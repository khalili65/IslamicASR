# Copy values into repo-root .env (gitignored) or export locally.

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_EMBED_MODEL=BAAI/bge-m3

# Shared password for ~10 trusted users (portal /ask + API)
RAG_ACCESS_PASSWORD=change-me

# Optional override for the portal static site when calling the API
# NEXT_PUBLIC_RAG_API_URL=http://127.0.0.1:8000
