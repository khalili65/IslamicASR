 "chapters": [
  {
   "index": 0,
   "title": "## وداع جمعه با امام رضا و قطع مراحل",
   "start": 37.72,
   "end": 196.48
  },
  {
   "index": 1,
   "title": "## اجسادکم فی الأجساد و همسنخی",
   "start": 196.48,
   "end": 216.72
  },
  {
   "index": 2,
   "title": "## قطع مراحل در رسالهٔ بحرالعلوم",
   "start": 216.72,
   "end": 249.08
  },
  {
   "index": 3,
   "title": "## طی‌الارض و شش آیهٔ نخست طه",
   "start": 249.08,
   "end": 958.43
  },
  {
   "index": 4,
   "title": "## اربعین و برکت تقوا",
   "start": 958.43,
   "end": 1081.99
  },
  {
   "index": 5,
   "title": "## رؤوف و زلزال در حروف",
   "start": 1081.99,
   "end": 1150.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 8.34,
   "text": "یا رب اعوذ به من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.34,
   "end": 10.28,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.28,
   "end": 15.96,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.96,
   "end": 23.52,
   "text": "اللهم ایکا نعبد و ایکا نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.52,
   "end": 30.6,
   "text": "الحمدلله على کل نعمته و اسال الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.6,
   "end": 35.72,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.72,
   "end": 37.72,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.72,
   "end": 41.3,
   "text": "غروب جمعه و وقت وداع ما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.3,
   "end": 48.1,
   "text": "بر حسب ظاهر با مولا و ولی نعمتمون علی ابن موسی الرضا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.1,
   "end": 54.2,
   "text": "برای اینکه سیر بحث غروب های جمعه مون تبرکاً قطع نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.2,
   "end": 61.08,
   "text": "در محضر عالم آل محمد صلى الله عليه و آله و سلم حضرت علی ابن موسی الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.08,
   "end": 67.54,
   "text": "به اذن این بزرگوار. به عقل قاصر بلکه قصیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 67.54,
   "end": 71.74,
   "text": "حقیر این چنین القا شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 71.74,
   "end": 77.64,
   "text": "نکته ای رو پیرامون همون ابتدای رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.64,
   "end": 81.44,
   "text": "سلوکیه سید بحر العلوم پیرامون قطع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.44,
   "end": 86.94,
   "text": "مراحل و طی منازل عرض کنم در سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.94,
   "end": 94.22,
   "text": "که رسیده بودیم به ابتدای فصل اول ایشون که در خاصیت عدد چهل بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 94.22,
   "end": 98.86,
   "text": "و تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 98.86,
   "end": 101.46,
   "text": "محضر شما عزیزان و دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 101.46,
   "end": 106.22,
   "text": "عرض کنم که بحث امروز رو جدی بگیریم همه مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.22,
   "end": 110.12,
   "text": "و این رو هدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 110.12,
   "end": 115.06,
   "text": "حضرت در این زیارت وداعیه بدانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.06,
   "end": 120.38,
   "text": "که چه جالب و شیرین که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.38,
   "end": 123.66,
   "text": "نماز عزیز دردونه شون حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 123.66,
   "end": 127.16,
   "text": "امام جواد صلوات الله علیه هم در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 127.16,
   "end": 130.36,
   "text": "دعای بعد از نماز ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.36,
   "end": 132.78,
   "text": "وقتی می خوانیم که اللهم رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.78,
   "end": 135.26,
   "text": "الارواح الفانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.26,
   "end": 139.4,
   "text": "والاجساد الباليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.4,
   "end": 146.14,
   "text": "اسألك بطاعه الارواح الراجعه الى اجسادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.14,
   "end": 151.68,
   "text": "این در اینجا درخواست می کنی به اطاعتی که ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.68,
   "end": 154.12,
   "text": "از حضرت حق دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.12,
   "end": 156.92,
   "text": "در رجعت شون به جسم هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.92,
   "end": 162.08,
   "text": "چقدر جالب ما وقت وداع به حضرت عرض می کنیم هارب منک الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.08,
   "end": 164.82,
   "text": "ما از تو به سوی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 164.82,
   "end": 168.64,
   "text": "فرار می کنیم. از شما به شما پناه می آوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.64,
   "end": 170.46,
   "text": "از شما به شما رجعت می کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.46,
   "end": 172.82,
   "text": "یعنی چی از شما به شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.82,
   "end": 176.28,
   "text": "یعنی از جلال شما به جمال شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.28,
   "end": 179.5,
   "text": "چون تجلی جلال این خاندان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.5,
   "end": 184.36,
   "text": "تجلی جلال این آقا میشود جهنم و دوزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.36,
   "end": 187.8,
   "text": "و ما از جلال او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.8,
   "end": 195.96,
   "text": "فرار می کنیم به جمال او پناه می آوریم که تجلی جمال این آقا میشود بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.96,
   "end": 201.72,
   "text": "و اونجا که در زیارت جامعه کبیره عرض می کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.72,
   "end": 203.96,
   "text": "ذکرکم في الذاکرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.96,
   "end": 206.4,
   "text": "اسماءکم في الاسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.4,
   "end": 209.64,
   "text": "اجسادکم في الاجساد که میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.64,
   "end": 211.98,
   "text": "ارواحکم في الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.98,
   "end": 214.5,
   "text": "اجسادکم في الاجساد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.5,
   "end": 216.72,
   "text": "این جسد شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.72,
   "end": 219.2,
   "text": "جسدها است. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.2,
   "end": 223.8,
   "text": "که اینجا عرض می کنیم بعد از نماز امام جواد صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.8,
   "end": 228.06,
   "text": "که از تو درخواست می کنم خدایا به آن اطاعتی که ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.06,
   "end": 232.16,
   "text": "در رجعت شون به جسم هاشون از تو دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.16,
   "end": 235.08,
   "text": "ببینید عزیزان ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.08,
   "end": 241.54,
   "text": "کافی کلینی علی مقامه الشریف روایتی داریم که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.54,
   "end": 246.38,
   "text": "شیرین که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 246.38,
   "end": 250.36,
   "text": "روح اهل بیت علیهم الصلاة و السلام رو از ما فوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.36,
   "end": 257.94,
   "text": "اعلا علیین خلق کرده و جسمشون رو از اعلا علیین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.94,
   "end": 263.74,
   "text": "و مؤمن یعنی محب علی علیه الصلاة والسلام رو یعنی شیعه اونها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.74,
   "end": 266.74,
   "text": "روحشون رو از اعلا علیین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.74,
   "end": 270.9,
   "text": "و جسمشون رو از غیر اعلا علیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.9,
   "end": 273.14,
   "text": "همونطور که حالا در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.14,
   "end": 278.32,
   "text": "اسفل سافلین اینها هم که در خصوص کفار و مشـ-مشركین و اینها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.32,
   "end": 289.1,
   "text": "شما اینجا دقت کردید کجا مرتبه هم سنخی و هم جنسی ما با آل الله می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.1,
   "end": 291.46,
   "text": "جسم آنها از مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.46,
   "end": 293.42,
   "text": "اعلا علیین بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.42,
   "end": 297.6,
   "text": "در حالی که روح ما از مرتبه اعلا علیین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.6,
   "end": 300.58,
   "text": "پس روح ما هم جنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.58,
   "end": 304.04,
   "text": "جسم اهل بیت است. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.04,
   "end": 308.96,
   "text": "اونجا که می فر-- تو زیارت جامعه میگیم و اجسادکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.96,
   "end": 312.22,
   "text": "جسدهای شما في الاجساد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.22,
   "end": 314.98,
   "text": "در جسدهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.98,
   "end": 319.42,
   "text": "چون دقت بفرمایید چی عرض می کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.42,
   "end": 324.42,
   "text": "چون جسد اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.42,
   "end": 327.66,
   "text": "از جنس اعلا علیین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.66,
   "end": 330.78,
   "text": "در جسد ماست یعنی روح ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.78,
   "end": 332.92,
   "text": "روح ما در جسد ماست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.92,
   "end": 339.32,
   "text": "چون روح ما هم سنخ با جسد اونهاست میگیم اجسادکم في الاجساد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.32,
   "end": 344.44,
   "text": "یعنی ارواح ما که اجساد شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.44,
   "end": 349.4,
   "text": "در جسم های ماست. حالا اینجا در این زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.4,
   "end": 359.28,
   "text": "در دعای بعد از نماز امام جواد صلوات الله علیه میگیم اسألك بطاعه الارواح الراجعه الى اجسادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.28,
   "end": 362.1,
   "text": "اینم باز به یک معنا همین رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.1,
   "end": 364.18,
   "text": "القا میکنه به ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.18,
   "end": 368.48,
   "text": "اون ارواحی که رجعت می‌کنند به جسدهاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.48,
   "end": 373.27,
   "text": "خب جسدهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 373.27,
   "end": 377.33,
   "text": "دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 377.33,
   "end": 380.89,
   "text": "شما اون و علم آدم الاسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.89,
   "end": 385.03,
   "text": "کلها رو یادتون عرض کردم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.03,
   "end": 389.71,
   "text": "که اون کلها ضمیرهایی که اونجا میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.71,
   "end": 395.23,
   "text": "اونجا خب وقتی میگه الاسماء جمعه باید بگه کلهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 395.23,
   "end": 398.21,
   "text": "همونطور که از وقتی به ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.21,
   "end": 402.43,
   "text": "بحث انبا رو میگه، میگه انبه هم به اسماء هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.43,
   "end": 407.29,
   "text": "اونجا یادتون باشه در شب جمعه‌ای در بحث لقاء الله عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.29,
   "end": 410.09,
   "text": "در توقیع شریعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.09,
   "end": 414.95,
   "text": "شریف مولامون امام عصر صلوات الله عليه که در ماه رجب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 414.95,
   "end": 419.15,
   "text": "می‌خونیم، اونجا هم وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 419.15,
   "end": 422.17,
   "text": "خدمت خدا عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 422.17,
   "end": 425.05,
   "text": "این اهل بیت عصمت و طهارت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.05,
   "end": 429.39,
   "text": "چهارده نور پاک فرقی با تو نمی‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.39,
   "end": 432.59,
   "text": "مگر اینکه میگه لا فرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.59,
   "end": 436.05,
   "text": "بینک و بینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.05,
   "end": 440.79,
   "text": "و بینها در صورتی که در حسب ظاهر باید بگیم و بینهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 440.79,
   "end": 445.01,
   "text": "الا وقتی اول میگیم بینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.01,
   "end": 449.71,
   "text": "ضمیر رو مفرد می‌گیریم بعد میگیم و انههم عبادک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.71,
   "end": 452.31,
   "text": "و انههم عبادک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.31,
   "end": 456.69,
   "text": "توجه بفرمایید انههم دوباره ضمیر جمع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.69,
   "end": 464.91,
   "text": "اینجا الان باز داریم میگیم که اسألك بطاعة الارواح الراجعة الى اجسادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.91,
   "end": 469.67,
   "text": "توجه کردید چی شد؟ جسد اهل بیت از اعلا علیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 469.67,
   "end": 478.21,
   "text": "روح ما که هم سنخ با جسد اهل بیته از اعلا علیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 478.21,
   "end": 480.85,
   "text": "توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 480.85,
   "end": 486.05,
   "text": "این سنخیت و جنسیت رو دقت کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.05,
   "end": 489.85,
   "text": "که یک حقیقتن، یک حقیقتن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.85,
   "end": 492.71,
   "text": "وقتی یک حقیقتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 492.71,
   "end": 496.41,
   "text": "که حالا اونجا حضرت علامه می‌فرماید که ضمیرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.41,
   "end": 504.23,
   "text": "برای غیر ذو الحق، ذو العقول هم استفاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 504.23,
   "end": 507.75,
   "text": "خب اما ضمیر هم فقط برای ذو العقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.75,
   "end": 513.15,
   "text": "خب اینجا یک حقیقت کلیه وقتی میگیری اونا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 513.15,
   "end": 517.43,
   "text": "میگی ها. توجه فرمودید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 517.43,
   "end": 522.53,
   "text": "و علم الاسماء و علم آدم الاسماء کلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 522.53,
   "end": 526.93,
   "text": "در صورتی که باید در حسب ظاهر میگفت کلهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 526.93,
   "end": 532.53,
   "text": "یا اونجا لا فرق بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 532.53,
   "end": 537.45,
   "text": "ک، بین تو ای خدا و بینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 537.45,
   "end": 540.89,
   "text": "یک حقیقت کلیه گرفتی اونها رو خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 540.89,
   "end": 543.63,
   "text": "بعد که میری تو کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 543.63,
   "end": 546.71,
   "text": "تو مرحله واحدیت اونها رو و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 546.71,
   "end": 551.23,
   "text": "اش اهدیت بود وقتی میری تو مرحله واحدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 551.23,
   "end": 553.77,
   "text": "الا و انه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 553.77,
   "end": 556.65,
   "text": "عبادک و خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 556.65,
   "end": 559.27,
   "text": "توجه کردید؟ این یه نکته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 559.27,
   "end": 561.39,
   "text": "حالا خواستم عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 561.39,
   "end": 565.35,
   "text": "در وداع با حضرت توجه بفرمایند که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.35,
   "end": 570.25,
   "text": "داریم از حضرت به حضرت پناه می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 570.25,
   "end": 576.29,
   "text": "خب ، و از اما اونجایی که در ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.29,
   "end": 588.57,
   "text": "فصل اول رساله سلوکیه حضرت سید بحر العلوم علیه الرحمه عرض شد، اونجا ایشون می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 588.57,
   "end": 593.47,
   "text": "عدد چهل رو اون حالا فرمودن که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 593.47,
   "end": 595.31,
   "text": "تاثیر شگرفیست در چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 595.31,
   "end": 598.41,
   "text": "قطع مراحل و طی منازل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 598.41,
   "end": 601.27,
   "text": "اینجا هم نکته‌ای را عرض کنیم تبرکاً و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 601.27,
   "end": 603.23,
   "text": "شما را به خدای بزرگ و حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 603.23,
   "end": 607.57,
   "text": "امام رئوف بسپاریم. قطع مراحل؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 607.57,
   "end": 610.35,
   "text": "ببینید ما مرحله به مرحله در پیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 610.35,
   "end": 616.77,
   "text": "داریم حرکت می‌کنیم. مرحله به مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 616.77,
   "end": 621.09,
   "text": "ما همونطور که امیرالمؤمنین صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 621.09,
   "end": 629.03,
   "text": "ذیل آیه شریفه کل يوم هو في شأن فرمودن مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 629.03,
   "end": 635.21,
   "text": "خدای منان آن به آن در هر مرحله‌ای از خلقتش در شان و ظهور خاصیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 635.21,
   "end": 638.75,
   "text": "عده‌ای رو در از خلائقش در رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 638.75,
   "end": 642.33,
   "text": "مادر و عده‌ای رو در رحم دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 642.33,
   "end": 645.41,
   "text": "طبیعت، عده‌ای رو در رحم سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 645.41,
   "end": 649.59,
   "text": "یعنی بعد از موت اینها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 649.59,
   "end": 654.29,
   "text": "شان خاصی در همه اینها می‌دهد، انشا می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 654.29,
   "end": 659.23,
   "text": "و ما در مراحل مخت-مختلف و متعدد زندگیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 659.23,
   "end": 664.37,
   "text": "از لحظه‌ای که خدای منان اراده ایجاد ما رو کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 664.37,
   "end": 668.95,
   "text": "تا ابدی که در پیش داریم مرحله به مرحله در پیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 668.95,
   "end": 672.65,
   "text": "بعضی از مراحل ما در نشئه طبیعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 672.65,
   "end": 676.41,
   "text": "این که می‌فرماید قطع مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 676.41,
   "end": 679.63,
   "text": "خیلی نکته سنجیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 679.63,
   "end": 683.33,
   "text": "روح سید شاد. این سید بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 683.33,
   "end": 688.25,
   "text": "قطع مراحل یکی معناش اینه که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 688.25,
   "end": 694.67,
   "text": "قطع کنی با قاطعیت قطع کنی مرحله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 694.67,
   "end": 697.65,
   "text": "یعنی مرحله رو نیمه کاره رها نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 697.65,
   "end": 701.41,
   "text": "مثلاً در منازل الصائرین شما برید بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 701.41,
   "end": 705.01,
   "text": "یا کتاب‌هایی که پیرامون سیر و سلوکه هر کدوم حالا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 705.01,
   "end": 707.81,
   "text": "فراخور حال خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 707.81,
   "end": 710.97,
   "text": "مراحلی رو در سیر و سلوک بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 710.97,
   "end": 713.91,
   "text": "عده‌ای میگن نود و نه مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 713.91,
   "end": 718.83,
   "text": "عده‌ای میگن مثلاً دو مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 718.83,
   "end": 723.81,
   "text": "عده‌ای میگن یک مرحله‌ست، اونم پا گذاشتن رو خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 723.81,
   "end": 727.49,
   "text": "حالا این مراحل رو میگه به قطعییت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 727.49,
   "end": 731.19,
   "text": "قطع مراحل یک معناش اینه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 731.19,
   "end": 736.89,
   "text": "قاطعانه تصمیمت اینگونه باشد که تا انتهای مرحله رو بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 736.89,
   "end": 741.63,
   "text": "نه اینکه سیرت در نشئه طبیعت به گونه‌ای باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 741.63,
   "end": 747.17,
   "text": "که مجبور بشی در سیر تکاملی برزخی قرار بگیری که اونجا کار دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 747.17,
   "end": 752.37,
   "text": "توجه کردی چی عرض می‌کنم؟ در مرحله‌های سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 752.37,
   "end": 755.95,
   "text": "قاطعیت داشته باشی و قطع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 755.95,
   "end": 759.67,
   "text": "یک معناش اینه و یک معناش قطع مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 759.67,
   "end": 761.61,
   "text": "یعنی اینکه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 761.61,
   "end": 764.63,
   "text": "کندن، قطع کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 764.63,
   "end": 766.69,
   "text": "هر آنچه که تعلق داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 766.69,
   "end": 769.09,
   "text": "در هر مرحله‌ای. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 769.09,
   "end": 773.03,
   "text": "اینجا زحمت می‌کشی تا به طی منازل برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 773.03,
   "end": 775.83,
   "text": "طی منازل دیگه اون‌ها برکت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 775.83,
   "end": 779.13,
   "text": "اون‌ها طیت میدن مثل طی الارض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 779.13,
   "end": 782.95,
   "text": "طی الارض، طی الارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 782.95,
   "end": 785.69,
   "text": "به یک معنا معنای برکت دارد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 785.69,
   "end": 789.25,
   "text": "که حالا مثلاً از مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 789.25,
   "end": 793.89,
   "text": "علامه طباطبایی روحشون شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 793.89,
   "end": 796.55,
   "text": "علیه الرحمه پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 796.55,
   "end": 799.47,
   "text": "حقیقت طی الارض چیه و رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 799.47,
   "end": 803.13,
   "text": "میزان و رو چه میزانی از موازین فلسفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 803.13,
   "end": 807.67,
   "text": "این امر طی الارض. رو چه میزان از موازین فلسفی این امر صورت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 807.67,
   "end": 813.73,
   "text": "پس علامه طباطبایی علیه الرحمه جواب دادن که حقیقت این طی الارض پیچیدن زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 813.73,
   "end": 816.09,
   "text": "زیر گام رونده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 816.09,
   "end": 818.99,
   "text": "این همون معنای برکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 818.99,
   "end": 821.83,
   "text": "که حالا البته ایشون توضیح میدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 821.83,
   "end": 828.11,
   "text": "برادر ما یعنی مرحوم آقا سید محمد حسن الهی قاضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 828.11,
   "end": 834.73,
   "text": "می‌فرماید که یه روز به وسیله شاگردی که ایشون داشته احضار ارواح می‌کرده از روح مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 834.73,
   "end": 837.67,
   "text": "حاج میرزا علی آقا قاضی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 837.67,
   "end": 841.27,
   "text": "راجع به همین طی الارض سؤال می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 841.27,
   "end": 845.55,
   "text": "اینو مرحوم علامه طباطبایی دارن می‌فرماین به روایت از برادرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 845.55,
   "end": 850.95,
   "text": "که مرحوم آقا قاضی علیه الرحمه جواب میدن که طی الارض شش آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 850.95,
   "end": 853.01,
   "text": "اول سوره طه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 853.01,
   "end": 855.47,
   "text": "عجب! که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 855.47,
   "end": 859.87,
   "text": "شش آیه اول سوره طه چه چیزی درش که طی الارضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 859.87,
   "end": 862.05,
   "text": "که می‌فرماید \"بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 862.05,
   "end": 869.71,
   "text": "طه. ما انزلنا علیک القرآن لتشقا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 869.71,
   "end": 876.77,
   "text": "خب ما قرآن رو بر تو نازل نکردیم برای اینکه به خودت سختی بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 876.77,
   "end": 879.29,
   "text": "اذیت شی. زجر بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 879.29,
   "end": 883.23,
   "text": "لتشقا. برای رنج نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 883.23,
   "end": 887.35,
   "text": "ن-- این قرآن رو برا تو نازل نکردیم برای اینکه به رنج بیفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 887.35,
   "end": 890.21,
   "text": "خب چه چیزی انسان را از رنج خارج می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 890.21,
   "end": 895.11,
   "text": "برکت. که اگر برکت نباشد انسان دائماً در رنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 895.11,
   "end": 898.83,
   "text": "\"الا تذکرة لمن يخشى.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 898.83,
   "end": 901.67,
   "text": "باز مقام خشوع مقام همون برکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 901.67,
   "end": 905.97,
   "text": "\"تنزيلا ممن خلق الأرض والسماوات العلا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 905.97,
   "end": 907.81,
   "text": "علا. اون مقامات عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 907.81,
   "end": 910.17,
   "text": "اون درجات عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 910.17,
   "end": 913.93,
   "text": "\"الرحمن على العرش استوى.\" به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 913.93,
   "end": 920.11,
   "text": "\"له ما في السماوات وما في الأرض وما بينهما وما تحت الثرى.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 920.11,
   "end": 922.09,
   "text": "همه دست اوست. همه برای اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 922.09,
   "end": 924.93,
   "text": "همه تحت مالکیت و ملکیت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 924.93,
   "end": 929.01,
   "text": "او بخواهد زمین رو می‌پیچونه زیر پای تو برکت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 929.01,
   "end": 931.49,
   "text": "\"وإن تجهر بالقول فإنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 931.49,
   "end": 934.05,
   "text": "يعلم السر وأخفى.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 934.05,
   "end": 936.99,
   "text": "اینجا این آیه شیشم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 936.99,
   "end": 940.39,
   "text": "درش مطلب هست و سر هست که \"الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 940.39,
   "end": 943.39,
   "text": "لا إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 943.39,
   "end": 945.51,
   "text": "له الأسماء الحسنى.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 945.51,
   "end": 947.43,
   "text": "الله اکبر. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 947.43,
   "end": 951.35,
   "text": "حالا من مقصودم این نبود. الآن والله به ذهنم آمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 951.35,
   "end": 953.15,
   "text": "حضرت القا کرد که به شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 953.15,
   "end": 958.43,
   "text": "در هر حال بحث طی مراحل بود، قطع مراحل بود و طی منازل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 958.43,
   "end": 963.49,
   "text": "وقتی قطع مراحل به نحو احسن صورت گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 963.49,
   "end": 970.59,
   "text": "که انسان وقتی می‌خواد در سیر و سلوک اربعین گیری کنه باید قطع مراحل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 970.59,
   "end": 975.07,
   "text": "قاطعیت داشته باشه که این مرحله چهل روزه‌ش رو به نحو احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 975.07,
   "end": 980.45,
   "text": "حرکت کنه. نیمه کاره انجام نده تا به مراحل بعدی برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 980.45,
   "end": 984.07,
   "text": "و بکنه از تعلقات تا طی منازل شروع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 984.07,
   "end": 987.45,
   "text": "منازل چنان جلوه گر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 987.45,
   "end": 993.25,
   "text": "که مرحله به مرحله، چله به چله، اربعین به اربعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 993.25,
   "end": 998.01,
   "text": "طیت میده تو رو. مثل طی الارض که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 998.01,
   "end": 1001.87,
   "text": "که زمین زیر پای اون شخص می‌پیچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1001.87,
   "end": 1005.51,
   "text": "زمان و مکان برای تو می‌پیچه در هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1005.51,
   "end": 1007.85,
   "text": "و برای تو برکت ایجاد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1007.85,
   "end": 1012.29,
   "text": "و می‌بینی که این چهل روز از نظر چهل سال برکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1012.29,
   "end": 1014.81,
   "text": "برکت. برکت خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1014.81,
   "end": 1017.19,
   "text": "خیلیا دنبال ازدیاد مالن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1017.19,
   "end": 1020.01,
   "text": "در حالی که برکت مهم‌تر از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1020.01,
   "end": 1026.15,
   "text": "برکت که از اون معنایه \"ومن يتق الله يجعل له مخرجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1026.15,
   "end": 1029.03,
   "text": "ويرزقه من حيث لا يحتسب.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1029.03,
   "end": 1032.55,
   "text": "اونجا از امام صادق صلوات الله علیه سؤال کردن آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1032.55,
   "end": 1037.89,
   "text": "رزقی که از جایی که گمان نمی‌کنه بر اثر تقوا خدا براش می‌رسونه این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1037.89,
   "end": 1046.09,
   "text": "یعنی ازدیاد مال؟ حضرت فرمودن نخیر بلکه برکت است در اونچه که خدا بهش عطا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1046.09,
   "end": 1047.85,
   "text": "و باریک لهو فيما آتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1047.85,
   "end": 1050.17,
   "text": "اونچه که خدا بهش عطا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1050.17,
   "end": 1052.39,
   "text": "خدا برکت براش می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1052.39,
   "end": 1055.87,
   "text": "و به امید برکت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1055.87,
   "end": 1064.35,
   "text": "که انشاالله در مسیر سیر و سلوک و این چله گیری‌ها و اربعین گیری‌ها هرچه که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1064.35,
   "end": 1070.49,
   "text": "ما قطع مراحل کنیم تا طی منازل بدن به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1070.49,
   "end": 1074.15,
   "text": "از آقامون علی ابن موسی الرضا در این غروب جمعه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1074.15,
   "end": 1080.29,
   "text": "استمداد می‌طلبیم که حضرت عنایت کنند و ما رو در این مسیر موفق کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1080.29,
   "end": 1086.65,
   "text": "چه خوش که ما در بحث لقاء الله شب جمعه‌مون بحثمون دیشب رسید به همون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1086.65,
   "end": 1092.67,
   "text": "اون حدیث شریفی که خود این آقای مهربان از جدشون امیرالمؤمنین صلوات الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1092.67,
   "end": 1094.71,
   "text": "که شأن نزول حروف رو می‌فرماین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1094.71,
   "end": 1098.19,
   "text": "چه شیرین که رسیدیم به حرف را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1098.19,
   "end": 1100.85,
   "text": "الرؤوف الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1100.85,
   "end": 1103.47,
   "text": "و حرف زا که زلزله‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1103.47,
   "end": 1106.07,
   "text": "روز قیامت بود. زلزله‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1106.07,
   "end": 1113.65,
   "text": "روز قیامت که در همون بحث اقامه قیامت در حرم امام رضا صلوات الله علیه نکته‌ای عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1113.65,
   "end": 1116.87,
   "text": "مختصراً و اجمالاً بازش کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1116.87,
   "end": 1119.61,
   "text": "و الرؤوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1119.61,
   "end": 1123.09,
   "text": "که در محضر این حضرت هستیم که الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1123.09,
   "end": 1124.73,
   "text": "اینجا جلوه گری می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1124.73,
   "end": 1127.83,
   "text": "رحمت خاصش به اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1127.83,
   "end": 1130.61,
   "text": "این هم دیگه خودتون چشیدید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1130.61,
   "end": 1136.51,
   "text": "در محضر حضرت به این به شأن نزول حرف را و زا رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1136.51,
   "end": 1140.41,
   "text": "خب باز هم عرض می‌کنیم خارب من که العی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1140.41,
   "end": 1144.33,
   "text": "از جلال شما به جمال شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1144.33,
   "end": 1148.73,
   "text": "پناه می‌بریم. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1148.73,
   "end": 1150.91,
   "text": "ثار حضرت مهربانش صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}