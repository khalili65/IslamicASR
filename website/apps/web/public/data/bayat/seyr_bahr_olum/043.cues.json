   "start": 183.66,
   "end": 234.78
  },
  {
   "index": 2,
   "title": "## وسوسه از انانیّت؛ شیطان هادی مخلصین",
   "start": 234.78,
   "end": 255.74
  },
  {
   "index": 3,
   "title": "## سه راه تسلّط شیطان و توحید سه مرتبه",
   "start": 255.74,
   "end": 744.05
  },
  {
   "index": 4,
   "title": "## منصب چهارم در دل منصب اول",
   "start": 744.05,
   "end": 801.85
  },
  {
   "index": 5,
   "title": "## یادکرد شهید نعمتی و درد خانوادهٔ شهدا",
   "start": 801.85,
   "end": 821.95
  },
  {
   "index": 6,
   "title": "## درد خانوادهٔ شهید و جانمایی قبر",
   "start": 821.95,
   "end": 1138.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 4.54,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.54,
   "end": 9.86,
   "text": "السلام علیک ای داعی الله و ربانی آیا چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.86,
   "end": 13.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.8,
   "end": 16.98,
   "text": "خب ادامه بحث در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.98,
   "end": 21.46,
   "text": "مخلصین. در رساله سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.46,
   "end": 25.82,
   "text": "حضرت علامه طباطبایی عليه الرحمة والرضوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.82,
   "end": 28.84,
   "text": "ذیل همون بحثی که قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.84,
   "end": 31.22,
   "text": "در قلب مؤمن داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.22,
   "end": 35.8,
   "text": "اونجا که اظهار عجز شیطان از اغواء مخلصین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.8,
   "end": 38.38,
   "text": "یه چند تا نکته اونجا گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.38,
   "end": 40.06,
   "text": "تتمه‌ش رو دیگه نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.06,
   "end": 44.18,
   "text": "الان سنجاقش می‌کنیم به بحث چون بحث، بحث مخلصینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.18,
   "end": 55.64,
   "text": "مرحوم علامه طباطبایی در تفسیر المیزان، جلد هفده، صفحه دویست و بیست و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.64,
   "end": 60.94,
   "text": "ایشون می‌آورن که البته این فرمایش رو من الان از رو تفسیر نمی‌خونم، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.94,
   "end": 64.38,
   "text": "خود رساله دارم می‌خونم. رساله سیر سلوکی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.38,
   "end": 68.64,
   "text": "که ذیل شاگردان ایشون شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.64,
   "end": 74.56,
   "text": "تو شرحش اینو آوردن بحث کامل‌تر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.56,
   "end": 82.5,
   "text": "می‌فرماین \"و استثنی منهم المخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.5,
   "end": 89.14,
   "text": "و هم الذین أخلص الله لنفسه فلا نصيب فيهم لإبليس ولا لغير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.14,
   "end": 92.42,
   "text": "اینم یکی دیگه از خصوصیات مخلصینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.42,
   "end": 97.6,
   "text": "یعنی مخلصین عبارتند از اون کسانی که خدای متعال اونا رو برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.6,
   "end": 106.16,
   "text": "خالص کرده و هیچکس در اون‌ها نصيبي ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.16,
   "end": 112.32,
   "text": "فلا نصيب فيهم لإبليس ولا لغير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.32,
   "end": 116.4,
   "text": "حتی ابلیس هم از اون‌ها نصيبي نداره چه برسه به غير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.4,
   "end": 121.28,
   "text": "انقدر خالص می‌شن. این برمی‌گرده به کدوم آیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.28,
   "end": 124.3,
   "text": "اون آیه‌ای که علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.3,
   "end": 127.08,
   "text": "تهرانی احتراماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.08,
   "end": 131.38,
   "text": "اضافه کرد به سه منصب مخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.38,
   "end": 139.0,
   "text": "گفت فبعزتك لأغوينهم أجمعین إلا عبادك منهم المخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.0,
   "end": 141.04,
   "text": "مخلصین هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.04,
   "end": 143.4,
   "text": "اغواء شیاطین ایمنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.4,
   "end": 150.44,
   "text": "اینم یه منصبه. ولی چون فرمایش تو یادتون باشه فرمایش علامه این بود که چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.44,
   "end": 158.9,
   "text": "اون‌ها در محشر حاضر نمی‌شن علتش اینه که قبلاً حساب کتاب پس دادن تو قیامت صغری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.9,
   "end": 160.98,
   "text": "و خودشون رو دامن‌شون رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.98,
   "end": 163.3,
   "text": "شر ابالسه جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.3,
   "end": 166.04,
   "text": "اصلاً شیطان زورش به اینا نرسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.04,
   "end": 170.1,
   "text": "که تو محشر صغری یعنی تو دنیا موفق بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.1,
   "end": 172.46,
   "text": "این منصب رو اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.46,
   "end": 177.84,
   "text": "علامه تهرانی اضافه کرد به منصب سه منصبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.84,
   "end": 180.52,
   "text": "سید بحر العلوم داشت. اونجا بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.52,
   "end": 183.66,
   "text": "اینم باز فرمایش علامه طباطبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.66,
   "end": 186.52,
   "text": "باز در رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.52,
   "end": 192.2,
   "text": "الرسائل التوحیدیه صفحه سیصد و سی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.2,
   "end": 196.26,
   "text": "همچنین در الانسان والعقیده صفحه نود و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.26,
   "end": 200.3,
   "text": "علامه طباطبایی در خصوص مخلصین اینچنین می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.3,
   "end": 205.12,
   "text": "\"فالمخلصون هم المخلصون عن الشرك بذاتهم لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.12,
   "end": 208.06,
   "text": "يرون بغيره سبحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.06,
   "end": 216.4,
   "text": "وجودا ولا يح-- ولا يحسون لغيره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.4,
   "end": 222.26,
   "text": "اسم ولا رسم ولا يملكون لأنفسهم نفعا ولا ضرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.26,
   "end": 224.68,
   "text": "ولا موتا ولا نشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.68,
   "end": 226.58,
   "text": "وهذا هو الولاية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.58,
   "end": 230.86,
   "text": "به به، به به! عجب فرمایشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.86,
   "end": 236.56,
   "text": "فرمودن که مخلصین یا مخلصین مستغرق در خدای سبحانه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.56,
   "end": 241.74,
   "text": "غرق در خدااند. نه ابلیس رو می‌بینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.74,
   "end": 244.2,
   "text": "و نه وسوسه‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.2,
   "end": 248.08,
   "text": "توجه دارن. مخلصین کسانی‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.08,
   "end": 252.54,
   "text": "ذاتاً از شرک پاک و پیراسته‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.54,
   "end": 255.74,
   "text": "ذاتاً اشاره به چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.74,
   "end": 259.12,
   "text": "ما گفتیم اخلاص در عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.12,
   "end": 261.94,
   "text": "اخلاص ذات یا نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.94,
   "end": 267.02,
   "text": "اینکه می‌فرماید ذاتاً از شرک پاک، پاک و پیراسته‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.02,
   "end": 270.88,
   "text": "یعنی اینا تونستن ذاتشون رو از شرک پاک کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.88,
   "end": 274.12,
   "text": "یعنی ذاتشون رو خالص کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.12,
   "end": 276.32,
   "text": "این بالاتر از اخلاص عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.32,
   "end": 285.9,
   "text": "اخلاص ذاتیه. و برای غیر خدا وجودی نمی‌بینن و نام و نشانی جز برای او نمی‌یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.9,
   "end": 288.96,
   "text": "اصلاً هرچی می‌بینن ظهور خدا می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.96,
   "end": 293.34,
   "text": "برای غیر حق جایی ندارن اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.34,
   "end": 299.36,
   "text": "نه اختیار نفع خویش را دارند، نه ضرر، نه مرگ، نه حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.36,
   "end": 307.12,
   "text": "بعد خیلی جالب اینجا علامه طباطبایی تصریح دارن که \"وهذا هو الولاية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.12,
   "end": 310.64,
   "text": "به به. اونایی که دنبال اینن که ولایت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.64,
   "end": 315.68,
   "text": "یعنی این. ولایت یعنی مخلص شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.68,
   "end": 318.72,
   "text": "هرچی به سمت هم صحبت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.72,
   "end": 328.3,
   "text": "جلسات پیش هست، هرچی به سمت اخلاص سازی میری به ولایت نزدیک‌تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.3,
   "end": 337.7,
   "text": "باز در جای دیگه در رسالت توحید صفحه صد و پنجاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 337.7,
   "end": 342.38,
   "text": "ایشون بحث وسوسه رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 342.38,
   "end": 347.76,
   "text": "می‌فرماین که اصلاً چرا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 347.76,
   "end": 351.86,
   "text": "به اینجا می‌رسن که هیچ وسوسه‌ای درشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 351.86,
   "end": 356.06,
   "text": "چرا؟ می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 356.06,
   "end": 359.9,
   "text": "اصلاً وسوسه از انانیت میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 359.9,
   "end": 364.02,
   "text": "از دیدن خود، ندیدن خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 364.02,
   "end": 367.56,
   "text": "غفلت از حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 367.56,
   "end": 373.22,
   "text": "خب اگر کسی اصلا توجهی به غیر خدا نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.22,
   "end": 375.46,
   "text": "اصلا قائل به دویت نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 375.46,
   "end": 379.46,
   "text": "کاملا در محضر حق خودش رو دقیقا می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 379.46,
   "end": 383.98,
   "text": "دیگه چه وسوسه‌ای؟ یعنی از اینجام این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.98,
   "end": 387.2,
   "text": "وسوسه رو برمی‌داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 387.2,
   "end": 393.36,
   "text": "بعد می‌فرماید که این‌ها یعنی مخلصین به مرحله شهود رسیده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 393.36,
   "end": 395.96,
   "text": "و شیطان مغوی برای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.96,
   "end": 399.38,
   "text": "شیطان مغوی یعنی اون شیطان اغواگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 399.38,
   "end": 406.44,
   "text": "حالا خیلی جالبه اینجا شیطانی که همه رو اغوا می‌کنه برای اینا چی می‌شه خود شیطان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.44,
   "end": 411.02,
   "text": "بالاخره یه موجودیه. همه رو داره اغوا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 411.02,
   "end": 413.34,
   "text": "مظهر اسم مذل حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.34,
   "end": 416.0,
   "text": "حالا برای مخلصین این حکمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 416.0,
   "end": 418.28,
   "text": "چی کار کنه؟ چی کار می‌کنه با اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.28,
   "end": 422.16,
   "text": "بالاخره یکی از کلمات وجودی نظام هستی هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.16,
   "end": 425.46,
   "text": "آیا انبیا با همه کلمات مرتبط هستند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.46,
   "end": 429.38,
   "text": "آیا همه کلمات وجودی نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 429.38,
   "end": 432.92,
   "text": "به یک نحوی از انحاء شأنی از شعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 432.92,
   "end": 435.26,
   "text": "انسان کامل به حساب میان یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 435.26,
   "end": 441.16,
   "text": "پس رابطه‌ی این شخص، این آدم مخلص با شیطان چگونه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 441.16,
   "end": 445.04,
   "text": "در صورتی که ذاتا شیطان اغواگره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.04,
   "end": 451.46,
   "text": "خب رابطه‌ی این نبی، این پیغمبر، این انسان کامل با شیطان چگونه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 451.46,
   "end": 456.18,
   "text": "یه سؤال جدیه. خیلی قشنگ علامه با زیرکی فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.18,
   "end": 463.02,
   "text": "که و شیطان مغوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 463.02,
   "end": 468.36,
   "text": "برای این‌ها هادی می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 468.36,
   "end": 470.56,
   "text": "این یعنی چی؟ اصلا برعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.56,
   "end": 474.08,
   "text": "یعنی چی؟ همون فرمایش عرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 474.08,
   "end": 478.66,
   "text": "فرمودن شیطان چیزی نیست جز سگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.66,
   "end": 482.6,
   "text": "پاسبان درگاه خدا که پاس می‌کنه تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.6,
   "end": 486.8,
   "text": "بترسونه بری سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.8,
   "end": 493.06,
   "text": "این نگاه رو ببینید. میگه اصلا پاس می‌کنه تو رو متوجه کنه که اینجا محل خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 493.06,
   "end": 496.78,
   "text": "پاس پاس وق وق شیطان جسارتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.78,
   "end": 501.22,
   "text": "میخواد به تو اینو بفهمونه. اصلا هرچی اون میگه وق وق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.22,
   "end": 504.08,
   "text": "داره به تو می‌فهمونه که اینجا محل خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 504.08,
   "end": 506.7,
   "text": "اینجا جهنمه. اینجا دوری از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 506.7,
   "end": 510.86,
   "text": "اینجا نیای پس برو سمت خدا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 510.86,
   "end": 517.98,
   "text": "برای اونا می‌شه هادی. یعنی هرچی شیطان دعوت می‌کنه اونا عکسش رو انجام میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 517.98,
   "end": 519.88,
   "text": "می‌دونن اینجا محل دوری از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 519.88,
   "end": 523.82,
   "text": "اینجا جهنمه. اینجا محل خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 523.82,
   "end": 526.6,
   "text": "خیلی شیرینه که شیطان برای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 526.6,
   "end": 530.1,
   "text": "شیطانی که اصلا ذاتش اغواگره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 530.1,
   "end": 537.38,
   "text": "برای اینا می‌شه هادی. حالا کی اصلاً توجه به این ظریف کاری‌ها داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 537.38,
   "end": 543.68,
   "text": "یه عالمی مثل علامه طباطبایی باید ذره‌بین طهارت نفس و دقت نظر بزنه به چشمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 543.68,
   "end": 546.22,
   "text": "این‌ها رو رمزگشایی کنه به من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 546.22,
   "end": 551.64,
   "text": "بگه. این دیگه هنر ماست که دنبال سر اینا راه بیفتیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 551.64,
   "end": 554.7,
   "text": "بعد خیلی جالب شیرین‌ترش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 554.7,
   "end": 563.72,
   "text": "حضرت علامه می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 563.72,
   "end": 567.26,
   "text": "حالا شاگردشون حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.26,
   "end": 570.16,
   "text": "جعفری ایشون به نقل از فرمایشات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 570.16,
   "end": 572.84,
   "text": "علامه طباطبایی می‌فرمایند که این‌ها به مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 572.84,
   "end": 580.3,
   "text": "شهود رسیده‌اند و شهود دارند و شیطان از یکی از سه راه بر انسان مسلط می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 580.3,
   "end": 586.24,
   "text": "به شهود رسیدن که شیطان از سه راه بیشتر نمی‌تونه بر انسان مسلط بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 586.24,
   "end": 589.4,
   "text": "یکی از راه افعال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 589.4,
   "end": 594.72,
   "text": "یکی از راه صفات، یکی هم از راه ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 594.72,
   "end": 599.62,
   "text": "این‌ها بر سه-- این‌ها همین یعنی انبیا یعنی مخلصین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 599.62,
   "end": 602.88,
   "text": "هر سه مرحله را گذراندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 602.88,
   "end": 608.58,
   "text": "نه فعلی دارند و نه عنیتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 608.58,
   "end": 611.6,
   "text": "افعالشان افعال حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 611.6,
   "end": 614.3,
   "text": "صفاتشان صفات حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 614.3,
   "end": 616.88,
   "text": "و ذاتشان ذات حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 616.88,
   "end": 622.32,
   "text": "دیگر شیطان به چه چیزی می‌خواهد این‌ها را گول بزند و فریب دهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 622.32,
   "end": 629.14,
   "text": "لذا دستش کوتاه است. خیلی قشنگ گفته‌ ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 629.14,
   "end": 634.48,
   "text": "می‌فرمود کسی که در مسیر توحید همون بحثی که تو کشکول نور داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 634.48,
   "end": 639.08,
   "text": "زهرا در مسیر توحید حرکت می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 639.08,
   "end": 643.18,
   "text": "توحید افعالی و صفاتی و ذاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 643.18,
   "end": 649.54,
   "text": "پشت سر می‌گذاره. اصلا دیگه برای فعل خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 649.54,
   "end": 651.76,
   "text": "صفات و اسماء خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 651.76,
   "end": 654.68,
   "text": "و ذات خودش در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 654.68,
   "end": 658.26,
   "text": "فعل و صفات و ذات الهی دویت قائله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 658.26,
   "end": 668.26,
   "text": "هرچی می‌بینه حق می‌بینه. وقتی کسی به این مرحله رسیده اصلا وجود غیر رو نمی‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 668.26,
   "end": 671.54,
   "text": "اصلا نمی‌تونه بپذیره شیطان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 671.54,
   "end": 676.46,
   "text": "چون رسیده به توحید افعالی، صفاتی و ذاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 676.46,
   "end": 679.58,
   "text": "افعال خودش رو افعال حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 679.58,
   "end": 681.64,
   "text": "لا حول ولا قوة الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 681.64,
   "end": 689.08,
   "text": "فانی در افعال حق. صفات و اسماء و دارایی‌های خودش رو در درون هرچه ملکه داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 689.08,
   "end": 692.4,
   "text": "کمال داره همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 692.4,
   "end": 695.72,
   "text": "فانی در صفات و اسماء و کمالات الهی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 695.72,
   "end": 701.5,
   "text": "برای خودش چیزی قائل نیست که بخواد اون رو با شیطان معاوضه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 701.5,
   "end": 711.26,
   "text": "لا اله الا الله و اصلا عینیت وجود خودش رو، موجودیت خودش رو، ذات خودش رو هم فانی در ذات الهی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 711.26,
   "end": 714.38,
   "text": "میگه خدا ظهور کرده. من کیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 714.38,
   "end": 718.8,
   "text": "من چیم؟ یا ملاهو الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 718.8,
   "end": 723.74,
   "text": "کسی که واقعا به این رسید دیگه شیطان اینجا چه کار است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 723.74,
   "end": 727.08,
   "text": "اصلا شیطان نمی‌تونه در این رتبه در این مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 727.08,
   "end": 729.9,
   "text": "ظاهر بشه و حضور پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 729.9,
   "end": 734.58,
   "text": "ببین چقدر بحث رو دقیق می‌کنند بزرگان اهل معرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 734.58,
   "end": 737.91,
   "text": "ما بتونیم با یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 737.91,
   "end": 741.47,
   "text": "این مسیر رو با یقین قدم بردارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 741.47,
   "end": 745.15,
   "text": "پس حالا خلاصه مطلب باز ما منصب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 745.15,
   "end": 748.75,
   "text": "دوم و سوم رو نرسیدیم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 748.75,
   "end": 752.25,
   "text": "اما منصب چها-- منصب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 752.25,
   "end": 755.51,
   "text": "چهارم رو با زیرکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 755.51,
   "end": 759.59,
   "text": "علامه‌ tabatabai در دل منصب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 759.59,
   "end": 762.19,
   "text": "بیان کردیم. اونم چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 762.19,
   "end": 766.71,
   "text": "اینکه مخلصین از اغوای شیاطین ایمنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 766.71,
   "end": 768.93,
   "text": "در منصب اول که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 768.93,
   "end": 772.47,
   "text": "از قیامت کبرا هم ایمنن جاش دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 772.47,
   "end": 775.87,
   "text": "که این‌ها از اغوای شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 775.87,
   "end": 780.31,
   "text": "در امان بودن که از قیامت کبرا در امانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 780.31,
   "end": 785.11,
   "text": "درست شد؟ در حقیقت ما دو منصب رو گفتیم اما از نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 785.11,
   "end": 789.13,
   "text": "السید بحر العلوم هنوز منصب اول هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 789.13,
   "end": 791.65,
   "text": "که این‌ها از قیامت کبرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 791.65,
   "end": 796.93,
   "text": "ایمنن. بعد دیگه میریم دو-- انشاالله به فضل الهی جلسات بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 796.93,
   "end": 799.29,
   "text": "منصب دوم و سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 799.29,
   "end": 805.43,
   "text": "که جمعش کنیم. خیلی امروز متأثر شدیم شما تشریف نداشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 805.43,
   "end": 809.73,
   "text": "از عزیزمون آقا محجوب اومده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 809.73,
   "end": 812.99,
   "text": "از شهادت شاهدها می‌گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 812.99,
   "end": 816.19,
   "text": "خاطراتی از شهید نعمتي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 816.19,
   "end": 819.15,
   "text": "که در حرم حضرت عبدالعظیم دفنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 819.15,
   "end": 826.75,
   "text": "گفتند و از اذیت‌هایی که خانواده‌های شهدا دارن همین بعد از این جنگ دوازده روزه اسرائیل خبیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 826.75,
   "end": 829.99,
   "text": "اذیت‌هایی که خانواده‌های شهدا دارن میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 829.99,
   "end": 834.03,
   "text": "به خصوص خانواده‌ی شهید نعمتي این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 834.03,
   "end": 837.45,
   "text": "خیلی چقدر اینجا گریه کردن اشک ما رو درآوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 837.45,
   "end": 839.35,
   "text": "خاطرات خانواده رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 839.35,
   "end": 844.03,
   "text": "سختی‌هایی که خانواده‌های شهدا در نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 844.03,
   "end": 847.49,
   "text": "همسرشون، پدرشون تو خونه متحمل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 847.49,
   "end": 850.91,
   "text": "جگرسوزه واقعا دعاشون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 850.91,
   "end": 855.33,
   "text": "دختر هجده ساله‌ی ایشون چقدر در فراق بابا می‌سوزه که براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 855.33,
   "end": 858.07,
   "text": "مثلا یه جشن تولد گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 858.07,
   "end": 861.47,
   "text": "دقیقا روز تولد دختر، پدر شهید میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 861.47,
   "end": 864.31,
   "text": "یه چند روز بعد براش جشن تولد میگیرن دختر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 864.31,
   "end": 868.13,
   "text": "میخوان شادش کنن بادکنک میزنن و عکس بابا رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 868.13,
   "end": 870.75,
   "text": "به نقل از بابا نوشتن دخترم تولدت مبارک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 870.75,
   "end": 873.55,
   "text": "وقتی وارد میشه عکس بابا رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 873.55,
   "end": 879.89,
   "text": "اینا منقلب میشه اصن جشنشون میریزه به هم و این شبانه روز در حال سوختن و اشریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 879.89,
   "end": 885.03,
   "text": "باورشون نمیشه. حتی ایشون رفیق ماست دیگه همکار ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 885.03,
   "end": 888.61,
   "text": "حالا باز نشست شده بچه با عشق و خوب و میشناسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 888.61,
   "end": 893.05,
   "text": "ایشون که همیشه دعای شهادت داشت و دعای برای شهادت می‌گفت من این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 893.05,
   "end": 897.35,
   "text": "سختی‌هایی که از این خانواده دارم میبینم در فراق پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 897.35,
   "end": 900.89,
   "text": "دیگه دارم می‌ترسم از خدا شهادت بخوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 900.89,
   "end": 905.59,
   "text": "حالا حالاها. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 905.59,
   "end": 912.15,
   "text": "دعاشون کنیم خیلی در زجر و اذیتن حتی من نمی‌دونستم این قبرهایی که در امامزاده‌ها میدن به اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 912.15,
   "end": 917.77,
   "text": "مثل اینکه الان شهید نعمتي، سردار سلامی اینا در حرم حضرت عبدالعظیم دفنن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 917.77,
   "end": 919.87,
   "text": "من فکر کردم اینا رایگانه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 919.87,
   "end": 922.11,
   "text": "دیدیم نه خیر از اینا هم پول میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 922.11,
   "end": 925.43,
   "text": "بله. گفت حرم حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 925.43,
   "end": 928.03,
   "text": "عبدالعظیم گفته اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 928.03,
   "end": 931.97,
   "text": "قبرها هشتصد میلیونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 931.97,
   "end": 935.29,
   "text": "قبرهایی که تو اون نقطه‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 935.29,
   "end": 937.59,
   "text": "نه همون داخل حرم. خودشون خواستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 937.59,
   "end": 940.89,
   "text": "خودشون خواستن داخل حرم حضرت عبدالعظیم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 940.89,
   "end": 944.59,
   "text": "بعد اول که حرم حضرت عبدالعظیم قبول نمی‌کنه میگه ما جا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 944.59,
   "end": 947.71,
   "text": "یه دونه جا داشتیم دادیم به سردار س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 947.71,
   "end": 953.95,
   "text": "سلامی. بعد خلاصه اینا خواهش می‌کنن، تمنا دفتر رو میارن نگاه می‌کنن میبینن همه قبرها پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 953.95,
   "end": 957.87,
   "text": "میان قدم می‌زنن جریان مبصوتی داره حالا وقتتون نمی‌خوام بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 957.87,
   "end": 962.35,
   "text": "معجزه‌وار یه، یه قبر رو پیدا می‌کنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 962.35,
   "end": 966.97,
   "text": "همونجایی که الان دفنه کنار شهید تهرانی‌چی و شانه‌ای و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 966.97,
   "end": 972.63,
   "text": "این‌ها اونجا دفنه یا موسوی که با شهید رئیسی بودن همونجا دفنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 972.63,
   "end": 976.17,
   "text": "اونجا میبینن مثلا خال-- عکس روش چیزی ننوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 976.17,
   "end": 979.53,
   "text": "به ایشون میگن دوباره دفتر رو بررسی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 979.53,
   "end": 982.33,
   "text": "میاد مدیر حراست حرم و میخوان اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 982.33,
   "end": 984.99,
   "text": "می‌گفت خلاصه می‌ریزن به هم باورشون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 984.99,
   "end": 988.21,
   "text": "گریه‌شون می‌گیره که ما اصن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 988.21,
   "end": 992.87,
   "text": "برای سردار سلامی هم هرچی گشتیم همین یه دونه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 992.87,
   "end": 997.95,
   "text": "تازه کسای دیگه رو هم می‌خواستیم دفن کنیم جا نبود بردیم فرستادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 997.95,
   "end": 1001.93,
   "text": "شهرای دیگه و فلان. این خود شهید جانمایی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1001.93,
   "end": 1005.45,
   "text": "و همونجا دفنش می‌کنن. برید سر قبرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1005.45,
   "end": 1010.79,
   "text": "شهید نعمتي. البته گفت هشتصد میلیون بود حالا تا دویست میلیون به اینا تخفیف میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1010.79,
   "end": 1014.05,
   "text": "میگن ششصد میلیون. بعد اینا چک میدن طفلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1014.05,
   "end": 1021.43,
   "text": "چک میدن برای دوازده اسفند آخر امسال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1021.43,
   "end": 1026.79,
   "text": "اینا درده. اینا آدم دردش رو نمی‌دونه کجا ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1026.79,
   "end": 1031.07,
   "text": "اطلاعات سپاه بود دیگه. نه اصن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1031.07,
   "end": 1037.19,
   "text": "اصن آدم تعجب می‌کنه. دیگه این چیزا رو که دیگه باید متقبل بشن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1037.19,
   "end": 1039.21,
   "text": "بعد چقدرشون از جهت مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1039.21,
   "end": 1046.25,
   "text": "استیجاری نشستنن. خیلی از این خانواده‌های شهدا چقدر در اذیتن، چقدر در فشاره‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1046.25,
   "end": 1050.09,
   "text": "جناب آقای موذن‌زاده- خدا رحمت- دف کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1050.09,
   "end": 1053.07,
   "text": "هیچی نگرفته‌ن. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1053.07,
   "end": 1055.71,
   "text": "هم قبر-- قیمت قبرها میلیاردیه ولی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1055.71,
   "end": 1057.75,
   "text": "شهدا، خانواده شهدا- مطمئنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1057.75,
   "end": 1061.45,
   "text": "نهایت یه سنگ قبر رو از خودشون می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1061.45,
   "end": 1063.01,
   "text": "و مثلا- حالا یه بررسی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1063.01,
   "end": 1066.01,
   "text": "من هم در خصوص حضرت عبدالعظیم اینطوری فکر می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1066.01,
   "end": 1069.41,
   "text": "اما الان- ششصد یعنی از کجاش می‌گیره یه خانواده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1069.41,
   "end": 1071.49,
   "text": "خب دیگه الان چک دادن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1071.49,
   "end": 1074.05,
   "text": "همین امروز اومد اینجا گفت چک دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1074.05,
   "end": 1077.37,
   "text": "اینا درد‌هاییه که آدم نمی‌دونه اینا رو کجا ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1077.37,
   "end": 1081.99,
   "text": "بعد میگن خانواده شهدا خوردن، بردن، امتیاز چی گرفتن فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1081.99,
   "end": 1084.99,
   "text": "شاید توجه داشته باشید ساوجی بودن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1084.99,
   "end": 1088.67,
   "text": "ساوجی. اونجا رو خیلی بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1088.67,
   "end": 1092.71,
   "text": "زده بود- نه تو س-- اون سعول، سعول رو که به شدت زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1092.71,
   "end": 1096.97,
   "text": "فراج آره. فراج‌ها فکر کنم سهمیه گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1096.97,
   "end": 1099.67,
   "text": "نه، ایشون مأمور بوده اون روز اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1099.67,
   "end": 1103.97,
   "text": "خود ایشون که بچه‌های سپاه بوده ولی اون روز مأمور بوده میره اونجا که-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1103.97,
   "end": 1107.39,
   "text": "برای کاری آره، بله. رفته اونجا طفلی خواسته حقوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1107.39,
   "end": 1109.87,
   "text": "همکارا رو از سیستم وارد کنه و بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1109.87,
   "end": 1111.41,
   "text": "بهش میگن بیا برو میخوام بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1111.41,
   "end": 1114.47,
   "text": "گفته بذار حقوق بچه‌ها رو بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1114.47,
   "end": 1118.23,
   "text": "در حالی که حقوق بچه‌ها-- ولی تا تخلیه شده بوده ساختمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1118.23,
   "end": 1123.23,
   "text": "داشته حقوق بچه‌ها رو واریز می‌کرده از عشق اینکه بچه‌ها زودتر به حقوقشون برسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1123.23,
   "end": 1128.73,
   "text": "می‌کوبن. انشاالله به زودی از زود شاهد نابودی اسرائیل باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1128.73,
   "end": 1132.37,
   "text": "اللهم باریک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1132.37,
   "end": 1134.17,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1134.17,
   "end": 1136.79,
   "text": "نثار همه شهدا مخصوصا شهید نعمتي صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1136.79,
   "end": 1138.53,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}