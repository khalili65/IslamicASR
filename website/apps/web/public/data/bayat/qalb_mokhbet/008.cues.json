 "chapters": [
  {
   "index": 0,
   "title": "## تطهیر لباس و بدن از بول و غساله",
   "start": 11.6,
   "end": 88.84
  },
  {
   "index": 1,
   "title": "## لب و قشر؛ ظاهر و باطن",
   "start": 88.84,
   "end": 311.7
  },
  {
   "index": 2,
   "title": "## دهان جسم و دهان روح؛ الهام کنار درخت",
   "start": 311.7,
   "end": 441.3
  },
  {
   "index": 3,
   "title": "## فرار از شنیدن حکمت",
   "start": 441.3,
   "end": 471.96
  },
  {
   "index": 4,
   "title": "## عالم خیال و عقل",
   "start": 471.96,
   "end": 678.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 7.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.84,
   "end": 11.6,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 15.54,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.54,
   "end": 18.76,
   "text": "اگر چنانچه قطره ای بل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.76,
   "end": 21.58,
   "text": "یا ادرار بر لباس یا بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.58,
   "end": 24.32,
   "text": "بپاچه چگونه پاک میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.32,
   "end": 27.98,
   "text": "خب در هر حال اولین کاری که باید کرد رفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.98,
   "end": 30.28,
   "text": "یا ازاله نجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.28,
   "end": 33.66,
   "text": "بعد از برطرف شدن عین نجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 33.66,
   "end": 37.92,
   "text": "اگر آب کور بود یک بار شستشو میخواد، قلیل بود دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.92,
   "end": 40.46,
   "text": "لکن م-نکته ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.46,
   "end": 45.14,
   "text": "قابل تحمل هست این هستش که خب اگر بدن رو شستشو میدیم همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 45.14,
   "end": 50.86,
   "text": "آبو که ریختیم به همه محل نجاست برخورد کرد تمام پاک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.86,
   "end": 54.38,
   "text": "اما اگر لباس و این چیزها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.38,
   "end": 58.12,
   "text": "شستشو داده میشه باید غساله گرفته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.12,
   "end": 62.12,
   "text": "غساله آب درون لباس یا فرش اینها رو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.12,
   "end": 72.48,
   "text": "به این صورت که وقتی آب رو ریختیم و در کل محل نجس شده آب همه جا رو فرا گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.48,
   "end": 75.7,
   "text": "آخر سر یا با دست باید فشار بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.7,
   "end": 80.14,
   "text": "یا اون پارچه، اون فرش هرچی هستو تکون بدیم در آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.14,
   "end": 83.18,
   "text": "به گونه ای که آب درونش حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.18,
   "end": 85.9,
   "text": "به اون آب درونشو میگن غسـ-- غساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.9,
   "end": 88.84,
   "text": "اون باید خارج بشه. اون موقع پاک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.84,
   "end": 96.94,
   "text": "در خصوص حساسیتی که ما داریم نشون میدیم به قر-- جریان قلب و درون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.94,
   "end": 105.12,
   "text": "توجه بفرمایید به دعایی که تو صحیفه ثانیه سجادیه امام سجاد سلام الله علیه به خدا عرض میکنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.12,
   "end": 110.76,
   "text": "اللهم ارزقنی عقلا کاملا تا میرسن به لبا راجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.76,
   "end": 118.28,
   "text": "البته این در زیار-- در دعای عالیة المزامین هم وارد شده این درخواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.28,
   "end": 122.86,
   "text": "که پیامبر اعظمی شهر اسلام هم فرمودن ما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.86,
   "end": 127.46,
   "text": "قشری داریم انسان یه لبی داره و یه قشری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.46,
   "end": 132.0,
   "text": "قشر اون همین ظاهرشه و لبش باطنش رو تشکیل میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.0,
   "end": 140.74,
   "text": "که اگر کسی بین ظاهرش یا قشر ظاهریش و اون باطنش یا لبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.74,
   "end": 147.78,
   "text": "اختلافی وجود داشته باشه یعنی ظاهر خوبی داشته باشه ظاهراً جسدش خشوع داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.78,
   "end": 154.04,
   "text": "اما قلبش یا باطنش یا لبش بدون خشوع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.04,
   "end": 157.12,
   "text": "یا اون لب راجه‌ش اون موقع این نشانه نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.12,
   "end": 159.68,
   "text": "البته بعضیا اشتباها میان خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.68,
   "end": 162.54,
   "text": "میزنن ظاهر رو خراب میکنن مثل باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.54,
   "end": 166.68,
   "text": "اما این اشتباهه. لکن ظاهر درسته باطن رو باید درست کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.68,
   "end": 169.76,
   "text": "بعد این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.76,
   "end": 171.82,
   "text": "ماهیچه ما قلب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.82,
   "end": 173.26,
   "text": "و ما از این جهت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.26,
   "end": 177.34,
   "text": "یک سالی هست رجوع کردیم به آیات قرآن که پیرامون موضوع قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.34,
   "end": 182.64,
   "text": "است چون ماهصل وجود ما هنگام رفتن از این دنیا قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.64,
   "end": 185.06,
   "text": "احساس کنید که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.06,
   "end": 191.06,
   "text": "نوار قلبی وصل کردن به خودتون چطوری نوسانات حال قلب رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.06,
   "end": 194.54,
   "text": "ما نوار قلبمون رو وصل کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.54,
   "end": 202.76,
   "text": "به دستگاه قرآن، به آیات قرآن داریم بررسی میکنیم وضعیت و کیف و کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.76,
   "end": 205.32,
   "text": "قلبمون رو که به چه شکل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.32,
   "end": 211.36,
   "text": "حالا رسیدیم از حدود شصت نوع قلبی که در قرآن بیان شده به قلب مخبت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.36,
   "end": 214.96,
   "text": "یکی دیگه از نشونه‌های اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.96,
   "end": 218.88,
   "text": "در آیه سی و پنج سوره حجر به زیبایی بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.88,
   "end": 221.72,
   "text": "البته انتهای آیه سی و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.72,
   "end": 223.96,
   "text": "خدای منّان می فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.96,
   "end": 230.32,
   "text": "و بشر المخبتین. پیغمبر بشارت بده به اهل اخبات اونایی که دارای قلب مخبت هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.32,
   "end": 233.84,
   "text": "بعد در ابتدای آیه سی و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.84,
   "end": 240.0,
   "text": "نشانه اونهایی که به حالت اخبات رسیدن رو اول این چنین چهار تا نشونه خدا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.0,
   "end": 243.2,
   "text": "اول می فرماید الذین اذا ذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.2,
   "end": 247.5,
   "text": "وجلت قلوبهم. اینا کسانی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.5,
   "end": 249.96,
   "text": "به محض اینکه یاد خدا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.96,
   "end": 253.78,
   "text": "پیششون اینها دارای قلب وجل هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.78,
   "end": 256.78,
   "text": "قلبشون مضطرب میشه، نه مضطرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.78,
   "end": 259.04,
   "text": "در بحث قلب وجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.04,
   "end": 262.76,
   "text": "ما این آیه رو مفصل توضیح دادیم که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.76,
   "end": 269.08,
   "text": "حدود بیست نوع ذکر رو هم ما از آیات استخراج کردیم که به چه چیزهایی ذکر گفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.08,
   "end": 271.24,
   "text": "حالا اینجا مطلق ذکر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.24,
   "end": 274.36,
   "text": "اذا ذكر الله وجلت قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.36,
   "end": 276.3,
   "text": "نشانه‌شون اینه که بی تفاوت نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.3,
   "end": 277.96,
   "text": "میشه انسان خودشم بسنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.96,
   "end": 281.52,
   "text": "همین الان آیات قرآن که قرائت میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.52,
   "end": 285.72,
   "text": "اذان گفته میشه، نماز که ولا ذكر الله الاكبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.72,
   "end": 292.84,
   "text": "عرض شود. همین بیان معارف، شنیدن این حقایق، اینها هم ذکر خدا و اهل بیتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.84,
   "end": 297.74,
   "text": "آیا اینها در قلب ما چه احساسی ایجاد می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.74,
   "end": 301.96,
   "text": "اگر بی‌تفاوتیم خب نشانه خطر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.96,
   "end": 303.92,
   "text": "نشانه مریض دلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.92,
   "end": 306.06,
   "text": "اما اگر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.06,
   "end": 311.46,
   "text": "تأثیر می‌گیره به هر مقدار که متأثر میشه نشانه امیدواری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.46,
   "end": 321.74,
   "text": "حالا این ذکر به قدری مهمه که ببینید ما در فک خودمون، در سر و صورت خودمون دهانی داریم که باهاش جسم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.74,
   "end": 323.86,
   "text": "تغذیه می‌کنیم. دهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.86,
   "end": 327.66,
   "text": "قشر ما و جسم ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.66,
   "end": 333.4,
   "text": "آآآ همچنین روح ما هم دهانی دارد که از طریق اون باید تغذیه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.4,
   "end": 338.22,
   "text": "ببینید خدا حفظ کنه علامه حسن زاده رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.22,
   "end": 342.34,
   "text": "حالا اینا که میگن داستان بگو ما درست بفهمیم دقت کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.34,
   "end": 345.78,
   "text": "که علامه حسن زاده می فرمودن که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.78,
   "end": 350.66,
   "text": "رفتم یه روز کنار یه درختی قرار گرفتم دقت می کردم به این درخت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.66,
   "end": 353.12,
   "text": "ازش برداشتی بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.12,
   "end": 355.3,
   "text": "به حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.3,
   "end": 359.32,
   "text": "هستی توجه کنم. علم و معرفتم بیشتر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.32,
   "end": 367.06,
   "text": "و همونطور که به دقت نگاه می‌کردم یه حیوونی اومد بین من و درخت حائل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.06,
   "end": 372.12,
   "text": "یه لحظه دقت کردم دیدم منم و حیوان و چهارپای و درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.12,
   "end": 377.96,
   "text": "بعد همونجا به قلبم این چنین الهام شد که ببین این حیوان پوزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.96,
   "end": 381.52,
   "text": "افقیه، دهانش افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.52,
   "end": 384.14,
   "text": "محلی که ازش تغذیه می‌کنه افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.14,
   "end": 387.96,
   "text": "نه مطلقاً به سمت بالاست، نه مطلقاً به سمت پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.96,
   "end": 392.56,
   "text": "اما اون درخت دهانش در خاک قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.56,
   "end": 397.36,
   "text": "دهانش از زمین داره تغذیه می‌کنه، از ریشه‌ها تغذیه می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.36,
   "end": 401.56,
   "text": "پاهاش به سمت آسمونه. ببین دیگه عالم چجوری ذره‌بین میذاره دقت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.56,
   "end": 404.94,
   "text": "ما که نمی‌دونستیم که. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.94,
   "end": 408.26,
   "text": "اما انسان تنها موجودیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.26,
   "end": 410.76,
   "text": "سرش به سمت آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.76,
   "end": 415.04,
   "text": "یعنی در حال قيامه. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.04,
   "end": 420.06,
   "text": "اینکه سرش به سمت آسمونه نشون میده که رزقش رو باید از آسمان بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.06,
   "end": 423.7,
   "text": "چون محل تغذیه‌ش چه جسمی، چه روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.7,
   "end": 425.94,
   "text": "در سرش قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 425.94,
   "end": 428.92,
   "text": "اینا نکاتیه. به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.92,
   "end": 435.1,
   "text": "ما همون گونه که از دهانمون که در سر قرار گرفته تغذیه جسم می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.1,
   "end": 439.54,
   "text": "از گوشمون که دهان روحمون هست باید تغذیه روحی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.54,
   "end": 444.98,
   "text": "اونم با شنیدن. متأسفانه اشکال ما برمی‌گرده به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 444.98,
   "end": 446.64,
   "text": "خیلی اهل شنیدن نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.64,
   "end": 450.18,
   "text": "حوصله شنیدن حکمت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.18,
   "end": 452.78,
   "text": "من بارها و بارها انتخاب اینو امتحان کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.78,
   "end": 455.34,
   "text": "وقتی وارد یه جمعی میشم همه هم خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.34,
   "end": 458.64,
   "text": "مشغول بگو بخند، صفا همینجوری یه گرده‌ای گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.64,
   "end": 462.62,
   "text": "به محض اینکه شروع می‌کنی یه حرف خوب زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.62,
   "end": 464.7,
   "text": "آقا یه نکته معرفتی بگم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.7,
   "end": 467.68,
   "text": "آقا امام صادق سلام الله علیه اینو فرمود، آقا آیه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.68,
   "end": 469.4,
   "text": "یه دفعه می‌بینی آقا کاری ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.4,
   "end": 471.96,
   "text": "التماس دعا. همین می‌خوان فرار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.96,
   "end": 476.8,
   "text": "معمولاً این چنینه که ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.8,
   "end": 478.4,
   "text": "فرار می‌کنیم از شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.4,
   "end": 481.38,
   "text": "عادت نکردیم. گوش جانمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.38,
   "end": 485.04,
   "text": "به حرف خوب بدهکار نیست، توجه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.04,
   "end": 489.38,
   "text": "خدا می‌دونه که من همین صحبت‌هایی که هر روز به فضل الهی ارائه میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.38,
   "end": 492.32,
   "text": "بعضاً میشه سه ساعت، چهار ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.32,
   "end": 497.84,
   "text": "دیگه حداقل یک ساعت وقت می‌گذاریم به فضل الهی که بفهمیم چی داریم می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.84,
   "end": 502.92,
   "text": "وقت شما تلف نشه. به هر حال جان شما داره تغذیه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.92,
   "end": 505.56,
   "text": "و باید بدونید بالاخره چی می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.56,
   "end": 508.56,
   "text": "و اینایی هم که معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.56,
   "end": 512.92,
   "text": "دقت بفرمایید این نکته رو. معمولاً این عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.92,
   "end": 515.42,
   "text": "توی عالم خیال گیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.42,
   "end": 520.92,
   "text": "ببینید نکته‌ای بگم ما باید سعی کنیم خودمون رو حداقل به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.92,
   "end": 525.72,
   "text": "عقل برسونیم. خب می‌دونید حواس ظاهریه است بعد عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.72,
   "end": 529.76,
   "text": "یعنی میشه گفت همون عالم ناسوت و طبیعت و حواس ظاهریشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.76,
   "end": 532.6,
   "text": "حس ماست. بعدش میره تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.6,
   "end": 537.2,
   "text": "عالم خیال و بعد عالم ذهن و وهم و بعدش عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.2,
   "end": 539.22,
   "text": "ما وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.22,
   "end": 546.62,
   "text": "یه کلی رو، امهات رو درک می‌کنیم، مطالب علمی رو می‌خوایم بفهمیم، عقلمون باید اینجا کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.62,
   "end": 549.24,
   "text": "عقل معمولاً میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.24,
   "end": 551.62,
   "text": "از طریق قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.62,
   "end": 556.24,
   "text": "عکس می‌گیره. قوه خیال در حقیقت مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 556.24,
   "end": 559.12,
   "text": "دوربین عکسبرداریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.12,
   "end": 561.74,
   "text": "برای فهم عقل و برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.74,
   "end": 564.28,
   "text": "کلی‌سازی مطالب عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.28,
   "end": 568.46,
   "text": "برای درک و فهم بهتر عکسبرداری می‌کنه از همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.46,
   "end": 573.48,
   "text": "یا یک وجه دیگه‌ای که مثال دیگه‌ای که زدن اینکه قوه خیال مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 573.48,
   "end": 576.98,
   "text": "آینه‌ایست که اگر روش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 576.98,
   "end": 579.84,
   "text": "غبار گرفته باشه عقل نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.84,
   "end": 582.62,
   "text": "ازش استفاده کنه و بفهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.62,
   "end": 584.62,
   "text": "و تو معقولات گیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.62,
   "end": 587.52,
   "text": "اما اگر زلال باشه و بتونه ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.52,
   "end": 590.12,
   "text": "اون موقع همه چی رو می‌تونه عقل درک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.12,
   "end": 592.62,
   "text": "با مسائل علمی راحت کنار میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.62,
   "end": 595.26,
   "text": "البته اون چیزی که غبار می‌ریزه روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 595.26,
   "end": 598.62,
   "text": "غبار می‌گیره روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.62,
   "end": 600.96,
   "text": "قوه خیال رو در سه جنبه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.96,
   "end": 605.94,
   "text": "یکی معتقدات یعنی اعتقادات انسان باید درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.94,
   "end": 610.0,
   "text": "نباشه غبار آلود می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.0,
   "end": 612.06,
   "text": "عالم خیال انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 612.06,
   "end": 619.78,
   "text": "و نمی‌تونه درست عکسبرداری بکنه و عقل از کار می‌افته یا تحت الشعاع قرار می‌گیره و اذیت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.78,
   "end": 623.04,
   "text": "یکی در بحث حسن ظنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.04,
   "end": 627.22,
   "text": "باید قل اونجا قوه خیال حسن ظن داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.22,
   "end": 630.98,
   "text": "سوء ظن مثل اون ظلمت و مثل اون غبار میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.98,
   "end": 633.72,
   "text": "خوش دل باید باشه. یکی هم در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.72,
   "end": 636.58,
   "text": "آمال و رزوهاست که باید روش کار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 636.58,
   "end": 638.96,
   "text": "به هر حال اگر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.96,
   "end": 641.98,
   "text": "درست شد، اون موقع عقل می‌تونه درک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.98,
   "end": 650.56,
   "text": "معمولاً کسی که یک مطلب علمی رو می‌شنوه و متوجه نمیشه، سختشه، درک نمی‌کنه، برخورد می‌کنه با ذهنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.56,
   "end": 652.44,
   "text": "میگه آقا یه مثال بزن ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.44,
   "end": 655.24,
   "text": "این معلومه تو قوه خیالش گیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 655.24,
   "end": 657.62,
   "text": "هنوز به قوه عقلش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 657.62,
   "end": 660.68,
   "text": "باید سعی کنیم تلاش کنیم بلکه انشاالله به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 660.68,
   "end": 662.92,
   "text": "برسیم به عالم عقل وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 662.92,
   "end": 667.26,
   "text": "تازه بعد از اون راه‌ها داریم، سیرها در پیش داریم که بعدش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 667.26,
   "end": 671.1,
   "text": "عالم قلب و بعد روح و بعد سر و جان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.1,
   "end": 674.12,
   "text": "اینها باید همینطوری عوالم طی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 674.12,
   "end": 678.22,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه. به برکت صلوات بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}