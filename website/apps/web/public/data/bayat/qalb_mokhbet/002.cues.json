 "chapters": [
  {
   "index": 0,
   "title": "## طهارت دهان با روکش و پرکردن دندان",
   "start": 12.3,
   "end": 124.98
  },
  {
   "index": 1,
   "title": "آیهٔ پنجاه و چهار را داشتیم نگاه می‌کردیم که می‌فرمود:",
   "start": 124.98,
   "end": 207.88
  },
  {
   "index": 2,
   "title": "## جنگ‌های مراحل سلوک",
   "start": 207.88,
   "end": 271.42
  },
  {
   "index": 3,
   "title": "بعد اگر اینجا پیروز شد می‌رود به مرحلهٔ بعدی که تقوا، مرحلهٔ تقوی که می‌خواهد متقی بشود. اینجا جنگ است:",
   "start": 271.42,
   "end": 351.3
  },
  {
   "index": 4,
   "title": "## اشراق و مشاء و رواق؛ سکوت استاد",
   "start": 351.3,
   "end": 400.66
  },
  {
   "index": 5,
   "title": "## اشراق در نماز؛ نور در ذکر",
   "start": 400.66,
   "end": 665.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 4.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.44,
   "end": 8.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.1,
   "end": 12.3,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 14.62,
   "text": "استفسار دیگری که در باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.62,
   "end": 17.9,
   "text": "طهارت از رهبر عزیز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.9,
   "end": 20.16,
   "text": "اینه که خب میدونید وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.16,
   "end": 25.74,
   "text": "دهان دا-- فضای داخل دهان نجس میشه نیازی به شستشو با آب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.74,
   "end": 29.06,
   "text": "همین که ازاله نجاست صورت بگیره دهان پاک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.06,
   "end": 32.78,
   "text": "یعنی اون خون یا نج-نجاستی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.78,
   "end": 37.24,
   "text": "دهان واقع شده اون رفع شد، برطرف شد دیگه دهان پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.24,
   "end": 40.7,
   "text": "نیاز نیست که حتما با آب شستشو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.7,
   "end": 45.64,
   "text": "اما سؤال اینه که حالا اینایی که دندون پر کردن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.64,
   "end": 51.72,
   "text": "روکش کردن دندونشونو و این روکش و اون موادی که دندون باهاش پر شده جدا نمیشه که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.72,
   "end": 55.04,
   "text": "منفک نمیشه از دندان که موقع مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.04,
   "end": 59.8,
   "text": "دهان نجس میشه نمیتونی اونو جدا کنی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.8,
   "end": 63.42,
   "text": "اون یه جرمیه متصل شده به دندان انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.42,
   "end": 66.36,
   "text": "چه کنیم اینجا؟ اینجا هم همون حکمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.36,
   "end": 75.04,
   "text": "که با ازاله نجاست دهان پاکه، محکومه به طهارته یا نیازه که با آب شستشو بشه چون مواد خارجی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.04,
   "end": 78.24,
   "text": "رهبری-- ببین کلاً فقها ورود به مصداق نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.24,
   "end": 80.26,
   "text": "مصداق رو میگن خودت باید پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.26,
   "end": 88.98,
   "text": "حکم کلی اینه. اگر اون موادی که به دندون اضافه شده یا روکش شده ایناها جزء دندون تو حساب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.98,
   "end": 91.62,
   "text": "یعنی بگن آقا این دندون طرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.62,
   "end": 95.54,
   "text": "ها؟ یعنی جزء دندون طبیعیت حساب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.54,
   "end": 100.74,
   "text": "اون موقع آقا می‌فرمود نخیر، دیگه نیازی به آب کشیدن هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.74,
   "end": 106.28,
   "text": "اما نه اگر جزء دندون حساب نشه بگن نه این یک چیزیه به جز دندان طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.28,
   "end": 110.32,
   "text": "اون موقع باید با آب داخل دهان رو بشوری تا پاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.32,
   "end": 114.92,
   "text": "آیه پنجاه و چهار سوره حجر رو داشتیم نگاه می‌کردیم با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.92,
   "end": 121.64,
   "text": "که می‌فرمود \"وليعلم الذي أوت العلم أنه الحق من ربك فيؤمن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.64,
   "end": 124.98,
   "text": "فتخبط له قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.98,
   "end": 131.46,
   "text": "در این آیه بحث قلب مخبط رو خدای منان به زیبایی تمام بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.46,
   "end": 135.64,
   "text": "البته سیری در این آیه داره که بعداً باید صحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.64,
   "end": 141.96,
   "text": "که از علم می‌بره به سمت ایمان، سپس اخبط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.96,
   "end": 145.6,
   "text": "و ما عرض کردیم که قلب مخبط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.6,
   "end": 153.82,
   "text": "قلبی‌ست که از مرحله اسلام به ایمان رسیده، از ایمان به تقوا رسیده، از تقوا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.82,
   "end": 157.2,
   "text": "احسان و سپس به اخبط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.2,
   "end": 160.4,
   "text": "اینو توضیح دادیم. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.4,
   "end": 163.04,
   "text": "کاربردیش این شکلی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.04,
   "end": 169.9,
   "text": "یعنی در حقیقت انسان دائماً در یک جنگی‌ست بین درون و بیرون خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.9,
   "end": 173.14,
   "text": "در یک جنگی‌ست بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.14,
   "end": 178.28,
   "text": "ذلت باطنی که او رو به عز خدایی می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.28,
   "end": 180.94,
   "text": "در برابر عزت خدا احساس ذلت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.94,
   "end": 185.02,
   "text": "اصلاً همین سرتو می‌ذاری رو سجده برای اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.02,
   "end": 188.18,
   "text": "و بین عز-عزت باطنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.18,
   "end": 190.52,
   "text": "کبریا ظاهری خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.52,
   "end": 194.36,
   "text": "دوست داره دیگه جلوی دیگران سرش بلند باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.36,
   "end": 197.18,
   "text": "توجه کردید همیشه سر بلند باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.18,
   "end": 200.9,
   "text": "نمی‌تونه با ذلت باطنی‌ش کنار بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.9,
   "end": 203.1,
   "text": "این ذلت، یک جنگیه بین این دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.1,
   "end": 206.64,
   "text": "یک جنگی‌ست بین فطرت و طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.64,
   "end": 209.22,
   "text": "توجه کردید؟ در حقیقت وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.22,
   "end": 211.94,
   "text": "میره به مرحله اسلام طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.94,
   "end": 214.94,
   "text": "اسلام میاره جنگ بین کفر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.94,
   "end": 218.82,
   "text": "اسلامه دیگه. می‌خواد تسلیم بشه یا نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.82,
   "end": 220.62,
   "text": "بپوشونه رو حقو و کافر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.62,
   "end": 224.38,
   "text": "یک جنگه. اگر تونست از این جنگ بیرون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.38,
   "end": 227.58,
   "text": "و به مر-- تسلیم بشه به مرحله اسلام برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.58,
   "end": 231.14,
   "text": "عل اسلام هو التسلیم. میره به مرحله بعدی که ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.14,
   "end": 233.26,
   "text": "بازم جنگ پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.26,
   "end": 235.44,
   "text": "اینجا جنگ پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.44,
   "end": 241.36,
   "text": "بین ایمان یعنی دل دادن، اینکه انسان دل بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.36,
   "end": 248.9,
   "text": "یا بین نفاق، بین شرک، بین جنگ، بین ایمان و شرک و نفاق جنگ پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.9,
   "end": 254.24,
   "text": "که طرف اینجا چه کنه؟ کل دلش رو در اختیار بگذاره باور کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.24,
   "end": 257.2,
   "text": "یا نه ظاهراً خماراس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.2,
   "end": 261.18,
   "text": "بعد می-- حالا اینا توضیح می‌خواد ما دیگه خودتون الحمد لله اهل فضلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.18,
   "end": 265.56,
   "text": "بعد میره به ور-- اگر اینجا پیروز شد میره به مرحله بعدی که تقوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.56,
   "end": 267.72,
   "text": "مرحله تقوی که می‌خواد متقی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.72,
   "end": 270.64,
   "text": "اینجا جنگه میگه \"فألهمها فجورها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.64,
   "end": 275.0,
   "text": "وتقواها\". جنگ بین تقوا پیش میاد و فجور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.0,
   "end": 278.88,
   "text": "اینکه انسان خود نگهدار باشه، حدود رو رعایت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.88,
   "end": 283.34,
   "text": "یا نه. نمیگیم همیشه بعضی موقع‌ها یه دفعه خط قرمز هم رد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.34,
   "end": 287.18,
   "text": "دست به فجور بزنه. دست به گناهان و معصیت‌ها بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.18,
   "end": 292.04,
   "text": "اینجا دیگه خ-- اگر تونست از این مرحله از این جنگ هم به سلامت بگذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.04,
   "end": 295.52,
   "text": "و خودشو برسونه به مرحله بعدی، میرسه به مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.52,
   "end": 298.02,
   "text": "محسنین یا همون احسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.02,
   "end": 304.76,
   "text": "اینجا جنگ بین حسنه و سیئه پیش میاد که مرحله‌ش بالاتر از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.76,
   "end": 307.34,
   "text": "گاهی آقا می‌بینی نیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.34,
   "end": 310.34,
   "text": "سیئه است. نیت بد داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.34,
   "end": 314.2,
   "text": "در درون خودش بوی بدی رافته با نیت بدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.2,
   "end": 316.22,
   "text": "اینو باید سریع ازاله کنه. نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.22,
   "end": 317.92,
   "text": "خبیثه. ازاله نجاست کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.92,
   "end": 324.34,
   "text": "خب باید طهارت بگیره. حالا بر بحث‌های مربوط به سیر السلوك هست و کاری هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.34,
   "end": 328.66,
   "text": "بعد از اینجا اگر به سلامت گذشت میرسه به مرحله اخبط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.66,
   "end": 332.04,
   "text": "یعنی دیگه در درون خودش هیچ گونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.04,
   "end": 336.18,
   "text": "هیچ گونه تدبیری، هیچ گونه حرفی، هیچی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.18,
   "end": 339.22,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.22,
   "end": 343.04,
   "text": "گفتیم در بال-- اعلی مرتبه خودسازی اخبط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.04,
   "end": 346.26,
   "text": "به جاییه که دیگه تفویض محض الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.26,
   "end": 348.46,
   "text": "اصلاً جز خدا چیزی نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.46,
   "end": 352.66,
   "text": "به جایی می‌رسه که دیگه به مرحله اشراق می‌رسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.66,
   "end": 357.38,
   "text": "اشراق می‌دونید حالا این بحث اشراقیون و مشاییین و اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.38,
   "end": 360.42,
   "text": "کسایی که تو فلسفه کار کردن یا حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.42,
   "end": 364.64,
   "text": "می‌دونن که از اینجا گرفته شد که حضرت افلاطون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.64,
   "end": 369.16,
   "text": "ایشون حالا اگه شما بگید آقا چرا گفتی حضرت افلاطون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.16,
   "end": 375.18,
   "text": "چون خدا رحمت کنه سید ابن طاووس این عالم برجسته که به قول علامه طباطبایی ما سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.18,
   "end": 377.6,
   "text": "عالم شیعه داریم که تراز اولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.6,
   "end": 380.46,
   "text": "ابن فهد حلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.46,
   "end": 383.66,
   "text": "سید بحر العلوم و سید ابن طاووس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.66,
   "end": 386.56,
   "text": "سید ابن طاووس توی کتابش داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.56,
   "end": 388.58,
   "text": "افلاطون و ارسطو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.58,
   "end": 391.94,
   "text": "این دو پی-- از انبیاء خدا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.94,
   "end": 394.28,
   "text": "این دو رو پیغمبر ما یه حدیث میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.28,
   "end": 397.56,
   "text": "برای سید طاووس کسi نبو-- کم کسی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.56,
   "end": 400.66,
   "text": "در هر حال افلاطون سه نوع شاگر داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.66,
   "end": 402.36,
   "text": "حالا خلاصه عرض کنم و رد شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.36,
   "end": 406.16,
   "text": "اینایی که حکمت، حکمت خوندید یا فلسفه می‌دونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.16,
   "end": 408.68,
   "text": "اون‌هایی که در راه مشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 408.68,
   "end": 415.0,
   "text": "در حال حرکت ازش سؤال می‌کردن، استفاده می‌کردن مثل آقای بهجت دیده بودید دورش می‌خوردن از طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.0,
   "end": 417.9,
   "text": "سر مثلا خونه‌ش بیاد تا مسجد یا بالعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.9,
   "end": 420.74,
   "text": "تو راه ازش می‌پرسیدن از نفسش استفاده می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.74,
   "end": 423.1,
   "text": "اینا مشایین بودند. مشاعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 423.1,
   "end": 425.4,
   "text": "مشایی بودند در حال حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 425.4,
   "end": 428.98,
   "text": "عده‌ای رواقیون بودند. اینا می‌رفتند تو بیت طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.98,
   "end": 436.16,
   "text": "زانو می‌زدن تو حالا اتاق بیت اون حجره خاصش استفاده می‌کردن درس و بحث و جلوتر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.16,
   "end": 439.48,
   "text": "عده‌ای از همه اینا جلوتر بودند بهشون می‌گفتن اشراقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.48,
   "end": 445.14,
   "text": "اشراقیون. اینا به نحو اشراق یعنی از سکوت استاد استفاده می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.14,
   "end": 448.64,
   "text": "از سر و ضمیر و باطن استاد استفاده می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.64,
   "end": 452.02,
   "text": "طرف به مرحله اشراق می‌رسه تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.02,
   "end": 454.62,
   "text": "اخبات به مرحله اشراق می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.62,
   "end": 458.9,
   "text": "حالا اینا رو تعجب نکنیم ما هر روز داریم اینا رو درک می‌کنیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.9,
   "end": 464.16,
   "text": "یه مثال به شما بزنم. وقتی که نماز می‌خونی مثلا تو سجده و رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.16,
   "end": 467.78,
   "text": "چنان حواست جمعه، بذار رو خودمونی حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.78,
   "end": 473.3,
   "text": "حواست جمعه که داری با کی حرف می‌زنی به ذلت باطنی خودت و عز و عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.3,
   "end": 477.7,
   "text": "بی‌منتهی خدا که پی می‌بری یه لرزه‌ای یهو به تنت، به تنت، به دلت می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.7,
   "end": 480.78,
   "text": "می‌لرزي ذکر رو میگی. یه رعشه ای چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.78,
   "end": 483.66,
   "text": "یه حالت خشوعتی. اونه، اون چیز عجیب اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.66,
   "end": 488.9,
   "text": "بهش میگن اشراق. از بیرون یه نوری وارد به بدنت می‌شه، به وجودت می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.9,
   "end": 495.12,
   "text": "به باطنت می‌شه. هرکی که مثلا تسبیحات حضرت زهرا سلام الله علیها رو چرا ما داریم اینطوری میگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.12,
   "end": 497.44,
   "text": "برای اینکه ما به نحو اشراق برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.44,
   "end": 502.36,
   "text": "الله اکبر. می‌تونیم بگیم الله اکبر، الله اکبر، الله اکبر که هم که خیلی‌ها میگیم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.36,
   "end": 503.98,
   "text": "سبحان الله، سبحان الله، سبحان سبحان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.98,
   "end": 509.04,
   "text": "چی می‌فهمن؟ اما وقتی بگی الله اکبر، الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.04,
   "end": 511.96,
   "text": "اکبر، الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.96,
   "end": 515.64,
   "text": "خودتو داری می‌رسونی به اون نحوی که بفهمی چی داری میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.64,
   "end": 521.32,
   "text": "تازه ابتدای اشراق بشه. حالا بعدش دیگه سکوته البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.32,
   "end": 525.62,
   "text": "حالا یکی از بزرگان نماز که می‌خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.62,
   "end": 528.04,
   "text": "اینو شیخ جواد کربلایی می‌فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.04,
   "end": 530.94,
   "text": "من که ندیدم ایشون می‌فرمودن یکی از بزرگان اسمم نبردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.94,
   "end": 534.72,
   "text": "فرمودن نماز که می‌خوند گاهی اوقات تو نمازش حالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.72,
   "end": 539.32,
   "text": "بد می‌شد اصلاً دوباره می‌شکست نمازو از نو شروع می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.32,
   "end": 543.22,
   "text": "گفتم آخه این چه کاریه؟ فرمود چنان از خود بی‌خود می‌شم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.22,
   "end": 549.38,
   "text": "چنان اشراقات الهی به سر و ضمیر و باطنم اون نور وارد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.38,
   "end": 554.4,
   "text": "که حواس طبیعی‌م از کار می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.4,
   "end": 560.06,
   "text": "یا مثلاً در رکوع یه عالمی هفتاد بار می‌گفت سبحان تو جماعت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.06,
   "end": 562.62,
   "text": "سبحان ربی العظیم و بحمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.62,
   "end": 566.3,
   "text": "هفتاد بار. دیگه مأمومین صداشون در اومد آخه چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.3,
   "end": 570.9,
   "text": "فرمود آخه شما نمی‌دونین من هر سبحانکی میگم نوری وارد دلم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.9,
   "end": 575.12,
   "text": "هی می‌خوام بیشتر بشه. اگه شما هم می‌ذاشتید هفتصد بار می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.12,
   "end": 581.16,
   "text": "حالا ما دنبال یه آخوند بازاری می‌گردیم بیاد اداره‌مون، سازمانمون، چه می‌دونم هیئتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.16,
   "end": 583.76,
   "text": "سریع بازاری بخونه بره. سبحان الله میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.76,
   "end": 586.54,
   "text": "پاشو بریم به کارمون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.54,
   "end": 589.48,
   "text": "ولی حقش چیز دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.48,
   "end": 595.2,
   "text": "کی ما می‌خوایم به اون نحوی برسیم که ببینیم در درونمون نوری وارد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.2,
   "end": 600.32,
   "text": "خشوعی ایجاد شد، ذلتی در برابر عظمت خدا ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.32,
   "end": 602.64,
   "text": "اگر این نبود نماز، نماز نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.64,
   "end": 606.16,
   "text": "سجده و رکوع که سجده و رکوع به واقع نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.16,
   "end": 607.8,
   "text": "و ما داریم پسرفت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.8,
   "end": 610.86,
   "text": "به جایی نرسیدیم که. ما باید خودمون رو به اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.86,
   "end": 614.42,
   "text": "لذا بزرگان می‌گن این راهش سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.42,
   "end": 617.34,
   "text": "سکوت. قبل از نماز آدم من دیدم بعضیا اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.34,
   "end": 622.78,
   "text": "ثابت، دقت کردم ثابت میان پنج دقیقه، ده دقیقه قبل نماز میان اینجا می‌شینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.78,
   "end": 625.16,
   "text": "خب مطمئن باشیم اینا نمازشون بهتر از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.16,
   "end": 627.28,
   "text": "تا کسی که از پشت میز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.28,
   "end": 632.14,
   "text": "بدو، بدو، بدو بریم الان سر مو رو پرت می‌کنه یا الله، یا الله، الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.14,
   "end": 634.56,
   "text": "ما رسیدیم. رسیدیم ها جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.56,
   "end": 639.58,
   "text": "این که نشد که. ببخشید یه ذره ما به درد دلم افتادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 639.58,
   "end": 645.32,
   "text": "حالا میشه البته ما اینو چجوری با خودمون جمع کنیم که با یه سبحان الله تمومش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 645.32,
   "end": 649.92,
   "text": "این انقدر رعشه بر وجود ما می‌افته که سریع می‌خوایم فرار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.92,
   "end": 653.42,
   "text": "اینطوری توجیهش کنیم. انشاالله عاقبت بخیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.42,
   "end": 656.08,
   "text": "به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.08,
   "end": 659.8,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.8,
   "end": 665.26,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}