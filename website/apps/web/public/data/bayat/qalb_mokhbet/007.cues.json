 "chapters": [
  {
   "index": 0,
   "title": "## استفتای عسل و شیرهٔ نجس‌شده",
   "start": 10.82,
   "end": 67.8
  },
  {
   "index": 1,
   "title": "## سه راه اخبات و زیربنای طهارت",
   "start": 67.8,
   "end": 147.24
  },
  {
   "index": 2,
   "title": "آیا بهشت جنسش از چیست؟ جنس بهشت از نور است. از چه نوری؟ نور سیدالشهدا. خلقت بهشت از نور سیدالشهداست. اگر",
   "start": 147.24,
   "end": 195.22
  },
  {
   "index": 3,
   "title": "## طهارت دنیایی و وجوه ظاهری",
   "start": 195.22,
   "end": 488.66
  },
  {
   "index": 4,
   "title": "## حواس پنج‌گانه، لسان و گوش",
   "start": 488.66,
   "end": 713.56
  },
  {
   "index": 5,
   "title": "## متنجس و عین نجاست؛ خیال و مراتب بالاتر",
   "start": 713.56,
   "end": 837.82
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 3.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.28,
   "end": 7.0,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.0,
   "end": 10.82,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.82,
   "end": 13.2,
   "text": "در وادی طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.2,
   "end": 19.26,
   "text": "س-- استفتای دیگری که از رهبر عزیزمون شده اینه که اگر عسل یا شیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.26,
   "end": 24.06,
   "text": "نجاستی درش بیفته آیا قابل پاک شدن و تطهیر هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.06,
   "end": 29.02,
   "text": "جواب این هستش که اگر این عسل یا شیره یا مثال اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.02,
   "end": 32.86,
   "text": "به صورت جامد باشن جوری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.86,
   "end": 35.78,
   "text": "کسی نگاه کرد بگه این مایع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.78,
   "end": 38.74,
   "text": "وضعیت این عسل و این شیره و این‌ها جو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.74,
   "end": 41.78,
   "text": "به گونه‌ای باشه کسی نگاه کرد بگه این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.78,
   "end": 44.28,
   "text": "الان مایع، مایع نیست، جامده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.28,
   "end": 49.96,
   "text": "در این صورت همون نجاستی که افتاده توش و با یه مقدار اطرافشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.96,
   "end": 53.14,
   "text": "برداری پاکه. بقیه‌ش پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.14,
   "end": 58.66,
   "text": "اما اگر حالتی باشه که بهش بگن مایعه، این دیگه الان این عسل مایعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.66,
   "end": 60.94,
   "text": "این نبات مایعه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.94,
   "end": 65.02,
   "text": "شیره‌ی مایعه؛ اون موقع دیگه هیچ کاریش نمیشه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.02,
   "end": 67.8,
   "text": "تمامش نجسه باید بریزی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.8,
   "end": 70.52,
   "text": "در خصوص قلب مخدبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.52,
   "end": 76.92,
   "text": "عرض کردیم با توجه به اینکه ما سه تا راه حل قرآنی عرض کردیم میشه به اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.92,
   "end": 78.82,
   "text": "فقط از این سه راه رسید؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.82,
   "end": 82.44,
   "text": "تزکیه و تذکره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.44,
   "end": 88.38,
   "text": "تعلیم. و گفتیم زیربنای همه‌ی این‌ها تزکیه است یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.38,
   "end": 91.0,
   "text": "مقدمه‌ی همه‌ی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.0,
   "end": 98.42,
   "text": "طهارت است. شما اگر دقت بفرمایید از آیه‌ی بیست و سه سوره هود هم که قبلاً ملاحظه کردید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.42,
   "end": 104.44,
   "text": "به ظرافت این ب-- به این گونه بیان شده \"إن الذين آمنوا وعملوا الصالحات وأخبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.44,
   "end": 109.02,
   "text": "\"و أخبت إلى ربهم\" اونایی که این سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.02,
   "end": 117.12,
   "text": "ضلع مثلث رو تو زندگیشون لحاظ کردن، ایمان داشتن، عمل صالح داشتن و اخبات که عرض کردیم جمع بین خضوع و خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.12,
   "end": 122.86,
   "text": "و اطمینان درونه. کسی این‌ها، این سه تا رو داشت قطعاً چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.86,
   "end": 127.0,
   "text": "\"أولئک\" این‌ها \"أصحاب الجنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.0,
   "end": 131.9,
   "text": "هم فيها خالدون\". تأکید هم می‌کنن که دیگه همیشه تا ابد اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.9,
   "end": 133.96,
   "text": "و من از شما سؤال می‌کنم آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.96,
   "end": 136.48,
   "text": "بهشت جنسش از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.48,
   "end": 138.8,
   "text": "جنس بهشت از نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.8,
   "end": 141.04,
   "text": "از چه نوری؟ نور سید و شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.04,
   "end": 143.62,
   "text": "خلقت بهشت از نور سید و شهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.62,
   "end": 147.98,
   "text": "اگر \"لا يمسه إلا المطهرون\" است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.98,
   "end": 154.08,
   "text": "و ابی عبدالله و عالم نور و ملکوت رو نمیشه به جز طهارت مس کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.08,
   "end": 157.76,
   "text": "پس بهشت رو هم به جز طهارت نمیشه مس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.76,
   "end": 163.44,
   "text": "پس زیربنای حتی بهشت رفتن هم جز طهارت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.44,
   "end": 171.62,
   "text": "لذا اینجا اینکه میگه \"أخبت إلى ربهم\" اصلاً \"أخبت\" اومده کنار ایمان و عمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.62,
   "end": 177.64,
   "text": "کأنّ این تو-- این تأکید رو بکنه که وقتی ایمان تو ایمان کارساز است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.64,
   "end": 179.9,
   "text": "مگه ایمان غیر کارساز هم داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.9,
   "end": 183.88,
   "text": "بله. قرآن فرمود \"يا أيها الذين آمنوا آمنوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.88,
   "end": 187.52,
   "text": "وقتی عمل تو عمل کارساز است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.52,
   "end": 194.16,
   "text": "که در وادی اخبات وارد شده باشی که زیربناش اینجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.16,
   "end": 199.68,
   "text": "طهارته. حالا طهارت دنیایی درباره‌ش حرف زده شده، کتاب‌ها نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.68,
   "end": 203.02,
   "text": "یعنی ما به زلصقاة عرض کنم اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.02,
   "end": 205.26,
   "text": "یه چقدر الان سه چهار ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.26,
   "end": 210.14,
   "text": "با هم داریم حرف‌های اهل بیت رو بررسی می‌کنیم و آیات قرآن رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.14,
   "end": 216.5,
   "text": "عین چهار سال دیگه ما فقط در طهارت حرف بزنیم حرف باید پیاده بشه و زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.5,
   "end": 218.9,
   "text": "کتاب‌ها نوشتن، صحبت‌ها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.9,
   "end": 223.06,
   "text": "فقط یکی از بزرگان علمای دینی چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.06,
   "end": 225.96,
   "text": "سخنرانی پرمایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.96,
   "end": 229.12,
   "text": "پیرامون طهارت به صورت علمی ارائه داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.12,
   "end": 231.8,
   "text": "بزرگان کتاب‌ها نوشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.8,
   "end": 236.16,
   "text": "رساله‌ها نوشتن. حالا من چند وجهش رو مختصر عرض می‌کنم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.16,
   "end": 240.5,
   "text": "نمیخوام ورود کنیم به این قصه فقط در، در همون همین حد که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.5,
   "end": 244.28,
   "text": "اهمیتشو بدونیم و الا بحث ما چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.28,
   "end": 246.92,
   "text": "طهارت که زیربنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.92,
   "end": 254.06,
   "text": "به هر حال عبادیت ما و زیر بیان، زیربنای رسیدن به بهشت ما و قلب مخدته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.06,
   "end": 256.54,
   "text": "در چند وجه باید بررسی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.54,
   "end": 259.64,
   "text": "یکی طهارت باط-- ظاهری انسانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.64,
   "end": 261.78,
   "text": "یکی طهارت باطنی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.78,
   "end": 263.58,
   "text": "تو هر کدومش وجوهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.58,
   "end": 269.52,
   "text": "مثلاً طهارت ظاهری یه وجهش برمی‌گرده به لباس انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.52,
   "end": 272.68,
   "text": "لباس-- بدن انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.68,
   "end": 276.34,
   "text": "و این‌ها احکام شرعی دارن البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.34,
   "end": 278.54,
   "text": "و حدود اون‌ها باید رعایت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.54,
   "end": 283.48,
   "text": "کما اینکه ما بدون طهارت حق نداریم با لباس نجس حق نداریم نماز بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.48,
   "end": 285.56,
   "text": "بدون وضو حق نداریم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.56,
   "end": 293.62,
   "text": "خود همون وضو کلی درش اسرار هست که من از یکی از بزرگان علما بلکه از چند تاشون سؤال کردم خودم به شخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.62,
   "end": 297.42,
   "text": "چه کنیم نمازمون خوب بشه؟ فرمودن توجه به وضو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.42,
   "end": 300.62,
   "text": "وضو البته درست عربیش وزوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.62,
   "end": 303.32,
   "text": "وزو وقتی تمام شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.32,
   "end": 305.72,
   "text": "میشه وضو که نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.72,
   "end": 308.48,
   "text": "حالا اینا وجوهی رو بیان کردن بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.48,
   "end": 311.52,
   "text": "در وضو باید حواسمون باشه ما داریم اصلاً چی کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.52,
   "end": 315.58,
   "text": "در یک حدیثی پیامبر عظیم الشأن اسلام فرمودن سر اینکه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.58,
   "end": 319.08,
   "text": "صورتتو می‌شوری برمی‌گرده به جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.08,
   "end": 325.76,
   "text": "اینکه آدم نبی الله رو کرد به گندم ممنوعه، به شجرة ممنوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.76,
   "end": 328.96,
   "text": "رو کرد. لذا رو تو می‌شوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.96,
   "end": 331.28,
   "text": "آدم با دست اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.28,
   "end": 333.44,
   "text": "دست درازی کرد که اون رو بچینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.44,
   "end": 336.3,
   "text": "طمع کرد با دستش. دستتو می‌شوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.3,
   "end": 338.16,
   "text": "با پا به سمت اون حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.16,
   "end": 340.68,
   "text": "پاتو می‌شوری. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.68,
   "end": 346.3,
   "text": "ماحسل و حالا اون خوشه‌ی چیده شده رو بر سرش نهاد و برا هواس برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.3,
   "end": 349.5,
   "text": "به سرت می‌کشی. ببینید این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.5,
   "end": 351.48,
   "text": "هر کدوم وجوهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 351.48,
   "end": 353.14,
   "text": "یعنی اسراری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.14,
   "end": 358.94,
   "text": "حالا این یک چیزی که پیغمبر فرموده درش هزاران اسرار اهل سر بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.94,
   "end": 363.48,
   "text": "تا طهارت نباشه، تا ما دست نشوییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.48,
   "end": 365.74,
   "text": "دست شستن نه یعنی فقط ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.74,
   "end": 370.0,
   "text": "دست نشوییم از هر آنچه که منطقه‌ی ممنوعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.0,
   "end": 375.12,
   "text": "ما دستمون به دامان خدا و ملکوت و اماممون نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.12,
   "end": 378.2,
   "text": "همینطور حالا تو بحث‌های لباس و بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.2,
   "end": 383.5,
   "text": "و که لباس مثلاً حضرت امام رحمت‌الله علیه میگن یه لک می‌افتاد رو لباسش سریع عوض می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.5,
   "end": 385.82,
   "text": "این دیگه بحث اسراف نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.82,
   "end": 388.8,
   "text": "یا همون لک رو می‌شست یا کل لباس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.8,
   "end": 393.14,
   "text": "چون حدیث پیغمبر فرمودن که لباساتون رو تمیز نگه دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.14,
   "end": 396.98,
   "text": "گفتن چرا یا رسول الله؟ البته در حد درک و فهم اونا گفته و لو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.98,
   "end": 401.24,
   "text": "عالمی باز همین جا حرف هست و من شنیدم که به شما میگم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.24,
   "end": 403.42,
   "text": "خدا شاهد اغراق نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.42,
   "end": 407.96,
   "text": "پیغمبر فرموده بعدش رو عرض کنید پیغمبر فرمود این لباس دیگه ذکر نمی‌تونه بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.96,
   "end": 410.84,
   "text": "کثیفه طهارت نداره. ذکر نمی‌تونه بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.84,
   "end": 415.3,
   "text": "تو منعش کردی و اون که ذکر نمیگه که امّا تو نمی‌تونی نفس بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.3,
   "end": 418.62,
   "text": "بدنت اگر کثیف باشه نمی‌تونه ذکر بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.62,
   "end": 421.74,
   "text": "حالا این وجوه متعددی تو بحث‌های ظاهریه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.74,
   "end": 425.22,
   "text": "تو غذا غذایی که می‌خوری غذای جسمته باید پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.22,
   "end": 429.86,
   "text": "هم پاکی ظاهری داشته باشه که حلال باشه و طیب باشه که قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.86,
   "end": 434.14,
   "text": "فرق رزق حلال و واسع و طیب رو تعریف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.14,
   "end": 436.94,
   "text": "هم باید عرض شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.94,
   "end": 439.86,
   "text": "طهارت باطنی داشته باشه اون غذا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.86,
   "end": 444.82,
   "text": "طهارت ظاهریه. کار کردن طهارت داره، حرف زدن طهارت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.82,
   "end": 447.58,
   "text": "یعنی کار کردن چه-چگونه طهارت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.58,
   "end": 452.16,
   "text": "میگن که کارگر اگر بیش از حدی که اسلام تعریف کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.16,
   "end": 455.14,
   "text": "کار کنه، اون کارش طهارت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.14,
   "end": 458.96,
   "text": "اگر کمتر کار کنه تنبلی کنه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.96,
   "end": 461.02,
   "text": "عدم طهارت در کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.02,
   "end": 464.5,
   "text": "حالا اینا رو تعریف شده، پیاده کردن مطالب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 464.5,
   "end": 467.64,
   "text": "من فقط می‌خوام تشنه بشید ببینید عجب چه وجوهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.64,
   "end": 469.58,
   "text": "یا حتی غذا خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 469.58,
   "end": 474.54,
   "text": "اگر کسی گرسنه نیست و غذا می‌خوره، این خوردنش طهارت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.54,
   "end": 477.96,
   "text": "اگر کسی گرس-- سیر شده باز داره می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.96,
   "end": 480.86,
   "text": "باز این طهارت نداره. می‌زنه درون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 480.86,
   "end": 486.5,
   "text": "بیچاره می‌کنه، درون رو از بین می‌بره، اون درون مایه رو نفس رو خفه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.5,
   "end": 492.16,
   "text": "تو نطفه خفه می‌کنه. حالا این بحث‌های ظاهریه بعد میره تو باطن حواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.16,
   "end": 494.6,
   "text": "پنج‌گانه که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.6,
   "end": 497.84,
   "text": "هی هرچی میری جلوتر اینا لطیف‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.84,
   "end": 501.62,
   "text": "چشم چقدر میگه \"هر آنچه که دیده ببیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.62,
   "end": 505.14,
   "text": "دل کند یاد، ز دست دیده و دل هر دو فریاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.14,
   "end": 509.56,
   "text": "هر آنچه دیده ببیند دل کند یاد\" این نگاه به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.56,
   "end": 512.32,
   "text": "تاثیر داره در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.32,
   "end": 514.88,
   "text": "حرف زدن یه طور، شنیدن یه طور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.88,
   "end": 521.88,
   "text": "حدیث داریم اگر کسی فکر نکنه و حرف بزنه، این حرف زدنش طهارت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.88,
   "end": 523.78,
   "text": "حتی اگر حرف خوب می‌خواد بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.78,
   "end": 527.16,
   "text": "قربونتون برم. اگر امیرالمؤمنین علیه‌سلام نفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.16,
   "end": 531.04,
   "text": "که العاقل لسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.04,
   "end": 533.94,
   "text": "وراء عقله یا قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 533.94,
   "end": 535.86,
   "text": "والجاهل لسانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 535.86,
   "end": 539.0,
   "text": "لسانه أمام عقله یا قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 539.0,
   "end": 544.26,
   "text": "یعنی یه ملاک بزرگیه. حتی حرف خوبم اگر می‌خواد بزنه باید فکر کنه و بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 544.26,
   "end": 546.78,
   "text": "بدون فکر اگر مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.78,
   "end": 551.32,
   "text": "نمیگه اگر کسی حرف بد بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.32,
   "end": 554.94,
   "text": "میگه اصلاً حرف خوب هر ه-- مطلق کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.94,
   "end": 563.14,
   "text": "حرف لسانش به حرکت دراومد اگر بدون تفکر و تعقل و تدبر باشه و لو حرف خوب می‌خواد بزنه این طهارت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.14,
   "end": 566.7,
   "text": "این از عقل برنمی‌خیزه چون طهارت منشأش عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.7,
   "end": 568.98,
   "text": "توجه کردید؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 568.98,
   "end": 572.66,
   "text": "شما میگه تو خود حدیث مفصل بخوان از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.66,
   "end": 576.66,
   "text": "بحث لسان. اگر من از شما یه سؤال بپرسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.66,
   "end": 579.04,
   "text": "ا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.04,
   "end": 582.66,
   "text": "همه‌تون در درونتون جواب میدید قطعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 582.66,
   "end": 585.36,
   "text": "کی به شما حرف زدن یاد داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.36,
   "end": 587.9,
   "text": "اینکه فم شما، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 587.9,
   "end": 591.34,
   "text": "فک شما، زبان شما، حلق شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 591.34,
   "end": 595.38,
   "text": "اینا ماهیچه‌ها چگونه تکون بخورن، حرکت کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.38,
   "end": 598.14,
   "text": "تا این مخرج رو ادا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.14,
   "end": 601.68,
   "text": "پدر مادر یاد داد؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.68,
   "end": 605.1,
   "text": "به‌طور غیرعادی اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.1,
   "end": 608.96,
   "text": "خود بچه وقتی به سن خاصی رسید شروع می‌کنه حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.96,
   "end": 611.52,
   "text": "کی اینو داره از درون بهش یاد می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.52,
   "end": 615.34,
   "text": "خدا. خدا الهام می‌کنه نفسش به حرف زدن می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 615.34,
   "end": 619.46,
   "text": "این لسان یک جسم، یک جسم ظاهریه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.46,
   "end": 622.2,
   "text": "نفسه که داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.2,
   "end": 626.42,
   "text": "نفس ناطقه دیگه. نه-- یعنی جان ما داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.42,
   "end": 629.28,
   "text": "لذا میگن از حرف زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 629.28,
   "end": 632.44,
   "text": "تا مرد سخن نگفته باشد عیب هنرش نهفته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 632.44,
   "end": 636.12,
   "text": "از حرف زدن بفهم آقا جانش چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 636.12,
   "end": 639.5,
   "text": "لذا اگر کسی حرف خوب می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.5,
   "end": 643.9,
   "text": "جانش پاکه. البته با اون شرطی که گفتیم همراه با تدبر و تعقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 643.9,
   "end": 646.7,
   "text": "حتی خیلی امروز یه حدیثی شنیدم خیلی تکونم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 646.7,
   "end": 651.36,
   "text": "دیدم. امیرالمؤمنین علیه‌سلام فرمود هر چیزی حریم و ادبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 651.36,
   "end": 653.68,
   "text": "خیلی عجیبه این و قربون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.68,
   "end": 659.28,
   "text": "امیر لسان و بیان. فرمود حریم سؤال اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.28,
   "end": 662.1,
   "text": "وقتی سؤال رو شنیدی تأمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.1,
   "end": 667.68,
   "text": "بلافاصله جواب ندی. دیدی بزرگان سؤال می‌پرسیدین می‌گفت تأمل می‌کنم فکر می‌کنی بلد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 667.68,
   "end": 674.48,
   "text": "حریم نگه می‌داره. خب این اگر حریم رعایت نشه باز داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 674.48,
   "end": 678.3,
   "text": "نجس حرف می‌زنه. اون حرفش طهارت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.3,
   "end": 682.34,
   "text": "اگر کسی فحش میده حدیث داریم قطعاً از پلیدی جانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.34,
   "end": 686.62,
   "text": "نفسش ناپاکه. چون جان داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 686.62,
   "end": 690.06,
   "text": "زبان که نیست. جان ناپاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 690.06,
   "end": 692.68,
   "text": "همین‌طوری شما تو گوش اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 692.68,
   "end": 697.44,
   "text": "دهان ما جسم ما رو تقویت می‌کنه، چیزی می‌خوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.44,
   "end": 700.26,
   "text": "گوش ما دهان روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 700.26,
   "end": 703.72,
   "text": "روح ما، جان ما با گوشمون تغذیه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 703.72,
   "end": 707.94,
   "text": "اونچه که می‌شنویم اگر درسته و حقه طهارت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 707.94,
   "end": 710.74,
   "text": "اگر باطله نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 710.74,
   "end": 715.28,
   "text": "تو داری جانت رو نجس می‌کنی و من لا-لايه پرانتز یه سری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 715.28,
   "end": 718.54,
   "text": "از اهل سر از خودمم نیست به شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 718.54,
   "end": 726.32,
   "text": "سریعم ازش رد می‌شم. اگر ما متنجس شویم بر اثر ارتباط با کر پاک می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 726.32,
   "end": 732.44,
   "text": "اما اگر عین نجاست شویم دیگه هزار تا کوه حتی تو دریاها بگردونمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.44,
   "end": 736.9,
   "text": "هیچ فایده‌ای نداره. اگر عین نجاست بشیم کر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.9,
   "end": 743.98,
   "text": "اهل بیت‌ن. با ارتباط با اهل بیت عین نجاست بشیم هیچی هزاری هم کربلا بریم پاکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 743.98,
   "end": 746.18,
   "text": "اما اگر نجس بشیم، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 746.18,
   "end": 752.0,
   "text": "متنجس بشیم، برخورد به نجاست کنیم با ارتباط با اهل بیت می‌تونیم پاک شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 752.0,
   "end": 754.24,
   "text": "بحث طهارت انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.24,
   "end": 756.72,
   "text": "حالا شما این لایه‌ها رو بگیر برو جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 756.72,
   "end": 760.74,
   "text": "دست و پا و گوش و حواس ظاهری و بعد برو تو بحث چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.74,
   "end": 766.94,
   "text": "خیال. خیال. انقدر حدیث داریم معذرت می‌خوام این مثال رو می‌زنم که وقت مجامعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 766.94,
   "end": 773.76,
   "text": "اگر زن و مرد به فکر غیر از همسر خودشون باشن هنگام انعقاد نقطه-نکته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 773.76,
   "end": 776.0,
   "text": "اون بچه پلید به دنیا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 776.0,
   "end": 779.26,
   "text": "هم تو جسمش بزرگان گفتن یه مشکلاتی ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 779.26,
   "end": 781.74,
   "text": "البته گفتن چه مشکلاتی ایجاد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 781.74,
   "end": 785.48,
   "text": "و هم تو روحش پلیدی و خباثت و نجاست ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 785.48,
   "end": 788.04,
   "text": "این دیگه نجاست که فقط این نجاست ظاهری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 788.04,
   "end": 790.42,
   "text": "این مرتبه نازل‌ترین مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 790.42,
   "end": 794.8,
   "text": "نجاست عالمه. این مثلاً بول و غائت و اینا خون و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 794.8,
   "end": 799.76,
   "text": "همینطور بعد برو تو بحث اوه-- وه، قوای واهمه برو بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 799.76,
   "end": 804.74,
   "text": "تا جایی که دیگه جان و سر آدم باید پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 804.74,
   "end": 807.82,
   "text": "سر و سر باید پاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 807.82,
   "end": 810.1,
   "text": "خفی وجود آدم پاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 810.1,
   "end": 811.94,
   "text": "اخفاء وجود آدم پاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 811.94,
   "end": 814.12,
   "text": "که من این حرفو بزنم بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 814.12,
   "end": 818.5,
   "text": "اعتراض می‌کنن که حرفاتون یه مقدار سنگین می‌شه و شده و فلان و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 818.5,
   "end": 822.24,
   "text": "دو تا داستان بگیم. انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 822.24,
   "end": 825.56,
   "text": "خدای منان ما رو به حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 825.56,
   "end": 830.58,
   "text": "همین پیرامون طهارت آشنا کنه که بدون این لا یمسّهو لا نمی‌شه مس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 830.58,
   "end": 833.4,
   "text": "\"لا یمسّهُ إلاّ المتَهَرّون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 833.4,
   "end": 835.3,
   "text": "عاقبتمون انشاالله ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 835.3,
   "end": 837.82,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}