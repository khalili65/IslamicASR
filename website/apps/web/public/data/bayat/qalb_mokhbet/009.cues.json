 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء در طهارت با آب قلیل",
   "start": 13.26,
   "end": 130.96
  },
  {
   "index": 1,
   "title": "## صبر از جنود عقل است",
   "start": 130.96,
   "end": 175.84
  },
  {
   "index": 2,
   "title": "## ستایش خلق و نشانهٔ خیال",
   "start": 175.84,
   "end": 256.18
  },
  {
   "index": 3,
   "title": "## داستان شیخ عباس قمی در سرداب سامرا",
   "start": 256.18,
   "end": 601.85
  },
  {
   "index": 4,
   "title": "## راه تصفیهٔ عالم خیال",
   "start": 601.85,
   "end": 650.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 4.16,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.16,
   "end": 8.94,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.94,
   "end": 13.26,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.26,
   "end": 18.54,
   "text": "از استفتائات دیگه پیرامون طهارت اینه که از رهبرمون سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.54,
   "end": 24.42,
   "text": "با آب قلیل وقتی می‌خوایم مخرج بل و قائط رو بشوریم چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.42,
   "end": 27.9,
   "text": "آقا فرمودن که آقا احتیاط کردن اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.9,
   "end": 32.8,
   "text": "احتیاط واجب چون بلافاصله یعنی اول فتوا ندادن بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.8,
   "end": 35.6,
   "text": "احتیاط کنن، احتیاط واجب است، مستحب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.6,
   "end": 38.4,
   "text": "یعنی یا باید اینو انجام بدید یا برید رجوع کنید به کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.4,
   "end": 41.26,
   "text": "در خصوص آب قلیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.26,
   "end": 45.02,
   "text": "شستن آب قلیل، مخرج بل رو احتیاط کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.02,
   "end": 49.56,
   "text": "گفتن اگر خواستید مخرج بل رو با آب قلیل بشورید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.56,
   "end": 52.8,
   "text": "احتیاطاً دو بار بشورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.8,
   "end": 57.16,
   "text": "احتیاط کردن. حالا باید می‌تونین اینجا رجوع کنید به مراجع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.16,
   "end": 61.52,
   "text": "اما مخرج قائط رو فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.52,
   "end": 66.26,
   "text": "همون یه بار فقط به قدری که یعنی کفایت می‌کنه، به قدری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.26,
   "end": 70.52,
   "text": "همه‌ی آثار نجاست از بین بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.52,
   "end": 75.16,
   "text": "دیگه پاکه انشاالله. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.16,
   "end": 81.86,
   "text": "نشانه‌های قلب مخبت داشتیم بر اساس آیه سی و پنج حج صحبت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.86,
   "end": 84.34,
   "text": "چون امروز نخودخورون هم دارید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.34,
   "end": 89.8,
   "text": "سریع بحثو جمع کنیم. دل‌ها اونجاست و بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.8,
   "end": 92.88,
   "text": "خیلی اینجا دل‌ها حاضر پیش ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.88,
   "end": 96.46,
   "text": "\"و صابرین على ما أصابهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.46,
   "end": 101.6,
   "text": "برید ببینید آیه سی و پنج سوره حج رو وقتی \"و بشر المخبتین\" میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.6,
   "end": 107.14,
   "text": "اینا کیان؟ این فرمود \"الذین اذا ذكر الله اجلت قلوبهم\" که دیروز توضیح دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.14,
   "end": 109.96,
   "text": "و امروز \"و صابرین على ما أصابهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.96,
   "end": 112.7,
   "text": "اینا بر اونچه که بهشون اصابت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.7,
   "end": 115.18,
   "text": "از روزگار صابران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.18,
   "end": 118.22,
   "text": "یه نکته بذارید یه ذره علمی ح-- بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.22,
   "end": 120.88,
   "text": "حواسمون باشه صبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.88,
   "end": 124.52,
   "text": "خود، خود صبر کردن صبر می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.52,
   "end": 128.3,
   "text": "یعنی آدم بر صبرش هم باید صبر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.3,
   "end": 131.66,
   "text": "چه موقع می‌تونه-- اصلاً ببینید یادتون باشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.66,
   "end": 135.26,
   "text": "قوای عقل، در اون حدیث جنود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.26,
   "end": 142.58,
   "text": "عقل و جهل در اصول کافی مرحوم کلینی آورده‌ش که هفتصد و پنج تا عقل لشگر داره، هفتصد و پنج تا جهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.58,
   "end": 148.24,
   "text": "و اینا با هم دائماً درگ- ااا درگیری و جنگ به سر می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.24,
   "end": 151.88,
   "text": "یکی از کارگزاران و سربازان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.88,
   "end": 155.1,
   "text": "عقل صبره. این خیلی نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.1,
   "end": 162.94,
   "text": "یعنی چی؟ یعنی اصلاً انسان نمی‌تونه صبر از خودش نشون بده مگر وادی عقل رو وارد شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.94,
   "end": 166.3,
   "text": "اون وادی‌هایی که ما عرض کردیم عوالمی در وجود ما وا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.3,
   "end": 171.38,
   "text": "هستن، قطعاً و قطعاً باید از عالم خیال خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.38,
   "end": 174.84,
   "text": "از عالم خیال رفته باشه رسیده باشه به عالم قع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.84,
   "end": 180.7,
   "text": "عقله. اگر کسی هنوز در عالم خیال به سر می‌بره شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.7,
   "end": 185.12,
   "text": "ظاهراً صبوری نشون بده اما بر صبر خودش صبر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.12,
   "end": 192.4,
   "text": "این نشونه‌شه. بعداً میگه عجب غلطی کردیم صبر کردیم یا همون موقع اصلاً بی‌قراره، آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.4,
   "end": 197.8,
   "text": "این که می‌فرمود اینجا از نشانه‌های مخبتین \"و صابرین على ما أصابهم\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.8,
   "end": 201.6,
   "text": "صبر در وادی عقله. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.6,
   "end": 205.38,
   "text": "در خ-- البته این جای بحث داره اما سریع عرض می‌کنم میرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.38,
   "end": 209.4,
   "text": "که ما وقتی وارد عالم خیال می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.4,
   "end": 218.26,
   "text": "قبلاً عرض کردیم عالم خیال بازیگره، بازی می‌کنه و همه اجتماع عموماً گرفتار این عالم خیال هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.26,
   "end": 224.06,
   "text": "و نوعاً دوستی‌ها، دشمنی‌ها در این اجتماع بر اساس قوه خیال صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.06,
   "end": 226.52,
   "text": "لذا دوستی‌ها پایدار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.52,
   "end": 228.84,
   "text": "حتی دشمنی‌ها هم می‌بینی پایدار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.84,
   "end": 230.4,
   "text": "امروز دوسته فردا دشمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.4,
   "end": 232.2,
   "text": "دوباره همین‌طور. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.2,
   "end": 235.62,
   "text": "چون بر- در وادی عالم خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.62,
   "end": 238.34,
   "text": "با هم تصویرسازی کردن و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.34,
   "end": 239.9,
   "text": "و با هم رفیق شدن و دوستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.9,
   "end": 245.4,
   "text": "اصلاً زندگی ما عموماً کا-- همین سر کار که میایم، درس که می‌خونیم، ازدواج که می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.4,
   "end": 249.32,
   "text": "کارامون معمولاً حتی متأسفانه عبادیات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.32,
   "end": 254.38,
   "text": "تو وادی عالم خیال صورت می‌گیره و خیال هم بازیگره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.38,
   "end": 258.54,
   "text": "درسته؟ ااا قوه عکس‌برداری قوای عقل ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.54,
   "end": 265.62,
   "text": "یعنی عقل ما، قوه عاقله ما با اون عکس‌برداری می‌کنه، کلی‌سازی می‌کنه که درک کنه مفاهیم کلی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.62,
   "end": 268.94,
   "text": "اما این چون عکس‌هایی به غلط می‌ندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.94,
   "end": 272.88,
   "text": "یا بازی درمیاره، به هر حال قوه عقل رو هم بازی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.88,
   "end": 276.5,
   "text": "باید خیلی زیرک باشه انسان تا معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.5,
   "end": 278.66,
   "text": "غالب مردم تو وادی خیالن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.66,
   "end": 283.3,
   "text": "یعنی هنوز به عقلشون نرسیدن لذا نمی‌تونن صبر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.3,
   "end": 288.24,
   "text": "صبر کردن مال قوه خیاله، از جنود عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.24,
   "end": 293.98,
   "text": "اگر کسی دست پیدا کرد به قوای عاقلش رفته تو عالم مجرداتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.98,
   "end": 296.4,
   "text": "عا-- عالم مجردات، عالم عقوله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.4,
   "end": 298.28,
   "text": "عالم ملائکه، عالم عقوله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.28,
   "end": 300.22,
   "text": "ملائکه جنسشون از عقله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.22,
   "end": 302.96,
   "text": "اصلاً اونا با هم دعوا ندارن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.96,
   "end": 305.46,
   "text": "همه سر-- حدیث داریم، خیلی حدیث عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.46,
   "end": 308.08,
   "text": "من هر وقت تو هیئتها، پایگاه‌های بسیج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.08,
   "end": 310.0,
   "text": "جاهای مذهبی دعوا می‌شه اینو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.0,
   "end": 315.98,
   "text": "میگم صد و بیست و چهار هزار پیغمبر اگه گرد هم جمع شن، حدیث داریم کوچک‌ترین اختلاف رو با هم نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.98,
   "end": 318.48,
   "text": "اگه همه بخوان مملکت‌دار بشوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.48,
   "end": 322.42,
   "text": "مملکت رو بسپری صد و بیست و چهار هزار پیغمبر، کوچک‌ترین اختلاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.42,
   "end": 326.04,
   "text": "همه‌ی این اختلافاتی که الان تو سطح کشور ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.04,
   "end": 331.18,
   "text": "جاری و ساریه همش نشأت گرفته از عالم خیاله، خیالات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.18,
   "end": 336.26,
   "text": "اگر کسی وارد بشه به عالم عقل اصلاً دیگه برعکس فکر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.26,
   "end": 339.44,
   "text": "یعنی چنان عاشق صبر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.44,
   "end": 344.08,
   "text": "و حتی اگر قدرت برطرف کردن مشکل رو هم داشته باشه می‌بینی برطرف نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.08,
   "end": 346.68,
   "text": "خیلی جالبه. مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.68,
   "end": 351.8,
   "text": "مگر تو قرآن نداریم که نما \"إنما نطعمكم لوجه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.8,
   "end": 354.08,
   "text": "لا نريد منكم جزىً ولا شكورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.08,
   "end": 356.7,
   "text": "این برمی‌گرده به چی؟ اون اطعامی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.7,
   "end": 361.18,
   "text": "امیرالمؤمنین علیه السلام زهرای کردن به اون یتیم و اسیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.18,
   "end": 364.49,
   "text": "سائل اینا چی بود؟ به خاطر چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.49,
   "end": 368.23,
   "text": "روزه گرفتن چون امام حسن و امام حسین مریض شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.23,
   "end": 373.35,
   "text": "من از شما سؤال می‌کنم ما هر کدوم بچه‌مون مریض شه اول میریم دامن امام زمانو می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.35,
   "end": 376.15,
   "text": "می‌گیم آقا قدرت داره، قدرت خدا دستشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.15,
   "end": 380.85,
   "text": "می‌تونه شفا بده. چرا بچه‌های خودشو شفا نداده مولا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.85,
   "end": 382.69,
   "text": "نمی‌تونست امیر-- مگه امام اول نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.69,
   "end": 387.13,
   "text": "مگه ابوالأئمه نیست؟ مگه لب تر می‌کرد، مگه حقیقت اسم اعظم نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.13,
   "end": 388.81,
   "text": "لب تر می‌کرد خدا شفا می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.81,
   "end": 394.77,
   "text": "بابا بچه‌های حضرت زهرا، خود حسنین دعا می‌کردن شفا نمی‌گرفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.77,
   "end": 397.53,
   "text": "آقا خدا این زره آدم می‌دونه نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.53,
   "end": 400.47,
   "text": "چرا اینجا صبر می‌کنن؟ چرا دعا نمی‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.47,
   "end": 403.01,
   "text": "چرا دست به اون قوای آنچنانی نمی‌زنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.01,
   "end": 405.91,
   "text": "چرا به صورت طبیعی صبر می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.91,
   "end": 411.43,
   "text": "و روزه می‌گیرن؟ سه روز روزه می‌گیرن نذر می‌کنن که خدا اینا رو شفا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.43,
   "end": 416.35,
   "text": "الله اکبر. اینا چنان، اصلا عقل محضن ایناها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.35,
   "end": 418.71,
   "text": "همه چی رو می‌سپردن به خدا. به این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.71,
   "end": 421.13,
   "text": "صبری بر صبرشون هم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.13,
   "end": 423.15,
   "text": "صبری بر مریضی‌شون هم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.15,
   "end": 428.57,
   "text": "لذا وقتی به اون شاگردش آقا سؤال کرد شما فقر رو بیشتر دوست داری یا غنا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.57,
   "end": 432.37,
   "text": "گفت غنا رو. عرض کرد فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.37,
   "end": 435.35,
   "text": "شفا ااا سلامت رو بیشتر دوست داری یا مریضی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.35,
   "end": 438.57,
   "text": "گفت سلامتی رو. حضرت فرمود ما نه اینو دوست داریم نه اونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.57,
   "end": 440.73,
   "text": "اونی رو دوست داریم که خدا دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.73,
   "end": 442.91,
   "text": "هرچی رو خدا دوست داره ما همونو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.91,
   "end": 445.11,
   "text": "شاید الان سلام-- بینم و خدا من مریض باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.11,
   "end": 450.59,
   "text": "ببینید نگاهو. این فقط در عالم عقل صورت می‌گیره این نوع نگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.59,
   "end": 454.19,
   "text": "اون موقع همه چی عوض می‌شه. اگه کسی تعریفت کنه تعجب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.19,
   "end": 456.55,
   "text": "میگی برای چی تعریفو داری برای من می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.55,
   "end": 459.53,
   "text": "الان اگه ما تو عالم خیال باشیم، همش دوست داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.53,
   "end": 465.21,
   "text": "نشانه‌ها رو دریابید ها. اگر دوست داریم خیلی تعریفمون بکنن تو عالم خیالیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.21,
   "end": 468.29,
   "text": "اگر عاقلانه رفتار کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.29,
   "end": 471.21,
   "text": "اصلا میگی برای چی داری تعریف می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.21,
   "end": 475.59,
   "text": "تعریفت برای چیه؟ چرا بی‌خودی داری زیادی تعریف می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.59,
   "end": 482.07,
   "text": "اگه شیخ عباس قمی تو سرداب نشسته بود، سرداب مقدس سامرا انشاالله توفیق شه به زودی بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.07,
   "end": 485.63,
   "text": "اینم داستان برای امثال خودم که تو عالم خیالیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.63,
   "end": 487.89,
   "text": "باید مثال بزنیم تا متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.89,
   "end": 490.61,
   "text": "نشسته بود، یه نفر بغلش، کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.61,
   "end": 492.43,
   "text": "سلطان الواعظین شیرازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.43,
   "end": 495.25,
   "text": "بغل شیخ عباس نشسته میگه دیدم یه پیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.25,
   "end": 498.29,
   "text": "یه آخوند ژولیده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.29,
   "end": 501.71,
   "text": "عمامه کوچیکه. گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.71,
   "end": 503.67,
   "text": "این کیه نشسته داره ذکر میگه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.67,
   "end": 507.97,
   "text": "نشناخت شیخ عباسه. شیخ عباس خیلی ساده زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.97,
   "end": 511.81,
   "text": "بعد دید یه مفاتیح دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.81,
   "end": 515.05,
   "text": "خود همین سلطان الواعظین شیخ عباس دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.05,
   "end": 518.37,
   "text": "بهش گفت این کی، این چیه؟ این کتاب کیه داره می‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.37,
   "end": 524.25,
   "text": "با تغییر. گفتش که کتاب حضرت استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.25,
   "end": 528.75,
   "text": "شیخ المحدثین، حضرت آقای قمی، کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.75,
   "end": 531.95,
   "text": "گفت چه خبره؟ این حرفا چیو می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.95,
   "end": 536.15,
   "text": "این تعریفا براش چیو می‌کنی؟ اینطوری هم که تو میگی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 536.15,
   "end": 539.29,
   "text": "جمع کن بابا این حرفا رو نزن. زد به پر پر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.29,
   "end": 544.25,
   "text": "حالا خود شیخ عباسه. زد به پرش گفت این حرفا رو نزن، این تعریف‌ها رو نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.25,
   "end": 546.49,
   "text": "اینطوری که تو میگی نیست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.49,
   "end": 550.93,
   "text": "خیلی سلطان الواعظین به قول ما تعصبی شد و ناراحت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 550.93,
   "end": 553.91,
   "text": "گفت جمع کن، جمع کن، خودت جمع کن از اینجا برو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 553.91,
   "end": 555.53,
   "text": "شیخ عباس قمی جسارت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.53,
   "end": 559.53,
   "text": "گفت تو خودت جمع کن به استاد ما جسارت می‌کنی این حرفا چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.53,
   "end": 562.73,
   "text": "یه دفعه یکی اونجا شناخت شیخ عباسو با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 562.73,
   "end": 565.05,
   "text": "بغل دستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 565.05,
   "end": 568.87,
   "text": "زد به آرنجش به این کتف کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.87,
   "end": 571.53,
   "text": "سلطان الواعظین. بابا این خود شیخ عباسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.53,
   "end": 573.99,
   "text": "گفت الله اکبر افتاد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.99,
   "end": 576.29,
   "text": "دست شیخ عباسو ببوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 576.29,
   "end": 579.35,
   "text": "حالا اونم البته سید بود سلطان الواعظین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.35,
   "end": 582.41,
   "text": "شیخ عباس افتاد دست اونو بوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.41,
   "end": 584.41,
   "text": "گفت شما ساداتی من باید دستتو ببوسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 584.41,
   "end": 586.87,
   "text": "اما دیگه از این تعریف‌ها نکن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 586.87,
   "end": 589.65,
   "text": "ببین وقتی وارد عالم عقل بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 589.65,
   "end": 594.13,
   "text": "همه چیت برعکس می‌شه. همه چیت برعکس می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 594.13,
   "end": 598.37,
   "text": "تا وقتی که تو عالم خیال هستیم گرفتار این مسائل روزمره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.37,
   "end": 604.67,
   "text": "چیزای کوچیک و یادتون باشه عالم خیال آخرِ کلام اینو یادت-- یادمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 604.67,
   "end": 607.27,
   "text": "من عرض کردم و علمی هم دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 607.27,
   "end": 611.17,
   "text": "سخن بزرگان رو به شما امثال علامه حسن زاده رو دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 611.17,
   "end": 616.89,
   "text": "راه تصفیه عالم خیال برای رسیدن به عالم عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.89,
   "end": 618.97,
   "text": "اینه که سه حوزه درست شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 618.97,
   "end": 622.65,
   "text": "یک معتقدات، اعتقادات انسان باید درست شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 622.65,
   "end": 628.13,
   "text": "دو مخصوصا از بدبینی، بددلی و سوءظن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.13,
   "end": 630.13,
   "text": "حوزه خیال باید تطهیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 630.13,
   "end": 632.15,
   "text": "سه آمال و آرزوها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.15,
   "end": 635.49,
   "text": "که ما نوعا گرفتار این سه قصه هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 635.49,
   "end": 637.33,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 637.33,
   "end": 642.79,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 642.79,
   "end": 645.81,
   "text": "صلوات على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.81,
   "end": 650.51,
   "text": "آل محمد عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}