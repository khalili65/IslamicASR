 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ بخار آب و طهارت از نجاست",
   "start": 0.34,
   "end": 88.76
  },
  {
   "index": 1,
   "title": "## مدخل جدید؛ مثلث بعثت و قلب مخبت",
   "start": 88.76,
   "end": 233.52
  },
  {
   "index": 2,
   "title": "این‌ها چه ربطی به قلب مخبت دارد؟ باید با زیرکی رسید. نخست:",
   "start": 233.52,
   "end": 271.96
  },
  {
   "index": 3,
   "title": "### ضلع سوم؛ ذکر و اطمینان قلب",
   "start": 271.96,
   "end": 530.75
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.62,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.62,
   "end": 7.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.74,
   "end": 12.38,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 15.86,
   "text": "سؤال شده از رهبر عزیزمون که آیا بخار آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.86,
   "end": 21.42,
   "text": "بخار فوران کننده آب، اون حالت نقطه جوش که دیگه بخار خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.42,
   "end": 24.7,
   "text": "شدید دما گرفته و این‌ها که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.7,
   "end": 29.4,
   "text": "اون حالت برای استریلیزه مثلا بعضی ظروف استفاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 32.84,
   "text": "آیا این بخار شدید آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.84,
   "end": 34.74,
   "text": "نجاست رو برطرف می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.74,
   "end": 36.84,
   "text": "یعنی پاک می‌کنه؟ مطهره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.84,
   "end": 46.64,
   "text": "یعنی عرض کنم خدمتتون مثلا در اتاق عمل این وسایل عمل خب توش خون بعضی موقع‌ها باقی می‌مونه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.64,
   "end": 50.16,
   "text": "اصلاً خون هم باقی نمی‌مونه بر اثر ارتباط با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.16,
   "end": 52.26,
   "text": "عین نجاست نجس شدن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.26,
   "end": 54.74,
   "text": "بعد این‌ها رو می‌ریزن تو یه جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.74,
   "end": 57.8,
   "text": "در اثر بخار شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.8,
   "end": 61.5,
   "text": "آب، بخار آب. این‌ها رو مثلا اصطلاحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.5,
   "end": 63.82,
   "text": "استریلیزه می‌کنند یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.82,
   "end": 68.38,
   "text": "میکروب‌کشی می‌کنند. آیا این‌ها پاک هم می‌شن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.38,
   "end": 73.54,
   "text": "رهبری فرمودن نخیر بخار آب هر چقدر هم شدت داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.54,
   "end": 75.7,
   "text": "نجاست رو یا نجس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.7,
   "end": 80.24,
   "text": "پاک نمی‌کنه. اون قصه دیگه، اون بحث میکروب‌کشی و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.24,
   "end": 84.76,
   "text": "ولی این دیگه هنوز نجسه باید با آب شستشو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.76,
   "end": 86.88,
   "text": "یکی از آیات قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.88,
   "end": 92.22,
   "text": "دقت بفرمایید این ورود به یک مدخل جدیدی از بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.22,
   "end": 98.14,
   "text": "تو قلب مخبت امروز اتفاق میفته که امیدوارم خدا کمک کنه بتونم جمعش کنم بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.14,
   "end": 101.36,
   "text": "خیلی مهمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.36,
   "end": 105.42,
   "text": "قرآنی هم هست. البته عنوان هست که خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.42,
   "end": 107.9,
   "text": "قرون، قرآنی هست قلب مخبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.9,
   "end": 112.52,
   "text": "لکن خب این نکته‌ای که امروز عرض می‌کنیم هم باز برگرفته از قرآن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.52,
   "end": 115.42,
   "text": "این آیه‌ای که معمولا همه حفظیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.42,
   "end": 118.0,
   "text": "هو الذي خدا این چنین خودشو معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.0,
   "end": 123.28,
   "text": "هو الذي او کسی است که بعث في الاميين رسولا منهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.28,
   "end": 126.46,
   "text": "يتلو عليهم آياته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.46,
   "end": 132.8,
   "text": "و یزکيهم و يعلمهم الكتاب و الحکمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.8,
   "end": 136.88,
   "text": "فلسفه بعثت انبیا رو اینجا تو این آیه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.88,
   "end": 141.28,
   "text": "سه جهت بهش داده. یکی فرموده يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.28,
   "end": 148.96,
   "text": "این ذکر و آیات الهی، قرآن کلا و آیاتش ذکر الهی‌اند دیگه، ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.96,
   "end": 154.5,
   "text": "می‌فرماید برای فلسفه ذکر‌اند یا تذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.5,
   "end": 157.38,
   "text": "بعد می‌فرماید یزکيهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.38,
   "end": 161.78,
   "text": "فلسفه دوم بعثت انبیا می‌شه تزکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.78,
   "end": 164.52,
   "text": "طهارت باطن و ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.52,
   "end": 169.84,
   "text": "هر دو جهت. بعد يعلمهم الكتاب و الحکمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.84,
   "end": 174.52,
   "text": "سومین فلسفه می‌شه چی؟ تعلیم علم و معرفت و دانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.52,
   "end": 178.32,
   "text": "سه ضلع پیدا کردیم مثلث بعثت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.32,
   "end": 185.38,
   "text": "رضا علامه جوادی آملی می‌فرماید که اصلا ما سه تا وظیفه رو این کره خاکی بیشتر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.38,
   "end": 188.24,
   "text": "یکی تذکره‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.24,
   "end": 192.24,
   "text": "یاد خدا، ذکر خدا که این عبادات و این‌ها رو شامل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.24,
   "end": 196.5,
   "text": "قرآن خوندن، نماز خوندن، یاد خدا، ذکر، ورد، عبادات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.5,
   "end": 199.98,
   "text": "یکی تزکیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.98,
   "end": 203.86,
   "text": "که پاکی و طهارت رو از باطن و ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.86,
   "end": 206.76,
   "text": "می‌طلبه. یکیشم تعلیم علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.76,
   "end": 210.1,
   "text": "تعلیم، یاد گرفتن معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.1,
   "end": 214.82,
   "text": "مثل الان که با هم نشستیم چند دقیقه‌ای محضر قرآن و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.82,
   "end": 220.6,
   "text": "توجه کردید؟ حالا این‌ها چه ربطی به بحث قلب مخبت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.6,
   "end": 224.2,
   "text": "با یک زیرکی باید بهش برسیم دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.2,
   "end": 228.8,
   "text": "اولا داریم که إنما یخش الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.8,
   "end": 233.08,
   "text": "من عباده العلماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.08,
   "end": 235.24,
   "text": "یعنی فقط کسایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.24,
   "end": 238.74,
   "text": "از خدا خشیت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.74,
   "end": 244.18,
   "text": "که اینا عالمن. چون ما قبلاً گفتیم اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.18,
   "end": 246.58,
   "text": "تو سه تا فرمول جمع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.58,
   "end": 249.9,
   "text": "یادتونه دیگه خذو و خشوع و اطمینان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.9,
   "end": 252.42,
   "text": "خذو و خشوع و اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.42,
   "end": 257.32,
   "text": "اینجا قرآن می‌فرماید که خشوع رو کجا می‌شه پیدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.32,
   "end": 259.38,
   "text": "إنما، إنما هم هسته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.38,
   "end": 261.66,
   "text": "فقط یه جا خشوع وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.66,
   "end": 264.9,
   "text": "یخش الله من عباده العلماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.9,
   "end": 271.22,
   "text": "فقط بندگان خدایی که عالمن، علم دارن، معرفت دارن، اونا به خشیت می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.22,
   "end": 274.32,
   "text": "پس این یک اتصالش با قلب مخبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.32,
   "end": 281.44,
   "text": "ببینید اگر قلب مخبت مجموع بین خذو و خشوع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.44,
   "end": 284.04,
   "text": "سکون و اطمینان است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.04,
   "end": 286.74,
   "text": "خشوعشو پیدا کردیم از کجا بهش باید رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.74,
   "end": 290.24,
   "text": "از طریق تحصیل علم و معرفت و دانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.24,
   "end": 293.0,
   "text": "این یه ضلع مثلث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.0,
   "end": 295.8,
   "text": "خب تزکیه کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.8,
   "end": 300.94,
   "text": "تزکیه مقدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.94,
   "end": 303.24,
   "text": "تعلیمه. اینو همه می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.24,
   "end": 306.08,
   "text": "حالا مقدمه خشوع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.08,
   "end": 310.62,
   "text": "میگن خذو. انسان اول خاضع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.62,
   "end": 315.9,
   "text": "بعد خاشع می‌شه. عرض کردیم مقدمه خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.9,
   "end": 321.52,
   "text": "ذلت ظاهری‌ست که به ذلت باطنی در برابر خدا ختم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.52,
   "end": 324.9,
   "text": "پس عزیزان دلم تزکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.9,
   "end": 330.68,
   "text": "می‌شه همون خذو یعنی از تزکیه، خذو ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.68,
   "end": 333.08,
   "text": "چون تزکیه مقدمه عبادته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.08,
   "end": 336.02,
   "text": "طهارت. شما الان خواستید نماز بخونید چکار کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.02,
   "end": 339.14,
   "text": "اول کاری که کردید طهارت گرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.14,
   "end": 341.32,
   "text": "اگر طهارت نمی‌گرفتیم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.32,
   "end": 343.12,
   "text": "اجازه نداشتیم رو به خدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.12,
   "end": 347.62,
   "text": "درسته؟ پس چون مقدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.62,
   "end": 352.84,
   "text": "عبادات، مقدمه رو به خدا رفتن طهارت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.84,
   "end": 358.22,
   "text": "توجه کردید؟ تزکیه هم که همون طهارت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.22,
   "end": 364.19,
   "text": "می‌شه همون مقدمه خضوع هم که مقدمه‌ی خشوع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.19,
   "end": 367.09,
   "text": "پس تزکیه، خضوع میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.09,
   "end": 369.69,
   "text": "اینم دو تا. دو تا فرمول پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.69,
   "end": 372.37,
   "text": "ارتباط این‌ها با هم. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.37,
   "end": 378.33,
   "text": "پس خشوع از کجا میومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.33,
   "end": 380.55,
   "text": ". خضوع از کجا دراومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.55,
   "end": 383.21,
   "text": "که س-- ضلع دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.21,
   "end": 385.39,
   "text": "عرض کنم اخبات بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.39,
   "end": 389.51,
   "text": "از کجا؟ از تزکیه، از طهارت که حالا اینو باید بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.51,
   "end": 395.99,
   "text": "یه دونه موند، اونم سکون و اطمینان و آرامش قلبیه که در قلب مخبت وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.99,
   "end": 398.85,
   "text": "اون توی این آیه کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.85,
   "end": 405.73,
   "text": "یه دونه باقی موند دیگه. که گفتیم محض ذکر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.73,
   "end": 411.37,
   "text": "حالا آیه ش کجاست؟ دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.37,
   "end": 413.85,
   "text": "ذکر خدا اطمینان قلب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.85,
   "end": 415.77,
   "text": "آرامش و سکون میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.77,
   "end": 422.33,
   "text": "پس در حقیقت دقت بفرمایید چقدر زیبا وقتی آیات رو کنار هم می‌بینید چقدر قشنگ دستگیرت میشه موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.33,
   "end": 427.01,
   "text": "همه با هم مرتبط‌اند و ما او تناقضات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.01,
   "end": 431.59,
   "text": "اقوال و که اصلاً بین اقوال شما تناقضی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.59,
   "end": 438.49,
   "text": "همش یکیه. در حقیقت این آیه فلسفت-- فلسفه بعثت انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.49,
   "end": 443.21,
   "text": "فلسفه‌ش اینه که حکمتش اینه که بیاد انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.21,
   "end": 445.61,
   "text": "به مخبت بودن برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.61,
   "end": 447.49,
   "text": "به حقیقت اخبات برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.49,
   "end": 449.95,
   "text": "چرا؟ خیلی سریع بگم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.95,
   "end": 452.65,
   "text": "چون اخبات سه ضلع داشت؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.65,
   "end": 455.17,
   "text": "خضوع، خشوع، اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.17,
   "end": 457.91,
   "text": "ما این سه تا رو در این آیه پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.91,
   "end": 462.33,
   "text": "اونچه که سبب اطمینان میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.33,
   "end": 467.19,
   "text": ". اونچه که سبب خضوع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.19,
   "end": 471.83,
   "text": "که مقدمه عبادت هست، اونم مقدمه خشوع است خضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.83,
   "end": 477.29,
   "text": "و اونچه که مق-- اونچه که سبب خشوع میشه یعنی خشوع میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.29,
   "end": 483.57,
   "text": ". . پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.57,
   "end": 489.79,
   "text": "ختم کلام برای رسیدن به قلب مخبت این آیه به زیرکی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.79,
   "end": 494.87,
   "text": "داره به ما راه حل رسیدن به قلب مخبت رو چی-- چگونه بیان می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.87,
   "end": 496.71,
   "text": "تو سه جهت. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.71,
   "end": 499.21,
   "text": "یکی ذکر یا تذکره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.21,
   "end": 504.37,
   "text": "تزکیه یا طهارت و تعلیم علم و معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.37,
   "end": 509.83,
   "text": "حالا بحث طهارت چون مقدمه است و خیلی هم مهمه فردا با هم یه چیزکی ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.83,
   "end": 516.27,
   "text": "برداشت می‌کنیم تو معارف ببینیم چقدر جایگاه مهمی طهارت داره هم از جهت باطنی هم ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.27,
   "end": 521.15,
   "text": "ان‌شاءالله قصه تموم ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.15,
   "end": 524.83,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.83,
   "end": 527.77,
   "text": "محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.77,
   "end": 530.75,
   "text": "محمد وعجل فرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}