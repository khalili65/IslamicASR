 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتای انحراف سنگ توالت از قبله",
   "start": 18.64,
   "end": 80.1
  },
  {
   "index": 1,
   "title": "## سومین نشانهٔ قلب مخبت: مقیم الصلاة",
   "start": 80.1,
   "end": 157.38
  },
  {
   "index": 2,
   "title": "## أقم الصلاة لذکری",
   "start": 157.38,
   "end": 461.91
  },
  {
   "index": 3,
   "title": "## ترک گداصفتی؛ عبادت حبی",
   "start": 461.91,
   "end": 619.43
  },
  {
   "index": 4,
   "title": "## بلای حب و دعای همسانی با آل محمد",
   "start": 619.43,
   "end": 730.57
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 4.26,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.26,
   "end": 7.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.92,
   "end": 12.68,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.68,
   "end": 18.64,
   "text": "در بحث طهارت استفتای دیگه‌ای که از رهبر عزیزمون شده این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.64,
   "end": 24.8,
   "text": "اگر متوجه بشیم که جسارتاً سنگ توالت که خب با-- نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.8,
   "end": 27.72,
   "text": "به گونه‌ای باشه که رو به قبله بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.72,
   "end": 31.9,
   "text": "یا پشت به قبله بشه؛ باید انحراف داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.9,
   "end": 38.34,
   "text": "از قبله. خب این رو ما حالا مثلاً متوجه شدیم که بیست درجه انحراف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.34,
   "end": 41.74,
   "text": "کاملاً منحرف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.74,
   "end": 44.72,
   "text": "بیست درجه، بیست و دو درجه مثلاً اینطوری سؤال شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.72,
   "end": 47.38,
   "text": "یعنی انحرافش از قبله کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.38,
   "end": 52.34,
   "text": "چیکار باید کرد اینجا؟ آقا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.34,
   "end": 56.42,
   "text": "میزان اینه که وقتی کسی نگاه کرد بگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.42,
   "end": 58.5,
   "text": "سنگ رو به قبله نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.5,
   "end": 61.0,
   "text": "منحرفه از قبله. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.0,
   "end": 65.7,
   "text": "حالا دیگه نیاز نیست که بری بشینی درجه‌شو بسنجی، چند درجه‌شو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.7,
   "end": 70.84,
   "text": "اینا که نیاز نیست. یعنی در عرف بگن آقا این سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.84,
   "end": 73.96,
   "text": "منحرفه از جهت قبله، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.96,
   "end": 78.84,
   "text": "حالا این انحراف می‌خواد کم باشه یا زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.84,
   "end": 81.38,
   "text": "خب ما رسیدیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.38,
   "end": 83.9,
   "text": "سومین بخش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.9,
   "end": 89.16,
   "text": "نشانه‌های قلب مخبت در آیه سی و پنج حج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.16,
   "end": 93.72,
   "text": "چون این خیلی مهمه این بخشش رو یه توضیح دیگه‌ای عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.72,
   "end": 95.82,
   "text": "امروز البته باید بخش چهارم رو می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.82,
   "end": 100.14,
   "text": "\"الذین اذا ذكر الله رجلت قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.14,
   "end": 107.4,
   "text": "یه وجهش بود \"والصابرین على ما اصابهم\" یه وجهش بود \"و المقیمي الصلاة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.4,
   "end": 110.3,
   "text": "وجه سوم از نشانه‌های قلب مخبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.3,
   "end": 116.6,
   "text": "چون آیه قبلش می‌فرمود \"وبشر المخبتین\" بعد این نشانه‌ها رو بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.6,
   "end": 123.6,
   "text": "و ما عرض کردیم حالت اخبات و قلب مخبت از نا-- لازمه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.6,
   "end": 127.12,
   "text": "ا یعنی نمی‌شه بدون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.12,
   "end": 129.54,
   "text": "نمی‌شه وارد بهشت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.54,
   "end": 131.28,
   "text": "آیه‌ش هم قبلاً تلاوت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.28,
   "end": 136.78,
   "text": "لذا انقدر با پا فشاری می‌کنیم چون همه هم دوست داریم بریم بهشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.78,
   "end": 141.8,
   "text": "حالا اینجا نکته‌ای که هست می‌فرماید که \"و المقیم الصلاة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.8,
   "end": 145.14,
   "text": "اولاً نکته اول اینکه میگه مقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.14,
   "end": 150.36,
   "text": "این‌ها در نمازشون میگن فل-- شما مقیم کجا هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.36,
   "end": 156.48,
   "text": "این یه نکته‌ست. یک وجه هست مثل دیروز میاییم بحث اقامه رو مطرح می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.48,
   "end": 159.06,
   "text": "گفته نخون نماز رو اقامه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.06,
   "end": 166.24,
   "text": "اون یه بحثه. اینجا اومده به یک لطائف الحیل خاص یعنی یک لطیفه‌ایه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.24,
   "end": 170.44,
   "text": "اینجا می‌فرماید مقیم نمازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.44,
   "end": 173.54,
   "text": "مثل اینکه از شما بپرسم آقا مقیم کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.54,
   "end": 177.36,
   "text": "کجا اقامت کردی؟ رحل اقامت گزیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.36,
   "end": 181.52,
   "text": "این نشون میده که یعنی اینا مثلاً میگن آقا مقیم فلان جایی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.52,
   "end": 185.34,
   "text": "اهل فلان جای دیگه. یعنی اینطوری ازش بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.34,
   "end": 187.08,
   "text": "یعنی اهل نمازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.08,
   "end": 191.84,
   "text": "اینا اصلاً خود نمازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.84,
   "end": 195.2,
   "text": "میگن فلانی مثلاً اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.2,
   "end": 198.18,
   "text": "چیه؟ ایل و تبار مثلاً لوراس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.18,
   "end": 200.52,
   "text": "اهل مثلاً لرستان، اهل یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.52,
   "end": 203.28,
   "text": "یعنی خودش لوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.28,
   "end": 206.3,
   "text": "فلانی اهل مثلاً آذربایجان، آذریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.3,
   "end": 211.52,
   "text": "خودش-- این که اهل نمازه یعنی اصلاً خودش نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.52,
   "end": 214.88,
   "text": "خودش نکته‌ست. اگه توجه بفرمایید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.88,
   "end": 219.74,
   "text": "الفاظ و این توجهاته که کار دست ما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.74,
   "end": 223.9,
   "text": "کار دست ما میده که واحد یه دفعه می‌بینی اِ یه باب جدیدی برات باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.9,
   "end": 228.64,
   "text": "ما وظیفه داریم به آیات قرآن توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.64,
   "end": 231.78,
   "text": "این آیات رو دقت داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.78,
   "end": 236.3,
   "text": "متأسفانه این‌هایی که فقط سمت روایات میرن سر می‌خورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.3,
   "end": 240.24,
   "text": "و اونام که فقط صرف سمت آیات میرن بدون روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.24,
   "end": 245.7,
   "text": "چون آی-- روایات ترجمات آیه، آیات ما که نمی‌دونیم آیه چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.7,
   "end": 248.44,
   "text": "روایات ترجمه آیاتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.44,
   "end": 256.7,
   "text": "از اون طرفم خود روایت محض هم همه روایات به ما هو بروایت درستی یعنی اون حدیث، اون عین کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.7,
   "end": 259.44,
   "text": "جان کلام اهل بیت که نیستن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.44,
   "end": 262.58,
   "text": "مثل الان شما این همه دارید می‌شنوید حرفای منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.58,
   "end": 264.46,
   "text": "بلافاصله بگیم آقا بشینید بنویسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.46,
   "end": 268.6,
   "text": "هیچ‌کدومتون نمی‌تونید عین کلمات منو بنویسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.6,
   "end": 272.52,
   "text": "لذا میان علم رجال و درایه و این‌ها چقدر بحث می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.52,
   "end": 275.42,
   "text": "یه معدود ما روایاتی داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.42,
   "end": 278.2,
   "text": "عینش یعنی مفا-- بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.2,
   "end": 283.54,
   "text": "علما قسم خوردن که این عین کلام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.54,
   "end": 286.3,
   "text": "و الا اینطور نیست که هر روایتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.3,
   "end": 288.56,
   "text": "معمولاً نقل به مزموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.56,
   "end": 290.68,
   "text": "هرکی به نقل به قلم خودش نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.68,
   "end": 294.88,
   "text": "اما آیه چی؟ آیه عین خود کلام خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.88,
   "end": 299.12,
   "text": "تنزل یافته کلام. لذا هرچی بهش دقت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.12,
   "end": 302.34,
   "text": "می‌بینی تشنه‌ترت می‌کنه. مقیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.34,
   "end": 304.5,
   "text": "میگه تو باید مقیم صلاة باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.5,
   "end": 306.14,
   "text": "حالا اصلاً چرا نماز می‌خونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.14,
   "end": 310.58,
   "text": "نکته دوم. خود قرآن می‌فرماید \"أقم الصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.58,
   "end": 313.26,
   "text": "لذکری\" نماز بخون برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.26,
   "end": 317.5,
   "text": "یاد من. خداوکیلی ما نماز می‌خونیم برای یاد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.5,
   "end": 322.22,
   "text": "بعدم متکلم ملغی رو یک یای، یای ضمیر متکلم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.22,
   "end": 325.56,
   "text": "ببخشید متکلم وحده. یای ضمیر میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.56,
   "end": 331.0,
   "text": "می‌فرماید برای من. یاد م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.0,
   "end": 333.62,
   "text": "نماز بخون برای چی؟ \"لذکری\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.62,
   "end": 339.18,
   "text": "برای من. مثل اون آیه‌ای که می‌فرمود خیلی اسرار تو اون آیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.18,
   "end": 342.66,
   "text": "می‌فرماد که پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.66,
   "end": 347.22,
   "text": "بگو \"اذا سألك عبادی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.22,
   "end": 350.76,
   "text": "وقتی از تو سؤال کردن بندگان من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.76,
   "end": 356.74,
   "text": "\"عني\" از من \"فاني\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.74,
   "end": 366.39,
   "text": "بهشون بگو که قطعاً من ببین هی میگه من، من \"قريب\" \"أجيب دعوة الداع إذا دعان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.39,
   "end": 373.41,
   "text": "فلیستجيبوا لي وليؤمنوا بي فلیستجيبوا لي وليؤمنوا بي لعلهم یرشدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.41,
   "end": 377.05,
   "text": "خیلی آیه پرسرّیه. مثلا نداریم آیه‌ تو قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.05,
   "end": 380.63,
   "text": "اینطوری چند تا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.63,
   "end": 383.91,
   "text": "متکلم وحده به خودش نسبت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.91,
   "end": 386.57,
   "text": "و همش خودش رو مطرح کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.57,
   "end": 388.13,
   "text": "این که همون لذکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.13,
   "end": 394.23,
   "text": "میگه عبادی، بندگان من مگه بندگان من با بندگان دیگر فرق می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.23,
   "end": 398.61,
   "text": "بله. می‌شه انسان نماز بخونه اما بنده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.61,
   "end": 402.21,
   "text": "جنت باشه جن-- بنده بهشت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.21,
   "end": 406.05,
   "text": "می‌تونه انسان نماز بخونه بنده‌ی دنیا باشه اصن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.05,
   "end": 408.39,
   "text": "ببینید همه‌ی اینا گیرش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.39,
   "end": 413.91,
   "text": "اینه که لذکری نیست برای ذکر مطلق خدا نیست، برای خود خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.91,
   "end": 417.25,
   "text": "ما به خاطر خدا نماز نخوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.25,
   "end": 421.43,
   "text": "گدا صفتی کردیم. خوب توجه بفرمایید نکته مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.43,
   "end": 424.57,
   "text": "یک انصراف عجیبی از نیات ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.57,
   "end": 429.39,
   "text": "عبادات ایجاد می‌کنه که اون موقع کم و کیف عباداتمون عالی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.39,
   "end": 434.05,
   "text": "میریم تو جرگه انشاالله اخب-- اهل اخبات و قلب مخبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.05,
   "end": 435.87,
   "text": "و بهترین جاهای بهشتو به ما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.87,
   "end": 440.53,
   "text": "چرا ندن؟ ما که داریم کارشو انجام میدیم چرا درستش نکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.53,
   "end": 445.75,
   "text": "دقت بفرمایید ما معمولا خدا رو از رو گدا صفتي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.75,
   "end": 449.09,
   "text": "عبادت می‌کنیم. از رو گدایی میریم در خونه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.09,
   "end": 455.77,
   "text": "این اصلا ذات گد-- طبع گدایی رو خدا دوست نداره و لو در عبادت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.77,
   "end": 458.37,
   "text": "میگه من رو برای خودم بخواه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.37,
   "end": 462.47,
   "text": "نه برای خودت. ما معمولا نماز می‌خونیم برا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.47,
   "end": 469.55,
   "text": "خداییش برا چیه؟ یا از ترس جهنمه یا عشق به بهشته یا ثواب و بالاخره ثواب و عقابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.55,
   "end": 474.47,
   "text": "فوقش دنبال کرامات معنوی و مقامات بالای معنوی و چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.47,
   "end": 476.37,
   "text": "یه چیزی در گروش می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.37,
   "end": 480.01,
   "text": "میگه سلام درویشان بی‌طمع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.01,
   "end": 483.35,
   "text": "یه سلامی ال-- السلام علیکم و رحمة الله، الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.35,
   "end": 487.47,
   "text": "اکبر. چی می‌خوای؟ مشکل دارم میگه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.47,
   "end": 491.69,
   "text": "اگه این مشکلاتو بگیرن اصلا شاید ما دیگه اصلا کلا نماز رو تعطیل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.69,
   "end": 497.83,
   "text": "خیلی کارامونو تعطیل کنیم. ما هنوز به عبادت حبی نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.83,
   "end": 501.71,
   "text": "اینجا لذا می‌فرماید مقیم نمازن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.71,
   "end": 506.93,
   "text": "اصلا همیشه در-- اصلا خودشون نمازن، خودشون ذکرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.93,
   "end": 510.17,
   "text": "سر تا پای وجودشون ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.17,
   "end": 513.49,
   "text": "این فهمش البته فهم عمیقی می‌خواد ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.49,
   "end": 515.73,
   "text": "لکن من دارم عرض می‌کنم و میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.73,
   "end": 519.01,
   "text": "یه بررسی بکنیم عباداتمون تو چه حسابی آخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.01,
   "end": 521.83,
   "text": "همین نمازمون آیا واقعا لذکریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.83,
   "end": 526.01,
   "text": "ببینم، ببین نمی‌فرماید که برای ذکر رحمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.01,
   "end": 528.63,
   "text": "نمی‌فرماید برای حتی ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.63,
   "end": 531.13,
   "text": "اینا همش خیلی نکته درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.13,
   "end": 534.35,
   "text": "باید حرف‌ها به قول بزرگان پیاده بشه تا اینو ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.35,
   "end": 538.83,
   "text": "می‌فرماید لذکری، مطلق من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.83,
   "end": 543.21,
   "text": "یعنی تو وجودت ذکر مطلق من بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.21,
   "end": 546.65,
   "text": "وسائط رو واسطه‌ها رو هم بذاری کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.65,
   "end": 551.97,
   "text": "کلمات وجودی عالم رو هم مثل بهشت و دیگران هم بذاری کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.97,
   "end": 554.23,
   "text": "صرفا عبادتت حبی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 554.23,
   "end": 560.11,
   "text": "دیدی با یکی خیلی رفیق میشی اصلا دوست داری ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.11,
   "end": 566.13,
   "text": "معمولا اینطوریه. طرف زنگ می‌زنه، یه ساله زنگ نزده زنگ می‌زنه به به چه عجب حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.13,
   "end": 568.63,
   "text": "زنگ زدی به ما ناپریزی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.63,
   "end": 572.61,
   "text": "دلم برات تنگ شده بود حاج آقا چاخان نگو باور کن دلم برات تنگ شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.61,
   "end": 574.67,
   "text": "خوبی؟ کجایی؟ چیکار می‌کنی؟ اینطوری گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.67,
   "end": 578.11,
   "text": "آراسته حاج آقا یه استخاره هم لطف کنید برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.11,
   "end": 580.57,
   "text": "همه‌ی این بازیا رو درآورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.57,
   "end": 587.63,
   "text": "که یه استخاره بزنه. بابا تو استخاره‌تو از اول می‌گفتی صادقانه رفتار کن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.63,
   "end": 592.27,
   "text": "و کیه که واقعا خود منو برای خودم بخواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.27,
   "end": 597.61,
   "text": "تو رو برای خودت بخواد. خدا میگه من اصلا می‌دونی برا چ-- چی تو رو خرج-- خلق کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.61,
   "end": 602.03,
   "text": "حدیث قدسیه. تو کتاب جواهر الثنیه فی احاديث القدیسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.03,
   "end": 605.33,
   "text": "خیلی هم حدیث شریفه. خیلی قشنگه این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.33,
   "end": 609.03,
   "text": "می‌فرماید من تو رو از حب، از عشق یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.03,
   "end": 611.83,
   "text": "دوست داشتم خلقت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.83,
   "end": 614.37,
   "text": "تو رو خلق کردم برای خودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.37,
   "end": 617.99,
   "text": "برای حب و دوستی. تو رو می‌خوام برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.99,
   "end": 621.15,
   "text": "تو هم منو به خاطر خودم بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.15,
   "end": 627.97,
   "text": "ببینید اصلا اساس خلقت ما آیا خدا احتیاج سر سوزنی به ما یا عبادت ما داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.97,
   "end": 630.95,
   "text": "حتی خلقت ما؟ نه. اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 630.95,
   "end": 632.91,
   "text": "خلقت ما چی بوده؟ حب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 632.91,
   "end": 636.87,
   "text": "عشق. خدا عشقش کشیده ما رو خلق کرده، دوست داشته ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.87,
   "end": 642.87,
   "text": "کدوم یکی از ما، از ما همین فلسفه خلقت و همین رو جوابشو درست دادیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.87,
   "end": 646.09,
   "text": "عشقی عبادت کردیم دیگه خودمونی عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.09,
   "end": 648.69,
   "text": "کیف کردیم. آقا اصلا هیچی نمی‌خوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.69,
   "end": 651.47,
   "text": "فقط می‌خوام مقیم نماز و مقیم صلاة باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.47,
   "end": 653.37,
   "text": "یک پارچه ذکر و عشق تو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.37,
   "end": 657.35,
   "text": "هیچی هم ندادی ندادی. به این میگن مقام حب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.35,
   "end": 660.99,
   "text": "عبادت حبی، جایگاه اخبات که مال اوهدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.99,
   "end": 664.83,
   "text": "از بزرگانم ها بگیم یه ذره مزه مزه ش بکنیم لااقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.83,
   "end": 666.91,
   "text": "توجه کردی که تو دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.91,
   "end": 669.01,
   "text": "قلب مخبت این جا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.01,
   "end": 672.07,
   "text": "بله البته چنین چیزی بلاخیز هم هست بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 672.07,
   "end": 677.71,
   "text": "وقتی کسی میگه من فقط خودتو می‌خوام میگه بفرمایین از گودی بلا و کربلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.71,
   "end": 681.85,
   "text": "این همه بلا و بلا و بلا پشت سر هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.85,
   "end": 687.71,
   "text": "بعد ما هم باید بگیم اللهم اجعل محیای محیا محمد و آل محمد و مماتی ممات محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.71,
   "end": 691.49,
   "text": "باید به اون سمت بریم. اگر می‌خوایم حبی باشه، اگه نمی‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 691.49,
   "end": 697.57,
   "text": "گدا صفتیو بیاید از همین الان طبع گدا صفتي رو مطلقا بذاریم کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 697.57,
   "end": 700.15,
   "text": "که من اومدم بگیرم و برم. گدا می‌گیره میره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 700.15,
   "end": 703.23,
   "text": "نمی‌مونه که. مقیم نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 703.23,
   "end": 708.33,
   "text": "مقیم الصلاة، مقیم الصلاة که تو این آیه میگه، میگه اصلا اومده که بمونه پیش من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 708.33,
   "end": 712.91,
   "text": "نیومده بگیره بره. چه بدم می‌مونه، چه ندم می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 712.91,
   "end": 719.13,
   "text": "این نکته‌ست. حالا حفظ نبود من اینم نمی‌گفتم با همدیگه مزه مزه ش نمی‌کردیم رد می‌شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.13,
   "end": 723.89,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.89,
   "end": 727.41,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 727.41,
   "end": 730.57,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}