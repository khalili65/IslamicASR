 "chapters": [
  {
   "index": 0,
   "title": "## تطهیر با کر و قلیل؛ قطع آب لازم نیست",
   "start": 1.92,
   "end": 129.4
  },
  {
   "index": 1,
   "title": "## آیهٔ بیست‌وسه هود؛ ایمان و عمل و اخبات",
   "start": 129.4,
   "end": 206.1
  },
  {
   "index": 2,
   "title": "## اخبات؛ خضوع و خشوع و اطمینان",
   "start": 206.1,
   "end": 350.4
  },
  {
   "index": 3,
   "title": "## دعای سجاد و عرفه؛ ذلت باطنی",
   "start": 350.4,
   "end": 371.03
  },
  {
   "index": 4,
   "title": "## موسی کلیم؛ گزینش به‌سبب ذلت",
   "start": 371.03,
   "end": 391.31
  },
  {
   "index": 5,
   "title": "## پس از نماز؛ محک توقع",
   "start": 391.31,
   "end": 630.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.92,
   "end": 5.5,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.5,
   "end": 9.26,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 14.0,
   "text": "آياته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.0,
   "end": 18.02,
   "text": "استفتای دیگری که از رهبرمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 20.86,
   "text": "طهارت شده اینه که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.86,
   "end": 23.42,
   "text": "وقت شستشو با آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.42,
   "end": 28.4,
   "text": "کر بعد از برطرف شدن عین نجاست باید یک بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.4,
   "end": 31.58,
   "text": "شستشو بشه و با آب قلیل دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.58,
   "end": 35.52,
   "text": "حالا سؤال اینجاست که آیا ما باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.52,
   "end": 38.18,
   "text": "آب رو قطع کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.18,
   "end": 42.06,
   "text": "یعنی اینکه مثلاً میگه عین نجاست که برطرف شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.06,
   "end": 47.22,
   "text": "حالا یه دور میشوری، حالا دو بار میشوری با آب قلیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.22,
   "end": 51.18,
   "text": "این حالا دو بار، حالا یه بار باید آب قطع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.18,
   "end": 56.48,
   "text": "دو مرتبه آب ریزش پیدا کنه یا همین‌طوری که آب داره ریخ-- می‌ریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.48,
   "end": 62.64,
   "text": "و عین نجاست برطرف شد حالا نیت می‌کنی آب داره ریخته می‌شه، نیت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.64,
   "end": 66.42,
   "text": "بار اوله میشوری بار دومه میشوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.42,
   "end": 70.02,
   "text": "آب قطع بشه یا نه همون‌طوری ادامه پیدا کنه آب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.02,
   "end": 73.64,
   "text": "آقا فرمودن نه نیازی نداره که آبو قطع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.64,
   "end": 78.76,
   "text": "همین که آب داره ریزش می-- می‌ریزه روی اون قسمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.76,
   "end": 82.46,
   "text": "که حالا نجس بوده و عین نجاست برطرف شده حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.46,
   "end": 88.0,
   "text": "دیگه شما نیتت اینه که داری میشو-- میشوریش حالا چه بار اوله چه بار دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.0,
   "end": 93.22,
   "text": "نیتت یه بار شستنه، نیتت دو بار شستنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.22,
   "end": 98.9,
   "text": "کفایت می‌کنه. نمی‌خواد آبو قطع کنی دوباره از نو آبو وصل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.9,
   "end": 101.42,
   "text": "یکی دیگه از آیاتی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.42,
   "end": 104.34,
   "text": "موضوع اخبات و قلب مخبط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.34,
   "end": 108.94,
   "text": "در حقیقت مخبتین رو خیلی زیبا معرفی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.94,
   "end": 113.24,
   "text": "آیه بیست و سه سوره هوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.24,
   "end": 118.48,
   "text": "یکی از لطایفی در این آیات اومده که کمتر بهش توجه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.48,
   "end": 123.28,
   "text": "ببینید إن الذين آمنوا وعملوا الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.28,
   "end": 130.76,
   "text": "معمولا ما تو قرآن هرچی نگاه می‌کنیم اینجوریه آمنوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.76,
   "end": 133.34,
   "text": "صالحات. این عم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.34,
   "end": 135.78,
   "text": "آمن و عملو، آمن و عملو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.78,
   "end": 139.66,
   "text": "این دو تا با هم اومده ایمان کنار عمل صالح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.66,
   "end": 141.9,
   "text": "تمام. معمولا به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.9,
   "end": 146.24,
   "text": "وقتی هم که ذهنمونو سرچ کنیم می‌بینیم همیشه آمنوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.24,
   "end": 151.98,
   "text": "عملو این دو تا اومده دیگه بقیش تو ذهن ما چیزی نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.98,
   "end": 154.38,
   "text": "فرایند دیگه‌ای صورت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.38,
   "end": 160.62,
   "text": "عادت کردیم مثلاً شرطی شدیم تو آیات قرآن آمنوا، عملو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.62,
   "end": 169.04,
   "text": "لکن اینجا بلافاصله بعد از اینکه فرموده إن الذين آمنوا وعملوا الصالحات و أخبتوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.04,
   "end": 172.7,
   "text": "یه جمله جدیدی آورده که معمولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.7,
   "end": 178.6,
   "text": "توی آیاتی که بحث ایمان و عمل صالح هست این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.6,
   "end": 182.1,
   "text": "اینه که علامه طباطبایی رحمة الله علیه می‌فرماین باید آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.1,
   "end": 186.16,
   "text": "قرآنو همه رو کنار هم دید و الا انسان به انحراف می‌که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.16,
   "end": 188.76,
   "text": "می‌کشه کارش یعنی منحرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.76,
   "end": 192.32,
   "text": "اگر چند تا آیه رو ببینه همه رو نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.32,
   "end": 194.88,
   "text": "در حقیقت اینجا می‌فرمود بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.88,
   "end": 201.74,
   "text": "اون که قطعاً اون کسانی که ایمان آوردن و عمل صالح انجام دادن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.74,
   "end": 205.16,
   "text": "نخیر و اخبتوا إلى ربهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.16,
   "end": 209.92,
   "text": "اینا به مقام اخبات به سوی پروردگارشون رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.92,
   "end": 214.04,
   "text": "اونان که أولئک أصحاب الجنة هم فيها خالدون توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.04,
   "end": 222.68,
   "text": "ببینید طبق اون آموزه‌های قبلی‌مون بر اساس دیدن بعضی از آیات ما باید اینطوری می‌گفتیم آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.68,
   "end": 225.52,
   "text": "إن الذين آمنوا وعملوا الصالحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.52,
   "end": 229.96,
   "text": "أولئک أصحاب الجنة هم فيها خالدون کسی اشکال می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.96,
   "end": 231.92,
   "text": "کسی میگه آقا اشتباه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.92,
   "end": 235.6,
   "text": "میگه نه دیگه عمل صالح کنار ایمان اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.6,
   "end": 243.2,
   "text": "جزاش بهشته. اما اینجا شرطه و اخبتوا واقعا عطف هم آورده و این‌ها کسایی باید باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.2,
   "end": 245.3,
   "text": "که به مقام اخبات رسیده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.3,
   "end": 247.06,
   "text": "یعنی قلب مخبت داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.06,
   "end": 254.58,
   "text": "اون موقع است که أولئک أصحاب الجنة هم فيها خالدون برای همیشه تو جنت هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.58,
   "end": 257.4,
   "text": "ببینید این نشون میده که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.4,
   "end": 259.04,
   "text": "مقام اخبات مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.04,
   "end": 263.24,
   "text": "ما فکر نکنیم که حالا بابا ولمون کن دیگه تو هم آقا گیر دادی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.24,
   "end": 265.66,
   "text": "هی مخبتین، مخبتین. ما همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.66,
   "end": 268.06,
   "text": "ایمان و عمل صالح داشته باشیم بحثمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.06,
   "end": 273.28,
   "text": "نخیر، اگر بر اساس این آیه اگر کسی به مقام اخبات نرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.28,
   "end": 275.92,
   "text": "هم فيها خالدون به مشکل بر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.92,
   "end": 280.86,
   "text": "کجا در بهشت؟ اخبات هم که عرض کردیم یک حالتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.86,
   "end": 283.42,
   "text": "که بچه‌ها خیلی خوب قشنگ فرمولش کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.42,
   "end": 288.88,
   "text": "درس مواد همون آموزه‌هایی که ما از روایات و آیات اینجا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.88,
   "end": 292.6,
   "text": "خذو کنار خشوع با آرامش، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.6,
   "end": 299.22,
   "text": "یادتونه؟ گفتیم خذو کنار خشوع، خذو ظاهر انسانه، خشوع باطن انسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.22,
   "end": 307.2,
   "text": "کنار اطمینان که می‌شه همون سکون، آرامش، آرامش محض در درون انسان آرامش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.2,
   "end": 313.48,
   "text": "خلاصه‌ش می‌شه حالا همین سه تا رو شما بخوای خلاصه کنی می‌شه تس-تسلیم محض خدا بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.48,
   "end": 318.82,
   "text": "یعنی گاهی اوقات انسان عبادت می‌کنه، نماز می‌خونه اما از خدا متوقعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.82,
   "end": 323.3,
   "text": "توجه کردید؟ خیلی راحت می‌تونه انسان مهک بزنه خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.3,
   "end": 326.1,
   "text": "عبادتشو انجام داده. آیا توقع داره از خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.1,
   "end": 331.4,
   "text": "آهای خدا حالا این همه ما نماز خوندیم، روضه خدا این حاجتمو بده دیگه چرا نمیدی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.4,
   "end": 334.88,
   "text": "جنگ داره با خدا تو درونش و لو به ظاهر نگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.88,
   "end": 340.86,
   "text": "این متوقع بودن خدا نشون میده که هنوز نرسیده قلبش به حالت اخبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 340.86,
   "end": 345.52,
   "text": "تسلیم نیست. ذلیلانه در برابر خدا حاضر نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.52,
   "end": 349.88,
   "text": "پررو هم هست اتفاقا. ذلیل باید باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.88,
   "end": 356.42,
   "text": "اینکه امام سجاد سلام الله علیه در دعای شریفش به خدا عرض می‌کنه که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.42,
   "end": 363.7,
   "text": "یا ابی عبدالله سلام الله علیه هم در دعای عرفه این رو داره که می‌فرماید هر مقدار منو تو چشم مردم بالا بردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.7,
   "end": 368.27,
   "text": "همون مقدار در درون به من ذلت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 368.27,
   "end": 372.99,
   "text": "اگه یه درجه تو چشم مردم بردیم بالا، یه درجه در درون خودم ذلت بهم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 372.99,
   "end": 374.97,
   "text": "در برابر تو احساس ذلت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.97,
   "end": 378.87,
   "text": "پررو میشه آدم. چهار نفر دور آدمو بگیرن فکر می‌کنه خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.87,
   "end": 384.31,
   "text": "حالا چهار تا نماز شب و نماز و روزه و ذکر و ورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.31,
   "end": 387.61,
   "text": "در هر حال نفس ناطقه انسان هم به گونه‌ایست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.61,
   "end": 392.59,
   "text": "یه مقدار با معنویت خو می‌گیره، توهمش گل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.59,
   "end": 396.11,
   "text": "اون وهم، وادی وهم یک وادی بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.11,
   "end": 398.43,
   "text": "مهمه در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.43,
   "end": 401.29,
   "text": "رسیدن به عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.29,
   "end": 405.11,
   "text": "سر و قلب و استقرار قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.11,
   "end": 410.17,
   "text": "لکن رهزنی شیطان در قوه واهمه خیلی قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.17,
   "end": 416.33,
   "text": "می‌دونید دیگه شیطان تا قوه واهمه ما می‌تونه بیاد، به عقل دیگه نمی‌تونه دسترسی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 416.33,
   "end": 419.87,
   "text": "اینه که شو-- اشکال و صور بسیاری تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 419.87,
   "end": 423.69,
   "text": "ذهن آدم ایجاد می‌کنه تو قوه خیالیه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 423.69,
   "end": 426.51,
   "text": "عرض کنم مثال‌های متعدد میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 426.51,
   "end": 429.73,
   "text": "وهم و خیال آدم گمان می‌کنه خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.73,
   "end": 435.55,
   "text": "مرتبط با معنویت هم شده به اینجا رسیده اما هنوز به بدل عقل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 435.55,
   "end": 438.17,
   "text": "حالت ذلیلانه در درگاه خدا نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.17,
   "end": 446.01,
   "text": "اینه که خدای منان به موسی کلیم اینو فکر می‌کنم در کتاب جواهر الثنیه فی احادیث قدسیه دیدم از شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.01,
   "end": 448.33,
   "text": "حر عاملی رحمة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 448.33,
   "end": 453.01,
   "text": "خیلی قشنگه این جمله که خدا به موسی کلیم الله فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 453.01,
   "end": 455.77,
   "text": "موسی می‌خوای بدونی چرا تو رو انتخاب کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 455.77,
   "end": 460.17,
   "text": "بین این همه آدم تو رو انتخاب کردم برای کلیم اللهی، برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.17,
   "end": 462.45,
   "text": "اینکه با من گفت‌وگو کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.45,
   "end": 466.01,
   "text": "کلیم اللهی خیلی مقام بالاییه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 466.01,
   "end": 468.15,
   "text": "و موسی عرض کرد خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.15,
   "end": 470.87,
   "text": "بفرمایید خدای من نمی‌دونم چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.87,
   "end": 475.79,
   "text": "خدا فرمود به خاطر اینکه نگاه کردم در میان بندگانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 475.79,
   "end": 482.25,
   "text": "حالتی ذلیلانه‌تر و خاضعانه‌تر از تو نیافتم در برابر خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 482.25,
   "end": 485.31,
   "text": "حالا تو یه جای دیگه دیدم فرموده بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.31,
   "end": 490.07,
   "text": "نیایش و نماز تو و اینا دیدم هیچکس به اندازه تو سر به خاک نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.07,
   "end": 495.25,
   "text": "دوتاش یه معنا داره. اون حالت ذلیلانه در درگاه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.25,
   "end": 498.63,
   "text": "شما ببینید معمولا کسایی که سفیران الهی می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.63,
   "end": 502.11,
   "text": "در مسیر خدا و الهیت عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.11,
   "end": 507.31,
   "text": "پرچم‌دار می‌شن، خضوعشون از همه بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.31,
   "end": 511.03,
   "text": "الان مثلا یه مدیر ببینید با دفتردارش چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.03,
   "end": 513.37,
   "text": "خیلی راحت می‌شود تشخیص داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 513.37,
   "end": 518.37,
   "text": "با زیردستش چگونه است. متواضعانه است یا متکبرانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 518.37,
   "end": 523.19,
   "text": "مسئول، کسی که یه درجه مثلا بالاتر از کس دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.19,
   "end": 525.49,
   "text": "وقتی امام تو جماران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.49,
   "end": 530.01,
   "text": "هوا سرد بود، برف اومده بود، نگاه کرد دید پاسداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 530.01,
   "end": 533.63,
   "text": "سردش شده، چنبات‌مه زده خوابش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 533.63,
   "end": 539.57,
   "text": "پُ-- پست داشت می‌داد برای مثلا از جماران از بیت امام پست داشت می‌داد و نگهبانی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 539.57,
   "end": 546.05,
   "text": "حالا اگه مثلا یه آدم متکبر و شاه و پادشاهی چیزی بود در دم می‌گفت گردن اینو بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.05,
   "end": 552.81,
   "text": "خوابش رفته بود سر پست. یه لحظه به هوش اومد، یعنی ب-بیدار شد از اون حالت دید اِ امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 552.81,
   "end": 555.77,
   "text": "اسلحه‌شو ورداشته انداخته رو دوشش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 555.77,
   "end": 561.09,
   "text": "اسلحه این پاسداره رو. دست می‌کشه سرش میگه پسرم خسته ای برو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 561.09,
   "end": 562.71,
   "text": "سربازخونه‌ت اونجا استراحت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 562.71,
   "end": 566.93,
   "text": "من به جات اینجا پست میدم. ببینه تو رو خدا آخه کی اینطور رفتار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 566.93,
   "end": 570.15,
   "text": "کی؟ خدا نکنه یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.15,
   "end": 572.17,
   "text": "چاییمونو آبدارچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 572.17,
   "end": 575.07,
   "text": "محل کارمون دیرتر بیاره بذاره رو میزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.07,
   "end": 577.55,
   "text": "دادمون بلند می‌شه. این کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.55,
   "end": 581.41,
   "text": "این چی بود؟ بهش تذکر بدید فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.41,
   "end": 587.05,
   "text": "از این راهه خیلی راحت می‌شه از این راه‌ها تشخیص داد حالت ذلیلانه داریم یا متوقعانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 587.05,
   "end": 589.03,
   "text": "وقتی نمازت تموم می‌شه می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 589.03,
   "end": 592.55,
   "text": "خب حالا نماز تموم شد وقت درخواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 592.55,
   "end": 595.09,
   "text": "خواسته‌هامون از خداست. وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.09,
   "end": 598.41,
   "text": "دعا. دیگه کارمونو انجام دادیم، متوقع‌ایم ما بعضی موقع‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.41,
   "end": 601.27,
   "text": "یعنی خلاصه مطلب اذیتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 601.27,
   "end": 610.37,
   "text": "اگر به این حالت ذلیلانه و بی‌توقعی که تسلیم است در برابر خدا به صورت محض که بهش مقام اخلاص هم بعضا می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.37,
   "end": 612.53,
   "text": "نرسیدیم عزیز دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.53,
   "end": 617.01,
   "text": "ایمان و عمل صالح به تنهایی فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.01,
   "end": 621.93,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.93,
   "end": 630.25,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}