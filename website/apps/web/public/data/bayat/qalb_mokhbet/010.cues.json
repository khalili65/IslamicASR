 "chapters": [
  {
   "index": 0,
   "title": "## اصل کلی طهارت: همه چیز محکوم به طهارت است",
   "start": 0.48,
   "end": 21.32
  },
  {
   "index": 1,
   "title": "## نشانهٔ سوم: مقیم الصلاة نه فقط خوانندهٔ نماز",
   "start": 21.32,
   "end": 211.8
  },
  {
   "index": 2,
   "title": "## قیام کعبه و قیام امام عصر بر چهار ذکر",
   "start": 211.8,
   "end": 232.42
  },
  {
   "index": 3,
   "title": "## سکوت، حکمت و تمرکز قوا بر اذکار",
   "start": 232.42,
   "end": 670.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 4.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.48,
   "end": 8.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.12,
   "end": 11.98,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.98,
   "end": 15.66,
   "text": "یک اصل کلی در طهارت وجود داره عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.66,
   "end": 19.2,
   "text": "که این یک اصل کلی هست و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.2,
   "end": 22.36,
   "text": "مراجع به اون متفق القولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.36,
   "end": 26.8,
   "text": "اونم اینکه همه چی محکوم به طهارته این یادمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.8,
   "end": 30.32,
   "text": "همه چی، همه چی محکوم به طهارته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.32,
   "end": 33.14,
   "text": "مگر اینکه عکسش ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.14,
   "end": 41.24,
   "text": "یا اون ثابت شدن هم از دو طریقه، یا اینکه خودت عین نجاست رو ببینی یا نجس شدن چیزی رو ببینی متنجس شدنشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.24,
   "end": 46.3,
   "text": "یا یه شخص عادلی به شما خبر بده بگه آقا اینجا نجس شد من دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.3,
   "end": 50.08,
   "text": "در غیر این صورت حتی معذرت می‌خوام سنگ توالت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.08,
   "end": 55.06,
   "text": "پاکه. شما شاید نجاست درش ندیدی که، آب ریختن شسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.06,
   "end": 56.8,
   "text": "سخت نگیرین تو بحث طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.8,
   "end": 59.7,
   "text": "اونچه که اسلام سخت گرفته در گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.7,
   "end": 64.06,
   "text": "و عدم طهارت باطنیه، اونجا خیلی اسلام سخت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.06,
   "end": 66.7,
   "text": "خب تو بحث قلب مخبط بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.7,
   "end": 70.28,
   "text": "بر اساس آیه سی و پنج سوره حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.28,
   "end": 74.42,
   "text": "و نشانه‌های مخبطین و کسی که دارای قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.42,
   "end": 80.24,
   "text": "مخبط هست، اشاره کردیم به این آیه که چهار نشونه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.24,
   "end": 83.14,
   "text": "اهل اخباث رو بیان می‌کنه که جالبه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.14,
   "end": 86.92,
   "text": "اینو شما بدونید که این چهار نشونه همراه با هم باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.92,
   "end": 91.14,
   "text": "اینطور نیست که یه دونه‌شم کسی داشته باشه بگیم قلب مخبط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.14,
   "end": 96.24,
   "text": "نخیر. خب یکیش الذین اذا ذكر الله وجلت قلوبهم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.24,
   "end": 99.28,
   "text": "بعدیش والصابرین على ما اصابهم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.28,
   "end": 104.46,
   "text": "بحث صبر بود. سومیش والمقيم الصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.46,
   "end": 108.5,
   "text": "خیلی جالبه که هیچ کجای قرآن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.5,
   "end": 111.22,
   "text": "دستورات اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.22,
   "end": 113.46,
   "text": "نمیگن خواندن نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.46,
   "end": 119.94,
   "text": "همه بدون اس-- بدون استثناء قرآن می‌فرماید، اهل بیت می‌فرمایند اقامه صلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.94,
   "end": 123.14,
   "text": "اولاً خود صلاة یه معنای در خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.14,
   "end": 128.88,
   "text": "از ریشه صَلَ الَ اگه بگیریم یعنی سوختن یا سوزاندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.88,
   "end": 131.34,
   "text": "در حقیقت نماز باید درون و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.34,
   "end": 134.06,
   "text": "ناپاکی‌های وجود رو بسوزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.06,
   "end": 140.22,
   "text": "یا نه خود انسان نمازش به گونه‌ای باشه که با سوختن نماز رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.22,
   "end": 145.12,
   "text": "حالا سوختن، اون سوختن عشق و درون و بفهمه داره چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.12,
   "end": 149.76,
   "text": "مثل کسی که یک عمر از دوری محبوب و معشوقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.76,
   "end": 154.98,
   "text": "سوخته، حالا اون آتش گر گرفته‌ش می‌شه نمازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.98,
   "end": 159.4,
   "text": "و اگه اینچنین نگاه کنیم من اصلاً نماز، من خودم نماز نمی‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.4,
   "end": 163.38,
   "text": "حالا رو ریشه کلمه خیلی کاری نداریم رو بحث اقامه کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.38,
   "end": 166.76,
   "text": "این توجه بفرمایید خیلی نکته مهمی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.76,
   "end": 170.98,
   "text": "که اولاً ما تا نمازمون درست نشه بقیه کارهامون درست نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.98,
   "end": 176.9,
   "text": "این که اصل اساسی‌ست. لکن اینم توجه داشته باشیم ق-- نماز خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.9,
   "end": 179.58,
   "text": "خود صلاة ذات صلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.58,
   "end": 182.86,
   "text": "محک زدن بقیه کارها هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.86,
   "end": 188.84,
   "text": "لذا آقای بهجت فرمودن نماز می‌خونی نه این برای این بخونی که کیف کنی، عشق کنی، حال کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.84,
   "end": 191.76,
   "text": "فرمودن که بخون که ببینی چگونه زندگی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.76,
   "end": 194.82,
   "text": "اگر تو بیرون نمازت درست باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.82,
   "end": 197.42,
   "text": "داخل نمازت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.42,
   "end": 200.68,
   "text": "پس اشکال کار برمی‌گرده به بیرون نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.68,
   "end": 205.26,
   "text": "این که می‌فرماید اقامه صلاة اصلاً معنیش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.26,
   "end": 208.12,
   "text": "یعنی باید نماز اقامه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.12,
   "end": 211.46,
   "text": "اقامه بر چی بشه؟ بر ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.46,
   "end": 214.02,
   "text": "مثل حضرت ولی عصر ارواحنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.02,
   "end": 218.08,
   "text": "فدا که انشالله وقتی تشریف میارن ایشون رو برای چی قائم میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.08,
   "end": 220.76,
   "text": "چون قیام می‌کنند به ذکر الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.76,
   "end": 224.88,
   "text": "به ذکر خدا. چرا پشت به خانه کعبه می‌زنن و قیام می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.88,
   "end": 227.44,
   "text": "چون خانه کعبه هم قائم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.44,
   "end": 231.34,
   "text": "اون قبة الارضی که اولین بار سر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.34,
   "end": 235.42,
   "text": "حالا زیر آب بیرون آورد در اون مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.42,
   "end": 239.56,
   "text": "جدید خلقت که هر مرحله به مرحله این‌ها فرق می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.56,
   "end": 244.28,
   "text": "و ما در خلقت انسان در مرحله هفتمش هستیم و بعد از ما هم دو سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.28,
   "end": 248.18,
   "text": "مرحله دیگری هست و هر کدوم قبة الارضش به شکلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.18,
   "end": 251.4,
   "text": "تو علم هیأت این‌ها بر-بررسی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.4,
   "end": 254.04,
   "text": "اون زمین قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.04,
   "end": 257.74,
   "text": "اولین خشکی‌ست که از زیر آب قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.74,
   "end": 260.86,
   "text": "چون قیام کرد، خب بر اساس چی قیام کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.86,
   "end": 263.84,
   "text": "چهار ذکر. رضا کعبه هم چهار رکن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.84,
   "end": 268.06,
   "text": "سبحان الله، الحمدالله، لا اله الا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.06,
   "end": 274.38,
   "text": "الله اکبر. بر اساس این چهار ذکر و حقیقت این چهار ذکر قیام کرده کعبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.38,
   "end": 277.52,
   "text": "امام عصر هم قیامش به-- یعنی د--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.52,
   "end": 280.04,
   "text": "تکیه به جایی می‌زنه که او هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.04,
   "end": 282.84,
   "text": "قائم است. او هم قیام کرده، یعنی کعبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.84,
   "end": 286.56,
   "text": "یعنی باید اینچنین باشه. اصلاً به غیر از این نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.56,
   "end": 291.68,
   "text": "کسایی جلو-- دور امام عصر جمع می‌شن که اون‌ها هم اهل قیامن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.68,
   "end": 294.64,
   "text": "اون‌ها هم قائمن. اون‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.64,
   "end": 297.88,
   "text": "نشانه‌هاشون، بهترین نشانه‌شون در نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.88,
   "end": 300.78,
   "text": "اون‌ها هم صلاةشون رو اقامه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.78,
   "end": 303.12,
   "text": "اقامه در این چهار ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.12,
   "end": 305.9,
   "text": "یعنی وجود این‌ها، دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.9,
   "end": 311.7,
   "text": "روح این‌ها، قوای عاقله‌شون، درونشون، ذات و سرشتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.7,
   "end": 314.04,
   "text": "تغذیه‌ش از این ذکر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.04,
   "end": 317.38,
   "text": "می‌دونید تغذیه‌ی باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.38,
   "end": 320.38,
   "text": "از حقیقت اذكار صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.38,
   "end": 324.0,
   "text": "آقای بهجت می‌فرمایند که قوت ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.0,
   "end": 326.22,
   "text": "همین تسبیحات اربعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.22,
   "end": 329.86,
   "text": "که ما به راحتی می‌گیم می‌ریم. همین تسبیح حضرت زهرا الان با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.86,
   "end": 334.88,
   "text": "یه کمکی متوجه می‌شیم عظمت این تسبیح و که متأسفانه من غصه می‌خورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.88,
   "end": 337.92,
   "text": "در مساجد ما این تسبیح تعظیم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 337.92,
   "end": 340.52,
   "text": "ای کاش همه جا درست مثل شماها بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 340.52,
   "end": 342.7,
   "text": "تازه این ظاهرشه، شکل ظاهرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 342.7,
   "end": 349.94,
   "text": "باطنشو که اگر کسی به باطن ح-حقیقت تسبیح حضرت زهرا سلام الله علیها که قیام به اون اق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.94,
   "end": 353.22,
   "text": "تمام عوالم هستی به اون قیام کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.22,
   "end": 357.44,
   "text": "و قوام همه عوالم به اون چهار ذکره متوجه بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.44,
   "end": 359.6,
   "text": "اصلاً این یعنی باقیات الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.6,
   "end": 369.6,
   "text": "حدیث داریم کسی می‌تونه به حقیقت این ذکر دست پیدا کنه، در نتیجه وجودش قائم بشه، لذا نمازش قیام باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.6,
   "end": 372.08,
   "text": "و اقامه باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.08,
   "end": 374.38,
   "text": "به حکمت دست پیدا کرده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.38,
   "end": 376.64,
   "text": "و سکوت اختیار کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 376.64,
   "end": 380.3,
   "text": "لذا یه حدیث عجیب از حضرت زهرا سلام الله علیها دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.3,
   "end": 384.22,
   "text": "تو رو خدا این احادیث رو قدر بدونید چون هر جایی نیست و گفته نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.22,
   "end": 387.32,
   "text": "خانم فرمود بگردید دنبال کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.32,
   "end": 391.84,
   "text": "سکوت زیاد داره و باهاش رفیق بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.84,
   "end": 397.76,
   "text": "چرا؟ بعد خود خانم می‌فرمایند کسی که سکوت زیاد داره به حکمت رسیده، بهش حکمت می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.76,
   "end": 402.46,
   "text": "کسی که حکیمه یعنی وجودش قائمه بر اذکار، بر اون چهار ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.46,
   "end": 407.2,
   "text": "کسی که وجودش قائمه یعنی حواجس، افکارش، قوای خیالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.2,
   "end": 410.26,
   "text": "زیرمجموعه قوه عقلش قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 410.26,
   "end": 413.46,
   "text": "و پراکنده فکر نمی‌کنه، متمرکز فکر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.46,
   "end": 420.44,
   "text": "همه، همه عوالم وجودیش و همه افکارش متمرکز رو حقیقت این چهار ذکره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.44,
   "end": 425.78,
   "text": "حتی سر کار میره، شغل اختیار می‌کنه، ازدواج می‌کنه، دانشگاه میره، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.78,
   "end": 432.66,
   "text": "شئونی از شئونات مختلف زندگیش رو اختیار می‌کنه بر اساس این چهار ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.66,
   "end": 435.26,
   "text": "وقتی می‌خواد بره سر کار میگه سبحان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.26,
   "end": 438.04,
   "text": "وقتی می‌خواد یه انتخاب کنه میگه الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.04,
   "end": 439.6,
   "text": "و اینا باید البته روش کار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.6,
   "end": 442.8,
   "text": "یعنی چی؟ وقتی میگه سبحان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.8,
   "end": 446.42,
   "text": "یعنی خدایا همه نواقص، این یه وجهش البته، از تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.42,
   "end": 451.68,
   "text": "بریه. اگر ضرری من تو زندگیم می‌کنم از خودمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.68,
   "end": 455.38,
   "text": "ما أصابک من سیئه فمن نفسك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.38,
   "end": 458.48,
   "text": "ما أصابک من حسنه فمن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.48,
   "end": 463.0,
   "text": "هرچی سیئه و بدیه از خودته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.0,
   "end": 466.36,
   "text": "قرآن می‌فرمایده و هرچی خیره از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.36,
   "end": 469.84,
   "text": "خیر محض هم خدا تو این چهار تا ذکر قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 469.84,
   "end": 474.08,
   "text": "اگر کسی تو این چهار تا ذکر تمرکز داشت، تفکر داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.08,
   "end": 477.1,
   "text": "سکوت داشت بر اساس این چهار ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.1,
   "end": 479.24,
   "text": "اون موقع نمازش قیام داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.24,
   "end": 486.12,
   "text": "قائمه. لذا این همه میلیاردی و میلیونی آدم چندتاشون دارن، اصلاً چندتاشون نماز می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.12,
   "end": 489.24,
   "text": "از همینم که نماز می‌خونن چندتاشون اقامه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.24,
   "end": 490.98,
   "text": "آقای بهجت چقدر عمر کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.98,
   "end": 493.18,
   "text": "هشت، نود سال، چقدر؟ صد سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.18,
   "end": 498.8,
   "text": "خودشون فرمودن من تو کل عمرم سه نفر رو دیدم نماز اقامه می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.8,
   "end": 504.68,
   "text": "بعد دو تاشون رو حس می‌بره. یکیش که میگه میرزای دوم عجب نمازی می‌خوند، آقای بهجت می‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.68,
   "end": 507.18,
   "text": "یکی شیخ عبدالله پیاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.18,
   "end": 511.88,
   "text": "معروف بوده. یه آدم مثلا نه عالم آنچنانی بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 511.88,
   "end": 513.82,
   "text": "حالا آدم مقدسی بوده، نماز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.82,
   "end": 518.66,
   "text": "بعد آقای بهجت می‌فرمود اصلاً فکر معصیت هم نمی‌کرد شیخ عبدالله پیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.66,
   "end": 520.56,
   "text": "ببین فکر معصیت نمی‌کرد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.56,
   "end": 524.46,
   "text": "یعنی فکرش قوای فکریش متمرکز بود روی یه نقطه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.46,
   "end": 530.4,
   "text": "روی یک نقطه. اونم ذکره، ذکر، ذکر الله که پایه ذکر الله اون چهار ذکرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.4,
   "end": 534.94,
   "text": "اگر کسی اینطوری شد، اون موقع می‌تونه دور امام عصر بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.94,
   "end": 538.02,
   "text": "دور حضرت رو بگیره، جزو اون حلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.02,
   "end": 540.0,
   "text": "حالا اوتاد نه، ابدال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.0,
   "end": 543.1,
   "text": "ابدال نه، ابرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.1,
   "end": 545.44,
   "text": "یا حالا به عبارتی صلحا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.44,
   "end": 548.02,
   "text": "صلحا نشد؟ جزو نقبا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.02,
   "end": 550.6,
   "text": "نقبا نشد؟ لااقل نجبا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.6,
   "end": 552.6,
   "text": "این حلقه‌های ابتدایی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 552.6,
   "end": 557.62,
   "text": "اگر دیگه نشد به هیچ وجه من الوجوه اقامه صلاة کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 557.62,
   "end": 561.32,
   "text": "نمازش همه کدورت‌های وجودش رو بسوزونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.32,
   "end": 563.94,
   "text": "و او اقامه کنه بر حقیقت ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.94,
   "end": 571.2,
   "text": "اگر نشد به اینجا برسه، او متصل به قائم نیست و نمی‌تونه در اون قیام جهانی شرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.2,
   "end": 573.58,
   "text": "اما اگر کسی به این قیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 573.58,
   "end": 581.7,
   "text": "و ان شاء الله به این اقامه صلاة به این معنا که نشانه اهل اخبات و قلب مخدبت است رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 581.7,
   "end": 584.74,
   "text": "هر کجای عالم دفن شده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 584.74,
   "end": 596.8,
   "text": "می‌فرمود که اون موقع می‌تونه دور حضرت رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.8,
   "end": 599.7,
   "text": "هر کجا باشه اصلاً میاد، می‌کشوننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.7,
   "end": 601.92,
   "text": "این اقامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.92,
   "end": 605.66,
   "text": "قیام حضرت هر کسی که اهل اقامه بوده رو می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.66,
   "end": 611.04,
   "text": "بیاید رو نمازمون کار کنیم. چقدر ما شنیدیم تا نماز درست نشه هیچی درست نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.04,
   "end": 614.2,
   "text": "چقدر بزرگان مثل آقای بهجت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.2,
   "end": 619.32,
   "text": "از قول اساتیدشون مثل آقای قاضی‌ها فرمودن آقا جون، عزیز دلم، آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.32,
   "end": 623.8,
   "text": "اگر نماز همین نماز پنج گانه روز، يوميت همین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.8,
   "end": 628.16,
   "text": "درست و به موقع اول وقت درست اقامه کنی و تمام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.16,
   "end": 630.76,
   "text": "تمام آقا جان تمام. همه چی درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.76,
   "end": 636.1,
   "text": "همه چی حتی دنیا. بعد می‌گه تو درست کن اگه نشد تف کن تو صورت من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 636.1,
   "end": 638.26,
   "text": "بابا بزرگان دین دارن اینو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.26,
   "end": 641.04,
   "text": "بعد ما از این نماز چقدر غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 641.04,
   "end": 643.16,
   "text": "مهرو پرت می‌کنیم دنبالش راه میفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.16,
   "end": 645.94,
   "text": "هر کجا سکون پیدا کرد الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.94,
   "end": 651.08,
   "text": "بعد السلام علیکم و رحمة الله و برکاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.08,
   "end": 655.1,
   "text": "همون سلام آخر خودش انقدر اسرار داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.1,
   "end": 662.16,
   "text": "نگو و نپرس. ان شاء الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 662.16,
   "end": 670.26,
   "text": "سلام بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}