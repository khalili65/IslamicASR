   "start": 583.58,
   "end": 745.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.84,
   "end": 6.58,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.58,
   "end": 10.42,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.42,
   "end": 14.64,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.64,
   "end": 17.76,
   "text": "استفتای دیگری از رهبر شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.76,
   "end": 25.86,
   "text": "گاهی اوقات مثلا لکه‌ای از خون روی لباس هست و این شستشو میشه، عین نجاست برطرف میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.86,
   "end": 32.56,
   "text": "تطهیر میشه به نحو شرعی لکن رنگ اون خون و اون نجاست رو لباس باقی میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.56,
   "end": 36.36,
   "text": "آیا سؤال اینه که آیا این لباس بالاخره نجسه یا پاکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.36,
   "end": 42.1,
   "text": "ما ر-اون مراحل تطهیر رو انجام دادیم اما رنگ نجاست مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.1,
   "end": 44.54,
   "text": "رهبری فرمودن اگر جرمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.54,
   "end": 51.54,
   "text": "اونجا وجود نداشته باشه، به گونه‌ای رفع نجاست شده که جرم برطرف شده و لو حالا رنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.54,
   "end": 55.22,
   "text": "خون یا نجاست رو لباس باقی مونده، اون دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.22,
   "end": 59.0,
   "text": "حکم نجاست رو نداره و پاکه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.0,
   "end": 62.94,
   "text": "ما در خصوص قلب مخلص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.94,
   "end": 64.8,
   "text": "یک سوالی رو طرح کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.8,
   "end": 71.98,
   "text": "الان تو ذهنتون بررسی کنید اگر یادتون باشه یه فرمول دادیم دست خودمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.98,
   "end": 77.4,
   "text": "بر اساس روایات و آموزه‌های بزرگانمون پیرامون قلب مخلص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.4,
   "end": 80.38,
   "text": "که گفتیم از شرایط ورود به بهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.38,
   "end": 84.36,
   "text": "اگر کسی به این شرط لازم نرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.36,
   "end": 87.9,
   "text": "نمی‌تونه بره به بهشت. ما باید خودمون رو به اون حد برسونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.9,
   "end": 93.72,
   "text": "من سوالم اینه که بر اساس اینکه عرض کردیم قلب مخلص جمع بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.72,
   "end": 97.76,
   "text": "خضوع ظاهری، خشوع باطنی و سکون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.76,
   "end": 100.34,
   "text": "ذات-دا-درونی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.34,
   "end": 106.18,
   "text": "یا ذاتی است، اینکه انسان در درونش، در ذاتش، در سرشتش، در ضمیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.18,
   "end": 110.52,
   "text": "احساس آرامش و سکون یا اطمینان بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.52,
   "end": 114.2,
   "text": "پس خضوع و خشوع و اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.2,
   "end": 121.58,
   "text": "به نظر شما در این فرمول که مجموعا معنای اخلاص و قلب مخلص رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.58,
   "end": 124.98,
   "text": "تشکیل میده چی باعث این اطمینان میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.98,
   "end": 128.78,
   "text": "چی باعث این اااه قلب به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.78,
   "end": 132.24,
   "text": "خروجی این فرمول که قلب مخلص هست میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.24,
   "end": 138.88,
   "text": "یعنی چی اگر نباشد قلب انسان به اطمینان نمی‌رسد یا بالعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.88,
   "end": 144.44,
   "text": "چی باعث میشه که انسان از سکون و آرامش و اطمینان خارج بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.44,
   "end": 148.54,
   "text": "مضطرب بشه، اضطراب پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.54,
   "end": 153.58,
   "text": "تمام روایات ما فرمودن دلبستن به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.58,
   "end": 156.58,
   "text": "عکسش میشه چی؟ زهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.58,
   "end": 159.74,
   "text": "اونچه که ما رو مضطرب می‌کنه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.74,
   "end": 165.58,
   "text": "نمی‌ذاره، مانع میشه ما به اخلاص برسیم و قلبمون حالت مخلص بودن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.58,
   "end": 170.48,
   "text": "پیدا کنه. مانع رسیدن به اون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.48,
   "end": 179.06,
   "text": "حب به دنیا یا علاقه به دنیا یا بهتره بگیم دلبستن به دنیا و شعاراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 179.06,
   "end": 185.58,
   "text": "و عکسش. اون چیزی که زیربنای رسیدن به اخلاص هست زهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.58,
   "end": 188.76,
   "text": "البته زهد درجاتی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.76,
   "end": 194.34,
   "text": "به نظر شما کسی که آرامش و اطمینان در درون پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.34,
   "end": 198.4,
   "text": "آیا میشه به یقین نرسیده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.4,
   "end": 202.1,
   "text": "حداقل به علم الیقین رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 202.1,
   "end": 206.06,
   "text": "حالا ما تا باید بریم اونجا هم کار کنیم که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.06,
   "end": 208.86,
   "text": "میشه کسی به یقین رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.86,
   "end": 211.16,
   "text": "در درون سکون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.16,
   "end": 214.8,
   "text": "و آرامش و اطمینان محض پیدا کرده بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.8,
   "end": 217.3,
   "text": "به مقام رضا نرسیده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.3,
   "end": 219.0,
   "text": "چون این‌ها بینشون فرق هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.0,
   "end": 221.84,
   "text": "ببین امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.84,
   "end": 228.82,
   "text": "در یک روایتی در اصول کافی مرحوم کلینی اعلا الله مقامه الشریف آورده این روایتو که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.82,
   "end": 232.32,
   "text": "مردم سه دسته‌اند. ببینیم الان ما جزو کدوماشونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.32,
   "end": 237.1,
   "text": "فرمودن یا راغب‌اند یا صابرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.1,
   "end": 239.76,
   "text": "یا زاهدند. بعد توضیح دادن حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.76,
   "end": 242.7,
   "text": "فرمودن عده‌ای رغبت به دنیا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.7,
   "end": 246.82,
   "text": "راغب‌اند یعنی اصلا عشقشون دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.82,
   "end": 250.06,
   "text": "رغبت‌شون دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.06,
   "end": 255.38,
   "text": "همش پی دنیاان. اصلا این ایدئولوژی، ایدئولوژی‌شون دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.38,
   "end": 260.2,
   "text": "تصمیمات و انگیزه‌هاشون بر اساس دنیا گرفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.2,
   "end": 262.88,
   "text": "جهت‌گیری‌هاشون دنیویست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.88,
   "end": 265.78,
   "text": "همه ملاک‌های زندگیشون دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.78,
   "end": 269.5,
   "text": "که از این دنیا به چه متاعی برسن، به چه حدیش برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.5,
   "end": 273.86,
   "text": "حالا می‌تونه پول باشه، می‌تونه مقام و شهرت باشه که دام بزرگیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.86,
   "end": 276.92,
   "text": "حتی بر سر الهیون، بر سر راه الهیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.92,
   "end": 279.02,
   "text": "شهرت، مقام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.02,
   "end": 283.22,
   "text": "جاه، مریدبازی، چه می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.22,
   "end": 288.64,
   "text": "و انواع اقسامش. از اون طرف فرمود صابر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.64,
   "end": 292.92,
   "text": "مولا فرمودن عده‌ای از راغب بودن فارغ شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.92,
   "end": 295.24,
   "text": "رفتن به مقام صابری رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.24,
   "end": 299.48,
   "text": "بعد مولا اینجا خیلی زیرکانه و خیلی زیبا می‌فرماید این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.48,
   "end": 305.2,
   "text": "صبر می‌کنن و بشر الصابرین خیلی هم خوبه اما به مقام رضا نرسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.2,
   "end": 309.32,
   "text": "صبر می‌کنند یعنی از دنیا کنده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.32,
   "end": 312.52,
   "text": "نمی‌رن به سمت دنیا. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.52,
   "end": 316.5,
   "text": "د-- به قول حالا تعبیر من درون رو جیگر گذاشتنو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.5,
   "end": 320.38,
   "text": "صبر کردن یعنی راضی نیستن به این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.38,
   "end": 322.92,
   "text": "توجه کردی اینا زاهد نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.92,
   "end": 330.34,
   "text": "لذا توی زیارت غدیریه یادگار امام هادی سلام الله علیه که واقعا غوغاست، یه بار با هم یه بخشیش رو بررسی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.34,
   "end": 334.5,
   "text": "اونجایی که خطاب به امیرالمؤمنین علیه الصلاة والسلام در روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.5,
   "end": 338.56,
   "text": "غدیر عرض می‌کردیم که به مولامون می‌گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.56,
   "end": 342.16,
   "text": "اعتصمت بالله فاززته یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.16,
   "end": 345.44,
   "text": "تو اعتصام به خدا کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.44,
   "end": 349.74,
   "text": "لذا خدا عزیزت کرد. بعد اینجا بعدش عبارت بعدیشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.74,
   "end": 356.26,
   "text": "عرض می‌کنیم که و آثرت الآخرة علی الأولى فزهدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.26,
   "end": 360.68,
   "text": "تو آخرت رو برگزیدی بر دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.68,
   "end": 364.76,
   "text": "لذا فزهدت زاهدانه زندگی کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.76,
   "end": 368.46,
   "text": "چون آخرت رو انتخاب کرده، انتخابش آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.46,
   "end": 373.62,
   "text": "علی الاولی یعنی بر دنیا. چون انتخابش آخرته این کیف هم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.62,
   "end": 376.92,
   "text": "انتخابش اونه. خودش خواسته، راضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.92,
   "end": 379.52,
   "text": "فزهدت. لذا زاهد شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.52,
   "end": 384.82,
   "text": "چون زاهد شدی ایدک الله وهداک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.82,
   "end": 387.84,
   "text": "توجه کردی؟ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.84,
   "end": 391.7,
   "text": "بعدش بحث است-است-استفا و اجتبا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.7,
   "end": 397.18,
   "text": "اجتبا و این‌ها پیش میاد که خدا شما رو برگزید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.18,
   "end": 404.6,
   "text": "چون آخرت انتخاب شما بود از روی علاقه و میل هم این کارو کردید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.6,
   "end": 410.16,
   "text": "خدا ایدک الله شما رو تأیید کرد وهداک هدایتتون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.16,
   "end": 413.82,
   "text": "ببینید این معنا درش هست که پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.82,
   "end": 419.72,
   "text": "کسی به مقام قلب اخبات دست پیدا می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 419.72,
   "end": 425.84,
   "text": "که نه فقط زاهد شده چون دست دوم شد صابر، صب-صبر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.84,
   "end": 429.14,
   "text": "اما دوست هم داره که به سمت دنیا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.14,
   "end": 434.98,
   "text": "دندون رو جگر گذاشته اما چون کف نفس می‌کنه چون مولاش دستور داده دل بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 434.98,
   "end": 437.5,
   "text": "نرو سمت دنیا، نمیره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.5,
   "end": 440.56,
   "text": "مثلا در درون آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 440.56,
   "end": 446.1,
   "text": "بعد زاهده مولا دست سوم فرمود زاهد نه این اصلا دیگه انتخابش آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.1,
   "end": 451.74,
   "text": "البته توی یک دسته‌بندی دیگه‌ای خیلی ز-زیبا، خیلی قشنگ اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 451.74,
   "end": 455.12,
   "text": "باید دقت کنیم. باید بشینیم این‌ها رو بررسی کنیم، پژوهش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 455.12,
   "end": 457.56,
   "text": "چطور یه دفعه یه بحث سیاسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 457.56,
   "end": 461.42,
   "text": "یه موضع سیاسی یکی می‌گیره، یه اتفاقی میفته می‌شینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.42,
   "end": 465.72,
   "text": "چنان تحلیلش می‌کنیم، پژوهش می‌کنیم، ریز و بمش رو درمیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 465.72,
   "end": 467.68,
   "text": "چطور تو این روایات ما پژوهش نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.68,
   "end": 473.54,
   "text": "چرا تأمل نداریم؟ فرمود که ادنی اینو دقت بفرمایید چقدر زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.54,
   "end": 476.82,
   "text": "مولا فرمودن ادنی درجة الزهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.82,
   "end": 480.38,
   "text": "درجة الزهد پایین-- اعلی بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.38,
   "end": 484.96,
   "text": "اعلی درجة الزهد بالاترین درجه زهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.96,
   "end": 488.26,
   "text": "ادنی درجة اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.26,
   "end": 491.02,
   "text": "اول یا پایین‌ترین درجه یقینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.02,
   "end": 496.12,
   "text": "یعنی تو وقتی زهدت به حد اعلا رسید تازه می‌رسی به وادی یقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.12,
   "end": 504.5,
   "text": "بعد اد-- اعلی درجة اليقين اگر يقينتو به اعلا به حد اعلا رسوندی ادنی درجة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 504.5,
   "end": 506.58,
   "text": "کی؟ حرف چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 506.58,
   "end": 508.76,
   "text": "اینجا یعنی بالاترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.76,
   "end": 515.1,
   "text": "حالت رو در وادی یقین پیدا کردی می‌شه ادنی پایین‌ترین درجة رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 515.1,
   "end": 517.92,
   "text": "پایین‌ترین درجه کسی که رضایت پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.92,
   "end": 519.86,
   "text": "این‌ها این فرمول‌ها رو باید بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.86,
   "end": 522.52,
   "text": "باید ببینیم ما کجای کاریم. ما الان کجای کاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.52,
   "end": 525.94,
   "text": "من کجای کارم. خودمو پیدا کنم دیگه کار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.94,
   "end": 534.66,
   "text": "پس مجموعاً به اینجا می‌رسیم که کسی می‌تونه واقعاً به مقام اخبات برسه و کسی می‌تونه هم فیها خالدون در بهشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 534.66,
   "end": 540.98,
   "text": "در بهشت مخلد باشه که به این حالات رسیده باشه راضی باشه که بره تو بهشت رضوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.98,
   "end": 546.14,
   "text": "اسم بهشت، بهشت رضوانه. راضی باشه نه فقط صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 546.14,
   "end": 548.28,
   "text": "عرض کنیم زهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 548.28,
   "end": 551.78,
   "text": "به تنها پیشه کرده باشه به منهای رضایت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 551.78,
   "end": 553.84,
   "text": "صبر کنه منهای رضایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.84,
   "end": 559.7,
   "text": "باید حداقل علم و يق-- علم اليقين رو داشته باشه و خودش رو بکشونه به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 559.7,
   "end": 565.0,
   "text": "رضایت خاطر یعنی از درون آرامش داشته باشه، کیف هم بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.0,
   "end": 569.2,
   "text": "که نداره. یعنی اینطوری نیست که شما بگی زجر می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 569.2,
   "end": 571.52,
   "text": "که داره خیلی ساده زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 571.52,
   "end": 573.84,
   "text": "خونه‌ش مبل مان و لوستر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 573.84,
   "end": 577.24,
   "text": "نمی‌دونم اون آلات عجیب و غریب و تجملات رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 577.24,
   "end": 582.22,
   "text": "اصلاً کیف هم می‌کنه. اصلاً تعجب می‌کنه از اونا که چطور اون‌ها اینا رو جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 582.22,
   "end": 584.8,
   "text": "توجه کردید؟ یعنی اصلاً د--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 584.8,
   "end": 590.86,
   "text": "البته این زهد رو من یه نکته‌ای هم عرض کنم اینجا و ختم کلام خیلی توجه بفرمایید خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.86,
   "end": 595.86,
   "text": "یه وقت به انحراف بره تو ذهن ما، ما رو منحرف می‌کنه شدید، شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 595.86,
   "end": 598.9,
   "text": "تا جایی که مثلاً طرف برمی‌گرده می‌گه چطور فلان عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 598.9,
   "end": 602.38,
   "text": "مثل فلان مرجع تقلید رفتم خونه‌ش لوستر داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 602.38,
   "end": 605.28,
   "text": "مبل آنچنانی داشت به من چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 605.28,
   "end": 607.54,
   "text": "به من چه که اون داشت. تو خودت رو دریاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 607.54,
   "end": 609.52,
   "text": "اون شاید دل نتون-- نبسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 609.52,
   "end": 612.58,
   "text": "اون به جای اینکه مثل ملک سلیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.58,
   "end": 616.34,
   "text": "لا ینبغي لأحدٍ ها اصلاً به عهدی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.34,
   "end": 619.66,
   "text": "ملک سلیمان رو به عهدی جز سلیمان نداده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.66,
   "end": 623.56,
   "text": "اون قصر و اون جاه و باروت و اون عظمت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.56,
   "end": 627.02,
   "text": "حتی شیاطین جن، شیاطین جن نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.02,
   "end": 630.98,
   "text": "شیعیان جن، شیاطین جن هم مسخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.98,
   "end": 633.94,
   "text": "سلیمان بودند و در ساختن قصر کمکش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 633.94,
   "end": 638.32,
   "text": "یه قصر با چه عظمت مجلل که تو دنیا نمونه نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 638.32,
   "end": 641.04,
   "text": "حضرت رفت ببینه چه خبره این قصر به کجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.04,
   "end": 643.68,
   "text": "حالا به قول ما تو پنت هاوسش رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 643.68,
   "end": 647.9,
   "text": "سان دید. اومدن رژه می‌رفتن قبلاً داستانشو براتون گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 647.9,
   "end": 650.94,
   "text": "که اون عظمت حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 650.94,
   "end": 655.6,
   "text": "که بعد حضرت عزرائیل اومد جانشو بگیره گفت تو به چه اجازه‌ای وارد شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 655.6,
   "end": 658.54,
   "text": "من گفته بودم کسی وارد تاج و تخت من نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 658.54,
   "end": 660.3,
   "text": "فرمود من از عهدی اجازه نمی‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 660.3,
   "end": 664.54,
   "text": "اون فهمید حضرت عزرائیله. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 664.54,
   "end": 669.58,
   "text": "این جمله رو گفت و حاضر به قبض روح شد که در اون که عصاش رو تکیه کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 669.58,
   "end": 673.42,
   "text": "خدا-- حضرت عزرائیل سلام الله جانشو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 673.42,
   "end": 676.34,
   "text": "گفت ظاهراً خدا دوست نداره ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 676.34,
   "end": 679.18,
   "text": "چشممون به این ملک باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 679.18,
   "end": 682.44,
   "text": "چون تا حالا ندیده بود. ملک سلیمان رو نرفته بود ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.44,
   "end": 685.68,
   "text": "داشت ولی نرفته بود. حالا رفته بود ببینه چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 685.68,
   "end": 688.88,
   "text": "دل نبسته بود دیگه. می‌خوام عرض کنم که یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 688.88,
   "end": 696.08,
   "text": "مثل سلیمان همه چی هم خدا بهش میده اما سر سوزنی دل نبسته تا میگن بیا برو میگه چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 696.08,
   "end": 699.72,
   "text": "بریم. خدا نمی‌خواد ما اینو حتی نگاه کنیم، نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 699.72,
   "end": 702.18,
   "text": "اما یکی به قول اساتید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 702.18,
   "end": 706.28,
   "text": "یه وقت مثل یه تسبیح دستشه، اینام یه جور کفش نو می‌خره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.28,
   "end": 710.0,
   "text": "یه عینک قشنگ می‌زنه. چه می‌دونم یه لباس جدید می‌پوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.0,
   "end": 715.6,
   "text": "بعد به همون وابسته‌ست به گونه‌ای که اگر اون رو ازش بگیرن انگار جانشو گرفتن سختشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 715.6,
   "end": 719.26,
   "text": "این یعنی دلبستن. این یعنی غیر زهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 719.26,
   "end": 724.44,
   "text": "اما اون می‌شه که کسی داشته باشه، خیلی هم داشته باشه اما زهد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 724.44,
   "end": 727.2,
   "text": "یعنی دل نبسته راحت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 727.2,
   "end": 733.38,
   "text": "پس یه وقت خلط بحث نشه. ختم کلام اینکه اخوت در دلش زهد رو هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 733.38,
   "end": 735.22,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 735.22,
   "end": 738.36,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 738.36,
   "end": 742.06,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 742.06,
   "end": 745.4,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}