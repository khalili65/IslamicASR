 },
 "chapters": [
  {
   "index": 0,
   "title": "## تطهیر کف پا با آب بارانِ جمع‌شده",
   "start": 0.5,
   "end": 56.22
  },
  {
   "index": 1,
   "title": "## قلب مخبت؛ آیهٔ حج",
   "start": 56.22,
   "end": 216.94
  },
  {
   "index": 2,
   "title": "## لغت اخبات؛ زمین و شتر",
   "start": 216.94,
   "end": 620.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.5,
   "end": 4.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.64,
   "end": 8.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.6,
   "end": 13.8,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.8,
   "end": 17.08,
   "text": "سؤال شده از رهبر عزیز که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.08,
   "end": 20.36,
   "text": "وقتی بارون میاد رو زمین خب مقداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.36,
   "end": 27.24,
   "text": "آب جمع میشه بعضی گوشه‌ها رو زمین همینطوری آب جمع شده، تجمع آب صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.24,
   "end": 30.1,
   "text": "آیا بر اثر راه رفتن در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.1,
   "end": 36.44,
   "text": "آب‌های جمع شده کف پای نجس پاک میشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.44,
   "end": 38.76,
   "text": "رهبر فرمودن به دو شرط پاک میشه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.76,
   "end": 41.8,
   "text": "یکی اینکه وقتی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.8,
   "end": 48.32,
   "text": "در این آب‌ها حرکت کنی که در حال بارش باران باشه یعنی بارون قطع نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.32,
   "end": 51.3,
   "text": "نکته دوم اینکه بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.3,
   "end": 53.18,
   "text": "حرکت در این آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.18,
   "end": 58.32,
   "text": "جمع شده‌ها، عین نجاست از کف پا برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.32,
   "end": 62.72,
   "text": "همینطوری که داری رد میشی از توی این آب‌ها عین نجاست رفع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.72,
   "end": 67.06,
   "text": "به این دو صورت پاک میشه. خب ما دیگه از بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.06,
   "end": 70.3,
   "text": "قلب قسی خارج شیم، فارغ شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.3,
   "end": 72.72,
   "text": "و بریم سراغ یازدهمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.72,
   "end": 79.46,
   "text": "مورد یا عنوان و سرفصل از انواع قلب در قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.46,
   "end": 82.48,
   "text": "قلب مخبت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.48,
   "end": 84.82,
   "text": "مورد بررسی قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.82,
   "end": 93.96,
   "text": "قلب مخبت. یکی از آیاتی که در قرآن پیرامون این قلب وارد شده آیه پنجاه و چهار سوره حج هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.96,
   "end": 100.34,
   "text": "بخونیم میفرماید: \"و ليعلم الذين أوتوا العلم أنه الحق من ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.34,
   "end": 102.9,
   "text": "فيؤمنوا به\" میگه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.9,
   "end": 107.68,
   "text": "اون‌هایی که اهل علم و معرفت‌اند به یقین بدونند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.68,
   "end": 110.12,
   "text": "\"أنه الحق من ربك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.12,
   "end": 115.28,
   "text": "که این آیات قرآن به حق از جانب پروردگار تو نازل گردیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.28,
   "end": 118.24,
   "text": "\"فيؤمنوا به\" پس اینا بهش ایمان بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.24,
   "end": 121.36,
   "text": "\"فتخبت له قلوبهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.36,
   "end": 123.48,
   "text": "فتخبت له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.48,
   "end": 127.52,
   "text": "قلوبهم\" و اینجا هم میفرماید که دل‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.52,
   "end": 131.34,
   "text": "پیش او یعنی برای خدا حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.34,
   "end": 136.86,
   "text": "اخبات بگیره و قلب یعنی مخبت باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.86,
   "end": 139.68,
   "text": "حالت خضوع و خشوع که حالا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.68,
   "end": 143.82,
   "text": "\"و إن الله لهادي الذين آمنوا إلى صراط مستقيم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.82,
   "end": 146.16,
   "text": "البته قطعاً خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.16,
   "end": 149.98,
   "text": "اهل ایمان رو هدایت میکنه به صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.98,
   "end": 152.68,
   "text": "خب نکاتی در این آیه هست که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.68,
   "end": 155.52,
   "text": "امروز شاید بهش نرسیم که سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.52,
   "end": 159.42,
   "text": "عمل، بعد ایمان، بعد اخبات رو بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.42,
   "end": 162.1,
   "text": "اصلاً اخبات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.1,
   "end": 166.1,
   "text": "به چه کسی میگن مخبت؟ به صورت کلی عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.1,
   "end": 171.36,
   "text": "اولاً یکی از ویژگی، ویژگی‌های اوج سلامت قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.36,
   "end": 175.02,
   "text": "حالت اخبات در انسانه، در قلب انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.02,
   "end": 179.84,
   "text": "اگر کسی مخبت شد در اوج سلامت قلب قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.84,
   "end": 183.52,
   "text": "یعنی در اوج بندگی و تقرب الی الله واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.52,
   "end": 185.72,
   "text": "خوش به حال کسی که مخبت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.72,
   "end": 193.2,
   "text": "که حالا بعداً شرایطش و ویژگی‌هاشو با-- بر اساس آیات و روایات بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.2,
   "end": 196.06,
   "text": "که البته بزرگان فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.06,
   "end": 198.98,
   "text": "جایگاه مخبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.98,
   "end": 205.12,
   "text": "بدین صورته که اول طرف مسلم میشه، اسلام میاره، بعد مؤمن میشه، ایمان میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.12,
   "end": 210.54,
   "text": "بعد متقی میشه، با تقوا میشه، بعد محسن میشه، اهل احسان میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.54,
   "end": 213.88,
   "text": "بعد مخبت میشه و اهل اخبات میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.88,
   "end": 216.94,
   "text": "اخبات رو قبلاً توضیح داده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.94,
   "end": 220.3,
   "text": "در عرب معمولاً به زمینی میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.3,
   "end": 224.1,
   "text": "بلندی نداره، همواره یا بعضیا گفتن نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.1,
   "end": 229.96,
   "text": "بلندی نداره که هیچ حالت گودی هم داره یعنی فرو رفته است، افتاده حاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.96,
   "end": 232.94,
   "text": "زمین حالت تواضع به خودش گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.94,
   "end": 236.9,
   "text": "به این قطعه زمین میگن زمینی که مخبته یا اخبات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.9,
   "end": 241.46,
   "text": "در یکی از تفاسیر دیگه می‌خوندم خیلی جالبه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.46,
   "end": 246.28,
   "text": "عرب می فرمود به حالتی از شتر اخبات میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.28,
   "end": 248.5,
   "text": "گوش بدید خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.5,
   "end": 252.32,
   "text": "شتر گاهی اوقات یه حشراتی وجودشو می‌گیره میره لای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.32,
   "end": 259.4,
   "text": "پشمش و موهای بدنش و اینا یه حشراتی که این شتر خب نمی‌تونه توان نداره این حشرات رو از خودش دفع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.4,
   "end": 262.48,
   "text": "میرن اینا لای پوست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.48,
   "end": 264.48,
   "text": "مثلا این پشم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.48,
   "end": 270.9,
   "text": "شتر و اذیتش می‌کنن. یه پرنده‌ای هست که غذاش اینا، غذای این پرنده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.9,
   "end": 274.02,
   "text": "پشه هایی‌اند که حشراتی‌اند که رفتن لای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.02,
   "end": 276.76,
   "text": "موها و پشم‌های شتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.76,
   "end": 279.12,
   "text": "اینا میان می‌شینن رو بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.12,
   "end": 285.32,
   "text": "شتر. شتر به قدری آرامش به خودش میده که حتی میگن پلک هم نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.32,
   "end": 288.94,
   "text": "کاملاً آماده میشه تا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.94,
   "end": 292.84,
   "text": "شپشا و پشه ها و حشرات حالا هرچی که رفته تو لای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.84,
   "end": 296.58,
   "text": "بدنش و داره اذیتش می‌کنه و اونو می‌خورن این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.58,
   "end": 299.58,
   "text": "دقیقاً ریشه‌کن کنن این پرنده ها بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.58,
   "end": 307.44,
   "text": "به این حالت سکون کامل شتر که خودشو در اختیار در حقیقت این طبیب خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.44,
   "end": 310.36,
   "text": "قرار داده میگن اخبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.36,
   "end": 313.82,
   "text": "در حقیقت مقام تسلیم محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.82,
   "end": 320.1,
   "text": "یعنی اگر کسی به جایی برسه که کاملاً دیگه در سکون قرار بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.1,
   "end": 323.92,
   "text": "در حالت اثبات قرار بگیره، ثبات کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.92,
   "end": 328.6,
   "text": "و خودشو کاملاً بسپره به خدا، تفویض امر کنه به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.6,
   "end": 334.7,
   "text": "که حالا بعضی از لغت شناسان فرمودن برای اینکه خوب قشنگ بحث اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.7,
   "end": 337.32,
   "text": "و اینکه مخبت چه کسی‌ست جا بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.32,
   "end": 340.14,
   "text": "فرمودن که جمع بین خضوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.14,
   "end": 342.24,
   "text": "طمأنینه و خشوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.24,
   "end": 345.62,
   "text": "این سه تا رو در هم جمع کنی میشه معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.62,
   "end": 350.36,
   "text": "اخبات. یعنی چی؟ خضوع که می‌دونید یعنی حالت طاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.36,
   "end": 354.38,
   "text": "که البته بعضیا گفتن مطیع ظاهری خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.38,
   "end": 356.48,
   "text": "یعنی کسی قیافشو دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.48,
   "end": 359.9,
   "text": "بگی آدم مطیعیه، این آدم مؤمنیه، این آدم باخدایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.9,
   "end": 361.44,
   "text": "قیافش داد می‌زنه، خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.44,
   "end": 365.36,
   "text": "به این حالت میگن خضوع. یعنی ظاهر خوبی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.36,
   "end": 368.48,
   "text": "که نقطه مقابلش میشه تکبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.48,
   "end": 372.15,
   "text": "فرعون خب غرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.15,
   "end": 375.25,
   "text": "اما خشوع متقارب با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.25,
   "end": 378.79,
   "text": "خضوع معناش. یعنی همین حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.79,
   "end": 382.05,
   "text": "افتاده حالی و بندگی و این‌ها و خضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.05,
   "end": 384.51,
   "text": "بیاد در قلب واقع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.51,
   "end": 389.37,
   "text": "یعنی ظاهر و باطن هر دو افتاده بشن، هر دو افتاده حال بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.37,
   "end": 392.17,
   "text": "هر دو متوازن بشن هم ظاهر و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.17,
   "end": 394.67,
   "text": "خشوع به باطن ربط داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.67,
   "end": 397.05,
   "text": "خضوع به ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.05,
   "end": 400.25,
   "text": "خب گفتیم یه معنای دیگه هم درش هست در اخبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.25,
   "end": 403.45,
   "text": "اونم طمأنينه است از اطمینان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.45,
   "end": 406.85,
   "text": "یعنی حالت سکون و آرامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.85,
   "end": 410.69,
   "text": "تو بحث قلب مطمئن عرض کردیم دیگه که یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.69,
   "end": 415.51,
   "text": "یعنی کسی که به آرامش کامل رسیده، ثبات داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.51,
   "end": 420.55,
   "text": "به مقام ثبوت اصلاً رسیده، نه اثبات، وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.55,
   "end": 426.03,
   "text": "و البته نقطه مقابلش هم می‌شه عدم ثبات و عدم استقرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.03,
   "end": 429.41,
   "text": "دیدی بعضیا سجیه اخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.41,
   "end": 432.15,
   "text": "نه-- یعنی سجایای اخلاقی پیدا نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.15,
   "end": 437.11,
   "text": "یعنی اخلاق یا اعتقادیات در وجودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.11,
   "end": 440.77,
   "text": "سکون نگرفته، ثابت نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.77,
   "end": 444.07,
   "text": "به مقام ثبوت نرسیدن، ثبات قدم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.07,
   "end": 447.27,
   "text": "امروز بسیار آدم آروم و خوبیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.27,
   "end": 451.03,
   "text": "فردا بسیار آدم عصبی و به هم ریخته‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.03,
   "end": 454.53,
   "text": "امروز خیلی از خود گذشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.53,
   "end": 456.63,
   "text": "عرض کنم منفعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.63,
   "end": 459.45,
   "text": "فردا اصلاً چنان بخیل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.45,
   "end": 461.53,
   "text": "که از یه لقمه خودشم نمی‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.53,
   "end": 464.39,
   "text": "این سجایای اخلاقی در وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 464.39,
   "end": 468.27,
   "text": "جا نیفتاده، ریشه نگرفته، ثبات نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.27,
   "end": 470.91,
   "text": "اما نه اگر این سه تا با هم اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.91,
   "end": 475.49,
   "text": "سجایای اخلاقی در وجودش ریشه دواند و ثبات پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 475.49,
   "end": 477.79,
   "text": "او به مرحله اخبات رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.79,
   "end": 481.35,
   "text": "مثلاً مثالشو در خصوص بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.35,
   "end": 486.91,
   "text": "عرض کنم خدمتتون حالا از صحابه بزنیم که کسی نگه بابا مثلاً اهل بیت کجا ما کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.91,
   "end": 491.05,
   "text": "مثلاً مالک شنیدید خروس جنگی امیرالمؤمنین دیگه معروف بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.05,
   "end": 493.65,
   "text": "مالک کسی جرات نداشت اسمش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.65,
   "end": 498.43,
   "text": "ببره. ولی خب رد می‌شد از تو کوچه بازار و نوشتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.43,
   "end": 501.65,
   "text": "یه کسی جسارت کرد. نمی‌شناخت که این مالکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.65,
   "end": 504.95,
   "text": "جسارت کرد. آب دهان انداخت و فحش داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.95,
   "end": 509.97,
   "text": "به مالک. پیداست که چقدر ظاهرش اصلاً نشون نمی‌داده که این آقا کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.97,
   "end": 511.87,
   "text": "برعکس امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.87,
   "end": 518.55,
   "text": "خیلی از ماها که اصلاً ظاهرشو می‌گی اوه، اوه، اوه این مد-- معلومه که یه آدم کتک لفتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.55,
   "end": 528.19,
   "text": "این فلان. ولی معلومه که چقدر خاکی زندگی می‌کرد اصلاً نشون نمی‌داده این سردار لشکر امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.19,
   "end": 532.47,
   "text": "حالا سردارای ما الان به چه نشانه‌هایی شناخته می‌شن و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.47,
   "end": 534.85,
   "text": "در هر حال میره خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.85,
   "end": 537.13,
   "text": "اونایی که می‌شناختن می‌ترسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.13,
   "end": 542.05,
   "text": "از وضع این شخص. میرن بهش می-می‌گن که وای خدا به دادت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.05,
   "end": 544.15,
   "text": "می‌دونی به کی اهانت کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.15,
   "end": 546.05,
   "text": "خروس جنگی امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.05,
   "end": 548.35,
   "text": "کی؟ مالک. آره این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 548.35,
   "end": 551.55,
   "text": "میره می‌گرده تو کوچه پس کوچه پیداش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.55,
   "end": 555.13,
   "text": "می‌پرسه مالک کجا رفت؟ می‌گن تو مسجد رفت مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.13,
   "end": 557.87,
   "text": "میره مسجد می‌بینه افتاده به سجده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 557.87,
   "end": 560.77,
   "text": "نماز می‌خونه و منتظر شد نمازش که تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 560.77,
   "end": 564.97,
   "text": "افتاد به پاش و ببخشید من جسارت کردم شما رو نشناختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.97,
   "end": 569.23,
   "text": "می‌گه من همون لحظه تو رو بخشیدم و الان اومدم اینجا به خاطر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.23,
   "end": 573.11,
   "text": "بلند شدم نماز خوندم از خدا خواستم که تو رو ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.11,
   "end": 576.23,
   "text": "خدا وکیلی این حالت تو کدوم یکی از ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.23,
   "end": 579.79,
   "text": "ریشه گرفته و بدل به سجیه اخلاقی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.79,
   "end": 583.91,
   "text": "اگر کسی به این حالت رسید، سکون، آرامش مطلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.91,
   "end": 588.35,
   "text": "یعنی به حالتی که دیگه کوه تکون بخوره، او تکون نخوره، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 588.35,
   "end": 592.53,
   "text": "و خودش رو در بست تقدیم خدا و صاحب امر خودش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.53,
   "end": 594.65,
   "text": "به این می‌گن مخبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.65,
   "end": 599.03,
   "text": "و حالا این‌هایی که دارم می‌گم رو امیدوارم داستان نباشه شما باهاش چرت بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 599.03,
   "end": 601.65,
   "text": "بگید عجب چه خبره، چه چیزایی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.65,
   "end": 604.97,
   "text": "امیدوارم که تلاش کنیم برای اینکه انشاالله ما هم به اون جاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.97,
   "end": 610.63,
   "text": "برسیم. عاقبتمون انشاالله ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 610.63,
   "end": 616.89,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.89,
   "end": 620.39,
   "text": "علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}