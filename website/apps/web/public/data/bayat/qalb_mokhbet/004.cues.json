  {
   "index": 7,
   "title": "## فرمول سلوک مخبتین",
   "start": 632.13,
   "end": 670.47
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.24,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 7.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.98,
   "end": 12.72,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.72,
   "end": 17.92,
   "text": "از رهبر عزیزمون استفتایی شده اینو خوب گوش بدید چون خیلی مبتلا به هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.92,
   "end": 24.98,
   "text": "اونم اینکه مثلا فرشی یه بخشیش یا بعضی قسمتاش نجس شده یا پتویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.98,
   "end": 27.9,
   "text": "حالا گیلیمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.9,
   "end": 34.56,
   "text": "موکتی، جایی بعضی قسمت‌های این نجس شده ما نمی‌دونیم کجاش نجس شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.56,
   "end": 38.58,
   "text": "فقط می‌دونیم که مثلا این نجس شده حالا به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.58,
   "end": 42.3,
   "text": "می‌دونیم که این نجسه اما کجاش نجسه نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.3,
   "end": 45.4,
   "text": "سؤال اینه حالا که ما نمی‌دونیم کجای این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.4,
   "end": 49.28,
   "text": "فرش، این پتو، اینها نجسه، این تشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.28,
   "end": 56.0,
   "text": "اگر شیء خیسی و مرطوبی بهش برخورد کنه به اون فرش، به اون پتو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.0,
   "end": 60.08,
   "text": "خب آیا باید بگیم که نجس شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.08,
   "end": 62.56,
   "text": "اون شیی که برخورد کرد به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.56,
   "end": 65.78,
   "text": "پتو، به این فرش به هر قسمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.78,
   "end": 69.94,
   "text": "آیا نجس می‌شه اون؟ چون ما نمی‌دونیم کجای این فرش نجس بوده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.94,
   "end": 75.36,
   "text": "رهبری فرمودن که بنا به فرض مذکور، یعنی همین که شما نمی‌دونید کجاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.36,
   "end": 78.4,
   "text": "نجسه، این شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.4,
   "end": 83.78,
   "text": "خیس و مرطوب که مرتبط شده با اون محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.78,
   "end": 89.44,
   "text": "یعنی اینکه نخیر باید بگی بنا رو بذاری ان شاالله پاکه چ- چون که شما نمی‌دونید کجاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.44,
   "end": 94.8,
   "text": "نجس بوده که. این سخت نگرفته فقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.8,
   "end": 102.34,
   "text": "در خصوص قلب مخبت نکته بسیار مهمی رو امروز به فضل الهی عرض کنم که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.34,
   "end": 107.42,
   "text": "برای اینکه این جا بیفته حداقل یک ساعت ما باید با هم بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.42,
   "end": 110.5,
   "text": "اما خب سختم از خدا کمک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.5,
   "end": 117.68,
   "text": "این مسئله به این مهمی که یک ساعتم وقت می‌خواد جا بیفته رو ما تو ده دقیقه جمعش کنیم، تو هشت دقیقه جمعش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.68,
   "end": 124.0,
   "text": "دقت بفرمایید که حالا اگر براتون سؤالی پیش اومد بعدا من پاسخگو هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.0,
   "end": 127.62,
   "text": "قلب مخبت یا مقام اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.62,
   "end": 134.14,
   "text": "گفتیم در ادامه ایمان و عمل صالح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.14,
   "end": 136.72,
   "text": "و طبق آیه قرآنی که براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.72,
   "end": 141.98,
   "text": "تلاوت کردیم از آیه بیست و سه سوره هود عرض کردیم شرط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.98,
   "end": 147.02,
   "text": "خلود در بهشته. یعنی نمی‌شه به جز اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.02,
   "end": 152.82,
   "text": "حالا بررسی‌هایی که حقیر کردم خلاصه عرض کنم که اخبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.82,
   "end": 156.16,
   "text": "انتهای مقام توجه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.16,
   "end": 160.58,
   "text": "و مدخل ورود به مقام همت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.58,
   "end": 164.54,
   "text": "که بعد از مقام همت صاحب الأمر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 164.54,
   "end": 169.18,
   "text": "حالا من اینا رو خیلی سریع عرض کنم و رد شم ببینیم کجای کاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.18,
   "end": 171.6,
   "text": "انسان نفس ناطقه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.6,
   "end": 175.26,
   "text": "یک قدرت خیلی بالایی خدا بهش داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.26,
   "end": 179.08,
   "text": "می‌تونه از ابزار و قوای دیگه‌ای که داره مثل قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.08,
   "end": 183.46,
   "text": "مخیله و قوه اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 183.46,
   "end": 185.98,
   "text": "وهمش یا واهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.98,
   "end": 187.92,
   "text": "می‌تونه تصور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.92,
   "end": 190.8,
   "text": "می‌تونه صور و اشکالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.8,
   "end": 192.96,
   "text": "بیرون از نفس ناطقه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.96,
   "end": 196.14,
   "text": "ایجاد کنه، ایجاد کنه اصطلاحاً تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.14,
   "end": 200.18,
   "text": "فلسفه میگن. ایجاد کنه یعنی ایجاد کنه، بیافرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.18,
   "end": 203.46,
   "text": "این قدرت رو خدا به نفس ناطقه انسان داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.46,
   "end": 206.28,
   "text": "شما در آن واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.28,
   "end": 210.14,
   "text": "اسم باباتو، تا اسم باباتو میارن چهره‌ش رو تصور می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.14,
   "end": 212.78,
   "text": "میش- یعنی قشنگ شکلش رو می‌کشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.78,
   "end": 216.3,
   "text": "تو وجود خودت، تو یه جایگاه خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.3,
   "end": 219.14,
   "text": "مثل یه بوم که بوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.14,
   "end": 222.16,
   "text": "نقاشی که تو وجودت خودت تعبیر کرده سریع می‌کشیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.16,
   "end": 225.22,
   "text": "این قدرت بسیار بالایی‌ست که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.22,
   "end": 228.52,
   "text": "به قوه مصوره یا مخیله انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.52,
   "end": 235.18,
   "text": "عطا کرده که قوه واهمه این‌ها رو جزء، جزء می‌کنه بعد عقل میاد کلیش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.18,
   "end": 238.78,
   "text": "با اصول مرتبطش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.78,
   "end": 241.84,
   "text": "خیلی این قوه کارسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.84,
   "end": 243.88,
   "text": "کسایی که میان از این قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.88,
   "end": 249.78,
   "text": "ایجاد صور و اشکال بیرون از وجود خودشون استفاده می‌کنند از طریق غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.78,
   "end": 254.88,
   "text": "شرعی، همون رمال‌ها و جادوگرها و شعبه- شعبده‌بازها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.88,
   "end": 261.74,
   "text": "سر کتاب باز کننده‌ها و اینایی که حالا از طریق غیر شرعی یه کارایی می‌کنن بعضا می‌گین اِ زدم تو خال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.74,
   "end": 263.96,
   "text": "به حقم دقیقا درست گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.96,
   "end": 266.22,
   "text": "از آینده گفت، از اتفاقی افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.22,
   "end": 268.62,
   "text": "گفت، دزد رو پیدا کرد چه چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.62,
   "end": 272.56,
   "text": "اینا از همین قوه، از قوه توجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.56,
   "end": 275.38,
   "text": "توجه نفس ناطقه استفاده می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.38,
   "end": 278.94,
   "text": "اما از طریق غیر شرعی چون مرتبط با عقلشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.94,
   "end": 281.62,
   "text": "ریاضاتی که می‌کشند شرعیه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.62,
   "end": 287.96,
   "text": "اما اگر کسی توجه به خدای منان داشته باشه از این قوه توجهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.96,
   "end": 291.04,
   "text": "توجه به خدا از طریق شرعیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.04,
   "end": 293.04,
   "text": "و ریاضات شرعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.04,
   "end": 300.08,
   "text": "استفاده کنه، یعنی از طریق ریاضات شرعیه متوجه خدا بشه و این قوه به اوج برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.08,
   "end": 305.14,
   "text": "می‌تونه برسه به مقام یواش یواش همت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.14,
   "end": 312.04,
   "text": "که اون مثلا اوج توجه هست که اینکه مثلا مرحوم آیه tabatabai رحمة الله علیه حتما شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.04,
   "end": 317.96,
   "text": "نمی‌دونم چرا، چرا بعضی از اساتید واهمه دارن از اینکه بگن این مربوط به چه کسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.96,
   "end": 322.68,
   "text": "علامه طباطبایی به شهید مطهری فرموده بود که چجوری نماز می‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.68,
   "end": 329.54,
   "text": "فرموده بود اون معانی و مفهوم جملات و کلماتی که میگم رو تصویر، تصور می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.54,
   "end": 334.88,
   "text": "مفاهیم رو. بعد ایشون فرموده بود که تو که داری مفاهیم رو تصور می‌کنی، خدا رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.88,
   "end": 338.56,
   "text": "عبادت نمی‌کنی که. وقت اون رسیده که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.56,
   "end": 341.04,
   "text": "اون کلمات و مفاهیمش بگذری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.04,
   "end": 343.3,
   "text": "اینم یک صور خیالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.3,
   "end": 345.32,
   "text": "بگذری. حالا یک راه مدخلی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.32,
   "end": 349.52,
   "text": "ببینید از توجه کشوندش به سمت همت با این تذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.52,
   "end": 352.08,
   "text": "حالا من خیلی سریع دارم عرض می‌کنم رد می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.08,
   "end": 354.34,
   "text": "اینا جای بحث و چکش کاری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.34,
   "end": 358.52,
   "text": "اگه تشنه id برید پیگیر باشید یا با هم بحث می‌کنیم دربارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.52,
   "end": 361.76,
   "text": "خلاصه وقتی به مقام همت طرف رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.76,
   "end": 365.71,
   "text": "مقام همت همش فقط و فقط خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.71,
   "end": 371.19,
   "text": "و در طریق امام عصر سلام الله علیه، عظمش از امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.19,
   "end": 375.97,
   "text": "همه وجودش تسلیم محض امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.97,
   "end": 377.99,
   "text": "و همتش عالی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.99,
   "end": 381.29,
   "text": "به گونه‌ای که می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.29,
   "end": 384.47,
   "text": "با کمک نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.47,
   "end": 391.91,
   "text": "مخیله‌ش یا عرض کنم قوه مخیله‌ش و قوه واهمه‌ش زیر نظر قوای عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.91,
   "end": 394.07,
   "text": "بدلی از خودش ایجاد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.07,
   "end": 396.13,
   "text": "که گاهی آقا به این‌ها می‌گن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.13,
   "end": 402.03,
   "text": "ابدال. اون قبلیا ببینید آدم از ایمان شروع می‌کنه مؤمنه بعد می‌شه صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.03,
   "end": 405.25,
   "text": "اینجا هم می‌گه \"إن الذين آمنوا وعملوا الصالحات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.25,
   "end": 407.35,
   "text": "بعد از صالح چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.35,
   "end": 411.01,
   "text": "می‌شه صاحب توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.01,
   "end": 413.13,
   "text": "صاحب توجه رو می‌گن ابرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.13,
   "end": 414.87,
   "text": "بعد از ابرار کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.87,
   "end": 417.37,
   "text": "ابدال‌اند. ابدال از بدل میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.37,
   "end": 420.59,
   "text": "اینا می‌تونن بدل‌هایی برای خودشون ایجاد کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.59,
   "end": 424.57,
   "text": "یعنی اینجاست از خودش می‌تونه ده‌ها، صدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.57,
   "end": 430.57,
   "text": "بدل مثالی از بدن خودش به شکل خودش درست کنه پخش کنه تو عالم برن به داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.57,
   "end": 435.29,
   "text": "گرفتار‌ها برسن. امام عصر سلام الله علیه شأنش خیلی بالاتر از اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.29,
   "end": 438.87,
   "text": "آقا را بیفته تو بیابونا و تو مریضخونه‌ها و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.87,
   "end": 443.23,
   "text": "مثلا گرفتار جاهایی که مردم مسترن، گرفتن آقا بره بالا سرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.23,
   "end": 448.39,
   "text": "از این ابدال که سومین دسته‌اند استفاده می‌کنه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.39,
   "end": 456.01,
   "text": "اون‌ها در م-- یعنی به چنان توجه و همتی رسیدن که تشخیص میدن اذن آقا هست یا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.01,
   "end": 458.49,
   "text": "و اونجاش کار می‌کنن، میرن به داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.49,
   "end": 463.89,
   "text": "دیگران می‌رسن. یه کسی که خدا اراده شفاشو کرده حضرت حجت محل اراده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.89,
   "end": 468.59,
   "text": "خدا و مشیت خدا قرار گرفته می‌خواد شفاشو بده، این آقا رو می‌فرسته حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.59,
   "end": 471.01,
   "text": "اذن می‌ده اینم متوجه اذن می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.01,
   "end": 474.21,
   "text": "اذن می‌شه. حالا به چه شکل باید بحث شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.21,
   "end": 476.13,
   "text": "او میره به داد. خیلی از کسایی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.13,
   "end": 482.69,
   "text": "جبهه ما می‌دیدیم، بچه‌ها می‌دیدن آقا یکی اومد یه دفعه رفت جلو همه پشت سرش راه پیدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.69,
   "end": 488.15,
   "text": "نمی‌دونم آقا تو جبهه‌ها زیاد امداد غیبی یکی اومد نمی‌دونم اسب سوار نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.15,
   "end": 490.59,
   "text": "پیاده اینطوری اینا همین ابدال‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.59,
   "end": 494.23,
   "text": "امام عصر که نمیاد که آقا که وقت این کارا نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.23,
   "end": 496.09,
   "text": "به هر حال از شأن آقا کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.09,
   "end": 499.77,
   "text": "نباید تنزل کنه که شأنش خیلی بالاتر از این حرفاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.77,
   "end": 503.99,
   "text": "به قول بزرگان. یا تو مریضخونه‌ها یکی اومد دست سرم کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.99,
   "end": 507.29,
   "text": "یهو دیدم حالم خوب شد و بعد نگاه کردم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.29,
   "end": 513.05,
   "text": "این که یه دفعه غیبش می‌زنه، چرا غیبش می‌زنه اون شکل، اون صور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.05,
   "end": 516.17,
   "text": "اون صورت ظاهری؟ به خاطر اینکه بدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.17,
   "end": 521.35,
   "text": "این شخص بوده. به محض اینکه این شخص توجهش رو از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.35,
   "end": 525.97,
   "text": "ش-- از اون بدن مثالی خودش ورداشت، همون آن غیب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.97,
   "end": 531.07,
   "text": "یعنی محو می‌شه. ایجاد کرده بوده بیرون از نفس ناطقه خودش اون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.07,
   "end": 537.11,
   "text": "همون آن غیب می‌شه. و این‌ها رو زیاد دیدیم ما مثلا تو حضرت آیت الله سیبوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.11,
   "end": 543.87,
   "text": "یک شب شاید مثلا بعضیا که این امور رو یا به توانایی نفس ناطقه خودشون پیدا نبردن، اینا براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.87,
   "end": 546.37,
   "text": "مثلا عجیب و غریب بیاد و خرافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.37,
   "end": 550.01,
   "text": "در صورتی که آقای حضرت آیت الله سیبوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.01,
   "end": 555.57,
   "text": "که ما در اون حد نیستیم اما شاید انگشت کوچیکه بعضی از مراجع ما هم نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.57,
   "end": 562.05,
   "text": "بود که مثلا تو یه دهه‌ای چند تا هیئت دعوت بود تو یک ساعت و همش هم رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.05,
   "end": 568.99,
   "text": "بعدا مشخص شد و بعد از ارتحالشون ارتباطشون با امام عصر سلام الله علیه کشف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.99,
   "end": 571.25,
   "text": "حالا این‌ها چی-- کیا هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.25,
   "end": 573.67,
   "text": "ابدال‌اند که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.67,
   "end": 577.03,
   "text": "سربازای آقان، صاحبان همت بالان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.03,
   "end": 578.71,
   "text": "بعد از اینا می‌شن اوتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.71,
   "end": 581.45,
   "text": "\"والجبال اوتادا\" تو قرآن می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.45,
   "end": 584.03,
   "text": "اینا مثل دیگه میخ زمین اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.03,
   "end": 586.87,
   "text": "زمین به وجود این‌ها مستقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.87,
   "end": 589.01,
   "text": "مثل میخ کوبیده شدن رو زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.01,
   "end": 593.59,
   "text": "و خیلی از بلاهایی که میاد میره به واسطه وجود این‌ها از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.59,
   "end": 596.19,
   "text": "که حالا اینا رو تعدادشون هم مشخصه ما کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.19,
   "end": 599.27,
   "text": "دیگه بعد از اون حضرت حجته اون‌ها مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.27,
   "end": 603.37,
   "text": "دیگه این‌ها رو صاحبان همت رو می‌گن نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.37,
   "end": 606.65,
   "text": "مستکفی. توجه کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.65,
   "end": 609.75,
   "text": "صاحب امر رو که بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.75,
   "end": 612.45,
   "text": "صاحبان همت هست می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.45,
   "end": 620.67,
   "text": "صاحب-- بهش می‌گن نفس مکتفی یا صاحب الأمر که همون حضرت حجت بن الحسن و امام زمان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 620.67,
   "end": 622.63,
   "text": "که فقط او این قدرت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.63,
   "end": 625.65,
   "text": "اون محل مشیت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.65,
   "end": 628.79,
   "text": "این رونده، این سیره، این اتصاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.79,
   "end": 630.83,
   "text": "این خطیه که انسان باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 630.83,
   "end": 634.67,
   "text": "شروع کنه طی کنه. ایمان، عمل صالح به ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.67,
   "end": 637.71,
   "text": "به مرحله اخبات برسه که همون ابرارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.71,
   "end": 642.49,
   "text": "توجه کامل. ورود پیدا کنه به بحث همت عالی و ابدال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.49,
   "end": 646.37,
   "text": "بعد انشاالله اوتاد و دیگه در خدمت حضرت حجت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.37,
   "end": 652.37,
   "text": "این اخ-اخبات رو و مخبتین رو توی این فرمول انشاالله توجه کردید کجا قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 652.37,
   "end": 655.33,
   "text": "انشاالله برسید و دست ما رو هم بگیرید نثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 655.33,
   "end": 657.51,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.51,
   "end": 660.55,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 660.55,
   "end": 670.47,
   "text": "اللهم صل على محمد و آل محمد كما علمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}