 "chapters": [
  {
   "index": 0,
   "title": "## سوختن و طهارت نفس؛ گریه ملک حسین",
   "start": 0.54,
   "end": 181.46
  },
  {
   "index": 1,
   "title": "## غسل قلب؛ اشک برای حسین",
   "start": 181.46,
   "end": 356.1
  },
  {
   "index": 2,
   "title": "## کندن از تعلّقات و مهجه",
   "start": 356.1,
   "end": 377.18
  },
  {
   "index": 3,
   "title": "## امیرالمؤمنین و کفش کارگر",
   "start": 377.18,
   "end": 779.07
  },
  {
   "index": 4,
   "title": "## زینب از کودکی کنده از تعلّق؛ روضهٔ ناحیه",
   "start": 779.07,
   "end": 928.65
  },
  {
   "index": 5,
   "title": "## عباسی رکاب زینب؛ کعبهٔ الرّزایا",
   "start": 928.65,
   "end": 1158.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 6.26,
   "text": "من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.26,
   "end": 8.18,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.18,
   "end": 12.32,
   "text": "لا حول ولا قوة الا بالله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.32,
   "end": 16.84,
   "text": "اللهم اياک نعبد واياک نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.84,
   "end": 22.16,
   "text": "الحمد لله على كل نعمته واسال الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.16,
   "end": 26.22,
   "text": "السلام عليك يا داعي الله ورباني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.22,
   "end": 32.46,
   "text": "اياته. سلام عليكم ورحمة الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.46,
   "end": 37.5,
   "text": ". روز سوم محرم الحرام و ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.5,
   "end": 42.54,
   "text": "عزاداری سید و سالار شهیدان و یاران باوفاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.54,
   "end": 48.86,
   "text": "ان شا الله که امام عصر عزیزمون از سائع هر کجا گریانن به حال جدشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.86,
   "end": 53.08,
   "text": "در میان گریه ما رو هم دعا کنن صلواتی هدیه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.08,
   "end": 59.04,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.04,
   "end": 67.46,
   "text": "محمد خیلی کوتاه بحث ما چه در بحث روضه و چه صحبت در این ایام خیلی اجمال هست کوتاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.46,
   "end": 73.34,
   "text": "خیلی کوتاه بحث سوختن رو که موضوعیت سوختن رو بیان می‌کردیم امروز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.34,
   "end": 76.58,
   "text": "ادامه بدیم و نکته‌ای رو از اون استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.58,
   "end": 81.02,
   "text": "عرض کردیم که سوختن طهارت نفس میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.02,
   "end": 83.86,
   "text": "و سبب می‌شه که حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.86,
   "end": 87.92,
   "text": "عالم در وجود ما نزول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.92,
   "end": 93.72,
   "text": "و ما حقایق رو بهتر بفهمیم، معرفت کسب کنیم و خود معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.72,
   "end": 96.94,
   "text": "عرض کردیم که شدت معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.94,
   "end": 100.68,
   "text": "هب رو شدید می‌کنه و بدل به عشق می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.68,
   "end": 104.74,
   "text": "این‌ها و عرض کردیم که سوختن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.74,
   "end": 109.2,
   "text": "اون بهترین آثارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.2,
   "end": 112.78,
   "text": "ایجاد طهارت نفس برای انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.78,
   "end": 116.24,
   "text": "امروز نکته‌ای که عرض می‌کنیم این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.24,
   "end": 119.32,
   "text": "یکی از بهترین آثار سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.32,
   "end": 123.52,
   "text": "و گریه کردن برای حضرت ابا عبدالله که اختصاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.52,
   "end": 127.08,
   "text": "گریه برای ایشون خیلی مختصه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.08,
   "end": 129.68,
   "text": "فبک للحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.68,
   "end": 133.54,
   "text": "این لام رو لام مالکیت بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.54,
   "end": 139.3,
   "text": "که نه گریه اصلاً مالکیتش برای حسین ابن علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.3,
   "end": 142.62,
   "text": "تحت تملک سید و شهداست گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.62,
   "end": 148.14,
   "text": "لذا حضرت علی ابن موسی الرضا علیهم الصلاة والسلام به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.14,
   "end": 150.64,
   "text": "ابن شبيب چی فرمود؟ همه حفظید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.64,
   "end": 154.8,
   "text": "که اذا کنت باکی للشيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.8,
   "end": 159.04,
   "text": "برای هر چیزی للشيء برای هر چیزی خواستی گریه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.04,
   "end": 161.42,
   "text": "فبک پس گریه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.42,
   "end": 164.24,
   "text": "للحسین این لام رو مالکیت بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.24,
   "end": 167.0,
   "text": "اصلاً گریه برای این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.0,
   "end": 169.76,
   "text": "حالا این اختصاصی که ایجاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.76,
   "end": 178.3,
   "text": "خدای خصوصیت خاصی رو در اشک برای آقا قرار داده در سوختن، سوختنش جنسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.3,
   "end": 181.46,
   "text": "فرق می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.46,
   "end": 185.18,
   "text": "کاری که بلایی که این نوع سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.18,
   "end": 187.7,
   "text": "سر قلب میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.7,
   "end": 194.02,
   "text": "اینو خوب توجه کنید خیلی به دردتون می‌خوره که چرا ما باید اصلاً گریه کنیم و بسوزیم برای آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.02,
   "end": 196.58,
   "text": "کاری که سوختن برای این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.58,
   "end": 198.84,
   "text": "با قلب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.84,
   "end": 203.92,
   "text": "کاریه که غسل به ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.92,
   "end": 209.34,
   "text": "با بدن می‌کنم. روز اول محرم غسل توبه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.34,
   "end": 216.1,
   "text": "خوشا به حال کسایی که حواسشون جمع به این دستورات و آدابه دیگه آداب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.1,
   "end": 220.52,
   "text": "ادب آموزی می‌کنند و انجام میدن خیرشو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.52,
   "end": 223.9,
   "text": "اون غسلی که روز اول محرم کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.9,
   "end": 228.06,
   "text": "بدنت رو تطهیر کرد. اگرچه تطهیر بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.06,
   "end": 231.56,
   "text": "در باطن هم تاثیرگذار هست البته این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.56,
   "end": 234.9,
   "text": "در هم تاثیرگذارن. مثل اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.9,
   "end": 238.02,
   "text": "یه شخصی لباسشو دیر به دیر می‌شست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.02,
   "end": 240.62,
   "text": "مثل بعضیا دیدیم مثلاً یقه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.62,
   "end": 243.46,
   "text": "چرک شده، سراستیناش چرک شده، اصلاً توجه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.46,
   "end": 247.2,
   "text": "پیغمبر بهش تذکر داد فرمود لباستو بشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.2,
   "end": 253.02,
   "text": "این لباس وقتی کثیفه نمی‌تونه ذکر خدا رو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.02,
   "end": 257.32,
   "text": "این کثافت و خباثت و این‌ها مانع ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.32,
   "end": 260.94,
   "text": "حالا این حقایق چگونه ملک و ملکوت با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.94,
   "end": 264.68,
   "text": "در هم تنیده می‌شن اهلش می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.68,
   "end": 267.76,
   "text": "همینطور تاثیرگذار طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.76,
   "end": 271.82,
   "text": "ظاهر در باطن. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.82,
   "end": 282.8,
   "text": "اونچه که اصلاً قلب ما رو تطهیر می‌کنه و غسل قلب می‌شه، شما غس-غسل دادید بدنتون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.8,
   "end": 290.7,
   "text": "غسل قلب چیه؟ غسل باطن وجودی نفس ناطقه ما، روح ما هر اس-اسمی بخوای روش بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.7,
   "end": 294.04,
   "text": "غسل قلب اشکه برای این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.04,
   "end": 298.74,
   "text": "یعنی کسی که می‌سوزه در مسیر حسین ابن علی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.74,
   "end": 301.84,
   "text": "دل هم نسوزه اشک جاری نمی‌شه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.84,
   "end": 304.04,
   "text": "فرق نمی‌کنه چه بگی سوختن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.04,
   "end": 308.2,
   "text": "چه بگی گریه کردن. البته سوختن مقدمه‌ی اشکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.2,
   "end": 313.1,
   "text": "یعنی می‌سوزی آماده میشی برای اشک ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.1,
   "end": 316.7,
   "text": "حالا یکی برای چک برگشتیش می‌سوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.7,
   "end": 321.24,
   "text": "اونم یه طور گریه می‌کنه. یکی برای بدبخت بیچاره‌گیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.24,
   "end": 326.18,
   "text": "این‌ها، یکی هم نه برای حجت خدا گریه می‌کنه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.18,
   "end": 330.22,
   "text": "حالا در اقسام گریه کردن ما سال گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.22,
   "end": 333.0,
   "text": "حرف زیاد زدیم یادش بخیر اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.0,
   "end": 339.28,
   "text": "در اقسام گریه کردن حتی برای این آقا مراتب گریه کردن رو توضیح دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.28,
   "end": 344.7,
   "text": "بر اساس فرمایشات بزرگانی مثل مثلاً شیخ جعفر شوشتری مراتب گریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.7,
   "end": 350.32,
   "text": "اقسام دوازده گانه بعضیا تا چهارده تا گفتن گریه چگونه‌ست حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.32,
   "end": 355.8,
   "text": "پس غسل قلب ما غسل باطن ما می‌شه اشکه برای حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.8,
   "end": 360.98,
   "text": "خب این غسل باطن و سوختن و اشک ریختن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.98,
   "end": 364.06,
   "text": "قلب رو تطهیر میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.06,
   "end": 366.34,
   "text": "باطن رو غسل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.34,
   "end": 368.34,
   "text": "این چه اثری داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.34,
   "end": 370.68,
   "text": "یعنی کسی سوخت گریه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.68,
   "end": 374.0,
   "text": "و قـ-قلبش غسل داده شد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.0,
   "end": 377.18,
   "text": "اون موقع آماده میشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.18,
   "end": 379.8,
   "text": "برای تـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.8,
   "end": 382.82,
   "text": "اتصال و ارتباط با ملکوت عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.82,
   "end": 390.08,
   "text": "رو چه حسابی میگی؟ به جهت اینکه وقتی که مخصوصاً برای این آقا ها، مخصوصاً حواستون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.08,
   "end": 394.7,
   "text": "برای این آقا خدا هم قرار داده در دل این سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 394.7,
   "end": 398.44,
   "text": "یه حالتی رو که فقط چشیدنیه، گفتنی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.44,
   "end": 401.9,
   "text": "یه حالتی رو که کسی که برای این آقا بسوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.9,
   "end": 404.26,
   "text": "جگرش کباب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.26,
   "end": 407.74,
   "text": "و اشک بریزه در مصیبت و غربت این آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.74,
   "end": 410.48,
   "text": "کنده میشه از تعلقاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.48,
   "end": 413.34,
   "text": "شما دقت بفرمایید بعد از جلسه امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.34,
   "end": 416.32,
   "text": "علیه السلام چه نشاط و فرحی درته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.32,
   "end": 419.04,
   "text": "اون برای چیه؟ که اینم خودش یه مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.04,
   "end": 423.78,
   "text": "انشالله یه روز باید بهش بپردازیم. علت این انبساط و این نشاط چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.78,
   "end": 426.58,
   "text": "اونم خودش یه نکته‌ست. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.58,
   "end": 430.58,
   "text": "اونچه که باعث اون انبساط شده، کندن از تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.58,
   "end": 433.6,
   "text": "یعنی شما وقتی داری برای این آقا گریه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.6,
   "end": 441.56,
   "text": "مخصوصاً اگر خصوصاً میگم اگر انتقال حال حجت به تو رخ بده، یعنی حال امام حسن به تو منتقل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.56,
   "end": 444.5,
   "text": "ولا سر سوزنی اصلاً دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.5,
   "end": 448.02,
   "text": "دوست داری همه چی تو فدای این آقا بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.02,
   "end": 450.28,
   "text": "\"الذین بذلوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.28,
   "end": 454.68,
   "text": "مهجهم دونک\" تو سجده زیارت عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.68,
   "end": 462.08,
   "text": "این مهجه مهجه در عرب قبلاً عرض کردیم اون آخر وقتی که مثلاً گوسفندو ذبح می‌کنند، قربانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 462.08,
   "end": 467.32,
   "text": "می‌کشن و این‌ها و دیگه خونش میره و بعداً پوستشو می‌کنن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.32,
   "end": 472.32,
   "text": "این‌ها باز چک، چک، چک خون‌هایی ازش می‌ریزه که اونا دیگه پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.32,
   "end": 475.8,
   "text": "قلبشو که درآری قلب این قربانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.8,
   "end": 480.82,
   "text": "آخرین قطره خونی که تو این قلب باقی مونده به اون میگه عرب به اون میگه مهجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.82,
   "end": 484.3,
   "text": "\"الذین بذلوا مهجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.3,
   "end": 487.7,
   "text": "دونک\" یعنی این آخرین قطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.7,
   "end": 491.32,
   "text": "خون در قلب مونده‌شون رو ببین قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.32,
   "end": 497.5,
   "text": "یعنی شما قلبت که سوخت آتش گرفت برای این آقا آتش گرفت و سوختی اشک ریختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.5,
   "end": 501.3,
   "text": "دیگه حاضری حتی آخرین ق-- این خصوصیت برای گریه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.3,
   "end": 505.92,
   "text": "اباعبدالله این به صورت سری در زیارت عاشورا واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.92,
   "end": 514.24,
   "text": "حاضر میشی نه فقط دار و ندارَت بلکه آخرین قطره خون در قلبت رو هم چون قلبت می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 514.24,
   "end": 516.84,
   "text": "تطهیر قلبه دیگه. غسل داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.84,
   "end": 521.18,
   "text": "آخرین قطره خون در قلبت رو هم برای آقا بدی فدا بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.18,
   "end": 526.5,
   "text": "و تا تعل-- کندن از تعلقات رخ نده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.5,
   "end": 529.0,
   "text": "نمیشه کسی اینطوری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.0,
   "end": 533.14,
   "text": "یعنی نمیشه کسی حاضر بشه همه چیو فدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 533.14,
   "end": 536.74,
   "text": "تعلقات ما رو بیچاره کرده که خیلی در سیر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 536.74,
   "end": 540.34,
   "text": "مراتب نفس و این‌ها ما قبلاً پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 540.34,
   "end": 543.06,
   "text": "گرفتاری تعلقات نفس زیاد حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.06,
   "end": 544.86,
   "text": "اینا رو سنجاق کنید به اون مباحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.86,
   "end": 547.42,
   "text": "کسانی که این حرفا رو قبلاً شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.42,
   "end": 553.46,
   "text": "خوب دیگه قشنگ الان براشون جا میفته که چقدر بیچاره‌ایم ما به خاطر تعلقاتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 553.46,
   "end": 558.26,
   "text": "یکی تعلق داره به نسب و نسبش مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.26,
   "end": 560.54,
   "text": "نسب پدریش، مادریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.54,
   "end": 565.72,
   "text": "اون مثلاً چه می‌دونم گیرین که پدر تو بود فاضل از فضل پدر تو را چه خاصیت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 565.72,
   "end": 568.3,
   "text": "گرفتاره. من پسر فلانی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 568.3,
   "end": 574.56,
   "text": "من پسر... بعضیا تعلق دارن به مالشون که اوه، اوه این که دیگه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 574.56,
   "end": 578.7,
   "text": "غوغا کرده. تعلق بعضیا دارن به میزشون به مدیریتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 578.7,
   "end": 583.34,
   "text": "اوه، اوه، اوه. خدا نکنه یه آدم بی ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 583.34,
   "end": 586.54,
   "text": "و بدون آماده بره بشینه پشت میز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 586.54,
   "end": 590.16,
   "text": "ریاست. تازه ریاست‌های کوچیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 590.16,
   "end": 593.62,
   "text": "دیگه واویلتاست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.62,
   "end": 595.64,
   "text": "اون که رئیس کل عالم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 595.64,
   "end": 597.88,
   "text": "عالم. رئیس هم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.88,
   "end": 603.68,
   "text": "رئیس که غلطه بگیم. زعیم بود، امام بود، خلیفه الله بود، منصوب از طرف حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 603.68,
   "end": 610.42,
   "text": "اینطوری نگاش کن. نه یه ریاست اعتباری که دو روز تویی بعدش مینذارنت بیرون یکی دیگه میاد جای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 610.42,
   "end": 617.7,
   "text": "همونایی که با قلمت حقوقشونو کم کردی، پدرشونو درآوردی، آبروشونو بردی، معرفیشون کردی به اداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 617.7,
   "end": 619.78,
   "text": "همونا بعداً به ریشت می‌خندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 619.78,
   "end": 624.64,
   "text": "ما هستیم، تو رفتی. اون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.64,
   "end": 627.68,
   "text": "زعیم آل از طرف حضرت حق منصوب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 627.68,
   "end": 631.68,
   "text": "شوخی نیست. تو بازا-- آقامون امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 631.68,
   "end": 635.58,
   "text": "به دروغ هم میایم میگیم مولامون، آقامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.58,
   "end": 639.6,
   "text": "بشین سر جات. تو کجا و مولای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 639.6,
   "end": 643.58,
   "text": "به خودم حدیث و نص می‌خونم جسارت به شما نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 643.58,
   "end": 648.04,
   "text": "تو بازار داشتم امروز به همین زحمتکش‌های ادارتون هم داشتم می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 648.04,
   "end": 650.96,
   "text": "همینای که چایی می‌ریزن و چایی می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 650.96,
   "end": 657.32,
   "text": "اصلاً جگرشون خنک میشد از این حرفا که همچین آقایی بالا سرشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 657.32,
   "end": 660.38,
   "text": "حالا آقاهای بالا سر ما کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.38,
   "end": 663.96,
   "text": "این زحمتکش‌های درب و داغونا آقاشون علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.96,
   "end": 669.22,
   "text": "آقا تو بازار می‌رفت کفش یکی که داشت بار می‌کشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.22,
   "end": 673.18,
   "text": "کارگر بود جزء اینا که ما اصلاً معذرت می‌خوام آدم حسابشون نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 673.18,
   "end": 675.76,
   "text": "ببخشید اتفاقاً آدم پیش خدا همیناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 675.76,
   "end": 680.32,
   "text": "افضل القوم خادم. خادم هر قومی افضل هر قومیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.32,
   "end": 684.64,
   "text": "نه مدیر هر قومی. خادم هر قومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.64,
   "end": 689.02,
   "text": "بعد کفشش لنگه کفشش از پاش دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 689.02,
   "end": 692.88,
   "text": "خب این کارگره. امیرالمؤمنین دوید آقا رئیس آل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 692.88,
   "end": 695.14,
   "text": "استغفرالله حجت عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.14,
   "end": 698.1,
   "text": "حجت خدا. ولی الله العظم دوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 698.1,
   "end": 702.24,
   "text": "کفش حالا به قول ما دمپایی این کارگره رو برداشت برد برسون بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 702.24,
   "end": 707.8,
   "text": "حالا اگه ما بودیم خیلی مثلاً علیه السلام بودیم به این نوچه‌هامون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.8,
   "end": 710.0,
   "text": "مریدامون می‌گفتیم برو اون کفششو بهش برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 710.0,
   "end": 712.5,
   "text": "رفت با دست مبارک کفشو کرد تو پاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 712.5,
   "end": 719.14,
   "text": "اعتراض کردن به آقا. اون یکی بارش داشت می‌افتاد از رو دوشش اینقدر سنگین بود پیرمردה داشت بار می‌کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.14,
   "end": 723.23,
   "text": "مولا رفت بارشو از رو دوشش برداشت گذاشت رو دوش خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 723.23,
   "end": 726.81,
   "text": "گفتن آقا شما رئیس مملکتی زشته این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 726.81,
   "end": 728.45,
   "text": "گفت بشینید سر جاتون چی زشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 728.45,
   "end": 733.21,
   "text": "حالا من لطیفانه دارم میگم. حضرت فرمودن ما اومدیم بار از روی دوش مردم برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 733.21,
   "end": 739.05,
   "text": "چی دارید میگید شما؟ حالا بحث ما دوباره به اون طرف کشیده نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 739.05,
   "end": 744.13,
   "text": "میخوام بگم که کندن از تعلقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 744.13,
   "end": 747.83,
   "text": "تو اشک واقعی برای حسین ابن علی رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 747.83,
   "end": 750.91,
   "text": "حالا یکی اشک خیالی میریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 750.91,
   "end": 754.33,
   "text": "یه وجه، یه طور. یکی عک-- اشک عقلی میریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 754.33,
   "end": 757.43,
   "text": "یه طور. یکی اشک قلبی میریزه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 757.43,
   "end": 760.03,
   "text": "خیلی بالاتر. محجע اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 760.03,
   "end": 762.03,
   "text": "تو قلبه. حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 762.03,
   "end": 764.09,
   "text": "یعنی دل بکنی از تعلقاتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 764.09,
   "end": 766.95,
   "text": "یکی هم تعلق به مثلاً تیپ و قیافه‌ش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 766.95,
   "end": 769.63,
   "text": "یکی تعلق به اعتباریاتش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 769.63,
   "end": 773.67,
   "text": "معروفیت و مشهوریتش هرکیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.67,
   "end": 778.93,
   "text": "باید بکنی. الذین بذلوا محجعم دونک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 778.93,
   "end": 784.07,
   "text": "و چه عجیب که این خانمی که امروز میخوایم روضه‌ش رو بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 784.07,
   "end": 789.31,
   "text": "از بچگی از همه تعلقاتش کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 789.31,
   "end": 792.77,
   "text": "حواستون جمع باشه چجوری داریم میریم تو روضه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 792.77,
   "end": 798.31,
   "text": "از همون بچگی از همه تعلقاتش تو وادی حسین کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 798.31,
   "end": 802.83,
   "text": "یعنی چی حاجی؟ چی داری میگی؟ هیچ کجا بدون حسین نمیرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 802.83,
   "end": 804.89,
   "text": "اینو همه شنیدید. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 804.89,
   "end": 807.15,
   "text": "یعنی تعلق، کندن از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 807.15,
   "end": 811.25,
   "text": "گنده گنده هاش تو قصه حرکت ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 811.25,
   "end": 817.45,
   "text": "از مدینه به سمت مکه و بعد به سمت کوفه و بعد کربلا بریده بودن، گنده هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 817.45,
   "end": 820.05,
   "text": "اما این خانم از بچگی نه که فقط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 820.05,
   "end": 824.23,
   "text": "از بچگی کنده بود به خاطر حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 824.23,
   "end": 827.01,
   "text": "یه چیز عجیبیه. اصلاً واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 827.01,
   "end": 830.23,
   "text": "این حسین یک عاشق دارد و آن هم زینب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 830.23,
   "end": 835.11,
   "text": "تمام. چیز عجیبیه وقتی روایات رو بررسی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 835.11,
   "end": 838.17,
   "text": "حالا روضه‌ی ما هم اجمالیه شما هم باید سریع آماده بشید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 838.17,
   "end": 840.81,
   "text": "هه، دیگه ما مقدمه نشینیم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 840.81,
   "end": 843.11,
   "text": "وقتی به دنیا اومد هی گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 843.11,
   "end": 845.65,
   "text": "بچه گریه می‌کنه دیگه که اون هم حکمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 845.65,
   "end": 849.15,
   "text": "امام صادق حکمت اون رو هم فرموده چرا بچه گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 849.15,
   "end": 851.91,
   "text": "در توحید مفضل مفصل گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 851.91,
   "end": 854.05,
   "text": "بچه گریه می‌کرد از زینب قربونش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 854.05,
   "end": 857.37,
   "text": "اگرچه دختر ولایته وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 857.37,
   "end": 859.47,
   "text": "بغل هر کدوم دادن این گریه آروم نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 859.47,
   "end": 861.03,
   "text": "چشمای خانم هم بسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 861.03,
   "end": 867.35,
   "text": "به محض اینکه دادنش بغل ابا عبدالله روایته اینو احساسی نبینید مدعا بگن نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 867.35,
   "end": 870.51,
   "text": "تا دادن بغل ابی عبدالله چشماشو باز کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 870.51,
   "end": 872.31,
   "text": "تو صورت حسین نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 872.31,
   "end": 874.35,
   "text": "اشکش تموم شد. گریه‌ش تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 874.35,
   "end": 877.75,
   "text": "لبخند زد. همه دیدن حال زینب عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 877.75,
   "end": 880.69,
   "text": "عجیبه ارتباط این دو تا با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 880.69,
   "end": 883.51,
   "text": "چی بگه آدم؟ بعد اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 883.51,
   "end": 887.45,
   "text": "میخوای گریه کنی، میخوای ناله بزنی، میخوای بسوزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 887.45,
   "end": 892.31,
   "text": "اوج روضه تو ناحیه مقدسه رو اون همه سلام میده آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 892.31,
   "end": 894.57,
   "text": "امام عصر به جدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 894.57,
   "end": 898.25,
   "text": "السلام علی من دفنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 898.25,
   "end": 901.61,
   "text": "اهل القری. السلام علی مقطع الاعضاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 901.61,
   "end": 904.05,
   "text": "السلام علی رأس المرفوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 904.05,
   "end": 908.05,
   "text": "همه اینا، اینا. اوج روضه رو ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 908.05,
   "end": 910.39,
   "text": "می‌دونی کجا مرق میکنه تو ناحیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 910.39,
   "end": 912.41,
   "text": "میگه سلام به تو ای جدّ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.41,
   "end": 914.53,
   "text": "اون لحظه‌ای که در گودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 914.53,
   "end": 920.81,
   "text": "انقباض و انبساط عضلاتت رخ داده بود و از این پهلو به اون پهلو میشدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 920.81,
   "end": 925.57,
   "text": "گوشه‌ی چشمت به خیمه‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 925.57,
   "end": 928.37,
   "text": "گوشه‌ی چشمت به خیمه‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 928.37,
   "end": 932.19,
   "text": "یعنی دل نگران حال زینب و بچه‌ها بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 932.19,
   "end": 934.37,
   "text": "اصلاً قصه‌ی کربلا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 934.37,
   "end": 939.93,
   "text": "روضه‌ی حسینی اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 939.93,
   "end": 944.71,
   "text": "هنر اون داره که بتونه اوج روضه رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 944.71,
   "end": 949.55,
   "text": "خب ولی سنگ هم گریه کرده برای حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 949.55,
   "end": 952.25,
   "text": "برای همین غریبی امام حسین سنگ هم گریه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 952.25,
   "end": 955.71,
   "text": "اما هنر داشته باشی اون جاهای خاص رو بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 955.71,
   "end": 957.81,
   "text": "حسین جان تو خودت داری از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 957.81,
   "end": 960.51,
   "text": "کشته میشی. همه یارانت شهید شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 960.51,
   "end": 963.01,
   "text": "امام زمان سری داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 963.01,
   "end": 966.49,
   "text": "میگه نه، همه‌ی غصه‌ی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 966.49,
   "end": 976.37,
   "text": "این بود که داری میری بعد تو چیز-- بلایی سر زینب میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 976.37,
   "end": 981.05,
   "text": "آخ زینب، آخ زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 981.05,
   "end": 983.85,
   "text": "قربون حال همتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 983.85,
   "end": 988.73,
   "text": "ایشالا چنان از تعلقات بکنی مثل شهدا بخرنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 988.73,
   "end": 991.61,
   "text": "که کندن اونا هم خریدنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 991.61,
   "end": 994.11,
   "text": "برای عزیز دلم زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 994.11,
   "end": 997.11,
   "text": "سلام الله علیها. یه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 997.11,
   "end": 1000.03,
   "text": "چیزی بگم و عزیزم ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1000.03,
   "end": 1006.19,
   "text": "دلم رفت سمت لحظه‌ای که می‌خواستن راه بیفتن از مدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1006.19,
   "end": 1010.87,
   "text": "راوی میگه نگاه کردم دیدم یک زن با جلالتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1010.87,
   "end": 1013.53,
   "text": "از دور نگاه کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1013.53,
   "end": 1016.21,
   "text": "دیدم همه دورشو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1016.21,
   "end": 1018.65,
   "text": "با یه ابهت و عظمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1018.65,
   "end": 1021.49,
   "text": "دارن میارنش سوار بر مرکبش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1021.49,
   "end": 1025.89,
   "text": "گفتم این چیه؟ گفتن دختر علی، زینبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1025.89,
   "end": 1030.23,
   "text": "دورشو گرفته بودن. هرچی کله‌م رو سر کشیدم اینور اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1030.23,
   "end": 1032.89,
   "text": "نتونستم ببینمش دور شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1032.89,
   "end": 1035.23,
   "text": "بعد دیدم یه آقایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1035.23,
   "end": 1038.19,
   "text": "چهارشونه‌ی خیلی قدبلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1038.19,
   "end": 1040.61,
   "text": "و اومد خیلی رشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1040.61,
   "end": 1042.85,
   "text": "زانو زد کنار مرکب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1042.85,
   "end": 1045.13,
   "text": "زانوشو رکاب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1045.13,
   "end": 1047.43,
   "text": "این خانم پاشو گذاشت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1047.43,
   "end": 1050.01,
   "text": "زانوی این آقا رفت بالای مرکب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1050.01,
   "end": 1052.59,
   "text": "گفتم این آقا چیه؟ چه ادبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1052.59,
   "end": 1055.53,
   "text": "گفتن این عباسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1055.53,
   "end": 1059.75,
   "text": "زانوش رکابه سواری زینب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1059.75,
   "end": 1065.25,
   "text": "وقتی هم می‌خواست از ناقه پیاده بشه همین کارو ابالفضل با زینب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1065.25,
   "end": 1073.53,
   "text": "حالا غروب عاشورا یا روز یازدهم می‌خواد از کربلا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1073.53,
   "end": 1075.93,
   "text": "یه نگاه سمت غم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1075.93,
   "end": 1079.15,
   "text": "کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1079.15,
   "end": 1080.99,
   "text": "داداش کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1080.99,
   "end": 1084.55,
   "text": "زانوت برام رکاب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1084.55,
   "end": 1088.01,
   "text": "داداش ببین آقا اهرم و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1088.01,
   "end": 1091.03,
   "text": "تا دورمو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1091.03,
   "end": 1095.87,
   "text": "خدا رحمت کنه سید نعمت الله جزایری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1095.87,
   "end": 1099.61,
   "text": "تو کتابش میگه السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1099.61,
   "end": 1108.05,
   "text": "کعبة الرضا. میگه سلام به تو ای کعبه‌ی اذیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1108.05,
   "end": 1110.35,
   "text": "چرا کعبه؟ بگم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1110.35,
   "end": 1115.25,
   "text": "آخه کعبه دورش طواف می‌کنند و می‌گردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1115.25,
   "end": 1122.05,
   "text": "یعنی دو تا دور زینب رو حرامی‌ها گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 287,
   "start": 1122.05,
   "end": 1138.69,
   "text": "آخ حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 288,
   "start": 1138.69,
   "end": 1142.69,
   "text": "حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 289,
   "start": 1142.69,
   "end": 1145.25,
   "text": "حسین. همه با، همه با هم سلام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 290,
   "start": 1145.25,
   "end": 1151.87,
   "text": "السلام علیک حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 291,
   "start": 1151.87,
   "end": 1158.95,
   "text": "وعلی ابن حسن و علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}