 "chapters": [
  {
   "index": 0,
   "title": "## اربعینِ حسینی؛ چهل‌گیریِ عشاق",
   "start": 0.38,
   "end": 194.6
  },
  {
   "index": 1,
   "title": "## الحج عرفه؛ بیرون از حرم بسوزید",
   "start": 194.6,
   "end": 377.14
  },
  {
   "index": 2,
   "title": "## صلاة؛ آتش گرفتن در لغت",
   "start": 377.14,
   "end": 517.54
  },
  {
   "index": 3,
   "title": "## قرب با سوختن؛ یاران حسین",
   "start": 517.54,
   "end": 568.84
  },
  {
   "index": 4,
   "title": "## مسلم بن عقیل؛ أوثق بنی‌هاشم",
   "start": 568.84,
   "end": 937.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 4.8,
   "text": "اعوذ بالله من الشیطان و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 6.76,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.76,
   "end": 10.72,
   "text": "لا حول و لا قوة الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.72,
   "end": 13.6,
   "text": "العلی العظیم. اللهم ایاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.6,
   "end": 16.64,
   "text": "نعبد و ایاک نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.64,
   "end": 22.56,
   "text": "الحمد لله على کل نعمته و اسال الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.56,
   "end": 27.12,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.12,
   "end": 30.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.16,
   "end": 37.06,
   "text": "تو این چند روز ماه عزای سید و سالار شهیدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.06,
   "end": 42.58,
   "text": "عزیزان نیت کردن که خیلی به صورت اجمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.58,
   "end": 48.68,
   "text": "توسل کوتاهی داشته باشیم و نکاتی رو هم البته قبلش بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.68,
   "end": 52.08,
   "text": "خیلی کوتاه عرض کنم تا عزیزان توسل‌شون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.08,
   "end": 56.78,
   "text": "شروع می‌کنند .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.78,
   "end": 62.96,
   "text": "اون‌هایی که در مسیر سیر و سلوک هستند می‌دانند که بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.96,
   "end": 65.72,
   "text": "اون چهل‌ده و اربعین‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.72,
   "end": 75.46,
   "text": "موسوی یا کلیمیه که از اول ماه ذی القعده شروع می‌شه تا دهم ذی الحجة و بعید قربان تموم می‌شه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.46,
   "end": 79.96,
   "text": "یکی از بهترین اربعینیات و چهل‌گیری‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.96,
   "end": 86.04,
   "text": "برای سلاک و عباد الرحمن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.04,
   "end": 95.08,
   "text": "که دستور، دستورات زیادی براش مترتب شده هم از روزه و از کار و اوراد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.08,
   "end": 100.44,
   "text": "بالاتر از عارف و عرفا، عشاق هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.44,
   "end": 104.22,
   "text": "البته مسیر عشق و حب که عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.22,
   "end": 108.54,
   "text": "شدت حب است از مسیر عرفان میره، می‌گذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.54,
   "end": 115.2,
   "text": "یعنی عارف بر اثر شناخت دقیق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.2,
   "end": 119.58,
   "text": "لطیفی که از معشوق پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 119.58,
   "end": 121.84,
   "text": "از مسیر حب گذر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.84,
   "end": 125.0,
   "text": "شدت حب او رو به عشق می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.0,
   "end": 128.44,
   "text": "لذا این اربعین حسینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.44,
   "end": 135.52,
   "text": "این چهل‌گیری که عشاق می‌گیرن از اول محرم شروع می‌شه تا دهه‌ی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.52,
   "end": 138.4,
   "text": "تا عرض شود اربعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.4,
   "end": 148.02,
   "text": "اربعین سید و شهدا. بعض تا ده روز قبل از اربعین بعضی‌ هم از روز شهادت ارباب شروع می‌کنند تا اربعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 148.02,
   "end": 150.5,
   "text": "به این شکل. یعنی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 150.5,
   "end": 156.04,
   "text": "اول محرم بعضی‌ها از امروز شروع می‌کنند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 156.04,
   "end": 160.22,
   "text": "دهه ماه سه- دهه اول ماه صفر، روز دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.22,
   "end": 162.2,
   "text": "می‌شه چهل روز. بعضی‌ هم نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.2,
   "end": 165.82,
   "text": "از روز شهادت ارباب شروع می‌کنند تا روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.82,
   "end": 169.92,
   "text": "اربعین چهل روز. حالا در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.92,
   "end": 173.6,
   "text": "این چهل‌ده، چهل‌ده حسینیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.6,
   "end": 176.4,
   "text": "آنچه که در این چهل‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.4,
   "end": 180.1,
   "text": "عشاق لحاظ می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.1,
   "end": 186.32,
   "text": "از حیث اون آدابی که برای چهل‌گیری و اربعین‌شون دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.32,
   "end": 189.64,
   "text": "چیزی نیست جز سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.64,
   "end": 193.14,
   "text": "برنامه‌شون در مسیر سوختن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.14,
   "end": 198.76,
   "text": "اتفاقاً نکته‌ای رو عرض کنم که در عزیزانی که تشریف داشتند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.76,
   "end": 204.56,
   "text": "دعای عرفه پیش از شروع دعای عرفه محضر اون شاهد گمنام عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.56,
   "end": 213.04,
   "text": "که اتفاقاً حضرت امام صادق صلی الله علیه یه سؤال خیلی جالبی پرسیدن و چه شیرین جواب دادن حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.04,
   "end": 215.36,
   "text": "که آقا مثلاً در ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.36,
   "end": 220.96,
   "text": "حج ما از حرم بیرون می‌شیم می‌ریم به صحرای عرفات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.96,
   "end": 223.8,
   "text": "ان‌شاءالله قسمت بشه با معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.8,
   "end": 228.18,
   "text": "خب چگونه است که شما فرمودید الحج عرفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.18,
   "end": 231.04,
   "text": "یعنی همه‌ی حج عرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.04,
   "end": 234.24,
   "text": "در حالی که خود صحرای عرفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 234.24,
   "end": 238.5,
   "text": "به یک معنا بیرون کردن حاجی از حرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.5,
   "end": 241.74,
   "text": "خود صحرای عرفات که جزو حرم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.74,
   "end": 244.5,
   "text": "از حرم بیرونت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.5,
   "end": 248.42,
   "text": "میری تو بیابون اونجا وقوف می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.42,
   "end": 254.54,
   "text": "در صحرای عرفات تا حالا بعد دو مرتبه برگردی برای اِه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.54,
   "end": 258.38,
   "text": "ادامه مناسک حج. چه شیرین حضرت جواب دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.38,
   "end": 263.04,
   "text": "فرمودند از این حیث همه‌ی حج عرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.04,
   "end": 269.52,
   "text": "البته یک وجهش اینه حضرت فرمودن بنا به سعه‌ی وجودی اون سائل که پرسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.52,
   "end": 274.08,
   "text": "فرمودند که بله شما رو از حرم بیرون می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.08,
   "end": 279.1,
   "text": "دور از حرم، فراغ حرم شما رو بگیره بیرون از حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.1,
   "end": 283.2,
   "text": "و بسوزید. به سوختن بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 283.2,
   "end": 292.28,
   "text": "به گریه بیفتید. به ناله و عنابه بیفتید تا دو مرتبه بر اثر این سوختن لیاقت برگشتن به حرم پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 292.28,
   "end": 298.66,
   "text": "اتفاقاً اصل حج رو حضرت می‌فرماید همون سوختن تو عرفاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 298.66,
   "end": 303.92,
   "text": "عجیبه. این سوختن خیلی موضوعیت داره اصلاً طریقیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 303.92,
   "end": 307.0,
   "text": "بگیم حالا یه راه مثلاً رسیدن به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 307.0,
   "end": 311.84,
   "text": "مثلاً یه راهش نمازه، یه راهش هم مثلاً سوختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.84,
   "end": 314.82,
   "text": "نه، اصلاً موضوعیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 314.82,
   "end": 319.4,
   "text": "یعنی در هر منسکی از مناسک الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 319.4,
   "end": 322.24,
   "text": "و در هر طریقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 322.24,
   "end": 324.22,
   "text": "در، برای سالک الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 324.22,
   "end": 327.12,
   "text": "و عباد الرحمن هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 327.12,
   "end": 332.52,
   "text": "عبادتی رو که اینا بخوان در چهله‌شون منظور کنند باید همراه سوختن باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 332.52,
   "end": 335.62,
   "text": "و هر چیزی که ما رو بیشتر بسوزونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 335.62,
   "end": 339.62,
   "text": "بنا به فرمایش امام صادق صلی الله علیه که اینجا فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 339.62,
   "end": 350.78,
   "text": "ما رو لایق وصل و زیارت می‌کنه که اصل زیارت هم حضور زائر عند المبرور مزور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 350.78,
   "end": 353.56,
   "text": "زیارت شد، ش-شونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 353.56,
   "end": 357.1,
   "text": "حضور زائر، زائر زیارت کننده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 357.1,
   "end": 361.12,
   "text": "حضور او نزد زیارت شونده می‌شه اصل زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 361.12,
   "end": 363.14,
   "text": "که حالا از راه دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 363.14,
   "end": 366.5,
   "text": "می‌شه زیارت قلبی که اصل هم البته زیارت قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 366.5,
   "end": 371.12,
   "text": "پس این سوختن یکی از بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.12,
   "end": 373.92,
   "text": "موضوعاتی‌ست که در متن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 373.92,
   "end": 377.14,
   "text": "در متن عبادیت ما می‌بایستی که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.14,
   "end": 381.06,
   "text": "اتفاقاً بزرگان فرمودن اصل معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 381.06,
   "end": 385.86,
   "text": "صلاة، صلاة رو اگر لغت‌شناسی کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.86,
   "end": 389.64,
   "text": "سحاح اللغة، کتاب‌های خوب لغت‌شناسی رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.64,
   "end": 396.08,
   "text": "یکی از معانی دقیقی که بر صلاة و نماز ما دادن گفتن سوختن، آتش، آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 396.08,
   "end": 403.58,
   "text": "آتش گرفتن. اصلاً نمازی که بدون سوختن و آتش گرفتن باشه چه نمازیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.58,
   "end": 406.44,
   "text": "محرمی که بدون سوختن باشه چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.44,
   "end": 410.1,
   "text": "محرمیه؟ بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.1,
   "end": 415.48,
   "text": "دام عشق ابا عبدالله، بهترین دام عشق خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.48,
   "end": 418.88,
   "text": "این الهیت نظام هستی عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 418.88,
   "end": 422.5,
   "text": "تو این ده شب اتفاق میفته با سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 422.5,
   "end": 424.38,
   "text": "سوختن، همه رو سوزوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 424.38,
   "end": 427.38,
   "text": "یعنی انبیا همه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 427.38,
   "end": 432.6,
   "text": "با این عشق سوختن. اصلاً معنای سوختن همون معنای حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 432.6,
   "end": 436.38,
   "text": "حضور. ما گفتیم حضور ظاهر عند المظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 436.38,
   "end": 442.42,
   "text": "اصلاً حس حضور در محضر حضرت حق که تمام عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 442.42,
   "end": 447.9,
   "text": "محضر اوست چون همه‌ی عالم ظهور و تجلی حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 447.9,
   "end": 449.76,
   "text": "و چیزی جز حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 449.76,
   "end": 453.7,
   "text": "خلق حق متشعنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.7,
   "end": 456.52,
   "text": "حق ظهور یافته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.52,
   "end": 459.6,
   "text": "باطن حق آشکار که می‌شه، می‌شه خلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.6,
   "end": 462.22,
   "text": "می‌شی شما. خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 462.22,
   "end": 467.24,
   "text": "عین محضر حقه. کسی این رو درک کنه ما آنی از محضر حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 467.24,
   "end": 469.6,
   "text": "سبحانه و فارغ نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 469.6,
   "end": 471.94,
   "text": "وقتی که فهمید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 471.94,
   "end": 476.06,
   "text": "آن فآن در محضر حضرت حق سبحانه وست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 476.06,
   "end": 479.48,
   "text": "و حق داره تجلی می‌کنه در او این حالت سوختن ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.48,
   "end": 482.78,
   "text": "اصلاً حضور همراه سوختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 482.78,
   "end": 487.06,
   "text": "یاد کم و کاستی‌ها، بیچارگی‌هاش این‌ها می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 487.06,
   "end": 491.24,
   "text": "یاد ضعف در عبادتش، نقصان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 491.24,
   "end": 494.98,
   "text": "به هر حال مسیر بندگی‌ش و اون گرفتاری‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 494.98,
   "end": 501.28,
   "text": "در مسیر ب-بندگی و باطنی که بل الإنسان على نفسه بصيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 501.28,
   "end": 504.64,
   "text": "هر کسی آگاه‌تره به درون و بی-- باطن خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 504.64,
   "end": 507.18,
   "text": "هیچکس نمی‌تونه ما رو تحلیل کنه، تجزیه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.18,
   "end": 512.68,
   "text": "هیچکس جز خودمون که ما چه کردیم و چه هستیم و به چه سمتی می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 512.68,
   "end": 515.9,
   "text": "خودمون از همه بهتر و صد آیه قرآن می‌تونیم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 515.9,
   "end": 518.74,
   "text": "چی‌کاره‌ایم. حالا برگردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 518.74,
   "end": 521.04,
   "text": "در محضر ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.04,
   "end": 524.68,
   "text": "روز اول ماه محرم الحرام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.68,
   "end": 526.92,
   "text": "سوختن در خیمه ابا عبدالله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 526.92,
   "end": 529.44,
   "text": "هرکی بیشتر بسوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.44,
   "end": 531.98,
   "text": "مقرب‌تره، نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.98,
   "end": 538.32,
   "text": "چون شما نمازم که می‌خونید اگر معنای نماز، معنای اصیل نماز یعنی سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.32,
   "end": 541.76,
   "text": "خب شما میگی اِ-- نماز می‌خوانم که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 541.76,
   "end": 544.8,
   "text": "قربتاً الی‌الله قرب بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 544.8,
   "end": 547.74,
   "text": "پس اصلاً سوختن قرب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.74,
   "end": 550.28,
   "text": "هرکی بیشتر بسوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.28,
   "end": 553.88,
   "text": "بیشتر نزدیک می‌شه. و چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 553.88,
   "end": 560.1,
   "text": "یاران ابا عبدالله رو شما بررسی کنید می‌بینید اون‌هایی که بیشتر از همه سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.1,
   "end": 563.72,
   "text": "قرب بیشتری به ابا عبدالله داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.72,
   "end": 568.84,
   "text": "هرچی که سوختن بیشتر، قرب بیشتری پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 568.84,
   "end": 571.86,
   "text": "یکی از کسانی که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.86,
   "end": 576.24,
   "text": "سوخت در مسیر حسین سوخت و شهید شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 576.24,
   "end": 577.88,
   "text": "حضرت مسلم بن عقیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.88,
   "end": 580.94,
   "text": "قربونش بریم. باب الخوائج الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.94,
   "end": 584.26,
   "text": "أوفق بنی هاشم عند الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 584.26,
   "end": 588.64,
   "text": "به فرمایش خود ابا عبدالله در نامه‌ای که نوشتند او رو أوفق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 588.64,
   "end": 592.28,
   "text": "معرفی کردن. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 592.28,
   "end": 596.32,
   "text": "مورد وثوق‌ترین شخص در بنی‌هاشم نزد امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.32,
   "end": 599.5,
   "text": "خیلی حرف بالاست. لذا می‌شه نایب خاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.5,
   "end": 604.18,
   "text": "خب این عزیز بزرگوار همه وجودشو فدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 604.18,
   "end": 614.02,
   "text": "برای ابا عبدالله و وقتی اون بی‌معرفتی و بی‌وفایی مردم کوفه رو که دید و دید، دید، چش-چشید یعنی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 614.02,
   "end": 617.32,
   "text": "نه که خبر بگیره نه، دید و چشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 617.32,
   "end": 620.42,
   "text": "تازه سوختن مسلم شروع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 620.42,
   "end": 623.9,
   "text": "که کاری هم دیگه نمی‌تونست بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 623.9,
   "end": 628.66,
   "text": "که طوعه، اون طوعه خانم با معرفت وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 628.66,
   "end": 632.4,
   "text": "دید مسلم خیلی تو خودشه، خیلی دگرگونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 632.4,
   "end": 637.48,
   "text": "هی با دست رو زانوش می‌زنه، هی آه می‌کشه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 637.48,
   "end": 639.24,
   "text": "گریه می‌کنه. چی شده؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 639.24,
   "end": 644.36,
   "text": "چطونه شما این‌ها؟ مسلم میگه من نامه نوشتم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 644.36,
   "end": 647.5,
   "text": "سید و سالارم، پسر فاطمه زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 647.5,
   "end": 654.12,
   "text": "به یه امیدی آقا داره میاد تو این شهر و بعد الان می‌بینم که این‌ها چگونه بر علیه او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 654.12,
   "end": 657.2,
   "text": "چه کنم به زبان خودمونی بشکنه این دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 657.2,
   "end": 659.48,
   "text": "چه کردم، چه نامه‌ای برای حسین نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 659.48,
   "end": 662.54,
   "text": "لذا تا لحظه آخرش می‌سوخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 662.54,
   "end": 666.62,
   "text": "تا اون لحظه‌ای که بردنش بالای دارالاماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.62,
   "end": 670.54,
   "text": "مسلم می‌سوخت. یک پارچه آتش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 670.54,
   "end": 674.02,
   "text": "که حسین جان کاش یه طوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 674.02,
   "end": 676.32,
   "text": "صدای من بهت می‌رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.32,
   "end": 681.6,
   "text": "من نامه‌بر تو بودم، سفیر تو بودم، دعوتت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 681.6,
   "end": 685.22,
   "text": "ای کاش صدای من به تو می‌رسید که کوفه نیای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 685.22,
   "end": 690.98,
   "text": "و اگر کوفه میای بدون زینب بیای، بدون رقیه بیای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 690.98,
   "end": 694.5,
   "text": "این‌ها خیلی بی‌معرفتن، خیلی بی‌حیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 694.5,
   "end": 698.92,
   "text": "اما چه کنیم؟ صدای مسلم به گوش کی می‌رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 698.92,
   "end": 706.54,
   "text": "عجیبه، یه رعبی با مسلم ایجاد کردن که مثلاً بخوان یه زهره‌چشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 706.54,
   "end": 709.02,
   "text": "مداح‌ها، خوندن‌ها این‌ها خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 709.02,
   "end": 712.74,
   "text": "کتاب‌های بسیار اصیل و عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 712.74,
   "end": 717.96,
   "text": "در خصوص روضه مثل مثلاً الارشاد شیخ مفید رو بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 717.96,
   "end": 720.74,
   "text": "کتاب بسیار گران سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 720.74,
   "end": 724.64,
   "text": "الارشاد شیخ مفید در معرفت امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 724.64,
   "end": 727.72,
   "text": "دو جلده. یه جلدش مختص به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 727.72,
   "end": 730.1,
   "text": "آقا ابا عبدالله بخشیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 730.1,
   "end": 733.62,
   "text": "این‌ها. بسیار از بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 733.62,
   "end": 735.8,
   "text": "نظرشون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 735.8,
   "end": 740.3,
   "text": "یه زهر چشی اون ملعون تو کوفه گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 740.3,
   "end": 745.18,
   "text": "از محبین امام حسین زهره چشم رو من در قالب روضه مسلم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 745.18,
   "end": 748.06,
   "text": "که تنم به لرزه میفته هر وقت میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 748.06,
   "end": 751.5,
   "text": "که تو عرفه وقتی گفتم بچه ها گفتن واقعا حاجی اینطوری بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 751.5,
   "end": 759.36,
   "text": "گفتم بله ما باور نمی‌کردیم تا مثلا داعشی‌ها رو دیدیم باور کردیم که میشه انقدر آدم قسی القلب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 759.36,
   "end": 762.58,
   "text": "من خودم دیدم بچه‌های مدافع حرم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 762.58,
   "end": 766.34,
   "text": "خب دو سال کار محرمانه در داعش کرده بودیم و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 766.34,
   "end": 773.66,
   "text": "فیلم‌هایی دیدیم که هیچکس ندید و مثلا بچه‌های مدافع حرم رو توی سلاخ خونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 773.66,
   "end": 781.4,
   "text": "ذبح می‌کردن مثلا قربانی می‌کردن، گوسفندا رو سلاخی می‌کردن، اینا رو به این چنگک‌های قصابی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 781.4,
   "end": 785.14,
   "text": "از پا بچه‌های ما رو آویزون کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 785.14,
   "end": 787.92,
   "text": "اونطوری بعد خون جمع می‌شد تو سرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 787.92,
   "end": 792.06,
   "text": "یه دفعه رگ گردن رو می‌زدن، خون می‌پاشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 792.06,
   "end": 799.34,
   "text": "چه کردن اینا؟ یه همچین بلایی سر مسلم آوردن برای اینکه زهر چشم بکشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 799.34,
   "end": 803.82,
   "text": "بگیرن از محبین حسین که آخر عاقبت محبین حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 803.82,
   "end": 813.64,
   "text": "چطوره آقا رو وقتی از دار و وار پرت کردن پایین سر از بدن جدا کردن بدن مسلم رو به یه روایت آوردن به این چنگک‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 813.64,
   "end": 817.24,
   "text": "قصابی آویزون کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 817.24,
   "end": 820.68,
   "text": "که همه ببینن عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 820.68,
   "end": 822.76,
   "text": "دم زدن از حسین چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 822.76,
   "end": 825.32,
   "text": "به همین هم اکتفا نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 825.32,
   "end": 828.9,
   "text": "بدن آقا رو بستن به پشت یه اسبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 828.9,
   "end": 835.38,
   "text": "تو کوچه‌های کوفه می‌کشوندن رو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 835.38,
   "end": 839.2,
   "text": "یه نفر نبود اونجا فریاد بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 839.2,
   "end": 843.18,
   "text": "دم از مظلومیت مسلم و حسین بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 843.18,
   "end": 845.38,
   "text": "خدا رو شکر رفقا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 845.38,
   "end": 850.44,
   "text": "نمردیم و پای ما به سفره محرم و حسین رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 850.44,
   "end": 854.48,
   "text": "دوباره لباس‌های احرام مشکیمون رو به تن کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 854.48,
   "end": 856.94,
   "text": "آقای لطفی همکار ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 856.94,
   "end": 859.14,
   "text": "به محرم نرسید روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 859.14,
   "end": 862.14,
   "text": "می‌شد ما هم الان زیر خاک باشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 862.14,
   "end": 864.96,
   "text": "محرم حسین رو درک نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 864.96,
   "end": 870.6,
   "text": "خدا رو شکر الهی که عاشورای حسین رو هم ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 870.6,
   "end": 877.74,
   "text": "و بین عزاداری و گریه و اشک و آه جون بدیم برای حسین که ما جز حسین کسی رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 877.74,
   "end": 881.8,
   "text": "سلامی تقدیم کنیم عزیز دلم براتون ادامه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 881.8,
   "end": 886.28,
   "text": "السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 886.28,
   "end": 892.8,
   "text": "یا أبا عبد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 892.8,
   "end": 897.3,
   "text": "و علی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 897.3,
   "end": 901.12,
   "text": "حلت بفنائک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 901.12,
   "end": 908.98,
   "text": "علیک منی سلام الله ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 908.98,
   "end": 914.74,
   "text": "حسین جان خدا ما را از شما جدا نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 914.74,
   "end": 918.7,
   "text": "ایشالله این آخرین محرم عمر ما نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 918.7,
   "end": 921.72,
   "text": "همیشه پا رکابت باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 921.72,
   "end": 924.38,
   "text": "ولا جعل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 924.38,
   "end": 929.72,
   "text": "اخر العهد منی لزيارتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 929.72,
   "end": 933.36,
   "text": "السلام على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 933.36,
   "end": 937.9,
   "text": "الحسين- همه بگن بکنن. وعلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}