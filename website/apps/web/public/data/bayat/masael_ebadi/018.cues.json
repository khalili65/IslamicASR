 "chapters": [
  {
   "index": 0,
   "title": "## کلاس عزت‌بخشی خدا پس از شهادت خدمت",
   "start": 16.88,
   "end": 47.58
  },
  {
   "index": 1,
   "title": "## هوشمندی رهبری؛ کارآمدی و کفایت",
   "start": 47.58,
   "end": 96.0
  },
  {
   "index": 2,
   "title": "## قلوب بنی‌آدم بین اصبعین",
   "start": 96.0,
   "end": 116.18
  },
  {
   "index": 3,
   "title": "## دعای صرف القلوب و عزت در اطاعت",
   "start": 116.18,
   "end": 705.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.48,
   "end": 8.64,
   "text": "السلام علیک یا دعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 15.34,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.34,
   "end": 18.96,
   "text": "قطعاً همه ما این چند روز مات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.96,
   "end": 24.22,
   "text": "مبهوت عزت و آبرویی بودیم که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.22,
   "end": 28.6,
   "text": "به شهدای خدمت مخصوصاً آقای رئیسی داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.6,
   "end": 35.58,
   "text": "می‌خوام یه آیه از قرآن رو تلاوت کنم خودم بهره ببرم و شما هم از نورانیت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.58,
   "end": 41.06,
   "text": "آیه بهره بگیرید. دقیقاً داره این کلاس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.06,
   "end": 47.28,
   "text": "عرفانی و معرفتی حضرت حق رو که به عینه این چند روز پیاده شد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.28,
   "end": 51.8,
   "text": "یعنی خدا کلاس‌داری کرد، معلم همه ما شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.8,
   "end": 56.12,
   "text": "و قدرتش رو، قدرت عزت بخشیش رو به ما نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.12,
   "end": 58.94,
   "text": "در این یه دونه آیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.94,
   "end": 62.18,
   "text": "ببینیمش. آیه شصت و سه سوره انفال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.18,
   "end": 65.14,
   "text": "خیلی شیرین، آیه عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.14,
   "end": 69.4,
   "text": "وألف بين قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.4,
   "end": 74.08,
   "text": "بین دل‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.08,
   "end": 76.0,
   "text": "تألیف ایجاد کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.0,
   "end": 79.32,
   "text": "ألف بين قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.32,
   "end": 82.9,
   "text": "من خدا بودم که ألف بين قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.9,
   "end": 85.72,
   "text": "بین دل‌های این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.72,
   "end": 89.6,
   "text": "تألیف و الفت و انس برقرار کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.6,
   "end": 92.26,
   "text": "حالا این تیکه‌ش خیلی جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.26,
   "end": 99.34,
   "text": "که به پیغمبر عزیز عالمم با صراحت اونم خدا در این آیه می‌فرماید: لو أنفقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.34,
   "end": 102.86,
   "text": "اگه می‌بخشیدی ما في الأرض جميعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.86,
   "end": 106.1,
   "text": "هرچی که رو زمینه تو می‌بخشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.1,
   "end": 110.78,
   "text": "که چی بشه؟ که بخوای مثلاً مردم رو اینطوری بینشون تألیف قلوب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.78,
   "end": 113.86,
   "text": "معمولاً الآن با بذل و بخشش تألیف قلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.86,
   "end": 120.14,
   "text": "تا حدی اتفاق میفته. شما مثلاً به یه کسی یه چیزی می‌بخشی بالاخره دلش به شما متمایل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.14,
   "end": 127.58,
   "text": "اینجا خدا می‌گه اگه همه ز-- آنچه که در زمینه می‌بخشیدی، اونم تویی پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.58,
   "end": 131.24,
   "text": "الله اکبر. ما ألفت بين قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.24,
   "end": 134.64,
   "text": "بین قلوب این‌ها، دل‌های این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.64,
   "end": 138.06,
   "text": "انس و الفتی برقرار نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.06,
   "end": 140.66,
   "text": "ولكن الله ألف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.66,
   "end": 146.44,
   "text": "بينها. بلکه الله که بین این‌ها الفت و انس برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.44,
   "end": 148.94,
   "text": "ولكن الله ألف بينها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.94,
   "end": 152.02,
   "text": "به به، به به. إنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.02,
   "end": 157.82,
   "text": "عزيز حكيم. اصلاً این دو تا اسم خدا پیاده می‌شه، این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.82,
   "end": 162.26,
   "text": "واقعاً همه داریم اقرار می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.26,
   "end": 170.0,
   "text": "اصلاً ااا به منصه ظهور، منصه یعنی اونجایی که عروس تخت و تاج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.0,
   "end": 174.92,
   "text": "تاجی که اون تختی که عروس خودنمایی می‌کنه برای داماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.92,
   "end": 180.7,
   "text": "در شب زفاف به اون می‌گن منصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.7,
   "end": 185.58,
   "text": "این آیه واقعاً این چند روز به منصه ظهور کشیده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.58,
   "end": 188.48,
   "text": "یعنی خدا تاج و تخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.48,
   "end": 192.54,
   "text": "عزت و سلطنتش رو به ما نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.54,
   "end": 194.5,
   "text": "که آقا همه چی عزت دست منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.5,
   "end": 198.34,
   "text": "من کان یرید العزة فإن العزة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.34,
   "end": 202.9,
   "text": "لله جميعا. اصلاً جای دیگه دنبال عزت نگرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.9,
   "end": 206.2,
   "text": "اونم کسی رو که همه دست به دست هم داده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.2,
   "end": 211.06,
   "text": "همه که می‌گم متأسفانه جریان انحراف دیگه، جنحا-- جریان تخریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.06,
   "end": 217.72,
   "text": "مخصوصاً که سال آخر ریاست جمهوری ایشون بود می‌خواستن شروع کنن دیگه تخریب‌ها رو شروع کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.72,
   "end": 219.74,
   "text": "و زنبزنه هاشون رو شروع کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.74,
   "end": 224.6,
   "text": "ناکارآمدی دولت و این‌ها رو bold کنن و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.6,
   "end": 227.5,
   "text": "و چه جالب که چقدر آقا هوشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.5,
   "end": 230.84,
   "text": "خدا حفظ کنه سایه این حکیم رو بر سر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.84,
   "end": 234.78,
   "text": "که اون چند تا خصلتی که در خصوص آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.78,
   "end": 241.4,
   "text": "رئیسی فرمودن دو تاش یکی با کفایت و یکی کارآمد بود مخصوصاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.4,
   "end": 244.74,
   "text": "چون جریان انحراف میاد چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.74,
   "end": 247.56,
   "text": "الآن این خط تحریف میان می‌گن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.56,
   "end": 252.04,
   "text": "خب اخلاص به جاش، مرد خدا بودن به جاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.04,
   "end": 254.24,
   "text": "همه اینا رو ما قبول داریم. خیلی هم خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.24,
   "end": 256.48,
   "text": "آقای رئیسی نمره‌ش بیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.48,
   "end": 258.5,
   "text": "اما کارآمدی چیز دیگر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.5,
   "end": 262.5,
   "text": "توجه کردید از این شیوه می‌خوان وارد شن-- خواستن یعنی وارد شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.5,
   "end": 264.7,
   "text": "آقا با این دو تا کلمه زد تو دهن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.7,
   "end": 267.46,
   "text": "خیلی هوشمنده آقا. واقعاً آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.46,
   "end": 270.7,
   "text": "هرچی میره جلوتر به هوشمندی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.7,
   "end": 273.16,
   "text": "پی می‌بره و ربطش با عالم قدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.16,
   "end": 277.36,
   "text": "و الا نمی‌شه اصلاً جز با عنایات الهی نمی‌شه این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.36,
   "end": 279.94,
   "text": "ظرافت‌ها رو در نظر گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.94,
   "end": 286.24,
   "text": "کشور توی همچین بهتی فرو بره و بتونه به-- راحت کشور رو مدیریت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.24,
   "end": 290.72,
   "text": "در حالی که همه احساسین، او احساساتش رو نشون نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.72,
   "end": 293.12,
   "text": "مرد می‌خواد خداوکیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.12,
   "end": 297.92,
   "text": "و بتونه کشور-- هر کشور دیگه‌ای بود ا-اتفاقات عجیبی توش می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.92,
   "end": 301.86,
   "text": "مجلس تعطیل شده، مجلس خبرگان می‌خواد تشکیل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.86,
   "end": 304.58,
   "text": "دو نفر از اعضای اصلیش نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.58,
   "end": 308.58,
   "text": "بعد یه دفعه نفر دوم مملکت میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.58,
   "end": 312.32,
   "text": "با به-- یکی از چند تا از بهترین تیم‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.32,
   "end": 317.74,
   "text": "بعد ایشون به جای اینکه بیاد قصه رو احساسی کنه سریع دستور میده بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.74,
   "end": 320.72,
   "text": "انتخابات مجدد و بحث اجرایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.72,
   "end": 323.46,
   "text": "هیچ خللی تو سیستم اجرایی کشور نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.46,
   "end": 325.72,
   "text": "اینا هوشمندی آقاست، باید بهش توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.72,
   "end": 328.2,
   "text": "حالا بحث ما چیز دیگه‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.2,
   "end": 334.86,
   "text": "اون کارآمدی و کفایت ایشون رو اصلاً خدا برد که ثابت کنه چرا ایشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.86,
   "end": 338.24,
   "text": "تو دل‌های مردم الان سطح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.24,
   "end": 342.9,
   "text": "تراز یه رئیس جمهور کارآمد و با کفایت رفت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.9,
   "end": 346.82,
   "text": "یعنی رفت تا سطح ت-تراز انقلاب اسلامی قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.82,
   "end": 350.22,
   "text": "قبل از این اینطوری نبود. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.22,
   "end": 354.0,
   "text": "خروجی‌ها و برکات رفتن ایشون این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.0,
   "end": 356.44,
   "text": "یه روایتی هم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.44,
   "end": 361.04,
   "text": "این روایتو در کتاب معروف اعمال المرتضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.04,
   "end": 363.88,
   "text": "یا بعضیا میگن امالی آل مرتضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.88,
   "end": 368.28,
   "text": "غرر الفوائد و درر القلائد اسم اصلیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.28,
   "end": 370.64,
   "text": "جلد یک، صفحه سیصد و هجده می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.64,
   "end": 374.4,
   "text": "خیلی این روایت عالیه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.4,
   "end": 383.02,
   "text": "دقت بفرمایید. اینایی که دست و پا می‌زنن، پول خرج می‌کنن، زور می‌زنن تا معروف بشن، مشهور بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.02,
   "end": 387.98,
   "text": "مقبولیت پیدا کنن، تو چشم مردم عزیز شن، عزیز دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.98,
   "end": 399.26,
   "text": "انقدر تقلا نکن. بفرمایید این روایت، اون آیه ش، اینم روایت \"إن قلوب بني آدم كلها بين إصبعين من أصابع الرحمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.26,
   "end": 403.5,
   "text": "تمام دل‌ها بین دو تا انگشت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.5,
   "end": 408.66,
   "text": "\"من أصابع الرحمن\". همه دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.66,
   "end": 411.98,
   "text": "اینجا منفك نکرده بگه دل اهل ایمان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.98,
   "end": 416.02,
   "text": "مثلا فقط اهل ایمان. همه دل‌ها حتی کفار و مشرکین و منافقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.02,
   "end": 419.0,
   "text": "آقای رئیسی مخالف‌هایی هم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.0,
   "end": 423.86,
   "text": "اما چه اتفاقی می‌افته که مخالفاش هم تعظیم می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.86,
   "end": 426.78,
   "text": "یا حتی اون پیجی که خودش اقرار کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.78,
   "end": 431.46,
   "text": "و دیدیم همش دائم بر علیه آقای رئیسی و تیمش مطلب می‌ذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.46,
   "end": 434.3,
   "text": "و حتی مسائل خلاف شرع هم می‌ذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.3,
   "end": 437.8,
   "text": "بعد چه اتفاقی افتاد که توبه کرد اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.8,
   "end": 442.64,
   "text": "توبه نامه‌اش هم تو پیجش اعلام کرد، گفت من دیگه متنبه شدم واقعاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.64,
   "end": 444.94,
   "text": "پشیمونم، توبه می‌کنم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.94,
   "end": 450.82,
   "text": "یا اون کسی که اومده میگه من اومدم گریه می‌کنم، اومدم ازش حلالیت بطلبم که چرا بهش رأی ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.82,
   "end": 453.92,
   "text": "خب دیگه که گناه نکردی که بهش رأی ندادی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.92,
   "end": 458.14,
   "text": "اینا آیا به‌جز اینه که کار دست کس دیگه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.14,
   "end": 461.12,
   "text": "اینا، این روایتشه دیگه. این کلاس توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.12,
   "end": 464.96,
   "text": "یعنی یه کلاس توحیدی خدا برای همه ما گذاشت، معلمش هم او بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.96,
   "end": 469.54,
   "text": "\"وعلم آدم الأسماء كلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.54,
   "end": 472.08,
   "text": "به حضرت آدم همه رو یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.08,
   "end": 477.08,
   "text": "به ما هم یه جلوه ای، یه رشه‌ای از اسم العزيزش رو تعلیم کرد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.08,
   "end": 486.44,
   "text": "معلم خدا بود. خب \"إن قلوب بني آدم كلها بين إصبع، إصبعين من أصابع الرحمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.44,
   "end": 490.42,
   "text": "چه می‌کنه خدا؟ \"يصرفها كيف يشاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.42,
   "end": 492.72,
   "text": "می‌گردونه، تصریف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.72,
   "end": 496.94,
   "text": "اصلاً خدا خودش رو تو قرآن صراف معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.94,
   "end": 500.54,
   "text": "می‌فرماید کذا والکذا \"نصرف الآيات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.54,
   "end": 503.48,
   "text": "نصرف. ماییم که تصریف می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.48,
   "end": 505.62,
   "text": "صرافی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.62,
   "end": 512.72,
   "text": "برگردوندن پول. یه واحد پول یه کشور رو میدی، واحد پول دیگه رو برمی‌گردونه معادلش به تو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.72,
   "end": 517.0,
   "text": "تصریف، صراف اینه. خدا خودش رو در قرآن صراف معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 517.0,
   "end": 519.96,
   "text": "البته صراف دل‌ها. تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 519.96,
   "end": 523.02,
   "text": "روایت هم می‌فرماید \"يصرفها كيف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.02,
   "end": 527.7,
   "text": "كيف يشاء\". هر طرف که دوست داره دل‌ها رو می‌گردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.7,
   "end": 533.46,
   "text": "کار، کار خداست. بعد وقتی به اینجا می‌رسه راوی میگه پیغمبر دست به دعا برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.46,
   "end": 535.48,
   "text": "این دعای زیبا و قشنگ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.48,
   "end": 538.72,
   "text": "عرضه داشت که \"اللهم صرف القلوب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.72,
   "end": 540.72,
   "text": "به به! چه دعای قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.72,
   "end": 544.3,
   "text": "ای کسی که دل‌ها رو می‌چرخونی، می‌گردونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.3,
   "end": 548.82,
   "text": "عوض می‌کنی. \"صرف قلوبنا على طاعتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.82,
   "end": 554.54,
   "text": "دل ما رو بچرخون، بگردون به سمت طاعت تو چون عزت در اطاعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.54,
   "end": 557.9,
   "text": "اگر آقای رئیسی عزت پیدا می‌کنه به جهت اطاعتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.9,
   "end": 560.78,
   "text": "حالا بعضیا چه خوش ذوقی‌هایی هم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.78,
   "end": 563.98,
   "text": "خیلی شیرین زیاد دیدیم. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.98,
   "end": 569.4,
   "text": "من برای اطمینان خودم امروز مصایب، محاسبه کردم دیدم درسته عدد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.4,
   "end": 573.86,
   "text": "عدد ابجد سید ابراهیم می‌شه سیصد و سی و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.86,
   "end": 577.4,
   "text": "دیدم یکی خوش ذوقی کرده بود برای اینکه مطمئن شم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.4,
   "end": 583.52,
   "text": "محاسبه کردم دیدم درسته. سید ابراهیم عدد ابجدش می‌شد سیصد و سی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.52,
   "end": 587.58,
   "text": "سه. بعد سه سه سه تدفینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.58,
   "end": 594.18,
   "text": "بعد سه سال قوه قضائیه، سه سال آستان قدس، سه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.18,
   "end": 601.08,
   "text": "قوه مجریه. سی و سه ماه هم مسئولیت تو قوه مجریه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.08,
   "end": 604.78,
   "text": "بعد تاریخ تولدش رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.78,
   "end": 614.44,
   "text": "که اعلام کردن دفتر آثار که بیست و شش نه 1339 بوده جمع بند، جمع‌بندی می‌شه سی و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 614.44,
   "end": 619.26,
   "text": "حالا یه عزیزی خوش ذوقی کرده بود که تو هرجا رفتی سه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 619.26,
   "end": 623.76,
   "text": "دوام آوردی، سه سال تموم شد رفتی یه مسئولیت جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 623.76,
   "end": 630.32,
   "text": "انشاالله سه سال بیشتر اون ور طاقت نیاری برگردی در ظهور آقا رجعت آقا پیش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.32,
   "end": 634.5,
   "text": "که حضرت آیت الله نکته آخرم یه مژده‌ای باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 634.5,
   "end": 639.68,
   "text": "من اولین بار بود از این استاد اخلاق شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.68,
   "end": 646.28,
   "text": "دیروز بود فکر کنم. ایشون صحبت کرده، من آخر شب صحبت ایشون رو دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 646.28,
   "end": 649.56,
   "text": "که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 649.56,
   "end": 652.12,
   "text": "آیت الله توکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 652.12,
   "end": 657.86,
   "text": "ما بعضی موقع‌ها جوون که بودیم از محضرشون قم که بودیم فیض می‌بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 657.86,
   "end": 661.3,
   "text": "حالا یک انسان خاصیه آیت الله توکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.3,
   "end": 664.16,
   "text": "آدمیه که حساب شده حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 664.16,
   "end": 666.98,
   "text": "نمی‌دونم صحبت‌های ایشون رو شنیدید، عجیب بود صحبت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 666.98,
   "end": 670.04,
   "text": "خیلی امیدوار کننده بود. در جمع کران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 670.04,
   "end": 676.4,
   "text": "فرمودن که بله حدیث داریم هرکس برای ظهور وقت تعیین کنه کذابه، کذابه، کذابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.4,
   "end": 678.08,
   "text": "من میگم ان شا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 678.08,
   "end": 680.5,
   "text": "سه بار میگه ان شا الله. بعد میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.5,
   "end": 684.58,
   "text": "ان شا الله ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.58,
   "end": 686.36,
   "text": "ظهور رو درک خواهیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 686.36,
   "end": 690.6,
   "text": "باز میگه ان شا الله. حالا این استاد اخلاق بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 690.6,
   "end": 693.98,
   "text": "به اون، چه مرحله‌ای چی دیده که اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 693.98,
   "end": 695.68,
   "text": "خیلی امیدوار باشیم. خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 695.68,
   "end": 697.9,
   "text": "بی‌خود نیست آقا مثل کوه وایساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 697.9,
   "end": 701.78,
   "text": "انشاالله عاقبت همه‌مون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 701.78,
   "end": 705.76,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}