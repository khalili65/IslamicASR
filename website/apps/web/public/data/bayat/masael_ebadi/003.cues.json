   "start": 61.86,
   "end": 82.06
  },
  {
   "index": 2,
   "title": "## نفس همزاد؛ حمله در صراط مستقیم",
   "start": 82.06,
   "end": 219.62
  },
  {
   "index": 3,
   "title": "## روایت امام عسکری و لایه‌های ریا و سمعه",
   "start": 219.62,
   "end": 386.32
  },
  {
   "index": 4,
   "title": "کار با یک نماز و یک توسل و یک زیارت تمام نمی‌شود؛ لایه به لایه در وجود ماست. حضرت موسی کلیم‌الله در میقات:",
   "start": 386.32,
   "end": 472.78
  },
  {
   "index": 5,
   "title": "## ملا محسن؛ غضب و شهوت بر جان عقل",
   "start": 472.78,
   "end": 569.34
  },
  {
   "index": 6,
   "title": "## شیخ عباس قمی و لحظهٔ کیف در اقتدا",
   "start": 569.34,
   "end": 608.46
  },
  {
   "index": 7,
   "title": "## دشمن بیرون؛ داعش و اسرائیل و غزه",
   "start": 608.46,
   "end": 844.34
  },
  {
   "index": 8,
   "title": "## مرتضی تهرانی؛ نعمت شناخت دشمن در رهبر",
   "start": 844.34,
   "end": 951.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.14,
   "end": 7.32,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.32,
   "end": 12.7,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.7,
   "end": 18.08,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.08,
   "end": 21.78,
   "text": "در نماز جماعت انتظارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.78,
   "end": 25.7,
   "text": "فضیلت داره. یعنی اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.7,
   "end": 33.82,
   "text": "نماز اول وقت رو مردده که الان بخونه یا اینکه مثلا قراره با تأخیر نماز جماعت بخواد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.82,
   "end": 40.88,
   "text": "میدونه که نماز جماعتی قراره یک ساعت بعد، دو ساعت بعد با تأخیر انجام بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.88,
   "end": 46.32,
   "text": "فرمودن که بهتره صبر کنه با جماعت بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.32,
   "end": 49.56,
   "text": "و ثوابش بیشتره اگرچه اول وقت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.56,
   "end": 54.16,
   "text": "یعنی نماز جماعتی که اول وقت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.16,
   "end": 59.8,
   "text": "ثوابش بیشتر است از نماز فرادای اول وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.8,
   "end": 64.44,
   "text": "امروز هم نکته مهمی رو پیرامون مسائل جاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.44,
   "end": 67.68,
   "text": "حالا چه در کشورمون، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.68,
   "end": 71.38,
   "text": "مرکز خودمون به فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.38,
   "end": 79.22,
   "text": "عزیزان پیرامون مسائل عبادی، اجتماعی، سیاسی عرض کنیم، اونم موضوع دشمن شناسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.22,
   "end": 86.82,
   "text": "ما در خصوص شناخت دشمن خیلی ضعیف هستیم متأسفانه و ضعیف عمل کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.82,
   "end": 90.4,
   "text": "برای همین هم دائما در مسیر زمین می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 90.4,
   "end": 94.98,
   "text": "این دشمن گاهی اوقات انسان گمان می‌کنه که صرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.98,
   "end": 97.34,
   "text": "دشمن جنی و انسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.34,
   "end": 106.36,
   "text": "یعنی از بیرون مثلا ابالسه و شیاطین از بیرون، از اجنه یا مثلا دشمنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.36,
   "end": 110.24,
   "text": "انسی، انسان‌هایی که به ما خدعه می‌کنند و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 110.24,
   "end": 113.2,
   "text": "در صورتی که اصل دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 113.2,
   "end": 116.52,
   "text": "خود ماییم. خود من با خودم دشمنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.52,
   "end": 120.94,
   "text": "ما وجودمون دو نیمه، نیمی عقله، نیمی نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.94,
   "end": 124.92,
   "text": "اون اعدا عدوک که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.92,
   "end": 127.9,
   "text": "نفس، نفس اون nefsi‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.9,
   "end": 130.3,
   "text": "التي بين جنبک بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.3,
   "end": 133.54,
   "text": "دو پهلوی توئه، اون نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.54,
   "end": 135.9,
   "text": "این نفس بدترین دشمن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.9,
   "end": 138.08,
   "text": "اعدی عدو ماست، شیطان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.08,
   "end": 142.38,
   "text": "اون همزاد که میگن هرکی به دنیا میاد یه همزاد شیطان داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.38,
   "end": 145.1,
   "text": "یه وجهش همین نفس باطن خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.1,
   "end": 148.7,
   "text": "ماه مبارک رمضان میگن دست بال شیطان بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.7,
   "end": 154.44,
   "text": "چرا باز من گناه می‌کنم؟ شیطان در درون خودمه دیگه از خودم غافل شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.44,
   "end": 158.8,
   "text": "حالا یه شیطان در درون خودمه که نیمی از وجود منه، همیشه هم با منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.8,
   "end": 163.06,
   "text": "هیچ‌وقت هم دست از سر من برنمی‌داره و اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.06,
   "end": 167.84,
   "text": "هرچه که من به خدا نزدیک‌تر بشم او بیشتر به من حمله ور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.84,
   "end": 170.28,
   "text": "لاقد ان لهم صراط کل مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.28,
   "end": 175.04,
   "text": "این وعده‌ایست که به خدا داده اون ملعونه الی الابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.04,
   "end": 179.42,
   "text": "گفته که من قطعاً به اینا کمین می‌زنم، زمینشون می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.42,
   "end": 182.24,
   "text": "کی؟ صراط کل مستقیم وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.24,
   "end": 184.5,
   "text": "تو صراط مستقیم تو هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.5,
   "end": 188.62,
   "text": "یعنی ما وقتی میایم هیئت، میایم مسجد، میریم حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.62,
   "end": 193.7,
   "text": "با خدا خلوت می‌کنیم اتفاقاً بیشتر شیطان به سمت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.7,
   "end": 201.8,
   "text": "حمله ور می‌شه با تمام قوا و هرچی قدرت معنوی و برد اجتماعی ما بیشتره، بیشتر به ما حمله ور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.8,
   "end": 204.44,
   "text": "ما فکر می‌کنیم شیطان در مسجد، هیئت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.44,
   "end": 210.5,
   "text": "حرم نیست. اونکه رفته بود از لابلای شبکه ضریح زن‌ها رو پاییده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.5,
   "end": 212.78,
   "text": "بعد اومده بود بدبخت به درد دل افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.78,
   "end": 216.02,
   "text": "این یعنی چی؟ یعنی بغل همون حرم شیطان کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.02,
   "end": 219.62,
   "text": "تو خودشه، تو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.62,
   "end": 227.96,
   "text": "انقدر قصه ظریفه، انقدر همون روایت تکان دهنده دیروز امام س-- امام عسکری سلام الله علیه رو فراموش نکنیم هیچ‌وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.96,
   "end": 232.08,
   "text": "که میگه به اون چهره نورانی و زهدش توجه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.08,
   "end": 235.4,
   "text": "برو تا آخر سر. آخرین مرحله این بود که حب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.4,
   "end": 238.1,
   "text": "ریاست در دلش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.1,
   "end": 242.06,
   "text": "خیلی اون روایت تکان دهندس و هرکی رسیدم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.06,
   "end": 246.44,
   "text": "مراقب خودمون باشیم. من الان دارم حرفای خیلی قشنگ می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.44,
   "end": 249.36,
   "text": "خب بفرما ببینم اولا خودت عمل می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.36,
   "end": 251.8,
   "text": "لم تقولون ما لا تفعلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.8,
   "end": 255.9,
   "text": "آیه صریح قرآنه. چرا میگید اون چیزی که عمل نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.9,
   "end": 260.3,
   "text": "كبر مقتاً عند الله. آقا پیش خدا چی خیلی سنگینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.3,
   "end": 264.54,
   "text": "الان سریع میگیم ظلم به مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.54,
   "end": 268.62,
   "text": "مظلوم. مثلا خیانت به یتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.62,
   "end": 271.24,
   "text": "خوردن مال یتیم. چه بله همه حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.24,
   "end": 275.74,
   "text": "اما اونجا كبر مقتاً عند الله خیلی سنگینه پیش خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.74,
   "end": 278.08,
   "text": "چی؟ ان تقولوا ما لا تفعلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.08,
   "end": 279.68,
   "text": "بگید اون چیزی که عمل نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.68,
   "end": 285.08,
   "text": "خب اولا الان من دارم حرفای خیلی خوب می‌زنم‌ها و حدیث آیه خیلی هم قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.08,
   "end": 288.12,
   "text": "در کسوت علم و منبر خیلی زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.12,
   "end": 290.8,
   "text": "خودت عمل می‌کنی یا نه؟ اگه عمل نمی‌کنی چرا میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.8,
   "end": 294.74,
   "text": "دو، از اینم بگذریم عمل می‌کنی، درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.74,
   "end": 299.56,
   "text": "آیا انگیزت چیه؟ از گفتن این حرفای قشنگ و خوب انگیزت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.56,
   "end": 302.42,
   "text": "برای دنیا میگی؟ برای خوشامد این و اون میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.42,
   "end": 305.52,
   "text": "به به، چه چه، عجب، چه حرفی، چه...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.52,
   "end": 308.4,
   "text": "اگه اینه که خب با بدبختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.4,
   "end": 312.12,
   "text": "ریائه دیگه، شرکه. حالا نه اصلا برای خلوص محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.12,
   "end": 317.76,
   "text": "اصلا صرفا به خاطر خدا گفتم هیچ چشم داشتی هم از خلق خدا نگو-- نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.76,
   "end": 320.76,
   "text": "بعدش چی؟ آیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.76,
   "end": 322.86,
   "text": "کرامتی که از تو رخ داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.86,
   "end": 326.54,
   "text": "آیا بعدا چی؟ دوست داری کسی بشنوه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.54,
   "end": 328.24,
   "text": "دوست داری کسی بدونه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.24,
   "end": 332.5,
   "text": "یه کار خیری کردی برای خدا خالصاً مخلصاً تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.5,
   "end": 335.76,
   "text": "آیا اگر بعدا نقل شد خوشت میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.76,
   "end": 338.08,
   "text": "کیف نفس بهت دست میده؟ اینم سمعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.08,
   "end": 340.8,
   "text": "اینم گناهه. اسمش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.8,
   "end": 345.82,
   "text": "اینجا ریائه، اونجا بعد از انجام و لو با اخلاص انجام شده بهش میگن سمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.82,
   "end": 349.8,
   "text": "کسی شنید به به، به به، بگید، بگید خوشش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.8,
   "end": 355.48,
   "text": "هرکس که هست امام علیه الرحمه نمی‌شه که آقای مشکینی اونطوری جلوش تعریفشو بکنه امام امت فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.48,
   "end": 357.76,
   "text": "بعد بگه من از آقای مشکینی یه گلگی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.76,
   "end": 359.86,
   "text": "ما به اندازه کافی با نفسمون درگیر هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.86,
   "end": 364.28,
   "text": "شما دیگه ما رو درگیر نکنید خب کار خیلی دشواره، خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.28,
   "end": 366.28,
   "text": "اینطوری نیست که ما فکر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.28,
   "end": 369.92,
   "text": "با یه نماز و یه توسل و یه زیارت کار تمام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.92,
   "end": 372.56,
   "text": "انقدر لایه به لایه تو وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.56,
   "end": 382.58,
   "text": "اون حضرت موسی کلیم الله در میقات \"و واعدنا موسی فلا فی الليلة واتممناها بعشر فتمم میقات ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.58,
   "end": 386.32,
   "text": "اربعین\". میقات پروردگارشه شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.32,
   "end": 390.96,
   "text": "میقات محل ملاقات ربشه رفته اونجا می‌بینه شیطان اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.96,
   "end": 394.72,
   "text": "بارها اینو من خدمت شما و خودم عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.72,
   "end": 399.72,
   "text": "که آقا آخه اینجام ملعون، اینجام دست از سر من برنمیداری تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.72,
   "end": 402.24,
   "text": "چی گفته باشه شیطان خوبه؟ گفت بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.24,
   "end": 407.96,
   "text": "من اونجا در مقام اند-- اندیت، مقام قرب الهی و اون بهشت برینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.96,
   "end": 412.24,
   "text": "مقام بهشت عنداللهی، اونجا جدت آدم رو اغوا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.24,
   "end": 414.98,
   "text": "اینجا تو دست از سر تو بکشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.98,
   "end": 422.42,
   "text": "اتفاقاً هرچی که وزن علمی، معنوی، اجتماعی مخصوصاً ها بیشتر می‌شه، شیطان بیشتر به ما حمله می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.42,
   "end": 427.78,
   "text": "اصلاً اتفاقاً شیطان دنبال ما ریشوها و ما نمازخون‌ها و هیئتی‌ها و انقلابی‌ها می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.78,
   "end": 433.1,
   "text": "اونوری‌ها رو کاری نداره که اونا خودشون دیگه اصلاً راه رو گم کردن رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.1,
   "end": 439.06,
   "text": "دنبال سر ما داره میدوئه. چه‌گونه‌ست که رهبر ما باید وقتی رهبر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.06,
   "end": 442.5,
   "text": "گریه کنه. بعد ما هزار یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.5,
   "end": 444.62,
   "text": "غلط بکنیم که بخوایم مسئولیت بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.62,
   "end": 447.54,
   "text": "بعد هم کیف کنیم که آقا رئیس شدیم، مدیر شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.54,
   "end": 449.94,
   "text": "هزار و یک حق، ناحق و ناحق کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.94,
   "end": 453.46,
   "text": "عین نفسه. از امیرالمؤمنین علیه الصلاة والسلام پرسیدن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.46,
   "end": 455.98,
   "text": "چی می‌شه که طلحه و زبیر جلو شما وایسادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.98,
   "end": 460.94,
   "text": "چی شد؟ زبیر از زبیر رو \"منا اهل البيت\" فرمایش خود حضرت‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.94,
   "end": 463.22,
   "text": "شوخیه مگه؟ تا اونجا رفته جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.22,
   "end": 466.8,
   "text": "پیغمبر فرمود \"سیف الله\" به شمشیر زبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.8,
   "end": 471.88,
   "text": "شمشیر اسلام. من و شما چه فخری برای اسلام داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.88,
   "end": 475.86,
   "text": "فخری بالاتر از این که یکی شمشیرش بشه شمشیر اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.86,
   "end": 479.08,
   "text": "ولی چی شد جلو مولای زمانش ایستاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.08,
   "end": 481.86,
   "text": "البته این دو آخر توبه کردن به بیابون زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.86,
   "end": 486.5,
   "text": "اینا می‌دونید. امیرالمؤمنین علیه الصلاة والسلام مثلا با زبیر صحبت کرد، با طلحه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.5,
   "end": 490.96,
   "text": "ول کردن رفتن. ولی خب چه فایده جلو امامشون وایسادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.96,
   "end": 495.38,
   "text": "سؤال، يا امیرالمؤمنین چی شده که اینا، این‌ها جلو شما وایسادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.38,
   "end": 498.62,
   "text": "تو همین انقلاب خودمون چه آدمای ریشه‌داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.62,
   "end": 501.18,
   "text": "صفشون رو از انقلاب جدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.18,
   "end": 503.94,
   "text": "زیاد من و شما دیدیم. نباید بترسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.94,
   "end": 506.38,
   "text": "مولا فرمود به خاطر سه چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.38,
   "end": 509.36,
   "text": "ریشه‌ی سه چیز رو در خودشون نخشکوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.36,
   "end": 513.32,
   "text": "تکبر، حسد و حرص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.32,
   "end": 515.08,
   "text": "چیزی که در امثال من خیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.08,
   "end": 517.06,
   "text": "چقدر ما نگاه بالا به پایین داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.06,
   "end": 519.02,
   "text": "چقدر ما تکبرانه رفتار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.02,
   "end": 521.9,
   "text": "خدا نکنه مسئولیت چهار نفر رو بسپارن به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.9,
   "end": 528.38,
   "text": "دیگه خدا رو بنده نیستیم. رزق طرف هم فکر می‌کنیم از طرف ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.38,
   "end": 530.7,
   "text": "خیلی کار دشواره، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.7,
   "end": 534.36,
   "text": "سنگینه. حالا این تازه دشمنیه از درون که خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.36,
   "end": 538.48,
   "text": "و یه طرف نفسمون، وجودمون رو بشناسیم که ملا محسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.48,
   "end": 540.84,
   "text": "علیه الرحمه می‌فرمود یه غضب داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.84,
   "end": 543.36,
   "text": "یه شهوت داری، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.36,
   "end": 546.5,
   "text": "شیطان داری، یه عقل داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.5,
   "end": 549.24,
   "text": "شیطان میاد چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.24,
   "end": 553.02,
   "text": "غضب و شهوت رو می‌ندازه به جون عقلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.02,
   "end": 557.58,
   "text": "کار شیطان اینه. غضب و شهوت تو می‌ندازه به جون عقلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.58,
   "end": 561.78,
   "text": "اینا رو با هم درگیر می‌کنه. بعدم می‌شینه بر رو بر نگاه می‌کنه می‌خنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.78,
   "end": 569.24,
   "text": "اگر تا، تا ما دشمن شناسای خوبی نداشته باشیم، دشمن رو نس-- رصد نکنیم، مراقبت نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.24,
   "end": 571.0,
   "text": "آخه شیخ عباس قمی به به!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.0,
   "end": 573.58,
   "text": "حاج آقا صاحب کتاب مفاتیح الجنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.58,
   "end": 578.4,
   "text": "شیخ قمی محدث به هرکس نمی‌گفتن بیا حرم علی بن موسی الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.4,
   "end": 583.68,
   "text": "علیه الصلاة والسلام اون جماعت کثیر بهش اقتدا کنن، علما بهش اقتدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.68,
   "end": 586.88,
   "text": "بعد نماز دوم رو بره عقب بگه یکی دیگه وایسه جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.88,
   "end": 589.54,
   "text": "نماز عشا رو نخونه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.54,
   "end": 591.5,
   "text": "ازش پرسیدن تو در گوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.5,
   "end": 597.1,
   "text": "اونم نه داد بزنه. فرمود که من تو نماز اول وقتی که بهم اقتدا کردن و از خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.1,
   "end": 601.72,
   "text": "دور دارن الله اکبر میگن فهمیدم جماعت زیادی به من اقتدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.72,
   "end": 604.44,
   "text": "یه لحظه یک حالت کیفی به من دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.44,
   "end": 606.4,
   "text": "چقدر مراقب خودشون بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.4,
   "end": 608.46,
   "text": "اصلاً ما توجه به این چیزا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.46,
   "end": 611.42,
   "text": "این تازه دشمن درون، دشمن بیرون که الا ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.42,
   "end": 617.38,
   "text": "این همه دو-- شیطان این‌همه دور و بر ما رو احاطه کردن نفس به نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.38,
   "end": 620.0,
   "text": "از حیث جن و انسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.0,
   "end": 624.18,
   "text": "چقدر ما اع-- اعوذات داریم، احراز و این‌ها داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.18,
   "end": 629.32,
   "text": "ادعیه داریم که بیست جلسه تو شرح کتاب الموت ما پیراهون این‌ها حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 629.32,
   "end": 631.68,
   "text": "که اینا دفع بشن. طلسمات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.68,
   "end": 633.36,
   "text": "جادوها، این‌هایی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.36,
   "end": 636.48,
   "text": "حالا بالاخره باید مراقبت کرد یا نه بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 636.48,
   "end": 639.78,
   "text": "اینم یه بحثیه. یا اصلاً دشمن انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 639.78,
   "end": 642.8,
   "text": "چقدر ما الان چشم ندارن من و شما رو ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.8,
   "end": 645.54,
   "text": "تو همین کشور خودمون بگیم تا بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 645.54,
   "end": 649.9,
   "text": "الان آیا به نظر شما هدف اصلی آمریکا و اسرائیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 649.9,
   "end": 655.14,
   "text": "اینا ایران نیست؟ واقعاً خیال خام که اگه به کسی بگه بگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.14,
   "end": 660.16,
   "text": "آیا داعش من خودم چون دو سال کار محرمانه در داعش کردم، چیزایی دیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.16,
   "end": 664.76,
   "text": "ندید هیچکس. اصلاً من مریضی روحی دیگه داشتم می‌گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.76,
   "end": 670.78,
   "text": "قشنگ تا اون ریز و جزئ اهنامه‌شون نمی‌دونم مرام‌نامه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.78,
   "end": 673.92,
   "text": "همه اینا رو با اسم و جزئیات داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.92,
   "end": 677.1,
   "text": "قشنگ می‌دیدیم که با همدیگه گفت‌وگو می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.1,
   "end": 679.28,
   "text": "اصل کاری‌هاشون، تیم اصلیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.28,
   "end": 685.24,
   "text": "با عربی حرف می‌زدن. حرفشون این بود که نهایت ما قصدمون ایرانه، تجزیه ایرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.24,
   "end": 687.82,
   "text": "خب یه دشمن به این بزرگی کی در افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.82,
   "end": 693.06,
   "text": "آیا اگر قاسم سلیمانی نمی‌رفت بسیج مردمی رو ایجاد نمی‌کرد، حشد شعبی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.06,
   "end": 697.7,
   "text": "کی می‌تو-- با دیپلماسی و گفت‌وگو و این چیزا آقا مذاکره قابل حل بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.7,
   "end": 703.56,
   "text": "ذهی خیال باطل. یا الان قصه اسرائیل مثلا شما فکر می‌کنید آخرین هدفش ایران نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.56,
   "end": 710.72,
   "text": "همین سه تا سناتور ملعونی که اخیراً تو آمریکا گفت من بارها و بارها بیست ساله دارم میگم ایرانو بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 710.72,
   "end": 716.4,
   "text": "صراحتا گفت دیگه. میگم بزنید چاه‌های نفتش معلومه بزنید پایگاه‌های سپاهش معلومه بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.4,
   "end": 722.2,
   "text": "اصلاً قصدشون ماییم. الانم هی همشون هدفشون اینه که ایرانو بکشونن وسط گود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.2,
   "end": 726.02,
   "text": "با سیاست‌های مدبرانه رهبر این اتفاق نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 726.02,
   "end": 728.44,
   "text": "اصلاً از خداشونه ما بریم وسط گود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.44,
   "end": 733.92,
   "text": "چه بهتر که ما در جنگ باشیم اما جنگ نیابتی نوچه های ایران بجنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 733.92,
   "end": 739.32,
   "text": "قشنگ تره که تا ما خودمون مستقیم بریم وقتی تحلیل سیاسی نداشته باشیم اینطوری میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 739.32,
   "end": 741.38,
   "text": "یا اونا هم که اصلا از خداشونه این جنگ باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 741.38,
   "end": 745.62,
   "text": "اگرچه الان یه مقدار آمریکا عقب نشینی کرده، ترسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 745.62,
   "end": 748.82,
   "text": "خب الان مثلا این، صوتی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.82,
   "end": 752.0,
   "text": "ابو عُبیده پخش شد، سخنگوی حماس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 752.0,
   "end": 754.16,
   "text": "شا-شاخه عز الدین القسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 754.16,
   "end": 757.52,
   "text": "چند روز پیش، قریب به هشتصد و من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.52,
   "end": 761.56,
   "text": "حالا عددشو قشنگ حفظ کردم، هشتصد و بیست و پنج تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.56,
   "end": 764.76,
   "text": "گفت ما ماشین و خودروهای نظامی ازشون منفجر کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.76,
   "end": 769.04,
   "text": "دیروز اعلام کردن بین نهصد تا هزار تا تانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.04,
   "end": 770.94,
   "text": "نِرکاوا زدن. اینو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 770.94,
   "end": 774.16,
   "text": "کم نیست. یعنی با، با دست خالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 774.16,
   "end": 778.5,
   "text": "با دست خالی. کم آوردن اما به شدت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.5,
   "end": 781.28,
   "text": "میرن جلو. بایدن رو کسی خودش صهیونیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.28,
   "end": 785.46,
   "text": "میدونید دیگه. بایدن خود بارها اعلام کرده من صهیونیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 785.46,
   "end": 789.44,
   "text": "علنا گفته. دو تا سود هم میبرن این ملعونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.44,
   "end": 791.16,
   "text": "یکیش حالا تو مسائل خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.16,
   "end": 794.44,
   "text": "یکی اینکه الان انتخاباتشون نزدیکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 794.44,
   "end": 801.8,
   "text": "و دنبال اینن که بالاخره اسرائیل حمایتشون کنه، پول بهشون بده و تبلیغاتشون رو بکنه و چه پشتوانه‌شون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 801.8,
   "end": 805.3,
   "text": "از این طرف هم تسلیحاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 805.3,
   "end": 808.7,
   "text": "بلوکه کردن اینا تاریخ مصرف داره تسلیحات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 808.7,
   "end": 812.18,
   "text": "بمب‌ها، اینا تاریخ مصرف داره. اینا داره تاریخ مصرفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 812.18,
   "end": 817.12,
   "text": "از بین و خیلی اینا رو منهدم کردنش هزینه‌ش بیشتر از ساختشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 817.12,
   "end": 820.7,
   "text": "چیکار میکنن؟ اینا رو میندازن به سر مردم غزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 820.7,
   "end": 825.14,
   "text": "از این طرف هم سود میبرن. اما هدف اصلیشون من و شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.14,
   "end": 828.92,
   "text": "ولایت فقیه، ایران اسلامی‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 828.92,
   "end": 830.94,
   "text": "نباید ما چشمامونو باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 830.94,
   "end": 833.04,
   "text": "من حرف تو این زمینه زیاد دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 833.04,
   "end": 835.54,
   "text": "بسه. یه جمله‌ای تقدیمتون کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 835.54,
   "end": 838.16,
   "text": "حتما اینو شنیدید ولی متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 838.16,
   "end": 839.84,
   "text": "تو یه غباری قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 839.84,
   "end": 842.18,
   "text": "خیلی خبرگزاری‌ها بهش نپرداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 842.18,
   "end": 844.08,
   "text": "من خیلی به این توجه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 844.08,
   "end": 847.3,
   "text": "یک استادی ما داشتیم حضرت آقا مرتضی تهرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 847.3,
   "end": 851.5,
   "text": "مدتی از وجود پر برکتشون بهره می‌بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 851.5,
   "end": 854.1,
   "text": "می‌دونید ایشون شصت سال کتم بود، اصلا حرف نزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 854.1,
   "end": 856.56,
   "text": "همه می‌گفتن ایشون سیاسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 856.56,
   "end": 859.6,
   "text": "اصلا می‌رفتی پیشش پیش-- ولی خیلی حواسش جمع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 859.6,
   "end": 861.74,
   "text": "این آخر عمریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 861.74,
   "end": 864.98,
   "text": "یک هیبتی هم داشت. داداش آقا مجتبی رو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 864.98,
   "end": 869.0,
   "text": "یک هیبتی داشت. اصلا نگاش می‌کردی رنگت عوض می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 869.0,
   "end": 872.04,
   "text": "ایشون آخر عمر به سخن اومد، حرف زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 872.04,
   "end": 874.52,
   "text": "و عجیبه ایشون در خصوص رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 874.52,
   "end": 878.98,
   "text": "فر-- بعد از اینکه پرده از رفاقت شصت ساله‌شون با آقا برداشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 878.98,
   "end": 881.62,
   "text": "فرمودن که «من چند شب پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 881.62,
   "end": 887.36,
   "text": "آثار حرکت تهذیب نفس و شدت اخلاص رو در ایشان دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 887.36,
   "end": 890.08,
   "text": "که اگر از من بپرسید با چه چشمی دیدین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 890.08,
   "end": 896.68,
   "text": "با همین چشم؟ می‌گویم که نه، با همون، همون چشمی که خدا به من عطا کرده.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 896.68,
   "end": 899.48,
   "text": "آخر عمری به ز-- لسان، زبانش باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 899.48,
   "end": 903.38,
   "text": "خیلی کتم بود ایشون. بعد این جمله رو در خصوص آقا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 903.38,
   "end": 905.38,
   "text": "خدا به این بزرگ-- عین کلام ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 905.38,
   "end": 910.9,
   "text": "«خدا به این بزرگوار این نعمت شناخت دشمن را عطا کرده.» خدا عطا کرده این نعمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 910.9,
   "end": 916.16,
   "text": "«کسانی که خیال می‌کنند ایشان دارد تند می‌رود اشتباه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 916.16,
   "end": 923.98,
   "text": "خدا این شناخت را به ایشان عطا کرده و دارد جلوی پای خودش و جلوی پای ملت چاه‌ها و چاله‌ها را می‌بیند.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 923.98,
   "end": 927.72,
   "text": "بعدم از دنیا رفت. اینو یادگاری برای ما گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 927.72,
   "end": 933.64,
   "text": "اگر ما خودمون دشمن شناس نیستیم، دشمن شناس قوی‌ای نیستیم، پشت سر یه آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 933.64,
   "end": 937.88,
   "text": "راه بلد و دشمن شناس حرکت کنیم تا مصون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 937.88,
   "end": 941.92,
   "text": "این قصه سر دراز دارد. خیلی هم حرف باید روش زده بشه اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 941.92,
   "end": 944.9,
   "text": "همین مقدار بسنده می‌کنیم. ان شا الله عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 944.9,
   "end": 947.9,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 947.9,
   "end": 951.16,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}