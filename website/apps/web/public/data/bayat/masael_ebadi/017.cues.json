 "chapters": [
  {
   "index": 0,
   "title": "## تبریک دههٔ کرامت؛ ماه مهدوی که با جمعه آغاز شود",
   "start": 1.58,
   "end": 61.78
  },
  {
   "index": 1,
   "title": "## آیهٔ نور؛ دویست‌وپنجاه‌وشش؛ هدیه به امام عصر",
   "start": 61.78,
   "end": 122.84
  },
  {
   "index": 2,
   "title": "## چلهٔ کلیمیه؛ زیاد با خدا حرف زدن",
   "start": 122.84,
   "end": 426.26
  },
  {
   "index": 3,
   "title": "## ملاصدرا در کهک؛ حل مشکل علمی با زیارت حضرت معصومه",
   "start": 426.26,
   "end": 529.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.58,
   "end": 8.38,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.38,
   "end": 11.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.34,
   "end": 14.06,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.06,
   "end": 16.36,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.36,
   "end": 19.08,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.08,
   "end": 24.76,
   "text": "تبریک عرض می‌کنم دهه با عظمت کرامت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.76,
   "end": 28.76,
   "text": "چند تا نکته عرض کنم خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.76,
   "end": 34.3,
   "text": "یکی اینکه قبلاً هم عرض کردم به جهت تذکر و یادآوری میگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.3,
   "end": 37.36,
   "text": "ماه قمری که روز اولش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.36,
   "end": 44.0,
   "text": "جمعه باشه فرمودن ماهی‌ست که سرتاسر منور است به نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.0,
   "end": 48.66,
   "text": "حضرت ابا صالح المهدی سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.66,
   "end": 52.1,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.1,
   "end": 58.34,
   "text": "یعنی این ماهی که الان درش قرار گرفتیم چون با جمعه شروع شد، ماه مهدوی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.34,
   "end": 64.28,
   "text": "لذا فرمودن که خدا رحمت کنه علامه هم خیلی علاقه به آیه نور داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.28,
   "end": 66.38,
   "text": "آیه سی و پنج سوره نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.38,
   "end": 71.78,
   "text": "الله نور السماوات و الأرض مثل نوره کمشكاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.78,
   "end": 78.2,
   "text": "این آیه رو که ملا صدرا هم یه تفسیر، یه کتاب بر تفسیر این آیه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.2,
   "end": 82.78,
   "text": "فرمودن که به عدد نور که خود عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.78,
   "end": 86.24,
   "text": "امام زمان هم همونه دویست و پنجاه و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.24,
   "end": 92.38,
   "text": "اگه کسی بتونه هر روز دویست و پنجاه و شش بار این آیه رو بخونه نور على نور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.38,
   "end": 94.72,
   "text": "بخونه و برکاتش رو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.72,
   "end": 98.98,
   "text": "اگر نتونست هر مقدار که می‌تونه در این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.98,
   "end": 101.58,
   "text": "این آیه رو بخونه و هدیه کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.58,
   "end": 108.88,
   "text": "امام عصر. بعضیا فرمودن از بزرگان که هر شب قبل خواب اگه کسی بتونه چهارده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.88,
   "end": 113.56,
   "text": "قبل از خواب چهارده بار، یه ربع هم نمیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.56,
   "end": 116.02,
   "text": "این آیه را قرائت کنه هدیه کنه به امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.02,
   "end": 118.48,
   "text": "خیلی برکات داره، خیلی اثر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.48,
   "end": 122.84,
   "text": "توی این ماه، این ماهی که اولش با جمعه شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.84,
   "end": 125.7,
   "text": "نکته دوم که بعضی از عزیزانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.7,
   "end": 131.96,
   "text": "سؤال کردن که مثلاً چهل کلیمیه یا موسی که شروع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.96,
   "end": 136.82,
   "text": "از اول ماه ذی القعده تا دهم ذی الحجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.82,
   "end": 139.98,
   "text": "الان ماه ذی القعده‌ایم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.98,
   "end": 146.4,
   "text": "بهترین کار چیه؟ خب شما باید دقت بفرمایید به خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.4,
   "end": 149.12,
   "text": "آیه. اصلاً به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.12,
   "end": 152.76,
   "text": "موسی علیه السلام میگن کلیم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.76,
   "end": 156.98,
   "text": "خیلی با خدا حرف می‌زد. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.98,
   "end": 161.92,
   "text": "کلیم الله و این چهل هم منتسب به ایشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.92,
   "end": 169.26,
   "text": "خودش داره فریاد می‌زنه که آقا بهترین کار در این چهل روز اینه که شما زیاد با خدا حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.26,
   "end": 170.88,
   "text": "تا می‌تونید حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.88,
   "end": 173.82,
   "text": "ببینید حاجت خواستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.82,
   "end": 176.8,
   "text": "حرف زدن با خدا نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.8,
   "end": 179.36,
   "text": "حرف زدنه با خدا حرف بزن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.36,
   "end": 183.28,
   "text": "صحبت کن. هم-- فقط حاجت خواستن نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.28,
   "end": 187.6,
   "text": "گفت‌وگوئه. خیلی از ادعیه هست که خواندن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.6,
   "end": 189.46,
   "text": "توش درخواستی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.46,
   "end": 192.72,
   "text": "فقط خدا مثل مثلاً جوشن ببینید همش اسماء خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.72,
   "end": 196.1,
   "text": "خدا رو می‌خوانی. با خدا گفت‌وگو کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.1,
   "end": 200.04,
   "text": "اتفاقاً می‌دونید که حضرت موسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.04,
   "end": 202.66,
   "text": "روایت دیدم از مرحوم شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.66,
   "end": 206.96,
   "text": "ج-- شیخ حر عاملی در کتاب شریف جواهر الثنیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.96,
   "end": 213.0,
   "text": "فی احادیث قدسیه که خدا بهش فرمود موسی می‌دونی چرا تو رو اختیار کردم بر نبوت و این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.0,
   "end": 217.34,
   "text": "به جهت اینکه دیدم بعد از نمازت می‌شینی زیاد با من حرف می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.34,
   "end": 220.38,
   "text": "مثلاً بعضی‌ها زود فرار نمی‌کنی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.38,
   "end": 225.12,
   "text": "خیلی جالبه. مثلاً خدا دوست داره اینو بشینی باهاش حرف بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.12,
   "end": 232.76,
   "text": "تو اون آیه‌ای هم که دهه اول ذی الحجه می‌خونن و وعدنا موسی ثلاثین ليلة وأتممناها بعشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.76,
   "end": 235.72,
   "text": "وأتممناها بعشر چهل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.72,
   "end": 240.98,
   "text": "فتم میقات ربه أربعین ليلة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.98,
   "end": 243.08,
   "text": "وقال موسى لأخیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.08,
   "end": 245.74,
   "text": "هارون اخلفني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.74,
   "end": 251.48,
   "text": "فی قومي. خلافت رو می‌ده تو جانشین من باش بعد از من تو قومم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.48,
   "end": 254.62,
   "text": "توجه کردید؟ این جانشینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.62,
   "end": 258.54,
   "text": "برادرش در قومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.54,
   "end": 264.64,
   "text": "می‌خواد بگه چی؟ این جانشینی وقتی موسی رو به جهت زیاد صحبت کردن با خدا جانشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.64,
   "end": 271.28,
   "text": "شده خلیفه خدا، جانشین خودش هم قطعاً زیاد با خدا صحبت می‌کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.28,
   "end": 274.42,
   "text": "اخلفني فی قومي. که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.42,
   "end": 279.48,
   "text": "وأصلح ولاتتبع سبيل المفسدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.48,
   "end": 282.14,
   "text": "یعنی اصلاً صلاح و رستگاری مردم در اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.14,
   "end": 287.26,
   "text": "اون کسی که بیشتر از همه با خدا مرتبطه و با خدا حرف می‌زنه بشه خلیفه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.26,
   "end": 290.68,
   "text": "خلیفه خدا بشه جانشین خدا بین اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.68,
   "end": 293.36,
   "text": "پس بهترین کار توی این چله اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.36,
   "end": 297.32,
   "text": "حالا هر کی یه راهی رو پیدا کنه، هرچی باهاش معنوسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.32,
   "end": 301.7,
   "text": "یکی از بهترین صحبت‌های با خدا ذکر یونسیه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.7,
   "end": 305.46,
   "text": "لا اله الا انت سبحانک انی كنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.46,
   "end": 308.9,
   "text": "می‌تونی بعد از نمازها، سحرها اینا هر چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.9,
   "end": 311.5,
   "text": "صحبت با خدا توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.5,
   "end": 314.4,
   "text": "چهل. اینم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.4,
   "end": 319.36,
   "text": "و نکته بعدم خود حضرت معصومه سلام الله علیها هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.36,
   "end": 323.76,
   "text": "به هر حال این ماه با میلادشون شروع شد عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.76,
   "end": 329.24,
   "text": "خب باید تا می‌تونیم در خصوص عظمت ایشون حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.24,
   "end": 334.76,
   "text": "عظمت ایشون درست جا نیفتاده بین ما هنوز که هنوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.76,
   "end": 338.46,
   "text": "شما زیارت‌نامه ایشون رو که بررسی کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.46,
   "end": 341.14,
   "text": "عجیب زیارت‌نامه است. می‌دونستید که از بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.14,
   "end": 348.44,
   "text": "امامزادگان تنها امامزاده‌ای‌ست که زیارت‌نامه‌ش رو هم امامان معصوم تنظیم فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.44,
   "end": 352.82,
   "text": "و سه تا امام معصوم به این زیارت او رو خواندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.82,
   "end": 359.58,
   "text": "و تصریح کردن. امام صادق قبل از به دنیا اومدن حضرت معصومه مژده ایشون رو داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.58,
   "end": 363.46,
   "text": "اگر ایشون علمه شفاعت بردارن روایت داریم کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.46,
   "end": 366.2,
   "text": "صحنه محشر رو خالی می‌کنن از گناهکاران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.2,
   "end": 369.32,
   "text": "یعنی همه رو می‌تونی-- یه همچین آبرویی داره ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.32,
   "end": 374.16,
   "text": "شما ببینید برنامه ایشون رو وقتی سلام به انبیا میدی غائب سلام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.16,
   "end": 377.28,
   "text": "السلام علی ابراهیم، علی موسی، علی عیسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.28,
   "end": 380.74,
   "text": "ولی یه دفعه السلام علیک یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.74,
   "end": 385.32,
   "text": "السلام علیک یا امیرالمؤمنین. همینطوری اهل بیت رو مخاطب قرار میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.32,
   "end": 388.46,
   "text": "یعنی کعبه اینجا حرم همه اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.46,
   "end": 391.14,
   "text": "روایت هم داریم که حرم ما اهل بیت قمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.14,
   "end": 394.28,
   "text": "یعنی کعبه از زیارت برمی‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.28,
   "end": 397.96,
   "text": "کسی این خانم رو زیارت کنه کعبه همه اهل بیت رو زیارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.96,
   "end": 401.94,
   "text": "چه‌بُنَه‌ست که شما هر کدوم از اهل بیت رو صدا بزنید خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.94,
   "end": 403.68,
   "text": "میگه لبیک خودش جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.68,
   "end": 408.22,
   "text": "اما وقتی حضرت زهرا رو صدا بزنی همه به تو رو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.22,
   "end": 410.7,
   "text": "مرحوم مرعشی نجفی هم امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.7,
   "end": 417.2,
   "text": "عصر رو که زیارت کرد حضرت فرمود هر وقت دلتنگ مادر ما فاطمه شدی برو زیارت حضرت معصومه عمه‌ی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.2,
   "end": 420.96,
   "text": "این خب حضرت زهرا محل جمع اجتماع همشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.96,
   "end": 423.94,
   "text": "اونجا هم که پایگاه اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.94,
   "end": 426.26,
   "text": "مقام رو ببینید، جایگاه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.26,
   "end": 427.94,
   "text": "خدا رحمت کنه ملاصدرا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.94,
   "end": 431.26,
   "text": "این که عرض می‌کنم در انتهای ب-صحبتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.26,
   "end": 434.06,
   "text": "یادگار حضرت علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.06,
   "end": 441.22,
   "text": "ما که نمی‌دونستیم علامه در کتاب شریف شرح بر کتاب شریف اتحاد عاقل به معقول استادشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.22,
   "end": 444.12,
   "text": "حضرت آی-- علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.12,
   "end": 449.08,
   "text": "مرحوم علامه رفیعی قزوینی، استاد علامه حسن زاده، کتاب اتحاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.08,
   "end": 452.5,
   "text": "عاقل به معقول داره. علامه شرح داده این کتابو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.5,
   "end": 458.5,
   "text": "اونجا می‌فرماید ملاصدرا اینو خوب گوش بدید ملاصدرا ای که همه متحیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.5,
   "end": 463.7,
   "text": "قلم ایشونن. چه قلم پخته‌ای، چه دهانی که به قول علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.7,
   "end": 465.9,
   "text": "عقل این دهان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.9,
   "end": 469.26,
   "text": "و این چانه رو تکون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.26,
   "end": 472.72,
   "text": "ایشون فرمودن که هر وقت برای من مشکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.72,
   "end": 475.16,
   "text": "سنگین علمی پیش میومد، کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.16,
   "end": 477.74,
   "text": "ملاصدرا. کی داره میگه؟ علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.74,
   "end": 480.78,
   "text": "کجا؟ در شرح اتحاد عاقل به معقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.78,
   "end": 487.66,
   "text": "مشکل سنگین و پیچیده علمی برام پیش میومد از کهک قم چون ایشون تبعید بودن به کهک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.66,
   "end": 493.32,
   "text": "میومدم پیاده تا قم زیارت حضرت معصومه سلام الله علیها می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.32,
   "end": 497.14,
   "text": "مشکلم حل می‌شد. مشکل علمیم حل می‌شد، برمی‌گشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.14,
   "end": 503.6,
   "text": "چرا ما فقط وقت پاس شدن چک‌مون و شفای مریض‌مون به حضرت معصومه میریم توسل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.6,
   "end": 505.98,
   "text": "کی رفتیم ضریح خانم رو بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.98,
   "end": 514.28,
   "text": "و از ایشون التماس کنیم یه مشکل پیچیده علمی و معرفتی رو برای ما باز کنه ما بفهمیم حقایق عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.28,
   "end": 518.1,
   "text": "اونا گاهی اوقات می‌بینید بین ما زندانی شدن، بین ما غریبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.1,
   "end": 521.54,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.54,
   "end": 523.94,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.94,
   "end": 527.34,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.34,
   "end": 529.7,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}