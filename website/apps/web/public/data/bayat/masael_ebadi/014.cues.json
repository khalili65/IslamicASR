 "chapters": [
  {
   "index": 0,
   "title": "## حفظ حال نورانی پس از مهمانی خدا",
   "start": 5.48,
   "end": 196.6
  },
  {
   "index": 1,
   "title": "## هشدار نقطۀ جوش؛ تکرار بلای پس از سیلی سردار",
   "start": 196.6,
   "end": 506.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 5.48,
   "text": "ربانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.48,
   "end": 8.12,
   "text": "ضمن تبریک مجدد این ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.12,
   "end": 17.78,
   "text": "بسیار الحمد لله نورانی رو که همه از مهمانی خدا فارغ شدن و نفس مستعدشون پر از نور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.78,
   "end": 22.0,
   "text": "ان شاء الله سرور به جهت بندگی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.0,
   "end": 26.18,
   "text": "امیدوارم که این حالت رو با خودمون به قول رهبر عزیزمون حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.18,
   "end": 29.02,
   "text": "نکته‌ای رو عرض کنم که شنبه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.02,
   "end": 32.24,
   "text": "ما قرار شد پیرامون مسائل مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.24,
   "end": 35.8,
   "text": "حالا عبادی، اجتماعی و سیاسی صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.8,
   "end": 37.96,
   "text": "این یکی از مهم‌ترین موضوعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.96,
   "end": 43.98,
   "text": "که خیلی الان مطرحه، من اینو مخصوصا عرض می‌کنم که نکته‌ای رو در دلش بیان کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.98,
   "end": 50.54,
   "text": "خب می‌بینید الان هم خبرگزاری‌ها سرتاسر دنیا من زحمت نکشیدم، هم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.54,
   "end": 57.34,
   "text": "به هر حال فضاهای مجازی انواع و اقسام خبرها رو پیرامون این قصه انتقام میگن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.34,
   "end": 60.68,
   "text": "خب، اهmm می‌دونید که و می‌بینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.68,
   "end": 64.34,
   "text": "الان حدود بیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.34,
   "end": 66.88,
   "text": "آخرین آماری که دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.88,
   "end": 70.52,
   "text": "بیست و هشت سفارت‌خونه اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.52,
   "end": 74.2,
   "text": "تعطیل شده تو کشورهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.2,
   "end": 79.3,
   "text": "خود آمریکا، انگلیس و فرانسه دیپلمات‌هاشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.3,
   "end": 82.0,
   "text": "خارج کردن از خاک اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.0,
   "end": 88.26,
   "text": "به قول خودشون پناهگاه‌هاشون پر شده، مراکز حساسشون تعطیل شده، پناهگاه‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.26,
   "end": 95.42,
   "text": "نه که پر شده از مردم عادی، بلکه آدم‌های کلیدی و حساس هم تحت مراقبت قرار گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.42,
   "end": 100.6,
   "text": "و در آماده باش، در بالاترین سطح آماده باش‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.6,
   "end": 103.12,
   "text": "کیا همونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.12,
   "end": 105.1,
   "text": "ما حالا میگن قدرت ششم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.1,
   "end": 110.3,
   "text": "دنیا هستن، در برابر یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.3,
   "end": 113.3,
   "text": "عکس‌العمل ایران اینچنین زمین گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.3,
   "end": 118.98,
   "text": "انواع و اقسام پیام‌هایی که حالا یا مستقیم یا غیرمستقیم می‌فرستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.98,
   "end": 129.52,
   "text": "که از طریق کشورهای دیگه خود آمریکا چندین بار پیام داده که به ایران که ما رو نزنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.52,
   "end": 132.78,
   "text": "و البته ایران از طریق کشورهای عربی هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.78,
   "end": 137.06,
   "text": "هم به آمریکا، هم به انگلیس، هم به فرانسه، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.06,
   "end": 140.24,
   "text": "پیام داده که اگر ما پاسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.24,
   "end": 144.2,
   "text": "مخصوصا کلمه پاسخ اومده، پاسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.2,
   "end": 147.72,
   "text": "اسرائیل رو بدیم و شما بخواید مواجهه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.72,
   "end": 152.26,
   "text": "ما پایگاه‌های شما رو هم می‌زنیم تو منطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.26,
   "end": 156.18,
   "text": "خب این حالتی که هنوز ایران هم فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.18,
   "end": 161.1,
   "text": "به قولی تهدید کرده، رهبر عزیزمون یه جمله فرموده که ما پشیمونتون می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.1,
   "end": 164.28,
   "text": "اینطوری دنیا ریخته به هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.28,
   "end": 170.16,
   "text": "و از اون طرف التماس می‌کنن به ایران که به کشورهای دیگه شما سلاح نفروشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.16,
   "end": 173.08,
   "text": "هر کاری می‌خواید بکنید سلاح‌هاتونو نفروشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.08,
   "end": 176.28,
   "text": "یعنی این هرکی با یک چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.28,
   "end": 181.48,
   "text": "حق‌بین نگاه کنه عزت و اقتدار ایران اسلامی رو داره مشاهده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.48,
   "end": 183.02,
   "text": "هنوز اتفاقی هم نیفتاده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.02,
   "end": 189.46,
   "text": "این عزت و اقتدار ایران اسلامیه در مقابل قبل از انقلاب که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.46,
   "end": 193.96,
   "text": "متاسفانه مرعوب بود و مفعول بود شاه مملکت در برابر این قدرت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.96,
   "end": 196.6,
   "text": "حالا اونا به التماس به ایران افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.6,
   "end": 200.04,
   "text": "منتها در دل این موضوع به حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.04,
   "end": 202.74,
   "text": "این عزتی که واقعا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.74,
   "end": 206.68,
   "text": "پدیدار میشه، یه نکته‌ای رو من اینجا عارض بشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.68,
   "end": 211.4,
   "text": "خوب اینو توجه کنیم. تو چندین باری که ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.4,
   "end": 215.86,
   "text": "بر اساس مطالبه مردمی مثلا انتقامی چیزی گرفت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.86,
   "end": 219.46,
   "text": "مخفول واقع موند از اذهان خیلیامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.46,
   "end": 223.38,
   "text": "چی؟ اونم اینکه چرا الان مثلا شبکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.38,
   "end": 225.74,
   "text": "CBS نیوز آمریکا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.74,
   "end": 229.76,
   "text": "به نقل از دو تا از مقامات آمریکایی که اسمشون نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.76,
   "end": 235.44,
   "text": "گزارشی رو په-- ان-انواع و اقسام این گزارش‌ها داره میاد، این یه نمونه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.44,
   "end": 239.86,
   "text": "اومم، نقل می‌کنند که اون‌ها مدعی شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.86,
   "end": 244.28,
   "text": "که پاسخ ایران هم قطعی‌ست، هم نزدیک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.28,
   "end": 248.56,
   "text": "هم وحشتناک به گونه‌ای که حداقل برآورد ما اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.56,
   "end": 253.12,
   "text": "بیش از صد پهپاد و ده‌ها موشک، موشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.12,
   "end": 256.94,
   "text": "سنگین نقطه زن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.94,
   "end": 261.12,
   "text": "جاهای حساس اسرائیل برخورد می‌کنه در اولین حمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.12,
   "end": 265.98,
   "text": "و انواع و اقسام این به هر حال نقطه نظراتی که داره بیان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.98,
   "end": 271.08,
   "text": "در حسب ظاهر ما میگیم عجب، عجب مثلا چه جالب، چه خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.08,
   "end": 273.66,
   "text": "اما یه نکته رو توجه نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.66,
   "end": 281.04,
   "text": "همون بلایی که سر انتقام یا به قول رهبر سیلی که پیرامون شهادت سردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.04,
   "end": 284.32,
   "text": "سر ما اومد، همونو دوباره دارن اینجا سر ما میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.32,
   "end": 289.94,
   "text": "چیه؟ اونم اینکه انقدر نقطه جوش ماها رو می‌برن بالا با همین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.94,
   "end": 293.08,
   "text": "اونا که دوست ما نیستن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.08,
   "end": 297.06,
   "text": "نقطه جوش ما رو انقدر می‌برن بالا، آره قراره ایران بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.06,
   "end": 301.16,
   "text": "نمی‌دونم به قلب حیفا، تلاویو نابود کنه، نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.16,
   "end": 303.1,
   "text": "اصلا بعضی جاها من اصلا خنده‌م گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.1,
   "end": 306.48,
   "text": "نوشته بودن قراره ایران با خاک یکسان کنه اسرائیلی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.48,
   "end": 310.4,
   "text": "همین بچه‌های خودمون تو تحلیل‌هاشون که ارائه میدن داخل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.4,
   "end": 312.76,
   "text": "تمام پایگاه‌های موشکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.76,
   "end": 318.44,
   "text": "ای-ایران در سطح آماده باش کامل و قراره از تمام پایگاه‌ها به سمت اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.44,
   "end": 320.54,
   "text": "تو چه حسابی شما این اخبار رو دارید میگید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.54,
   "end": 323.24,
   "text": "بله، چون رهبر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.24,
   "end": 327.76,
   "text": "ان شاء الله پاسخ و انتقام قطعی صد در صدیه و به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.76,
   "end": 329.72,
   "text": "به بهترین وجه ممکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.72,
   "end": 334.16,
   "text": "ان شاء الله خواهند زد و درست و دقیق هم خواهند زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.16,
   "end": 337.96,
   "text": "نقطه یعنی اون نقطه‌هایی که اینا مد-مدنظرشون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.96,
   "end": 341.14,
   "text": "دقیق و نمره‌شون هم بیست، صد درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.14,
   "end": 346.08,
   "text": "اما چه اتفاقی اینجا می‌افته؟ اونا میان نقطه جوش ما رو می‌برن بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.08,
   "end": 351.1,
   "text": "که اگر، اگر که نه صد درصد ایران ان شاء الله اون انتقامشو گرفته، اون نقاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.1,
   "end": 354.98,
   "text": "حساس رو زده و کارشو انجام داده که تازه شروع یک ماجراست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.98,
   "end": 357.66,
   "text": "همه ما بزنیم رو دستمون عجب، این بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.66,
   "end": 360.78,
   "text": "دقیقا همون اتفاقی که سر قصه سردار رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.78,
   "end": 365.7,
   "text": "ما نمی‌دون-- اصلا کسی جگر نداشت پایگاه‌های آمریکایی تو منطقه بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.7,
   "end": 369.78,
   "text": "عین الاسد رو که ما زدیم اولین بار بود یه پایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.78,
   "end": 375.2,
   "text": "آمریکایی، اونم یکی از مهم‌ترین پایگاه و بزرگ‌ترین پایگاه‌های آمریکایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.2,
   "end": 378.14,
   "text": "اون ارشد‌های نظامی‌شون اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.14,
   "end": 381.64,
   "text": "ساکن بودن رو ما زدیم. این کار بسیار بزرگی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.64,
   "end": 388.68,
   "text": "اما اینقدر نقطه جوش ما رو تو خبرگزاری‌ها چه داخل، چه خارج برده بودن بالا، ما توقع داشتیم از خود من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.68,
   "end": 394.72,
   "text": "اون موقع می‌گفتم باید حداقل صد و ده تا موشک بزنن به تمام پایگاه‌های آمریکا تو سرتاسر کشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.72,
   "end": 396.66,
   "text": "حالیمون نبود چیکار داریم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.66,
   "end": 401.46,
   "text": "خب غیرتمون سر سردار جوشیده بود، اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.46,
   "end": 406.02,
   "text": "اما توجه نداشتیم وقتی که زدن با اینکه مهم‌ترین نقطه رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.02,
   "end": 409.02,
   "text": "و بعدش من یه روز اینجا یه تحلیلی ارائه دادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.02,
   "end": 413.1,
   "text": "چندین فرمانده ارشد اسرائیل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.1,
   "end": 417.3,
   "text": "با هر فرمانده ارشدی از ما که زدن، این‌ها زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.3,
   "end": 420.2,
   "text": "چندین بار پ-- انتقام گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.2,
   "end": 424.98,
   "text": "نفر اول پهبادی‌شون، نفر اول هسته‌ای‌شون، نفر اول نمیدونم چی چیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.98,
   "end": 427.78,
   "text": "اینا رو همه رو زدن به صورت خاموش و گمنام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.78,
   "end": 430.32,
   "text": "اما ما بی‌خبر بودیم چیکار کردیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.32,
   "end": 432.34,
   "text": "ما که مرعوب بودیم، ما که مفعول بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.34,
   "end": 435.6,
   "text": "نه، اتفاقاً الان فاعل ایرانه، اونا مفعولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.6,
   "end": 438.34,
   "text": "منتها باید حواسمون جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.34,
   "end": 444.92,
   "text": "بدانیم این‌ها به بهترین وجه ممکن کارشون رو پشت-- انشاالله پشت سر فرمانده رهبری انجام خواهند داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.92,
   "end": 449.98,
   "text": "ما دیگه بیخودی گنده‌ش نکنیم، داغش نکنیم، آه، قراره اسرائیل با خاک یکسان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.98,
   "end": 452.24,
   "text": "نه، این تازه شروع ماجراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.24,
   "end": 456.26,
   "text": "این نکته رو میخوام بگم. انشاالله انجام میشه و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.26,
   "end": 458.46,
   "text": "خ-خشنودیم که به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.46,
   "end": 466.02,
   "text": "اون فرمایش امام معصوم که الحمدلله که خدا دشمنان ما رو از احمق‌ها آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.02,
   "end": 468.68,
   "text": "بزرگ‌ترین حماقتی که کردن همین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.68,
   "end": 471.5,
   "text": "دیگه ایران می‌تونه راحت-- چون زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.5,
   "end": 474.76,
   "text": "سفارت به منزله زدن خاک هر کشوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.76,
   "end": 477.28,
   "text": "این کار یعنی دیگه دست ایران رو باز کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.28,
   "end": 485.2,
   "text": "هیچکس هم نمی‌تونه چیزی بگه. این نکته رو گفتم عارض بشم که توجه داشته باشیم تو تحلیل‌هامون حواسمون جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.2,
   "end": 489.02,
   "text": "واقع‌بینانه ببینیم و دعا کنیم انشاالله بچه‌ها رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.02,
   "end": 491.74,
   "text": "خدا موفقشون کنه. این تازه شروع ماجراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.74,
   "end": 496.94,
   "text": "انشاالله که عاقبت مخلفه به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.94,
   "end": 501.8,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.8,
   "end": 504.0,
   "text": "محمد و آل محمد. اللهم کن لولیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.0,
   "end": 506.5,
   "text": "في ما قضیت بحکمک ولیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}