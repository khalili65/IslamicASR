 "chapters": [
  {
   "index": 0,
   "title": "## وحدت جماعت و حرمت تفرقه در نزدیکی نمازخانه",
   "start": 22.32,
   "end": 137.14
  },
  {
   "index": 1,
   "title": "## میلاد امام جواد و ابتلای دائمی مؤمن",
   "start": 137.14,
   "end": 227.56
  },
  {
   "index": 2,
   "title": "## نسبت امتحان؛ از کتاب معمولی تا جنب‌الله",
   "start": 227.56,
   "end": 293.38
  },
  {
   "index": 3,
   "title": "## ابن‌الرضا و امتحان شیعه پس از امام رئوف",
   "start": 293.38,
   "end": 614.19
  },
  {
   "index": 4,
   "title": "## کوثر امام رضا و پربرکت‌ترین مولود",
   "start": 614.19,
   "end": 774.64
  },
  {
   "index": 5,
   "title": "## انتساب و سنگینی بار ادعا",
   "start": 774.64,
   "end": 931.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 3.5,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 11.1,
   "text": "محمد و آل محمد. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.1,
   "end": 16.22,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.22,
   "end": 22.32,
   "text": "سلامٌ علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.32,
   "end": 24.9,
   "text": "جلسه‌ی امروزمون رو هدیه می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.9,
   "end": 31.02,
   "text": "روح پدر حاج آقا رضای عزیزمون که چندین سال اینجا برای ما روضه خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.02,
   "end": 37.2,
   "text": "اگر ما بدانیم که روضه‌خون‌های اهل بیت چه حق بزرگی گردن ما دارن بیشتر از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.2,
   "end": 42.26,
   "text": "به فکر خواهیم بود. این‌ها واسطه‌ی خیر و فیض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.26,
   "end": 44.88,
   "text": "هرچه که هست چون کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.88,
   "end": 52.1,
   "text": "آل الله هست و قال الله تبارک و تعالی لذا همه رو هدیه می‌کنیم به روح پدر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.1,
   "end": 57.2,
   "text": "ان شاء الله در نشئه‌ی بالا داووی ما باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.2,
   "end": 61.94,
   "text": "می‌دونید که فلسفه‌ی اقامه نماز جماعت وحدت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.94,
   "end": 65.82,
   "text": "رفع تفرقه و پراکندگی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.82,
   "end": 68.78,
   "text": "لذا رهبر عزیزمون فرمودن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.78,
   "end": 72.96,
   "text": "در نزدیکی مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.96,
   "end": 75.08,
   "text": "در نزدیکی مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.08,
   "end": 79.32,
   "text": "نمازی به پا بشه که موجبات پراکندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.32,
   "end": 85.1,
   "text": "و اختلاف اون جماعت بشه، جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.1,
   "end": 94.14,
   "text": "اقامه اون نماز در نزدیکی مسجد به گونه‌ای که موجب پراکندگی و اختلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.14,
   "end": 97.82,
   "text": "اهل ایمان در مسجد بشه جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.82,
   "end": 101.84,
   "text": "دیگه خودتون توجه داشته باشید که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.84,
   "end": 106.26,
   "text": "کسانی که مثلاً تو همین جا، همین جا بالاخره اینجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.26,
   "end": 112.62,
   "text": "محل سجده‌ست. به یک معنا مسجد بنا شده به، به نیت نمازخانه و مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.62,
   "end": 121.54,
   "text": "اون‌هایی که نزدیک اینجا حالا حتی تو اتاق‌هاشون بعضیا نماز می‌خونن اگر موجب تضعیف این جماعت بشه جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.54,
   "end": 123.98,
   "text": "مگر اینکه در عدالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.98,
   "end": 129.26,
   "text": "یا قرائت امام جماعت اونا مشکل داشته باشن که باید رسیدگی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.26,
   "end": 134.56,
   "text": "اون باید رسیدگی بشه که اگر حق به حرفشون امام جماعت عوض شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.56,
   "end": 141.2,
   "text": "چرا موجب تضعیف بشیم؟ تبریک عرض می‌کنم روز میلاد بسیار با عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 141.2,
   "end": 144.06,
   "text": "امام جواد صلوات الله عليه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.06,
   "end": 147.12,
   "text": "عزیز در دومه امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.12,
   "end": 151.86,
   "text": "وابل حوائج حضرت علی اصغر علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.86,
   "end": 161.28,
   "text": "می‌دونید که مؤمنی نیست مگر اینکه هر روز تحت یک امتحان و ابتلا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.28,
   "end": 163.52,
   "text": "تا جایی که فرمودن اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 163.52,
   "end": 172.5,
   "text": "کسی احساس کرد مورد امتحان، ابتلا و بلای الهی نیست به ایمانش شک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 172.5,
   "end": 179.28,
   "text": "حتی از حیث مصیبت‌ها مثلاً حضرت فرمود اگر کسی چهل روز بهش بگذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 179.28,
   "end": 183.18,
   "text": "و بلایی بهش نخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 183.18,
   "end": 191.2,
   "text": "حالا یا به مالش یا به جانش مثلاً مریضی نشه، ضربه‌ای نخوره، مصیبتی بهش وارد نشه، بله این اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 191.2,
   "end": 195.76,
   "text": "در ایمانش شک کنه. چنین کسی مؤمن نیست، محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 195.76,
   "end": 201.02,
   "text": "دار داره امتحانه و هر یک سال یک بار این رو توجه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 201.02,
   "end": 205.36,
   "text": "هر سال یک بار هر مؤمنی یک امتحان سنگین داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 205.36,
   "end": 210.66,
   "text": "سنگین. که دیگه عقاب پر می‌ریزه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 210.66,
   "end": 215.96,
   "text": "حالا باید توجه داشته باشیم هر کدوممون که در سال چه امتحان سنگینی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 215.96,
   "end": 218.62,
   "text": "و البته این سنگینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 218.62,
   "end": 222.16,
   "text": "یک نسبت به صیعه وجود هر کسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 222.16,
   "end": 227.56,
   "text": "دو نسبت به کسی‌ست که در مورد او تو امتحان میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 227.56,
   "end": 235.42,
   "text": "مطمئنم اگر انسان به یک آدم معمولی امتحان بشه، نسبت به یک شخص معمولی امتحان بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 235.42,
   "end": 242.02,
   "text": "مثلاً نسبت به یک کتابی امتحان بشه، خوابیده پاش درازه سمت یک کتاب درسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 242.02,
   "end": 247.8,
   "text": "علم حرمت داره. بزرگان حتی روزنامه رو هم زیر پاشون نمی‌انداختن نماز بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 247.8,
   "end": 249.8,
   "text": "می‌گفتن این حروف حرمت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 249.8,
   "end": 254.52,
   "text": "از ازدواج این حروف کلمات تشکیل میشه و از ازدواج این کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 254.52,
   "end": 257.52,
   "text": "موضوعات و مفاهیم. این‌هام حرمت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 257.52,
   "end": 261.42,
   "text": "علم حروف اصلاً نشان حرمت حروف رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 261.42,
   "end": 264.36,
   "text": "حتی اعداد که روح حروفن اون هم حرمت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 264.36,
   "end": 269.36,
   "text": "همه چی در عالم حرمت داره. خیلی با احتیاط قدم برمی‌داشتن بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 269.36,
   "end": 275.78,
   "text": "دلایلی هم داره. رو همین زمین‌ها چون این زمین هم آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 275.78,
   "end": 279.56,
   "text": "تا حالا توجه داشتیم که ما رو آیت الله داریم راه میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 279.56,
   "end": 284.04,
   "text": "لذا با احتیاط، با وضو، با طهارت، با توجه و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 284.04,
   "end": 291.96,
   "text": "خب فرق می‌کنه که انسان مثلاً پاش دراز باشه سمت یک کتاب معمولی تا پاش دراز باشه سمت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 291.96,
   "end": 296.22,
   "text": "نسبت به قرآن امتحان پس بده یا نسبت به یک کتاب معمولی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 296.22,
   "end": 301.88,
   "text": "نسبت به یک انسان معمولی امتحان پس بده یا نسبت به یک معلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 301.88,
   "end": 305.54,
   "text": "یا معلم قرآن که شیطان فرم-- گفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 305.54,
   "end": 310.24,
   "text": "روایت داریم از اهل بیت علیهم الصلاة والسلام که شیطان از مرگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 310.24,
   "end": 315.5,
   "text": "از مرگ هیچ کسی به اندازه مرگ معلم قرآن خوشحال نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 315.5,
   "end": 319.6,
   "text": "حالا این معلم قرآن هم دیگه همه چیز ذات مراتبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 319.6,
   "end": 321.74,
   "text": "اون مع-معلم قرآنی که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 321.74,
   "end": 327.98,
   "text": "ظاهر قرآن می‌پردازه، روحانی قرآن، تجوید و صوت و لحن اون هم خیلی شرف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 327.98,
   "end": 333.86,
   "text": "اما معلم اشرف کسی که شرفش از همه معلمين قرآن بیشتره اون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 333.86,
   "end": 337.7,
   "text": "تفسیر قرآن و بالاتر از اون کسی که تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 337.7,
   "end": 342.26,
   "text": "انسی قرآن رو میگه. مثل آقا محسن زاده‌ها و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 342.26,
   "end": 344.6,
   "text": "و به هر حال معلم قرآن. خب فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 344.6,
   "end": 349.96,
   "text": "باز فرق می‌کنه که انسان مثلاً نسبت به یک عالم جلیل القدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 349.96,
   "end": 352.0,
   "text": "به یک مرجع تقلید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 352.0,
   "end": 354.72,
   "text": "به رهبر عزیز همینطوری مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 354.72,
   "end": 361.91,
   "text": "یا کسی نسبت به حجت زمانش، به امام زمانش، به ولی اعظم زمانش امتحان بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 361.91,
   "end": 367.35,
   "text": "لذا اون صریح آیه قرآن که \"یا حسرتا على ما فرطت في جنب الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 367.35,
   "end": 370.09,
   "text": "تصریح میکنه که قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 370.09,
   "end": 377.13,
   "text": "همه فریاد وا حسرتا سر میزنن از کوتاهی که پیرامون جنب الله کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 377.13,
   "end": 380.21,
   "text": "و شیخ صدوق روایت میاره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 380.21,
   "end": 384.45,
   "text": "کتاب شریف کمال الدین و تمام نعمتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 384.45,
   "end": 386.87,
   "text": "این جنب الله امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 386.87,
   "end": 395.79,
   "text": "نسبت به امام عصر اگه کسی کوتاهی کنه فریاد وا حسرتاش قیامت بلنده و از لحظه مرگش که قیامت صغراش رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 395.79,
   "end": 398.27,
   "text": "فریاد وا حسرتاش بلنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 398.27,
   "end": 400.57,
   "text": "تو رابطت با امام زمانت چگونه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 400.57,
   "end": 403.39,
   "text": "حالا مردم بعد از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 403.39,
   "end": 406.59,
   "text": "اینا رو توضیح بدم مقدمه برای نکته‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 406.59,
   "end": 414.33,
   "text": "بعد از امام رضا که دیگه تا امام عصر ما رو بهشون میگفتن ابن الرضا یه حکایتی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 414.33,
   "end": 418.35,
   "text": "یک وجهش به این خاطر بود که بعد از امام الرؤوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 418.35,
   "end": 422.03,
   "text": "شیعیان امتحان سنگینی پس دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 422.03,
   "end": 428.25,
   "text": "الان شما من داش-داشتم دقت میکردم به همین اذکاری که اینجا نوشته اذکار روز رو شما دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 428.25,
   "end": 432.75,
   "text": "اصلا دقت کردید هرچی میری جلوتر این اذکار سنگین‌تر میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 432.75,
   "end": 435.51,
   "text": "هرچی میری جلوتر سنگین‌تر میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 435.51,
   "end": 438.63,
   "text": "شما ذکر روز چهارشنبه رو ببینید اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 438.63,
   "end": 443.17,
   "text": "یا حی یا قیوم. به قول علامه حائری یزدی علیه الرحمه در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 443.17,
   "end": 446.31,
   "text": "بحث شرح نسبه الاونسش میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 446.31,
   "end": 451.25,
   "text": "هر روایتی هر دعایی که فرمودن اسم اعظم در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 451.25,
   "end": 453.61,
   "text": "دعاست یا در این آیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 453.61,
   "end": 457.11,
   "text": "دقت کنید دو تا کلمه مشترک درشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 457.11,
   "end": 465.43,
   "text": "حی و قیوم. این یا حی یا قیوم اسم اعظمه شوخی نیست از اون يا رب العالمين که ذکر روز شنبه‌ست بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 465.43,
   "end": 468.63,
   "text": "اینا البته سلسله‌وار به هم مرتبط‌اند این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 468.63,
   "end": 471.95,
   "text": "اذکار. چرا رب العالمين شد یا ذو الجلال والاکرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 471.95,
   "end": 476.55,
   "text": "هی دارن تکمیل میشن. حالا دلیلش بماند چون بحث ما این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 476.55,
   "end": 478.99,
   "text": "بعد روز پنج شنبه ببین چقدر سنگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 478.99,
   "end": 483.09,
   "text": "لا اله الا الله الملك الحق المبين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 483.09,
   "end": 487.25,
   "text": "خیلی ذکر سنگینیه. بعد دیگه جمعه تلطیف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 487.25,
   "end": 490.69,
   "text": "جمعه دیگه مولتی‌ویتامین اذکار میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 490.69,
   "end": 495.15,
   "text": "تلطیفه. خدا لطف میکنه به قاعده لطفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 495.15,
   "end": 499.65,
   "text": "روز امام زمان ماست. سنگین‌ترین ذکر روز پنج شنبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 499.65,
   "end": 505.37,
   "text": "آمادست میکنه برای معراج شب جمعه که ليلة القدر شب‌های جمعه‌ست، شب‌های هفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 505.37,
   "end": 507.75,
   "text": "امام عصر ما هم شب جمعه معراج میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 507.75,
   "end": 510.45,
   "text": "وای به کسی که شب جمعه معراج نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 510.45,
   "end": 516.75,
   "text": "فرق میکنه انسان نسبت به شب جمعه امتحان بشه یا نسبت به ایام دیگه هفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 516.75,
   "end": 520.73,
   "text": "فرق میکنه انسان نسبت به ماه رجب امتحان پس بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 520.73,
   "end": 527.79,
   "text": "تا به ایام دیگه. اینو نفس کینونت از من و ام کنه که قبلا بحث کردیم و بحث بسیار مهمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 527.79,
   "end": 535.09,
   "text": "که تو نفس خلقتش ماه رجب یه کینونت، یک نفس برتری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 535.09,
   "end": 541.43,
   "text": "ماه عصب ریزش رحمت یعنی ارتباطی با رحمتللعالمین به طور ویژه داره که شده خاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 541.43,
   "end": 544.35,
   "text": "حالا در زمان امام رضا به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 544.35,
   "end": 546.83,
   "text": "شیعیان امتحانات خاصی پس دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 546.83,
   "end": 549.83,
   "text": "امتحان، امتحانات عجیبی و الـ- الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 549.83,
   "end": 556.99,
   "text": "لله که غالبا هم اکثرا هم سیر تطور تاریخ میگه که خداروشکر سر بلند بیرون اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 556.99,
   "end": 560.11,
   "text": "چون اولا امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 560.11,
   "end": 564.83,
   "text": "علیه السلام پا به سن گذاشت بر خلاف همه اهل بیت دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 564.83,
   "end": 567.59,
   "text": "دیر بچه دار-- اصلا بچه دار نمیشد امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 567.59,
   "end": 570.09,
   "text": "خودش یک امتحان سنگینی بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 570.09,
   "end": 573.91,
   "text": "شیعیان میخواستن بپذیرن اولا ایشون امامه پس چرا بچه دار نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 573.91,
   "end": 580.47,
   "text": "شما که تا امام دوازدهم رو به ما اسم دادید در صحیفه فاطمیه اومده پس بقیه کوشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 580.47,
   "end": 587.27,
   "text": "ثانیا امام پا به سن بگذاره بعد یه بچه خردسال، یه بچه خردسال امامت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 587.27,
   "end": 590.55,
   "text": "اولین بار بود یه بچه خردسال میخواست امامت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 590.55,
   "end": 594.01,
   "text": "دوباره امام هادی هم حدود شش تا هشت سالگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 594.01,
   "end": 599.91,
   "text": "همینطور امام عسکری، امام زمان که دیگه بالاتر از همه پنج سالگی امام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 599.91,
   "end": 602.83,
   "text": "یعنی ببین اینا یه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 602.83,
   "end": 606.61,
   "text": "امتحان سنگینیه و هرکسی نمیتونه رو سفید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 606.61,
   "end": 610.27,
   "text": "شما تصور کن یه بچه پنج ساله رو بپذیر به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 610.27,
   "end": 612.37,
   "text": "ولی مطلق زمانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 612.37,
   "end": 620.43,
   "text": "این کارا هرکسی نیست. حالا به امام رضا مثل اینکه به پیغمبر علیه السلام گفتن مقطوع النسل، ابتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 620.43,
   "end": 624.43,
   "text": "که \"إن شانئك هو الأبتر\" سوره کوثر رفع کرد این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 624.43,
   "end": 627.17,
   "text": "که دشمن تو خودش مقطوع النسل و دنبریده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 627.17,
   "end": 630.17,
   "text": "به پیغمبر میگفتن چون پیغمبر همه فرزندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 630.17,
   "end": 633.21,
   "text": "ذکورش، پسرا از دنیا میرفتن همون بچگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 633.21,
   "end": 638.77,
   "text": "یا حضرت زهرا براش اومده. \"آتیناک الكوثر\" همه اتفاقا همه نسل تو از ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 638.77,
   "end": 642.53,
   "text": "امام رضا نه دختر، نه پسر، هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 642.53,
   "end": 644.89,
   "text": "به قول زمان خودشون عقیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 644.89,
   "end": 647.21,
   "text": "العیاذ بالله. خب امتحان سنگینی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 647.21,
   "end": 650.95,
   "text": "بعد امام رض-- امام جواد علیه السلام به دنیا اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 650.95,
   "end": 653.15,
   "text": "دیگه خ-- لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 653.15,
   "end": 662.45,
   "text": "شاید یه وجهش این باشه که خود حضرت فرمودن پربرکت‌ترین مولود خاندان ما پسرم امام جواده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 662.45,
   "end": 666.63,
   "text": "لذا زرنگ‌ها امروز خیلی زرنـ-- زیرکی‌شون گل میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 666.63,
   "end": 671.53,
   "text": "مثلا حتما اگه میتونید امشب برید من دیشب رفتم که به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 671.53,
   "end": 677.07,
   "text": "امشب برید حتما زیارت حضرت عبدالعظیم حسنی که وکالت از امام جواد داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 677.07,
   "end": 679.87,
   "text": "از چهار تا امام حالا سه تاش قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 679.87,
   "end": 682.43,
   "text": "از موسی بن جعفر تا امام هادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 682.43,
   "end": 687.75,
   "text": "بالاخره فرق میکنه. ببین ما ایرانی‌ها نسبت به حضرت عبدالعظیم حسنی یه علقه ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 687.75,
   "end": 691.55,
   "text": "تهرانی‌ها ببخشید. مجموعا ایرانی‌ها به امام رضا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 691.55,
   "end": 693.69,
   "text": "ما تهرانی‌ها به حضرت عبدالعظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 693.69,
   "end": 697.41,
   "text": "مشهدی‌ها به امام رضا خیلی بیشتر از ما علقه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 697.41,
   "end": 700.15,
   "text": "بالاخره شرف مکان به مکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 700.15,
   "end": 704.47,
   "text": "ایناها حرف توش داریم ما، حرفای علمی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 704.47,
   "end": 712.49,
   "text": "فرق میکنه بالاخره ما بریم محضر ایشون با امام جواد نشسته مستقیم وکالت داشته یعنی فکر کنید نائب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 712.49,
   "end": 715.55,
   "text": "خاص ما الان ما به ولی فقیه میگیم نائب عام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 715.55,
   "end": 718.33,
   "text": "ایشون نیابت خاص از امام زمانش داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 718.33,
   "end": 722.81,
   "text": "شوخی نیست. برید محضر ایشون زرنگ باشید بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 722.81,
   "end": 726.19,
   "text": "یا ابا القاسم کنیه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 726.19,
   "end": 729.71,
   "text": "عبدالعظیم یا سید کریم ما اومدیم عیدی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 729.71,
   "end": 731.43,
   "text": "شما وکیل امام جواد بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 731.43,
   "end": 736.64,
   "text": "امروز روز میلادشه. خب باز فرق می‌کنه ما نسبت به امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 736.64,
   "end": 742.58,
   "text": "به حضرت عبدالهادی ما حسنی ما تهرانی‌ها امتحان پس بدیم یا مشهدی‌ها نسبت به امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 742.58,
   "end": 745.4,
   "text": "که سر سفره‌شن. اینا باز همه با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 745.4,
   "end": 747.9,
   "text": "امتحانی که می‌خوایم پس بدیم نسبت به کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 747.9,
   "end": 750.78,
   "text": "به چه کسیه؟ به چه زمانیه؟ به چه مکانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 750.78,
   "end": 754.44,
   "text": "لذا فرمودن شب جمعه گناه دو برابر نوشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 754.44,
   "end": 757.62,
   "text": "سادات گناهشون دو برابر نوشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 757.62,
   "end": 759.92,
   "text": "باز شب جمعه ثواب دو برابره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 759.92,
   "end": 762.62,
   "text": "سادات فضیلتشون دو برابره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 762.62,
   "end": 766.32,
   "text": "ماه رجب الان، ماه رجب اشرف ماه‌های دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 766.32,
   "end": 769.54,
   "text": "کسی در این ماه گناه کنه وا مصیبتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 769.54,
   "end": 774.64,
   "text": "و اگر ثواب کنه که وا رحمتها چقدر خوب و عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 774.64,
   "end": 782.06,
   "text": "پس بحث اینجا بود که چی؟ ما باید حواسمون جمع بکنیم که دائم در معرض ابتلا و امتحانیم مخصوصا هر سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 782.06,
   "end": 785.08,
   "text": "لذا می‌طلبَد نتیجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 785.08,
   "end": 787.82,
   "text": "می‌طلبَد نکته آخر رو خوب توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 787.82,
   "end": 796.58,
   "text": "همه اینا رو گفتم به این خاطر. می‌طلبَد که مراقب باشیم به کسانی و چیزهایی که بهش نزدیک میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 796.58,
   "end": 798.52,
   "text": "معمولا ما پوزیشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 798.52,
   "end": 802.4,
   "text": "چیزها و کسانی که بهشون نزدیک میشیم رو بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 802.4,
   "end": 805.06,
   "text": "انتساب پیدا می‌کنیم و می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 805.06,
   "end": 808.38,
   "text": "آره من قاری قرآنم، من ذاکر امام حسینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 808.38,
   "end": 810.4,
   "text": "اینا خیلی چ-- خطرناکا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 810.4,
   "end": 812.58,
   "text": "خیلی ادعای بزرگی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 812.58,
   "end": 815.08,
   "text": "من شاگرد مثلا حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 815.08,
   "end": 822.94,
   "text": "العظمی آقای بهجتم، من شاگرد آیت الله العظمی مثلا حضرت علامه حسن زاده‌م، من شاگرد فلانم و این ادعاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 822.94,
   "end": 825.04,
   "text": "خب تو رو با همون امتحانت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 825.04,
   "end": 827.32,
   "text": "فرق می‌کنه با اون کاسب معمولی سر کوچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 827.32,
   "end": 832.5,
   "text": "آقا توجه داشته باشیم اگر یک باربر باز- بازار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 832.5,
   "end": 836.06,
   "text": "بارشو با سلامت ببره و حلال کار کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 836.06,
   "end": 841.98,
   "text": "فرمودن هم‌درجه یک مرجع تقلیدی محشور میشه که اونم تکلیفش رو ادا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 841.98,
   "end": 844.2,
   "text": "این تکلیفشو، اونم تکلیفشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 844.2,
   "end": 847.3,
   "text": "لا یکلف الله نفسا الا وسعها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 847.3,
   "end": 851.46,
   "text": "خیلی قصه فرق می‌کنه که ما با چی امتحان پس میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 851.46,
   "end": 856.52,
   "text": "تو نسبت، برای همین سعی کنیم یا دوری کنیم از نفسش بهره ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 856.52,
   "end": 861.44,
   "text": "با آدمای خاص، آدما تا مثلا اعلام می‌کنن دست‌بوسی مقام ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 861.44,
   "end": 863.42,
   "text": "با سر میره، با سر میدوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 863.42,
   "end": 866.46,
   "text": "آقا مر-مر می‌تونی جوابگوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 866.46,
   "end": 872.22,
   "text": "تبعاتش باشی؟ به خدا ما رو وقتی دست‌بوسی از امام زمان جنگ دعوت کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 872.22,
   "end": 874.34,
   "text": "یه سری بچه‌های جنگو ما اونجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 874.34,
   "end": 880.26,
   "text": "من تا صبح خواب تو چشام نمیرفت از اینکه من برم الان دست امامو ببوسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 880.26,
   "end": 882.22,
   "text": "بعد بارم سنگین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 882.22,
   "end": 885.02,
   "text": "برم، نرم، خدا شاهده تا صبح آخرم نرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 885.02,
   "end": 886.96,
   "text": "گفتم بچه‌ها شما برید من نمیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 886.96,
   "end": 893.12,
   "text": "می‌خوام ندیده امام بیارم. الان ما نسبت به امام زمانمون خیلی بارمون سبک‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 893.12,
   "end": 896.86,
   "text": "که نمی‌بینیم تا اون کسی که با حضرت محشور بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 896.86,
   "end": 899.56,
   "text": "اونایی که میگن متى ترانا و نراك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 899.56,
   "end": 901.92,
   "text": "امتحانشون خیلی سنگین‌تر میشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 901.92,
   "end": 904.7,
   "text": "امام ببینند و باز خطا کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 904.7,
   "end": 906.26,
   "text": "آقا این امتحان‌ها رو باید توجه داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 906.26,
   "end": 910.44,
   "text": "یا دور باش یا اگه نزدیکی امتحان پس بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 910.44,
   "end": 914.38,
   "text": "یعنی درست امتحان، اهل امتحان پس دادن و نمره بیست باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 914.38,
   "end": 917.8,
   "text": "و الا ادعا نکن به خودم عرض می‌کنم و نزدیک نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 917.8,
   "end": 919.86,
   "text": "از دور از نفسش بهره ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 919.86,
   "end": 924.66,
   "text": "ان شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 924.66,
   "end": 931.52,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}