 },
 "chapters": [
  {
   "index": 0,
   "title": "## مناسبت‌ها و حدیث ترازِ شخصیت",
   "start": 29.76,
   "end": 365.06
  },
  {
   "index": 1,
   "title": "## حاج قاسم و عملیات رسانه‌ای روی بیلبورد",
   "start": 365.06,
   "end": 531.3
  },
  {
   "index": 2,
   "title": "## کاندیدای تیر و ترکش",
   "start": 531.3,
   "end": 799.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 17.52,
   "end": 21.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 21.22,
   "end": 26.24,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 26.24,
   "end": 29.46,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 29.46,
   "end": 34.18,
   "text": "خب چند تا مناسبت خیلی مهم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 34.18,
   "end": 38.24,
   "text": "و هنر میخواد که این‌ها رو با، با هم بتونه انسان بیان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 38.24,
   "end": 41.74,
   "text": "روح نو- روز نه هدیه زحمت نکشید ممنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 41.74,
   "end": 45.3,
   "text": "سالگرد حماسه تاریخی مردمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 45.3,
   "end": 49.08,
   "text": "نه هدیه هست. از طرفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 49.08,
   "end": 53.14,
   "text": "ایام شهادت حاج قاسم عزیز هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 53.14,
   "end": 56.9,
   "text": "هفته مقاومت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.9,
   "end": 61.78,
   "text": "و همه این‌ها مناسبت‌های خیلی مهمی هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.78,
   "end": 66.18,
   "text": "برای اینکه ما روزای شنبه رو اختصاص دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.18,
   "end": 70.38,
   "text": "به مسائل جاری کشور یا خود مرکز‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 70.38,
   "end": 73.62,
   "text": "و مسائل مهم عبادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.62,
   "end": 77.52,
   "text": "سیاسی، اجتماعی. مثلا جلسه پیش هفته پیش پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.52,
   "end": 83.18,
   "text": "اهمیت نماز اول وقت به جماعت در ادارجات صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 83.18,
   "end": 87.16,
   "text": "امروز با توجه به موضوع روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.16,
   "end": 93.58,
   "text": "ااا برای اینکه هم موضوع عبادی باشه هم سیاسی هم اجتماعی یک حدیث تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.58,
   "end": 99.96,
   "text": "که با همه ادعایی که دارم اولین بار بعد پنجاه سال این حدیث رو خودم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 99.96,
   "end": 101.84,
   "text": "خیلی حدیث عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.84,
   "end": 105.32,
   "text": "خیلی. یعنی وقتی من این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.32,
   "end": 111.26,
   "text": "خوندم انقدر تن و بدنم لرزید که خدا میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.26,
   "end": 114.34,
   "text": "حالا بگم ببینیم کدomo می‌لرزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.34,
   "end": 118.18,
   "text": "حدیث از امام، امام عسکری صلوات الله علیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.18,
   "end": 124.62,
   "text": "سندش هم بهار جلد نه صفحه صد و شصت و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.62,
   "end": 129.86,
   "text": "حضرت فرمودن که اگه کسی رو دیدید که خیلی نورانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.86,
   "end": 136.9,
   "text": "و با وقار راه میره، زاهدانه زندگی می‌کنه، رفتار متینی داره اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 136.9,
   "end": 138.92,
   "text": "ظاهرا میگی آقا این دیگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.92,
   "end": 143.48,
   "text": "کارش درسته. چهره رو ببین داد می‌زنه نورانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.48,
   "end": 148.38,
   "text": "زاهدانه هم زندگی می‌کنه باز گولش رو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 148.38,
   "end": 152.42,
   "text": "حضرت، گول همچین چهره‌ای رو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 152.42,
   "end": 158.86,
   "text": "حضرت فرمودن که شاید این رو ملعبه دنیاش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.86,
   "end": 165.46,
   "text": "این چهره نورانی و این زاهدانه زندگی کردن و این لباس دینی که به تن کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.46,
   "end": 169.94,
   "text": "برای دنیاشه. میگه دنیاشو بدست میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 169.94,
   "end": 177.82,
   "text": "بعد حضرت حالا به قول خودمون انگار که الک گرفته حضرت همینطوری داره الک می‌کنه، قرقور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 177.82,
   "end": 179.8,
   "text": "بعد فرمودن بررسی کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.8,
   "end": 187.74,
   "text": "اگر دیدید نه، واقعا این چهره و این وضعیت زاهدانه رو این‌ها رو به خاطر دنیاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 187.74,
   "end": 190.4,
   "text": "انجام داده، دنبال مال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 190.4,
   "end": 193.04,
   "text": "حضرت فرمود باز هم گولش رو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 193.04,
   "end": 195.2,
   "text": "بررسی کنید شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 195.2,
   "end": 200.06,
   "text": "دنبال شهواتشه. یعنی ز- آدم خوبیه اما پاش بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 200.06,
   "end": 202.04,
   "text": "سمت شهوات سر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.04,
   "end": 205.06,
   "text": "خلوتش، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 205.06,
   "end": 209.8,
   "text": "کارو خراب می‌کنه. یعنی الگو نیست برای ما هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 209.8,
   "end": 219.24,
   "text": "تراز نیست. خب اگر می‌فرمود که بررسی کردی دیدی نه آدم شهوت‌رانی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 219.24,
   "end": 226.4,
   "text": "آدم خوبیه به قولی منحرف نیست باز حضرت فرمود مواظ، مواظب باش باز هم گولشو نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 226.4,
   "end": 231.74,
   "text": "دقت کن که آدمی باشه که عقل سالم و بینش درستی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 231.74,
   "end": 235.16,
   "text": "بینشش درست باشه. عقلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.16,
   "end": 237.78,
   "text": "درست باشه. درایت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 237.78,
   "end": 240.26,
   "text": "عقل و معرفت. باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 240.26,
   "end": 243.8,
   "text": "بررسی کردی دیدی که آدم عاقلیه حرفای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 243.8,
   "end": 246.96,
   "text": "حکیمانه و عاقلانه‌ای می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 246.96,
   "end": 250.48,
   "text": "انگار که حکمت بلده، عرفان بلده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 250.48,
   "end": 254.16,
   "text": "فلسفه بلده، حرفاش عاقلانه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 254.16,
   "end": 256.08,
   "text": "درسته؟ نمیشه رد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.08,
   "end": 259.02,
   "text": "محکم حرف می‌زنه. متین حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.02,
   "end": 261.8,
   "text": "اما باز گولش رو نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.8,
   "end": 266.5,
   "text": "فرمودن که دقت کنید ببینید که تو دوراهی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.5,
   "end": 269.8,
   "text": "عقلش رو ترجیح میده یا نفسش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.8,
   "end": 273.7,
   "text": "بله حرف ع- عاقلانه خیلی قشنگ می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.7,
   "end": 275.7,
   "text": "اما وقتی دوراهی پیش اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.7,
   "end": 279.4,
   "text": "نفسش رو ترجیح میده یا عقلش رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.4,
   "end": 281.5,
   "text": "تو دوراهی‌ها معلوم می‌شه چی کاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.5,
   "end": 284.66,
   "text": "حرف زدن همه بلدن. به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.66,
   "end": 290.9,
   "text": "استاد علامه حسنزاده علیه رحمة بارها این رو می‌فرمودن که الان ایشون می‌فرمودن الان که من دارم برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.9,
   "end": 294.4,
   "text": "تو این کلاس درس صحبت می‌کنم هممون خوبیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.4,
   "end": 296.06,
   "text": "منم از همه شما بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.06,
   "end": 302.8,
   "text": "ایشون می‌فرمودن. به وقتش معلوم می‌شه وقتی دنیا رو آورد، ریاست رو آورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.8,
   "end": 307.08,
   "text": "مال رو آورد، اون موقع معلوم می‌شه کی چی کاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.08,
   "end": 309.24,
   "text": "می‌فرمود ببین تو دوراهی‌ها چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.24,
   "end": 311.28,
   "text": "نفسش رو ترجیح میده یا عقلش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.28,
   "end": 314.14,
   "text": "امام عسکری صلوات الله. تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.14,
   "end": 317.76,
   "text": "می‌گفت آقا دقت کردی دیدی نه تو دوراهی‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.76,
   "end": 319.96,
   "text": "عقلش رو رجحان میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.96,
   "end": 322.56,
   "text": "نفسش رو رها می‌کنه. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.56,
   "end": 324.88,
   "text": "به نظر شما ترازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.88,
   "end": 327.44,
   "text": "الگوعه؟ درسته؟ اینجا دیگه باید بگیم تمام دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.44,
   "end": 331.42,
   "text": "حضرت فرمود نه بازم گولشو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.42,
   "end": 335.18,
   "text": "دقت کنید که ایشون تو وجودش، تو دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.18,
   "end": 338.02,
   "text": "شاید حب ریاست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.02,
   "end": 342.0,
   "text": "ریاست طلبه، عاشق مسئولیت و مدیریت و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.0,
   "end": 344.48,
   "text": "نشون نمی‌ده. به وقتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.48,
   "end": 350.22,
   "text": "چیجوری دست پا می‌شکونه تا به مسئولیتی، ریاستی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.22,
   "end": 353.24,
   "text": "اگر اینم رد شد واقعا دیدی نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.24,
   "end": 358.86,
   "text": "ریاست طلب هم نیست دنبال ریاست و مدیریت و چه و این‌ها هم نیست دیگه بله ایشون ترازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.86,
   "end": 361.82,
   "text": "می‌تونه معلم اخلاق خوبی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.82,
   "end": 368.2,
   "text": "الله اکبر. حالا خب چه ربطی داشت به مباحث روز و سیاسی و اجتماعی و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.2,
   "end": 373.86,
   "text": "یعنی متأسفانه انحرافی و تحریفی دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.86,
   "end": 378.3,
   "text": "نمیدونم شما هم دقت کردید دیدید یا نه از سازمان زیبایشی-- زیباسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.3,
   "end": 383.4,
   "text": "شهرداری تهران چند تا بیلبورد زده بود عکس حاج قاسم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.4,
   "end": 390.14,
   "text": "بعد این جمله رو نوشته بود زیرش با دستخط خود حاج قاسم نوشته بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.14,
   "end": 394.36,
   "text": "من هرگز نمی‌خواستم سلاح دست بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.36,
   "end": 401.2,
   "text": "همین. تمام. من می‌خواستم مخصوصاً اینجا انقدر من حرص خوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.2,
   "end": 405.74,
   "text": "برای خودم تعجب داشت که از شهرداری دیگه بعیده با بودن آیزه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.74,
   "end": 409.54,
   "text": "این نفوذه دیگه. خب حاج قاسم اینجا جمله‌اش تموم نمی‌شه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.54,
   "end": 415.14,
   "text": "ولی ایشون تموم کرده. ببین اول میان سد های ذهنی رو در عملیات روانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.14,
   "end": 422.28,
   "text": "در عملیات رسانه‌ای حتی تو بحث در بستر فرهنگی عملیات میخوان بکنن، بستر، بستر فرهنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.28,
   "end": 424.14,
   "text": "اما وقتی ما میاییم میگیم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.14,
   "end": 430.86,
   "text": "صرفاً کار فرهنگی تمامه کار رو مثلاً در خصوص بی‌حجابی و بدحجابی کار فرهنگی اکتفا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.86,
   "end": 434.88,
   "text": "وقتی اینطوری فکر می‌کنی ذهن خیال باطل اینطوری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 434.88,
   "end": 439.0,
   "text": "میان تو همین بستر فرهنگی ما کار ضد فرهنگی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.0,
   "end": 441.32,
   "text": "سد ذهنی رو که شکستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.32,
   "end": 447.26,
   "text": "ذهن ما اینطوری شکل گرفت که عه پس حاج قاسم انگار با اکراه اسلحه دستش گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 447.26,
   "end": 450.08,
   "text": "چون میگه من نمی‌خواستم اسلحه دست بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.08,
   "end": 452.42,
   "text": "انگار یه اجباری بالا سرش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 452.42,
   "end": 455.4,
   "text": "حاکمیت زورش کرده و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 455.4,
   "end": 459.88,
   "text": "سد ذهنی رو که شکستند، سد عینی شکسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 459.88,
   "end": 461.54,
   "text": "سد عینی شکسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 461.54,
   "end": 465.64,
   "text": "در مقابله با مقا-- مثلاً دشمنان مقاومت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.64,
   "end": 468.62,
   "text": "آدم‌های مقاوم کم میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.62,
   "end": 476.66,
   "text": "ادامه‌اش اینه. بله حاج قاسم فرمود هرگز نمی‌خواستم سلاح دست بگیرم اما این اماشو با شیطنت نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.66,
   "end": 482.98,
   "text": "اما به خاطر مبارزه با ظلم و به خاطر خدا می‌جنگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.98,
   "end": 487.02,
   "text": "اینو نیاوردن. خب اون-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 487.02,
   "end": 490.9,
   "text": "دیگه آورده جان؟ تابلوهای دیگه اینو آورده با آدم‌هایی که می‌جنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 490.9,
   "end": 493.7,
   "text": "خب باز، باز می‌شه گفت شیطنت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 493.7,
   "end": 496.22,
   "text": "چرا یه جا آوردی، یه جا نیاوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.22,
   "end": 500.58,
   "text": "من که هرچی دیدم این جمله اول هر جا دیدم همین جمله اول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.58,
   "end": 504.3,
   "text": "ما دقت کردیم این جمله بود ولی بعضی تابلوهای دیگه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.3,
   "end": 506.7,
   "text": "بعضی جاهای دیگه بعدی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.7,
   "end": 511.28,
   "text": "آوردن. فقط بعدیشو آوردن. تفتیش کرده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.28,
   "end": 518.26,
   "text": "اینم خود شیطنته دیگه. باید حواسمون جمع باشه و الان رسانه، رسانه خط مقدم جبهه فرهنگی نظام اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.26,
   "end": 520.54,
   "text": "باید داد بزنیم. باید بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.54,
   "end": 522.72,
   "text": "اصلاً این صحبت امروز منو بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.72,
   "end": 525.8,
   "text": "بگین بدون لینک بچه‌ها بذارن تو کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.8,
   "end": 528.86,
   "text": "فوروارد کنن همه جا. منم که کسی نمیشناسه این کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.86,
   "end": 530.98,
   "text": "ولی اصل حرف که درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.98,
   "end": 536.32,
   "text": "اونجا امام عسکری صلوات الله علیه فرمودن که شخصیت ترازو برو، برو، برو تا کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 536.32,
   "end": 540.72,
   "text": "تا جایی که دیگه میدونی مطمئن میشی اون بالا ریاست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.72,
   "end": 544.82,
   "text": "اون خونه آخره. حاج قاسم یادتونه زمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.82,
   "end": 550.7,
   "text": "بهش پیشنهاد دادند که بیاد برای ریاست جمهوری واقعاً هم به نظر شما چیزی کم داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.7,
   "end": 552.88,
   "text": "حاج قاسم چیزی کم داشت برای ریاست جمهوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 552.88,
   "end": 556.58,
   "text": "قطعاً رای می‌آورد با اون اعتبار مردمی که داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 556.58,
   "end": 559.52,
   "text": "از هر حیث‌ها. از حیث مال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 559.52,
   "end": 564.86,
   "text": "هرچی شما بخوای. موقعیت اجتماعی، جایگاه اجتماعی، مدیریت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 564.86,
   "end": 571.82,
   "text": "جواب ایشون چی بود؟ چقدرم پیچیده بود که آره ایشون دنبال ریاست جمهوری رفته سپاه قدس رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.82,
   "end": 573.42,
   "text": "چه جمله‌ی جالبی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.42,
   "end": 576.64,
   "text": "من ترجیح میدم کاندیدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.64,
   "end": 581.72,
   "text": "ترکش و تیر باشم، تیر و ترکش باشم تا کاندیدای ریاست جمهوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.72,
   "end": 585.28,
   "text": "ببین چجوری زده بالا پر ریاست طلبی رو ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 585.28,
   "end": 589.76,
   "text": "بعد ماها یا خود رهبر عزیزمون که جلو دار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 589.76,
   "end": 591.74,
   "text": "چطور میشه که تو نه دе",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 591.74,
   "end": 597.44,
   "text": "مثلاً که امروز سالگردشه مردم اونطوری پشت سر رهبر قیام کنن خودجوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.44,
   "end": 601.26,
   "text": "خب یه همچین کسی رو جلو خودشون میبینن، جلو دار میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 601.26,
   "end": 604.82,
   "text": "بله البته کلید واژه‌اش از قصه عاشورا خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 604.82,
   "end": 606.66,
   "text": "خیمه‌های امام حسین رو آتیش زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 606.66,
   "end": 611.44,
   "text": "حماقت محضشون بود که دیگه واقعاً از درون حب امام حسین از درون جوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.44,
   "end": 613.1,
   "text": "اون کلیپ خیلی شیرین رو دیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.1,
   "end": 619.36,
   "text": "چند روز پخش شد که از نمیدونم نه تا ده تا چقدر بچه‌های مثلاً جوون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.36,
   "end": 624.42,
   "text": "به قول ماها تازه به دوران رسیده‌ای که قیافه‌ها وحشتناکه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.42,
   "end": 628.5,
   "text": "اِاِاِ وحشت می‌کنی قیافه طرفو نگاه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 628.5,
   "end": 632.1,
   "text": "اصلاً نه، نه به عرق ملی مون می‌خوره، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 632.1,
   "end": 638.14,
   "text": "دینیمون. از تک تک اونا طرف می‌پرسه آقا شمال یا مشهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 638.14,
   "end": 640.76,
   "text": "همشون می‌گن صد درصد مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 640.76,
   "end": 644.46,
   "text": "یکیشون می‌گه شمال بعد می‌ریم مشهد توبه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 644.46,
   "end": 647.3,
   "text": "آره خب این عرق تو وجودشونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.3,
   "end": 651.44,
   "text": "درسته به-- به خاطر بالاخره خیمه‌های امام حسین رو آتیش زدن و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.44,
   "end": 654.54,
   "text": "ولی خب رهبر رو جلو-- جلو دار دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 654.54,
   "end": 661.5,
   "text": "که رهبری که همه دیدیم دیگه چندین بار دیدیم که اون روزی که ایشونو می‌خواستن برای رهبری انتخاب کنن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.5,
   "end": 663.56,
   "text": "خبرگان گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 663.56,
   "end": 665.48,
   "text": "کدوم-- شما یه نمونه سراغ بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.48,
   "end": 671.26,
   "text": "یه نفر می‌خوان مسئولیتی بهش بدن گریه کنه پس بزنه آقا برای چی می‌خوای به من مسئولیت بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 671.26,
   "end": 673.14,
   "text": "هی استنباط میاد می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 673.14,
   "end": 675.78,
   "text": "هی دلیل و مدرک می‌آورد که نه اشتباه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 675.78,
   "end": 680.52,
   "text": "نکنید این کارو. گریه کرد آخر وقتی ایشون رای آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.52,
   "end": 682.46,
   "text": "یعنی این. یعنی خود ساخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 682.46,
   "end": 685.0,
   "text": "یعنی ایشون می‌تونه جلودار باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 685.0,
   "end": 688.5,
   "text": "اینه که مردم اینطوری پشت سرش راه می‌افتادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 688.5,
   "end": 693.88,
   "text": "ما اگر امثال حاج قاسم‌ها رو هم بخوایم بزنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 693.88,
   "end": 697.96,
   "text": "اون موقع دیگه من نمی‌دونم چه حرفی برای گفتن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.96,
   "end": 704.7,
   "text": "الان که یمن با دست خالی با دمپایی پاره رو افتاده جلو آمریکا وایساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 704.7,
   "end": 707.22,
   "text": "کشتی اسرائیلی رو اونطوری می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.22,
   "end": 710.9,
   "text": "الان حالا من بیانیه یمن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 710.9,
   "end": 714.52,
   "text": "برای آمریکا نوشته بودم براتون بخونم دیگه فرصت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 714.52,
   "end": 720.0,
   "text": "یه قسمتشو براتون بخونم ببینید کیا برای کی داره رجز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 720.0,
   "end": 729.08,
   "text": "تو قسمت پنجمش میگه دشمن آمریکایی باید به هشدارهای فرمانده ما در آخرین سخنرانی ایشان توجه کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 729.08,
   "end": 733.64,
   "text": "میگه آمریکا باید توجه کنه به فرمایش رهب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 733.64,
   "end": 737.16,
   "text": "فرمانده ما. ایشان اهل عمل هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 737.16,
   "end": 740.08,
   "text": "یعنی هرچی بگه همونه و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 740.08,
   "end": 745.74,
   "text": "و بر خدای مقتدر و توانا تکیه دارند و مورد حمایت هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 745.74,
   "end": 748.76,
   "text": "داره به آمریکا اینطوری یمن اینطوری رجز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 748.76,
   "end": 755.02,
   "text": "بعد می‌زنه. الان یه زمانی فقط ایران می‌جنگید الان اما الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 755.02,
   "end": 761.46,
   "text": "یه کشور یه استانش ایرانه، یه استانش یمنه، یه استانش عراقه، یه استانش سوریه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 761.46,
   "end": 764.22,
   "text": "همین امروز چند تا پایگاه آمریکایی رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 764.22,
   "end": 771.9,
   "text": "تو سوریه و تو عراق. ببین تبدیل شده جبهه مقاومت به یه جبهه یا اصلاً یه استان چند منظوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 771.9,
   "end": 774.7,
   "text": "همه این‌ها به رهبری این حکیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 774.7,
   "end": 776.84,
   "text": "مقتدر و اندیشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 776.84,
   "end": 779.8,
   "text": "خدا به آبروی زهرا صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 779.8,
   "end": 782.6,
   "text": "طول عمر با برکت به این آقا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 782.6,
   "end": 786.94,
   "text": "قرن-- اون بیرونی‌ها بیشتر ایشونو می‌شناسن تا ما متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 786.94,
   "end": 788.74,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 788.74,
   "end": 791.68,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 791.68,
   "end": 799.52,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}