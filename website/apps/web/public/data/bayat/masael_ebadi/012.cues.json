 "chapters": [
  {
   "index": 0,
   "title": "## از تفرقه به جماعت؛ ید الله فوق ایدیهم",
   "start": 12.76,
   "end": 76.56
  },
  {
   "index": 1,
   "title": "## سیرِ الهیت در تاریخِ انبیا",
   "start": 76.56,
   "end": 353.38
  },
  {
   "index": 2,
   "title": "## انقلاب؛ خون بر شمشیر و انفجارِ نور",
   "start": 353.38,
   "end": 422.02
  },
  {
   "index": 3,
   "title": "## امپراتوریِ دروغ و مشارکتِ مردم",
   "start": 422.02,
   "end": 442.64
  },
  {
   "index": 4,
   "title": "## شرمندگیِ تهران و نقدِ رفاه‌پرستی",
   "start": 442.64,
   "end": 882.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 3.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.86,
   "end": 8.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.84,
   "end": 12.76,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.76,
   "end": 20.26,
   "text": "جای شکر و جبهه سپاس ساییدن در درگاه حضرت حق دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.26,
   "end": 23.48,
   "text": "چنین قلوب متشتت مردم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.48,
   "end": 27.82,
   "text": "از اون تفرق به جماعت بدل کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.82,
   "end": 31.82,
   "text": "البته که يد الله فوق أیدیهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.82,
   "end": 39.22,
   "text": "این همه تلاش و کوششی که دشمنان و معاندین از داخل و خارج کردن که مردم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.22,
   "end": 41.96,
   "text": "مایوس کنند از شرکت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.96,
   "end": 44.9,
   "text": "انتخابات. ولی الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.9,
   "end": 48.2,
   "text": "علی رغم این همه تلاش‌های مضبوحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.2,
   "end": 52.04,
   "text": "به فضل الهی با توجه به همه مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.04,
   "end": 54.56,
   "text": "نتیجه چشمگیری حاصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.56,
   "end": 56.84,
   "text": "واقعا دست تک تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.84,
   "end": 61.88,
   "text": "مردم رو باید بوسید. عزیزانی که در این زمینه زحمت کشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.88,
   "end": 66.42,
   "text": "و تلاش کردن، نفس زدن، تبیین کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.42,
   "end": 69.38,
   "text": "رغبت ایجاد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.38,
   "end": 71.4,
   "text": "و مردم رو دعوت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.4,
   "end": 81.84,
   "text": "هر کسی در هر حالا شما وقتی نگاه می‌کنی به قصه این سیر الهیت نظام هستی رو که آنف آن در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.84,
   "end": 88.14,
   "text": "فعالیت است تا قابلیت چه باشد از همان ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.14,
   "end": 90.78,
   "text": "به منصه ظهور آمدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.78,
   "end": 97.0,
   "text": "رسالت انبیا بگیر ببینید انبیا یک یک چه سختی‌هایی رو متحمل شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.0,
   "end": 100.46,
   "text": "فراعنه زمان چگونه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.46,
   "end": 102.5,
   "text": "نوح رو مسخره کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.5,
   "end": 106.62,
   "text": "الاعوذ بالله که این پیرمرد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.62,
   "end": 110.46,
   "text": "خشکی داره کشتی می‌سازه و آنچنان خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.46,
   "end": 115.14,
   "text": "نجات داد قوم حضرت رو به اتفاق حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.14,
   "end": 116.86,
   "text": "به صورت باور نکردنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.86,
   "end": 119.18,
   "text": "چگونه حضرت موسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.18,
   "end": 122.42,
   "text": "آنچنان دریا رو براش شکافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.42,
   "end": 125.06,
   "text": "و معجزه کرد؟ چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.06,
   "end": 134.34,
   "text": "حضرت ابراهیم خلیل رو کن و برد یا نار کن و برد و سلام و آتش رو براش برد و سلام کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.34,
   "end": 136.96,
   "text": "خنک و سلامت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.96,
   "end": 138.88,
   "text": "و او رو نجات داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.88,
   "end": 143.56,
   "text": "همچنین می‌آید تا پیغمبر عزیز عالم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.56,
   "end": 146.18,
   "text": "معروف بودند به یتیم عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.18,
   "end": 151.74,
   "text": "چگونه اون بزرگوار که سلام و صلوات و درود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.74,
   "end": 156.62,
   "text": "خدای منّان و ملائکه مقربش و اولیایش بر او و خاندانش باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.62,
   "end": 160.48,
   "text": "چگونه با دست خالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.48,
   "end": 166.68,
   "text": "بین اون جاهلیت عجیب و غریب اون زمان امپراتوری اسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.68,
   "end": 173.08,
   "text": "ایجاد کرد. و اگرچه زمانه دست به دست هم دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.08,
   "end": 179.92,
   "text": "و فرزندان ایشون رو منتسبین به ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.92,
   "end": 187.68,
   "text": "یک یک از لب تیغ گذروندن، زندان کردن، در حصر قرار دادن، اذیت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.68,
   "end": 192.4,
   "text": "می‌بینید ابا عبدالله در اوج غربت همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.4,
   "end": 198.52,
   "text": "به شهادت می‌رسه در حالی که به صغیر و کبیر حضرت رحم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.52,
   "end": 207.62,
   "text": "به قول شیخ جعفر شوشتری در حالی علی اصغر امام حسین صلوات الله علیه مظلومانه رو دست‌های حضرت پرپر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.62,
   "end": 210.94,
   "text": "که قریب به شش هزار فرزند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.94,
   "end": 214.1,
   "text": "شیرخوار در گهواره‌های طرای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.1,
   "end": 216.94,
   "text": "بنی امیه و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.94,
   "end": 221.48,
   "text": "و آل مروان بودند در مواجهه با حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.48,
   "end": 225.84,
   "text": "ولی باز يد الله فوق أیدیهم همچنین میاید جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.84,
   "end": 230.32,
   "text": "ما خیلی سال‌های پیش بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.32,
   "end": 235.52,
   "text": "مشرف بودیم حرم بی بی جانمون حضرت رقیه سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.52,
   "end": 240.54,
   "text": "وقتی از اون ستاره درخشان نشان بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.54,
   "end": 243.8,
   "text": "گیتی بیرون می‌آید از حرم بی بی جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.8,
   "end": 246.32,
   "text": "وارد می‌شی که اون کوچه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.32,
   "end": 249.6,
   "text": "سمت چپت مسجد امویست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.6,
   "end": 255.64,
   "text": "و روبروش کاخ یزید که کنگره‌هاش ریخته و هنوز نیمه کاره هم تو راه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.64,
   "end": 257.84,
   "text": "بغلش یه حالت زیرزمینی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.84,
   "end": 262.7,
   "text": "اون یزید فرعون زمانش با اون تاج و تخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.7,
   "end": 265.92,
   "text": "یادمه که یه پیرزنی اونجا دم در نشسته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.92,
   "end": 267.56,
   "text": "پول می‌گرفت راهنمایی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.56,
   "end": 272.66,
   "text": "ملت می‌رفتن جسارتا نجاست می‌کردن رو قبر یزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.66,
   "end": 275.98,
   "text": "ببینید اون آمریکا زمان خودش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.98,
   "end": 277.88,
   "text": "صهیونیست زمان خودش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.88,
   "end": 281.7,
   "text": "فرعون زمان خودش بود. الان وضعش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.7,
   "end": 285.12,
   "text": "بعد ابا عبدالله ما چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.12,
   "end": 290.24,
   "text": "خورشید وجودش حسین نوری‌ست که هرگز خاموش نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.24,
   "end": 293.16,
   "text": "جهان رو تحت شعاع خودش قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.16,
   "end": 297.16,
   "text": "همچنین بیا تا امام زمان عزیزمون چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.16,
   "end": 299.2,
   "text": "این همه اجدادشون رو کشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.2,
   "end": 302.76,
   "text": "اما حضرت به يد قدرت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.76,
   "end": 306.32,
   "text": "باقی و برقرار. الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.32,
   "end": 309.38,
   "text": "و ان شاء الله روزی خواهد آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.38,
   "end": 312.7,
   "text": "و اون خلاصه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.7,
   "end": 319.64,
   "text": "نتیجه دین الهی که لیظهره على الدين كله و لو کره المشركون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.64,
   "end": 322.36,
   "text": "ظهور خواهد داد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.36,
   "end": 332.44,
   "text": "یکپارچه همه جهان رو پر از عدل و داد و نور این يد الله فوق أیدیهم این الهیت نظام رو شما وقتی نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.44,
   "end": 336.26,
   "text": "دلت قوص محکم می‌شه. بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.26,
   "end": 340.5,
   "text": "فرعون‌ها میرن. عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.5,
   "end": 343.48,
   "text": "سیاهی بر دل زغال می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.48,
   "end": 346.82,
   "text": "و می‌بینید حتی تا انقلاب خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.82,
   "end": 353.38,
   "text": "کی باورش می‌شد که واقعا خون بر شمشیر یک بار دیگه پیروز بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.38,
   "end": 355.4,
   "text": "کی باور می‌کرد اینو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.4,
   "end": 362.88,
   "text": "خود انقلابیون وقتی تو زندان‌ها تحت شکنجه ساواک بودند می‌گفتند ما امیدی به پیروزی نداشتیم فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.88,
   "end": 364.8,
   "text": "وظیفه خودمون رو انجام می‌دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.8,
   "end": 368.44,
   "text": "وقتی هم که انقلاب با ناباورi پیروز شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.44,
   "end": 371.92,
   "text": "و تاج و تخت سلطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.92,
   "end": 374.94,
   "text": "س-ستم شاهی آن چنین ویران شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.94,
   "end": 377.02,
   "text": "امام عزیز اون بی هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.02,
   "end": 379.8,
   "text": "ادعایی فرمودند که نه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.8,
   "end": 382.8,
   "text": "این انقلاب رو پیروز کردم، نه شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.8,
   "end": 384.48,
   "text": "خدا بود که پیروز کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.48,
   "end": 386.86,
   "text": "انقلاب انفجار نور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.86,
   "end": 391.46,
   "text": "ببینید ید الله، این الهیت توجه به الهیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.46,
   "end": 395.34,
   "text": "الهیت نظام و بعد از او هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.34,
   "end": 401.96,
   "text": "فرزند خلفش، جانشین صالح و خلفش، رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.96,
   "end": 406.06,
   "text": "هر بار بحث انتخابات میشه به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.06,
   "end": 409.26,
   "text": "ل-لسان خاصی به همین مضمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.26,
   "end": 412.22,
   "text": "حالا با الفاظ متعدد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.22,
   "end": 415.44,
   "text": "به یک مضمون که تا ببینیم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.44,
   "end": 418.46,
   "text": "قلوب مردم را چگونه هدایت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.46,
   "end": 424.04,
   "text": "شما دقت بفرمایید که چگونه بیش از یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.04,
   "end": 428.08,
   "text": "تمام دشمنان از داخل و خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.08,
   "end": 435.16,
   "text": "سعی در م-مأیوس کردن و ناامید کردن مردم، بدبین کردن مردم به نظام و به داشته هاشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.16,
   "end": 438.6,
   "text": "اینها که دچار خود تحقیرشون کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.6,
   "end": 442.64,
   "text": "با تمام تجهیزات و قوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.64,
   "end": 446.54,
   "text": "سیصد کانال فارسی زبان بر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.54,
   "end": 450.58,
   "text": "انقلاب و دین و ارزش‌های نظام ما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.58,
   "end": 453.72,
   "text": "کشورمون و ایران قوی و مقتدر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.72,
   "end": 456.7,
   "text": "اینها عرض شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.7,
   "end": 459.76,
   "text": "چقدر پول‌ها خرج کردند، چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.76,
   "end": 466.0,
   "text": "امپراتوری دروغ در رسانه‌هاشون داشتند که بزرگ‌ترین سلاح امروز که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.0,
   "end": 467.58,
   "text": "رسانه است دست اونا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.58,
   "end": 469.6,
   "text": "ما رسانه‌ای نداریم. یه رسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.6,
   "end": 476.08,
   "text": "ملی داریم اونم اگرچه خیلی زحمت کشیدند اما در قیاس با رسانه‌های اون‌ها اصلا به حساب نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.08,
   "end": 477.74,
   "text": "رسانه دست اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.74,
   "end": 481.0,
   "text": "ابزار اصلی از جهت سلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.0,
   "end": 484.16,
   "text": "روز و سلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.16,
   "end": 491.08,
   "text": "حالا نه بحث معنوی و الهی، نه بحث طبیعیش رو داریم مادیش فرض می‌کنیم دست اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.08,
   "end": 494.44,
   "text": "یه اپلیکیشن اون‌ها به نام مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.44,
   "end": 496.86,
   "text": "اینستا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.86,
   "end": 503.76,
   "text": "تلگرام چه اینها سر از همه اپلیکیشن‌های ما رو رو هم جمع کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.76,
   "end": 508.16,
   "text": "از همه حیثش، از حیث قدرتش، نفوذش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.16,
   "end": 511.0,
   "text": "از شود آنتن دهیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.0,
   "end": 516.3,
   "text": "اون برنامه‌های اگرچه به دروغ اما اقناعی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.3,
   "end": 519.16,
   "text": "و سرورش و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 519.16,
   "end": 523.06,
   "text": "با تمام این تجهیزات و قوا با خیانت‌هایی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.06,
   "end": 526.62,
   "text": "داخل بعضی از مسئولین مرعوب ما کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.62,
   "end": 530.82,
   "text": "با این همه تحریم، با این همه فشارهای اقتصادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.82,
   "end": 535.34,
   "text": "و سیاسی و هجمه‌ها، آشوب‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.34,
   "end": 539.16,
   "text": "آشوب‌های خیابانی، شما هرچی فکر می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.16,
   "end": 541.2,
   "text": "چیزی نگذشته از آخرین آشوب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 541.2,
   "end": 543.72,
   "text": "این همه زحمت، تلاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.72,
   "end": 548.04,
   "text": "این همه کار تو برای مجلس خودشون در آمریکا، مجلس سنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.04,
   "end": 550.34,
   "text": "قریب به نه میلیارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.34,
   "end": 553.92,
   "text": "دلار هزینه کردن تا مشارکت رو بکشن بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.92,
   "end": 556.28,
   "text": "نهایت به بیست و پنج درصد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 556.28,
   "end": 561.2,
   "text": "در کشورهای مختلف اروپایی و غربی همچنین این‌ها می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.2,
   "end": 564.56,
   "text": "میلیاردها دلار خرج می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.56,
   "end": 569.02,
   "text": "تو خود هر کدوم از اون‌ها دست بگذاری کشورهای غربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.02,
   "end": 572.66,
   "text": "حالا که ادعای دموکراسی و اینها می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.66,
   "end": 577.08,
   "text": "می‌بینی حداکثر مشارکت مردمشون مثلا به سی درصد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.08,
   "end": 579.06,
   "text": "سی و پنج درصد نهایت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.06,
   "end": 585.52,
   "text": "اما داخل این کشوری که این همه تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.52,
   "end": 589.82,
   "text": "نفوذ بیگانه و این همه تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.82,
   "end": 595.2,
   "text": "عرض شود دروغ پردازی، برنامه‌سازی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 595.2,
   "end": 598.3,
   "text": "دشمنی از داخل و خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.3,
   "end": 600.8,
   "text": "ولی باز می‌بینیم با این علیرغم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.8,
   "end": 607.42,
   "text": "اینکه خودشون مدعی بودند که دیگه خیلی بخواد مردم مشارکت کنند بیست درصد نهایت بیست و پنج درصد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 607.42,
   "end": 615.62,
   "text": "باز تقریباً حدود چهل و سه درصد چیزی که اعلام کردن مشارکت مردمی حدوداً مثل دفعه پیش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.62,
   "end": 619.4,
   "text": "یعنی این همه زحماتشون به باد فنا رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.4,
   "end": 624.58,
   "text": "و شما می‌بینید که با اینکه ساختار شکنی‌ها شد این چند ساله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.58,
   "end": 628.2,
   "text": "تو این چهار سال ما عجیب اصلاً سابقه نداشته این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.2,
   "end": 630.76,
   "text": "خطوط قرمز نظام رو بشکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 630.76,
   "end": 634.94,
   "text": "به شخص اول مملکت علناً توهین کنند تو کوچه خیابون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.94,
   "end": 636.56,
   "text": "هشتگ اون‌ها چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.56,
   "end": 640.38,
   "text": "به الله اکبر ما اونطوری جسارت کنند، فحش بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 640.38,
   "end": 642.9,
   "text": "ناسزا بگن و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.9,
   "end": 645.8,
   "text": "ولی باز می‌بینید که خنثی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.8,
   "end": 648.04,
   "text": "این‌ها واقعاً تبیین نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.04,
   "end": 651.2,
   "text": "باریکلا گفتن به مردم نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.2,
   "end": 653.48,
   "text": "جشن ملی نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.48,
   "end": 656.5,
   "text": "واقعاً دست خدا در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 656.5,
   "end": 660.12,
   "text": "خدا نیست که این نظام رو داره مدیریت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.12,
   "end": 666.02,
   "text": "خدا نیست که جلوه کرده، تجلی کرده، ظهور کرده، قلب مردم رو متمایل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.02,
   "end": 669.12,
   "text": "اگرچه ما تهرانی‌ها شرمنده شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.12,
   "end": 675.2,
   "text": "هرچی نگاه می‌کنیم بین شهرهای مختلف هر شهری که کم برخوردار تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.2,
   "end": 677.66,
   "text": "می‌بینی عجیبه که مشارکتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 677.66,
   "end": 682.6,
   "text": "تو انتخابات بیشتره. بعضی از شهرها بیش از شصت درصد نزدیک هفتاد درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 682.6,
   "end": 685.5,
   "text": "شهر‌هایی که کم برخوردارن به قول اصطلاح امروزی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.5,
   "end": 688.44,
   "text": "اما تهران که با این همه امکانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 688.44,
   "end": 695.9,
   "text": "می‌بینی که متأسفانه کمترین مشارکت‌ها رو حدود بیست درصد، بیست و خرده‌ای درصد ظاهراً داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.9,
   "end": 699.5,
   "text": "این شرمندگی ما تهرانی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.5,
   "end": 702.3,
   "text": "و این جواب اوناییه که فکر می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 702.3,
   "end": 705.68,
   "text": "پول و مادیات و رفاه این چیزا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 705.68,
   "end": 709.96,
   "text": "مثلاً حرف اول رو می‌زنه در خوشبختی و دینداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.96,
   "end": 711.86,
   "text": "و این‌ها حرفای عوامانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 711.86,
   "end": 716.78,
   "text": "کسی مخالف با رفاه نیست، کسی موافق با فقر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 716.78,
   "end": 718.98,
   "text": "اما این چنین نیست که شما بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 718.98,
   "end": 722.76,
   "text": "کسی که از جهت مالی وضعش توپ شد، خوب شد، عالی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 722.76,
   "end": 724.88,
   "text": "دیگه دینش هم درستو، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 724.88,
   "end": 729.04,
   "text": "اتفاقاً شما هرچی میری بالا شهر تهران می‌بینی دین کم رنگ‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 729.04,
   "end": 732.08,
   "text": "عرق ملی، بومی، عرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 732.08,
   "end": 735.28,
   "text": "ایرانی بودن کمتره، خودتحقیر بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 735.28,
   "end": 740.66,
   "text": "اتفاقاً اون کسایی که مخالف نظامند بیشتر می‌بینی که از جهت دارایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 740.66,
   "end": 743.96,
   "text": "هزار تا آدم انقلابی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 743.96,
   "end": 748.6,
   "text": "طرفدار نظام و مذهبی رو بذاری دارایی‌ش می‌بینی یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.6,
   "end": 751.38,
   "text": "هزارم یه نفر از اون‌ها نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 751.38,
   "end": 755.96,
   "text": "باز همش مینالن، نق می‌زنن، فحش میدن، ناسزا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.96,
   "end": 758.54,
   "text": "و و و. بماند، درد دل نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 758.54,
   "end": 762.24,
   "text": "اما در هر حال واقعاً این نتیجه معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 762.24,
   "end": 765.4,
   "text": "جز دست الهی چیز دیگری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 765.4,
   "end": 767.58,
   "text": "باید تشکر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 767.58,
   "end": 772.2,
   "text": "باید هم از خدای منان تشکر کرد، نماز شکر خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 772.2,
   "end": 778.98,
   "text": "و عقیده بنده باید الان رسانه ملی بیش از آنکه تلاش کرد تا مردم را به مشارکت حداکثری دعوت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.98,
   "end": 780.62,
   "text": "خدا خیرشون هم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 780.62,
   "end": 783.82,
   "text": "اما بیش از اون باید الان جشن ملی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.82,
   "end": 786.1,
   "text": "بولد کنه، برجسته کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.1,
   "end": 789.34,
   "text": "به ذائقه‌ی مردم این شیرینی بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.34,
   "end": 794.12,
   "text": "بدونن، متوجه باشن که چه حماسه‌ای آفریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 794.12,
   "end": 802.68,
   "text": "که البته نفس رهبر عزیزمون هم خدا سایه‌شون رو بر سر ما مستدام بداره که او هم دست خدا واقعاً بر سر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.68,
   "end": 806.92,
   "text": "که اگر خدای منان این جانشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.92,
   "end": 814.22,
   "text": "خالی از هرگونه دغدغه دنیایی و هوای نفسانی و چه چه بر سر ما قرار نمی‌داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 814.22,
   "end": 819.82,
   "text": "کنار ما و واقعاً سایه‌اش سر ما بعد از حضرت امام نبود، ما چه خاکی بر سرمون می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 819.82,
   "end": 823.82,
   "text": "انشاالله که چه ما باشیم عزیزان، چه نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 823.82,
   "end": 826.26,
   "text": "این پرچم طبق قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 826.26,
   "end": 830.38,
   "text": "خود حضرت حق که ولایت دست اوست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 830.38,
   "end": 834.0,
   "text": "الله ولی الذین آمنو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 834.0,
   "end": 836.46,
   "text": "یخرجهم من الظلمات الی النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 836.46,
   "end": 841.52,
   "text": "انشاالله این پرچم یه روزی به دست صاحب اصلیش خواهد رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 841.52,
   "end": 848.5,
   "text": "و چه ما باشیم چه نباشیم روسیاهی به زغال خواهد نشست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.5,
   "end": 851.46,
   "text": "و اون که الهیت نظامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 851.46,
   "end": 856.86,
   "text": "بیش از هر وقت دیگری جلوه خواهد کرد و تابناک‌تر از هر وقتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 856.86,
   "end": 864.22,
   "text": "دعای سلامتی وجود نازنین رهبر عزیزمون و همه اونایی که در مسیر این انتخاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 864.22,
   "end": 871.26,
   "text": "موفق عمل کردن، زحمت کشیدن، تلاش کردن در هر حیثه مخصوصاً اون‌هایی که تبیین کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 871.26,
   "end": 875.22,
   "text": "و شادی روح امام عزیز و شهدامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 875.22,
   "end": 878.8,
   "text": "و اساتید و اون‌هایی که گردن ما حق داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 878.8,
   "end": 882.68,
   "text": "محبت کنید از صمیم قلبتون صلوات قشنگی ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}