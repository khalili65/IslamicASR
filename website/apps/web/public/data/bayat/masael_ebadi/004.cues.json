   "title": "## حدیث نبوی؛ احداث در مدینه و لعنت قتل",
   "start": 18.72,
   "end": 139.04
  },
  {
   "index": 1,
   "title": "## سیاست‌زدگی و تحریف عاشورا",
   "start": 139.04,
   "end": 227.32
  },
  {
   "index": 2,
   "title": "## داعش؛ زاییدهٔ قدرت و سرمایه",
   "start": 227.32,
   "end": 378.45
  },
  {
   "index": 3,
   "title": "## مقاومت و فرسایش دشمن",
   "start": 378.45,
   "end": 467.55
  },
  {
   "index": 4,
   "title": "## ظلمت سردمداران و جزیرهٔ اپستین",
   "start": 467.55,
   "end": 845.85
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 8.86,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.86,
   "end": 15.44,
   "text": "و به این استعین. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.44,
   "end": 18.72,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.72,
   "end": 23.82,
   "text": "در کتاب کافی مرحوم کلینی اعلی الله مقامه الشریف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.82,
   "end": 26.6,
   "text": "جلد چهار، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.6,
   "end": 30.4,
   "text": "پانصد و شصت و پنج می‌تونید این روایت شریف رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.4,
   "end": 33.76,
   "text": "روایت نبوی‌ست. فرمودن من أحدث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.76,
   "end": 37.44,
   "text": "این روایت پیغمبر تو مدینه بودن فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.44,
   "end": 41.82,
   "text": "من أحدث بالمدينة حدثاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.82,
   "end": 47.04,
   "text": "هر کسی که یه حادثه‌ای در مدینه بیافرینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.04,
   "end": 49.9,
   "text": "ایجاد کنه أو آوى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.9,
   "end": 52.42,
   "text": "محدثاً یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.42,
   "end": 57.26,
   "text": "اون حادثه‌گر رو پناه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.26,
   "end": 61.76,
   "text": "فرمودن که فعليه لعنت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.76,
   "end": 63.9,
   "text": "پس لعنت خدا بر او باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.9,
   "end": 69.2,
   "text": "پیغمبر یه کسی رو بگه لعنت خدا بر او باد، دیگه معلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.2,
   "end": 74.06,
   "text": "چه خبیثیه. سؤال شد که قلت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.06,
   "end": 76.26,
   "text": "پرسید، یه شخصی پرسید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.26,
   "end": 86.5,
   "text": "وما الحدث؟ اون حادثه چیه که اگر اون رو بیافرینه یا کسی پناهش بده اون حادثه‌گر رو لعنت خدا بر او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.5,
   "end": 90.18,
   "text": "پیغمبر فرمود قال القتل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.18,
   "end": 95.36,
   "text": "قتل، کشتن آدم‌ها بی‌گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.36,
   "end": 98.46,
   "text": "یعنی همه اون کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.46,
   "end": 106.52,
   "text": "در شهادت قریبه به صد نفر از عزیزان ما، پرپر شدنشون در حادثه کرمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.52,
   "end": 111.76,
   "text": "نقش داشتن، چه اونایی که پشتیبانی کردن و حتی اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.76,
   "end": 114.36,
   "text": "رضایت دادن و خوشحال شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.36,
   "end": 117.84,
   "text": "چقدر بدبخت و بیچاره‌اند کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.84,
   "end": 120.12,
   "text": "مثلاً توئیت زدن که آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.12,
   "end": 125.44,
   "text": "مردمی که حقشونه، اومدن مثلاً تا ساندیس و شربت بخورن فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.44,
   "end": 128.3,
   "text": "چقدر بدبختن. بعد این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.3,
   "end": 131.1,
   "text": "تو مملکت ما هم نفس می‌کشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.1,
   "end": 134.22,
   "text": "از همین سفره هم دارن ارتزاق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.22,
   "end": 143.78,
   "text": "واقعاً ملعونن و اون متاسفانه سیاستمدارهای ما که با حرف‌های بزک شده و قشنگ و اصلاح طلبانه و چه و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.78,
   "end": 152.38,
   "text": "که آره کِی میشه که کلاً شعار مرگ بر، مرگ بر، لعنت بر، لعنت بر کلاً برچیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.38,
   "end": 155.68,
   "text": "انقدر احمقن جسارت به شما نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.68,
   "end": 159.36,
   "text": "که این حرفشون یعنی کِی میشه آیات قرآن برچیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.36,
   "end": 163.56,
   "text": "ألا لعنت الله على القوم الظالمین مگر تو قرآن نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.56,
   "end": 167.9,
   "text": "انقدر نفهمن یکی هم نیست تو دهن اینا بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.9,
   "end": 171.64,
   "text": "مثل اون ملعونی که برگشت امام حسین رو هم تحریف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.64,
   "end": 174.68,
   "text": "تو مملکت خودمون، تو تیرگون‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.68,
   "end": 182.6,
   "text": "مهممون. امیرالمؤمنین رو هم تحریف کرد که حالا امام حسین مثلا رفته مثلا مذاکره کرده با عمر سعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.6,
   "end": 186.3,
   "text": "به قول رهبر عزیزمون مذاکره نکرد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.3,
   "end": 191.3,
   "text": "آقا با عمر سعد ملعون مذاکره نکرد، دعوتش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.3,
   "end": 193.58,
   "text": "او رو برحذر داشت از این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.58,
   "end": 197.52,
   "text": "مذاکره چیه؟ شما هم بیاید اونا رو دعوت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.52,
   "end": 200.36,
   "text": "اون‌ها رو نصیحت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.36,
   "end": 205.52,
   "text": "این چه ربطی به مذاکره داره و متاسفانه درد زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.52,
   "end": 210.78,
   "text": "حالا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.78,
   "end": 215.16,
   "text": "عرض شود که بخواهیم بگیم که این کار صرفاً داعشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.16,
   "end": 218.38,
   "text": "هیچ ربطی به آمریکا و اسرائیل نداره، باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.38,
   "end": 221.96,
   "text": "این هم معذرت می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.96,
   "end": 224.18,
   "text": "نفهمی عده‌ایه که این‌ها رو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.18,
   "end": 232.44,
   "text": "بنده خودم خب ادعایی ندارم ولی حدود دو سال کار محرمانه در داعش کردم، خدمتتون عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.44,
   "end": 237.42,
   "text": "و هفته‌ای یک بار جلسات محرمانه داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.42,
   "end": 241.24,
   "text": "ما بودیم و سیزده نفر، مجموعاً چهارده نفر بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.24,
   "end": 247.8,
   "text": "هفته‌ای یه بار یکی از فرمانده‌های جبهه مقاومت می‌اومد و مستنداتشون رو پرده پخش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.8,
   "end": 251.42,
   "text": "ما می‌دیدیم. از درون با داعش آشنا می‌شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.42,
   "end": 254.8,
   "text": "صحنه‌هایی دیدیم که امروز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.8,
   "end": 257.06,
   "text": "چند تاشو برای بعضی از همکارام گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.06,
   "end": 260.82,
   "text": "دیگه یکیشون هم تو زا زا شروع کرد گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.82,
   "end": 262.44,
   "text": "گفت تو مریض نشدی اینا رو دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.44,
   "end": 264.74,
   "text": "گفتم چرا چند وقت اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.74,
   "end": 269.08,
   "text": "حالم بد شده بود. تا یک هفته نمی‌تونستم نه غذا بخورم، نه شب بخوابم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.08,
   "end": 274.7,
   "text": "اگر مردم می‌دونستن که چه بلایی میخواد توسط داعش سرشون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.7,
   "end": 284.2,
   "text": "و جالبه که بدونید خب این‌ها جزو خاطرات خود هیلاری کلینتون هست دیگه تو اون خاط-- کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.2,
   "end": 287.2,
   "text": "معروفش که خودش ادعا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.2,
   "end": 290.26,
   "text": "که از صد تا کشور سفر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.26,
   "end": 293.9,
   "text": "و داعش زاییده دست آمریکا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.9,
   "end": 297.22,
   "text": "زاییده دست اسرائیل بود. این‌ها رو جمع‌آوری کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.22,
   "end": 299.5,
   "text": "و مستنداتی رو دیدم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.5,
   "end": 303.4,
   "text": "داعش از درون یعنی فیلم‌های خودشان بود که دست بچه های مقاومت افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.4,
   "end": 305.44,
   "text": "بچه های تیم حاج قاسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.44,
   "end": 314.04,
   "text": "رحمة الله علیه که مثلا بچه های کوچولو هنوز به سن تکلیف نرسیده رو اینا رو آموزش میدادن چجوری سر ببرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.04,
   "end": 316.74,
   "text": "و مخصوصا اگر ایرانی بود چجوری ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.74,
   "end": 320.76,
   "text": "فرق می‌کرد. سر بریدن ایرانی‌ها با اونای دیگه فرق می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.76,
   "end": 325.96,
   "text": "بعد این بچه چه می‌فهمه؟ از اون بچگی بعد آدم می‌خوابوند، یعنی بچه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.96,
   "end": 329.16,
   "text": "که از مقاومت اسیر شده بود می‌خوابوندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.16,
   "end": 331.82,
   "text": "کاردو می‌ذاشتن دست بچه، خب شروع کن بریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.82,
   "end": 333.54,
   "text": "نه اینطوری غلطه، اینطوری ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.54,
   "end": 337.8,
   "text": "حالا اون زیر داره طرف دست و پا می‌زنه، بره به این بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.8,
   "end": 341.9,
   "text": "طریقه‌ی آموزش سر بریدن یاد میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.9,
   "end": 345.36,
   "text": "به به، به به. تو این پنج سال حکومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.36,
   "end": 348.6,
   "text": "داعش، پنج سال حدوداً حکومت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.6,
   "end": 351.4,
   "text": "حالا بعضیا هم اشکال می‌کنن حاج قاسم تو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.4,
   "end": 355.62,
   "text": "عه صدایی که حالا یا اون تصویری که صدا و سیما پخش می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.62,
   "end": 358.78,
   "text": "کمتر از نمی‌دونم سه ماه چقدر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.78,
   "end": 362.18,
   "text": "پایان حکومت داعش، پس چرا هنوز هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.18,
   "end": 367.35,
   "text": "یه دهن کجی می‌کنن. این‌ها نمی‌فهمن که حکومت داعش رو برچیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.35,
   "end": 370.33,
   "text": "حکومت داعش نه این حالا تک و توک از نابشون رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.33,
   "end": 374.01,
   "text": "بله حکومت داعش و پنج سال حکومت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.01,
   "end": 381.61,
   "text": "شوخیه مگه؟ نود درصد شاه‌های سوریه در اختیارشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.61,
   "end": 386.11,
   "text": "تا نود و پنج درصد هم بعضیا گفتن سوریه دستشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.11,
   "end": 391.19,
   "text": "چهار تا استان مهم عراق تا پنج تا استان تقریباً دستشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.19,
   "end": 393.25,
   "text": "دیگه همه حلفشون هم که ایران بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.25,
   "end": 396.91,
   "text": "تو اون پنج سال خلافت این ملعون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.91,
   "end": 399.53,
   "text": "یک بار فقط تو بلندی‌های جولان بود کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.53,
   "end": 402.63,
   "text": "اینا آتیش اشتباها ریختن سمت اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.63,
   "end": 404.83,
   "text": "نمی‌دونم یادتون باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.83,
   "end": 407.43,
   "text": "سریع عذرخواهی کردن از اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.43,
   "end": 412.67,
   "text": "مگه یادتون نیست که مجروحین داعش می‌رفتن تو اسرائیل مداوا می‌شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.67,
   "end": 417.19,
   "text": "اینا یعنی چی؟ حالا بیاییم هی بشینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.19,
   "end": 420.41,
   "text": "خیال بافی بکنیم که بابا اینا حالا یه چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.41,
   "end": 423.11,
   "text": "مثلاً ااا مزدور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.11,
   "end": 426.33,
   "text": "خارجی بودن وارد شده بودن نفوذ کرده بودن از داعش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.33,
   "end": 432.87,
   "text": "عوامل مثلاً اضافه‌های تفاله‌های داعش بودن هیچ ربطی به آمریکا، اسرائیل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.87,
   "end": 437.55,
   "text": "مگه میشه ربط نداشته باشه؟ اصلاً اینا نطفه‌شون رو آمریکا بست، اسرائیل بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.55,
   "end": 439.55,
   "text": "یعنی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.55,
   "end": 448.35,
   "text": "اتفاقاً تحلیل‌گرایی که میشه به تحلیلشون اکتفا کرد و میشه اون‌ها رو واقعاً یه تحلیلگر دونست هرکی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.35,
   "end": 453.75,
   "text": "هرچی میگه نه. میگن که وضعیت جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 453.75,
   "end": 459.05,
   "text": "اسرائیل و غزه چنان و حماس چنان فرسایشی شده که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.05,
   "end": 462.39,
   "text": "دیدید دیگه تا-- دیگه رسید به هزار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.39,
   "end": 465.73,
   "text": "از تخریب و منهدم شدن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.73,
   "end": 468.81,
   "text": "خودروهای جنگیشون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.81,
   "end": 470.37,
   "text": "تانک مرکاوا، اون جدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.37,
   "end": 472.21,
   "text": "یعنی هزار تا اون، هزار تا این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.21,
   "end": 475.13,
   "text": "شوخی نیست با دست خالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.13,
   "end": 477.91,
   "text": "بعد شهدای مثلاً مقاومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.91,
   "end": 480.63,
   "text": "شه– شهدای حزب‌الله چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.63,
   "end": 484.79,
   "text": "صد و بیست تا. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.79,
   "end": 491.25,
   "text": "سه برابر اون آماری که خود اسرائیل داره میده رسماً اینا کشته دادن، مجروح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.25,
   "end": 494.53,
   "text": "خودشونم می‌دونن. چون فرسایشی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.53,
   "end": 497.39,
   "text": "دیگه واقعاً اینا دنبال این هستن که یه جوری فرار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.39,
   "end": 500.93,
   "text": "منتها ترسشون از اینه که ایران بیاد وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.93,
   "end": 508.25,
   "text": "این اتفاقی که افتاد در حقیقت یه نوع ترسوندن ایران بود که نیاد وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.25,
   "end": 513.55,
   "text": "ایران مثلاً بترسونن که ما هنوز از نابمون هستیم و یه تحلیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.55,
   "end": 517.55,
   "text": "می‌تونه باشه که ایران اگر بره کار تمومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.55,
   "end": 526.27,
   "text": "و اگرچه که ایران حالا من فرصت ندارم نوشتم یه وقت دیگه‌ای براتون یه تحلیل انشاالله شاید هفته بعد ارائه بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.27,
   "end": 529.83,
   "text": "یک یک رد پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 529.83,
   "end": 535.99,
   "text": "انتقام‌های جدی و پاسخ‌های سختی که ایران به اون‌ها داده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.99,
   "end": 538.13,
   "text": "که عده‌ای میگیم پس چی شد انتقام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 538.13,
   "end": 541.77,
   "text": "پس چی شد پاسخ؟ خب خیلیاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.77,
   "end": 548.37,
   "text": "گفته نمیشه و اصلاً سیاست‌های کلان نظام ما اینطوری هست که گفته نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.37,
   "end": 553.81,
   "text": "بعداً بهتون میگم که چه ها کردن تو همین یکی دو سال گذشته بچه‌های ما اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.81,
   "end": 558.81,
   "text": "چه کارهای بزرگی رو کردن که اهلش می‌دونن انشاالله خدمتتون عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.81,
   "end": 563.21,
   "text": "که این‌ها واقعاً شما وقتی نگاه می‌کنی ختم کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 563.21,
   "end": 569.79,
   "text": "یک سیاهی عجیبی رو دنیا گرفته، یک پلیدی عجیبی رو، یک ظلمت سرایی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 569.79,
   "end": 573.13,
   "text": "اون ملئت ظلم و جورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.13,
   "end": 577.79,
   "text": "خیلی جالبه. زمان جنگ ما فکر می‌کردیم یعنی همه آلوده میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.79,
   "end": 587.65,
   "text": "الان می‌بینیم این همه باورتون میشه شش هزار راهپیمایی در حمایت از فلسطین، شش هزار راهپیمایی در کل دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 587.65,
   "end": 592.01,
   "text": "خب اینا همه فاسدن. اینا همه علیه عذرا الله عوضین، کافر مشرکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 592.01,
   "end": 595.41,
   "text": "اینا انسانیت سرشون نمیشه که اومدن وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 595.41,
   "end": 597.97,
   "text": "خیلیاشون اصلاً مسلمون هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 597.97,
   "end": 599.65,
   "text": "پس این چیه ملئت ظلم و جور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 599.65,
   "end": 605.31,
   "text": "داریم می‌رسیم به اون. ببین یک عالم فرهیخته مثل، مثل حضرت آقا علامه‌ حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 605.31,
   "end": 608.89,
   "text": "با ذره‌بین طهارت نفس می‌تونه اینو تشخیص بده ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.89,
   "end": 614.47,
   "text": "متوجه کنه که آقا اون یعنی سردمدر، سردمدارا یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 614.47,
   "end": 616.77,
   "text": "آدمای کت و کلف مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 616.77,
   "end": 620.43,
   "text": "مدیرا چه می‌دونم رهبرانه که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 620.43,
   "end": 625.09,
   "text": "ملئت ظلم-- اونا خیلی به شدت ظلم می‌کنن بر مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 625.09,
   "end": 629.71,
   "text": "الان این هست دیگه. یه اونا تعدادشون کمه ولی خب حاکمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 629.71,
   "end": 632.51,
   "text": "اینا بعد، بعد شما وقتی میری نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 632.51,
   "end": 638.03,
   "text": "می‌بینی که به شدت مشکلات اخلاقی، سیاسی، اجتماعی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 638.03,
   "end": 642.89,
   "text": "کی اینا رو سر کار آورده؟ سرمایه، قدرت و سرمایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 642.89,
   "end": 648.15,
   "text": "قدرت و سرمایه حرف اول رو اونجا نظام سرمایه‌داریه دیگه حرف اول رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 648.15,
   "end": 650.97,
   "text": "حالا خسته‌تون نکنم. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 650.97,
   "end": 654.55,
   "text": "آمار رو من دیدم البته اگه کسی خواست جدولش رو هم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 654.55,
   "end": 657.57,
   "text": "تو فضای مجازی هم بعضاً دیدم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 657.57,
   "end": 661.41,
   "text": "که این جفری اپستین که می‌دونید ماره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 661.41,
   "end": 664.61,
   "text": "اون جزیره‌ای که دستش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 664.61,
   "end": 666.89,
   "text": "حالا فکر کنم یادم بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.89,
   "end": 671.03,
   "text": "که بچه‌های زیر هجده سالو چه پسر، چه دختر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 671.03,
   "end": 673.25,
   "text": "خریداری می‌کرد یا می‌دزدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.25,
   "end": 676.69,
   "text": "یه به هر حال سلسله‌ای بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.69,
   "end": 680.05,
   "text": "می‌بردن اونجا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.05,
   "end": 683.05,
   "text": "بیچاره‌ها رو این بچه‌ها رو اونجا دفن می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.05,
   "end": 688.05,
   "text": "هرکس که می‌خواست تجاوز به این بچه‌ها جسارتاً بکنه یه پول کلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 688.05,
   "end": 693.35,
   "text": "به این ملعون خبیث می‌داد که چهار سال پیش تو حدوداً تو زندان جون داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 693.35,
   "end": 697.39,
   "text": "این ملعون. بعد می‌رفتن اونجا به بچه‌ها تا– تجاوز می‌کردن می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.39,
   "end": 700.79,
   "text": "بعد الان آمار یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 700.79,
   "end": 704.03,
   "text": "چیزی که پیش خود ایشون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 704.03,
   "end": 709.51,
   "text": "به قول خودش مثلاً نوشته بوده چه کسایی به من رجوع کردن، مشتریای من کی بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 709.51,
   "end": 712.83,
   "text": "که خودش visitor بوده دیگه. کیا بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 712.83,
   "end": 718.25,
   "text": "بیرون اومده. حالا من چند تاشو خیلی من همه رو هم نوشتم اینا یعنی یه صفحه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 718.25,
   "end": 720.19,
   "text": "چند تاشو براتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 720.19,
   "end": 723.61,
   "text": "مخ‌تون سود می‌کشه. کسایی که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 723.61,
   "end": 730.41,
   "text": "واضح و روشن فاش شده که اینا رفتن چندین بار تو اون سرزمین ملعونای خبیث دلار، دلار، دلار خرج کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 730.41,
   "end": 733.15,
   "text": "تا مثلاً تجاوز کنن کسفت کنن بعد دوباره برگردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 733.15,
   "end": 737.97,
   "text": "بعد اینا، اینا همینا که الان می‌خوام اسمشونو ببرم اینا بعضیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 737.97,
   "end": 740.57,
   "text": "صراحتن گفتن ما نماینده خدا رو زمینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 740.57,
   "end": 743.03,
   "text": "به ما وحی میشه. ما اومدیم برای نجات مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 743.03,
   "end": 745.61,
   "text": "انقدر مردم رو کودن فرض کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 745.61,
   "end": 751.31,
   "text": "واقعاً دیگه عصر، عصر حظ-حضور مردم و ظهور آقاست انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 751.31,
   "end": 755.11,
   "text": "انشاالله یعنی دیگه واقعاً ملئت ظلم و جور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 755.11,
   "end": 760.55,
   "text": "اولین کسی که اتفاقاً تو اون سر تیترش دیدم همین جو بایدن ملعونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 760.55,
   "end": 765.35,
   "text": "و باراک اوباما، میشل اوباما، بیل کلینتون، هیلاری کلینتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 765.35,
   "end": 769.23,
   "text": "ببینین همه کت و کلفته‌ن. این هیلاری کلینتون خودش میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 769.23,
   "end": 773.87,
   "text": "خودش من از خودش شنیدم، شمام شنیدید گفت از صد تا کشور داعش رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 773.87,
   "end": 779.23,
   "text": "جمع کردیم. یعنی نطفه‌شو اونا بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 779.23,
   "end": 781.67,
   "text": "بعد چقدر دیکاپریو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 781.67,
   "end": 785.09,
   "text": "شارلیز ترون، بن افلک، جیمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 785.09,
   "end": 787.03,
   "text": "کیمل، لیدی گاگا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 787.03,
   "end": 797.13,
   "text": "بیل، بیل گیتس. این کسی که خیلی هم متاسفانه جوونا الان خیلی ازش دم می‌زنن و حرف می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 797.13,
   "end": 798.97,
   "text": "و، و حالا زیاده اسم‌ها رو نخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 798.97,
   "end": 802.43,
   "text": "اینایی که تقریباً همه می‌شناختید اینا بودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 802.43,
   "end": 805.43,
   "text": "چه بلایی سر مردم دارن میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 805.43,
   "end": 808.73,
   "text": "و من همه تأسفم از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 808.73,
   "end": 812.83,
   "text": "از اینکه متأسفانه وقتی تو بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 812.83,
   "end": 815.69,
   "text": "همین فضاهای مذهبی و معنوی‌مون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 815.69,
   "end": 819.63,
   "text": "هیئتامون و مساجدمون و چهره‌های انقلابی هم که میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 819.63,
   "end": 821.73,
   "text": "نداشتن قدرت تحلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 821.73,
   "end": 828.51,
   "text": "باعث شده که این‌ها رو مواجه، مواجهه کنه با تصمیمات کلان مثل رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 828.51,
   "end": 831.35,
   "text": "که حالا مثلاً رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 831.35,
   "end": 834.37,
   "text": "دیگه ایشونم ساعت‌شونو نگاه کردن یعنی وقت تمومه حاجی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 834.37,
   "end": 837.41,
   "text": "ممنون. انشاالله عقبت و مختمه بخیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 837.41,
   "end": 840.33,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 840.33,
   "end": 845.85,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}