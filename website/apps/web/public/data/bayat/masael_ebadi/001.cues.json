 },
 "chapters": [
  {
   "index": 0,
   "title": "## تکبیرة الاحرام پس از امام",
   "start": 33.44,
   "end": 53.62
  },
  {
   "index": 1,
   "title": "## نماز جماعت در ادارات؛ استفتای رهبری",
   "start": 53.62,
   "end": 127.18
  },
  {
   "index": 2,
   "title": "## ماه آغازشده با جمعه؛ آیهٔ نور",
   "start": 127.18,
   "end": 404.61
  },
  {
   "index": 3,
   "title": "## شاه‌کلید نخودکی؛ سه ضمانت پیامبر",
   "start": 404.61,
   "end": 570.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.76,
   "end": 10.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.2,
   "end": 15.24,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.24,
   "end": 17.62,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.62,
   "end": 25.04,
   "text": "من متوجه شدم که بعضیا همین الان الله اکبر اذان نماز رو که گفتم تکبیرة الاحرام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.04,
   "end": 30.96,
   "text": "نماز عصر رو که گفتم هنوز الله اکبر خودم تموم نشده دیدم یه عزیزی گفت الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.96,
   "end": 33.44,
   "text": "نمازش باطله هرکس بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.44,
   "end": 36.76,
   "text": "پیش از اینکه تکبیرة الاحرام امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.76,
   "end": 41.52,
   "text": "تموم بشه هرکس الله اکبر بگه نمازش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.52,
   "end": 46.86,
   "text": "یعنی باید راه الله اکبر این راه تموم بشه بعد شما شروع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.86,
   "end": 50.84,
   "text": "این حکم فقهی. بعد اِمم خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.84,
   "end": 58.02,
   "text": "یه سوالی هم استفتایی هم از رهبر عزیزمون شده خیلی سال‌های پیش در خصوص نماز جماعت در ادارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.02,
   "end": 63.54,
   "text": "که چه کنیم بالاخره نماز جماعت اصلاً نماز بگیریم نگیریم بعد ارباب رجوع هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.54,
   "end": 72.46,
   "text": "کار که محول شده به ما این مثلاً کم کاری نمیشه بالاخره ما داریم حقوق میگیریم حقوق بگیر دولتی‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.46,
   "end": 77.6,
   "text": "این مدتی که نیم ساعت چقدر وقت میذاریم میایم نمازخونه اینا بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.6,
   "end": 83.08,
   "text": "اونایی که نگران رزق حلالشون بودن استفتاء کردن از آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 83.08,
   "end": 85.62,
   "text": "اون که نگران نیست اصلاً بنده خیالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.62,
   "end": 88.06,
   "text": "حالا چه کنیم آقا چه کنیم بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 88.06,
   "end": 92.44,
   "text": "من عین فتوی جواب استفتاء رو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.44,
   "end": 97.58,
   "text": "آقا فرمودن که با توجه به اهمیت خاص نمازهای یومیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.58,
   "end": 106.34,
   "text": "و تأکید زیادی که بر اقامه نماز در اول وقت شده است و با توجه به فضیلت نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.34,
   "end": 113.24,
   "text": "مناسب است کارمندان روشی را اتخاذ کنند که بتوانند در خلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 113.24,
   "end": 115.42,
   "text": "ساعات کار اداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.42,
   "end": 120.1,
   "text": "نماز واجب را به طور جماعت در اول وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.1,
   "end": 123.42,
   "text": "و در کمترین زمان بخوانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 123.42,
   "end": 133.12,
   "text": "ولی باید به گونه‌ای مقدمات این کار را فراهم کنند که نماز جماعت در اول وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 133.12,
   "end": 140.88,
   "text": "بهانه و وسیله‌ای برای به تأخیر انداختن کارهای مراجعین کنندگان نشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 140.88,
   "end": 143.84,
   "text": ". این بهانه نشه از فرار از کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 143.84,
   "end": 150.66,
   "text": "یعنی اینو مقدم بشمارید نماز جماعت باشه اینها ولی این بهانه نشه برای فرار از کار اداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 150.66,
   "end": 153.26,
   "text": "دیگه خودش میدونه و قیامت خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 153.26,
   "end": 162.08,
   "text": "در نظرات دیگر مراجع رو هم دیدم بعضیا فرمودن اگر ارباب رجوع داشت طرف باید کار ارباب رجوع رو اول انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 162.08,
   "end": 164.72,
   "text": "اگه ارباب رجوع داشت اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 164.72,
   "end": 167.08,
   "text": "انجام بده بعد بیاد برای نماز جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 167.08,
   "end": 169.34,
   "text": "اما همش برای نماز جماعت باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 169.34,
   "end": 172.8,
   "text": "همه فرمودن همش نماز اول وقت باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 172.8,
   "end": 174.96,
   "text": "این ماه در روز جمعه شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.96,
   "end": 183.44,
   "text": "وقتی ماه قمری با روز جمعه شروع میشه فرمودن بزرگک-- بزرگان که اون ماه سراسر به نور امام عصر روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 183.44,
   "end": 187.16,
   "text": "یهد الله نور لنوره ما یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 187.16,
   "end": 190.44,
   "text": "تو آیه نوره، آیه سی و پنج سوره نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 190.44,
   "end": 195.52,
   "text": "و لذا اون آیه سی و پنج سوره نور رو گفتن تو این ماه زیاد قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 195.52,
   "end": 199.64,
   "text": "بعضیا گفتن هر شب قبل از خواب یا بین طولین چهارده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.64,
   "end": 202.9,
   "text": "خیلی سبب تقرب ما به امام زمانمون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.9,
   "end": 207.16,
   "text": "من دیشب که داشتم می‌خوندم اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 207.16,
   "end": 212.04,
   "text": "انقدر شیرینه این آیه ما رو کشوند مثل اینکه سوار موج میشی میبرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.04,
   "end": 217.1,
   "text": "رسیدیم به آیات بعدیش هم توجه کردیم و رسیدیم به آیه سی و هفت سوره نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 217.1,
   "end": 221.16,
   "text": "دیدم چقدر قشنگ پیرامون همین بحث نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 221.16,
   "end": 224.44,
   "text": "فرمودن که رجال الله خیلی شیرینه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 224.44,
   "end": 226.78,
   "text": "رجال الله تلهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 226.78,
   "end": 230.9,
   "text": "یه مردانی هستن که چیزی مانعشون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 230.9,
   "end": 233.2,
   "text": "چی؟ تجارت و لا بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 233.2,
   "end": 236.94,
   "text": "نه تجارت، نه کار روزمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 236.94,
   "end": 238.66,
   "text": "مانع اینا نمیشه. از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.66,
   "end": 245.04,
   "text": "ان ذکر الله. از اینکه یاد خدا بکنند و اقامه صلاة اقامه نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 245.04,
   "end": 249.24,
   "text": "نه خوندن نماز، اقامه نماز، اقامه صلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.24,
   "end": 256.18,
   "text": "و ایتاء الزکاة. يخافون يوما تتقلب فيه القلوب والابصار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 256.18,
   "end": 259.24,
   "text": "اینا دلشون ترسانه، حیرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 259.24,
   "end": 266.14,
   "text": "از روزی که دل و چشم دل‌ها و چشم‌ها تتقلب زیر و رو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 266.14,
   "end": 268.94,
   "text": "يوم تبل السرائر دیگه زیر و رو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 268.94,
   "end": 271.08,
   "text": "یعنی باطن آشکار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 271.08,
   "end": 273.94,
   "text": "به قول علامه عجب جمله‌ای فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.94,
   "end": 277.5,
   "text": "یک کتاب باید این جمله رو تشریح کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 277.5,
   "end": 280.04,
   "text": "فرمود ظاهر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 280.04,
   "end": 285.02,
   "text": "در اون دنیا ، ما ظاهرمون اون دنیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 285.02,
   "end": 286.6,
   "text": "چگونه است؟ عجب جمله‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.6,
   "end": 290.54,
   "text": "فرمود ظاهر شما در اون دنیا یعنی بعد مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.54,
   "end": 293.5,
   "text": "باطن شماست در این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 293.5,
   "end": 297.8,
   "text": "یا به این عبارت باطن شما در این دنیا الان باطن شما چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.8,
   "end": 302.32,
   "text": "من چه خبرم؟ هیچکس خبر نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.32,
   "end": 305.44,
   "text": ". باطن من تو این دنیا ظاهر من در اون دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 305.44,
   "end": 308.18,
   "text": "اونجا که ظاهرها آشکار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 308.18,
   "end": 312.12,
   "text": "دل و ز-- چشم و دیده رزی-- زیر و رو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 312.12,
   "end": 314.8,
   "text": "و وجوههم يومئذ حاکمة. چشم‌ها تیز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.8,
   "end": 319.6,
   "text": "تازه می‌فهمید ببخشید عذرخواهی می‌کنم چه غلطی کردی، چه غلط‌ها که نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.6,
   "end": 323.0,
   "text": "اینجا هر کی، هر کی باطل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.0,
   "end": 329.84,
   "text": "حق مشوب شر و خیر مشوب نور و ظلمت مشوب قاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 329.84,
   "end": 333.28,
   "text": "خلاف هم انجام میدی، پارتی بازی هم می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 333.28,
   "end": 335.72,
   "text": "حق و ناحق می‌کنی، به به چه‌چه هم می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.72,
   "end": 340.5,
   "text": "اونجا اینطوری نیست. زیر و رو میشه دل‌ها و چشم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.5,
   "end": 344.86,
   "text": "فرمود ترس- ترسان اونجان لذا این‌ها نمازشون اول وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.86,
   "end": 348.24,
   "text": "اقامه صلاة نماز اقامه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.24,
   "end": 350.76,
   "text": "اقامه با خوندن فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.76,
   "end": 352.92,
   "text": "ما الان من دارم نماز رو می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.92,
   "end": 354.86,
   "text": "به قول علامه خیلی شیرین در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.86,
   "end": 359.24,
   "text": "در جلسه صد و هشتاد و هفت مصباح الونس فرمود چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.24,
   "end": 365.39,
   "text": "خوب اصلاً این کلامو نوشتم. نماز رو می‌خوانیم، واقعاً می‌خوانیم ما اقامه نمی‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.39,
   "end": 368.15,
   "text": "بترسه انسان در مقام حیرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.15,
   "end": 375.23,
   "text": "از حیرت دستش بیاد بالا بگه الله اکبر یک پارچه نظام هستی و حيات تفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.23,
   "end": 377.87,
   "text": "حیاتی ببینه که داره می جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 377.87,
   "end": 384.71,
   "text": "این کار هر کسی نیست. حالا می فرمایند شیرینی آیه از این حس که داره میگه مردان خدا چگونه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.71,
   "end": 388.81,
   "text": "اصلا نمیشه وقت نماز اینا رو دگرگون نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.81,
   "end": 390.79,
   "text": "ملتهبن. بعد به من بگن حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.79,
   "end": 393.29,
   "text": "نماز رو بذار لفتش بده تا ما برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.29,
   "end": 395.65,
   "text": "عجب! ما لفت بدیم که شما برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.65,
   "end": 399.09,
   "text": "\"فاسابقوا الخیرات\" شما سریع‌تر خودتو برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.09,
   "end": 401.23,
   "text": "شما مترصد الله اکبر باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.23,
   "end": 404.61,
   "text": "هی نگاه کن ساعت رو بپا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.61,
   "end": 407.09,
   "text": "از آشیخ حسن عقلی نخودکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.09,
   "end": 410.39,
   "text": "علیه الرحمه پرسیدن. یه جوونی اومد گفتش که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.39,
   "end": 412.81,
   "text": "من سه تا قفل به زندگیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.81,
   "end": 418.01,
   "text": "اونایی که قفل به زندگیشونه توجه کنن چون معمولا قفلهای ما همیناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.01,
   "end": 420.35,
   "text": "خب مشکلت چیه؟ گفت یه قفلم به ازدواجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.35,
   "end": 423.99,
   "text": "می‌خوام یه ازدواج سالم و خوب داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.99,
   "end": 425.81,
   "text": "یه قفلمم برای کارمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 425.81,
   "end": 427.89,
   "text": "دوست دارم کارم برکت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.89,
   "end": 431.37,
   "text": "به قول ما هرچی میدوییم بازم هشت تا اون گره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.37,
   "end": 434.23,
   "text": "نامون. بعد سومیش گفت می‌خوام عاقبت بخیر باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.23,
   "end": 436.53,
   "text": "باز خب دمش گرم حواسش به اون ور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.53,
   "end": 438.65,
   "text": "یه دونه از قفلاش اونوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.65,
   "end": 441.51,
   "text": "می‌خوام عاقبت بخیر بشم. یک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.51,
   "end": 447.21,
   "text": "سه تا کلید از شما می‌خوام. مرحوم آیه نخودکی اصفهانی علیه الرحمه فرمودن که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.21,
   "end": 451.33,
   "text": "اینکه ازدواج خوب و سالم داشته باشی نماز اول وقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.33,
   "end": 460.27,
   "text": "نمازتو اول وقت بخون. برای اینکه کارت با برکت باشه، رزقت با برکت باشه نماز اول وقت بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.27,
   "end": 464.01,
   "text": "برای اینکه عاقبت به خیر بشی نماز اول وقت بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.01,
   "end": 467.89,
   "text": "این بنده خدا گفت آقا یک کلید داری برای سه تا قفل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.89,
   "end": 472.35,
   "text": "ایشون فرمودن نه سه تا قفل بلکه شاه کلیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.35,
   "end": 475.81,
   "text": "اصلاً تمام قفلهای زندگی ما با همین باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.81,
   "end": 478.69,
   "text": "نماز اول وقت، نماز اول وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.69,
   "end": 481.33,
   "text": "چقدر آیه داریم، چقدر روایت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.33,
   "end": 485.47,
   "text": "یه روایت خیلی شیرینی، خوشگل و قشنگ و خوشی دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.47,
   "end": 488.65,
   "text": "براتون بگم که پیغمبر عزیز عالم فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.65,
   "end": 496.73,
   "text": "بنده ای که وقت‌های نماز رو رعایت کنه، یعنی به موقع اول وقت نمازشو بخونه، مترصد رفت و آمد خورشیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.73,
   "end": 500.01,
   "text": "وقت نگذره، حواسش جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.01,
   "end": 504.23,
   "text": "پیغمبر عزیز عالم فرمود من سه تا چیز رو براش ضمانت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.23,
   "end": 506.69,
   "text": "پیغمبر ضامن آدم بشه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.69,
   "end": 511.45,
   "text": "تمومه دیگه کار. اول فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.45,
   "end": 514.13,
   "text": "برطرف شدن گرفتاری‌ها و ناراحتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.13,
   "end": 518.63,
   "text": "چقدر ما ناراحتی و دغدغه و گرفتاری داریم تو زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.63,
   "end": 523.71,
   "text": "بسم الله. به همین راحتی نسخه‌ای که پیغمبر ضمانت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.71,
   "end": 528.85,
   "text": "مترصد وقت نماز باش. دو فرمود آسایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.85,
   "end": 531.51,
   "text": "و خوشی به هنگام مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.51,
   "end": 534.71,
   "text": "وقتی داری می‌میری با خوشی بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.71,
   "end": 536.99,
   "text": "نه با ناراحتی و استرس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.99,
   "end": 539.01,
   "text": "نگرانی. آسایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.01,
   "end": 542.01,
   "text": "بفرمایین، بفرمایین همه ملائک صف بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.01,
   "end": 544.11,
   "text": "سومیش هم فرمود نجات از آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.11,
   "end": 548.43,
   "text": "اگر بدانیم آتش جهنم چیست، اینو دست کم نمی‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.43,
   "end": 553.51,
   "text": "نجات از آتش. حالا صحبت در خصوص نماز بسیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 553.51,
   "end": 556.09,
   "text": "روایت‌های دیگه هم آماده کرده بودم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.09,
   "end": 559.79,
   "text": "فکر می‌کنم تقریبا ده دقیقه شد دیگه کفایت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.79,
   "end": 564.41,
   "text": "عاقبت 末 ختم به خیر بشه و برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.41,
   "end": 570.51,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}