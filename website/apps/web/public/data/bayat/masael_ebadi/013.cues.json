  {
   "index": 8,
   "title": "## زیارت جامعه؛ رنگین کردن ضیافت آخر رمضان",
   "start": 574.22,
   "end": 712.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 4.18,
   "text": "[سخنگوی 1] یا اطه. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.18,
   "end": 6.7,
   "text": "امشب شب بسیار پرفضیلتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.7,
   "end": 10.8,
   "text": "خیلی اجمالی نکته‌ای رو عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.8,
   "end": 14.38,
   "text": "بدونیم که خدایی نکرده یه وقت از امشب جا نمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.38,
   "end": 22.64,
   "text": "شب بیست‌وهفتم ماه مبارک رمضان است و در دعای روز بیست‌وهفتم تنها دعایی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.64,
   "end": 25.7,
   "text": "که اشاره به درک فضیلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.7,
   "end": 29.78,
   "text": "شب قدر شده. یعنی فردا، دعای فردا رو که می‌خونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.78,
   "end": 32.04,
   "text": "اللهم ارزقنی فیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.04,
   "end": 35.68,
   "text": "خدایا من توی این روز به من این رزق رو بده که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.68,
   "end": 41.32,
   "text": "فقل ليلة القدر. توفیق فضیل، درک فضیلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.32,
   "end": 50.26,
   "text": "شب قدر که البته اگه بعضیا بپرسن آقا روزه داریم دعا تو روز می‌کنیم بعد شب بیست‌وهفتم گذشته شب بیست‌وهشتم فردا شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.26,
   "end": 54.02,
   "text": "چطور میگه تو امروز درک لیله قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.02,
   "end": 58.5,
   "text": "چون روایت داریم که روز قدر هم مثل شب قدره فضیلتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.5,
   "end": 62.1,
   "text": "ما غافل می‌شیم و میگیم دیگه تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.1,
   "end": 67.12,
   "text": "باید خیلی حواسمون جمع باشه که من یه نکته‌ای رو برداشتی از فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.12,
   "end": 70.48,
   "text": "بزرگان عرض می‌کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.48,
   "end": 75.8,
   "text": "همه لیالی قدر یک حقیقتی‌اند در طورهای مختلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.8,
   "end": 78.78,
   "text": "در ظهور و بروز متعدد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.78,
   "end": 80.62,
   "text": "همشون رو باید با هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.62,
   "end": 84.58,
   "text": "نمیشه شما یک شب رو ورداری بقیه رو غافل باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.58,
   "end": 89.16,
   "text": "مثلا مثل این که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.16,
   "end": 96.42,
   "text": "آیه سوره پنج سوره یونس، آیه پنج سوره یونس میفر-- خدای من، منام خودش رو اینطوری معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.42,
   "end": 100.62,
   "text": "هو الذي جعل الشمس ضياءً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.62,
   "end": 105.48,
   "text": "والقمر نوراً. خدا اون کسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.48,
   "end": 108.18,
   "text": "ضیا یعنی شروع نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.18,
   "end": 110.3,
   "text": "شروق نور، شدت نور؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.3,
   "end": 113.64,
   "text": "اون رو به شمس اطلاق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.64,
   "end": 115.76,
   "text": "شمس ضياءً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.76,
   "end": 119.8,
   "text": "یعنی منبع نور، شدت نور، شروق نور مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.8,
   "end": 129.18,
   "text": "شمسه. اما والقمر نورا خود نور رو که انعکاس اون ضیا و اون شدت نوره به قمر نسبت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.18,
   "end": 131.18,
   "text": "بعد باز ستاره هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.18,
   "end": 134.2,
   "text": "ستاره هم رهرو راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.2,
   "end": 136.46,
   "text": "ماهه. همینطور دنبال هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.46,
   "end": 140.92,
   "text": "یعنی یک حقیقتی‌اند همه دارن تدای نور می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.92,
   "end": 144.26,
   "text": "اما نسبت به صاع وجودیشون هر کدوم یه کاره‌این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.26,
   "end": 146.9,
   "text": "البته در تفسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.9,
   "end": 151.88,
   "text": "جلد شش صفحه چهارصد و بیست و چهار می‌تونید روایت شیرین رو از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.88,
   "end": 156.42,
   "text": "پیغمبر عظیم الشأن اسلام ببینید که جابر بن عبدالله انصاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.42,
   "end": 160.46,
   "text": "از پیغمبر نقل می‌کنه که ذیل این آیه، همین آیه‌ای که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.46,
   "end": 166.52,
   "text": "اقتدوا بالشمس. بالشمس یعنی به خورشید اقتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.52,
   "end": 169.92,
   "text": "فإذا غابت الشمس فاقتدوا بالقمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.92,
   "end": 173.56,
   "text": "وقتی خورشید ناپدید شد، غائب شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.56,
   "end": 176.3,
   "text": "به ماه اقتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.3,
   "end": 178.56,
   "text": "خب این در حسب ظاهرش همین طوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.56,
   "end": 183.36,
   "text": "میگه وقتی شب شد خورشید نیست از طریق ماه شما می‌تونید راهو پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.36,
   "end": 187.76,
   "text": "این ظاهرش. فإذا غابت القمر وقتی قمر ناپدید شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.76,
   "end": 191.44,
   "text": "اقتدوا بالزهرة. همون زهره خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.44,
   "end": 195.5,
   "text": "و إذا غابت الزهرة یا زهرة فاقتدوا بالفرغدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.5,
   "end": 199.62,
   "text": "تو قرآن یه آیه هست فرغدان رو میگه اون دو تا ستاره قطبی که خیلی خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.62,
   "end": 203.7,
   "text": "می‌درخشند. از، از همه درخشان‌ترند، از همه ستاره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.7,
   "end": 205.92,
   "text": "فقال یا رسول الله فما الشمس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.92,
   "end": 209.54,
   "text": "شمس چیه؟ وما القمر وما الزهرة وما الفرغدان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.54,
   "end": 212.72,
   "text": "اینا چین؟ کی‌ان؟ فقالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.72,
   "end": 216.22,
   "text": "پیغمبر فرمود أنا الشمس خورشید منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.22,
   "end": 218.82,
   "text": "به به. وعلیّ القمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.82,
   "end": 223.3,
   "text": "ماه علی‌ست. والزهرة فاطمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.3,
   "end": 226.64,
   "text": "والفرغدان الحسن والحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.64,
   "end": 229.52,
   "text": "میگه این‌ها همشون یک کلهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.52,
   "end": 232.32,
   "text": "من نور واحد دیگه یک حقیقتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.32,
   "end": 235.08,
   "text": "حالا یکی نامش شده حسن، یکی حسین علیهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.08,
   "end": 238.7,
   "text": "حسن به این شکل. همه هم یک حرف دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.7,
   "end": 241.1,
   "text": "منتها اونچه که مهمه اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.1,
   "end": 243.42,
   "text": "اصل شروق نور از خورشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.42,
   "end": 247.54,
   "text": "امیرالمؤمنین هم به تبع پیغمبر شد علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.54,
   "end": 249.92,
   "text": "پیغمبر اصالتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.92,
   "end": 253.26,
   "text": "به ذات و اصالتاً این راه رو رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.26,
   "end": 254.9,
   "text": "لذا شد پیغمبر خاتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.9,
   "end": 258.54,
   "text": "امیرالمؤمنین به تبع پیغمبر رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 258.54,
   "end": 262.74,
   "text": "و به اون مقامات رسید. در هر حال اینجا امیرالمؤمنین کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 262.74,
   "end": 266.58,
   "text": "قمره. نور، نور قمر از خودشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.58,
   "end": 269.86,
   "text": "نه از خورشیده. اما نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.86,
   "end": 273.86,
   "text": "منعکس کننده نور خورشیده. همه‌شون دارن نور رو منعکس می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.86,
   "end": 275.48,
   "text": "درسته؟ همون نسبت صاع وجودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.48,
   "end": 278.36,
   "text": "حالا اینو برگردونیم به همین حقیقت شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 278.36,
   "end": 282.34,
   "text": "لیالی قدر هم این چنین‌اند. یک حقیقت کلی‌اند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.34,
   "end": 287.46,
   "text": "جلوه‌های مختلف. مثلا شب نوزدهم رو گفتن ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 287.46,
   "end": 290.54,
   "text": "شبی‌ست که مقدرات صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 290.54,
   "end": 295.92,
   "text": "اندازه هر کسی با اون وزن‌کشی که در ارتباطش با امام عصرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 295.92,
   "end": 298.64,
   "text": "اتفاق می‌افته که نحن موازین القسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.64,
   "end": 301.32,
   "text": "قسط تو رو، قسط تو رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.32,
   "end": 303.5,
   "text": "حقیقت ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.5,
   "end": 306.0,
   "text": "آقا می‌سنجه، اندازه‌ت چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 306.0,
   "end": 308.18,
   "text": "این اندازه‌ت مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 308.18,
   "end": 312.68,
   "text": "مثل این‌که هو الله الخالق البارع المصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 312.68,
   "end": 314.58,
   "text": "خالق یعنی اندازه میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 314.58,
   "end": 317.92,
   "text": "اصلا خلقت یعنی تقدیر، اندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 317.92,
   "end": 321.1,
   "text": "حد می‌خوری از نظام وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 321.1,
   "end": 323.8,
   "text": "بارع می‌شه دوخت این بریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 323.8,
   "end": 326.24,
   "text": "اون برش رو میگن بارع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 326.24,
   "end": 331.2,
   "text": "آیه آخر سوره حشر. المصور هم که بعدش اومده یعنی صورت دهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 331.2,
   "end": 335.72,
   "text": "یعنی اینا دوخته می‌شن. هر کدوم از این‌ها تو یه شب داره اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 335.72,
   "end": 339.32,
   "text": "ليلة القدر اندازه‌گیری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 339.32,
   "end": 342.84,
   "text": "اندازه‌ت مشخص می‌شه که اصلش هم به نیت‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 342.84,
   "end": 347.72,
   "text": "ما معمولا خودمون رو با عمل خسته می‌کنیم اون شب خیلی کار به نیت‌هامون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.72,
   "end": 350.5,
   "text": "نه تو درون دلت، کمون غیبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 350.5,
   "end": 357.74,
   "text": "اون مکمن غیبت، اون ثغء ذاتت، اون پنهان‌ترین‌ها، اون انگیزه‌ت اصلاً چیه از امشب که بیداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.74,
   "end": 360.78,
   "text": "اون مهمه بعد شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 360.78,
   "end": 363.48,
   "text": "بیست و یکم می‌شه ليلة التحکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 363.48,
   "end": 368.26,
   "text": "محکم می‌شه یعنی اون تقدیرها، اندازه‌ها برش داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 368.26,
   "end": 370.8,
   "text": "دیگه محکم کاری می‌شه، برش داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 370.8,
   "end": 372.82,
   "text": "ليلة بیست و سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 372.82,
   "end": 376.54,
   "text": "می‌شه ليلة العموا. امضا یعنی دیگه اینا چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 376.54,
   "end": 380.16,
   "text": "به هم دوخته می‌شه. دقیقا همین کار رو دارن می‌کنن این شب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 380.16,
   "end": 383.74,
   "text": "نمی‌شه یه شب رو ورداری مشکل پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.74,
   "end": 386.9,
   "text": "باید همه‌ش رو باشی. شب بیست و سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 386.9,
   "end": 392.88,
   "text": "امضا می‌شه. حضرت حجت سلام الله عليه امضا می‌زنه که الان تو اندازه‌ات مشخص شد، لباس دوخته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 392.88,
   "end": 395.7,
   "text": "و بهت تقدیم شد. خب حالا تمام شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 395.7,
   "end": 401.48,
   "text": "نخیر، لباسو می‌دوزی می‌فرستی برای طرف می‌بینی می‌پوشه می‌بینی یه ذره تنگ و گشاد شده، عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 401.48,
   "end": 403.82,
   "text": "تو همین چند روزی عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 403.82,
   "end": 406.62,
   "text": "یه دفعه مثلاً یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 406.62,
   "end": 408.58,
   "text": "قدش بلندتر شده کوتاه‌تر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 408.58,
   "end": 411.98,
   "text": "حالا اون تو نظام ماده، این تو بحث معنویت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 411.98,
   "end": 415.9,
   "text": "خدا به جهت این که اسامی خدا هم که نمی‌شه معطل باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 415.9,
   "end": 419.54,
   "text": "یکی از جاهایی که از اسم الجابر یا جبار خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 419.54,
   "end": 423.12,
   "text": "به شدت جبران کننده است پیاده می‌شه همین امشبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 423.12,
   "end": 426.26,
   "text": "همه این‌ها رو گفتم که به این برسیم. امشب خدا جبران کننده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 426.26,
   "end": 428.34,
   "text": "برای کیا؟ اونایی که اون شب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 428.34,
   "end": 431.64,
   "text": "نتونستن درست، یعنی اون لباس رو اندازه‌شون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 431.64,
   "end": 434.4,
   "text": "امشب دو مرتبه همه‌ی اون کارا صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 434.4,
   "end": 437.64,
   "text": "لذا به یک معنا می‌شه گفت امشب، امشب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 437.64,
   "end": 441.2,
   "text": "ليلة الجبرانه. اسم الجابر خدا پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 441.2,
   "end": 442.8,
   "text": "امشب هم باید قرآن سر گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 442.8,
   "end": 446.28,
   "text": "امشب هم باید اون اعمال رو هرکی به سعه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 446.28,
   "end": 451.4,
   "text": "خیلی امشب مهمه. به این وجه که نگاه می‌کنی بعد می‌بینی بازم ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 451.4,
   "end": 455.26,
   "text": "تمام شد؟ نخیر. می‌گه دوباره به روزرسانی باید انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 455.26,
   "end": 458.54,
   "text": "هر روز باید لباسو اندازه‌ات بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 458.54,
   "end": 461.64,
   "text": "کیا؟ لیالی شب‌های جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 461.64,
   "end": 463.78,
   "text": "ليلة الجمعة اسمش هم رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 463.78,
   "end": 466.84,
   "text": "دیگه جمعه مقام جمعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 466.84,
   "end": 468.76,
   "text": "دیگه ما بالاتر از شب جمعه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 468.76,
   "end": 474.9,
   "text": "ليلة القدر شب‌های هفته است که امام عصر هم مرحوم علامه همدانی در کتاب از شموس طالعه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 474.9,
   "end": 477.42,
   "text": "می‌گه امام عصر هم می‌ره معراج شب‌های جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.42,
   "end": 479.62,
   "text": "محضر اجدادش رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 479.62,
   "end": 481.82,
   "text": "بر علم حضرت، معرفت حضرت اضافه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 481.82,
   "end": 487.92,
   "text": "دو مرتبه برمی‌گرده. ما جا نمونیم از شب‌های جمع، شب‌های جمعه که ليلة القدر هفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.92,
   "end": 490.6,
   "text": "ببینید یک وجوده در طورهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 490.6,
   "end": 493.42,
   "text": "حالا باز بالاتر از این هم داریم لیلة القدر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 493.42,
   "end": 496.7,
   "text": "بله. اصلا لحظه‌ی قدر هم ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 496.7,
   "end": 501.08,
   "text": "حضرت علامه حسن زاده علیه الرحمه یه جمله کلیدی و طلایی تقدیمتون کنم امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 501.08,
   "end": 503.52,
   "text": "یه هدیه هم بدم بهتون از اساتیدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 503.52,
   "end": 505.68,
   "text": "که ایشون فرمودن هر آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 505.68,
   "end": 509.46,
   "text": "هر آنک که بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 509.46,
   "end": 516.6,
   "text": "منقلب بشه، عوض بشه و تحت عنایت حضرت حق قرار بگیره، \"إنا أنزلناه في ليلة القدر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 516.6,
   "end": 518.84,
   "text": "کل قرآن به قلب پیغمبر نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 518.84,
   "end": 527.34,
   "text": "هر مقداری از قرآن حتی یک حرف مقطعه‌اش که از سر ما هم زیادیه بر ما نازل بشه، یعنی عنایت خدا بر ما تعقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 527.34,
   "end": 530.44,
   "text": "تعلق بگیره، اون ليله، اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 530.44,
   "end": 537.2,
   "text": "ثوان ليلة القدر ماست. هر شب ما چنان منقلب بشیم که بریم تو دامان خدا باز اون می‌شه ليلة القدر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 537.2,
   "end": 541.18,
   "text": "چون از سمت حضرت حق به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 541.18,
   "end": 544.82,
   "text": "دفعی به یک باره حقیقتی بر ما نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 544.82,
   "end": 549.32,
   "text": "احسان و عنایتش و حالا تدریجیش تن، چند سال طول می‌کشه الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 549.32,
   "end": 552.44,
   "text": "یه هدیه هم تقدیم کنم مال همین روزای آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 552.44,
   "end": 554.6,
   "text": "سه چهار روز بیشتر باقی نمونده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 554.6,
   "end": 560.88,
   "text": "خدا رحمت کنه از جمله اساتیدی که ما بعضا از حضورشون استفاده می‌کردیم حضرت آقای فاطمی نیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 560.88,
   "end": 563.86,
   "text": "روحش شاد. آدم خاصی بود این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 563.86,
   "end": 569.86,
   "text": "حرف‌های خاصی می‌زد. اون از شب دستور اول شب‌های قدرشون که همه جا پیچید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 569.86,
   "end": 572.18,
   "text": "سوره واقعه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 572.18,
   "end": 575.92,
   "text": "با قل هوالله رو با هم بخون بعد هفت بار بگو یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 575.92,
   "end": 579.54,
   "text": "این هم زیرکی ایشون بود و الا روایت امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 579.54,
   "end": 586.4,
   "text": "قطعا دیدید امیرالمؤمنین فرمود از پیغمبر شنیدم هر کس صد آیه از قرآن رو بخونه بعد هفت بار بگه یا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 586.4,
   "end": 594.92,
   "text": "خدا حاجتشو می‌ده. این واقعه رو با قل هوالله رو با هم کنار هم بگذاری بر فرض اگر بگیریم البته بسم الله‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 594.92,
   "end": 597.86,
   "text": "این فرض رو قبول کنیم که علامه این فرض رو قبول نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 597.86,
   "end": 600.08,
   "text": "بسم الله‌ش جزو سوره نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 600.08,
   "end": 602.9,
   "text": "می‌شه صد آیه. بعد هفت تا یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 602.9,
   "end": 606.8,
   "text": "همونو داره می‌زنه. اما دو تا از سوره‌هایی که منتخب مولان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 606.8,
   "end": 610.22,
   "text": "سوره واقعه اصلاً سوره مولا علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 610.22,
   "end": 614.9,
   "text": "در شأن ایشون نازل شده. هر کس این سوره رو زیاد بخونه با مولا علی محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.9,
   "end": 617.12,
   "text": "سوره قل هوالله هم که منتخب مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 617.12,
   "end": 619.13,
   "text": "یعنی همیشه مولا قل هوالله می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 619.13,
   "end": 623.84,
   "text": "نماز امیرالمؤمنین رو دیدید؟ چهار رکعت در هر رکعت بعد از حمد پنجاه تا قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 623.84,
   "end": 629.1,
   "text": "همش قل هوالله، قل. پیغمبر، امیرالمؤمنین در هر حال مشغول قل هوالله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 629.1,
   "end": 632.66,
   "text": "یعنی این زیرکی آقای فاطمی نیاست این دستور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 632.66,
   "end": 636.94,
   "text": "همون دستور امیرالمؤمنینه اما دو تا از سوره‌هایی که نور امیرالمؤمنین دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 636.94,
   "end": 639.16,
   "text": "در شأن آقا و منتخب ایشونن آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 639.16,
   "end": 642.52,
   "text": "بعد می‌گه خب حالا این صد تا آیه رو بخون و بعد اسراری درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 642.52,
   "end": 647.26,
   "text": "در خصوص این آ، روزهای پایانی ایشون یه دستور اولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 647.26,
   "end": 655.8,
   "text": "می‌فرمودن که تعبیرشون این بود که روزی که هیچی به دردت نمی‌خوره، چنان این ضیافت رو رنگین می‌کنه این کار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 655.8,
   "end": 663.56,
   "text": "این عمل. که البته دیگه می‌دونید ایشون فرمود سینه به سینه از اساتیدمون و مشایخ‌مون دارن نگفتم هم که از کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 663.56,
   "end": 672.16,
   "text": "این هدیه رو. و فرمودن که عقل گنجایش درک این رو نداره که چه کار می‌کنه، چه سفره رنگینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 672.16,
   "end": 674.12,
   "text": "این ضیافت رو چگونه رنگین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 674.12,
   "end": 684.9,
   "text": "اونم اینه. روزهای آخر ماه مبارک رمضانت رو ایشون فرمودن سفره ضیافت الله رو رنگین کنید به یک زیارت جامعه کبیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.9,
   "end": 688.16,
   "text": "حالا اینم باز چه زیرکی به خرج داده توش حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 688.16,
   "end": 690.96,
   "text": "باشه انشاالله وقتمون گذشته یه فرصت دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 690.96,
   "end": 692.5,
   "text": "انشاالله هم دیگه رو امشب دعا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 692.5,
   "end": 696.26,
   "text": "برای مردم مظلوم غزه هم قطعا امشب دعا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 696.26,
   "end": 698.9,
   "text": "انشاالله امسال سال ظهور آقامون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.9,
   "end": 700.52,
   "text": "عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.52,
   "end": 708.64,
   "text": "به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 708.64,
   "end": 712.04,
   "text": "الله الله الله الله الله اکبر، الله اکبر، لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}