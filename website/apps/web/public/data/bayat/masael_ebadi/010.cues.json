   "title": "## نگاه دشمن به دستاوردهای انقلاب",
   "start": 1.18,
   "end": 21.26
  },
  {
   "index": 1,
   "title": "## آبراهامیان؛ کارنامهٔ رفاه اجتماعی",
   "start": 21.26,
   "end": 75.84
  },
  {
   "index": 2,
   "title": "## آمار یونسکو؛ باسوادی و امید به زندگی",
   "start": 75.84,
   "end": 232.68
  },
  {
   "index": 3,
   "title": "## افسانهٔ غربی و هشدار نیچر",
   "start": 232.68,
   "end": 256.16
  },
  {
   "index": 4,
   "title": "## ارزیابی‌های امنیتی دشمن از هسته‌ای",
   "start": 256.16,
   "end": 769.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 4.66,
   "text": "هایی که در این ایام میشه خوب انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.66,
   "end": 11.12,
   "text": "شیرینی وصفیه که دشمنان انقلاب به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.12,
   "end": 15.92,
   "text": "نامحرمان به انقلاب به قول امام ربه عابدی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.92,
   "end": 19.84,
   "text": "در خصوص انقلاب و پیشرفت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.84,
   "end": 25.76,
   "text": "کشور ما و به نوعی دستاوردهای ما دارند که آدم یه مطالعه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.76,
   "end": 28.92,
   "text": "اجمالی حتی بکنه یه تورقی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.92,
   "end": 33.54,
   "text": "مقالات رو ببینه بالاخره اونا چی میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.54,
   "end": 37.92,
   "text": "که وقتی که داخلی‌ها تعریف می‌کنن ما نگیم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.92,
   "end": 40.02,
   "text": "اغراق می‌کنن، بزرگ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.02,
   "end": 44.92,
   "text": "خارجی‌ها دارن میگن، دشمنان ما دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.92,
   "end": 49.12,
   "text": "یکی از بهترین مقالات رو در یک سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.12,
   "end": 52.16,
   "text": "حالا تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.16,
   "end": 57.62,
   "text": "زمان‌بندی شده در روزنامه کیهان اومد در خصوص نظرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.62,
   "end": 62.62,
   "text": "مثلاً دشمنان ما در خصوص پیشرفت ایران یا انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.62,
   "end": 65.8,
   "text": "من چند تاشون رو با توجه به ضیق وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.8,
   "end": 67.84,
   "text": "براتون تندتند عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.84,
   "end": 78.86,
   "text": "مثلاً آقای ابراهامیان رو دیگه می‌شناسید که مورخ مقیم آمریکا و استاد دانشگاه‌های آکسفورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.86,
   "end": 86.7,
   "text": "پرینستون و کالج باروک نیورو-- نیویورک و خیلی جاهای معروفی اینو تو مثلاً آکادمی اینا درس میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.7,
   "end": 89.48,
   "text": "یه مصاحبه‌ای ازش می‌کنن سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.48,
   "end": 92.18,
   "text": "نود و هشت، هفت فروردین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.18,
   "end": 94.04,
   "text": "بخشی‌شو من براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.04,
   "end": 100.14,
   "text": "ایشون میگه دستاوردهای انقلاب اغلب نادیده گرفته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.14,
   "end": 105.42,
   "text": "خیلی جالبه. یه مورخه خارج از کشور که مسلمون هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.42,
   "end": 111.58,
   "text": "اینها در خصوص دستاوردهای انقلاب ما میگه اینا نادیده گرفته میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.58,
   "end": 118.52,
   "text": "برای نمونه برنامه‌های مبارزه با بی‌سوادی و احداث مدارس و دانشگاه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.52,
   "end": 123.7,
   "text": "همچنین توسعه جاده‌های روستایی و همچنین خانه‌های بهداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.7,
   "end": 126.3,
   "text": "و مراکز سلامت در روستاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.3,
   "end": 133.8,
   "text": "و اگر دوست داشتید آمار داخلیش رو هم من بعداً براتون میگم که چند تا بوده، چند تا شده اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.8,
   "end": 137.9,
   "text": "مدارس مثلاً مراکز سلامت در روستا و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.9,
   "end": 147.5,
   "text": "بعد میگن که بنابراین اگرچه اغلب افراد از لحاظ رفاه اقتصادی و مسائل اجتماعی مشکلاتی دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.5,
   "end": 153.34,
   "text": "ایشون میگه، اما رژیم جمهوری اسلامی به نسبت رژیم شاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.34,
   "end": 157.2,
   "text": "واقعاً در این زمینه کارنامه بهتری داشته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 157.2,
   "end": 162.12,
   "text": "بنابراین اگر دو رژیم را مقایسه کنید ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 162.12,
   "end": 167.06,
   "text": "اصلاً نمیگیم دشمن‌ها. یه آدم بی‌تفاوت ولی تحصیل‌کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 167.06,
   "end": 169.42,
   "text": "چندین دانشگاه، مدرس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.42,
   "end": 173.2,
   "text": "در سطح بین‌المللی داره این نظر رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 173.2,
   "end": 176.98,
   "text": "اگرچه نارضایتی‌های اقتصادی وجود دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.98,
   "end": 184.5,
   "text": "رژیم کنونی در برنامه‌های رفاه اجتماعی بسیار خوب عمل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.5,
   "end": 187.52,
   "text": "شما ببینید نظر ایشون. این یه نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.52,
   "end": 190.22,
   "text": "البته طولانیه. مصاحبه با ایشون طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 190.22,
   "end": 195.74,
   "text": "بخشی‌شو من براتون خوندم. حالا بعضی جاهاشو من علامت زدم براتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.74,
   "end": 201.94,
   "text": "در خصوص مثلاً نرخ بی‌سوادی و باسوادی و یه مقایسه‌ای کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.94,
   "end": 205.46,
   "text": "کجا؟ نه داخلی‌ها. آماره‌ای که یونسکو داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 205.46,
   "end": 209.12,
   "text": "یونسکو اوایل دهه پنجاه، ایشون توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 209.12,
   "end": 216.8,
   "text": "یونسکو توی مقاله‌ای میگه-- گزارشی میگه در اواسط، اواسط دهه پنجاه یعنی که قبل انقلاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 216.8,
   "end": 220.6,
   "text": "یعنی در اوج به اصطلاح تمدن بزرگ شاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 220.6,
   "end": 224.66,
   "text": "میزان باسوادان در ایران حدود سی درصد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 224.66,
   "end": 232.32,
   "text": "اما بر اساس همین آمار تا سال هفتاد و شش بیش از هفتاد و پنج درصد از مردم ایران باسواد شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 232.32,
   "end": 236.58,
   "text": "و در سال دو هزار و شونزده حالا تازه یعنی نود و پنج ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 236.58,
   "end": 242.0,
   "text": "اون موقع رو میگه آمار باسوادان کشور رقم حدود نود درصد را نشان می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.0,
   "end": 248.24,
   "text": "یعنی بعد حالا نتیجه می‌گیره که چه حالا مقایسه می‌کنه که طولانیه دیگه رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 248.24,
   "end": 253.88,
   "text": "دیگه شما ببینید این آمار رو با هم مق-- تازه مال سال نود و پنج، نه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 253.88,
   "end": 258.04,
   "text": "که خیلی این آمار بیشتر شد. یا در خصوص مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 258.04,
   "end": 260.48,
   "text": "عرض شود خدمتتون امید به زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 260.48,
   "end": 265.74,
   "text": "یه نمونه‌ای. یه گزارش سالانه سازمان ملل می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 265.74,
   "end": 271.34,
   "text": "در خصوص متوسط عمود-- امور-- امید به زندگی در کشورهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 271.34,
   "end": 275.24,
   "text": "در رابطه با ایران پروفسور همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 275.24,
   "end": 278.32,
   "text": "آبراهامیان که براتون عرض کردم کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 278.32,
   "end": 282.64,
   "text": "در رابطه با شاخص توسعه انسانی و عامل امید به زندگی در این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 282.64,
   "end": 286.32,
   "text": "در این شاخص در همون مصاحبه این رو بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 286.32,
   "end": 288.56,
   "text": "که در گزارش سالانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.56,
   "end": 290.8,
   "text": "سازمان ملل هم میاد. چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 290.8,
   "end": 293.92,
   "text": "میگه من یک شاخص اجتماعی رو ذکر می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 293.92,
   "end": 303.4,
   "text": "که امید به زندگی‌ست. پیش از انقلاب امید به زندگی در ایران به نسبت دیگر کشورهای جهان سوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.4,
   "end": 308.9,
   "text": "تازه نسبت به جهان سوم، در واقع آمار بدی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 308.9,
   "end": 314.84,
   "text": "در حال حاضر نرخ امید به زندگی واقعاً بالا رفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 314.84,
   "end": 318.92,
   "text": "و اینو توصیف می‌کنه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 318.92,
   "end": 321.36,
   "text": "به نقل از بعضی از نشریه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 321.36,
   "end": 325.88,
   "text": "انگلیسی و اینا مطالب دیگه‌ای میگه که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 325.88,
   "end": 332.38,
   "text": "در خصوص اینکه چگونه بتونن جلوی رشد ایران رو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 332.38,
   "end": 338.82,
   "text": "یه پایگاه اینترنتی هست که خیلی معروفه و میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 338.82,
   "end": 344.16,
   "text": "در اون یادداشتی که داره میگه در واقع مردم ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 344.16,
   "end": 347.34,
   "text": "این افسانه غربی‌ها را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 347.34,
   "end": 355.04,
   "text": "افسانه غربی‌ها چیه؟ که از زمان انقلاب اسلامی سال هفتاد و نه، هزار و نهصد و هفتاد و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 355.04,
   "end": 361.98,
   "text": "می‌گوین کشور آیت‌الله‌ها نمی‌تواند در هیچ زمینه‌ای پیشرفت داشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 361.98,
   "end": 364.8,
   "text": "نقش بر آب کرده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 364.8,
   "end": 367.72,
   "text": "می‌گه این رو نقش بر آب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 367.72,
   "end": 372.58,
   "text": "بعد میاد عنوان می‌کنه که توضیح میده مفصل خلاصه‌اش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 372.58,
   "end": 378.9,
   "text": "که باید با تحریم و اغتشاش جلوی رشد علمی ایران گرفته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 378.9,
   "end": 384.9,
   "text": "راهش اینه. اجازه بدید این تیکش هم شیرینه براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 384.9,
   "end": 387.62,
   "text": "سردبیر مجله nature",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 387.62,
   "end": 391.02,
   "text": "با اشاره به پیشرفت‌های ایران اینو می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 391.02,
   "end": 397.16,
   "text": "اینم بخشی‌ش رو من می‌خونم. «تعالی علمی در ایران در حال بازسازی دوباره است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 397.16,
   "end": 402.0,
   "text": "مگر اینکه با اغتشاشات یا تحریم‌های بیشتر جلوی آن گرفته شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 402.0,
   "end": 405.3,
   "text": "و، و، و، و، و ایرانیان می‌دانند چه کسانی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 405.3,
   "end": 411.14,
   "text": "خودشون می‌دونند کی‌اند و از سابقه تمدن و علمی‌شان به خوبی آگاه هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 411.14,
   "end": 415.96,
   "text": "در چند سال گذشته این کشور پول بیشتری را در علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 415.96,
   "end": 418.04,
   "text": "سرمایه‌گذاری کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 418.04,
   "end": 425.9,
   "text": "حتی آیت الله علی خامنه‌ای که به طور مؤثر مسئولیت این کشور را بر عهده دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 425.9,
   "end": 428.18,
   "text": "برای علم صحبت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 428.18,
   "end": 432.0,
   "text": "و از کشور خود خواسته است تا اعتماد به نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 432.0,
   "end": 435.44,
   "text": "در تمامی زمینه‌های علمی را توسعه دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 435.44,
   "end": 438.58,
   "text": "این فراخوان درون یک جامعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 438.58,
   "end": 442.66,
   "text": "این فراخوانی درون یک جامعه دانشگاهی کوچک است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 442.66,
   "end": 452.24,
   "text": "که به شدت از میراث غنی و باستانی پیشرفت علمی ایران آگاه است.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 452.24,
   "end": 456.58,
   "text": "اینم مال این سردبیر. مثلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 456.58,
   "end": 459.24,
   "text": "Fox News دیگه آگاه هستید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 459.24,
   "end": 461.38,
   "text": "در رابطه با بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 461.38,
   "end": 463.66,
   "text": "مثلاً مؤسسه رویان و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 463.66,
   "end": 472.82,
   "text": "می‌گه «در حالی که بخشی از دانشمندان آمریکایی از نظر برخی محدودیت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 472.82,
   "end": 481.32,
   "text": "به کشورهای غربی آماده پذیرش ایران در باشگاه کشورهای هسته‌ای بودند.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 481.32,
   "end": 486.74,
   "text": "می‌گه «در اواخر سال نود و یک که هنوز چشم‌انداز روشنی از پیروزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 486.74,
   "end": 491.52,
   "text": "مدعیان اصلاحات و تدبیر و امید در انتخابات یازدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 491.52,
   "end": 493.98,
   "text": "ریاست جمهوری رویت نمی‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 493.98,
   "end": 496.72,
   "text": "یک مرکز» مربوط به اوایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 496.72,
   "end": 499.22,
   "text": "دولت امید به خیال خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 499.22,
   "end": 504.08,
   "text": "«یک مرکز مطالعاتی امنیتی رژیم صهیونیستی اعلام کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 504.08,
   "end": 511.26,
   "text": "در چالش هسته‌ای با غرب موفقیتی بزرگ در انتظار ایران است.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 511.26,
   "end": 513.48,
   "text": "اون اعلام می‌کنه. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 513.48,
   "end": 515.7,
   "text": "«به گزارش وبسایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 515.7,
   "end": 520.34,
   "text": "Institute مطالعات امنیتی ملی اسرائیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 520.34,
   "end": 524.48,
   "text": "تو همون زمان پروفسور افرایم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 524.48,
   "end": 528.04,
   "text": "ایشون نقل می‌کنه که «وابسته به دانشگاه تلاویو هم هست».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 528.04,
   "end": 531.22,
   "text": "تلاویو اسرائیل. اینم براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 531.22,
   "end": 533.16,
   "text": "بعد حالا بریم آخر مقاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 533.16,
   "end": 535.42,
   "text": "یه تیکه هم از آخرش بخونم بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 535.42,
   "end": 537.08,
   "text": "عین گزارش رو دارم براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 537.08,
   "end": 540.5,
   "text": "«گزارش آژانس بین‌المللی انرژی اتمی نشان می‌دهد که ایران تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 540.5,
   "end": 542.42,
   "text": "چه اندازه در تولید اورانیوم غنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 542.42,
   "end": 548.18,
   "text": "شده موفق بوده و چه توانایی‌های بالایی در تکنولوژی برخورداری از انرژی هسته‌ای به دست آورده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 548.18,
   "end": 551.6,
   "text": "رسیدن به این مرحله این نکته رو به ما یادآور می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 551.6,
   "end": 555.08,
   "text": "این نکته رو دقت کنید که ایران به نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 555.08,
   "end": 558.74,
   "text": "غیر قابل بازگشت در برنامه هسته‌ای‌اش رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 558.74,
   "end": 561.04,
   "text": "یعنی شما نمی‌تونید دیگه جلوش رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 561.04,
   "end": 563.34,
   "text": "این بدان معناست» خودشم داره تحلیل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 563.34,
   "end": 568.24,
   "text": "«این بدان معناست که ایرانی‌ها به پیر-پیروزی بزرگی دست یافته‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 568.24,
   "end": 573.06,
   "text": "از اظهارات مقام‌های مذاکره‌کننده با ایران نیز می‌توان چنین چیزی را دریافت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 573.06,
   "end": 577.42,
   "text": "این در ذات خود پیروزی بزرگی برای ایران محسوب می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 577.42,
   "end": 580.34,
   "text": "بدین ترتیب ایران ثابت کرد که می‌تواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 580.34,
   "end": 586.08,
   "text": "تحریم‌های بین‌المللی را تحمل کند و همزمان به پیشرفت هسته‌ش، هسته‌ای‌اش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 586.08,
   "end": 590.38,
   "text": "بپردازد.» روزنامه فیگارو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 590.38,
   "end": 594.94,
   "text": "سرتیترش می‌گه «اکنون ایران می‌تواند مرکز نظامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 594.94,
   "end": 598.26,
   "text": "و هسته‌ای اسرائیل رو رصد کند».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 598.26,
   "end": 604.58,
   "text": "لوموند تیتر می‌زنه «ایران با پرتاب نخستین موشک بالستیک نظامی خود گام دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 604.58,
   "end": 606.34,
   "text": "در راه تقابل برمی‌دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 606.34,
   "end": 611.9,
   "text": "بعد از عرصه تعجب دانشمندان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 611.9,
   "end": 616.98,
   "text": "سیاستمداران جهان در خصوص پرتاب موشک ایران» می‌گه خیلی مفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 616.98,
   "end": 619.98,
   "text": "من قسمت آخر مقاله رو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 619.98,
   "end": 622.28,
   "text": "ببینید خیلی شیرینه این قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 622.28,
   "end": 623.96,
   "text": "وقت نیست و الا اینو باز می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 623.96,
   "end": 628.68,
   "text": "خیلی شیرین بود. روبین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 628.68,
   "end": 632.6,
   "text": "تو مرکز دفتر مطالعات نظامی خارجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 632.6,
   "end": 637.74,
   "text": "یه هم شخصیت میشه گفت نظامی داره هم اطلاعاتی، هم امنیتی، هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 637.74,
   "end": 641.8,
   "text": "مثلاً از حیث خبرگزاری اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 641.8,
   "end": 645.3,
   "text": "هم شخصیت دانشگاهی داره تو رشته‌های نظامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 645.3,
   "end": 648.34,
   "text": "یه چهار پنج خط از صحبت‌های ایشون هم براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 648.34,
   "end": 652.42,
   "text": "شیرینه. می‌گه «رویکرد ایران به قدرت نرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 652.42,
   "end": 655.58,
   "text": "ماهرانه و متنوع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 655.58,
   "end": 661.56,
   "text": "برای درک قدرت نرم ایران باید سابقه امپرا-امپراتوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 661.56,
   "end": 664.04,
   "text": "تحولات مذهبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 664.04,
   "end": 667.0,
   "text": "زبان و فرهنگ فارسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 667.0,
   "end": 670.52,
   "text": "و تاریخ این کشور را به رسمیت شناخت.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 670.52,
   "end": 673.28,
   "text": "می‌گه همه اینا رو باید به رسمیت بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 673.28,
   "end": 676.14,
   "text": "دیگه «اگر تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 676.14,
   "end": 679.3,
   "text": "یکی از ستون‌های نفوذ ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 679.3,
   "end": 683.58,
   "text": "و یکی از نقاط اشتراکی باشد که مقامات این کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 683.58,
   "end": 689.58,
   "text": "استراژ-استراتژی‌های قدرت نرم را حول آن شکل می‌دهند»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 689.58,
   "end": 693.56,
   "text": "یعنی اگه تاریخ ایران، تاریخ تمدن ایران که الان چندتاش رو شمرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 693.56,
   "end": 697.9,
   "text": "اگه اینا یه ستون باشه که قدرت ایران حول اونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 697.9,
   "end": 700.16,
   "text": "اینجاش خیلی شیرینه. «دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 700.16,
   "end": 703.94,
   "text": "ستون دیگر جنگ نرم ایران است.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 703.94,
   "end": 706.28,
   "text": "این آقا داره اقرار می‌کنه. دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 706.28,
   "end": 709.78,
   "text": "اون داره. بعد مردم خودمون یه سری داخل استهلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 709.78,
   "end": 715.1,
   "text": "فرهنگی و دینی بهشون رخ داده که احساس می‌کنن مثلاً عقب موندگیه همه از دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 715.1,
   "end": 722.28,
   "text": "اون داره اقرار می‌کنه که از معجزات رشد ایران، پیشرفت چشمگیر ایران در همه صنعت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 722.28,
   "end": 724.18,
   "text": "در همه حوزه‌ها اصلاً دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 724.18,
   "end": 726.76,
   "text": "خود دین‌داری و مذهب‌مداریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 726.76,
   "end": 731.32,
   "text": "بعد اینا می‌ره حالا به سمت رهبری و اینا که دیگه فرصت ما گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 731.32,
   "end": 733.62,
   "text": "من سعی می‌کنم هر روز بخشی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 733.62,
   "end": 737.08,
   "text": "از شاید دستاوردها رو براتون بخونم یه مقدار کیف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 737.08,
   "end": 740.84,
   "text": "انشاالله اگر دوست داشتن بچه‌ها بذارن تو کانال دیگران هم بشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 740.84,
   "end": 742.68,
   "text": "یه ذره از این چیزا گوششون بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 742.68,
   "end": 744.9,
   "text": "انقدر دچار خودتحقیر نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 744.9,
   "end": 746.56,
   "text": "انشاالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 746.56,
   "end": 750.6,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 750.6,
   "end": 752.82,
   "text": "سلام بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 752.82,
   "end": 768.84,
   "text": "محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 768.84,
   "end": 769.66,
   "text": "و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}