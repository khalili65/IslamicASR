 "chapters": [
  {
   "index": 0,
   "title": "## میلاد امام هادی و زیارت جامعهٔ کبیره",
   "start": 24.52,
   "end": 80.6
  },
  {
   "index": 1,
   "title": "## نخستین حکومت علوی پس از حسن؛ ثمرهٔ خون اولیا",
   "start": 80.6,
   "end": 303.48
  },
  {
   "index": 2,
   "title": "## انتخابات به مثابهٔ واجب و تجدید میثاق با ولایت",
   "start": 303.48,
   "end": 324.06
  },
  {
   "index": 3,
   "title": "## احکام از مراجع؛ وجوب شرکت آگاهانه",
   "start": 324.06,
   "end": 394.67
  },
  {
   "index": 4,
   "title": "## لایمسه إلا المطهرون؛ تشنگی معرفت و سؤال زهرا",
   "start": 394.67,
   "end": 606.63
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 13.84,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.84,
   "end": 17.12,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.12,
   "end": 20.52,
   "text": "و ربانی یا آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.52,
   "end": 23.42,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.42,
   "end": 25.86,
   "text": "تبریک عرض می‌کنم روز میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.86,
   "end": 29.52,
   "text": "امام هادی صلوات الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.52,
   "end": 31.7,
   "text": "پرچمدار هدایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.7,
   "end": 35.22,
   "text": "و پرچمدار امام شناسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.22,
   "end": 41.14,
   "text": "هدیه بزرگ ایشون جامعه کبیره به ما یک دوره امام شناسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.14,
   "end": 44.9,
   "text": "خب در هشت سالگی امام بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.9,
   "end": 48.56,
   "text": "و سی و سه سال ایشون زحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.56,
   "end": 52.7,
   "text": "امامت رو به دوش بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.7,
   "end": 57.26,
   "text": "و البته چه امتحان سختی اون موقع پس دادن شیعیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.26,
   "end": 59.86,
   "text": "الحمد لله نمرشون خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.86,
   "end": 65.74,
   "text": "یه بچه هشت ساله. جمله امامانی بودن ایشون مثل امام جواد مثل خود امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.74,
   "end": 68.12,
   "text": "که در خردسالگی امام شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.12,
   "end": 74.12,
   "text": "تبریک میگم همچنین ایام دهه حالا بعضیا میگن دهه بعضیا میگن هفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.12,
   "end": 78.22,
   "text": "اگر اون سه روز بعد از عید غدیر رو هم بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.22,
   "end": 85.46,
   "text": "که علما گفتن حداقل سه روز برای عید غدیر جشن بگیرید چون سه روز پیغمبر نگه داشت قافله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.46,
   "end": 90.72,
   "text": "حالا اینطوری فکر کنیم می‌شه ده روز دیگه دهه ولایت بحثی نداریم که حالا هفته یا دهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.72,
   "end": 93.78,
   "text": "تبریک میگیم. جهت هشدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.78,
   "end": 97.0,
   "text": "و هوشیاری یه نکته‌ای می‌خوام عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.0,
   "end": 102.7,
   "text": "ببینید این حکومت اولین حکومت علوی و شیعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.7,
   "end": 106.28,
   "text": "که بعد از حکومت امیرالمؤمنین و توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.28,
   "end": 108.62,
   "text": "مرحله خیلی کوتاهی حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.62,
   "end": 112.76,
   "text": "پنج شش ماهه امام حسن صلوات الله علیهما دیگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.76,
   "end": 115.52,
   "text": "حکومت علوی و شیعی نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.52,
   "end": 118.26,
   "text": "همه حکومت‌ها مشوب شد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.26,
   "end": 121.98,
   "text": "باطل. این اولین حکومته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.98,
   "end": 126.92,
   "text": "یعنی ثمره خون حضرت زهرا خون سید الشهدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.92,
   "end": 130.34,
   "text": "بیابان گردی‌های امام عصرمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.34,
   "end": 138.1,
   "text": "امام عصر و امیرالمؤمنین حضرت وصی صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.1,
   "end": 144.06,
   "text": "معرفی کردن. هر کدوم این کلمات بار داره، بار معنوی عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.06,
   "end": 146.06,
   "text": "بیابانگرد آواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.06,
   "end": 150.5,
   "text": "طردشده تنهامانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.5,
   "end": 155.1,
   "text": "شوخی نیست. ماحصل همه این زحمات شده این دولت شیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.1,
   "end": 158.28,
   "text": "و ولایی. من تعجب می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.28,
   "end": 167.24,
   "text": "هنوز بعضیا از کسایی که ادعا می‌کنن ما پیرو خط شهدا و امام هستیم و مثلا باید قصد رأی دادن ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.24,
   "end": 169.78,
   "text": "اصلاً نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.78,
   "end": 172.16,
   "text": "منطق این عزیزان چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.16,
   "end": 176.62,
   "text": "واقعا نمی‌دونم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.62,
   "end": 179.42,
   "text": "لام، لام تأکیده اونم نون ثقیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.42,
   "end": 181.04,
   "text": "اون آخر باز تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.04,
   "end": 187.34,
   "text": "قطعاً، قطعاً از شما سؤال می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.34,
   "end": 190.36,
   "text": ". تمام تفاسیر شیعه فرمودن از ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.36,
   "end": 193.46,
   "text": "نعیم اینجا ولایته. خواب و خوراک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.46,
   "end": 196.9,
   "text": "مسکن و مرکب نیست. اینجا نعمت ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.9,
   "end": 200.22,
   "text": "سؤال می‌شه. عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.22,
   "end": 203.48,
   "text": "ما به زر صقاته عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.48,
   "end": 209.44,
   "text": "هنگام موت از موت به بعد ما فقط سؤال از نماز و روزه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.44,
   "end": 212.88,
   "text": "اول اتفاقاً از ولایت سؤال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.88,
   "end": 217.2,
   "text": "بعضی از بزرگان اهل معرفت که اعتقاد دارن حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.2,
   "end": 220.36,
   "text": "صلوات الله علیها مخصوصاً میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.36,
   "end": 222.84,
   "text": "هنگام موت شیعیان فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.84,
   "end": 225.88,
   "text": "حضرت زهرا میاد. علتش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.88,
   "end": 230.04,
   "text": "با اونوریا که کاری ندارن تموم شد اونا که اصلاً به باطل رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.04,
   "end": 234.04,
   "text": "همونطور که الان شیطان با اونوریا کاری نداره چون اونا به باطل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.04,
   "end": 237.72,
   "text": "شیطان کاری با اونا نداره. اتفاقا شیطان با من و شما کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.72,
   "end": 245.96,
   "text": "هرچی هم کسوت و هیئت دینی‌تره مثل من که لباس پیغمبر هست، شیطان اتفاقا مترصد اغوا امثال ما میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.96,
   "end": 248.72,
   "text": "برای اینه. چرا حضرت زهرا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.72,
   "end": 257.08,
   "text": "سؤال. اصلاً میاد سؤال کنه که با آخرین یادگار من ولایت زمان من چه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.08,
   "end": 261.36,
   "text": "که ثمره خون همه اولیاء الله شده این حکومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.36,
   "end": 264.48,
   "text": "حالا نسبت ما با این حکومت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.48,
   "end": 267.92,
   "text": "عزیزانی که غروب جمعه بودند تشریف آوردند عرض کردم خدمتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.92,
   "end": 272.08,
   "text": "نسبت بسنجیم خودمون، نه دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.08,
   "end": 274.66,
   "text": "من چه کردم برای این حکومت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.66,
   "end": 277.32,
   "text": "اولین حکومت ولایی و شیعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.32,
   "end": 282.64,
   "text": "چه کردم؟ از آبروم گذشتم، از پولم، نفسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.64,
   "end": 289.08,
   "text": "از جوونیم. الان الحمد لله پیشکسوت‌های جهاد و شهادت تو جمع ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.08,
   "end": 295.12,
   "text": "استوارم دوستان که ما از وجودشون فیض می‌بریم واقعاً در این محل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.12,
   "end": 301.42,
   "text": "در این محل مقدس واقعاً بنده فیض می‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.42,
   "end": 305.84,
   "text": "ما الان چه کردیم؟ الان دیگه وقتی اون کسی که پرچمدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.84,
   "end": 310.08,
   "text": "و زعیم عالم اسلامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.08,
   "end": 313.66,
   "text": "می‌فرماید که الان انتخابات از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.66,
   "end": 318.5,
   "text": "واجباته. واجب که فقط نماز نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.5,
   "end": 324.06,
   "text": "نسبت ما با اون چیه؟ بعد اگر ما شرکت نکنیم شور انتخاباتی کم بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.06,
   "end": 326.18,
   "text": "یا بدتر غیر اصلح بیاد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.18,
   "end": 331.56,
   "text": "اینها بعد تبعاتش همش تو نامه عمل من و شما درج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.56,
   "end": 335.9,
   "text": "این فقط این نیستش که اون پنجاه موقفی که قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.9,
   "end": 341.54,
   "text": "سؤال می‌کنند از من و شما فقط از نماز و روزه و خمس و زکات و امر به معروف و نهی از منکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.54,
   "end": 346.14,
   "text": "اینها. اتفاقاً باطن همه اینها ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.14,
   "end": 348.42,
   "text": "ما برای ولایت چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.42,
   "end": 351.74,
   "text": "حالا یه بحثی هست و بحث غدیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.74,
   "end": 355.28,
   "text": "الحمد لله یه مقدار بازارش داغ هست خداروشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.28,
   "end": 359.96,
   "text": "البته نه اونطوری که باید باشه مثل محرم و مثل اربعین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.96,
   "end": 362.85,
   "text": "بعضیا هم از اون ور بوم افتادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.85,
   "end": 368.97,
   "text": "الان به جای اینکه به فکر غدیر باشن از الان به فکر اربعینن و بستی خب برای آماده‌سازی و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.97,
   "end": 371.77,
   "text": "ولی غدیر چی؟ اینو چرا نمی‌پاییم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.77,
   "end": 374.11,
   "text": "مگه علامه امینی نفرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.11,
   "end": 376.65,
   "text": "یک بار کلاه سر ما ب- رفت بسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.65,
   "end": 380.23,
   "text": "اونم تو غدیر. کلاه رفت سرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.23,
   "end": 382.01,
   "text": "نسبت به غدیر بی‌تفاوت شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.01,
   "end": 385.63,
   "text": "اون کلاه رفت سر ما. غصب شد اون جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.63,
   "end": 388.65,
   "text": "جا، اون محل. خلافت غصب نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.65,
   "end": 391.49,
   "text": "امامت، وصایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.49,
   "end": 394.67,
   "text": "ولایت بس نشده. اون ریاست ظاهریه غصب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.67,
   "end": 397.87,
   "text": "این بلا سر ما اومده. بسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.87,
   "end": 401.89,
   "text": "در خصوص کربلا این اتفاق نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.89,
   "end": 405.19,
   "text": "خب حالا الان چی؟ الان در مقطع کنونی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.19,
   "end": 407.47,
   "text": "ما با انتخاباتمون داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.47,
   "end": 409.99,
   "text": "تجدید میثاق می‌کنیم با ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.99,
   "end": 412.05,
   "text": "مثلاً یه سؤال. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.05,
   "end": 414.77,
   "text": "هر کسی تو ذهن خودش جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.77,
   "end": 422.21,
   "text": "ما احکام شرعیه‌مون رو همین فروعات رو آقا چجوری من نماز بخونم، روزه چجوری بگیرم، وضو چجوری بگیرم بیام نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.21,
   "end": 425.07,
   "text": "اینا رو از کی یاد گرفتیم؟ از امام عصرمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.07,
   "end": 429.93,
   "text": "یعنی من و شما انقدر مثل سید ابن طاووس که فرمود هر وقت در مطلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.93,
   "end": 435.35,
   "text": "به شک و تردید افتادم حضور مبارک امام عصرم رسیدم و از او سوالمو پرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.35,
   "end": 437.73,
   "text": "کی گفته باب علم و یقین مسدوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.73,
   "end": 440.35,
   "text": "بازه. اما برای سید ابن طاووس‌ها خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.35,
   "end": 445.57,
   "text": "بیامرز. کدوم یک از ما سید ابن طاووس و سید بحر العلومیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.57,
   "end": 449.43,
   "text": "که بریم احکام شرعیمون رو از امام عصر اخذ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.43,
   "end": 453.53,
   "text": "هممون از همین مراجع. اینا علمدار دینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.53,
   "end": 459.69,
   "text": "و همون کسی که دقت بفرمایید چی عرض می‌کنم، نمازت رو از او یاد گرفتی، او داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.69,
   "end": 466.21,
   "text": "واجب شرعیه که شما در انتخابات شرکت کنی بعدم دقت کنی، چشمتو باز کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.21,
   "end": 469.35,
   "text": "باز تعجب دومی که بعضیا اصلاً توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.35,
   "end": 471.43,
   "text": "به صحبت‌ها و مناظرات اینا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.43,
   "end": 474.15,
   "text": "میگن آقا میریم رای میدیم دیگه حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.15,
   "end": 477.45,
   "text": "اصلاً نمیشینن گوش بدن توجه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.45,
   "end": 486.21,
   "text": "خدا شاهده من دیشب چه-- پلک نمیزدم که یه وقت یک جمله اینا تو مناظرات بگن من نشنیده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.21,
   "end": 490.63,
   "text": "آدمی که بعد پا شدم خ-خ عیال ما و حضرت حواهای منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.63,
   "end": 494.61,
   "text": "به ما گفت که حالا اون حواس ما که آدم نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.61,
   "end": 496.69,
   "text": "گفتش که خسته نباشید. گفتم چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.69,
   "end": 499.79,
   "text": "گفت خیلی تو بحر چهار ساعت اون چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.79,
   "end": 505.03,
   "text": "گفتم خب وظیفه است کسی که ایران رو دوست داره، کشورش رو دوست داره، انقلابش رو دوست داره مگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.03,
   "end": 506.77,
   "text": "میشه غیر از این باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.77,
   "end": 513.33,
   "text": "هر چقدرم دلت پره، هر چقدرم هممون گلایه‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.33,
   "end": 515.81,
   "text": "دهه، دهه ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.81,
   "end": 517.75,
   "text": "الحمدلله خوب وقتیم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.75,
   "end": 521.43,
   "text": "بحث انتخابات داغ. بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.43,
   "end": 524.55,
   "text": "مراقب اون سؤال اصلی حضرت زهرا صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.55,
   "end": 527.63,
   "text": "این حرفا رو کمتر کسیو من و شما میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.63,
   "end": 532.99,
   "text": "چون اینجور دست این روایاتی که مثلا حضرت زهرا میاد تو هر کتابی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.99,
   "end": 535.95,
   "text": "متن کتاب عربیه، ثقیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.95,
   "end": 538.75,
   "text": "بزرگان نوشتن مخصوصاً هم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.75,
   "end": 544.23,
   "text": "به یک کلمات پیچیده و غامض گفتن که هر کسی در هر کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.23,
   "end": 547.99,
   "text": "هر بی سر و پای اینا باید بشینه پای این دروس و این معارف که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.99,
   "end": 550.69,
   "text": "مثلاً یه علت اینکه امثال علامه حسن زاده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.69,
   "end": 553.49,
   "text": "یه طوری کتاب نوشتن که گیج میشی اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.49,
   "end": 558.05,
   "text": "شاره‌شم می مونه که قصه چیه تا نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.05,
   "end": 560.23,
   "text": "زانو نزنه. علتش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.23,
   "end": 563.17,
   "text": "کسی که تشنه است بیاد واقعاً خوانه بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.17,
   "end": 565.53,
   "text": "لا یمسهُ إلا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.53,
   "end": 567.17,
   "text": "اینا رو هر کسی به شما نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.17,
   "end": 569.35,
   "text": "مراقب جمله آخرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.35,
   "end": 573.07,
   "text": "مراقب سؤال حضرت صدیقه شهیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.07,
   "end": 576.17,
   "text": "صلوات الله علیها لب موت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.17,
   "end": 579.43,
   "text": "خودمون باشیم پیرامون این حکومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.43,
   "end": 587.53,
   "text": "که خلاصه زحمات تمام فرزندانشه حتی بیابان‌گردی امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.53,
   "end": 594.61,
   "text": "این رو مراقب باشیم. ما چه کردیم برای این حکومت، برای این انقلاب، برای این مردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 594.61,
   "end": 599.45,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.45,
   "end": 602.77,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.77,
   "end": 606.63,
   "text": "محمد و آل محمد عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}