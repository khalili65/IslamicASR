 },
 "chapters": [
  {
   "index": 0,
   "title": "## رجب و میلاد باقر العلوم؛ رمزِ مبارزه با تحریف",
   "start": 10.38,
   "end": 48.16
  },
  {
   "index": 1,
   "title": "## اذن الله؛ جاری در تکوین نه انتظار لفظ",
   "start": 48.16,
   "end": 615.9
  },
  {
   "index": 2,
   "title": "## نامهٔ عمل؛ خودِ تو کتابِ توست",
   "start": 615.9,
   "end": 671.12
  },
  {
   "index": 3,
   "title": "## توفّی انفس؛ خواب و موت",
   "start": 671.12,
   "end": 724.68
  },
  {
   "index": 4,
   "title": "## ظل و شمس و قمر؛ ولایت باب علم",
   "start": 724.68,
   "end": 933.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 8.92,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 12.02,
   "text": "تبریک عرض می‌کنم هم حلول ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.02,
   "end": 18.94,
   "text": "رجب رو که ماه عصبست و ریزش شدید رحمت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.94,
   "end": 22.5,
   "text": "و خاصه عجیبه که روز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.5,
   "end": 28.14,
   "text": "میلاد شکافنده علوم هست، امام باقر صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.14,
   "end": 31.98,
   "text": "در کتاب شریف انسان دویست و پنجاه ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.98,
   "end": 36.16,
   "text": "رهبر عزیزمون یه بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.16,
   "end": 39.7,
   "text": "زندگی‌نامه حضرت باقر رو که می‌فرمایند این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.7,
   "end": 42.26,
   "text": "یه رمزی رو فاش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.26,
   "end": 44.88,
   "text": "می‌فرماید، این فرمایش رهبر عزیزمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.88,
   "end": 48.16,
   "text": "می‌فرماد مبارزه با تحریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.16,
   "end": 57.48,
   "text": "در دوران امام باقر علیه السلام از همیشه پیش از زمان آن حضرت گسترده‌تر انجام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.48,
   "end": 60.64,
   "text": "یعنی یکی از مهم‌ترین کارهایی که امام باقر کرد چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.64,
   "end": 65.5,
   "text": "مبارزه با تحریف بود. اینکه حرف خدا و حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.5,
   "end": 72.3,
   "text": "دین خدا عوض بشه که الان تا دلت بخواد این اتفاق افتاده، مخصوصاً تو فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.3,
   "end": 75.78,
   "text": "بعد ادامه میدن که مبارزه فرهنگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.78,
   "end": 80.24,
   "text": "اینایی که الان دایه مبارزه فرهنگی دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.24,
   "end": 84.6,
   "text": "مبارزه فرهنگی یعنی تلاش برای تغییر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.6,
   "end": 89.18,
   "text": "فرهنگ حاکم بر ذهن‌های مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.18,
   "end": 93.52,
   "text": "چقدر الان فرهنگ حاکم بر اذهان مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.52,
   "end": 101.58,
   "text": "اشتباهه. چقدر حرف‌های غلط، برداشت‌های ناصحیح از متن دین متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.58,
   "end": 106.34,
   "text": "بعد ادامه میدن تا راه را برای حکومت الهی هموار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.34,
   "end": 109.9,
   "text": "و بر حکومت طاغوتی ببندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.9,
   "end": 115.18,
   "text": "یعنی ماهایی که ادعا می‌کنیم زمینه‌ساز ظهور امام عصر بخواهیم باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.18,
   "end": 117.82,
   "text": "می‌فرماید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.82,
   "end": 124.18,
   "text": "برطرف کردن اون فرهنگ حاکم و غلطی که تو اذهان مردمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.18,
   "end": 128.48,
   "text": "می‌شه خودش هموار کردن راه حکومت امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.48,
   "end": 132.52,
   "text": "این فرمایش امام باقر صلی الله علیه اینو داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.52,
   "end": 135.04,
   "text": "ما چقدر زحمت کشیدیم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.04,
   "end": 139.0,
   "text": "تغییر نگرش مردم، فکر مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.0,
   "end": 141.3,
   "text": "خیلی، خیلی جون کندیم یه صدقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.3,
   "end": 148.14,
   "text": "یه کمک مالی به یه نیازمندی کردیم و حالا افکار رو بخواهیم تغییر بدیم، افکار غلط رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.14,
   "end": 151.3,
   "text": "تصحیح کنیم، اونم بر مبنای قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.3,
   "end": 155.96,
   "text": "نه، خیلی کم. بعد باز می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.96,
   "end": 158.3,
   "text": "و امام باقر این کار رو شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.3,
   "end": 160.54,
   "text": "یعنی بعد از قصه کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.54,
   "end": 164.68,
   "text": "و امام سجاد، امام باقر شروع کننده چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.68,
   "end": 170.12,
   "text": "تغییر اذهان، اون فرهنگ حاکم غلط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.12,
   "end": 176.1,
   "text": "باز ادامه میدن که باقر علم الاولین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.1,
   "end": 177.84,
   "text": "می‌خواد اینو ترجمه کنه رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.84,
   "end": 181.76,
   "text": "یعنی چی؟ باقر علم الاولین والاخرین یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.76,
   "end": 188.28,
   "text": "یعنی این. ایشان شکافنده حقایق قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.28,
   "end": 191.3,
   "text": "و دانش‌های اسلامی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.3,
   "end": 194.02,
   "text": "حقایق قرآنی و دانش‌های اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.02,
   "end": 201.0,
   "text": "یعنی تبیین همین جهاد تبیین که آقا می‌فرمود متاسفانه غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.0,
   "end": 204.36,
   "text": "رفتیم به سمت تبیین مسائل سیاسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.36,
   "end": 207.56,
   "text": "اونم خیلی خوب و مورد نیاز جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.56,
   "end": 212.34,
   "text": "اما غافل شدیم از این موضوع که رهبر فرمودند ما در حوزه معارف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.34,
   "end": 216.28,
   "text": "معارف دین بسیار حرف‌های نگفته داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.28,
   "end": 219.76,
   "text": "خب اینا کجان؟ اگر چهل و چند ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.76,
   "end": 223.72,
   "text": "بزرگان و علما و آخوندای ما بالا منبر نمیگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.72,
   "end": 228.02,
   "text": "پس چگونه است که بسیاری حرف‌های نگفته داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.02,
   "end": 231.52,
   "text": "و چقدر اشتباه مردم برداشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.52,
   "end": 237.62,
   "text": "ما در خصوص همین توحید صمدی قرآن که اصلاً الصمد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.62,
   "end": 240.5,
   "text": "تو همین هر، هر روز داریم تو نمازامون هم می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.5,
   "end": 242.96,
   "text": "تو این ماه هم وارد شده مثلاً هزار بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.96,
   "end": 246.66,
   "text": "سوره قل هوالله خوندن یا روزی صد بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.66,
   "end": 249.0,
   "text": "قل هوالله احد الله الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.0,
   "end": 251.68,
   "text": "خب یعنی چی؟ صمد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.68,
   "end": 255.3,
   "text": "متاسفانه تو قرآن هم نوشتن بی‌نیاز، این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.3,
   "end": 262.6,
   "text": "غنی یعنی بی‌نیاز. الصمد رو از حضرت سؤال کردن حضرت فرمود الذي لا جوف له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.6,
   "end": 265.4,
   "text": "کسیه که پر کرده همه جا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.4,
   "end": 268.12,
   "text": "هو معکم أینما کنتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.12,
   "end": 272.36,
   "text": "هو الاول والآخر والظاهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.36,
   "end": 275.12,
   "text": "اول و آخر اوست. ظاهر و باطن اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.12,
   "end": 281.22,
   "text": "اصلاً جز او کسی نیست. اگر بخواهیم شیعیتی قائل بشیم برای چیزی به جز خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.22,
   "end": 285.28,
   "text": "دویت پیش میاد. یعنی یک جای ابسیلون، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.28,
   "end": 290.82,
   "text": "ذره یک جایی رو پیدا کردیم که خدا اونجا نیست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.82,
   "end": 295.04,
   "text": "که ما الان این توحیدی که از قدیم به ما یاد دادن شرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.04,
   "end": 297.06,
   "text": "میگه خب این آسمان، این هم زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.06,
   "end": 302.76,
   "text": "حالا خدای خالد این آسمان و زمین رو بگردین ببینین کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.76,
   "end": 305.1,
   "text": "فأینما تولى فثم وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.1,
   "end": 308.7,
   "text": "این آیاتیه که نیاز به تبیین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.7,
   "end": 313.78,
   "text": "من چندین سال لطف کرد خدا از همون ابتدا که شهید حججی دفع شد رفتیم به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.78,
   "end": 315.72,
   "text": "م-منبری دهه مهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.72,
   "end": 319.4,
   "text": "م-محرم‌هاشون اونجا صحبت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.4,
   "end": 325.52,
   "text": "هر سال حداقل یک منبر پیرامون حقیقت توحید صمدی حرف می‌زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.52,
   "end": 328.04,
   "text": "نگرش‌ها کاملاً عوض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.04,
   "end": 333.18,
   "text": "متاسفانه آخرین سالی که رفتیم که پارسال بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.18,
   "end": 336.96,
   "text": "یکی از خادم‌هایی که هر سال هم می‌دیدیمش ایشون گفت عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.96,
   "end": 338.98,
   "text": "من اولین باره دارم می‌شنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.98,
   "end": 342.4,
   "text": "این حالا چند سال اونجا خدمت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.4,
   "end": 346.76,
   "text": "اولین باره عجب چیزیه این توحید صمدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.76,
   "end": 350.52,
   "text": "تمام معارف حق بر مبنای توحید صمدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.52,
   "end": 352.9,
   "text": "که حالا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.9,
   "end": 357.98,
   "text": "ملاصدرا می‌فرماید که در اسفارش که اگر خب همه چی حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.98,
   "end": 361.68,
   "text": "که اگر حق یک وجود واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.68,
   "end": 364.12,
   "text": "مثل اینکه شما یک وجود واحدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.12,
   "end": 368.06,
   "text": "یک شخصی. اتوار مختلف داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.06,
   "end": 376.12,
   "text": "طورهای مختلف داری. یک طورت نشستنت، ایستادنت، خندیدنت، گریه کردنت، خوابیدنت، خوردنت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.12,
   "end": 380.38,
   "text": "چشم و گوش و سمع و بصر و همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.38,
   "end": 383.16,
   "text": "شم و لمس و خیال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.16,
   "end": 388.14,
   "text": "وهم و عقل و قلب و روح و سر و سر و سر و همینطوری این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.14,
   "end": 390.56,
   "text": "کثرات اما یک وجود واحدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.56,
   "end": 398.32,
   "text": "درسته؟ بعد ملاصدرا می‌فرماید اگر یک وجود واحد از سمد است که همه جا رو پر کرده، پس تکلیف این کثرات چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.32,
   "end": 401.06,
   "text": "این همه کثرت خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.06,
   "end": 404.58,
   "text": "اینا چی‌ان؟ می‌فرماید خود قرآن فرموده اینا چی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.58,
   "end": 410.08,
   "text": "\"إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.08,
   "end": 417.5,
   "text": "لأولي الألباب\" یا \"وفى الأرض آيات للموقنين، وفي أنفسكم أفلا تبصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.5,
   "end": 420.88,
   "text": "آ اینا آیات الهی‌اند. نشانه‌های الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.88,
   "end": 423.02,
   "text": "ظهور حق‌اند. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.02,
   "end": 426.5,
   "text": "نه اینکه من و شما هر شیئی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.5,
   "end": 430.88,
   "text": "هر صورتی از اشیا، یک چیزی، یک ظرفی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.88,
   "end": 433.14,
   "text": "که حالا اومده درش خدا ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.14,
   "end": 435.76,
   "text": "نه، اصلاً عینیّت این شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.76,
   "end": 438.24,
   "text": "یعنی اصلاً بودنش همون ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.24,
   "end": 440.72,
   "text": "یعنی خدا ظهور کرده شده این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.72,
   "end": 443.74,
   "text": "همه چی حقه. اینا نیاز به تبیین نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.74,
   "end": 446.58,
   "text": "چقدر نگاه‌ها رو تغییر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.58,
   "end": 450.06,
   "text": "آیه قرآنه \"سنوريهم\". \"سنوريهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.06,
   "end": 453.46,
   "text": "ما می‌خوایم ما قطعاً در آینده \"سنوريهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.46,
   "end": 455.68,
   "text": "نشون می‌دیم به این‌ها. چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.68,
   "end": 457.5,
   "text": "آیاتنا. آیات‌هامون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.5,
   "end": 461.94,
   "text": "کجا نشون میدی خدا؟ \"في الآفاق وفي أنفسهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.94,
   "end": 465.12,
   "text": "نظام آفاقی و انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.12,
   "end": 467.24,
   "text": "دو تا نظام. که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.24,
   "end": 470.9,
   "text": "\"حتى يتبين لهم أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.9,
   "end": 475.02,
   "text": "تو نظام آفاقی و انفسی به این‌ها نشان خواهیم داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.02,
   "end": 478.38,
   "text": "که اون حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.38,
   "end": 481.14,
   "text": "یعنی حق ظهور کرده در هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.14,
   "end": 486.08,
   "text": "او حقه. در نظام آیات آفاقی و انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.08,
   "end": 494.0,
   "text": "ببینید از قرآن وقتی شما بر-- اینجا رهبر عزیزمون فرمودن که کار امام باقر تبیین حقایق قرآنی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.0,
   "end": 501.26,
   "text": "حالا ما چند تا، چند تا آیه رو گذاشتیم تا حالا رو میز کار کارگاهی انجام دادیم، اینا رو تبیین کردیم و ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.26,
   "end": 505.28,
   "text": "گراه‌های ذهنی مردم رو برطرف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.28,
   "end": 510.42,
   "text": "یا اینجایی که می‌فرماید \"من والذي يشفع عنده إلا بإذنه\" آیه الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.42,
   "end": 515.84,
   "text": "این اذن الله که رهبر عزیزمون هم اخیراً فرمودن پاسخ سخت به اذن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.84,
   "end": 518.26,
   "text": "اصلاً اذن الله چیه؟ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.26,
   "end": 521.98,
   "text": "یعنی ما منتظریم خدا بزه-بگه بزن بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.98,
   "end": 524.84,
   "text": "منتظریم تا خدا بگه انتقام بگیر بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.84,
   "end": 527.64,
   "text": "منتظریم به این معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.64,
   "end": 531.86,
   "text": "که یک لفظی صادر بشه \"کن فیکون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.86,
   "end": 535.98,
   "text": "اذن الله در اصلاً تکویناً در کائنات جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.98,
   "end": 540.98,
   "text": "مثال مثل اینکه شما الان چشمت داره به اذن نفس می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.98,
   "end": 549.38,
   "text": "اگر این نفست اذن نده، آنی اذن نده به چشمت اصلاً چشمت دیگه نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.38,
   "end": 552.26,
   "text": "آیا این چشم منتظر اذن نفسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.26,
   "end": 554.44,
   "text": "اصلاً تکویناً جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.44,
   "end": 557.16,
   "text": "اذن نفس در دیدن چشم جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.16,
   "end": 560.66,
   "text": "اصلاً چشم داره به اذن نفس می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.66,
   "end": 562.84,
   "text": "اذن الله رو اینطوری باید ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.84,
   "end": 567.58,
   "text": "اصلاً در تکوین نظام هستی، در بافت و چینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.58,
   "end": 570.18,
   "text": "نظام هستی اذن الله جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 570.18,
   "end": 575.02,
   "text": "هر چیزی به اذن الله. به اذن او هر برگی از درخت می‌افته به اذن اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.02,
   "end": 579.4,
   "text": "\"لا حول ولا قوة إلا بالله العلی العظیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.4,
   "end": 581.7,
   "text": "سر برده آقا رو نیزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.7,
   "end": 584.04,
   "text": "چی گفت؟ آیاتی که خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.04,
   "end": 588.92,
   "text": "\"وسيعلم الذين ظلموا أي منقلب ينقلبون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 588.92,
   "end": 592.42,
   "text": "می‌بینن بعدها آشکار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.42,
   "end": 595.84,
   "text": "\"سيعلم\" همه اینو می‌دانند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.84,
   "end": 598.62,
   "text": "کسی که ظلم کرده به سزاش می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.62,
   "end": 601.72,
   "text": "این یعنی اذن. اصلاً اذن الهی جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.72,
   "end": 604.9,
   "text": "ظالم چوب ظلمش رو می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.9,
   "end": 606.68,
   "text": "و خدا از مظلوم دفاع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.68,
   "end": 612.56,
   "text": "این اذنه. یعنی نگاه به اذن الله در آیات، به وسیله آیات باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.56,
   "end": 614.88,
   "text": "عوض شه. هی می‌گیم نامه عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.88,
   "end": 617.4,
   "text": "مثلا امام زمان صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 617.4,
   "end": 622.3,
   "text": "روز دوشنبه و پ-- جمعه نامه عمل ما رو می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 622.3,
   "end": 627.8,
   "text": "مگر اونجا که ملائکه کاتبند، اونجا ماده‌ست، کتابه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.8,
   "end": 630.52,
   "text": "اونجا که مجرده. اینجا ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 630.52,
   "end": 636.28,
   "text": "پس چه نامه عملی؟ فرمود \"اقرأ كتابك كفى\" آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.28,
   "end": 639.52,
   "text": "\"کفى بنفسك اليوم عليك حسيباً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.52,
   "end": 642.24,
   "text": "تو خودت کافیی برای حسابرسی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 642.24,
   "end": 646.12,
   "text": "خودت کتاب خودتی. \"ن والقلم وما يسترون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.12,
   "end": 652.22,
   "text": "تو خودت با علم و عملت داری کتاب وجود خودت رو سطر سطر می‌نویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 652.22,
   "end": 659.6,
   "text": "نگاه‌ها باید عوض بشه. این آیه رو ببینید چقدر این آیه شیرینه، چقدر علامه حسن زاده در فصوص و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 659.6,
   "end": 661.66,
   "text": "مصباح این رو شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.66,
   "end": 666.52,
   "text": "چقدر شیرین. \"الله يتوفى الأنفس حين موتها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 666.52,
   "end": 671.12,
   "text": "خداست که وقت موت به تمامه جان رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.12,
   "end": 673.14,
   "text": "پس عزرائیل اینجا چیکاره است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.14,
   "end": 676.4,
   "text": "اگه \"الله يتوفى الأنفس حين موتها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.4,
   "end": 678.34,
   "text": "دو، \"والتي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 678.34,
   "end": 680.82,
   "text": "لم تمت في منامها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 680.82,
   "end": 686.16,
   "text": "حتی کسی که \"لم تمت\" نمرده‌ها اما \"في منامها\" تو خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 686.16,
   "end": 690.32,
   "text": "یعنی اونی هم که تو خوابه جانش رو خدا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 690.32,
   "end": 693.16,
   "text": "چیه؟ ان نام اخو الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 693.16,
   "end": 696.16,
   "text": "یعنی اصلاً نگاه به موت رو تغییر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 696.16,
   "end": 698.18,
   "text": "موت اون چیزی نیست که ما فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.18,
   "end": 700.64,
   "text": "یعنی نابودی. آقا بیچاره شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.64,
   "end": 702.7,
   "text": "داداشم مرد، پدرم مرد فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 702.7,
   "end": 707.74,
   "text": "این یعنی ارتقای وجودی. چگونه است که تا الان وقتی من و شما می‌خوابیم می‌ریم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 707.74,
   "end": 710.98,
   "text": "یه عالمی به نام عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 710.98,
   "end": 714.68,
   "text": "چقدر صور و اشکال اونجا می‌بینیم و برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 714.68,
   "end": 717.58,
   "text": "موت یعنی این. یعنی سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 717.58,
   "end": 720.8,
   "text": "ببینید یکی یکی مثال همه اینا رو هم ما گفتیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.8,
   "end": 724.68,
   "text": "همه این آیات رو ما بارها و بارها درباره‌ش با هم صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 724.68,
   "end": 728.8,
   "text": "\"ألم تر إلى ربك كيف مدDال بحر\" به به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 728.8,
   "end": 732.8,
   "text": "آیا نگاه نمیکنی به پروردگارت که چگونه سایه رو میکشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 732.8,
   "end": 735.78,
   "text": "تفسیر ظاهریش یعنی بین الطلوعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 735.78,
   "end": 739.9,
   "text": "که نه شبه نه روزه. میکشه این سایه رو تا روز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 739.9,
   "end": 741.78,
   "text": "اما تفسیر انفسیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 741.78,
   "end": 745.82,
   "text": "اون تفسیر آفاقیه. تفسیر انفسیش یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 745.82,
   "end": 751.04,
   "text": "ظل، ظل الله که مد خدا بهش میده و میکشش نفس الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 751.04,
   "end": 757.24,
   "text": "صادر اوله مثل تو که یه نفس داری هو میزنی این همه کلمات ازش منتشر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.24,
   "end": 762.1,
   "text": "نفس الهی زده این همه کلمات وجودی نظام هستی ازش منتشر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 762.1,
   "end": 764.42,
   "text": "این حقایق رو کی ما باید بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.42,
   "end": 769.54,
   "text": "کی جایگاه خودمون رو نسبت به این کلمات وجودی نظام هستی باید بسنجیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.54,
   "end": 773.76,
   "text": "که میگه اون صادر اول و اون نفس الرحمن پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.76,
   "end": 777.4,
   "text": "یا إن فی خلق السماوات. اینا میگه آقا ذکر بده، ذکر بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 777.4,
   "end": 780.42,
   "text": "ورد بده در حقیقت. داره میگه ورد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 780.42,
   "end": 782.94,
   "text": "علامه میگه آقا انقدر دنبال ذکر نرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 782.94,
   "end": 786.64,
   "text": "این دو تا آیه صد و نود و صد و صد و نود و یک آل عمران رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 786.64,
   "end": 790.9,
   "text": "إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.9,
   "end": 796.02,
   "text": "لأولي الألباب. آیه ها رو کسی دقت میکنه لب داره، مغز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 796.02,
   "end": 799.78,
   "text": "بعد میفرماید الذين يذكرون الله ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 799.78,
   "end": 803.06,
   "text": "قيما وقعودا وعلى جنوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 803.06,
   "end": 804.98,
   "text": "در هر حال مشغول ذکرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 804.98,
   "end": 807.54,
   "text": "بعد میفرماید حالا اینها که مشغول ذکرند چی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 807.54,
   "end": 810.82,
   "text": "ويتفكرون في خلق السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 810.82,
   "end": 814.0,
   "text": "علامه میفرماید ذکر رو میاره بین دو تا فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 814.0,
   "end": 817.02,
   "text": "یعنی تو اهل فکر باش، اهل تفکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.02,
   "end": 821.18,
   "text": "و با دیده عقل نگاه کردن به پیرامون خودت باش ذکر میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 821.18,
   "end": 824.42,
   "text": "ما ورد میگیم، تسبیح می‌گیریم همینطوری میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.42,
   "end": 827.5,
   "text": "اهل ذکر و باطن اون نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 827.5,
   "end": 831.12,
   "text": "کمال چی رو به ما یاد میده؟ يا من اسمه دواء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 831.12,
   "end": 835.06,
   "text": "اسمت دواست بله اما میشه آدم دوا بخوره خوب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 835.06,
   "end": 838.3,
   "text": "و ذكره شفاء. ذکر که شفا دهنده شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 838.3,
   "end": 839.94,
   "text": "اینا تو آیات تبیین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 839.94,
   "end": 842.14,
   "text": "حالا حرف زیاده. والشمس وضحاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 842.14,
   "end": 847.0,
   "text": "انقدر من آیه نوشتم از هر کدوم یه تبیینی که بارها هم گفتیم دوباره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 847.0,
   "end": 849.74,
   "text": "زیاده. وقتتون رو میگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 849.74,
   "end": 855.82,
   "text": "یه دونه هم دیگه عرض کنم بسه. شمس میگه وضحی نور رو استناد میده به شمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 855.82,
   "end": 861.58,
   "text": "حالا شمس کیه؟ در تفسیر انفسی و تأویل قرآن فرمودن پیغمبر عزیز عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 861.58,
   "end": 864.0,
   "text": "والقمر إنها تلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 864.0,
   "end": 867.02,
   "text": "بعد قمر به دنبال شمس راه میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 867.02,
   "end": 870.58,
   "text": "یعنی شق-- قمر به شخصه نور نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.58,
   "end": 872.48,
   "text": "نورش رو از خورشید میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 872.48,
   "end": 875.9,
   "text": "میگه این قمر امیرالمؤمنینه که به دنبال پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 875.9,
   "end": 879.4,
   "text": "اگر بخواهی به شمس بخ-برسی راهش امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 879.4,
   "end": 883.08,
   "text": "از طریق ولایت. جز با ولایت نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 883.08,
   "end": 886.54,
   "text": "اینکه فرمود أنا مدینة العلم و علی بابها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 886.54,
   "end": 889.26,
   "text": "اصلا اینجا باب علم علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 889.26,
   "end": 892.32,
   "text": "موضوعیت داره. نه اینکه حالا یه باب علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 892.32,
   "end": 894.54,
   "text": "یه باب هم ایکس و ایگرگه. نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 894.54,
   "end": 898.28,
   "text": "اصلا هیچ علمی نیست مگر از باب علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 898.28,
   "end": 900.02,
   "text": "یعنی اصلا دیگه علمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 900.02,
   "end": 904.34,
   "text": "اگر علمی رو از جز باب ولایت اخذ کنی علم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 904.34,
   "end": 907.34,
   "text": "دروغه، کذبه، وهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 907.34,
   "end": 913.64,
   "text": "خیاله. چقدر ما گرفته.\" حالا امام باقر اومده شکافته، اینا رو شکافته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 913.64,
   "end": 917.06,
   "text": "ما نباید بشینیم اینها رو برای خودمون بگیم، تبیین کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 917.06,
   "end": 920.86,
   "text": "سر این سفره‌ها بنشینیم. مائده‌های الهین انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 920.86,
   "end": 924.2,
   "text": "خدا انشاالله عاقبتمون رو ختم به خیر کنه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 924.2,
   "end": 926.62,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 926.62,
   "end": 933.9,
   "text": "اللهم صل على محمد و آل محمد. الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}