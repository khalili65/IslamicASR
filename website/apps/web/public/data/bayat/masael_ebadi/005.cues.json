 },
 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از انتقام سخت پس از طوفان الأقصی",
   "start": 19.48,
   "end": 469.23
  },
  {
   "index": 1,
   "title": "## سایبر، امرون و اقتصاد جنگ",
   "start": 469.23,
   "end": 536.27
  },
  {
   "index": 2,
   "title": "## تجهیز جبههٔ مقاومت و جنگ نیابتی",
   "start": 536.27,
   "end": 918.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.52,
   "end": 6.96,
   "text": "اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.96,
   "end": 11.58,
   "text": "محمد بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.58,
   "end": 14.98,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.98,
   "end": 17.3,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.3,
   "end": 19.48,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.48,
   "end": 23.44,
   "text": "دیروز سخن در تاثیرات طوفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.44,
   "end": 27.94,
   "text": "الأقصى و این‌ها، قصه هفت اکتبر و این‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.94,
   "end": 32.86,
   "text": "و اینکه بعضیا اشکال میکنن که حالا انتقام سخت و خُن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.86,
   "end": 36.34,
   "text": "عرض شود پاسخ سخت و اینا کجا گرفته شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.34,
   "end": 41.44,
   "text": "یعنی چند تا، اینا تحلیل نیست که الان میخوام ارائه بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.44,
   "end": 43.88,
   "text": "خبر قطعی‌ست که واقع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.88,
   "end": 46.1,
   "text": "بعضیاش رو خب خبرگزاری‌ها گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.1,
   "end": 48.74,
   "text": "چه خبرگزاری‌های خارجی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.74,
   "end": 51.4,
   "text": "چه داخلی. بعضیاشم نگفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.4,
   "end": 55.14,
   "text": "مثلا خود سرهنگ تنگس، تنگسیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.14,
   "end": 60.94,
   "text": "ایشون خودشون خیلی تو لفافه گفتن ما نه تا سیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.94,
   "end": 67.48,
   "text": "جانانه به آمریکا زدیم و بنا به بعضی از دلایل امنیتی نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.48,
   "end": 72.04,
   "text": "خب یعنی هر، اینطوری گفتن اما حالا بخوان بازش کنن خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.04,
   "end": 75.3,
   "text": "نه. که حالا من چند تاشو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.3,
   "end": 83.7,
   "text": "اولین اقدامی که بعد از قصه شهادت حاج قاسم چهار سال پیش رخ داد، دیگه همه شاهد بودیم همون زدن پایگاه الأسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.7,
   "end": 88.14,
   "text": "شما نشنید بگید حالا همش شش تا موشک نمیدونم بعدم تخ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.14,
   "end": 90.98,
   "text": "از قبل هماهنگ شده بود و اینا رفته بودن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.98,
   "end": 94.34,
   "text": "این صحبت‌ها می‌شه حالا هست یا نیست کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.34,
   "end": 97.66,
   "text": "شما به اصل موضوع نگاه کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.66,
   "end": 100.12,
   "text": "پایگاه آمریکا تو منطقه زده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.12,
   "end": 102.14,
   "text": "کی جرات داشت این کارو بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.14,
   "end": 106.1,
   "text": "اولین بار بود. یعنی قبل از این همچین اتفاقی نیفتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.1,
   "end": 108.8,
   "text": "اصلاً کسی جگر نداشت. مثل قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.8,
   "end": 113.68,
   "text": "هست امام که برای اولین بار گفت مرگ، تو ایون جماران نشسته فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.68,
   "end": 117.16,
   "text": "مرگ بر آمریکا. کی جرات داشت بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.16,
   "end": 123.7,
   "text": "وقتی شما بررسی میکنی محیط رو، میدان رو متوجه میشی چه کار بزرگی انجام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.7,
   "end": 129.82,
   "text": "یعنی اون شکست هیمنه آمریکا، این مهم‌ترین کاری بود که بلافاصله انجام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.82,
   "end": 136.82,
   "text": "تازه با اون مشکلات متاسفانه نفوذی که ما در بحث امنیتمون داشتیم که دیگه مستحضر هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.82,
   "end": 140.16,
   "text": "در مسئولین امنیتی‌مون. یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.16,
   "end": 143.46,
   "text": "دبیر شورای عالی امنیت ملی کی بود اون موقع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.46,
   "end": 147.32,
   "text": "رییس جمهور. کی بود اون موقع مثلا رییس جمهور ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.32,
   "end": 155.0,
   "text": "بماند. بلافاصله در مس، مسج، مجلس عراق تصویب شد خروج آمریکا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.0,
   "end": 157.36,
   "text": "البته با یه بلافاصله که بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.36,
   "end": 159.94,
   "text": "چند ماهی فکر میکنم طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.94,
   "end": 166.04,
   "text": "در مجلس عراق تصویب شد برای اولین بار رسما که آمریکا باید از عراق بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.04,
   "end": 168.92,
   "text": "البته هنوز به صورت کامل خارج نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.92,
   "end": 172.8,
   "text": "با اون سه هزار تا نیرویی که اونجا پیاده کرده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.8,
   "end": 178.32,
   "text": "اینا رو قرار شد با یک مرحله‌بندی فازبندی کنن و خارج کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.32,
   "end": 182.44,
   "text": "بعد اول گفتن فازبندی می‌کنیم خارج می‌کنیم، نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.44,
   "end": 185.4,
   "text": "بعد ش، بچه‌های مقاومت دست به کار شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.4,
   "end": 189.58,
   "text": "شروع کردن پایگاه‌هاشون رو زدن. در عراق، در سوریه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.58,
   "end": 193.46,
   "text": "در لبنان، در بعضی از جاهای سرزمین اشغالی زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.46,
   "end": 196.06,
   "text": "وقتی که زدن این مثل اینکه جدیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.06,
   "end": 198.96,
   "text": "دوباره مجلس فشار آورد، مجلس عراق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.96,
   "end": 203.66,
   "text": "بعد اینا شروع کردن یه جدولی دادن بیرون و جالبه که شما بدونید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.66,
   "end": 205.94,
   "text": "من یادمه این خبر گفته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.94,
   "end": 208.22,
   "text": "حالا شاید از ذهنا رفته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.22,
   "end": 212.24,
   "text": "اعلام شد که آمریکا نامه‌ای داده به ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.24,
   "end": 217.64,
   "text": "که شما میانجی‌گری کنید ما بتونیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.64,
   "end": 220.76,
   "text": "ضریب امنیتی بالا از عراق خارج شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.76,
   "end": 222.7,
   "text": "یعنی آسیبی نبینیم و خارج شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.7,
   "end": 227.32,
   "text": "اینا به نظر شما با توجه به اون هیمنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.32,
   "end": 230.44,
   "text": "آنچنانی آمریکا، اینا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.44,
   "end": 235.58,
   "text": "خودش نمی‌تونه یه انتقام باشه، یه پاسخ باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.58,
   "end": 237.86,
   "text": "بعد عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.86,
   "end": 243.04,
   "text": "از افغانستان حتی خروج آمریکا کلید خورد بلافاصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.04,
   "end": 246.72,
   "text": "یه قایقی، اینو، این خبرش رفت یادمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.72,
   "end": 249.2,
   "text": "یه قایقی واژگون شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.2,
   "end": 252.98,
   "text": "توی ایتالیا. بچه‌های ما بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.98,
   "end": 261.56,
   "text": "حالا یکی از مقامات موساد، مقامات ارشد موساد تو اون قایق بود و به درک واصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.56,
   "end": 265.54,
   "text": "و حالا اسمشو نبردن فقط گفتن مقامات ارشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.54,
   "end": 271.32,
   "text": "بعد اون معادلات پیمان ابراهیم یادتون باشه به هم خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.32,
   "end": 274.76,
   "text": "تا همینطوری اومد تا پیمان‌هایی که تا همین اخیر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.76,
   "end": 278.82,
   "text": "بین عربستان و اسرائیل و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.82,
   "end": 283.98,
   "text": "کشورهای حوزه خلیج فارس و این‌ها، پیمان‌هایی که بسته بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.98,
   "end": 288.86,
   "text": "به قولی اصلاً اون نفرت اسرائیل برداشته بشه حتی اسرائیل بیاد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.86,
   "end": 292.92,
   "text": "جا، حالا بخش‌های مختلف اقتصادی، ورزشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.92,
   "end": 297.14,
   "text": "فرهنگی، جاهایی که ممنوع الورود بود بیاد ورود کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.14,
   "end": 300.88,
   "text": "داشت رسما این اتفاق می‌افتاد ولی همش به هم ریخت بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.88,
   "end": 304.26,
   "text": "طوفان الأقصى و بعد از البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.26,
   "end": 307.56,
   "text": "از زمان شهادت حاج قاسم اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.56,
   "end": 311.18,
   "text": "کلیدش خورد. حالا با این طوفان الأقصى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.18,
   "end": 314.06,
   "text": "دیگه الحمد لله به اوج رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.06,
   "end": 317.96,
   "text": "و مغز متفکر فضایی و موشکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.96,
   "end": 320.98,
   "text": "رژیم صهیونیستی کشته شد توی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.98,
   "end": 324.06,
   "text": "حمله‌ای که بچه‌ها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.06,
   "end": 327.04,
   "text": "فهیم هیناوی افسر اطلاعاتی اسرائیل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.04,
   "end": 329.24,
   "text": "می‌دونید که بعد از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.24,
   "end": 332.64,
   "text": "خدا رحمت کنه شهید فخری‌زاده رو، من که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.64,
   "end": 335.98,
   "text": "مجروح شده بودم ایشون اومده بود عیادت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.98,
   "end": 339.84,
   "text": "چقدر افتاده حال. انگار نه انگار مثلا یک دانشمند هسته‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.84,
   "end": 343.14,
   "text": "انقدر خاکی، انقدر باصفا این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.14,
   "end": 346.02,
   "text": "وقتی ایشون شهید شد من خیلی پژمرده شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.02,
   "end": 348.28,
   "text": "الحمد لله وقتی شنیدیم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.28,
   "end": 355.48,
   "text": "فهیم هیناوی بعد از یه هفته بعد از شهادت شهید فخری‌زاده به درک واصل شد، یه ذره جیگرمون خنک شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.48,
   "end": 358.38,
   "text": "کار بچه‌های ما بود اینا. کشته شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.38,
   "end": 361.14,
   "text": "ژنرال شارون اسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.14,
   "end": 364.56,
   "text": "که این فرمانده لشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.56,
   "end": 367.05,
   "text": "ناهان ارتش اسرائیل بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.05,
   "end": 371.91,
   "text": "یکی از بهترین، قدرترین قدر، قدرت‌هاشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.91,
   "end": 373.69,
   "text": "کشتن. به درک واصلش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.69,
   "end": 378.05,
   "text": "الحمدالله. دو تا افسر زن اسرائیل بودن، اسرائیلی بودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.05,
   "end": 379.99,
   "text": "اینا تو حادثه اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.99,
   "end": 382.39,
   "text": "ااا تو تأسیسات اصفهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.39,
   "end": 387.51,
   "text": "که پیش اومد، اون حمله شد به تأسیسات اصفهان، اینا دخیل بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.51,
   "end": 392.75,
   "text": "یکیشون اسمش میشل هرش بود، فعال در حوزه پهپادی اسرائیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.75,
   "end": 395.83,
   "text": "خیلی از علوم پهپادی اسرائیل رو ایشون داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.83,
   "end": 398.13,
   "text": "یکی هم که دلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.13,
   "end": 400.77,
   "text": "هایتز بود که این دوتاشون به درک واصل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.77,
   "end": 405.79,
   "text": "اینا همه توسط بچه‌های مقاومت و بچه‌های ما و دخالت بچه‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.79,
   "end": 410.51,
   "text": "توی کارخانه تولید موشک تو منطقه گوشتان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.51,
   "end": 413.41,
   "text": "تو مرکز اسرائیل انفجار رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.41,
   "end": 419.33,
   "text": "کار ما بود. در تأسیسات پتروشیمی بندر حیفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.33,
   "end": 422.45,
   "text": "یه انفجاری رخ داد. اینا کار ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.45,
   "end": 425.15,
   "text": "تلافی از خون حاج قاسم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.15,
   "end": 429.33,
   "text": "گز-- به یه گزارشی الجزیره رفت اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.33,
   "end": 433.85,
   "text": "که اعلام کرد یه گوشمالی سختی ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.85,
   "end": 436.55,
   "text": "به اسرائیل داده. بیست تا افسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.55,
   "end": 440.41,
   "text": "تراز بالای اسرائیل رو طی یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.41,
   "end": 445.75,
   "text": "به درک واصل-- اسم نبرد، ولی همینایی که من دارم اسم میبرم همیناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.75,
   "end": 450.57,
   "text": "که اونها اعلام کردن به صورت رسمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.57,
   "end": 455.45,
   "text": "عرض شود که و گفتن حتی عین خبر این بود که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.45,
   "end": 459.51,
   "text": "عین خبرو من اینجا نوشتم. تو الجزیره نوشته بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.51,
   "end": 464.05,
   "text": "بیست فرمانده اسرائیلی، اونم فرمانده‌های ارشدشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.05,
   "end": 467.63,
   "text": "در واکنش‌های ایران کشته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.63,
   "end": 472.25,
   "text": "این دیگه رسمی بود. حمله به مقر موساد در اربیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.25,
   "end": 476.95,
   "text": "و کشته شدن تعداد زیادی از افسران و سربازان صهیونیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.95,
   "end": 483.01,
   "text": "اون قصه هک شدن و اخذ اطلاعات گنبد آهنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.01,
   "end": 488.31,
   "text": "یکی از کارهای بسیار عالی بود که هیمنه اسرائیل رو در هم کوفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.31,
   "end": 491.37,
   "text": "خیلی عالی بود که میدونید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.37,
   "end": 493.41,
   "text": "اِممم هک شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.41,
   "end": 496.83,
   "text": "شرکت تأسیسات نظامی فارائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.83,
   "end": 500.45,
   "text": "که اون گنبد آهنین تحت بیرق اون بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.45,
   "end": 502.67,
   "text": "یکی از کارهایی بود که بچه‌ها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.67,
   "end": 505.91,
   "text": "بچه‌های سایبری سپاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.91,
   "end": 509.53,
   "text": "سپاه قدس. کشته شدن رئیس جوخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.53,
   "end": 512.95,
   "text": "ترور موساد. چقدر بچه‌های ما رو این ملعون دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.95,
   "end": 515.51,
   "text": "کشتنشون رو داد، بچه‌های مقاومت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.51,
   "end": 518.41,
   "text": "در حملات پهپادی کشته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 518.41,
   "end": 523.03,
   "text": "دو تا افسر اطلاعاتی موساد تو ابوظبی کشته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.03,
   "end": 526.19,
   "text": "همینطوری بریم جلو. یا امروز نمیدونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.19,
   "end": 528.57,
   "text": "یه خبر شیرین اومد که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.57,
   "end": 531.69,
   "text": "امرون شصت و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.69,
   "end": 535.61,
   "text": "موشک توسط حزب‌الله لبنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.61,
   "end": 538.15,
   "text": "شلیک شد به، حالا اونجا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.15,
   "end": 542.15,
   "text": "امرون یه پایگاهی که نخبه‌گان نظامی اسرائیل جمعن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.15,
   "end": 545.89,
   "text": "شصت و دو تا موشک و یه دونه‌شم غنیمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.89,
   "end": 549.51,
   "text": "آیا اینا پاسخ نیست؟ ای کاش اون آقایی که دیروز اشکال کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.51,
   "end": 554.21,
   "text": "چه اتفاقی افتاده، چه نمیدونم، چه پاسخی، چه انتقامی، کاش امروز بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.21,
   "end": 562.47,
   "text": "می‌شنیدن این حرفا رو. حالا من تازه نسبت به ضیغ وقت تندتند بعضیشو دارم عرض می‌کنم و هر کدوم از اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.47,
   "end": 566.97,
   "text": "دارن تحلیل می‌کنن و بازش می‌کنن برای من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.97,
   "end": 572.81,
   "text": "ااا از جهت اقتصادی ضربات سنگینی که اسرائیل خورده و داره میخوره و مخصوصا بعد از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.81,
   "end": 579.03,
   "text": "من یه گزارشی رو دیدم که تو سه هفته اول بعد از همین طوفان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.03,
   "end": 583.11,
   "text": "تو سه هفته اول پونصد میلیون دلار فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.11,
   "end": 587.59,
   "text": "هزینه رهگیری موشک‌هایی بوده که گنبد آهنین انجام داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.59,
   "end": 591.73,
   "text": "تو سه هفته اول و همینطوری هی بیشتر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.73,
   "end": 596.81,
   "text": "کاهش درآمد، درآمد، درآمد‌های مالی، مالیاتی بنگاه‌های اقتصادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.81,
   "end": 601.45,
   "text": "حالا چه خردش، چه متوسطش، چه کلانش که خیلی‌هاشون از بین رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.45,
   "end": 605.87,
   "text": "تخلیه اجباری دویست و پنجاه هزار اسرائیلی که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.87,
   "end": 608.07,
   "text": "تو نوار‌های حالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.07,
   "end": 611.73,
   "text": "حالا شمالی یا در مرزهای غزه بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.73,
   "end": 613.87,
   "text": "بالاجبار اینا رو تخلیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.87,
   "end": 617.51,
   "text": "چه از نوار شمالی، چه از مرزهای دیگه اومدن تو مرکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.51,
   "end": 622.93,
   "text": "ساکن بشن. همین تخلیه اینها میدونید چقدر هزینه گذاشته س-- رو دست اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 622.93,
   "end": 630.27,
   "text": "بعد اون نا، نا، ناآرامی‌ها و تظاهرات که بین خودشون صورت گرفته، افتادن به جون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.27,
   "end": 633.25,
   "text": "تا دلت بخواد. عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.25,
   "end": 637.03,
   "text": "اقتصاد اسرائیل میدونید بر مبنای صنایع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.03,
   "end": 641.57,
   "text": "با فناوری ویژه سایبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.57,
   "end": 643.79,
   "text": "اقتصاد اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.79,
   "end": 647.59,
   "text": "از بناهای محکمش مسائل سایبریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 647.59,
   "end": 655.45,
   "text": "که اخیرا اعلام کردن هفتاد درصد این شرکت‌ها به فکر خروج از سرزمین‌های اشغالی افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.45,
   "end": 658.53,
   "text": "این یه خودش یه ضربه مهلک اقتصادی به آمریکاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 658.53,
   "end": 661.39,
   "text": "تو روزنامه یدیت آهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.39,
   "end": 664.39,
   "text": "آهارونوت نوشت اسرائیل روزانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 664.39,
   "end": 668.71,
   "text": "دویست و چهل و شش میلیون دلار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 668.71,
   "end": 671.67,
   "text": "اسرائیل همین الان ها، این خبر جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 671.67,
   "end": 675.69,
   "text": "دویست و چهل و شش میلیون دلار متحمل خزین--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 675.69,
   "end": 677.97,
   "text": "هزینه تو این جنگ داره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 677.97,
   "end": 680.47,
   "text": "این دیگه کمترین آماریه که من دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.47,
   "end": 686.61,
   "text": "بعضیا تا بالای تا ششصد میلیون دلار هم دیدم بعضیا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.61,
   "end": 690.57,
   "text": "روزی حداقل دویست میلیون دلار هزینه‌هاشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 690.57,
   "end": 696.03,
   "text": "که دیگه طاقت‌فرساس. بعد حالا شما برید سراغ همین تجهیز جبهه مقاومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 696.03,
   "end": 700.47,
   "text": "ببینید که از وقتی که رهبر فرمودن خب اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.47,
   "end": 703.69,
   "text": "هفتاد و پنج سال بود با سنگ می‌جنگیدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 703.69,
   "end": 706.09,
   "text": "انتفاضه یعنی چی؟ سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 706.09,
   "end": 709.51,
   "text": "انقلاب سنگ. کی تجهیز شدن اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.51,
   "end": 713.79,
   "text": "البته فرمانش از طرف رهبر قبل از شهادت حاج قاسم صادر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 713.79,
   "end": 716.69,
   "text": "اما بلافاصله بعد از شهادت حاج قاسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.69,
   "end": 720.45,
   "text": "این به اوج رسید و تند و تن-- من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.45,
   "end": 728.19,
   "text": "یادم نمیره همین-- یادم نیست، در خاطرم دقیقا نیست که قبل از شهادت حاج قاسم بود، همون اواخر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.19,
   "end": 735.16,
   "text": "بلافاصله بعد از شهادت. یکی از الان آقا محسن که عزیزان ما اینجا نشسته میدونه اسم ببرم از بچه‌های خوب هیئتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 735.16,
   "end": 737.88,
   "text": "از یمن به من زنگ می‌زد از اونجا اطلاعات می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 737.88,
   "end": 740.78,
   "text": "یعنی بچه‌های ما اینا دارم به شما دارم میگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.78,
   "end": 743.68,
   "text": "بچه‌های ما تو یمن بودن رفته بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 743.68,
   "end": 747.0,
   "text": "اون موقع هیچکس خ-خبری از یمن نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 747.0,
   "end": 749.12,
   "text": "یمن درگیر بود با عربستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 749.12,
   "end": 754.64,
   "text": "و چیکار داشتن می‌کردن؟ داشتن همین الان رو تحریک می‌کردن برای الان که یمن اینطوری داره می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 754.64,
   "end": 758.1,
   "text": "با چی می‌زنه؟ با پهباد می‌زنه، با موشک‌های دوربرد می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 758.1,
   "end": 760.5,
   "text": "از کجا آورده بچه‌های ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.5,
   "end": 763.66,
   "text": "به فرمان رهبر، به تقاص خون حاج قاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 763.66,
   "end": 766.56,
   "text": "و الانم که بعد از قصه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 766.56,
   "end": 771.2,
   "text": "حادثه تروریستی کرمان، رهبر فرمودن پاسخ سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 771.2,
   "end": 772.98,
   "text": "دیگه ببین از اینجا به بعد چی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 772.98,
   "end": 776.6,
   "text": "این تازه اول ماجراست. حالا به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 776.6,
   "end": 780.46,
   "text": "ما بریم مستقیم بجنگیم بهتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 780.46,
   "end": 787.18,
   "text": "ما اینجا ابهتمون حفظ می‌شه و مملکتمون دست خوش نامولایمت قرار نمی‌گیره یا نوچه هامون بجنگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 787.18,
   "end": 794.5,
   "text": "همونطور که تو داعش جنگ نیابتی از طرف ما داشتن نیروهای مقاومت در چند جبهه، الانم اینجوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 794.5,
   "end": 796.7,
   "text": "به نی-- به نیابت از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 796.7,
   "end": 799.52,
   "text": "با لجستیک و تسلیحات نظامی و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 799.52,
   "end": 802.1,
   "text": "و مستشاران نظامی ما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 802.1,
   "end": 807.18,
   "text": "فرماندهی فرمانده کل قوا دارن اونا اونجا دارن از طرف ما می‌جنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 807.18,
   "end": 810.42,
   "text": "حتی یمن، حتی انصار حزب‌الله یمن، حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 810.42,
   "end": 812.94,
   "text": "نمی‌دونم نیروهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 812.94,
   "end": 815.02,
   "text": "حشد شعبی، حتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 815.02,
   "end": 818.62,
   "text": "عرض شود بچه‌های خود لبنان، نیروهای مقاومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 818.62,
   "end": 821.1,
   "text": "همشون بدون استثناء اینم ادعا دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 821.1,
   "end": 824.82,
   "text": "یعنی الان جنگ از چندین جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.82,
   "end": 829.52,
   "text": "یمن میاد اون تنگه رو می‌بنده، بندر رو تعطیل می‌کنه، یکی از زر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 829.52,
   "end": 832.8,
   "text": "سنگین‌ترین ضربه‌های اقتصادی که به اسرائیل خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 832.8,
   "end": 835.38,
   "text": "همین کار یمنه. اصلاً همه م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 835.38,
   "end": 838.56,
   "text": "همینطوری موندن. همه مات و مبهوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 838.56,
   "end": 840.2,
   "text": "دیگه یمن چیکار داره می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 840.2,
   "end": 843.06,
   "text": "هیچکس باورش نمی‌شد یمن این کارو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 843.06,
   "end": 846.6,
   "text": "به چه پشتوانه‌هایی؟ به پشتوانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 846.6,
   "end": 849.66,
   "text": "حمایت‌های ایران. یعنی اونا جنگ نیابتی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 849.66,
   "end": 853.36,
   "text": "آیا اینها پاسخ نیست؟ الان کشورهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 853.36,
   "end": 858.64,
   "text": "با دمپایی پاره جلوی عربستان وایساده بودن، یمنی‌ها مجهز به پهبادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 858.64,
   "end": 860.84,
   "text": "کی پهبادو به اینا دی-داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 860.84,
   "end": 866.8,
   "text": "همین دیروز موشک‌های بالستیک رو دو سه روز پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 866.8,
   "end": 870.1,
   "text": "روسیه اعلام کرد می‌خوایم از ایران خریداری کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.1,
   "end": 873.02,
   "text": "روسیه خریدار موشک‌های ما شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 873.02,
   "end": 876.46,
   "text": "حالا اینا، اینها نباید دیده بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 876.46,
   "end": 880.2,
   "text": "اینها پاسخ نیست؟ اینا انتقام از دشمن نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 880.2,
   "end": 884.54,
   "text": "یه مقدار باید دیدمون واضح‌تر بشه، بازتر بشه و متوجه قضایا باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 884.54,
   "end": 887.88,
   "text": "حالا در خصوص نحوه عملیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 887.88,
   "end": 890.84,
   "text": "عرض شود طوفان الاقصی که عزیزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 890.84,
   "end": 895.88,
   "text": "رجوع کنید به آقای مرادی دیروز انقدر حرف‌های شیرین و جالبی زد من خودم نمی‌دونستم از این که نحوه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 895.88,
   "end": 899.84,
   "text": "چگونه معجزه آسا اینها این سدها رو رد می‌کنند میرن جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 899.84,
   "end": 902.68,
   "text": "اونم خودش یه داستان داره. دعاشون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 902.68,
   "end": 905.52,
   "text": "واقعاً همه‌شون رو دعا کنیم از ته جیگرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 905.52,
   "end": 910.44,
   "text": "ان شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 910.44,
   "end": 914.66,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 914.66,
   "end": 918.78,
   "text": "و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}