   "start": 14.68,
   "end": 41.06
  },
  {
   "index": 1,
   "title": "## اقدامات رهبری پس از سقوط بالگرد",
   "start": 41.06,
   "end": 391.78
  },
  {
   "index": 2,
   "title": "## نامه به دانشجویان حامی فلسطین",
   "start": 391.78,
   "end": 639.04
  },
  {
   "index": 3,
   "title": "## یمن و روحیهٔ انقلاب",
   "start": 639.04,
   "end": 731.9
  },
  {
   "index": 4,
   "title": "## رأی و محور مقاومت",
   "start": 731.9,
   "end": 751.96
  },
  {
   "index": 5,
   "title": "## دو راهی رأی",
   "start": 751.96,
   "end": 826.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.48,
   "end": 6.38,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.38,
   "end": 9.26,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 12.46,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.46,
   "end": 14.68,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.68,
   "end": 21.76,
   "text": "ایام به یک روایت شهادت آقامون امام الرؤوف هست و ایام زیارتی ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.76,
   "end": 24.9,
   "text": "خوشا به سعادت کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.9,
   "end": 29.36,
   "text": "الان در حرم‌شان و در این ایام می‌تونن حضرت رو از نزدیک زیارت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.36,
   "end": 31.74,
   "text": "البته ما هم از قافله جا نمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.74,
   "end": 36.72,
   "text": "اگر کسی رو در مشهد داریم سفارشی کنیم به نیابت ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.72,
   "end": 44.56,
   "text": "زیارت کنن حضرت رو ولو یه صله‌ای بهشون بدیم هر چقدر که در توانمون هست یا حداقلش اینه که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.56,
   "end": 47.34,
   "text": "کم کمش این که از همین راه دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.34,
   "end": 50.3,
   "text": "ولو شده به یک صلوات خاصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.3,
   "end": 53.5,
   "text": "یک زیارت‌نامه خودمون رو سهیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.5,
   "end": 58.0,
   "text": "به هر حال یه سری درش هست که این ایام زیارت حضرت وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.0,
   "end": 61.22,
   "text": "جا نمونیم از قافله. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.22,
   "end": 66.06,
   "text": "اجازه بفرمایید تو این فرصت کوتاه که شنبه‌ها بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.06,
   "end": 70.04,
   "text": "مسائل مهم عبادی، اجتماعی و سیاسی روز رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.04,
   "end": 77.44,
   "text": "مطرح می‌کنیم. مهم‌ترین اقدامات رهبر عزیزمون رو توی این چند روزه از حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.44,
   "end": 80.42,
   "text": "خبر سقوط بالگرد رو بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.42,
   "end": 83.24,
   "text": "یه چند تا سرفصل و نکته عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.24,
   "end": 87.58,
   "text": "البته هر کدومش جای بحث و بررسی داره جانانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.58,
   "end": 91.76,
   "text": "منتها من مد نظرم بیشتر اون نکته آخر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.76,
   "end": 94.88,
   "text": "و حرکت جانانه آخر آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.88,
   "end": 97.9,
   "text": "اولا در سی اردیبهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.9,
   "end": 103.0,
   "text": "آقا دیداری با جمعی از خانواده‌های سپاهی‌ها و پاسداران داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.0,
   "end": 107.18,
   "text": "تازه خبر سقوط بالگرد مطرح شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.18,
   "end": 110.72,
   "text": "و یک التهابی در جامعه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.72,
   "end": 114.46,
   "text": "رهبر عزیزمون با اون نفس قدسی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.46,
   "end": 117.78,
   "text": "ایجاد آرامش کردن در جامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.78,
   "end": 120.48,
   "text": "و اون جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.48,
   "end": 124.24,
   "text": "کلیدی‌شون که خیلی‌ها رو آروم کرد فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.24,
   "end": 127.16,
   "text": "هیچ خللی مطمئن باشید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.16,
   "end": 129.78,
   "text": "نظام پیش نمیاد و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.78,
   "end": 133.22,
   "text": "این اولین حرکت حضرت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.22,
   "end": 138.42,
   "text": "کار آقا بود. نکته دوم ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.42,
   "end": 148.26,
   "text": "سی و یک اردیبهشت بود که آقا پیام تسلیت دادن و اعلام پنج روز عزای عمومی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.26,
   "end": 155.18,
   "text": "و در پیام پرمعناشون درگذشت شهادت گونه رئیس جمهور رو مطرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.18,
   "end": 158.34,
   "text": "فعلا هم مطالبی درش هست که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.34,
   "end": 162.96,
   "text": "اول خرداد پیام به مناسبت آغاز به کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.96,
   "end": 166.76,
   "text": "ششمین دوره مجلس خبرگان رهبری رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.76,
   "end": 174.3,
   "text": "توی اون پیام مطالب خیلی مهمی رو مطرح کردن، خط و مرزها، سیاست‌های کلی و به یک معنا ریل‌گذاری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.3,
   "end": 178.88,
   "text": "دوم خرداد اقامه نماز بر پیکر شهدای خدمت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.88,
   "end": 182.14,
   "text": "و مخابره پیام عزت به تمام دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.14,
   "end": 185.2,
   "text": "با گریه نکردنشون، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.2,
   "end": 190.84,
   "text": "عرض شود حتی خم نشدن برای بوسیدن تابوت و این‌ها که از لحاظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.84,
   "end": 195.52,
   "text": "زبان دیپلماسی اینا خیلی معناداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.52,
   "end": 198.5,
   "text": "دو مرتبه همون روز با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.5,
   "end": 204.54,
   "text": "آقا به هر حال تحت فشارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.54,
   "end": 211.56,
   "text": "عرض شود غم و حزن و اندوهی که از از دست دادن بهترین یارانشون بودن باز با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.56,
   "end": 213.82,
   "text": "سران کشورهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.82,
   "end": 216.6,
   "text": "خارجی دیدار کردن. اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.6,
   "end": 220.4,
   "text": "نخست وزیر لبنان، نخست وزیر ارمنستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.4,
   "end": 225.16,
   "text": "رئیس جمهور تونس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.16,
   "end": 227.4,
   "text": "رئیس مجلس لبنان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.4,
   "end": 233.68,
   "text": "امیر قطر، نخست وزیر پاکستان، رئیس دفتر سیاسی حماس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.68,
   "end": 236.9,
   "text": "اینا کم آدمایی نبودن و آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.9,
   "end": 244.48,
   "text": "با این کارشون به یک معنا رشته مدیریت بحران جهان رو دست گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.48,
   "end": 248.26,
   "text": "سررشته مدیریت بحران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.26,
   "end": 250.98,
   "text": "داخلی و خارجی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.98,
   "end": 256.78,
   "text": "دست گرفت و القای پیام‌های بسیار مهمی از حیث سیاسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.78,
   "end": 259.7,
   "text": "به رهبران و سران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.7,
   "end": 263.86,
   "text": "دنیا کرد. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.86,
   "end": 266.16,
   "text": "به جاش باید بحث بشه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.16,
   "end": 269.18,
   "text": "چهارم خرداد در منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.18,
   "end": 273.66,
   "text": "شهید رئیسی حضور به هم رسوند آقا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.66,
   "end": 279.12,
   "text": "جملات خیلی طلایی و کلیدی رو اونجا فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.12,
   "end": 285.7,
   "text": "برای خط تراز رئیس جمهوری که خدمتگذار این مردم باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.7,
   "end": 289.44,
   "text": "خط دهی کردن و فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.44,
   "end": 294.02,
   "text": "زیر این آسمون ما یکی از بهترین‌هامونو از دست دادیم و جبران نشدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.02,
   "end": 302.48,
   "text": "این جبران نشدنی شاید به یک معنا بشه گفت یعنی اینکه دیگه مثل ایشون نداریم و نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.48,
   "end": 304.78,
   "text": "از این حیث مصیبت خیلی جانکاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.78,
   "end": 310.3,
   "text": "پنجم خرداد مراسم بزرگداشت شهدا در بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.3,
   "end": 312.92,
   "text": "شریف آقا بود با مهمان‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.92,
   "end": 316.86,
   "text": "خارجی و مردمی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.86,
   "end": 321.2,
   "text": "ششم خرداد پیام به مناسبت آغاز به کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.2,
   "end": 325.36,
   "text": "دوازدهمين دوره مجلس شورای اسلامی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.36,
   "end": 327.82,
   "text": "خط مشی مهمی رو حضرت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.82,
   "end": 330.72,
   "text": "تبیین کردن، مشخص کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.72,
   "end": 337.58,
   "text": "هفتم خرداد پیام تسلیت به مجاهد بزرگ سید حسن نصرالله بود در پی درگذشت مادر گرامیشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.58,
   "end": 341.04,
   "text": "اصلا همون یه جمله پیام خیلی کوتاه اما پرمغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.04,
   "end": 349.34,
   "text": "در حالی که اخبار غزه تو حاشیه رفته بود، آقا دو مرتبه سرفصل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.34,
   "end": 352.5,
   "text": "اصل میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.5,
   "end": 355.32,
   "text": "خبرگزاری‌ها رو پیام پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.32,
   "end": 357.34,
   "text": "مقاومت و فلسطین قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 357.34,
   "end": 359.94,
   "text": "با این پیام کوتاهشون که فرمودن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.94,
   "end": 365.94,
   "text": "حالا کرامت مادرتون همین بس که مجاهد نسطویی مثل شما رو پرورش داده در دمنش و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.94,
   "end": 370.04,
   "text": "خودش خیلی عجیب بود تاثیر این پیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.04,
   "end": 373.56,
   "text": "دهم خرداد که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.56,
   "end": 382.12,
   "text": "با رئیس جمهور سوریه دیدار داشتن و تذکرات مهمی رو به ایشون دادن از جمله مراقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.12,
   "end": 385.8,
   "text": "در خصوص سیاست‌های غرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.8,
   "end": 388.06,
   "text": "که هوشیار کردن ایشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 388.06,
   "end": 391.78,
   "text": "خلاصه و نکته آخر هم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.78,
   "end": 396.42,
   "text": "نامه حضرت آقا، نامه عجیب و غریب حضرت آقا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.42,
   "end": 399.74,
   "text": "دانشجویان حامی مردم فلسطین بود؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.74,
   "end": 402.48,
   "text": "تو دانشگاه‌های ایالات متحده آمریکا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.48,
   "end": 405.08,
   "text": "و البته دانشگاه‌های دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.08,
   "end": 407.84,
   "text": "اون هم دقت بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.84,
   "end": 411.74,
   "text": "واقعا تو اوج مشکلات داخلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.74,
   "end": 417.84,
   "text": "و حتی خارجی آقا غافل نیستن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.84,
   "end": 422.16,
   "text": "جزئی‌ترین مسائل و به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.16,
   "end": 426.74,
   "text": "این خودش هوشمندی و زیرکی آقا رو می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.74,
   "end": 432.14,
   "text": "که حالا این نامه رو من از خودم و شماها دعوت می‌کنم که یه بازخوانی بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.14,
   "end": 436.62,
   "text": "خیلی نامه عجیبی‌ست. یه بخشیش رو من عرض می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.62,
   "end": 439.94,
   "text": "واقعا آقا ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.94,
   "end": 442.88,
   "text": "چه کرد. یعنی در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.88,
   "end": 446.02,
   "text": "اون مثل زمانی که حاج قاسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.02,
   "end": 449.12,
   "text": "شهید شد، یادتونه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.12,
   "end": 454.92,
   "text": "دامنه و دایره انتقام حاج قاسم رو بزرگ گرفت تا جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.92,
   "end": 458.52,
   "text": "هر جوون مرد و آزاده‌خواهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.52,
   "end": 464.88,
   "text": "ااا تو عالم خودش رو در مواجهه با تروریست‌های آمریکایی ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.88,
   "end": 467.82,
   "text": "و هیچ کجا تروریست‌های آمریکایی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 467.82,
   "end": 471.32,
   "text": "از نابشون امنیت نداشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.32,
   "end": 479.02,
   "text": "این کاری که آقا اون موقع کرد الان دقیقا اگر شما پیام رو دقت کرده باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.02,
   "end": 485.9,
   "text": "تو یه بخشی از پیام آقا می‌فرمود این دانشجوها قسمتی از جبهه مقاومت تعریف میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.9,
   "end": 496.0,
   "text": "این می‌دونید یعنی چی؟ یعنی اینکه داره این پیام به دنیا مخابره می‌شه که جبهه مقاومت تا قلب آمریکا پیش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.0,
   "end": 498.96,
   "text": "از شاخ آمریکا، آفریقا بگیر تا قلب آمریکا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 498.96,
   "end": 501.74,
   "text": "اینا، اینا چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.74,
   "end": 508.3,
   "text": "تو پیام‌های آقا یعنی این استراتژی مهمی که تو پیام بود، یکی از مهماتش این بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.3,
   "end": 511.12,
   "text": "که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.12,
   "end": 515.34,
   "text": "دامنه مقاومت رو آقا جهانی بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 515.34,
   "end": 518.92,
   "text": "مرزها اصلا برداشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.92,
   "end": 521.0,
   "text": "شما دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.0,
   "end": 523.5,
   "text": "اصلا این مرزهای جغرافیایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.5,
   "end": 526.58,
   "text": "اینا پارامترهایی‌اند برای ایجاد نظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.58,
   "end": 529.82,
   "text": "مثلا جهانی و حریم ماده و هر چه باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 529.82,
   "end": 532.08,
   "text": "اعتباری‌اند. بسیاری از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.08,
   "end": 535.2,
   "text": "شهر، کشورهایی که الان اطراف ما هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.2,
   "end": 539.96,
   "text": "استان‌ها یا شهرهای ایران بودند، اعتباری بودند، الان نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.96,
   "end": 546.58,
   "text": "اما وقتی شما مثل الان که نماز خوندی \"السَّلامُ عَلَیْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 546.58,
   "end": 552.78,
   "text": "دور تا دور دنیا هر کس عمل صالحی انجام داده صلاة شما بهش اصابت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 552.78,
   "end": 558.0,
   "text": "یعنی پیام آقا بوی صلاة می‌ده، کار نماز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 558.0,
   "end": 561.28,
   "text": "مرز رو برداشتن ایشون. مرزهای جغرافیایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 561.28,
   "end": 564.7,
   "text": "دیگه مطرح نیست اینجا. مرزها مرزهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 564.7,
   "end": 568.92,
   "text": "اندیشه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 568.92,
   "end": 573.04,
   "text": "در حقیقت جهان‌بینی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 573.04,
   "end": 577.74,
   "text": "چنان وسعت پیدا کرده که روی فطرت‌ها بنا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 577.74,
   "end": 581.22,
   "text": "یعنی هر آدم دارای فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 581.22,
   "end": 586.04,
   "text": "سلیمی خودش رو در جبهه مقاومت می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 586.04,
   "end": 590.28,
   "text": "اصلا دنیا به دو جبهه تقسیم شده کلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.28,
   "end": 593.22,
   "text": "و شد؛ این اتفاق افتاده الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.22,
   "end": 596.16,
   "text": "یک جبهه حق که مقاومته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.16,
   "end": 600.44,
   "text": "جبهه باطل که رو در روی مقاومته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 600.44,
   "end": 602.96,
   "text": "که اسرائیل و آمریکا و از نابشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.96,
   "end": 606.0,
   "text": "ببین حالا این الک آخرالزمان که ببین چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 606.0,
   "end": 611.58,
   "text": "البته خطر اینجاست دیگه دانه‌های این الک چقدر درشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.58,
   "end": 614.56,
   "text": "که گنده گنده ها از این الک دارن میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.56,
   "end": 618.74,
   "text": "چرا؟ چون خبر بزرگی در پیشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 618.74,
   "end": 621.2,
   "text": "دیگه ما گام‌های انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.2,
   "end": 624.06,
   "text": "نزدیک به قله‌ایم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.06,
   "end": 631.44,
   "text": "آخرالزمانه دیگه. به قول یه عزیزی یک لحظه خواب تو آخرالزمان باعث می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 631.44,
   "end": 636.24,
   "text": "کلی از حوادث مهم جهان عقب بیفتیم چون آخرالزمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 636.24,
   "end": 637.94,
   "text": "باید خیلی حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.94,
   "end": 642.26,
   "text": "الان هی، کی فکر می‌کرد یه روزی یمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 642.26,
   "end": 644.72,
   "text": "که پا برهنه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 644.72,
   "end": 651.86,
   "text": "بیاد ای-ناوه هواپیمابر افسانه‌ای آمریکا رو که معروف بوده آیزن هاور رو بزنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 651.86,
   "end": 655.26,
   "text": "کی باورش می‌شد؟ وا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 655.26,
   "end": 658.4,
   "text": "همین ناوی که وقتی وارد خلیج فارس شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 658.4,
   "end": 661.72,
   "text": "بعضی از مسئولین ما تنشون لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.72,
   "end": 663.28,
   "text": "اما چی می‌شه که یمن می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 663.28,
   "end": 665.6,
   "text": "بعد اونا وقتی یمن رو می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.6,
   "end": 668.84,
   "text": "اصلاً دقیقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 668.84,
   "end": 672.74,
   "text": "روحیه انقلاب امام و مثل امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 672.74,
   "end": 679.36,
   "text": "فریاد یمن بلند شد که اگه کل دنیا جلوی ما وایسته تا وقتی که محاصره غزه شکسته نشه، ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 679.36,
   "end": 681.58,
   "text": "کارمون رو انجام میدیم. از اهدی نمی‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 681.58,
   "end": 683.94,
   "text": "این، این روحیه از کجا دراومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 683.94,
   "end": 688.76,
   "text": "عبیس قرنی که پیغمبر فرمود من ازش بوی بهشت رو استشمام می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.76,
   "end": 691.44,
   "text": "یعنی این دیگه سپاه یمانی به نظرتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 691.44,
   "end": 694.22,
   "text": "در حال شکل‌گیری نیست؟ مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.22,
   "end": 699.08,
   "text": "حائری شیرازی آ-- به قول پسرشون آخرین صحبت‌هایی که کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 699.08,
   "end": 703.28,
   "text": "هنگام ارتحالشون نفرمودن منتظر اخبار یمن باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.28,
   "end": 707.2,
   "text": "آیا ارتش و سپاه یمانی در حال تشکیل نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.2,
   "end": 712.14,
   "text": "آیا این خیزش عظیمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 712.14,
   "end": 717.12,
   "text": "داره به وقوع می‌پیونده تو غرب آسیا این خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 717.12,
   "end": 720.38,
   "text": "در حقیقت یکی از بزرگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 720.38,
   "end": 724.58,
   "text": "دلایل نزدیک بودن اون قیام نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 724.58,
   "end": 728.42,
   "text": "الان خلاصه اینکه سکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 728.42,
   "end": 731.9,
   "text": "دست شماهاست، دست ماست، دست مقاومته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 731.9,
   "end": 735.1,
   "text": "انتخاب هم که در پیش داریم، انتخابات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 735.1,
   "end": 737.66,
   "text": "ختم کلام این جمله آخرم رو دقت داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 737.66,
   "end": 741.22,
   "text": "اون هم اینکه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 741.22,
   "end": 743.9,
   "text": "شما هستید، ما هستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 743.9,
   "end": 747.7,
   "text": "با انتخابمون خودمون رو در جبهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 747.7,
   "end": 750.46,
   "text": "یا مقاومت یعنی حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 750.46,
   "end": 753.5,
   "text": "یا مقابل مقاومت یعنی باطل قرار میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 753.5,
   "end": 757.94,
   "text": "کسی رو انتخاب می‌کنی که اهل مقاومت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 757.94,
   "end": 760.56,
   "text": "تو محور مقاومت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 760.56,
   "end": 766.36,
   "text": "مثل اینکه آقا تو پیامشون دانشجوهای آمریکا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 766.36,
   "end": 775.72,
   "text": "و دانشگاه‌های غرب رو که به حمایت از اس-اا-فلسطین بلند شدن رو جزء به، قسمتی از جبهه مقاومت تعریف کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 775.72,
   "end": 778.24,
   "text": "این شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 778.24,
   "end": 782.0,
   "text": "آیا رأی به یه همچین نگاهی میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 782.0,
   "end": 785.56,
   "text": "که تقویت محور مقاومت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 785.56,
   "end": 788.14,
   "text": "و اراده‌اش بر این باشه یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 788.14,
   "end": 790.58,
   "text": "رأی به آدمایی میدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 790.58,
   "end": 795.18,
   "text": "حرفشون مذاکره‌ست، مذاکره با دشمن مقاومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 795.18,
   "end": 799.1,
   "text": "همین دو جبهه‌ست. بیش از این هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 799.1,
   "end": 803.6,
   "text": "انشاالله که خدای منان هممون رو آگاه کنه، بصیرت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 803.6,
   "end": 809.12,
   "text": "و نمی‌تونیم بگیم بهتر از آقای رئیسی که بی‌ادبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 809.12,
   "end": 811.88,
   "text": "نیست. ولی انشاالله حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 811.88,
   "end": 816.76,
   "text": "کسی که در خور این مردم و این نظام باشه خدای منان تقدیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 816.76,
   "end": 821.62,
   "text": "دیگه واقعا بس ماست و به دست پر برکت این مردم انتخاب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 821.62,
   "end": 823.72,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 823.72,
   "end": 826.18,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}