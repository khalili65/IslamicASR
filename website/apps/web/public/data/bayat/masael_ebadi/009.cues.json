 "chapters": [
  {
   "index": 0,
   "title": "## تبیین حقایق برای نسل آینده",
   "start": 4.74,
   "end": 45.38
  },
  {
   "index": 1,
   "title": "## لجاجت شناختی؛ تفسیر به رأی از رهبری",
   "start": 45.38,
   "end": 187.74
  },
  {
   "index": 2,
   "title": "## خلوت علامه با ابن‌سینا و صدرا",
   "start": 187.74,
   "end": 348.0
  },
  {
   "index": 3,
   "title": "## مصادیق تاریخی لجاجت",
   "start": 348.0,
   "end": 368.7
  },
  {
   "index": 4,
   "title": "## انسجام ملی؛ ترور حاج قاسم؛ انتخابات",
   "start": 368.7,
   "end": 573.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 2.86,
   "text": "خدمت همه دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.86,
   "end": 8.48,
   "text": "امیدوارم که مخصوصا در این ایام وظایف خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.48,
   "end": 11.36,
   "text": "درست انجام بدیم. یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.36,
   "end": 16.02,
   "text": "وظایف ما در این ایام حداقل اینه که برای بچه‌هامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.02,
   "end": 18.1,
   "text": "که نسل آینده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.1,
   "end": 21.08,
   "text": "نظام هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.08,
   "end": 23.24,
   "text": "حقایق رو تبیین کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.24,
   "end": 28.86,
   "text": "ممنون زحمت نکشید. حداقل برای اون‌ها اگر برای اجتماع زورمون نمی‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.86,
   "end": 32.16,
   "text": "که یکی از بزرگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.16,
   "end": 39.64,
   "text": "رفت و آمدهای متاسفانه اجتماعی امروز بحث‌های لجاجت سیاسیه که بنده اسمشو میذارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.64,
   "end": 44.1,
   "text": "لجاجت شناختی. از چه حیث؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.1,
   "end": 47.32,
   "text": "شما دقت کنید هم در صدر اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.32,
   "end": 50.08,
   "text": "مصادیقش رو زیاد می‌بینید هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.08,
   "end": 52.16,
   "text": "در تاریخ انقلاب خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.16,
   "end": 55.26,
   "text": "آدم‌هایی که تحلیل درستی ندارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.26,
   "end": 62.62,
   "text": "از یک واقعه‌ای، از یک جهت‌گیری مثلا از رهبر عزیزمون به خصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.62,
   "end": 66.16,
   "text": "یک تصمیمی رو رهبر می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.16,
   "end": 71.58,
   "text": "یه فرمایشاتی دارن و بر اساس مبانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.58,
   "end": 79.04,
   "text": "دینی حتی و ما چون تحلیل نداریم، بلد نیستیم و تفسیر به رأی می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.04,
   "end": 84.06,
   "text": "و شناختمون در اون خصوص دقیق نیست دچار لجاجت می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.06,
   "end": 88.28,
   "text": "حالا اینجا سراشیبی سقوطه، یک دوراهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.28,
   "end": 91.86,
   "text": "اونایی که ایمانشون محکمه، مستحکمه، درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.86,
   "end": 102.86,
   "text": "کنار میان با قصه، یه نگاه درستی دارن به قضیه اگرچه نمی‌فهمن جهت‌گیری‌های رهبر رو مثلا در خصوص امیدآفرینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.86,
   "end": 107.74,
   "text": "تو همین جمع خودتون بارها من شنیدم عزیزان بعضیا هستن میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.74,
   "end": 113.0,
   "text": "میگن آخه رو چه حسابی رهبر انقدر امیدواره به آینده، به الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.0,
   "end": 117.68,
   "text": "من زیاد شنیدم از همین خود شما یا حتی بچه‌های سپاه اومدن به من میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.68,
   "end": 120.6,
   "text": "ما واقعا حاج آقا موندیم رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.6,
   "end": 124.88,
   "text": "مثلا به پشتوانه کدوم صنعت نظامی ما جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.88,
   "end": 126.9,
   "text": "اون صنعت پیشرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.9,
   "end": 129.36,
   "text": "نظامی مثلا آمریکا میخواد قد علم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.36,
   "end": 134.58,
   "text": "حرف‌های این چنینی. متاسفانه در جمع خودمونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.58,
   "end": 138.56,
   "text": "دیدم کسانی که اومدن تو رسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.56,
   "end": 141.56,
   "text": "نمی‌دونم اینا کجا تربیت یافتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.56,
   "end": 146.56,
   "text": "و قراره مثلا تحلیلگر جمعیت‌های ما تو رسانه باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.56,
   "end": 149.88,
   "text": "تو همین حوزه‌ها. بعد می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.88,
   "end": 156.56,
   "text": "وقتی با صحبتشون می‌شینی به شدت ناامیدانه در خصوص مسائل اجتماعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.56,
   "end": 159.38,
   "text": "و خصوصا نسل جوون صحبت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.38,
   "end": 162.44,
   "text": "وقتی بهشون میگی پس رهبر چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.44,
   "end": 166.22,
   "text": "سریع میگن که اطلاعات غلط به آقا میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.22,
   "end": 170.9,
   "text": "خودشونو راحت می‌کنن. یعنی واقعا انگار این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.9,
   "end": 173.26,
   "text": "از رهبر بهتر می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.26,
   "end": 176.24,
   "text": "ارتباطش با مثلا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.24,
   "end": 179.92,
   "text": "جایگاه، پایگاه اطلاعاتی قوی‌تره، بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.92,
   "end": 185.82,
   "text": "یه ادعای دیگه اینکه ب-به آقا اطلاعات غلط میدن یعنی به شما درست میدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.82,
   "end": 189.42,
   "text": "یعنی یه ادعائه. اتفاقا خدا رحمت کنه حضرت علامه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.42,
   "end": 192.06,
   "text": "این جمله ایشون خیلی منو کمک کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.06,
   "end": 197.04,
   "text": "به شما عرض می‌کنم حالا بحث، بحث سیاسیه، اجتماعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.04,
   "end": 200.72,
   "text": "اما از حیث عبادی هم به دردمون می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.72,
   "end": 205.78,
   "text": "که ایشون می‌فرمودن من که جوون بودم تازه افتاده بودم به خوانش کتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.78,
   "end": 209.24,
   "text": "و صحف نوریه عرفانیه و حکمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.24,
   "end": 216.84,
   "text": "مثلا اشارات شیخ الرئیس مثلا منظومه حال-- حاج ملا هادی سبزواری، اسفار ملا صدرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.84,
   "end": 220.86,
   "text": "فتوحات و فسوس ابن عربی و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.86,
   "end": 223.06,
   "text": "بعد مخالفت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.06,
   "end": 228.38,
   "text": "اهل علم رو، اون‌هایی که تو لباس دین و علما این‌ها بودن وقتی دیدم با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.38,
   "end": 233.44,
   "text": "مباحث عقلی تا اسم اب-ابن عربی می‌آمد فحش می‌دادن، لعن می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.44,
   "end": 236.9,
   "text": "اینا همینایی که تو لباس دین بودن من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.9,
   "end": 241.5,
   "text": "یک ضعف نفسی بهم دست داد تو جوونیم، علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.5,
   "end": 244.66,
   "text": "می‌فرمود یه ضعف نفسی بهم دست داد تا مدتی باهام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.66,
   "end": 248.16,
   "text": "دچار شک و تردید شده بودم نسبت به این حقایق عقلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.16,
   "end": 250.58,
   "text": "در صورتی که هرچی نگاه می‌کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.58,
   "end": 254.46,
   "text": "هرچی می‌گفتن از آیات و روایات می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.46,
   "end": 259.5,
   "text": "چگونه میگه علامه می‌فرمایند چگونه من بیرون اومدم از این ضعف نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.5,
   "end": 263.7,
   "text": "به اطمینان رسیدم به اینکه در خلوت خانه خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.7,
   "end": 268.06,
   "text": "نشستم فکر کردم تو بیشتر می‌فهمی یا شیخ الرئیس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.06,
   "end": 271.74,
   "text": "تو بیشتر می‌فهمی یا ملا صدرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.74,
   "end": 274.18,
   "text": "تو جوونی خودش علامه حسن زاده میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.18,
   "end": 277.64,
   "text": "با خودم خلوت کردم. تو بیشتر حالیت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.64,
   "end": 282.26,
   "text": "یا ابن عربی که شصت و-- نود و پنج جلد کتاب تفسیر قرآن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.26,
   "end": 286.22,
   "text": "قریب به هزار جلد تألیف داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.22,
   "end": 290.58,
   "text": "در موضوعات مختلف که عثمان یحیی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.58,
   "end": 293.14,
   "text": "عناوین ایشون رو تو کتابش میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.14,
   "end": 295.8,
   "text": "خب تو بیشتر می‌فهمی یه همچین کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.8,
   "end": 301.6,
   "text": "خب میگه با خودم که کنار اومدم دیدم قطعا اون‌ها بهتر و بیشتر می‌فهمن، دل دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.6,
   "end": 308.94,
   "text": "دل دادم دیگه تموم شد. حالا این لجاجت سیاسی که میگم نمی‌تونه، تحلیل نداره، تشخیص نمیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.94,
   "end": 316.7,
   "text": "رهبر رو چه حسابی داره این جهت مثلا از فلانی تعریف می‌کنه، از ره-- مثلا دولت رئیسی و دستاوردهاش تعریف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.7,
   "end": 319.44,
   "text": "من به حسب شخصی خودم نگاه می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.44,
   "end": 322.94,
   "text": "نقطه او مثلا روشنی نمی‌بینم مثلا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.94,
   "end": 326.6,
   "text": "نمی‌تونم کنار بیام. دچار چی می‌شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.6,
   "end": 328.88,
   "text": "لجاجت سیاسی. من میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.88,
   "end": 331.98,
   "text": "لجاجت شناختی. درست نشناختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.98,
   "end": 337.74,
   "text": "اگر همینطوری فکر کنم آقا بهتر متوجه می‌شه مسائل و اشراف داره یا تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.74,
   "end": 344.04,
   "text": "تمومه قصه. آقا دین رو بهتر می‌شناسه یا تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.04,
   "end": 346.56,
   "text": "قصه تموم می‌شه و الا. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.56,
   "end": 353.04,
   "text": "شما اگر دقت کنید چه در صدر اسلام، چه الان بسیار مصادیقش رو پیدا می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.04,
   "end": 360.78,
   "text": "چه کسایی جلوی پیغمبر و چه، چه کسایی جلوی امیرالمؤمنین وایسادن، چه کسایی جلوی امام حسن وایسادن، تشخیص ندادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 360.78,
   "end": 364.18,
   "text": "چرا میاد میگه یا مدلل المؤمنین به امام حسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.18,
   "end": 365.9,
   "text": "دچار لجاجت سیاسی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.9,
   "end": 368.7,
   "text": "تشخیص نمی‌ده چرا آقا صلح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.7,
   "end": 371.88,
   "text": "خب دل بده. تو نمی‌فهمی قرار نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 371.88,
   "end": 375.04,
   "text": "او تو رو درک کنه. تو باید او رو درک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.04,
   "end": 379.56,
   "text": "یا اون که در تاریخ دیگه از همه تو سریال مختار معروف‌تر دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.56,
   "end": 383.22,
   "text": "رفاعت بن شداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.22,
   "end": 385.28,
   "text": "بجلی. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.28,
   "end": 386.86,
   "text": "خب تو جنگ جمل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.86,
   "end": 389.24,
   "text": "صفین بود. در رکاب امیرالمؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.24,
   "end": 392.22,
   "text": "نامه نوشت به امام حسین که بیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.22,
   "end": 394.66,
   "text": "ولی خودش تو کربلا حضور نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.66,
   "end": 396.72,
   "text": "بعد رفت جزو طوابین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.72,
   "end": 401.86,
   "text": "دید شهید نشد. می‌خواست روغن سوخته رو نذر امام حسین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.86,
   "end": 404.82,
   "text": "بعد وارد شد به سپاه مختار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.82,
   "end": 406.86,
   "text": "درک نکرد. مختار رو درک نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.86,
   "end": 409.68,
   "text": "گیر کرد. دچار لجاجت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.68,
   "end": 412.78,
   "text": "رفت دیگه تو سریال دیدید دیگه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.78,
   "end": 417.4,
   "text": "به کسی اقتدا کرد که قاتل امام حسین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.4,
   "end": 419.58,
   "text": "یعنی طوری شد که رفت تو صف اونوری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.58,
   "end": 421.94,
   "text": "به لجاجت چی؟ مختار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.94,
   "end": 425.04,
   "text": "یعنی خیلی تو همین کشور خودمون تو سر-- همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.04,
   "end": 428.96,
   "text": "بحث انقلاب شما دقت کنید کسایی که بعداً به مروررر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.96,
   "end": 433.74,
   "text": "می‌بینی زاویه گرفتن از نظام و رهبری دچار این لجاجت‌ها شدن تشخیص ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.74,
   "end": 436.48,
   "text": "هاشمی‌ها، شریعتمداری‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.48,
   "end": 438.54,
   "text": "خود احمدی‌نژادها، خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.54,
   "end": 440.8,
   "text": "و همین روحانی که این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 440.8,
   "end": 442.98,
   "text": "انحرافش عجیب زیاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.98,
   "end": 450.04,
   "text": "اوایل جنگ شما دقت می‌کنید یک حرف‌های بسیار شدید کوبنده بر علیه مخالفین نظام داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.04,
   "end": 455.28,
   "text": "که شما باورت نمی‌شه این انقدر تغییر روش و رویه و تفکر داده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.28,
   "end": 458.96,
   "text": "لجاجت‌ها. این لجاجت خیلی مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.96,
   "end": 463.0,
   "text": "آدم خود-- یعنی مراقب باشه که از این حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.0,
   "end": 466.36,
   "text": "منحرف نشه. بعد در نهایت می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.36,
   "end": 473.92,
   "text": "وقتی که این لجاجت‌ها کار رو به جایی برسونه که بدنه انقلاب، بدنه مردم مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.92,
   "end": 477.9,
   "text": "و خواص فاصله بگیرن از امام جامعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.9,
   "end": 481.58,
   "text": "امنیت میاد پایین. یعنی ضربه امنیتی می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.58,
   "end": 485.84,
   "text": "شما هم فکر می‌کنید چرا حاج قاسم رو سال نود و هشت ترور کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.84,
   "end": 490.2,
   "text": "اصلاً از شما الان این سؤال رو بکنم تحلیلت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.2,
   "end": 494.2,
   "text": "حالا عزیزان ساعتشون هم نگاه می‌کنند یعنی وقت تمومه چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.2,
   "end": 499.32,
   "text": "تحلیلتون چیه؟ چرا حاج قاسم رو اون موقع شهید کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.32,
   "end": 504.46,
   "text": "خب خیلی بود دنبالش بودن. باور کنید چون بلافاصله بعد از اغتشاشات بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.46,
   "end": 508.78,
   "text": "دشمن ف-- گمان کرد که انسجام ملی اومده پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.78,
   "end": 510.56,
   "text": "مردم از رهبر فاصله گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.56,
   "end": 514.12,
   "text": "اغتشاشات به اوج رسیده بود. گمانش این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.12,
   "end": 520.16,
   "text": "اتفاقاً چرا رهبر از تنها شهیدی که از روحش تشکر کرد حاج قاسم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.16,
   "end": 524.26,
   "text": "توجه کردید؟ فرمود من از ایشون تشکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.26,
   "end": 527.56,
   "text": "من ممنون ایشونم. از روحش حاج قاسم بعد از شهادتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.56,
   "end": 532.9,
   "text": "چرا؟ خود رهبر سرش رو فرمود وفاق ملی ایجاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.9,
   "end": 536.34,
   "text": "وفاق ملی، انسجام ملی ایجاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.34,
   "end": 539.0,
   "text": "همه رو شست برد. انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.0,
   "end": 542.24,
   "text": "حالا همینطور اگر توی انتخاباتی که داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.24,
   "end": 548.0,
   "text": "با همه مشکلاتی که داریم اگر شرکت نکنیم تو انتخابات و آیه عس بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.0,
   "end": 554.36,
   "text": "تو گوش این و اون به همون شدت امنیت وقتی که انسجام ملی بیاد پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.36,
   "end": 559.66,
   "text": "مرد-- دشمن متوجه بشه که مردم نسبت به انتخابات بی‌تفاوتن چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.66,
   "end": 562.84,
   "text": "امنیت کم می‌شه. دوباره اتفاقات آنچنانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.84,
   "end": 564.66,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.66,
   "end": 567.52,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.52,
   "end": 573.36,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}