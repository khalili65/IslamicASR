 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 6.0,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.0,
   "end": 10.54,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.54,
   "end": 14.04,
   "text": "شرکت کردن در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.04,
   "end": 17.44,
   "text": "به نیت عقلایی اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.44,
   "end": 21.28,
   "text": "مثل فرار از اتهام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.28,
   "end": 25.36,
   "text": "این که متهم نشه، طرفدار در نماز جماعت شرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.36,
   "end": 29.72,
   "text": "یه منفعت عقلاییه. فتوای رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.72,
   "end": 31.9,
   "text": "بی‌اشکاله. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.9,
   "end": 34.94,
   "text": "حالا که اومد در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.94,
   "end": 40.0,
   "text": "می‌خواد فرادا بخونه، قاطی جماعت وایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.0,
   "end": 45.78,
   "text": "خب قبلاً هم عرض کردیم که نباید شأن جماعت بره زیر سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.78,
   "end": 52.46,
   "text": "خب ایشون وقتی اومده اقتدا کرده نماز مثلاً ز-- یا صبحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.46,
   "end": 56.76,
   "text": "یا مغرب و عشا است که باید حمد سوره رو بلند بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.76,
   "end": 60.04,
   "text": "ای-- برای اینکه مشخص نشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.04,
   "end": 62.54,
   "text": "داره نماز فرادا می‌خونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.54,
   "end": 65.24,
   "text": "حمد سوره رو آهسته می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.24,
   "end": 69.32,
   "text": "تو صف جماعت ایستاده، اقتدا نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.32,
   "end": 71.32,
   "text": "حمد سوره رو اینجا چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.32,
   "end": 73.9,
   "text": "آهسته می‌خونه. رهبر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.9,
   "end": 76.66,
   "text": "صحیح نیست. نمی‌شه همچین کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.66,
   "end": 80.46,
   "text": "باید حمد سوره بلند خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.46,
   "end": 85.04,
   "text": "حالا بعد تعارض می‌کنه با اون که اگه شأن جماعت بره زیر سؤال چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.04,
   "end": 89.68,
   "text": "س-- شأن امام جماعت اینا خب اشکال داره دیگه، نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.68,
   "end": 93.08,
   "text": "مثلاً نماز ظهر و عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.08,
   "end": 100.7,
   "text": "و این‌ها که حمد و سورش آهسته است می‌شه، کسی هم متوجه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.7,
   "end": 104.84,
   "text": "خب یکی از موضوعات بسیار مهم روز جامعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.84,
   "end": 112.86,
   "text": "جامعه‌یه چه بیرون از منزل ما، چه داخل منزل ما، چه داخل اداره و سازمانمون، چه بیرون از سازمان، همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.86,
   "end": 115.68,
   "text": "اصلاً از موضوعات بسیار مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.68,
   "end": 119.66,
   "text": "آنتن، موضوع زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.66,
   "end": 124.32,
   "text": "حقوق زن در اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.32,
   "end": 126.46,
   "text": "که متاسفانه امروزه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.46,
   "end": 133.16,
   "text": "زیاد داره سوءاستفاده می‌شه با حرف‌های بزک کرده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.16,
   "end": 136.72,
   "text": "مخالف با نصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.72,
   "end": 139.94,
   "text": "صریح آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.94,
   "end": 144.72,
   "text": "که مثلاً اخیراً رهبر عزیزمون مخصوصاً پافشاری داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.72,
   "end": 150.5,
   "text": "در ایام میلاد حضرت زهرا صلی الله علیها اگر دقت کردید پافشاری داشتن روی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.5,
   "end": 152.82,
   "text": "که مهم‌ترین وظیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.82,
   "end": 155.42,
   "text": "زن مادر بودنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.42,
   "end": 158.88,
   "text": "اینه که در منزل پرورش نفوس کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.88,
   "end": 161.56,
   "text": "این مهم‌ترین وظیفه زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.56,
   "end": 164.42,
   "text": "بعد یه مشت از این سیاستمدارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.42,
   "end": 168.78,
   "text": "متاسفانه نفهمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.78,
   "end": 172.6,
   "text": "حالا ی-- وقتی می‌بینی لباس دین تنشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.6,
   "end": 179.02,
   "text": "نمی‌تونی بگی جهل. نمی‌تونی بگی این جهله در مقابل داناییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.02,
   "end": 183.26,
   "text": "اخیر جهل در برابر عقله، نه در برابر علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.26,
   "end": 186.18,
   "text": "که میگن که نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.18,
   "end": 189.86,
   "text": "تخریب می‌کنن این مثلاً این جمله که زن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.86,
   "end": 192.1,
   "text": "خانه‌دار باشد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.1,
   "end": 195.6,
   "text": "یه حماقت می‌دونن. یه کسر شأن برای زن می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.6,
   "end": 199.2,
   "text": "برای مادر که متاسفانه الان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.2,
   "end": 204.8,
   "text": "خیلی زن‌ها عاشق کار کردنن و مردهای ما هم حتی اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.8,
   "end": 207.88,
   "text": "می‌بینیم که میرن سراغ زن‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.88,
   "end": 210.32,
   "text": "متاسفانه دوشغلن. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.32,
   "end": 214.92,
   "text": "عرض شود شغل دارن که مثلاً تو خونه‌شون یه شغل، شوهر داشته باشه، یه شغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.92,
   "end": 217.56,
   "text": "همسر. حالا به بهانه مسائل اقتصادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.56,
   "end": 220.1,
   "text": "حالا بهانه‌هاشو کاری ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.1,
   "end": 224.04,
   "text": "این یه انحرافی‌ست که در جامعه داره صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.04,
   "end": 226.22,
   "text": "اتفاقاً شهید مطهری یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.22,
   "end": 229.4,
   "text": "کتابی دارن خیلی-- کتاب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.4,
   "end": 232.64,
   "text": "عنوانش هست نظام حقوق زن در اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.64,
   "end": 236.98,
   "text": "اما مقالات، مجموعه مقالات شهید مطهریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.98,
   "end": 238.92,
   "text": "در سال چهل و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.92,
   "end": 244.62,
   "text": "و چهل و شش قبل از انقلاب در مجله زن روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.62,
   "end": 250.4,
   "text": "در جواب مقالاتی که بر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.4,
   "end": 256.82,
   "text": "زن از حیث نص صریح روایات و آیات مقاله می‌نوشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.82,
   "end": 259.88,
   "text": "پیرامون مسائل مختلف مثل مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.88,
   "end": 262.94,
   "text": "استقلال اقتصادی زن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.94,
   "end": 265.34,
   "text": "یا ازدواج مجدد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.34,
   "end": 272.28,
   "text": "اصلاً ازدواج، جایگاه زن، جایگاه اجتماعی و خانوادگی زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.28,
   "end": 275.76,
   "text": "همه این‌ها مقالاتی که می‌نوشتن اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.76,
   "end": 282.46,
   "text": "بر علیه قوانین و دوس-- می‌خواستن، یعنی می‌خواستن جامعه رو به سمتی ببرن که اون قوانین مدنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.46,
   "end": 286.1,
   "text": "بر علیه قوانین شرعی ما بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.1,
   "end": 291.86,
   "text": "اونجا شهید مطهری-- خیلی هم بهشون اشکال می‌کردن همون موقع‌ش که آخه شخصیت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.86,
   "end": 298.0,
   "text": "به عنوان یک مثلاً اسلام‌شناس زشته بیای تو زن روز مثلاً مقاله بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.0,
   "end": 302.06,
   "text": "یکی از اتفاقاً خدا رحمت کنه حضرات عهای مصباح رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.06,
   "end": 306.94,
   "text": "جلسه اخلاق ایشون که قم رفته بودیم یه روزی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.94,
   "end": 313.8,
   "text": "فرمودن که علت اینکه شهید مطهری اینقدر رشد کرد، عزیزان بدونید فرمایش‌های مصباح رو دارم بهتون عرض می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.8,
   "end": 316.44,
   "text": "این بود که نیاز زمانه رو تشخیص داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.44,
   "end": 318.4,
   "text": "دیگه کاری نداشت که مردم چی فکر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.4,
   "end": 321.84,
   "text": "مثلاً داستان راستان نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.84,
   "end": 325.02,
   "text": "داستان نوشت، کتاب داستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.02,
   "end": 328.74,
   "text": "یه فیلسوف بیاد کتاب داستان-- گفتن آخه شما در شأن‌ت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.74,
   "end": 331.92,
   "text": "فرمود الان جوون‌ها نیاز به این دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.92,
   "end": 337.62,
   "text": "حتی شما مجموعه داستان‌های ایشون رو نگاه کنید بسیار داستان‌ها حکیمانه انتخاب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.62,
   "end": 342.62,
   "text": "جنبه عقلایی داره. زیربنای عقلی جوون‌ها رو محکم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.62,
   "end": 346.16,
   "text": "حالا این خیلی خوبه که اتفاقاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.16,
   "end": 350.12,
   "text": "م-مجموعه مقالات که به عنوان کتاب چاپ شد الان وقتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.12,
   "end": 352.96,
   "text": "یکی از بهترین وقت‌هاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.96,
   "end": 355.52,
   "text": "اهلش بیان این رو بازش کنن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.52,
   "end": 360.24,
   "text": "چیره‌بون به دستا اون‌هایی که در جامعه جا افتادن این رو دوباره به یه بازخوانی‌ای بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.24,
   "end": 364.14,
   "text": "الان که داره انحراف مجدد، تحریف صورت می‌گیره و صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.14,
   "end": 367.28,
   "text": "چرا رهبرمون یه تنه داد بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.28,
   "end": 371.44,
   "text": "یا حالا خیلیا معتقدن که اصلاً تاریخ مذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.44,
   "end": 374.64,
   "text": "یعنی تاریخ رو مردها می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.64,
   "end": 381.8,
   "text": "نظر شما چیه؟ مثلاً رهب-- ا-امام علیه السلام جمله ما رو امامه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.8,
   "end": 385.62,
   "text": "مرد از دامن زن به معراج می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.62,
   "end": 390.46,
   "text": "شهید مطهری تو، تو مجموعه مقالاتش در یکی از مقالاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.46,
   "end": 397.32,
   "text": "می‌نویسه که خیلی شیرین می‌فرمود که بله مردها تاریخ سازن اما کیا مردها رو می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.32,
   "end": 403.8,
   "text": "ایشون می‌فرمودن که زن مرد رو می‌سازه، مرد هم تاریخ رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.8,
   "end": 406.84,
   "text": "یعنی خیلی حرف متعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.84,
   "end": 413.6,
   "text": "و ما، شما وقتی دقت می‌کنید می‌بینید سر تا سر تاریخ حتی قبل از اسلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.6,
   "end": 418.52,
   "text": "زنان حماسه‌ساز و جامعه‌ساز کم نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.52,
   "end": 424.06,
   "text": "شما حتی میری سراغ مسائل و مبانی شرعی دینمون، مناسک حج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.06,
   "end": 429.24,
   "text": "می‌بینی بر اساس حرکت یک زن استوار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.24,
   "end": 433.66,
   "text": "سعی بین صفا و مروه چجوری ایجاد شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.66,
   "end": 437.28,
   "text": "از حرکت هروله‌وار حضرت هاجر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.28,
   "end": 442.18,
   "text": "که اون زمزم که پای حضرت اسماعیل به زمین کشیده می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.18,
   "end": 445.82,
   "text": "آب می‌جوشه. خب قبلش مادرش هفت مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.82,
   "end": 449.16,
   "text": "بین دو-- دویدن و راه رفتن، هروله‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.16,
   "end": 454.54,
   "text": "رفت بین کوه، در کوه صفا یا مروه هی سراب می‌دید، آب می‌دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.54,
   "end": 457.92,
   "text": "و حرکت کرد. ببینید بر بنای اون منسک، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.92,
   "end": 461.16,
   "text": "مناسک حج یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.16,
   "end": 463.26,
   "text": "شعوناتش همین سعی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.26,
   "end": 466.4,
   "text": "صفا و مروه‌ست که بر اساس حرکتی، اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.4,
   "end": 470.72,
   "text": "اینکه همسرش و فرزندش رو اونجا حضرت ابراهیم گذاشت و رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.72,
   "end": 478.0,
   "text": "این مناسک ایجاد شد. یا شما تو هر کدوم از انبیا مثلا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.0,
   "end": 482.34,
   "text": "مریم صلوات الله علیها رو می‌بینی \"فتمثل لها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.34,
   "end": 485.66,
   "text": "لها چقدر علامه حسن زاده اینجا حرف داره رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.66,
   "end": 490.9,
   "text": "ها ضمیره های. \"فتمثل لها\" یعنی فقط برا حضرت مریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.9,
   "end": 492.58,
   "text": "\"بشراً سویا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.58,
   "end": 497.02,
   "text": "حضرت روح‌الامین مثل یک بشر راستقامت جلوه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.02,
   "end": 500.88,
   "text": "یعنی هیچکس نمی‌دید. چه مقام، مقام بالایی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.88,
   "end": 504.78,
   "text": "مقام خیلی مقام بالایی‌ست که أطعمة و أشربة بهشتی بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.78,
   "end": 509.04,
   "text": "در قیاس با حضرت زهرا سلام الله علیها یا امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.04,
   "end": 513.8,
   "text": "مثلاً می‌خوان بیان کلمه وجودی حضرت عیسی رو با کلمه وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 513.8,
   "end": 516.78,
   "text": "امیرالمؤمنین قیاس کنن. حرفم درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.78,
   "end": 521.18,
   "text": "می‌گن خب حضرت مریم وقتی وارد مب-معبد شد خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.18,
   "end": 522.94,
   "text": "وضع حمل کنه بیرونش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 522.94,
   "end": 525.58,
   "text": "خدا فرمود برو بیرون از اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.58,
   "end": 531.32,
   "text": "ولی حضرت فاطمه بنت اسد رو برعکس خدا فرمود بیا داخل شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.32,
   "end": 534.1,
   "text": "داخل کعبه. اینطوری قیاس می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.1,
   "end": 538.96,
   "text": "اما حضرت مریم هم از أطعمة و أشربة بهشتی خورد و نوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.96,
   "end": 541.68,
   "text": "چیز کمی نیست و کلمه عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 541.68,
   "end": 545.44,
   "text": "بر او القا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.44,
   "end": 548.7,
   "text": "که حالا نحوه القا به چگونه بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.7,
   "end": 554.16,
   "text": "حضرت علامه معتقدن پدر حضرت عیسی می‌شه حضرت روح‌الامین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.16,
   "end": 560.96,
   "text": "القای این کلمه به رحم حضرت مریم که جاش اینجا نیست باز کردنش از جهت علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.96,
   "end": 562.64,
   "text": "خیلی حرف‌های شیرینی پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.64,
   "end": 564.88,
   "text": "این باز جایگاه، جایگاه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.88,
   "end": 570.2,
   "text": "یعنی در دامن کی کلمه الهی حضرت عیسی پرورش پیدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.2,
   "end": 573.12,
   "text": "حضرت مریم. یا در خصوص حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.12,
   "end": 575.52,
   "text": "پای سه تا زن در میانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.52,
   "end": 583.2,
   "text": "وقتی که می‌ره در قصر فرعون یکیش که آسیه همسر فرعون، ایشون رو بزرگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.2,
   "end": 586.88,
   "text": "می‌شه مادرخوانده. از اون طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 586.88,
   "end": 588.9,
   "text": "مادر این-- موسی و خواهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.9,
   "end": 595.74,
   "text": "و اتفاقاً در جا به جا شدن حضرت زهرا سلام الله علیها در بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.74,
   "end": 602.32,
   "text": "شهادت‌شون یکی از اون چهار زن بهشتی که می‌آمده کمک می‌کرده حضرت آسیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.32,
   "end": 606.14,
   "text": "حالا نحوه‌ش باید از جهت علمی بحث بشه چون اینجا عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.14,
   "end": 608.98,
   "text": "او از نشئه مجردات اومده تو عالم ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 608.98,
   "end": 611.54,
   "text": "مگه می‌شه همچین چیزی؟ نه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 611.54,
   "end": 614.48,
   "text": "عقلاً نمی‌شه. وقتی رفتی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.48,
   "end": 617.32,
   "text": "حتی بحث رجعت قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.32,
   "end": 621.48,
   "text": "پرداخته، قابل تحقیقه که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.48,
   "end": 624.28,
   "text": "یعنی با همون، با همین جسم خاکی برمی‌گردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.28,
   "end": 629.94,
   "text": "نمی‌شه. کسی که از نشئه ماده رفت به مجرد دیگه نمی‌شه بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 629.94,
   "end": 634.02,
   "text": "اینجا استعداده. اینجا امکان استعدادی داره، اونجا امکان استعدادی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.02,
   "end": 638.5,
   "text": "باید رفت رو ملکات اعمال و رو بدن برزخی صحبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 638.5,
   "end": 641.24,
   "text": "حالا در هر حال بحث اون رو نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.24,
   "end": 644.08,
   "text": "که حضرت آسیه می‌اومد کمک حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.08,
   "end": 647.82,
   "text": "حالا نحوه‌ش به چگونه‌ست باید بماند تو بحث‌های علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.82,
   "end": 651.14,
   "text": "شما هر طرف که نگاه می‌کنید پای یک زن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 651.14,
   "end": 654.92,
   "text": "در میانه. حالا شما میای جلو تو تاریخ اسلام می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.92,
   "end": 661.46,
   "text": "حضرت زهرا صلوات الله علیه به جایی پیش می‌ره که می‌شه نفس مصداق اتم نفس کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 661.46,
   "end": 666.56,
   "text": "و چون تمام کائنات تحت پرورش نفس کلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.56,
   "end": 673.24,
   "text": "لذا حضرت علامه حسن زاده همونطور که بحثش در فاطمیه گذشت در فس اسمتیه‌شون یا فاطمیه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 673.24,
   "end": 678.44,
   "text": "می‌فرمود که از این جهت فرمود پیغمبر به دخترش ام ابیها، مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 678.44,
   "end": 681.1,
   "text": "پدرش که چون همه کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 681.1,
   "end": 685.3,
   "text": "در نشئه ماده و طبیعت هم تحت پرورش نفس کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 685.3,
   "end": 690.16,
   "text": "و حضرت صدوق صلوات الله علیه در غوص سعود رفته رسیده به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.16,
   "end": 693.12,
   "text": "نفس کل. پس پیغمبر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 693.12,
   "end": 697.2,
   "text": "که در نشئه طبیعت بوده تحت پرورش نفس کل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 697.2,
   "end": 699.94,
   "text": "پس او مادر پیغمبر هم حساب می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.94,
   "end": 702.38,
   "text": "نه ف-- صرفاً حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.38,
   "end": 704.04,
   "text": "مثلاً عاطفی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.04,
   "end": 705.66,
   "text": "جوشش عاطفه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 705.66,
   "end": 708.84,
   "text": "نه اینطوری نیست. یا حضرت زینب رو شما ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 708.84,
   "end": 710.54,
   "text": "اصلاً این وجود حضرت زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.54,
   "end": 712.92,
   "text": "حالا اینجا، همینجا فرود بیاریم بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.92,
   "end": 717.12,
   "text": "اصلاً آدم لال می‌شه در خصوص این خانم صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 717.12,
   "end": 719.06,
   "text": "ریاحین الشریعه رو شما بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 719.06,
   "end": 720.64,
   "text": "تاریخ دمشق رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 720.64,
   "end": 722.98,
   "text": "ستاره درخشان شام رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 722.98,
   "end": 726.56,
   "text": "این کتاب‌هایی که یه قلم‌هایی زدن، چیزکی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 726.56,
   "end": 728.44,
   "text": "چه غوغاییه در خصوص ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 728.44,
   "end": 732.95,
   "text": "اصلاً این مدال تا همیشه همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 732.95,
   "end": 740.45,
   "text": "بر تارک، تارک گیتی باید بدرخشه که ان-انسان کامل زمانش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 740.45,
   "end": 746.77,
   "text": "امام زمانش بهش این مدال رو داد که \"أنت بحمدالله أمتي\" امه جان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 746.77,
   "end": 750.89,
   "text": "امام سجاد. امام زمان به یکی این حرفو بزنه شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 750.89,
   "end": 758.15,
   "text": "امام زمانش بوده. \"أنت بحمدالله\" حالا آقا توی این بحمدالله انقدر حرف پیاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 758.15,
   "end": 761.61,
   "text": "خیلی سروسته عرض کنم برای اهلش که \"الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 761.61,
   "end": 763.91,
   "text": "لله رب العالمين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 763.91,
   "end": 767.65,
   "text": "اون الحمد مقام صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 767.65,
   "end": 770.31,
   "text": "یعنی واسطه فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 770.31,
   "end": 773.67,
   "text": "با خدا. یعنی برزخ بین حق و خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 773.67,
   "end": 778.99,
   "text": "کسی از واسطه فیض، برزخ بین حق و خلق که صادر اوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 778.99,
   "end": 786.87,
   "text": "نفس الرحمن نفس الرحمن که زده همه کلمات وجودی نظام هستی ازش منتشر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 786.87,
   "end": 789.55,
   "text": "از اون فیض بگیره به میگن علم لدنّی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 789.55,
   "end": 793.95,
   "text": "میگه أنت این رمزه دارم عرض میکنم سریعم ازش رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 793.95,
   "end": 799.99,
   "text": "بحمدالله، بحمدالله یعنی واسطه فیض رو در نظر میگیره اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 799.99,
   "end": 803.23,
   "text": "تو به کجا رسیدی که علم لدنّی پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 803.23,
   "end": 806.59,
   "text": "\"عالمة غير معلمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 806.59,
   "end": 808.87,
   "text": "و فهمة غير مفهمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 808.87,
   "end": 814.97,
   "text": "اصلاً بدون اینکه کسی به تو تفهیم کنه، بدون اینکه معلم بگیری تو به علم لدنّی رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 814.97,
   "end": 823.23,
   "text": "ببینید بعد آخه جایگاه کجاست که امام معصوم بهش بگه تو قنوت نماز وترت منو دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 823.23,
   "end": 826.51,
   "text": "دو جا حضرت زینب امامت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 826.51,
   "end": 828.99,
   "text": "اینا دیگه تو تاریخ هست. دیگه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 828.99,
   "end": 831.45,
   "text": "عرض نکنم. دیگه وقت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 831.45,
   "end": 834.23,
   "text": "دو جا یا بعضا گفتن تا سه جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 834.23,
   "end": 838.63,
   "text": "جان انسان کامل و امام زمانش رو نجات داده که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 838.63,
   "end": 841.19,
   "text": "قصه روضه‌ست من بیان نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 841.19,
   "end": 843.79,
   "text": "چه کرده این زن؟ این خانم چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 843.79,
   "end": 848.51,
   "text": "می‌کنن. حالا برید تو اون خطبه ببینید چه غوغاییه که یه دست اینطوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.51,
   "end": 852.77,
   "text": "یه اشاره دست نه تکلم، اشاره دست حضرت زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 852.77,
   "end": 855.71,
   "text": "اون زنگوله شترها رو هم از کار انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 855.71,
   "end": 858.43,
   "text": "یعنی تصرف در ماده کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 858.43,
   "end": 862.49,
   "text": "برید کلمه چهل و هشت صد کلمه در معرفت نفس علامه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 862.49,
   "end": 864.41,
   "text": "تصرف در ماده کائنات یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 864.41,
   "end": 871.13,
   "text": "چه مقامی می‌خواد. جایگاه زن واقعاً باید از نو بررسی بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 871.13,
   "end": 873.85,
   "text": "دو مرتبه بیان بشه. یه بازخوانی نیاز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.85,
   "end": 875.67,
   "text": "ان‌شاءالله عاقبتmu ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 875.67,
   "end": 879.11,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}