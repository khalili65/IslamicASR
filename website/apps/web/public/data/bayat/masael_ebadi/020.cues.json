 },
 "chapters": [
  {
   "index": 0,
   "title": "## نامهٔ چهل‌وپنج؛ ساده‌زیستی و پرهیز از ثروت‌اندوزی",
   "start": 0.4,
   "end": 154.92
  },
  {
   "index": 1,
   "title": "دوم، در نامهٔ چهل‌ویک دیده می‌شود: برخورد محکم با نزدیکان مفسد اقتصادی، ولو نزدیکان باشند. جملهٔ مولا شگفت است:",
   "start": 154.92,
   "end": 206.88
  },
  {
   "index": 2,
   "title": "سوم، عدم همراهی و به‌کارگیری دنیاطلبان در کابینه و اطرافیان است؛ از نامهٔ سی‌ونه:",
   "start": 206.88,
   "end": 245.54
  },
  {
   "index": 3,
   "title": "### طبقهٔ سفلی و کاهش گرفتاری محرومان",
   "start": 245.54,
   "end": 529.53
  },
  {
   "index": 4,
   "title": "### حسن‌ظن نداشتن به دشمن",
   "start": 529.53,
   "end": 597.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 6.04,
   "text": "به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.04,
   "end": 11.62,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.62,
   "end": 13.98,
   "text": "با توجه به نامه‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.98,
   "end": 17.96,
   "text": "از امیرالمؤمنین علیه الصلاة والسلام به یادگار مونده برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.96,
   "end": 25.1,
   "text": "و اینا ذخائرن. یه چند تا رد پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.1,
   "end": 32.08,
   "text": "بحث انتخابات رو، رد پای اون‌هایی که اصلحن از میان نامه‌های مولا پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.08,
   "end": 36.98,
   "text": "چند تاشو من عرض کنم. یه مقدار خب با توجه به این‌ها آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.98,
   "end": 40.94,
   "text": "خیالش راحت میشه که دیگه قیامت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.94,
   "end": 44.54,
   "text": "هرچند اون بالا ساق ما با توجه کردیم به فرمایشات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.54,
   "end": 48.9,
   "text": "مولامون امیرالمؤمنین، به فرمایشات رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.9,
   "end": 54.1,
   "text": "و اصلح رو انتخاب کردیم بر اساس این موازین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.1,
   "end": 56.72,
   "text": "اولین نکته‌ای که عرض می‌کنم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.72,
   "end": 59.76,
   "text": "نامه‌ی چهل و پنج امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.76,
   "end": 62.32,
   "text": "این قسمتش که می‌فرماید الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.32,
   "end": 70.28,
   "text": "بحث ساده زیستی و عدم ثروت اندوزی یکی از ملاک‌های بسیار مهم در انتخاب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.28,
   "end": 74.0,
   "text": "که الا و ان امامکم قد اكتفی من دنیاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.0,
   "end": 77.3,
   "text": "بتمره‌. تمره‌ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.3,
   "end": 81.48,
   "text": "دو تا جامه کهنه. میگه حواستون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.48,
   "end": 85.56,
   "text": "ببینید که امامتون کفایت کرد به دو تا جامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.56,
   "end": 89.26,
   "text": "کهنه از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.26,
   "end": 94.24,
   "text": "و من طعمهی یعنی از غذای این دنیا به قرص‌یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.24,
   "end": 97.74,
   "text": "به دو تا نون، به دو تا تیکه نون قناعت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.74,
   "end": 103.82,
   "text": "این که مولای شماست. دیگه اون کسی که میخواد در مسیر مولا باشه، علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.82,
   "end": 106.66,
   "text": "راه مولا رو برداره بالطبع باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.66,
   "end": 110.58,
   "text": "نزدیک بشه دیگه. اهل ثروت اندوزی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.58,
   "end": 113.5,
   "text": "این یک خصوصیت. دومیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.5,
   "end": 115.56,
   "text": "در نامه‌ی چهل و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.56,
   "end": 122.78,
   "text": "مولا دیده میشه که برخورد محکم با نزدیکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.78,
   "end": 125.4,
   "text": "مفسد اقتصادی ولو نزدیکان باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.4,
   "end": 130.74,
   "text": "خیلی این جمله مولا عجیبه که می‌فرماید \"لو ان الحسن والحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.74,
   "end": 133.24,
   "text": "فعلا مثل الذي فعلت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.24,
   "end": 135.62,
   "text": "اگه حسن و حسین من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.62,
   "end": 138.34,
   "text": "یه عزیزتر از این‌ها رو ندارم که ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.34,
   "end": 143.74,
   "text": "اگر این‌ها اون کاری که تو می‌کردن انجام می‌دادن \"ما كانت لهما عندي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.74,
   "end": 147.18,
   "text": "خوادع\" از من هیچ نرمشی نمی‌دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.18,
   "end": 150.82,
   "text": "\"ولا ظفرا مني بإرادة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.82,
   "end": 154.54,
   "text": "به هیچ مرادی از طرف من نمی‌رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.54,
   "end": 159.24,
   "text": "یعنی عزیزترین کس من اگر فساد کنه من باهاش برخورد می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.24,
   "end": 163.84,
   "text": "این خیلی نکته مهمیه در تراز کسی که می‌خواد بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.84,
   "end": 166.62,
   "text": "یعنی ریاست جمهوری انقلابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.62,
   "end": 169.96,
   "text": "ما. بعدیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.96,
   "end": 174.0,
   "text": "بحث عدم همراهی و به کارگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.0,
   "end": 178.86,
   "text": "دنیاطلب‌هاست. تو کابینش، دور و وری‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.86,
   "end": 184.22,
   "text": "باید توجه به این داشته باشه که از نامه‌ی سی و نه مولا برداشت میشه که \"فانك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.22,
   "end": 191.34,
   "text": "قد جعلت دینک تبعا لدنیا امر إواهر غیه-غیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.34,
   "end": 198.28,
   "text": "می‌فرماید تو دینت رو تابع دنیای کسی نمودی که گمراهیش معلوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.28,
   "end": 203.24,
   "text": "دینت رو تابع دنیای کسی کردی که گمراهیش معلوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.24,
   "end": 206.88,
   "text": "خیلیا الان می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.88,
   "end": 210.48,
   "text": "دنبال سر آدمایی حرکت می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.48,
   "end": 212.16,
   "text": "حتی تو مسائل دینی‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.16,
   "end": 217.84,
   "text": "خیلی عجیبه. اقتدا هم می‌کنن به اونایی که اصلاً گمراهیشون مسجله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.84,
   "end": 221.16,
   "text": "اصلاً کسی که ولو لباس روحانیت تنشه ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.16,
   "end": 225.02,
   "text": "با زن برهنه عکس می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.02,
   "end": 228.68,
   "text": "ولو یه زمانی مثلاً پرچم انقلاب هم رو دوشش بوده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.68,
   "end": 231.86,
   "text": "باشه خب الان منحرف شده یا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.86,
   "end": 234.72,
   "text": "عرض کنم دست میده به نامحرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.72,
   "end": 238.2,
   "text": "اینا دیگه شریعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.2,
   "end": 243.84,
   "text": "واضحات شریعت رو وقتی رعایت نمی‌کنه شما می‌خوای علم انقلابو بدی دست این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.84,
   "end": 248.66,
   "text": "دیگه میگه که باید حواست تو این مسائل جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.66,
   "end": 255.6,
   "text": "دنبال سر دو-دو-- یعنی کسایی که داری رای میدی بهشون دنبال سر دنیاطلبا نرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.6,
   "end": 258.06,
   "text": "اون‌ها رو پیشوای خودشون قرار ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.06,
   "end": 262.04,
   "text": "نکته بعدی از نامه سی و هشت استخراج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.04,
   "end": 264.9,
   "text": "بحث عقب نشینی نکردن در برابر دشمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.9,
   "end": 268.5,
   "text": "چقدر ما مسئولین متأسفانه مرعوب داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.5,
   "end": 271.76,
   "text": "که دنبال سازش و این‌ها بودن از ترسشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.76,
   "end": 274.56,
   "text": "دیپلماسی ما چقدر منفعل بود یه زمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.56,
   "end": 280.92,
   "text": "\"لا ينقضي عن الأعدا ساعات الروع\" می‌فرماید اون ساعت‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.92,
   "end": 284.48,
   "text": "می‌ترسی عقب نشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.48,
   "end": 289.9,
   "text": "اون ساعت‌هایی که عن الأعدا از دشمن، یه ساعت ترس از دشمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.9,
   "end": 293.42,
   "text": "مثلاً دشمن یه تشری زده، یه کُری خونده به قول ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.42,
   "end": 296.4,
   "text": "میگه عقب نشینی نکن، محکم باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.4,
   "end": 302.28,
   "text": "یکی از شاخصه‌های مهم کسیه که می‌خوایم انتخابش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.28,
   "end": 306.54,
   "text": "نامه پنجاه و سه. الان تیکه‌های بعدیشو دیگه همه از نامه پنجاه و سه انتخاب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.54,
   "end": 312.62,
   "text": "نامه پنجاه و سه هم که می‌دونید عهدنامه معروف به عهدنامه امیرالمؤمنین با مالک اشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.62,
   "end": 318.02,
   "text": "بین این دو عزیز. نامه مولا به مالکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.02,
   "end": 320.82,
   "text": "در خصوص اعتنا کردن به نظرات مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.82,
   "end": 323.7,
   "text": "\"ولا تقولن إني مؤمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.7,
   "end": 326.64,
   "text": "أمر فأطاع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.64,
   "end": 329.12,
   "text": "نگو که حالا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.12,
   "end": 332.28,
   "text": "منو امیر شما قرار دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.28,
   "end": 334.3,
   "text": "باید فرمان من اطاعت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.3,
   "end": 339.18,
   "text": "هرچی من میگم همونه. همچین حرفی نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.18,
   "end": 341.86,
   "text": "یا دو مرتبه یه بخش دیگه‌ش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.86,
   "end": 348.16,
   "text": "ثم این در خصوص توجه داشتن به اقشار ضعیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.16,
   "end": 351.5,
   "text": "و در صدد کاهش گرفتاری‌هاشون بودنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.5,
   "end": 354.86,
   "text": "به فکر طبقه مستضعف و محروم باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.86,
   "end": 357.5,
   "text": "\"ثم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.5,
   "end": 359.88,
   "text": "الله\" دو بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.88,
   "end": 364.96,
   "text": "\"الله الله في الطبقة السفلى\" کاملاً مشخصه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.96,
   "end": 369.27,
   "text": "ترجمه نمی‌خواد خدا را، خدا را در نظر بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.27,
   "end": 372.87,
   "text": "در خصوص کی؟ اون طبقه محروم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.87,
   "end": 375.91,
   "text": "حالا الان اومدن مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.91,
   "end": 379.41,
   "text": "برای اینکه خودشون رو استهاله کنن گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.41,
   "end": 381.83,
   "text": "کم بهره، چی؟ کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.83,
   "end": 386.25,
   "text": "برخوردار به جای محروم و مستضعف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.25,
   "end": 388.13,
   "text": "طبقه کم برخوردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.13,
   "end": 391.05,
   "text": "بازی با کلمات دارن می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.05,
   "end": 396.05,
   "text": "حالا شما ببین مثلاً بنیاد مستضعفان چه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.05,
   "end": 400.67,
   "text": ". ببند. قطعه بعدی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.67,
   "end": 404.95,
   "text": "کینه و اینه که حواسش باشه کینه‌ی مردم رو از بین ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.95,
   "end": 408.07,
   "text": "دچار دو قطبی‌سازی اجتماع نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.07,
   "end": 428.07,
   "text": "می‌فرماید قطعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 454.19,
   "end": 456.81,
   "text": "بعدی. فحص این پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.81,
   "end": 460.45,
   "text": "اینه که تلاشش برای از بین بردن فساد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 460.45,
   "end": 467.69,
   "text": "\"فحص مادة أولئک و قطع أسباب تلك الأحوال\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.69,
   "end": 475.31,
   "text": "می‌فرماید که ریشه ستمکاری‌هاشون رو وقتی شناختی که فهمیدی اینا ریشه ستمکاری‌شون کجاست و چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 475.31,
   "end": 477.51,
   "text": "این عقده رو شناسایی کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 477.51,
   "end": 480.59,
   "text": "میگه \"بقطع اسباب تلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.59,
   "end": 486.03,
   "text": "الأحوال\". فرمود که بخشکن با بریدن اسبابشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 486.03,
   "end": 490.89,
   "text": "سبب‌هاشون، اسبابشون بخشکن، ریشه فساد رو بخشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.89,
   "end": 493.55,
   "text": "راحت از کنار فساد رد نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 493.55,
   "end": 499.75,
   "text": "نگو این حالا برادر فلانیه، این خواهر فلانیه، این فامیل قوم و خویش فلانیه حتی خود منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 499.75,
   "end": 505.87,
   "text": "حالا شما این فرمایش مولا رو بذار کنار اونی که می‌گفت اگه دست برادرم بزنید انتخابات رو برگزار نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 505.87,
   "end": 507.99,
   "text": "یعنی هرچی آدم می‌ره جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 507.99,
   "end": 510.35,
   "text": "چهره منفور بعضیا آشکارتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.35,
   "end": 516.85,
   "text": "حالا نمی‌دونم با چه رویی دوباره مثل مار سرشون رو مثل افعی از لونه‌هاشون دوباره بیرون آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 516.85,
   "end": 519.69,
   "text": "و دوباره فراکسیون راه انداختن و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 519.69,
   "end": 522.15,
   "text": "قطعه بعدی باز از نامه پنجاه و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 522.15,
   "end": 525.91,
   "text": "\"وتهم فی ذلک حسن الظن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 525.91,
   "end": 529.53,
   "text": "اصلاً کلاً می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 529.53,
   "end": 531.63,
   "text": "مطلقا به دشمنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 531.63,
   "end": 535.07,
   "text": "حسن ظن نداشته باش. \"وتهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 535.07,
   "end": 538.97,
   "text": "فی ذلک حسن الظن\". اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 538.97,
   "end": 541.79,
   "text": "معنا نداره به دشمن حسن ظن داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 541.79,
   "end": 545.55,
   "text": "اینایی که همش حرف مذاکره، مذاکره، مذاکره می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 545.55,
   "end": 549.03,
   "text": "معنا در-- نداره اصلاً. حسن ظن به دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 549.03,
   "end": 553.67,
   "text": "توبه گرگ مرگه. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 553.67,
   "end": 559.61,
   "text": "نکته‌ی بعدی بحث نظارت بر زیردستان و انتخاب فرد شایسته برای خدمت به مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.61,
   "end": 563.11,
   "text": "\"ثم انظر فی امور أموالک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 563.11,
   "end": 571.19,
   "text": "می‌فرماید تو امور اونایی که به کار بستیشون یا می‌خوای به کار ببندیشون اموال توهست دقت کن، بیندیش \"فانظر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 571.19,
   "end": 574.43,
   "text": "\"ثم انظر\" نظر بنداز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 574.43,
   "end": 577.17,
   "text": "\"فاستعملهم اختبارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 577.17,
   "end": 583.95,
   "text": "بعد از وقتی که آزمایش‌شون کردی خبر محکم گرفتی که اینا ما-- واقعاً درستکارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 583.95,
   "end": 589.15,
   "text": "اون موقع به کار بگیرشون. ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 589.15,
   "end": 597.23,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}