 },
 "chapters": [
  {
   "index": 0,
   "title": "## معیار حال کنونی در خط امام",
   "start": 9.18,
   "end": 31.06
  },
  {
   "index": 1,
   "title": "## عدالت دوطرفه",
   "start": 31.06,
   "end": 644.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 5.62,
   "text": "این السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.62,
   "end": 8.3,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 12.9,
   "text": "یه چند جمله از رهبر عزیزمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.9,
   "end": 18.18,
   "text": "بخونیم. نکته بسیار مهمی رو تصریح کردن آقا در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.18,
   "end": 28.04,
   "text": "چند جمله فرمودند یک نکته اساسی دیگر در مورد خط امام و راه امام این است که امام بارها فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.04,
   "end": 31.06,
   "text": "قضاوت در مورد اشخاص باید با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.06,
   "end": 35.92,
   "text": "معیار حال کنونی اشخاص باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.92,
   "end": 39.8,
   "text": "گذشته اشخاص مورد توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.8,
   "end": 43.7,
   "text": "است یا نیست؟ نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.7,
   "end": 46.92,
   "text": "تموم شد. منقضی رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.92,
   "end": 49.4,
   "text": "گذشته مال آن وقتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.4,
   "end": 53.08,
   "text": "که حال فعلی معلوم نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.08,
   "end": 61.18,
   "text": "خیلی نکته مهمیه. انسان به آن گذشته تمسک کند و بگوید خب قبلاً اینجوری بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.18,
   "end": 62.82,
   "text": "حالا هم لابد همان جور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.82,
   "end": 65.72,
   "text": "مال کیه؟ وقتی حال کنونی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.72,
   "end": 71.98,
   "text": "نمیشه تشخیص داد. حالا مثلاً طرف جهت‌گیری اجتماعی خاصی نداشته تو خونه نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.98,
   "end": 76.26,
   "text": "مسائل و ابعاد متعدد سیاسی، اجتماعی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.26,
   "end": 80.44,
   "text": "جهت‌گیری نکرده، اصلاً پیداش نبوده، در معرض عام نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.44,
   "end": 83.08,
   "text": "نمیشه تشخیص داد. اون موقع بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.08,
   "end": 87.08,
   "text": "رجوع می‌کنیم به قبلش. در غیر این صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.08,
   "end": 89.96,
   "text": "الانش رو باید دید. ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.96,
   "end": 97.46,
   "text": "فرمایشات. اگر حال فعلی اشخاص در نقطه مقابل آن گذشته بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.46,
   "end": 100.7,
   "text": "آن گذشته دیگر کارایی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.7,
   "end": 103.66,
   "text": "این همان قضاوتی بود که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.66,
   "end": 109.14,
   "text": "امیرالمؤمنین علیه الصلاة والسلام با جناب طلحه و زبیر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.14,
   "end": 111.86,
   "text": "جناب طلحه و جناب زبیر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.86,
   "end": 117.26,
   "text": "شما باید بدانید طلحه و زبیر مردمان کوچکی نبودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.26,
   "end": 125.0,
   "text": "جناب زبیر سوابق درخشان دارد که نظیر آن را کمتر کسی از اصحاب امیرالمؤمنین داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.0,
   "end": 128.9,
   "text": "بعد از به خلافت رسیدن جناب ابی بکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.9,
   "end": 133.12,
   "text": "در همان روزهای اول پای منبر ابی بکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.12,
   "end": 136.24,
   "text": "چند نفر از صحابه بلند شدند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.24,
   "end": 138.5,
   "text": "اظهار مخالفت کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.5,
   "end": 140.98,
   "text": "گفتند حق با شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.98,
   "end": 143.96,
   "text": "حق با علی ابن ابی طالب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.96,
   "end": 148.0,
   "text": "اسم این اشخاص در تاریخ ثبت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.0,
   "end": 151.78,
   "text": "این چیزهایی نیست که شیعه نقل کرده باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.78,
   "end": 156.0,
   "text": "نه، این در همه کتب تواریخ ذکر شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.0,
   "end": 163.06,
   "text": "یکی از آن اشخاصی که پای منبر جناب ابی بکر بلند شد و از حق امیرالمؤمنین دفاع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.06,
   "end": 166.92,
   "text": "زبیر است. این سابقه زبیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.92,
   "end": 173.16,
   "text": "مابین آن روز و روزی که زبیر روی امیرالمؤمنین شمشیر کشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.16,
   "end": 176.58,
   "text": "فاصله بیست و پنج سال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.58,
   "end": 183.4,
   "text": "چقدر آدم عوض می‌شه. حالا برادران اهل سنت از طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.4,
   "end": 186.06,
   "text": "طلحه و زبیر عذرخواهی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.06,
   "end": 192.06,
   "text": "عذر تراشی می‌کنند یعنی. می‌گویند آنها اجتهادشان به اینجا منتهی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.06,
   "end": 197.12,
   "text": "مجتهد بودند. استنباط‌شون این بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.12,
   "end": 199.56,
   "text": "که مولا اشتباه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.56,
   "end": 201.18,
   "text": "میان اینطوری عذر تراشی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.18,
   "end": 203.2,
   "text": "خیلی خب حالا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.2,
   "end": 209.84,
   "text": "ما راجع به اینکه آنها در مقابل خدای متعال چه وضعی دارند الان در مقام آن نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.84,
   "end": 213.6,
   "text": "اما امیرالمؤمنین با این‌ها چه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.6,
   "end": 217.14,
   "text": "این نکته مهمه. امیرالمؤمنین با این‌ها چکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.14,
   "end": 221.24,
   "text": "یعنی گفتش که آقا این‌ها این س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.24,
   "end": 226.26,
   "text": "مثلاً زبیر سیف الاسلامه، پیغمبر بهش لقب سیف الاسلام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.26,
   "end": 232.0,
   "text": "طلحه چقدر در جانفشانی‌ها شرکت داشته در جنگ‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.0,
   "end": 235.22,
   "text": "این‌ها مثلاً فامیل‌های پیغمبرند، نزدیک‌اند، قوم و خویش‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.22,
   "end": 237.5,
   "text": "چه از این حرف‌ها. نه مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.5,
   "end": 242.9,
   "text": "اون قبلش رو یا مثلاً اول کسی بوده که به نفع من بلند شده جلوی خلیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.9,
   "end": 246.02,
   "text": "به ناحق اولی مثلاً ایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.02,
   "end": 248.78,
   "text": "خب بیام بهش مثلاً باج بدم چکار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.78,
   "end": 253.88,
   "text": "نه مطلقا. چه کرد واقعاً مولا باهاشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.88,
   "end": 256.64,
   "text": "اینجا رهبر می‌فرماید جنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.64,
   "end": 263.96,
   "text": "امیرالمؤمنین از مدینه لشکر کشید، رفت طرف کوفه و بصره برای جنگ با طلحه و زبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.96,
   "end": 268.04,
   "text": "یعنی آن سوابق محو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.04,
   "end": 271.66,
   "text": "تمام شد. امام ملاکش این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.66,
   "end": 274.64,
   "text": "معیارش این بود. ببین چقدر قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.64,
   "end": 277.58,
   "text": "تجزیه می‌کنه از دل تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.58,
   "end": 280.48,
   "text": "و جهت‌گیری‌های الان رو مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.48,
   "end": 284.12,
   "text": "بعد حالا چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.12,
   "end": 286.44,
   "text": "آدم‌ها بیچاره‌اند و چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.44,
   "end": 289.6,
   "text": "متأسفانه ما حواسمون پرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.6,
   "end": 294.04,
   "text": "که هر کس و ناکسی به راحتی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.04,
   "end": 296.42,
   "text": "مقام شامخ بلکه اشمخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.42,
   "end": 299.26,
   "text": "رهبر عزیزمون جسارت می‌کنه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.26,
   "end": 304.0,
   "text": "حالا میگیم بابا این یه زمانی مثلاً مسکن مهر رو راه انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.0,
   "end": 309.64,
   "text": "داره جسارت می‌کنه. باید تو دهنش زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.64,
   "end": 312.52,
   "text": "باید با افکارش جنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.52,
   "end": 314.22,
   "text": "حالا یه زمانی جو گرفته بودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.22,
   "end": 318.44,
   "text": "اومد وقتی رأی آورد رفت پیش مراجع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.44,
   "end": 321.74,
   "text": "گفت شما یه حمال معذرت می‌خوام الاغ می‌خواستید بار بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.74,
   "end": 325.72,
   "text": "بسم الله اومد. خب این اینطوریش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.72,
   "end": 331.24,
   "text": "نداشتیم نمونه‌ش. بله رهبر عزیزمون هم زمان ریاست جمهوری احمدی نژاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.24,
   "end": 333.52,
   "text": "فرمودند کمتر کسی بوده اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.52,
   "end": 337.48,
   "text": "پیام‌های امام و شعارهای زمان امام رو زنده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.48,
   "end": 341.14,
   "text": "اما الان چی؟ رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.14,
   "end": 344.96,
   "text": "دیگه اینو که همه قبول داریم که مخالفت با انتخابات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.96,
   "end": 348.44,
   "text": "هم مخالفت با جمهوری اسلامیه، هم مخالفت با اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.44,
   "end": 351.34,
   "text": "این کاملاً مشخصه. چون جمهوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.34,
   "end": 356.52,
   "text": "مخالفت با مردم. اسلام خب مخالفت با اسلامه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.52,
   "end": 358.78,
   "text": "تصریح هم که آقا نفرمود هرکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.78,
   "end": 362.4,
   "text": "مخالفت با انتخابات می‌کنه اصلاً مسلمان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.4,
   "end": 365.3,
   "text": "اون بحث‌های فقهی داره. بعد انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.3,
   "end": 368.06,
   "text": "احمق انقدر بی‌شعوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.06,
   "end": 374.64,
   "text": "خودش جرات می‌ده جسارت کنه که می‌خنده، مزخکه می‌کنه اعوذ بالله بعد می‌گه آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.64,
   "end": 378.9,
   "text": "کارشون به جایی رسیده، همین احمدی‌نژاد کارشون به جایی رسیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.9,
   "end": 381.78,
   "text": "می‌گن هرکس مخالفه، هرکس رأی نده مسلمان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.78,
   "end": 388.06,
   "text": "کی آقا همچین حرفی زد؟ در مورد مخا-- در مخالفت با اسلام قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.06,
   "end": 390.98,
   "text": "من خودم وقتی که مس-- من مسلمانم خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.98,
   "end": 393.4,
   "text": "وقتی که امر خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.4,
   "end": 396.6,
   "text": "اطاعت نمی‌کنم اینو مخالفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.6,
   "end": 401.72,
   "text": "نه اینکه مسلمان نیستم. بفهم تو اینکه شعور نداری بعد یه مشت هم اونجا نشستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.72,
   "end": 406.7,
   "text": "بعضی عجیب عمامه به سر می‌خندن دف دست می‌زنن سوت می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.7,
   "end": 409.32,
   "text": "انقدر احمقن، انقدر بی‌شعورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.32,
   "end": 415.02,
   "text": "جسارت به شما نشد. به همین راحتی هرکی بیاد هرچی می‌خواد بگه دهنشو باز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.02,
   "end": 418.06,
   "text": "یه وقت مردم عامه نفهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.06,
   "end": 420.34,
   "text": "که اصلاً تو-- هیچ‌چیو خبر ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.34,
   "end": 423.1,
   "text": "فقط شکمشونو می‌بینن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.1,
   "end": 427.34,
   "text": "جسارتاً اصلاً معیارهاشون متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.34,
   "end": 432.21,
   "text": "غربی و شرقی فکر می‌کنن اینا حالا فحشی میدن جهله بدبختیشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.21,
   "end": 435.72,
   "text": "ولی تو دیگه تویی که هرچی داری اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.72,
   "end": 439.02,
   "text": "اینکه تو رو می‌شناسن به واسطه این انقلاب شناختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.02,
   "end": 444.56,
   "text": "تو کی بودی؟ چی بودی؟ بعد بیای اینطوری جسارت کنی بعد ما هم ساکت باشیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.56,
   "end": 448.22,
   "text": "بعد جالب بعد، بعد دردمنتر اینکه درد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.22,
   "end": 451.32,
   "text": "سنگین اینه که بگیم آقا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.32,
   "end": 454.06,
   "text": "خدمت کرده مسکن مهر ساخته بخور تو سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.06,
   "end": 458.76,
   "text": "مگه خودش ساخته؟ با دارایی‌های ملت ساخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.76,
   "end": 462.88,
   "text": "با دارایی مل-- هرچی هم کرده مال اون موقع بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.88,
   "end": 467.24,
   "text": "الان چی؟ الان چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.24,
   "end": 469.82,
   "text": "بعد بگه اون مسلمانی که بله تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.82,
   "end": 473.2,
   "text": "دمشو می‌زنی مردم ما کدوم مردم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.2,
   "end": 475.76,
   "text": "اون چهار نفری که دور تو هستن مردمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.76,
   "end": 480.02,
   "text": "این‌ها این مسلمانی رو قبول ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.02,
   "end": 484.96,
   "text": "من تعجب می‌کنم بعضی از بچه انقلابی‌ها، هیئتی‌هام باز دم از این آقا می‌زنن الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.96,
   "end": 488.42,
   "text": "یا دار و دسته‌ش و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.42,
   "end": 493.88,
   "text": "بدتر از اون اینه که ما بیاییم آدمایی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.88,
   "end": 498.18,
   "text": "کسی اصلاً اینا رو آدم حساب نمی‌کردو بزرگ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.18,
   "end": 502.68,
   "text": "این خیلی درده. حالا کجا بذاره این درد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.68,
   "end": 505.0,
   "text": "بولدش کنیم برجسته‌ش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.0,
   "end": 507.06,
   "text": "مثل مثلاً رفسنجانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.06,
   "end": 510.8,
   "text": "یادتونه هنوز تو خاطر ما هست وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.8,
   "end": 514.94,
   "text": "روحانی رو ایشون مطرح کرد دیگه خودش اصلاً توی سخنرانی فیلم‌هاش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.94,
   "end": 518.02,
   "text": "می‌گه آقا شما اصلاح طلب‌ها باید به گونه‌ای باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.02,
   "end": 526.18,
   "text": "که بیاید آدم‌هایی که اِمم معرف مردم نیستن، معروف نیستن، این‌ها رو بیارید چهره‌شون کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.18,
   "end": 531.26,
   "text": "معرفی کنید، چهره‌شون کنید. مثل کاری که من با دکتر روحانی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.26,
   "end": 533.36,
   "text": "سه یا چهار درصد بیشتر رأی نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.36,
   "end": 536.68,
   "text": "من معرفیش کردم. رأیش رفت بالای پنجاه درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.68,
   "end": 540.52,
   "text": "اینو خود رفسنجانی گفت. که الان آه ملت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.52,
   "end": 542.74,
   "text": "دامن رفسنجانی رو هم قطعاً می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.74,
   "end": 545.66,
   "text": "چون اون این شخص رو بولد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.66,
   "end": 548.86,
   "text": "امثال طلحه و زبیر زمان ما همینا نیستن، همینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.86,
   "end": 551.62,
   "text": "البته اینا که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.62,
   "end": 555.12,
   "text": "پست‌تر از اونا. باز اونای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.12,
   "end": 558.88,
   "text": "گذشته و پیشینه خاصی سیف الاسلامی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.88,
   "end": 563.22,
   "text": "تو که چی داشتی آخه؟ هرچی داشتی به رأی ملت داشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.22,
   "end": 570.02,
   "text": "خیلی باید مراقب باشیم که خصوصاً الان تنور انتخابات داغه، حرف و چیزایی که می‌زنن مثلاً میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.02,
   "end": 573.56,
   "text": "برجسته‌سازی می‌کنن یه چیزایی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.56,
   "end": 576.26,
   "text": "مثلاً از زمان احمدی‌نژاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.26,
   "end": 579.32,
   "text": "که اون کسی که مورد تأیید ایشونه بیاد یا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.32,
   "end": 585.52,
   "text": "طرف مثلاً آقای روحانی کسی که مورد تأیید ایشون بیاد یا امثال کسایی که تو مجلسن یا هر جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.52,
   "end": 588.12,
   "text": "ملاک این خیلی مهمه حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.12,
   "end": 590.18,
   "text": "ملاک حال فعلی افراده یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.18,
   "end": 592.72,
   "text": "دو کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.72,
   "end": 601.98,
   "text": "اِمم کاملاً چرخش می‌کنه از ارزش‌ها، از ارزش‌های انقلاب چرخش می‌کنه، کاملاً متضاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 601.98,
   "end": 604.3,
   "text": "مولا با چنین کسایی جنگیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 604.3,
   "end": 608.24,
   "text": "حالا ما بگیم چون خدمت داشتن چیزی نگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 608.24,
   "end": 612.08,
   "text": "امیر المؤمنین جلوشون وایساده جنگیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 612.08,
   "end": 615.08,
   "text": "باید زد تو دهانشون تا اونجایی که می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 615.08,
   "end": 621.8,
   "text": "اگر تریبون نداریم، کانالی نداریم، مجلسی نداریم، جایی رو نداریم، مقاله‌ای نمی‌نویسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.8,
   "end": 626.0,
   "text": "حداقل برای فامیلامون، خونواده‌مون، بچه‌های خودمون اینا رو توجیه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.0,
   "end": 628.56,
   "text": "اینا اصول انقلاب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.56,
   "end": 633.0,
   "text": "اصول و امنه‌هاتن. اگر از اینا عدول کنیم دیگه چی می‌مونه برای ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 633.0,
   "end": 636.32,
   "text": "واری به هر جهت. ان‌شاءالله که عاقبت مختومه بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 636.32,
   "end": 639.44,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.44,
   "end": 643.56,
   "text": "اللهُمَ صَلِّ عَلَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 643.56,
