 "chapters": [
  {
   "index": 0,
   "title": "## جنبش دانشگاه‌های آمریکا و نامهٔ رهبر به جوانان غرب",
   "start": 0.86,
   "end": 85.58
  },
  {
   "index": 1,
   "title": "## یهودیان اسرائیل و پلاکارد خطاب به رهبر ایران",
   "start": 85.58,
   "end": 138.34
  },
  {
   "index": 2,
   "title": "## پنجاه‌هزار دانشجو و وعدهٔ صادقِ قرآن",
   "start": 138.34,
   "end": 158.4
  },
  {
   "index": 3,
   "title": "## سلبریتی‌های داخلی و چهارهزار خانهٔ تیمی",
   "start": 158.4,
   "end": 434.38
  },
  {
   "index": 4,
   "title": "## علامه حسن‌زاده؛ با ناموس خدا نجنگید",
   "start": 434.38,
   "end": 510.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 4.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.06,
   "end": 9.42,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.42,
   "end": 12.78,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.78,
   "end": 20.04,
   "text": "کی فکرشو میکرد که بیش از دویست دانشگاه در آمریکا این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.04,
   "end": 23.12,
   "text": "به هم بریزه و بشه محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.12,
   "end": 30.34,
   "text": "اعتراض در خصوص کشت و کشتاری که در فلسطین داره اتفاق میافته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.34,
   "end": 36.76,
   "text": "واقعا کی فکرشو میکرد؟ اون زمانی که رهبر عزیزمون نامه نوشتن به جوانان غرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.76,
   "end": 40.4,
   "text": "یه مشت آدم‌های معذرت می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.4,
   "end": 44.34,
   "text": "نفهم بی‌شعور این سلبریتی‌ها اینها چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.34,
   "end": 46.8,
   "text": "مسخره کردن دهن کجی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.8,
   "end": 51.76,
   "text": "الان می‌بینیم که خیلیاشون تو توئیت‌هایی که می‌زنن همون جوون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.76,
   "end": 56.86,
   "text": "اعلام می‌کنن که ما تازه داریم می‌فهمیم که رهبر ایران چی گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.86,
   "end": 61.5,
   "text": "و چی می‌گفت. و این خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.5,
   "end": 66.12,
   "text": "یعنی خودشون دارن تو درون خودشون دچار یک تجزیه‌ای میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.12,
   "end": 68.84,
   "text": "کم نیست دویست تا دانشگاه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.84,
   "end": 72.96,
   "text": "فیلم‌هایی که داره میاد بیرون تو فضای مجازی دارید می‌بینید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.96,
   "end": 76.0,
   "text": "کی فکرشو می‌کرد واقعا که جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.0,
   "end": 83.38,
   "text": "کاخ سفید پن-- حدود حداقل پنج هزار نفر نماز جماعت بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.38,
   "end": 86.46,
   "text": "بعدش هم پلاکاردهای حمایت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.46,
   "end": 90.38,
   "text": "مردم مظلوم غزه و فلسطین بلند کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.38,
   "end": 98.52,
   "text": "حالا کلیدش کجا، جرقهش کجا خورد که رئیس نمایندگان مجلس آمریکا اومد دانشگاه کلمبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.52,
   "end": 102.74,
   "text": "به خیال خودش که مثلا بین دانشجوها و اساتید شروع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.74,
   "end": 105.54,
   "text": "از رژیم صهیونیستی دفاع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.54,
   "end": 108.36,
   "text": "بعد از عملیات وعده صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.36,
   "end": 111.5,
   "text": "به محض اینکه شروع می‌کنه سخنرانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.5,
   "end": 116.52,
   "text": "یه دانشجویی با جسارت پا می‌شه و رو به روی جمعیت پشت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.52,
   "end": 119.9,
   "text": "ایشون وایمیسته و پرچم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.9,
   "end": 123.54,
   "text": "فلسطین رو باز می‌کنه و وایمیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.54,
   "end": 127.4,
   "text": "اونا میان مثلا جلوشو بگیرن، دانشجوی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.4,
   "end": 130.68,
   "text": "خلاصه ضرب و شتم صورت می‌گیره و میان وسط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.68,
   "end": 136.86,
   "text": "از اینجا جرقهش می‌خوره که تا حالا بیش از پونصد نفر رو اینا چیکار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.86,
   "end": 139.66,
   "text": "گرفتن با ضرب و شتم و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.66,
   "end": 143.3,
   "text": "حالا تو ایران از گل نازک‌تر به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.3,
   "end": 147.78,
   "text": "دانشجویی اگر نیروهای امنیتی می‌گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.78,
   "end": 149.46,
   "text": "چقدر تو بوق و کرناش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.46,
   "end": 157.48,
   "text": "الان دارید می‌بینید دیگه فیلم‌هاشو که چه زد و خوردی حتی با کسایی که خبرنگارن دارن این صحنه رو فیلم می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.48,
   "end": 160.32,
   "text": "چه زد و خوردهای وحشتناکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.32,
   "end": 166.56,
   "text": "حتی بعضی از اساتید دانشگاه‌هاشون هم به اون‌ها هم رحم نکردن، به آقازاده‌هاشون هم رحم نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.56,
   "end": 172.54,
   "text": "و جالبه مادر یکی از همین دانشجوها که از دانشگاه کلمبیا دستگیرش کردن بردن، مادرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.54,
   "end": 176.52,
   "text": "خودش جزو مسئولین تراز بالاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.52,
   "end": 180.12,
   "text": "اعلام کرد که من افتخار می‌کنم که پسرم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.12,
   "end": 184.28,
   "text": "به خاطر حمایت از مردم مظلوم غزه گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.28,
   "end": 190.38,
   "text": "این شما دقت کنید از درون داره یه فروپاشی عجیبی تو آمریکا رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.38,
   "end": 196.38,
   "text": "و از اون طرف هم که یهودی‌ها راهپیمایی کردن چند روز پیش جالبه که خیلی شیرینه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.38,
   "end": 199.84,
   "text": "پلاکاردی که بلند کردن عکس ام-- رهبر روشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.84,
   "end": 204.22,
   "text": "یهودی‌های داخل اسرائیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.22,
   "end": 211.66,
   "text": "اعلام کردن که خطاب به رهبر ایران که بیا ما رو در، از دست نتانیاهو نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.66,
   "end": 214.66,
   "text": "شما ببینید چه اتفاقات عجیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.66,
   "end": 217.94,
   "text": "واقعا عجیب. من این، اینطوری به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.94,
   "end": 220.74,
   "text": "ااا تا پیش، من خودم به شخصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.74,
   "end": 224.82,
   "text": "تا پیش از این آرزوی شهادت و اینها رو هنوز هم داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.82,
   "end": 227.88,
   "text": "داریم یعنی آرزوی شهادت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.88,
   "end": 232.96,
   "text": "شبانه روز آرزو داشتیم که زودتر به رفیقای شهیدمون بپیوندیم و بریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.96,
   "end": 236.6,
   "text": "الان این اتفاقات عجیب و غریب رو که داریم می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.6,
   "end": 240.84,
   "text": "میگیم خدایا ما رو بذار حبیب من مذاهب بشین در بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.84,
   "end": 244.5,
   "text": "خیلی شیرین داره میشه. بذار ببینیم واقعا ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.5,
   "end": 249.1,
   "text": "کی فکر می‌کرد. چقدر ما آرزو داشتیم مستقیم بزنیم اسرائیل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.1,
   "end": 257.54,
   "text": "زدیم. اینا آرزوهای ما بوده و این اتفاقاتی که داره رخ میده کم نیست پونصد حداقل خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.54,
   "end": 261.32,
   "text": "اعلام کردن بیش از پونصد دانشگاه رو که با ضرب و شتم گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.32,
   "end": 265.34,
   "text": "پنجاه هزار دانشجو به این جنبش پیوستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.34,
   "end": 270.56,
   "text": "پنجاه هزار دانشجو کم نیست ها تو آمریکا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.56,
   "end": 274.48,
   "text": "یعنی اگر شما مثلا پنجاه تا ایالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.48,
   "end": 278.74,
   "text": "داشته باشه آمریکا بگیم هر دانشگاه توی ایالت سه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.74,
   "end": 282.42,
   "text": "بفرض الهر دانشگاهی توی ایالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.42,
   "end": 285.6,
   "text": "پنجاه هزار دانش-- یعنی از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.6,
   "end": 290.82,
   "text": "ایالتی از هر دانشگاهی در هر ایالت هزار تا دانشجو بلند شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.82,
   "end": 298.52,
   "text": "شوخی نیست. این‌ها تازه اونایی‌ان که شروع کردن بعد بهشون می‌پیوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.52,
   "end": 301.06,
   "text": "این‌ها وعده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.06,
   "end": 304.22,
   "text": "صادقی که قرآن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.22,
   "end": 309.3,
   "text": "خودشو به بهترین وجه ممکن داره نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.3,
   "end": 311.68,
   "text": "انشاالله یه عزیزی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.68,
   "end": 317.78,
   "text": "چند سال پیش که رهبر عزیزمون مژده فروپاشی از درون آمریکا رو داد، می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 317.78,
   "end": 321.32,
   "text": "پنجاه تا ایالتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.32,
   "end": 326.58,
   "text": "اینا وقتی اعلام استقلال کنن میشه پنجاه تا کشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.58,
   "end": 330.72,
   "text": "پنجاه تا کشور می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.72,
   "end": 335.46,
   "text": "پنجاه تا نماینده داشته باشه در خدمت اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.46,
   "end": 337.58,
   "text": "پنجاه تا نماینده در خدمت جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.58,
   "end": 341.5,
   "text": "انگار کردن از ژانویه بیست، بیست و پنج بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.5,
   "end": 345.16,
   "text": "خیلیاشون که با خیلی قشنگ علنا گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.16,
   "end": 349.92,
   "text": "ما ساعت و تاریخشم حتی روزشم مشخص کردن ژانویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.92,
   "end": 352.64,
   "text": "گفتن که اعلام استقلال می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.64,
   "end": 354.46,
   "text": "حالا اینا از درون ترسیدن و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.46,
   "end": 360.8,
   "text": "بعد از اون طرف هم که خب عملیات وعده صادق یه بلایی سر اسرائیل آورد که سر اقتصادش، سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.8,
   "end": 363.84,
   "text": "سیاست خارجیش، آبرو و حیثیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.84,
   "end": 366.58,
   "text": "و از این طرف این رو حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.58,
   "end": 371.88,
   "text": "اون‌ها چون می‌بینن که طرف نظام رو نمی‌تونن بشن دوباره میرن سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.88,
   "end": 375.28,
   "text": "این سلبریتی‌های دوزاری داخلی و دست نشانده‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.28,
   "end": 377.76,
   "text": "حالا از هر دویست تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.76,
   "end": 383.58,
   "text": "دویست حالا بگیم دویست نفری که تو خونه‌های تیمی حدود چهار هزار خونه تیمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.58,
   "end": 387.04,
   "text": "توی آخرین اغتشاشات گرفتن بیش از چهار هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.04,
   "end": 390.64,
   "text": "خونه تیمی که هر خونه تیمی دویست نفر تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.64,
   "end": 393.98,
   "text": "نظارتشون بود، پنج تاشون خارج از کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.98,
   "end": 396.74,
   "text": "تعلیم دیدن. رفتن اونجا پول گرفتن تعلیم دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.74,
   "end": 400.12,
   "text": "این پنج تا، پنج تا، پنج تا اینکه یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.12,
   "end": 402.88,
   "text": "برچیده شدن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.88,
   "end": 407.88,
   "text": "اعتراضات خیابانیه به قول خودشون حالا اغتشاشات به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.88,
   "end": 410.6,
   "text": "طول کشید برای اینکه بتونن این‌ها رو شناسایی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.6,
   "end": 413.46,
   "text": "الحمد لله اون پنج تا، پنج تاها رو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.46,
   "end": 419.24,
   "text": "در هر چهار هزار خونه‌ی تیمی اینو آموزش داده بودن ولی خب دوباره شاخک‌هاشون تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.24,
   "end": 424.06,
   "text": "کارشون اینه که بیان از درون دوباره با قصه‌ی حجاب وارد بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.06,
   "end": 428.32,
   "text": "دخترک‌های ما هم که طفل معصوم بی‌خبر نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.32,
   "end": 432.84,
   "text": "دختران پاک و معصوم ما هم گرفتار این دام می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.84,
   "end": 439.38,
   "text": "من گفتم عزیزان یه کلیپ خیلی کوتاه از رح-- از، از حضرت علامه حسن زاده تو کانال گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.38,
   "end": 442.24,
   "text": "امروز که خیلی ایشون صراحتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.24,
   "end": 449.62,
   "text": "می‌فرماید که اون بیچاره اون زنی که می‌خواد با یه چادر سر کردن به جنگ با خدا بره، آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.62,
   "end": 452.44,
   "text": "مردم بدونید فرمایش علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.44,
   "end": 455.82,
   "text": "می‌فرماید با ناموس خدا نجنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 455.82,
   "end": 458.7,
   "text": "دین خدا ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.7,
   "end": 460.72,
   "text": "کسی که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 460.72,
   "end": 467.66,
   "text": "و می‌خواد با چادر، با حجاب، با عفاف اینا بجنگه با دین خدا داره می‌جنگه و دین خدا هم ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.66,
   "end": 470.58,
   "text": "جنگ با ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.58,
   "end": 477.22,
   "text": "اگر کسی بیاد این کلام آخر منم دقت کنیم همه اگر کسی بیاد با ناموس ما بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.22,
   "end": 481.54,
   "text": "بجنگه، دربیفته با ناموس ما چگونه رفتار می‌کنیم باهاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.54,
   "end": 486.26,
   "text": "حواسمون هست علامه داره شاخک‌های ما رو تیز می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 486.26,
   "end": 489.54,
   "text": "این جنگ با ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.54,
   "end": 491.7,
   "text": "از توسط کی داره صورت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 491.7,
   "end": 497.04,
   "text": "تمام از خارج از کشور تامین می‌شن از نابشون این‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 497.04,
   "end": 499.9,
   "text": "طرحشون خلاصه اینه. خیلی باید مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 499.9,
   "end": 505.42,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.42,
   "end": 510.36,
   "text": "الله الله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}