 "chapters": [
  {
   "index": 0,
   "title": "## مبانی قرآنی دست برتر اهل ایمان",
   "start": 12.02,
   "end": 106.02
  },
  {
   "index": 1,
   "title": "## واقع‌بینی؛ دشمن را کوچک نشمردن",
   "start": 106.02,
   "end": 222.86
  },
  {
   "index": 2,
   "title": "## بازتاب جهانی وعده‌ی صادق",
   "start": 222.86,
   "end": 370.24
  },
  {
   "index": 3,
   "title": "## ریزپرنده‌های اصفهان و انحراف افکار عمومی",
   "start": 370.24,
   "end": 963.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.88,
   "end": 4.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 7.32,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.32,
   "end": 10.26,
   "text": "و ربانی ایه آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.26,
   "end": 12.02,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.02,
   "end": 15.92,
   "text": "برای اینکه یک موضوع مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.92,
   "end": 20.96,
   "text": "سیاسی اجتماعی رو بیان کنم ابتدا تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.96,
   "end": 26.24,
   "text": "توسل می‌کنم به یک آیه یکی دو تا از آیات قرآن و فرمایش بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.24,
   "end": 31.68,
   "text": "در آیه صد و یازده سوره آل عمران می‌خونیم \"لا یضرکم إلا أذى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.68,
   "end": 35.62,
   "text": "و إن یقاتلوکم یولوکم الأدبار ثم لا ینصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.62,
   "end": 38.36,
   "text": "در خصوص اهل کتاب خاصه یهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.36,
   "end": 44.6,
   "text": "حضرت حق در قرآن می‌فرماید هرگز نمی‌تونند به شما زیان برسانند جز آزار‌های مختصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.6,
   "end": 48.08,
   "text": "و اگر با شما پی-- پیکار کنند به جنگند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.08,
   "end": 51.12,
   "text": "به شما پشت می‌کنند یعنی شکست می‌خورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.12,
   "end": 53.14,
   "text": "سپس کسی اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.14,
   "end": 56.1,
   "text": "لا ینصرون یاری نمی‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.1,
   "end": 64.84,
   "text": "آیه دیگه در دو مرتبه سوره آل عمران آیه صد و سی و نه می‌فرماید \"ولا تحنوا\" سست نشید \"ولا تحزنوا\" محزون نشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.84,
   "end": 71.62,
   "text": "\"وأنتم الأعلون\" شما دست برتر دارید شما بالاترید \"إن کنتم مؤمنین\" البته اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.62,
   "end": 76.1,
   "text": "اهل ایمان باشید. خب این‌ها داره تصریح می‌کنه بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.1,
   "end": 78.94,
   "text": "بر اینکه الحمد لله به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.94,
   "end": 84.8,
   "text": "اون حمایت‌های الهی از اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.8,
   "end": 87.92,
   "text": "قطعا دست برتر با اهل ایمانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 90.14,
   "text": "با انقلابی‌هاست، با مقاومت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.14,
   "end": 95.3,
   "text": "حتی امام علیه الرحمه می‌فرمودند که از هیچکس از این قدرت‌ها نترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.3,
   "end": 98.92,
   "text": "این‌ها هیاهوشون بیشتر از خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.92,
   "end": 106.02,
   "text": "که خب این‌ها همه درست همه این‌ها صحیح، این‌ها مبانی‌اند، نص صریح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.02,
   "end": 111.74,
   "text": "اما نکته‌ای که میخوام عرض کنم اینه، اونم اینکه این‌ها نباید باعث بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.74,
   "end": 117.08,
   "text": "ما دشمن رو کمتر از اون چیزی که هست فرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.08,
   "end": 120.22,
   "text": "ما باید واقع‌بین باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.22,
   "end": 123.46,
   "text": "متاسفانه حتی در بحث اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.46,
   "end": 127.94,
   "text": "وعده صادق که به هر حال ضربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.94,
   "end": 131.56,
   "text": "نفس‌گیری رو به اسرائیل زد و دنیا رو متحول--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.56,
   "end": 134.06,
   "text": "واقعا نگاه دنیا رو به ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.06,
   "end": 139.94,
   "text": "عوض کرد، به اندازه بعضیا حتی گفتند که به اندازه هشت سال دفاع مقدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.94,
   "end": 145.84,
   "text": "آبروی دشمن رو برد. همه این‌ها درست اما بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.84,
   "end": 148.18,
   "text": "یه طوری وانمود کردن که اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.18,
   "end": 152.26,
   "text": "مثلا دشمن ما انقدر ذلیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.26,
   "end": 155.64,
   "text": "بدون محاسبه و بدون ابزار آلات جنگی و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.64,
   "end": 157.76,
   "text": "نه اینطوری نیست. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.76,
   "end": 166.0,
   "text": "مثلا شما برای اینکه یک گوشه‌ای از این جلوه و اقتدار رو بیان کنید باید مثلا همون سه، سه لایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.0,
   "end": 170.22,
   "text": "گنبد آهنین و نمی‌دونم پیکان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.22,
   "end": 172.74,
   "text": "فلاخن داوود و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.74,
   "end": 174.8,
   "text": "باز کنید برای مخاطب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.8,
   "end": 177.32,
   "text": "برای مردم، برای افکار عمومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.32,
   "end": 180.56,
   "text": "ببینید چه جنگ‌افزارهایی داشتند، چه چیزهایی داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.56,
   "end": 186.04,
   "text": "بعد چقدر زیبا با این طراحی عجیب و غریبی که سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.04,
   "end": 188.8,
   "text": "انجام داد تونست اون‌ها رو فریب بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.8,
   "end": 190.7,
   "text": "و خلع سلاحشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.7,
   "end": 192.62,
   "text": "بله، دست برتر با ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.62,
   "end": 197.02,
   "text": "ایران قدرتمندانه وارد میشه و اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.02,
   "end": 200.76,
   "text": "سر جاشون می‌نشونه طوری که همه مات و مبهوت می‌بینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.76,
   "end": 205.22,
   "text": "می‌مونن. اما این دلیل بر این نیست که دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.22,
   "end": 208.42,
   "text": "ضعی-- خیلی ضعیفه و اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.42,
   "end": 211.46,
   "text": "ابزار آلاتی نداره که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.46,
   "end": 219.5,
   "text": "در حقیقت این سیلی محکمی یا به قول رهبر عزیزمون تنبیه جانانه‌ای که صورت گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.5,
   "end": 221.88,
   "text": "یه چیز مثلا عادی جلوه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.88,
   "end": 226.96,
   "text": "نه. اتفاقا بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.96,
   "end": 234.6,
   "text": "عرض شود خدمتتون اون جهت‌گیری‌هایی که بعد از وعده صادق داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.6,
   "end": 239.04,
   "text": "یعنی وقتی شما تحلیل‌ها رو نگاه می‌کنی می‌بینی یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.04,
   "end": 241.6,
   "text": "بعد جهانی پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.6,
   "end": 247.38,
   "text": "یعنی مثلا رویکرد جوامع اسلامی به عملی بودن نظریه امام خمینی مبنی بر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.38,
   "end": 249.96,
   "text": "لزوم محو اسرائیل. این دوباره شو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.96,
   "end": 252.3,
   "text": "صورت گرفت، دوباره شکل گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.3,
   "end": 258.86,
   "text": "دوباره احیا شد. فروپاشی افسانه شکست‌ناپذیری اسرائیل صورت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.86,
   "end": 261.78,
   "text": "افزایش جرأت حمله به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.78,
   "end": 263.98,
   "text": "این رژیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.98,
   "end": 269.58,
   "text": "منحوس بین گروه‌های جوا-- جهادی به شدت سرعت و شدت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.58,
   "end": 275.54,
   "text": "اصلا تحقیر بی‌سابقه اسرائیل و هم‌پیمانانش در سطح جهان صورت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.54,
   "end": 278.72,
   "text": "تثبیت ایران به عنوان یک قدرت جهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.72,
   "end": 283.84,
   "text": "اتفاق افتاد. این‌ها رو شما وقتی می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.84,
   "end": 289.6,
   "text": "در کنار دیدن توانمندی‌های نظامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.6,
   "end": 294.04,
   "text": "و عرض شود تجهیزات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.04,
   "end": 297.0,
   "text": "پیشرفته دشمن، این‌ها قشنگ‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.0,
   "end": 298.74,
   "text": "نه اینکه بگیم وا، وا اونا چی بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.74,
   "end": 302.34,
   "text": "حالا من الان عرض می‌کنم چرا اینطوری دارم صحبت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.34,
   "end": 305.62,
   "text": "یا مثلا لری جانسون تحلیلگر سابق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.62,
   "end": 309.74,
   "text": "سازمان سیا یه جمله خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.74,
   "end": 313.14,
   "text": "جالب میگه که در این زمان از زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.14,
   "end": 316.32,
   "text": "مورد اصابت موشک‌ها بسیار مهم‌تر می‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.32,
   "end": 319.84,
   "text": "یعنی میگه هیچ چیزی الان مهم‌تر از این موضوع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.84,
   "end": 323.62,
   "text": "یعنی کم و نه یک پدیده رخ داده، یک چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.62,
   "end": 325.64,
   "text": "خارق‌العاده اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.64,
   "end": 333.98,
   "text": "مثلا جورج گالووی نماینده پارلمان انگلیس میگه نتانیاهو مثل موش در پناهگاه خزیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.98,
   "end": 337.14,
   "text": "مثلا روزنامه اسرائیلی معاریو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.14,
   "end": 342.08,
   "text": "که می‌دونید پرخوننده‌ترین روزنامه عصر اسرائیلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.08,
   "end": 350.18,
   "text": "میگه مشخص-- نوشته اینو مشخص گردید که بزرگ‌ترین سلاح موجود در زرادخانه ایرانی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.18,
   "end": 355.16,
   "text": "ایجاد بلاتکلیفی و اضطراب در بین مردم اسرائیل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.16,
   "end": 363.9,
   "text": "و همینطور ادامه میده تا میگه و اون‌ها اکنون گفتمان ما را کنترل و الگوهای رفتاری ما را تغییر می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.9,
   "end": 370.24,
   "text": "شما ببینید اینها بله تا دلت بخواد الا ماشاالله از این بازخوردهام بود بعد از وعده صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.24,
   "end": 373.78,
   "text": "اما اخیراً با اتفاقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.78,
   "end": 376.5,
   "text": "در خ- اصفهان با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.5,
   "end": 380.32,
   "text": "حالا اون چند تا ریزپرنده و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.32,
   "end": 387.58,
   "text": "و حتی چند تا مثلاً یه لاشه موشک یا دو سه تا برخورد موشک در، در عراق رخ داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.58,
   "end": 391.56,
   "text": "متأسفانه انحراف افکار عمومی صورت گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.56,
   "end": 394.02,
   "text": "که خیلی‌ها به این توجه نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.02,
   "end": 396.12,
   "text": "فضاهای مجازی پر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.12,
   "end": 400.14,
   "text": "حالا که آره حمله اسرائیل به ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.14,
   "end": 404.76,
   "text": "البته حالا اینکه دارم عرض می‌کنم اگرچه بعضیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.76,
   "end": 410.22,
   "text": "بعداً توئیتشونو یا خبرشونو حذف کردن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.22,
   "end": 414.14,
   "text": "مثلاً اظهار حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.14,
   "end": 419.34,
   "text": "ندامت کردن در این خصوص بعضیا یا مثلاً خبرنگار اسرائیلی که مدعی حمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.34,
   "end": 423.58,
   "text": "نیروی هوایی اسرائیل به هفت شهر ایران شده بود، توئیت خودشو حذف کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.58,
   "end": 430.88,
   "text": "و امثالهم. اما بعضیاشون هنوز دارن جنگ روانی رو ادامه میدن و ما هم متوجه نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.88,
   "end": 436.24,
   "text": "خیلی معدود من دیدم بازم ماشاالله به دلاورمردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.24,
   "end": 438.4,
   "text": "سپاه که مثلاً سردار استکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.4,
   "end": 443.3,
   "text": "فرمانده قرارگاه منطقه‌ای سیدالشهدا نیروی زمینی سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.3,
   "end": 450.2,
   "text": "، جالب بود دیدم که سریع عکس‌العمل نشون داد و فرمود حادثه صبح امروز تو اصفهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.2,
   "end": 452.2,
   "text": "بیشتر یک عملیات روانی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.2,
   "end": 455.88,
   "text": "ببینید عملیات روانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 455.88,
   "end": 459.9,
   "text": "چرا عملیات روانی؟ حالا شما دقت می‌کنی میبینی آقا چه عملیات روانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.9,
   "end": 464.24,
   "text": "بین خودشون درگیری شده، دعوا شده، نزاع شده، افتادن به جون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.24,
   "end": 469.56,
   "text": "بله، این هست. میگه عدو شود سبب خیر اگر خدا خواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 469.56,
   "end": 476.5,
   "text": "اما این خودش یک سناریوعه عزیزان، این رو میخوام، میخوام عرض کنم که توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.5,
   "end": 480.98,
   "text": "ببینید لیبرمن، وزیر جنگ سابق رژیم صهیونیستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.98,
   "end": 485.46,
   "text": "با انتقاد شدید از کابینه جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.46,
   "end": 489.46,
   "text": "خواستار استعفای همه اعضای کابینه جنگ رژیم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.46,
   "end": 494.98,
   "text": "و گفت ما در مسیر پیروزی قرار نداریم، بلکه در مسیر ننگ و آر گام برمی‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 494.98,
   "end": 501.62,
   "text": "اولاً این د-- پیامد بعدی وعده صادقه، نه این چند تا ریزپرنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.62,
   "end": 504.02,
   "text": "حالا بعضیا آوردن ربطش دادن به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.02,
   "end": 506.62,
   "text": "یا خود لاپید، رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.62,
   "end": 508.76,
   "text": "مخالفان نتانیاهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 508.76,
   "end": 511.52,
   "text": "میگه اون جمله‌ای که بن‌گویر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.52,
   "end": 516.06,
   "text": "با یه توئیت میزنه که مسخره، می‌نویسه مسخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 516.06,
   "end": 519.92,
   "text": "این طعنه بن‌گویر، وزیر امنیت داخلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 519.92,
   "end": 524.6,
   "text": "رژیم صهیونیستی تو حساب کاربری خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.6,
   "end": 528.1,
   "text": "، در واکنش به گزارش‌های رسانه‌های غربی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.1,
   "end": 531.98,
   "text": "حالا پیرامون مثلاً پاسخ اسرائیل به عملیات ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.98,
   "end": 535.74,
   "text": "با یک کلمه نوشت مسخره. خب این هزار و یک معنی می‌تونه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.74,
   "end": 538.12,
   "text": "یعنی خودش می‌تونه عملیات روانی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.12,
   "end": 544.6,
   "text": "بعد بعضیا اومدن همین رو اینچنین بیان کردن که یعنی خود لاپید که مخالف نتانیاهوعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.6,
   "end": 550.0,
   "text": "که مثلاً میگه این توئیت یه کلمه، یه کلمه‌ای بود که ما رو تو دنیا مزخکه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.0,
   "end": 552.6,
   "text": "اینا دعوای بین خودشون و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 552.6,
   "end": 559.16,
   "text": "اما واقعاً شما فکر می‌کنید کسی که الان وزیر امنیت داخلی رژیم صهیونیستیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 559.16,
   "end": 563.74,
   "text": "این میاد این حرکت اسرائیل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.74,
   "end": 566.08,
   "text": "پاسخ به ایران وانمود کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 566.08,
   "end": 572.12,
   "text": "بعدم بنویسه مسخره؟ وقتی شما دقت می‌کنی به لایه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 572.12,
   "end": 576.2,
   "text": "و ترازهای آدم‌هایی که دارن این حرفا رو می‌زنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 576.2,
   "end": 580.86,
   "text": "متوجه میشید که یک قصه‌ای پشت، یه ماجرایی پشت پرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 580.86,
   "end": 583.84,
   "text": "اون موشک‌هایی هم که حالا نشون دادن عکساشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 583.84,
   "end": 588.1,
   "text": "تو کانال‌های مختلف دیدیم که مثلاً لاشه موشک افتاده تو عراق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 588.1,
   "end": 590.5,
   "text": "گفتن اینا قرار بوده به ایران زده بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 590.5,
   "end": 595.6,
   "text": "پدافند عراق زدش. بابا همین امروز خود عراق چرا بندر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 595.6,
   "end": 599.56,
   "text": "ایلات رو زد؟ اعلام کرد که حشد شعبی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 599.56,
   "end": 602.46,
   "text": "زدن، اسرائیلی‌ها زدن، ما هم جواب دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.46,
   "end": 606.44,
   "text": "ادامه بدید ما هم با مثلاً آتش سهمگین‌تری جواب میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 606.44,
   "end": 613.82,
   "text": "اونا قصدشون زدن حشد شعبی و عراق بود، حالا دو سه تا-- یعنی واقعاً اسرائیل میاد بعد از اون حمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 613.82,
   "end": 617.32,
   "text": "عجیب و غریب و مقتدرانه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 617.32,
   "end": 621.96,
   "text": "، صدها موشک و پهپاد بیاد سه تا دونه موشک بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 621.96,
   "end": 626.76,
   "text": "و سه تا دونه ریزپرنده بفرسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 626.76,
   "end": 630.96,
   "text": "که اون مردک خبیث مراد ویسی هست، کارشناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 630.96,
   "end": 638.7,
   "text": "ضد ایرانی اینترنشنال ، جسارتاً مردم رو چیز گیر آورده، بر می‌گرده میگه حمله با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 638.7,
   "end": 643.48,
   "text": "ریزپرنده‌های پیتزا بر، دقیقاً این عبارتیه که ایشون گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 643.48,
   "end": 646.96,
   "text": "اون چیزی نبود که ما از اسرائیل انتظار داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 646.96,
   "end": 653.58,
   "text": "فکر می‌کنه مردم ایران یا مثلاً سرداران سپاه ما، تروریست‌های نظامی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 653.58,
   "end": 658.12,
   "text": "اینها انقدر کوته فکرن که این رو پاسخ اسرائیل بدونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 658.12,
   "end": 661.24,
   "text": "که چی بشه؟ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 661.24,
   "end": 663.8,
   "text": "گارد ایران باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 663.8,
   "end": 668.68,
   "text": "یعنی ایران در حقیقت بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 668.68,
   "end": 672.98,
   "text": "از اون دیوار دفاعی بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 672.98,
   "end": 679.02,
   "text": "شما ببینید وقتی تو کانال دوازده تلویزیون رژیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 679.02,
   "end": 688.9,
   "text": "اسرائیل میگن که برآورد‌های ارتش و نیروهای امنیتی این رژیم اینه که حمله به ایران پایان یافته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 688.9,
   "end": 693.64,
   "text": "یا مقامات اسرائیلی بلندپایه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 693.64,
   "end": 702.3,
   "text": "میگن که نمایش تمسخرآمیز ریزپرنده‌ها رو پایان حمله به ایران اعلام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 702.3,
   "end": 705.44,
   "text": "یعنی واقعاً شما فکر می‌کنید اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 705.44,
   "end": 710.58,
   "text": "یعنی در اون سطح وقتی دقت می‌کنیم واقعاً این حمله اسرائیل به ایران بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 710.58,
   "end": 714.2,
   "text": "که اینا دارن تو اذهان اینچنین جا می‌ندازن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 714.2,
   "end": 718.18,
   "text": "میکی لوی، رئیس سابق و عضو فعلی پارلمان لژ- رژیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 718.18,
   "end": 722.56,
   "text": "خطاب به بن‌گویر تبریک میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 722.56,
   "end": 724.34,
   "text": "این تبریکش برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 724.34,
   "end": 732.2,
   "text": "میگه شما تونستی تمام دوران حضور خودتون تو مسئولیت وزارت شکست ملی و عضویت تو کابینه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 732.2,
   "end": 736.14,
   "text": "رو با یک کلمه توصیف کنید، الان همون مسخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 736.14,
   "end": 741.28,
   "text": "اینا یه به نظر میرسه خطی که الان از اذیتتون نکنم یک بازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 741.28,
   "end": 747.52,
   "text": "رسانه‌ایه سطح بین‌المللیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 747.52,
   "end": 751.14,
   "text": ". در حقیقت بازی با افکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 751.14,
   "end": 758.18,
   "text": "عمومی و همون انحراف افکار عمومی و عملیات روانیه که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 758.18,
   "end": 760.98,
   "text": "تموم شد. اسرائیل همین بود و تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 760.98,
   "end": 767.18,
   "text": "یه سه تا ریزپرنده فرستاد و سه تا هم موشک و اینا به هدف نرسید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 767.18,
   "end": 769.68,
   "text": "و حالا تموم شد. بعد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 769.68,
   "end": 774.94,
   "text": "ببینید که شروع میکنه از اون طرف وقتی این افکار مسموم رو پخش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 774.94,
   "end": 778.92,
   "text": "از اون طرف شروع میکنه اولاً تخلیه اطلاعاتی آدم‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 778.92,
   "end": 781.84,
   "text": "اطلاعاتی در خود کشور ما دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 781.84,
   "end": 786.52,
   "text": "نزدیک کنه خودشو به اونها. از اون طرف شروع میکنه آشوب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 786.52,
   "end": 790.26,
   "text": "مه-- جاهای خیلی مهم و مراکز بسیار مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.26,
   "end": 792.98,
   "text": "مخصوصاً تو پایتخت. از اون طرف شروع میکنه خونی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 792.98,
   "end": 795.74,
   "text": "خونه‌های تیمیشو دوباره راه‌اندازی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 795.74,
   "end": 801.0,
   "text": "از اون طرف شروع میکنه دوباره ترور شخصیت‌های ما، چه نظامی، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 801.0,
   "end": 803.82,
   "text": "علمی، دانشمندای ما و غیر و غیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 803.82,
   "end": 806.64,
   "text": "بعد اینها رو افکار عمومی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 806.64,
   "end": 810.62,
   "text": "از اون سمت بالا مثلاً پاسخ اسرائیل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 810.62,
   "end": 815.58,
   "text": "ایران منحرف کرد، بعد آماده میشه برای مثلاً یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 815.58,
   "end": 821.06,
   "text": "ضربه‌ای به ایران و ایران هم از اون حالت مثلاً دفاعی، افکار عمومی خیلی اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 821.06,
   "end": 825.04,
   "text": "مهمن که فاصله گرفته باشن از حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 825.04,
   "end": 829.66,
   "text": "عمومی. اینکه حالا یه وقت طنزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 829.66,
   "end": 833.7,
   "text": "، یه وقت طنزه تو کانال‌ها اینا پر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 833.7,
   "end": 837.1,
   "text": "حالا خودش زده هشتگ طنز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 837.1,
   "end": 841.96,
   "text": "میگه حالا مثلاً پاسخ پونصد پهباد و موشک ایران با سه تا ریزپرنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 841.96,
   "end": 844.84,
   "text": "اینا طنزه اما اینا به واقع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 844.84,
   "end": 848.98,
   "text": "قصه چیز دیگه است. خلاصه اینکه م-مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 848.98,
   "end": 853.1,
   "text": "من با چند تا از کارشناسای خبره نظامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 853.1,
   "end": 856.18,
   "text": "اینها که در این زمینه‌های موشکی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 856.18,
   "end": 858.6,
   "text": "س-- اطلاعات سپاه و اینا الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 858.6,
   "end": 864.68,
   "text": "آدم‌های باخبر و مو-موثقی هستند امروز گفت‌وگو می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 864.68,
   "end": 868.96,
   "text": "اونها هم همین برداشت بنده رو، یعنی تحلیل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 868.96,
   "end": 870.94,
   "text": "تأیید می‌کردن. می‌گفتن همینطور هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 870.94,
   "end": 874.38,
   "text": "باید مراقب باشیم و حواسمون جمع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 874.38,
   "end": 877.6,
   "text": "و حتی این عزیزانی که کانال دارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 877.6,
   "end": 882.2,
   "text": "تولید محتوا می‌کنند به واقع تولید محتوا کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 882.2,
   "end": 885.38,
   "text": "و درست. ببینید عجله هم نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 885.38,
   "end": 892.16,
   "text": "ببینید رهبر عزیزمون معمولاً اتفاق خاصی که می‌افته به سرعت عکس‌العمل نشون نمیده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 892.16,
   "end": 896.98,
   "text": "صبر می‌کنه، رصد می‌کنه میدان رو، نظرات مختلف رو می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 896.98,
   "end": 900.46,
   "text": "بعد مثلاً نظر میده. ما متأسفانه تا یه اتفاق می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 900.46,
   "end": 903.52,
   "text": "حالا این قصه ری-ریزپرنده‌های اصفهان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 903.52,
   "end": 906.36,
   "text": "چیز جدیدی نیست. تقریباً یک سال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 906.36,
   "end": 909.64,
   "text": "خورده‌ای چند ماه مثلاً یک سال و چند ماهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 909.64,
   "end": 913.08,
   "text": "قبل بود که دو مرتبه ریزپرنده‌هایی تو اصفهان بلند شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 913.08,
   "end": 915.24,
   "text": "چون می‌دونید تو اصفهان یهودی زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 915.24,
   "end": 920.24,
   "text": "اینا از ناب اونا اراذل-- اراذل و اوباش اسرائیلیان در داخل کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 920.24,
   "end": 923.84,
   "text": "بلند شدن حالا یکی از مراکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 923.84,
   "end": 928.56,
   "text": "هسته‌ای ایران رو در اصفهان بزنن که موفق نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 928.56,
   "end": 935.3,
   "text": "الانم اینها دنبال، به نظر میرسه دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 935.3,
   "end": 939.72,
   "text": "جمع کردن اطلاعات بودن از مراکز مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 939.72,
   "end": 945.3,
   "text": "تو حالا ناحیه اصفهان و اینها که می‌خواستن به اون برسن که حالا الحمد لله پدافند زدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 945.3,
   "end": 948.76,
   "text": "بعد اون کسی هم که این ریزپرنده‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 948.76,
   "end": 951.48,
   "text": "سال گذشته پرواز داد اسفند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 951.48,
   "end": 954.68,
   "text": "اسفندماه سال گذشته اعدامش کردن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 954.68,
   "end": 957.66,
   "text": "حالا تا اینها رو هم انشاالله بگیرن و تموم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 957.66,
   "end": 960.64,
   "text": "انشاالله که عاقبت به خیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 960.64,
   "end": 963.28,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}