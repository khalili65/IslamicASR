 "chapters": [
  {
   "index": 0,
   "title": "## تسلیت شهادت سید مقاومت",
   "start": 17.14,
   "end": 73.54
  },
  {
   "index": 1,
   "title": "## دعا و تمهید در برابر تهدید",
   "start": 73.54,
   "end": 268.96
  },
  {
   "index": 2,
   "title": "## حمایت‌های منطقه‌ای از اسرائیل و تمهید دفاعی",
   "start": 268.96,
   "end": 570.16
  },
  {
   "index": 3,
   "title": "## دو راه: زدن یا سکوت",
   "start": 570.16,
   "end": 614.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 2.06,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.06,
   "end": 4.64,
   "text": "محمد .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 4.64,
   "end": 8.34,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.34,
   "end": 12.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.54,
   "end": 17.14,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.14,
   "end": 20.12,
   "text": "تسلیت عرض می‌کنم به نوبه خودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.12,
   "end": 26.96,
   "text": "حضور امام عصر، رهبر عزیزمون، جبهه مقاومت، مردم ایران و شما عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.96,
   "end": 31.38,
   "text": "شهادت سید مقاومت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.38,
   "end": 37.38,
   "text": "وجود زیجویی رو از ما گرفتن، شخصیت کاریزما و بی‌نظیری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.38,
   "end": 43.92,
   "text": "که به واقع در خدمت نه فقط اسلام بلکه در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.92,
   "end": 48.16,
   "text": "به قاطبه مظلومین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.16,
   "end": 56.06,
   "text": "اگر نگیم دنیا ، به یک معنا میشه البته گفت ولی حداقل منطقه بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.06,
   "end": 64.02,
   "text": "و البته ما وقتی سیر تطور تاریخ رو بررسی می‌کنیم ما حقمونه و بلکه انشاالله خدا رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.02,
   "end": 66.28,
   "text": "بلکه بدتر از این رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.28,
   "end": 73.06,
   "text": "خواهیم دید وقتی ما انسان‌ها به عزیزترین‌های خدا که حضرت زهراست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.06,
   "end": 78.64,
   "text": "آقا ابا عبدالله است، همینطوری بگیر تا امام عصرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.64,
   "end": 85.68,
   "text": "رحم نکردیم. تا جایی که امیرالمؤمنین امام عصر ما را از طرید و شرید الفرید الوحید معرفی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.68,
   "end": 88.98,
   "text": "طردشده آواره غریب تنها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.98,
   "end": 94.64,
   "text": "من و شما ببخشید جسارتا به صورت کلی عرض می‌کنم حدیث نفس برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.64,
   "end": 98.02,
   "text": "پس شاید شمام به دردتون بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.02,
   "end": 102.68,
   "text": "بله. احسنت شما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.68,
   "end": 104.74,
   "text": "واقعا بلایی که ما سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.74,
   "end": 108.54,
   "text": "اولیای خدا داریم میاریم ما خوبان عالم تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.54,
   "end": 112.3,
   "text": "یه وقتی که کربلا تموم شد قصه همه گفتن وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.3,
   "end": 115.8,
   "text": "خطبه‌خوانی امام سجاد و حضرت زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.8,
   "end": 119.18,
   "text": "به جایی کشیده شد که یادگارهایی که از اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.18,
   "end": 125.22,
   "text": "به یغما برده شده بود برگردوندن سر‌های مقدس و برگردوندن اینها همه گفتن تموم شد و اینا در اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.22,
   "end": 127.42,
   "text": "اول کار بود تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.42,
   "end": 133.8,
   "text": "امام سجاد بعد از قص-قصه عاشورا فرمودند ما زمانی رو به خودمون دیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.8,
   "end": 136.34,
   "text": "تو رو-- این کره زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.34,
   "end": 139.44,
   "text": "بیست نفر بیشتر ما رو دوست نداشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.44,
   "end": 143.2,
   "text": "نه که شیعه، بلکه دوست نداشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.2,
   "end": 151.78,
   "text": "آقا خیلی زمان‌های عجیبی رو این کره زمین به خودش دیده و اون یادگار آخر سرّ سرّ حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.78,
   "end": 157.18,
   "text": "اون یادگار آخره اینطوری نیست که به همین راحتی بگیم آقا دیگه آقا میاد الان دیگه تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.18,
   "end": 159.54,
   "text": "اینطوری نیست. اگه قرار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.54,
   "end": 161.98,
   "text": "اینطوری بیاد تا حالا حضرت تشریف آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.98,
   "end": 165.88,
   "text": "البته ما ناامید نمی‌خوایم بکنیم خودمون و شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.88,
   "end": 169.36,
   "text": "انهم یره نه بعید و نراه قریبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.36,
   "end": 175.12,
   "text": "اما توجه داشته باشیم که هفتصد سال پیش شیخ طوسی فرمود ز-ظهور نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.12,
   "end": 179.54,
   "text": "خب بدا حاصل میشه. همش بستگی به عملکرد ما داره و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.54,
   "end": 186.34,
   "text": "انشاالله روح این سید اونجا دست به دامن مادرش بشه که ناموس خداست و ایشون به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.34,
   "end": 189.0,
   "text": "امام عصر ما یه کاری بکنن در درگاه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.0,
   "end": 194.06,
   "text": "مگر اون‌ها، من الان فرصت نیست، یه روزی دوست داشتید براتون ثابت می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.06,
   "end": 199.4,
   "text": "که امام عصر هنوز خودش برای ظهور خودش دعا نکرده و الا اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.4,
   "end": 204.02,
   "text": "سپرده به من و شما. آخرم خودش در سجده شب جمعه‌ی ظهور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.02,
   "end": 206.92,
   "text": "ظهورش و فرجش رو از خدا می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.92,
   "end": 211.74,
   "text": "کار، کار خودشونه. منتها دیگه ما سیاهی لشکر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.74,
   "end": 215.22,
   "text": "یه نکته که من خواهشم اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.22,
   "end": 216.96,
   "text": "حتما و حتما دست به دعا بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.96,
   "end": 219.32,
   "text": "بزرگان سفارشاتی کردن مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.32,
   "end": 221.96,
   "text": "ختم surه احزاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.96,
   "end": 226.1,
   "text": "دعای جوشن صغیر اینها این ایام برای دفع این بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.1,
   "end": 228.26,
   "text": "معلومه بلا داره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.26,
   "end": 231.74,
   "text": "این یه رشحشه تازه. این رو توجه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.74,
   "end": 235.26,
   "text": "حالا اینجا حرف‌هایی داریم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.26,
   "end": 239.14,
   "text": "تهدیدات احتمالی الان وجود داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.14,
   "end": 242.18,
   "text": "در پس اون‌ها ما لازمه تمهیداتی رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.18,
   "end": 246.8,
   "text": "من چند تاشو فهرست‌وار میگم البته اهلش باید این‌ها رو باز کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.8,
   "end": 252.9,
   "text": "یکی تهدیدات دیگه خیلی روشن و واضح و صریح خود اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.9,
   "end": 258.24,
   "text": "که علنا ایران رو تهدید می‌کنه به جنگ و حتی جنگ داخلی و حتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.24,
   "end": 261.16,
   "text": "اِممم... گمانه زنی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.16,
   "end": 265.6,
   "text": "تا اینجا حاکیه که میگن حتی اِه-- این احتمال وجود داره که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.6,
   "end": 268.96,
   "text": "جنگنده‌های اف سی و پنجش بیاد وارد ایران شه و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.96,
   "end": 272.82,
   "text": "حالا بعد از این کاری که کردن و جشن‌هایی هم که گرفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.82,
   "end": 277.68,
   "text": "اینها باید براش تمهیدات دفاعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.68,
   "end": 282.46,
   "text": "مورد نیاز فراهم بشه. حمایت‌های منطقه‌ای از اسرائیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.46,
   "end": 286.64,
   "text": "نمی‌دونم توجه دارید یا نه. خیلی داره زیاد میشه اتفاقا علیرغم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.64,
   "end": 290.86,
   "text": "خلاف‌های سنگینی که داره مرتکب میشه مثلا باکو به شدت داره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.86,
   "end": 298.22,
   "text": "خب باکو می‌دونید یکی از حامی‌های استراتژیک اسرائیل بوده به طور فزاینده‌ای در حمایت تقویت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.22,
   "end": 301.62,
   "text": "صهیونیست داره کار می‌کنه. اینا باید یه تو دهنی از ایران بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.62,
   "end": 306.34,
   "text": "باید یه تمهیداتی از جهت اطلاعاتی بررسی بشه، دفاعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.34,
   "end": 308.92,
   "text": "لازم تمهیدش فراهم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.92,
   "end": 313.4,
   "text": "ناآرامی‌های داخلی. الان هیچ وقت مثل این چند وقته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.4,
   "end": 315.14,
   "text": "اِممم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.14,
   "end": 318.54,
   "text": "عصب-- قاچاق اسلحه به داخل نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.54,
   "end": 323.88,
   "text": "ورود غیرمجاز اسلحه و حالا خیلیاشونو گرفتن و خیلیاشونم نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.88,
   "end": 326.02,
   "text": "بسیار اسلحه داره وارد کشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.02,
   "end": 329.88,
   "text": "اینا یعنی ان قریبه که از درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.88,
   "end": 336.58,
   "text": "یه به هر حال با کمک فتنه‌انگیزا و آدمای نادون و جاهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.58,
   "end": 338.82,
   "text": "یه اتفاقاتی بیفته و ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.82,
   "end": 342.56,
   "text": "با تسهیلات با اسلحه و اونا بیان وسط گود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.56,
   "end": 344.94,
   "text": "اینا باید خیلی بهش توجه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.94,
   "end": 348.12,
   "text": "الان مثلا اِ-- همین اخیرا به در خونه بنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.12,
   "end": 351.68,
   "text": "اِ-- یه نمی‌دونم حالا همراهم باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.68,
   "end": 353.7,
   "text": "به سازمان اطلاعات اطلاع دادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.7,
   "end": 358.74,
   "text": "گزارش دادم. نامه با مهر سازمان مجاهدین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.74,
   "end": 362.3,
   "text": "چاکک‌هاشون تیز شده، زدن منو تهدید کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.3,
   "end": 364.76,
   "text": "به مثلاً که میکشیمتو فلان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.76,
   "end": 366.74,
   "text": "آوردم اینجا برای همکارا خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.74,
   "end": 368.96,
   "text": "دیگه من یه بچه طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.96,
   "end": 372.26,
   "text": "ااا یه الحمدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.26,
   "end": 376.28,
   "text": "گوشت و پوست و خونمون از انقلاب جونمون هم فدا میکنیمش ادعایی هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.28,
   "end": 378.92,
   "text": "اما یه بچه طلبه‌ای که حالا کارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.92,
   "end": 382.08,
   "text": "علمه، معرفته، چه میدونم این چیزا رو انتقال دادنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.08,
   "end": 385.0,
   "text": "یه ظباطه ضبط کرده به دیگران میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.0,
   "end": 388.16,
   "text": "مورد تهدیده. دیگه ببین اون بزرگان ما اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.16,
   "end": 391.1,
   "text": "واقعاً اینها رو باید توجه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.1,
   "end": 393.84,
   "text": "تحرکاتی که تو سوریه داره اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.84,
   "end": 397.96,
   "text": "الان احتمال ترور بشار اسد هست، تو لیستشون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.96,
   "end": 402.8,
   "text": "هست بعد از اینکه اینا به همین راحتی سید حسن رو کی باورش میشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.8,
   "end": 408.24,
   "text": "دیگه الان پس ترور بشار هم حتی، حتی، حتی زبونم لال ترور آقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.24,
   "end": 413.04,
   "text": "دیگه خیلی راحت داره رو زبونشون میاد و الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.04,
   "end": 418.54,
   "text": "فرزند عزیز رهبر آقا مجتبی درسشون رو تعطیل کردن یه وجهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.54,
   "end": 423.9,
   "text": "میتونه یعنی این باشه. درس خارجشون رو تعطیل کردن که مراقب آقا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.9,
   "end": 425.74,
   "text": "خیلی ما باید برا آقا دعا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.74,
   "end": 433.34,
   "text": "خیلی آقا در خطره. اگه خدایی نکرده آقا رو از ما بگیرن دیگه وا مصیبتا!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.34,
   "end": 439.04,
   "text": "از شه-- حالا بعد در خصوص سوریه حرف زیاد داریم بماند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.04,
   "end": 445.16,
   "text": "حالا حداقل حملات اردن، عربستان، امارات اینا احتمالش میره به سوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.16,
   "end": 447.98,
   "text": "هدف بعدیشون میتونه سوریه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.98,
   "end": 451.94,
   "text": "اما اهدا-- اِاِقدامات راهبردی که من چند تاشو خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.94,
   "end": 455.2,
   "text": "توجه کردم و نوشتم که ای کاش اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.2,
   "end": 457.62,
   "text": "صورت بگیره خیلی میتونه کارساز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.62,
   "end": 460.5,
   "text": "یکی هدف‌گیری استراتژیکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.5,
   "end": 464.38,
   "text": "مثلاً بندر حیفا است، تأسیسات دیما و بن‌گوریون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.38,
   "end": 466.0,
   "text": "زیرساخت‌های نظامی اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.0,
   "end": 471.78,
   "text": "اینا باید الان به شدت هدف‌گیری بشه و اون چیزهایی که امثال سردار حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.78,
   "end": 474.02,
   "text": "زاده‌ها گفتن تسهیلاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.02,
   "end": 482.08,
   "text": "هنوز رو نشده از جهت رزا-- نظامی رو نشده و هیچکسم مثلاً حریفش نیست، سپاه این ادعا رو کرد دیگه خب الان وقتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.08,
   "end": 486.32,
   "text": "الان وقتشه که اینو که من دارم به شما میگم من دارم وظیفه‌م رو انجام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.32,
   "end": 488.64,
   "text": "یه بخشیشو شما هم وظیفه دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.64,
   "end": 493.14,
   "text": "یعنی ببینید رهبر همیشه از رییس جمهورها حمایت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.14,
   "end": 496.56,
   "text": "از رییس جمهورهایی که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.56,
   "end": 499.34,
   "text": "قبول نداشتن انقلابو. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.34,
   "end": 505.52,
   "text": "این هم همینطور. اینکه میره نیویورک اون گاف‌های عجیب رو میده، همه رو متحیر میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.52,
   "end": 507.96,
   "text": "ذلت برای ما به ارمغان میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.96,
   "end": 511.36,
   "text": "بعد از این طرف باز رهبر اجازه میده که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.36,
   "end": 514.74,
   "text": "حرفاشو بزنه، حالا بره مذاکره‌شو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.74,
   "end": 517.02,
   "text": "همیشه حمایت کرده. اما من و شما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.02,
   "end": 519.34,
   "text": "ما باید مطالبه‌مون رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.34,
   "end": 524.44,
   "text": "هرکسی باید ترند کنیم بحث انتقام جدی رو الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.44,
   "end": 530.86,
   "text": "باید پشت آقا رو بگیریم. دیگری کنترل پایگاه‌های نظامیه که مخصوصاً تو امارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.86,
   "end": 536.1,
   "text": "باید توسط پایگاه‌های نظامیش توسط حشد شعبی عراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.1,
   "end": 541.04,
   "text": "عرض شود رصد بشه و با دقت باهاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 541.04,
   "end": 545.38,
   "text": "برخورد بشه. توسعه روابط منطقه‌ایه، مخصوصاً با یمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.38,
   "end": 552.68,
   "text": "سوریه، عراق، لبنان، با کشورهای از منطقه و خصوصاً حوزه مقاومت که بلکه بشه جلوی اردن رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.68,
   "end": 556.38,
   "text": "اردن الان خیلی شاخش بله چشم اشاره به ساعتشون کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.38,
   "end": 560.96,
   "text": "تهدید مستقیم باکوئه برای خنثی‌سازی توطئه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.96,
   "end": 567.0,
   "text": "اینا باید صورت بگیره. انجام آزمایش‌های هسته‌ایه که الان به نظرم بهترین وقته که سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 567.0,
   "end": 569.76,
   "text": "آزمایش‌های هسته‌ایش رو شروع کنه انجام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.76,
   "end": 573.22,
   "text": "اما به صورت کلی ما دو تا کار می‌تونیم انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.22,
   "end": 576.34,
   "text": "ها کار سمبولی نیست یا باید بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.34,
   "end": 578.28,
   "text": "یا مثل قبل سکوت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.28,
   "end": 580.24,
   "text": "نتیجه‌ی سکوت رو دیدیم چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 580.24,
   "end": 582.56,
   "text": "هی قدم به قدم اومدن جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.56,
   "end": 585.94,
   "text": "زدن یعنی هیچ چاره‌ای الان جز زدن نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.94,
   "end": 591.88,
   "text": "ما الان باید اینو ترند کنیم. هرکس کانال داره تو فضای مجازی به شدت اینو تشدید کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 591.88,
   "end": 594.0,
   "text": "که تهیج کنیم حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.0,
   "end": 597.46,
   "text": "هیجان ایجاد کنیم که باید این اتفاق صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.46,
   "end": 603.64,
   "text": "انشاالله که خدای متعال به يد قدرت خودش بیاد وسط و انتقام این سید مظلوم رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.64,
   "end": 608.96,
   "text": "نثار روح بلندش و هر کسی که در این مسیر به شهادت رسیده صلواتی ختم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.96,
   "end": 611.74,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.74,
   "end": 614.46,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}