 },
 "chapters": [
  {
   "index": 0,
   "title": "## اخلاص و خلوص؛ نرم‌کننده‌ی باطنی قلب",
   "start": 22.56,
   "end": 79.68
  },
  {
   "index": 1,
   "title": "## چهل روز اخلاص و جوشش چشمه‌های حکمت",
   "start": 79.68,
   "end": 100.54
  },
  {
   "index": 2,
   "title": "«من أخلص لله»؛ الله اسم جامع است.",
   "start": 100.54,
   "end": 120.62
  },
  {
   "index": 3,
   "title": "## دو رکعت بی‌حاجت؛ دستور آیت‌الله مصباح",
   "start": 120.62,
   "end": 767.22
  },
  {
   "index": 4,
   "title": "فرصت این بخش تمام شد؛ روزهای بعد اگر ماند. دائماً از داری به دار دیگر منتقل می‌شویم:",
   "start": 767.22,
   "end": 958.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 9.88,
   "end": 13.34,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.34,
   "end": 17.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.5,
   "end": 22.56,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 22.56,
   "end": 31.52,
   "text": "در بحث قلب لعن یا لين بودیم و عرض می‌کردیم که طبق روایات و فرمایش بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 31.52,
   "end": 34.84,
   "text": "چه چیزهایی قلب رو نرم می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.84,
   "end": 42.1,
   "text": "یکی از چیزهای بسیار مهمی که مربوط به جوانح هست، جوانحی نه جوارحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 42.1,
   "end": 45.98,
   "text": "باطنیه، امر باطنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 45.98,
   "end": 49.62,
   "text": "اخلاصه. فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 49.62,
   "end": 54.78,
   "text": "اخلاص و که شدت‌ش می‌شه خلوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 54.78,
   "end": 60.64,
   "text": "خدا رحمت کنه سید بحر العلوم در رساله سیر و سلوکیه‌شون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 60.64,
   "end": 62.62,
   "text": "با غروب‌های جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 62.62,
   "end": 66.44,
   "text": "در غرب تهران سر سفره‌ش داریم ارتضا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.44,
   "end": 70.26,
   "text": "این رساله بسیار درون مایه عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 70.26,
   "end": 76.82,
   "text": "اونجا خب فصل دوم رو معرفت اجمالیه می‌گیره، فصل سوم رو خلوص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.82,
   "end": 81.96,
   "text": "نه اخلاص. میگه در مسیر سیر و سلوک باید به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.96,
   "end": 85.84,
   "text": "اخلاص رسیده باشی که می‌شه خلوص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.84,
   "end": 92.56,
   "text": "شدت اخلاص. که بعد دیگه از مرحله مخلص بودن هم گذر کنی بری مخلص بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 92.56,
   "end": 100.54,
   "text": "چون شیطان گفت فبعزتك لا أقوی عليهم أجمعین إلا عبادك منهم المخلصون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 100.54,
   "end": 102.9,
   "text": "نه مخلص، مخلصو باز موانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 102.9,
   "end": 108.44,
   "text": "اونم. تازه والمخلصون هم فی خطر عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 108.44,
   "end": 112.98,
   "text": "تازه اون کسی هم که مخلص می‌شه باز تو خطره مگر خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 112.98,
   "end": 118.54,
   "text": "مگر خدا رحم کنه. به هر حال یکی از چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 118.54,
   "end": 122.42,
   "text": "دل رو به شدت نرم می‌کنه خلوصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.42,
   "end": 128.78,
   "text": "اتفاقا این روایت که الان تقدیم می‌کنم اونجا سید بحر العلوم هم میاره در کتاب رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 128.78,
   "end": 132.4,
   "text": "شریف سیر و سلوکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 132.4,
   "end": 136.86,
   "text": "اتفاقا این رو هم عرض کنم خدا رحمت کنه حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.86,
   "end": 139.14,
   "text": "آستاد محمد حسین، حسینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 139.14,
   "end": 147.52,
   "text": "حسینی تهرانی که قبرشو بعضی از عزیزان نشون دادم یادگار از آیت الله العظمی فقیه مامی بود به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 147.52,
   "end": 151.0,
   "text": "که عرض کردم خدمتتون تو حرم یه چیز مخفی‌م رو بهشون یاد دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 151.0,
   "end": 154.74,
   "text": "ایشون قبر ایشون که بوی بهشت می‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 154.74,
   "end": 157.72,
   "text": "که دلش برای بوی بهشت تنگ می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 157.72,
   "end": 161.3,
   "text": "صورتشو بذاره رو سنگ قبر ایشون که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.3,
   "end": 164.38,
   "text": "پیشونه‌ای نداره مثل مادرش بی‌نشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 164.38,
   "end": 167.98,
   "text": "کسی که بدونه کجاست قبر، بوی عجیبی بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 167.98,
   "end": 172.26,
   "text": "ایشون شرح داده این رساله رو اگر یه وقت کسی خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.26,
   "end": 176.98,
   "text": "رجوع کنه به شرح علامه تهرانی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.98,
   "end": 179.34,
   "text": "رساله سیر و سلوکیه سید بحر العلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 179.34,
   "end": 183.98,
   "text": "بعد ببینید ذیل این روایت چه غوغایی کرده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.98,
   "end": 192.76,
   "text": "روایت رو البته در جامع الأخبار جلد یک صفحه صد و نود و دو به این شکل آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 192.76,
   "end": 197.14,
   "text": "به چند شکل با یک مضمون ولی قوالب مختلف اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 197.14,
   "end": 203.08,
   "text": "نبوی است روایت که پیغمبر فرمود من أخلص لله أربعين صباحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 203.08,
   "end": 206.72,
   "text": "کسی بعضی جاها میگه أربعين يوما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 206.72,
   "end": 209.16,
   "text": "مضمون یکیه. چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 209.16,
   "end": 215.62,
   "text": "صبح، چهل روز، چهل شب، چهل شبانه روز کسی خودش رو خالص کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.62,
   "end": 220.46,
   "text": "و هرت ينابيع الحكمة من قلبه على لسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 220.46,
   "end": 228.38,
   "text": "حکمت که علم به احوال اعیان موجودات و بارها درباره‌ش اینجا صحبت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 228.38,
   "end": 232.84,
   "text": "از قلبش بر لسانش جاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 232.84,
   "end": 237.04,
   "text": "چرا از قلبش بر لسانش جاری می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 237.04,
   "end": 242.02,
   "text": "چون قلب نرم شده. قلب دیگه خشن نیست، زمخت نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 242.02,
   "end": 248.82,
   "text": "قسی نیست. تا قلب نرم نشه اصلاً خبری از حکمت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 248.82,
   "end": 251.14,
   "text": "و يعلمهم الكتاب والحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 251.14,
   "end": 253.54,
   "text": "حکمت باطن کتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 253.54,
   "end": 256.78,
   "text": "شاید یه سری کتاب رو هم قرآن رو بخونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 256.78,
   "end": 263.42,
   "text": "همینطوری توتی‌وار بخونن اما اون کجا که با باطن‌ش مرتبط بشه، اون می‌شه حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 263.42,
   "end": 267.36,
   "text": "هر مقدار علم به احوال اعیان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 267.36,
   "end": 270.4,
   "text": "عین موجودات به احوالش، حالش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 270.4,
   "end": 273.28,
   "text": "حالش. اللهم غير سوء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 273.28,
   "end": 275.2,
   "text": "حالنا بحسن حالك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 275.2,
   "end": 277.16,
   "text": "حتی خدا هم حال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 277.16,
   "end": 285.66,
   "text": "ابن عربی تو فتوحاتش رحمة الله علیه عارف عربی می‌فرماید حال خدا، حال پیغمبره از مشأن اسلامه که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.66,
   "end": 291.82,
   "text": "همه چیز حال داره، زبان حال داره، خود حال چیه تا زبان حال چی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 291.82,
   "end": 297.56,
   "text": "به هر حال تا قلب نرم نشه عزیزان دلم به حکمت نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 297.56,
   "end": 306.68,
   "text": "اصلاً نشدنی‌ست. و برای رسیدن به قلب نرم که بجوشه ازش حکمت هیچ چاره‌ای جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 306.68,
   "end": 312.74,
   "text": "خلوص نیست. แ น่ น อ น من أخلص لله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 312.74,
   "end": 315.36,
   "text": "الله اسم جامع دیگه. قل إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 315.36,
   "end": 318.56,
   "text": "صلاتي قبل از نماز چی مستحبه بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 318.56,
   "end": 325.2,
   "text": "إن صلاتي و نسكي و محياي و مماتي لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 325.2,
   "end": 330.16,
   "text": "همه کار من هرچی که هست، هرچه که هست ریز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 330.16,
   "end": 333.1,
   "text": "درشتش همه لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 333.1,
   "end": 336.58,
   "text": "برای خدا تموم می‌شه. اگه کسی به اینجا رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 336.58,
   "end": 339.9,
   "text": "واقعاً دیگه گل رو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 339.9,
   "end": 346.0,
   "text": "گل طلایی رو زده و قلب قطعاً در یه همچین مرحله‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 346.0,
   "end": 349.22,
   "text": "نرم شده و از اون زمختی خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 349.22,
   "end": 353.68,
   "text": "چقدر قشنگه که آدم خالصانه خدا رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 353.68,
   "end": 360.81,
   "text": "الانم حالا مخصوصاً من این بحث رو به این شکل قرار دادم چون ایام اربعین موسوی و کلیمی هم هست دیروز هم عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 360.81,
   "end": 363.51,
   "text": "خب بالاخره شروع شده اربعینی‌هات و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 363.51,
   "end": 365.87,
   "text": "به قول علامه جوادی آملی علی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 365.87,
   "end": 371.19,
   "text": "حفظه الله تعالی که خب این اربعینی‌هات هست، سیر و سلوک همیشه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 371.19,
   "end": 376.59,
   "text": "ولی خب یکی از بهترین‌هاش همین اربعین موسویه که از اول این ماه شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 376.59,
   "end": 379.07,
   "text": "یکی از بهترین. حالا اگه کسی جا مونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 379.07,
   "end": 381.11,
   "text": "عیبی نداره که از همین امروز شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 381.11,
   "end": 383.69,
   "text": "سه روز گذشته، سه روز هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 383.69,
   "end": 388.83,
   "text": "مثلاً بشه سیزدهم ذی الحجه تموم کنه به جای دهم که عید قربانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 388.83,
   "end": 393.99,
   "text": "عیبی نداره. چهل اربعینه ولی خب این چهل روز یه جور دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 393.99,
   "end": 397.73,
   "text": "خب این ار-- چقدر خوبه که این خالصانه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 397.73,
   "end": 400.99,
   "text": "آقای مصباح یه دستور الاولی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 400.99,
   "end": 404.85,
   "text": "روحشون شاد. خیلی عجیب بودن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 404.85,
   "end": 407.27,
   "text": "نمی‌دونم از نزدیک درک کردید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 407.27,
   "end": 409.51,
   "text": "ایشون رو یا نه. عزیز دلم از قم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 409.51,
   "end": 413.07,
   "text": "از قزوین تشریف آوردین شما. نمی‌دونم حالا قم بودن یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 413.07,
   "end": 415.51,
   "text": "اصن قمی‌ها خیلی آقای مصباح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 415.51,
   "end": 417.23,
   "text": "الان بغل آقای بهجت هم دفن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 417.23,
   "end": 421.23,
   "text": "شاگرد آقای بهجت بود دیگه. یکی از هم مباحثه‌های آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 421.23,
   "end": 424.81,
   "text": "مصباح می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 424.81,
   "end": 427.31,
   "text": "حالا نمی‌دونم الان در قید حیات باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.31,
   "end": 431.35,
   "text": "سنشون بالا بود ایشون. از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 431.35,
   "end": 433.27,
   "text": "ملازمان آقای بهجت بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 433.27,
   "end": 436.57,
   "text": "ما می‌رفتیم محضر آقای بهجت، ایشون همیشه کنار آقای بهجت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 436.57,
   "end": 440.19,
   "text": "یه سید بزرگواری بود. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 440.19,
   "end": 445.45,
   "text": "می‌فرمود که من بچه که بودم، طلبه که بودم سردرد می‌شدم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 445.45,
   "end": 450.79,
   "text": "بعد یه روز نماز آقای بهجت که تو خونه بود، تو مسجد نبود اونطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 450.79,
   "end": 453.67,
   "text": "علنی نبود چون نمازهاش خاص بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.67,
   "end": 459.33,
   "text": "مثل نماز آمیزه جواد آقا ملکی تبریزی، نماز صبح ایشون رو هر کسی نمی‌رفت که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.33,
   "end": 462.23,
   "text": "یه چند نفر خواص می‌رفتن اقتدا می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 462.23,
   "end": 464.95,
   "text": "یک ساعت نماز صبح ایشون طول می‌کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.95,
   "end": 467.09,
   "text": "حالا ول کن آقا من این حرف‌ها رو نزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 467.09,
   "end": 470.33,
   "text": "در حد دهان خود منم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.33,
   "end": 472.29,
   "text": "بعد خلاصه تو خونه‌ش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.29,
   "end": 475.93,
   "text": "می‌گفت من رفتم و دیدم آقای مصباح تکیه کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 475.93,
   "end": 479.29,
   "text": "نشستم پیش ایشون. گفت سردرد شما خوب شده آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.29,
   "end": 481.37,
   "text": "آقای مصباح به ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 481.37,
   "end": 484.77,
   "text": "گفتم نه. گفت دو رکعت نماز بخون، بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 484.77,
   "end": 487.27,
   "text": "بگو خدایا سردردم رو خوب کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 487.27,
   "end": 490.87,
   "text": "من این کارو کردم خوب شد. این رو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 490.87,
   "end": 492.93,
   "text": "تیکه‌شو من دارم میگم الان به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.93,
   "end": 496.07,
   "text": "باور کنید بنده بی‌سواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.07,
   "end": 502.27,
   "text": "بی‌مقدار چه عرض کنم. باور کنید اینو در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.27,
   "end": 505.03,
   "text": "محل خ-- مقدس عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.03,
   "end": 509.97,
   "text": "خود بنده بارها و بارها در تمام مقطع زندگیم اینو امتحان کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 509.97,
   "end": 512.89,
   "text": "البته من نماز مصعب بن جعفر خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 512.89,
   "end": 517.01,
   "text": "صادقانه بگم حالا هم تو دو رکعت نماز معمولی هم نه ولی خب دو رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.01,
   "end": 519.67,
   "text": "نماز مصعب بن جعفر هم بعد از حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.67,
   "end": 523.43,
   "text": "دوازده تا قل هوالله دارم. دو رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.43,
   "end": 529.17,
   "text": "هر وقت مثلاً بچه‌م تب شدید داشت، خودم سردرد شدید گرفتم، خانمم حالش بد شد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.17,
   "end": 531.51,
   "text": "خوندم اثرشو آناً دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.51,
   "end": 535.55,
   "text": "خلاصه ایشون می‌فرمود که ما می‌خوندیم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 535.55,
   "end": 539.47,
   "text": "خوب می‌شد. گاهی اوقات که یادم می‌رفت سردرده شروع می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 539.47,
   "end": 546.75,
   "text": "جالبه. بعد آقای مصباح یه روز بهش گفته بود که یه رمزی رو به شما بگم که این الان روزی شماست امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.75,
   "end": 551.53,
   "text": "ایشون زیر خاکه ظاهراً. اما رزقش سینه به سینه اومده تا شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 551.53,
   "end": 555.43,
   "text": "حالا کی اینجا پیش خدا عزیز بوده این رزق بهش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 555.43,
   "end": 557.19,
   "text": "حالا کی می‌خواد انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 557.19,
   "end": 561.17,
   "text": "خب خیلیا گوش میدن از این گوش از اون گوش در میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 561.17,
   "end": 566.21,
   "text": "خلاصه فرمودن که آقا دو رکعت نماز بخون بعد ببین چه غوغایی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 566.21,
   "end": 568.49,
   "text": "چه؟ برای چی؟ به چه نیتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 568.49,
   "end": 571.59,
   "text": "هیچ نیتی. یعنی چی هیچ نیتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.59,
   "end": 575.79,
   "text": "دو رکعت نمازو بخون بگو خدایا من هیچ حاجتی نداشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.79,
   "end": 578.93,
   "text": "دلم برات تنگ شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 578.93,
   "end": 581.13,
   "text": "دلم یادتو کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.13,
   "end": 586.41,
   "text": "به به، به به، به. ببین اینو تا حالا اینطوری نماز خوندیم خداوکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.41,
   "end": 590.41,
   "text": "تا حالا اینطوری رفتیم پیش امام معصوم، کربلا رفتیم اینطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 590.41,
   "end": 593.79,
   "text": "مشهد رفتیم؟ ضریحو می‌گیریم آقا امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 593.79,
   "end": 597.17,
   "text": "گفتم به تو یکی داد می‌زد ملت هم جیغ فریاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.17,
   "end": 600.75,
   "text": "اگه حوجتمو ندی میرم دیگه برنمی‌گردم به امام رئوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 600.75,
   "end": 603.47,
   "text": "این چیه؟ برو برنگرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.47,
   "end": 608.29,
   "text": "ملت هم سر هوا می‌ذارن. اما بهتر که برنگردی با این زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 608.29,
   "end": 611.37,
   "text": "با-- اینطوری آدم بره محضر امامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.37,
   "end": 613.59,
   "text": "به عشق تو. اصن دوستت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.59,
   "end": 616.81,
   "text": "برای چی اومدی؟ دوستت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.81,
   "end": 620.19,
   "text": "مثل اون عالمی که خیلی دوست داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 620.19,
   "end": 628.99,
   "text": "عبدالله بن-- نه سعید بن عبدالله، سعید بن عبدالله رو که تو کربلا سیزده چوب-- تیر خورد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 628.99,
   "end": 633.61,
   "text": "بدنش. رو به رو ابا عبدالله وایساد که حضرت با حبیب با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 633.61,
   "end": 635.79,
   "text": "وایسادن با ظهیر و حبیب و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 635.79,
   "end": 639.55,
   "text": "ایشون وایسادن سد دفاعی درست کردن تیره‌ها به ابا عبدالله نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.55,
   "end": 645.87,
   "text": "چه سعادتی. تیرها خورد، خورد سیزده تا تیر آخرش تو پیشونیش افتاد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.87,
   "end": 647.63,
   "text": "پای امام حسین آقا سلامو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.63,
   "end": 650.25,
   "text": "تموم شد دیگه وقتی تیر آخر رو خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 650.25,
   "end": 652.17,
   "text": "بغلش کردن و فیتو بعهدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 652.17,
   "end": 654.27,
   "text": "حسین جان آیا به عهدم وفا کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 654.27,
   "end": 659.19,
   "text": "حضرت فرمود چگونه تو به عهدت وفا نکردی که انت امامی في الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 659.19,
   "end": 662.53,
   "text": "تو رو به روی منی، پیش روی منی همیشه در بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 662.53,
   "end": 665.47,
   "text": "یکی از علما میگه خیلی دوست داشتم اینو ببینمش من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.47,
   "end": 668.73,
   "text": "تو یه مکاشفه ای هست، بودن، هستن، الانم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.73,
   "end": 671.31,
   "text": "ما غرق دنیا، خود من شدم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 671.31,
   "end": 673.35,
   "text": "این چیزا برام ثقیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 673.35,
   "end": 679.71,
   "text": "آقای الهی برادر علامه طباطبایی با همه بزرگان درس و بحث اونا که از دنیا رفته بودن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 679.71,
   "end": 682.03,
   "text": "درس و بحث‌های علمی داشت. آثارشو نوشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.03,
   "end": 683.89,
   "text": "آخر عمر هم همه‌ش سوزون ریخت بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 683.89,
   "end": 687.33,
   "text": "دید کسی درکشو نداره. فقط با دو کس نتونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 687.33,
   "end": 689.55,
   "text": "ما محو جمال امیرالمؤمنین بودن غافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 689.55,
   "end": 691.83,
   "text": "اصن ول نکردن مولا رو بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.83,
   "end": 694.53,
   "text": "سعید بن طاووس و سید بهرالعلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.53,
   "end": 701.31,
   "text": "با ارتباط می‌گرفت. خلاصه ایشون هم می‌گفت من باید ببینم این سعید بن عبدالله رمز این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 701.31,
   "end": 706.01,
   "text": "عشق چی بوده آخه؟ سیزده تا تیر بخوره به بدنت وایستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 706.01,
   "end": 708.95,
   "text": "یه سوزن بخوره بدنت داد می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 708.95,
   "end": 713.61,
   "text": "به خداست دیدنیه این چهره‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 713.61,
   "end": 720.27,
   "text": ". مثل شهید حججی که کتکش زدن، شکنجه‌ش دادن، پریدن رو سینش بالا پایین با پوتین تو دهن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 720.27,
   "end": 723.07,
   "text": "چیه و که بگه اصرار و ندامت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.07,
   "end": 726.64,
   "text": "مطلقا. همش یا زینب می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 726.64,
   "end": 733.92,
   "text": "خلاصه میگه که آخر دیدم سعید بن عبدالله رو گفتم بهش گفتم که آقا دیدم در جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 733.92,
   "end": 736.96,
   "text": "شهدای کربلا ابا عبدالله هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 736.96,
   "end": 743.24,
   "text": "یه گوشه‌ای تشریف دارن و من به ایشون سریع تا ایشون رو دیدم گفتم آقا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 743.24,
   "end": 746.62,
   "text": "چه کردی سیزده چوبه تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 746.62,
   "end": 748.98,
   "text": "تیر رو تحمل کردی؟ یه اشاره کرد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 748.98,
   "end": 752.86,
   "text": "آقا ابا عبدالله فرمود حب الحسین حب الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 752.86,
   "end": 759.68,
   "text": "عشق عشق یعنی خلوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.68,
   "end": 761.9,
   "text": "کسی بتونه به اینجا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 761.9,
   "end": 765.34,
   "text": "حب الحسین. اتفاقاً حالا دیگه فرصت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 765.34,
   "end": 768.56,
   "text": "حالا روزهای بعدو که از ما نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 768.56,
   "end": 772.0,
   "text": "اگر مردیم شما رفتی زودتر از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 772.0,
   "end": 774.26,
   "text": "آقا انشاالله با عاقبت بخیری و شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 774.26,
   "end": 776.18,
   "text": "نه ما زودتر از شما رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 776.18,
   "end": 781.18,
   "text": "سفر حق دیگه. \"نما تنتقلون من دارٍ إلى دار\" از یه داری میریم به دار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 781.18,
   "end": 784.64,
   "text": "از سر رحم اومدیم به اینجا. حالا از رحم طبیعت میریم به برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 784.64,
   "end": 787.34,
   "text": "اونجام دوباره \"وأمددناهم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 787.34,
   "end": 789.64,
   "text": "اونجام دوباره بار دوم تو برزخ می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.64,
   "end": 791.98,
   "text": "میریم یه عالم دیگه. دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 791.98,
   "end": 795.06,
   "text": "پشت سر هم هی پوست میندازیم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 795.06,
   "end": 799.0,
   "text": "اینجا نشد تو عالم برزخ من شما رو گیر میارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 799.0,
   "end": 802.78,
   "text": ". اونجا می‌شینیم دوباره با همدیگه بحث می‌کنیم صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 802.78,
   "end": 806.46,
   "text": "آره عزیز دلم. ولی خب می‌خواستم این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 806.46,
   "end": 810.18,
   "text": "باشه جلسه بعد این تیکه رو فقط عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 810.18,
   "end": 815.38,
   "text": "داشتم دعای جامع معروفه به دعای جامع زمان غیبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 815.38,
   "end": 818.56,
   "text": "معمولاً همه عادت کردن به همون تیکه اولش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 818.56,
   "end": 823.02,
   "text": "\"اللهم عرفنی نفسك فإنك إن لم تعرفني نفسك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 823.02,
   "end": 827.94,
   "text": "لم أعرف رسولک اللهم عرفنی رسولک\" تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 827.94,
   "end": 829.96,
   "text": "اون آخرش که \"وللت أم ديني\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 829.96,
   "end": 832.68,
   "text": "این تیکه اول دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 832.68,
   "end": 835.2,
   "text": "تازه یعنی از اینجا تازه شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 835.2,
   "end": 838.04,
   "text": "حدود دوازده بند، بیست و دو بند داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 838.04,
   "end": 841.14,
   "text": "بیست و دو بند داره این یه بندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 841.14,
   "end": 846.96,
   "text": "دعای جامع مخصوص آخر زمان نائب اول امام عصر این دعا رو تعلیم فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 846.96,
   "end": 848.72,
   "text": "و از امام عصر هم دریافت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.72,
   "end": 850.3,
   "text": "یه تیکه‌ش و علیکُم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 850.3,
   "end": 854.32,
   "text": "یه تیکه‌شو می‌خواستم توجه خودمون رو به اون جلب کنم که باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 854.32,
   "end": 860.38,
   "text": "جلسه بعد فکر می‌کنم دیگه توفیق شه چهارشنبه تو مسجد بلال این تیکه‌شو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 860.38,
   "end": 864.74,
   "text": "که این قسمتش به خدا عرض می‌کنیم که اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 864.74,
   "end": 867.26,
   "text": "به به به و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.26,
   "end": 871.44,
   "text": "اا \"وستعملنی بطاعتك و ليّن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 871.44,
   "end": 873.18,
   "text": "و ليّن قلب چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.18,
   "end": 875.58,
   "text": "بحث ما لَعْن یا لَيّن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 875.58,
   "end": 879.58,
   "text": "و ليّن خدایا نرم کن قلبم را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 879.58,
   "end": 881.98,
   "text": "\"و ليّن قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 881.98,
   "end": 885.54,
   "text": "لولی أمرک\". به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 885.54,
   "end": 888.32,
   "text": "برای امام زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 888.32,
   "end": 892.9,
   "text": "خودم و ولی امر تو دلم رو نرم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 892.9,
   "end": 897.22,
   "text": "این از لوازم نوکری اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 897.22,
   "end": 900.06,
   "text": "یعنی چی دلم رو نرم کن؟ با سیر بحث بریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 900.06,
   "end": 905.42,
   "text": "یعنی عشق آقا رو تو دلم به طوری بنداز که من یکپارچه حب آقا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 905.42,
   "end": 907.74,
   "text": "آتش عشق آقا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 907.74,
   "end": 910.66,
   "text": "نه برای دنیام برم سمت آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 910.66,
   "end": 915.6,
   "text": "بله امروزه خیلیا اربعین می‌گیریم اما اربعینمون معمولاً خداوکیلی برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 915.6,
   "end": 919.68,
   "text": "خیلی آدم درست حسابی باشیم برای دنیامون نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 919.68,
   "end": 924.14,
   "text": "برای کسب معارف و علم و حکمت و اونم خوبه، اونم قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 924.14,
   "end": 926.0,
   "text": "برای مقامات رسیدن به مقامات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 926.0,
   "end": 933.08,
   "text": "اما اون کجا که چهله بگیره بگه اصلاً دوست دارم با تو حرف-- تو رو، تو دوست داشتنی‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 933.08,
   "end": 935.88,
   "text": "دوست دارم غرق در تو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 935.88,
   "end": 940.0,
   "text": "این چقدر شیرینه. این دیگه اوج قلب نرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 940.0,
   "end": 943.46,
   "text": "قلب لَعْنِ و قلب-- خدایا روزیمون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 943.46,
   "end": 949.16,
   "text": "خدایا روزی هممون کن. انشاالله عاقبتمون با قلب نرم با قلب لَعْن و لَيّن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 949.16,
   "end": 953.1,
   "text": "ختم بخیر بشه. به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
