 },
 "chapters": [
  {
   "index": 0,
   "title": "## دعا؛ عامل نرمی دل در قلب لَیِن",
   "start": 5.06,
   "end": 187.16
  },
  {
   "index": 1,
   "title": "## دعا خواندن است نه انبار حاجت",
   "start": 187.16,
   "end": 252.32
  },
  {
   "index": 2,
   "title": "## سه سنخ دعا در بیان امام",
   "start": 252.32,
   "end": 368.65
  },
  {
   "index": 3,
   "title": "حاجت را معین نکرد؛ هرچه تو بخواهی. حتی حاجت را نیز چنین باید خواست. آیهٔ انفال:",
   "start": 368.65,
   "end": 639.71
  },
  {
   "index": 4,
   "title": "آیهٔ بقره:",
   "start": 639.71,
   "end": 660.25
  },
  {
   "index": 5,
   "title": "## ذکر، ورد، مناجات",
   "start": 660.25,
   "end": 934.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.06,
   "end": 9.12,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.12,
   "end": 21.58,
   "text": "و آل محمد. بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 21.58,
   "end": 25.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 25.5,
   "end": 30.64,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 30.64,
   "end": 41.0,
   "text": "یکی دیگه از کارهایی که دل رو نرم می‌کنه و در بحث قلب لنگ بودیم یا لَین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 41.0,
   "end": 44.54,
   "text": "و خیلی بهش تصریح شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 44.54,
   "end": 48.64,
   "text": "دعا کردنه. منتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 48.64,
   "end": 50.64,
   "text": "باید فرق گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 50.64,
   "end": 53.34,
   "text": "بین دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 53.34,
   "end": 56.22,
   "text": "که خواندن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.22,
   "end": 60.7,
   "text": "با طلب حاجت که خواستن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.7,
   "end": 63.68,
   "text": "و ذکر که یاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.68,
   "end": 66.18,
   "text": "این‌ها با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.18,
   "end": 70.72,
   "text": "در کتاب شریف حکمت عبادات یادش بخیر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.72,
   "end": 74.38,
   "text": "خیلی بچه‌تر بودیم این کتابو از آقای جوادی آملی خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.38,
   "end": 77.84,
   "text": "یه بخشیش پیرامون این فرق می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.84,
   "end": 82.96,
   "text": "جوهر ذکر غیر از گوهر دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.96,
   "end": 86.0,
   "text": "یعنی خواندن و سؤال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.0,
   "end": 90.48,
   "text": "یعنی خواستن است. این‌ها با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.48,
   "end": 93.84,
   "text": "زیرا صرف توجه به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.84,
   "end": 99.7,
   "text": "ذکر اوست. همین که توجه به خدا کردی، توجه عرفانی کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.7,
   "end": 102.22,
   "text": "یاد کردی خدا رو، این ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.22,
   "end": 107.4,
   "text": "اگرچه خطاب یعنی مخاطب قرار ندادی خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.4,
   "end": 110.52,
   "text": "فقط یادش کردی. اگرچه خطاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.52,
   "end": 116.12,
   "text": "انشا یا درخواستی او را همراهی نکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.12,
   "end": 120.72,
   "text": "می‌شه ذکر. ذکر از آن جهت که ذکر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.72,
   "end": 122.76,
   "text": "و منحاز از دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.76,
   "end": 125.48,
   "text": "ببینید آقای جوادی تصریح داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.48,
   "end": 127.56,
   "text": "ذکر حتی ذکر با دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.56,
   "end": 134.4,
   "text": "فرق می‌کنه و منحاز از دعا و ممتاز از سؤال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.4,
   "end": 136.92,
   "text": "هیچ گونه خواندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.92,
   "end": 139.62,
   "text": "خواندن چی شد؟ دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.62,
   "end": 143.82,
   "text": "یا خواستن یعنی طلب حاجت در بین نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.82,
   "end": 149.14,
   "text": "تا اجابت شود. اگرچه ممکن است با ذکر خاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.14,
   "end": 158.12,
   "text": "نیاز مخصوصی برطرف گردد یا مشکلی گشوده شود یا سیئه‌ای بخشیده یا حسنه‌ای افزوده شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.12,
   "end": 163.3,
   "text": "لکن هیچ کدام از این امور و مانند آن در متن ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.3,
   "end": 166.46,
   "text": "تعبیه نشده. شما در ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.46,
   "end": 169.96,
   "text": "نه خدا رو می‌خوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.96,
   "end": 174.2,
   "text": "که مثلاً بگی یا الله، یا رحمان، یا رحیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.2,
   "end": 178.12,
   "text": "نه می‌خواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.12,
   "end": 183.5,
   "text": "توجه کردید؟ اینا باید امتیاز بینشون برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.5,
   "end": 187.0,
   "text": "ممتاز از هم‌اند، منحاز‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.0,
   "end": 192.58,
   "text": "که تا میگی دعا طرف فکر می‌کنه یعنی باید طوماری از خواسته‌ها و حاجاتشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.58,
   "end": 200.22,
   "text": "بنویسه بره محضر درگاه حضرت حق و شروع کنه تق تق دق گلباد و آقای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.22,
   "end": 204.5,
   "text": "بسم الله گفتی بیا ادعونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.5,
   "end": 207.94,
   "text": "منو بخوانید استجب لکم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.94,
   "end": 210.38,
   "text": "سریع همه شما استجابت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.38,
   "end": 215.76,
   "text": "اگه این ادعونی استجب لکم به این معنای متعارفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.76,
   "end": 220.1,
   "text": "پس چگونه است که در خصوص حضرت یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.1,
   "end": 228.02,
   "text": "به قول استاد عزیز ما در خصوص ایشون در شکم ماهی بود مگه چیزی از خدا درخواست کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.02,
   "end": 230.14,
   "text": "اگر اون دعا رو بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.14,
   "end": 234.5,
   "text": "خواستن، نه خواندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.5,
   "end": 236.64,
   "text": "چی عرض کرد تو شکم ماهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.64,
   "end": 239.56,
   "text": "سبحانک إنی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.56,
   "end": 245.68,
   "text": "لا اله الا انت سبحانک إنی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.68,
   "end": 248.8,
   "text": "یعنی در حقیقت خواندن بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.8,
   "end": 253.78,
   "text": "خواستن نبود. اگرچه حضرت امام در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.78,
   "end": 261.2,
   "text": "دعا می‌فرماید دعایی مستجابه که بر اساس یعنی هم زبان حال، هم قال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.2,
   "end": 264.0,
   "text": "هم استعداد همراه باشه با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.0,
   "end": 270.08,
   "text": "اگر زبان قاله شروع کرده تند تند دعا خوندن دعای کمیل و هی هم ساعتشو نگاه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.08,
   "end": 273.92,
   "text": "چرا تموم نمی‌شه؟ ورق می‌زنه. جمعش کن آقا این به درد نمی‌خوره خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.92,
   "end": 283.78,
   "text": "این فقط قاله. اگر مطابق با حال باشه یعنی دلت همراه اون چیزی‌ست که با خدا داری مطرح می‌کنی لذت می‌بری، درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 283.78,
   "end": 288.96,
   "text": "ولی استعداد چی؟ مثلاً من بگم خدایا یه کاری کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 288.96,
   "end": 291.98,
   "text": "که من الان از خدا بخوام دوست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 291.98,
   "end": 295.16,
   "text": "زبان قال هست. حالم هست یعنی دوست دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.16,
   "end": 297.86,
   "text": "واقعاً متوجهم که چی دارم می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.86,
   "end": 300.42,
   "text": "ولی چی می‌خوام؟ مطابق با استعدادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 300.42,
   "end": 303.2,
   "text": "خدایا منو پیغمبر کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.2,
   "end": 306.28,
   "text": "منو امام کن. این مطابق با استعداد منه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.28,
   "end": 309.66,
   "text": "نه. پس استجابتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.66,
   "end": 315.42,
   "text": "که حالا بعد امام میاد سه دسته دعا رو مطرح می‌کنه که یا استعجالی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.42,
   "end": 319.58,
   "text": "یا احتمالی‌ست یا امتثالی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.58,
   "end": 323.12,
   "text": "اون که استعجال است آره متعارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.12,
   "end": 326.62,
   "text": "عامه مردم عجله می‌کنند مبادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.62,
   "end": 329.38,
   "text": "امور دنیویه‌شون فوت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.38,
   "end": 333.28,
   "text": "برای مسائل دنیاییشون غالباً خواهش می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.28,
   "end": 338.9,
   "text": "حتی از آخرت هم اگه چیزی می‌خوان برای اینکه رتبه و درجه می‌خوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.9,
   "end": 341.28,
   "text": "فضیلت بر دیگران می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.28,
   "end": 344.76,
   "text": "اینه. بعد اون حالت استعجال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.76,
   "end": 348.8,
   "text": "مال کیاست؟ کسایی که اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.8,
   "end": 351.6,
   "text": "رشدند. اهل در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.6,
   "end": 356.18,
   "text": "اصحابی هستند که اینا می‌خوان بیشتر رشد کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.18,
   "end": 358.86,
   "text": "به قول امام اهل حکمت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.86,
   "end": 361.42,
   "text": "باطن رو می‌خوان. اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.42,
   "end": 364.65,
   "text": "دعاهاشون از رو است- می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.65,
   "end": 366.79,
   "text": "احتماله. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.79,
   "end": 370.87,
   "text": "احتمال میدن از دعا یدو قضا والمبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.87,
   "end": 377.71,
   "text": "اون قضای حتمی که براشون از طرف حق در نظر گرفته شده احتمال میدن با دعا برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.71,
   "end": 380.43,
   "text": "احتمال. اما اس-- اون آخری چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.43,
   "end": 383.51,
   "text": "امتثال. اصلا براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.51,
   "end": 385.81,
   "text": "مهم نیست که خدا بدهد یا ندهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.81,
   "end": 389.25,
   "text": "اون عشقش اینه که با خدا حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.25,
   "end": 392.85,
   "text": "این چنینه و حتی درخواستش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.85,
   "end": 397.03,
   "text": "چون خدا دستور داده امتثال از من چیزی بخواه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.03,
   "end": 400.07,
   "text": "کم-- چون می‌فرمود که انتم الفقراء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.07,
   "end": 405.23,
   "text": "الى الله همه فقیر الى الله هستید برای اینکه فقرشو بر در خونه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.23,
   "end": 408.43,
   "text": "صدا می‌زنه. حالا چه خدا داد، چه نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.43,
   "end": 412.03,
   "text": "یه مداحه بود جلوی ایوان طلا امام رضای روزی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.03,
   "end": 416.37,
   "text": "بچه بودیم. داد می‌زد، ملت هم گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.37,
   "end": 420.13,
   "text": "بعد یه جمله گفت همه زجه‌شون بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.13,
   "end": 427.75,
   "text": "به نظر شما چی گفته باشه؟ مثلا گفته باشه امام رضا دورت بگردم یا مثلا گفته باشه روضه قتلگاه خونده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.75,
   "end": 429.85,
   "text": "این جمله رو گفت آقا اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.85,
   "end": 433.23,
   "text": "حاجتمو دادی دادی ندادی دیگه نمیام حرمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.23,
   "end": 437.19,
   "text": "همه زجه می‌زدن. این چه جای زجه زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.19,
   "end": 442.73,
   "text": "زجه باید بر حماقت این شخص زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.73,
   "end": 445.41,
   "text": "این خواستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.41,
   "end": 447.03,
   "text": "آیا درش خواندن بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.03,
   "end": 450.25,
   "text": "آیا ذکر بود؟ این صرفا مسائل دنیایی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.25,
   "end": 456.51,
   "text": "حالا پس این رو باید حواسمون جمع باشه که اونجا حضرت یونس تو شکم ماهی صرفا خدا رو خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.51,
   "end": 461.91,
   "text": "دعا یعنی این. بعد فاستجبنا له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.91,
   "end": 465.29,
   "text": "استجابت بعدش اومد. چیزی نخواسته بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.29,
   "end": 468.31,
   "text": "خدا رو خوند. یا حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.31,
   "end": 472.95,
   "text": "رب انی لما انزلت الی من خیرًا فقیر چقدر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.95,
   "end": 475.61,
   "text": "دعا زیباست. دعاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.61,
   "end": 478.73,
   "text": "اما تو دلش چیز خاصی رو معین نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.73,
   "end": 483.89,
   "text": "خدایا من محتاجَم به اون خیری که از تو به من نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 483.89,
   "end": 487.61,
   "text": "تمام. حالا می‌خوای بده، می‌خوای نده اصن هرچی خودت می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.61,
   "end": 492.05,
   "text": "چقدر شیرینه. حتی حاجت هم می‌خواد آدم اینطوری بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.05,
   "end": 496.57,
   "text": "یا اون دعای شع-- اون عذ-- شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.57,
   "end": 499.11,
   "text": "آیه بیست و چهار انfal",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.11,
   "end": 503.93,
   "text": "يا ايها الذين آمنوا استجيبوا لله وللرسول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.93,
   "end": 509.29,
   "text": "استجابت کنید. دعا-- دعوت خدا و پیغمبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.29,
   "end": 512.19,
   "text": "کی؟ الى دعا کم دعا کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.19,
   "end": 514.75,
   "text": "وقتی شما رو دعا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.75,
   "end": 516.55,
   "text": "عجب. یعنی چی اونا ما رو دعا می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.55,
   "end": 519.99,
   "text": "یعنی دعوت می‌کنن. لغت شناسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.99,
   "end": 522.57,
   "text": "فرمودن اینجا ریشه دعا از دعوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.57,
   "end": 529.71,
   "text": "اونا شما رو دعوت می‌کنن. مثلا من شما رو دعوت می‌کنم تشریف بیارید منزل ما شام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.71,
   "end": 532.71,
   "text": "خب من از شما تشریف میارین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.71,
   "end": 536.53,
   "text": "خوشتون اومد ها. مرد و حرفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.53,
   "end": 540.49,
   "text": "بعد در حقیقت من از شما چیزی نمی‌خوام که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.49,
   "end": 542.11,
   "text": "یعنی می‌خوام به من چیزی بدید که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.11,
   "end": 545.81,
   "text": "تازه ظاهرا میاد چیزی از من کم می‌شه ظاهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.81,
   "end": 549.17,
   "text": "این دعوته. اما به نفعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.17,
   "end": 552.05,
   "text": "حالا می‌فرمود که لمایحیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.05,
   "end": 554.39,
   "text": "برای اینکه شما احیا بشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.39,
   "end": 556.51,
   "text": "دعوت اونا رو استجابت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.51,
   "end": 558.71,
   "text": "توی حضرت آل یاسین به امام عسل چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.71,
   "end": 562.05,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.05,
   "end": 566.71,
   "text": "تو داعی الى اللهی دعوت کننده به سمت اللهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.71,
   "end": 569.49,
   "text": "می‌خوانی همه رو به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.49,
   "end": 571.61,
   "text": "نه اینکه به سمت خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.61,
   "end": 575.49,
   "text": "نه اینکه این‌ها رو می‌خوای که استغفرالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.49,
   "end": 581.15,
   "text": "مثلا حلم ناصر یانصرنی یعنی من محتاجَم العیاذبالله کسی بیاد منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.15,
   "end": 583.83,
   "text": "نصرت بده، یاری بده. نخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.83,
   "end": 588.63,
   "text": "این بلده به این شکل. یا حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.63,
   "end": 593.87,
   "text": "تفاسیر مثلا در تفسیر برهان از امام صادق علیه السلام روایت داریم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.87,
   "end": 597.37,
   "text": "لمایحیکم این دعوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.37,
   "end": 600.99,
   "text": "استجابت دعوت پیغمبر و خدا برای اینکه شما را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.99,
   "end": 604.43,
   "text": "حیات می‌بخشه ولایت امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 604.43,
   "end": 608.75,
   "text": "چون اونا دعوت به سمت ولایت می‌کنن، ولایت کلیه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 608.75,
   "end": 613.13,
   "text": "لذا دعوتشون هم ما رو به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 613.13,
   "end": 616.05,
   "text": "ولایت می‌بره که باطن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.05,
   "end": 618.73,
   "text": "باطن نبوت پیغمبر ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.73,
   "end": 621.35,
   "text": "ظاهرش نبوته، باطنش ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 621.35,
   "end": 625.93,
   "text": "یا در آیه صد و هشتاد و شش بقره چقدر شیرینن این آیات مثل قندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.93,
   "end": 629.73,
   "text": "و اذا سألك عبادی عنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.73,
   "end": 633.29,
   "text": "وقتی که پیغمبر از تو سؤال کردن از من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.29,
   "end": 635.85,
   "text": "بهشون بگو که فاني قريب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 635.85,
   "end": 638.41,
   "text": "نزدیکم اجيب جواب میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.41,
   "end": 640.83,
   "text": "کیو جواب میدم؟ جواب کیو میدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.83,
   "end": 644.27,
   "text": "دعوت الداع اذا دعانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.27,
   "end": 647.23,
   "text": "وقتی دعا می‌کنند یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 647.23,
   "end": 650.35,
   "text": "خب این همه ما از خدا چیزی خواستیم و نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.35,
   "end": 653.31,
   "text": "ادعونی استجب لکم مرا بخوانید تا اجابت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.31,
   "end": 654.99,
   "text": "بعد چرا این همه ما می‌خوایم نمیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.99,
   "end": 657.13,
   "text": "بله در مقام توجیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 657.13,
   "end": 660.25,
   "text": "نه اونم درسته ها روایت میگه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 660.25,
   "end": 663.07,
   "text": "این چیزی که خواستی اگه به نفعته بسم الله میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.07,
   "end": 665.41,
   "text": "نیست، یه چیز بهتر میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.41,
   "end": 668.67,
   "text": "یا میذاریم قیامت جبران می‌کنیم یا ازت دفع بلا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.67,
   "end": 671.23,
   "text": "یا بالاخره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.23,
   "end": 673.37,
   "text": "یه توجیه درستی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.37,
   "end": 675.57,
   "text": "اما درست‌تر از اون اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.57,
   "end": 680.25,
   "text": "که من الان چیزی از خدا نخواستم، فقط او رو خواندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 680.25,
   "end": 684.69,
   "text": "شما ببینید یکی از بهترین ادعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.69,
   "end": 688.39,
   "text": "دعای سحر امام باقره که مال همه سحرهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.39,
   "end": 690.45,
   "text": "اشتباها میگن سحرهای ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.45,
   "end": 694.31,
   "text": "همه سحرها. برید ببینید این دعا رو اصن درخواستی توش هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 694.31,
   "end": 697.67,
   "text": "خواستنی توشه؟ همش خواندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 697.67,
   "end": 701.25,
   "text": "این، این، این خواندن دل رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 701.25,
   "end": 705.99,
   "text": "اشتباه نشه. یه وقت هست من شما رو یاد می‌کنم تو قلبم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 705.99,
   "end": 708.73,
   "text": "هیچ وردی هم به لسانم جاری نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 708.73,
   "end": 710.71,
   "text": "بعد یه وقت شما رو می‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 710.71,
   "end": 713.99,
   "text": "مثلا میگم یا محسن ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 713.99,
   "end": 716.21,
   "text": "شما رو می‌خوانم آقا محسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 716.21,
   "end": 718.35,
   "text": "این خواندنه. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 718.35,
   "end": 720.89,
   "text": "هیچی هم ازت نمی‌خوام. من فقط دوست دارم بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 720.89,
   "end": 724.98,
   "text": "دوستت دارم. چاخانی البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.98,
   "end": 727.2,
   "text": "خب ولی یه وقت هست نه یه چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 727.2,
   "end": 730.56,
   "text": "میگه سلام گرگ بی‌تمه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 730.56,
   "end": 734.0,
   "text": "یا محسن بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 734.0,
   "end": 736.0,
   "text": "یه چیزی ازت می‌خوام. اینجا چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.0,
   "end": 740.2,
   "text": "می‌شه خواستن. حواسمون جمع باشه خلاصه خسته م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 740.2,
   "end": 744.64,
   "text": "خسته تون نکنم. اونچه که در روایات می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 744.64,
   "end": 749.06,
   "text": "موجب نرمی دل می‌شه دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 749.06,
   "end": 755.18,
   "text": "که در آیه‌ی هفتاد و هفت فرقان هم می‌فرماید \"قل\" خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 755.18,
   "end": 758.84,
   "text": "لرزاننده و ترساننده است این دعا، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 758.84,
   "end": 761.3,
   "text": "آیه. \"قل\" بگو به همه بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 761.3,
   "end": 764.36,
   "text": "\"ما یعبع بكم ربی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.36,
   "end": 767.72,
   "text": "اصلا پروردگار شما به شما نه-- نگاه نمی‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 767.72,
   "end": 770.14,
   "text": "\"لولا دعاكم\" اگه دعاتون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 770.14,
   "end": 774.28,
   "text": "دعا نه یعنی برم چیزی بخوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 774.28,
   "end": 779.86,
   "text": "یعنی بخوانم او را در کنار یاد قلبی که است او را بخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 779.86,
   "end": 784.24,
   "text": "که اگر این نباشه دیگه کمهیتمون لنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 784.24,
   "end": 787.54,
   "text": "در اح-- کافی کلینی جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 787.54,
   "end": 793.2,
   "text": "دو صفحه چهارصد و هفت هم از اهمیت دعای روایت تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.2,
   "end": 798.86,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمود \"احب الأعمال إلى الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 798.86,
   "end": 801.14,
   "text": "آقا از من و شما سؤال کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 801.14,
   "end": 807.62,
   "text": "محبوب‌ترین کارها به سمت خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 807.62,
   "end": 812.54,
   "text": "بفرمایین. مولا علی امیر بیان می‌فرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 812.54,
   "end": 814.8,
   "text": "\"إلى الله عز وجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.8,
   "end": 817.62,
   "text": "في الأرواض الدعاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 817.62,
   "end": 822.28,
   "text": "یعنی خواندن خدا. همین که یه دفعه دیدی گاهی اوقات یه دفعه می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 822.28,
   "end": 824.2,
   "text": "یه آه می‌کشی. آخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 824.2,
   "end": 826.0,
   "text": "اصلا آروم می‌شی. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 826.0,
   "end": 828.82,
   "text": "چون آه اسم من أسماء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 828.82,
   "end": 832.0,
   "text": "اسم خداست. مثل اون روایتی که داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 832.0,
   "end": 835.64,
   "text": "ای ق-- امام صادق با یه دسته از خلق از خواب رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 835.64,
   "end": 839.52,
   "text": "عیادت یه نفر و دیدن هی آه می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 839.52,
   "end": 843.88,
   "text": "درد داشت. گفتن آقا بسه دیگه خجالت بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 843.88,
   "end": 848.22,
   "text": "هی آه می‌کشی. حضرت فرمود رлаш کنید این اسم خدا رو داره می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 848.22,
   "end": 853.04,
   "text": "آه اسم من أسماء الله. اسم خدا رو می‌بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 853.04,
   "end": 856.9,
   "text": "آرامش میاد، نرمی دل میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 856.9,
   "end": 859.24,
   "text": "توجه کردید؟ این اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 859.24,
   "end": 861.94,
   "text": "اگر ورد نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 861.94,
   "end": 864.1,
   "text": "فقط تو دل باشه می‌شه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 864.1,
   "end": 867.76,
   "text": "\"واذكر الله ذكرا كثيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 867.76,
   "end": 870.14,
   "text": "تا می‌تونید یاد خدا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 870.14,
   "end": 873.26,
   "text": "اما اگر می‌خواید دلت نرم بشه اونو باید چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 873.26,
   "end": 876.0,
   "text": "بریزیش بیرون. ظهور بهش بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 876.0,
   "end": 880.26,
   "text": "ظهورش می‌شه ورد. یعنی به زبانت جاری کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 880.26,
   "end": 887.02,
   "text": "خواندن رو البته. یا الله، یا الله، یا الله چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 887.02,
   "end": 890.34,
   "text": "البته یا منادى می‌کنی یعنی مناداته، دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 890.34,
   "end": 892.26,
   "text": "وقتی نزدیک شدی می‌شه مناجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 892.26,
   "end": 894.8,
   "text": "نجوا در گوشیه. یایشو وردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 894.8,
   "end": 897.72,
   "text": "الله، الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 897.72,
   "end": 900.82,
   "text": "الله. به، به، به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 900.82,
   "end": 904.84,
   "text": "به. مثل اون از دعاهای بعد از نماز جعفر طیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 904.84,
   "end": 907.44,
   "text": "اول میگی یا ربه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 907.44,
   "end": 910.68,
   "text": "یا ربه، یا ربه تا نفس داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 910.68,
   "end": 912.76,
   "text": "بعد میگی یا رباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 912.76,
   "end": 915.54,
   "text": "یعنی رفتی نزدیک‌تر انگار خدا رو می‌خوای بغل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 915.54,
   "end": 917.94,
   "text": "یعنی پروردگار جانم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 917.94,
   "end": 921.5,
   "text": "خدا جونم اینطوری. یا رباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 921.5,
   "end": 924.24,
   "text": "بعد دیگه یایشم میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 924.24,
   "end": 926.7,
   "text": "میگی چی؟ ربه، ربه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 926.7,
   "end": 929.76,
   "text": "ربه، ربه. اصلا دیگه رفتی تو گوش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 929.76,
   "end": 932.44,
   "text": "دیگه نجواست. انقدر نزدیک شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 932.44,
   "end": 934.24,
   "text": "انشاالله عاقبتمون ختم به خیر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}