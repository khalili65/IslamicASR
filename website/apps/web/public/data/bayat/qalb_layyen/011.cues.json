 },
 "chapters": [
  {
   "index": 0,
   "title": "## اطعام فقرا و نرم‌کردن قلب",
   "start": 22.26,
   "end": 92.5
  },
  {
   "index": 1,
   "title": "## حق سائل و محروم در مال اغنیا",
   "start": 92.5,
   "end": 500.62
  },
  {
   "index": 2,
   "title": "## اطعام علی حبّه در سورهٔ انسان",
   "start": 500.62,
   "end": 543.32
  },
  {
   "index": 3,
   "title": "## سورهٔ بلد: یتیم ذا مقربة و مسکین ذا متربة",
   "start": 543.32,
   "end": 955.84
  },
  {
   "index": 4,
   "title": "## ضایع‌شدن مال به ترک زکات و صید به ترک تسبیح",
   "start": 955.84,
   "end": 1038.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.92,
   "end": 12.3,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.3,
   "end": 16.56,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.56,
   "end": 22.26,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 22.26,
   "end": 29.58,
   "text": "یکی دیگه از کارهایی که قلب رو نرم می‌کنه در بحث قلب لعين یا لين هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 29.58,
   "end": 36.32,
   "text": "و در آینه‌ی روایات و آیات داریم عرض می‌کنیم چه چیزهایی قلب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 36.32,
   "end": 39.28,
   "text": "نرم می‌کنه یا نرم نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 39.28,
   "end": 48.76,
   "text": "یکی دیگه از اون کارهایی که به تصریح آیات و روایات قلب انسان رو نرم می‌کنه یا نرم نگه می‌داره اطعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 48.76,
   "end": 52.04,
   "text": "فقرا و مساکین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 52.04,
   "end": 54.62,
   "text": "البته خصوصاً أيتام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 54.62,
   "end": 58.64,
   "text": "منتها اجازه بدید که بحث أيتام رو یه جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 58.64,
   "end": 60.86,
   "text": "به جهت اهمیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.86,
   "end": 63.24,
   "text": "جداگونه صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.24,
   "end": 65.36,
   "text": "فعلاً پیرامون اطعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.36,
   "end": 68.98,
   "text": "این اطعام ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.98,
   "end": 73.64,
   "text": "عرض شود بحث صدقه یه چیزه، اطعام یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.64,
   "end": 78.82,
   "text": "صدقه دادن، کمک کردن مالی و، و، و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.82,
   "end": 87.54,
   "text": "فروعی دارد. ما الآن توجه داشته باشید بحث اطعام رو داریم می‌گیم یعنی طعام کـ-- دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.54,
   "end": 89.92,
   "text": "و کسی رو سیر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.92,
   "end": 97.42,
   "text": "یه لقمه غذایی، چیزی ولو در ماه مبارک رمضان فرمودن ولو شده به یک دونه خرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.42,
   "end": 101.26,
   "text": "کسی رو افطار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.26,
   "end": 105.26,
   "text": "به شدت در نرم کردن دل‌ها این کار مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.26,
   "end": 112.18,
   "text": "قدیم‌ها یادش بخیر نونوایی‌ها البته الآن هم هست، الآن هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.18,
   "end": 115.28,
   "text": "و ولی خب قدیم‌ها خیلی بیشتر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.28,
   "end": 118.62,
   "text": "طوری که دیگه نونوایی‌ها شیفتی می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.62,
   "end": 122.32,
   "text": "که مخصوصاً تولدهای اهل بیت، خواسته کریم اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.32,
   "end": 124.56,
   "text": "نونوایی‌ها دیگه همه نونه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.56,
   "end": 127.62,
   "text": "کلاً نون‌هاشون چی بود؟ رایگان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.62,
   "end": 130.0,
   "text": "این بحث اطعام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.0,
   "end": 136.48,
   "text": "دقت بفرمایید که الآن تو هیأت‌هان قبل از اینکه من چند تا روایت و آیه تقدیم کنم، تو هیئت‌هان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.48,
   "end": 139.26,
   "text": "خیلی الحمد لله مرسوم شده و این‌ها؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.26,
   "end": 144.92,
   "text": "این رو امام صادق صلی الله علیه ابداع کردن در جلسات روضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.92,
   "end": 147.68,
   "text": "اولاً در ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.68,
   "end": 154.7,
   "text": "دعوت به سمت حضرت حق که توسط پیغمبر از مشهد اسلام رخ داد، اولین دعوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.7,
   "end": 157.38,
   "text": "پیغمبر همراه با یه آبگوشت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.38,
   "end": 160.04,
   "text": "یه آبگوشت چرب و چلی و خوشمزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.04,
   "end": 163.44,
   "text": "پیغمبر خودشون بار گذاشتن روایت میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.44,
   "end": 167.5,
   "text": "و چند تا گوسفند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.5,
   "end": 170.24,
   "text": "درست و درمان ذبح شد و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.24,
   "end": 172.38,
   "text": "فامیل‌ها رو پیغمبر دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.38,
   "end": 174.22,
   "text": "خب می‌تونست همین‌طوری دعوت کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.22,
   "end": 175.9,
   "text": "دعوت حق هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.9,
   "end": 178.14,
   "text": "شکم خالی. نه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.14,
   "end": 182.7,
   "text": "اطعام کرد. یعنی این از اولش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.7,
   "end": 191.02,
   "text": "بعد حالا بعد که امام صادق صلی الله علیه جلسات روضه رو راه انداختن، حالا به روایت اون منزلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.02,
   "end": 193.96,
   "text": "بالای شارع شریعه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.96,
   "end": 196.66,
   "text": "فرات نه ها شریعه علقم اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.66,
   "end": 200.22,
   "text": "من منتسب به حضرته. اونجا میگن که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.22,
   "end": 203.38,
   "text": "دهه می‌گرفته یا مثلاً شب‌های جمعه روضه می‌گرفته اطعام می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.38,
   "end": 207.64,
   "text": "بدون استثناء امام صادق صلی الله علیه اطعام می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.64,
   "end": 210.1,
   "text": "خب اون موقع یکی از راه‌های اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.1,
   "end": 214.36,
   "text": "نرم کنن حتی دل مردم رو نسبت به حقایق دین همین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.36,
   "end": 217.28,
   "text": "غالب مردم گرفتاری‌های مالی داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.28,
   "end": 219.92,
   "text": "مشکلات اقتصادی داشتن با همین‌ها جذب می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.92,
   "end": 222.74,
   "text": "الآنم شما دقت بکنید چیز بدی هم نیست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.74,
   "end": 227.3,
   "text": "چیز بدی هم نیست. معمولاً این‌چنینه هیئتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.3,
   "end": 231.04,
   "text": "غذا می‌ده شلوغ‌تره. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.04,
   "end": 236.52,
   "text": "خوبم هست که بگیم بده. اگرچه اصل اون محتوای هیئته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.52,
   "end": 239.86,
   "text": "اما خب یه سنته، سنت حسنه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.86,
   "end": 241.86,
   "text": "بعد هم دل‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.86,
   "end": 244.84,
   "text": "گرم می‌کنه، جذب می‌کنه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.84,
   "end": 250.56,
   "text": "که بیان بشینن دو کلام حرف حق بشنون هم اینکه خود اون طرفی که بانیه دلش نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.56,
   "end": 254.36,
   "text": "آثارش رو می‌بینه. قطعاً آثارش رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.36,
   "end": 259.94,
   "text": "ولو شده به یک-- میگن تو ماه مبارک رمضان حتی میگه دیگه یک، یک خرما، یک خرما دیگه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.94,
   "end": 262.78,
   "text": "ببین چقدر تأثیر داره. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.78,
   "end": 266.2,
   "text": "ایام، ایامی که دل‌ها باید نرم بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.2,
   "end": 268.8,
   "text": "و انقدر این قصه مهمه، انقدر این قصه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.8,
   "end": 272.24,
   "text": "یه زمانی حالا ما مثلاً با یه بانی بحثمون شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.24,
   "end": 274.32,
   "text": "خیلی کمک‌های خوبی به خیریه ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.32,
   "end": 277.7,
   "text": "یه بحث کوچولی بین ما جدلی پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.7,
   "end": 281.38,
   "text": "یکی از رفیق‌های چیز فهم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.38,
   "end": 284.36,
   "text": "نهیب زد به من که گفت حاجی حق وظیفشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.36,
   "end": 286.1,
   "text": "چی داری میگی تو؟ این وظیفشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.1,
   "end": 289.36,
   "text": "داره حسابی هم داره. وظیفشه کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.36,
   "end": 292.28,
   "text": "این آیه‌شه. آیه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.28,
   "end": 298.06,
   "text": "ذاریات آیه نوزده. می‌فرماید \"و فی اموالهم حق للسائل والمحروم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.06,
   "end": 301.06,
   "text": "ها؟ \"حق للسائل والمحروم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.06,
   "end": 305.4,
   "text": "تو اموال اون‌ها حقی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.4,
   "end": 311.58,
   "text": "برای همونایی که سؤال می‌کنن، همونایی هم که سؤال نمی‌کنن اما محرومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.58,
   "end": 315.08,
   "text": "حق اون‌هاست. باید این‌ها بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.08,
   "end": 319.12,
   "text": "آیه نوزده سوره ذاریات آقا محسن نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.12,
   "end": 323.5,
   "text": "اشتباه نگفته باشم. \"و فی اموالهم حق للسائل والمحروم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.5,
   "end": 326.28,
   "text": "که در حکمت سیصد و بیست و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.28,
   "end": 333.96,
   "text": "نهج‌البلاغه امیرالمؤمنین چنین می‌فرمایند \"ان الله سبحانه فرض فی اموال الاغنیا اقوات الفقراء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.96,
   "end": 340.36,
   "text": "اصلاً خدا فرض کرده، قرار داده تو اموال اونایی که ثروتمندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.36,
   "end": 343.3,
   "text": "قوت کیو؟ فقرا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.3,
   "end": 346.98,
   "text": "اصلاً خدا قرار داده اونجا فرض کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.98,
   "end": 352.5,
   "text": "که \"فما جاء فقیر الا بما متع به غنی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.5,
   "end": 358.2,
   "text": "الله اکبر. هیچ کسی فقیر نمی‌شه، گرسنه نمی‌شه \"فما جاء فقیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.2,
   "end": 360.52,
   "text": "هیچ فقیر گرسنه نمی‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.52,
   "end": 364.46,
   "text": "\"الا بما متع به غنی\" مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.46,
   "end": 371.94,
   "text": "یه تمتی ثروتمندی پیدا کرده و حق اون محروم رو، اون فقیر رو نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.94,
   "end": 377.34,
   "text": "و الا اون گرسنه نمیموند. \"والله والله تعالى سائله عن ذلک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.34,
   "end": 385.68,
   "text": "امیرالمؤمنین داره می‌فرماید والله تعالى لفظ رو ببینید، اسم رو ببینید والله لفظ جلاله دوباره تعالى هم تأکید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.68,
   "end": 390.52,
   "text": "که یه همچه ال با شخص با عظمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.52,
   "end": 393.7,
   "text": "یعنی الله تعالی چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.7,
   "end": 396.84,
   "text": "سائله عن ذلک ازشون سؤال می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.84,
   "end": 401.2,
   "text": "از اینا که دارن چی کار کردی نسبت به اینایی که ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.2,
   "end": 409.12,
   "text": "وظیفتو انجام دادی یا نه؟ البته این رو باید توجه داشت که بر اساس آیه هشت و نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.12,
   "end": 414.76,
   "text": "الحمد لله ما جز قرآن و روایات و گفتار بزرگان چیزی نداریم تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.76,
   "end": 418.04,
   "text": "تصریحاً اینجا بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.04,
   "end": 421.76,
   "text": "اخلاص در این دادن و این اطعام شرطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.76,
   "end": 426.96,
   "text": "هرچی تو مخلص‌تر باشی در اطعام دلت بیشتر نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.96,
   "end": 431.92,
   "text": "در این آیه‌ای که می‌دونید امام حسن و امام حسین قابل توجهه اینایی که تا به امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.92,
   "end": 438.52,
   "text": "انسان کامل و امام زمانشون که می‌رسن میگن آقا، آقا به گرفتارم مریضمو شفا بده فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.52,
   "end": 440.72,
   "text": "و همش این مطلقاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 440.72,
   "end": 443.78,
   "text": "چیزهای متعارف از حضرت می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.78,
   "end": 448.04,
   "text": "و به هر حال می‌خوان حضرت دست تصرف دراز کنه در کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.04,
   "end": 452.92,
   "text": "دیگه نمیگه که بابا او هم خدا دارد و خداست و دارد خدایی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.92,
   "end": 455.36,
   "text": "امام حسن و امام حسین مریض شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.36,
   "end": 458.24,
   "text": "نمی‌تونست امیرالمؤمنین خودش اسم اعظم نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.24,
   "end": 461.16,
   "text": "اشاره کنه اونا خوب بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.16,
   "end": 465.1,
   "text": "چرا این کارو نکرد؟ به صورت طبیعی زندگی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.1,
   "end": 467.2,
   "text": "سه روز روزه گرفتن. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.2,
   "end": 468.84,
   "text": "که امام حسن این خوب بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.84,
   "end": 470.68,
   "text": "تب شدیدی عارض شده بود بهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.68,
   "end": 473.96,
   "text": "عارضی بود دیگه اینا دیگه ذاتی نبود این مریضی‌ها که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.96,
   "end": 477.56,
   "text": "این که انسان کاملن اعدل امذجه امذجه نباید مریض شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.56,
   "end": 482.14,
   "text": "از بیرون اومده بود. به هر حال روزه گرفتن بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.14,
   "end": 485.32,
   "text": "چی شد؟ یه شب مسکین، یه شب یتیم، یه شب اسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.32,
   "end": 489.26,
   "text": "دیگه می‌دونید اون بدن این‌ها افطارشونو دادن و هیچی نخوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.26,
   "end": 492.22,
   "text": "سه روز آب خوردن. شوخی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.22,
   "end": 495.82,
   "text": "حرف زدنش آسونه. اما همه اینا رو برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.82,
   "end": 500.62,
   "text": "می‌فرماید \"ویطعمون الطعام على حبه مسكينا ویتيما وأسيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.62,
   "end": 504.44,
   "text": "اولا على حبه با عشق این کارو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.44,
   "end": 512.38,
   "text": "بعدم \"انما نطعمکم\" حواستون جمع باشه‌ها ما شما رو اطعام کردیم \"لوجه الله\" فقط برای رضای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.38,
   "end": 517.14,
   "text": "وجه خدا، اون صورت حق راضی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 517.14,
   "end": 521.26,
   "text": "الله اکبر. \"لا نريد منکم جزاء ولا شكورا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.26,
   "end": 523.82,
   "text": "نه جزایی، نه شکرگزاری، هیچی از شما نمی‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.82,
   "end": 531.88,
   "text": "حالا ما معمولا اینطوری هستش که برای خدا هم حتی به کسی ببخشیم اینو ثبت می‌کنیم به گوشه ذهنمون یه زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.88,
   "end": 534.26,
   "text": "بریم سراغ طرف و بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.26,
   "end": 540.58,
   "text": "آره از دلش درآریم. در آیات چهارده، پونزده و شونزده سوره بلد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.58,
   "end": 543.32,
   "text": "باز اصرار داره به اینجا، به این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.32,
   "end": 547.22,
   "text": "\"أو اطعام في يوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.22,
   "end": 552.48,
   "text": "ذي مسغبة\". اون روزی که گرسنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.48,
   "end": 554.44,
   "text": "ذي مسغبة یعنی کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.44,
   "end": 559.78,
   "text": "دیگه از گرسنگی شدت گرفته گرسنگی این شکم چسبیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.78,
   "end": 561.66,
   "text": "به این شکل. می‌فرماید أو اطعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.66,
   "end": 566.4,
   "text": "اینا آیا نمی‌خوان طعامی کنن برای اون روز ذخیره‌ی اون روزشون کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.4,
   "end": 570.5,
   "text": "گرسنگی روز قیامت. \"یتيما ذا مقربة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.5,
   "end": 573.64,
   "text": "حالا کیا رو؟ کیا رو اطعام کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.64,
   "end": 575.56,
   "text": "سری اول میگه چی؟ یتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.56,
   "end": 577.8,
   "text": "\"یتيما ذا مقربة\". اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.8,
   "end": 579.76,
   "text": "ن-- از غربا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.76,
   "end": 582.74,
   "text": "یعنی ن-- هرچی نزدیک‌تر باشه یتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.74,
   "end": 588.12,
   "text": "بعضیا بی‌خیال نزدیکان خود و خانواده و خویشان و فامیل و همسایه ها میرن به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.12,
   "end": 591.76,
   "text": "اول اطرافیان. ذا مقربة یتیمی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 591.76,
   "end": 594.82,
   "text": "بعد می‌فرماید \"أو مسكينا ذا متربة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.82,
   "end": 598.86,
   "text": "تراب، خاک. مسکینی که افتاده رو خاک دیگه اصلا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.86,
   "end": 603.66,
   "text": "ببینید یه فرقی هم بین فقیر و مسکین و مستکین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.66,
   "end": 606.3,
   "text": "هرچی آدم بتونه این‌ها رو رعایت کنه خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.3,
   "end": 609.04,
   "text": "فقیر خب نداره اما هنوز مسکین نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.04,
   "end": 614.04,
   "text": "مسکین یعنی ساکن افتاده، ساکن شده یه جا نشسته نمی‌تونه دیگه راه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.04,
   "end": 616.3,
   "text": "انقدر که درد منده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.3,
   "end": 619.26,
   "text": "مستکین چی؟ کمرش هم شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.26,
   "end": 623.42,
   "text": "اصلا دیگه کسی هم بیاد دستشم بگیره بلند کنه نمی‌تونه راه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.42,
   "end": 629.26,
   "text": "اینا با هم فرق می‌کنن و کمک کردن به این‌ها هم اون کسی که از همه وضعیتش بدتره قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.26,
   "end": 634.18,
   "text": "بهتره. حالا اول اینجا کی رو مقدم می‌کنه خدا تو این اطعام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.18,
   "end": 637.22,
   "text": "یتیم رو. حالا گفتم اجازه بدید یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.22,
   "end": 639.24,
   "text": "وقت بهتری. یه روایت هم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.24,
   "end": 642.74,
   "text": "این روایت خیلی شیرینه. مخصوصا انتهای روایت خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 642.74,
   "end": 647.3,
   "text": "همه عالیه، همه عالی. بالاخره کلمات اون معصومین است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.3,
   "end": 650.02,
   "text": "حالا به هر حال به ذائقه ما بیشتر می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 650.02,
   "end": 655.38,
   "text": "امام صادق صلی الله علیه فرمودند \"انما وضعت زكاة اختبار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.38,
   "end": 662.2,
   "text": "للأغنياء\". اصلاً اینکه زکات تشریع شده برای امتحان اغنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.2,
   "end": 667.56,
   "text": "زکات مالتو بده. حتی عالم \"زكاة العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.56,
   "end": 673.8,
   "text": "نشره\". تو عالم شدی بفرما ببینم بخل داری تو انتشار حقایق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 673.8,
   "end": 677.36,
   "text": "یا حتی میگه زکات عفه-- زکات زیبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 677.36,
   "end": 679.68,
   "text": "همه چی زکات داره. روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.68,
   "end": 683.42,
   "text": "همه چی زکات داره. مثلا زکات زیبایی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 683.42,
   "end": 686.38,
   "text": "عفت. عفت پیشه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 686.38,
   "end": 688.5,
   "text": "حالا بحث اونجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.5,
   "end": 694.98,
   "text": "می‌فرماید تشریع به جهت امتحان اغنیاست از حیث زکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.98,
   "end": 700.48,
   "text": "\"ومعونة للفقراء\" برای اینکه کمک حالی برای فقرا باشه زکات واجب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.48,
   "end": 706.44,
   "text": "\"ولو ان الناس ادّوا زكاة اموالهم ما بقي مسلم فقيرا محتاجا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.44,
   "end": 711.3,
   "text": "اگر همه مردم زکاتشونو می‌دادن هیچ مسلمون فقیر محتاجی باقی نمیموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.3,
   "end": 715.08,
   "text": "چرا زمانی که امام عصر صلوات الله علیه ایشالله ظهور کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 715.08,
   "end": 717.32,
   "text": "میگن هیچ، اصلاً باب فقر بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 717.32,
   "end": 723.16,
   "text": "هیچ فقیر نیست. هرچی می‌گردی حتی میگن من یه روایت دیدم که طرف میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.16,
   "end": 725.52,
   "text": "کمک می‌خواد از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 725.52,
   "end": 729.18,
   "text": "بعد همه بهش نهیب بزنن خجالت بکش بسه دیگه چقدر می‌خواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 729.18,
   "end": 732.02,
   "text": "چقدر می‌گیری؟ تو که همه چی داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 732.02,
   "end": 735.84,
   "text": "اینجوریه. میگه مثلا همه چی داره بازم تقاضا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 735.84,
   "end": 741.86,
   "text": "اصلا باب-- برای همین میگه قبل از اینکه ظهور اتفاق بیفته صدقه‌هاتو بده اطعام تو بکن کمکتو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 741.86,
   "end": 744.1,
   "text": "اینجا دیگه بابش بسته می‌شه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 744.1,
   "end": 750.38,
   "text": "تموم می‌شه. باز می‌فرماید \"ولا-- ولستغنی بما فرغ الله له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 750.38,
   "end": 754.92,
   "text": "اصلا دیگه به اونچی که خدا فرض کرده یعنی زکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 754.92,
   "end": 757.82,
   "text": "دیگه همه غنی می‌شدن اگه این اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 757.82,
   "end": 761.56,
   "text": "هیچکس مشکل مالی نداشت. متاسفانه اسلام پیاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 761.56,
   "end": 766.78,
   "text": "\"وإن الناس مفتقر ولاحتاج ولاعاج ولاعروا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 766.78,
   "end": 769.22,
   "text": "إلا بذنوب الأغنياء\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 769.22,
   "end": 771.36,
   "text": "دیگه هیچکس گرسنه نمی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 771.36,
   "end": 774.78,
   "text": "هیچکس محتاج نمی‌شه. هیچکس برهنه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 774.78,
   "end": 777.72,
   "text": "فقیر و محتاج و گرسنه و برهنه و اینا هیچکس نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 777.72,
   "end": 779.92,
   "text": "الا به چی؟ بذنوب الأغنياء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 779.92,
   "end": 785.48,
   "text": "مگر اینکه اینایی که دارن ثروتمندا اینا گناه می‌کنن که اونا گرفتار می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 785.48,
   "end": 788.36,
   "text": "دادشو خدا قیامت سر اینا می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 788.36,
   "end": 795.18,
   "text": "و جالبه بدونید خداوند متعال با اون عظمتش قیامت از دو کس عذرخواهی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 795.18,
   "end": 799.64,
   "text": "اگه گفتید کیان؟ یکیشو بگم یکیش باشه طلبه‌تون روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 799.64,
   "end": 801.84,
   "text": "یکیش اق-- اونایین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 801.84,
   "end": 805.68,
   "text": "فقیر بودن، گرفتار شده، گرفتاری‌های مالی داشتن تو دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 805.68,
   "end": 809.28,
   "text": "خداست، رازق علی الاصلابه عذرخواهی می‌کنه از بنده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 809.28,
   "end": 813.48,
   "text": "خیلی درد سنگینیه. اما دادشو سر کی می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 813.48,
   "end": 816.96,
   "text": "اغنیا. حالا اینجاش خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 816.96,
   "end": 820.16,
   "text": "ما ذا مال. دیدی بعضیا یهو مالشونا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 820.16,
   "end": 824.98,
   "text": "یه رفیقی داشتیم مال تجاره خوبی داشت، مغازه خیلی عالی و بزرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 824.98,
   "end": 827.12,
   "text": "بعد یهو دزد همه چیشو برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 827.12,
   "end": 830.7,
   "text": "هرچی تو مغازه رحم نکرده بود همه رو برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.7,
   "end": 833.08,
   "text": "یه روز درد دل برای من می‌کرد. هیئت ما می‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 833.08,
   "end": 836.48,
   "text": "ما از سوریه رفته بودیم. گفت حاجی من همه کارو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 836.48,
   "end": 842.24,
   "text": "گفتم که داداش ببین نمازتو اول، اول گفتم نماز، نمازتو اول وقت می‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 842.24,
   "end": 846.86,
   "text": "نماز صبح مخصوصا. گفت آره به خدا حاجی همیشه اصلا نماز صبح مسجدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 846.86,
   "end": 850.24,
   "text": "هرچی فکر کردم به ذهنم خطور کرد اصلاً فکر نمی‌کردم ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.24,
   "end": 852.3,
   "text": "خمس نده. گفتم خمس میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 852.3,
   "end": 854.75,
   "text": "گفت حاجی این یدونه رو بی‌خیال شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 854.75,
   "end": 856.36,
   "text": "گفتم بی‌خیال شد همین شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 856.36,
   "end": 861.7,
   "text": "همش رفت به باد فنا. ضمانت الهی کس که خمس بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 861.7,
   "end": 863.64,
   "text": "زکات و خمسش رو بده خدا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 863.64,
   "end": 867.5,
   "text": "مالشو حفظ می‌کنه. دیدی بعضیا یه دفعه مالشون رو از دست میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 867.5,
   "end": 872.7,
   "text": "ضایع می‌شه. مثلا حتی اینایی که خیلی دارن یهو کشتی‌شون غرق می‌شه یا تو گمرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 872.7,
   "end": 875.0,
   "text": "مالشونو نگه می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 875.0,
   "end": 876.86,
   "text": "نمی‌دونم مالیات سنگین می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 876.86,
   "end": 879.72,
   "text": "چه، چه اینا متن روایتو بخونم براتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 879.72,
   "end": 881.88,
   "text": "از خودم نیست‌ها. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 881.88,
   "end": 885.6,
   "text": "\"ما ذا مال فی بر ولا بحر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 885.6,
   "end": 888.36,
   "text": "اصلا ضایع نمی‌شه مالی. چه تو خشکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 888.36,
   "end": 890.38,
   "text": "چه تو آب. یعنی سوار کشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 890.38,
   "end": 893.56,
   "text": "مالش ضایع می‌شه. الا به چی به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 893.56,
   "end": 896.88,
   "text": "به ترک زکات. زکاتشو نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 896.88,
   "end": 899.16,
   "text": "اون اضافه‌شو نداده و حقش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 899.16,
   "end": 902.54,
   "text": "که خدا قرار داده بوده و حق السائل و المحروم نداده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 902.54,
   "end": 904.68,
   "text": "ضایع شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 904.68,
   "end": 909.04,
   "text": "خیلی شیرین اینجا بس \"وما صید صید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 909.04,
   "end": 911.6,
   "text": "فی بر ولا بحر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 911.6,
   "end": 913.64,
   "text": "البته من روایتو کامل نخوندم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 913.64,
   "end": 916.26,
   "text": "دیگه آخرشو دیگه چون وقت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 916.26,
   "end": 919.76,
   "text": "خیلی شیرین می‌فرماید صید نمی‌شه هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 919.76,
   "end": 923.3,
   "text": "صیدی. چه در دریا، چه در بیابان و خشکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 923.3,
   "end": 928.48,
   "text": "الا به چی؟ مثلا هیچ حیوونی چه آبزی باشه مثل ماهیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 928.48,
   "end": 931.38,
   "text": "چه خشک زیبا یا مثل هرکی تو خشکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 931.38,
   "end": 933.98,
   "text": "گوسفند و گاو همه مطلقاً پرنده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 933.98,
   "end": 935.66,
   "text": "اینا صید نمی‌شن الا به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 935.66,
   "end": 940.98,
   "text": "\"الا بترك التسبيح في ذلك اليوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 940.98,
   "end": 943.24,
   "text": "اون روز تسبیحش ترک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 943.24,
   "end": 945.82,
   "text": "آنی که غافل می‌شه صید می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 945.82,
   "end": 948.64,
   "text": "ببینید روایت، تا پرنده تو هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 948.64,
   "end": 950.62,
   "text": "غافل از خدا شد صید می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 950.62,
   "end": 952.52,
   "text": "اصلا نمی‌شه غیر از این باشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 952.52,
   "end": 955.84,
   "text": "چون \"يسبح لله ما في السماوات وما في الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 955.84,
   "end": 959.38,
   "text": "باید آنفاً تسبیح کنه. نکنه از دایره خلقت خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 959.38,
   "end": 962.08,
   "text": "طورش عوض می‌شه. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 962.08,
   "end": 966.72,
   "text": "این رو چرا بعد از بحث زکات تسبیح رو آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 966.72,
   "end": 969.64,
   "text": "که خود تسبیح نرم‌کننده دله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 969.64,
   "end": 972.06,
   "text": "ذکر. کأنَّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 972.06,
   "end": 975.2,
   "text": "انفاق و اطعام. اطعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 975.2,
   "end": 978.46,
   "text": "و بخشیدن، دادن زکات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 978.46,
   "end": 982.32,
   "text": "کأنَّ همون اثری رو داره که تسبیح داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 982.32,
   "end": 984.58,
   "text": "تسبیح چگونه یاد خدا دل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 984.58,
   "end": 990.34,
   "text": "نرم می‌کنه؟ همونطور زکات دادن، خمس دادن، صدقه دادن، اطعام به خصوص اطعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 990.34,
   "end": 992.6,
   "text": "چیکار می‌کنه؟ همون اثر رو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 992.6,
   "end": 995.44,
   "text": "وجود انسان می‌ذاره. نرم می‌کنه دلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 995.44,
   "end": 998.2,
   "text": "بعد میگه نمی‌دونم چرا نمی‌تونم برای امام حسین گریه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 998.2,
   "end": 1002.88,
   "text": "چند وقت پیش یکی به من می‌گفت. می‌گفت حاجی من بچه بودم خوش اشک بودم الان خشک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1002.88,
   "end": 1006.26,
   "text": "چی بگم بهش؟ چی بگم من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1006.26,
   "end": 1014.34,
   "text": "آخه یکی دو تا که نیست درد. بعد اون طرف رفته به اسم کار فرهنگی کلی کار کرده و وضع مالیش توپ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1014.34,
   "end": 1020.74,
   "text": "بعد یه کسی مثل با لباس پیغمبر مثلا بهش میگه ما یه خیریه‌ای داریم صد تا خونواده تحت پوششم بیست تا یتیمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1020.74,
   "end": 1022.66,
   "text": "یه کمکی در این قضیه تومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1022.66,
   "end": 1025.86,
   "text": "باشه حالا ببینیم چی می‌شه. بله باید هم اشکت خشک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1025.86,
   "end": 1029.8,
   "text": "نوش جونت. ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1029.8,
   "end": 1032.98,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1032.98,
   "end": 1035.62,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1035.62,
   "end": 1038.68,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}