   "title": "## خواب پس از غذا و قساوت",
   "start": 737.32,
   "end": 919.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.5,
   "text": "چه چیزهایی در خوردن قلب رو نرم میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 10.8,
   "text": "ما اونچه که پیرامون نرمی دله بعضیاش رو بحث کردیم جوانحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.8,
   "end": 13.52,
   "text": "مثل خشیت مثل، مثل اخلاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.52,
   "end": 15.94,
   "text": "بعضیا جوارحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.94,
   "end": 19.54,
   "text": "یعنی باید بدنت عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.54,
   "end": 24.02,
   "text": "یه چیزایی هست که خوردنش قلب رو نرم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.02,
   "end": 27.56,
   "text": "شنیده بودید اینا رو؟ بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.56,
   "end": 33.82,
   "text": "لئین یا لَین با خوردن رابطه مستقیم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.82,
   "end": 38.08,
   "text": "می خوام چند تا روایت تو این زمینه تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.08,
   "end": 44.44,
   "text": "مثلا در کافی کلینی اعلا الله مقامه الشریف جلد شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.44,
   "end": 49.5,
   "text": "وقتی میگم جلد شش یعنی این چاپ‌های جدیده دیگه قدیمیا چهار جلدی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.5,
   "end": 53.12,
   "text": "صفحه سیصد و چهل و سه میتونید این روایت رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.12,
   "end": 55.9,
   "text": "امام صادق سلام الله علیه ببینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.9,
   "end": 60.7,
   "text": "ایشون فرمودن \"شکا رجل الی نبی الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.7,
   "end": 63.56,
   "text": "یه نفر اومد پیش پیغمبر شکایت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.56,
   "end": 66.56,
   "text": "چی گفت؟ \"قسوة القلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.56,
   "end": 71.28,
   "text": "پیغمبر من دلم قسی شده، سخت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.28,
   "end": 75.74,
   "text": "از اون نرمی خارج شده. \"فقال له\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.74,
   "end": 77.74,
   "text": "پیغمبر می خواد بهش دستور العمل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.74,
   "end": 81.26,
   "text": "خب دیگه پیغمبره دیگه درون افراد رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.26,
   "end": 84.46,
   "text": "شاید منو ببینه ایشون بگه عدس بخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.46,
   "end": 90.24,
   "text": "کار دیگه‌ای انجام بده. اما به هر حال این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.24,
   "end": 92.74,
   "text": "نشون میده که یک دستور عمومیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.74,
   "end": 96.3,
   "text": "چون جاهای دیگه هم اهل بیت توصیه داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.3,
   "end": 98.0,
   "text": "و الان هم این ثابت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.0,
   "end": 102.2,
   "text": "\"علیک بالعدس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.2,
   "end": 105.36,
   "text": "یادش بخیر آقا محسنم که هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.36,
   "end": 108.54,
   "text": "یه زمانی ما شبای جمعه هیئتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.54,
   "end": 113.52,
   "text": "از سی و پنج سال پیش که شروع کرده بودیم ثابت عدسی میدادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.52,
   "end": 115.44,
   "text": "هر شب جمعه یکی بانیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.44,
   "end": 120.88,
   "text": "اصلا بچه ها خوش اشک‌تر بودن تا الان که چلو مرغ میدیم و چلو کباب میدیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.88,
   "end": 125.62,
   "text": "حالا شاید بگن هیئت‌تون کجاست ما بیایم چلو مرغ و چلو کباب گرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.62,
   "end": 133.62,
   "text": "نه حالا بعضی موقع‌ها میدیم. بله فرمودن \"علیک بالعدس فانه يرقق القلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.62,
   "end": 138.74,
   "text": "پیغمبر فرمود عدس قلب رو رقیق میکنه، نرم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.74,
   "end": 141.02,
   "text": "دیگه چی؟ \"ويسرع الدمع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.02,
   "end": 144.26,
   "text": "اشک رو جاری میکنه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.26,
   "end": 146.9,
   "text": "اشک رو زیاد میکنه عدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.9,
   "end": 149.88,
   "text": "حالا چه خصوصیتی در عدس هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.88,
   "end": 153.9,
   "text": "این باید بحث بشه و اصلا ربط این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.9,
   "end": 162.78,
   "text": "این حالا یک موجود دیگه، یه نباته با اشک، با قلب، قلب که یک خصوصیت مجرد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.78,
   "end": 167.38,
   "text": "منظور اون قلب صنوبری ظاهری نیست که، که می تپه این گوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.38,
   "end": 169.78,
   "text": "نه، اون قلب مجرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.78,
   "end": 174.98,
   "text": "اون روح ما. چه ربطی داره بین این ماده و اون مجرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.98,
   "end": 177.28,
   "text": "اینا دیگه اسرار عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.28,
   "end": 178.88,
   "text": "چی در عدسه که باعث میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.88,
   "end": 181.06,
   "text": "حالا رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.06,
   "end": 183.84,
   "text": "روایت دیگه از شیخ طبرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.84,
   "end": 185.96,
   "text": "صفحه صد و هفتاد و هفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.96,
   "end": 191.62,
   "text": "مکارم الاخلاق. حالا ما میگیم شیخ طبرسی شما میشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.62,
   "end": 197.16,
   "text": "دیگه شیخ طبرسی همونه که اینجا داستانشو گفتم دفنش کردن شب اول قبر زنده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.16,
   "end": 200.48,
   "text": "یعنی نمرده بود بیچاره فکر میکردن مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.48,
   "end": 203.08,
   "text": "سکته قلبی کرده بود. قدیم‌ها نگه میداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.08,
   "end": 210.56,
   "text": "الان اینطوری نیست. قدیم‌ها تا سه روزم نگه میداشتن کسی سکته قلبی میکرد بگن شاید برگرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.56,
   "end": 212.96,
   "text": "و بر بعضیا هم برمیگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.96,
   "end": 215.22,
   "text": "دفنش کردن بیچاره‌ی ایشونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.22,
   "end": 220.64,
   "text": "بعد تو قبر زنده شد. حالا داستان داره مفصل قبلا گفتیم چجوری شد که از قبر اومد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.64,
   "end": 224.94,
   "text": "تو قبر نذر کرد که عمرشو برای قرآن وقف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.94,
   "end": 227.4,
   "text": "خدا نجاتش داد. حالا چجوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.4,
   "end": 230.76,
   "text": "قبلا گفتم از قبر بیرونش آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.76,
   "end": 233.92,
   "text": "و ایشون سی جل تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.92,
   "end": 238.94,
   "text": "البیان رو، مجموعه البیان رو نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.94,
   "end": 242.32,
   "text": "بعد از اینکه از قبر اومد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.32,
   "end": 247.9,
   "text": "می فرمود که امام صادق سلام الله علیه بر از نقل رسول الله فرمودن که باز فرمایش نبوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.9,
   "end": 250.18,
   "text": "\"من اکل دبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.18,
   "end": 254.62,
   "text": "دبا چیه؟ کی میدونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.62,
   "end": 258.82,
   "text": "دبا به عربی. عرب نداریم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.82,
   "end": 265.58,
   "text": "دبا کدوئه. پیغمبر فرمود \"من اکل دبا بالعدس\" یعنی اینا رو با هم ممزوج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.58,
   "end": 269.9,
   "text": "یعنی یه آشی درست کنه که توش هم کدو داره هم عدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.9,
   "end": 272.7,
   "text": "\"رق قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.7,
   "end": 274.56,
   "text": "عند ذکر الله عز وجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.56,
   "end": 278.52,
   "text": "بعضیا میگن پس چطور، چگونه‌ست که یه کسی تا ذکر خدا میگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.52,
   "end": 282.6,
   "text": "قرآن می شنوه، روضه می شنوه سریع چشمش پر اشک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.6,
   "end": 286.5,
   "text": "اینجا بودن یه چند نفری بودن من حرف میزدم هر روز حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.5,
   "end": 289.26,
   "text": "بعضی، بعضی روزهاشون من دلم تنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.26,
   "end": 292.26,
   "text": "یه پیرمردی بود دیگه هم ندیدیم ایشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.26,
   "end": 295.5,
   "text": "ریش سفیدی بود اینجا میشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.5,
   "end": 298.24,
   "text": "اسمشونو من اصلا نمی‌دونم چی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.24,
   "end": 302.08,
   "text": "هر وقت من صحبت می‌کردم با حرفای ما اشک می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.08,
   "end": 305.82,
   "text": "مثل که بعضیاشون می‌خندید هروقت به حرف‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.82,
   "end": 308.7,
   "text": "اینم شیرینه ها. اینم بالاخره بد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.7,
   "end": 314.26,
   "text": "اما ایشون اشک می‌ریخت. چگونه‌ست که یکی اشک می‌ریزه یکی نمی‌ریزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.26,
   "end": 317.76,
   "text": "پیغمبر فرمود کی؟ \"عند ذکر الله عز وجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.76,
   "end": 323.24,
   "text": "می‌خوای اینطوری بشه؟ کدو رو با عسل قاطی کن بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.24,
   "end": 325.18,
   "text": "ها؟ کدو رو با عدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.18,
   "end": 328.76,
   "text": "عذر. گفتم عسل؟ حالا عسل هم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.76,
   "end": 332.12,
   "text": "بحار جلد شصت و سه صفحه صد و هشتاد و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.12,
   "end": 336.14,
   "text": "پیغمبر باز فرمود \"من احب ان يرق قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.14,
   "end": 340.4,
   "text": "فلیأكل البلس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.4,
   "end": 344.62,
   "text": "بلس چیه؟ عربا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.62,
   "end": 348.42,
   "text": "پیغمبر ترجمه، ترجمه کرده \"يعني تين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.42,
   "end": 352.12,
   "text": "تین چیه؟ \"والتين والزيتون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.12,
   "end": 355.46,
   "text": "آفرین انجیره دیگه. تو قرآن هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.46,
   "end": 366.18,
   "text": "فرمودن که اگر می‌خواید دلت نرم بشه، رقيق القلب بشی، پیغمبر فرمود کسی دوست داره رقيق القلب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.18,
   "end": 369.42,
   "text": "چیکار کنه؟ انجیر بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.42,
   "end": 372.34,
   "text": "حالا زیاده من بخوام اینطوری بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.34,
   "end": 377.32,
   "text": "چند تا تقدیم می‌کنم. مثلا در تفسیر علیاشی از امام صادق اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.32,
   "end": 382.4,
   "text": "اصلا سر اینکه این راه ربط بین خوردنی‌ها و حالات انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.4,
   "end": 385.4,
   "text": "چرا خوردن خون حرامه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.4,
   "end": 389.76,
   "text": "امام صادق در همین تفسیر فرمودن به جهت کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.76,
   "end": 396.26,
   "text": "خون بخوره قسی القلب میشه و خود حضرت فرمودن احتمال داره کار به جایی برسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.26,
   "end": 399.58,
   "text": "فرزندش رو یا پدر و مادرشو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.58,
   "end": 401.16,
   "text": "قسی القلب میکنه آدم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.16,
   "end": 404.46,
   "text": "ببینید حیواناتی که خونخوارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.46,
   "end": 409.4,
   "text": "قسی-- اصلا جزو سبعان یعنی وحشه، وحشی‌ان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.4,
   "end": 415.1,
   "text": "خونخوارها. اما اونایی که نبات میخورن، وحشی خیلی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.1,
   "end": 424.28,
   "text": "یا مثلا امام صادق فرمودن که کسی که دوست داره خشمش کم بشه، بعضیا میان میگن آقا ما زود عصبانی میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.28,
   "end": 430.2,
   "text": "حاج آقا ما زود عصبانی میشیم. این اصلا این درد بعضی‌هاست یا همه‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.2,
   "end": 432.4,
   "text": "زود عصبانی میشیم. ما که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.4,
   "end": 434.96,
   "text": "دیر عصبانی میشیم اما اگه بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.96,
   "end": 436.54,
   "text": "دیگه کسی جلودارمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.54,
   "end": 440.44,
   "text": "دیگه بدتر. حضرت فرمود میخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.44,
   "end": 444.3,
   "text": "خشم‌ت کم شه؟ راهش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.3,
   "end": 448.8,
   "text": "یه راهشو پیغمبر فرمود. فرمودن درraj بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.8,
   "end": 452.26,
   "text": "حالا درraj چیه عربا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.26,
   "end": 454.68,
   "text": "یه کب-- یه پرنده‌ایه شبیه کبکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.68,
   "end": 458.7,
   "text": "بعضیا گفتن خوده کبکه. اما نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.7,
   "end": 462.28,
   "text": "با توجه به روایت دیگه پرنده‌ایست خیلی هم خوش گوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.28,
   "end": 466.76,
   "text": "یعنی گوشتش خوشمزه است. ما آخه اینو نخوردیمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.76,
   "end": 470.6,
   "text": "ولی شنیدیم که خوشمزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.6,
   "end": 474.86,
   "text": "دوباره از پیغمبر روایت هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.86,
   "end": 480.06,
   "text": "کسی که میخواد صفراش از بین بره، می‌دونید صفرا عامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.06,
   "end": 486.1,
   "text": "عصبیته. میخواد از بین بره و اخلاقش نیکو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.1,
   "end": 488.6,
   "text": "حسن نیکویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.6,
   "end": 490.98,
   "text": "خلق پیدا کنه. چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.98,
   "end": 495.1,
   "text": "پیغمبر فرمود روغن چی بخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.1,
   "end": 499.78,
   "text": "به نظر شما نباتی؟ روغن حیوانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.78,
   "end": 503.5,
   "text": "روغن کرمانشاهی؟ روغن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.5,
   "end": 507.02,
   "text": "زیتون. زیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.02,
   "end": 511.42,
   "text": "زیت فرمودن که یعنی روغن زیتان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.42,
   "end": 515.24,
   "text": "زیتون. پیغمبر فرمود روغن زیتون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.24,
   "end": 517.92,
   "text": "که البته میدونم الان خیلی گرونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.92,
   "end": 520.82,
   "text": "اما بالاخره هر از چندگاهی آدم بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.82,
   "end": 525.2,
   "text": "قاطی غذاش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.2,
   "end": 528.38,
   "text": "مثلا فرمود \"من ترك اللحم أربعين صباحا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.38,
   "end": 531.9,
   "text": "میدونید که گوشت خوردن قسی القلب میکنه آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.9,
   "end": 535.32,
   "text": "از اون طرفم اگر کسی اصلا گوشت نخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.32,
   "end": 538.4,
   "text": "بعضیا ترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.4,
   "end": 543.88,
   "text": "گوشت ایجاد میکنن. مثلا خدا رحمت کنه مرحوم شیخ بهائی در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.88,
   "end": 547.98,
   "text": "موت سیاهش، موت سیاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.98,
   "end": 551.7,
   "text": "یه کتابی داره به نام موت ابيض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.7,
   "end": 555.22,
   "text": "موت سفید، یه موت سیاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.22,
   "end": 557.88,
   "text": "بعد اینا البته ترجمه ها بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.88,
   "end": 560.22,
   "text": "موت قبلا تموم-- تو قبلا گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.22,
   "end": 563.22,
   "text": "موت سیاه چیه؟ موت احمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.22,
   "end": 565.24,
   "text": "اخضر چیه؟ موت ابيض چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.24,
   "end": 571.1,
   "text": "این‌ها رو قبلا گفتیم. تو موت ابيضش شیخ بهاء بغل امام رضا هستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 571.1,
   "end": 573.42,
   "text": "یکی از درب‌های حرم آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.42,
   "end": 575.52,
   "text": "ایشون تو اون کتاب چهله میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.52,
   "end": 577.44,
   "text": "چهله‌ی گیاهخواری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.44,
   "end": 583.3,
   "text": "اصلا گوشت نخورد. در کنارش یه کارهای دیگه باید انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.3,
   "end": 587.7,
   "text": "چرا؟ چون اینجا پیغمبر فرمود \"من ترك اللحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 587.7,
   "end": 592.28,
   "text": "أربعين صباحا\" کسی که چهل روز گوشت نخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.28,
   "end": 595.4,
   "text": "\"ساء خلقه\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.4,
   "end": 601.24,
   "text": "بداخلاق میشه. چه ربطی داره بین گوشت چهل روز نخوردن و بداخلاقی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.24,
   "end": 606.22,
   "text": "باز ربطی داره. حالا برو حکمای-- اسرارشو چگونه فاش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.22,
   "end": 609.78,
   "text": "ما وقت برای این چیزا نمی‌ذاریم ولی شیخ الرئیس‌ها گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.78,
   "end": 613.02,
   "text": "وقت گذاشتن. برای مفضل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.02,
   "end": 618.48,
   "text": "امام صادق چند روز وقت گذاشت و امثال این اسرار رو براش بیان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.48,
   "end": 623.62,
   "text": "اسرار از خلقت زمین و زمان و فرشته‌ها و آدم و جن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 623.62,
   "end": 630.24,
   "text": "انس و نباتات و گیاهان و حیوانات و ذکر تک تک موجودات و همه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.24,
   "end": 633.1,
   "text": "اوه اوه چه از جنین اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.1,
   "end": 635.58,
   "text": "ااا سلاسه چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.58,
   "end": 639.4,
   "text": "ظلمات ثلاث رحم مادر که الان پزشکی بهش رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.4,
   "end": 644.06,
   "text": "اوه چه-- چهار روز مفضل پیش امام صادق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.06,
   "end": 645.68,
   "text": "دلش سنگین شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.68,
   "end": 649.88,
   "text": "اومد گفت آقا چه خبر؟ مثل الان ما میرسیم به هم میگیم آقا چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.88,
   "end": 652.26,
   "text": "چه زمانه فاسدی شده فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.26,
   "end": 655.3,
   "text": "حضرت فرمود بشین، بشین تا برات بگم دلت باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.3,
   "end": 657.32,
   "text": "چهار روز حضرت گفت این نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.32,
   "end": 660.18,
   "text": "شده اسمش کتابش چیه؟ توحید مفضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.18,
   "end": 665.56,
   "text": "بخونیم اینو. یه، یه زمانی اینجا این کتاب رو بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 665.56,
   "end": 672.5,
   "text": "تدریس کردم همینجا. شاید فایل‌هاش هنوز، هنوز باشه این کتاب تو اون کانال مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 672.5,
   "end": 675.02,
   "text": "خب اینا اسراریه که آدم باید بدونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 675.02,
   "end": 677.64,
   "text": "خلاصه خسته تون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.64,
   "end": 684.52,
   "text": "اگر شما کتاب دایرة المعارف طب اسلامی رو بخونید، اینا رو من تندتند براتون بگم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.52,
   "end": 689.74,
   "text": "احادیثشو نخونیم. چیزایی که قلب رو قسی میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 689.74,
   "end": 692.86,
   "text": "تاریک میکنه، قلب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 692.86,
   "end": 695.22,
   "text": "خشم میکنه، ذمخ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 695.22,
   "end": 698.14,
   "text": "تندتند اینا رو بگم. کثرت اکل و شرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.14,
   "end": 702.22,
   "text": "زیاد خوردن و خور-- حالا چه غذا، چه آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 702.22,
   "end": 705.38,
   "text": "کثرت گناه. شرب خمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.38,
   "end": 711.04,
   "text": "ولو قطره‌ای. چهل روز پیاپی گوشت خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.04,
   "end": 713.78,
   "text": "هر روز تا کسی گوشت بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 713.78,
   "end": 718.32,
   "text": "ریختن خاک بر سر جنازه اقوام در قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 718.32,
   "end": 721.48,
   "text": "اینا همه روایته ها. من اینطوری نوشتم رد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 721.48,
   "end": 724.84,
   "text": "بلافاصله بعد از غذا خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 724.84,
   "end": 729.4,
   "text": "علامه اون خوابی که دید از امام رضا که دهان ما-- زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 729.4,
   "end": 731.66,
   "text": "ایشون رو مکید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 731.66,
   "end": 739.08,
   "text": "در نوزده سالگی و فرمود دیگه هرچی علم ترشح میکنه در وجود من از آب دهان امام رضاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 739.08,
   "end": 743.8,
   "text": "نوزده سالش بود هم غذا خورده بود خیلی هم خسته بود و خوابش میومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 743.8,
   "end": 748.48,
   "text": "خودشون می فرمودن خیلی اذیت-- ولی برای اینکه خوابم نره دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 748.48,
   "end": 750.62,
   "text": "خونه میچرخیم راه می‌رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 750.62,
   "end": 753.38,
   "text": "هی تو سر خودم می‌کوبیدم نخوابم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 753.38,
   "end": 756.12,
   "text": "چرا آخه آقا؟ چرا الا منده خوی تو اذیت کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 756.12,
   "end": 761.76,
   "text": "نوزده ساله بیار بخواب دیگه. اخی فرمود بلافاصله بعد غذا خوابیدن قساوت قلب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 761.76,
   "end": 763.96,
   "text": "مثلا یه چیزایی رعایت نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 763.96,
   "end": 768.26,
   "text": "بعدم میگیم هیئت روضه‌خونه میگه تو بلد نبودی ما رو بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 768.26,
   "end": 772.1,
   "text": "یه روضه‌خونه خوش صداتر بیارین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 772.1,
   "end": 778.08,
   "text": "خوردن خون، زیاد صحبت کردن در غیر ذکر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.08,
   "end": 781.5,
   "text": "و اگه ما آخوندا رو متهم کنیم شما زیاد صحبت می‌کنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.5,
   "end": 784.24,
   "text": "روایت میگه در غیر ذکر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.24,
   "end": 786.8,
   "text": "زیاد صحبت کردن دلمون می‌رونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 786.8,
   "end": 789.84,
   "text": "آرزوی طولانی، غفلت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 789.84,
   "end": 793.16,
   "text": "حب دنیا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 793.16,
   "end": 795.88,
   "text": "قابل توجه دفتردارها دفتر اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 795.88,
   "end": 798.16,
   "text": "اینجا کی دفتر مدیر کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 798.16,
   "end": 803.48,
   "text": "دفتر دار مدیرشه. همنشینی با امرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 803.48,
   "end": 807.38,
   "text": "رؤسا، مدیران و اغنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 807.38,
   "end": 810.36,
   "text": "عجب زیاد با اونا نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 810.36,
   "end": 814.96,
   "text": "جدال. کثرت مجالست با زنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 814.96,
   "end": 817.8,
   "text": "قبلاً گفتم یه سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 817.8,
   "end": 822.46,
   "text": "مثلاً شغل‌ها هست به خاطر زیاد ارتباط با خانوما کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 822.46,
   "end": 830.46,
   "text": "پرداختن به امور lehvi زیاد چرت و پرت گفتن و مزخرفات گفتن و قابل توجه بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 830.46,
   "end": 834.7,
   "text": ". اینا همه باعث کوهی باطن و قساوت قلب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 834.7,
   "end": 837.42,
   "text": "یه چند تا هم برعکسشو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 837.42,
   "end": 843.36,
   "text": "اینایی که قوت قلب میاره نور دل میاره رقیق القلب می‌کنه اینور اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 843.36,
   "end": 848.56,
   "text": "فرمودن خوردن کشمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 848.56,
   "end": 850.98,
   "text": "بوی خوش استفاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 850.98,
   "end": 854.4,
   "text": "مثلا هر کی بهم رسید بوی خوش از من استشمام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 854.4,
   "end": 860.06,
   "text": "چون یه عزیزی از کربلا اومده بود مشک حرم امام حسین و ضریح آقا رو بهم ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 860.06,
   "end": 862.34,
   "text": "گذاشتن تو نماز بهم بیشتر چسبید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 862.34,
   "end": 864.86,
   "text": "این تو جیبم بود. هی بوش میزد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 864.86,
   "end": 866.66,
   "text": "اینا قلب رو رقیق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 866.66,
   "end": 870.1,
   "text": "خوردن عسل، گلابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 870.1,
   "end": 872.7,
   "text": "سیب، به اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 872.7,
   "end": 876.88,
   "text": "قلب رو شفاف میکنه. گریه از خوف خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 876.88,
   "end": 879.6,
   "text": "ذکر مدام داشتن. گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 879.6,
   "end": 884.56,
   "text": "مثلاً روزه. خوردن خربزه، سرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 884.56,
   "end": 890.82,
   "text": "سه تا دونه انار خوردن از یک تا سه یا یکی یا دو تا یا سه تا کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 890.82,
   "end": 897.16,
   "text": "یعنی تنها چیزی که گفتم خوردی تا دونه آخرشو خودت بخور و اهلی نده اناره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 897.16,
   "end": 899.74,
   "text": "چون حدیث داریم یه دونه بهشتی درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 899.74,
   "end": 902.62,
   "text": "حالا اونم حکایتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 902.62,
   "end": 907.44,
   "text": "مخصوصا صبح جمعه. و من حيث المجموع وقت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 907.44,
   "end": 911.18,
   "text": "این‌ها رو آدم انجام بده بعد نتیجه‌شو ببینه و ما رو دعا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 911.18,
   "end": 916.12,
   "text": "انشاالله عاقبتمون ختم به خیر باشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 916.12,
   "end": 919.18,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}