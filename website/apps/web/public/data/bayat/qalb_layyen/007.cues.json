   "start": 16.36,
   "end": 190.96
  },
  {
   "index": 1,
   "title": "## ولایت هدایت است نه سوءاستفادهٔ ابزاری",
   "start": 190.96,
   "end": 416.25
  },
  {
   "index": 2,
   "title": "## تصرف هدایتی؛ داستان نگاه امیرالمؤمنین",
   "start": 416.25,
   "end": 579.51
  },
  {
   "index": 3,
   "title": "## شعبان دروازهٔ رمضان و رقت قلوب",
   "start": 579.51,
   "end": 722.59
  },
  {
   "index": 4,
   "title": "## امام باقر: تعرض لرقة القلب بکثرة الذکر فی الخلوات",
   "start": 722.59,
   "end": 894.92
  },
  {
   "index": 5,
   "title": "## حدیث قدسی به عیسی: اطب لی قلبک",
   "start": 894.92,
   "end": 1010.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.76,
   "end": 6.26,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.26,
   "end": 10.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.14,
   "end": 16.36,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.36,
   "end": 20.26,
   "text": "تبریک عرض می‌کنم هم اعیاد شعبانیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.26,
   "end": 24.32,
   "text": "هم چهل و پنجمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.32,
   "end": 27.72,
   "text": "سالگرد پیروزی انقلاب عزیزمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.72,
   "end": 32.52,
   "text": "گل کاشتن ملت الحمد لله واقعا دست بوسی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.52,
   "end": 35.62,
   "text": "خاک بوسی داره از این ملت که با همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.62,
   "end": 38.0,
   "text": "این مشکلات باز این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.0,
   "end": 39.88,
   "text": "پشت ولایت دراومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.88,
   "end": 44.46,
   "text": "الحمد لله هرچند ما کلیپ و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.46,
   "end": 51.32,
   "text": "فیلم و نمایش و این‌ها دیدیم از مردم، قاطبه مردم جالب بود که امروز کلیدواژه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.32,
   "end": 54.04,
   "text": "غالب اونایی که شرکت کرده بودن این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.04,
   "end": 57.28,
   "text": "می‌گفتن به عشق رهبر اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.28,
   "end": 60.18,
   "text": "خب چون دیدن جسارت‌هایی که به رهبر این و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.18,
   "end": 62.02,
   "text": "چند وقتی تو اغتشاشات شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.02,
   "end": 64.44,
   "text": "الحمد لله ملتم آگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.44,
   "end": 67.02,
   "text": "البته یه گلایه‌ای هم بکنیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.02,
   "end": 69.66,
   "text": "متاسفانه خواصی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.66,
   "end": 72.62,
   "text": "بعضی موقع‌ها حرف‌ها رو یا نیمه کاره می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.62,
   "end": 75.12,
   "text": "یا به جاش نمی‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.12,
   "end": 77.96,
   "text": "مثلا یه عزیزی اسم نبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.96,
   "end": 82.92,
   "text": "دیدید حتما کلیپ ایشون پخش شد متاسفانه تو فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.92,
   "end": 87.86,
   "text": "ما هم ایشون رو قبول داریم. اما حالا یا صحبت‌های ایشون تقطیع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.86,
   "end": 90.74,
   "text": "یا ایشون به هنگام حرف نزده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.74,
   "end": 95.06,
   "text": "کامل نزده. نمی‌دونم به هر حال هرچی که بود این چیزی که ما دیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.06,
   "end": 99.38,
   "text": "خوب نبود. که یه خاطره‌ای ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.38,
   "end": 101.94,
   "text": "از آقای بهجت نقل می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 101.94,
   "end": 105.18,
   "text": "ا آقای بهجت میگن فکر می‌کنید اینا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.18,
   "end": 112.06,
   "text": "مثلا بیست و هشت بهمن اومدن راهپیمایی این همه جمعیت مثلا همه امام رو قبول دارن و اومدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.06,
   "end": 116.9,
   "text": "ایشون میگه نه. اولا رو چه استدلالی شما گفتید نه به آقای بهجت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.9,
   "end": 119.22,
   "text": "رو چه استدلالی؟ استدلالتونو بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.22,
   "end": 122.16,
   "text": "چرا گفتید کسایی که میان راهپیمایی امام رو قبول ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.16,
   "end": 128.54,
   "text": "اونم شما. شما یه شخصیت تو لباس پیغمبر، شخصیت برجسته و خواص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.54,
   "end": 131.6,
   "text": "نماینده مجلس چی اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.6,
   "end": 133.88,
   "text": "این یه اشکال. رو چه استنادی گفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.88,
   "end": 139.28,
   "text": "بعد آقای بهجت هم فرمودن که فکر می‌کنید چرا اینا میان اگه قبول ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.28,
   "end": 143.14,
   "text": "خب نمی‌دونم بفرمایید چرا میان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.14,
   "end": 148.76,
   "text": "شما که خودت میگی نمی‌دونن تحلیل ندارید چرا اصلا اینو رسانه‌ایش می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.76,
   "end": 150.52,
   "text": "من این، این کلیپ رو امروز دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.52,
   "end": 156.42,
   "text": "خیلی تأسف خوردم. بعد آقای بهجت فرمودن که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.42,
   "end": 158.34,
   "text": "با ولایتش اینا رو می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.34,
   "end": 160.86,
   "text": "ولایت امام اینا رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.86,
   "end": 163.22,
   "text": "اصلا این حرف درست. نمیگیم غلط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.22,
   "end": 164.84,
   "text": "بله ولایت جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.84,
   "end": 168.42,
   "text": "سلام من شما به ولایت امیرالمؤمنین اینجا نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.42,
   "end": 171.14,
   "text": "نفس ولایتی اهل بیت ما رو کشونده اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.14,
   "end": 175.72,
   "text": "ما هدایت دست اون‌هاست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.72,
   "end": 178.9,
   "text": "هدایت دست اون‌هاست. قبلا بحث زیاد در این زمینه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 178.9,
   "end": 182.4,
   "text": "اصلا ولایت یعنی همون اصل هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 182.4,
   "end": 186.26,
   "text": "عهدنا صراط مستقیم هدایت در مسیر مستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 186.26,
   "end": 190.96,
   "text": "به وسیله خود ولایت در خود ولایت صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 190.96,
   "end": 199.32,
   "text": "اما این یعنی چی؟ یعنی تو ذهن اینطوری متصور بشه که ولایت داره است-سو استفاده ابزاری می‌کنه از مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.32,
   "end": 202.76,
   "text": "خب الان نیازه ملت رو بکشونیم با یه نگاه بکشونیمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.76,
   "end": 206.96,
   "text": "این حرفا چیه؟ درسته اصلش من رد نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 206.96,
   "end": 209.82,
   "text": "اصل ولایت که جاریه، ساريه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.82,
   "end": 212.22,
   "text": "اصلا کائنات تحت تصرف ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.22,
   "end": 214.96,
   "text": "اونا کی بودن که بخوان ولایت رو غصب کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.96,
   "end": 219.8,
   "text": "این چه حرفیه حتی ریاست مثلا خلافت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.8,
   "end": 222.0,
   "text": "انی جاعل في الارض خليفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.0,
   "end": 224.76,
   "text": "خدا جعل خلی-خلافت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.76,
   "end": 226.56,
   "text": "کی می‌تونه جلو خدا وایسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 226.56,
   "end": 228.88,
   "text": "ریاست رو غصب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 228.88,
   "end": 234.06,
   "text": "ریاست صورت ظاهریه. بله امام تصرف ولی ادامش رو هم بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.06,
   "end": 237.4,
   "text": "ادام-- تصرف ولایتی امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 237.4,
   "end": 241.92,
   "text": "اینطوری قشنگه. بگیم همونطوری که ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 241.92,
   "end": 247.08,
   "text": "جوونای کاهوار برو و مشروب خور و چی و سر کوچه‌ای و هرزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 247.08,
   "end": 251.9,
   "text": "چنان تصرف کرد و هدایتشون کرد آورد کردشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 251.9,
   "end": 256.58,
   "text": "عاشق یک پارچه خدا و اهل بیت و که رو از رو سیم خاردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 256.58,
   "end": 259.48,
   "text": "بخوابن ملت از روش رد شن، رزمنده رد شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 259.48,
   "end": 263.18,
   "text": "این اینطوری بگو. چنان هدایت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 263.18,
   "end": 265.9,
   "text": "این چه حرف نیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.9,
   "end": 268.0,
   "text": "کاره و ناقصیه که بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 268.0,
   "end": 271.78,
   "text": "از توش هزار تا تعبیر غلط بیرون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 271.78,
   "end": 275.68,
   "text": "که هر کجا حتی از قدرت معنوی‌شونم اینا سواستفاده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 275.68,
   "end": 279.92,
   "text": "اینا از تو دلش بیرون نمیاد. یه آدم ناآگاه اینو بشنوه اینطوری نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 279.92,
   "end": 284.48,
   "text": "میگه بس اینا همه نمایشه. نمایش‌های خدا و اهل بیت و ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 284.48,
   "end": 287.9,
   "text": "اینام در طول اونن دیگه. ایشون شاگرد ولایته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 287.9,
   "end": 290.24,
   "text": "یعنی چی الان نیازه که بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 290.24,
   "end": 292.8,
   "text": "مثلا یه نمایش یه مانور بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 292.8,
   "end": 295.52,
   "text": "مثلا یه میتینگ چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 295.52,
   "end": 303.22,
   "text": "یه رفراندوم عمومی داشته باشم، ملت بریزید من تصرف ولایت از این قدرتم استفاده کنم بعدش دیگه استفاده نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 303.22,
   "end": 306.86,
   "text": "حالا برید دنبال کارتون. این چه طرز تفکر غلطیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 306.86,
   "end": 313.36,
   "text": "این چه بیان ناقصیه؟ بله اینطوری میشه گفت که این‌هایی که الان میان وسط گود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 313.36,
   "end": 316.34,
   "text": "می‌دونید تو دلشون خیلی اشکالات هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 316.34,
   "end": 319.48,
   "text": "همینطور که ببین رهبر چقدر شیرین و قشنگ میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 319.48,
   "end": 322.3,
   "text": "می‌فرماید حضور مردم در راهپیمایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 322.3,
   "end": 326.0,
   "text": "به این نگیرید که یعنی اینها قائل‌اند که هیچ مشکلی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 326.0,
   "end": 331.44,
   "text": "عین فرمایش رهبر. اتفاقا با وجود همه مشکلات میان چون اصل نظام رو قبول دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 331.44,
   "end": 334.98,
   "text": "مگه میشه کسی امام رو قبول نداشته باشه بیاد راهپیمایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 334.98,
   "end": 338.62,
   "text": "چرا یه وقت دست فروشه اومده اونجا کاسبی کنه بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.62,
   "end": 341.8,
   "text": "ولی اون قاطبه ملت اصلا چه حرف غلطیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 341.8,
   "end": 344.34,
   "text": "آدم به خدا فشار میاد بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 344.34,
   "end": 348.8,
   "text": "یه سری حرفایی می‌زنن. من بچه طلبه که هیچ تحلیل آنچنانی هم ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 348.8,
   "end": 352.1,
   "text": "خیلی هم مطرح نیستم و معروف نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 352.1,
   "end": 355.04,
   "text": "خط بطلان خیلی راحت رو این می‌کشم همچنین شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 355.04,
   "end": 359.64,
   "text": "من نمی‌دونم چه کسایی جلو دار ما میشن بعضی موقع‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.64,
   "end": 362.0,
   "text": "بعد رهبر عزیزمون چه فرمایشی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.0,
   "end": 368.0,
   "text": "فرمودن اصلا این انقلاب در هیچ جای دنیا بدون نام امام خمینی معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 368.0,
   "end": 372.13,
   "text": "مگه رهبر نفرمودن؟ مگه میشه کسی بیاد تو این راهپیمایی شرکت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.13,
   "end": 376.71,
   "text": "میگم مگر حواشی مثلا طرف پستشه تو مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.71,
   "end": 382.63,
   "text": "مثال می‌زنیم تو نیروی انتظامیه باید بیاد وایسته پست بده قبول نداره مجبوره اجبارا یا کاسب اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.63,
   "end": 385.99,
   "text": "این‌ها رو ما کاری نداریم. حضور قاطبه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.99,
   "end": 388.17,
   "text": "به عشق رهبر، به عشق امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.17,
   "end": 391.57,
   "text": "اینطوری حرف بزنیم بگیم چی میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.57,
   "end": 397.77,
   "text": "این مردم با وجود این همه فشارهای اقتصادی و مشکلات داخلی و بیرونی باز میان پای نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 397.77,
   "end": 400.75,
   "text": "باز میان میگن به عشق رهبر اومدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 400.75,
   "end": 402.83,
   "text": "اینطوری نگاه کنیم به قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 402.83,
   "end": 406.31,
   "text": "حالا در این خصوص من حرف زیاد داشتم ولی بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 406.31,
   "end": 408.15,
   "text": "یعنی حرف رو کامل بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 408.15,
   "end": 412.55,
   "text": "ولایت هدایت می‌کنه. هدایت می‌کنه اون کسی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 412.55,
   "end": 416.25,
   "text": "نمی‌شناسه یه دفعه می‌بینه وسط گود بعدم عاشق می‌شه میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 416.25,
   "end": 423.91,
   "text": "با منی که عرض کردم هیچ‌کاره‌م تو این نظامی بچه طلبه‌ایه هیچی اصلاً بچه طلبه‌ام واقعاً خودم رو نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.91,
   "end": 426.47,
   "text": "واقعاً نمی‌بینم. واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.47,
   "end": 431.47,
   "text": "توبه می‌کنم هر روز از اینکه لباس پیغمبر تنم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.47,
   "end": 437.07,
   "text": "خدا می‌دونه. ولی مثلاً در رابطه با خود منم یه حرفایی زده بودن آره ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 437.07,
   "end": 439.99,
   "text": "مثلاً از خارج از کشور از کانادا کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 439.99,
   "end": 444.51,
   "text": "پول میاره؟ اینا آقا محسن بچه‌های هیئتمون تشریف دارن می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.51,
   "end": 446.39,
   "text": "هزینه می‌کنه این پولا رو از کجا میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.39,
   "end": 449.87,
   "text": "از خارج از کشور از کانادا و انگلیس از اونجاها میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.87,
   "end": 453.55,
   "text": "منی که هیچی نه حالا یه مقدار پولی تو هیئتمون هزینه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.55,
   "end": 457.47,
   "text": "یه خیریه زدیم، صندوق قرض‌الحسنه زدیم از چهار تا آدم خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.47,
   "end": 460.75,
   "text": "جالبه بچه‌های اطلاعات اومده بودن هیئت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.75,
   "end": 462.59,
   "text": "همونه الان جذب هیئت ما شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 462.59,
   "end": 466.03,
   "text": "یعنی من چند نفرم می‌تونم اسم ببرم که اومدن ثابت هیئت ما شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.03,
   "end": 470.81,
   "text": "میگن اصلاً به این خاطر ما اومدیم. ما اومدیم انقدر که حرف پشت سر شما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 470.81,
   "end": 472.71,
   "text": "حالا یه وجه کوچیکش رو دارم میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 472.71,
   "end": 475.47,
   "text": "منی که هیچ‌کاره‌م. اونا هم اینطورین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.47,
   "end": 477.73,
   "text": "یه دفعه می‌بینی طرف سرک می‌کشه از طولانه‌ش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 477.73,
   "end": 480.47,
   "text": "چه خبره این همه ملت فلان پا می‌شه میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 480.47,
   "end": 486.23,
   "text": "بعد رفته رفته می‌بینه نه مثل اینکه یه خبریه و عاشق می‌شه، عاشق رهبر می‌شه، عاشق ولایت می‌شه، عاشق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 486.23,
   "end": 493.69,
   "text": "این راه رو میره. تصرف ولایت هست اما تصرف هدایتی‌ست نه سوءاستفاده ابزاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 493.69,
   "end": 495.83,
   "text": "کامل بگیم یک مطلب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 495.83,
   "end": 500.13,
   "text": "مثل اون نگاهی که امیرالمؤمنین به اون شخص کرد که خنجر داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 500.13,
   "end": 504.17,
   "text": "داستانشو می‌دونید دیگه مدح‌ها میگن متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 504.17,
   "end": 507.91,
   "text": "فقط. که اومد می‌خواست حضرت رو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 507.91,
   "end": 509.55,
   "text": "پدرش اومد افتاد به پای آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 509.55,
   "end": 513.53,
   "text": "پسرم غول خورده زیر رداش خنجر پنهان کرده می‌خواست شما رو گوشت ازت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 513.53,
   "end": 516.93,
   "text": "فرمود برو کنار غصه نخور. رفت پدره کنار نگاه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 516.93,
   "end": 520.83,
   "text": "پسره تا نزدیک شد حضرت یه نگاهی اینجا تصرف ولایتی بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 520.83,
   "end": 523.97,
   "text": "تصرف کرد. چه شد؟ خنجر از دستش افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 523.97,
   "end": 527.03,
   "text": "تمام. خب حالا که منو می‌خواستی بکشی تصرف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 527.03,
   "end": 529.49,
   "text": "حالا برو پی کارت. دوباره دشمن باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 529.49,
   "end": 533.27,
   "text": "نه افتاد به پای آقا گفت چه کردی قبل از اینکه بیام محضر شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 533.27,
   "end": 535.51,
   "text": "شما محبوب‌ترین آدما تو دل من بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 535.51,
   "end": 537.99,
   "text": "الان محبوب‌ترین‌هایی عاشقت شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 537.99,
   "end": 543.15,
   "text": "چیکار کردی با دل من؟ گریه می‌کرد نمی‌تونست جدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 543.15,
   "end": 545.91,
   "text": "پدرش اومد بردش. بعد اومد حالا پدره گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 545.91,
   "end": 548.19,
   "text": "گفت چرا زودتر از این نگاه نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 548.19,
   "end": 550.21,
   "text": "چه پررو .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 550.21,
   "end": 552.83,
   "text": "به جای تشکر چه-- حضرت چی جواب داده باشن خوبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 552.83,
   "end": 556.37,
   "text": "فرمودن این نگاه، نگاه همه ما این قدرت رو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 556.37,
   "end": 561.03,
   "text": "اما اذن استفاده‌ش رو خدا سپرده به فرزند آخر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 561.03,
   "end": 564.15,
   "text": "مهدی ما که بیاد با این نگاه آدما رو عوض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 564.15,
   "end": 567.39,
   "text": "می‌کنه. اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 567.39,
   "end": 571.19,
   "text": "نگاه می‌کنه آدما رو هدایت می‌کنه، نه سوءاستفاده ابزاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 571.19,
   "end": 574.39,
   "text": "کامل بگیم یک حرفو. به هر حال تشکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 574.39,
   "end": 577.05,
   "text": "من نمی‌خواستم این موضوع رو باز کنم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 577.05,
   "end": 579.51,
   "text": "اذیت شدم اومدم درد و دل تو جمع شما بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 579.51,
   "end": 582.59,
   "text": "بحث دوشنبه‌های ما قلب لنگ بود یا لین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 582.59,
   "end": 585.67,
   "text": "یکی دیگه از راه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 585.67,
   "end": 589.09,
   "text": "نرم شدن قلب رو هم بگیم که سلسله بحثمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 589.09,
   "end": 591.51,
   "text": "منقطع نشده باشه. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 591.51,
   "end": 594.65,
   "text": "خیلی شیرین که این ایام ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 594.65,
   "end": 599.75,
   "text": "ش-شعبان. حالا یکی مثل من میگه آقا من رجب را از دست دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 599.75,
   "end": 602.13,
   "text": "واقعاً با آه و حسرت از رجب جدا شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 602.13,
   "end": 604.97,
   "text": "بسم الله شعبان که از رجب بالاتره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 604.97,
   "end": 609.81,
   "text": "ش-ماه مبارک شعبان دروازه به منزله در ورودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 609.81,
   "end": 613.15,
   "text": "ماه مبارک رمضانه. هرکس که جا مونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 613.15,
   "end": 621.09,
   "text": "کفاره‌ش میشه استفاده از این ماه به خصوص صلوات که در این ماه اکثار صلوات کفاره همه گناهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 621.09,
   "end": 625.55,
   "text": "بله. اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 625.55,
   "end": 631.31,
   "text": "حالا این فرمایش امام سجاد در خصوص ماه مبارک رمضانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 631.31,
   "end": 633.61,
   "text": "اما شما پیوست بزنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 633.61,
   "end": 638.05,
   "text": "که این ماه باب ماه مبارک رمضانه باز عظمتش دستمون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 638.05,
   "end": 643.27,
   "text": "که یک تیکه‌ای حضرت در وداع با ماه مبارک رمضان فرمود السلام علیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 643.27,
   "end": 646.33,
   "text": "عرب می‌دونید موقع وداکش هم سلام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 646.33,
   "end": 648.49,
   "text": "مجاور رقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 648.49,
   "end": 650.63,
   "text": "رقت فيه القلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 650.63,
   "end": 652.61,
   "text": "و قلت فيه الذنوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 652.61,
   "end": 658.51,
   "text": "سلام به ماهی که بر اثر مجاورت و هم‌نشینی با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 658.51,
   "end": 662.09,
   "text": "گناه‌ها می‌ریزه کم می‌شه. قلت کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 662.09,
   "end": 664.71,
   "text": "فيه الذنوب و چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 664.71,
   "end": 667.43,
   "text": "رقت فيه القلوب قلب نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 667.43,
   "end": 673.09,
   "text": "این تکمله و تتمه بحث جلسه پیشمون استفاده از نفس کینونت زمان و مکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 673.09,
   "end": 676.79,
   "text": "بسم الله ماه شعبان. این ایام الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 676.79,
   "end": 680.27,
   "text": "ایام الله خدا ظهور می‌کنه در ایام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 680.27,
   "end": 682.55,
   "text": "ایام الله یعنی الله ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 682.55,
   "end": 687.51,
   "text": "بسم الله مثل اینکه بیست و دو بهمن رو چرا امام فرمود ایام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 687.51,
   "end": 690.87,
   "text": "طرف میگه امام قدرت ولایتی‌ش مردم رو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 690.87,
   "end": 697.67,
   "text": "درست. چطور خود ایشون فرمودن امام علیه الرحمه ایشون فرمودن که از، از این حیث ایام الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 697.67,
   "end": 704.33,
   "text": "یوم الله هست که خدا نگاه کرد پیر و جوان از بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 704.33,
   "end": 706.37,
   "text": "چند ساله‌ی تازه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 706.37,
   "end": 709.61,
   "text": "سن بلوغ نرسیده تا پیرمردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 709.61,
   "end": 712.63,
   "text": "تو بستر تو خونه افتاده همه هم دل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 712.63,
   "end": 715.35,
   "text": "این کار خداست. یعنی ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 715.35,
   "end": 718.75,
   "text": "هدایت رو شما ببینید سرنخ رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 718.75,
   "end": 722.59,
   "text": "چی داره میگه؟ ایام الله خدا تو این ایام ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 722.59,
   "end": 724.19,
   "text": "یکی از-- پس حالا بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 724.19,
   "end": 728.79,
   "text": "یکی دیگه از راه‌های عرض شود نرمی دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 728.79,
   "end": 732.81,
   "text": "روایت بگم از ببخشید تهف العقول صفحه دویست و هشتاد و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 732.81,
   "end": 734.73,
   "text": "امام باقر صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 734.73,
   "end": 737.95,
   "text": "بسم الله اینو یادگار ما داشته باشیم بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 737.95,
   "end": 743.6,
   "text": "و تعرّض وتعرّ اول یعنی خودشو در معرض قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 743.6,
   "end": 745.64,
   "text": "برای چی؟ ر-ر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 745.64,
   "end": 749.94,
   "text": "لرقّة القلب برای اینکه قلبت نرم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 749.94,
   "end": 753.02,
   "text": "به چی؟ امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 753.02,
   "end": 756.48,
   "text": "شکافنده علوم. بکثرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 756.48,
   "end": 759.28,
   "text": "ذکر به اکثار ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 759.28,
   "end": 761.82,
   "text": "ذکر هم گفتیم با ورد متفاوته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 761.82,
   "end": 764.48,
   "text": "ذکر باطن ورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 764.48,
   "end": 769.5,
   "text": "ورد اینه که به زبانت جاری می‌شه وقتی اون همراه یاد قلبی شد می‌شه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 769.5,
   "end": 771.64,
   "text": "یعنی قلبت همراه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 771.64,
   "end": 778.36,
   "text": "یه دونه صلوات با حضور قلب به مراتب بالاتر است از هزاران صلوات بدون حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 778.36,
   "end": 781.34,
   "text": "با حضور قلب. این یعنی ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 781.34,
   "end": 783.76,
   "text": "بکثرة ذکر. کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 783.76,
   "end": 785.84,
   "text": "به نظر شما؟ کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 785.84,
   "end": 788.82,
   "text": "رقّة قلب میاره؟ في الخلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 788.82,
   "end": 791.84,
   "text": "در خلوت‌ها غافل نشیم از خلوت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 791.84,
   "end": 794.08,
   "text": "انقدر این خلوت‌ها مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 794.08,
   "end": 797.28,
   "text": "که در کمال می‌خونیم ولا تعجلنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 797.28,
   "end": 802.8,
   "text": "خدایا عجله نکنی‌ها بالعقوبة على ما عملته في خلواتي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 802.8,
   "end": 804.56,
   "text": "از اونچه که در خلوتم کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 804.56,
   "end": 807.5,
   "text": "خیلی مهمه آدم تو خلوتش چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 807.5,
   "end": 810.46,
   "text": "از چه نوع کارهایی که در خلوتم کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 810.46,
   "end": 814.28,
   "text": "تو عجله نکن. خلوتم چون پر شده از این چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 814.28,
   "end": 821.6,
   "text": "من سوء عملی و اساءتی و دوام تفریطي و جهالتي و کثرة شهواتی و غفلتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 821.6,
   "end": 825.74,
   "text": "اینا همه تو خلوت پیش میاد. خلوت معلوم می‌کنه آدم چی کاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 825.74,
   "end": 829.72,
   "text": "تو خلوتت چی کاره‌ای؟ این تکبیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 829.72,
   "end": 834.6,
   "text": "بالای بوم یا در منظر انظار م-م-مرأي مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 834.6,
   "end": 838.86,
   "text": "شب بیست و دو بهمن اینا خلوت توئه با خدای خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 838.86,
   "end": 843.6,
   "text": "و الان معلومه شما تو خودمون که هستیم دیگران که منو می‌شناسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 843.6,
   "end": 847.28,
   "text": "الله اکبر گلومو پاره می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 847.28,
   "end": 849.32,
   "text": "ولی وقتی رفتم تو محله‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 849.32,
   "end": 851.7,
   "text": "همه مخالفن، همه هم نه، یه عده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 851.7,
   "end": 856.72,
   "text": "پررو هم هستن، اونجا خلوت کردی خودتی، اونجا خودتی و خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 856.72,
   "end": 862.16,
   "text": "جگر داری بگی؟ بعد اونا چقدر تو باطلشون با هم منسجم‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 862.16,
   "end": 866.56,
   "text": "برنامه داشتن که هرکی الله اکبر گفت فحشش بدید که می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 866.56,
   "end": 870.44,
   "text": "بعد ما انقدر مثلا از هم متاسفانه بعضا نه همه جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 870.44,
   "end": 873.16,
   "text": "متفرق، متفرق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 873.16,
   "end": 875.8,
   "text": "من که خودم به شما میگم خودم فحششو خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 875.8,
   "end": 881.86,
   "text": "خیلی هم برام کیف داد. یعنی از صد تا نماز شب به خدا نزدیک شدم با فحش‌هایی که با بیست و دو بهمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 881.86,
   "end": 884.4,
   "text": "الله اکبر گفتنم خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 884.4,
   "end": 889.6,
   "text": "نوش جونم. چقدر کیف داره آدم فحش بخوره، چک بخوره تو راه انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 889.6,
   "end": 893.82,
   "text": "بماند به در خلوات آقا جان تو خلوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 893.82,
   "end": 897.64,
   "text": "آدم ذکر بگه. یه روایت قدسی دیگه‌ای هم بگم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 897.64,
   "end": 901.14,
   "text": "این روایت جای شرح و بسط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 901.14,
   "end": 907.34,
   "text": "توضیح داره. فقط صورت روایتو بگم کیف کنید باهاش مثل عسل به کامتون شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 907.34,
   "end": 910.96,
   "text": "سند هم که ما بی‌سند اینجا حرف نمی‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 910.96,
   "end": 913.8,
   "text": "کافی مرحوم کلینی اعلم الله مقامه الشریف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 913.8,
   "end": 915.84,
   "text": "جلد هشت، صفحه صد و چهل و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 915.84,
   "end": 919.0,
   "text": "يا عيسى پس پیداست که حدیث چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 919.0,
   "end": 921.8,
   "text": "قدسیه. يا عيسى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 921.8,
   "end": 924.98,
   "text": "به به اطب لي قلبك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 924.98,
   "end": 928.62,
   "text": "این دلت رو برای من پاک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 928.62,
   "end": 932.78,
   "text": "با چی؟ و اكثر ذكري في الخلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 932.78,
   "end": 935.52,
   "text": "تو خلوتت اگه راست میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 935.52,
   "end": 937.84,
   "text": "بسیار یاد من کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 937.84,
   "end": 939.98,
   "text": "بعد واعلم ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 939.98,
   "end": 942.54,
   "text": "سروري ان تبسبس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 942.54,
   "end": 946.94,
   "text": "الي الله اکبر تو این بحث تبسبس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 946.94,
   "end": 951.54,
   "text": "کن في ذا لك حيا ولا تكن ميتا مثل میت نباش موقع ذکر گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 951.54,
   "end": 953.98,
   "text": "حیا دل زنده باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 953.98,
   "end": 958.02,
   "text": "بعد هم حالت تبسبس بگیر یعنی تمام وجودت بیفته به پای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 958.02,
   "end": 961.56,
   "text": "خواهش و التماس کن از من، از من خواهش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 961.56,
   "end": 968.7,
   "text": "کی؟ تو خلوت‌ها. می‌دونید چرا بعضی از ماها موعظه‌مون تاثیر نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 968.7,
   "end": 973.26,
   "text": "می‌ذارید، می‌دونید چرا بعضی از مداح‌هامون دل سنگ می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 973.26,
   "end": 977.04,
   "text": "چون صرفا میان برای مردم نمایشی دعا می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 977.04,
   "end": 982.16,
   "text": "روضه می‌خونیم ولی خلوتمون نه دعایی، نه ذکری، نه خلوتی، نه چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 982.16,
   "end": 985.18,
   "text": "نه نماز شب. همین طوری می‌شینم رو منبر مردم نماز شب بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 985.18,
   "end": 988.94,
   "text": "خودت چرا به کمرت بزنه؟ چرا خودت نخوندی میای میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 988.94,
   "end": 994.66,
   "text": "لذا تاثیر نداره. مداح موفق، سخنرانی موفقی که خلوتش رو دریابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 994.66,
   "end": 998.26,
   "text": "بعد حالا در جلوت هم چیزی گفت انشالله به دل می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 998.26,
   "end": 1000.12,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1000.12,
   "end": 1003.2,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1003.2,
   "end": 1010.0,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}