   "start": 6.76,
   "end": 136.8
  },
  {
   "index": 1,
   "title": "و چنان‌که اهل ایمان نیز مراتب دارند:",
   "start": 136.8,
   "end": 173.6
  },
  {
   "index": 2,
   "title": "## لیالی قدر و همواری راه توبه",
   "start": 173.6,
   "end": 193.82
  },
  {
   "index": 3,
   "title": "## مکان‌های شریف",
   "start": 193.82,
   "end": 214.18
  },
  {
   "index": 4,
   "title": "## نفحات الهی در میراث عرفانی و حدیث",
   "start": 214.18,
   "end": 389.22
  },
  {
   "index": 5,
   "title": "## روایت یعقوب و یوسف در علل الشرایع",
   "start": 389.22,
   "end": 824.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.76,
   "end": 10.76,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.76,
   "end": 15.16,
   "text": "و به این استعذین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.16,
   "end": 17.94,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.94,
   "end": 21.04,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.04,
   "end": 25.34,
   "text": "از رهبر عزیزمون استفتاء شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.34,
   "end": 28.34,
   "text": "و عزیزانی که جلسه دارن میخوان تشریف ببرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.34,
   "end": 30.76,
   "text": "این حکم رو گوش بدن و برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.76,
   "end": 33.7,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.7,
   "end": 38.14,
   "text": "آیا شرکت کردن در انتخابات جمهوری اسلامی ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.14,
   "end": 41.88,
   "text": "واجبه و عدم شرکت حرامه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.88,
   "end": 44.46,
   "text": "رهبر عزیزمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.46,
   "end": 49.02,
   "text": "شرکت کردن در انتخابات جمهوری اسلامی ایران وظیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.02,
   "end": 51.84,
   "text": "شرعی، اسلامی و الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.84,
   "end": 59.58,
   "text": "همه است. بعد از در یک استفتای دیگه پرسیدن آیا این واجب عینیه یا کفاییه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.58,
   "end": 62.6,
   "text": "کفایی فرقش با عینی اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.6,
   "end": 66.04,
   "text": "مثلاً یه عده‌ای شرکت کنن دیگه کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.04,
   "end": 71.94,
   "text": "این کفاییه. اگر عینی باشه یعنی عینا هر کسی عینا دید براش واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.94,
   "end": 74.04,
   "text": "کاری نداره کی شرکت کرده یا نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.04,
   "end": 76.84,
   "text": "واجبه برای همه. همه عینا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.84,
   "end": 82.2,
   "text": "رهبر عزیزمون فرمودن شرکت در انتخابات جمهوری اسلامی واجب عینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.2,
   "end": 84.52,
   "text": "یعنی همه عینا باید شرکت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.52,
   "end": 90.74,
   "text": "یه صلوات بفرستین. الله، الله، الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.74,
   "end": 96.48,
   "text": "بچه‌ها این صلوات رو ما گرفتیم که دوستانی که میخوان جلسه تشریف ببرن تشریف ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.48,
   "end": 100.6,
   "text": "اما بحث قلب لین رو یا لَین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.6,
   "end": 102.92,
   "text": "در این بودیم که چه کارهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.92,
   "end": 106.88,
   "text": "قلب رو نرم می‌کنه. قلب لَین یا لَین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.88,
   "end": 110.12,
   "text": "آیه‌شم که قبلاً خوندیم. یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.12,
   "end": 114.2,
   "text": "کارهایی که قلب رو نرم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.2,
   "end": 122.98,
   "text": "توجه به نفس کینونت اس-- در خصوص نفس کینونت زمان و مکان حرف زدیم چند بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.98,
   "end": 126.96,
   "text": "که زمان‌ها و مکان‌ها در نفس خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.96,
   "end": 130.46,
   "text": "یک شرافتى دارن نسبت به هم فضیلت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.46,
   "end": 134.94,
   "text": "همونطور که \"تِلْكَ الرُّسُلْ فَأَوَّلْنَا بَعْضَهُمْ عَلَى بَعْضٍ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.94,
   "end": 138.34,
   "text": "انبیا به هم برتری دارن. همونطور که اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.34,
   "end": 143.6,
   "text": "که \"يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.6,
   "end": 147.54,
   "text": "خدا این اهل ایمانو بالا می‌بره اما \"وَالَّذِينَ أُوتُوا الْعِلْمَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.54,
   "end": 150.36,
   "text": "دَرَجَاتٍ\" اونکه علم داره درجات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.36,
   "end": 152.88,
   "text": "درجاتش بالاتره. اهل ایمان یه درجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.88,
   "end": 155.12,
   "text": "علما درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.12,
   "end": 157.04,
   "text": "خب همین‌طور در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.04,
   "end": 160.36,
   "text": "زمان‌ها و مکان‌هام این فضیلت‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.36,
   "end": 162.58,
   "text": "زمان‌ها و مکان‌ها بر هم فضیلت‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.58,
   "end": 165.22,
   "text": "توجه و استفاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.22,
   "end": 173.06,
   "text": "از این زمان‌ها و مکان‌های خاص که شرافت دارن، فضیلت و برتری دارن دل رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.06,
   "end": 179.56,
   "text": "مثلاً لیالی قدر. اصلاً نفس کینونت نوا-- لا-- لیالی قدر این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.56,
   "end": 183.18,
   "text": "اصلاً یک روح دیگه‌ای عالم رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.18,
   "end": 188.1,
   "text": "آدم خیلی راحت‌تر می‌تونه به سمت حضرت حق بره ترجمه‌ش بخوایم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.1,
   "end": 191.7,
   "text": "چرا راحت‌تر می‌تونه بره؟ چرا راحت‌تر می‌تونه ارتباط بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.7,
   "end": 196.04,
   "text": "چرا توبه آسون‌تره؟ راه چون اون زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.04,
   "end": 199.32,
   "text": "اون زمان در جان خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.32,
   "end": 202.58,
   "text": "خدا یه کینونتی رو قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.58,
   "end": 206.04,
   "text": "در تکوینش یعنی آفرینشش اصلاً ذاتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.04,
   "end": 208.7,
   "text": "که راه‌ها رو هموار می‌کنه، دل‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.7,
   "end": 214.18,
   "text": "خدا انگار اون زمان توجه خاص و ویژه به دل می‌کنه، دل راحت نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.18,
   "end": 219.06,
   "text": "و مثلاً لیالی قدر هفته، لیلة القدر هفته که شب جمعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.06,
   "end": 222.7,
   "text": "ساعات و آنات که قبلاً اینجا توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.7,
   "end": 225.68,
   "text": "دوازده ساعت هر شبانه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.68,
   "end": 230.2,
   "text": "نه ساعت اول، دوم، سوم منظور ساعتی یک و دو و سه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.2,
   "end": 234.74,
   "text": "اون ساعت که بعضیاش یه ربع بعضیاش دو ساعته، چهار ساعته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.74,
   "end": 241.74,
   "text": "مربوط به یکی از اهل بیته توجه به اون زمان‌ها و اون ساعات نه اینکه خب همه در این ساعات قرار دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.74,
   "end": 244.56,
   "text": "توجه به اون ساعت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.56,
   "end": 247.28,
   "text": "عرض شود با توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.28,
   "end": 251.3,
   "text": "به صاحب اون ساعت، اون زیارت نامه‌ای که معروفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.3,
   "end": 254.96,
   "text": "در هر ساعتی سلامی که به اهل بیت می‌دن اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.96,
   "end": 258.34,
   "text": "این‌ها دل رو نرم می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.34,
   "end": 261.68,
   "text": "عرض شود خدمتتون مکان‌هام همچنین هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.68,
   "end": 267.3,
   "text": "مکان‌هام مثل حرم‌ها، حرم‌های اهل بیت علیهم‌السلام، مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.3,
   "end": 269.54,
   "text": "جاهایی که در، در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.54,
   "end": 272.8,
   "text": "عالم، عالم ربانی البته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.8,
   "end": 276.2,
   "text": "در جوار پدر و مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.2,
   "end": 281.64,
   "text": "طوری که جناحینت رو این دست و پات رو بندازی زمین، بالات رو باز کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.64,
   "end": 287.12,
   "text": "خاضعانه، ذلیلانه در کنار پدر و مادر نشستن اینا دل رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.12,
   "end": 291.7,
   "text": "نگاه کردن به صورت عالم، به مناره و گنبد مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.7,
   "end": 295.36,
   "text": "و، و، و. یکی از اون بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.36,
   "end": 299.62,
   "text": "جاها و در حقیقت از یک حس میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.62,
   "end": 303.02,
   "text": "مکانتش از یک حس میشه زمانش گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.02,
   "end": 306.0,
   "text": "که دل نرم هست اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.0,
   "end": 311.5,
   "text": "و باید این نرمی رو تقویت کرد و حفظ کرد، جوانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.5,
   "end": 315.3,
   "text": "استفاده از خصوصیت جوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.3,
   "end": 319.96,
   "text": "جوانی تمام بزرگان بدون استثنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.96,
   "end": 327.14,
   "text": "شما می‌بینید همشون نصیحت به جوان‌ها و حتی اونایی که موفق بودن مثل علامه حسن زاده بارها ما ازشون شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.14,
   "end": 330.18,
   "text": "که ایشون می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.18,
   "end": 332.76,
   "text": "قدر جوانی‌تون رو بدونید ما ندونستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.76,
   "end": 335.5,
   "text": "عجب! شما ندونستی پس ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.5,
   "end": 339.04,
   "text": "حضرت امام، دیگران، رهبر بارها، جوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.04,
   "end": 341.8,
   "text": "در جوانی دل نرم‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.8,
   "end": 344.26,
   "text": "و این نرمش دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.26,
   "end": 347.18,
   "text": "که خصوصیت جوانیه باید تقویت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.18,
   "end": 351.68,
   "text": "اگر تقویت نشه رفته رفته زمخت می‌شه، خشن می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.68,
   "end": 354.18,
   "text": "بعد نفحات الهی درش تأثیر نمی‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.18,
   "end": 356.4,
   "text": "نفحه نسیم، نسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.4,
   "end": 359.12,
   "text": "نفحات، نسیم‌هات. یه کتابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.12,
   "end": 363.3,
   "text": "مرحوم صدر‌القونوی داره از برجسته‌ترین شاگردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.3,
   "end": 365.76,
   "text": "ابن عربی‌ست که شاگرد ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.76,
   "end": 371.04,
   "text": "استاد ابن فناری است صاحب کتاب شریف مصباح العنس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.04,
   "end": 377.56,
   "text": "که ایشون تو متن کتاب مصباح العنسش بعضی موقع‌ها میزنه بحث رو به نفحات استادش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.56,
   "end": 380.3,
   "text": "نفحات. نوشتن بزرگان پیرامون این مسئله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.3,
   "end": 382.28,
   "text": "یه روایت هم داریم. الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.28,
   "end": 384.78,
   "text": "می‌فرماید انى لربکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.78,
   "end": 389.22,
   "text": "انى لربکم. حالا چقدر شیرین و در مایه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.22,
   "end": 393.1,
   "text": "برای پروردگار شما فی ایام دهرکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.1,
   "end": 397.24,
   "text": "اونم دهر شما. دهر حالا فرقش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.24,
   "end": 400.38,
   "text": "زمان و دنیا چیه؟ فرقش با سرمد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.38,
   "end": 403.78,
   "text": "فی ایام دهرکم نفحات، نفحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.78,
   "end": 406.16,
   "text": "یه نسیمه‌ای میاد. یه جا می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.16,
   "end": 410.6,
   "text": "فتعرضوا لها خودتونو در معرض اون قرار بدید، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.6,
   "end": 414.04,
   "text": "یه جای دیگه در کنز العمال حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.04,
   "end": 416.84,
   "text": "بیست و یک هزار و سیصد و بیست و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.84,
   "end": 423.8,
   "text": "ادامه‌ش اینطوریه. فتعرضوا له لعله ان يصیبكم نفحة منها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.8,
   "end": 427.54,
   "text": "فلا تشقون بعدها ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.54,
   "end": 432.66,
   "text": "فرمود که باشد که نسیمی از رحمت پروردگار شما به شما بوزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.66,
   "end": 434.64,
   "text": "خودتو در معرض اون قرار بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.64,
   "end": 438.04,
   "text": "و پس از اون هرگز به شقاوת نیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.04,
   "end": 440.38,
   "text": "خیلی مهمه این نفحه، نفحه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.38,
   "end": 442.12,
   "text": "در جوانی اینا بیشتر درک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.12,
   "end": 447.5,
   "text": "اگه تقویت نرمی دل صورت نگیره یعنی سیر و سلوک، یعنی مراقبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.5,
   "end": 453.4,
   "text": "حس حضور داشتن، اینا صورت نگیره هرچی پا به سن می‌ذاری زمخت می‌شه، کلفتی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.4,
   "end": 455.9,
   "text": "خشن می‌شه. مثل این که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.9,
   "end": 460.38,
   "text": "الان یه کابل، کابل رو طوفان شاید تکونش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.38,
   "end": 462.6,
   "text": "نسیم که کابل رو تکون نمی‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.6,
   "end": 466.34,
   "text": "اما یه تار رو یه نسیم هم می‌نوازش، تکون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.34,
   "end": 469.5,
   "text": "علت این‌که بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.5,
   "end": 474.04,
   "text": "مع-- یعنی نسیم‌ها رو دریافت می‌کنند چون دل نازک‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.04,
   "end": 477.66,
   "text": "الان دارین می‌فهمین. چون دلشون نرمه، نازک دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.66,
   "end": 481.22,
   "text": "من خشن شده، زمخت شده، سفت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.22,
   "end": 485.52,
   "text": "طوفان باید بیاد تا طوفان لیلة القدر باید بیاد تا تکونش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.52,
   "end": 487.8,
   "text": "خیلی مهمه. من برای این‌که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.8,
   "end": 495.44,
   "text": "اهمیت این موضوع رو به خودم و شما متوجه کنم یه روایت خیلی شیرین تقدیم کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.44,
   "end": 502.12,
   "text": "بدونید شما بعد پنجاه سال من اولین بار بود این روایت رو متوجهش شدم و برام خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.12,
   "end": 506.54,
   "text": "که علل و شرایع صفحه پنجاه و چهار حدیثی است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.54,
   "end": 509.34,
   "text": "شخصی به نام عن اسماعیل بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.34,
   "end": 513.26,
   "text": "عن اسماعیل بن الفضل هاشمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.26,
   "end": 516.62,
   "text": "این شخص قلت لجعفر بن محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.62,
   "end": 520.52,
   "text": "می‌گه من سؤال کردم از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.52,
   "end": 522.82,
   "text": "صلی الله علیه امام جعفر صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.82,
   "end": 525.16,
   "text": "اخبرنی عن یعقوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.16,
   "end": 527.24,
   "text": "به من خبر بده از حضرت یعقوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.24,
   "end": 530.34,
   "text": "چرا؟ لما. از چی خبر بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.34,
   "end": 533.44,
   "text": "لما قال له بنوه اون موقع که به فرزندان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.44,
   "end": 536.1,
   "text": "فرزندانش اومدن پیشش گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.1,
   "end": 538.3,
   "text": "بنوه، فرزندانش گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.3,
   "end": 543.42,
   "text": "قالوا یا ابانا استغفر لنا ذنوبنا انا کنا خاطئین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.42,
   "end": 546.86,
   "text": "ما خطا کردیم برامون استغفار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.86,
   "end": 549.46,
   "text": "قال حضرت یعقوب چی گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.46,
   "end": 552.86,
   "text": "گفت سوف استغفر لکم ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 552.86,
   "end": 556.98,
   "text": "نزد پروردگارم در آینده برای شما استغفار می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 556.98,
   "end": 559.54,
   "text": "فأخر الاستغفار لهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.54,
   "end": 561.44,
   "text": "براشون تأخیر انداخت استغفار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.44,
   "end": 564.98,
   "text": "همونجا چرا استغفار نکرد؟ سؤال قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.98,
   "end": 572.12,
   "text": "و یوسف. حالا درخواست یوسف هم آقا به ما خبر بده که برعکسش اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.12,
   "end": 581.16,
   "text": "لما قالوا له وقتی که برادرها اومدن گفتن بهش تلاhe لقد أثرک الله علينا ان کنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 581.16,
   "end": 587.44,
   "text": "لخطیئين تا گفتن ما خطا کردیم و اینا برگشتن قال یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 587.44,
   "end": 590.52,
   "text": "فرمود که لا تثریب عليكم اليوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.52,
   "end": 592.32,
   "text": "سرزنش امروز بر شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 592.32,
   "end": 595.2,
   "text": "یغفر الله لکم و هو ارحم الراحمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 595.2,
   "end": 597.98,
   "text": "خدا شما رو می‌بخشه. اونم ارحم الراحمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.98,
   "end": 602.06,
   "text": "حالا سؤال چیه؟ چرا هر دو پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 602.06,
   "end": 604.9,
   "text": "چرا حضرت یعقوب گفت بعدا استغفار می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.9,
   "end": 607.8,
   "text": "حضرت یوسف نه استغفار همونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.8,
   "end": 611.06,
   "text": "گفتش که اصلاً سرزنشیم بر شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 611.06,
   "end": 614.0,
   "text": "توبت‌تون قبوله. این فرقش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.0,
   "end": 616.14,
   "text": "این ببینید ما قبلاً شنیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.14,
   "end": 618.9,
   "text": "حالا انتهای روایت هم همین و باز تصریح داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 618.9,
   "end": 628.5,
   "text": "که به خاطر شرافت ببین نفس کینونت زمان، شرافت سحر شب جمعه حضرت یعقوب وعده داد سحر، سحر شب جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 628.5,
   "end": 632.3,
   "text": "دعا می‌کنم که دیگه قطعیه. اینو همه شنیدیم بارها ما گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 632.3,
   "end": 636.58,
   "text": "دیدیم. اما اینجا این تیکه رو من اولین بار بود متوجه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.58,
   "end": 644.28,
   "text": "خیلی شیرین بود. حضرت سه تا دلیل میاره بر اینکه چرا یوسف بلافاصله قبول کرد حضرت یس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.28,
   "end": 646.6,
   "text": "یعقوب بعداً وعده داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.6,
   "end": 650.1,
   "text": "قال. کی قال؟ امام جعفر صادق علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.1,
   "end": 653.44,
   "text": "لان قلب الشاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.44,
   "end": 655.7,
   "text": "أرق أو أرق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.7,
   "end": 657.88,
   "text": "أرق من قلب الشيخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 657.88,
   "end": 660.54,
   "text": "عجب! دلیل اول چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 660.54,
   "end": 664.72,
   "text": "قلب جوان نرم‌تر از قلب پیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 664.72,
   "end": 667.94,
   "text": "یعنی حضرت یعقوب پیر درسته پیغمبر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 667.94,
   "end": 670.86,
   "text": "اما باز یعقوب سنش بالا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 670.86,
   "end": 674.54,
   "text": "یوسف جوان بود. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 674.54,
   "end": 678.8,
   "text": "الله اکبر واقعاً. یعنی تو انبیا می‌شه این رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 678.8,
   "end": 683.54,
   "text": "انقدر موضوع مهمه. خب تلك الرسل فضلنا بعضهم على بعض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.54,
   "end": 689.76,
   "text": "و حضرت یوسف هم البته به این هم دقت داشته باشین ولایت داشت بر حضرت یعقوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.76,
   "end": 695.04,
   "text": "دومین دلیل. و كانت جنایت ولد یعقوب على یوسف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.04,
   "end": 701.28,
   "text": "جنایت فرزندان یعقوب به خاطر یوسف بود و جنایتهم على یعقوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 701.28,
   "end": 704.82,
   "text": "انما كانت بجنایتهم على یوسف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.82,
   "end": 707.96,
   "text": "یعنی به خاطر جنایتی که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 707.96,
   "end": 710.3,
   "text": "فرزندش کرده بودن اومده بودن پیشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 710.3,
   "end": 712.74,
   "text": "یعنی حق، حق خودش نبود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 712.74,
   "end": 715.32,
   "text": "حضرت یعقوب بخواد ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 715.32,
   "end": 717.18,
   "text": "مثل این که ما حق دیگران رو می‌بخشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 717.18,
   "end": 719.14,
   "text": "می‌گیم نوش جونت. به تو چه که می‌بخشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 719.14,
   "end": 722.86,
   "text": "تو چی کاره‌ای که میگی آقا طرف خطا کرده، گناه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 722.86,
   "end": 724.86,
   "text": "مثلاً ساختار نظام رو شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.86,
   "end": 726.86,
   "text": "جسارت به رهبری که ببخشی بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 726.86,
   "end": 729.02,
   "text": "خب تو حق خودتو می‌تونی ببخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 729.02,
   "end": 732.56,
   "text": "حق آقا رو می‌تونی؟ حق این همه ملت رو می‌تونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 732.56,
   "end": 735.86,
   "text": "اون قصه‌ش فرق می‌کنه. حق ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 735.86,
   "end": 740.4,
   "text": "نسبت به این‌که از کسی یعنی به کس دیگه‌ای درسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 740.4,
   "end": 743.06,
   "text": "تب-- تا-- در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 743.06,
   "end": 746.76,
   "text": "تابع جنایت و ظلم اون‌ها پرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 746.76,
   "end": 751.72,
   "text": "حضرت یعقوب رو هم گرفت. گریه‌های این همه سالش نزدیک به چهل سالش و نابینا شدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 751.72,
   "end": 754.52,
   "text": "اما اصل جنایت بر حضرت یوسف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 754.52,
   "end": 757.3,
   "text": "من چی کاره‌ام که. و اینم دلیل دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 757.3,
   "end": 760.98,
   "text": "دلیل آخر که عزیزم ساعت رو نگاه کرد منم سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 760.98,
   "end": 763.2,
   "text": "دلیل آخرم بگم دیگه توضیح ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.2,
   "end": 767.38,
   "text": "دلیل آخر. و أخر یعقوب العفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 767.38,
   "end": 770.64,
   "text": "و تأخیر انداخت یعقوب استغفار رو عفو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 770.64,
   "end": 775.34,
   "text": "چرا؟ لأن عفوه انما کان عن حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.34,
   "end": 779.14,
   "text": "غیره فأخره إلى سحر ليلة الجمعة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 779.14,
   "end": 782.6,
   "text": "باز تاکید می‌کنه یکیش این بود که به خاطر دیگری بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 782.6,
   "end": 786.62,
   "text": "حق دیگری رو باید عفو می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 786.62,
   "end": 790.46,
   "text": "دو به خاطر اهمیت سحر شب جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 790.46,
   "end": 793.48,
   "text": "اما اولین دلیل رو حضرت چی زد کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 793.48,
   "end": 796.8,
   "text": "نرمی دل. حضرت یوسف سریع بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 796.8,
   "end": 801.44,
   "text": "چقدر خوبه که. قدیم‌ها می‌گفتن همه چی تو جوونی خوبه، خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 801.44,
   "end": 805.48,
   "text": "یا حتی تازه داریم می‌فهمیم که حالا که داریم پیر می‌شیم موهامون داره سفید می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 805.48,
   "end": 807.22,
   "text": "تازه می‌فهمیم جسارت به شمارشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 807.22,
   "end": 809.34,
   "text": "مرگ هم تو جوونی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 809.34,
   "end": 811.5,
   "text": "به خدا. آدم بارش سبک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 811.5,
   "end": 813.3,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 813.3,
   "end": 816.76,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 816.76,
   "end": 818.66,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 818.66,
   "end": 824.2,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}