 "chapters": [
  {
   "index": 0,
   "title": "## صلهٔ رحم و نرمی قلبِ لیّن",
   "start": 17.2,
   "end": 99.06
  },
  {
   "index": 1,
   "title": "## صله قطع نبودن است نه الزامِ هرروزه",
   "start": 99.06,
   "end": 530.43
  },
  {
   "index": 2,
   "title": "## روایات قطع رحم و زیادت عمر",
   "start": 530.43,
   "end": 550.63
  },
  {
   "index": 3,
   "title": "## آیهٔ نساء؛ اتقوا الله و الارحام",
   "start": 550.63,
   "end": 766.41
  },
  {
   "index": 4,
   "title": "## تجربهٔ نرمی دل پای پدر و مادر",
   "start": 766.41,
   "end": 836.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.54,
   "end": 8.62,
   "text": "بسم الله الرحمن الرحيم و به هي نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.62,
   "end": 11.44,
   "text": "السلام عليك يا داعي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.44,
   "end": 14.54,
   "text": "و رباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.54,
   "end": 17.2,
   "text": "السلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.2,
   "end": 19.82,
   "text": "یکی دیگه از چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.82,
   "end": 24.66,
   "text": "دل رو نرم می‌کنه در بحث قلب اللئن یا لئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.66,
   "end": 30.44,
   "text": "صله رحمه. خیلی تاکید شده در آینه‌ی آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.44,
   "end": 34.7,
   "text": "حالا صله یعنی وصل شدن دو چیز به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.7,
   "end": 36.86,
   "text": "این صله می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.86,
   "end": 42.5,
   "text": "وصل شدن دو چیزی باشد که یکی‌شون اصله یکی‌شون فرعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.5,
   "end": 48.08,
   "text": "یعنی اینکه این وصل می‌شه به اصل خودش، به ریشه‌ی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.08,
   "end": 51.74,
   "text": "یا اینکه وصل شدن به چیزی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.74,
   "end": 56.94,
   "text": "اون این دو تا هر دو اصل‌شون از یک ریشه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.94,
   "end": 62.66,
   "text": "به این شکل. حالا اون که وصل می‌شه به اصلش و ریشه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.66,
   "end": 67.38,
   "text": "می‌شه مثلا صله رحم به پدر و مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.38,
   "end": 70.84,
   "text": "اون که به چیزی وصل می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.84,
   "end": 77.6,
   "text": "هر دو از یک جنسن، از یک ریشه‌ن می‌شه مثل وصل شدن به خواهر و برادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.6,
   "end": 81.36,
   "text": "حالا این رحم هم به جایی می‌گن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.36,
   "end": 84.96,
   "text": "جنین پرورش پیدا می‌کنه در جان مادر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.96,
   "end": 87.1,
   "text": "در اون باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.1,
   "end": 92.14,
   "text": "مکمن از دید ما غیبی‌ست، دیده نمی‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.14,
   "end": 96.24,
   "text": "حتی از دید مادر فقط حسش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.24,
   "end": 100.24,
   "text": "یعنی باز می‌بینه که ریشه از یک جاست، صله رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.24,
   "end": 103.56,
   "text": "حالا، حالا این یا از حیث مادیه یا معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.56,
   "end": 107.3,
   "text": "مادیش هم یا سببیه یا نسوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.3,
   "end": 110.82,
   "text": "که نسوی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.82,
   "end": 117.42,
   "text": "پدر، مادر، خواهر، برادر، عمه، دایی، خاله، عمو اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.42,
   "end": 120.94,
   "text": "سببیش می‌شه با ازدواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.94,
   "end": 123.24,
   "text": "مثلا خود همسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.24,
   "end": 127.64,
   "text": "فرزندان، پدر همسر، مادر همسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.64,
   "end": 130.94,
   "text": "خواهر برادراش، همچنین دایی‌هاش، عموهاش، خاله هاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.94,
   "end": 139.0,
   "text": "عمه هاش به این شکل. یه صله رحم هم داریم که از این بالاتره رحم معنوی هستن که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.0,
   "end": 143.98,
   "text": "می‌شه اصلش که خود خداست و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.98,
   "end": 154.78,
   "text": "ظهور او هستن. اصل اونه بقیه متفرع بر او هستن و تحت تدبیر متفرد به جبروت او هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.78,
   "end": 157.58,
   "text": "بعد پیغمبر عزیز عالمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.58,
   "end": 161.5,
   "text": "اهل بیت عترتش علیهم الصلاة والسلام، قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.5,
   "end": 167.06,
   "text": "همچنین به رتبه از جهت رتبه‌ای بعد می‌شه نوبت علما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.06,
   "end": 173.16,
   "text": "علما و بزرگان اهل معرفت همچنین تا دیگه میاد تا انزل المرتب که اهل ایمانن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.16,
   "end": 176.4,
   "text": "اهل ایمان. این‌ها از جهت معنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.4,
   "end": 178.04,
   "text": "ریشه‌شون به یه جا بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.04,
   "end": 180.44,
   "text": "یعنی اون رحم اصلی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.44,
   "end": 182.78,
   "text": "می‌شه اسلام، می‌شه ایمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.78,
   "end": 187.38,
   "text": "ریشه یکیه. که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.38,
   "end": 189.72,
   "text": "صله‌ش واجبه. صله‌ی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.72,
   "end": 192.62,
   "text": "حالا صله هم یعنی وصل باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.62,
   "end": 196.5,
   "text": "صله نه یعنی اینکه حتماً، حتماً بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.5,
   "end": 201.32,
   "text": "الا بلا هر روز سرکشی کنی بری خونه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.32,
   "end": 204.66,
   "text": "این نه. از حیث معنوی خب هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.66,
   "end": 208.58,
   "text": "هر روزم بری، هر ساعت و هر آنی بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.58,
   "end": 211.52,
   "text": "آدم بره در خونه خدا اشکال نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.52,
   "end": 216.82,
   "text": "اما از جهت مادی و این‌ها بحث پدر، مادر، خواهر، برادر، عمه، دایی، خاله این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.82,
   "end": 220.0,
   "text": "نه، اونو گفتن همین که وصل باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.0,
   "end": 223.56,
   "text": "قطع نباشی. می‌شه با یه نامه، می‌شه با یه تلفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.56,
   "end": 227.88,
   "text": "فلانی سلام منو با مثلا آ-آبجی مورد نظر سلام برسون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.88,
   "end": 230.62,
   "text": "یعنی قطع نیست. اینم صله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.62,
   "end": 232.78,
   "text": "اینایی که وقتی می‌بینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.78,
   "end": 237.74,
   "text": "صله رحم به اون معنای متعارف امروزی رو انجام میدن، میرن خونه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.74,
   "end": 241.06,
   "text": "بچه‌شون مثل زلزله می‌شه. مثلا ماهواره دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.06,
   "end": 248.68,
   "text": "اخلاق‌شون با اینا اعتقادات‌شون همخوانی نداره، خمس نمیدن، نمی‌دونم ولایت رو قبول ندارن، بی‌ادبی می‌کنن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.68,
   "end": 252.4,
   "text": "مقدسات این‌ها. نه اینا حتما نباید برن خونه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.4,
   "end": 255.5,
   "text": "کی گفته؟ همین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.5,
   "end": 261.08,
   "text": "یه سلامی برسونن، حالشو بپرسن، زنگ بزنن این‌ها یه پیامی بفرستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.08,
   "end": 263.76,
   "text": "قدیم‌ها نامه بود حالا پیامک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.76,
   "end": 266.3,
   "text": "این‌ها یعنی صله. یعنی قطع نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.3,
   "end": 269.32,
   "text": "البته شرافت پدر و مادر از همه بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.32,
   "end": 272.02,
   "text": "پدر و مادر رو باید سر زد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.02,
   "end": 275.78,
   "text": "اونو نمی‌شه. باید رفت، باید سرکشی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.78,
   "end": 278.92,
   "text": "ولو اگر فاسق باشه. روایت داریم ولو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.92,
   "end": 282.22,
   "text": "کافر و فاسق باشه. اصلا اون قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.22,
   "end": 285.78,
   "text": "اون ریشه‌ست، اون رحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.78,
   "end": 289.24,
   "text": "بقیه نه. همچنین در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.24,
   "end": 292.68,
   "text": "از جهت معنوی هم پیغمبر ریشه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.68,
   "end": 296.66,
   "text": "یعنی آدم دائم باید مرت-مرتبط با پیغمبر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.66,
   "end": 298.9,
   "text": "و اهل بیت. اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.9,
   "end": 302.7,
   "text": "این بحث صلوات ارزش و اهمیت صلوات اینجا معلوم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.7,
   "end": 306.68,
   "text": "آنفعال. آدم بتونه مرتبط با اونا صلوات یعنی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.68,
   "end": 309.58,
   "text": "صله معنوی با اون ریشه‌ی اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.58,
   "end": 311.32,
   "text": "و اون اب بودن اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.32,
   "end": 314.68,
   "text": "انا و علی ابوا عادل و ما نفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.68,
   "end": 317.74,
   "text": "ما والدیم. والد یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.74,
   "end": 321.78,
   "text": "پدر و مادری که از یه رحم و یک صلب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.78,
   "end": 324.84,
   "text": "به این شکل. این‌ها مادین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.84,
   "end": 327.72,
   "text": "اما اون اب یعنی ریشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.72,
   "end": 330.64,
   "text": "اگر بگیری ابر و پدر این اشتباه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.64,
   "end": 337.38,
   "text": "بعضی مفسرین کردن به قول حضرت آقا علم الهدى حسن زاده داد می‌زنه سر این مفسرین که این اشتباهات رو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.38,
   "end": 342.06,
   "text": "که چرا مثلا اونجا که لأبيه آزر حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.06,
   "end": 349.02,
   "text": "به پدرش لأبيه آزر به پدرش آزر اگه بخوایم ابر و پدر معنا کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.02,
   "end": 351.38,
   "text": "گفت از این شرکت بردار. اونم گوش نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.38,
   "end": 353.9,
   "text": "مف-- نمی‌شه که انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.9,
   "end": 357.72,
   "text": "قطعاً و مسلماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.72,
   "end": 364.26,
   "text": "آبا و اجدادشون کنتم في الاصلاب الشامخة والارحام المطهرة موحد باید باشن سلسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.26,
   "end": 370.51,
   "text": "یه دونه یعنی یک، یک تو این رن-زنجیره حلقه های وصل آبا و اجداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.51,
   "end": 374.93,
   "text": "انبیا و اولیا و اهل بیت یه دونه غیر موحد نمیشه پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.93,
   "end": 377.41,
   "text": "اصلا نه عقلًا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.41,
   "end": 379.91,
   "text": "قطع بشه اصلا این shows نمیتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.91,
   "end": 386.61,
   "text": "نبی بشه، نمیتونه امام بشه، نمیتونه از جزء ائمه هدی و الگوی همه عالم قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.61,
   "end": 389.39,
   "text": "نیست. اونا اشتباه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.39,
   "end": 392.01,
   "text": "اب اینجا رو به معنای پدر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.01,
   "end": 401.17,
   "text": "اگر پدر به معنای پدر متعارف امروز بود که حضرت آزر که پدر حضرت ابراهیم نبود چرا قرآن بهش میگه اب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.17,
   "end": 405.47,
   "text": "لفظ اب رو میاره. یعنی سرپرست کسی که بزرگش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.47,
   "end": 408.37,
   "text": "یعنی سرپرستشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.37,
   "end": 410.33,
   "text": "سررشته امورش رو در دست داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.33,
   "end": 412.73,
   "text": "یکی از معانیش اینه. اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.73,
   "end": 414.83,
   "text": "معنی اب یعنی ریشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.83,
   "end": 417.11,
   "text": "یعنی اصل. اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.11,
   "end": 420.15,
   "text": "آدم از اون اصلش نباید ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.15,
   "end": 427.93,
   "text": "از اون اصلیتش. اگه ببره ببینید شما برگ از درخت که اصلشو قطع میشه از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.93,
   "end": 430.05,
   "text": "یه میوه رو از درخت بچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.05,
   "end": 433.71,
   "text": "باید سریع بخوریش و الا رفته رفته از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.71,
   "end": 435.45,
   "text": "پژمرده میشه، فاسد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.45,
   "end": 438.51,
   "text": "عال-عالم عالم کُنو فساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.51,
   "end": 442.17,
   "text": "اینجا چون مرکبات عالم مرکبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.17,
   "end": 447.19,
   "text": "نشئه طبیعت مثل مجردات نیست که یک حقیقت کلی باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.19,
   "end": 451.19,
   "text": "اینجا مرکبن. مزاج دارن از امتزاجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.19,
   "end": 454.39,
   "text": "ازدواج بین عناصر اربع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.39,
   "end": 456.53,
   "text": "بعد اخلاط اربع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.53,
   "end": 458.87,
   "text": "روح بخاری همچنین. دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.87,
   "end": 461.89,
   "text": "نسبت به لطافتش و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.89,
   "end": 465.69,
   "text": "شرافتش روح تعلق میگیره به اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.69,
   "end": 469.55,
   "text": "به اون مزاج. هرچه مزاج معتدل‌تر، روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.55,
   "end": 476.05,
   "text": "لطیف‌تر. برای همون برای همونایی که می‌خوان تلطیف سر کنن اول میرن سراغ مزاجشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.05,
   "end": 478.59,
   "text": "اینا خیلی ته عالم مرکباته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.59,
   "end": 480.41,
   "text": "ترکیبه. هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.41,
   "end": 482.59,
   "text": "هی یک طور به طور دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.59,
   "end": 488.47,
   "text": "تغییر پیدا میکنه که تو یه طور ما اینه، یه طور همینطوری عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.47,
   "end": 493.63,
   "text": "اما اون ور اینطوری نیست. در مرکبات این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.63,
   "end": 498.21,
   "text": "جدا بشی از اصلت و حالا در مادیات وقتی این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.21,
   "end": 502.01,
   "text": "در معنویات هم به طریق اولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.01,
   "end": 505.19,
   "text": "به تبعش اگر انسان جدا بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.19,
   "end": 510.39,
   "text": "دلش فاسد میشه، دلش می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.39,
   "end": 513.73,
   "text": "لذا یکی از بهترین راه‌ها برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.73,
   "end": 517.67,
   "text": "نرمی دل فرمودن صله رحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.67,
   "end": 520.49,
   "text": "از همه اتوارش که الان گفتیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.49,
   "end": 523.23,
   "text": "چه معنوی‌ش، چه مادی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.23,
   "end": 527.35,
   "text": "که حالا جهت بهره بردن از نورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.35,
   "end": 530.01,
   "text": "احادیث و آیات یه چند تا تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.01,
   "end": 533.65,
   "text": "مثلا در کافی جلد دو صفحه سیصد و هفتاد و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.65,
   "end": 536.99,
   "text": "امام سجاد صلوات الله علیه به فرزندش نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.99,
   "end": 540.23,
   "text": "ببین چقدر ترسونده بچه‌ش رو حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.23,
   "end": 544.57,
   "text": "\"یا بني أنذر خمسة فلا تصاحبهم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.57,
   "end": 547.95,
   "text": "با پنج نفر مطلقا نشینی، مصاحبت نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.95,
   "end": 551.51,
   "text": "\"و ایاک\" برحذر باش از کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.51,
   "end": 554.99,
   "text": "\"ومصاحبة القاطع رحمهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 554.99,
   "end": 561.15,
   "text": "فإني وجدته\" میگه از مصاحبت با قاطع رحم کسی که قاطع رحمه بپرهیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.15,
   "end": 565.99,
   "text": "چون من اونو یافتم \"ملعونًا في کتاب الله عز وجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.99,
   "end": 569.27,
   "text": "هرچی اهل بیت میگن از کتاب خدا اقتباس می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.27,
   "end": 571.25,
   "text": "عجب! قاطع رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 571.25,
   "end": 575.63,
   "text": "حضرت سجاد تصریح می‌کنه به فرزندش که تو کتاب خدا ملعونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.63,
   "end": 580.31,
   "text": "طرف آدم ملعون نرو. انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.31,
   "end": 586.53,
   "text": "یا مثلا از پیغمبر عزیز عالم پرسیدن مبغوض‌ترین عمل در درگاه خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.53,
   "end": 589.37,
   "text": "فرمود شرک. سؤال کردن بعد از شرک؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.37,
   "end": 592.73,
   "text": "فرمود قاطع رحم. قطع رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.73,
   "end": 596.95,
   "text": "میگه ما بالاتر از این. که البته این عرض کردم از جهت معنوی دیگه اوجشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.95,
   "end": 599.59,
   "text": "یعنی کسی از امام زمانش ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.59,
   "end": 603.25,
   "text": "از حضرت زهرا که رحم عالم هستیس ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.25,
   "end": 605.11,
   "text": "این دیگه اون آخرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 605.11,
   "end": 608.49,
   "text": "لذا بدترین عذاب‌ها نصیب-- اصلاً اصل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.49,
   "end": 614.29,
   "text": "اصل ترک رحم و قطع رحم برمی‌گرده به اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.29,
   "end": 618.49,
   "text": "یا یه روایتی هم از امام رضا صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.49,
   "end": 622.35,
   "text": "قبل از نماز برای دوستان می‌خوندم جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.35,
   "end": 627.93,
   "text": "حضرت فرموده این سندش هم جلد دو اصول کافی صفحه صد و پنجاه و دو می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 627.93,
   "end": 632.69,
   "text": "فرمود ما برای زیاد شدن عمر وسیله‌ای جز صله رحم نمی‌شناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 632.69,
   "end": 636.45,
   "text": "اگه کسی دوست داره عمرش زیاد شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 636.45,
   "end": 638.45,
   "text": "صله رحم به اندازه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 638.45,
   "end": 641.03,
   "text": "در زیاد شدن عمر موثر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.03,
   "end": 643.17,
   "text": "فرمایش حضرت رضاست صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.17,
   "end": 646.57,
   "text": "شخصی که از عمرش سه سال مانده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.57,
   "end": 650.79,
   "text": "خدا به سبب صله رحم سی سال به عمرش می‌افزاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.79,
   "end": 652.85,
   "text": "که مجموعا سی و سه سال می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.85,
   "end": 655.99,
   "text": "سی سال به خاطر صله رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.99,
   "end": 659.29,
   "text": "و کسی که از عمرش سی و سه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 659.29,
   "end": 666.07,
   "text": "تمام باقی مانده، خداوند به سبب قطع رحم سی سال از عمرش برمی‌دارد و آن را به سه سال کاهش می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 666.07,
   "end": 669.79,
   "text": "حالا سر اینکه چرا سی و سی و سه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.79,
   "end": 672.35,
   "text": "سه سال و اینا رو مثال زده حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.35,
   "end": 676.89,
   "text": "بهمان از خودش نکته‌ای داره. نکته‌ها دارد البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 676.89,
   "end": 680.13,
   "text": "نکته سنج‌ها گفتند و می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 680.13,
   "end": 681.89,
   "text": "این آیه رو هم توجه داشته باشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.89,
   "end": 685.93,
   "text": "آیه یک سوره نساء \"واتقوا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.93,
   "end": 689.69,
   "text": "الذي تساءلون\". از اون خدایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.69,
   "end": 692.87,
   "text": "به نامش از این و اون درخواست می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 692.87,
   "end": 696.55,
   "text": "مثلا به خدا قسم اینو به من بده من به تو برمی‌گردونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 696.55,
   "end": 698.39,
   "text": "به خدا قسم این جنس اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 698.39,
   "end": 703.65,
   "text": "به خدا. دیگه از اون خدا بترسید از اون خ- بپرهیزید از اون خدایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 703.65,
   "end": 706.91,
   "text": "\"الذي تساءلون\". از تساءلون به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 706.91,
   "end": 710.65,
   "text": "به اسمش از همدیگه درخواست می‌کنید \"والأرحام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 710.65,
   "end": 713.75,
   "text": "بلافاصله \"والأرحام\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.75,
   "end": 717.33,
   "text": "انقدر مهمه. \"إن الله كان عليكم رقيبًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 717.33,
   "end": 721.93,
   "text": "حواستون باشه در بحث خودش خدا و ارحام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 721.93,
   "end": 725.07,
   "text": "خدا رقیب شماست. رقیب اتید شنیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 725.07,
   "end": 727.47,
   "text": "دو تا فرشته‌ای که سمت چپ و راست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 727.47,
   "end": 730.47,
   "text": "ما هستن. اینجا خدا هم فرمود \"إن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 730.47,
   "end": 733.73,
   "text": "كان عليكم رقيبًا\". اصلاً اون رقیب خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 733.73,
   "end": 737.59,
   "text": "خدا مراقبه. مراقب اصلی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 737.59,
   "end": 741.99,
   "text": "اینه که بزرگان و اهل معرفت به شدت می‌افتند به مراقبه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 741.99,
   "end": 747.57,
   "text": "نگه داشتن حس حضور خودشون و دائما در حضور حق تعالی ببینن به خاطر اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 747.57,
   "end": 750.63,
   "text": "که خدا خودش می‌فرماید من مراقب شمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 750.63,
   "end": 754.03,
   "text": "مراقب. اونا که امتحان می‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.03,
   "end": 760.09,
   "text": "تا اون مراقب میاد یه ذره نزدیک میشه حواسشون رو جمع می‌کنن، تقلبشون می‌ذارن کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 760.09,
   "end": 763.31,
   "text": "اگه ما بدونیم واقعاً کسی مراقب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 763.31,
   "end": 765.95,
   "text": "مراقبه می‌کنیم. این را یا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 765.95,
   "end": 769.01,
   "text": "بحث ما بحث قلب لئن بود و لئن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 769.01,
   "end": 771.41,
   "text": "از مهم‌ترین چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 771.41,
   "end": 773.69,
   "text": "نرم می‌کنه قلبو چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 773.69,
   "end": 779.01,
   "text": "فرع به اصلش برمی‌گرده مثل برگی که به درخت وصل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 779.01,
   "end": 782.81,
   "text": "میوه‌ای که دوباره به درخت، به درخت متصلش کنن اگه بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 782.81,
   "end": 786.43,
   "text": "نرم میشه. لطافتش رو پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 786.43,
   "end": 788.39,
   "text": "یکی از بهترین کارها برای نرم شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 788.39,
   "end": 793.79,
   "text": "بعد خودتم حس می‌کنی‌ها. خودتو بنداز پای پدر مادر ببین چجوری حس می‌کنی قلبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 793.79,
   "end": 798.25,
   "text": "اگه وقتی دیدی قلبت سخت شده، اشکت کم شده، بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 798.25,
   "end": 800.77,
   "text": "من بارها این رو امتحان کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 800.77,
   "end": 806.19,
   "text": "صورتمو کف پای مادرم خدا بیامرزه می‌گذاشتم چنان قلبم نرم می‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 806.19,
   "end": 808.33,
   "text": "چنان قلبم می‌شکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 808.33,
   "end": 810.75,
   "text": "هنوزم وقتی محضر پدرم میرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 810.75,
   "end": 812.89,
   "text": "جسارت به شما نشم مثل یه سگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 812.89,
   "end": 815.19,
   "text": "چهار دست و پا میرم سمت پدرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 815.19,
   "end": 819.61,
   "text": "میفتم به پاش. هر وقت که مجلس سنگینی دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 819.61,
   "end": 823.65,
   "text": "حرف‌های سنگینی می‌خوام بزنم، شب قدر می‌خوام جای منبر برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 823.65,
   "end": 829.55,
   "text": "سعی می‌کنم حتما برم محضر پدر پیرم بیفتم پاشو ببوسم و می‌بینم تاثیرش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 829.55,
   "end": 836.01,
   "text": "نرمی دل. انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}