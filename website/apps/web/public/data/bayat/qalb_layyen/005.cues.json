 "chapters": [
  {
   "index": 0,
   "title": "## اقتدا نکردن در صف جماعت و حمد آهسته",
   "start": 14.14,
   "end": 82.82
  },
  {
   "index": 1,
   "title": "## قلب لین و قساوت؛ نقطهٔ مقابل",
   "start": 82.82,
   "end": 115.2
  },
  {
   "index": 2,
   "title": "## قرآن شفا و رحمت",
   "start": 115.2,
   "end": 199.88
  },
  {
   "index": 3,
   "title": "و دیگر موعظه است. در آیهٔ پنجاه و هفت سورهٔ یونس می‌فرماید:",
   "start": 199.88,
   "end": 585.86
  },
  {
   "index": 4,
   "title": "## سه نیاز مؤمن از امام جواد",
   "start": 585.86,
   "end": 705.68
  },
  {
   "index": 5,
   "title": "## جمع‌بندی: قرآن و موعظه",
   "start": 705.68,
   "end": 740.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.22,
   "end": 5.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.58,
   "end": 8.88,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.88,
   "end": 11.88,
   "text": "و ربانیة آیه سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.88,
   "end": 14.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.14,
   "end": 18.28,
   "text": "در خصوص احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.28,
   "end": 22.96,
   "text": "نکته‌ای عرض کنیم که از نظر رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.96,
   "end": 29.06,
   "text": "شرکت در نماز جماعت از حیث یک غرض عقلایی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.06,
   "end": 31.64,
   "text": "دوری کردن، دوری جستن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.64,
   "end": 34.58,
   "text": "تهمت، تهمت دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.58,
   "end": 37.54,
   "text": "اشکالی نداره، بی‌اشکاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.54,
   "end": 39.6,
   "text": "و اما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.6,
   "end": 43.28,
   "text": "چنین کسی اومد در صف جماعت ایستاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.28,
   "end": 46.78,
   "text": "لکن اقتدا نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.78,
   "end": 49.98,
   "text": "خب در جماعت ایستاده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.98,
   "end": 53.2,
   "text": "داره نمازشو فرادا می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.2,
   "end": 56.12,
   "text": "ااا اقتدا نکرده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.12,
   "end": 58.64,
   "text": "به جهت اینکه مشخص نشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 58.64,
   "end": 62.92,
   "text": "فرادا، فرادا داره می‌خونه حمد و سوره‌ش رو آهسته می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.92,
   "end": 68.04,
   "text": "خب اگر رهبر عزیزمون می‌فرماید اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.04,
   "end": 72.58,
   "text": "نماز، نمازیه که باید حمد و سوره درش بلند خونده بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.58,
   "end": 75.76,
   "text": "مثل نماز صبح و مغرب و عشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.76,
   "end": 78.24,
   "text": "و این شخص آهسته می‌خونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 78.24,
   "end": 82.2,
   "text": "صحیح نیست، اشکال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.2,
   "end": 87.32,
   "text": "اما بحث قلب لعن یا لين رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.32,
   "end": 89.94,
   "text": "به فضل الهی ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.94,
   "end": 92.68,
   "text": "دوستان توجه داشته باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 92.68,
   "end": 95.22,
   "text": "که خب حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 95.22,
   "end": 100.26,
   "text": "علت اینکه خود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 100.26,
   "end": 104.36,
   "text": "خود اینکه قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 104.36,
   "end": 108.1,
   "text": "دچار سختی و کدورت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 108.1,
   "end": 116.9,
   "text": "این‌ها می‌شه، قلب خشن می‌شه، سخت می‌شه، اصطلاحا قسی می‌شه که قبلا تو قلب قسی کلی صحبت داشتیم در این رابطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.9,
   "end": 121.7,
   "text": "دلایلی داره که حالا قبلا ما مبصول اگه خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.7,
   "end": 125.62,
   "text": "رجوع کنه به اون مباحث قلب قسی گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.62,
   "end": 129.32,
   "text": "نقطه مقابلش هم نرمی دل هم دلایلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.32,
   "end": 132.96,
   "text": "یعنی راه‌هایی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.96,
   "end": 136.82,
   "text": "می‌شه با اون‌ها دل رو نرم کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.82,
   "end": 142.1,
   "text": "که اگر کسی دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.1,
   "end": 144.7,
   "text": "نرم بود هم قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.7,
   "end": 148.42,
   "text": "خود نرمش دل هم دلایلی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.42,
   "end": 150.6,
   "text": "حالا کسی دلش سنگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.6,
   "end": 154.8,
   "text": "سخته خدایی نکرده که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.8,
   "end": 158.18,
   "text": "هستند بعضیا به سختی می‌تونند گریه کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.18,
   "end": 160.72,
   "text": "حتی بعضی از پدرها میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.72,
   "end": 163.84,
   "text": "سن و سال بالا دارند میان بعضی موقع‌ها درد و دل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.84,
   "end": 167.06,
   "text": "می‌گن ما جوون که بودیم خوب اشکی داشتیم، خوش اشک بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.06,
   "end": 169.82,
   "text": "الان سخت می‌شه گریه کرد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.82,
   "end": 172.12,
   "text": "خب دلایلی داره در روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 172.12,
   "end": 178.08,
   "text": "که حالا بعداً شاید عرض کردیم و قبلاً هم البته تو قلب قسی عرض کردم، اونجا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.08,
   "end": 181.7,
   "text": "همچنین حالا کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.7,
   "end": 186.0,
   "text": "کسی که قلبش سخت شده می‌خواد قلبش رو نرم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.0,
   "end": 190.8,
   "text": "در آیینه آیات روایت اگر دقت کنیم راه‌هایی بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.8,
   "end": 195.66,
   "text": "یکی از راه‌هایی که قلب رو نرم می‌کنه اصطلاحا قلب لعن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.66,
   "end": 199.36,
   "text": "یا لين میاره خود قرآنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.36,
   "end": 204.66,
   "text": "خود قرآن. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.66,
   "end": 207.96,
   "text": "دیگری هم موعظه است. حالا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.96,
   "end": 210.78,
   "text": "در آیه‌ی هشتاد و دو سوره اسرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.78,
   "end": 214.16,
   "text": "می‌فرماید \"و ننزّل من القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.16,
   "end": 220.38,
   "text": "ما هو شفاء\" آنچه که ما نازل کردیم از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.38,
   "end": 224.44,
   "text": "چیه؟ شفاست. \"ورحمة للمؤمنین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.44,
   "end": 228.46,
   "text": "شفای یعنی درمان دردهاست، شفای دل‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.46,
   "end": 230.68,
   "text": "کسی که دلش سنگ شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.68,
   "end": 233.02,
   "text": "می‌تونه با قرآن دلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 233.02,
   "end": 239.64,
   "text": "نرم کنه. البته \"ولا يزيد الظالمین إلا خسارا\" بقیه آیه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.64,
   "end": 243.1,
   "text": "جالبه که چگونه است که قرآن یک وجود واحد است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.1,
   "end": 246.38,
   "text": "یک حقیقت اما برای اهل ایمان رحمت و شفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.38,
   "end": 249.08,
   "text": "برای اهل ظالم و ظالمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.08,
   "end": 251.66,
   "text": "اهل ظلم خسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.66,
   "end": 253.84,
   "text": "مثل اون کسی که از دنیا رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.84,
   "end": 257.18,
   "text": "حالا قدیما مرسوم بود پول می‌دادند یکی رو اجیر می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.18,
   "end": 262.66,
   "text": "الان خیلی نیست. اجیر می‌کردند می‌گفتند مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.66,
   "end": 265.48,
   "text": "بمون کنار قبر ایشون تا ختم قرآن کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 265.48,
   "end": 269.44,
   "text": "یه پولی کلانی بهش می‌دادند. بود اینا قدیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 269.44,
   "end": 273.36,
   "text": "طرف نشسته بود برای رفیقش حالا این کارو کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 273.36,
   "end": 277.26,
   "text": "کسی رو اجیر کرده بود ختم قرآن بالا سر قبر رفیقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 277.26,
   "end": 281.86,
   "text": "شب اومده بود به خوابش که آقا تو رو خدا بیا به این بگو دیگه قرآن بالا سر من نخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.86,
   "end": 286.6,
   "text": "با هر آیه‌ای که عمل نکردم گرز آتشینه که به سرم می‌کوبند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.6,
   "end": 289.4,
   "text": "این یعنی \"ولا يزيد الظالمین إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.4,
   "end": 292.1,
   "text": "خسارا\" خسارت میاره برای اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.1,
   "end": 297.42,
   "text": "ظلم. همین قرآنی که شفا و رحمته برای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 297.42,
   "end": 299.9,
   "text": "خب پس یکی از راه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.9,
   "end": 303.6,
   "text": "همین قرآنه، استماع قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.6,
   "end": 308.14,
   "text": "توجه به قرآن، قرائت و ترتیل قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.14,
   "end": 311.14,
   "text": "عرض شود، مطالعه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.14,
   "end": 314.6,
   "text": "دقت نظر در قرآن، شخ زدن قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 314.6,
   "end": 317.94,
   "text": "به قول عبدالله بن مسعود این راوی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 317.94,
   "end": 325.7,
   "text": "صحابی پیغمبر که فرمود \"من اراد علم الاولین والاخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.7,
   "end": 332.2,
   "text": "فليصور القرآن\" شخ بزنه قرآنو هرکی اراده اول و آخر علم عالم رو کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.2,
   "end": 334.44,
   "text": "علامه در سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.44,
   "end": 339.42,
   "text": "مصباح العنس، شرح مصباح العنس مرحوم ابن فناری چندین بار اشاره به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.42,
   "end": 342.58,
   "text": "فرمایش این صحابی پیغمبر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.58,
   "end": 347.82,
   "text": "به هر حال همه این‌ها از اون ظاهر قرآن که به قول ملا صدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.82,
   "end": 351.26,
   "text": "همون خط ظاهری جوهرش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.26,
   "end": 355.9,
   "text": "در همین کتب شده، قرآن کتب شده هست و می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.9,
   "end": 358.92,
   "text": "همون لمعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.92,
   "end": 363.06,
   "text": "جمال الهی رو به همراه خودش داره بگیر تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.06,
   "end": 370.34,
   "text": "مراتب قرآن همونطور که همه‌ی عالم مراتب داره، وجود من و شما هم مراتب داره، قرآن هم مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.34,
   "end": 374.24,
   "text": "از همین مرتبه دانی بگیر تا عالی و اعلی‌اش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.24,
   "end": 377.62,
   "text": "همه این‌ها موجب نرمی دل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.62,
   "end": 381.2,
   "text": "هرچه انسان با قرآن عجین بیشتر عجین باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.2,
   "end": 389.98,
   "text": "نرمش دلش بیشتره. و واقعاً اگر تعارف رو بگذاریم کنار و وجدان خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.98,
   "end": 395.66,
   "text": "دقت کنیم، وجدان ما اینو به ما میگه که علت اصلی اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.66,
   "end": 398.14,
   "text": "نداشتن دل نرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.14,
   "end": 402.32,
   "text": "دوری از قرآنه و کسایی هم که دلشون نرمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.32,
   "end": 404.06,
   "text": "قطعاً با قرآن عجین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.06,
   "end": 407.1,
   "text": "که هرچه از قرآن دورتر بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.1,
   "end": 413.4,
   "text": "قلبمون فاسدتر می‌شه و سخت‌تر و خشن‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.4,
   "end": 420.08,
   "text": "و دیگه موعظه است که باز خیلی جالبه که در آیه پنجاه و هفت سوره یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.08,
   "end": 424.76,
   "text": "می‌فرماید \"قد جاءكم موعظة من ربكم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.76,
   "end": 428.94,
   "text": "قرآن اینجا خودش رو موعظه معرفی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.94,
   "end": 432.96,
   "text": "که همین قرآنی که الان بحثشه خودش موعظه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.96,
   "end": 436.88,
   "text": "حتی خود قرآن رو شما جای جای قرآن رو مطالعه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 436.88,
   "end": 441.38,
   "text": "می‌بینی واقعاً یک موعظه است بلکه بهترین موعظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.38,
   "end": 444.46,
   "text": "و البته \"والشفاء لما في الصدور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.46,
   "end": 448.74,
   "text": "وهدى ورحمة للمؤمنين.\" می‌دونید چقدر آثار داره قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.74,
   "end": 451.08,
   "text": "موعظه است، شفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.08,
   "end": 454.7,
   "text": "اونم از اون چیزهایی که در سینه جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.7,
   "end": 457.5,
   "text": "از شود هدی، هدایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.5,
   "end": 461.22,
   "text": "رحمة، رحمة للمؤمنين البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.22,
   "end": 466.24,
   "text": "رحمت الهیه. اونایی که هدایت می‌خوان، اونایی که رحمت الهی رو می‌خوان با خودشون جلب کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.24,
   "end": 470.98,
   "text": "اونایی که درمان درد دل‌ها رو می‌خوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.98,
   "end": 476.68,
   "text": "آلدگی‌های سینه رو می‌خوان، آلدگی‌ها و قذارات قلبی رو می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.68,
   "end": 480.12,
   "text": "و هر که دنبال موعظه است که موعظه دل رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.12,
   "end": 486.3,
   "text": "بسم الله قرآن. که ما متأسفانه از مو-موعظه غافلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.3,
   "end": 491.04,
   "text": "و گوش شنوا نداریم و \"في آذانهم وقرا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.04,
   "end": 494.48,
   "text": "تو گوشمون. اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.48,
   "end": 498.58,
   "text": "چنان سنگین شده که حرف حق نمیره، فرار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.58,
   "end": 500.8,
   "text": "حوصله نداریم اصلاً بشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.8,
   "end": 505.6,
   "text": "علت اصلی اینکه حوصله نداریم حرف بشنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.6,
   "end": 509.44,
   "text": "اینه که دل از نرمش فاصله گرفته و خشن شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.44,
   "end": 515.08,
   "text": "که بارها و بارها حضرت استاد فرمودن همونطور که حیوان با شلاق تأدیب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.08,
   "end": 519.7,
   "text": "و نبات، گیاهان، درختان این‌ها با هرس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.7,
   "end": 522.48,
   "text": "انسان با شنیدن حرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.48,
   "end": 525.28,
   "text": "با حرف شنیدن مؤدب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.28,
   "end": 530.92,
   "text": "ادب انسان به این شکله. که القرآن معدبت الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.92,
   "end": 534.38,
   "text": "یا معدبه یا معدبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.38,
   "end": 538.16,
   "text": "این معدبه یا معدبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.16,
   "end": 543.5,
   "text": "هر دو تاش اومده. حالا یا از شود سفره‌ی آسمانی بگیر- سلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.5,
   "end": 546.18,
   "text": "یا سفره آسمانی بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.18,
   "end": 549.22,
   "text": "یا از شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.22,
   "end": 551.48,
   "text": "اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.48,
   "end": 555.24,
   "text": "فرض کن مائده آسمانی بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.24,
   "end": 559.0,
   "text": "یا محل اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.0,
   "end": 561.36,
   "text": "ادب آموزی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.36,
   "end": 566.58,
   "text": "ادبستان الهی. در هر حال در سر سفره قرآن انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.58,
   "end": 568.94,
   "text": "بهترین موعظه‌ها رو می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.94,
   "end": 572.12,
   "text": "و علت اصلی دوری ما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.12,
   "end": 575.86,
   "text": "دل نرم نشنیدن موعظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.86,
   "end": 579.46,
   "text": "حالا در خصوص موعظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.46,
   "end": 585.86,
   "text": "خیلی حرف‌ها هست. بهتره که رجوع کنیم به کتاب‌هایی که پیرامون موعظه نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.86,
   "end": 590.28,
   "text": "یکی از فرمایشات عرشی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.28,
   "end": 593.22,
   "text": "امام جواد سلام الله علیه هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.22,
   "end": 597.08,
   "text": "می‌فرمود \"المؤمن يحتاج إلى ثلاث.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.08,
   "end": 601.22,
   "text": "از ضروریات و احتیاجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.22,
   "end": 607.76,
   "text": "مهم هر مؤمنی سه چیزه که حالا الان از من بپرسن که آقا احتیاجات مهم هر کسی الان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.76,
   "end": 610.42,
   "text": "سریع میگیم خونه و کار و ماشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.42,
   "end": 616.7,
   "text": "خب اون بحث دنیاشه. بله انسان یه سرپناهی می‌خواد، یه وسیله‌ای مرکبی می‌خواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.7,
   "end": 619.86,
   "text": "یه کاری می‌خواد که تحصیل معاش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.86,
   "end": 625.34,
   "text": "اما اون ضروریات اصلی که تا ابد با خودت می‌بری رو هم در نظر بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 625.34,
   "end": 627.02,
   "text": "بلکه اون رو اولویت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.02,
   "end": 629.7,
   "text": "امام جواد سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.7,
   "end": 635.52,
   "text": "فرمودن که اولیش فرمودن \"التوفيق من الله.\" توفیقی که از سمت و ناحیه حضرت حق نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.52,
   "end": 638.4,
   "text": "نه برا خودمون توفیق بافی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.4,
   "end": 642.94,
   "text": "که هندسه‌ش بالا به پایینه. در پس اخلاص که از پایین به بالا میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 642.94,
   "end": 645.36,
   "text": "نازل می‌شه. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 645.36,
   "end": 648.12,
   "text": "فرمودن که دومیش همین مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 648.12,
   "end": 651.0,
   "text": "فرمودن \"و واعظ من نفسه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 651.0,
   "end": 654.28,
   "text": "تو وجود خودش. خودش اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 654.28,
   "end": 660.8,
   "text": "کسی رو هم پیدا نمی‌کنه او رو موعظه کنه، به قدری موعظه مورد احتیاج و نیاز روحی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 660.8,
   "end": 666.32,
   "text": "که میگه خودش تو نفس خودش، تو وجدان و وجود خودش، خودش رو موعظه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.32,
   "end": 671.56,
   "text": "خدا رحمت کنه قدیمی‌ها، پیرزن، پیرمردها دیده می‌شد بعضی موقع‌ها با خودشون حرف می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 671.56,
   "end": 674.32,
   "text": "یه وقت می‌بینی این‌ها داشتن خودشونو موعظه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 674.32,
   "end": 678.34,
   "text": "چه می‌دونی؟ که ما کمتر با خودمون حرف می‌زنیم، خلوت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 678.34,
   "end": 681.92,
   "text": "و سومیش هم البته فرمود \"وقبول من من ينصح.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.92,
   "end": 683.98,
   "text": "قبول کنه از کسی که نصیحتش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 683.98,
   "end": 685.72,
   "text": "ولو یه بچه نصیحتش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 685.72,
   "end": 688.34,
   "text": "ولو مدیرکل زیردستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 688.34,
   "end": 690.78,
   "text": "میاد یه آبدارچیه داره میاد نصیحتش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.78,
   "end": 695.14,
   "text": "نباید تبت-- تبتخر داشته باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 695.14,
   "end": 698.0,
   "text": "چرا حالا شما آبدارچی، من مدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.0,
   "end": 699.56,
   "text": "چرا شما منو نصیحت کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.56,
   "end": 705.68,
   "text": "نه. \"وقبول من من ينصح.\" هرکی نص-- خیرخواهش بود نصیحتش کرد این بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.68,
   "end": 708.48,
   "text": "در مجموع پس اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 708.48,
   "end": 711.28,
   "text": "باعث نرمی قلب می‌شه عزیزانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 711.28,
   "end": 716.16,
   "text": "در دستوراتی که از ناحیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 716.16,
   "end": 718.24,
   "text": "آل الله وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 718.24,
   "end": 720.88,
   "text": "و بر اساس آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 720.88,
   "end": 726.62,
   "text": "که جزو ضرور-ضروری‌ترین نیازهای اصلی بشر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 726.62,
   "end": 728.26,
   "text": "قرآن هست و موعظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.26,
   "end": 731.72,
   "text": "حالا هست چیزای دیگه‌ای هم هست انشاالله به مرور عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 731.72,
   "end": 736.32,
   "text": "خدای منان همه ما رو عجین کنه با قرآن و موعظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 736.32,
   "end": 738.32,
   "text": "عاقبتمون ختم به خیر بشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 738.32,
   "end": 740.66,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}