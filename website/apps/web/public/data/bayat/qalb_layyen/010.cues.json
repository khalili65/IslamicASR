 "chapters": [
  {
   "index": 0,
   "title": "## یوم‌الشک و نیت روزه",
   "start": 13.08,
   "end": 95.4
  },
  {
   "index": 1,
   "title": "## یاد مرگ نرم‌کنندهٔ دل",
   "start": 95.4,
   "end": 173.28
  },
  {
   "index": 2,
   "title": "## مصباح الشریعه؛ آثار ذکر موت",
   "start": 173.28,
   "end": 395.42
  },
  {
   "index": 3,
   "title": "## نامهٔ سی‌ویک؛ احیای قلب",
   "start": 395.42,
   "end": 526.76
  },
  {
   "index": 4,
   "title": "## شعر طول الأمل و قبر صندوق عمل",
   "start": 526.76,
   "end": 608.06
  },
  {
   "index": 5,
   "title": "## مثال اسب؛ زنگار دل",
   "start": 608.06,
   "end": 692.86
  },
  {
   "index": 6,
   "title": "## اسب بی‌لگام و زنگار آهن",
   "start": 692.86,
   "end": 759.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 4.12,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.12,
   "end": 8.16,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.16,
   "end": 13.08,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.08,
   "end": 18.88,
   "text": "فردا یا روز اول ماه مبارک رمضان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.88,
   "end": 21.3,
   "text": "یا روز آخر شعبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.3,
   "end": 24.06,
   "text": "اصطلاحا بهش میگن يوم الشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.06,
   "end": 28.78,
   "text": "منتها تا یقین حاصل نشده بر ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.78,
   "end": 37.12,
   "text": "ماه مبارک رمضان هست حق نداریم نیت روزه ماه رمضان و واجب بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.12,
   "end": 41.3,
   "text": "واجب هم نیست که فردا رو روزه بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.3,
   "end": 47.28,
   "text": "اما احتیاطا بهتره که انسان روزه بگیره به نیت آخر شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.28,
   "end": 50.8,
   "text": "تا امم محقق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.8,
   "end": 57.3,
   "text": "اگر چنانچه در اثنای روز متوجه شد که اعلام شده روز اول ماهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.3,
   "end": 59.98,
   "text": "باید نیتشو برگردونه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.98,
   "end": 61.92,
   "text": "روزه ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.92,
   "end": 65.0,
   "text": "اما اگر اعلام نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.0,
   "end": 67.42,
   "text": "مثلا بعد از افطار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.42,
   "end": 70.74,
   "text": "مشخص شد که روز اول بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.74,
   "end": 74.3,
   "text": "و ایشون به نیت آخر شعبان گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.3,
   "end": 77.08,
   "text": "مشکلی نداره و روزه‌ش درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.08,
   "end": 82.06,
   "text": "جزو ماه مبارک رمضان هم حساب میشه به لطف خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.06,
   "end": 89.08,
   "text": "و اگر هم که نه، معلوم شد که آخر شعبان بوده خب به پیشواز رفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.08,
   "end": 93.74,
   "text": "بالاخره ثواب زیادی عایدش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.74,
   "end": 97.6,
   "text": "امروز به فضل الهی ادامه بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.6,
   "end": 99.68,
   "text": "لن یا لين رو عرض میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.68,
   "end": 102.7,
   "text": "یکی دیگه از چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.7,
   "end": 108.96,
   "text": "قلب رو نرم میکنه به صریح روایات یاد مرگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.96,
   "end": 113.38,
   "text": "که امروز ما ازش فرار میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.38,
   "end": 116.08,
   "text": "تو همین مرکز چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.08,
   "end": 123.76,
   "text": "به ما تذکر داده شد که آقا نگید، نگید یاد مرگ خوب نیست، چیز خوبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.76,
   "end": 126.72,
   "text": "ما جوونیم، آرزو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.72,
   "end": 133.48,
   "text": "و امثالهم. مشکلات کمرمونو خم کرده شما دیگه با حرف‌های این چنینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.48,
   "end": 136.6,
   "text": "خم‌ترش نکن. در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.6,
   "end": 139.96,
   "text": "توصیه اکید اولیاء الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.96,
   "end": 145.84,
   "text": "که یعنی شما اصلا نهج البلاغه رو وقتی بررسی کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.84,
   "end": 149.76,
   "text": "هندسه کلام امیرالمؤمنین در نهج البلاغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.76,
   "end": 153.02,
   "text": "فراوانی‌ش اگه گفتید پیرامون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.02,
   "end": 158.26,
   "text": "فراوانی‌ش. بیشترین صحبت حضرت یکی پیرامون توحیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.26,
   "end": 162.34,
   "text": "یکی تقواست، یکی هم مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.34,
   "end": 170.58,
   "text": "که ما ازش فرار می‌کنیم. یکی از چیزهایی که دل رو نرم می‌کنه، علت اینکه ما دلمون سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.58,
   "end": 173.28,
   "text": "اینه که خیلی توجه به موت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.28,
   "end": 176.2,
   "text": "در مصباح الشریعه یادش بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.2,
   "end": 181.28,
   "text": "من خیلی بچه‌تر بودم و شاید زیر سن بیست سال بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.28,
   "end": 183.18,
   "text": "این کتاب رو باهاش محشور بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.18,
   "end": 186.76,
   "text": "خیلی کتاب شیرینیه. فرمایشات امام صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.76,
   "end": 189.14,
   "text": "یعنی اصلا کتاب، کتاب امام صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.14,
   "end": 192.52,
   "text": "خیلی شیرینه در موضوعات مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.52,
   "end": 199.74,
   "text": "اونجا صفحه ششصد و هفتاد و یک می‌تونید ببینید که حضرت می‌فرماید ذکر الموته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.74,
   "end": 204.34,
   "text": "حالا آثار یاد موت رو داره میگه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.34,
   "end": 208.86,
   "text": "چیاست؟ یکیش میفرماید یمیت الشهوات في النفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.86,
   "end": 211.24,
   "text": "اون رویشگاه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.24,
   "end": 216.8,
   "text": "اون میشه گفت الشهوات في النفس تو نفس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.8,
   "end": 218.36,
   "text": "شهوات تو نفسن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.36,
   "end": 221.72,
   "text": "نفس اماره. اینا رو می‌میراند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.72,
   "end": 225.98,
   "text": "و یقلع منابت الغفله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.98,
   "end": 230.2,
   "text": "هر چیزی که اون ریشه غفلت رو خشک میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.2,
   "end": 234.42,
   "text": "رویشگاه‌های غفلت رو خشک میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.42,
   "end": 236.1,
   "text": "خیلی این نکته مهم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.1,
   "end": 244.42,
   "text": "وقتی شما یه مثلا نهالی رو، درختی و یه بوته ای رو هی شاخ و برگشو میزنی دوباره میاد چون ریشه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.42,
   "end": 249.56,
   "text": "حضرت می‌فرماید یاد موت اون رویشگاه‌ها و ریشه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.56,
   "end": 251.74,
   "text": "خشک میکنه، ریشه غفلت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.74,
   "end": 255.48,
   "text": "که هرچی ما می‌کشیم از دست این غفلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.48,
   "end": 261.02,
   "text": "و یقوی القلب بمواعید الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.02,
   "end": 266.8,
   "text": "دل رو با اون وعده‌های خدا يقوی قوی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.8,
   "end": 270.06,
   "text": "دل رو مقاوم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.06,
   "end": 273.04,
   "text": "یعنی کسی که الان یکی از علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.04,
   "end": 276.38,
   "text": "مقاومت مردم غزه و فلسطین فکر میکنید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.38,
   "end": 279.0,
   "text": "مرگ رو جلو چشمشون دارن میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.0,
   "end": 282.98,
   "text": "یعنی براشون مسجل شده یا امشب یا فردا بالاخره رفتنی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.98,
   "end": 286.16,
   "text": "لذا مقاوم شدن. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.16,
   "end": 288.4,
   "text": "دائما متأثر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.4,
   "end": 290.44,
   "text": "مرگ و موتند لذا مقاوم شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.44,
   "end": 294.64,
   "text": "ما چون فرار می‌کنیم از موت نمیخوایم باور کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.64,
   "end": 298.48,
   "text": "برای همین مقاوم هم معمولا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.48,
   "end": 300.96,
   "text": "و یرق تبع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.96,
   "end": 304.92,
   "text": "به به! فرمود تبعو نازک میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.92,
   "end": 307.54,
   "text": "آدم نازک میشه طبیعتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.54,
   "end": 312.18,
   "text": "این خیلی، خیلی با لطافت حضرت اینجا و با ظرافت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.18,
   "end": 314.48,
   "text": "با کیاست حرف زده حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.48,
   "end": 317.9,
   "text": "یعنی چی تبعو نازک میکنه طبیعت رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.9,
   "end": 321.64,
   "text": "یعنی اینکه آدم طبیعتش زودی با دو لقمه سیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.64,
   "end": 323.48,
   "text": "یه لباس ساده بسشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.48,
   "end": 326.7,
   "text": "یعنی قناعت میکنه. تبعش نازک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.7,
   "end": 332.48,
   "text": "خیلی دنبال اون تبع و طبیعتش نمیره که به اون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.48,
   "end": 337.7,
   "text": "دیگه چی؟ و یكسر أعلام الهوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.7,
   "end": 340.56,
   "text": "پرچم یعنی أعلام جمع علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.56,
   "end": 344.98,
   "text": "پرچم‌های هوس رو یكسرو میشکونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.98,
   "end": 348.12,
   "text": "هوس، هوی، دل خواهش میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.12,
   "end": 350.7,
   "text": "دیگه این پرچمشو میزنه میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.7,
   "end": 353.56,
   "text": "خیلی جالبه. عجب آثاری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.56,
   "end": 357.22,
   "text": "و یدفع نار الحرس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.22,
   "end": 360.74,
   "text": "آتش حرص رو که از بزرگترین مشکلات ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.74,
   "end": 366.76,
   "text": "امام علیه السلام گفت آقا چی شد که کسانی مثل طلحه، زبیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.76,
   "end": 369.7,
   "text": "از زبیرو من أهل اینا جلوی شما علم شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.7,
   "end": 374.7,
   "text": "فرمود به خاطر سه چیز: تکبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.7,
   "end": 379.16,
   "text": "تکبر و حسد و حرص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.16,
   "end": 383.68,
   "text": "هرکسی این سه تا رو داشته باشه جلوی امام زمانش وایمیسته حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.68,
   "end": 391.7,
   "text": "انقدر خطرناکه. و یا حق رد دنیا، دنیا رو تو چشم آدم کوچیک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.7,
   "end": 395.42,
   "text": "توجه به مرگ، ذکر موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.42,
   "end": 399.42,
   "text": "در نامه سی و یک نهج‌البلاغه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.42,
   "end": 406.5,
   "text": "می‌دونید این نامه فرمایشات امیرالمؤمنین، نصیحت مولا به فرزند عزیزشه، امام حسن مجتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.5,
   "end": 409.4,
   "text": "صلی الله علیه. خیلی نامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.4,
   "end": 412.62,
   "text": "کثیر الفروع و پر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.62,
   "end": 416.42,
   "text": "حرفیه این نامه. یه بخشیش می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.42,
   "end": 419.22,
   "text": "\"أَحْیِ قَلْبَكَ بِالْمَوَاعِظِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.22,
   "end": 422.52,
   "text": "با موعظه قلبت رو زنده نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.52,
   "end": 425.62,
   "text": "الان من و شما پای موعظه نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.62,
   "end": 429.02,
   "text": "واعظ کیه؟ امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.02,
   "end": 433.5,
   "text": "صادق، امام آقامون امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.5,
   "end": 435.4,
   "text": "اینا الان دارن وعظ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.4,
   "end": 436.94,
   "text": "حدیث ایشون رو داریم می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.94,
   "end": 441.36,
   "text": "\"وَ أمِتْهُ بِالزَّهَادَةِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.36,
   "end": 445.26,
   "text": "می‌فرماید که بکش اون نفست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.26,
   "end": 449.28,
   "text": "با زهد، با بی‌رقبتی به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.28,
   "end": 455.34,
   "text": "\"وَ قُوَهْ وَ قَوِّهِ بِالْیَقِینِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.34,
   "end": 458.96,
   "text": "هر کدوم اینا یه منبر استخوندار می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.96,
   "end": 462.92,
   "text": "با یقین قلبت رو قوت ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.92,
   "end": 467.22,
   "text": "کسی که دلش ضعیفه، قلب، قلبش ضعیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.22,
   "end": 469.8,
   "text": "نفس قوی‌ای نداره چون یقینش کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.8,
   "end": 471.52,
   "text": "\"و نَوِّرْهُ بِالْحِكْمَةِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.52,
   "end": 475.62,
   "text": "به به. کیا می‌خوان دلشون نورانی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.62,
   "end": 479.64,
   "text": "آقا داره به فرزندش می‌فرماید که با حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.64,
   "end": 482.56,
   "text": "دلت رو نورانی کن و اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.56,
   "end": 485.64,
   "text": "\"وَ ذَلِّلْهُ بِذِكْرِ الْمَوْتِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.64,
   "end": 488.98,
   "text": "خارش کن، نرمش کن به اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.98,
   "end": 490.84,
   "text": "نرمش کن قلبت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.84,
   "end": 496.38,
   "text": "به چی؟ به ذکر الموت. دل رو نرم کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.38,
   "end": 501.8,
   "text": "با یاد موت. \"وَ قَرِّرْهُ بِالْفَنَاءِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.8,
   "end": 505.04,
   "text": "خیلی زیباست. اقرارش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.04,
   "end": 510.72,
   "text": "مثل این که به یه کسی می‌خوای شهادتین رو تلقین کنی، اون اقرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.72,
   "end": 516.06,
   "text": "میگه قرر هو اقرار بهش بده بالفنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.06,
   "end": 521.5,
   "text": "بهش قلبت این اقرار رو بکنه که \"كُلُّ مَنْ عَلَيْهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.5,
   "end": 524.84,
   "text": "فَانٍ وَيَبْقَى وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْإِكْرَامِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.84,
   "end": 529.38,
   "text": "به به به. خدا رحمت کنه مرحوم آقای عراقی رو بهشون می‌گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.38,
   "end": 533.54,
   "text": "سلمان معاصر. حضرت آقای عراقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.54,
   "end": 536.4,
   "text": "لقب سلمان زمان رو داده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.4,
   "end": 542.48,
   "text": "ایشون اون اشعار منتسب به امیرالمؤمنین رو زیاد می‌خوندن، گریه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.48,
   "end": 545.68,
   "text": "نزدیکاشون می‌گفتن که گریه می‌کردن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.68,
   "end": 547.72,
   "text": "شعر رو می‌خوندن که منسوب مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.72,
   "end": 550.92,
   "text": "\"یا من بدنیا هشت بل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.92,
   "end": 552.96,
   "text": "به به. عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.96,
   "end": 555.88,
   "text": "فرمایشی، عجب شعری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.88,
   "end": 561.16,
   "text": "ای کسی که مشغول دنیایی \"بَدْغَرَّهُ طُولُ الْأَمَلِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.16,
   "end": 565.2,
   "text": "پر روت کرده، مغترت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.2,
   "end": 567.82,
   "text": "چی؟ طول الأمل. طولانی آرزوها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.82,
   "end": 571.84,
   "text": "\"الْمَوْتُ يَأْتِي بَغْتَةً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.84,
   "end": 574.66,
   "text": "موت به یکباره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.66,
   "end": 576.8,
   "text": "الموت یأتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.8,
   "end": 580.46,
   "text": "بغتة. به ناگهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.46,
   "end": 585.3,
   "text": "که اصلا باورت نمی‌شه. حتی ریشتم سفید باشه باز باورت نمیشه که عه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.3,
   "end": 588.26,
   "text": "اونقدر جدی واقعا من باید برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.26,
   "end": 591.0,
   "text": "اینطوریه. کمتر کسی پیش میاد که آماده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.0,
   "end": 593.16,
   "text": "\"وَ الْقَبْرُ\" به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.16,
   "end": 597.48,
   "text": "\"وَ الْقَبْرُ صُنْدُوقُ الْعَمَلِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 597.48,
   "end": 601.22,
   "text": "عجب. قبر صندوق اعمال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.22,
   "end": 604.24,
   "text": "بعد این صندوق باز میشه، صندوقچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 604.24,
   "end": 607.16,
   "text": "و همه اعمال خودشو نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.16,
   "end": 611.44,
   "text": "خیلی جالبه در میزان حکمت مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.44,
   "end": 615.26,
   "text": "خدا رحمت کنه مرحوم آقای ریشهری خیلی خدمت علمی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 615.26,
   "end": 619.3,
   "text": "خیلی کتاب زیاد تألیف کثیر التألیف‌اند ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.3,
   "end": 623.48,
   "text": "بالاخره حرم سیدالکریم میریم ایشون متولی بودن چندین سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 623.48,
   "end": 630.34,
   "text": "حرمت بگذاریم و حتی سر قبر استاد عزیزمون حضرت آقای حق شناس هم که میان می‌خوان، برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 630.34,
   "end": 634.16,
   "text": "مقارن قبر ایشونه اول یه تعظیمی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.16,
   "end": 638.22,
   "text": "ایشون می‌کنن آقای ریشهری متولی سیدالکریم بودن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.22,
   "end": 641.02,
   "text": "گردن ما تهرانی‌ها مخصوصا حق دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.02,
   "end": 644.24,
   "text": "اون بنای اونجا رو رسیدگی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 644.24,
   "end": 649.08,
   "text": "در میزان حکمتش جلد سیزده صفحه بیست، دویست و هفتاد و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.08,
   "end": 652.66,
   "text": "روایتی میاره که مضمونش اینه که حضرت عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.66,
   "end": 656.38,
   "text": "علی‌نبی‌اناواعلیه صلوة السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.38,
   "end": 657.94,
   "text": "مثال اسب رو می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.94,
   "end": 662.42,
   "text": "میگن اگه اسب رو لجام نزنی ازش بار نکشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 662.42,
   "end": 666.88,
   "text": "سرکشی می‌کنه و خلاصه کج خلقی می‌کنه اسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.88,
   "end": 670.24,
   "text": "همین رو میاره رو دل پیاده می‌کنه حضرت عیسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.24,
   "end": 672.76,
   "text": "می‌فرماید حضرت روح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.76,
   "end": 675.32,
   "text": "می‌فرماید دل هم همچنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.32,
   "end": 678.06,
   "text": "اگر با یاد مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.06,
   "end": 683.2,
   "text": "نرم نشه، ایشون داره تصریح می‌کنه که دل با یاد نه، مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 683.2,
   "end": 687.98,
   "text": "نرم میشه و عبادت مدام اون رو به رنج نندازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.98,
   "end": 691.12,
   "text": "سخت و سنگ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 691.12,
   "end": 694.98,
   "text": "پس اینجا داره حضرت عیسی تص، تصریح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 694.98,
   "end": 698.56,
   "text": "که اون چیزی که دل رو نرم می‌کنه یاد مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 698.56,
   "end": 701.1,
   "text": "یه روایت قشنگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 701.1,
   "end": 706.18,
   "text": "قطعا این رو دیدید از کنز العمال هست، از پیغمبر از روایت نبویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 706.18,
   "end": 708.3,
   "text": "عزیز عالم فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 708.3,
   "end": 711.74,
   "text": "همونطور که آهن زنگ می‌خوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 711.74,
   "end": 714.82,
   "text": "زنگار می‌گیره. میگن زنگ زده آهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 714.82,
   "end": 717.0,
   "text": "آب بهش می‌خوره، رطوبت می‌خوره، زنگ می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 717.0,
   "end": 719.42,
   "text": "دل‌ها هم زنگ می‌زنن. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 719.42,
   "end": 723.08,
   "text": "دل هم زنگار می‌گیره. سؤال شده یا رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 723.08,
   "end": 727.54,
   "text": "زنگار دل‌ها، زنگ دل با چی برطرف میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 727.54,
   "end": 729.62,
   "text": "حضرت دو تا دارو معرفی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 729.62,
   "end": 732.5,
   "text": "امروز میگن برو ضد زنگ بزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 732.5,
   "end": 734.76,
   "text": "فلان. حالا حضرت دو تا دارو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 734.76,
   "end": 740.86,
   "text": "فرمودن. کثرت یاد موت و تلاوت قرآن این دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 740.86,
   "end": 745.12,
   "text": "دوتاش هم اکثار داره. زیاد یاد موت کنی، زیاد قرآن بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 745.12,
   "end": 747.46,
   "text": "ماه مبارک رمضان هم که در پیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 747.46,
   "end": 749.76,
   "text": "و بالاخره بهار تلاوت قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 749.76,
   "end": 753.48,
   "text": "انشاالله که عاقبتمون ختم به خیر بشود به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 753.48,
   "end": 759.04,
   "text": "صلوات بر محمد و آل محمد. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}