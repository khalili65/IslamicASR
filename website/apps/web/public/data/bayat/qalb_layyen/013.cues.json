 },
 "chapters": [
  {
   "index": 0,
   "title": "## اطعام مسکین و مسح سر یتیم",
   "start": 10.98,
   "end": 155.18
  },
  {
   "index": 1,
   "title": "## مجالست با علما و صالحان",
   "start": 155.18,
   "end": 226.64
  },
  {
   "index": 2,
   "title": "## باب تقلب احوال القلب؛ شکایت از سستی دل",
   "start": 226.64,
   "end": 528.68
  },
  {
   "index": 3,
   "title": "## سید بن طاووس و راه باز علم و یقین",
   "start": 528.68,
   "end": 652.5
  },
  {
   "index": 4,
   "title": "## امام کاظم؛ از پنج چیز به پنج چیز",
   "start": 652.5,
   "end": 675.48
  },
  {
   "index": 5,
   "title": "## عیسی و معیار مجالست",
   "start": 675.48,
   "end": 981.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 2.74,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.74,
   "end": 6.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.82,
   "end": 10.98,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.98,
   "end": 14.82,
   "text": "در خصوص قلب اللعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 18.54,
   "text": "داشتیم عوامل نرم شدن دل رو می‌گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.54,
   "end": 22.82,
   "text": "و عرض کردیم آخرین جلسه‌ای که داشتیم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.82,
   "end": 26.58,
   "text": "یتیم بود و یتیم نوازی یکی از راه‌های نرم شدن دله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.58,
   "end": 30.22,
   "text": "روایتی رو دیدم خیلی جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.22,
   "end": 37.2,
   "text": "دو تا از عوامل نرم شدن دل رو که ما تو دو تا جلسه گفته بودیمو توی این حدیث جمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.2,
   "end": 43.28,
   "text": "مشکات الانوار شیخ طبرسی صفحه صد و شصت و هفت می‌تونید این روایت رو ببینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.28,
   "end": 46.74,
   "text": "شخصی اومد پیش امام رسول اعظم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.74,
   "end": 51.04,
   "text": "گلایه کرد از سخت شدن دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.04,
   "end": 53.72,
   "text": "گفت دلم سخت شده، سفت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.72,
   "end": 55.94,
   "text": "قسی شده، قساوت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.94,
   "end": 61.36,
   "text": "چه کنم؟ پیغمبر فرمودند اذا اردت ان یلين قلبک هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.36,
   "end": 64.44,
   "text": "وقت اراده کردی که قلبت، دلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.44,
   "end": 68.26,
   "text": "نرم بشه، یلين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.26,
   "end": 72.84,
   "text": "قلب یل– لَین یا لَعِن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.84,
   "end": 78.22,
   "text": "ان یلين قلبک هر وقت خواستی قلبت نرم بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.22,
   "end": 83.92,
   "text": "فَأطعم المسکین این یه دونه دستور که یه جلسه دربارش حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.92,
   "end": 87.92,
   "text": "می‌خوای دلت نرم شه مسکین رو اطعام کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 91.36,
   "text": "وامسح رأس اليتيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.36,
   "end": 95.96,
   "text": "و مسح کن، دست بکش سر یتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.96,
   "end": 98.8,
   "text": "یکی دیگه از چیزایی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.8,
   "end": 102.4,
   "text": "نرم می‌کنه دل رو. یا در کتاب ملا يهزر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.4,
   "end": 106.88,
   "text": "شیخ صدوق جلد یک صفحه صد و هشتاد و هشت هم می‌تونید این روایت رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.88,
   "end": 109.42,
   "text": "روایت نبویه اونجا ببینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.42,
   "end": 115.32,
   "text": "من ان کرمن کن بصه وثقل بهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.32,
   "end": 119.0,
   "text": "فلیتمن– فلیتنوا یتيما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.0,
   "end": 123.14,
   "text": "فیلاطفه. اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.14,
   "end": 127.06,
   "text": "دچار سختی دل و این‌ها شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.06,
   "end": 132.58,
   "text": "راهش چیه؟ یه یتیم رو مورد ملاطفه خودش قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.58,
   "end": 134.8,
   "text": "والیمسح رأسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.8,
   "end": 139.88,
   "text": "حالا چه سری در مسح کردن سر یتیمه که روایت داریم به عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.88,
   "end": 144.9,
   "text": "موهای سر اون یتیم براش حسنه می‌نویسن و گناه ازش پاک می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.9,
   "end": 148.46,
   "text": "یلين قلبه بإذن الله عز وجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.46,
   "end": 150.58,
   "text": "فإن لليتيم حقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.58,
   "end": 154.92,
   "text": "این مثلا از حقوق یتیمه که تو اینطوری باهاش رفتار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.92,
   "end": 160.5,
   "text": "حالا این جلسه تو این فرصت کوتاهی که داریم که این موضوعی که الان می‌خوام عرض کنم خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.5,
   "end": 164.44,
   "text": "بسیار ده‌ها جلسه درباره‌ش باید حرف زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.44,
   "end": 167.82,
   "text": "یکی از مهم‌ترین راه‌های نرم شدن دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.82,
   "end": 172.28,
   "text": "مجالست، مؤانست و مصاحبت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.28,
   "end": 175.08,
   "text": "علما و صالحینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.08,
   "end": 179.16,
   "text": "علما و صلحا، عرفا و حکما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.16,
   "end": 182.24,
   "text": "با این‌ها نشستنه. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.24,
   "end": 185.46,
   "text": "از وجه اتم‌ش می‌شه انسان کامل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.46,
   "end": 189.34,
   "text": "می‌شه رسول اکرم، می‌شه امام عصر ما بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.34,
   "end": 191.68,
   "text": "که داد می‌زنیم تو ندبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.68,
   "end": 196.02,
   "text": "که هل الیک يا ابن أحمد سبيلٌ فتلقى؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.02,
   "end": 201.64,
   "text": "آیا راهی هست پسر پیغمبر که راهی هست که ما شما رو ملاقات کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.64,
   "end": 207.06,
   "text": "دل سخت شده دیگه. عزيزا علي ان ارى الخلق ولا تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.06,
   "end": 210.06,
   "text": "خیلی سخت شده که همه رو ببینم شما رو نبینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.06,
   "end": 212.28,
   "text": "متى ترانا ونراك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.28,
   "end": 214.56,
   "text": "دل می‌خواد نرم شه دیگه راهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.56,
   "end": 217.86,
   "text": "حالا ما که دسترسی به حجت خدا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.86,
   "end": 222.4,
   "text": "اما جانشینان این عزیزان نوابشون علما، عُل–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.4,
   "end": 225.02,
   "text": "عرفا که خودشون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.02,
   "end": 229.42,
   "text": "که این‌ها جانشینان ما در روی زمین هستند و در حوادث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.42,
   "end": 234.56,
   "text": "وقوع وح- حوادث رجوع کنید به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.56,
   "end": 237.86,
   "text": "نشست و برخاست با اون‌هاست که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.86,
   "end": 240.54,
   "text": "در حقیقت دل رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.54,
   "end": 244.94,
   "text": "در کتاب کافی مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.94,
   "end": 249.74,
   "text": "کلینی جلد دو صفحه چهارصد و بیست و سه یه بابی داره به نام باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.74,
   "end": 253.72,
   "text": "فی تنقل احوال القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.72,
   "end": 257.04,
   "text": "در منقلب شدن حال دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.04,
   "end": 260.46,
   "text": "حدیث یکش خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.46,
   "end": 262.3,
   "text": "یکی اومد ببینید از چه چیزهایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.3,
   "end": 266.08,
   "text": "چه چیزهایی شکایت کرد. شکایت‌های ما معمولا از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.08,
   "end": 271.4,
   "text": "آخ گرون شد، آخ دلار رفت بالا، آخ نمی‌دونم نون گرون شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.4,
   "end": 273.46,
   "text": "آب گرون شد، برق گرون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.46,
   "end": 279.48,
   "text": "شکایت‌های این شخص میاد پیش امام زمانش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.48,
   "end": 284.16,
   "text": "اومد گفت آقا من چند تا مشکل پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.16,
   "end": 288.14,
   "text": "یک، دلم نرم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.14,
   "end": 290.76,
   "text": "وقتی که میام پیش شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.76,
   "end": 294.2,
   "text": "پیش شما که هستم دلم نرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.2,
   "end": 297.1,
   "text": "وقتی میرم ضد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.1,
   "end": 299.64,
   "text": "حالم می‌ریزه به هم. حالا یک یک ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.64,
   "end": 303.64,
   "text": "وقتی پیش شمام دلم نرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.64,
   "end": 306.96,
   "text": "جان‌های هممون، اصلاً هرکس که پیش شما میاد اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.96,
   "end": 310.84,
   "text": "جان‌هامون آرامش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.84,
   "end": 314.62,
   "text": "در دنیا یعنی ت-- از تعلق، از بند تعلق آزاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.62,
   "end": 319.28,
   "text": "این آرامش داره یعنی اطمینانه، حالت اطمینان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.28,
   "end": 323.66,
   "text": "عدم تعلق به دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.66,
   "end": 328.66,
   "text": "بعد فرمود که مردم و آنچه که مردم، وای چه مردم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.66,
   "end": 333.44,
   "text": "که ما اصلاً چشم ما به داشته‌های مردمه میگه تو نظر ما خاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.44,
   "end": 335.88,
   "text": "اصلاً اینا رو هیچی حساب نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.88,
   "end": 338.74,
   "text": "کی؟ وقتی در محضر شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.74,
   "end": 347.18,
   "text": "اما وقتی از محضر شما بیرون میریم، میریم تو مردم، تو تجارتمون، تو کسب و کارمون و به قول ما اداره مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.18,
   "end": 353.06,
   "text": "فرمود که می‌دونیم اِ عوض شد، حال دل عوض شد و دوستدار دنیا می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.06,
   "end": 358.02,
   "text": "اون حالت عوض می‌شه. دل نرم بدل می‌شه به دل قسی و دنیا زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.02,
   "end": 362.02,
   "text": "حضرت در جواب اشاره کردند البته به حالات مختلف قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.02,
   "end": 365.24,
   "text": "اصلاً از این جهت بهش می‌گن قلب که منقلبه دیگه، انقلاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.24,
   "end": 368.92,
   "text": "هه حالش متقلبه، عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.92,
   "end": 374.14,
   "text": "بعد فرمودن مشابه همین سؤال شما رو یه صحابی از پیغمبر پرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.14,
   "end": 377.16,
   "text": "پیغمبر ببینید جواب رو چقدر شیرین دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.16,
   "end": 381.62,
   "text": "فرمودن والله قسم الله لفظ جلاله پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.62,
   "end": 389.64,
   "text": "والله سلام علیکم. لو تدومون علی الخالة التي وصفتم أنفسکم بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.64,
   "end": 394.1,
   "text": "به اون حضرت حق قسم که اگر شما تدومون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.1,
   "end": 397.88,
   "text": "دوام، اگر این حالی که وصف کردی از جانتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.88,
   "end": 400.0,
   "text": "مداومت داشتید براش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.0,
   "end": 402.76,
   "text": "یعنی این حال رو همیشه حفظ می‌کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.76,
   "end": 405.84,
   "text": "اگر این حال رو حفظ می‌کردید چه اتفاقی می‌افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.84,
   "end": 409.04,
   "text": "لصافحتکم الملائكة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.04,
   "end": 412.2,
   "text": "به به، به به. مصافحه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.2,
   "end": 414.26,
   "text": "معانی که به گردن به گردن می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.26,
   "end": 420.46,
   "text": "مصافحه دست میدن. یعنی مس می‌کنی ملائکه هم که عقول‌اند، مجرد‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.46,
   "end": 423.26,
   "text": "یعنی ارتباط می‌کنی با، پیدا می‌کنی با باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.26,
   "end": 427.8,
   "text": "یعنی دست میدید به ملائکه، قدرت‌تون فزونی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.8,
   "end": 430.78,
   "text": "دست که میدی قدرت می‌ریزه رو هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.78,
   "end": 435.6,
   "text": "اونا کمک حال شما می‌شن. دست می‌تونی مس کنی \"لا یمسّه إلا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.6,
   "end": 439.24,
   "text": "ببین چقدر پاکه محضر انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.24,
   "end": 442.28,
   "text": "که میگه وقتی رفتی این حال رو پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.28,
   "end": 445.32,
   "text": "حالا اگر اینو حفظش کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.32,
   "end": 449.44,
   "text": "لامش هم تأکیده. لصافحتکم الملائكة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.44,
   "end": 452.9,
   "text": "ملائکه میان با شما دست میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.9,
   "end": 456.86,
   "text": "چقدر آدم می‌تونه رشد کنه با هم‌نشینی با انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.86,
   "end": 459.64,
   "text": "و مشیتم علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.64,
   "end": 462.3,
   "text": "ما. اصلاً ما به این چیزا فکر می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.3,
   "end": 464.24,
   "text": "مثل آب خوردن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.24,
   "end": 467.04,
   "text": "چی؟ مشیتم، راه رفتن شما به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.04,
   "end": 470.86,
   "text": "علل ما. رو آب راه میرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.86,
   "end": 475.16,
   "text": "حضرت موسی ما فکر می‌کنیم اوه، اوه چه کار دشواری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.16,
   "end": 482.3,
   "text": "رود نیل رو شکافته. خب، تصرف در ماده کائنات کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.3,
   "end": 486.58,
   "text": "قبلاً در صد کلمه در معرفت نفس علو عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.58,
   "end": 490.34,
   "text": "سعادت نفس در اینه که بتونه تصرف کنه در ماده کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.34,
   "end": 494.06,
   "text": "نفس مجرده، می‌تونه ارتباط پیدا کنه با مجردات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.06,
   "end": 498.4,
   "text": "مجردات هم که همون عقول و مفارقات و مرسلات‌اند، ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.4,
   "end": 502.06,
   "text": "که رب مادون خودشونن اون‌ها هم قدرت دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.06,
   "end": 506.98,
   "text": "پرورش دهنده‌اند. اونا استیلا دارن، استعلى دارن بر مادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.98,
   "end": 511.44,
   "text": "اونا می‌تونن این قدرت رو دارن. شما با ارتباط با ملائکه می‌تونی رو آب راه بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.44,
   "end": 513.86,
   "text": "چیزی عجیبی نیست اینا که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.86,
   "end": 516.14,
   "text": "منتها راهش تو چیه؟ کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.14,
   "end": 518.3,
   "text": "همه اینا رو حضرت فرمود تو کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.3,
   "end": 520.84,
   "text": "هم‌نشینی با انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.84,
   "end": 523.78,
   "text": "وقتی با اونا می‌شینی اینطوری میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.78,
   "end": 527.16,
   "text": "عجب! یعنی سعادت در اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.16,
   "end": 532.78,
   "text": "ما فکر می‌کنیم حالا انقدر متأسفانه دور افتادیم از حقایق و معارف و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.78,
   "end": 537.18,
   "text": "این چیزا رو عروس یکی میگن آقا نگو، نگو این خرافات رو نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 537.18,
   "end": 540.46,
   "text": "از چیزی که بوده و هست و خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.46,
   "end": 545.42,
   "text": "حالا اینجا خب ما که دستمون به انسان کامل نمی‌رسه متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.42,
   "end": 550.04,
   "text": "البته یه نفر مثل سید ابن طاووس حجت میشه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.04,
   "end": 554.76,
   "text": "بر ما قیامت که فرمود چرا میگید راه علم و یقین مسدوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.76,
   "end": 560.28,
   "text": "من هر وقت برام سؤال ایجاد میشه محضر امام عصرم، همین آقایی که قاعده از نظر‌های ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.28,
   "end": 563.72,
   "text": "می‌رسم و سؤال‌هامو مطرح می‌کنم جواب می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.72,
   "end": 571.48,
   "text": "چرا بزرگانی که سیر انفسی و آفاقی دارن در عوالم سیر می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.48,
   "end": 574.04,
   "text": "من یه بار محضر امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.04,
   "end": 576.46,
   "text": "از امام خمینی در حرمشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.46,
   "end": 582.06,
   "text": "بودم به محضری که از بزرگان رسیدم و گفت و گوها کردیم و یه بزرگی بود ایشون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 582.06,
   "end": 584.38,
   "text": "کشف و کراماتی داشت. ایشون رفته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 584.38,
   "end": 591.78,
   "text": "ا-اکثریت قریب به اتفاق بزرگان رو س-- در سیر آفاقی و انفسی دیده بود در آسمان‌های چندم و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.78,
   "end": 594.22,
   "text": "دو نفر رو پیدا نکرده بود هرچی رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.22,
   "end": 597.24,
   "text": "سید ابن طاووس و سید بحر العلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.24,
   "end": 600.54,
   "text": "گفته بودم اونا در محضر امیرالمؤمنین یک آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.54,
   "end": 603.94,
   "text": "حاضر نیستن اون محضر رو رها کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 603.94,
   "end": 606.86,
   "text": "و یکی اینطوری میشه دیگه امام عصرشو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.86,
   "end": 611.56,
   "text": "اما خب چه کنیم ما که ضعیفیم، ما که گرفتاریم، ناقصیم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.56,
   "end": 618.4,
   "text": "بالاخره راهش چیه؟ ارتباط با اون‌هایی که بوی ولایت میدن، بوی امام عصر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.4,
   "end": 622.12,
   "text": "اون‌هایی که نگاشون می‌کنی یاد امام زمانت می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.12,
   "end": 624.46,
   "text": "نه هر عمامه به سری مثل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 624.46,
   "end": 628.84,
   "text": "اون‌ها مثل کنعانی، مثل آقای بهجت‌ها، مثل رهبر عزیزمون، مثل امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.84,
   "end": 631.34,
   "text": "مثل علامه حسن زاده این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 631.34,
   "end": 635.22,
   "text": "این‌ها رو رفتن نشستن. ما غافلیم از نفس اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.22,
   "end": 638.78,
   "text": "همش می‌خوایم بریم بشینیم تو درس و بحث و اونم عشق علت مؤد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.78,
   "end": 643.04,
   "text": "مؤده‌ست دیگه. که تو رو شخ بزنه وجودت که یه چیزی حالیت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.04,
   "end": 645.36,
   "text": "اما از نفسش چرا غافلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.36,
   "end": 649.36,
   "text": "یه بزرگی رو آدم پیدا کنه هر از چندگاهی بره محضرشو درک کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.36,
   "end": 652.5,
   "text": "نفسش چاق بشه به عب-- به عبارتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.5,
   "end": 655.34,
   "text": "امام کاظم صلوات الله علیه برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.34,
   "end": 661.16,
   "text": "پیش کدوم عالم بشینی، پیش کدوم عالم نشینی یه روایت زیبایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.16,
   "end": 665.46,
   "text": "لا تجالسوا عند کل عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.46,
   "end": 669.48,
   "text": "پیش هر عالمی نری جلع-- بنشینی جلوس کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 669.48,
   "end": 671.14,
   "text": "امام موسی کاظم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.14,
   "end": 675.48,
   "text": "سندش هم بحار جلده هفتاد و یک، صفحه صد و هشتاد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 675.48,
   "end": 678.2,
   "text": "الا عالم. حالا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 678.2,
   "end": 681.8,
   "text": "امام کاظم من پیش کدوم عالم برم جلوس کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 681.8,
   "end": 683.86,
   "text": "فرمود الا عالم یدعوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 683.86,
   "end": 690.56,
   "text": "من الخمس الی الخمس. مگر عالمی که شما رو بکشونه از پنج چیز به پنج چیز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.56,
   "end": 693.62,
   "text": "شما رو عبور بده از پنج چیز ببره به پنج چیز برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.62,
   "end": 697.46,
   "text": "اگه پیدا کردید بره جلوس کنید دلتون نرم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.46,
   "end": 699.66,
   "text": "اول فرمود من الشک الی اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.66,
   "end": 706.68,
   "text": "وقتی میری می‌شینی پیشش می‌بینی از شک و تردید نجات پیدا کردی و به یقین رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 706.68,
   "end": 711.44,
   "text": "بعد فرم-- دومیش فرمود و من الكبر الی التواضع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.44,
   "end": 720.36,
   "text": "خوی و منش این شخص رو دیدی از تکبر و تبختر نجات پیدا کردی و اصلاً عملاً تواضع و فروتنی رو یاد گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 720.36,
   "end": 723.96,
   "text": "سوم فرمود و من الرياء الی الاخلاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 723.96,
   "end": 729.29,
   "text": "تو رو از تظاهر و ظاهر فریبی و این چیزا بکشونه به سمت خلوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 729.29,
   "end": 734.29,
   "text": "عشق محض حضرت حق. چهارم \"و من Adawat Al نصیحه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.29,
   "end": 736.33,
   "text": "چقدر بین ما جنگ و دعوا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 736.33,
   "end": 738.69,
   "text": "این زیر آبه اونو میزنه، اون پشت سر اونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.69,
   "end": 742.97,
   "text": "میگه تو رو از عداوت و دشمنی ببره به سمت نصیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 742.97,
   "end": 749.07,
   "text": "نصیحه یعنی خیرخواهی. خیرخواه همه باشیم، خیر همه رو بخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 749.07,
   "end": 752.15,
   "text": "و بزرگترین خیرخواه عالم اصلا خود خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 752.15,
   "end": 756.69,
   "text": "جهنمش هم خیره. یه تعبی-- تادیبگاهی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.69,
   "end": 760.63,
   "text": "بدا. آدم بدا رو میریزه اون تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 760.63,
   "end": 762.89,
   "text": "بعد کیسه شونو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 762.89,
   "end": 766.23,
   "text": "کیسه می‌کشه که آلودگی هاشون بره بعد بیان تو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.23,
   "end": 771.49,
   "text": "اینجوری نیست که تا آخر تو بهشت همه ب-- تو جهنم همه بمونن که اکثراً میان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 771.49,
   "end": 775.31,
   "text": "و من الرغبة پنجمیش و من الرغبة ال زهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 775.31,
   "end": 777.77,
   "text": "تو رو از تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 777.77,
   "end": 781.45,
   "text": "و رغبت به دنیا بکشونه بیاره به سمت زهد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 781.45,
   "end": 783.43,
   "text": "یعنی بی‌علاقگی به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 783.43,
   "end": 790.55,
   "text": "الان پیش رفیقت می‌شینی می‌بینی شروع می‌کنه همش از دنیا حرف زدن، همش از دنیا و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.55,
   "end": 794.71,
   "text": "کیه که واقعاً در تو بی‌علاقگی نسبت به دنیا ایجاد کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 794.71,
   "end": 797.41,
   "text": "نه اینکه چشمت رو به روی حقایق عالم ببنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 797.41,
   "end": 803.09,
   "text": "نه، عبورت بده از همین حقای-- از همین واقعیت‌ها به حقایق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 803.09,
   "end": 807.01,
   "text": "به حقیقت‌ها. این صفات اون کسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 807.01,
   "end": 810.31,
   "text": "میشه پیشش نشست و دلت رو نرم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.31,
   "end": 814.87,
   "text": "یه نشونی خیلی قشنگ دیگه‌ای هم توی روایت قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 814.87,
   "end": 816.79,
   "text": "شنیدید، دیدید، خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.79,
   "end": 819.03,
   "text": "قبلاً هم من چند بار عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 819.03,
   "end": 821.31,
   "text": "که از حضرت عیسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 821.31,
   "end": 823.41,
   "text": "پیغمبر عزیز عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 823.41,
   "end": 828.75,
   "text": "سلام و صلوات و درود خدا و ملائکه و مقربینش بر او و خاندانش باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 828.75,
   "end": 832.29,
   "text": "ایشون فرمودن مشخصات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 832.29,
   "end": 839.01,
   "text": "کسی که صلاحیت اینو داره که باهاش بشینی، بشینی پاشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 839.01,
   "end": 840.77,
   "text": "روایت در چند جا اومده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 840.77,
   "end": 846.85,
   "text": "مثلاً اصول کافی، جلد یک، صفحه سی و نه، تحف العقول، صفحه چهل و چهار و چند جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 846.85,
   "end": 851.53,
   "text": "پیغمبر فرمودن \"قالت الحواریون لعیسی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 851.53,
   "end": 855.31,
   "text": "حواریون دور حضرت عیسی بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 855.31,
   "end": 858.47,
   "text": "اون دوازده نفر. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 858.47,
   "end": 860.79,
   "text": "که یکیشون خیلی شبیه حضرت عیسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 860.79,
   "end": 864.39,
   "text": "اونو به جای حضرت عیسی چون شبیه ایشون بود گرفتن دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 864.39,
   "end": 867.29,
   "text": "صلیب کشیدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 867.29,
   "end": 871.57,
   "text": "اینا، این‌ها دور حضرت بودن، نزدیکانش بودن، اقربای ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 871.57,
   "end": 877.23,
   "text": "پرسیدن \"یا روح الله من نجالس؟\" ما با کی بشینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 877.23,
   "end": 879.03,
   "text": "این روایت فصول الخطاب امروز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 879.03,
   "end": 883.91,
   "text": "با کی بشینیم؟ این با کی بشینیم خودش می‌تونه خط قرمز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 883.91,
   "end": 888.05,
   "text": "یعنی با کی نشینیم. \"قال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 888.05,
   "end": 893.41,
   "text": "حضرت روح الله فرمودن \"من یذکرکم الله رؤیتہ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 893.41,
   "end": 895.37,
   "text": "کسی که تو دیدیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 895.37,
   "end": 899.81,
   "text": "یاد خدا بیوفتی. اونم \"یذکرکم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 899.81,
   "end": 903.51,
   "text": "رؤیتہ\". الله رو اسم جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 903.51,
   "end": 906.13,
   "text": "پیغمبر فرمود \"من رعانی فقط رأی الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 906.13,
   "end": 909.09,
   "text": "هرکی منو ببینه به تحقیق الله رو دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 909.09,
   "end": 912.61,
   "text": "یعنی ببینی که جامعه‌یت داره، اسماء الهی درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 912.61,
   "end": 916.07,
   "text": "\"أشد على الكفار رحمة بينهم\" هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 916.07,
   "end": 918.47,
   "text": "برای شاید شما یکی رو ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 918.47,
   "end": 920.99,
   "text": "صرفاً مظهر مثلاً می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 920.99,
   "end": 923.39,
   "text": "خیلی مظهریت داره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 923.39,
   "end": 927.31,
   "text": "قهاریت. اسم القهار خدا بدجوری توش پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 927.31,
   "end": 929.71,
   "text": "به شدت شکننده این و اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 929.71,
   "end": 933.29,
   "text": "البته این اسماء افعالی‌ند دیگه ذاتی نیستند، می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 933.29,
   "end": 935.93,
   "text": "پس اولیش این که اونو دیدی یاد خدا بیوفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 935.93,
   "end": 940.13,
   "text": "دیگه چی؟ \"و یزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 940.13,
   "end": 943.53,
   "text": "فی علمک منطقہ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 943.53,
   "end": 947.83,
   "text": "وقتی باهاش نشستی ببینی منطقش علمت رو زیاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 947.83,
   "end": 950.39,
   "text": "نطقش علمت رو زیاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 950.39,
   "end": 956.53,
   "text": "سومی و آخریشم فرمود \"و یقر-- یرقبکم في الآخرة عملہ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 956.53,
   "end": 962.27,
   "text": "تو رو ترغیب بده عملش به سمت آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 962.27,
   "end": 968.29,
   "text": "تو رو ترغیب بده. یعنی راقب بشی با اعمالت به سمت آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 968.29,
   "end": 970.31,
   "text": "چون داری به اون سمت حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 970.31,
   "end": 972.95,
   "text": "اگر انشاالله پیدا کردید سلام ما رو هم برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 972.95,
   "end": 974.91,
   "text": "انشاالله عاقبت به خیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 974.91,
   "end": 978.15,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 978.15,
   "end": 981.23,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}