 "chapters": [
  {
   "index": 0,
   "title": "## تسلیت شهادت امام هادی و اختصاص اسماء",
   "start": 27.78,
   "end": 160.4
  },
  {
   "index": 1,
   "title": "## اسم الهادی و امام هادی",
   "start": 160.4,
   "end": 220.64
  },
  {
   "index": 2,
   "title": "## آیهٔ قلب لیّن و پیوند با هدایت",
   "start": 220.64,
   "end": 499.48
  },
  {
   "index": 3,
   "title": "هدایت از کجا آغاز می‌شود؟ تجلیات و اشراقات الهی یا نزول نور الهی:",
   "start": 499.48,
   "end": 624.32
  },
  {
   "index": 4,
   "title": "## تصرف امام هادی در دل‌ها",
   "start": 624.32,
   "end": 721.0
  },
  {
   "index": 5,
   "title": "## پوستین در گرما و تحقق سخن امیرالمؤمنین",
   "start": 721.0,
   "end": 946.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 3.36,
   "text": "لا حول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.36,
   "end": 8.14,
   "text": "ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 11.2,
   "text": "لا حول ولا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.2,
   "end": 15.5,
   "text": "العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.5,
   "end": 19.98,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.98,
   "end": 25.02,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.02,
   "end": 27.78,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.78,
   "end": 31.56,
   "text": "تسلیت عرض می‌کنم روز شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.56,
   "end": 35.02,
   "text": "امام هادی حضرت ابالحسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.02,
   "end": 40.58,
   "text": "علی بن محمد النقی سلام الله علیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.58,
   "end": 46.12,
   "text": "می‌دونید که کلهم نور واحد اما در حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.12,
   "end": 49.5,
   "text": "تجلی و ظهورشون، نمایششون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.5,
   "end": 52.92,
   "text": "تابششون بر نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.92,
   "end": 56.78,
   "text": "اختصاص پیدا می‌کنند به یک اسمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.78,
   "end": 62.94,
   "text": "که مثلاً امام رضا صلوات الله علیه همونطور که اسمشون رو خودشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.94,
   "end": 67.42,
   "text": "ظهور اسم روای حضرت حق در نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.42,
   "end": 71.42,
   "text": "طبیعت بلکه در کائنات تحت تصرف ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.42,
   "end": 76.2,
   "text": "یعنی چی؟ دقت بفرمایید که موضوع خیلی دقیقه، ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.2,
   "end": 81.76,
   "text": "هر کجا رضایتی در مسیر حق البته پیش بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.76,
   "end": 84.26,
   "text": "تحت تصرف ولایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.26,
   "end": 88.82,
   "text": "ولایت امام رضاست. یعنی حتی قطب مثبت و منفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.82,
   "end": 95.46,
   "text": "که راضی میشن به هم که پیوند می‌خورند و مزدوج میشن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.46,
   "end": 101.5,
   "text": "سبحان الذي خلق الازواج كلها این قطب مثبت و منفی به هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.5,
   "end": 109.0,
   "text": "مزدوج میشن. این ارتباط این‌ها هم چون با رضایت اتفاق می‌فته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.0,
   "end": 112.86,
   "text": "ازدواج و این تقرب تحت تصرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.86,
   "end": 115.18,
   "text": "رضایت امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.18,
   "end": 123.58,
   "text": "شما اگه از همسرت راضی بودی لحظه‌ای که همسرش و ایشون رو اختیار کردی یا ایشون بله گفت راضی بود قلباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.58,
   "end": 125.62,
   "text": "تحت تصرف امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.62,
   "end": 129.92,
   "text": "یه وجه این که میگن برای ازدواج برو رجوع کن به امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.92,
   "end": 132.58,
   "text": "یکی از دستوراتی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.58,
   "end": 135.56,
   "text": "چون یک سفره. ازدواج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.56,
   "end": 139.84,
   "text": "تشکیل زندگی یک سفره و تو یک همسفر میخوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.84,
   "end": 142.6,
   "text": "همسر، همسفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.6,
   "end": 147.14,
   "text": "که فرمودن مطلقاً مسافر به امام رضا توسل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.14,
   "end": 155.5,
   "text": "همونطور که ز-- کسی که تحت ستم و ظلم قرار می‌گیره مظلوم می‌شه به اول مظلوم عالم امیرالمؤمنین توسل کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.5,
   "end": 160.4,
   "text": "قص علی هذا. که همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.4,
   "end": 168.26,
   "text": "در اسم الهادی حضرت حق هم که إن الله يهدي من يشاء ويضل من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.26,
   "end": 170.36,
   "text": "این اسم تحت تصرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.36,
   "end": 174.98,
   "text": "امام هادی‌ست. امام علی بن محمد النقی الهادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.98,
   "end": 176.66,
   "text": "صلوات الله علیه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.66,
   "end": 181.1,
   "text": "به همون وزان. یعنی که هر هدایتی در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.1,
   "end": 185.48,
   "text": "عالم صورت بگیره تحت توجه و عنایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.48,
   "end": 187.84,
   "text": "تحت تصرف ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.84,
   "end": 192.84,
   "text": "اصلاً نیست هدایتی مگر اینکه دست امام هادی در کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.84,
   "end": 201.64,
   "text": "خیلی در خصوص همین موضوعی که من عرض کردم جای کار داره، جای تبیین داره و چقدر این آقا مظلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.64,
   "end": 205.88,
   "text": "چقدر مظلومه. چقدر هیئت داریم و جلساتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.88,
   "end": 209.36,
   "text": "این‌ها رسالتشون برگزاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.36,
   "end": 212.32,
   "text": "جلسات وفیا یا شهادت‌ها یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.32,
   "end": 217.76,
   "text": "مثلاً موالید اهل بیت اما در خصوص امام هادی کوتاهی کردند و می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.76,
   "end": 221.88,
   "text": "حالا در خ-- رابطه با اتفاقاً چون بحث ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.88,
   "end": 224.28,
   "text": "روزهای دوشنبه قلب اللعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.28,
   "end": 228.88,
   "text": "قلب در قرآن بود رسیدیم به قلب اللعین یا لين، قلب نرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.88,
   "end": 234.54,
   "text": "اتفاقاً چه شیرین که بر اساس همین آیه‌ای که موضوع قلب اللعین درش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.54,
   "end": 239.54,
   "text": "چه شیرین که ارتباط داره این موضوع به خود موضوع هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.54,
   "end": 245.64,
   "text": "چگونه؟ خود آیت، متن آیه بیست و سه سوره زمر رو که دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.64,
   "end": 251.06,
   "text": "از اونجا که الله نزل الحديث، نزل احسن الحديث شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.06,
   "end": 257.74,
   "text": "میره تا ثم تلين جلودهم و قلوبهم إلى ذكر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.74,
   "end": 260.66,
   "text": "دیگه ما ورود کردیم به بحث قلب اللعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.66,
   "end": 264.42,
   "text": "حالا ببینیم ارتباطش با بحث هدایت‌گری چگونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.42,
   "end": 267.1,
   "text": "که می‌فرماید سپس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.1,
   "end": 271.44,
   "text": "این‌ها تلين جلودهم این پوستشون نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.44,
   "end": 275.98,
   "text": "قبلش می‌فرماد که تقشعر منه جلود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.98,
   "end": 281.36,
   "text": "این پوستشون می‌لرزه به جهت اینکه متوجه آیات قهر خدا می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.36,
   "end": 283.5,
   "text": "اینجا تلين جلودهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.5,
   "end": 285.9,
   "text": "اینجا نرم می‌شه پوستشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.9,
   "end": 289.9,
   "text": "یعنی نرمش و خضوع در ظاهرشون می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.9,
   "end": 292.86,
   "text": "به جهت اینکه متوجه آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.86,
   "end": 296.42,
   "text": "رحمت الهی می‌شن و قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.42,
   "end": 299.24,
   "text": "و دل‌هاشون نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.24,
   "end": 307.38,
   "text": "بحث جلسه پیش که ظاهر و باطن در هم تنیدن یک حقیقت واحد زومراتب یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.38,
   "end": 311.72,
   "text": "از شب-- اطوار مختلف و متعدد یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.72,
   "end": 314.04,
   "text": "ظاهر و باطن از هم جدا نمی‌شن. وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.04,
   "end": 318.42,
   "text": "که قلب خاشع شد، قلب إلى ذكر الله با ذکر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.42,
   "end": 320.84,
   "text": "نرم شد قلباً قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.84,
   "end": 324.58,
   "text": "پوست آدم یعنی ظاهر آدم هم نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.58,
   "end": 328.64,
   "text": "نرم خو می‌شه، نرم خلق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.64,
   "end": 331.88,
   "text": "منشش نرم می‌شه از اون خشونت میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.88,
   "end": 336.0,
   "text": "اینا رابطه دارن با هم. نمی‌شه کسی باطنش نرم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.0,
   "end": 341.56,
   "text": "بعد ظاهرش خشن باشه. مگر أشد على الكفار اون دیگه قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.56,
   "end": 345.06,
   "text": "اونم با عقله، عاقلانه شدت می‌ورزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.06,
   "end": 348.84,
   "text": "نه از رو عصبیت که ما فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.84,
   "end": 355.06,
   "text": "حالا إلى ذكر الله که اینم باید بحث بشه البته به وقتش و انشاالله در آینده که با چی قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.06,
   "end": 358.6,
   "text": "خاشع می‌شه إلى ذكر الله با چی نرم می‌شه إلى ذكر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.6,
   "end": 361.46,
   "text": "حالا ذکر باید اینجا تبیین بشه بگذریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.46,
   "end": 364.98,
   "text": "که بعد می‌فرماید ذلك این آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.98,
   "end": 367.86,
   "text": "آن که از الان دربارش حرف زدیم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 367.86,
   "end": 370.78,
   "text": "هدی الله هدایت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.78,
   "end": 374.8,
   "text": "يهدي به ميشاي. اون قرآنی که سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.8,
   "end": 378.0,
   "text": "نرم شدن دل‌ها میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.0,
   "end": 381.62,
   "text": "که احسن الحديثه می‌فرماید که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.62,
   "end": 383.4,
   "text": "هد-- اون هدایتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.4,
   "end": 385.98,
   "text": "چرا والکا؟ چرا هذا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.98,
   "end": 389.1,
   "text": "چرا هذا القرآن نه؟ چرا والکا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.1,
   "end": 397.4,
   "text": "چون اینجا می‌فرماین انقدر که مقام قرآن شامخه اینجا داره به مقام احدیتش اشاره می‌کنه نه واحدیتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.4,
   "end": 401.22,
   "text": "اِاَمم مقام اشمخش که اصلاً دست نیفتنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.22,
   "end": 403.82,
   "text": "یعنی هدایت از اون احدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.82,
   "end": 406.08,
   "text": "نازل میشه از مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.08,
   "end": 411.42,
   "text": "وحدت محض نازل میشه میاد به عالم کثرت که واحدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.42,
   "end": 419.12,
   "text": "یه که می‌فرماد هدی الله يهدي به ميشاي که هرکیو حالا این ميشاي رو اگه به خدا بزنی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.12,
   "end": 421.74,
   "text": "خدا هرکی رو بخواد خودش هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.74,
   "end": 426.66,
   "text": "اگر به ما بزنی میگه هرکی که خودش دلش بخواد یعنی هر انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.66,
   "end": 429.1,
   "text": "که بخواد خدا اونو هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.1,
   "end": 431.06,
   "text": "اینطوری هم میشه معنون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.06,
   "end": 438.98,
   "text": "خب و من یضل اینجا رو دقت کنید و من-- انتهای آیه و من یضل الله هرکس که اونو رهاش کنه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.98,
   "end": 443.6,
   "text": "یعنی قاعده ازلال رهاش کنه فما له من هاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.6,
   "end": 445.24,
   "text": "فما له من هاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.24,
   "end": 447.98,
   "text": "دیگه هیچ هدایتگری براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.98,
   "end": 454.02,
   "text": "ببین رابطه نرمی دل با هدایت یا عدم هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.02,
   "end": 457.06,
   "text": "اگر دل نرم شد هدایت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 457.06,
   "end": 461.62,
   "text": "اگر دل نرم نبود، خشن بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.62,
   "end": 465.28,
   "text": "سفت و محکم بود این دیگه هدایتی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.28,
   "end": 468.06,
   "text": "فما له من هاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.06,
   "end": 471.72,
   "text": "چقدر جالب که اتفاقاً برخورد کرده با شهادت امام هادی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.72,
   "end": 474.2,
   "text": "همین امروز که این بحث رو داریم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.2,
   "end": 477.06,
   "text": "یا حالا این هدایت از کجا آغاز میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.06,
   "end": 481.78,
   "text": "نقطه آغازین هدایت خود همه اینا جمله به جمله منبر می‌خواد ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.78,
   "end": 486.46,
   "text": "ما داریم همینطوری میگیم میریم. دیگه اهلش می‌دونن که اهل مداقه باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.46,
   "end": 494.78,
   "text": "تدقق کنن درش. حالا اینجا می‌فرماید که تجلیات یا اشراقات الهیه یا همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.78,
   "end": 496.7,
   "text": "نزول نور الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.7,
   "end": 501.2,
   "text": "الله نور السماوات والارض که مثل نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.2,
   "end": 503.9,
   "text": "مثل نورهی پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.9,
   "end": 507.0,
   "text": "کمش کرد حضرت زهرا. همینطوری آیه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.0,
   "end": 509.08,
   "text": "تا پایین تمام اهل بیت رو در بر می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.08,
   "end": 512.06,
   "text": "آیه نور، آیه سی و پنج سوره نور رو برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.06,
   "end": 514.18,
   "text": "تجلیات یعنی تابش یعنی ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.18,
   "end": 518.02,
   "text": "تجلی در لغت یعنی به معنای تابش، ظهور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.02,
   "end": 520.8,
   "text": "نمایش، جلوه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.8,
   "end": 523.94,
   "text": "خدا چگونه جلوه می‌کنه؟ چگونه تجلی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.94,
   "end": 526.12,
   "text": "اتفاقاً در آیاتی داریم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.12,
   "end": 530.92,
   "text": "فلما تجلی، تجلی ربه للجبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.92,
   "end": 533.52,
   "text": "جعله دک و خر موسی صعقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.52,
   "end": 535.16,
   "text": "خدا تجلی کرد به اون کوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.16,
   "end": 539.32,
   "text": "چه جالب! به جبل، به کوه تجلی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.32,
   "end": 543.18,
   "text": "پاچید از هم کوه که موسی غش کرد افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.18,
   "end": 548.0,
   "text": "چرا؟ داره میگه که ببین سخت‌ترین چیزا در نشأت طبیعت کوهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.0,
   "end": 550.62,
   "text": "با تجلی الهی می‌پاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.62,
   "end": 554.52,
   "text": "چی میشه؟ نرم میشه، پودر میشه، نرم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.52,
   "end": 557.52,
   "text": "یا مثلاً در دوباره داریم در زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.52,
   "end": 562.42,
   "text": "شب مبعث اللهم انی اسألك بتجلی الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.42,
   "end": 564.68,
   "text": "تجلی اعظم حق کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.68,
   "end": 566.24,
   "text": "پیغمبر عزیز عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.24,
   "end": 570.04,
   "text": "وتجلیت لابراهیم في مسجد الخيف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 570.04,
   "end": 575.06,
   "text": "زیاده در ادعیه، در زیارات، در خود قرآن تجلی حق یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.06,
   "end": 580.24,
   "text": "تنزل نور، نور، نور الهی میاد نازل میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.24,
   "end": 584.12,
   "text": "من لم يجعل الله له نورا فما له من نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.12,
   "end": 587.9,
   "text": "اگه کسی خدا براش نور قرار نده نوری در-- براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.9,
   "end": 594.88,
   "text": "این نور شروع تجلیه. تجلی یعنی ظهور، تابش، نمایش خدا در قلب هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.88,
   "end": 599.78,
   "text": "اگر خدا تجلی کرد در قلب کسی نتیجه‌ش میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.78,
   "end": 603.66,
   "text": "میشه قلب نرم. خیلی راحت رسیدیم به موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.66,
   "end": 609.68,
   "text": "قلب لعن یا نرم. حالا اگر کسی قلبش نرم شد بر اساس آیه این چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.68,
   "end": 612.32,
   "text": "هدایت شده. مثلا هدایت از دل این میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 612.32,
   "end": 614.44,
   "text": "یعنی شروع هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.44,
   "end": 618.26,
   "text": "با نزول نور و تجلیات و اشراقات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 618.26,
   "end": 624.03,
   "text": "است که منجر میشه، منتج میشه به نرم شدن دل و در نتیجه هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.03,
   "end": 627.38,
   "text": "لذا در زمان امام هادی صلوات الله علیه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.38,
   "end": 631.26,
   "text": "انقدر که حضرت-- عرض کردم که هدایت تحت تصرف ایشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.26,
   "end": 634.2,
   "text": "حلا-- حتی الان نه زمان حیاتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.2,
   "end": 637.22,
   "text": "انقدر که حضرت تجلی می‌کرد، حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.22,
   "end": 642.5,
   "text": "تصرف می‌کرد در دل‌ها و قلب‌ها و دل‌ها رو نرم می‌کرد، هدایت می‌کرد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.5,
   "end": 646.38,
   "text": "دیگه مورد خشم و غضب دیگران واقع شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.38,
   "end": 648.62,
   "text": "تا جایی که در تاریخ نوشته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.62,
   "end": 653.6,
   "text": "مثلاً عبدالله بن محمد امام جماعت مسجد النبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.6,
   "end": 656.64,
   "text": "این ملعون خبیث دیگه انقدر بدش اومد دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.64,
   "end": 659.02,
   "text": "همه تحت نفوذ حضرتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.02,
   "end": 661.64,
   "text": "دشمن‌ترین دشمن‌ها میان حتی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.64,
   "end": 665.74,
   "text": "جریان اِاِاِ جُنیدی رو شنیدید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 665.74,
   "end": 668.8,
   "text": "جُنیدی رو که آوردن گفتن آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 668.8,
   "end": 674.04,
   "text": "بر معروفه. یکی از علمای برجسته بلکه بهترین عالم ضد ولایت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 674.04,
   "end": 678.92,
   "text": "خیلی قرآن رو حفظ بود، تفاسیر چه چه، ولی منهای ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.92,
   "end": 681.48,
   "text": "ایشون رو انداختن تو حالا یه جایی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.48,
   "end": 685.96,
   "text": "یه محوطی مدینه ها هنوز نرفتن سامرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.96,
   "end": 690.34,
   "text": "تبعید نشدن. اونجا ایشون رو قرار دادن گفتن شما برو تربیت کن چون امام هادی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.34,
   "end": 694.68,
   "text": "شش تا هشت سالش بودن دیگه ایشون امام شدن تا سی و سه سال هم امامت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.68,
   "end": 698.3,
   "text": "گفتن شما ایشون، ایشون رو تربیت کن بیارش به وادی ما عباسیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.3,
   "end": 703.78,
   "text": "چشم. یه پول هنگفت هم خلیفه متوکل علیه لعنة در اختیارش گذاشت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.78,
   "end": 707.98,
   "text": "تو اون اتاق حتی می‌رفت درو قفل می‌کرد کسی وارد نشه به حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.98,
   "end": 709.72,
   "text": "رفت اومد یه چند جلسه گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.72,
   "end": 713.52,
   "text": "تو سه جلسه میگن چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.52,
   "end": 717.4,
   "text": "برگشت و از مریدان دست اول امام هادی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 717.4,
   "end": 721.98,
   "text": "یعنی هدایت، هدایت قلبی امام هادی با سه بار نشستن با حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.98,
   "end": 729.66,
   "text": "حالا من یه عمر سر سفره اهل بیتم ادعا می‌کنم نوکر امام زمانم چرا این دل نرم نیست و همش ازش خشونت دیده میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 729.66,
   "end": 732.72,
   "text": "اونا دیگه باید بحث بشه بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 732.72,
   "end": 734.66,
   "text": "اینطوری بود همه تحت نفوذش بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 734.66,
   "end": 737.4,
   "text": "اصلا به همین دلیل بود که بعد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 737.4,
   "end": 742.42,
   "text": "عبدالله بن محمد دیگه حسدش گل کرد و یه نامه به متوکل نوشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 742.42,
   "end": 745.82,
   "text": "ایشون یعنی علی بن محمد داره بر علیه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 745.82,
   "end": 748.28,
   "text": "یار جمع میکنه و سعایت کرد و نامه نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 748.28,
   "end": 751.52,
   "text": "متوکل هم، اِاِاِ یحیی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 751.52,
   "end": 755.64,
   "text": "بن هرثمه رو فرستاد که با سیصد نفر امام هادی رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 755.64,
   "end": 757.5,
   "text": "مدینه ببرن به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 757.5,
   "end": 759.18,
   "text": "به سامرا. شروع تبعید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.18,
   "end": 764.28,
   "text": "و جالبه که یحیی میگه من وارد مدینه شدم با اون سیصد نفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.28,
   "end": 766.44,
   "text": "دیدم زجه مردم بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.44,
   "end": 768.92,
   "text": "تو عمرم همچین زجه‌ای نشنیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 768.92,
   "end": 772.12,
   "text": "چرا؟ فهمیدن من می‌خوام امام رو از پیش اینا ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 772.12,
   "end": 775.44,
   "text": "ایشون که نمیگفت امام. علی بن محمد رو ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.44,
   "end": 779.46,
   "text": "نشون داد چقدر مردم تحت نفوذ و سلطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.46,
   "end": 783.26,
   "text": "هدایتگری و تصرف هدایتی ایشون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.26,
   "end": 786.1,
   "text": "یا حالا به هر حال بردیم. بعد یه چیز عجیبی پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.1,
   "end": 789.6,
   "text": "جریان جالبی داره اینم براتون بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.6,
   "end": 792.56,
   "text": "در تاریخ نوشتن که حضرت وقتی میخواست بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 792.56,
   "end": 796.24,
   "text": "به این چند نفر شیعیانش که همراهش بودند فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 796.24,
   "end": 798.62,
   "text": "لباس پشینه گرم تنتون کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 798.62,
   "end": 801.5,
   "text": "در حالی که هوا عادی بود، سرد نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.5,
   "end": 803.68,
   "text": "سیصد نفری که باهاش بودند خندیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 803.68,
   "end": 806.42,
   "text": "با هرثمه بودند. ابن هرثمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 806.42,
   "end": 809.04,
   "text": "یحیی ابن هرثمه. خیلی خندیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 809.04,
   "end": 813.72,
   "text": "پوستخند زدند. نگاه کن تو این هوا پوستین و پشینه پوشیدن و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 813.72,
   "end": 815.82,
   "text": "راه افتادند رفتند. اینا هی پوستخند می‌زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 815.82,
   "end": 819.26,
   "text": "تو راه، تو بیابونا و صحراها که رسیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 819.26,
   "end": 827.12,
   "text": "دیگه یکیشون نامرد یه مثلاً نیش زبون به امام زد که آره جد شما-- بعد یه نگاه به بیابونا کرد برهوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 827.12,
   "end": 833.0,
   "text": "گفتش که آره جد شما امیرالمؤمنین که نمیگفتن علی ابن ابی طالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.0,
   "end": 841.32,
   "text": "صلوات الله علیه گفته که ادعا کرده که بیابون، بیابونی صحرایی نیست مگر اینکه قبرستان بوده یا خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 841.32,
   "end": 843.9,
   "text": "آخه این قبرستون، این بیابون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 843.9,
   "end": 849.32,
   "text": "برهوتو که ما داریم ازش رد میشیم میریم کجا اینجا میشه قبرستون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 849.32,
   "end": 854.68,
   "text": "هه هه هه خندیدن به فرمایش العیاذ بالله امیرالمؤمنین و امام هادی هم اونو نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 854.68,
   "end": 858.34,
   "text": "آقا ساعتی نگذشت از آسمون رعد و برق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 858.34,
   "end": 861.6,
   "text": "شدید صاعقه تگرگ تو اون هوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 861.6,
   "end": 865.0,
   "text": "تگرگ شدید به قدرت خدا بارش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 865.0,
   "end": 871.46,
   "text": "طوری که تو تاریخ نوشته به شدت هوا سرد شد و این تگرگ‌ها تو سر و صورت اینا می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 871.46,
   "end": 877.12,
   "text": "از شدت برخورد و اصابت این تگرگ‌ها و هوای سرد چندتاشون به درک واژ شدند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 877.12,
   "end": 880.04,
   "text": "سیصد نفر. حالا تاریخ ننوشته چند نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.04,
   "end": 886.48,
   "text": "یه سریشون مردن همونجا دفن شدند و حضرت اشاره کرد فرمود دیدید فرمایش جدم امیرالمؤمنین به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 886.48,
   "end": 891.72,
   "text": "تحقق پیوست. دیدید همین بیابونی که مسخره می‌کردید فرمایش باباما شد قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.72,
   "end": 894.88,
   "text": "یاران شما. اینجا هم پس قبرستان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 894.88,
   "end": 900.74,
   "text": "جدی بگیرید. این، اینطوری بود که بعد حالا اینا یاران حضرت زنده موندن تا رفتن سامرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 900.74,
   "end": 908.8,
   "text": "هرکس که در مسیر هدایت قرار گرفته قطعاً تحت نفوذ نگاه امام هادی قرار گرفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 908.8,
   "end": 912.9,
   "text": "که قبل، قطعاً قبلش چی شده که قلب هدایت شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 912.9,
   "end": 919.0,
   "text": "قلب نرم شده. قبلاً قبل از نرم شدن قلب چه اتفاقی افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 919.0,
   "end": 922.36,
   "text": "تجلی. آفرین. شروق حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 922.36,
   "end": 926.56,
   "text": "خودش رو نشون داده. قبل از تجلی حق چه اتفاقی افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 926.56,
   "end": 932.14,
   "text": "تنزل نور. نور نازل شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 932.14,
   "end": 935.76,
   "text": ". حالا این نزول حق یا دفعیه یا تدریجیه دیگه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 935.76,
   "end": 938.38,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 938.38,
   "end": 941.38,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 941.38,
   "end": 946.3,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}