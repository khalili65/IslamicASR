 },
 "chapters": [
  {
   "index": 0,
   "title": "## تفسیر اهل بیت؛ لین و رقت و دمعه و وجل",
   "start": 16.64,
   "end": 47.22
  },
  {
   "index": 1,
   "title": "## ذکر الله؛ مطلق ذکر و یاد قلبی",
   "start": 47.22,
   "end": 105.0
  },
  {
   "index": 2,
   "title": "## آیات ذکر و اهمیت صلاة",
   "start": 105.0,
   "end": 759.87
  },
  {
   "index": 3,
   "title": "## اول‌وقت و مراقبه؛ پادزهر دنیا",
   "start": 759.87,
   "end": 968.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.24,
   "end": 6.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.48,
   "end": 10.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.54,
   "end": 16.64,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.64,
   "end": 21.12,
   "text": "در خصوص آیه بیست و سه سوره زمر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.12,
   "end": 24.6,
   "text": "پیرامون قلب اللین هست دیروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.6,
   "end": 29.3,
   "text": "نکته‌ای رو عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.3,
   "end": 32.16,
   "text": "بنده خدا بین خوف و رجا گیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.16,
   "end": 38.54,
   "text": "تخشع منه جلود الذين يخشون ربهم این خوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.54,
   "end": 44.24,
   "text": "یعنی چنان خوف خدا می‌گیرش، خائف می‌شه که پوست بدنش می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.24,
   "end": 48.1,
   "text": "ثم تلين جلودهم وقلوبهم إلى ذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.1,
   "end": 51.06,
   "text": "این امید. رجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.06,
   "end": 56.82,
   "text": "بین خوف و رجا این بنده گرفتار می‌شه، گیر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.82,
   "end": 60.1,
   "text": "و عرض کردیم که این حالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.1,
   "end": 63.9,
   "text": "به نظر علامه طباطبایی این حالتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.9,
   "end": 68.1,
   "text": "بعد از اون خوف بدنش آروم می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.1,
   "end": 70.86,
   "text": "هم پوست بدنش، جلودهم و هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.86,
   "end": 75.92,
   "text": "قلبش، قلوبهم؛ یعنی ظاهر و باطنش آرامش پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.92,
   "end": 80.24,
   "text": "این حالت رو علامه نظرش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.24,
   "end": 82.76,
   "text": "به این حالت می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.76,
   "end": 89.42,
   "text": "اون هدایت الهی که ذلک هدى الله يهدي به من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.42,
   "end": 94.04,
   "text": "تا اینجا صحبت کردیم. حالا این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.04,
   "end": 98.02,
   "text": "نرمی دل، رقت قلب، اشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.02,
   "end": 102.98,
   "text": "و حالت اضطرابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.98,
   "end": 107.64,
   "text": "حالت بیمی که در انسان ایجاد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.64,
   "end": 115.38,
   "text": "این‌ها هم همش ریشه داره از اینکه خواست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.38,
   "end": 119.5,
   "text": "اگر خواست خدا نبود اینچ-- این چنین نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.5,
   "end": 121.9,
   "text": "گاهی اوقات آدم از خودش یه چیزایی درمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.9,
   "end": 126.0,
   "text": "مثلا احتمال داره کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.0,
   "end": 132.0,
   "text": "بگه که آقا وقتی ک-کسی حسین، حسین می‌گه شما رو دو تا دستت راه برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.0,
   "end": 139.02,
   "text": "مثلا. بین زمین و آسمون معلق شو و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.02,
   "end": 142.32,
   "text": "باید دید نص صریح چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.32,
   "end": 146.76,
   "text": "در خصوص این حالاتی که پیرامون شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.76,
   "end": 149.86,
   "text": "هدایت قرآنی ایجاد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.86,
   "end": 151.96,
   "text": "مثلا در ذیل همین آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.96,
   "end": 153.84,
   "text": "برید تا تفسیر اهل بیت رو نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.84,
   "end": 158.2,
   "text": "منظور از تفسیر اهل بیت تفسیر قميه دیگه، می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.2,
   "end": 160.16,
   "text": "جلد سیزده، صفحه دویست و بیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.16,
   "end": 162.88,
   "text": "اونجا جابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.88,
   "end": 169.42,
   "text": "به امام باقر صلوات الله علیه عرض می‌کنه که یه گروهی هستن که این‌ها اندکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.42,
   "end": 172.64,
   "text": "و وقتی که قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.64,
   "end": 177.82,
   "text": "براشون می‌خونی، قرآن رو که به یاد میارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.82,
   "end": 180.46,
   "text": "چنان از هوش میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.46,
   "end": 186.46,
   "text": "یه حالت غیرعادی بهشون دست می‌ده که اگه دست و پای این‌ها رو اون لحظه قطع کنی نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.46,
   "end": 190.18,
   "text": "می‌گن یه عده اصولای این چنینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.18,
   "end": 192.54,
   "text": "بعد حضرت فرمودن که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.54,
   "end": 197.68,
   "text": "امام باقر، سبحان الله ذلک من الشيطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.68,
   "end": 201.4,
   "text": "این کار از شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.4,
   "end": 204.06,
   "text": "سبحان الله! حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.06,
   "end": 208.34,
   "text": "چی رحمانیه؟ چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.34,
   "end": 215.0,
   "text": "ارتباطی ما نسبت به، یعنی چه عکس‌العملی نسبت به این هدایت قرآنی داشته باشیم رحمانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.0,
   "end": 218.88,
   "text": "ما به هذا نعتوا. اصلا همچین چیزی رو خدا تو قرآن نفرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.88,
   "end": 224.36,
   "text": "نعت‌شون رو، وصف‌شون رو این چنین نفرموده بلکه فرموده انما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.36,
   "end": 226.66,
   "text": "هو اللين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.66,
   "end": 230.66,
   "text": "و الرقة و الدمعة و الوجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.66,
   "end": 235.68,
   "text": "این‌ها پیشامد‌های شنیدن قرآن و هدایت قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.68,
   "end": 238.68,
   "text": "لين، دل نرم بشه، رقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.68,
   "end": 243.56,
   "text": "چنان رقتی پیدا بکنه که و الدمعة دیگه اشک جاری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.56,
   "end": 246.48,
   "text": "والوجل که اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.48,
   "end": 251.48,
   "text": "قبلاً قلب وجل رو چند جلسه صحبت کردیم ازش گذشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.48,
   "end": 255.26,
   "text": "قلب بیمناک، ترسناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.26,
   "end": 258.56,
   "text": "که این نشون می‌ده که اون حالاتی هم که در انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.56,
   "end": 261.22,
   "text": "اتفاق می‌افته باید ریشه الهی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.22,
   "end": 264.68,
   "text": "همینطوری که این آدم خودش هر حالتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.68,
   "end": 267.9,
   "text": "اجازه بده به خودش بگیره در قبالش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.9,
   "end": 269.96,
   "text": "در قبال شنیدن این هدایت قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.96,
   "end": 276.1,
   "text": "حالا نکته آخری که دیگه فکر می‌کنم آخرین نکته‌ای باشه که بخوایم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.1,
   "end": 281.52,
   "text": "در خصوص این آیه و رد شیم دیگه بریم سراغ قلب جدید اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.52,
   "end": 284.48,
   "text": "اینجا اگر دقت بفرمایید می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.48,
   "end": 286.68,
   "text": "این هدایت قرآنی نو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.68,
   "end": 292.62,
   "text": "ثم تلین جلودهم و قلوبهم وقتی که پوستشون و دلشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.62,
   "end": 295.18,
   "text": "نرم می‌شه، تلین و نرم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.18,
   "end": 300.9,
   "text": "با چی نرم می‌شه؟ بعدش می‌فرماید ذلک هدى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.9,
   "end": 304.04,
   "text": "این، اون یعنی این حالتی که پیش میاد هدایت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.04,
   "end": 306.58,
   "text": "اما با چی این هدایت جاری می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.58,
   "end": 310.34,
   "text": "می‌فرماید إلى ذكر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.34,
   "end": 313.74,
   "text": "با ذکر الله این اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.74,
   "end": 315.92,
   "text": "بله قرآن خودش ذکر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.92,
   "end": 318.06,
   "text": "یکی از اسامی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.06,
   "end": 321.08,
   "text": "ذکره. اما اینجا مطلق ذکر رو منظوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.08,
   "end": 323.5,
   "text": "من خیلی تفاسیر رو زیر و رو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.5,
   "end": 326.5,
   "text": "دیدم غالباً نظرش اینه که اینجا مطلق ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.5,
   "end": 332.56,
   "text": "بله البته بعضی از ذکر الله‌ها هستن که دیگه اعظم‌ان، اشرفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.56,
   "end": 335.66,
   "text": "مثلاً fain-- اون که می‌فرماید من أعرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.66,
   "end": 341.64,
   "text": "عن ذكري فإن له معيشة ضنكا ونحشره يوم القيامة أعمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.64,
   "end": 345.44,
   "text": "قرآن می‌فرماید کسی که اعراض کنه، پشت کنه به ذکر ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.44,
   "end": 349.96,
   "text": "به یاد ما، چنین کسانی معیشت زنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.96,
   "end": 353.54,
   "text": "پیدا می‌کنن، مشکلات اقتصادی شدید پیدا می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.54,
   "end": 355.62,
   "text": "قیامت هم نابینا محشور می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.62,
   "end": 360.87,
   "text": "خب اینجا ذیلش روایت آوردن که منظور از این ذکر اینجا تو این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.87,
   "end": 363.89,
   "text": "ذكرناست یعنی ذکر ما اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.89,
   "end": 367.65,
   "text": "یعنی کسی که امام عصرش رو فراموش کنه این بلا سرش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.65,
   "end": 375.67,
   "text": "توجه کردید؟ هر جا منظور از ذکر الله می‌تونه چیزی باشد اما مطلقاً ذکر الله یعنی یاد قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.67,
   "end": 378.65,
   "text": "شما یه وقت یا خدا رو یاد می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.65,
   "end": 381.07,
   "text": "ورد رو زبانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.07,
   "end": 383.61,
   "text": "جاری می‌شه. ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.61,
   "end": 388.01,
   "text": "تردد می‌کنی یک اسمی رو رو زبا-- لسانت هی تردد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.01,
   "end": 390.55,
   "text": "ورود می‌کنی خارج می‌شه. به این می‌گن ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.55,
   "end": 394.85,
   "text": "اما وقتی همراه یاد قلبی شد می‌شه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.85,
   "end": 400.11,
   "text": "این که قبلاً بحث کردیم. حالا این ذکر الله که یاد قلبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.11,
   "end": 404.89,
   "text": "بعضی جاها اعظمه. یکی از جاهایی که خیلی اعظمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.89,
   "end": 407.07,
   "text": "مثلاً یاد امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.07,
   "end": 409.83,
   "text": "یکی ج-- دیگه از جاها خود نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.83,
   "end": 412.81,
   "text": "نماز که اجازه بدید الان به روایتش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.81,
   "end": 415.33,
   "text": "تو قرآن خیلی از ذکر الله یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.33,
   "end": 422.15,
   "text": "خیلی زیاد. یعنی انقدر آیات پیرامون ذکر الله هست چند تاشو من تبرکاً تندتند بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.15,
   "end": 424.23,
   "text": "مثلاً آیه چهل و یک احزاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.23,
   "end": 427.57,
   "text": "\"یا ایها الذین آمنوا اذكروا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.57,
   "end": 430.99,
   "text": "ذكراً كثيرا\" تازه اینجا ذکر کثیر رو می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.99,
   "end": 435.91,
   "text": "ده جمعه \"وابتغوا من فضل الله واذكروا الله كثيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.91,
   "end": 438.91,
   "text": "لعلكم تفلحون\". بذار دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.91,
   "end": 440.67,
   "text": "نشونی آیه رو من الان وقت نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.67,
   "end": 444.69,
   "text": "\"واذكر اسم ربک، واذكر اسم ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.69,
   "end": 449.45,
   "text": "وتبت الی الہ تبتیلا\". \"واذكر اسم ربک بكرة واصیلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.45,
   "end": 452.05,
   "text": "\"وذكر اسم ربه فصلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.05,
   "end": 456.01,
   "text": "\"وذكر اسم ربه فصلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.01,
   "end": 462.89,
   "text": "\"الذین یذکرون الله قياما وقعودا وعلی جنوبهم\" یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.89,
   "end": 467.33,
   "text": "\"الذین یذکرون الله\" اینا دائم مشغول ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.33,
   "end": 470.25,
   "text": "ایستاده، نشسته، خوابیده \"وعلی جنوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.25,
   "end": 475.81,
   "text": "\"واذكر ربک فی نفسك تبرّعاً وخيفة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.81,
   "end": 478.89,
   "text": "ظاهر و باطن مشغول ذکر پروردگار باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.89,
   "end": 482.95,
   "text": "\"فاذکرونی اذكرکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.95,
   "end": 487.49,
   "text": "یکی از آثار ذکر الهی اصلاً اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.49,
   "end": 490.29,
   "text": "وقتی خدا رو یاد کنی خدا هم تو رو یاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.29,
   "end": 492.71,
   "text": "\"فاذکرونی اذكرکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.71,
   "end": 495.21,
   "text": "یاد من کن تا من یاد تو بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.21,
   "end": 502.33,
   "text": "یا اونجا که می‌فرماید \"فاسألوا\" تو دو تا آیه قرآن دیدم هست \"فاسألوا اهل الذکر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.33,
   "end": 508.25,
   "text": "معمولاً بچه‌هایی که میاد از ما سؤال می‌کنن ما اون سؤالو بلد نیستیم یا می‌خوایم بپیچینیشون این آیه رو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.25,
   "end": 510.41,
   "text": "می‌گیم \"فاسألوا اهل الذکر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.41,
   "end": 512.57,
   "text": "برو از اهل ذکر بپرس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.57,
   "end": 516.03,
   "text": "البته روایت داریم اهل ذکر اینجا منظور اهل بیت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.03,
   "end": 519.75,
   "text": "ائمه معصومه. حالا ببینید زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.75,
   "end": 524.03,
   "text": "در هر حال یا اون آیه‌ای که \"أقم الصلاة لذکری\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.03,
   "end": 529.03,
   "text": "برای اینکه یاد من کنی \"لذکری\" اصلاً فلسفه صلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.03,
   "end": 531.57,
   "text": "یاد خداست، ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.57,
   "end": 536.11,
   "text": "بعضیا گفتن اون ذکر الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.11,
   "end": 537.87,
   "text": "خود صلاة، نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.87,
   "end": 540.21,
   "text": "اهمیت نماز که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.21,
   "end": 546.25,
   "text": "این برکت صحبت امروز به جهت برکت نشست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.25,
   "end": 550.03,
   "text": "عزیزانی هست که پنج نفر از این ریش سفیدا نشستیم بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.03,
   "end": 556.19,
   "text": "دیروز بحث شد رو همین مبحثی که داشتیم می‌گفتیم و بحث نماز مطرح شد بین دوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.19,
   "end": 558.95,
   "text": "ریشه‌یابی شد، آسیب‌شناسی شد که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.95,
   "end": 565.81,
   "text": "مساجد خلوته یا بعضی جوون‌هایی که تو همین مرکز هستن شاید به نماز اهمیت ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.81,
   "end": 568.79,
   "text": "گفتم تبرکاً این رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.79,
   "end": 573.85,
   "text": "زیل این آیه چهل و پنج سوره عنکبوت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.85,
   "end": 578.59,
   "text": "صراحتاً بحث صلاة رو میاره در ذکر \"إن الصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.59,
   "end": 580.91,
   "text": "تنها عن الفحشاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.91,
   "end": 583.29,
   "text": "والمنكر\" اینو همه شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.29,
   "end": 586.71,
   "text": "معمولاً تا اینجاشو هم می‌شنویم. بقیه‌شو نمی‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.71,
   "end": 589.73,
   "text": "بله صلاة اگر صلاة باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.73,
   "end": 592.79,
   "text": "انسان رو از زشتی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.79,
   "end": 595.81,
   "text": "پستی حفظ می‌کنه، از فحشا و منکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 595.81,
   "end": 600.15,
   "text": "\"ولذكر\" اون لام تأکیده \"ولا ذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 600.15,
   "end": 603.41,
   "text": "اکبر\". قطعاً ذکر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 603.41,
   "end": 606.75,
   "text": "بالاتره، بزرگتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 606.75,
   "end": 610.19,
   "text": "خب این منظور کدوم ذکر الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.19,
   "end": 613.25,
   "text": "اجازه بدید از فرمایش امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 613.25,
   "end": 615.87,
   "text": "باقر علیه الصلاة والسلام سؤال رو جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.87,
   "end": 618.65,
   "text": "تفسیر قمی رو رجوع کنید جلد دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.65,
   "end": 623.43,
   "text": "صفحه صد و پنجاه و سه. الوشیه جلد بیست و هفت صفحه سیصد و هفتاد و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 623.43,
   "end": 629.45,
   "text": "منبع این روایته. امام باقر صلوات الله علیه زیل همین آیه چهل و پنج سوره عنکبوت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.45,
   "end": 634.73,
   "text": "\"ذكر الله لاهل الصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.73,
   "end": 637.69,
   "text": "اکبر من ذکرهم إياه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.69,
   "end": 642.27,
   "text": "می‌فرماید یاد خدا از اهل نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 642.27,
   "end": 646.63,
   "text": "بزرگتر است از یاد نمازگزار از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 646.63,
   "end": 649.99,
   "text": "یعنی شما نماز می‌خونی \"أقم الصلاة لذكري\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.99,
   "end": 652.19,
   "text": "نماز می‌خونی که یاد خدا بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.19,
   "end": 655.77,
   "text": "حالا اون یادی که خدا از تو می‌کنه به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 655.77,
   "end": 661.55,
   "text": "أجل، أشمخ، اکبر، بالاتر است از اون یادیست که تو از خدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.55,
   "end": 665.07,
   "text": "این فرمایش امام باقره و برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 665.07,
   "end": 667.63,
   "text": "دلیلشونم می‌فرماید \"ألا ترى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 667.63,
   "end": 673.99,
   "text": "آیا ندیدی که \"أنه یقول\" خودش خدا تو قرآن فرمود \"فاذکرونی اذكرکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.99,
   "end": 677.83,
   "text": "خب اگه نماز ذکر خداست قطعاً خدا هم یاد تو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.83,
   "end": 681.67,
   "text": "اما اینجا که می‌فرماید \"ولذكر وذكر الله اکبر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.67,
   "end": 687.99,
   "text": "یعنی اون یادی که خدا از نمازگزار مصلی می‌کنه به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.99,
   "end": 690.49,
   "text": "بالاتر است از یادی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.49,
   "end": 694.99,
   "text": "مصلی از حق می‌کنه که \"المصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.99,
   "end": 698.47,
   "text": "یناجی ربه\" یا \"في المحراب یناجي رب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.47,
   "end": 704.21,
   "text": "کسی که در محراب نماز قرار می‌گیره داره مناجاتو با خدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 704.21,
   "end": 706.89,
   "text": "دیدی شما اینو دقت بفرمایید ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 706.89,
   "end": 710.19,
   "text": "شما وقتی با یکی خیلی خودمونی باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.19,
   "end": 714.55,
   "text": "بخوای حرفی رو بهش بزنی که اهدی نشنوه نزدیکش می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 714.55,
   "end": 716.23,
   "text": "و تو گوشش حرف می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.23,
   "end": 719.89,
   "text": "به این حالت در عربی می‌گن نجوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 719.89,
   "end": 725.81,
   "text": "مناجات یعنی این، در گوشی حرف زدن، مقا-مخالف منادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 725.81,
   "end": 728.77,
   "text": "ندا داد می‌زنی از دور سلام فلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.77,
   "end": 731.85,
   "text": "یه حرفی که همه هم بشنون عیبی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 731.85,
   "end": 734.39,
   "text": "اما مناجات در گوشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 734.39,
   "end": 741.41,
   "text": "اگر میگه نمازگزار مناجات می‌کنه با پروردگارش در محراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 741.41,
   "end": 749.51,
   "text": "یعنی چ-- که چی؟ یعنی این دیگه انقدر نزدیک به حضرت حق شده درگوشی با خدا دارن با هم حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 749.51,
   "end": 754.91,
   "text": "این دیگه واقعاً جگرگوشه‌ی حق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.91,
   "end": 757.69,
   "text": "نماز، نماز، اهمیت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 757.69,
   "end": 759.87,
   "text": "که خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 759.87,
   "end": 766.83,
   "text": "آقای قاضی خیلی می‌فرمودن ما از آقای بهجت شنیدیم که فرمودن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.83,
   "end": 772.09,
   "text": "نماز اول وقتت همین نمازهای یومیه و واجباتت رو اول وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 772.09,
   "end": 774.81,
   "text": "بخون. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 774.81,
   "end": 779.85,
   "text": "آقا سید علی قاضی به تو قول میدم که تمام مشکلاتت برطرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.85,
   "end": 783.17,
   "text": "تو نمازت رو اول وقت به وقت بخون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 783.17,
   "end": 786.79,
   "text": "تمام مشکلات حل می‌شه. ما یه رفیقی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 786.79,
   "end": 792.39,
   "text": "شاید راضی نباشه اسمش رو می‌بریم آقای دکتر فلانی بعضی موقع‌ها به جای ما اینجا می‌اومد برای نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 792.39,
   "end": 796.51,
   "text": "ایشون عادت داره یه سجاده تو ماشینشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.51,
   "end": 799.05,
   "text": "هر جا تو بیابون، توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.05,
   "end": 801.89,
   "text": "بزرگراه هر جا یهو اذان بده می‌زنه بغل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 801.89,
   "end": 806.13,
   "text": "همون جا نمازشو بغل خیابون می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.13,
   "end": 810.19,
   "text": "الحمدلله من ندیدم مشکل خاصی تو زندگیش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 810.19,
   "end": 814.81,
   "text": "این نماز انشاالله یاد بگیریم و یاد بدیم به بچه‌هامون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 814.81,
   "end": 816.61,
   "text": "گره گشای همه‌ی اموره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.61,
   "end": 818.95,
   "text": "یاد خدا، ذکرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 818.95,
   "end": 824.47,
   "text": "حالا که به اینجا کشید این رو هم عرض کنم که شما حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.47,
   "end": 827.27,
   "text": "دقت بفرمایید صلاة یاد خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 827.27,
   "end": 832.09,
   "text": "درسته؟ اما باز به یاد خدا برید سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 832.09,
   "end": 834.93,
   "text": "صلاة. چرا میگه مقدمه بچین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 834.93,
   "end": 841.13,
   "text": "خدا رحمت کنه آقای توکل رو حدود بیست سال پیش محضرشون رسیدیم تو قم با بچه‌های هیتمون پرسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 841.13,
   "end": 845.19,
   "text": "این استاد اخلاق رو آقا ما چه کنیم تو نماز حواسمون جمع باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 845.19,
   "end": 851.17,
   "text": "فرمود نمی‌شه که شما صبح تا شب حواست پرت باشه یه دفعه بگی الله اکبر حواست جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 851.17,
   "end": 853.71,
   "text": "باید مراقبه داشته باشی، دائم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 853.71,
   "end": 856.75,
   "text": "دائم مراقبه داشته باشی تا تو نماز حواست جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 856.75,
   "end": 860.87,
   "text": "اتفاقاً آقای بهجت که می‌فرمود نماز نخوان کیف کنی حال کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 860.87,
   "end": 863.53,
   "text": "نماز بخون که حالت رو بسنجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 863.53,
   "end": 868.53,
   "text": "که حالت چگونه است. بیرون از نماز چگونه بودی تو نماز همونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 868.53,
   "end": 871.99,
   "text": "این میگه مقدمه بچین چند تا ذکر بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 871.99,
   "end": 876.35,
   "text": "\"إِنِّى وَجَّهْتُ وَجْهِىَ لِلَّذِى فَطَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا مُسْلِمًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 876.35,
   "end": 878.33,
   "text": "وَمَا أَنَا مِنَ الْمُشْرِكِينَ\" بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 878.33,
   "end": 881.59,
   "text": "\"إِنَّ صَلَاتِى وَنُسُكِى وَمَحْيَاىَ وَمَمَاتِى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 881.59,
   "end": 883.35,
   "text": "لِلَّهِ رَبِّ الْعَالَمِينَ\" بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 883.35,
   "end": 884.99,
   "text": "\"يا مُقِيلَ الْعَثَرات\" بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 884.99,
   "end": 889.09,
   "text": "به امام حسن توسل کن. \"السَّلامُ عَلَيْكَ حِينَ تُصَلِّى وَتَقْنُت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 889.09,
   "end": 891.51,
   "text": "سلام به ابی عبدالله بده. این مقدمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 891.51,
   "end": 896.87,
   "text": "چون آقا حضرت موسی علی نبی و آل و عليه الصلاة والسلام دل درد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 896.87,
   "end": 901.75,
   "text": "دل درد شدید و بعد خیلی حالش بد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 901.75,
   "end": 908.01,
   "text": "از خدا کمک خواست. خدا بهش الهام کرد برو فلان جا گیاه فلانو بگ-- حالا به قول ما دم‌نوشش کن بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 908.01,
   "end": 911.91,
   "text": "خورد و خوب شد. دفعه بعد یه مدتی گذشت دوباره دل درد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 911.91,
   "end": 918.57,
   "text": "رفت حضرت موسی همون گیاه رو گرفت دم‌نوشش کرد خورد خوب نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 918.57,
   "end": 920.61,
   "text": "بعد شکایت کرد به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 920.61,
   "end": 924.39,
   "text": "خدا فرمود دفعه پیش از من خواستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 924.39,
   "end": 926.47,
   "text": "از من خواستی من گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 926.47,
   "end": 930.21,
   "text": "یعنی اثرش در خواستنتو از من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 930.21,
   "end": 932.71,
   "text": "این دفعه از من نخواستی خودت رفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 932.71,
   "end": 934.85,
   "text": "اینه. این سر خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 934.85,
   "end": 937.09,
   "text": "البته نماز ذکرالله اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 937.09,
   "end": 939.93,
   "text": "با کمک از خدا برو به سمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 939.93,
   "end": 942.61,
   "text": "بعد اینجا خدا به حضرت موسی این جمله طلایی رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 942.61,
   "end": 945.97,
   "text": "فرمود دنیا همش زهر کشنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 945.97,
   "end": 949.49,
   "text": "پادزهر دنیا یاد منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 949.49,
   "end": 953.47,
   "text": "یاد من کن حتی با یاد من برو سمت نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
