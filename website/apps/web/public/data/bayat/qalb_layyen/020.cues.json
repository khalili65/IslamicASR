 "chapters": [
  {
   "index": 0,
   "title": "## مؤثر حقیقی در نرم‌شدن دل",
   "start": 19.8,
   "end": 84.68
  },
  {
   "index": 1,
   "title": "## احسن الحدیث و خشیت اهل ایمان",
   "start": 84.68,
   "end": 203.94
  },
  {
   "index": 2,
   "title": "## ذٰلک هدی الله؛ مرجع اشارت",
   "start": 203.94,
   "end": 436.01
  },
  {
   "index": 3,
   "title": "## هادی امت و ولایت",
   "start": 436.01,
   "end": 514.91
  },
  {
   "index": 4,
   "title": "## بیان علامه در المیزان",
   "start": 514.91,
   "end": 763.13
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 10.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.98,
   "end": 14.4,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.4,
   "end": 17.6,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.6,
   "end": 19.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.8,
   "end": 24.34,
   "text": "در بحث قلب اللعن یک بار دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.34,
   "end": 27.72,
   "text": "آیه رو قرائت کنیم. توجه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.72,
   "end": 31.78,
   "text": "منظورم از این قرائت اینه که خب چندین جلسه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.78,
   "end": 35.76,
   "text": "راه‌هایی که دل رو نرم می‌کنه گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.76,
   "end": 39.88,
   "text": "منتها توجه به این نکته است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.88,
   "end": 45.62,
   "text": "این کارها و این اسباب و این لوازم یک مؤثر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.62,
   "end": 47.48,
   "text": "که اثر رو اون می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.48,
   "end": 51.32,
   "text": "این رو باید خیلی توجه در حرکت توحیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.32,
   "end": 57.64,
   "text": "در نگاه توحیدی لا مؤثر فی الوجود الا الله تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.64,
   "end": 60.44,
   "text": "یعنی اگرم ما اعمالمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.44,
   "end": 65.36,
   "text": "اثری می‌کنه، تأثیری داره، همش کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.36,
   "end": 68.36,
   "text": "ما أصابک من حسنة فمن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.36,
   "end": 73.08,
   "text": "آنچه که به تو اصابت می‌کنه از حسنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.08,
   "end": 75.48,
   "text": "خیر و خوبی همش از الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.48,
   "end": 78.98,
   "text": "این نگاه توحیدی رو اگر ما نداشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.98,
   "end": 84.68,
   "text": "سرازیری میریم به سمت-- سرازیری می‌شیم به سمت جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.68,
   "end": 88.86,
   "text": "آیه بیست و سه سوره زمر بود الله نزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.86,
   "end": 97.96,
   "text": "احسن الحديث. اینجا قرآن خودش رو احسن الحديث معرفی کرده و خدا نازل کننده این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.96,
   "end": 101.1,
   "text": "الله نزل خداست که نازل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.1,
   "end": 103.52,
   "text": "کتاب، کتاب خداست. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.52,
   "end": 108.18,
   "text": "آدم همین، همین رو توجه بکنه که کتاب، کتاب خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.18,
   "end": 114.62,
   "text": "الله نزل. شما نسبت به اینکه آقا صاحب این کتاب کیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.62,
   "end": 118.86,
   "text": "چه کسی قلم زده، مؤلفش کیه، نسبت به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.86,
   "end": 121.82,
   "text": "وزانت اون شخص برای کتابش ارزش قائل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.82,
   "end": 125.38,
   "text": "حالا الله، الله نزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.38,
   "end": 128.8,
   "text": "اونم احسن الحديث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.8,
   "end": 132.42,
   "text": "الله اکبر. کتابم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.42,
   "end": 135.16,
   "text": "متشابهم مثانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.16,
   "end": 137.1,
   "text": "تقشعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.1,
   "end": 140.68,
   "text": "منه جلود الذين يخشون ربهم ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.68,
   "end": 143.18,
   "text": "تلين جلودهم وقلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.18,
   "end": 146.3,
   "text": "到 ذكر الله. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.3,
   "end": 150.08,
   "text": "عرض کردیم که این کتابیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.08,
   "end": 154.16,
   "text": "یه بلایی سر اهل ایمان میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.16,
   "end": 157.86,
   "text": "که تقشعر منه جلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.86,
   "end": 167.58,
   "text": "این جلشون رو، پوستشون رو یعنی ظاهرشون رو چنان در هم می‌ریزه، لرزش ایجاد می‌کنه درشون، یه حالت خشیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.58,
   "end": 170.48,
   "text": "يخشون ربهم از ترس پروردگارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.48,
   "end": 173.84,
   "text": "اون خشیت خدا که می‌گیرشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.84,
   "end": 176.86,
   "text": "لرزش در وجودشون ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.86,
   "end": 179.56,
   "text": "إذا زلزلت الأرض زلزالها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.56,
   "end": 182.08,
   "text": "این ارضه، این بدنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.08,
   "end": 188.46,
   "text": "وقتی می‌لرزه، لرزشی که کسی نمی‌تونه تصورش رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.46,
   "end": 193.5,
   "text": "بعد ثم تلين. حالا کی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.5,
   "end": 196.72,
   "text": "لرزش رو ایجاد کرد؟ يخشون ربهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.72,
   "end": 200.08,
   "text": "همش از پروردگارشونه، کار اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.08,
   "end": 203.78,
   "text": "ثم تلين جلودهم وقلوبهم 到 ذكر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.78,
   "end": 208.04,
   "text": "بعد اینا دو مرتبه از اون حالت برمی‌گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.04,
   "end": 211.84,
   "text": "هم جلو هم جلشون، جلودهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.84,
   "end": 214.54,
   "text": "و هم باطن‌شون و قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.54,
   "end": 217.66,
   "text": "اصلا قلب اللعن از اینجا دراومده که از این آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.66,
   "end": 220.6,
   "text": "از اینجا درآوردیم. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.6,
   "end": 224.54,
   "text": "دو مرتبه خدا یه کاری با اینا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.54,
   "end": 227.52,
   "text": "چرا؟ چون می‌فرماید 到 ذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.52,
   "end": 230.1,
   "text": "با ذ-- با یاد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.1,
   "end": 237.04,
   "text": "اینا، اون جلشون یعنی ظاهرشون، قلبشون هم که باطنه یعنی ظاهر و باطن‌شون تلين و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.04,
   "end": 240.66,
   "text": "نرم می‌شه، آرامش پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.66,
   "end": 242.84,
   "text": "آرامش دوباره به اینا برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.84,
   "end": 246.36,
   "text": "از اون لرزش و خشیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.36,
   "end": 250.26,
   "text": "برمی‌گردن به آرامش و سکینه قلبی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.26,
   "end": 253.0,
   "text": "حالا بحث ما اینجاست. ذلک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.0,
   "end": 256.16,
   "text": "یه سؤال می‌خوام مطرح کنم. ذلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.16,
   "end": 259.12,
   "text": "hudالله يهدي به من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.12,
   "end": 264.18,
   "text": "اون ذلک مثل اول سوره بقره می‌فرماید ذلک الكتاب لا ريب فيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.18,
   "end": 266.82,
   "text": "آن کتاب اشاره به دورم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.82,
   "end": 269.32,
   "text": "هذا الكتاب نه، آن کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.32,
   "end": 272.34,
   "text": "می‌فرماید ذلک hudالله يهدي به من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.34,
   "end": 277.08,
   "text": "آن هدایت خداست که هرکیو بخواد باهاش هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.08,
   "end": 279.84,
   "text": "برای خود من سؤال شد. همین امروز به این توجه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.84,
   "end": 284.2,
   "text": "خواستم پرونده قلب اللعن رو دیگه تو جمعمون جمع کنیم بریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.2,
   "end": 288.92,
   "text": "قلب جدید. گفتم یک بار دیگه آیه رو بخونم این به ذهنم متوالد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.92,
   "end": 291.66,
   "text": "این ذلک به کجا می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.66,
   "end": 293.76,
   "text": "آن هدایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.76,
   "end": 299.0,
   "text": "قرآن هدایت اینجا منظور اینجا قرآن که هدایت الهی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.0,
   "end": 302.44,
   "text": "خب اما منظور از این ذلک hudالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.44,
   "end": 311.74,
   "text": "اون هدایت خداست که هرکیو بخواد باهاش هدایت می‌کنه قرآنه یا این حالتیه که در اهل ایمان ایجاد می‌ک-می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.74,
   "end": 317.86,
   "text": "سؤاله دیگه. حالا شما تو ذهن خودتون ببینید می‌تونید اجتهاد کنید از ذهنتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.86,
   "end": 319.88,
   "text": "که بالاخره این ذلک به کجا می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.88,
   "end": 323.92,
   "text": "قرآن رو داره می‌گه که هرکیو بخواد باهاش هدایت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.92,
   "end": 330.2,
   "text": "یا این حالتی که الان گفتین از اون خشیت یهو میاره به حالت آرامش و نرمی دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.2,
   "end": 338.8,
   "text": "یا این هدایته که هرکیو بخواد هدایت کنه با این کار هدایتش می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.8,
   "end": 343.08,
   "text": "و من بررسی کردم. مفسرین مختلف رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.08,
   "end": 345.74,
   "text": "تفاسیر رو رجوع کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.74,
   "end": 348.4,
   "text": "دیدم عده‌ای معتقدند که این کتابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.4,
   "end": 351.6,
   "text": "قرآنه. بعضی از مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.6,
   "end": 357.26,
   "text": "معتقدند که این منظور همین ذلک می‌خوره به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.26,
   "end": 362.15,
   "text": "اما جالب بود برام که نظر علامه طباطبایی این نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.15,
   "end": 365.35,
   "text": "در المیزان نظر علامه طباطبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.35,
   "end": 370.63,
   "text": "این بود که این ذالکه می‌خوره به همین حالتی که در اهل ایمان ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.63,
   "end": 375.85,
   "text": "این هدایت الهیه. یعنی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.85,
   "end": 380.41,
   "text": "خود قرآن بسیاری رو به جهنم می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.41,
   "end": 383.95,
   "text": "خود قرآن. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.95,
   "end": 386.81,
   "text": "\"ولا يزيد الظالمين إلا خسارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.81,
   "end": 391.83,
   "text": "اهل ظلم از قرآن جز خسارت چیزی گیرشون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.83,
   "end": 395.29,
   "text": "عجب! برای مؤمنین رحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.29,
   "end": 400.17,
   "text": "شفاس. \"شفاء للما في الصدور\" اما برای اهل ظلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.17,
   "end": 403.81,
   "text": "\"ولا يزيد الظالمين إلا خسارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.81,
   "end": 406.49,
   "text": "اون حالت مهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.49,
   "end": 409.35,
   "text": "اون هدایته، اون حالتی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.35,
   "end": 412.43,
   "text": "اون نرمش قلبی‌ست که در درون ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.43,
   "end": 416.43,
   "text": "اون کار خداست. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.43,
   "end": 421.81,
   "text": "این که آدم صرفا قرآن بخونه که نمی‌شه بگیم این هدایت الهیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.81,
   "end": 425.27,
   "text": "خب اون کسی هم که رو سینه امام حسین نشست قرآن می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.27,
   "end": 426.97,
   "text": "خیلی‌هاشون حافظ قرآن بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.97,
   "end": 429.55,
   "text": "اما اون حالته، اون نرمشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.55,
   "end": 432.09,
   "text": "که از ولایت بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.09,
   "end": 436.01,
   "text": "مثلا اون آیه شریفه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.01,
   "end": 440.81,
   "text": "آیه هفت سوره رعد رو سریع من ذهنم رفت اونجا رفتم تفسیر اون رو هم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.81,
   "end": 443.55,
   "text": "\"انما انت منذر\" هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.55,
   "end": 446.61,
   "text": "خدا به پیغمبر فرمود فقط انذار دهنده تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.61,
   "end": 450.33,
   "text": "انما حصر دیگه. \"انما انت منذر\" انذار دهنده تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.33,
   "end": 453.45,
   "text": "\"ولكل قوم هاد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.45,
   "end": 459.09,
   "text": "برای همه قوم‌ها هم یه هادی، یه هدایتگری، هدایت کننده‌ای هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.09,
   "end": 462.63,
   "text": "بعد تفاسیر رو دیدم تفاسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.63,
   "end": 465.31,
   "text": "فرموده بودند که این هدایتگر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.31,
   "end": 467.45,
   "text": "هاد امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.45,
   "end": 476.53,
   "text": "مثلا امام ابن عباس روایت می‌کنه که وقتی این آیه نازل شد پیغمبر دست به سینه مبارکش گذاشت فرمود \"انا منذر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.53,
   "end": 480.31,
   "text": "بعد اشاره به شانه‌های مولا امیرالمؤمنین کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.31,
   "end": 483.59,
   "text": "فرمود \"انت الهادي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.59,
   "end": 486.35,
   "text": "بک يهتدى المهتدون بعدی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.35,
   "end": 488.79,
   "text": "به تو همه بعد از من هدایت می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.79,
   "end": 494.67,
   "text": "اون هدایتگر اصلا ولایت کلی الهی است که همش در مولا علی علیه الصلاة والسلام جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.67,
   "end": 498.29,
   "text": "یعنی قرآن بدون ولایت هم هدایت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.29,
   "end": 501.87,
   "text": "قرآنی هدایت داره که ولایت همراهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.87,
   "end": 504.83,
   "text": "ولایت از درونش می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.83,
   "end": 509.83,
   "text": "اصلا اون هدایته، اون حالتی که ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.83,
   "end": 517.05,
   "text": "حالا برای این که این رو خوب متوجه بشیم حوصله کنید من یه چند خط از فرمایش علامه طباطبایی رو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.05,
   "end": 519.61,
   "text": "البته وقتی به اینجا می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.61,
   "end": 522.89,
   "text": "داره همین آیه رو ذیل این آیه‌ای که الان خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.89,
   "end": 526.27,
   "text": "توضیح می‌ده. اشخاصی که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.27,
   "end": 530.75,
   "text": "کجاس این؟ خواستید ببینید ذیل آیه بیست و سه سوره زمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.75,
   "end": 538.15,
   "text": "در المیزان. اشخاصی که از مقام و عظمت پروردگارشان خشیت دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.15,
   "end": 550.15,
   "text": "همون \"يخشون ربهم\" با شنیدن آیات آن متوجه ساعت کبری و عظمت الهی شده، همون \"تخشعر منها جلود\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.15,
   "end": 552.55,
   "text": "و پوست بدنشان جمع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.55,
   "end": 561.99,
   "text": "می‌لرزند، می‌ترسند. ولی پس از مدتی بار دیگر پوست بدنشان نرم می‌گردد و دل‌هایشان آرامش می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 561.99,
   "end": 564.33,
   "text": "همون \"ثم تلين جلودهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.33,
   "end": 567.83,
   "text": "و قلوبهم\". خب تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.83,
   "end": 571.03,
   "text": "و دل‌هایشان آرامش می‌یابد چون به یاد خدا می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.03,
   "end": 575.13,
   "text": "چون می‌فرماید \"الى ذكر الله\" چون به یاد خدا می‌افتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.13,
   "end": 577.89,
   "text": "و همین یاد خدا، اینجا رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.89,
   "end": 583.95,
   "text": "علامه می‌فرماید و همین یاد خدا به آنها آرامش نفس و سکون می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.95,
   "end": 587.21,
   "text": "این حالت جمع شدن پوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.21,
   "end": 593.57,
   "text": "و سپس آرامشی که از یاد خدا به آنها دست می‌دهد هدایت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.57,
   "end": 595.99,
   "text": "پس اون ذالکه رو علامه زده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 595.99,
   "end": 599.13,
   "text": "به این حالت. این تیکش رو دوباره می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.13,
   "end": 602.19,
   "text": "این حالت جمع شدن پوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.19,
   "end": 606.99,
   "text": "و سپس آرامشی که از یاد خدا به آنها دست می‌دهد هدایت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.99,
   "end": 613.51,
   "text": "که فقط نصیب کسانی می‌شود که استعداد هدایت پذیری را در خود از بین نبرده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.51,
   "end": 615.95,
   "text": "و با اشتغال به امور چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 615.95,
   "end": 620.25,
   "text": "فسق و ظلم و معصیت مانع از هدایت خویش نشده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.25,
   "end": 625.79,
   "text": "این چنین افرادی هستند که خداوند به فضل خود اراده کرده و هدایت را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.79,
   "end": 629.13,
   "text": "شامل حالشان می‌نماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 629.13,
   "end": 631.45,
   "text": "این هدایت رو شامل حالشون می‌--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.45,
   "end": 634.77,
   "text": "\"انا هدينا الصراط المستقيم اما شاكرا واما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.77,
   "end": 636.79,
   "text": "كفورا\". ما هدایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.79,
   "end": 639.47,
   "text": "به شما می‌رسونیم. می‌خوای پس بزن، می‌خوای قبول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.47,
   "end": 643.27,
   "text": "اختیار با توه. اراده، اراده‌ش دست توه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.27,
   "end": 652.27,
   "text": "اینو دقت بکنید چقدر این اهمیت این رو داره می‌رسونه که این حالت نرم شدن قلب همون هدایت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.27,
   "end": 655.51,
   "text": "یعنی اگر کسی خلاصه اذیتتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.51,
   "end": 660.39,
   "text": "خلاصه امروز. اگر کسی دلش نرم نیست اولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.39,
   "end": 664.87,
   "text": "از شنیدن آیات الهی نمی‌لرزه، نمی‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.87,
   "end": 668.75,
   "text": "ذکر خدا که میاد خشیت بهش دست نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.75,
   "end": 671.11,
   "text": "ثانیا بعد از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.11,
   "end": 679.25,
   "text": "بعد از اینکه متذکر حضرت حق شد آیات رو شنید بر نمی‌گرده به حالت سکون، آرامش، سکینه، اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 679.25,
   "end": 685.05,
   "text": "اون نرمش قلب که نشانه رقت و نرمش قلب می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 685.05,
   "end": 687.81,
   "text": "می‌شه اشک. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 687.81,
   "end": 691.43,
   "text": "کسی که این حالت رو نداره هدایت رو پس داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.43,
   "end": 693.77,
   "text": "این خیلی ترس باید بترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 693.77,
   "end": 699.73,
   "text": "کسی که نرم نیست دلش. کسی که دلش نرم نیست قبلا گفتیم اشکش هم نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.73,
   "end": 704.47,
   "text": "اشک نماینده و نشانه رقت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 704.47,
   "end": 707.81,
   "text": "نرمی قلبه. قلب نرم شد اشک جاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 707.81,
   "end": 711.39,
   "text": "شما ببینید تمام اولیا بدون استثناء اشک عجیبی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.39,
   "end": 714.05,
   "text": "اشکشون به قول قدیمی‌ها دم مشکشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 714.05,
   "end": 716.57,
   "text": "خدا رحمت کنه آقای رئیسی رو دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 716.57,
   "end": 720.55,
   "text": "تو نماز مثلا حاج قاسم چه اشکی می‌ریخت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 720.55,
   "end": 722.99,
   "text": "اینایی که نزدیکش بودن اینا تعریف می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 722.99,
   "end": 727.63,
   "text": "می‌گن هر وقت که ما روضه می‌خوندیم اولین کسی که هه هه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 727.63,
   "end": 729.63,
   "text": "گریه‌ش بلند بود آقای رئیسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 729.63,
   "end": 732.79,
   "text": "اشکی که جاری می‌شه نشان دهنده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 732.79,
   "end": 735.41,
   "text": "نرمش قلبه. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 735.41,
   "end": 737.31,
   "text": "پس هدایت الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 737.31,
   "end": 741.89,
   "text": "این، این خیلی مهمه. لذا ما هر روز داریم تو نماز اینو می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 741.89,
   "end": 745.11,
   "text": "مثلا الان داریم می‌فهمیم هر روز تو نمازمون داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 745.11,
   "end": 749.39,
   "text": "به صورت واجب از خدا می‌خوایم دل ما رو نرم کن، دل ما رو نرم کن، دل ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 749.39,
   "end": 752.27,
   "text": "چرا؟ \"اهدنا الصراط المستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.27,
   "end": 755.45,
   "text": "این وادی ولایته. نرمی و رقت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 755.45,
   "end": 757.55,
   "text": "انشاالله که عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 757.55,
   "end": 760.57,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 760.57,
   "end": 763.13,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}