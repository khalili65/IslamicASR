 },
 "chapters": [
  {
   "index": 0,
   "title": "## دو روایت کوتاه پرمغز دربارهٔ رقت قلب",
   "start": 12.02,
   "end": 125.62
  },
  {
   "index": 1,
   "title": "## توجه به سیدالشهدا؛ سنگ و وحوش گریستند",
   "start": 125.62,
   "end": 211.78
  },
  {
   "index": 2,
   "title": "## خطر مصیبت‌خوانی و شنیدنِ بی‌توجه",
   "start": 211.78,
   "end": 422.92
  },
  {
   "index": 3,
   "title": "## هم‌وغم حفظ لین بودن قلب",
   "start": 422.92,
   "end": 522.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.96,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 7.78,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.78,
   "end": 12.02,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.02,
   "end": 15.32,
   "text": "در بحث قلب لعين یا لين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.32,
   "end": 16.98,
   "text": "دو تا روایت تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.98,
   "end": 21.44,
   "text": "خیلی شیرین، کوتاه، مختصر اما پرمغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.44,
   "end": 29.52,
   "text": "یکی در بحار جلد هفتاد، صفحه هشتاد و یک، پیامبر عظیم الشأن اسلام فرمودند أودو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.52,
   "end": 33.26,
   "text": "یعنی عادت بدید قلوبکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.26,
   "end": 36.04,
   "text": "این دل‌هاتون رو عادت بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.04,
   "end": 39.3,
   "text": "الرقة به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.3,
   "end": 42.1,
   "text": "رقیق بودن، به نرم بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.1,
   "end": 44.22,
   "text": "عادت بدید. أودو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.22,
   "end": 49.86,
   "text": "خب چی سبب این میشه که انسان عادت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.86,
   "end": 52.34,
   "text": "تکرار و ممارست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.34,
   "end": 56.8,
   "text": "تمرین، تکرار، پشت سر هم یه کاری رو انجام دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.8,
   "end": 59.6,
   "text": "اینکه هم‌غم‌ت اون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.6,
   "end": 63.06,
   "text": "یعنی هم‌غم‌ت این باشه که دلت نرم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.06,
   "end": 67.86,
   "text": "دومیش هم که در تصنیف غرر و درر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.86,
   "end": 74.82,
   "text": "مرحوم عاملیه، صفحه سیصد و بیست و پنج از مولامون علی علیه الصلاة و السلام که وا دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.82,
   "end": 77.52,
   "text": "قسوة بالرقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.52,
   "end": 80.1,
   "text": "فرمودن که این سنگی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.1,
   "end": 85.08,
   "text": "سختی دل رو زاد دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.08,
   "end": 89.64,
   "text": "یعنی با اون چیزی که ضدشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.64,
   "end": 92.2,
   "text": "به رقت وا بدارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.2,
   "end": 94.44,
   "text": "یعنی هر چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.44,
   "end": 96.36,
   "text": "ضد سنگدلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.36,
   "end": 100.24,
   "text": "ضد قساوت قلبه، زمختیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.24,
   "end": 104.56,
   "text": "اون رو بهش ممارست داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.56,
   "end": 108.88,
   "text": "باعث میشه که رفته رفته قلبتون نرم بشه، دلتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.88,
   "end": 112.3,
   "text": "لعين بشه. این دستور قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.3,
   "end": 117.06,
   "text": "که حالا اینکه انسان همش، غم‌ش این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.06,
   "end": 122.08,
   "text": "حتما به اون سمت بره، اینطوری نیست که دیگه یه کاری رو که دل رو نرم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.08,
   "end": 125.62,
   "text": "و ما چند تاشو مثال زدیم یه بار انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.62,
   "end": 128.58,
   "text": "یکی از مهم‌ترین چیزهایی که اصلا خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.58,
   "end": 133.18,
   "text": "قلب رو به شدت نرم می‌کنه، سخت‌ترین قلب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.18,
   "end": 137.88,
   "text": "نرم می‌کنه، توجه به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.88,
   "end": 141.2,
   "text": "دقت بفرمایید مخصوصا کلمه توجه رو به کار می‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.2,
   "end": 146.08,
   "text": "توجه به سید الشهدا و مصائب ایشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.08,
   "end": 148.22,
   "text": "که گفتن سنگ رو می‌جوشونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.22,
   "end": 151.42,
   "text": "چگونه‌ست که سنگ جوشید، سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.42,
   "end": 154.16,
   "text": "گریه کرد. حدیث داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.16,
   "end": 160.6,
   "text": "وحوش گریه کردن. دل ما وحشی‌تر از وحوش شده، سنگ‌تر از سنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.6,
   "end": 165.0,
   "text": "این فرمودن که اصلا اشک، یعنی انسان همش این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.0,
   "end": 167.2,
   "text": "حالا نه یه بار بره حالا یا خب یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.2,
   "end": 169.04,
   "text": "بله اثرش رو داره حتی یه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.04,
   "end": 170.98,
   "text": "اما عادت بده به خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.98,
   "end": 175.08,
   "text": "اینجا فرمایش امیرالمؤمنین رو عادت دادن به این اموره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.08,
   "end": 183.32,
   "text": "هرچی که ما عرض کردیم از فرمایش بزرگان که این‌ها سبب نرمی دل میشه رو عادت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.32,
   "end": 185.7,
   "text": "عادت کنه برای امام حسین گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.7,
   "end": 187.52,
   "text": "اصلا هیئت هفتگی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.52,
   "end": 190.4,
   "text": "شما دقت کنید عزیزان که هیئت هفتگی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.4,
   "end": 194.84,
   "text": "خوش اشک‌ترن تا اونایی که فقط محرم میان هیئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.84,
   "end": 198.4,
   "text": "اینو شما خـ تو خودت یا دیگران می‌بینی، ملاحظه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.4,
   "end": 204.92,
   "text": "چرا؟ چون عادت کرده. کسی که شبای جمعه قطعاً میره در خونه خود عادت میده خودشو به کمیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.92,
   "end": 209.34,
   "text": "به اشک و انابه راحت‌تر گریه می‌کنه تا دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.34,
   "end": 211.78,
   "text": "البته همراه با آدابش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.78,
   "end": 218.58,
   "text": "مثلاً اگه کسی عادت بکنه مصیبت بخونه بدون توجه، ببینید مخصوصا توجه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.58,
   "end": 221.18,
   "text": "توجه عرفانی رو به کار بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.18,
   "end": 224.86,
   "text": "مثلاً مداح‌هایی که بدون توجه مداحی می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.86,
   "end": 227.5,
   "text": "مثل نوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.5,
   "end": 232.58,
   "text": "مثلاً یه زباط یعنی که ضبط کردن playشو می‌زنی شروع می‌کنه و قطع می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.58,
   "end": 238.0,
   "text": "اینطوری عادت کرده. آقا بخون بسم الله الرحمن، یا رحمان همینطوری می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.0,
   "end": 241.3,
   "text": "اصلا نه دلش آماده‌ست نه، نه مقدمه نه هیچی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.3,
   "end": 244.86,
   "text": "این خطرناکه. این سخت-- اتفاقا برعکس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.86,
   "end": 246.64,
   "text": "سنگی و سختی دل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.64,
   "end": 249.42,
   "text": "رقت قلب رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.42,
   "end": 255.9,
   "text": "اینایی که عادت می‌کنن همش مصیبت بخونن بدون سوز، بدون آه، بدون توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.9,
   "end": 261.8,
   "text": "یا بشنون. مثلا داره می-- هر و کر می‌خنده در حال رانندگی، در حال غذا خوردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.8,
   "end": 264.54,
   "text": "مصیبت سنگین و کشف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.54,
   "end": 266.78,
   "text": "قتلگاه رو گذاشته داره نوارشو گوش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.78,
   "end": 270.78,
   "text": "اینا سنگی دل میاره. برعکس عمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.78,
   "end": 275.46,
   "text": "اما اگر توجه همراه با توجه باشه هرچی بیشتر بگریه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.46,
   "end": 281.78,
   "text": "مولا فرمود دیگه أودو عادت بدید قلوبکم رقة دل‌هاتون رو به رقت عادت بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.78,
   "end": 287.56,
   "text": "یعنی تمرین کنید. یه سری کارها هست اصلا برعکس عمل می‌کنه، دل رو سنگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.56,
   "end": 290.76,
   "text": "حتی از کار، کار، شغل، حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.76,
   "end": 293.3,
   "text": "می‌دونستید اینا رو؟ شما برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.3,
   "end": 302.62,
   "text": "مکاسب مرحوم شیخ انصاری رو بخونید که قدیم‌ها خدا رحمت کنه آیت الله مجتهدی تهرانی رو می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.62,
   "end": 306.52,
   "text": "چرا حوزه‌های علمیه قدیم‌ها معمولا تو بازارها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.52,
   "end": 311.24,
   "text": "چون کاسب‌ها اول می‌رفتن یه دونه مکاسب می‌گرفتن پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.24,
   "end": 314.78,
   "text": "اون مثلا حوزه علمیه، پیش استادشون، پیش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.78,
   "end": 317.2,
   "text": "حالا اون شیخشون اینا بعد می‌رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.2,
   "end": 319.92,
   "text": "سراغ کسب. الان اصلا این حرفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.92,
   "end": 323.9,
   "text": "اون اول کتاب مکاسب شیخ انصاری میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.9,
   "end": 330.5,
   "text": "شغل‌ها و حرفه‌ها، کارها، کسب‌هایی که حرامن، حلالن، مستحبن، مکروهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.5,
   "end": 336.2,
   "text": "یک یک می‌شماره. یه سری شغل‌ها هست اصلا سنگی دل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.2,
   "end": 339.2,
   "text": "اونا کراهت دارن. مثلا قصابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.2,
   "end": 341.72,
   "text": "کسی که اصلا شغلش قصابیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.72,
   "end": 345.06,
   "text": "یا شغلش ذبح گوسفنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.06,
   "end": 351.52,
   "text": "خوب نیست، کراهت داره. حالا البته فرمودن اگر کسی مجبوره، هیچ چاره‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.52,
   "end": 354.7,
   "text": "ها؟ هیچ حرفه دیگه‌ای بلد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.7,
   "end": 357.06,
   "text": "فرمودن جبرانی براش بذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.06,
   "end": 358.9,
   "text": "مثلا زیاد قرآن بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.9,
   "end": 361.38,
   "text": "نماز اول وقتشو فراموش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.38,
   "end": 364.14,
   "text": "هیئت بره سعی کنه با اشک و آه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.14,
   "end": 366.48,
   "text": "قصابی کراهت میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.48,
   "end": 368.5,
   "text": "کراهت داره. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.5,
   "end": 370.96,
   "text": "دل رو سنگ میکنه. یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.96,
   "end": 375.26,
   "text": "آرایشگری، اصطلاحاً سلمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.26,
   "end": 380.94,
   "text": "کارش این باشه که از ته ریش رو بتراشه چون داره فعل حرام انجام میده اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.94,
   "end": 383.42,
   "text": "اصلاً اون پولی هم که حتی میگیره اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.42,
   "end": 388.78,
   "text": "قاطی شده، اون پول دیگه، اون پولی که بابت تراشیدن ریش از ته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.78,
   "end": 393.88,
   "text": "میگیره حرامه. اون پول حرامه چون کارو-- فعل حرام انجام داد گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.88,
   "end": 401.46,
   "text": "لذا بزرگان قدیم ما که پول تو دست و بال مردم بود، پول رد و بدل میشد مثل الان کارت الکتر-الکترونیکی نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.46,
   "end": 404.4,
   "text": "چیکار می‌کردن؟ می‌گفت آقا رفتی سلمونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.4,
   "end": 407.94,
   "text": "یه طوری پول بده که دیگه نخوای ازش پول پس بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.94,
   "end": 412.6,
   "text": "که اون پوله اون که مثلاً ریش تراشیده اون قاطی نشه با اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.6,
   "end": 416.0,
   "text": "رعایت‌ها رو، مواظبت‌ها رو داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.0,
   "end": 420.68,
   "text": "خب کس که اینو رعایت نکنه یا مثلاً مرده‌شوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.68,
   "end": 425.88,
   "text": "مرده‌شوری، شستن میت تا هفت تا بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.88,
   "end": 430.18,
   "text": "روایت وارد نشده که آقا شما بیشتر از هفت تا بشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.18,
   "end": 432.06,
   "text": "نه، تا هفت تا خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.06,
   "end": 434.08,
   "text": "انسان هفت تا مرده رو بشوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.08,
   "end": 436.42,
   "text": "اینا که تنوع خاطر پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.42,
   "end": 440.84,
   "text": "اما مرده‌شور هی میشوره، هی میشوره، صبح تا شب میشوره بگه دیگه نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.84,
   "end": 446.92,
   "text": "اصلاً عادت کرده. میره بغل میت هم همینطور داره غذا میخوره و آب میخوره، می‌گه و می‌خنده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.92,
   "end": 450.84,
   "text": "این قساوت قلب میاره. خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.84,
   "end": 454.0,
   "text": "طلافروشی برای مردها کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.0,
   "end": 456.5,
   "text": "انقدر چون طلا بیشتر زن‌ها می‌خرن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.5,
   "end": 460.56,
   "text": "این مجبوره-- اصلاً هر شغلی که بیشتر با زن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.56,
   "end": 467.3,
   "text": "سروکار داره. اینایی که الان لوازم آرایشی می‌فروشن، خب قطعاً زن‌ها بیشتر، زن‌ها میان میش-می‌خرن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.3,
   "end": 469.5,
   "text": "نمی‌دونم رنگ مو، وسایل آرایشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.5,
   "end": 478.26,
   "text": "خب این کراهت داره چون ارتباط زیاد با نامحرم قلب رو می‌میرونه، قلب قساوت پیدا می‌کنه و از اون نرمیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.26,
   "end": 482.64,
   "text": "خارج می‌شه. و خلاصه می‌تونید اونجا برید ملاحظه کنید و ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.64,
   "end": 485.3,
   "text": "این‌ها رو تا می‌شه انس-انسان باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.3,
   "end": 487.3,
   "text": "رعایت کنه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 487.3,
   "end": 489.48,
   "text": "انشاالله عرض کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.48,
   "end": 493.78,
   "text": "اِممم ف-- اینجا فرمایش امیرالمؤمنین و پیغمبر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.78,
   "end": 497.68,
   "text": "بر عادت دادن دل به این اموره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.68,
   "end": 500.72,
   "text": "یعنی سعی کنه به گونه‌ای باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.72,
   "end": 504.98,
   "text": "عرض کردیم حتی مداحی اگه شغلش باشه خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.98,
   "end": 507.74,
   "text": "آقا مداحیه به اون شکل تصنعی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.74,
   "end": 512.22,
   "text": "عادت کنه به اینکه اون حالت رقت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.22,
   "end": 516.24,
   "text": "نرمی دل و لعين بودن قلب رو برای خودش حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 516.24,
   "end": 518.44,
   "text": "یعنی هم و غمش این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 518.44,
   "end": 522.02,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}