 },
 "chapters": [
  {
   "index": 0,
   "title": "## احراز عدالتِ امام جماعت",
   "start": 0.3,
   "end": 112.32
  },
  {
   "index": 1,
   "title": "## قلبِ لیّن؛ لغت و آیه",
   "start": 112.32,
   "end": 200.48
  },
  {
   "index": 2,
   "title": "## متشابه؛ خودِ کلمه نیز متشابه است",
   "start": 200.48,
   "end": 281.68
  },
  {
   "index": 3,
   "title": "## مثانی؛ عطف و گرایشِ آیات",
   "start": 281.68,
   "end": 695.69
  },
  {
   "index": 4,
   "title": "## معرفت نفس از آیه؛ ذو مراتب بودن انسان",
   "start": 695.69,
   "end": 802.63
  },
  {
   "index": 5,
   "title": "## قوس نزول و قوس صعود",
   "start": 802.63,
   "end": 854.35
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 11.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.34,
   "end": 15.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.24,
   "end": 20.34,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.34,
   "end": 23.88,
   "text": "ما به هر کسی نمی‌تونیم نماز رو اقتدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.88,
   "end": 27.2,
   "text": "انقدر که نماز مهمه حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.2,
   "end": 31.38,
   "text": "یکی از شروط اینه که امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.38,
   "end": 34.44,
   "text": "برای ما عدالتش احراز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.44,
   "end": 38.9,
   "text": "محرز باید بشه. همینطوری نیست به هر کسی اقتدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.9,
   "end": 41.72,
   "text": "باید عدالت محرز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.72,
   "end": 46.22,
   "text": "حالا راه‌های احراز عدالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.22,
   "end": 51.26,
   "text": "متفاوته. بعضیا گفتن خب رفتی یه مسجدی، یه نمازخونه‌ای دیدی یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.26,
   "end": 54.04,
   "text": "وایستاده جلوش اون که نمی‌شناسیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.04,
   "end": 57.18,
   "text": "چگونه احراز کنم؟ گفتن هم اینکه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.18,
   "end": 64.52,
   "text": "جماعتی از اهل ایمان که مورد وثوقن می‌دونی ظاهر الصلاة و این‌ها به ایشون اقتدا کردن این خودش راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.52,
   "end": 71.06,
   "text": "احراز عدالته. و عدالت هم معناش این نیستش که واقعاً اون عدالت محضه‌ای که به دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.06,
   "end": 74.96,
   "text": "حجت الله می‌خواد پیاده بشه نه اون که هیچکس نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.96,
   "end": 80.72,
   "text": "منظور اینه که فرمودن منظور از این عدالت اینجا اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.72,
   "end": 83.92,
   "text": "گناهی ازش نبینی، از اون امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.92,
   "end": 87.4,
   "text": "حالا سؤال آره از امام معصوم که همه نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.4,
   "end": 93.16,
   "text": "حالا یه خطاییه مخصوصا رفیق ما که امام جماعت یه اون باهاش بالاخره یه خطایی ازش می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.16,
   "end": 95.46,
   "text": "اینطوری نیستش که نبینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.46,
   "end": 98.86,
   "text": "همه از هم خطا و گناه می‌بینیم پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.86,
   "end": 102.26,
   "text": "فرمودن اصرار بر گناه نباید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.26,
   "end": 105.38,
   "text": "حالا یه گناهی یه وقت ازش دیدی خب توبه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.38,
   "end": 109.88,
   "text": "شاید توبه کرده چه می‌دونی؟ اصرار بر گناه نباید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.88,
   "end": 114.36,
   "text": "پافشاری بر گناه. در خصوص قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.36,
   "end": 117.08,
   "text": "نرم یا لَین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.08,
   "end": 119.36,
   "text": "یا لَین اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.36,
   "end": 122.3,
   "text": "لَین باشه همون به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.3,
   "end": 125.62,
   "text": "نرم جمعش می‌شه لَینون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.62,
   "end": 131.68,
   "text": "اگر لَین باشه تشدید نداره‌ها چون تشدید داشته باشه لَيِّن امر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.68,
   "end": 136.36,
   "text": "یعنی نرم کن. لَین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.36,
   "end": 140.54,
   "text": "که باز به معنای منعطف، آرام، نرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.54,
   "end": 145.44,
   "text": "هستش. اینم باز اگه اینطوری باشه جمعش می‌شه لَيِّنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.44,
   "end": 147.4,
   "text": "در چه آیه از آیات قرآن اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.4,
   "end": 149.48,
   "text": "آیه بیست و سه سوره زمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.48,
   "end": 154.08,
   "text": "الله نزل، خدا، الله نازل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.08,
   "end": 156.9,
   "text": "چی رو؟ أحسن الحديث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.9,
   "end": 161.58,
   "text": "خیلی شیرینه آیه. قرآن رو اسمشو اینجا می‌ذاره أحسن الحديث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.58,
   "end": 164.44,
   "text": "یکی از اسامی قرآن أحسن الحديثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.44,
   "end": 168.74,
   "text": "حدیث اصلاً یعنی نو. حرفیه که همیشه نوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.74,
   "end": 174.46,
   "text": "هیچ‌وقت کهنه نمی‌شه. أحسن اونم أحسن الحديث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.46,
   "end": 178.16,
   "text": "حرف نوئی‌ست که از همه بهتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.16,
   "end": 183.82,
   "text": "نیکوتره. خیلی قشنگه اسم قرآن اینجا أحسن الحديث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.82,
   "end": 187.56,
   "text": "یعنی اصلاً هیچکس نمی‌تونه اینطوری حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.56,
   "end": 192.32,
   "text": "هیچکس احدی نمی‌تونه مثل قرآن حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.32,
   "end": 195.06,
   "text": "و کتابم متشابهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.06,
   "end": 197.22,
   "text": "داره خودش، خودش رو معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.22,
   "end": 200.26,
   "text": "کتابی‌ست که متشابهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.26,
   "end": 203.84,
   "text": "حالا در خصوص این تشابه در تفسیر نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.84,
   "end": 208.42,
   "text": "آقای قرائتی خدا حفظشون کنه می‌فرمود که خود این کلمه متشابه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.42,
   "end": 211.6,
   "text": "متشابه‌ست. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.6,
   "end": 217.64,
   "text": "یعنی اینکه یا اینکه صفت بر بعض از آیات قرآن می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.64,
   "end": 222.56,
   "text": "چون بعض از آیات قرآن متشابهن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.56,
   "end": 226.54,
   "text": "چند وجهین. یعنی چند بعد دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.54,
   "end": 229.4,
   "text": "وجوه متعدد دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.4,
   "end": 234.68,
   "text": "و در برابر آیات محکم‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.68,
   "end": 237.2,
   "text": "یعنی مثلا شما میگی ید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.2,
   "end": 238.88,
   "text": "فوق، فوق أیدیهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.88,
   "end": 243.14,
   "text": "خب مگه خدا دست داره؟ ببین آدم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.14,
   "end": 245.92,
   "text": "منحرف از تو می‌کنه ظاهرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.92,
   "end": 249.42,
   "text": "این باید وجهش بیان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.42,
   "end": 252.02,
   "text": "اینجا می‌شه صفت برای بعضی از آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.02,
   "end": 256.62,
   "text": "چون همه آیات که از این حیث متشابه نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.62,
   "end": 259.94,
   "text": "أقم الصلاة لذکری محکمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.94,
   "end": 263.56,
   "text": "متشابه نیست، محکمه. نمازو بخون برای ذکر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.56,
   "end": 266.74,
   "text": "حالا بعد آقای قرائتی می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.74,
   "end": 274.22,
   "text": "اگر بگیم صفت برای همه آیاته یعنی همه آیات دارای فصاحت‌اند، بلاغت‌اند، معجزه الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.22,
   "end": 279.7,
   "text": "در هر حال متشابه باز خودش متشابهه یعنی وجوه متعدد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.7,
   "end": 286.8,
   "text": "مثانیه‌ند. مثانی از خب مثنی که می‌گن یعنی دو، عدد دو، ثنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.8,
   "end": 291.02,
   "text": "ثنان اینا. اصلاً یعنی عطف بر هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.02,
   "end": 294.0,
   "text": "در تفسیر مجمع البیان می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.0,
   "end": 297.56,
   "text": "این مثانی‌ای که اینجا آورده رو می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.56,
   "end": 300.42,
   "text": "فَ، فَنِیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.42,
   "end": 303.02,
   "text": "فَنِیه با سه تا نقطه‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.02,
   "end": 305.5,
   "text": "ریشه. که اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.5,
   "end": 312.02,
   "text": "این رو بخواهیم بیان کنیم از این ریشه می‌شه همون معنای عطف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.02,
   "end": 316.38,
   "text": "مثلاً ثنان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.38,
   "end": 319.18,
   "text": "مرحوم طباطبایی می‌فرمود از این جهت بهش می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.18,
   "end": 321.86,
   "text": "ثنان از ریشه فَنِیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.86,
   "end": 324.8,
   "text": "اینجام تو قرآن می‌گه مثانی. چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.8,
   "end": 326.88,
   "text": "یکی عطف بر دیگری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.88,
   "end": 329.46,
   "text": "می‌شه دو. ثنان یعنی دو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.46,
   "end": 333.6,
   "text": "یا مثلاً خود ایشون مثال می‌زنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.6,
   "end": 339.42,
   "text": "ثناگویی، ثناگویی رو چرا بهش می‌گن ثناگویی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.42,
   "end": 342.4,
   "text": "به جهت اینکه در مدح کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.4,
   "end": 345.52,
   "text": "صفات نیک طرف به هم عطف می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.52,
   "end": 348.46,
   "text": "یا استثناء. استثناء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.46,
   "end": 352.86,
   "text": "مستثنی به مستثنی منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.86,
   "end": 358.36,
   "text": "عطف می‌شه. یعنی چون معنای عطف داره بهش می‌گن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.36,
   "end": 361.3,
   "text": "مست-- استثناء. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.3,
   "end": 364.36,
   "text": "مثلاً ثنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.36,
   "end": 370.17,
   "text": "و امثالهم. که حالا مثانی که تو این آیه اومده جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.17,
   "end": 375.97,
   "text": "اِمم مسنیه که به معنی منعطفه که یعنی آیات قرآن به هم گرایش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.97,
   "end": 378.89,
   "text": "یه معناش اینه. آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.89,
   "end": 383.39,
   "text": "به هم گرایش دارن. همه‌شون انگار دارن یک حرفو می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.39,
   "end": 388.07,
   "text": "این توضیح اونه، اون شرح اینه، این متن اونه، این فرع اونه، اون اصل اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.07,
   "end": 390.81,
   "text": "به این شکل. حالا بریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.81,
   "end": 394.61,
   "text": "تخ-تخ شعر منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.61,
   "end": 397.67,
   "text": "تخ شعر منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.67,
   "end": 401.49,
   "text": "یعنی یه حالت لرزشی از اون ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.49,
   "end": 405.95,
   "text": "از چی؟ از همین کتاب احسن الحديث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.95,
   "end": 408.01,
   "text": "لرزش ایجاد می‌شه. کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.01,
   "end": 411.87,
   "text": "تو کجا ایجاد می‌شه؟ جلود الذی نخشعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.87,
   "end": 414.01,
   "text": "اونم نه همه ها. یخشعون ربهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.01,
   "end": 417.41,
   "text": "اون کسایی که حالت خشیت از خداشون دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.41,
   "end": 421.21,
   "text": "جلشون می‌لرزه. جلود جمع جلد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.21,
   "end": 423.91,
   "text": "جلد چیه؟ می‌گیم جلد کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.91,
   "end": 428.53,
   "text": "یعنی اون پوستش. پوستشون می‌لرزه عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.53,
   "end": 431.03,
   "text": "چه ربطی داره به پوست لرزیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.03,
   "end": 433.97,
   "text": "اتفاقا در تفسیر اهل بیت می‌دیدم جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.97,
   "end": 436.25,
   "text": "سیزده، صفحه دویست و بیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.25,
   "end": 439.03,
   "text": "در بهار هم جلد شصت و هفت، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.03,
   "end": 445.05,
   "text": "سیصد و چهل و شش هست. ذیل همین آیه از پیغمبر عزیز عالم روایت آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.05,
   "end": 450.41,
   "text": "پیغمبر فرمودن \"اِذَا شَعَرَ جِلْدُ الْعَبْدِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.41,
   "end": 453.81,
   "text": "وقتی پوست بنده می‌لرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.81,
   "end": 455.93,
   "text": "\"مِنْ خَشِيَّةِ اللَّهِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.93,
   "end": 458.53,
   "text": "از چی می‌لرزه؟ از خشیت الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.53,
   "end": 461.07,
   "text": "از خش-- از اون مقام خشیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.07,
   "end": 464.39,
   "text": "خشیت مقام باطنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.39,
   "end": 466.29,
   "text": "خضوع مقام ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.29,
   "end": 470.89,
   "text": "شما خیلی مؤدب بایستید سر پایین، دست پایین بگن خاضع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.89,
   "end": 475.49,
   "text": "خاضعانه. اما خشوع مرتبه باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.49,
   "end": 478.53,
   "text": "حالا الان عرض می‌کنم چه ازش بیرون میاد خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.53,
   "end": 483.01,
   "text": "خب اینجا پیغمبر فرموده که وقتی این حالت پیش میاد \"تحاتت\" اینم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.01,
   "end": 487.05,
   "text": "مجرده. کسایی که این حالتو دارن قرآن می‌خونن این حالت براشون پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.05,
   "end": 491.25,
   "text": "نمی‌دونم اصن پیش میاد برا ما؟ \"تحاتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.25,
   "end": 494.91,
   "text": "مِنْهُ ذُنُوبُهْ كَمَا تَحَ-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.91,
   "end": 498.31,
   "text": "تَتَحَطُّ عَنِ الشَّجَرَةِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.31,
   "end": 501.85,
   "text": "الْيَابِسَةِ وَرَقُهَا\" چه جوری یه درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.85,
   "end": 504.87,
   "text": "ریزش که می‌کنه پاییز همه برگا می‌ریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.87,
   "end": 510.23,
   "text": "همینطوری. مثاله. پیغمبر تلک الامثال-امثال ندر به الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.23,
   "end": 513.67,
   "text": "پیغمبر داره مثل می‌زنه که ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.67,
   "end": 517.99,
   "text": "مثل ریزش برگ درختان وقتی اون بدن طرف از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.99,
   "end": 521.29,
   "text": "شنیدن آیات قرآن از خشیت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 521.29,
   "end": 526.67,
   "text": "می‌لرزه، گناهاش همینجوری می‌ریزه همش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.67,
   "end": 529.57,
   "text": "و اونایی که احساس سنگینی گناه می‌کنن راهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 529.57,
   "end": 531.75,
   "text": "پیغمبر به اون سیزده تا جوون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.75,
   "end": 535.43,
   "text": "فرمود قرآن بخونید. نشستن گفت نه، نه، نه اینطوری نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.43,
   "end": 537.59,
   "text": "یه طوری بخون که گریه‌تون بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.59,
   "end": 543.97,
   "text": "بارها عرض کردیم این روایتو. یکی یکی خوندن تا گریه نکردن پیغمبر اجازه نداد رد شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.97,
   "end": 547.99,
   "text": "مثلا دیدی جلسات قرآن دور می‌شینن می‌گفت حالا نوبت شما، نوبت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.99,
   "end": 551.97,
   "text": "هر کدوم که به گریه می‌افتادن پیغمبر می‌گفت حالا نوبت بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.97,
   "end": 554.05,
   "text": "اون آخریه بیچاره هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.05,
   "end": 558.05,
   "text": "زور زد که گریه‌ش بگیره، گریه‌ش نگرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.05,
   "end": 560.35,
   "text": "پیغمبر گفت باز بخون. نشد. باز بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.35,
   "end": 562.29,
   "text": "چند بار هی خوند نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 562.29,
   "end": 566.65,
   "text": "فرمود سعی کن به جایی برسونی خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.65,
   "end": 571.27,
   "text": "سعی کن به جایی برسونی که با گریه و حزن و اندوه این، این حالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.27,
   "end": 573.71,
   "text": "اصن آیا باید این چنین بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.71,
   "end": 577.49,
   "text": "اگه کسی دنبال اینه که همه گناهاش بریزه راهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.49,
   "end": 579.81,
   "text": "حالا اینجا یه سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.81,
   "end": 584.41,
   "text": "می‌گه که خشیت الله از خشیت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 584.41,
   "end": 587.85,
   "text": "اونم تنشون می‌لرزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.85,
   "end": 592.11,
   "text": "جسمشون می‌لرزه، پوست بدنشون، جلشون می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.11,
   "end": 596.23,
   "text": "خشیت مقام باطنه که چه ربطی داره به پوست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.23,
   "end": 601.09,
   "text": "حالا ما داریم مقدمه‌چینی می‌کنیم دیگه امروز نمی‌رسیم البته وقتمون دیگه تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 601.09,
   "end": 603.23,
   "text": "مقدمه‌چینی می‌کنیم برای چی؟ قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 603.23,
   "end": 606.33,
   "text": "نرم که اونو توضیح بدیم. چه ربطی به اون داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 606.33,
   "end": 609.39,
   "text": "حالا بالاخره باید مقدمه‌چینی کنیم تا به حقیقت برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 609.39,
   "end": 614.79,
   "text": "تو یه دفعه کل مثلا پسته هم می‌خوای بخوری اول باید پوستشو بکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 614.79,
   "end": 622.43,
   "text": "پوستشو نوازش کنی، ناخن ناز-نازنینتو بندازی لاش فشار بدی زحمت بکشی تا به اون مغز برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.43,
   "end": 626.11,
   "text": "یا نمی‌تونید الان بخورید، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 626.11,
   "end": 630.11,
   "text": "گردو مثلا. بالاخره باید بشکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.11,
   "end": 632.89,
   "text": "بله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 632.89,
   "end": 639.59,
   "text": "عرض شود خدمتتون که این اتفاقا نکته خیلی شریفی ازش داره میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 639.59,
   "end": 642.37,
   "text": "من خیلی بهش فکر می‌کردم چقدر جالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 642.37,
   "end": 648.43,
   "text": "رابطه‌ی بین ظاهر و باطن رو خیلی زیبا این آیه داره تشریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.43,
   "end": 655.95,
   "text": "الان من می‌گم که حضرت آقا مثلا اگه آقا محسن اینجا نشسته، خب الان می‌گم آقا محسن آیا فقط بدنشو دارم می‌گم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.95,
   "end": 658.85,
   "text": "یعنی بدن منهای روحشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.85,
   "end": 661.85,
   "text": "ظاهرش منهای باطنشه؟ یا می‌گم روحشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.85,
   "end": 664.55,
   "text": "مثلا می‌گم آقا محسن منظور من روحشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.55,
   "end": 667.53,
   "text": "منهای بدنشه؟ اصن تفکیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.53,
   "end": 671.33,
   "text": "تو ذهن شما نیست اصن. می‌گی آقا محسن، آقا محسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.33,
   "end": 675.35,
   "text": "به ما و به ما. همین آقایی که هست با تمام قوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.35,
   "end": 678.93,
   "text": "یعنی ظاهر و باطن. یعنی پوست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.93,
   "end": 684.29,
   "text": "جلد و گوشت و خون و رو همینطور بگو برو تا قوّه‌ی خیال و ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.29,
   "end": 692.11,
   "text": "وهم و عقل و قلب و روح و سر و خفی و اخفا رو برو تا اون کانال وجودش که مرتبطه به حضرت حق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 692.11,
   "end": 695.69,
   "text": "توجه کردید؟ اینا یک وجود واحدن و مرتبط با همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.69,
   "end": 699.03,
   "text": "این نکته آخر رو خوب توجه کنید دارم جمعش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.03,
   "end": 701.33,
   "text": "خیلی خوبه آدم اینو-- معرفت نفسه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 701.33,
   "end": 703.67,
   "text": "از این آیه معرفت نفس درومده بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.67,
   "end": 705.69,
   "text": "نشون می‌ده که انسان ذو مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.69,
   "end": 709.31,
   "text": "ذات مراتبه. شؤون متعدد و مختلف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.31,
   "end": 713.15,
   "text": "سؤال: چرا وقتی که یه دفعه می‌ترسی دهنت خشک می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 713.15,
   "end": 714.69,
   "text": "دهنت مرتبه نازله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 714.69,
   "end": 717.65,
   "text": "بدنه. ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 717.65,
   "end": 720.15,
   "text": "ترس مال ظاهر نیست که. مال بدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 720.15,
   "end": 724.59,
   "text": "بدن نمی‌لرزه که. نفست می‌لرزه، می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.59,
   "end": 727.37,
   "text": "خوف بهش دست می‌ده. چرا دهنت خشک می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 727.37,
   "end": 729.79,
   "text": "چرا وقتی یه دفعه یه چیز عجیبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 729.79,
   "end": 732.71,
   "text": "تعجب‌آوری می‌بینی چشات باز می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.71,
   "end": 735.37,
   "text": "یا نه بد-- مو به تنت سیخ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 735.37,
   "end": 738.51,
   "text": "چه ربطی داره؟ این ظاهره، اون باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 738.51,
   "end": 742.89,
   "text": "یا به عکسش. یه ضربه‌ای به بدنت می‌خوره، به روحت که نخورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 742.89,
   "end": 747.13,
   "text": "دندون درد داری. هرچی رفیق میاد سلام احوال شما، می‌گی برو غصه اصن برو غصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 747.13,
   "end": 750.65,
   "text": "حوصله ندارم یا مثلاً که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 750.65,
   "end": 752.93,
   "text": "وقتی که بدنت سالمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 752.93,
   "end": 755.33,
   "text": "خیلی راحت مطالعه می‌کنی، نماز بهت حال میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 755.33,
   "end": 758.09,
   "text": "ولی وقتی مثلاً سردرد داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 758.09,
   "end": 761.05,
   "text": "اصلاً کتاب رو میذاری کنار میگی نمی‌تونم کتاب بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.05,
   "end": 764.67,
   "text": "خب کتاب مال فهم باطنه که باطنت می‌خواد بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 764.67,
   "end": 769.33,
   "text": "چه ربطی به ظاهرت داره که سردرد می‌کنی، سرت درد می‌کنه مال ظاهرته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 769.33,
   "end": 772.11,
   "text": "چرا نمی‌تونه باطنت هم مرتبط بشه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 772.11,
   "end": 775.31,
   "text": "اون فهم، فهمو بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.31,
   "end": 777.69,
   "text": "چون اینا با هم یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 777.69,
   "end": 782.47,
   "text": "ذات مراتب. یعنی ما یک وجود واحدیم، ذات مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 782.47,
   "end": 789.05,
   "text": "اصلاً عالم این‌چنینه. عالم عوالم، ذات مراتب، مراتب متعدد، عوالم متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 789.05,
   "end": 791.95,
   "text": "ما هم این‌چنین خود حضرت حق هم این‌چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 791.95,
   "end": 796.01,
   "text": "یه ذات غیب الغیوب ظهور کرده همین‌جوری ظهور، ظهور، ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 796.01,
   "end": 798.25,
   "text": "در قوس ظ-- در قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 798.25,
   "end": 802.63,
   "text": "امروز درس نود و یکه مثل آقا اون سر تعلّامه رو گوش دادم خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 802.63,
   "end": 805.71,
   "text": "در قوس نزول که همه تشریف فرما شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 805.71,
   "end": 811.31,
   "text": "سلطان اون نزول قوس النزول انا لله سلطانش اسم ابواهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 811.31,
   "end": 813.25,
   "text": "همه چیز ظاهر میشه. این بچه کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 813.25,
   "end": 816.45,
   "text": "کجا بود؟ این بچه کجا بود؟ این جنین کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 816.45,
   "end": 818.87,
   "text": "ظهور کرده هی داره هی ظا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 818.87,
   "end": 823.57,
   "text": "ظهورش هم شدت می‌گیره. حالا در قوس صعود که الان همه تشریف دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 823.57,
   "end": 827.71,
   "text": "اینجا سلطان چیه؟ سلطنت با اسم الباطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 827.71,
   "end": 830.23,
   "text": "همه داریم میریم به سمت باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 830.23,
   "end": 834.13,
   "text": "الان کشن اموات ما؟ تا دیروز بغل ما بودن، کجان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 834.13,
   "end": 838.45,
   "text": "در باطن عالمن. اصلاً مرگ یعنی این، سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 838.45,
   "end": 843.17,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 843.17,
   "end": 854.35,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}