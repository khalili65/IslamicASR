 "chapters": [
  {
   "index": 0,
   "title": "## پیگیری بحث غربت لین؛ خلوص و نرمی دل",
   "start": 14.5,
   "end": 47.68
  },
  {
   "index": 1,
   "title": "## دعای جامع زمان غیبت",
   "start": 47.68,
   "end": 67.92
  },
  {
   "index": 2,
   "title": "## واستعملنی بطاعتک",
   "start": 67.92,
   "end": 218.34
  },
  {
   "index": 3,
   "title": "## ادعاهای بزرگ و شرط نرمی دل",
   "start": 218.34,
   "end": 238.52
  },
  {
   "index": 4,
   "title": "## دعای حضرت زهرا؛ واستعملنی لما خلقتنی له",
   "start": 238.52,
   "end": 574.32
  },
  {
   "index": 5,
   "title": "## روایت امام سجاد به ابوخالد کابلی",
   "start": 574.32,
   "end": 858.8
  },
  {
   "index": 6,
   "title": "## انتظار فرج از اعظم فرج",
   "start": 858.8,
   "end": 944.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 3.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.9,
   "end": 7.94,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.94,
   "end": 13.04,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 21.34,
   "text": "اجازه بفرمایید که بحث دیروز غرب اللن رو که وسط بحث رهاش کردیم رو تکمیلش کنیم توی بحث خلوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.34,
   "end": 25.54,
   "text": "که یکی از راه‌های و کارکردهای خلوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.54,
   "end": 33.86,
   "text": "در حقیقت کارکرد خلوص میشه نرمی دل و از بهترین راه‌های نرم شدن دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.86,
   "end": 39.2,
   "text": "خلوص هست. این رو تموم کنیم حالا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.2,
   "end": 41.52,
   "text": "صد کلمه در معرفت نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.52,
   "end": 46.98,
   "text": "موقتا جا به جا کنیم برای چهارشنبه‌ها که مسجد بلال هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.98,
   "end": 51.08,
   "text": "ما رسیدیم به این قطعه از دعای شریف جامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.08,
   "end": 55.08,
   "text": "زمان غیبت. دعای جامع در زمان غیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.08,
   "end": 61.64,
   "text": "که گفتیم طولانیه. اللهم عرفنی نفسك فإنك إن لم تعرف نفسك شروع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.64,
   "end": 65.2,
   "text": "تا بیست و دو بند داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.2,
   "end": 71.14,
   "text": "و در یک بخشش به خدا عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.14,
   "end": 76.52,
   "text": "اللهم فثبتنی علی دینک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.52,
   "end": 79.82,
   "text": "خدایا پس منو ثابت قدم بدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.82,
   "end": 83.06,
   "text": "در دینت که یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.06,
   "end": 86.42,
   "text": "ادعیه است. مخصوصا این دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.42,
   "end": 89.18,
   "text": "در خصوص آخرالزمان خیلی سفارش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.18,
   "end": 96.86,
   "text": "دعای غریق که شنیدید یا الله، یا رحمن، یا رحیم، یا مقلب القلوب ثبت قلبی علی دینک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.86,
   "end": 100.46,
   "text": "این دیگه مخصوصا این ایام دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.46,
   "end": 103.22,
   "text": "از بهترین دعاهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.22,
   "end": 107.56,
   "text": "چون یک آن می‌بینید دین و دنیای آدم رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.56,
   "end": 110.38,
   "text": "حالا دنیا رفت، رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.38,
   "end": 113.58,
   "text": "میشه برگردونیم اما دین رفت دیگه کار خیلی دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.58,
   "end": 117.1,
   "text": "چون شما به کسی که خیانت در امانت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.1,
   "end": 120.38,
   "text": "هیچوقت دیگه بار دوم هیچی دیگه نمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.38,
   "end": 126.92,
   "text": "هم که بنده خیانت کنه در امانت، امانت هم که ولایت است، دین الهی است این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.92,
   "end": 134.02,
   "text": "سخت میشه کار. بعد عرض می‌کنیم که واستعملنی بطاعتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.02,
   "end": 136.04,
   "text": "چقدر این قسمت شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.04,
   "end": 139.9,
   "text": "ما رو به عمل وا بدار مشغول چی کن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.9,
   "end": 143.24,
   "text": "بطاعتك مشغول اطاعت تو باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.24,
   "end": 146.24,
   "text": "بعد عرض می‌کنیم ولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.24,
   "end": 150.24,
   "text": "قلبی لولی امرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.24,
   "end": 153.42,
   "text": "دل ما رو نرم کن برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.42,
   "end": 155.76,
   "text": "ولی امرت، برای امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.76,
   "end": 159.8,
   "text": "خیلی مهمه انسان دلش نرم باشه برای امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.8,
   "end": 165.3,
   "text": "خیلیا هستن متاسفانه تا اسم امام عصر میاد حالشون بد میشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.3,
   "end": 168.3,
   "text": "اصلا آدم‌های مذهبی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.3,
   "end": 170.26,
   "text": "این‌ها رو می‌بینن حالشون بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.26,
   "end": 172.72,
   "text": "حالا یه وقت هست بین خودمون هم این پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.72,
   "end": 177.56,
   "text": "انقدر متاسفانه اینایی که ریش تو صورتشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.56,
   "end": 181.22,
   "text": "مثل من یقه بستن و چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.22,
   "end": 187.58,
   "text": "جانماز آب می‌کشن خیانت به انقلاب و دین می‌کنن که آدم یه وقت می‌بینه از این طرفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.58,
   "end": 192.58,
   "text": "مثلا می‌ترسه اصلاً از چهره‌های مذهبی می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.58,
   "end": 200.12,
   "text": "ها؟ این، این حالا خب هست بالاخره به جهت متاسفانه خیانت که از صدر اسلام تا حالا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.12,
   "end": 202.02,
   "text": "اما نه این قصه‌ش چیز دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.02,
   "end": 204.7,
   "text": "اینکه اصلاً کلاً مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.7,
   "end": 207.4,
   "text": "از بردن نام مقدسات اینا بدش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.4,
   "end": 209.9,
   "text": "این متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.9,
   "end": 213.7,
   "text": "خیلی خطرناکه و بچه‌های ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.7,
   "end": 220.14,
   "text": "متاسفانه گرفتار کرده. می‌فرماید که اگر ببینید متن دعا رو که داریم می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.14,
   "end": 225.2,
   "text": "کاملاً داره مشخص می‌کنه که اگر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.2,
   "end": 227.22,
   "text": "به کار گرفته شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.22,
   "end": 230.36,
   "text": "در مسیر اطاعت الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.36,
   "end": 235.7,
   "text": "در مسیر اطاعت فرامین الهی قرار گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.7,
   "end": 238.52,
   "text": "ولین قلبی لولی امرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.52,
   "end": 241.1,
   "text": "دیگه دل نرم میشه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.1,
   "end": 244.84,
   "text": "خدمت به امام عصر. بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.84,
   "end": 246.98,
   "text": "هی ادعا می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.98,
   "end": 250.22,
   "text": "امام عصر رو برسه ما در خدمتش باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.22,
   "end": 255.18,
   "text": "اللهم اجعلنی من انصاره و اعوانه و الزابین عنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.18,
   "end": 267.6,
   "text": "اوف، اوف، اوف. و المسارعين الیه فی قضايا حوائجه و الممتثلین باوامره و المحامين عنه و السابقين، السابقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.6,
   "end": 271.42,
   "text": "الى ارادته. اوف، اوف چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.42,
   "end": 275.4,
   "text": "ادعاها. و المستشهدين بین یدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.4,
   "end": 280.06,
   "text": "تو آغوش آقا جون بدی مگه شوخیه آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.06,
   "end": 284.56,
   "text": "قویس قرنی باید باشی تو آغوش امیرالمؤمنین جون بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.56,
   "end": 286.66,
   "text": "این ادعاها خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.66,
   "end": 291.5,
   "text": "هیچ راهی جز این نیست که دل نرم بشه نسبت به ولی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.5,
   "end": 294.08,
   "text": "دل اگر نرم نشه، حالا راهش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.08,
   "end": 296.92,
   "text": "داریم خودمون رو هی اذیت می‌کنیم، شما رو اذیت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.92,
   "end": 304.4,
   "text": "خلوص. اصلاً نمیشه به جز خلوص اصلاً این غلطه بگیم یکی از راه ها نه اصلاً به جز خلوص نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.4,
   "end": 307.38,
   "text": "به جا، به جز خشیت که جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.38,
   "end": 309.54,
   "text": "دو سه جلسه قبل عرض کردیم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.54,
   "end": 313.5,
   "text": "اینا تنها راهن، شاه راهن و تنها راهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.5,
   "end": 315.88,
   "text": "صراط مستقیم‌اند به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.88,
   "end": 318.02,
   "text": "به جز خلوص اصلاً فایده‌ای نداره، نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.02,
   "end": 324.22,
   "text": "چقدر زیباست که من وقتی این قسمت دعا رو داشتم دقت می‌کردم یادم افتاد فرمایش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.22,
   "end": 326.84,
   "text": "دعای خاص حضرت زهرا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.84,
   "end": 329.56,
   "text": "این دعایی که خیلی بزرگان سفارش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.56,
   "end": 335.34,
   "text": "حضرت زهرا یه جمله دعاش می‌ارزه به همه عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.34,
   "end": 337.42,
   "text": "حضرت زهرا واستعملنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.42,
   "end": 340.1,
   "text": "به، به، به. واستعملنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.1,
   "end": 342.64,
   "text": "لما خلقتنی له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.64,
   "end": 346.06,
   "text": "خدایا منو به جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.06,
   "end": 349.88,
   "text": "به کار بگیر، در جایی به کار بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.88,
   "end": 353.78,
   "text": "واستعملنی. من عمله تو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.78,
   "end": 356.12,
   "text": "ها؟ در خدمت تو باشم. واستعملنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.12,
   "end": 359.24,
   "text": "منو به کار بگیر. کجا به کار بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.24,
   "end": 364.0,
   "text": "واستعملنی لما خلقتنی له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.0,
   "end": 366.18,
   "text": "اون جایی که منو براش خلق کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.18,
   "end": 369.66,
   "text": "مگه برای چی خلق کردی؟ خدا چرا منو خلق کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.66,
   "end": 375.1,
   "text": "ها؟ تو آیات قول کنی \"و ما خلقت الجن والانس الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.1,
   "end": 380.54,
   "text": "ليعبدون\". همه مفسرین امامیه فرمودن ای ليعرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.54,
   "end": 384.32,
   "text": "یعنی اصلا ما رو خلق کرده، خلق نکرده مگر برای عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.32,
   "end": 386.7,
   "text": "عبادت چیه؟ فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.7,
   "end": 390.2,
   "text": "عرفان، معرفت، شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.2,
   "end": 392.52,
   "text": "کنت کنزا مخفیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.52,
   "end": 394.58,
   "text": "فاحببت ان اعرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.58,
   "end": 397.52,
   "text": "فخلقت الخلق لکی اعرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.52,
   "end": 402.72,
   "text": "خدا فرمود من گنج مخفی بودم، دوست داشتم شناخته بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.72,
   "end": 404.82,
   "text": "خ- دست به خلقت زدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.82,
   "end": 408.02,
   "text": "تا شناخته بشم. یعنی اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.02,
   "end": 411.82,
   "text": "فلسفه خلقت شناخت خداست، معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.82,
   "end": 416.14,
   "text": "با دیده عقلی، با تفکر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.14,
   "end": 422.7,
   "text": "کلمات وجودی نظام هستی، سیر آفاقی و انفسی که یکیش خود ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.7,
   "end": 425.44,
   "text": "چقدر این دعا زیباست، دعای حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.44,
   "end": 432.48,
   "text": "حالا به اون شکل هم توی اون دعای جامعه زمان غیبت اومده \"و استعملنی\" دو تا هست یکی اونجا حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.48,
   "end": 437.26,
   "text": "\"و استعملنی لما خلقتنی له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.26,
   "end": 441.58,
   "text": "که اتفاقا هی ما میگیم تقوا، تقوا، تقوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.58,
   "end": 443.22,
   "text": "یعنی رعایت حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.22,
   "end": 450.96,
   "text": "به قول حضرت علامه جوادی آملی حفظه الله تعالی اینکه بگیم تقوا یعنی فقط گناه نکنیم غلطه، نصفه نیمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.96,
   "end": 454.42,
   "text": "تقوا یعنی رعایت همه حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.42,
   "end": 457.62,
   "text": "اعم از انجام واجبات، ترک محرمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.62,
   "end": 463.54,
   "text": "اتفاقا آیه دویست و هشتاد و دو بقره رو وقتی دقت کنیم انتهاش می فرماید \"واتق الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.54,
   "end": 466.18,
   "text": "تقوا رعایت حدود الهی رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.18,
   "end": 470.6,
   "text": "بعد چه اتفاقی میفته؟ \"و يعلمكم الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.6,
   "end": 478.92,
   "text": "به به، به به. مثل عسل دوست دارم بخورم این آیه رو \"و يعلمكم الله و الله بكل شيء عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.92,
   "end": 482.48,
   "text": "اون کسی که خودش معلم همه عالمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.48,
   "end": 484.34,
   "text": "اصلا علم به یک معنا خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.34,
   "end": 487.42,
   "text": "خود حضرت حقه. چون علم عین ذات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.42,
   "end": 491.62,
   "text": "اصلا علم یعنی خدا. اون میگه در اگر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.62,
   "end": 494.72,
   "text": "در مسیر اطاعت من بودی یعنی تقوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.72,
   "end": 499.06,
   "text": "\"يعلمكم الله\" اون موقع همون الله شما رو تعلیم میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.06,
   "end": 501.5,
   "text": "اصلا راه رسیدن به علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.5,
   "end": 504.36,
   "text": "یعنی تقوا. یعنی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.36,
   "end": 508.0,
   "text": "طاعت الهی که ما برای اون خلق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.0,
   "end": 510.48,
   "text": "این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.48,
   "end": 515.14,
   "text": "مسیری که انسان رو میرسونه به حجت خدا با دل نرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.14,
   "end": 517.54,
   "text": "اصطلاحا بهش میگیم خلوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.54,
   "end": 524.9,
   "text": "نه برای دنیا، منفعت دنیا حتی برای رسیدن به مقامات و مدارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.9,
   "end": 527.42,
   "text": "بندگی کردن که به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.42,
   "end": 533.46,
   "text": "آقای مص-- آ حضرت آقای جوادی آملی حفظ-- حفظه الله تعالی فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.46,
   "end": 536.74,
   "text": "آقا چهله اربعین کلیمی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.74,
   "end": 540.7,
   "text": "موسوی میگیری؟ خوب، خوب بگیر برای لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 540.7,
   "end": 544.76,
   "text": "چرا میگیری حتی برای رسیدن به مثلا مدارج معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.76,
   "end": 548.34,
   "text": "اونم خوب اما بالاتر لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.34,
   "end": 552.14,
   "text": "این خیلی قشنگ تریکه. اینکه تو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.14,
   "end": 557.42,
   "text": "صرفا به عشق خدا مثل اون که دیروز عرض کردیم دو رکعت نماز بخونی بگی خدایا دلم برات تنگ شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.42,
   "end": 559.48,
   "text": "هیچی هم نمیخوام فقط دلم برات تنگ شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.48,
   "end": 563.1,
   "text": "این یعنی خلوص. اخلاصم رد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.1,
   "end": 567.82,
   "text": "شدت خلوصه. اینا تو دعاها و رد فاهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.82,
   "end": 572.66,
   "text": "میرسه به جایی که دل نرم میشه و در خدمت حجت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.66,
   "end": 575.98,
   "text": "با ادعا که نمیشه بگه من در خدمت امام عصرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.98,
   "end": 578.36,
   "text": "امام عصر تشریف بیارید بنده علمدار شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.36,
   "end": 581.88,
   "text": "این حرفا چیه؟ با ادعا که نمیشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.88,
   "end": 585.82,
   "text": "اجازه بدید که در انتهای بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.82,
   "end": 593.56,
   "text": "این روایت شریف رو طولانیه یه بخشیش رو عرض کنم از کتاب شریف بهار جلد پنجاه و دو، صفحه صد و بیست و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.56,
   "end": 597.08,
   "text": "کمال الدین مرحوم شیخ صدوق هم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.08,
   "end": 603.1,
   "text": "یه روایت شیرینیه که امام سجاد سلام الله علیه به ابو خالد کابلی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.1,
   "end": 605.86,
   "text": "یا أبا خالد در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.86,
   "end": 610.04,
   "text": "اینایی که ادعای مهدویت دارن، یکیش خود من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.04,
   "end": 612.82,
   "text": "خب ببینیم اینا مشخصه هاشون چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.82,
   "end": 615.14,
   "text": "اصلا بحث اخلاص رو توش آقا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.14,
   "end": 618.94,
   "text": "بحث عقل و فکر و معرفت رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.94,
   "end": 621.84,
   "text": "ببینید یا أبا خالد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.84,
   "end": 624.24,
   "text": "فکر کنید الان امام زمان داره به من و شما میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.24,
   "end": 627.28,
   "text": "ها؟ کلهن نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.28,
   "end": 633.24,
   "text": "من نور واحد میگه \"إن أهل زمان غیبته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.24,
   "end": 637.38,
   "text": "قطعا اهل زمان غیبت پسر ما مهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.38,
   "end": 641.76,
   "text": "\"القائلین بإمامته\" اینا قائل به امامتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.76,
   "end": 645.66,
   "text": "قائلن نه یعنی فقط قبول دارنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.66,
   "end": 648.62,
   "text": "اینکه اعتقاده. قائل یعنی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.62,
   "end": 651.72,
   "text": "میگه هی بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.72,
   "end": 654.08,
   "text": "\"والمنتظرین لظهوره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 654.08,
   "end": 656.32,
   "text": "اینا برای ظهور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 656.32,
   "end": 659.0,
   "text": "ظهور حضرت انتظار میکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.0,
   "end": 664.1,
   "text": "خب حالا اینا کیان؟ \"أفضل من أهل کل زمان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.1,
   "end": 666.88,
   "text": "عجب! از اهل همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.88,
   "end": 670.22,
   "text": "زمان‌ها، هر زمانی که بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.22,
   "end": 674.36,
   "text": "افضلن. به خاطر همون خصوصیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 674.36,
   "end": 677.16,
   "text": "دیگه چی؟ خیلی زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.16,
   "end": 680.88,
   "text": "به به. \"لأن الله\" چرا اینا به اینجا رسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 680.88,
   "end": 684.2,
   "text": "چرا افضل شدن؟ برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 684.2,
   "end": 690.84,
   "text": "خدا \"لأن الله تبارك وتعالى أعطاهم\" خدا بهشون عطا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.84,
   "end": 694.7,
   "text": "چی؟ به نظر شما چی عطا کرد خدا به اینا که افضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.7,
   "end": 698.54,
   "text": "همه زمان‌ها شدن؟ منتظرین امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.54,
   "end": 701.9,
   "text": "چی بهشون داده؟ ماشین شاسی بلند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 701.9,
   "end": 705.36,
   "text": "پنت هاوس، مدیریت فلان جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 705.36,
   "end": 708.78,
   "text": "اسم و رسم و مدرک تحصیلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 708.78,
   "end": 711.82,
   "text": "اصل و نسب و این اعتباریات دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 711.82,
   "end": 713.94,
   "text": "نه خیر. فرمود \"أعطاهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 713.94,
   "end": 718.28,
   "text": "سه تا چیز داده \"من العقول والأفهام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 718.28,
   "end": 720.6,
   "text": "والمعرفة\". به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.6,
   "end": 724.36,
   "text": "بحث عقلو میکشه وسط. فهمو میکشه وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 724.36,
   "end": 728.64,
   "text": "و معرفت رو که الان بحثشو کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 728.64,
   "end": 732.78,
   "text": "خب ما سارت به الغیبه عندهم بمنزلة المشاهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 732.78,
   "end": 735.66,
   "text": "این باعث شده که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 735.66,
   "end": 739.22,
   "text": "غیبت و حضور امام عصر براشون یکی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 739.22,
   "end": 741.44,
   "text": "یعنی الان عصر غیبته، درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 741.44,
   "end": 744.04,
   "text": "اما کأنه آقا هست برای اینا آقا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 744.04,
   "end": 746.58,
   "text": "کی گفته غائبه؟ حاضره آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 746.58,
   "end": 751.1,
   "text": "یعنی اینطوری انگار که واقعاً حضرت هست و به هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 751.1,
   "end": 753.32,
   "text": "الله اکبر. این ارزش چی رو میرسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 753.32,
   "end": 758.08,
   "text": "اون اعطای الهی که عقل و فهم و معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 758.08,
   "end": 769.96,
   "text": "خب این تا کجا میره؟ وجعلهم فی ذلک الزمان بمنزلة المجاهدین بین یدی رسول الله صلی الله علیه و آله و سلم بالسيف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.96,
   "end": 778.56,
   "text": "اج-- اینا رو خدا یه طوری قرار میده، یه طوری بالا میکشه به منزله اون کسایی که با شمشیر در رکاب پیغمبر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 778.56,
   "end": 784.34,
   "text": "کم کسایی نبودن اینا کل کفر در برابرشون صف آرا-- صف آرایی کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 784.34,
   "end": 787.62,
   "text": "خب به به، به به. ببینید چقدر شیرین میشه هی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 787.62,
   "end": 791.1,
   "text": "عسل ناب میشه هی. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 791.1,
   "end": 795.82,
   "text": "تا اینجا که رسید فرمود اولئک المخلصون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 795.82,
   "end": 799.0,
   "text": "به به، مخلص هم نه، مخلص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 799.0,
   "end": 803.12,
   "text": "فرق مخلص و مخلص رو رهبر عزیرمون یه روز فرمودن تو سخنرانی هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 803.12,
   "end": 806.2,
   "text": "مخلص برای خاطر خدا کار میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 806.2,
   "end": 810.46,
   "text": "اما توقع پاداش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 810.46,
   "end": 815.74,
   "text": "اما مخلص برای خاطر خدا کار میکنه هیچ توقعی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 815.74,
   "end": 821.02,
   "text": "توجه کنید فرقشه. می فرماید اولئک المخلصون حقاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 821.02,
   "end": 824.28,
   "text": "حقاً اینا انت ولينا حقاً که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.28,
   "end": 828.18,
   "text": "حضرت به عبدالعظیم حسنی فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 828.18,
   "end": 834.04,
   "text": "اولئک المخلصون حقاً و شيعتنا صدقا صادقانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 834.04,
   "end": 836.92,
   "text": "شیعه ما شدند. و الدعاه الی دین الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 836.92,
   "end": 840.34,
   "text": "همش دعوت به سمت دین خدا می کنن، نه به خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 840.34,
   "end": 843.22,
   "text": "پس دعوت به خود ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 843.22,
   "end": 847.3,
   "text": "الی دین الله عز و جل سرا و جهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 847.3,
   "end": 851.24,
   "text": "چه در علن، چه در خفا و پنهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 851.24,
   "end": 853.14,
   "text": "اینا مشغول دعوت به سمت خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 853.14,
   "end": 857.94,
   "text": "یعنی حتی در خفا و پنهانی هم خودشون رو دائماً نفس خودشون رو دعوت می کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 857.94,
   "end": 864.28,
   "text": "به چقدر زیباست و قال عليه السلام انتظار الفرج یعنی فرج اینطوری، انتظار این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 864.28,
   "end": 867.96,
   "text": "این جور، این نوع انتظار فرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 867.96,
   "end": 870.12,
   "text": "من اعظم الفرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 870.12,
   "end": 874.42,
   "text": "الله اکبر از بالاترین فرج‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 874.42,
   "end": 878.18,
   "text": "یعنی کسی اینطوری بود اصلاً فرج حاصل شده براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 878.18,
   "end": 880.68,
   "text": "فرج فردی رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 880.68,
   "end": 885.84,
   "text": "اون که میاد توئیت میکنه یا مقاله میده که آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 885.84,
   "end": 892.64,
   "text": "مثلاً سا-- رسانه پر شده از کارشناسای بیسواد میان میگن فرج فردی داریم، فرج اجتماعی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 892.64,
   "end": 894.24,
   "text": "تو بیسوادی که نمی فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 894.24,
   "end": 896.98,
   "text": "اینا از تو دل روایات میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 896.98,
   "end": 901.52,
   "text": "فرج مگه حاصل شده الان؟ فرج قطعی اجتماعی و جمعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 901.52,
   "end": 906.64,
   "text": "اون فرج نهایی، نه. پس چطوری اینجا داره می فرمود اینها، این اشخاص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 906.64,
   "end": 909.62,
   "text": "اینا اعظم فرج رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 909.62,
   "end": 913.64,
   "text": "ها؟ به اعظم فرج رسیدن بر وزن افعل یعنی بالاتر از این فرج نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 913.64,
   "end": 916.62,
   "text": "یعنی فرج فردی. یعنی اصل اصلاً اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 916.62,
   "end": 919.52,
   "text": "مسیرش از اینه. هیچ راهی جز این نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 919.52,
   "end": 921.76,
   "text": "و خدا باید به ما عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 921.76,
   "end": 925.48,
   "text": "فهم و معرفت رو عطا کنه که به خلوص برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 925.48,
   "end": 928.14,
   "text": "نتیجه‌ش بشه قلب نرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 928.14,
   "end": 930.76,
   "text": "در خدمت حضرت ولی عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 930.76,
   "end": 933.22,
   "text": "سلام الله علیه سرش صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 933.22,
   "end": 936.3,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 936.3,
   "end": 940.24,
   "text": "محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 940.24,
   "end": 944.36,
   "text": "قرآن رو هم هر کی دوست داره بشینه با هم بخونیم. صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}