   "title": "## سکوت و نرمی دل",
   "start": 1.14,
   "end": 50.2
  },
  {
   "index": 1,
   "title": "## برکات سکوت در کلام امام صادق",
   "start": 50.2,
   "end": 329.38
  },
  {
   "index": 2,
   "title": "## زوال قساوت قلب",
   "start": 329.38,
   "end": 364.02
  },
  {
   "index": 3,
   "title": "## مکاشفه‌ی علامه در کتاب انسان در عرف عرفان",
   "start": 364.02,
   "end": 989.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.14,
   "end": 7.06,
   "text": "السلام علیک یا داعی الله و ربانیة آiate.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.06,
   "end": 9.98,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.98,
   "end": 13.44,
   "text": "در خصوص قلب لنگ یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.44,
   "end": 18.5,
   "text": "قلب نرم نکته‌ی دیگری رو هم عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.5,
   "end": 24.78,
   "text": "این‌هایی که می‌گیم مهمات دیگه و الا چیزهای دیگه‌ای هم هست که قلب رو نرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.78,
   "end": 28.7,
   "text": "یکی از مهم‌ترین چیزهایی که قلب رو نرم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.7,
   "end": 32.58,
   "text": "سکوته. اصمت با صاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.58,
   "end": 36.06,
   "text": "اصمت، سکوت موجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.06,
   "end": 40.98,
   "text": "نرمی دل هست. کتاب مصباح الشریعه رو قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.98,
   "end": 46.74,
   "text": "ملاحظه فرمودید که منتسب هست به آقا امام صادق صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.74,
   "end": 49.44,
   "text": "کتاب خیلی شیرین و عالی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.44,
   "end": 52.3,
   "text": "روایاتی رو در حوزه‌های مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.3,
   "end": 55.86,
   "text": "از لسان امام صادق سلام الله علیه اونجا بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.86,
   "end": 59.54,
   "text": "در صفحه صد و یک یه روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.54,
   "end": 63.88,
   "text": "مبسوطی رو آورده که یک بخشی از این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.88,
   "end": 70.0,
   "text": "تصریح امام صادق، این امام به حق ناطق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.0,
   "end": 73.42,
   "text": "سلام الله علیه در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.42,
   "end": 78.98,
   "text": "رفع و ازاله قلب از قساوت‌ه به جهت سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.98,
   "end": 84.98,
   "text": "وقتی حضرت بحث اصمت رو یعنی سکوت رو معرفی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.98,
   "end": 87.86,
   "text": "می‌فرماید و هو مفتاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.86,
   "end": 92.58,
   "text": "کل راحت من الدنیا والآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.58,
   "end": 95.62,
   "text": "هرکی می‌خواد تو دنیا و آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.62,
   "end": 98.64,
   "text": "کلید راحتی دستش باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.64,
   "end": 102.9,
   "text": "راحت باشه. راحت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.9,
   "end": 104.98,
   "text": "روح، روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.98,
   "end": 108.02,
   "text": "هم از اون راحت‌ست. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.02,
   "end": 111.9,
   "text": "به یک معنا می‌شه گفت روحانی زندگی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.9,
   "end": 115.26,
   "text": "این راحت یعنی این. یعنی از قید و بند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.26,
   "end": 118.54,
   "text": "طبیعیات و جسمانیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.54,
   "end": 124.88,
   "text": "نجات پیدا کنه. هو مفتاح کل راحت من الدنیا والآخرة این هو به چی می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.88,
   "end": 127.68,
   "text": "اصمت، سکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.68,
   "end": 132.52,
   "text": "به همین راحتی و فیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.52,
   "end": 136.48,
   "text": "رضى الله رضایت خدا رو کی می‌خواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.48,
   "end": 139.12,
   "text": "همه می‌خوایم. فیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.12,
   "end": 141.74,
   "text": "رضى الله در چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.74,
   "end": 144.1,
   "text": "رضایت خداست؟ در سکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.1,
   "end": 148.78,
   "text": "خدا دوست داره اصن راضی می‌شه از اینکه بنده‌ش ساکت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.78,
   "end": 150.94,
   "text": "تخفیف الحساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.94,
   "end": 154.6,
   "text": "به به. حسابش تخفیف می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.6,
   "end": 159.42,
   "text": "می‌گه آقا یه جا چیزی می‌خری می‌گه آقا یه تخفیفی بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.42,
   "end": 164.24,
   "text": "یعنی کمتر بگیر . یعنی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.24,
   "end": 168.8,
   "text": "تو حساب کتابش به یک معنا آسون می‌گیره .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.8,
   "end": 171.66,
   "text": "یعنی چقدر برکات داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.66,
   "end": 177.2,
   "text": "همین یه دونه دست گل مرغ. و سعنا من الخطايا و الزلل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.2,
   "end": 182.8,
   "text": "از خطاها و لغزش‌ها مصون می‌داره انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.8,
   "end": 187.82,
   "text": "یعنی هرکی که سکوتش بیشتره قطعاً از خطاها و لغزش‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.82,
   "end": 192.6,
   "text": "مصون‌تره. و قد جعله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.6,
   "end": 196.46,
   "text": "ستراً على الجاهل و زینه للعالِم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.46,
   "end": 200.04,
   "text": "به تحقیق خدا قرار داده صمت و سکوت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.04,
   "end": 203.56,
   "text": "سبب پوششه برای جاهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.56,
   "end": 207.86,
   "text": "می‌گه تا مرد سخن نگفته باشد عیب و هنرش هم عیبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.86,
   "end": 212.1,
   "text": "هم هنرش نگفته باشد. می‌گه این پوششه برای جاهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.1,
   "end": 215.66,
   "text": "خب جایی که علم نداری بلد نیستی، تخصص نداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.66,
   "end": 217.62,
   "text": "چرا الکی حرف می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.62,
   "end": 221.58,
   "text": "متأسفانه درد اجتماعی عجیبی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.58,
   "end": 226.2,
   "text": "جانسوز که هرکس در حوزه‌ای که تخصص نداره نظر میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.2,
   "end": 230.58,
   "text": "طرف هیچ خـ-- هیچ خبر و هیچ تخصصی در حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.58,
   "end": 233.38,
   "text": "مسائل اجتماعی، سیاسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.38,
   "end": 237.26,
   "text": "حتی فقهی، دینی که دیگه چه عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.26,
   "end": 241.0,
   "text": "همینطوری دهنشو باز می‌کنه و حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.0,
   "end": 243.74,
   "text": "آقا نگو دیگه. سکوت رو برای اینجا گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.74,
   "end": 248.58,
   "text": "و زینه للعالَم برای عالم، برای متخصص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.58,
   "end": 250.14,
   "text": "که تخصص خورده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.14,
   "end": 252.94,
   "text": "اینا تشخص پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.94,
   "end": 256.42,
   "text": "در اون حوزه البته سبب زینته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.42,
   "end": 258.68,
   "text": "با این که آقا علمش رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.68,
   "end": 262.58,
   "text": "می‌تونه حرف بزنه اما سکوتش زینتشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.58,
   "end": 267.08,
   "text": ". و معه خدا رحمت کنه همین الان به یاد یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.08,
   "end": 269.78,
   "text": "بزرگان اهل معرفت افتادم که از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.78,
   "end": 274.38,
   "text": "من می‌رفتم محضر ایشون می‌شستم سحرهای ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.38,
   "end": 278.94,
   "text": "بعد نماز صبح که ایشون می‌خوند همینطوری می‌شستم کنار دستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.94,
   "end": 283.2,
   "text": "مطلقا با اَهدی حرف نمی‌زد حتی استخاره هم که می‌زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.2,
   "end": 285.64,
   "text": "وقتی دستش رو اینطوری می‌کرد یعنی بد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.64,
   "end": 288.18,
   "text": "اینطوری می‌کرد یعنی خوب. اصلاً حرف نمی‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.18,
   "end": 290.68,
   "text": "یه روز من خواب عجیبی دیده بودم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.68,
   "end": 293.0,
   "text": "یکی از مراجع، محضر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.0,
   "end": 296.66,
   "text": "خوابم رو تعریف کردم فقط گریه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.66,
   "end": 298.84,
   "text": ". گفتم آقا گریه شما به چه درد من می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.84,
   "end": 301.18,
   "text": "شما برای من بگو تعبیرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.18,
   "end": 306.44,
   "text": "هیچی فقط گریه کرد. یه یک ساعتی گریه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.44,
   "end": 308.14,
   "text": ". اینا کجان؟ چی شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.14,
   "end": 313.12,
   "text": "نسل اینا اصلاً انگار برداشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.12,
   "end": 317.56,
   "text": ". و معه عزل الهوی و ریاضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.56,
   "end": 321.62,
   "text": "و ریاضت نفس. عزل الهوی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.62,
   "end": 327.68,
   "text": "معه به اتفاق سکوت یعنی کسی که معیت داره با سکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.68,
   "end": 329.38,
   "text": "عزل الهوی. به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.38,
   "end": 333.26,
   "text": "کی می‌گه آقا من می‌خوام از هوای نفس نجات پیدا کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.26,
   "end": 338.72,
   "text": "خب بسم الله. قطع هوای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.72,
   "end": 342.8,
   "text": ". و ریاضت نفس. هی می‌گیم آقا یه ریاضت شرعیه به ما بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.8,
   "end": 350.12,
   "text": "آقا بهترین ریاضت شرعیه امام صادق داره می‌گه من کی رو چه-- امام صادق می‌فرماید و ریاضت نفس بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.12,
   "end": 355.72,
   "text": "می‌خواید به نفس سختی بدید، ریاضت شرعی بکشید، چی بهتر از سکوت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.72,
   "end": 358.02,
   "text": "و حلاوه العباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.02,
   "end": 361.84,
   "text": "شیرینی بندگی. بارها خدمتتون عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.84,
   "end": 367.57,
   "text": "استادی ما داشتیم در زمان جنگ خدا حقش رو به ما حلال کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.57,
   "end": 371.69,
   "text": "نفسی داشت. کشف کراماتی ازش می‌دیدیم با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.69,
   "end": 375.23,
   "text": "من اون موقع پونزده سالم بود رفتم جبهه، ایشون هفده سالش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.23,
   "end": 378.59,
   "text": "دو سال از من بزرگ‌تر بود ولی عجیب کشف کراماتی ازش می‌دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.59,
   "end": 381.67,
   "text": "بماند که در شلمچه تیر خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.67,
   "end": 384.83,
   "text": "تو صورتش و داغون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.83,
   "end": 387.71,
   "text": "ایشون خیلی حال خوشی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.71,
   "end": 390.65,
   "text": "خب ما دوست داشتیم مثل ایشون تو نمازه مون اشک بریزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.65,
   "end": 395.23,
   "text": "حال خوشی داشت. رفتم بهش گفتم چیکار می‌کنی میثم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.23,
   "end": 400.27,
   "text": "گفت هیچ. قبل از نمازم می‌شینم تو سجاده یه ربع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.27,
   "end": 404.51,
   "text": "می‌شینم فکر می‌کنم. سکوت می‌گیرم فکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.51,
   "end": 406.65,
   "text": "این رمزشو اینجا حضرت یاد داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.65,
   "end": 412.89,
   "text": "حلاوة العبادة. از سمت اصلاً یه جا دیگه داریم اول العبادة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.89,
   "end": 414.63,
   "text": "اولین عبادت باید سمت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.63,
   "end": 417.19,
   "text": "طرف همینطوری داره با بغل دستیش صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.19,
   "end": 422.71,
   "text": "بگو بخند اینا مهرشم پرت می‌کنه که هرجا افتاد نمازشو شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.71,
   "end": 425.23,
   "text": "با بغل دستیش داره میگه می‌خنده و الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.23,
   "end": 429.65,
   "text": "آخه این چه نمازیه؟ بخوره تو کمر من این نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.65,
   "end": 433.05,
   "text": "اصلاً این نماز نیست. خودتو خسته می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.05,
   "end": 436.87,
   "text": "از تو اداره پا شده اومده الان داره جواب ارباب رجوع رو داده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.87,
   "end": 440.63,
   "text": "نمی‌کنه بابا دو دقیقه. هی به من میگه آقا حاج آقا صبر کنید تا همه بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.63,
   "end": 445.97,
   "text": "خب اونا زود بیان. قبل از اذان بره وضوشو بگیره بیاد چه اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.97,
   "end": 448.43,
   "text": "یه دو دقیقه زودتر بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.43,
   "end": 452.63,
   "text": "رهبر فرمودن که اگر خودسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.63,
   "end": 458.25,
   "text": "کارکنان، کارمندان خودسازیشون، یادگیری مسائل شرعی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.25,
   "end": 464.65,
   "text": "مبتنی بر این برنامه‌های فرهنگی و مذهبی و حضرت عاشورا و م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.65,
   "end": 469.35,
   "text": "نماز و نم-- کارهای نمازخانه و این چیزاست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.35,
   "end": 472.67,
   "text": "باید باشه. حالا یه سری میان می‌گن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.67,
   "end": 475.03,
   "text": "کار افضل و ارجح فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.03,
   "end": 479.29,
   "text": "خب کار بدون این که اصلاً کمه تا آدم می‌لنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.29,
   "end": 486.53,
   "text": "این یک دانشگاه انسان‌سازی نماز و این احادیث و روایات از اینا ورش داری دیگه چی می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.53,
   "end": 489.69,
   "text": "الان سازمان ما آموزشش چیکار داره می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.69,
   "end": 492.45,
   "text": "چه آموزشی برای من و شما داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.45,
   "end": 494.79,
   "text": "آموزش هین خدمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.79,
   "end": 498.73,
   "text": "اگر این منبرا رو هم ورداری دیگه چی می‌مونه برای ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.73,
   "end": 502.61,
   "text": "زودتر آدم بیاد بشینه پنج دقیقه زودتر تو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.61,
   "end": 505.11,
   "text": "شرکت کنه، بشینه فکر کنه، سکوت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.11,
   "end": 509.49,
   "text": "حضرت فرمودن و حلاوة العبادة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.49,
   "end": 513.47,
   "text": "و زوال و اینجا نکته اینجاست و زوال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 513.47,
   "end": 519.07,
   "text": "قسوة القلب. البته روایت ادامه داره باز میگن مبسوطه‌ اما همین جا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.07,
   "end": 522.03,
   "text": "فرود میایم. زوال و قسوة القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.03,
   "end": 526.73,
   "text": "آقا میگه من دلم سنگه. هرچی شما می‌خونی اصلاً نمی‌تونم ارتباط بگیرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.73,
   "end": 529.61,
   "text": "با خدا، با امام زمان، با امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.61,
   "end": 534.35,
   "text": "چرا همه گریه می‌کنن من اشکم در نمیاد بفرمایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.35,
   "end": 538.61,
   "text": "زوال و قسوة القلب. یکی از بهترین راه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.61,
   "end": 546.43,
   "text": "درمان قسی القلب و سختی قلب و رسیدن به نرمش دل همین سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.43,
   "end": 548.93,
   "text": "و چقدرم راهکار شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.93,
   "end": 556.49,
   "text": "راهکار قشنگیه. در این کتابی که الان دست منه، کتاب انسان در عرف عرفان حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.49,
   "end": 558.47,
   "text": "خیلی کتاب عالیه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.47,
   "end": 563.29,
   "text": "به وزان اون آیه به وفق اون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.29,
   "end": 570.11,
   "text": "واما بنعمت ربک فحدث وقتی نعمت بهت می‌دن حدیث کن، بیانش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.11,
   "end": 576.13,
   "text": "حضرت استاد چند تا از مکاشفاتی که براش رخ داده رو اول این کتاب آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.13,
   "end": 579.53,
   "text": "واقعه شیشم رو اجازه بدید براتون از رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.53,
   "end": 582.01,
   "text": "یعنی یکی از مکاشفات آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.01,
   "end": 584.55,
   "text": "در سحر شب یکشنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.55,
   "end": 586.93,
   "text": "پنج پنج سال چهل و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.93,
   "end": 589.63,
   "text": "من هنوز اون موقع به دنیا نیومده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.63,
   "end": 596.61,
   "text": "اون موقع بعد از ادای نافله شب و نافله و فریضه صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.61,
   "end": 604.59,
   "text": "در اربعینی یعنی چله‌ای که ذکر جلالی الله رو هر روز بعد از نماز صبح به عددی خاص داشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.59,
   "end": 607.23,
   "text": "بعد از این البته یه جای دیگه عددشو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.23,
   "end": 610.79,
   "text": "یک جای دیگه علامه فکر می‌کنم تو نامه‌ها و برنامه‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.79,
   "end": 613.25,
   "text": "عدد ذکر الله رو بیان می‌کنه به چه عدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.25,
   "end": 615.33,
   "text": "اینجا می‌فرماید با یه عدد خاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 615.33,
   "end": 619.31,
   "text": "بعد از نماز صبح چله گرفته بودم الله بگم الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.31,
   "end": 623.99,
   "text": "یا هم نه الله. بعد از این ذکر به توجه نشستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.99,
   "end": 627.73,
   "text": "همون بحث توجه عرفانیه که گفتم بهترین وقتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.73,
   "end": 635.17,
   "text": "بین الطلوعین. قبلاً پیرامون توجه عرفانی و آدابش حرف زدیم و سه راه براش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 635.17,
   "end": 642.91,
   "text": "تو یکی از جلسات. به توجه نشستن یعنی به توجه نشستن یعنی به توجه عرفانی که شروع کشف کراماته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.91,
   "end": 646.63,
   "text": "راهه. یک راه طریقه. شما هم می‌تونید برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.63,
   "end": 653.27,
   "text": "روز ب-- فرمود ت-به توجه نشستم که ناگهان جذبه و حالتی دست داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.27,
   "end": 656.61,
   "text": "و بدن به طوری به صدا درآمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 656.61,
   "end": 662.89,
   "text": "و می‌لرزید آنچنان صدایی که مثلاً تراکتور روی سنگ‌های درشت و جاده ناهموار می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.89,
   "end": 666.77,
   "text": "دیدم که جانم از بدنم مفارقت کرد و متصاعد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.77,
   "end": 669.83,
   "text": "یعنی پرواز کرد جانم رفت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.83,
   "end": 672.49,
   "text": "ولی در بدنی مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 672.49,
   "end": 675.23,
   "text": "مثال بدن عالم خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 675.23,
   "end": 677.73,
   "text": "یعنی تو خواب چجوری با چه بدنی میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.73,
   "end": 679.97,
   "text": "می‌گفتم با اینکه تو تن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.97,
   "end": 684.05,
   "text": "جسمی‌ام بودم، جسدی‌ام بودم ولی یه دفعه دیدم تو اون قالبم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.05,
   "end": 687.49,
   "text": "دارم میرم بالا. تا قدری بالا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 687.49,
   "end": 691.91,
   "text": "دیدم در میان خانه‌ای هستم که تیرهای آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 691.91,
   "end": 694.47,
   "text": "همه چوبی و نجاری شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 694.47,
   "end": 698.51,
   "text": "ولی من در این خانه مانند پرنده‌ای که در خانه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 698.51,
   "end": 704.43,
   "text": "دربسته گرفتار شده است و به این طرف و آن طرف پرواز می‌کند و راه خروج نمی‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 704.43,
   "end": 709.81,
   "text": "یعنی تو این وضعیت بودم. تقریباً در مدت یک ربع ساعت گرفتار بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.81,
   "end": 711.55,
   "text": "و به این سو آن سو می‌شتافتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.55,
   "end": 713.17,
   "text": "دیدم در این خانه زندانی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 713.17,
   "end": 716.77,
   "text": "نمی‌توانم به در بروم. سخ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.77,
   "end": 719.87,
   "text": "سخنی از گوینده‌ای شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 719.87,
   "end": 722.77,
   "text": "از گوینده‌ای شنیدم. ندیدمش بهش می‌گن حاطف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.77,
   "end": 727.59,
   "text": "در بحث عرفان. حاطف یعنی صدا شنیدم، ندیدمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.59,
   "end": 733.6,
   "text": "سخنی از گوینده‌ای شنیدم و خود، و خود او را ندیدم که به من می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.6,
   "end": 736.1,
   "text": "این محبوس بودنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 736.1,
   "end": 738.92,
   "text": "بر اثر حرف‌های زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 738.92,
   "end": 744.34,
   "text": "و بیخود توست. چرا حرف‌ها را نمی‌پایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 744.34,
   "end": 746.2,
   "text": "حالا علامه داره اینو میگه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 746.2,
   "end": 748.32,
   "text": "حواستون باشه. و دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.32,
   "end": 750.94,
   "text": "ما که بنده که دیگه ول معطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 750.94,
   "end": 758.06,
   "text": "\"من در آن حال چندین بار خدای متعال را به پیغمبر خاتم برای نجاتم قسم دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 758.06,
   "end": 762.84,
   "text": "و به تضرع و زاری افتادم که ناگهان چشمم به طرف شمال خانه افتاد که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 762.84,
   "end": 767.48,
   "text": "دیدم دریچه‌ای که یک شخص آدم بتواند به در برود به رویم گشوده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 767.48,
   "end": 770.16,
   "text": "از آنجا در رفتم و پس از آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 770.16,
   "end": 775.62,
   "text": "و پس از به در آمدن\" یعنی بیرون رفتن \"چندی به سوی مشرق در طیران بودم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.62,
   "end": 778.36,
   "text": "دوباره به جانب قبله رهسپار شدم و\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 778.36,
   "end": 783.28,
   "text": "می‌فرمود که \"و هنگامی که از آن حبس رهایی یافتم\" یعنی از خانه به در آمدم \"آن خانه را\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.28,
   "end": 784.7,
   "text": "حالا اون خونه‌ای که توش گیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.7,
   "end": 787.2,
   "text": "گیر افتاده بودها که میگه هیچ راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 787.2,
   "end": 790.22,
   "text": "فراری نبود و از بیرون داره می‌بینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.22,
   "end": 792.7,
   "text": "ببینید چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 792.7,
   "end": 796.8,
   "text": "خانه‌ای بوده. به نظر شما حالا یه آلونک تنگ بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 796.8,
   "end": 803.84,
   "text": "می‌فرماید که \"آن خانه را بسیار بزرگ و مجلل دیدم که در میان باغی بنا شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 803.84,
   "end": 813.24,
   "text": "و آن باغ را نهایت نبود و آن را درخت‌های گوناگون پر از شکوفه سفید بود که در عمرم چنان منظره‌ای ندیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 813.24,
   "end": 818.14,
   "text": "و می‌بینم که به ار، به اندازه ارتفاع درخت‌ها در هوا سیر می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 818.14,
   "end": 820.24,
   "text": "به گونه‌ای که رویم یعنی مقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.24,
   "end": 827.08,
   "text": "بلدم همه به سوی آسمان است و پشت به سوی زمین و به اراده و همت و فرمان خود نشیب و فراز دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 827.08,
   "end": 829.62,
   "text": "و بسیار خدای متعال را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 829.62,
   "end": 836.38,
   "text": "متعال را به پیغمبر خاتم و همه انبیا قسم می‌دادم که کشف حقایقی برایم دست داد.\" یعنی تو اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 836.38,
   "end": 839.44,
   "text": "میگه قسم می‌دادم که یه حقیقتی کشف بشه برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 839.44,
   "end": 842.32,
   "text": "وقتی این منظره رو دیدم. حالا اینجا خیلی حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 842.32,
   "end": 844.84,
   "text": "دیگه وقت هم داره تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 844.84,
   "end": 848.2,
   "text": "به امانت یه وقت دیگه‌ای که چرا وقتی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 848.2,
   "end": 852.94,
   "text": "خونه تنگ اومد بیرون وسیع دیدش پر از گل و گل و غزار و این‌ها دیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 852.94,
   "end": 856.58,
   "text": "اونا چی بود؟ از که حالا تنگ دیدش وقتی درش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 856.58,
   "end": 859.04,
   "text": "بیا دهانت رو ببندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 859.04,
   "end": 861.68,
   "text": "اینه. اون جای تنگ اینطوری می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 861.68,
   "end": 865.12,
   "text": "برات. \"در همین حال به خود آمدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 865.12,
   "end": 867.84,
   "text": "آن محبوس بودن چند دقیقه بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 867.84,
   "end": 875.6,
   "text": "در آن محبوس بودن چند دقیقه بسیار در من اثر بد گذاشت به گونه‌ای که بدنم خسته و کوفته شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 875.6,
   "end": 877.96,
   "text": "سرم و شانه‌ام همه درد گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 877.96,
   "end": 880.22,
   "text": "و قلبم به شدت می‌زد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 880.22,
   "end": 882.12,
   "text": "بعد می‌فرمایند ادامه می‌ده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 882.12,
   "end": 886.06,
   "text": "یکی از روایات و آیات قرآن رو میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 886.06,
   "end": 890.58,
   "text": "و این یه تمثل یک کشف در حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 890.58,
   "end": 893.66,
   "text": "که تازه نشسته به توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 893.66,
   "end": 899.34,
   "text": "بهش می‌گن که این گرفتاری که برای نفس تو ایجاد شد، نمی‌ذارن تر بکشی به جهت حرف زدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 899.34,
   "end": 904.46,
   "text": "آقا نزن، حرف نزن. از یک کشف، کشف دیگه‌شون که می‌فرمودند که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 904.46,
   "end": 907.0,
   "text": "حالا اونم مفصله به امانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 907.0,
   "end": 912.5,
   "text": "می‌فرمودند که اصلا دها، دو تا لب‌های من رو دوختن بهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.5,
   "end": 915.9,
   "text": "قشنگ باز می‌فرمود که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 915.9,
   "end": 919.94,
   "text": "فرشته‌ها اومدن با سوزن جوال دوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 919.94,
   "end": 922.2,
   "text": "که خیلی هم بزرگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 922.2,
   "end": 928.4,
   "text": "شروع کردن لب‌های منو می‌دوختن منم زجر می‌کشیدم فریاد می‌زدم اینا اصلا توجه نمی‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 928.4,
   "end": 933.02,
   "text": "که چرا حرف، یه حرف‌هایی رو داری می‌زنی که نباید بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 933.02,
   "end": 935.42,
   "text": "تازه نزده دهانش رو دوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 935.42,
   "end": 940.72,
   "text": "این کشف، کشف و کرامات‌ها این همه حرفا تو کتاباش پیاده کرده که همه رو به حیرت انداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 940.72,
   "end": 943.12,
   "text": "ببین چیو با خودش برد و خاک کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 943.12,
   "end": 946.42,
   "text": "که من در یکی از سوالات خیلی خاص از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 946.42,
   "end": 948.88,
   "text": "کلمه بیست و چهار هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 948.88,
   "end": 952.22,
   "text": "یک کلمه‌ی ایشون سؤالی برام ایجاد شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 952.22,
   "end": 954.44,
   "text": "زنگ زدم به دامادشون حاج آقا نوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 954.44,
   "end": 958.52,
   "text": "ایشون گفت آقا تو این قصه هرچی علامه داشت خاک کرد با خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 958.52,
   "end": 962.58,
   "text": "به مام نداد. خیلی‌ها رو با خودش خاک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 962.58,
   "end": 965.9,
   "text": "حالا ما حرف بزنیم هی حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 965.9,
   "end": 967.88,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 967.88,
   "end": 974.78,
   "text": "الان ببینید من اندازه‌ی یک ساعت حداقل اندازه‌ی یک ساعت حدیث و روایت و گفتار از بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 974.78,
   "end": 977.46,
   "text": "برای شما آماده کرده بودم. دو تاشو فقط گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 977.46,
   "end": 980.9,
   "text": "یعنی فکر کنم یک ساعت منبر می‌خواست من همه اینا رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 980.9,
   "end": 984.36,
   "text": "حالا تا یار که خواهد میلش بکشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 984.36,
   "end": 986.44,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 986.44,
   "end": 989.64,
   "text": "به برکت صلوات بر محمد و آل محمد. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}