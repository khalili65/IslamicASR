 "chapters": [
  {
   "index": 0,
   "title": "## احکام ذکر و سلام در جماعت",
   "start": 23.56,
   "end": 46.7
  },
  {
   "index": 1,
   "title": "## مرور بیست و دو قلب و معرفی قلب لیّن",
   "start": 46.7,
   "end": 398.75
  },
  {
   "index": 2,
   "title": "## هفت رتبهٔ وجود انسان",
   "start": 398.75,
   "end": 722.77
  },
  {
   "index": 3,
   "title": "## منابع برای مطالعهٔ قلب",
   "start": 722.77,
   "end": 785.02
  },
  {
   "index": 4,
   "title": "## فشردهٔ پنج قلب نزد برخی",
   "start": 785.02,
   "end": 939.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 4.28,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 6.96,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.96,
   "end": 14.16,
   "text": "محمد و آل محمد. بسم الله الرحمن الرحیم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.16,
   "end": 18.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 23.34,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.34,
   "end": 27.76,
   "text": "ما در اجزاء و ارکان نماز حق نداریم که از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.76,
   "end": 31.38,
   "text": "جماعت جلو بزنیم. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.38,
   "end": 33.4,
   "text": "تشهدمون رو گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.4,
   "end": 40.22,
   "text": "الان وقت قيامه. امام هنوز بلند نشده ما حق نداریم بلند شیم قیام کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.22,
   "end": 43.52,
   "text": "یا زودتر به رکوع و سجود رفتن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.52,
   "end": 49.1,
   "text": "زودتر سر برآوردن اینو که میدونیم اما در ذکر چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.1,
   "end": 51.16,
   "text": "اون ذکری که مثلا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.16,
   "end": 53.42,
   "text": "بعد از امام رفتیم به رکوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.42,
   "end": 58.2,
   "text": "درست؟ امام هنوز ذکرشو شروع نکرده من حق دارم ذکرمو شروع کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.2,
   "end": 67.38,
   "text": "یا امام شروع کرده هنوز تموم نکرده ذکر رکوع و سجودشو یا تشهدشو، امام داره تشهد میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.38,
   "end": 71.88,
   "text": "من پیش از امام ورود کردم به تشهد، قبول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.88,
   "end": 75.28,
   "text": "اما میتونم هنوز امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.28,
   "end": 81.4,
   "text": "تشهدش رو شروع نکرده من شروع کنم یا تشهدش رو تموم نکرده من تموم کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.4,
   "end": 84.5,
   "text": "بله اشکال نداره. در ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.5,
   "end": 89.26,
   "text": "اشکال نداره. مثلا تسبیحات اربعة رو رکعت سوم، چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.26,
   "end": 93.5,
   "text": "امام داره میگه ما زودتر تموم کنیم اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.5,
   "end": 98.34,
   "text": "یا امام هنوز شروع نکرده داره تأمل میکنه رو مفاهیم عبارات چه میدونم بعد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.34,
   "end": 102.72,
   "text": "زودتر شروع کنیم هیچ ایرادی نداره تو این در شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.72,
   "end": 105.78,
   "text": "یا مثلا خاتمه ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.78,
   "end": 109.8,
   "text": "پیش از امام در ذکر اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.8,
   "end": 115.66,
   "text": "خب امروز جانم. فرمودین بعضیا میان نماز دومه میرسن-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.66,
   "end": 118.52,
   "text": "بله بعد از قمیت نماز دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.52,
   "end": 121.96,
   "text": "جدا میشن. بله، به فتوای رهبر اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.96,
   "end": 125.36,
   "text": "برسونن به قمتی که تو نمازی که- بله متوجه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.36,
   "end": 128.28,
   "text": "نه به فتوای رهبر اشکال نداره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.28,
   "end": 132.94,
   "text": "انسان زودتر مثلا حتی وسط نماز شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.94,
   "end": 135.32,
   "text": "مثل همین مثالی که زدی میخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.32,
   "end": 140.58,
   "text": "دو تا نماز رو به یکی، حالا من با این سرعتی که من میخونم نمیدونم چجوری میرسن دو تا نماز به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.58,
   "end": 143.1,
   "text": "یه نماز من اقتدا میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.1,
   "end": 145.38,
   "text": "ولی خب هستن بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.38,
   "end": 149.78,
   "text": "اشکال نداره. البته این رو عرض کنم بعضی از مراجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.78,
   "end": 156.4,
   "text": "تک و توک دیدم که گفتن فقط عند الضرورة میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.4,
   "end": 159.32,
   "text": "نماز رو زودتر از امام سلام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.32,
   "end": 163.82,
   "text": "عند الضرورة. ضرورت ایجاد کنه در غیر این صورت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.82,
   "end": 169.26,
   "text": "ولی رهبر اشکال نکرده. رهبر فرمودن شما زودتر از امام سلام بده، اصلا نیت فرضا کن نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.26,
   "end": 173.1,
   "text": "زودتر تموم کن اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.1,
   "end": 180.8,
   "text": "خب در خصوص این روزها، اون روزهای دوشنبه که انشاالله به فضل الهی بحث قلب در قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.8,
   "end": 186.26,
   "text": "ادامه میدیم، تو این هفت، هشت دقیقه ای که من وقت دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.26,
   "end": 189.46,
   "text": "مجبورم امروز یه کلیتی رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.46,
   "end": 193.38,
   "text": "اولاً نمیدونم کی اصلا در خاطرش هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.38,
   "end": 196.68,
   "text": "ما چهارصد و سی، چهل جلسه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.68,
   "end": 198.56,
   "text": "قلب در قرآن حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.56,
   "end": 200.84,
   "text": "بیست و دو نوع قلب رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.84,
   "end": 204.38,
   "text": "بیش از شصت نوع قلب رو از قرآن استخراج کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.38,
   "end": 207.06,
   "text": "بیست و دو تاشو معرفی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.06,
   "end": 213.92,
   "text": "من اینا رو سریع میخونم برای اینکه تشنه بشید، ببینید چه رتبه هایی و درجاتی در وجود ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.92,
   "end": 218.04,
   "text": "یک حقیقت قلب اما ذات مراتب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.04,
   "end": 221.88,
   "text": "مراتب داره و تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.88,
   "end": 225.02,
   "text": "هر رتبه کارکرد خودش رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.02,
   "end": 229.28,
   "text": "اول ما قلب ما، الان تندتند بگم چون وقت کمه، قلب مطمئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.28,
   "end": 233.0,
   "text": "اینا رو همه رو گفتیم. قلب مطبوع با ط دست داره یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.0,
   "end": 235.96,
   "text": "مغ خورده. قلب خاشع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.96,
   "end": 239.52,
   "text": "قلب مختوم، ختم شده کارش تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.52,
   "end": 243.44,
   "text": "قلب منیب، قلب زایغ یا منحرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.44,
   "end": 246.66,
   "text": "قلب وجل یعنی ترسان از خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.66,
   "end": 249.12,
   "text": "قلب مریض، قلب سلیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.12,
   "end": 253.96,
   "text": "قلب قسی، قلب مخبت، قلب منافق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.96,
   "end": 258.4,
   "text": "قلب ممتحن. یادمه بچه های نجف آباد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.4,
   "end": 264.44,
   "text": "اصفهان خادمین شهید حججی، اونجا خیلی رو قلب منافق براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.44,
   "end": 269.04,
   "text": "جالب اومده بود. گفتن حاج آقا این مباحث قلب منافق باید اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.04,
   "end": 273.54,
   "text": "بره چون حرفای ما که نبود که قرآن و روایت، باید بره تو ادارجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.54,
   "end": 275.76,
   "text": "بره دست مدیران نظام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.76,
   "end": 279.68,
   "text": "اونجا مباحث قلب نف-- منافق رو که ما بحث کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.68,
   "end": 282.54,
   "text": "زدیمش به اونایی که تو انقلاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.54,
   "end": 284.56,
   "text": "نفاق نشون دادن از خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.56,
   "end": 289.04,
   "text": "قلب ممتحن، قلب مکنون که تو پرده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.04,
   "end": 292.08,
   "text": "قلب غیر متفقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.08,
   "end": 298.54,
   "text": "جسارتاً یعنی نفهم، قلب مغفول با قاف یعنی قفل شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.54,
   "end": 301.22,
   "text": "قلب ا-- قلب اغلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.22,
   "end": 303.44,
   "text": "یا مغلوف با غین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.44,
   "end": 307.56,
   "text": "یعنی تو غلافه، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.56,
   "end": 310.62,
   "text": "آثم با سه تا نقطه یعنی گنهکار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.62,
   "end": 313.74,
   "text": "قلب مألوف با الف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.74,
   "end": 319.76,
   "text": "که از انس و الفت میاد، قلب مریب یعنی مردد، شکاک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.76,
   "end": 325.18,
   "text": "قلب منزل که یادمه سنگین‌ترین و بهترین حرفا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.18,
   "end": 329.52,
   "text": "تو قلب منزل فکر میکنم سی جلسه ما پیاده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.52,
   "end": 333.26,
   "text": "اون موقع هم من بیشتر صحبت میکردم تا اینکه الان نبود یه ذره طول بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.26,
   "end": 336.14,
   "text": "صدای آقایی این در بیاد. بیست دقیقه حرف میزدم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.14,
   "end": 338.82,
   "text": "همه هم به گوش بودن یادش بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.82,
   "end": 341.2,
   "text": "دوران طلایی حرفای ما بود اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.2,
   "end": 344.98,
   "text": "قلب منزل، محل نزول، فرودگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.98,
   "end": 347.84,
   "text": "قلب منغمر یعنی بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.84,
   "end": 353.52,
   "text": "این آخرین قلبی بود که فکر می‌کنم بیست و دو جلسه صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.52,
   "end": 355.68,
   "text": "هست صوتاش تو حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.68,
   "end": 357.56,
   "text": "متاسفانه سرورهای تا یهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.56,
   "end": 361.4,
   "text": "ظرفیتشو خالی میکنه بعضاش نیست اما اکثرش هنوز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.4,
   "end": 364.27,
   "text": "میتونن رجوع کنن عزیزان. امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.27,
   "end": 366.21,
   "text": "فقط معرفی در حد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.21,
   "end": 369.03,
   "text": "بیست و سومین قلب، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.03,
   "end": 373.21,
   "text": "لَین میگن لَین هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.21,
   "end": 376.23,
   "text": "امرش می‌شه لَین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.23,
   "end": 378.61,
   "text": "لَین یعنی نرم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.61,
   "end": 381.61,
   "text": "لَین یعنی نرم. لَین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.61,
   "end": 387.13,
   "text": "یعنی منعطف. به یک معنا بعضی آرام هم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.13,
   "end": 391.03,
   "text": "حالا ما مصادر و منابعش رو به شما میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.03,
   "end": 398.75,
   "text": "به صورت کلی از حیث اینکه قلب کدوم رتبه از رتبه‌های وجودی ما رو تشکیل می‌ده می‌دونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.75,
   "end": 402.47,
   "text": "حکما و عرفا اون هم به استناد از آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.47,
   "end": 404.97,
   "text": "و روایات اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.97,
   "end": 408.29,
   "text": "وجود انسان رو به هفت بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.29,
   "end": 411.23,
   "text": "یا رتبه، بیرون از ما عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.23,
   "end": 414.09,
   "text": "عالم مثال، عالم عقل، عالم اله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.09,
   "end": 418.07,
   "text": "عالم اسماء ها؟ درون ما میگن رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.07,
   "end": 420.83,
   "text": "همونه ولی رتبه چون درون ماست میگن رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.83,
   "end": 423.91,
   "text": "هفت تا مرتبه رو شمردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.91,
   "end": 427.01,
   "text": "که اولیش عالم طبع یا رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.01,
   "end": 429.11,
   "text": "طبع طبیعت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.11,
   "end": 435.77,
   "text": "طبیعت هم بدن ما. از انزل مراتب وجود ما که یک وجود واحدی ما، اینا رتبه‌های وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.77,
   "end": 441.53,
   "text": "شئون وجودی ما هستن که ما اگر اینا رو ندونیم خراب، خراب می‌کنیم خودمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.53,
   "end": 445.57,
   "text": "علت اینکه ما خودمون رو جسارتاً خراب کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.57,
   "end": 451.93,
   "text": "یکی باید جمعمون کنه حجت خدا باید تفضل کنه جمعمون کنه به نگاه کن خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.93,
   "end": 456.73,
   "text": "که کن فیکون بشه. اینه که نشناختیم معرفت نفس نداشتیم خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.73,
   "end": 462.91,
   "text": "مثل اینکه بارها من مثال زدم یه دستگاهی مثل همین تلفن همراه رو چقدر درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.91,
   "end": 465.05,
   "text": "برنامه‌ها خوابیده، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.05,
   "end": 468.05,
   "text": "کاربردهایی داره. بعضی جاهاش به شدت پیشرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.05,
   "end": 472.33,
   "text": "حالا اینو دادن دست یه بچه به عنوان گوشت کوب ازش استفاده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.33,
   "end": 475.83,
   "text": "ما هم از وجود خودمون به عنوان یه گوشت کوب استفاده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.83,
   "end": 478.79,
   "text": "خودمونم زدیم له کردیم، نه دیگران رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.79,
   "end": 484.07,
   "text": "چرا این چرا آش و لاش با معذرت می‌خوام وضع ما انقدر آشفته‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.07,
   "end": 492.79,
   "text": "معرفت نفس نداشتیم. اینکه ما صد کلمه معرفت نفس اینجا شروع کردیم یه بخشش این بود که حالا مبحثش فرداش انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.79,
   "end": 494.45,
   "text": "پس یکی از رتبه‌های وجودیمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.45,
   "end": 496.37,
   "text": "طبع، طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.37,
   "end": 503.15,
   "text": "اونجایی‌ست که انسان منشاء حالا منشاء حرکت و سکون و سکون و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.15,
   "end": 504.89,
   "text": "ظاهره. از اینجا برو به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.89,
   "end": 509.07,
   "text": "مکان، زمان. یه رتبه باطن‌ترش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.07,
   "end": 511.77,
   "text": "مرتبه نفس. نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.77,
   "end": 516.91,
   "text": "ادراکات جزئی‌ست یا به یک معنا مراتب مافوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.91,
   "end": 523.41,
   "text": "اون بالایی‌ها باطن‌ترها باطن وجود ما وقتی می‌خواد حکمش رو در بدن پیاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.41,
   "end": 525.97,
   "text": "از طریق نفسه. یعنی نفس محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.97,
   "end": 529.43,
   "text": "تعلق مثلاً روح به بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.43,
   "end": 532.77,
   "text": "اینم یه رتبه از وجود ماست که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.77,
   "end": 538.17,
   "text": "کتاب‌ها نوشتن از تلمذ حسن زاده مثل اینکه هزار و یک نکته، هزار و یک کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.17,
   "end": 542.03,
   "text": "ها؟ می‌خواستن هزار و یک درس معرفت نفس هم برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.03,
   "end": 545.41,
   "text": "صد و پنجاه و سه تاش رو گفتن انقلاب شد تعطیل شد بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.41,
   "end": 548.63,
   "text": "در عنوان‌های دیگه مثل انسان در اورف‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.63,
   "end": 552.59,
   "text": "عرفان مثل سرالعيون همینطوری ادامه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.59,
   "end": 556.19,
   "text": "اون هزار و یک درس معرفت نفس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.19,
   "end": 561.31,
   "text": "مهم‌ترین کتاب علامه ديروان معرفت نفس سرالعيونشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.31,
   "end": 568.65,
   "text": "که خودشون این فرمودن چون تو پیری نوشتن شصت و شش اصل از اصول معارف نفس معرفت نفس درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.65,
   "end": 571.87,
   "text": "بعد پنهان‌تر از نفس می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.87,
   "end": 573.89,
   "text": "مرحله عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.89,
   "end": 581.13,
   "text": "حالا اینجا اگر بخواهیم بگیم به صورت کلی انسان رو در نظر بگیریم، نه مراتب نفس رو چون خود نفس مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.13,
   "end": 585.03,
   "text": "مثل اینکه قلب چند نوع ما قلب داریم میگیم مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.03,
   "end": 589.15,
   "text": "اینجا رو به صورت کلی انسان رو در نظر بگیریم طبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.15,
   "end": 592.65,
   "text": "نفس، حالا می‌شه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.65,
   "end": 597.77,
   "text": "قلب می‌شه محل Sand دیدن حقایق و ارتباط کثرات با وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.77,
   "end": 600.17,
   "text": "محل یه برزخ عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.17,
   "end": 603.93,
   "text": "نقطه قرمزه. یعنی این قلب برای همینه ما بهش رجوع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.93,
   "end": 608.45,
   "text": "ماحصل اونچه که ما بعد از مرگمون برای ما می‌مونه وضعیت قلبمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.45,
   "end": 610.77,
   "text": "نقطه اتصال ظاهر و باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.77,
   "end": 613.97,
   "text": "نقطه اتصال ملک و ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.97,
   "end": 618.53,
   "text": "کسی قلبش مشکل پیدا کنه ارتباطش از ملک با ملکوت قطع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.53,
   "end": 621.13,
   "text": "ظاهر و باطن نمی‌تونن با هم ارتباط بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.13,
   "end": 626.15,
   "text": "یه انسان ظاهری می‌شه دیگه به باطن راه پیدا نمی‌کنه لذا چون به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.15,
   "end": 631.23,
   "text": "راه پیدا نکرده و موت سفر از ظاهر به باطنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.23,
   "end": 636.73,
   "text": "موتش مشکل می‌شه. نمی‌تونه درک کنه این چه حقیقتیه که من باهاش رجوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.73,
   "end": 639.35,
   "text": "کردم. مثلاً فکشفنا عنک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.35,
   "end": 641.65,
   "text": "غطاءک یعنی معنای موته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 641.65,
   "end": 647.73,
   "text": "پرده که بیفته فکش فکشفنا ما که این پرده رو برداریم فبصرک اليوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 647.73,
   "end": 650.87,
   "text": "اون حقیقت اليوم ظرف ظهور اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.87,
   "end": 652.69,
   "text": "ظهور می‌کنه حقیقتت برای خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.69,
   "end": 656.45,
   "text": "یعنی خودت رو می‌بینی. بعد بصرک چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 656.45,
   "end": 659.09,
   "text": "حدید این چشمت تیز می‌شه تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.09,
   "end": 661.91,
   "text": "چرا؟ چرا انقدر لحظه موت عجیبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.91,
   "end": 664.91,
   "text": "چرا برزخمون طولانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 664.91,
   "end": 669.07,
   "text": "به جهت اینکه ما از ظاهر به باطن سفر نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.07,
   "end": 673.73,
   "text": "این سفر از ظاهر به باطن در محیط قلب صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.73,
   "end": 679.71,
   "text": "انقدر مهمه. حالا رتبه پنهان‌تر از قلب هم می‌شه روح که اون دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 679.71,
   "end": 682.15,
   "text": "حالت کلی داره و جمع و جمع و بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 682.15,
   "end": 686.69,
   "text": "حالا همه اینا توضیح داره دیگه به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 686.69,
   "end": 690.07,
   "text": "بعد می‌شه خفی می‌شه سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.07,
   "end": 692.71,
   "text": "سر که ارتباط با ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 692.71,
   "end": 698.15,
   "text": "ما با حقیقت عالمه. من خواهش می‌کنم اگر کسی گوش نمی‌ده تشریف ببره از نمازخونه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.15,
   "end": 703.51,
   "text": "جسارت می‌کنم من. زشته من دارم حدیث و روایت میگم آقایون گفت‌وگو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 703.51,
   "end": 705.39,
   "text": "اینجا محل الان محل گفت‌وگو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 705.39,
   "end": 710.07,
   "text": "جسارت بنده رو ببخشید. بعد از سر می‌شه خفی و اخفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.07,
   "end": 711.73,
   "text": "قلب اون وسط قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 711.73,
   "end": 715.05,
   "text": "همونطور که عرض کردم مرزه. خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 715.05,
   "end": 720.33,
   "text": "حالا انواع انواع اقسام رتبه‌های قلب داریم که داریم بحث می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 720.33,
   "end": 722.77,
   "text": "که چه کارکردی داره قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 722.77,
   "end": 726.99,
   "text": "در حالا اگر خواستید رجوع کنید مثلاً من چند تا مدرک ارائه بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 726.99,
   "end": 730.85,
   "text": "چون امروز کلی داریم صحبت می‌کنیم تو این دو دقیقه پایانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 730.85,
   "end": 736.22,
   "text": "کسی خواست رجوع کنه مثلاً دروس هشتاد تا صد مسباح الانس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 736.22,
   "end": 739.38,
   "text": "شرح مسباح الانس مرحوم ابن فناری علامه حلی بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 739.38,
   "end": 743.32,
   "text": "شرح داده به تفصیل پیرامون قلب سخن گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 743.32,
   "end": 744.94,
   "text": "انقدر زیبا و قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 744.94,
   "end": 749.84,
   "text": "تازه آدم هاج و واج می مونه واقعاً من همچین کسی هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 749.84,
   "end": 753.88,
   "text": "و یه همچین برنامه‌هایی رو خدا در وجود من تعبیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 753.88,
   "end": 755.9,
   "text": "در فصل شعیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 755.9,
   "end": 760.12,
   "text": "فسوس الحکم ابن عربی اصلاً مو-موضوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.12,
   "end": 762.92,
   "text": "موضوع قلبه. اونجا خیلی زیبا سخن گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.92,
   "end": 765.9,
   "text": "عیون مسائل نفس که گفتیم پخته‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 765.9,
   "end": 767.84,
   "text": "کتاب معرفت نفس علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 767.84,
   "end": 770.04,
   "text": "جلد یک صفحه چهل و شش می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 770.04,
   "end": 773.58,
   "text": "مراتب قلب رو ببینید. نکته ششصد و شصت و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 773.58,
   "end": 775.92,
   "text": "هزار و یک نکته علامه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 775.92,
   "end": 782.2,
   "text": "همچنینه. که حالا مثلاً به صورت کلی مثل اینکه الان من دارم تفصیل میدم بازش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 782.2,
   "end": 784.06,
   "text": "اینم حرف آخرم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 784.06,
   "end": 785.64,
   "text": "خیلی امروز کلی صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 785.64,
   "end": 787.72,
   "text": "دیگه نرسیدیم به قلب نرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 787.72,
   "end": 790.0,
   "text": "قلب لَین یا لَین. انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.0,
   "end": 792.56,
   "text": "جلسات بعد. خیلی کلی حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 792.56,
   "end": 794.72,
   "text": "بعضیا میگن اونو خیلی فشرده‌ش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 794.72,
   "end": 797.38,
   "text": "کل مثلاً شصت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 797.38,
   "end": 803.52,
   "text": "خورده‌ای قلب رو مراتبش رو میان فشرده می‌کنن میگن پنج تا قلب داریم به صورت کلی پنج تا قلب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.52,
   "end": 809.46,
   "text": "مثل این که میگه آقا این همه عوالم داریم به صورت کلی یه عالم ظاهر داریم، یه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 809.46,
   "end": 813.66,
   "text": "قبوله دیگه. درسته دیگه. این که نفی اون نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 813.66,
   "end": 816.22,
   "text": "اون پنج تا انواع قلب رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 816.22,
   "end": 820.84,
   "text": "علامه حدود بیست جلسه بیست بیش از بیست جلسه درباره‌ش سخن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 820.84,
   "end": 823.14,
   "text": "اینم معرفی کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 823.14,
   "end": 825.04,
   "text": "اولیش میگه قلب نفسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 825.04,
   "end": 827.32,
   "text": "میگه انزل مراتب قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 827.32,
   "end": 829.56,
   "text": "ادراکات بسیار جزئی قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 829.56,
   "end": 835.8,
   "text": "مربوط به نفسه. بعد قلب حقیقیه که تولدش از مشیمه جمعیت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 835.8,
   "end": 838.1,
   "text": "از تزویج بین روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 838.1,
   "end": 841.14,
   "text": "و نفس، قلب نفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 841.14,
   "end": 843.48,
   "text": "متولد می‌شه. خودش یه بچه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 843.48,
   "end": 846.14,
   "text": "که به دنیا میاد. حالا کارکردش بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 846.14,
   "end": 849.4,
   "text": "سومیش قلب متولد از مشیمه روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 849.4,
   "end": 852.6,
   "text": "مشیمه یعنی بچه‌دان مثل رحم مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 852.6,
   "end": 857.38,
   "text": "از مشیمه روحه. یعنی قلب قابل تجلی وجود باطنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 857.38,
   "end": 862.26,
   "text": "یعنی یه قلبی‌ست که از روح متولد می‌شه، نه جمعیت نفس و روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 862.26,
   "end": 867.34,
   "text": "از مستقیم روح. می‌تونه محل تجلی اسماء الهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 867.34,
   "end": 872.38,
   "text": "جای بسیار خاصیه. شما مثلاً اسم الرؤوف در تو پیاده بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 872.38,
   "end": 875.24,
   "text": "که میری مشهد امام الرؤوف تحویلت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 875.24,
   "end": 878.36,
   "text": "در تو پیاده بشه این اسم، این کارکرد این نوع قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 878.36,
   "end": 880.5,
   "text": "چهارمیش قلب جامعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 880.5,
   "end": 884.16,
   "text": "جامعه. که عدد ابجد جامعه هم صد و چهارده‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 884.16,
   "end": 887.02,
   "text": "قرآن هم که صد و چهارده تا سوره داره جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 887.02,
   "end": 890.58,
   "text": "یک جای بسیار خاصی در وجود انسان که مسخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 890.58,
   "end": 894.38,
   "text": "بین حضرتین‌ه. حضرتین منظور اسم ظاهر و باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 894.38,
   "end": 900.16,
   "text": "این قلب رو کسی می‌تونست بهش رسی برسه در عین اینکه ظاهره، غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 900.16,
   "end": 903.62,
   "text": "مثلا الان امام عصر ما ظاهر هست اما غائب هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 903.62,
   "end": 906.56,
   "text": "بالاتر از این می‌شه قلب اهدی جمعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 906.56,
   "end": 911.3,
   "text": "اون دیگه قلب انسان کامله، قلب نبی اکرمه، قلب امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 911.3,
   "end": 916.26,
   "text": "اون دیگه می‌شه گفت ظهور اتم نه تام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 916.26,
   "end": 919.08,
   "text": "ظهور اتم الله همه اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 919.08,
   "end": 921.6,
   "text": "اون دیگه اصلاً مورد بحث ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 921.6,
   "end": 925.48,
   "text": "این همه صحبت کلی که انشاالله جلسه بعد می‌ریم سراغ قلب نرم.",
   "kind": "speech",
