 "chapters": [
  {
   "index": 0,
   "title": "## همخوانی مرجع امام و مأموم در قصر و تمام",
   "start": 2.76,
   "end": 177.06
  },
  {
   "index": 1,
   "title": "## قلب لیّن؛ حوزهٔ تعلقات و انکسار",
   "start": 177.06,
   "end": 197.5
  },
  {
   "index": 2,
   "title": "## تفاوت دل‌ها در برابر یک منظرهٔ واحد",
   "start": 197.5,
   "end": 719.5
  },
  {
   "index": 3,
   "title": "## وجه اختلاف قلب‌ها؛ معرفت و قساوت",
   "start": 719.5,
   "end": 775.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.76,
   "end": 5.5,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.5,
   "end": 13.44,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.44,
   "end": 17.3,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.3,
   "end": 24.42,
   "text": "نکته خیلی مهمی رو عزیزان که خواستن برن و گوش بدن برن پیرامون احکام کمتر گفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.42,
   "end": 27.64,
   "text": "اولا در خصوص امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.64,
   "end": 34.9,
   "text": "نیاز نداره که حتما مقلدی ما که مقلد مثلا رهبر هستیم حتما امام جماعت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.9,
   "end": 40.64,
   "text": "مقلد رهبر باشه. یعنی همخوانی در مرجع تقلید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.64,
   "end": 43.44,
   "text": "در امام و مأموم ملاک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.44,
   "end": 46.86,
   "text": "فقط یه جا شرطه، یک جا شرطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.86,
   "end": 52.4,
   "text": "اینو خوب دقت کنید. اونم جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.4,
   "end": 55.26,
   "text": "نماز جماعتو که به پا می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.26,
   "end": 58.78,
   "text": "اون مرجع تقلیدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.78,
   "end": 65.44,
   "text": "امام مقلدشه قائل به اینه که این نماز الان اینجا شکسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.44,
   "end": 73.96,
   "text": "یا کامله. مأموم که اقتدا کرده مرجع تقلیدش نظرش عکس اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.96,
   "end": 81.56,
   "text": "اگه امام مرجعش اینه که الان نماز شکسته است، مأموم مرجعش قائله که نماز تمامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.56,
   "end": 86.36,
   "text": "یا بالعکس. اینجا حق اقتدا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.36,
   "end": 88.86,
   "text": "مثلا رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 88.86,
   "end": 91.82,
   "text": "جزو معدود علمایی هستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.82,
   "end": 97.04,
   "text": "مسافت شرعی رو بیست کیلومتر و نیم می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.04,
   "end": 100.1,
   "text": "اکثر مراجع بیست و دو کیلومتر و نیم می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.1,
   "end": 104.1,
   "text": "یعنی رفت و برگشت مراجع میگن چهل و پنج کیلومتر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.1,
   "end": 106.48,
   "text": "رهبر رفت و برگشتو می‌شه چهل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.48,
   "end": 111.5,
   "text": "یک کیلومتر. حالا اینجا یه کسی امکان داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.5,
   "end": 114.9,
   "text": "مثلا بیست رسیده به جایی که رهبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.9,
   "end": 117.38,
   "text": "رهبر قائله که الان بیست و یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.38,
   "end": 121.38,
   "text": "بیست کیلومتر و نیم رفت و برگشت چهل و یک کیلومتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.38,
   "end": 126.32,
   "text": "رسیده به اینجا که مسافت شرعی رو یعنی می‌خواد یه همچین مسافتی رو بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.32,
   "end": 131.46,
   "text": "حد ترخص رو که تقریبا هزار و سیصد متر رد کرد دیگه می‌تونه نمازشو شکسته بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.46,
   "end": 135.32,
   "text": "اگر می‌دونه که بی-- چهل و یک کیلومتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.32,
   "end": 137.92,
   "text": "رفت و برگشتش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.92,
   "end": 142.0,
   "text": "اما خب یه چن-چنین کسی امام جماعت می‌شه نمازشو باید چیکار بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.0,
   "end": 145.38,
   "text": "شکسته بخونه. درسته؟ چون مقلد رهبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.38,
   "end": 152.48,
   "text": "حالا مأموم مقلد رهبر نیست، مقلد کس دیگه‌ست که اون قائله چهل و پنج کیلومتر باید مسافت شرعی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.48,
   "end": 156.6,
   "text": "و اون باید نمازشو توی همچین وضعیتی چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.6,
   "end": 159.64,
   "text": "به این امام باید کامل اقتدا کنه، نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.64,
   "end": 161.44,
   "text": "حق اقتدا نداره اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.44,
   "end": 164.84,
   "text": "اینو توجه داشته باشید که کمتر گفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.84,
   "end": 169.62,
   "text": "البته رهبر هم اول بیست و دو کیلومتر و نیم بود نظرشona خیلی سال‌های پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.62,
   "end": 173.16,
   "text": "فکر می‌کنم چهار پنج ساله که ایشون ادول کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.16,
   "end": 177.06,
   "text": "نظرشون برگشت به بیست کیلومتر و نیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.06,
   "end": 181.34,
   "text": "بحث روزهای دوشنبه ما قلب لعين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.34,
   "end": 183.82,
   "text": "یا لين بود و هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.82,
   "end": 187.62,
   "text": "یعنی قلب نرم، قلب نرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.62,
   "end": 191.82,
   "text": "ببینید حوزه قلب، حوزه تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.82,
   "end": 197.5,
   "text": "حوزه ااا عرض شود انکسار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.5,
   "end": 200.56,
   "text": "حوزه ببینید مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.56,
   "end": 206.32,
   "text": "ما یک مرح-- یک منظره رقت‌انگیزی رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.32,
   "end": 208.74,
   "text": "مثلا دارن یه بچه ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.74,
   "end": 213.16,
   "text": "می‌زنن، می‌کشن مثل اسرائیل ملعون که مثلا ریخته سر غزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.16,
   "end": 215.26,
   "text": "چشم ما وقتی می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.26,
   "end": 220.54,
   "text": "که اینطور بمب سر مردم مظلوم غزه می‌ریزن و بچه ها رو می‌کشن، زن ها رو می‌کشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.54,
   "end": 226.54,
   "text": "چشم ما نگاه می‌کنه، چشم که نمی‌لرزه، چشم که نمی‌سوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.54,
   "end": 233.98,
   "text": "گوش که صدای ناله اون بچه رو می‌شنوه، گوش نمی‌لرزه، گوش نمی‌سوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.98,
   "end": 236.58,
   "text": "حس لمست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.58,
   "end": 239.46,
   "text": "سمعت، بصرت، شمّت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.46,
   "end": 241.88,
   "text": "اینا نمی‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.88,
   "end": 245.86,
   "text": "چی می‌سوزه؟ میگی دلم می‌سوزه، دلم سوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.86,
   "end": 250.66,
   "text": "این دل کو؟ الان خب چشمت داره می‌بینه، گوشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.66,
   "end": 254.92,
   "text": "داره می‌شنوه، دستت لمست اینا همه کار می‌کنن شمّت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.92,
   "end": 257.0,
   "text": "ذائقت. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.0,
   "end": 259.66,
   "text": "سوختن رو یا میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.66,
   "end": 263.28,
   "text": "خوشم اومد به دلم نشست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.28,
   "end": 267.4,
   "text": "یا میگی بدم اومد. اگرچه میگی از چشمم افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.4,
   "end": 271.04,
   "text": "اما حوزه محبت و نفرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.04,
   "end": 273.32,
   "text": "حوزه تعلقات کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.32,
   "end": 277.44,
   "text": "قلبه. اینجا نشون می‌ده پیداست که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.44,
   "end": 280.24,
   "text": "رتبه‌ای ما تو وجودمون داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.24,
   "end": 285.46,
   "text": "که اون رتبه فرق می‌کنه با چشم و گوش و دست و پا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.46,
   "end": 288.34,
   "text": "نمی‌دونم قوه شامه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.34,
   "end": 292.74,
   "text": "ذائقه و اینها با اینا متفاوته با اینا، بلکه امیر این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.74,
   "end": 294.52,
   "text": "اون بر این‌ها ریاست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.52,
   "end": 303.76,
   "text": "بحث ما اونه. چی می‌شه که یکی نگاه می‌کنه یه منظره رو خوشش میاد، یکی نگاه می‌کنه همون منظره رو بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.76,
   "end": 309.34,
   "text": "چرا یکی آخوند رو می‌بینه لباس پیغمبر تنش کرده، اصلا کاری نداره این شخص کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.34,
   "end": 314.12,
   "text": "کرنش می‌کنه، خوشش میاد، آرامش پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.12,
   "end": 317.66,
   "text": "حتی معتقده که نگاه کردن به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.66,
   "end": 322.0,
   "text": "اهل علم، نگاه کردن به حتی درب منزل اهل علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.0,
   "end": 325.96,
   "text": "عبادته. نگاه می‌کنه. یکی هم همونه، همون آخوند و همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.96,
   "end": 330.58,
   "text": "منزل عالم رو نگاه می‌کنه با نفرت رویشو برمی‌گردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.58,
   "end": 334.0,
   "text": "اشکال به کجا برمی‌گرده؟ این که یک شخص واحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.0,
   "end": 337.28,
   "text": "به دل‌ها. دلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.28,
   "end": 340.92,
   "text": "نفرت پیدا می‌کنه با دلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.92,
   "end": 344.32,
   "text": "اتفاقا لذت می‌بره و محبتش قل قل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.32,
   "end": 348.84,
   "text": "این تفاوت دل‌ها از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.84,
   "end": 352.92,
   "text": "چی باعث می‌شه که یک دل نرم می‌شه، یک دل نمی...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.92,
   "end": 360.34,
   "text": "چی باعث می‌شه تو کربلا وقتی ابا عبدالله علی اصغرش رو بلند می‌کنه رو دست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 360.34,
   "end": 363.76,
   "text": "عده قلیلی از اونهایی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.76,
   "end": 367.14,
   "text": "صف دشمن و مر سعد ملعون بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.14,
   "end": 372.56,
   "text": "دلشون می‌لرزه عده قلیلی و یک همهمه‌ای تو لشکر ابن سعد می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.56,
   "end": 375.7,
   "text": "اصلا برای همین حرمله، حرمله ملعون رو صدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.7,
   "end": 379.72,
   "text": "حالا روز جشن اینطوری صحبت نکنیم مثالیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.72,
   "end": 383.26,
   "text": "حالا بحث روضه نیست می‌خوایم مثالی رو عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.26,
   "end": 386.4,
   "text": "که خوب متوجه بشیم. چرا یه عده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 386.4,
   "end": 390.62,
   "text": "دلشون لرزید؟ گفتن آقا ما که دیگه با بچه دعوا نداشتیم این چه وضعشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.62,
   "end": 393.02,
   "text": "چرا الان خیلیا که این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.02,
   "end": 398.96,
   "text": "توی دنیا آمریکا و اسرائیل خیانت کرده بودن جنایت کرده بودن دلشون نلرزیده بود اما اخیرا توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.96,
   "end": 405.14,
   "text": "جبهه اخیر و بمبارون غزه خیلی‌ها دلشون لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.14,
   "end": 407.86,
   "text": "چرا؟ این برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.86,
   "end": 411.7,
   "text": "به تفاوت اون دل‌ها، نگاه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.7,
   "end": 415.88,
   "text": "که وقتی این دل، دل چشم، چشم تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.88,
   "end": 420.24,
   "text": "تصرف قلبه. البصره برید القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.24,
   "end": 422.62,
   "text": "چشم جاسوس قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.62,
   "end": 426.52,
   "text": "قلب میگه چی رو ببین و از چی خوشت بیاد، از چی بدت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.52,
   "end": 430.88,
   "text": "وقتی یکی خوشش میاد یکی بدش میاد برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 430.88,
   "end": 434.66,
   "text": "تغییر و تخلف در دل‌ها، در تقلب دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.66,
   "end": 439.18,
   "text": "اسمش رو خودشه. متقلبه، منقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.18,
   "end": 442.28,
   "text": "یعنی دائما دگرگونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.28,
   "end": 445.18,
   "text": "حالا چرا بعضی دل‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 445.18,
   "end": 449.06,
   "text": "نرم‌اند بعضیا قسی و سخت‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.06,
   "end": 455.32,
   "text": "چراش رو اجازه بدید که در یک دعایی منتسب به امیرالمؤمنین علیه‌الصلاة والسلام بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.32,
   "end": 460.74,
   "text": "که معمولا ما از این بخش از این دعای مولا که خیلی دعای شریفی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 460.74,
   "end": 464.24,
   "text": "در اثبات لایه‌های وجودی خودمون بهره می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.24,
   "end": 468.02,
   "text": "می‌گیم آقا ببینید این فرمایش مولا رو ببینید داره نشون میده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.02,
   "end": 470.98,
   "text": "لایه‌های متعدد در وجودمون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.98,
   "end": 473.32,
   "text": "مراتب متعدد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.32,
   "end": 478.3,
   "text": "ذو مراتبیم. البته سید حیدر آملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.3,
   "end": 481.84,
   "text": "صاحب کتاب جامع الاسرار، اون جامع الاسرار عجیبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.84,
   "end": 483.92,
   "text": "در انوارالحقیقه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.92,
   "end": 486.48,
   "text": "دعا رو از امیرالمؤمنین نقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.48,
   "end": 488.5,
   "text": "علامه سنزدی هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.5,
   "end": 490.9,
   "text": "هزار و یک نکته‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.9,
   "end": 494.14,
   "text": "از کتاب بحر المعارف مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.14,
   "end": 497.34,
   "text": "عبدالصمد همدانی نقل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.34,
   "end": 500.56,
   "text": "این دو تا سندش هم عرض کردم دو تا کتاب خیلی محکم و خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.56,
   "end": 506.98,
   "text": "سه تا، سه تا کتاب عالی. مولا عرض می‌کنه که اللهم نور باطنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.98,
   "end": 511.36,
   "text": "بطاعتك. خدایا ظاهر منو به اطاعت خودت نورانی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.36,
   "end": 514.98,
   "text": "این نشون میده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.98,
   "end": 517.6,
   "text": "ظاهرمون با اطاعت الهی نورانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.6,
   "end": 524.22,
   "text": "تازه می‌فهمیم چرا مثلا ظاهرا عبادت می‌کنیم، نماز شب می‌خونیم، ظاهرمون هم نورانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.22,
   "end": 526.98,
   "text": "وباطنی بمحبتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.98,
   "end": 530.54,
   "text": "باطنم رو به محبت خودت نورانی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.54,
   "end": 534.12,
   "text": "اون نور به همه می‌خوره. یعنی مرجع اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.12,
   "end": 537.24,
   "text": "رجوع می‌کنه این ضمائر به اون نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.24,
   "end": 538.82,
   "text": "نور، نور، نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.82,
   "end": 543.06,
   "text": "حالا باز اینجا مشخص می‌شه ما یه ظاهر داریم، یه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.06,
   "end": 546.16,
   "text": "باطن‌مون به اطاعت نورانی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.16,
   "end": 550.1,
   "text": "ظاهرمون، ظاهرمون به اطاعت نورانی می‌شه باطن‌مون با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.1,
   "end": 554.68,
   "text": "محبت. اصلا ظرف و وعاء محبت باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.68,
   "end": 557.34,
   "text": "بریم جلوتر. این دو تا رتبه وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.34,
   "end": 560.34,
   "text": "وقلبي بمعرفتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.34,
   "end": 563.08,
   "text": "و قلبی بحث قلب رو مولا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.08,
   "end": 566.32,
   "text": "نشون میده که یه رتبه دیگه از وجود ما قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.32,
   "end": 570.42,
   "text": "خب وعاء معرفت رو اینجا مولا چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 570.42,
   "end": 572.58,
   "text": "مشخص می‌کنه؟ قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.58,
   "end": 575.9,
   "text": "ظرف، ظرف معرفت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.9,
   "end": 577.74,
   "text": "وقلبي بمعرفتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.74,
   "end": 579.58,
   "text": "پس قلب به چی نورانی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.58,
   "end": 583.54,
   "text": "به معرفت. همون که ملا محسن فیض در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.54,
   "end": 587.3,
   "text": "معنای لقاء الله در کلمات مکنونه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.3,
   "end": 590.18,
   "text": "که می‌فرماید المعرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.18,
   "end": 594.26,
   "text": "بَوَرُ المشاهدة. کسی می‌خواد به شهود برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.26,
   "end": 597.2,
   "text": "اشهدو بگه. اشهد، شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 597.2,
   "end": 599.4,
   "text": "شهید بشه، شاهد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 599.4,
   "end": 602.22,
   "text": "به مقام شهود برسه راهش معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 602.22,
   "end": 604.3,
   "text": "خب معرفت کجا جمع می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.3,
   "end": 606.48,
   "text": "ظرف معرفت کجاست؟ تو چشمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.48,
   "end": 608.26,
   "text": "تو گوشه؟ کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.26,
   "end": 611.18,
   "text": "تو فکر و مغز و عقل و ایناست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.18,
   "end": 614.68,
   "text": "نخیر. وقلبي بمعرفتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.68,
   "end": 617.4,
   "text": "قلب با معرفت عجین می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.4,
   "end": 620.6,
   "text": "که اینجا داره مشخص می‌کنه. حالا بذارید دعا رو تموم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.6,
   "end": 623.0,
   "text": "اینم یه رتبه. و روحي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.0,
   "end": 625.29,
   "text": "پس پیداست روح با قلب فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.29,
   "end": 628.64,
   "text": "یه رتبه دیگه‌ست. و روحي کارکرد روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 628.64,
   "end": 630.92,
   "text": "بمشاهدتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.92,
   "end": 632.96,
   "text": "روح اونجایی‌ست که به شهود می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 632.96,
   "end": 637.96,
   "text": "پس قلب با معرفت انسان رو به مرحله روح که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.96,
   "end": 640.58,
   "text": "غذاش شهوده می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.58,
   "end": 642.22,
   "text": "باز رتبه بعدی تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 642.22,
   "end": 644.58,
   "text": "نخیر. رتبه بعدی. وسري،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.58,
   "end": 649.38,
   "text": "وسري عجب! یعنی به جز قلب و روح و اینا ما یک سر هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 649.38,
   "end": 651.9,
   "text": "وسري غذای سر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 651.9,
   "end": 653.76,
   "text": "به استقل-- به چی نورانی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.76,
   "end": 657.7,
   "text": "باستقلال اتصال حضرتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 657.7,
   "end": 663.74,
   "text": "حالا اینو باید به وقتش خودش یه منبر بشه اینا رو توضیح بدیم انشاالله در حد فهم و درکمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 663.74,
   "end": 666.7,
   "text": "و الا كهنشو که نمی‌فهمیم. به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 666.7,
   "end": 670.86,
   "text": "اتصال، باستقلال اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 670.86,
   "end": 674.6,
   "text": "حضرتك که دیگه اون جای حضور، جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.6,
   "end": 677.26,
   "text": "زیارت. الهی تو عرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.26,
   "end": 681.14,
   "text": "الهی تردد فی الآثار یوجب بعد المزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 681.14,
   "end": 684.78,
   "text": "زیارت، زیارتگاه، محل زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.78,
   "end": 687.1,
   "text": "و اون ز-- حضور، رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 687.1,
   "end": 690.46,
   "text": "چون زیارت یعنی حضور زائر عند المزور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 690.46,
   "end": 693.5,
   "text": "مزار کجاست؟ زیارت کجا اتفاق می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.5,
   "end": 696.22,
   "text": "حضرت یعنی اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 696.22,
   "end": 698.82,
   "text": "محل حضورشه و زیارت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.82,
   "end": 700.74,
   "text": "اونجا کجاست؟ در سر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.74,
   "end": 703.74,
   "text": "حالا سر چیه؟ مرتبه مافوق روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 703.74,
   "end": 706.3,
   "text": "که روح هرچی می‌گیره از سر می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 706.3,
   "end": 708.74,
   "text": "از طریق سر متصل می‌شه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 708.74,
   "end": 711.64,
   "text": "عوالم هستی. يا ذا الجلال والاكرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 711.64,
   "end": 715.48,
   "text": "ذکر چه روزیه؟ روز یکشنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 715.48,
   "end": 717.32,
   "text": "يا ذا الجلال والاكرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 717.32,
   "end": 719.5,
   "text": "اسماء جلال و جمال رو جمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 719.5,
   "end": 722.46,
   "text": "حالا برگردیم به مت-- به بحثمون و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 722.46,
   "end": 728.34,
   "text": "الان متوجه می‌شیم که وجه اختلاف قلب‌ها در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 728.34,
   "end": 733.24,
   "text": "در داشتن یا نداشتن یا شدت و ضعف معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 733.24,
   "end": 735.54,
   "text": "چرا یه قلبی نرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 735.54,
   "end": 737.5,
   "text": "قلب لن داره یا لئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 737.5,
   "end": 740.98,
   "text": "یه قلبی هم قلب قسیه، سخته، محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 740.98,
   "end": 744.96,
   "text": "هرچی نگاه می‌کنه این همه جنایت اسرائیل‌ها اصلا تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 744.96,
   "end": 748.2,
   "text": "تازه میگه بزنید بکشید. چه داخل، چه خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 748.2,
   "end": 750.68,
   "text": "علتش چیه؟ بی‌معرفتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 750.68,
   "end": 754.24,
   "text": "یعنی این دل، این قلب خالی از معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 754.24,
   "end": 756.7,
   "text": "شناخت نداره. نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 756.7,
   "end": 760.72,
   "text": "که اون عدم شناخت سرش داده سر مسائل دیگه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 760.72,
   "end": 763.74,
   "text": "انشاالله بعدا بحث می‌کنیم که اون‌ها دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 763.74,
   "end": 767.3,
   "text": "نشانه‌های اوج قساوت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 767.3,
   "end": 770.14,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 770.14,
   "end": 772.46,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 772.46,
   "end": 775.42,
   "text": "اللهumma صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}