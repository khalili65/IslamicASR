   "title": "## شکر پیروزی و شهدا",
   "start": 0.48,
   "end": 182.68
  },
  {
   "index": 1,
   "title": "## قلب لیّن و دست بر سر یتیم",
   "start": 182.68,
   "end": 272.08
  },
  {
   "index": 2,
   "title": "## اشدّ الیتیم؛ منقطع از امام",
   "start": 272.08,
   "end": 453.45
  },
  {
   "index": 3,
   "title": "## حماسهٔ دیشب؛ آمار و سامانه‌ها",
   "start": 453.45,
   "end": 610.25
  },
  {
   "index": 4,
   "title": "## خنکی دل حجّت و یزید زمان",
   "start": 610.25,
   "end": 1085.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 3.54,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.54,
   "end": 6.96,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.96,
   "end": 9.24,
   "text": "و ربانی آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.24,
   "end": 11.2,
   "text": "سلام خدا بر همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.2,
   "end": 13.72,
   "text": "رزمندگان اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 13.72,
   "end": 16.72,
   "text": "و همه شما دلشدگان راه ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 16.72,
   "end": 20.52,
   "text": "انشاالله که این پیروزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 20.52,
   "end": 23.6,
   "text": "بزرگی که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 23.6,
   "end": 25.92,
   "text": "به برکت خون شهدا رقم زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 25.92,
   "end": 28.54,
   "text": "به کام همه ملت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 28.54,
   "end": 31.12,
   "text": "مسلمان و مستضعف شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 31.12,
   "end": 32.84,
   "text": "باشه که هست انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 32.84,
   "end": 35.82,
   "text": "ما واقعا نمی‌دونم این شهدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 35.82,
   "end": 39.88,
   "text": "سفارت چقدر پیش خدا آبرو داشتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 39.88,
   "end": 43.8,
   "text": "منجر به یک چنین حرکت عظیمی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 43.8,
   "end": 46.6,
   "text": "من واقعا تبریک میگم تو پوست خودم نمی‌گنجم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 46.6,
   "end": 48.26,
   "text": "می‌بینم شما هم همچنین هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 48.26,
   "end": 50.72,
   "text": "همه واقعا همه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 50.72,
   "end": 56.26,
   "text": "خیلی رفتارهای شیرین و عالی و دیدنی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 56.26,
   "end": 59.7,
   "text": "کارارهای فضای مجازی یه طور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 59.7,
   "end": 65.54,
   "text": "خود مردم عادی تو کف خیابون یه طور از دیشب دیدیم خیلیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 65.54,
   "end": 68.34,
   "text": "تا سحر تا صبح بیدار بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 68.34,
   "end": 72.66,
   "text": "و به هرکی رسیدیم می‌گفت شب نخوابیدم از ذوق، از شوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 72.66,
   "end": 75.24,
   "text": "مثلا مادرم وقتی شنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 75.24,
   "end": 78.28,
   "text": "اسرائیل رو زدیم جیغ زد از خوشحالی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 78.28,
   "end": 82.2,
   "text": "چقدر کاربران، کاربرای فضای مجازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 82.2,
   "end": 86.24,
   "text": "الحمد لله با سواد رسانه‌ای خوبی که دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 86.24,
   "end": 89.22,
   "text": "اطلاعات خوبی انتقال دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 89.22,
   "end": 92.56,
   "text": "و عکس و فیلم‌های قشنگی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 92.56,
   "end": 96.4,
   "text": "پخش کردن. عرض شود خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 96.4,
   "end": 102.96,
   "text": "حالا البته ما امروز بحثمون قرار بود که قلب اللعن یا اللین باشه و بی‌ربط هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 102.96,
   "end": 105.56,
   "text": "الان عرض می‌کنم در دل بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 105.56,
   "end": 109.4,
   "text": "که چگونه ربط داره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 109.4,
   "end": 111.84,
   "text": "اینقدر که خوشحالیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 111.84,
   "end": 118.16,
   "text": "شور و شعف ما رو گرفته، من دیدم حتی بعضی از همکارا میزشون رو پر کردن از شکلات و شیرینی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 118.16,
   "end": 120.28,
   "text": "نسکافه و به همه بفرما می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 120.28,
   "end": 125.14,
   "text": "تو خیابون مردم همین شکل. الحمد لله واقعاً هم همین حقش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 125.14,
   "end": 127.78,
   "text": "خدا سایه رهبر رو سرمون حفظ کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 127.78,
   "end": 133.38,
   "text": "و روح سردار دل‌ها شهید سلیمانی و خاصه پدر موشکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 133.38,
   "end": 138.84,
   "text": "ایران شهید تهرانی مقدم، شهید فخ-- شهید فخری‌زاده که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 138.84,
   "end": 146.22,
   "text": "پیشبرد صنعت فضایی و هسته‌ای خیلی فعال بودند شاد، روح همشون شاد باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 146.22,
   "end": 148.14,
   "text": "و واقعاً نمی‌دونم چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 148.14,
   "end": 153.4,
   "text": "خبرها به شما رسیده و به همه رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 153.4,
   "end": 155.64,
   "text": "همه توی شور و شعف خاصی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 155.64,
   "end": 158.12,
   "text": "می‌بینید که معادلات دنیا عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 158.12,
   "end": 161.18,
   "text": "زبان حال دشمن و دوست نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 161.18,
   "end": 163.04,
   "text": "ایران عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 163.04,
   "end": 169.48,
   "text": "زبان دیپلماسی حتی بدترین دشمنان ما مثل آمریکا با ما عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 169.48,
   "end": 173.88,
   "text": "ا اون که تهدید می‌کرد حالا چنان مرعوب شده که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 173.88,
   "end": 176.24,
   "text": "نتانیاهو میگه دست به حمله نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 176.24,
   "end": 180.54,
   "text": "دست-- نمی‌دونم با-- بذار با دیپلماتیک قصه رو حل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 180.54,
   "end": 184.7,
   "text": "و ام سالوم. من اجازه می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 184.7,
   "end": 190.22,
   "text": "چون در دل بحث قلب اللعن هستیم نکته‌ای رو عرض کنم و ربطش رو به موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 190.22,
   "end": 198.1,
   "text": "اونم اینکه اگر چنانچه خاطرتون باشه آخرین باری که مبحث قلب اللعن رو داشتیم در محضر دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.1,
   "end": 200.7,
   "text": "عرض کردیم که بعداً توضیح میدیم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 200.7,
   "end": 205.06,
   "text": "بهترین شیوه‌ها و راه‌هایی که دل رو نرم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.06,
   "end": 208.64,
   "text": "دست کشیدن سر یتیم و رسیدگی به یتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 208.64,
   "end": 213.78,
   "text": "دستگیری از یتیم، شاد کردن دل یتیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 213.78,
   "end": 219.32,
   "text": "اتفاقاً یه به همین مناسبت روایتی رو تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.32,
   "end": 222.58,
   "text": "روایت خیلی عالی‌ست، خیلی شیرینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.58,
   "end": 224.94,
   "text": "و منابع زیادی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.94,
   "end": 227.08,
   "text": "در بحار جلد صد و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.08,
   "end": 229.2,
   "text": "صفحه صد و هفتاد و یک می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 229.2,
   "end": 233.28,
   "text": "احتجاج جلد یک صفحه شصت و شش می‌تونید روایت رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 233.28,
   "end": 237.88,
   "text": "تفسیر منسوب به امام عسکری سلام الله علیه هست که این تفسیر می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 237.88,
   "end": 242.26,
   "text": "منتسب به آقاست. فرمایشات حضرت درش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 242.26,
   "end": 245.62,
   "text": "چون روایت از امام عسکری سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 245.62,
   "end": 250.68,
   "text": "وارد شده که حدثنا ابو محمد الحسن بن علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.68,
   "end": 253.34,
   "text": "یعنی برای ما حدیث کردن امام عسکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 253.34,
   "end": 258.52,
   "text": "العسکری علیه السلام قال حدثنی، ایشون فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 258.52,
   "end": 260.92,
   "text": "به من حدیث کردن. ابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 260.92,
   "end": 263.66,
   "text": "ان ابائه الرسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 263.66,
   "end": 267.78,
   "text": "که یعنی از پدرم از اجدادشون هم تو آبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 267.78,
   "end": 273.62,
   "text": "و پدرانشون تا رسول خدا یعنی منتسب کردن به پیغمبر فرمایش رو که عنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 273.62,
   "end": 276.86,
   "text": "وقال که پیغمبرش این چنین فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 276.86,
   "end": 279.66,
   "text": "اشد من یتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 279.66,
   "end": 283.7,
   "text": "یتیم الذي انقطع عن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 283.7,
   "end": 291.44,
   "text": "امه و ابیه. فرمودند که سخت‌تر از یتیم جدا شده از پدر و مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 291.44,
   "end": 298.7,
   "text": "کیه؟ یعنی یتیم یعنی کسی که پدر مادر-- بدون پدر و مادر مونده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.7,
   "end": 304.02,
   "text": "یتیم الصغیر. حالا می‌فرماید حضرت داره می‌فرماید اشد من یتم یتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.02,
   "end": 307.18,
   "text": "حالا شدیدتر از این یتیم کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.18,
   "end": 310.4,
   "text": "به یک معنا میشه گفت یتیم واقعی کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.4,
   "end": 315.28,
   "text": "یتم یتیم من انقطع عن امامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.28,
   "end": 319.86,
   "text": "ولا يقدر على الوصول الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.86,
   "end": 325.88,
   "text": "می‌فرماید اون کسیه که از امامش منقطع شده، دور افتاده و قادر نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.88,
   "end": 327.84,
   "text": "به محضر امامش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.84,
   "end": 330.1,
   "text": "مثل ما. مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.1,
   "end": 334.24,
   "text": "ایتام آل پیغمبر از سر تا سر دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.24,
   "end": 340.1,
   "text": "ولا يدری كيف حكمه فيما يبتلی به من شرائع دينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.1,
   "end": 343.36,
   "text": "به اونچه که مبتلا بهشه و گرفتارشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.36,
   "end": 346.52,
   "text": "احکام دین، شرائع و قوانین دین رو اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.52,
   "end": 350.56,
   "text": "لا يدری. اینا رو نمی‌دونه و نمی‌دونه حکمش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.56,
   "end": 353.82,
   "text": "به جهت اینکه دسترسی به امامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.82,
   "end": 355.42,
   "text": "الا فمن به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.42,
   "end": 360.2,
   "text": "الا فمن کان من شيعتنا عالما بعلومنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.2,
   "end": 363.92,
   "text": "و هذا الجاهل بشريعتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.92,
   "end": 367.59,
   "text": "المنقطع عن مشاهدتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 367.59,
   "end": 371.45,
   "text": "یتیم فی حجرہ الا فمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.45,
   "end": 374.93,
   "text": "هداه می فرمود حواستون باشه الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.93,
   "end": 380.49,
   "text": "رو به دنیا کسی که از شیعه ما عالم باشه به علوم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.49,
   "end": 389.29,
   "text": "و بره سراغ این کسانی که منقطع‌اند از شریعت ما، از قانون دین ما جاهلن نمیدونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.29,
   "end": 391.73,
   "text": "و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.73,
   "end": 394.29,
   "text": "مشاهده ما یتیم موندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.29,
   "end": 397.41,
   "text": "دور افتادن، دور از ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.41,
   "end": 399.91,
   "text": "فرمودن که این کسا رو الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.91,
   "end": 404.25,
   "text": "فمن هداه و ارشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.25,
   "end": 407.13,
   "text": "و علمه شریعتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.13,
   "end": 411.15,
   "text": "الله اکبر. حضرت امام عسکری سلام الله علیه فرمود هر کس دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 411.15,
   "end": 415.83,
   "text": "یتیما رو به چه گونه‌ای بگیره هدایتشون کنه، ارشادشون کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.83,
   "end": 420.55,
   "text": "شریعت رو بهشون یاد بده. کان معنا فی رفیق اعلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.55,
   "end": 429.25,
   "text": "معنا که این کسی در اون اعلا مرتبه بهشت در مقام رفیق اعلا معنا همراه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.25,
   "end": 432.49,
   "text": "این یتیم واقعی و واقعا الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.49,
   "end": 442.09,
   "text": "چی یتیم‌تر از ماهاست که در دوران غیبت هستیم که اللهم انا نشکو الیک فقد نبینا و غیبت ولینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.09,
   "end": 446.95,
   "text": "و ایتام آل پیغمبر در سرتاسر دنیا مستضعفین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.95,
   "end": 451.49,
   "text": "و محرومین که همه چشم انتظار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.49,
   "end": 453.45,
   "text": "فرج حضرت صاحب الامر هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.45,
   "end": 460.05,
   "text": "دیدید با افتخاری که دیره-- دیشب بچه های سپاه آفریدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.05,
   "end": 463.19,
   "text": "چه دلی خنک شد، چه جیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.19,
   "end": 465.55,
   "text": "خنک شد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.55,
   "end": 470.83,
   "text": "ملت مظلوم و گرفتار از همین یتیمان آل پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.83,
   "end": 477.71,
   "text": "در حقیقت دیشب بزرگترین یتیم نوازی توسط بچه های سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.71,
   "end": 482.03,
   "text": "و عرض شود رهنوردان راه ولایت و شهدا انجام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.03,
   "end": 484.63,
   "text": "ما دست تک تکشون رو می بوسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.63,
   "end": 488.75,
   "text": "که چه، چه کردن، چه حماسه ای آفریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.75,
   "end": 493.33,
   "text": "حتی خود ما هم شاید فکر نمیکردیم، تصور نمیکردیم تا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.33,
   "end": 499.71,
   "text": "به این شدت و به این عظمت کار انجام بشه که بیش از پونصد پهپاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.71,
   "end": 504.83,
   "text": "پرواز کنه و بیش از صد و پنجاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.83,
   "end": 507.29,
   "text": "عرض شود موشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.29,
   "end": 511.91,
   "text": "و البته خودشون به اذعان خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.91,
   "end": 515.71,
   "text": "گفتند که با اینکه ما اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.71,
   "end": 518.19,
   "text": "سه تا لایه سامانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.19,
   "end": 520.47,
   "text": "ردیابی هوایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.47,
   "end": 524.27,
   "text": "حالا اولیش گنبد آهنین در اسرائیل وجود داره، بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.27,
   "end": 526.81,
   "text": "فلاخن داوود، بعد پیکانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.81,
   "end": 532.51,
   "text": "با این حال گفتند که-- خودشون اعلام کردن که برای پدافند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.51,
   "end": 537.05,
   "text": "این موشک‌ها و حمله ایران، ده تا کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.05,
   "end": 541.15,
   "text": "که مدعی قدرت دنیا هستند از جمله آمریکا و فرانسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.15,
   "end": 546.21,
   "text": "و انگلیس و اینها همراهی کردن در ره-- ردیابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.21,
   "end": 548.31,
   "text": "و رهزنی مثلا موشک‌های ایرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.31,
   "end": 550.05,
   "text": "اما دیدید که نتونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.05,
   "end": 552.85,
   "text": "خب تا خود سامانه گنبد آهنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 552.85,
   "end": 555.01,
   "text": "اصلا میگن از کار افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.01,
   "end": 558.39,
   "text": "با همون ضربات اولیه. که البته این سامانه می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.39,
   "end": 563.07,
   "text": "ضد راکت توپخونه است، خمپاره و دفاع هواییه برای سطح مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.07,
   "end": 572.41,
   "text": "اون کوتاه برده. بعد فلاخن داوود ما رو میان برده، اون سامانه پیکان ما رو حتی تا فوق جو رو هم رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.41,
   "end": 579.23,
   "text": "و جالبه که ایران بدون اینکه از اصل غافلگیری استفاده کنه با خبر قبلی حمله کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.23,
   "end": 583.47,
   "text": "بعد سه ساعت هم گفتن طول کشیده تا این موشک‌ها و پهپادها برسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.47,
   "end": 589.19,
   "text": "به اسرائیل. با این حال یعنی در بالاترین سطح ممکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.19,
   "end": 596.25,
   "text": "آمادگی اسرائیل قرار داشته باش، باز این همه دیگه حداقل حداقلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.25,
   "end": 598.37,
   "text": "پنجاه درصد موشک‌ها به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.37,
   "end": 602.75,
   "text": "به هدف اصلیشون برخورد کردن که بعضیا تا هفتاد درصد هم گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.75,
   "end": 605.97,
   "text": "و این جیگری که از ایتام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.97,
   "end": 608.35,
   "text": "آل پیغمبر خنک شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.35,
   "end": 613.21,
   "text": "یکی از بزرگترین کارها. به نظرم اگر درست رصد کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.21,
   "end": 615.67,
   "text": "این علت این شیرینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.67,
   "end": 618.41,
   "text": "دل ما-- دیدید وقتی سردار رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.41,
   "end": 621.81,
   "text": "بی‌اختیار عموم مردم گریان و محزون شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.81,
   "end": 624.85,
   "text": "الان می‌بینید بی‌اختیار همه شادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.85,
   "end": 629.49,
   "text": "حتی عجیبه بعضیا که اصلا خیلی انقلابی هم نیستن شاید حتی انقلابم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 629.49,
   "end": 631.73,
   "text": "قبول ندارن و اینها و خیلی هم منتقدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.73,
   "end": 635.79,
   "text": "اینام جیگراشون شاد شده، خنک شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.79,
   "end": 637.99,
   "text": "خوشحال شدن. اینام شادن بی‌اختیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.99,
   "end": 640.57,
   "text": "به نظر بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.57,
   "end": 642.77,
   "text": "اگر شما بپذیرید همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.77,
   "end": 649.81,
   "text": "دل امام عصر در زدن سردار خون شده بود که عالم محزون شده بود و همه بی‌اختیار گریه می‌کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.81,
   "end": 653.31,
   "text": "الانم دل امام عصر خنک شده همه شادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.31,
   "end": 656.11,
   "text": "اینو از بنده بپذیرید. باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.11,
   "end": 661.19,
   "text": "ما می‌تونیم بگیم بزرگترین دشمن، یکی از بزرگترین دشمن‌های ولایت رو زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.19,
   "end": 663.55,
   "text": "ما اصلا یزید زمان رو زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.55,
   "end": 665.85,
   "text": "دشمن امام عصرمون رو دیشب زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.85,
   "end": 669.49,
   "text": "اتفاق کمی رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 669.49,
   "end": 673.89,
   "text": "به قول خودشون اصلا دیپلماسی رو ریختیم به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 673.89,
   "end": 678.11,
   "text": "همه چی عوض شد. معادلات از این به بعد همه عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 678.11,
   "end": 684.87,
   "text": "خودشون دارن میگن که این حمله بی‌سابقه‌ترین، تاریخی‌ترین، تأمین کننده‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 684.87,
   "end": 687.93,
   "text": "عرض شود سرنوشت‌سازترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 687.93,
   "end": 697.01,
   "text": "چه عرض کنیم، بزرگترین-- حتی CNN، CNN اعلام کرد بزرگترین حمله پهپادی در تاریخ دنیا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 697.01,
   "end": 699.61,
   "text": "کار کمی صورت نگرفته. اون هم کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 699.61,
   "end": 702.67,
   "text": "به هیچ کدوم از مراکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 702.67,
   "end": 707.31,
   "text": "مسکونی نه، اقتصادی و تجاری حتی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 707.31,
   "end": 710.05,
   "text": "به مراکز نظامی. اونم کجاها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.05,
   "end": 713.15,
   "text": "جاهایی مثل در-- تو مرز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 713.15,
   "end": 717.57,
   "text": "عرض شود جبل الشيخ و سوریه، اونجا که پایگاه اطلاعاتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.57,
   "end": 722.19,
   "text": "نواتیم، این پایگاه‌های خاص، پایگاه‌های هوایی رامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.19,
   "end": 727.53,
   "text": "اینا جاهای کمی نیستن که خودشون میگن حداقل تو نواتیم چهل و چهار افسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.53,
   "end": 731.21,
   "text": "نظامی موساد به درک واصل شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 731.21,
   "end": 734.01,
   "text": "اینا چیزای کمی نیست. تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.01,
   "end": 737.01,
   "text": "عرض شود پایگاه هوایی رامون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 737.01,
   "end": 740.53,
   "text": "سپاه اونجا رو زده گفتن محل استقرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.53,
   "end": 744.15,
   "text": "هواپیماهای اف16، محل استقرار یگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 744.15,
   "end": 746.27,
   "text": "هلیکوپترهای آپاچیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 746.27,
   "end": 749.63,
   "text": "جای کمی نبود یا همون نواتیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 749.63,
   "end": 754.61,
   "text": "عرض شود خدمتتون میدونید که شاید مستحضر باشید در صحرای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 754.61,
   "end": 761.33,
   "text": "النقب نزدیک شهر بهر السبع طول باند فرودگاهی که اونجا سه هزار و چهارصد متره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 761.33,
   "end": 763.51,
   "text": "آشیانه و پایگاه مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 763.51,
   "end": 766.45,
   "text": "جنگنده‌های اف35 هم اونجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.45,
   "end": 772.25,
   "text": "حضور اسکادران صد و سه سوپر دولوکس های ترابری و پشتیبانی اونجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 772.25,
   "end": 776.19,
   "text": "حضور اسکادران عملیاتی صد و شونزده و صد و چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 776.19,
   "end": 778.97,
   "text": "جنگنده‌های اف35 باز اونجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 778.97,
   "end": 785.59,
   "text": "حضور اسکادران آموزشی صد و هفده تربیت خلبان اف35 باز هم اونجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 785.59,
   "end": 790.69,
   "text": "حضور اسکادران صد و بیست و دو جاسوسی اطلاعاتی رژیم صهیونیستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 790.69,
   "end": 793.67,
   "text": "اونجا بوده. آشیانه هواپیماهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 793.67,
   "end": 796.19,
   "text": "ویژه ریاست جمهوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 796.19,
   "end": 799.89,
   "text": "رژیم منحوس اسرائیل اونجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 799.89,
   "end": 802.53,
   "text": "مقر عده زیادی از عناصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 802.53,
   "end": 805.19,
   "text": "ارشد جاسوسی رژیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 805.19,
   "end": 807.93,
   "text": "غاصب اونجا بوده. محلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 807.93,
   "end": 814.81,
   "text": "اتفاقا خوبه بدونیم اعلام هم شد محلی که هواپیماهایی که کنسول گری ایران رو زدن بلند شد از همین جا پا شدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 814.81,
   "end": 818.05,
   "text": "چه زیبا که بچه های سپاه همونجا رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 818.05,
   "end": 825.11,
   "text": "و اقرار جهان الان اینه که متکثرترین عملیات موشکی تاریخ ایران بلکه جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 825.11,
   "end": 828.55,
   "text": "صورت گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 828.55,
   "end": 832.29,
   "text": "بزرگترین آفند تاریخ ایران بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 832.29,
   "end": 835.61,
   "text": "دفاع مقدسش بوده. اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 835.61,
   "end": 839.29,
   "text": "دستاوردهای بسیار بزر-- حالا بعدا انشاالله یکی یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 839.29,
   "end": 842.71,
   "text": "خودش رو نشون میده و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 842.71,
   "end": 846.11,
   "text": "به قولی نمیتونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 846.11,
   "end": 849.49,
   "text": "خورشید نمیتونه خودش رو پنهان کنه پشت ابر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 849.49,
   "end": 852.57,
   "text": "بالاخره هرچی هم ابرها بیان جلوشو بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 852.57,
   "end": 854.89,
   "text": "این بالاخره نورش همه جا رو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 854.89,
   "end": 857.95,
   "text": "با اینکه اینها اسرائیلی‌ها نخواستن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 857.95,
   "end": 862.21,
   "text": "حقایق فاش بشه اما دیدید که سر تا سر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 862.21,
   "end": 869.31,
   "text": "کشورها و شهرهایی که پهپادها و موشک‌ها حرکت می‌کردن و چه شیرین از بالای قدس که رد شدن آدم یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 869.31,
   "end": 876.19,
   "text": "راه قدس از کربلا می‌گذرد می‌افتاد وقتی از بین الحرمین و بال کربلا رد میشد یا از بالای قدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 876.19,
   "end": 878.15,
   "text": "این چقدر شیرین بودند این صحنه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 878.15,
   "end": 883.93,
   "text": "مردم کشورهای دیگه شاید بیش از ما خوشحال بودند از جیگرشون الله اکبر می‌گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 883.93,
   "end": 888.35,
   "text": "و عرض شود درود به رهبر عزیزمون می‌فرستادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 888.35,
   "end": 890.71,
   "text": "و، و، و خلاصه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 890.71,
   "end": 892.77,
   "text": "عرض کنم من میخوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 892.77,
   "end": 897.43,
   "text": "هر طور شده نمی‌دونم این شعف و نشاط درونیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 897.43,
   "end": 900.51,
   "text": "نشون بدم. نمی‌دونم چه باید بکنم واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 900.51,
   "end": 903.87,
   "text": "فقط می‌تونم بگم چشم روشنی داره به همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 903.87,
   "end": 907.19,
   "text": "من اگر جای مسئولین صدا و سیما بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 907.19,
   "end": 911.53,
   "text": "به همه همکارای حال اساسی می‌دادم، می‌ترکوندم واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 911.53,
   "end": 915.65,
   "text": "یه شاید یه پایه حقوق به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 915.65,
   "end": 918.53,
   "text": "این عیدی و چشم روشنی به همه می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 918.53,
   "end": 921.89,
   "text": "و، و چه، چه عرض کنیم به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 921.89,
   "end": 928.41,
   "text": "خوشحالیم سجده شکر به جا میاریم از خدای منان تشکر می‌کنیم و البته این اول ماجراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 928.41,
   "end": 932.01,
   "text": "این اول ماجراست و بحث قلب لاین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 932.01,
   "end": 937.15,
   "text": "در دل همین بحث مهم روز گفتیم که نمیشد نگیم واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 937.15,
   "end": 944.95,
   "text": "ا اونم فراموش نشه که برای نرم شدن دل عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 944.95,
   "end": 948.85,
   "text": "مخصوصا بعد از ماه مبارک رمضان که انسان از اون اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 948.85,
   "end": 953.13,
   "text": "عشق و بازی و هر روز روزه است کم میخوره، کم میخوابه، سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 953.13,
   "end": 955.87,
   "text": "شب زنده داری داره، هر روز ختم قرآن داره و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 955.87,
   "end": 958.35,
   "text": "یه دفعه میفته تو یه ورطه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 958.35,
   "end": 962.19,
   "text": "نفس یهو بحر زده میبینه دست شیاطین باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 962.19,
   "end": 965.15,
   "text": "ملائکه مقداری ازش دور شدند به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 965.15,
   "end": 967.11,
   "text": "اون دوریش از اون فضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 967.11,
   "end": 971.13,
   "text": "فضا کاملاً منقلب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 971.13,
   "end": 974.95,
   "text": "عرض شود عوض میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 974.95,
   "end": 979.41,
   "text": "تغییر میکنه و دیگه میبینه اون کم خوری‌ها، اون روزه‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 979.41,
   "end": 982.47,
   "text": "میبینه اون ختم قرآن متأسفانه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 982.47,
   "end": 985.47,
   "text": "و اون بیداری شب دل سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 985.47,
   "end": 989.09,
   "text": "و لو به بهانه سحری خوردن اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 989.09,
   "end": 992.21,
   "text": "ختم قرآن نیست. اینا بعد یه دفعه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 992.21,
   "end": 997.21,
   "text": "قبضی در قبضی-- در قلب انسان در وجود انسان ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 997.21,
   "end": 1001.59,
   "text": "دل به-- یه دفعه به سرعت به سمت انقباض میره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1001.59,
   "end": 1006.35,
   "text": "خشن میشه و باید سریع به دادش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1006.35,
   "end": 1010.53,
   "text": "این د-- باید اون نرمش دل رو نرمیش رو حفظ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1010.53,
   "end": 1016.63,
   "text": "با چی؟ با جایگزین. خب ما که دیگه هر روز که نمی‌تونیم روزه بگیریم توانش رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1016.63,
   "end": 1018.23,
   "text": "به جاش جایگزین بگذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1018.23,
   "end": 1022.29,
   "text": "یکی از بهترین جایگزین‌ها رسیدگی به یتیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1022.29,
   "end": 1025.75,
   "text": "رسیدگی به اونهایی که نیازمندن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1025.75,
   "end": 1029.13,
   "text": "یتیمن اصطلاحاً چه یتیمه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1029.13,
   "end": 1031.85,
   "text": "عرض شود جسمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1031.85,
   "end": 1034.15,
   "text": "یا به عبارتی میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1034.15,
   "end": 1038.93,
   "text": "نسبی که پدر و مادر نداره یا یتیم سببی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1038.93,
   "end": 1043.25,
   "text": "که به، به سبب دور ماندنش از mama و papa یتیم مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1043.25,
   "end": 1047.31,
   "text": "رسیدگی کنه آدم به این‌ها، این‌ها رو به حقایق ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1047.31,
   "end": 1049.79,
   "text": "نزدیک کنه و حتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1049.79,
   "end": 1057.99,
   "text": "جهاد تبیین بعد از این افتخار آفرین سپاهی شد خودش رو الان به بهترین وجه ممکن داره نشون میده که به چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1057.99,
   "end": 1060.17,
   "text": "شیرین کام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1060.17,
   "end": 1067.65,
   "text": "یتیم رو از شود شیرین کردن با خبرهای خوش، با تبیین درست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1067.65,
   "end": 1070.77,
   "text": "با آثار و برکات این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1070.77,
   "end": 1073.85,
   "text": "طوفان وعده صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1073.85,
   "end": 1077.63,
   "text": "به هر حال اینم یکی وجهه شد دیگه. اینم یکی وجه یتیم نوازیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1077.63,
   "end": 1082.39,
   "text": "و اس علاهاذا دیگه تو خود بخوان حدیث مفصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1082.39,
   "end": 1085.59,
   "text": "از این مجمل. والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}