 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ افزودن ماده به آب و سفیدشدن رنگ",
   "start": 0.72,
   "end": 49.46
  },
  {
   "index": 1,
   "title": "## حج/۵۳؛ فتنۀ القائات شیطان برای بیمار و قاسی‌القلب",
   "start": 49.46,
   "end": 109.3
  },
  {
   "index": 2,
   "title": "## المیزان؛ فتنه ناموس الهی و فرق مرض و قساوت",
   "start": 109.3,
   "end": 359.0
  },
  {
   "index": 3,
   "title": "## تشبیه مؤمن به زنبور و مریض‌دل به مگس",
   "start": 359.0,
   "end": 471.84
  },
  {
   "index": 4,
   "title": "## لاشۀ سگ و دندان سفید؛ حسن ظن مؤمن",
   "start": 471.84,
   "end": 560.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 4.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 7.8,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.8,
   "end": 12.04,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.04,
   "end": 16.6,
   "text": "استفتاء شده از رهبر عزیزمون که گاهی اوقات به آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.6,
   "end": 19.76,
   "text": "یه موادی رو اضافه می‌کنن که رنگ آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.76,
   "end": 22.36,
   "text": "سفید می‌شه مثل شیر مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.36,
   "end": 25.48,
   "text": "رنگش خیلی سفید می‌شه این آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.48,
   "end": 33.12,
   "text": "حالا همون آب لوله‌کشی حتی شهری گاهی اوقات یه چیزی بهش می‌زنن دقت کرده باشید خیلی رنگ آب به سفیدی می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.12,
   "end": 34.92,
   "text": "خب آیا این آب مزافه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.92,
   "end": 37.58,
   "text": "اگه مزاف باشه که نمی‌شه باهاش طهارت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.58,
   "end": 39.98,
   "text": "نمی‌شه وضو گرفت و غسل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.98,
   "end": 46.56,
   "text": "آقا فرمودن نه خه صرف اینکه این رنگ آب به این شکل دراومده آب مزاف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.56,
   "end": 49.46,
   "text": "اشکال نداره باهاش طهارت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.46,
   "end": 52.32,
   "text": "یکی دیگه از آیاتی که پیرامون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.32,
   "end": 56.84,
   "text": "قسی صحبت کرده، آیه پنجاه و سه سوره حجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.84,
   "end": 62.46,
   "text": "می‌فرماید که \"لیجعل ما یلقي الشيطان فتنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.46,
   "end": 69.42,
   "text": "فرمود که تا خدا به اون القاءات شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.42,
   "end": 72.9,
   "text": "بیاموزه. فتنه حالا یه معناش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.9,
   "end": 75.96,
   "text": "عذاب هست، یه معناش امتحان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.96,
   "end": 79.1,
   "text": "اینجا معنای امتحان و ابتلا رو می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.1,
   "end": 82.5,
   "text": "چه کس-- که چه کسانی رو خدا بیاموزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.5,
   "end": 84.74,
   "text": "چه کسانی رو امتحان کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.74,
   "end": 87.84,
   "text": "\"للذین في قلوبهم مرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.84,
   "end": 90.98,
   "text": "والقاسية قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.98,
   "end": 96.04,
   "text": "برای کسانی که تو دلشون مریضی وجود داره، دل مریض‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.04,
   "end": 98.54,
   "text": "و اون‌هایی که دلشون سخت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.54,
   "end": 102.74,
   "text": "\"وإن الظالمين لفي شقاق بعيد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.74,
   "end": 108.84,
   "text": "که قطعاً این‌هایی که ظلم می‌کنن، ستمکارن تو عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.84,
   "end": 111.8,
   "text": "سخت در ستیزه و دشمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.8,
   "end": 114.82,
   "text": "و دورن. دش-- در حال بعید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.82,
   "end": 116.74,
   "text": "در دشمنی دوری هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.74,
   "end": 119.04,
   "text": "دور از حق منظور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.04,
   "end": 121.82,
   "text": "حالا اینجا نکته‌ای رو تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.82,
   "end": 124.96,
   "text": "نور آقای قرائتی آورده که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.96,
   "end": 130.88,
   "text": "سنگدلی خودش یک نوع از انواع مریضی دل حساب می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.88,
   "end": 138.24,
   "text": "چطور اینجا گفته \"للذین في قلوبهم مرض والقاسية قلوبهم\" دوتا جدا از هم آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.24,
   "end": 145.58,
   "text": "می‌فرماید که شاید علتش این باشه که انقدر اهمیت داره و خطرناکه سخت‌دلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.58,
   "end": 148.04,
   "text": "اینکه جدا آورده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.04,
   "end": 152.48,
   "text": "دل مریض. یعنی اولاً می‌شه این باشه که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.48,
   "end": 158.9,
   "text": "کسی دلش سنگ می‌شه که اول به مریضی دل مبتلا شده، دلش مریض شده و ما قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.9,
   "end": 161.7,
   "text": "فکر می‌کنم حدود بیست جلسه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.7,
   "end": 165.52,
   "text": "قلب مریض آیاتشو بررسی کردیم و گفتگو کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.52,
   "end": 168.14,
   "text": "همه اونا رو شما ارساق کنید به اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.14,
   "end": 170.42,
   "text": "اون خطراتی که وجود داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.42,
   "end": 173.32,
   "text": "اگر کسی توجه به این خطرات نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.32,
   "end": 180.72,
   "text": "\"والقاسية قلوبهم\" قطعاً این مریضی دلش بر-- بدل می‌شه به سخت‌دلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.72,
   "end": 186.2,
   "text": "و اگر کسی دلش سخت شد بلا فاصله می‌فرماید \"وإن الظالمين لفي شقاق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.2,
   "end": 190.66,
   "text": "قطعاً دچار یک دوری از حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.66,
   "end": 196.46,
   "text": "و دشمنی و ستیزه با معارف می‌شه و از اهل ظلم و ستم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.46,
   "end": 202.1,
   "text": "حالا ظلم به خودش، به خدا، به حجت زمان، به مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.1,
   "end": 209.9,
   "text": "این یه نکته. نکته بعدی اینکه تو تفسیر المیزان می‌فرماید که اولاً آزمایش و فتنه از نوامیس الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.9,
   "end": 214.68,
   "text": "مرحوم طباطبایی علامه رحمة الله علیه اینچنین میارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.68,
   "end": 218.0,
   "text": "می‌فرماید در عالم انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.0,
   "end": 220.56,
   "text": "این ناموس خدا یعنی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.56,
   "end": 224.76,
   "text": "فتنه در کالبد این عالم بر-بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.76,
   "end": 227.42,
   "text": "در جریانه. همه در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.42,
   "end": 229.0,
   "text": "امتحانن. برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.0,
   "end": 233.84,
   "text": "برای اینکه سعادتمند و شقاوتمند از هم جدا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.84,
   "end": 237.54,
   "text": "آدم شقی و آدم سعید در این آزمون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.54,
   "end": 240.52,
   "text": "از هم جدا بشن و منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.52,
   "end": 242.76,
   "text": "چهره خودش رو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.76,
   "end": 245.72,
   "text": "این علت اصلی‌ست که علامه طباطبایی آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.72,
   "end": 253.42,
   "text": "البته من خلاصه عرض کردم. بعد در توضیحش می‌فرمایند که قلب مریض حالا چه فرقی با قلب قسی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.42,
   "end": 256.18,
   "text": "علامه می‌فرمایند که قلب مریض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.18,
   "end": 260.42,
   "text": "دیر حقایق رو می‌گیره، تصرف-- تصور می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.42,
   "end": 263.84,
   "text": "و دیر هم قبول می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.84,
   "end": 269.26,
   "text": "قلب قسی اصلاً قبول نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.26,
   "end": 272.12,
   "text": "قلب قسی اصلاً حق-حقایق رو نمی‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.12,
   "end": 276.08,
   "text": "به قول یکی دیگه از مفسرین می‌فرماید اصلاً گوش شنوا نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.08,
   "end": 279.7,
   "text": "که بخواد بپذیره. قلب مریض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.7,
   "end": 281.76,
   "text": "هنوز قلبش البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.76,
   "end": 285.6,
   "text": "قساوت از انواع مریضی قلب هست اما اینجا که جدا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.6,
   "end": 288.5,
   "text": "یعنی اگر کسی هنوز دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.5,
   "end": 291.16,
   "text": "قلب قسی نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.16,
   "end": 294.38,
   "text": "حقایق رو اگرچه دیر اما می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.38,
   "end": 297.54,
   "text": "شاید هم بپذیره، شاید هم نپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.54,
   "end": 300.8,
   "text": "بر-- بستگی داره به درجه مرض قلبی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.8,
   "end": 306.12,
   "text": "اما کسی که دچار قساوت قلب شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.12,
   "end": 307.9,
   "text": "اصلاً گوش شنوا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.9,
   "end": 310.04,
   "text": "هرچی تو بهش بگی هیچ فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.04,
   "end": 315.2,
   "text": "این‌هایی که شما هرچی براش آیه و روایت می‌خونی و از اهل بیت می‌گن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.2,
   "end": 321.96,
   "text": "مسخره‌ت می‌کنن، توجه ندارن، اصلاً دلشون نمی‌لرزه، این‌ها قطعاً دچار قساوت قلب‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.96,
   "end": 324.5,
   "text": "و از این نوع هستن. البته علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.5,
   "end": 329.3,
   "text": "ابتدا می‌فرماید که می‌شه قلب مریض سریع بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.3,
   "end": 331.96,
   "text": "دیر باور کنه. این هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.96,
   "end": 333.9,
   "text": "عرض کردم به درجاتش بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.9,
   "end": 342.2,
   "text": "اما چیزی که خطرناکه اینه که هر دو علامه می‌فرمایند هر دو، هم دل مریض هم دلی که از شدت مرض به قساوت رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.2,
   "end": 345.06,
   "text": "هر دو القاءات شیطان رو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.06,
   "end": 349.98,
   "text": "یعنی تحت تسخیر شیطان و اون بحثی که دیروز داشتیم و زينت بخشی شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.98,
   "end": 355.72,
   "text": "و انحرافات و القاءات شیطانی قطعاً خواهند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.72,
   "end": 359.0,
   "text": "نکته بعدی اینکه می‌فرماین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.0,
   "end": 365.14,
   "text": "در یکی از تفاسیر می‌خوندم که حالا خیلی هم تفسیرش معروف نیست اما نکات خوبی توش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.14,
   "end": 369.62,
   "text": "می‌فرمود که چطور مؤمن رو در روایات به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.62,
   "end": 373.46,
   "text": "زنبور عسل تشبیه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.46,
   "end": 379.7,
   "text": "و کسی که قلبش مریض هستو به مگس تش-تشبیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.7,
   "end": 384.44,
   "text": "از همین دو تا تشبیه که تو روایات اومده نکات زیادی شما می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.44,
   "end": 387.04,
   "text": "برداشت کنید. عسل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.04,
   "end": 389.98,
   "text": "زنبور عسل جاهای خوب می‌شینه، درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.98,
   "end": 392.02,
   "text": "هیچوقت نمیره جای بد بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.02,
   "end": 395.28,
   "text": "تا حالا دیدید زنبور عسل بره رو نجاست بشینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.28,
   "end": 398.7,
   "text": "رو خبائث بشینه؟ و بالعکس تا حالا دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.7,
   "end": 401.56,
   "text": "مگس بره رو طیبات بشینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.56,
   "end": 404.44,
   "text": "چیزای پاک بشینه، رو گل، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.44,
   "end": 406.0,
   "text": "مگس همش جاهای خبیث میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.0,
   "end": 408.76,
   "text": "یعنی چی؟ چرا مؤمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.76,
   "end": 414.16,
   "text": "حالا چون آیه بعدش، آیه پنجاه و چهار میره سراغ اهل ایمان که والا الان وقت نیست فردا ازش نکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.16,
   "end": 418.32,
   "text": "خیلی مهمی رو انشاالله استخراج می‌کنیم به فضل الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.32,
   "end": 421.18,
   "text": "چرا مؤمن در روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.18,
   "end": 423.78,
   "text": "زنبور عسل بیان شده؟ برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.78,
   "end": 429.84,
   "text": "خوشبینی مؤمن. انقدر دلش سلیمه، خوشبینه، بدبین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.84,
   "end": 433.72,
   "text": "بر، برعکس قلبی که مریضه، مخصوصاً قلبی که قسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.72,
   "end": 436.1,
   "text": "هرچی بهش میگن بد برداشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.1,
   "end": 439.1,
   "text": "همه چی رو بد می‌بینه. همه چی رو سیاه می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.1,
   "end": 441.2,
   "text": "سیاه‌نمایی داره از همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.2,
   "end": 444.84,
   "text": "اصلاً با خودشم دعوا داره. توجه کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.84,
   "end": 447.44,
   "text": "کسی که مؤمن نیست‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.44,
   "end": 450.48,
   "text": "مثل مگسه. همش جاهای کثیف می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.48,
   "end": 453.0,
   "text": "همش جاهای زشت و خبیث می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.0,
   "end": 457.14,
   "text": "همش میگه بعضیا مگس صفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.14,
   "end": 463.64,
   "text": "مگس صفت یعنی این دیگه. میره یه جا هزار و یک نکته خوب هست اه دستشو می‌ذاره رو اون کثیف‌ترین نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.64,
   "end": 465.56,
   "text": "خب بابا این همه خوبی تو طرف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.56,
   "end": 468.72,
   "text": "این همه خوبی تو فلان هیئت مثلا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.72,
   "end": 471.56,
   "text": "چرا تو فقط بدی‌هاشو داری می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.56,
   "end": 473.36,
   "text": "مثل جریان حضرت موسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 473.36,
   "end": 475.56,
   "text": "همه می‌دونید دیگه رفتن رد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.56,
   "end": 478.02,
   "text": "اون سگه که مرده بود لاشش افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.02,
   "end": 480.14,
   "text": "هرکی یه چیزی گفت. یکی لگد زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.14,
   "end": 482.54,
   "text": "اه، اه چه قیافه‌ای، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 482.54,
   "end": 485.76,
   "text": "بوی گندی، چه فلان. حضرت فرمود صبر کنید، صبر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 485.76,
   "end": 488.16,
   "text": "تو کتاب احادیث قدسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 488.16,
   "end": 492.6,
   "text": "مرحوم شیخ حر عاملی دیدم که روایت می‌گه صبر کنید چرا همش بدی‌هاشو می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.6,
   "end": 497.56,
   "text": "چه دندونای سفیدی داره. یعنی نهیبه برا ما دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 497.56,
   "end": 500.42,
   "text": "مؤمن خوش قلبه. مؤمن حسن ظن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.42,
   "end": 504.44,
   "text": "شاید از این حسن ظنش که سادگیشه بعضیا میگن ساده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.44,
   "end": 509.28,
   "text": "استغفرالله بعضیا میگن امله بعضیا استغفرالله میگن احمقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 509.28,
   "end": 513.86,
   "text": "شاید از این ضررهایی بکنه اما ضررش به مراتب کمتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 513.86,
   "end": 516.92,
   "text": "اون رشدیه که می‌کنه و اون منفعتیه که می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 516.92,
   "end": 522.86,
   "text": "اما بالعکس کسی که قلبش قساوت گرفته از مریضی قلب به اینجا کشیده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 522.86,
   "end": 525.86,
   "text": "اصلاً خوشبین نیست، همش بدبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.86,
   "end": 530.84,
   "text": "اگر خدای نکرده بچه‌های ما دچار بدبینی هستن باید ریشه‌ای مداوا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.84,
   "end": 535.14,
   "text": "باید مراقب باشیم. این که اصلاً ج-- نمی‌تونه با کسی رفیق شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 535.14,
   "end": 539.26,
   "text": "یه روز با یکی می‌پره سر میگه ببین فلانی هم اینجوریه ها و اون، اونم اینجوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 539.26,
   "end": 542.66,
   "text": "اون همش بدی می‌بینه. این خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.66,
   "end": 545.32,
   "text": "این نشانه استغفرالله ریشه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 545.32,
   "end": 549.36,
   "text": "نفاق و کفر و شرکه که داره خودشو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 549.36,
   "end": 554.42,
   "text": "انشاالله که عاقبتmu ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.42,
   "end": 558.26,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.26,
   "end": 560.9,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}