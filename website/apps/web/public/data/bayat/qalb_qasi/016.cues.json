  {
   "index": 1,
   "title": "## آیهٔ شرح صدر و قساوت قلب",
   "start": 151.24,
   "end": 247.72
  },
  {
   "index": 2,
   "title": "## روایت ابن مسعود؛ ورود نور به قلب",
   "start": 247.72,
   "end": 294.54
  },
  {
   "index": 3,
   "title": "## سه نشانه؛ نخستین: انابه الی دار الخلود",
   "start": 294.54,
   "end": 324.04
  },
  {
   "index": 4,
   "title": "## غنای دین و حدیث امانت مدیریت",
   "start": 324.04,
   "end": 384.77
  },
  {
   "index": 5,
   "title": "## بازگشت به نشانهٔ نخست؛ علامه صافی",
   "start": 384.77,
   "end": 815.79
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 4.8,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 8.48,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.48,
   "end": 13.54,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.54,
   "end": 16.76,
   "text": "از رهبر عزیزمون سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.76,
   "end": 19.48,
   "text": "اگر چنانچه زمین نجس بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.48,
   "end": 23.38,
   "text": "چگونه باید پاکش کنیم؟ زمین، حالا یا زمین اتاقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.38,
   "end": 27.56,
   "text": "یا همین اداره محل رفت و آمد هر جا زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.56,
   "end": 31.44,
   "text": "و جایی یک جایی واقع شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.44,
   "end": 34.2,
   "text": "آه آبی نیست مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.2,
   "end": 36.1,
   "text": "چی میگن کفشور نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.1,
   "end": 42.38,
   "text": "بعضی خب این زمین‌ها جاها هستش که کفشور براش درست نکرده‌ن مثل مثلاً خونه خود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.38,
   "end": 47.04,
   "text": "تو آشپزخونه داره اما تو پذیرایی و اتاق خواب که دیگه کفشور نداره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.04,
   "end": 49.26,
   "text": "آبو بهش بریزی بره تو چاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.26,
   "end": 51.86,
   "text": "اینجا چجوری باید پاکش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.86,
   "end": 55.82,
   "text": "آقا فرمودن که اگر با آب شهری و آبی که وصله به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.82,
   "end": 60.5,
   "text": "لوله و کره اگر با اون شسته میشه یک بار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.5,
   "end": 64.2,
   "text": "اگر با آب قلیل شسته میشه دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.2,
   "end": 68.56,
   "text": "اما دقت داشته باشید اولین وظیفه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.56,
   "end": 72.48,
   "text": "ازاله نجاسته. اول عین نجاست برطرف میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.48,
   "end": 81.26,
   "text": "عین نجاستو برمی‌داری. بعد محل متنجس رو به این دو گونه میشه پاک کرد، اون زمین رو که آب ازش نمی‌ره جایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.26,
   "end": 86.7,
   "text": "آب جمع می‌شه توش. اگر لوله آب لوله شهری رو بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.7,
   "end": 90.16,
   "text": "این آبو یه بار می‌ریزی روش، آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.16,
   "end": 93.56,
   "text": "وصل به کره، می‌ریزی اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.56,
   "end": 101.0,
   "text": "نجس شده تا آب اونجا رو پر کنه فر-- اون فضایی که نجس شده رو آب بگیره، فرا بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.0,
   "end": 103.74,
   "text": "بعد با یک پارچه‌ای چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.74,
   "end": 109.96,
   "text": "به این آ-- این آبی که اونجا جمع شده رو که بهش میگن غساله اینو جمعش می‌کنی، آب مونده اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.96,
   "end": 112.62,
   "text": "اونو جمعش می‌کنی با یه پارچه‌ای چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.62,
   "end": 114.5,
   "text": "می‌ریزی بیرون. پاک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.5,
   "end": 118.04,
   "text": "تمام. اگه آب لوله کشی باشه یه بار با این کار پاک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.04,
   "end": 121.9,
   "text": "اما اگر آب قلیل باشه مثل آب پارچ و آفتابه و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.9,
   "end": 124.58,
   "text": "کمتر از کره، دو بار این کارو انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.58,
   "end": 127.18,
   "text": "یعنی عین نجاستو که برطرف کردی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.18,
   "end": 133.6,
   "text": "یه بار آب می‌ریزی تا همون مقداری که نجس شده اگه به اندازه یه دوزاریه همون دوزاری آب کلشو بگیره بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.6,
   "end": 136.02,
   "text": "اگه دسته به اندازه یه دست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.02,
   "end": 140.94,
   "text": "یه تشت یه تشت، نه همون مقداری که نجسه آب کل اونجا رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.94,
   "end": 146.36,
   "text": "آبو قطع می‌کنی با پارچه آبا رو جمع می‌کنی می‌ریزی بیرون، یه بار دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.36,
   "end": 151.24,
   "text": "پاک می‌شه. حتما نیاز به کفشور نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.24,
   "end": 154.22,
   "text": "اما در خصوص قلب قسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.22,
   "end": 158.98,
   "text": "رسیده بودیم به آیه مهم بیست و دو سوره زمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.98,
   "end": 169.04,
   "text": "می‌فرمود \"افمن شرح الله صدره للاسلام فهو على نور من ربه فويل للقاسیه قلوبهم من ذكر الله اولئک فی ضلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.04,
   "end": 172.66,
   "text": "بعید\". عرض کردیم که اینجا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.66,
   "end": 179.5,
   "text": "یک مقایسه‌ای قرار داده بین کسایی که خدا بهشون شرح صدر داده، سینه گشاده داده برای پذیرش اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.5,
   "end": 186.58,
   "text": "\"فهو على نور من ربه\" یک نوری رو در وجود این‌ها قرار داده یا اون‌ها رو بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.58,
   "end": 189.2,
   "text": "مرکب نور چون می‌فرماید نورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.2,
   "end": 192.06,
   "text": "\"فهو على، على نور من ربه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.06,
   "end": 196.16,
   "text": "على یعنی که الان سوار بر مرکب نور شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.16,
   "end": 201.28,
   "text": "که حالا خیلی مرتبط با بحثمون نیست که بگیم این مرکب نور منظور چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.28,
   "end": 204.88,
   "text": "در هر حال بعد می‌فرماید \"فویل للقاسیه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.88,
   "end": 207.46,
   "text": "وای به حال... چند جای قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.46,
   "end": 209.38,
   "text": "خدا فرموده وای به حال اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.38,
   "end": 213.8,
   "text": "یک خدا بگه وای به حال کسی دیگه وای به حالش واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.8,
   "end": 216.74,
   "text": "یه جا می‌فرماید \"ويل للمصلین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.74,
   "end": 219.34,
   "text": "الذین هم فی صلاتهم ساهون\" اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.34,
   "end": 223.08,
   "text": "نماز می‌خونن تازه مصلی هستن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.08,
   "end": 227.94,
   "text": "کوتاهی می‌کنن. بی‌توجه‌ن به وقتش، به شرایطش، آدابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.94,
   "end": 233.24,
   "text": "یه جا می‌فرماید \"ويل للمطففين\" اونایی که کم‌فروشن وای بر اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.24,
   "end": 239.88,
   "text": "اینجا می‌فرماید \"ويل، فویل للقاسیه قلوبهم\" وای به اونایی که دلشون سنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.88,
   "end": 242.5,
   "text": "وای به اونایی که دل سنگ شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.5,
   "end": 246.08,
   "text": "حالا این دو تا رو وقتی کنار هم می‌ذاری خیلی چیزا دستگیرت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.08,
   "end": 249.14,
   "text": "یه کسی در تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.14,
   "end": 252.46,
   "text": "نور الثقلین هست این روایت، ابن مسعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.46,
   "end": 255.8,
   "text": "میگه از پیغمبر در خصوص همین آیه پرسیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.8,
   "end": 259.1,
   "text": "که این \"افمن شرح الله صدره\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.1,
   "end": 261.1,
   "text": "که نشون می‌ده اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.1,
   "end": 264.08,
   "text": "بخواد دچار قساوت قلب نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.08,
   "end": 266.28,
   "text": "لاجرم باید به سمت چی بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.28,
   "end": 269.82,
   "text": "شرح صدر و سوار شدن رو بر اون نور هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.82,
   "end": 272.88,
   "text": "یعنی از خدا بخواد چون می‌فرماید \"شرح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.88,
   "end": 276.42,
   "text": "صدره\" خدا شرح صدر بهش داده للاسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.42,
   "end": 279.44,
   "text": "که پذیرش اسلام کرده. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.44,
   "end": 282.54,
   "text": "راه نجات از قساوت قلب رو اینجا داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.54,
   "end": 284.72,
   "text": "اما خب برای امثال من خیلی گنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.72,
   "end": 288.18,
   "text": "یعنی چی؟ چگونه از قساوت قلب نجات پیدا کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.18,
   "end": 290.46,
   "text": "این شرح صدر اصلاً نشونه‌ش چجوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.46,
   "end": 293.62,
   "text": "حالا علامه‌ش، علامتش چجوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.62,
   "end": 296.46,
   "text": "خب خداروشکر ابن مسعود نامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.46,
   "end": 299.1,
   "text": "خدا خیرش بده از پیغمبر سؤال کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.1,
   "end": 301.98,
   "text": "گفت چگونه انسان شرح صدر پیدا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.98,
   "end": 306.58,
   "text": "این چگونه است؟ این آیه رو هم قرائت کردن بیست و دو زمر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.58,
   "end": 308.4,
   "text": "کجا عرض کردم سند رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.4,
   "end": 316.56,
   "text": "تفسیر نور الثقلین. پیغمبر اینچنین جواب دادند که \"إذا دخل النور في القلب\" وقتی این نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.56,
   "end": 320.32,
   "text": "این نور اونجا فرمود \"فهو على نور من ربه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.32,
   "end": 322.84,
   "text": "وقتی این نور وارد قلب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.84,
   "end": 325.54,
   "text": "\"انشرح و انفتح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.54,
   "end": 328.82,
   "text": "شرح صدر ایجاد می‌شه و گشایش درون ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.82,
   "end": 332.34,
   "text": "آدم بشاش می‌شه، نشاط پیدا می‌کنه، گشایش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.34,
   "end": 335.06,
   "text": "مثل کوه آتشفشان فوران می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.06,
   "end": 337.46,
   "text": "توجه کردی؟ پر از انرژی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.46,
   "end": 340.56,
   "text": "دیدی برام امام حسین دو قطره اشک می‌ریزه چه نشاطی پیدا می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.56,
   "end": 344.36,
   "text": "همون نور است اومده. تو سوار بر مرکب نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.36,
   "end": 348.58,
   "text": "راهت نور تا مقصد بی‌انتها در حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.58,
   "end": 351.38,
   "text": "حالا با گناه ما متوقف می‌شیم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.38,
   "end": 353.6,
   "text": "اینجا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.6,
   "end": 356.1,
   "text": "زیرک بوده دیگه ابن مسعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.1,
   "end": 361.88,
   "text": "جزء روات هست. پرسید که کار ما رو آسون کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.88,
   "end": 364.75,
   "text": "عرض کرد که آقا نشونه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.75,
   "end": 368.15,
   "text": "خب شما فرمودی که نور میاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.15,
   "end": 371.01,
   "text": "انشراح و انفتاح ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.01,
   "end": 373.19,
   "text": "درست. اما ما از کجا بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 373.19,
   "end": 377.43,
   "text": "نشونه‌ش چیه که ما بفهمیم این شهر هسد اومده لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.43,
   "end": 379.75,
   "text": "الحمد لله از خطر چی نجات پیدا کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 379.75,
   "end": 382.75,
   "text": "قساوت قلب. پیغمبر این‌چنین فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.75,
   "end": 386.85,
   "text": "فرمودن که نشونه‌ش اینه. ال-- سه تا نشونه داده پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 386.85,
   "end": 389.39,
   "text": "حالا خوش به حال اونایی که اینو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 389.39,
   "end": 391.79,
   "text": "من که بررسی کردم گیر کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.79,
   "end": 394.91,
   "text": "تو خودم موندم. افسوس خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 394.91,
   "end": 397.61,
   "text": "بیچاره شدم. سه تا نشونه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 397.61,
   "end": 399.89,
   "text": "العنابه، العنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.89,
   "end": 404.25,
   "text": "عنابه که قبلاً عرض کردیم چه فرقی با توبه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 404.25,
   "end": 407.33,
   "text": "یعنی آن به آن، برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 407.33,
   "end": 410.47,
   "text": "تند به تند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 410.47,
   "end": 414.99,
   "text": "پی در پی زنبور عسل به سمت کندوشو می‌گن نوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 414.99,
   "end": 417.85,
   "text": "عنابه یعنی دائماً در حال برگشت به خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 417.85,
   "end": 421.77,
   "text": "اینجا می‌فرماید العنابه الی دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 421.77,
   "end": 424.77,
   "text": "به سمت اون دار همیشگی در حرکت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 424.77,
   "end": 428.37,
   "text": "یعنی به هر طرف می‌ره قصدش برگشته به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 428.37,
   "end": 430.23,
   "text": "یعنی حتی دن-- به سمت دنیا می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 430.23,
   "end": 432.69,
   "text": "صبح داره میاد سر کار پول درآره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 432.69,
   "end": 439.03,
   "text": "اما هدفش خیره. فکرش به آخرتشه و قیامتشه، به حساب و کتابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 439.03,
   "end": 445.09,
   "text": "نه به این دنیاش، نه خشت رو خشت گذاشتن این دنیا و فخر فروشی‌ها و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 445.09,
   "end": 448.17,
   "text": "که طرف بیاد پراید ما رو سوار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 448.17,
   "end": 451.21,
   "text": "بعد النودشو بده ما یه دور بزنیم تو سازمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 451.21,
   "end": 456.41,
   "text": "بعد بگه عجب ماشین درب و داغونی داری حاجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 456.41,
   "end": 460.43,
   "text": "توجه کردید؟ خدا هم انشاالله هدایتشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 460.43,
   "end": 463.95,
   "text": "بله نه عزیز ماست. شو-- مفاه-- مزاحم می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 463.95,
   "end": 466.95,
   "text": "دومین، حالا اینا هر کدومش جای بحث داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 466.95,
   "end": 470.93,
   "text": "شما برید درباره‌ش تحقیق کنید دل-- اگه تشنه‌ایدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 470.93,
   "end": 472.81,
   "text": "نگو حاجی ما رو خسته می‌کنه. ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 472.81,
   "end": 474.51,
   "text": "خیلی حاج آقا طول و بس می‌دی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 474.51,
   "end": 477.81,
   "text": "چیکار کنم؟ انقدر که اهل بیت حرف زدن و امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 477.81,
   "end": 486.75,
   "text": "تو اداره خودمون می‌گفتم که اگر یه دونه حدیث پیغمبر و یه دونه حدیث پیغمبر و تو دایره مدیریت این کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 486.75,
   "end": 491.45,
   "text": "لحاظ کنن، هیچ مشکلی در مدیریت این کشور نیست و نخواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 491.45,
   "end": 493.97,
   "text": "همه تعجب کردن. گفتن ب-- گفتم بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 493.97,
   "end": 496.63,
   "text": "یه به واقع یه حدیث، یه دونه حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 496.63,
   "end": 502.23,
   "text": "دین ما انقدر غنیه. آخه اومده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 502.23,
   "end": 504.93,
   "text": "از کشور فرانسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 504.93,
   "end": 507.81,
   "text": "پروفسور مثلاً دیگه آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 507.81,
   "end": 511.51,
   "text": "از جهت علمی می‌شه گفت مثلاً تراز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 511.51,
   "end": 514.77,
   "text": "علوم جمعیه توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.77,
   "end": 520.07,
   "text": "فرانسه با همسرش اتفاقاً هر دو تا به تراز بالاترین تراز علمی فرانسه رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 520.07,
   "end": 524.35,
   "text": "زن و شوهر اومدن پیش علامه حسن زاده، عالم شیعه ما زانو زده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 524.35,
   "end": 528.33,
   "text": "که آقا مثلاً در مورد هیئت ریاضیات، نجوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 528.33,
   "end": 534.37,
   "text": "کلام اینا بحث کنن و علامه این استاد حسن-- استاد صمدی می‌فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.37,
   "end": 537.25,
   "text": "که برای ما فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 537.25,
   "end": 539.39,
   "text": "می‌شینن خلاصه اینا شروع می‌کنن بحث کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.39,
   "end": 542.21,
   "text": "در هر هیئتی از علوم مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 542.21,
   "end": 544.99,
   "text": "وارد بحث می‌شن علامه می‌غره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 544.99,
   "end": 550.49,
   "text": "می‌خروشه، حرف داره، بحث می‌کنه، اینا رو می‌بره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 550.49,
   "end": 553.29,
   "text": "وادی‌هایی که تازه بابی براشون باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 553.29,
   "end": 554.99,
   "text": "در رابطه با کرویت زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 554.99,
   "end": 557.89,
   "text": "می‌گه اصلاً اسلام اینو اثبات کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 557.89,
   "end": 559.89,
   "text": "نمی‌دونم. خلاصه بحث‌های مفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 559.89,
   "end": 563.01,
   "text": "بعد می‌بینین پروفسور فرانسوی داره گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 563.01,
   "end": 565.93,
   "text": "علامه می‌گه چیزی ما گفتیم شما ناراحت شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 565.93,
   "end": 568.97,
   "text": "بحث علمی بود دیگه. می‌گه نه من دارم گریه می‌کنم به حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 568.97,
   "end": 573.91,
   "text": "خودمون که تو فرانسه یه عده لباس پیغمبر تنشون رو ادعا می‌کنن آخوند مایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 573.91,
   "end": 577.69,
   "text": "در صورتی که هیچی نمی‌دونن. بعد شما تو این مملکت اینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 577.69,
   "end": 580.91,
   "text": "ما این همه راه اومدیم. بعد به هر طرف از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 580.91,
   "end": 583.03,
   "text": "وادی علم و معرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 583.03,
   "end": 588.33,
   "text": "باب علم هر باب علمی ما وارد می‌شیم شما تهشو رفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 588.33,
   "end": 592.27,
   "text": "گریه دارم برای این می‌کنم که شما کجایی ما کجاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 592.27,
   "end": 594.85,
   "text": "و علامه حسن زاده رو کی می‌شناسش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 594.85,
   "end": 597.03,
   "text": "همین علامه رو. خب علما اینان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 597.03,
   "end": 601.09,
   "text": "نه من بی‌سواد که. من آخوند زرب و زربا خونده بی‌سواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 601.09,
   "end": 605.03,
   "text": "حالا الحمد لله فخرمون اینه که حرف‌های اونا رو به شما می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 605.03,
   "end": 608.07,
   "text": "چی-- کجا بود یهو رفتیم اینور؟ گفتیم اسلام دین غنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 608.07,
   "end": 610.95,
   "text": "من یه حدیث رو تو اداره عرض کردم همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 610.95,
   "end": 613.51,
   "text": "با تعجب نگام کردن. عه راست می‌گه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 613.51,
   "end": 616.69,
   "text": "پیغمبر فرمود اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 616.69,
   "end": 619.83,
   "text": "مسئولیت هفت نفر رو قبول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 619.83,
   "end": 623.51,
   "text": "در حالی که لیاقتشو نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 623.51,
   "end": 626.87,
   "text": "یعنی این کاره نیست به قول ما. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 626.87,
   "end": 629.87,
   "text": "توانشو، استعداد و توانایی ایناشو نداشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 629.87,
   "end": 633.53,
   "text": "قدرتشو نداشته، بایدهاشو نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 633.53,
   "end": 636.13,
   "text": "فرمود به من خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 636.13,
   "end": 638.77,
   "text": "به من پیغمبر هفت نفر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 638.77,
   "end": 642.09,
   "text": "چند تا زیر دست مسئولین و مدیران ما هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 642.09,
   "end": 645.05,
   "text": "و البته فرمود اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 645.05,
   "end": 648.07,
   "text": "مسئولیت هفت نفر رو بهش بسپرن و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 648.07,
   "end": 654.57,
   "text": "بتونه و از پش-- از پسش بتونه بربیاد اما قبول نکنه، این هم به من خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 654.57,
   "end": 657.09,
   "text": "ببینید وقتی آدم اینطوری نگاه می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 657.09,
   "end": 660.61,
   "text": "هر کسی سر جایی می‌شینه که لیاقتشو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 660.61,
   "end": 667.85,
   "text": "اصلاً مشکلات از اینجا ناشی شده که بی‌لیاقتی‌ها رخت-- یعنی کسایی در جایی نشستن که لیاقت اونجا رو نداشتن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 667.85,
   "end": 673.59,
   "text": "تمام. همین یه فرمول تو سیستم مدیریتی مملکت ما پیاده بشه مشکلی دیگه به وجود میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 673.59,
   "end": 679.01,
   "text": "دیگه باید رفت سراغ مشکلات خارجی که اونم اتفاقاً یه فرصتیه به قول رهبر عزیزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 679.01,
   "end": 682.29,
   "text": "چی بگم من؟ من چی عرض کنم خدمت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 682.29,
   "end": 686.81,
   "text": "از غنای این دین، درون مایه پر مغز دینمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.81,
   "end": 689.99,
   "text": "حالا کجا بودیم ما؟ سه تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.99,
   "end": 693.73,
   "text": "سه تا عرض کنم خدمتتون نشانه بر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 693.73,
   "end": 696.65,
   "text": "آیا تو شهر هسد داری و از قساوت نجات پیدا کردی یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 696.65,
   "end": 701.43,
   "text": "بذارمتون تو خماری جلسه بعد بگم چون فرصت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 701.43,
   "end": 704.75,
   "text": "هرچی تشنه‌تر بشید بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 704.75,
   "end": 709.55,
   "text": "تو، تو تو خماری دو تا بعدیش بمونید عیب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 709.55,
   "end": 711.89,
   "text": "انشاالله عاقبت بخیر بشیم. اولیش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 711.89,
   "end": 713.99,
   "text": "هر کی بگه یه جایزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 713.99,
   "end": 718.01,
   "text": "هنوز نگفته ماشاالله دم در وایسا یه ماچ آبدار انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 718.01,
   "end": 722.17,
   "text": "جایزت باشه. العنابه الی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 722.17,
   "end": 724.25,
   "text": "دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 724.25,
   "end": 726.71,
   "text": "یعنی همش توجهش به آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 726.71,
   "end": 731.95,
   "text": "همش توجهش به آخرت. خدا رحم کن-- کجان علامه صافی‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 731.95,
   "end": 735.75,
   "text": "علامه حاج ملا، حاج ملا شیخ محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 735.75,
   "end": 738.35,
   "text": "حش-- ملا شیخ محمد جواد صافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 738.35,
   "end": 742.01,
   "text": "آقای بهجت می‌فرمود گوش بدید این آقای بهجت کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 742.01,
   "end": 747.51,
   "text": "آقای بهجت می‌فرمود مسجد بالا سر حضرت معصومه سلام الله علیها منو دید علامه صافی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 747.51,
   "end": 750.97,
   "text": "ملا شیخ محمد جواد صافی دست منو گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 750.97,
   "end": 754.95,
   "text": "منو برد جلوتر، یه جا رو نشونم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 754.95,
   "end": 757.43,
   "text": "یه زمین، همین زمین بود تو حرم مسجد بالا سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 757.43,
   "end": 759.49,
   "text": "فرمود بعدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 759.49,
   "end": 762.19,
   "text": "سر این قطعه زمین یاد ما باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 762.19,
   "end": 768.17,
   "text": "زیاد یاد ما کن اینجا. بعد آقای بهجت می‌گه بعداً که از دنیا رفت همونجا دفن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 768.17,
   "end": 770.39,
   "text": "این العنابه الی دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 770.39,
   "end": 774.07,
   "text": "حواسش به اون وره. انقدر حواسش به اون وره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 774.07,
   "end": 777.85,
   "text": "خونه‌شم می‌دونه الان کجاست. الان من شما بپرسم خونه‌ت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 777.85,
   "end": 780.67,
   "text": "این ساختمانو نشون می‌دی، این آپارتمانو این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 780.67,
   "end": 784.19,
   "text": "این کجاست؟ یه، یه معذرت می‌خوام حالا اسم ندارم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 784.19,
   "end": 787.17,
   "text": "یه جایی بعداً که حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 787.17,
   "end": 794.97,
   "text": "مستراح داره که یه ذره راحت بشی اونجا تخلیه انجام بدی و استراحتی و بری به اون محل، اون دار الخلود، اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 794.97,
   "end": 796.73,
   "text": "خونه‌ی ما اونجاست. کجاست الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 796.73,
   "end": 799.63,
   "text": "از من شما الان بپرسم خونه‌تو بلدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 799.63,
   "end": 804.21,
   "text": "خوش به حال کسی که بلده. امروز عجیب حرف می‌زنم، نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 804.21,
   "end": 808.73,
   "text": "انشاالله عاقبت بخیر بشیم هممون به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 808.73,
   "end": 815.79,
   "text": "الله .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}