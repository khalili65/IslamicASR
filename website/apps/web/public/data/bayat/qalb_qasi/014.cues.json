   "start": 397.68,
   "end": 569.7
  },
  {
   "index": 6,
   "title": "## زمزمهٔ آیهٔ قصص؛ نهی از علو در زمین",
   "start": 569.7,
   "end": 675.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 4.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 6.84,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.84,
   "end": 9.1,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.1,
   "end": 11.8,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.8,
   "end": 16.8,
   "text": "استفتا شده از رهبر عزیزمون که اگر این لباس‌هایی که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.8,
   "end": 22.14,
   "text": "مرطوب میشن رنگ میدن میشورین، این رنگی که به آب میدن چجوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.14,
   "end": 24.62,
   "text": "آیا مشکلی هست بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.62,
   "end": 31.24,
   "text": "طهارت این لباس‌ها؟ مثلا لباس نجس باشه بخوای بشوری‌ش رنگی که میده چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.24,
   "end": 38.64,
   "text": "آقا فرمودن که جواب آقا این هستش که اگر چنانچه به قدری رنگ بده که این آبی که داری باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.64,
   "end": 42.1,
   "text": "لباس متنجس رو پاک می‌کنی و میشوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.1,
   "end": 44.78,
   "text": "بدل بشه به آب مضاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.78,
   "end": 48.42,
   "text": "اینجا اشکال داره. نمیشه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.42,
   "end": 51.18,
   "text": "بعد از برطرف شدن عین نجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.18,
   "end": 54.24,
   "text": "این آبی که داری میشوری‌ش باید چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.24,
   "end": 55.98,
   "text": "مضاف نباشه، آب مطلق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.98,
   "end": 60.62,
   "text": "وقتی انقدر رنگ بده که بدل بشه به آب مضاف باید آب عوض شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.62,
   "end": 62.46,
   "text": "با آب جدید بشوری‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.46,
   "end": 66.24,
   "text": "حواسمون باشه. در خصوص قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.24,
   "end": 68.92,
   "text": "قسی رسیدیم به آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.92,
   "end": 74.84,
   "text": "پنجاه و سه سوره حج که می‌فرمود \"لیجعل ما یلقي الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.84,
   "end": 83.7,
   "text": "اونچه که اون القاءات شیطانی که \"فتنة للذین في قلوبهم مرض والقاسية قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.7,
   "end": 86.42,
   "text": "این القاءات شیطانی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.42,
   "end": 92.92,
   "text": "دائما جریان داره تو این عالم این رو قرآن می‌فرماید که آزمایشی قرار دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.92,
   "end": 98.78,
   "text": "برای اون‌هایی که دلشون مریضه یا \"قاسية قلوبهم\" دچار قلوبهم، دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.78,
   "end": 105.68,
   "text": "قسافت قلب هستن. آیه بعدش رو قرار بود امروز بررسی کنیم ببینیم خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.68,
   "end": 110.76,
   "text": "چه کسانی هستن که از این امتحان پیروز میشن و سر بلند بیرون میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.76,
   "end": 114.64,
   "text": "اونایی که قساوت قلب دارن، اونایی که مریض دل هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.64,
   "end": 123.06,
   "text": "طبق آیه پنجاه و سه \"و ان الظالمين لفي شقاق بعيد\" اینا گرفتار میشن از خدا و حق دور میشن و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.06,
   "end": 127.1,
   "text": "اما خب چه کسایی از این وضعیت نجات پیدا می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.1,
   "end": 129.58,
   "text": "یعنی دچار قساوت قلب نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.58,
   "end": 137.3,
   "text": "مریض نیست دلشون. لذا این آزمایش‌ها، امتحان اتفاقا باعث میشه که نمرشون بالا بره و پیروز بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.3,
   "end": 142.8,
   "text": "آیه بعدش رو اگر دقت کنید پرده‌برداری کرده از این قصه و فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.8,
   "end": 147.34,
   "text": "آیه پنجاه و چهار \"وليعلم الذين أوتوا العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.34,
   "end": 151.82,
   "text": "انه الحق من ربك فيؤمنوا به\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.82,
   "end": 157.28,
   "text": "می‌فرماید این، این اتفاقی که می‌افته، این آزمایشی که ما می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.28,
   "end": 159.22,
   "text": "هدف ما از این، اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.22,
   "end": 162.42,
   "text": "\"ليعلم الذين\" برای اینکه بدانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.42,
   "end": 165.8,
   "text": "اون‌هایی که \"أوتوا العلم\" اون‌هایی که آگاه‌ند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.8,
   "end": 169.72,
   "text": "دارای علم‌اند، عالمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.72,
   "end": 174.08,
   "text": "آگاهن، متوجه‌اند. این‌ها برای اینکه بدونن \"انه الحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.08,
   "end": 176.92,
   "text": "حق من ربك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.92,
   "end": 180.88,
   "text": "بدونن که این ات-- این آزمایشی که داره صورت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.88,
   "end": 183.36,
   "text": "از طرف خداست. یعنی حواسشون جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.36,
   "end": 186.88,
   "text": "اینا خیلی متوجه‌اند. خیلی چشمشون بازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.88,
   "end": 189.76,
   "text": "به اتفاقاتی که حول و حوششون می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.76,
   "end": 192.8,
   "text": "و می‌فرماید برای این‌ها چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.8,
   "end": 197.46,
   "text": "چه خوبی‌ها و خیراتی رو این آزمایش به دنبال داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.46,
   "end": 200.6,
   "text": "می‌فرماید \"فتخبت له قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.6,
   "end": 202.82,
   "text": "یه مژده‌ای خدا به اینا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.82,
   "end": 206.02,
   "text": "فرمود اینا اتفاقا این از آزمایش‌ها و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.02,
   "end": 209.0,
   "text": "مسائلی که حول و حوششون رخ میده، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.0,
   "end": 212.54,
   "text": "خیلی چیزها می‌تونه باشه مصداقش رو خودتون پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.54,
   "end": 215.3,
   "text": "این اتفاقا باعث میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.3,
   "end": 218.18,
   "text": "اولا که می‌فرمود \"فيؤمنوا به\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.18,
   "end": 221.9,
   "text": "باعث میشه که این‌ها ایمان، یعنی ایمانشون تقویت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.9,
   "end": 224.84,
   "text": "دو \"فتخبت له قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.84,
   "end": 229.78,
   "text": "اینا خاضع‌تر میشن، قلبشون خاضع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.78,
   "end": 232.52,
   "text": "که حالا تو قلب مخبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.52,
   "end": 238.04,
   "text": "انشاالله بعدا وارد میشیم این خودش یه عنوانه، قلب مخبت که اینجا ازش یاد کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.04,
   "end": 241.0,
   "text": "که د-- میرن تو وادی خضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.0,
   "end": 245.38,
   "text": "و \"ان الله لهاد الذين آمنوا الى صراط مستقیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.38,
   "end": 250.68,
   "text": "بشارت بعدی برای اینه که حواسشون جمعه و آگاهانه زندگی می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.68,
   "end": 256.34,
   "text": "اینه که هدایت الهی به قدری سراغ اینا میاد که می‌برشون به صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.34,
   "end": 259.32,
   "text": "این‌ها بشارت‌های خداست. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.32,
   "end": 262.24,
   "text": "مخبت از، اه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.24,
   "end": 264.18,
   "text": "عرض کنم ریشه خبت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.18,
   "end": 267.26,
   "text": "خبت هم میگن وارد گودی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.26,
   "end": 272.74,
   "text": "در عرب میگن وارد گو-- اصن مخبت یعنی کسی که وارد گودی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.74,
   "end": 278.8,
   "text": "یعنی چی؟ یعنی افتاده حال شده، خضوعش بیشتر شده، بالانشین نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.8,
   "end": 282.52,
   "text": "سرشو بالا نگرفته و همه رو به دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.52,
   "end": 284.58,
   "text": "از بالا به پایین نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.58,
   "end": 287.08,
   "text": "و این خیلی نکته مهمیه. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.08,
   "end": 291.96,
   "text": "در، در حقیقت میگه این کسانی که حواسشون به امتحانات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.96,
   "end": 297.8,
   "text": "و این سم پراکنی‌هایی که شیطان با القاءاتش ایجاد می‌کنه در حقایق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.8,
   "end": 300.74,
   "text": "در اصول، در عقاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.74,
   "end": 307.4,
   "text": "و به هر حال ارزش‌ها میاد هی القا می‌کنه این راه غلطه، این کارو نکن، یه عمر نماز خوندی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.4,
   "end": 310.04,
   "text": "هیئت رفتی چی شد؟ ببین همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.04,
   "end": 313.28,
   "text": "خوشن، همه کیف و نوش دارن می‌کنن، همه پی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.28,
   "end": 316.36,
   "text": "زندگیشونن، تو بدبختی، تو بیچاره‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.36,
   "end": 321.6,
   "text": "هی القاءات متعدد، شبهاتی که از جهت حالا تو فضای مجازی هم پره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.6,
   "end": 326.42,
   "text": "اعتقادات ما رو هدف گرفته و این‌ها میگه اتفاقا بالعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.42,
   "end": 333.28,
   "text": "باعث میشه برای کسایی که آگاهانه زندگی می‌کنند \"أوتوا العلم\" البته این علم، علم صرف تحصیلی نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.28,
   "end": 335.42,
   "text": "علمیست که انسان رو به شهود بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.42,
   "end": 337.46,
   "text": "علمیست که بر اساس طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.46,
   "end": 340.84,
   "text": "یعنی کسی تحصیل علم کنه و به طهارت هم برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.84,
   "end": 345.04,
   "text": "هر چقدر علمش بیشتر آگاهی‌ش بیشتر میشه طهارت نفسش بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.04,
   "end": 350.18,
   "text": "چنین کسی میگه قطعا هم ایمانش زیاد میشه هم خاضع‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.18,
   "end": 354.64,
   "text": "من دارم از احوالات امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.64,
   "end": 356.96,
   "text": "دیروز مطالعه می‌کردم خیلی تکون خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.96,
   "end": 358.86,
   "text": "دیدم اصلا ما کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.86,
   "end": 362.44,
   "text": "ایشون این بزرگوار کجا؟ بعد مدعی هستم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.44,
   "end": 364.86,
   "text": "شیعه و پیرو اون‌ها هم هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.86,
   "end": 367.38,
   "text": "که مثلا امیرالمؤمنین میخوندم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.38,
   "end": 375.76,
   "text": "تو مثلا تو کوچه بازار میرفت میدید کسی مثلا بند کفشش باز شده خم میشد خلیفه مؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.76,
   "end": 381.9,
   "text": "خلیفه مسلمین، امام اول بلحق مؤمنین، وصی بلا فصل الرسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.9,
   "end": 384.58,
   "text": "خم میشد بند کفش طرف رو می بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.58,
   "end": 387.9,
   "text": "کاری نداشت کارگره، رفتگره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.9,
   "end": 390.3,
   "text": "کیه؟ چیه؟ فقیره، ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.3,
   "end": 392.5,
   "text": "غنیه، کفششو می بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.5,
   "end": 397.68,
   "text": "میگفت کاری دیگه نداری؟ ببند بند کفشتو ببند زمین نخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.68,
   "end": 404.4,
   "text": "یا میدید یه ه-حمالی بارش افتاده مولا امیرالمؤمنین می‌رفت کمک می‌کرد بارش رو روی دوشش می‌ذاشت کمکش می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.4,
   "end": 407.96,
   "text": "کار دیگه‌ای نداری؟ یا کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.96,
   "end": 413.58,
   "text": "سؤال می‌کرد راه رو گم کرده بود حضرت می‌رفت راه رو قشنگ نشونش میداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.58,
   "end": 416.66,
   "text": "کاملا یعنی با تواضع کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.66,
   "end": 420.14,
   "text": "رو خاک می‌شست. ابوطراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.14,
   "end": 425.78,
   "text": "تو خرابه می‌رفت گدا می‌د-می‌دید کنارش می‌شست باهاش هم سفره می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.78,
   "end": 430.6,
   "text": "اصلا چیزهایی که آدم می‌خواست بره خطبه نماز جمعه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.6,
   "end": 434.86,
   "text": "اون‌هایی که مسئول حراست جان مولا بودن اجازه نمی‌دادن کسی نزدیک بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.86,
   "end": 439.88,
   "text": "زنه پیرزنه اومد گلایه داشت حضرت فرمود برید کنار بذارید بیاد گلایه‌شو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.88,
   "end": 444.86,
   "text": "نامه‌شو داد گلایه کرد گفت شما چه جور رئیس حکومتی هستی که فلان کس داره این کارو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.86,
   "end": 447.94,
   "text": "همونجا حضرت نامه‌ی عزل طرف رو نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.94,
   "end": 452.38,
   "text": "البته یه مشورت گرفت که صحت داره تایید کردن همونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.38,
   "end": 456.96,
   "text": "قبل از خطبه نماز جمعه. با اینا آدم اینا رو که میخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.96,
   "end": 461.66,
   "text": "چفا-- متوجه فاصله فاحش ما با اون‌ها میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.66,
   "end": 467.04,
   "text": "یا کسایی که متاسفانه حالا یا شیفته علمشون شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.04,
   "end": 470.82,
   "text": "یا شی-- معمولا اینطوریه یا شیفته علممون میشیم یا شیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.82,
   "end": 473.88,
   "text": "مقام و منصب و مدیریت و مسئولیتمون میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.88,
   "end": 478.84,
   "text": "به جای اینکه مسئولیت مورد سؤال باید واقع بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.84,
   "end": 483.56,
   "text": "در دفترش بسته‌ست شش ماه باید وقت بگیری تا آقا رو بتونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.56,
   "end": 488.16,
   "text": "امام عصر رو زودتر میشه-- رهبری رو زودتر از این آقا میشه دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.16,
   "end": 492.62,
   "text": "نمی‌دونم از دماغ کدوم فیل و شتر افتادن بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.62,
   "end": 496.12,
   "text": "سرویس بهداشتی‌شون کاملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.12,
   "end": 498.32,
   "text": "جدا از دیگران از همکارهای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.32,
   "end": 501.0,
   "text": "یعنی نمی‌دونم در دفترشون بسته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.0,
   "end": 503.02,
   "text": "در خیلی‌ها هم گرفتارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.02,
   "end": 507.56,
   "text": "گرفتاریم یعنی هممون. گاهی آقا آدم شیفته نسبش میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.56,
   "end": 510.14,
   "text": "از اینکه مثلا پسر فلانیه، دختر فلانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.14,
   "end": 512.7,
   "text": "خب باشه از فضل پدر تو لاجاباسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.7,
   "end": 516.4,
   "text": "گاهی بدتر شیفته جسم و این خریت وجودش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.4,
   "end": 519.84,
   "text": "این الاغه که سوارش شدی ببرت اینور اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.84,
   "end": 525.94,
   "text": "شیفته این میشی. شیفته پول، مقام، چه می‌دونم شهرت، معروفیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.94,
   "end": 530.64,
   "text": "آقا غوغا می‌کنه که فرمودم خوبش هم سمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.64,
   "end": 538.0,
   "text": "توجه کردید؟ این‌ها میگه کسی که اهل علمه، کسی که علم رو به شهود کشونده از تحصیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.0,
   "end": 541.56,
   "text": "چنین کسی قطعا دچار این مراقبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.56,
   "end": 544.96,
   "text": "نمی‌ذاره دلش مریض بشه که به قساوت بیفته دچار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.96,
   "end": 549.24,
   "text": "مسائل بشه. مثل مولا خاکی زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.24,
   "end": 551.42,
   "text": "آغوشش بازه به روی همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.42,
   "end": 554.98,
   "text": "چنین نیست که فقط به فکر خودش و خونواده خودش باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.98,
   "end": 556.86,
   "text": "از مشکلات مردم غافل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.86,
   "end": 558.9,
   "text": "تا حد توانش حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.9,
   "end": 561.16,
   "text": "یه آهی می‌کشه، دلسوزی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.16,
   "end": 564.86,
   "text": "ببخشید شرمنده‌ام دستم بسته‌ست ولی به فکرتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.86,
   "end": 568.82,
   "text": "اینطوری نیست که ولمون کن بابا تو هم فقط ما رو گیر آوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.82,
   "end": 575.08,
   "text": "چنین کسی-- بعد جالبه من می‌دیدم امیرالمؤمنین با اون عظمت وقتی این کارا رو می‌کرد می‌دیدم غالبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.08,
   "end": 576.58,
   "text": "داره این آیه رو تکرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.58,
   "end": 579.22,
   "text": "برید ببینید آیه هشتاد و سه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.22,
   "end": 584.48,
   "text": "قصص که می‌فر-- زیر لب زمزمه می‌کرد \"تلك الدار الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.48,
   "end": 586.48,
   "text": "نجعلها للذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.48,
   "end": 592.02,
   "text": "لا يريدون علوا في الأرض ولا فسادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.02,
   "end": 594.98,
   "text": "والعاقبة للمتقين\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.98,
   "end": 602.72,
   "text": "فرمود که خدا خودش و امیرالمؤمنین زیر لب داره بار کارگر رو می‌ذاره رو دوشش بند می‌بنده، بند کفش می‌بنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.72,
   "end": 605.2,
   "text": "خب بعد زیر لب زمزمه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.2,
   "end": 610.24,
   "text": "با سوز که بهشت رو آخرت رو خدا قا-قرار داده برای اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.24,
   "end": 612.76,
   "text": "تکبر، تکبر ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.76,
   "end": 615.4,
   "text": "متکبرانه رفته لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.4,
   "end": 619.52,
   "text": "يريدون علوا في الأرض دنبال علو و برتری نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.52,
   "end": 621.28,
   "text": "خیلی تکان‌دهنده‌ست این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.28,
   "end": 623.48,
   "text": "تو رو خدا تأمل کنیم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.48,
   "end": 627.54,
   "text": "حدیث داریم اگر کسی فقط به واسطه یه کفش نوعی که پوشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.54,
   "end": 631.92,
   "text": "خودش رو برتر از دیگران بدونه با فرعون محرو-- محشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.92,
   "end": 635.46,
   "text": "چون صفت فرعونی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.46,
   "end": 637.98,
   "text": "دوست داره برتر از دیگران باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.98,
   "end": 639.96,
   "text": "خب این چه مرضیه که منو گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.96,
   "end": 643.68,
   "text": "این چه قساوتیه تو دل من نشسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.68,
   "end": 645.96,
   "text": "چرا من این چیزا رو نباید توجه داشته باشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.96,
   "end": 647.92,
   "text": "چرا این‌ها رو قصه بدونم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 647.92,
   "end": 650.32,
   "text": "گرفتاریم آقا جان. گرفتاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 650.32,
   "end": 652.96,
   "text": "از اون بزرگ و کوچیکمون گرفتاری‌هایی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.96,
   "end": 656.16,
   "text": "باید حدیث نفس خونیم-- بخونیم حواسمون به هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.16,
   "end": 659.2,
   "text": "گوش همدیگه رو بپیچونیم. رفاقت تو این وادی هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.2,
   "end": 663.56,
   "text": "تو این وادی هم باید باشه. نه فقط پول قرض گرفتن و دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.56,
   "end": 668.48,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 668.48,
   "end": 672.2,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.2,
   "end": 675.56,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}