 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 14.22,
   "end": 122.1
  },
  {
   "index": 1,
   "title": "## قساوتِ قلب؛ آیهٔ هفتاد و چهارِ بقره",
   "start": 122.1,
   "end": 177.2
  },
  {
   "index": 2,
   "title": "## چهار مرحلهٔ زندگی",
   "start": 177.2,
   "end": 490.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.58,
   "end": 6.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.04,
   "end": 9.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.54,
   "end": 13.58,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.58,
   "end": 16.64,
   "text": "یه سوالی از دفتر آقا شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.64,
   "end": 23.64,
   "text": "بعضی از بانک‌ها که وام ربوی میدن مثلاً یعنی مسجل بشه که این بانک وام ربوی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.64,
   "end": 29.82,
   "text": "بعد ما هم به شدت نیازمندیم که این وام رو بگیریم، در حالت اضطرار هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.82,
   "end": 33.9,
   "text": "یک، آیا حالت اضطرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.9,
   "end": 39.82,
   "text": "اجازه میده؟ یعنی میشه انسان در این حالت که مضطر هست بالاخره این وام ربوی رو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.82,
   "end": 46.36,
   "text": "مثلاً بانک اعلام می‌کنه آقا در قبال انقدر وام که بهتون میدیم، انقدر اضافه باید بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.36,
   "end": 52.76,
   "text": "نکته دوم اینکه اگر اشکال داره آیا حاکم شرع و مجتهد ما اینا می‌تونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.76,
   "end": 55.56,
   "text": "اذن بدن؟ یعنی با اذن اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.56,
   "end": 58.52,
   "text": "این حرمت برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.52,
   "end": 63.38,
   "text": "آقا فرمودن که اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.38,
   "end": 71.62,
   "text": "وقتی که گرفتن وام ربوی حرام بود حتی حاکم شرع هم نمی‌تونه این حرام رو برداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.62,
   "end": 76.08,
   "text": "چون حرامه دیگه. فقه هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.08,
   "end": 80.86,
   "text": "دستور شارع مقدس است و حاکم شرع و مجتهد هم نمی‌تونه حرام رو حلال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.86,
   "end": 86.4,
   "text": "حلال اعلام کنه. اما اینکه شما خودت به حالت اضطرار رسیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 86.4,
   "end": 89.7,
   "text": "اگرچه حرمت اون وام برقراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.7,
   "end": 95.88,
   "text": "اما شما که به حالت اضطرار رسیدی و بعضا در حالت اضطرار مضطر واقعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.88,
   "end": 100.06,
   "text": "حرام حلال می‌شه، اون رو آقا فرمودن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.06,
   "end": 106.48,
   "text": "وام رو بگیر اما قصد دادن اون پول اضافه رو نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.48,
   "end": 109.52,
   "text": "شما قسطت رو بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.52,
   "end": 114.32,
   "text": "حالا چیزی که می‌بندن شروع کن به دادن اما قصد دادن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.32,
   "end": 116.84,
   "text": "پول اضافه رو نداشته باش چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.84,
   "end": 121.92,
   "text": "بالاخره اون پول اضافه حرمت براش تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.92,
   "end": 126.96,
   "text": "اما در خصوص قلب قسی یا قساوت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.96,
   "end": 130.24,
   "text": "عرض کردیم یکی از آیات، آیه هفتاد و چهار سوره بقره بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.24,
   "end": 132.48,
   "text": "اولین آیه ای که مورد مداقه قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.48,
   "end": 136.24,
   "text": "یه بار دیگه از نورانیتش استفاده کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.24,
   "end": 141.44,
   "text": "در این آیه خدا می‌فرماید «ثم قست قلوبکم من بعد ذلك»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.44,
   "end": 146.56,
   "text": "بعد از اون همه معجزات که دیدید که حالا این معجزات رو بعداً باید بررسی کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.56,
   "end": 150.28,
   "text": "دل‌های شما س-سفت شد، سخت شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.28,
   "end": 152.34,
   "text": "قسی شد. \"فهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.34,
   "end": 157.4,
   "text": "كالھجاره\" مثل سنگ \"أو أشد قسوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.4,
   "end": 160.36,
   "text": "بلکه شدیدتر از سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.36,
   "end": 162.92,
   "text": "حالا اینجا یه نکته‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.92,
   "end": 171.72,
   "text": "الان امروز روش بحث کنیم و برداشت کنیم اینکه وقتی خدا اول می‌فرماید \"کالهجاره\" بعد می‌فرماید \"أو أشد قسوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.72,
   "end": 176.34,
   "text": "نشون میده که قساوت قلب هم مرحله به مرحله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.34,
   "end": 180.48,
   "text": "یعنی اینطور نیست که طرف به یکباره قسی القلب بشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.48,
   "end": 186.24,
   "text": "ابتدا اینطوری نیست. که اما اینکه بعدش هم خدا می‌فرماید که «وإن من الحجارة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.24,
   "end": 189.24,
   "text": "لما يتفجر منه الأنهار» از بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.24,
   "end": 192.88,
   "text": "سنگ‌ها آب می‌جوشه اما بعضیاشون هم نه، آب نمی‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.88,
   "end": 194.58,
   "text": "سنگه اما آب ازش نمی‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.58,
   "end": 198.48,
   "text": "سنگه اما ازش آب می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.48,
   "end": 200.18,
   "text": "در هر حال این‌ها با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.18,
   "end": 201.98,
   "text": "سنگ‌ها با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.98,
   "end": 204.42,
   "text": "بعضیا از زیرش آب می‌جوشه بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.42,
   "end": 212.3,
   "text": "می‌فرماید «وإن منها لما يشقق فيخرج منه الماء» خودش پاره پاره می‌شه، تیکه تیکه می‌شه سنگ و از دلش آب می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.3,
   "end": 217.96,
   "text": "این‌ها با هم فرق می‌کنند. مراحل قساوت قلب، اصلاً مراحل انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.96,
   "end": 221.14,
   "text": "در این طبیعت سیری که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.14,
   "end": 225.64,
   "text": "متفاوته. می‌دونید ما زندگیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.64,
   "end": 228.82,
   "text": "چهار مرحله داره دیگه. مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.82,
   "end": 238.22,
   "text": "جمادی‌ست و که اینجا خدا به این مرحله داره اشاره می‌کنه که متوقف شدن بعضیا تو همین مرحله firstly",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.22,
   "end": 242.26,
   "text": "مثل سنگ شدن \"أو أشد\" بلکه بدتر از سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.26,
   "end": 247.74,
   "text": "همین آیه هفتاد و چهار سوره بقره داره به مرحله جمادی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.74,
   "end": 253.12,
   "text": "انسان‌ها اشاره می‌کنه که می‌فرماید هیچ هدف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.12,
   "end": 256.42,
   "text": "دغدغه‌ای ندارن. وجودشون جمود صرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 256.42,
   "end": 261.06,
   "text": "هیچ دغدغه‌ای ندارن. جمادی فکر می‌کنند و زندگی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.06,
   "end": 266.0,
   "text": "مرحله بعدی که یه مرحله از این بالاتره اما کامل نیست، مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.0,
   "end": 269.74,
   "text": "نباتی زندگیه که اینجا دغدغه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.74,
   "end": 273.3,
   "text": "جز گرفتن قف-غذا و آب از زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.3,
   "end": 276.92,
   "text": "عرض کنم رسیدن به اندام و جسم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.92,
   "end": 280.2,
   "text": "زیبایی ظاهر و پوشش و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.2,
   "end": 282.44,
   "text": "ندارن. فقط دغدغه‌شون همین چیزاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.44,
   "end": 286.62,
   "text": "به موهاشون ساعت‌ها می‌رسن، ناخن می‌ذارن، آرایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.62,
   "end": 289.54,
   "text": "دا-فقط به وجود ظاهرشون می‌پردازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.54,
   "end": 291.76,
   "text": "این‌ها وجودشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.76,
   "end": 293.46,
   "text": "صرفاً نباتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.46,
   "end": 296.3,
   "text": "اونجایی قرآن به این نوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.3,
   "end": 302.06,
   "text": "یا مرحله زندگی انسان اشاره کرده، آیه بیست و هشت، بیست و شش سوره ابراهیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.06,
   "end": 308.24,
   "text": "می‌فرماید «ومثل كلمة خبيثة» مثال کلمه خبيثة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.24,
   "end": 310.52,
   "text": "«کشجرة خبيثة»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.52,
   "end": 312.14,
   "text": "مثل درخت خبيثه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.14,
   "end": 315.48,
   "text": "«اصطدت من فوق الأرض ما لها من قرار»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.48,
   "end": 318.42,
   "text": "که او رو زمین پخش شده اما ریشه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.42,
   "end": 322.88,
   "text": "بی‌قرار هم هست. با یه بادی پخش و پلا می‌شه رو همون زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.88,
   "end": 326.88,
   "text": "اگرچه حجم زیادی از زمین رو به خودش گرفته مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.88,
   "end": 331.76,
   "text": "ولایت طاغوت که الان زمین رو پر کرده ظاهراً اما ریشه‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.76,
   "end": 334.1,
   "text": "اینجا اشاره به همون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.1,
   "end": 338.3,
   "text": "یعنی مرحله نباتی زندگی کرده خدا در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.3,
   "end": 342.42,
   "text": "که در حقیقت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.42,
   "end": 345.24,
   "text": "ثبات و قراری نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.24,
   "end": 348.14,
   "text": "در این مرحله فقط به ظاهرش می‌پردازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.14,
   "end": 351.18,
   "text": "مرحله بعدی زندگی حیوانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.18,
   "end": 355.54,
   "text": "که اینجا البته دغدغه‌ش یه مقدار فراتر از فقط خودش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.54,
   "end": 359.26,
   "text": "به دیگران، به خونوادش هم می‌پردازه اما با دو-دزدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.26,
   "end": 362.09,
   "text": "دزدی می‌کنه به خونوادش برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.09,
   "end": 365.81,
   "text": "یا از مرزهای خودش حراست می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.81,
   "end": 369.79,
   "text": "اما از مرزهای به ناحق گرفته‌ش مثل اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.79,
   "end": 374.99,
   "text": "یا بار می‌کشه برای صاحبانش اما صاحبان حاکمان ظلم و جور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.99,
   "end": 376.59,
   "text": "یعنی برای دیگران هم کار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.59,
   "end": 380.95,
   "text": "برای خونواده‌ش هم به فکر خونو-- اما از راه غیر شریعت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.95,
   "end": 382.99,
   "text": "تو حالت چی قرار گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.99,
   "end": 386.25,
   "text": "میگن مرحله حیوانی زندگیه اینجا، اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.25,
   "end": 393.05,
   "text": "که حالا آیه‌ای که مثلاً زیاده آیه، آیه‌ای که تبرکاً عرض می‌کنم بهش اشاره شده چهل و چهار سوره فرقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.05,
   "end": 398.55,
   "text": "فرمود \"أم تحسب أن أكثرهم يسمعون أو يعقلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.55,
   "end": 402.31,
   "text": "تو گمان می‌کنی که این‌ها بیشترشون می‌شنون یا می‌اندیشند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.31,
   "end": 405.27,
   "text": "\"إن هم إلا كالأنعام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.27,
   "end": 407.35,
   "text": "بلکه این‌ها نیستند مگر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.35,
   "end": 412.21,
   "text": "چهارپایان. حیوونن اینا. بدتر از اون اینه میفرماید \"بل هم أبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.21,
   "end": 415.31,
   "text": "سبيلا\". بلکه این‌ها گمراه‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.31,
   "end": 418.25,
   "text": "راهشون گمراه‌تر از حیوانات شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.25,
   "end": 422.21,
   "text": "حیوانات هم دیگه خیلیاشون تعدی نمی‌کنن از حدود خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.21,
   "end": 427.03,
   "text": "سیر شد دیگه ول می‌کنه. وقتی یه شیر یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.03,
   "end": 431.81,
   "text": "چیز حیوونی رو صید می‌کنه، یه مقدار که خورد سیر شد دیگه ولش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.81,
   "end": 433.75,
   "text": "نمی‌بره ذخیرش کنه برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.75,
   "end": 436.01,
   "text": "ولش می‌کنه لاشخورها بیان سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.01,
   "end": 437.73,
   "text": "اما اینا بدتر از حیوان شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.73,
   "end": 439.39,
   "text": "همه چی رو برای خودشون می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.39,
   "end": 441.23,
   "text": "فقط و فقط خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.23,
   "end": 443.41,
   "text": "این مرحله حیوانی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.41,
   "end": 445.41,
   "text": "مرحله بعدی انسانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.41,
   "end": 448.89,
   "text": "انسانه. مرحله انسانی که ما باید زور بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.89,
   "end": 453.03,
   "text": "به اون حالت برسونیم قصه رو که در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.03,
   "end": 456.65,
   "text": "معمولاً جاهایی که میگه \"إن الذين آمنوا وعملوا الصالحات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.65,
   "end": 460.09,
   "text": "اونجاهایی که بحث متقین است، بحث خاشعين است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.09,
   "end": 463.79,
   "text": "بحث صالحین است، مقربون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.79,
   "end": 467.11,
   "text": "این‌ها همون کسانی‌اند که به مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.11,
   "end": 471.99,
   "text": "چهارم و نهایی زندگی که مرحله انسانیت است، رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.99,
   "end": 474.09,
   "text": "اما خب اون هم حد یقف نداره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.09,
   "end": 477.81,
   "text": "مراحلش بسیار گسترده و حد یقف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.81,
   "end": 483.11,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.11,
   "end": 485.47,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.47,
   "end": 488.15,
   "text": "صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.15,
   "end": 490.55,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}