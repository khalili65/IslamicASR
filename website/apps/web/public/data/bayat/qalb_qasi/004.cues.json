 "chapters": [
  {
   "index": 0,
   "title": "## سپرده‌گذاری در بانک و شرط یقین",
   "start": 3.44,
   "end": 200.74
  },
  {
   "index": 1,
   "title": "## فرزند و پدر؛ حساسیت روایی",
   "start": 200.74,
   "end": 285.74
  },
  {
   "index": 2,
   "title": "## دعای ابراهیم؛ هوا به معنای نیکو",
   "start": 285.74,
   "end": 650.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.44,
   "end": 7.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.42,
   "end": 10.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.86,
   "end": 15.7,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.7,
   "end": 19.86,
   "text": "خب از رهبر استفتای دیگه‌ای که صورت گرفته اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.86,
   "end": 24.54,
   "text": "اگر ما متوجه بشیم یعنی یقین حاصل کنیم که یه بانکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.54,
   "end": 28.38,
   "text": "کارمندای این بانک دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.38,
   "end": 35.38,
   "text": "بر اساس عقود اسلامی وام و این‌ها رو سپرده‌گذاری‌ها رو به صورت اون بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.38,
   "end": 41.28,
   "text": "عقود انجام نمیدن و پولی که ما سپرده‌گذاری می‌کنیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.28,
   "end": 45.3,
   "text": "توی راه درستش هزینه نمی‌کنن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.3,
   "end": 48.44,
   "text": "حالا به کار نمی‌گیرن. اینطوری بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.44,
   "end": 52.04,
   "text": "خب ما چه باید بکنیم؟ آیا می‌تونیم اونجا اگر یقین حاصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.04,
   "end": 56.36,
   "text": "کنیم، رهبری فرمودن که اگر شما واقعاً به این یقین برسی که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.36,
   "end": 62.46,
   "text": "بانکی کارمنداش این کار رو دارن انجام میدن، خب حق نداری اونجا سپرده‌گذاری کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.46,
   "end": 65.4,
   "text": "اما رهبر ادامه استفتار رو اینچنین جواب میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.4,
   "end": 71.14,
   "text": "می‌فرمایند با این حجم پول‌هایی که به بانک‌ها سپرده میشه یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.14,
   "end": 79.36,
   "text": "دو، اون قانون‌هایی که و یعنی حجم معاملاتی که در بانک‌ها داره بر اساس قانون صورت می‌گیره و معاملات متعدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.36,
   "end": 81.98,
   "text": "که همه بر اساس عقود شرعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.98,
   "end": 84.72,
   "text": "جعاله و شرا-- نمیدونم شراکت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.72,
   "end": 88.32,
   "text": "مضاربه و این‌ها. سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.32,
   "end": 91.32,
   "text": "نظارتی که از-- توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.32,
   "end": 96.26,
   "text": "بانک مرکزی یا قانونی که قوه قضائیه داده رو بانک‌ها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.26,
   "end": 101.32,
   "text": "رهبری می‌فرماید بعید به نظرم می‌رسه که چنین علمی برای کسی ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.32,
   "end": 105.32,
   "text": "یعنی که چنین یقینی برای کسی ایجاد بشه که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.32,
   "end": 109.86,
   "text": "مثلاً این بانک داره بر اساس عقود عمل نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.86,
   "end": 111.5,
   "text": "این هم البته هستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.5,
   "end": 114.06,
   "text": "یعنی آدم نباید خیلی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.06,
   "end": 117.16,
   "text": "بخواد سوءظن پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.16,
   "end": 125.8,
   "text": "نکته قلب قصی ما به برداشت‌هایی از آیه هفتاد و چهار سوره بقره رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.8,
   "end": 128.42,
   "text": "یکی دیگه از برداشت‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.42,
   "end": 131.5,
   "text": "آقای قراعی در تفسیر سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.5,
   "end": 135.04,
   "text": "همین بقره در تفسیر نورشون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.04,
   "end": 137.4,
   "text": "یا زیل این آیه دارن اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.4,
   "end": 141.06,
   "text": "توجه بفرمایید که بنی اسرائیل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.06,
   "end": 143.78,
   "text": "خطا رو مرتکب شدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.78,
   "end": 149.48,
   "text": "معجزات الهی رو که دیروز برشمردیم رو نادیده گرفتن، لجاجت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.48,
   "end": 152.46,
   "text": "لذا دچار قساوت قلب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.46,
   "end": 157.56,
   "text": "اما اینجا تشرش رو خدا داره به فرزندانشون می‌زنه، به نسل‌شون، به ماها می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.56,
   "end": 161.56,
   "text": "\"ثم قصد قلوبکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.56,
   "end": 163.7,
   "text": "سپس دل‌های شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.7,
   "end": 169.92,
   "text": "قساوت قلب پیدا کرد \"من بعد ذلك\" بعد از اون جریانات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.92,
   "end": 173.82,
   "text": "و می‌فرماید \"فهی کالحجارة أو أشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.82,
   "end": 178.88,
   "text": "قسوة\" مثل سنگ شد دل‌هاتون بلکه سنگ‌تر از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.88,
   "end": 183.52,
   "text": "سخت‌تر از سنگ. نکته اینجاست که آقای قراعی برداشتشون این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.52,
   "end": 187.26,
   "text": "می‌فرمایند که ما نباید به گونه‌ای عمل کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.26,
   "end": 194.48,
   "text": "که فرزندان ما در آینده مؤاخذه بشن و تشر بخورن به واسطه عملکرد غلط ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.48,
   "end": 196.48,
   "text": "چه برسد اون‌ها هم راه ما را برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.48,
   "end": 198.94,
   "text": "اگر ما دچار قساوت قلب شدیم، اون‌ها هم همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.94,
   "end": 204.06,
   "text": "چون آخه این دیگه البته این حساسیت آقای قراعی هم بر اساس مبانی رواییه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.06,
   "end": 209.12,
   "text": "چون به همین روایتی علیه السلام کسی پرسید آقا ما چه کنیم بچه‌های خوبی داشته باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.12,
   "end": 213.0,
   "text": "حالا یه ذره حساسیت به خرج داد حضرت فرمود غصه نخور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.0,
   "end": 216.22,
   "text": "بچه‌تون همونی میشه که خودتون هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.22,
   "end": 218.86,
   "text": "معمولاً هم اینطوریه. مگر شرایط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.86,
   "end": 222.76,
   "text": "محیطی یا مثلاً استثنایی ایجاد بشه، یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.76,
   "end": 225.3,
   "text": "یهو از مسیر پدر مادرش منحرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.3,
   "end": 227.84,
   "text": "حالا چه به سمت خوب، چه به سمت بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.84,
   "end": 232.12,
   "text": "معلمی، رفیق بدی. ولی معمولاً این چنینه که بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.12,
   "end": 234.7,
   "text": "copy paste پدر مادرش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.7,
   "end": 240.76,
   "text": "خب این حساسیت مهمه. مسئله بعدی اینجاست که خب اصلاً این، این هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.76,
   "end": 245.86,
   "text": "این که مخاطب به ما قرار میده یعنی اگر شما هم اون راهو برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.86,
   "end": 249.14,
   "text": "دچار همین میشید. یعنی اگر شما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.14,
   "end": 252.76,
   "text": "که نسل بعدی هستید، این ضمیر kom یعنی این دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.76,
   "end": 257.32,
   "text": "یعنی قرآن زنده است. داستان و قصه صرفاً نمیگه برای شما داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.32,
   "end": 260.78,
   "text": "اگر شما هم لجاجت کنید که دیروز بحثش گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.78,
   "end": 264.5,
   "text": "و چشم‌تون رو ببندید رو معجزات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.5,
   "end": 269.84,
   "text": "که روز به روز پیرامون ما داره این قصه رخ میده تو زندگی‌های شخصیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.84,
   "end": 272.6,
   "text": "واقعاً حتی تو بحث رزق ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.6,
   "end": 279.88,
   "text": "با این حقوقی که بعضی از ماها می‌گیریم واقعاً معجزه الهیه که ما این مشت فشارهای اقتصادی تا انتهای برج می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.88,
   "end": 283.12,
   "text": "به خدا یه معجزه‌ست که واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.12,
   "end": 284.98,
   "text": "شما دو تا چهار تا می‌کنی می‌بینی نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.98,
   "end": 289.1,
   "text": "اصلاً نباید. باید تا همون ده روز اول ماه تموم بشه که میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.1,
   "end": 291.88,
   "text": "بقیه‌ش چجوری میشه؟ کار خدا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.88,
   "end": 299.92,
   "text": "این خودش یه معجزه است. قابل توجه مدیرانه که از دستشون کار برمی‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.92,
   "end": 303.54,
   "text": "اما نکته اینجاست که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.54,
   "end": 310.42,
   "text": "خودمون باید به گونه‌ای عمل کنیم که فرزندان ما هم این راه رو نرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.42,
   "end": 312.8,
   "text": "اگه شما دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.8,
   "end": 319.22,
   "text": "خیلی جالبه که حضرت ابراهیم وقتی تو اون مقام خاص قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.22,
   "end": 325.16,
   "text": "و توی جا-- در جایگاهی قرار می‌گیره که جایگاه استجابت دعاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.16,
   "end": 329.18,
   "text": "و خود حضرت هم متوجه میشه که اینجا جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.18,
   "end": 334.08,
   "text": "مقدسی‌ست و در حالت استواج-- استجابت دعا هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.08,
   "end": 339.64,
   "text": "دعای عجیبی می‌کنه نه فقط برای خودش بلکه برای ذریه‌اش و نسل بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.64,
   "end": 345.96,
   "text": "اینکه این یه درس بزرگیه که ما حتی شده از دعا کردن برای بچه‌مون دریغ نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.96,
   "end": 348.5,
   "text": "چه برسه برنامه‌ریزی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.5,
   "end": 352.46,
   "text": "اون هم توی آیه سی و هفت سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.46,
   "end": 355.06,
   "text": "ابراهیمه. خیلی جالبه که می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.06,
   "end": 357.84,
   "text": "ببینید حالا مقدمه‌ش یه چیز نکته‌ای عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.84,
   "end": 361.58,
   "text": "هوی شما بررسی بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.58,
   "end": 365.98,
   "text": "معمولاً تو آیین روایت و آیات هوی بد ازش بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.98,
   "end": 368.15,
   "text": "یعنی به معنای بد اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.15,
   "end": 370.39,
   "text": "هوا هوس. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.39,
   "end": 374.39,
   "text": "مثلا تو سوره جاثیه آیه بیست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.39,
   "end": 380.53,
   "text": "ملاحظه فرمودید می فرماد \"أفرأيت من اتخذ إلهه هواه\" آیا نمی بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.53,
   "end": 387.95,
   "text": "کسایی رو که الهه خودشون رو هوا قرار دادن یعنی هوای نفسشون، خواهش دلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.95,
   "end": 393.39,
   "text": "توجه کردید؟ اما تنها من حالا بررسی‌م به اینجا رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.39,
   "end": 396.55,
   "text": "شما رو نمی دونم شاید شما بررسی کنید ببینید نه یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.55,
   "end": 399.79,
   "text": "یه جا دیگه هم پیدا کردید ولی من ندیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.79,
   "end": 405.01,
   "text": "جایی از هوا به خوبی یاد بشه جز یه جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.01,
   "end": 409.93,
   "text": "تو روایات دیدم، تو آیات دیدم، یه جا من فقط اینو پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.93,
   "end": 412.07,
   "text": "شاید شما یه جا دیگه هم پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.07,
   "end": 415.05,
   "text": "اونم همین آیه دعای حضرت ابراهیم برای نسلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.05,
   "end": 417.67,
   "text": "خیلی جالبه. می فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.67,
   "end": 420.61,
   "text": "آیه سی و هفت رو برید ببینید سوره حضرت ابراهیم علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.61,
   "end": 424.47,
   "text": "می فرمود \"فاجعل أفئدة من الناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.47,
   "end": 428.19,
   "text": "خدایا دل‌های مردم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.19,
   "end": 431.13,
   "text": "قرار بده چطور؟ \"تهوی اليهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.13,
   "end": 433.91,
   "text": "تهوی از هوا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.91,
   "end": 438.23,
   "text": "اليهم به سوی فرزندان من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.23,
   "end": 442.79,
   "text": "دل اونا رو هوا بده. یعنی نسل‌های بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.79,
   "end": 445.49,
   "text": "هوای فرزندان منو بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.49,
   "end": 448.51,
   "text": "هوس فرزندان من به سرشون بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.51,
   "end": 452.19,
   "text": "هوای دلشون خواهش دلشون بشه بچه های من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.19,
   "end": 456.37,
   "text": "خیلی دعای قشنگیه. خیلی دعای و این مستجاب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.37,
   "end": 461.67,
   "text": "چطور؟ تو تفسیر عیاشی جلد دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.67,
   "end": 468.59,
   "text": "حالا صفحه‌ش یادم نیست. اونجا یه روایت جالبی هست که امام باقر صلوات الله علیه می فرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.59,
   "end": 474.63,
   "text": "همین آیه رو قرائت میکنه که این \"فاجعل أفئدة من الناس تهوی اليهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.63,
   "end": 479.37,
   "text": "یعنی الینا\". امام باقر می فرماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.37,
   "end": 482.53,
   "text": "خیلی جالبه. یعنی اینکه ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.53,
   "end": 484.67,
   "text": "پیغمبر عرض کرده خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.67,
   "end": 491.19,
   "text": "دل مردم رو در آینده هوا بده، پر بده به سمت بچه های من این اليهم یعنی الینا یعنی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.19,
   "end": 492.93,
   "text": "یعنی ما اهل بیت و این صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.93,
   "end": 495.79,
   "text": "ببینید هوا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.79,
   "end": 499.51,
   "text": "دلم هوای تو کرده بگو چه چاره کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.51,
   "end": 502.11,
   "text": "هر که دارد هوس کرب و بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.11,
   "end": 510.55,
   "text": "این هوای دل فقط همین یه جا خوب از آب دراومده و اشکالی هم نداره آدم خواهش دلش هوای دلش به سمت اهل بیت میل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.55,
   "end": 512.53,
   "text": "خب این دعا رو برای بچه هامون هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.53,
   "end": 515.19,
   "text": "اونها رو هم به این سمت بکشونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.19,
   "end": 517.81,
   "text": "هواخواه اهل بیت باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 517.81,
   "end": 520.65,
   "text": "تهوی الی، \"تهوی إلا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.65,
   "end": 525.11,
   "text": "امام زمانشون بشن. این دلها بره به سمت آقا هوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.11,
   "end": 528.99,
   "text": "تا دلشون میگیره اول جایی که هوس کنن کربلا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.99,
   "end": 533.65,
   "text": "حرم امام رضا باشه. یه امامزاده ذریه حضرت زهرا سلام الله علیها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.65,
   "end": 538.75,
   "text": "نه دربند و شاندیز و آنتالیا و چه بلا جاهای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.75,
   "end": 542.05,
   "text": "هواشون امام حسین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.05,
   "end": 546.19,
   "text": "روا بود که گریبان هجر پاره کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.19,
   "end": 549.79,
   "text": "دلم هوای تو کرده است بگو چه چاره کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.79,
   "end": 553.19,
   "text": "چقدر قشنگه آدم دلش هوای اهل بیت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.19,
   "end": 556.69,
   "text": "هر که دارد هوس کرب و بلا بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.69,
   "end": 559.39,
   "text": "این دعای حضرت ابراهیم در حق نسلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.39,
   "end": 562.19,
   "text": "تو جایگاه خاص، تو حالت خاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.19,
   "end": 568.31,
   "text": "ما آیا در جایگاه‌های خاص و حالات خاص هوای بچه ها و نسلمون رو داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.31,
   "end": 573.25,
   "text": "همه حضرت علامه بهر، حضرت علامه مجلسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.25,
   "end": 578.11,
   "text": "پدرشون آقا محمد باقر بودند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.11,
   "end": 581.51,
   "text": "آقا محمد تقی، ببخشید آقا محمد تقی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.51,
   "end": 584.67,
   "text": "آ، پسرشون آقا محمد باقر بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 584.67,
   "end": 587.33,
   "text": "که از بزرگان شدند علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.33,
   "end": 593.53,
   "text": "پدرش میگه تو حالت استجابت قرار گرفتم صدای گریه بچم بلند شد دعاش کردم که اون از آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.53,
   "end": 595.65,
   "text": "نشر آثار اهل بیت و کنه همون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.65,
   "end": 599.17,
   "text": "یه دعای دل شب پدرش در حقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 599.17,
   "end": 602.49,
   "text": "این نکته اینجاست. \"ثم قصد قلوبکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 602.49,
   "end": 609.35,
   "text": "به ما چرا به گونه‌ای نشه که در ارتباط با بچه های ما بگن مثلا امام عصر یه روزی بچه های ما رو دید بگه عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 609.35,
   "end": 612.83,
   "text": "اصلا نسل ما رو ها، ده تا نسل ما رو ان شا الله زودتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.83,
   "end": 617.09,
   "text": "اما حالا بالاخره می بینن دیگه ها نسل ما ان شا الله ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 617.09,
   "end": 622.09,
   "text": "امام عصر نسل ما رو دید. چه دختر چه پسر بگه یادش بخیر یه بابایی داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 622.09,
   "end": 625.07,
   "text": "یه پدربزرگی داشتی، یه مادری داشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.07,
   "end": 627.71,
   "text": "خیلی خوب بود. خیلی ما ازش راضی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.71,
   "end": 629.51,
   "text": "خیلی دلش هوای ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 629.51,
   "end": 634.65,
   "text": "چقدر این قشنگه تا روشو برگردونه بگه اوه، اوه چه پدری داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.65,
   "end": 636.93,
   "text": "ببخشید یه ذره احساسی شد بحث ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.93,
   "end": 640.23,
   "text": "ولی نکته، نکته دقیق قرآنی‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 640.23,
   "end": 645.27,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 645.27,
   "end": 650.95,
