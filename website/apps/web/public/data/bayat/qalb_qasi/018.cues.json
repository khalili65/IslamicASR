 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 13.26,
   "end": 171.16
  },
  {
   "index": 1,
   "title": "## مرگ پیش از مرگ",
   "start": 171.16,
   "end": 370.99
  },
  {
   "index": 2,
   "title": "## ماجرایِ ملّا حسینقلی همدانی",
   "start": 370.99,
   "end": 530.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.3,
   "end": 5.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.28,
   "end": 9.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.14,
   "end": 13.26,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.26,
   "end": 16.1,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.1,
   "end": 19.2,
   "text": "طهارت داخل بینی چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.2,
   "end": 22.92,
   "text": "اگر داخل بینی ما نجس بشه خون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.92,
   "end": 25.88,
   "text": "داخل را چگونه تطهیر کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.88,
   "end": 28.02,
   "text": "آقا فرمودن اصلا طه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.02,
   "end": 29.9,
   "text": "تطهیر یا طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.9,
   "end": 32.64,
   "text": "داخل بینی نیازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 32.64,
   "end": 37.02,
   "text": "اولا موقع نماز اگر داخل بینی خون هم حتی باشه اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.02,
   "end": 41.86,
   "text": "میشه باهاش نماز خوند. در فضای داخلی بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.86,
   "end": 47.92,
   "text": "نه بیرونی و با برطرف شدن یعنی ازاله عین نجاست از داخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.92,
   "end": 52.74,
   "text": "بینی دیگه یعنی اون نجاست اون خونی که هست وقتی بیرون ریخته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.74,
   "end": 59.6,
   "text": "دیگه پاک میشه. نیاز نداره که با آب حتی اون داخل رو شستشو بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.6,
   "end": 63.76,
   "text": "نکته‌ی دیگری که باقی مونده بود از قصه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.76,
   "end": 68.18,
   "text": "سه تا نشانه‌ی شرح سدر در انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.18,
   "end": 74.98,
   "text": "که عرض کردیم بر اساس آیه بیست و دو سوره زمر که شرح سدر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.98,
   "end": 81.7,
   "text": "کنار قلب قسی معرفی میکنه و راه برون رفت از قساوت قلب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.7,
   "end": 83.68,
   "text": "شرح سدر بیان می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.68,
   "end": 86.34,
   "text": "شرح صدری که شرح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.34,
   "end": 89.16,
   "text": "صدره للاسلام دیگه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.16,
   "end": 93.36,
   "text": "سینه رو گشاده کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.36,
   "end": 101.04,
   "text": "حدیثی رو از تفسیر نور الثقلین آوردیم ابن مسعود که از پیغمبرش سؤال کرده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.04,
   "end": 105.38,
   "text": "چگونه این شرح سدر در انسان ایجاد میشه که پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.38,
   "end": 113.4,
   "text": "فرموده بودند که با نوری که خدا در قلب طرف می‌تابونه و انشراح و انفتاح ایجاد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.4,
   "end": 118.5,
   "text": "نشونه خواسته بود. پیغمبر سه تا نشونه دادن که ما دو تاشو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.5,
   "end": 121.88,
   "text": "فرموده بودند اولیش العنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.88,
   "end": 124.52,
   "text": "الى دار الخلود عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.52,
   "end": 129.66,
   "text": "دومیش التجافي عن دار الغرور اینم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.66,
   "end": 134.5,
   "text": "سومین نشانه کسی که شرح سدر پیدا کرده لذا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.5,
   "end": 137.42,
   "text": "مرض مزمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.42,
   "end": 141.64,
   "text": "قساوت قلب نجات پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.64,
   "end": 144.62,
   "text": "پیغمبر فرموده والاستعداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.62,
   "end": 148.52,
   "text": "للموت قبل نزوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.52,
   "end": 154.56,
   "text": "که امام مجتبی سلام الله علیه توی فرمایشی می‌فرمایند قبل حلول اجلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.56,
   "end": 158.24,
   "text": "یعنی آماده شدن برای مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.24,
   "end": 160.56,
   "text": "قبل از اینکه بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.56,
   "end": 162.98,
   "text": "خب این داستانش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.98,
   "end": 167.2,
   "text": "یعنی چی؟ یعنی مرگ قبل از مرگ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.2,
   "end": 169.76,
   "text": "یعنی تو خودت بمیری قبل از اینکه بمیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.76,
   "end": 172.44,
   "text": "موتو قبلاً تموتو این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.44,
   "end": 174.72,
   "text": "یعنی چاقو برداری خودتو بکشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.72,
   "end": 177.82,
   "text": "خودکشی کنی؟ چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.82,
   "end": 180.94,
   "text": "ببینید یه نکته خیلی مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.94,
   "end": 185.34,
   "text": "و لاپرانتز عرض کنم که خودش بحث‌ها می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.34,
   "end": 189.74,
   "text": "ما بعد از مرگ، ما مردن اصلاً در کارمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.74,
   "end": 193.8,
   "text": "انسان ابدیه. همه اوالم هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.8,
   "end": 196.88,
   "text": "از جمادات و نباتات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.88,
   "end": 199.96,
   "text": "عرض کنم حیوانات و عقول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.96,
   "end": 207.34,
   "text": "ملائکه، آسمان‌ها و زمین، کائنات، اصلاً یه عالم تکوین دست به دست هم دادن خرج انسان بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.34,
   "end": 210.78,
   "text": "همه میخوان خودشونو نذر انسان کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.78,
   "end": 213.26,
   "text": "چرا؟ چون میگن انسان ابدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.26,
   "end": 217.8,
   "text": "لوح محفوظ همون نفس ناطقه انسانی‌ست که در درون انسان...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.8,
   "end": 220.44,
   "text": "همه میخوان خرج انسان بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.44,
   "end": 222.14,
   "text": "مثلاً مردنی در کار نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.14,
   "end": 225.58,
   "text": "انسان ابدیه. پس بحث مردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.58,
   "end": 229.5,
   "text": "اینکه انسان ظاهراً از این دنیا میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.5,
   "end": 232.1,
   "text": "از حالتی به حالت دیگه‌ای در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.1,
   "end": 234.6,
   "text": "از عالمی به عالم دیگه‌ای وارد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.6,
   "end": 244.42,
   "text": "دوره‌ش عوض میشه. حالا اولین کاری که در عالم برزخ صورت می‌گیره لای روپی کانال‌های وجودی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.42,
   "end": 248.76,
   "text": "در درون ما کانال‌هایی رو خدا در قرار داده که باهاش مرتبط بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.76,
   "end": 253.02,
   "text": "این کانال‌ها لای روپی نشدن، زنگ زدن، آلوده شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.02,
   "end": 257.96,
   "text": "زنگار گرفتن. ما باید این که میگه موتو قبلاً تموتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.96,
   "end": 261.08,
   "text": "میگه قبل اینکه بمیری اون دنیا کانال تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.08,
   "end": 264.42,
   "text": "درون تو، وجود تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.42,
   "end": 267.18,
   "text": "عرض کنم خدمتتون حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.18,
   "end": 272.14,
   "text": "میشه گفت از قوای واهمه و خیا-خیالیه بگیر تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.14,
   "end": 279.22,
   "text": "قوای عاقله و نمی‌دونم قلب و روح و تا نهایت سر جان تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.22,
   "end": 283.24,
   "text": "قبل از اینکه اون دنیا تصفیه کنن، لای روبیش کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.24,
   "end": 285.92,
   "text": "همین جا انجام بده. این یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.92,
   "end": 290.44,
   "text": "مرگ قبل از مرگ. یعنی خودتو آماده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.44,
   "end": 293.42,
   "text": "اینجا خودت رو لای روپی کن که این کانال‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.42,
   "end": 299.18,
   "text": "وصل بشه، شبکه‌ها وصل بشه، همین جا چشمت به ملکوت باز شه، به شهود بیفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.18,
   "end": 302.58,
   "text": "چون اونجا به یکباره یه دفعه به شهود بیفتی سکته می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.58,
   "end": 305.52,
   "text": "اصلاً ظرفیتشو نداری و اذیت میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.52,
   "end": 309.52,
   "text": "اون فشار قبر، اون سختی‌ها خدا که بدش نمیاد که از بنده‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.52,
   "end": 313.22,
   "text": "خدا که دشمن بنده‌ش نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.22,
   "end": 315.76,
   "text": "بالاخره اونجا لای روپی رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.76,
   "end": 318.28,
   "text": "همون فشارها، همون سختی‌ها، همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.28,
   "end": 321.1,
   "text": "به ظاهر عذاب‌ها، به ظاهر جهنم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.1,
   "end": 327.8,
   "text": "اینا برای چی؟ برای اینکه اون لای روبیه صورت بگیره بتونی ملکوت رو م-مشاهده کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.8,
   "end": 330.98,
   "text": "بتونی خ-وجه خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.98,
   "end": 333.76,
   "text": "نظاره کنی. حالا نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.76,
   "end": 337.46,
   "text": "اونجا مجبوره. میگه اینجا خودتو جلو بنداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.46,
   "end": 342.26,
   "text": "جهش کن. اینجا خودت رو آماده کن برای اون مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.26,
   "end": 344.9,
   "text": "که از اینجا چشمت باز بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.9,
   "end": 347.04,
   "text": "حقیقت مرگ رو بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.04,
   "end": 350.4,
   "text": "که البته این عزیزان دلم زمان می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.4,
   "end": 356.98,
   "text": "نباید عجله کرد. البته در تحصیل علم و معرفت و این چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.98,
   "end": 359.96,
   "text": "لازمه این راهه باید تلاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.96,
   "end": 362.24,
   "text": "اما اینکه بخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.24,
   "end": 366.55,
   "text": "سریع بمیری سریع خودتو بکشی نه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.55,
   "end": 369.03,
   "text": "همون خودکشیه. این خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.03,
   "end": 371.73,
   "text": "باید وقت بذاری، زمان بذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.73,
   "end": 379.01,
   "text": "خدا رحمت کنه حاج ملا حسین قلی همدانی رحمت الله علیه رحمت الله قدس سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.01,
   "end": 381.31,
   "text": "چه عظمتی داشته این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.31,
   "end": 386.17,
   "text": "خودش میگه تو احوالاتش که تو نجف می‌دونید ایشون زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.17,
   "end": 391.79,
   "text": "میگه تو نجف تو حیاط خونه‌مون نشسته بودم رو کردم به امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.79,
   "end": 396.89,
   "text": "چندین سال بود این مشغول را-- لای روبی درون خودش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.89,
   "end": 401.15,
   "text": "خودشو داشت آماده می‌کرد قبل از اینکه بمیره اینجا بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.15,
   "end": 404.85,
   "text": "نفسشو بکشه برسه به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.85,
   "end": 407.47,
   "text": "مشاهده به شهود بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.47,
   "end": 410.41,
   "text": "در هر حال میگه رو کردم به حرم مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.41,
   "end": 414.29,
   "text": "گفتم آقا جان چندین ساله من دارم زجر می‌کشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.29,
   "end": 416.55,
   "text": "چرا راهی باز نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.55,
   "end": 419.25,
   "text": "چشم ما باز نمیشه. یه خواب خوشی ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.25,
   "end": 424.07,
   "text": "یه نسیم ملکوتی بوزه صدایی بشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.07,
   "end": 428.59,
   "text": "میگه تو همین حالت بود که یه پرنده‌ای اومد نشست تو حیاط خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.59,
   "end": 431.17,
   "text": "یه تیکه نونی گوشه حیاط افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.17,
   "end": 434.85,
   "text": "این پرنده هی نوک زد اینو بخوره هرچی زد سفته نمی‌تونه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.85,
   "end": 437.51,
   "text": "دوباره برگشت. دوباره هی نوک زد دید نمیشه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.51,
   "end": 446.87,
   "text": "دوباره برگشت. انقدر این پرنده رفت و اومد انقدر نوک به این نون خشک زد تا خوردش کرد و خورد خورد خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.87,
   "end": 451.63,
   "text": "و رفت. ملا حسین قلی همدانی رحمت الله علیه اینجا ملهم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.63,
   "end": 453.19,
   "text": "گفت آقا با من حرف زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.19,
   "end": 455.83,
   "text": "ببین یه پرنده تو این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.83,
   "end": 457.91,
   "text": "می‌تونه الهام به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.91,
   "end": 461.39,
   "text": "می‌تونه جبرائیل ما بشه به یک بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.39,
   "end": 464.91,
   "text": "خ-- اینطوری بهش خبر دادن که عجله نکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.91,
   "end": 468.11,
   "text": "تو کار خودتو بکن. ما می‌دونیم چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.11,
   "end": 471.45,
   "text": "بعد از بیست و دو سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.45,
   "end": 476.31,
   "text": "چشم باز شد. بعد بیست و دو سال زحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.31,
   "end": 485.07,
   "text": "به شهود رسید. طی طریق کرد به گونه‌ای که بعضیا تا پونصد تا اما من غالبا مثلا از علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.07,
   "end": 491.51,
   "text": "آملي رحمت-- حفظه الله تعالی و بسیاری از بزرگان دیگه شنیدم سیصد تا حالا خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.51,
   "end": 499.45,
   "text": "داغش نکن. سیصد تا دیگه قضیه سیصد تا از بزرگان و نفوس مستعد زمان خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.45,
   "end": 504.29,
   "text": "جزو عرفا و بزرگان و علما کرد که چشماشون باز شد و طی طریق کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.29,
   "end": 507.35,
   "text": "سیصد تا عارف پروروند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.35,
   "end": 512.45,
   "text": "اما خودش بیست و دو سال زحمت کشید، جان به لب آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.45,
   "end": 514.57,
   "text": "تا آماده شد. پس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.57,
   "end": 516.19,
   "text": "زمان می‌بره. باید وقت گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.19,
   "end": 521.59,
   "text": "ان شا الله که عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.59,
   "end": 527.77,
   "text": "اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.77,
   "end": 530.37,
   "text": "محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}