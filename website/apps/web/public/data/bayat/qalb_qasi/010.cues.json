   "title": "## ختم آیه: زینت عمل توسط شیطان",
   "start": 462.39,
   "end": 683.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 4.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.0,
   "end": 7.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.68,
   "end": 11.82,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.82,
   "end": 14.4,
   "text": "در خصوص طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.4,
   "end": 18.0,
   "text": "استفتای دیگه ای که از رهبر عزیزمون شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.0,
   "end": 22.4,
   "text": "سؤال شده که آیا در شستن لباس با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.4,
   "end": 29.78,
   "text": "آب کر یا جاری فشار دادن یا تکون دادن لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.78,
   "end": 32.5,
   "text": "واجبه یا نه؟ ما می‌خوایم لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.5,
   "end": 35.04,
   "text": "متنجس رو بشوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.04,
   "end": 37.48,
   "text": "و پاکش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.48,
   "end": 45.44,
   "text": "آیا نیاز داره که اونطور که آب رو می‌ریزیم، آب کر یا جاری رو، لباس رو تکون بدیم یا فشارش بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.44,
   "end": 50.02,
   "text": "آقا فرمودن احتیاط، احتیاطاً فشار بدید یا تکون بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.02,
   "end": 53.78,
   "text": "چون بلافاصله بدون دادن فتوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.78,
   "end": 56.96,
   "text": "اینجا آقا احتیاط کردن میشه احتیاط چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.96,
   "end": 61.92,
   "text": "واجب. یعنی یا همین کارو بکنید یا اینکه رجوع کنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.92,
   "end": 64.56,
   "text": "ممم، مجتهدی که بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.56,
   "end": 67.52,
   "text": "آقا اعلمه از نظر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.52,
   "end": 70.68,
   "text": "پس حالا سؤال دیگه ای که شده که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.68,
   "end": 73.2,
   "text": "که ما می‌خوایم احتیاط شما رو عمل کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.2,
   "end": 78.16,
   "text": "با آقا پرسیدن می‌خوایم احتیاط شما رو عمل کنیم، فشار بدیم یا تکون بدیم لباس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.16,
   "end": 83.9,
   "text": "بعد از اینکه عین متنجس بر-- عین نجاست برطرف شد از متنجس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.9,
   "end": 87.64,
   "text": "خب آیا داخل آب فشار بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.64,
   "end": 93.14,
   "text": "کفایت می‌کنه یا داخل آب تکون بدیم یا بیاریم بیرون فشار بدیم لباس رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.14,
   "end": 98.58,
   "text": "آقا فرمودن همون داخل آب هم شما لباس رو تکون بدید یا فشار بدید کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.58,
   "end": 102.54,
   "text": "نیازی نداره حتما بیارید بیرون آب این کارو بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.54,
   "end": 109.08,
   "text": "خب یکی دیگه از آیاتی که پیرامون قلب قسی هست آیه چهل و سه سوره انعام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.08,
   "end": 115.34,
   "text": "قرائت کنیم. می‌فرماید که \"فَلَوْلَا إِذَا جَاءَهُمْ بَعْثُنَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.34,
   "end": 121.1,
   "text": "تَضَرَّعُوا\". پس چرا وقتی که بلای ما به اینا رسید بعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.1,
   "end": 123.62,
   "text": "به قوت و شدت میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.62,
   "end": 126.18,
   "text": "لکن اینجا معنای عذاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.18,
   "end": 129.0,
   "text": "\"فَلَوْلَا إِذَا جَاءَهُمْ بَعْثُنَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.0,
   "end": 134.88,
   "text": "تَضَرَّعُوا\" چرا اینا وقتی که عذاب ما براشون نازل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.88,
   "end": 138.72,
   "text": "تض-- لا تضرعوا لا بر-- مال همین فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.72,
   "end": 141.14,
   "text": "چرا اینا تضرع نکردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.14,
   "end": 144.36,
   "text": "نیومدن در خونه ما زاری کنن تا نجاتشون بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.36,
   "end": 147.84,
   "text": "\"فَلَوْلَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.84,
   "end": 152.48,
   "text": "إِذْ جَاءَهُمْ بَعْثُنَا تَضَرَّعُوا\" چرا تضرع، تضرع نکردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.48,
   "end": 159.1,
   "text": "چرا زاری نکردن؟ خود قرآن جوابشو میده \"وَلَٰكِن قَسَتْ قُلُوبُهُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.1,
   "end": 163.8,
   "text": "علتشو می‌خواید به شما بگم؟ چونکه این‌ها دچار قسابت قلب شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.8,
   "end": 170.42,
   "text": "البته بعضیا به این گونه ترجمه کردن فرمودن چون تضرع نکردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.42,
   "end": 174.34,
   "text": "قسابت قلب گرفتن. بعضی از مفسرین این‌گونه ترجمه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.34,
   "end": 177.2,
   "text": "بعضی از مفسرین امروز بررسی می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.2,
   "end": 180.2,
   "text": "دیدم نه، برعکس. گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.2,
   "end": 184.88,
   "text": "اه اصلاً دلیل اینکه تضرع نکردن قسابت قلبشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.88,
   "end": 187.66,
   "text": "در هر حال دو صورت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.66,
   "end": 193.38,
   "text": "کسی که تضرع نکند در درگاه خدا قطعاً قسابت قلب پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.38,
   "end": 198.86,
   "text": "و کسی هم که تضرع نمی‌کنه دلیلش قسابت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.86,
   "end": 204.82,
   "text": "یعنی دوتاش هم درسته. \"وَزَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا يَعْمَلُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.82,
   "end": 207.64,
   "text": "بلافاصله می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.64,
   "end": 213.86,
   "text": "بعد که اینا دلاشون قسابت گرفت، شیطون کردار زشت اینا رو تو نظرشون زینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.86,
   "end": 217.3,
   "text": "زیبا جلوه می‌ده. پس اگر کسی دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.3,
   "end": 220.32,
   "text": "قسابت قلب بشه، در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.32,
   "end": 224.3,
   "text": "تضرع نکردن به درگاه خدا رجوع نکردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.3,
   "end": 228.14,
   "text": "چه اتفاقی میفته؟ شیطون میاد دست به کار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.14,
   "end": 230.46,
   "text": "و کارهاشو براش زینت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.46,
   "end": 234.78,
   "text": "یه کاری می‌کنه که حتی کار به جایی می‌رسه که کارهای زشتشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.78,
   "end": 237.74,
   "text": "براش زیبا جلوه می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.74,
   "end": 243.7,
   "text": "پیرامون این قصه آیه صد و سه و صد و چهار کهف به تمام معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.7,
   "end": 249.62,
   "text": "این رو برای ما بیان کردن. خیلی از آیه‌های پر نهیب و تکون دهنده‌ست خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.62,
   "end": 252.24,
   "text": "آدم واقعاً با این آیات تنش می‌لرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.24,
   "end": 254.22,
   "text": "که نکنه مصداق این آیات باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.22,
   "end": 258.6,
   "text": "می‌فرماید \"قُلْ هَلْ نُنَبِّئُكُمْ بِالْأَخْسَرِينَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.6,
   "end": 261.52,
   "text": "أَعْمَالًا\". می‌خواید به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.52,
   "end": 265.2,
   "text": "زیان‌کارترین مردم کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.2,
   "end": 273.62,
   "text": "أخسَرينَ أَعْمَالًا. بعد خود قرآن می‌فرماید \"الَّذِينَ ضَاعَ سَعْيُهُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.62,
   "end": 277.04,
   "text": "ضَاعَ یعنی ظاهراً گم شد اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.04,
   "end": 278.78,
   "text": "نابود شد معنا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.78,
   "end": 282.08,
   "text": "\"الَّذِينَ ضَاعَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.08,
   "end": 285.32,
   "text": "کسانی که گم شد سَعْيُهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.32,
   "end": 288.1,
   "text": "تلاششون فِي الْحَيَاةِ الدُّنْيَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.1,
   "end": 291.14,
   "text": "یعنی هر کاری کردن اینا چیزی براشون نموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.14,
   "end": 298.08,
   "text": "در صورتی که \"وَهُمْ يَحْسَبُونَ\" اینا گمان می‌کردن \"أَنَّهُمْ يُحْسِنُونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.08,
   "end": 300.32,
   "text": "صُنْعًا\" گمان می‌کردن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.32,
   "end": 303.7,
   "text": "مثلا بهترین کار نیک رو داشتن انجام می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.7,
   "end": 306.24,
   "text": "خیلی نهیب داره که گاهی اوقات آدم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.24,
   "end": 309.44,
   "text": "البته این بدونیم که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.44,
   "end": 312.34,
   "text": "هم عقاید این امکان وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.34,
   "end": 315.52,
   "text": "هم اقوال، هم افعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.52,
   "end": 319.44,
   "text": "یعنی میشه انسان دچار عقیده فاسدی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.44,
   "end": 323.1,
   "text": "شیطان و نفس بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.1,
   "end": 327.84,
   "text": "این تسویه‌ رو براش ایجاد بکنن که گمان کنن آخه عقیده درستی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.84,
   "end": 331.86,
   "text": "هرچی هم بهش میگن قبول نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.86,
   "end": 335.48,
   "text": "یا در اقوالش حرفی رو می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.48,
   "end": 338.9,
   "text": "که یا در کردارش فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.9,
   "end": 340.9,
   "text": "کاری رو انجام میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.9,
   "end": 344.46,
   "text": "همه بهش نصیحت می‌کنن، همه تذکر میدن، انتقاد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.46,
   "end": 346.16,
   "text": "بابا این چه کاری بود تو کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.16,
   "end": 350.44,
   "text": "این چه حرفی بود تو زدی؟ این چه فکر غلط و باطلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.44,
   "end": 354.62,
   "text": "این چه تضیه، این چه فرهنگیه، این چه تفسیر به رأیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.62,
   "end": 357.92,
   "text": "این چه راهیه؟ ولی گوش شنوایی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.92,
   "end": 362.97,
   "text": "چرا؟ چون قرآن اینجا می‌فرماید \"وَلَٰكِن قَسَتْ قُلُوبُهُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.97,
   "end": 366.33,
   "text": "چون دل سنگ شده، دلش سنگ شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.33,
   "end": 368.57,
   "text": "به جهت اینکه به درگاه ما رجوع نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.57,
   "end": 371.77,
   "text": "یکی از جانبازای زمان جنگ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.77,
   "end": 379.35,
   "text": "هشت سال دفاع مقدس بوده و بسیاری از شاهدای فرمانده‌های بزرگ دفاع مقدس عکس داشت، من ایشونو دیدم، اینجام اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.35,
   "end": 382.23,
   "text": "برخورد خیلی ناشایستی سازمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.23,
   "end": 385.95,
   "text": "متاسفانه با ایشون کرد که دل ما پردرد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.95,
   "end": 390.29,
   "text": "به هر حال اهل قلم می‌دونید بعضی از شما، اهل قلم به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.29,
   "end": 393.65,
   "text": "و رهبری از بعضی از آثار ایشون تقدیر کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.65,
   "end": 397.97,
   "text": "متاسفانه گوشه‌ی خونه افتاده کسی هم به دادش نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.97,
   "end": 400.33,
   "text": "همه زندگیشو باخته بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.33,
   "end": 404.13,
   "text": "ایشون یه جمله‌ی خیلی جالبی به من گفت خیلی به دلم نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.13,
   "end": 409.29,
   "text": "رجوع کرده بود به بعضی از این مسئولین و دست رد به سینه ش زده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.29,
   "end": 412.17,
   "text": "و گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.17,
   "end": 413.87,
   "text": "عیبی نداره حاجی غصه نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.87,
   "end": 418.55,
   "text": "کسی که اشک برای امام حسین سلام الله علیه نداره دلش سنگ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.55,
   "end": 423.33,
   "text": "اصلاً نمی‌تونه. نه بهش اجازه نمیدن گره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.33,
   "end": 425.01,
   "text": "گریه کنن امام حسین باز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.01,
   "end": 427.41,
   "text": "این اصلاً جمله‌ی جالبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.41,
   "end": 432.99,
   "text": "واقعاً کسی که تضرع نداره، اشک نداره، زاری نداره، به درگاه خدا رجوع نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.99,
   "end": 434.75,
   "text": "واقعاً دل سنگ می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.75,
   "end": 437.45,
   "text": "نمی‌تونه بفهمه درد دیگران چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.45,
   "end": 439.95,
   "text": "اگر ببینید بعضی از مسئولین ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.95,
   "end": 444.19,
   "text": "چنان رفاه زده شدند یا به قول رهبر عزیرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.19,
   "end": 450.81,
   "text": "اشرافی‌گری رو پیش گرفتن، شما فکر می‌کنید جز دل سنگ شدنه، جز نرفتن در خونه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.81,
   "end": 457.25,
   "text": "اگر این نیمه شب داشت، اگر سحر داشت، اگر تضرع و اشک و آه داشت مگه می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.25,
   "end": 460.67,
   "text": "خودش سوار ماشین پونصد میلیونی بشه بعد ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.67,
   "end": 464.15,
   "text": "یه نفر با سه تا عائله، چهار تا عائله رو موتور تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.15,
   "end": 466.37,
   "text": "سرمای زمستون داره میره بی‌تفاوت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.37,
   "end": 469.31,
   "text": "اصلاً نمی‌شه. اینا با هم جور در نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.31,
   "end": 471.53,
   "text": "یا اون کسی که میاد تحریف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.53,
   "end": 476.35,
   "text": "یُحَرِّفُونَ الْكَلِمَ عَن مَّوَاضِعِهِ آیه سیزده سوره مائده دیروز بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.35,
   "end": 480.49,
   "text": "تحریف می‌کنه انقلاب رو، دین رو، قرآن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.49,
   "end": 483.85,
   "text": "اینایی که خدا هدایت کنه تو لباس پیغمبر میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.85,
   "end": 486.31,
   "text": "کی گفته اصلاً جهنمی هست عقابی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.31,
   "end": 490.01,
   "text": "این حرفا چیه؟ لباس آقاخوندی هم پوشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.01,
   "end": 491.85,
   "text": "بعد اراجیف می‌باfe.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.85,
   "end": 495.27,
   "text": "این‌ها چیزی جز قساوت قلب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.27,
   "end": 499.01,
   "text": "آثار همونه. یا اینایی که حرفایی می‌زنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.01,
   "end": 504.19,
   "text": "واقعاً آدمی که حتی کمترین تحلیل رو داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.19,
   "end": 507.99,
   "text": "یه بچه متوجه می‌شه این آقا توهم زده اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.99,
   "end": 512.15,
   "text": "یُحَرِّفُونَ الْكَلِمَ عَن مَّوَاضِعِهِ داره ارزش‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.15,
   "end": 514.69,
   "text": "منصرف می‌کنه، منحرف می‌کنه، داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 514.69,
   "end": 517.67,
   "text": "انحصار مطلوب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.67,
   "end": 520.29,
   "text": "و یه بچه می‌فهمه مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.29,
   "end": 522.81,
   "text": "آقایی که متاسفانه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.81,
   "end": 525.43,
   "text": "یعنی می‌شه چجوری بگم من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.43,
   "end": 529.71,
   "text": "نمی‌خوام اسم ببرم اما از مسئولین طراز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.71,
   "end": 535.61,
   "text": "جبهه فرهنگی یا بلکه خط مقدم جبهه فرهنگی نظام و رسانه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.61,
   "end": 538.93,
   "text": "تو اخیراً دانشجوها که دورش جمع می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.93,
   "end": 544.55,
   "text": "همین هفت-- چند روز پیش باید بیان کنه که بله، من صراح-- صریح به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.55,
   "end": 548.57,
   "text": "به سینه بکوبه که شهید حججی رو من حججی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.57,
   "end": 551.79,
   "text": "بشین سر جات بچه، تو شهید حججی رو حججی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.79,
   "end": 555.85,
   "text": "اگه کسی بخواد بازی دنیایی انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.85,
   "end": 559.21,
   "text": "این شطرنجی بازی کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.21,
   "end": 561.49,
   "text": "باید گفت فضای مجازی عمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.49,
   "end": 566.39,
   "text": "بعد شما پشت سرش. شما حتی عرضه نداشتید یکی مثل سرلشکر سلیمانی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 566.39,
   "end": 571.87,
   "text": "سردار سلیمانی رو بولد کنید، برجسته کنید به عنوان یک الگو و اسطوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 571.87,
   "end": 574.15,
   "text": "معرفی کنید به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 574.15,
   "end": 577.97,
   "text": "مق-- جبهه مقاومت، خود عراقی‌ها، سوریه براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 577.97,
   "end": 581.03,
   "text": "مستند ساختن. بیش از اینکه شما دست به کار بشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 581.03,
   "end": 582.57,
   "text": "شما عرضه اینم نداشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 582.57,
   "end": 586.11,
   "text": "بعد حالا شهید حججی رو شما حججی کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.11,
   "end": 591.05,
   "text": "آدم دوست داره حالا لااقل نکردن مثل اون بنده خدا که شنیده بود امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.05,
   "end": 593.81,
   "text": "البته شوخی کرده بود یه بچه بسیجی اما نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.81,
   "end": 601.31,
   "text": "مثل، نکرده مثل اون بگه که گفته بود امام فرمود خرمشهر را خدا آزاد کرد اما ما هم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.31,
   "end": 605.91,
   "text": "لااقل نکرده مرتیکه اینطوری بگه که آقا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.91,
   "end": 612.01,
   "text": "عرض کنم که شهید حججی رو خدا شهید حججی کرد اما ما هم بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.01,
   "end": 614.87,
   "text": "ما شهید حججی رو حججی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.87,
   "end": 618.55,
   "text": "چقدر آدم باید توهم بزنه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.55,
   "end": 624.73,
   "text": "آیا جز اینه که مصداق این آیات‌اند این‌هایی که اینچنین فکر می‌کنند و متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.73,
   "end": 630.39,
   "text": "اصلاً نه درد حالیشونه، نه مستضعف حالیشونه، نه پابرهه حالیشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.39,
   "end": 637.63,
   "text": "نه ارزش‌های انقلاب رو خوب می‌شناسن و دل رهبر پر از خونه از دست این‌ها و ماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.63,
   "end": 642.13,
   "text": "امیدوارم که خدای ممنون یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.13,
   "end": 645.23,
   "text": "این‌ها رو به عقل بیاره. نمی‌دونم چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.23,
   "end": 649.11,
   "text": "انتها آیه می‌فرماید زَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.11,
   "end": 653.21,
   "text": "يَعْمَلُونَ. شیطان دست به کار شده این زینت کرده برای اینا کارهاشونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.21,
   "end": 655.95,
   "text": "خودشون نمی‌فهمن. تفا-- توهم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.95,
   "end": 659.19,
   "text": "هم در قول، هم در فعل، هم در عقاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.19,
   "end": 663.47,
   "text": "دیگه چقدر دیگه. میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.47,
   "end": 666.31,
   "text": "چی میگن این دم خروس رو دیدیم قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.31,
   "end": 669.17,
   "text": "روباه و این حرفا. ایشالله عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 669.17,
   "end": 673.23,
   "text": "ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.23,
   "end": 683.83,
   "text": "اللهم صل على محمد و آل محمد. اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}