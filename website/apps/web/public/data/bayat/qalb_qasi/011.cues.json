 ],
 "cues": [
  {
   "i": 0,
   "start": 0.8,
   "end": 4.62,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.62,
   "end": 7.06,
   "text": "السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.06,
   "end": 10.48,
   "text": "داعی الله و ربانیة آياته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.48,
   "end": 12.52,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.52,
   "end": 16.56,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.56,
   "end": 23.06,
   "text": "آیا برای غسل و وضو و اینها میشه از آب دریاچه‌ای مثل مثلا دریاچه ارومیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.06,
   "end": 28.02,
   "text": "آب دریاچه یا دریاهایی که بر اثر وجود املاح غلظت گرفتن استفاده کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.02,
   "end": 31.76,
   "text": "شرعا جایزه. رهبری فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.76,
   "end": 34.62,
   "text": "صرف داشتن غلظت و املاح آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.62,
   "end": 39.28,
   "text": "مانع از صدق آب مطلق نمیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.28,
   "end": 42.92,
   "text": "بلکه ترتب آثار شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.92,
   "end": 47.8,
   "text": "بر این آب مطلق یا این آب برمی‌گرده به عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.8,
   "end": 53.04,
   "text": "که اینکه این مصداق آب مطلق هست یا نه به عرف برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.04,
   "end": 57.5,
   "text": "یعنی اینکه مردم اونجا، اون محل این آب رو آب مطلق می‌دونن یا نه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.5,
   "end": 60.68,
   "text": "باید از اون‌ها جستجو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.68,
   "end": 64.22,
   "text": "اما در خصوص قلب قسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.22,
   "end": 68.22,
   "text": "رسیدیم به آیه چهل و سه سوره انعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.22,
   "end": 74.46,
   "text": "که می‌فرماد «فلولا اذ جاءهم بعثنا تضرعوا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.46,
   "end": 81.7,
   "text": "چرا وقتی که بلای ما به آن‌ها رسید تضرع و زاری نکردند تا نجات پیدا کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.7,
   "end": 84.52,
   "text": "بعد خدا می‌فرماید که می‌خواید به شما بگم علتشو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.52,
   "end": 87.28,
   "text": "«ولکن قست قلوبهم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.28,
   "end": 90.5,
   "text": "بلکه این‌ها دچار قساوت قلب شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.5,
   "end": 93.2,
   "text": "البته میشه خود قساوت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.2,
   "end": 99.26,
   "text": "سبب بشه انسان تضرع و زاری نداشته باشه یا به عکس که قبلا عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.26,
   "end": 104.78,
   "text": "در حقیقت اینکه ما تضرع و زاری نداریم علت عمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.78,
   "end": 108.0,
   "text": "مشکلات قلبی و قساوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.0,
   "end": 111.4,
   "text": "دل ما و سنگینی دل ما، سختی دل ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.4,
   "end": 116.8,
   "text": "در این دنیای وانفسا اگر ما تضرع و زاری و انابه در درگاه خدا نداشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.8,
   "end": 120.2,
   "text": "قطعا دل می‌میره، دل سنگ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.2,
   "end": 122.34,
   "text": "ما یکی از دلایل اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.34,
   "end": 126.34,
   "text": "یک، در یک بی‌خبری محضی فرو رفتیم عزیزان دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.34,
   "end": 133.62,
   "text": "اینه که بی‌خبریم از، یعنی یا غافلیم از آنچه که قراره ببینیم و قراره طی کنیم مراحلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.62,
   "end": 136.16,
   "text": "یک یک باید پشت سر هم بگذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.16,
   "end": 141.62,
   "text": "که پیامبر عظیم الشأن اسلام قربونش بریم فرمودند که اگر شما بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.62,
   "end": 146.96,
   "text": "بعد از مرگ چه مراحلی و منازلی رو باید طی کنید خنده به لبتون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.96,
   "end": 149.0,
   "text": "واقعا ما در یک بی‌خبری هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.0,
   "end": 155.78,
   "text": "خدا رحمت کنه علامه حضرت آیت الله العظمی شهاب الدین بزرگ رو در کتاب شجر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.78,
   "end": 159.14,
   "text": "شجرات المعارفش میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.14,
   "end": 165.52,
   "text": "که وقتی ما از این دنیا میریم همون آن، یعنی لحظه‌ای که ما وارد عالم برزخ میشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.52,
   "end": 169.9,
   "text": "اونجا تمثلات حقیقت وجودی خودمون رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.9,
   "end": 174.7,
   "text": "خب می‌دونید ما اه وجودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.7,
   "end": 178.06,
   "text": "بسته به یک حواس ماست که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.06,
   "end": 180.32,
   "text": "بر سر حواس اعمالمون رو انجام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.32,
   "end": 182.8,
   "text": "مثل بینایی، چشایی، بویایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.8,
   "end": 185.34,
   "text": "لامسه، شنوایی، همه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.34,
   "end": 188.38,
   "text": "و عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.38,
   "end": 193.98,
   "text": "حواس یا عرض کنم ملکات وجودمون یا همون اخلاقیاتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.98,
   "end": 199.54,
   "text": "و همچنین قوای عاقله‌ی وجودمون یا حوزه قلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.54,
   "end": 202.38,
   "text": "این بزرگوار می‌فرماید که سلاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.38,
   "end": 206.56,
   "text": "عالم برزخ سه تا‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.56,
   "end": 210.14,
   "text": "که این‌ها هر کدوم تمثلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.14,
   "end": 212.98,
   "text": "وجودی انسان رو بررسی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.98,
   "end": 217.12,
   "text": "سلطان حس ما که اسمش رومان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.12,
   "end": 220.48,
   "text": "این بررسی می‌کنه در حوزه حس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.48,
   "end": 226.88,
   "text": "مثلا ما اگر تو این دنیا خدای نکرده نگاه حرامی داشته باشیم به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.88,
   "end": 233.44,
   "text": "از قوه باصره‌مون به حرام استفاده کنیم، نگاهی داشته باشیم به نامحرم و لذت ببریم، اینجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.44,
   "end": 239.6,
   "text": "فاصله بین ما و اون شخص با نور طی میشه اما اون ور بدل به نار میشه، عذاب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.6,
   "end": 243.86,
   "text": "یا می‌فرماید اینجا شاید چهره رو ببینی لذت ببری، چهره زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.86,
   "end": 246.72,
   "text": "اما همین تمثل برزخی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.72,
   "end": 250.32,
   "text": "چنان کریه المنظر میشه که آرزو می‌کنی بین او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.32,
   "end": 253.76,
   "text": "و تو فاصله مشرقین باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.76,
   "end": 258.72,
   "text": "مشرق و مغرب باشه و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.72,
   "end": 265.7,
   "text": "سلطان بعدی که بررسی می‌کنه تمثلات نفسانی وجود انسان رو اسمش فتان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.7,
   "end": 268.74,
   "text": "که ملکات اخلاقی رو بررسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.74,
   "end": 273.02,
   "text": "ببینه در وجود تو ملکه عفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.02,
   "end": 278.66,
   "text": "قرار گرفته، یعنی مالک وجودت در حوزه اخلاقیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.66,
   "end": 282.54,
   "text": "عفته یا خدای نکرده هرزگی و شهوت‌رانی و ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.54,
   "end": 285.82,
   "text": "ملکه عدالت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.82,
   "end": 290.48,
   "text": "بی‌عدالتی و بی‌توجهی به حقوق دیگرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.48,
   "end": 292.7,
   "text": "ملکه حلم و صبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.7,
   "end": 297.48,
   "text": "یا خشم و غضبه. این‌ها ملکات وجودی انسان رو بررسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.48,
   "end": 302.34,
   "text": "یعنی در حقیقت این‌ها اونجا خودش رو نشون میده منتها با قواعد عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.34,
   "end": 307.34,
   "text": "و سومین سلطان هم که فرمود اعظم سلاطین هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.34,
   "end": 310.72,
   "text": "اون ملکی هست که حوزه عقل انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.72,
   "end": 314.98,
   "text": "بررسی می‌کنه در حوزه البته عقاید انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.98,
   "end": 318.48,
   "text": "که اگر شخصی که از دنیا رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.48,
   "end": 320.8,
   "text": "عقاید صحیح داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.8,
   "end": 323.76,
   "text": "موحد باشه، او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.76,
   "end": 328.74,
   "text": "به نام بشیر و مبشر و به چهره بشیر و مبشر می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.74,
   "end": 334.4,
   "text": "اما اگر اه خدای نکرده منافق و مشرک و کافر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.4,
   "end": 337.14,
   "text": "به چهره نکیر و منکر می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.14,
   "end": 342.6,
   "text": "در حقیقت این دو یک وجودند اما جلوه‌ها، جلوه‌گری‌شون به اشخاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.6,
   "end": 345.66,
   "text": "و وجودشون بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.66,
   "end": 352.24,
   "text": "خب اگر چنانچه ما همین، همین، همین نکته‌ای رو که عرض کردم رو بدونیم که ما قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.24,
   "end": 354.96,
   "text": "تمام آنچه که در این سه حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.96,
   "end": 359.04,
   "text": "اعم از عقایدمون، ملکات اخلاقی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.04,
   "end": 362.27,
   "text": "و اعمالمون که با حواس انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.27,
   "end": 365.15,
   "text": "اینا رو قراره حقیقتشو در اون ور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.15,
   "end": 368.47,
   "text": "عالم ببینیم و به زودی هم این اتفاق خواهد افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.47,
   "end": 372.83,
   "text": "خب آدم اهل تضرع میشه، اهل انابه میشه، اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.83,
   "end": 375.37,
   "text": "توجه و توسل میشه. اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.37,
   "end": 379.45,
   "text": "دیگه دچار قساوت قلب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.45,
   "end": 382.61,
   "text": "که حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.61,
   "end": 386.29,
   "text": "کتاب یادم هست در کتاب هزار و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.29,
   "end": 389.23,
   "text": "حکایت قرآنی صفحه بیست و شش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.23,
   "end": 392.19,
   "text": "ظاهراً که یه حکایتی رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.19,
   "end": 397.49,
   "text": "یه زن بدکاره‌ای نقل میکنه به نام شعوانه که در بصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.49,
   "end": 400.99,
   "text": "خونه فساد داشته و به هر حال علیعاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.99,
   "end": 403.77,
   "text": "از همین راه رقاصه گری و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.77,
   "end": 408.67,
   "text": "از راه گناه و معصیت پول زیادی بدست میاورده و حتی کنیزکانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.67,
   "end": 411.83,
   "text": "خریداری کرده بود. یه روز رد میشدن از یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.83,
   "end": 416.67,
   "text": "محلی که میبینه از داخل منزل صدای عجیبی بلنده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.67,
   "end": 419.57,
   "text": "این‌ها. یکی از کنیزاشو میفرسته برو داخل ببین چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.57,
   "end": 422.99,
   "text": "این کنیز میره برنمی‌گرده. کنیز دوم میره برنمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.99,
   "end": 427.33,
   "text": "سوم همه کنیزا. خلاصه متعجب میشه این شعوانه که چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.33,
   "end": 431.63,
   "text": "خودش میره داخل میبینه که یه عارف نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.63,
   "end": 437.99,
   "text": "و با یک حال خاصی داره مردم رو موعظه میکنه و آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.99,
   "end": 442.09,
   "text": "یازده تا چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.09,
   "end": 447.77,
   "text": "سوره فرقان رو داره قرائت میکنه و این اثر این آیات و نفس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.77,
   "end": 450.13,
   "text": "عارف چنان همه رو منقلب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.13,
   "end": 453.53,
   "text": "اینم میشینه گوش میده تحت تاثیر قرار میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.53,
   "end": 457.09,
   "text": "واقعا کجان این بزرگوارانی که نفسشون اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.09,
   "end": 461.63,
   "text": "من در خودمم تاثیر ندارم چه برسه به شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.63,
   "end": 463.57,
   "text": "به هر حال میشینه و منقلب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.57,
   "end": 467.85,
   "text": "خلاصه مطلب الغرض ایشون منقلب میشه و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.85,
   "end": 470.85,
   "text": "و منقطع میشه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.85,
   "end": 475.79,
   "text": "علائق دنیوی‌ش و برمی‌گرده به این واعظ میگه که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.79,
   "end": 477.35,
   "text": "راه توبه‌ای برای ما هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.35,
   "end": 481.53,
   "text": "ما خیلی آلوده‌ایم و این‌ها عجیبه که این واعظ میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.53,
   "end": 485.45,
   "text": "اگر گناهان تو به قدر شعوانه هم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.45,
   "end": 489.15,
   "text": "خدا میبخشت. بعد این به گریه میفته و میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.15,
   "end": 490.99,
   "text": "چی میگی تو که شعوانه خود منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.99,
   "end": 495.21,
   "text": "بیرون میاد منقلب میشه اینقدر گریه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.21,
   "end": 497.23,
   "text": "کنیزکانش رو در راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.23,
   "end": 501.73,
   "text": "آزاد میکنه. هرچه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.73,
   "end": 504.59,
   "text": "در راه خدا میده خودش رو تطهیر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.59,
   "end": 507.25,
   "text": "توبه جانانه میکنه. شب و روز میسوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.25,
   "end": 510.31,
   "text": "گریان میشه به گونه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.31,
   "end": 516.37,
   "text": "کم کم چنان مقامات معنوی و معرفتی پیدا میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.37,
   "end": 519.65,
   "text": "نوشته‌اند عباد زمان می‌اومدن زانو می‌زدن جلوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.65,
   "end": 526.93,
   "text": "تو مجالسی که ایشون چشمای بسته زار زار گریه می‌کرده و وعظ می‌کرده، می‌نشستن از نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.93,
   "end": 530.09,
   "text": "و از این سوز درونش استفاده می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.09,
   "end": 533.75,
   "text": "به هر حال که بهش می‌گفتن بابا تو نابینا میشی، اینقدر گریه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.75,
   "end": 537.51,
   "text": "می‌گفت اگر این دنیا نابینا باشم بهتره تا قیامت نابینا بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 537.51,
   "end": 540.97,
   "text": "ببینید اگر انسان متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 540.97,
   "end": 544.23,
   "text": "پستی و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.23,
   "end": 546.93,
   "text": "زشتی اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.93,
   "end": 551.45,
   "text": "حالا اصطلاحا گناه و معصیتش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.45,
   "end": 555.75,
   "text": "و بوی بد این‌ها رو استشمام کنه، متوجه حقیقت بشه، اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.75,
   "end": 559.09,
   "text": "قطعاً اهل تضرع و زاری خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.09,
   "end": 563.15,
   "text": "به هر حال در این اجتماع فعلی ما هم اینایی که می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.15,
   "end": 566.53,
   "text": "دلشون نمی‌سوزه، دل سوخته ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.53,
   "end": 569.79,
   "text": "رقت قلب ندارن، اشک ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.79,
   "end": 572.87,
   "text": "بی‌توجه‌اند نسبت به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.87,
   "end": 574.93,
   "text": "سوار ماشین شاسی بلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.93,
   "end": 581.21,
   "text": "چند صد میلیونی میشه تو خیابونا ویراژ میده جلوی مردمی که بعضا به نون شبشون محتاج‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.21,
   "end": 584.65,
   "text": "تو پنت هاوس بهترین برج، برج‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.65,
   "end": 587.47,
   "text": "با بهترین امکانات برای خونوادش زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.47,
   "end": 591.81,
   "text": "اما توجهی به ضعفا و فقرا نداره، به پاره‌پنهه‌ها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.81,
   "end": 595.79,
   "text": "اینا جز اینه که تضرع ندارن، جز اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.79,
   "end": 599.67,
   "text": "زاری در درگاه خدا ندارن که قساوت قلب پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 599.67,
   "end": 604.07,
   "text": "همین به نظر شما که امروز متاسفانه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.07,
   "end": 607.79,
   "text": "چهل تا نماینده مجلس نامه‌ای که زدن که واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.79,
   "end": 610.67,
   "text": "آدم خجالت می‌کشه از این کارهای این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.67,
   "end": 614.55,
   "text": "به خاطر چی؟ که یه نماینده مجلس رفته حالا توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.55,
   "end": 617.79,
   "text": "اداره‌ای کجایی حالا فیلمشم بیرون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 617.79,
   "end": 620.87,
   "text": "بهش میگن صبر کن ظاهراً اونم ماشینشو می‌خواسته پارک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.87,
   "end": 623.51,
   "text": "چی بوده تو فیلم هست که میگه من نماینده مجلسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.51,
   "end": 626.01,
   "text": "اینم میگه خب باش من نمی‌تونم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.01,
   "end": 628.49,
   "text": "قانونو به خاطر شما زیر پا بذارم و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.49,
   "end": 632.39,
   "text": "نماینده مجلس توهین می‌کنه، فحاشی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.39,
   "end": 634.77,
   "text": "یه آقایی هم اونجا میاد ایشونو بیرون می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.77,
   "end": 638.89,
   "text": "چهل تا نماینده مجلس نامه زدن که باید وزیر استیضاح بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.89,
   "end": 642.47,
   "text": "و اینایی هم که جسارت به نماینده مجلس کردن باید دادگاهی بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.47,
   "end": 649.57,
   "text": "از این اراجیف که ما باید داد بزنیم بگیم آقا چطور زیر چرخ دنده اقتصاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.57,
   "end": 655.63,
   "text": "مریض شما یا دولت این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.63,
   "end": 661.13,
   "text": "زیر این چرخ دنده اقتصاد نابسامان این کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.13,
   "end": 664.73,
   "text": "ضعفا، فقرا، پاره‌پنهه‌ها، کارگرها له شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.73,
   "end": 667.93,
   "text": "یکی‌تون نکردید حرف از استیضاح بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.93,
   "end": 669.49,
   "text": "دلتون نسوخت به حال مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.49,
   "end": 674.29,
   "text": "حالا یک نماینده مجلس که فحاشی کرده و حقش هم بوده که بیرونش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 674.29,
   "end": 682.49,
   "text": "شما میاید اینطوری. آیا به نظر شما عزیزان این به جز قساوت قلبه، به جز نداشتن تضرع و زاری و اشک در درگاه خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.49,
   "end": 685.59,
   "text": "ان شاءالله که خدای منان عاقبت هممون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 685.59,
   "end": 688.27,
   "text": "خیر کنه. به برکت صلوات بر محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}