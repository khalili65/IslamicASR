 },
 "chapters": [
  {
   "index": 0,
   "title": "## بنای کر بودن آب",
   "start": 0.34,
   "end": 315.12
  },
  {
   "index": 1,
   "title": "## قساوت و تزیین شیطان",
   "start": 315.12,
   "end": 368.0
  },
  {
   "index": 2,
   "title": "## رفع حجب نه جمع کتب",
   "start": 368.0,
   "end": 469.37
  },
  {
   "index": 3,
   "title": "## شاگرد عیسی روی آب",
   "start": 469.37,
   "end": 644.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.28,
   "end": 6.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.84,
   "end": 11.16,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.16,
   "end": 14.62,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.62,
   "end": 20.02,
   "text": "برای مصداق کر بودن هر آبی آیا نیاز هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.02,
   "end": 24.24,
   "text": "حتما تحقیق کنیم و به علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.24,
   "end": 28.58,
   "text": "عرض کنم خدمتتون یقینی برسیم یا میشه بنا رو بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.58,
   "end": 30.76,
   "text": "کر بگذاریم؟ یعنی بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.76,
   "end": 35.04,
   "text": "بنا رو بر این بگذاریم که ان شا الله کر هست اون آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.04,
   "end": 37.8,
   "text": "رهبری فرمودن که اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.8,
   "end": 41.86,
   "text": "سابقه داشته این آب کر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.86,
   "end": 43.98,
   "text": "یعنی قبلاً اینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.98,
   "end": 48.9,
   "text": "مسبوق به سابقه بوده، سابقه داشته که این آب کر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.9,
   "end": 53.88,
   "text": "اینجا بنا رو می‌تونی بگذاری بر اینکه همون حالت سابق هست و کر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.88,
   "end": 57.88,
   "text": "اما اگر سابقه نداشته باید علمت رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.88,
   "end": 63.6,
   "text": "یقین حاصل کنی. یعنی تحقیق کنی، پژوهش کنی، بررسی کنی ببینی کر هست یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.6,
   "end": 67.54,
   "text": "تو مثال مثلاً تو این دستشویی‌ها، جسارتا دستشویه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.54,
   "end": 70.0,
   "text": "قطار رو مثال زدن. مثلا اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.0,
   "end": 73.94,
   "text": "میشه بنا رو بر این بگذاریم که کر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.94,
   "end": 76.4,
   "text": "آقا می‌فرمایند که همینه اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.4,
   "end": 80.86,
   "text": "قبلاً سابقه بر این بوده که اینا کر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.86,
   "end": 83.3,
   "text": "آبش به قدر کر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.3,
   "end": 85.84,
   "text": "خب شما همین الانم بنا رو می‌تونی بذاری بر اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.84,
   "end": 89.1,
   "text": "اما اگر این سابقه وجود نداشته نه، باید تحقیق کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.1,
   "end": 95.26,
   "text": "علمت باید به یقین برسه. در آیه چهل و سه سوره انعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.26,
   "end": 98.94,
   "text": "نکته دیگری رو هم عرض کنیم و که به جای خودش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.94,
   "end": 102.48,
   "text": "پیرامون قساوت قلب رو عرض کنیم از این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.48,
   "end": 107.32,
   "text": "که می‌فرماید \"فَلَوْلَا إِذْ جَاءَهُم بَأَسُنَا تَضَرَّعُوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.32,
   "end": 112.74,
   "text": "چرا وقتی عذاب ما نازل شد تضرع نکردید که توضیحش مختصراً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.74,
   "end": 117.78,
   "text": "\"وَلَكِن قَسَتْ قُلُوبُهُمْ\" اینکه شما دل‌هاتون سنگ شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.78,
   "end": 124.14,
   "text": "قساوت قلب پیدا کردید نتیجه‌ی همون نداشتن تضرعه \"وَزَيَّنَ لَهُمُ الشَّيْطَانُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.14,
   "end": 129.5,
   "text": "مَا كَانُوا يَعْمَلُونَ\". نکته خیلی، خیلی مهم و قابل توجه اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.5,
   "end": 136.22,
   "text": "اینجا اشاره می‌کنه به اینکه شیطان میاد اعمال شما رو زینت بخشی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.22,
   "end": 140.44,
   "text": "یه کاری می‌کنه که شما گمانت اینه که این کار درسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.44,
   "end": 147.24,
   "text": "اما باطله و این می‌طلبه که انسان خیلی دقتش رو بالا ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.24,
   "end": 149.5,
   "text": "و عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.5,
   "end": 152.48,
   "text": "در مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.48,
   "end": 156.4,
   "text": "آیه‌ی هجده سوره یوسف رو اگر بررسی کرده باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.4,
   "end": 164.96,
   "text": "همین بحث رو با یک ظرافت، ظرافت خاصی تو وادی تسویل شیطان میاره بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.96,
   "end": 168.52,
   "text": "که آیه می‌فرماید و جا او هم بحثی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.52,
   "end": 171.14,
   "text": "برادران حضرت یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.14,
   "end": 176.38,
   "text": "پیراهن برادرشونو آوردن خونی شکل انداختن جلوی پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.38,
   "end": 182.04,
   "text": "این رو قرآن داره میگه تسویل شیطان بود براشون که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.04,
   "end": 185.02,
   "text": "تسویلم می‌دونید بر وزن تفعیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.02,
   "end": 187.94,
   "text": "مصدر ثوله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.94,
   "end": 195.6,
   "text": "در حقیقت چیزی رو که نفس آدمی براش حریصه، شیطان میاد اینو جلوه میده، زینت می‌بخشه بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.6,
   "end": 199.02,
   "text": "در حالی که کار نفسانی‌ست و تو بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.02,
   "end": 205.1,
   "text": "در این آیه دقت بفرمایید کجا بحث تسویلو میاره \"وَجَاءُوا عَلَى قَمِيصٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.1,
   "end": 209.56,
   "text": "بَدَمٍ كَذَبٍ\" وقتی که برادرا پیراهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.56,
   "end": 214.1,
   "text": "خونی دروغین آغشته حالا به خون بز بود دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.1,
   "end": 216.68,
   "text": "آوردن نزد پدر. قال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.68,
   "end": 220.7,
   "text": "این قال بر می‌گرده به حضرت یعقوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.7,
   "end": 223.6,
   "text": "حضرت یعقوب فرمود که \"بَلْ سَوَّلَتْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.6,
   "end": 226.1,
   "text": "سَوَّلَتْ\" ببینید از اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.1,
   "end": 228.9,
   "text": "همون بحث تسویله شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.9,
   "end": 231.04,
   "text": "و تصویرسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.04,
   "end": 234.52,
   "text": "شیطان و زینت بخشی عمل رو اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.52,
   "end": 236.9,
   "text": "حضرت یعقوب داره بهشون تذکر میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.9,
   "end": 239.88,
   "text": "\"بَلْ سَوَّلَتْ لَكُمْ أَنفُسُكُمْ أَمْرًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.88,
   "end": 242.66,
   "text": "این هوای نفسانی شما بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.66,
   "end": 245.18,
   "text": "شیطان اینو براتون آراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.18,
   "end": 247.56,
   "text": "و جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.56,
   "end": 251.56,
   "text": "این‌ها از ذهنشون رفت که لااقل این پیراهن رو پاره کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.56,
   "end": 253.74,
   "text": "گفته بودن گرگ دریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.74,
   "end": 256.44,
   "text": "فقط خون بز بهش زدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.44,
   "end": 259.94,
   "text": "حضرت از این راه متوجه شد که این‌ها دارن دروغ میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.94,
   "end": 262.1,
   "text": "فرمود ببین شیطان داره این زین--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.1,
   "end": 264.18,
   "text": "کار رو بر شما زینت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.18,
   "end": 266.88,
   "text": "بسیاری از کارهای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.88,
   "end": 270.2,
   "text": "اگر دقت بهش بشه حالا تو جنبه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.2,
   "end": 274.14,
   "text": "نیت و انگیزه‌ش می‌تونیم عرض کنیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.14,
   "end": 277.66,
   "text": "نوع رفتار می‌تونیم تشخیص بدیم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.66,
   "end": 279.66,
   "text": "کار نفسه، شیطانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.66,
   "end": 283.72,
   "text": "یا چیز دیگه‌ست. خیلی باید مراقب باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.72,
   "end": 286.98,
   "text": "ما دچار این نشیم. گاهی اوقات حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.98,
   "end": 291.86,
   "text": "از شما اهل علم و فضیلت و تقوا عذرخواهی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.86,
   "end": 294.42,
   "text": "گاهی اوقات حتی ژست تقوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.42,
   "end": 297.9,
   "text": "ژست فضیلت و ژست علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.9,
   "end": 301.5,
   "text": "رو به خودمون می‌گیریم. تو لباس علم حاضر میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.5,
   "end": 303.98,
   "text": "و این‌ها بسیار خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.98,
   "end": 311.4,
   "text": "گاهی اوقات خودمون رو در جایگاهی قرار میدیم، گمان می‌کنیم ما جامون اونجاست در حالی که اهلش نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.4,
   "end": 314.04,
   "text": "همه‌ی این‌ها جنبه‌های مختلفیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.04,
   "end": 316.78,
   "text": "شیطان زینت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.78,
   "end": 320.96,
   "text": "خدا حفظ کنه رهبر عزیزمون که یه حدیث خیلی عجیبی خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.96,
   "end": 324.28,
   "text": "خیلی حالا من اینو نوشتم همرام نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.28,
   "end": 331.04,
   "text": "پیامبر فرمودن که قیامت هر کسی که در این دنیا ریاست داشته حداقل بر ده نفر رو میارن در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.04,
   "end": 333.54,
   "text": "دستش بسته است به گردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.54,
   "end": 336.66,
   "text": "همه رو هر کسی که هر مسئولیتی داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.66,
   "end": 344.04,
   "text": "دست بسته میارنش. بعد اینو میارن خیلی جالبه وقتی بررسی می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.04,
   "end": 348.76,
   "text": "ابتدا دست بسته میارن. اگر دیدن درست رفتار کرده دستشو باز می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.76,
   "end": 352.22,
   "text": "اگر دیدن درست رفتار نکرده دستشو بسته‌تر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.22,
   "end": 360.02,
   "text": "قابل توجه اینایی که بعد خود رهبر فرمود من تعجب می‌کنم از اینا که می‌کشن خودشونو که مثلاً برن ریاست چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.02,
   "end": 364.74,
   "text": "تو مجلس راه پیدا کنن و بخوان مثلاً کاندیدای مجلس بشن یا هر جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.74,
   "end": 370.01,
   "text": "بعد خودشون خاطره میگن که من اگر ریاست جمهور رفتم امام به من تکلیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.01,
   "end": 374.59,
   "text": "شرعی کردن. حتی تکلیف عینی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.59,
   "end": 377.25,
   "text": "که من با اینکه دوست نداشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.25,
   "end": 380.81,
   "text": "اجباراً قبول کردم. بسیاری از این قبول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.81,
   "end": 385.67,
   "text": "مسئولیت‌ها و مدیریت‌ها که گاهی اوقات ما تو ذهنمون با خیالاتش زندگی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.67,
   "end": 390.73,
   "text": "ای کاش، ای کاش خدا رحم کرده ما در اون جایگاه قرار نگرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.73,
   "end": 396.17,
   "text": "و گاهی اوقات خیلی از ما اگر مدیریتی دست گرفتیم خدا زده پس کله‌مون حالیمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.17,
   "end": 400.03,
   "text": "شیطان چنان تسویل آورده برامون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.03,
   "end": 403.13,
   "text": "زینت بخشی کرده حتی تو وادی علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.13,
   "end": 410.45,
   "text": "تو وادی علم. یه جمله‌ای از حضرت امام رحمت الله علیه برای خودم حدیث نفس می‌خونم که خیلی منو تکون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.45,
   "end": 414.09,
   "text": "می‌فرمود ااا توس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.09,
   "end": 419.33,
   "text": "خود حضرت می‌فرمود در رفع حجبه، در رفع حجب کوشا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.33,
   "end": 426.49,
   "text": "البته خطاب به طلاب و دانشجویان و اهل علم می‌فرمود اما فرق نمی‌کنه برای همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.49,
   "end": 433.87,
   "text": "حضرت امام می‌فرمود که \"در رفع حجب کوشا باشید نه در جمع کتب.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.87,
   "end": 439.47,
   "text": "عین کلام ایشونه. \"ممکن است نفس در انبار اصطلاحات و ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.47,
   "end": 442.41,
   "text": "Alfaz قرار گیرد و یک محموله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.41,
   "end": 444.97,
   "text": "سنگینی از کتب را حمل کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.97,
   "end": 452.27,
   "text": "اما این محموله همانا منیت است که با بازیچه ابلیس مجلس آرای مردم شده‌اید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.27,
   "end": 456.69,
   "text": "و غرور علم و عرفان هم بر حجاب‌هایت افزوده شده است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.69,
   "end": 459.05,
   "text": "ببین حتی تو وادی علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.05,
   "end": 465.41,
   "text": "فضیلت اینها هم می‌تونه شیطان بیاد تصویرسازی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.41,
   "end": 468.39,
   "text": "باید خیلی مراقب باشیم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.39,
   "end": 472.45,
   "text": "یه روایتی دیدم از امام صادق صلی الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.45,
   "end": 479.57,
   "text": "جالب بود. این زینت بخشی‌های شیطان خیلی جاها می‌تونه باشه حتی در مقامات عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.57,
   "end": 483.27,
   "text": "حتی در مقامات عرفانی حتی در خواب دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.27,
   "end": 487.09,
   "text": "آدم باید خیلی مراقب باشه که می‌فرمودند که حضرت عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.09,
   "end": 491.17,
   "text": "علی نبینا و علیه الصلاة والسلام معمولاً عادت داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.17,
   "end": 493.89,
   "text": "به شهرگردی و اینا می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.89,
   "end": 496.15,
   "text": "و سیروف الارض دیگه. می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.15,
   "end": 497.89,
   "text": "آخ سیر آفاق و انفس می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.89,
   "end": 500.63,
   "text": "یکی از شاگرداش یه روش، یه روز باهاش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.63,
   "end": 506.97,
   "text": "رسیدن به یه دریایی حضرت عیسی بسم الله الرحمن الرحیم گفت رفت رو آب حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.97,
   "end": 511.95,
   "text": "اینم پشت سرش بسم الله الرحمن الرحیم گفت رفت رو آب پشت سر حضرت عیسی حرکت-- اینو امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.95,
   "end": 514.19,
   "text": "صادق صلی الله علیه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.19,
   "end": 519.19,
   "text": "حرکت کرد. تو وسط راه ببین اینجا شیطان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.19,
   "end": 525.09,
   "text": "پیش خودش فکر کرد خب مگه من چه فرقی با این آقا می‌کنم که ایشون پیغمبر خدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.09,
   "end": 528.13,
   "text": "اون داره رو آب راه میره. منم دارم رو آب راه میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.13,
   "end": 530.61,
   "text": "تا این فکر رو کرد، رفت تو آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.61,
   "end": 532.39,
   "text": "داد فریاد داشت خفه میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.39,
   "end": 534.65,
   "text": "حضرت دستشو گرفت آوردش بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.65,
   "end": 540.75,
   "text": "گفت تو خودت رو در جایگاهی دیدی که خدا برات این جایگاه رو در نظر نگرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.75,
   "end": 544.19,
   "text": "ظلم به نفس کردی. خشم خدا رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.19,
   "end": 548.29,
   "text": "علیان آوردی لذا فرو رفتی در خشم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.29,
   "end": 551.39,
   "text": "دیگه اینطور فکر نکن. توبه کن و استغفار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.39,
   "end": 556.11,
   "text": "برگرد به سمت خدا. تو همون حالت که حالا دستش تو دست آقا بود، توبه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 556.11,
   "end": 559.81,
   "text": "دو مرتبه رو آب ایستاد و پشت سر حضرت حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.81,
   "end": 562.97,
   "text": "خب عرض کنم گاهی اوقات این تصویرسازی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.97,
   "end": 567.27,
   "text": "زینت بخشی‌های شیطان یک آنه، یک لحظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.27,
   "end": 571.95,
   "text": "خیلی باید آدم مراقب باشه که سقوط نکنه، غرق نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.95,
   "end": 574.59,
   "text": "در خیلی از مواردها، خیلی از موارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 574.59,
   "end": 578.29,
   "text": "دارم حتی میگم تو باب عرفان با پشت سر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.29,
   "end": 580.79,
   "text": "روح الله داره حرکت می‌کنه رو آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 580.79,
   "end": 582.71,
   "text": "خب مرد می‌خواد اینجا خودشو نبازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.71,
   "end": 585.33,
   "text": "اما شیطان اون لحظه هم میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.33,
   "end": 586.93,
   "text": "اون لحظه هم شیطان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.93,
   "end": 591.21,
   "text": "همونطور که گفتیم تر کوه تور برای موسی هم حاضر شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.21,
   "end": 594.57,
   "text": "باید خیلی مراقب باشیم. خیلی باید حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.57,
   "end": 596.55,
   "text": "خیلی باید پناه ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.55,
   "end": 605.37,
   "text": "چرا تو بسم-- تو شروع نماز دقت کردید دیگه مستحبه تو شروع نماز قبل بسم الله و الحمدالله چی بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.37,
   "end": 607.25,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.25,
   "end": 611.27,
   "text": "جالبه که بزرگان اهل معرفت فرمودن اینو آهسته بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.27,
   "end": 613.85,
   "text": "بلند نگو. اعوذ بالله من الشيطان الرجيم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.85,
   "end": 616.59,
   "text": "بسم الله رو بلند بگو. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.59,
   "end": 618.61,
   "text": "گفتن belki شیطان نشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.61,
   "end": 621.05,
   "text": "بشنوه تو داری تعویذ می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 621.05,
   "end": 623.25,
   "text": "اعوذ بالله میگی برنامه می‌ریزه برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
