 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء؛ جریمهٔ تأخیر اقساط بانکی",
   "start": 11.28,
   "end": 93.18
  },
  {
   "index": 1,
   "title": "بحث قلب قسی بر اساس آیهٔ سیزدهم سورهٔ مائده به این نکته رسیده است:",
   "start": 93.18,
   "end": 143.96
  },
  {
   "index": 2,
   "title": "## آیهٔ بقره؛ ناقضان عهد",
   "start": 143.96,
   "end": 309.02
  },
  {
   "index": 3,
   "title": "## مدیران و وعدهٔ بی‌عمل؛ نامه به مالک",
   "start": 309.02,
   "end": 378.06
  },
  {
   "index": 4,
   "title": "## علامات اللعن؛ غدر به مواثیق",
   "start": 378.06,
   "end": 473.92
  },
  {
   "index": 5,
   "title": "## میثاق‌های الست و عبادت؛ بازنگری خانوادگی",
   "start": 473.92,
   "end": 658.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.8,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.8,
   "end": 7.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.38,
   "end": 11.28,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 16.58,
   "text": "یکی دیگه از استفتائاتی که از دفتر آقا کردیم پیرامون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 22.08,
   "text": "سودهاییه که در تأخیر پرداخت اقساط تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.08,
   "end": 28.42,
   "text": "که آیا ما وقتی وام رو می‌گیریم از بانک بعد خب دیدید دیگه وقتی اقساط رو به تأخیر می‌ندازی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.42,
   "end": 31.62,
   "text": "سودی به عنوان جریمه میاد روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.62,
   "end": 35.82,
   "text": "آیا این اشکال داره دادن این سودها یا گرفتنش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.82,
   "end": 41.68,
   "text": "خودم از دفتر پرسیدم فرمودن نظر آقا اینه که البته این اختلافیه ها هرکی به مرجع خودش رجوع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.68,
   "end": 49.68,
   "text": "خیلیا مثلاً کل حرام دونستن لکن آقا فرمودن اگر وجه التزام باشه اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.68,
   "end": 55.24,
   "text": "یعنی چی؟ یعنی اینکه تو اون قرارداد که اول میخوای بری وامو بگیری این اونجا درد شده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.24,
   "end": 61.62,
   "text": "تو رو ملتزم کرده باشه که اگر یه وقت قسطتو دیر دادی اینقدر هم بهش جریمه تعلق می‌گیره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.62,
   "end": 64.7,
   "text": "وجه التزام قراردادت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.7,
   "end": 66.66,
   "text": "در این صورت اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.66,
   "end": 70.16,
   "text": "ولی اگر نباشه چرا، حرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.16,
   "end": 75.44,
   "text": "خب بحث ما تو همین هفت هشت دقیقه‌ای که حرف می‌زنیم پیرامون قلب قسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.44,
   "end": 79.46,
   "text": "و به این نکته رسیدیم بر اساس آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.46,
   "end": 83.56,
   "text": "سیزده surah مائده و خوش به حال اونایی که این‌ها رو میرن می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.56,
   "end": 88.36,
   "text": "همینطوری از من نمی‌شنون، میرن می‌بینن چیزای دیگه هم دستگیرشون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.36,
   "end": 98.0,
   "text": "در این آیه‌ی عجیب می‌فرمود \"فبما نقضهم میثاقهم\" چون این‌ها میثاقشون رو نقض کردن بنی‌اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.0,
   "end": 101.5,
   "text": "عرض کردیم آیه می‌فرمود دو تا پیامد داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.5,
   "end": 107.76,
   "text": "از طرف خدا. انقدر خدا از نقض پیمان و شکستن عهد بدش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.76,
   "end": 109.98,
   "text": "که فرمود \"لعناهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.98,
   "end": 116.32,
   "text": "ما اینا رو لعن می‌کنیم و از رحمت ما به دور میشن \"وجعلنا قلوبهم قاسية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.32,
   "end": 120.12,
   "text": "دلشون سنگ می‌شه یعنی جعلنا ما دلشونو سنگ می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.12,
   "end": 122.98,
   "text": "در حقیقت قدم اولو اونا برمی‌دارن در چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.98,
   "end": 128.22,
   "text": "در پیمان شکنی. انقدر این قصه‌ی پیمان شکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.22,
   "end": 131.86,
   "text": "بده، انقدر زشته چهره این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.86,
   "end": 136.02,
   "text": "که در جای جای قرآن و روایات به مذمت ازش یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.02,
   "end": 139.5,
   "text": "مثلا شما آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.5,
   "end": 142.56,
   "text": "surah آیه‌ی بیست و هفت surah بقره رو نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.56,
   "end": 146.14,
   "text": "می‌فرماید \"الذین\" شاید بارها ما این آیه رو خوندیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.14,
   "end": 148.58,
   "text": "اما حالا که بهش نگاه می‌کنیم می‌گیم عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.58,
   "end": 155.1,
   "text": "چقدر توجه ما نداشتیم. \"الذین ينقضون عهد الله من بعد میثاقه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.1,
   "end": 160.5,
   "text": "اون کسایی که بعد از اینکه پیمان رو با خدا بستن اینو شکستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.5,
   "end": 164.9,
   "text": "\"ويقطعون ما امر الله به ان يوصل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.9,
   "end": 168.56,
   "text": "اون پیوندهایی رو که خدا استوار کرده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.56,
   "end": 176.16,
   "text": "این‌ها رو قطع کردن. \"ويفسدون في الارض\" این‌ها ببینید چند تا رو کنار هم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.16,
   "end": 178.44,
   "text": "فساد می‌کنند تو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.44,
   "end": 182.66,
   "text": "\"اولئک هم الخاسرون\" این‌ها خسران می‌کنند بر حق خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.66,
   "end": 185.32,
   "text": "خاسرن. هیچی گیرشون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.32,
   "end": 187.06,
   "text": "بدبخت‌ترین آدمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.06,
   "end": 190.84,
   "text": "تو آیه‌ی پنجاه و پنج و پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.84,
   "end": 194.94,
   "text": "انفال که دیگه خیلی سخت‌تر از این رو می‌فرماید که واقعاً آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.94,
   "end": 200.48,
   "text": "اگه یه ذره الهیت وجودش قوی باشه تنش به لرزه میفته از این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.48,
   "end": 204.14,
   "text": "می‌فرماید \"ان شر الدواب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.14,
   "end": 206.76,
   "text": "الله اکبر. می‌خواد بفرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.76,
   "end": 213.7,
   "text": "خدا می‌خواد به، به ما بگه که می‌دونید پست‌ترین، بدترین، شرترین جنبندگان چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.7,
   "end": 217.84,
   "text": "حالا ما جالب و عجیبه البته ما هم قاطی جنبنده‌ها اینجا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.84,
   "end": 221.02,
   "text": "آورده. قاطی حیوونا همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.02,
   "end": 227.76,
   "text": "میگه می‌خوای به شما بگم بین همه‌ی جنبنده‌هایی که جنب می‌کنن رو این زمین پست‌ترینشون کدومان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.76,
   "end": 230.0,
   "text": "عندالله پیش خدا البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.0,
   "end": 233.72,
   "text": "\"الذین کفروا فهم لا يؤمنون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.72,
   "end": 236.38,
   "text": "اینا اونایین که کفر ورزیدن و ایمان نمیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.38,
   "end": 239.08,
   "text": "هرچی زور بزنی فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.08,
   "end": 244.32,
   "text": "بعد کنار این می‌فرماد \"الذین آ--\" می‌خوای بیشتر به تو معرفی کنم اینا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.32,
   "end": 250.86,
   "text": "\"الذین آهدت منهم ثم ينقضون عهدهم في کل مرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.86,
   "end": 254.16,
   "text": "اینا همونان که هر وقت عهد می‌بندن می‌شکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.16,
   "end": 256.38,
   "text": "\"في کل مرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.38,
   "end": 259.96,
   "text": "یعنی اصلاً از اینا وفای به عهد تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.96,
   "end": 265.94,
   "text": "\"وهم لا-- وهم لا يتقون\" که البته این از بی‌تقوایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.94,
   "end": 268.62,
   "text": "خیلی جالبه. دقیقاً صفات آمریکاست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.62,
   "end": 270.94,
   "text": "صفات استکبار امروزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.94,
   "end": 274.56,
   "text": "صفات این خبیثایی که پشت سرشون راه افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.56,
   "end": 277.76,
   "text": "آیه قرآن به صراحت تمام داره اینا رو معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.76,
   "end": 282.14,
   "text": "می‌گه اینا پست‌ترینن که امام فرمود شیطان بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.14,
   "end": 283.82,
   "text": "از قرآن این‌ها رو اقتباس کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.82,
   "end": 286.46,
   "text": "او فقیه امام اسلام شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.46,
   "end": 291.64,
   "text": "همینطوری از خودش استغفرالله از هوای نفسش که نمیگه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.64,
   "end": 296.18,
   "text": "این بزرگواران فرمود شیطان بزرگ، شیطان بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.18,
   "end": 301.38,
   "text": "اصلاً اینو برجسته‌سازی کرد، گفتمان تاریخیش کرد پشت سرش ملت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.38,
   "end": 303.22,
   "text": "از قرآن گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.22,
   "end": 305.08,
   "text": "یک بار به قولاش وفا نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.08,
   "end": 309.02,
   "text": "بعد نمی‌دونم چه من این مسئولینه که چی بگه آدم واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.02,
   "end": 311.34,
   "text": "بعضی از مسئولین تراز اول ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.34,
   "end": 313.7,
   "text": "مدیران کلان مملکت ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.7,
   "end": 317.04,
   "text": "متاسفانه پشت سر غربن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.04,
   "end": 320.78,
   "text": "شیفته‌ی غربن و حالا پشت سر آمریکا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.78,
   "end": 324.08,
   "text": "با پخ آمریکا خودشونو خراب می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.08,
   "end": 328.24,
   "text": "با وعده‌هاش خودشونو مثلا امیدوار نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.24,
   "end": 330.44,
   "text": "نمی‌دونم این‌ها دنبال چی راه افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.44,
   "end": 332.94,
   "text": "آیا قرآن حالا درد دل نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.94,
   "end": 336.74,
   "text": "آیه‌ی صفر رو شما دقت-- آیه سه surah صفر رو دوباره دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.74,
   "end": 340.38,
   "text": "من یه مدتی خب می‌ترسیدم از این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.38,
   "end": 342.72,
   "text": "و کمتر، خیلی کم صحبت می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.72,
   "end": 345.74,
   "text": "خیلی کم. بعداً رفتم دیدم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.74,
   "end": 352.82,
   "text": "آیه برگشته توسط امیرالمؤمنین علیه السلام تأویلش برگشته به همین نقض پیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.82,
   "end": 357.88,
   "text": "نمی‌دونستم من این رو. من فکر می‌کردم یعنی حرفی رو که خودت عمل نکردی نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.88,
   "end": 364.28,
   "text": "ظاهرش اینه. می‌فرماید \"كبر مقتا عندالله\" خیلی بزرگه پیش خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.28,
   "end": 368.28,
   "text": "ان تقولوا ما لا تفعلون چیزی رو بگی که عمل نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.28,
   "end": 371.92,
   "text": "ظاهرش اینه ها. ولی تو نامه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.92,
   "end": 374.96,
   "text": "امیرالمؤمنین علیه الصلاة والسلام به مالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.96,
   "end": 378.06,
   "text": "رحمت الله علیه دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.06,
   "end": 381.06,
   "text": "مولا بهش سفارش کرده که مالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.06,
   "end": 386.74,
   "text": "سعی کن البته ص-سندش هم مستدرک الوسائل ج11 صفحه 48 تا یکی خواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.74,
   "end": 393.72,
   "text": "خواست همشو ببینه که به مالک فرمود بپرهیز از اینکه به مردم وعده بدی و عمل نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.72,
   "end": 396.34,
   "text": "قابل توجه مدیران نظام ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.34,
   "end": 404.66,
   "text": "اصن هر کسی، هر کسی وعده به مردم بدی و عمل نکنی بعد مولا می‌فرماید در پسش خشم خدا و مردم رو در پی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.66,
   "end": 409.0,
   "text": "بعد اشاره به این آیه کرد که \"کبر مقتاً عندالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.0,
   "end": 412.06,
   "text": "ان تقولوا ما لا تفعلون\". نشون میده که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.06,
   "end": 414.8,
   "text": "بر می‌گرده به نقض پیمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.8,
   "end": 416.76,
   "text": "نقض عهد خیلی زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.76,
   "end": 418.5,
   "text": "حتی آدم میگه به بچه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.5,
   "end": 422.1,
   "text": "اصن روانشناسی امروزم از اینجا برداشت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.1,
   "end": 426.02,
   "text": "میگه به بچه‌ت یا قول نده یا قول دادی عملی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.02,
   "end": 427.94,
   "text": "نذار تو ذهن بچه خراب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.94,
   "end": 430.34,
   "text": "خیلی بده. اصن نامردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.34,
   "end": 432.98,
   "text": "یه چیز دیگه هم بگم که حالا دیگه آخرشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.98,
   "end": 439.1,
   "text": "آخرشه. یعنی دیگه اینجا مولا سنگ تموم گذاشته تو زشتی و خباثت این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.1,
   "end": 442.66,
   "text": "که در غرر الحکم صفحه 253 مولا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.66,
   "end": 444.82,
   "text": "\"من علامات اللعن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.82,
   "end": 450.4,
   "text": "لعن یعنی پستی که آدم به نهایت پستی و زشتی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.4,
   "end": 452.62,
   "text": "\"من علامات اللعن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.62,
   "end": 458.04,
   "text": "میگه از علامتهای پستی اینه \"الغدر بالمواثيق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.04,
   "end": 463.56,
   "text": "یعنی شکست یا نیرنگ ظاهرش یعنی نیرنگ به پیمان‌ها یعنی همون پیمان شکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.56,
   "end": 466.62,
   "text": "نیرنگ بزنه، پیمان بشکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.62,
   "end": 469.12,
   "text": "میگه از نشانه پستیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.12,
   "end": 471.16,
   "text": "کسی پست میشه اینطوری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.16,
   "end": 473.92,
   "text": "حالا شما ببینید ما چقدر بعداً باید روش کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.92,
   "end": 475.56,
   "text": "اصلاً میثاق اینجا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.56,
   "end": 480.98,
   "text": "فرقش با عهد چیه؟ چقدر جای جای قرآن میثاق و عهد رو یاد کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.98,
   "end": 486.16,
   "text": "چقدر ما میثاق داریم و چقدر این‌ها رو متأسفانه من زیر پا گذاشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.16,
   "end": 488.6,
   "text": "بعد خودمو آدم خوبی می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.6,
   "end": 492.82,
   "text": "بحث میثاق با میثاق توحید در عالم الست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.82,
   "end": 498.22,
   "text": "میثاق نبوت در زر دوم، میثاق ولایت در زر سوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.22,
   "end": 502.3,
   "text": "التزام عملی‌مون به دستورات اهل بیت، میثاق عبادت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.3,
   "end": 507.8,
   "text": "صراحتاً شما که قرآن خونید الحمدالله بعضی از قاریان قرآن هم هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.8,
   "end": 515.64,
   "text": "بهتر از من متوجه‌اند. تو فکر می‌کنم سوره یاسین باشه که خدا صراحتاً می‌فرماید \"ألم أعهد إليكم يا بني آدم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.64,
   "end": 523.04,
   "text": "عهد. آیا من از شما عهد نگرفتم که \"ألا تعبدوا الشيطان ينه لكم عدوا مبينا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.04,
   "end": 527.52,
   "text": "که این دشمن آشکاریه \"لا تعبد الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.52,
   "end": 530.02,
   "text": "نپرستید شیطان را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.02,
   "end": 535.18,
   "text": "خب کیو بپرستین؟ \"وعبدوني\" منو بپرستید \"هذا صراط مستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.18,
   "end": 539.72,
   "text": "عهد نپرستیدن شیطان و عهد پرستش خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.72,
   "end": 541.7,
   "text": "این خودش یه عهدیه که ما با خدا داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.7,
   "end": 544.2,
   "text": "چقدر من اینو زیر پا گذاشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.2,
   "end": 550.86,
   "text": "بعد قرآن و روایت میگه این جزو پست‌ترین کارهاییه که یه جنبنده می‌تونه انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.86,
   "end": 554.26,
   "text": "و من به راحتی عهدهایی که بستم زیر پا می‌گذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.26,
   "end": 557.92,
   "text": "در حالی که میگه یکی از دلایل اینکه شما دلتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.92,
   "end": 565.56,
   "text": "سنگ شده با معارف نمی‌لرزه، عالم دینو می‌بینید نفس عالم دین در شما تأثیر نمی‌ذاره و قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.56,
   "end": 572.6,
   "text": "معجزه پیغمبر که پیغمبر می‌گفت بدون اشک نخونید، بدون حزن نخونید، می‌خونیم عین خیالمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.6,
   "end": 574.62,
   "text": "نماز از اول تا آخر تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.62,
   "end": 580.12,
   "text": "هیچی ازش نمی‌فهمم. از روضه‌های اهل بیت درک و شعوری برام ایجاد نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.12,
   "end": 582.28,
   "text": "خودم راضیم. به شما خوبان جسارت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.28,
   "end": 584.58,
   "text": "همش مال این سنگ دلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.58,
   "end": 587.12,
   "text": "چرا؟ \"فبما نقضهم الميثاق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.12,
   "end": 589.28,
   "text": "چون که ما میثاق و عهدمون رو شکستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.28,
   "end": 591.1,
   "text": "بارها و بارها هم شکستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.1,
   "end": 593.96,
   "text": "یه تجدید نظر اساسی باید پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.96,
   "end": 600.38,
   "text": "عهد و پیمان‌هامون رو بکنیم. من خواهش می‌کنم من خودم چون این کارو دارم می‌کنم محکم به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.38,
   "end": 603.54,
   "text": "بیایید بشینید خودتون تو تنهایی و خلوتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.54,
   "end": 607.2,
   "text": "شده با زن و بچه‌تون یه کار گروه خانوادگی تشکیل بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.2,
   "end": 612.18,
   "text": "میثاق‌ها و عهدهایی که قرآن داره ما رو به اون‌ها ملتزم می‌کنه رو درآرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.18,
   "end": 616.56,
   "text": "چه پی-پیمان‌ها و عهدهای داشتیم که مراقبش باشیم نشکنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.56,
   "end": 623.32,
   "text": "بچه‌هامون، نسل‌مون. چه اشکالی داره ما یه وصیت‌نامه به نسل حتما باید باغ و ویلا و خونه و ماشین‌مون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.32,
   "end": 626.28,
   "text": "به ارث بذاریم. یه وصیت‌نامه بنویسیم برای نسل‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.28,
   "end": 632.04,
   "text": "من از قرآن آی خلف من، آی فرزند من، آی نسل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 632.04,
   "end": 635.7,
   "text": "من از قرآن این میثاق‌ها و عهدها رو درآوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.7,
   "end": 637.32,
   "text": "که باید این‌ها رو ملتزم باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.32,
   "end": 640.02,
   "text": "شما هم اگه من نرسیدم برسید درآرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.02,
   "end": 644.56,
   "text": "مراقب باشید این‌ها رو نقض نکنیم که دچار قلب قسی نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.56,
   "end": 648.54,
   "text": "چقدر مهمه این کار. خدا انشاالله عاقبتمون رو ختم به خیر بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.54,
   "end": 651.74,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.74,
   "end": 658.06,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}