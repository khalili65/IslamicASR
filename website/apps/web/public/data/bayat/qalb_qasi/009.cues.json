 "chapters": [
  {
   "index": 0,
   "title": "## آب قلیل از بالا؛ پایان بحث وام",
   "start": 21.92,
   "end": 100.68
  },
  {
   "index": 1,
   "title": "## میلاد امام عسکری و آیهٔ نور",
   "start": 100.68,
   "end": 279.32
  },
  {
   "index": 2,
   "title": "## امتحانات عصر عسکری و رهزنی خیال",
   "start": 279.32,
   "end": 499.87
  },
  {
   "index": 3,
   "title": "## فنسی آدم و نسیان عهد ولایت",
   "start": 499.87,
   "end": 670.35
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 5.54,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.54,
   "end": 9.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.36,
   "end": 14.14,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.14,
   "end": 17.8,
   "text": "بریم وارد بحث استفتائات پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.8,
   "end": 21.72,
   "text": "احکام طهارت و این‌ها بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.72,
   "end": 26.9,
   "text": "دیگه بحث وام و قسط و بانک‌ها و این‌ها رو تقریباً تموم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.9,
   "end": 30.32,
   "text": "از رهبر عزیزمون در این خصوص استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.32,
   "end": 32.64,
   "text": "اگر با آب قلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.64,
   "end": 38.52,
   "text": "که از البته بالا رها میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.52,
   "end": 42.36,
   "text": "حالا بدون فشار میاد می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.36,
   "end": 47.54,
   "text": "می‌ریزه حالا روی نجاست یا روی جایی که نجس هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.54,
   "end": 50.42,
   "text": "مثل اینکه با آفتابه آب بریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.42,
   "end": 56.34,
   "text": "از بالا، این آبی که داره می‌ریزه بیاد پایین برخورد کنه به نجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.34,
   "end": 61.64,
   "text": "حالا اون آبی که اون بالا هست هم چون آب قلیله، کر که نیست، کر باشه که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.64,
   "end": 69.72,
   "text": "اون آب بالا هم نجس میشه به واسطه‌ی برخورد اون آبی که اون پایین برخورد به نجاست کرده و نجس شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.72,
   "end": 75.36,
   "text": "آبی هم که از اون بالا داره میاد یا اون بقیه‌ی آب که هنوز تو آفتابه و پیوسته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.36,
   "end": 81.12,
   "text": "این آیا نجس میشه؟ رهبری فرمودن نه، اگر از بالا به پایین روند آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.12,
   "end": 86.48,
   "text": "جریان آب به جوری باشه که صدق کنه که از بالا به پایین داره میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.48,
   "end": 92.56,
   "text": "در اون صورت نه نجاست، اون بقیه‌ی آب یا اون قسمت بالایی آب نجس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.56,
   "end": 97.14,
   "text": "در صورتی که از بالا به پایین آب حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.14,
   "end": 99.18,
   "text": "در خصوص حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.18,
   "end": 101.3,
   "text": "قلب قصی مقدمتا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.3,
   "end": 103.22,
   "text": "روز میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.22,
   "end": 108.36,
   "text": "با عظمت و بی‌نظیر پدر امام زمانمون سلام الله عليه هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.36,
   "end": 111.6,
   "text": "نکته‌ای رو عرض کنم و ارتباطش البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.6,
   "end": 118.48,
   "text": "بدیم با بل، بحث قلب قصی به یک نکته‌ای که البته در آیه‌ی سیزده سوره‌ی مائده اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.48,
   "end": 123.94,
   "text": "تبریک میگیم خدمت حضرت ابا صالح المهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.94,
   "end": 128.84,
   "text": "میلاد با سعادت پدر عزیزشون رو و خدمت شما خوبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.84,
   "end": 131.9,
   "text": "امام عسکری سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.9,
   "end": 136.02,
   "text": "به زیبایی تمام ازشون در آیه‌ی نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.02,
   "end": 142.6,
   "text": "صحبت شده. جالبه که این روایت رو کتب مهم شیعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.6,
   "end": 146.96,
   "text": "کتب خوب و مهم روایی ما آوردن و تفاسیر هم زیاد نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.96,
   "end": 152.24,
   "text": "ذیل آیه‌ی نور \"الله نور السماوات والارض مثل نوره في کمشعات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.24,
   "end": 156.26,
   "text": "که امیرالمؤمنین علیه الصلاة والسلام یه روز آهی کشید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.26,
   "end": 161.58,
   "text": "حالا راوی هم جابر بن عبدالله انصاری بزرگ هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.58,
   "end": 164.14,
   "text": "میگه مولامون آهی کشید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.14,
   "end": 171.66,
   "text": "فرمودن که در تعجبم کسایی که این آیه رو می‌خونن و توجه به معناش ندارن، نمی‌فهمن چی می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.66,
   "end": 174.62,
   "text": "سریع پرسیدن که آقا کدوم آیه مد نظرتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.62,
   "end": 181.04,
   "text": "این آیه رو قرائت کرد. \"الله نور السماوات والارض مثل نوره في کمشعات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 181.04,
   "end": 184.1,
   "text": "بعد ادامه داد آیه رو یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.1,
   "end": 189.78,
   "text": "از پیغمبر و حضرت زهرا و خودشون مولا علی و امام حسن، امام حسین همینطور تا امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.78,
   "end": 193.64,
   "text": "عصر رو یک یک با این آیه معرفی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.64,
   "end": 197.44,
   "text": "که حدیث مبسوط و زیباییه و قبلاً یادمه تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.44,
   "end": 199.94,
   "text": "یک سال پیش ما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.94,
   "end": 207.28,
   "text": "یکی یکی اهل بیت رو از درون این آیه براتون گفتیم روایتش رو اصلاً تا رسید به اون انتهای آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.28,
   "end": 212.56,
   "text": "\"نور على نور يهدي الله لنوره من يشاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.56,
   "end": 216.48,
   "text": "حضرت امیرالمؤمنین علیه الصلاة والسلام فرمودن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.48,
   "end": 219.38,
   "text": "\"نور على نور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.38,
   "end": 224.58,
   "text": "فرزند ما امام حسن عسکری علیه الصلاة والسلام هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.58,
   "end": 228.48,
   "text": "و او \"يهدي الله لنوره من يشاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.48,
   "end": 237.32,
   "text": "اون نوری که خدا هرکیو بخواد هدایت کنه با اون نور هدایت می‌کنه فرزند آخر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.32,
   "end": 242.18,
   "text": "مصلح کل حضرت ابا صالح المهدی سلام الله عليه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.18,
   "end": 247.44,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 247.44,
   "end": 251.52,
   "text": "و اینجا اگر دقت کنید \"نور على نور\" البته مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.52,
   "end": 255.36,
   "text": "فرمودن نکره آمده \"نور على نور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.36,
   "end": 258.84,
   "text": "نکره آمده یعنی نمیشه حقش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.84,
   "end": 261.58,
   "text": "شناخت. یعنی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.58,
   "end": 265.5,
   "text": "در حد اندازه‌ی ما نیست شناخت این نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.5,
   "end": 268.92,
   "text": "اما در هر حال معرفی شده و ما باید در حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 268.92,
   "end": 271.92,
   "text": "سعه وجودمون از این نور بهره ببریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.92,
   "end": 275.48,
   "text": "که تا نور نباشد همه جا تاریک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.48,
   "end": 277.74,
   "text": "باید از این نور بهره جست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.74,
   "end": 283.02,
   "text": "و متأسفانه در زمان امام عسکری سلام الله عليه اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 283.02,
   "end": 290.5,
   "text": "جامعه شیعی رفته رفته چند تا آزمایش سخت داد و تقریباً نمره‌ش خوب بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.5,
   "end": 292.7,
   "text": "که قبلاً بحث کردیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.7,
   "end": 295.76,
   "text": "مثلاً به طفولیت، ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.76,
   "end": 299.1,
   "text": "به امامت رسیدن در زمان طفولیت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.1,
   "end": 301.6,
   "text": "مثل امام جواد سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.6,
   "end": 305.54,
   "text": "این‌ها تا امام عسکری سلام الله عليه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 305.54,
   "end": 308.14,
   "text": "بحث غیبت و از پشت پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.14,
   "end": 314.54,
   "text": "با دوستان، با دوستانش صحبت کردن خودش یک وجهه جدیدی بود که پیش از این نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.54,
   "end": 318.9,
   "text": "و امتحاناتi پس دادن. اما متأسفانه رهزنی‌های قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.9,
   "end": 321.52,
   "text": "واهمه و خیال مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.52,
   "end": 325.56,
   "text": "کار دستشون داد. تا جایی که استاد روژدی می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 325.56,
   "end": 334.04,
   "text": "شاید تنها امامی که این جسارت بهش شد توسط زمان مردم زمانش امام عسکری سلام الله عليه بود که وقتی وجوهات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 334.04,
   "end": 339.48,
   "text": "بهشون داده بودن، اون نماینده جمع‌آوری وجوهات که اومد مثلاً بزرگ، بزرگی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 339.48,
   "end": 342.42,
   "text": "مثلاً عالمی بود اومد تقدیم حضرت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.42,
   "end": 346.98,
   "text": "از حضرت سؤال کرد، فرمود اینا رو کجا شما هزینه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.98,
   "end": 350.32,
   "text": "میشه مثلاً به ما بیلان بدید اینا کجا هزینه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.32,
   "end": 353.0,
   "text": "یه جسارت این چنینی به حضرت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 353.0,
   "end": 361.25,
   "text": "که بعضیا میگن اصلاً این جسارتی که برای اولین بار به امام معصوم صورت گرفت یکی از دلایل غیبت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 361.25,
   "end": 367.97,
   "text": "که به نمایندگی از شیعیان کسی بیاد به امام بگه bilan بده ببینیم پول‌هایی که ما به شما میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 367.97,
   "end": 370.17,
   "text": "از وجوهات شرعیه تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 370.17,
   "end": 372.91,
   "text": "چه میشه؟ کجا میره؟ خاک بر سرش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.91,
   "end": 376.45,
   "text": "یعنی اینایی که نفهمیدن امام کیه، چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.45,
   "end": 380.09,
   "text": "و با کی مواجه می‌شه. اینا رهزنی‌های قوه‌ی خیاله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.09,
   "end": 389.39,
   "text": "اگر دقت کنین حالا ارتباط این قصه خیلی با ل-لطائف الهیلی تو بحث همین آیه سیزده سوره‌ی مائده اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.39,
   "end": 391.67,
   "text": "با هم بخونیم ببینیم کجاشه به نظر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 391.67,
   "end": 398.19,
   "text": "\"فبما نقضهم ميثاقهم لعنهم وجعلنا قلوبهم قاسية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.19,
   "end": 401.33,
   "text": "اینا چون پیمان شکنی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 401.33,
   "end": 404.97,
   "text": "مورد لعن ما واقع شدن و دلشون سنگ، دلشونو سنگ کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 404.97,
   "end": 407.91,
   "text": "\"يحرفون الكلم عن مواضعه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 407.91,
   "end": 411.91,
   "text": "اینا تحریف ایجاد کردن در بطن دین، در حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 411.91,
   "end": 416.35,
   "text": "\"ونسوا حظا مما ذكروا به\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 416.35,
   "end": 421.21,
   "text": "اینجاست موضوع. می‌فرماید اینا فراموش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.21,
   "end": 426.25,
   "text": "\"حظا مما ذكروا به\" اون چیزی که بسیار و به کرار و بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 426.25,
   "end": 431.43,
   "text": "ما متوجه‌شون کردیم اون رو از اون حظی که باید از حقایق می‌بردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 431.43,
   "end": 434.91,
   "text": "از اون میثاق و از اون عهدی که با خدا داشتند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 434.91,
   "end": 438.85,
   "text": "از اون نور تام و تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 438.85,
   "end": 441.57,
   "text": "وجود اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 441.57,
   "end": 445.59,
   "text": "از بحث میثاق ولایت، عهد ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.59,
   "end": 450.75,
   "text": "فرمود \"نسوا\" فراموش کردن این حظ و بره-برهه‌ای که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 450.75,
   "end": 456.43,
   "text": "از چیزی که بارها \"ذكروا به\" ما به این‌ها بارها تذکرش رو داده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.43,
   "end": 458.71,
   "text": "مراقب این شجره باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.71,
   "end": 464.71,
   "text": "این شجره که باید قبس قبس ازش مثل موسی کلیم که از شجره طیبه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.71,
   "end": 469.85,
   "text": "ابی عبدالله تو وادی تور قبلاً توضیح دادیم نور گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 469.85,
   "end": 472.57,
   "text": "\"واستنارت کل نفسي\" شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 472.57,
   "end": 475.79,
   "text": "خدا او رو استیفاء کرد برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 475.79,
   "end": 478.17,
   "text": "عرض کنم خدمتتون انتخابش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 478.17,
   "end": 484.85,
   "text": "برای پیغمبری قبس قبس نور گرفتن از همون شجره طیبه ولایت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 484.85,
   "end": 491.45,
   "text": "آیه صد و پونزده سوره‌ی طه هم قبلاً بحث کردیم که \"ولقد عهدنا الی آدم من قبل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 491.45,
   "end": 495.15,
   "text": "ما یه عهدی از آدم از قبل گرفته بودیم \"فنسی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 495.15,
   "end": 498.73,
   "text": "\"فنسی\" فراموش کرد \"ولم نجد له\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.73,
   "end": 503.51,
   "text": "از ما. حالا اون \"فنسی\" آدم رو بیارید اینجا کنار این \"ونسوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 503.51,
   "end": 506.99,
   "text": "دوتاش هم از ریشه‌ی نسیان و فراموشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 506.99,
   "end": 510.57,
   "text": "چی رو فراموش کردین؟ عهد ولایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 510.57,
   "end": 514.95,
   "text": "اصل عهد میثاق که با ولایت زمانمون، با امام عصرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 514.95,
   "end": 519.85,
   "text": "اون‌ها چنین عهدی رو فراموش کردن که به امام عسکری چنین جسارتی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 519.85,
   "end": 521.79,
   "text": "قطعاً. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 521.79,
   "end": 524.59,
   "text": "دلیلش چیه؟ خب در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 524.59,
   "end": 527.81,
   "text": "\"وجعلنا قلوبهم قاسية\" این اتفاق رخ میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.81,
   "end": 531.51,
   "text": "یعنی اصلاً محاله. اینو دقت بفرمایید نتیجه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 531.51,
   "end": 534.91,
   "text": "محاله کسی به امامش جسارت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 534.91,
   "end": 537.55,
   "text": "شأن امامش رو رعایت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.55,
   "end": 541.31,
   "text": "و عهدی که و پیمانی که با او دارد رو فراموش کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 541.31,
   "end": 544.89,
   "text": "مگر اینکه دلش سنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 544.89,
   "end": 547.79,
   "text": "دل سنگ از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.79,
   "end": 550.21,
   "text": "اول آیه میگه چی؟ نقض پیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 550.21,
   "end": 558.29,
   "text": "البته بخوایم همه فهم‌ترش کنیم یه حدیث بخونمو این حدیث خوبه همه گوش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 558.29,
   "end": 560.61,
   "text": "فصل الخطاب بحثمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 560.61,
   "end": 562.79,
   "text": "امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 562.79,
   "end": 568.35,
   "text": "فرمودن سند در علل الشرایع جلد یک صفحه هشتاد و یکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 568.35,
   "end": 573.61,
   "text": "مولا فرمودن که \"ما جفت الدموع الا لقسوة القلوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 573.61,
   "end": 579.71,
   "text": "چشم‌ها خشک نمی‌شه مگر به جهت قساوت قلب، سنگی دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.71,
   "end": 583.73,
   "text": "و جالبه می‌فرماید \"وما قست القلوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.73,
   "end": 588.11,
   "text": "دل‌هام سنگ نمی‌شه \"الا لكثرة الذنوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 588.11,
   "end": 591.47,
   "text": "مگر به \"كثرة الذنوب\" و گناهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 591.47,
   "end": 600.05,
   "text": "گناه پشت گناه و یکی از بزرگ‌ترین این گناهان همین فراموشی عهد ولایت و عهد میثاق ولایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 600.05,
   "end": 604.35,
   "text": "اینکه خلاصه‌ش که آدم فراموش کنه امامی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 604.35,
   "end": 608.23,
   "text": "حجت زمانی هست و در خصوص او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 608.23,
   "end": 610.75,
   "text": "وظایفی داره که باید این وظایف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 610.75,
   "end": 615.37,
   "text": "انجام بده. این باعث قساوت قلب و متاسفانه جسارت‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 615.37,
   "end": 618.73,
   "text": "به اون‌ها می‌شه. تا جایی که قوه وهم و خیال میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 618.73,
   "end": 626.05,
   "text": "گمان می‌کنه من ولایتی هستم، تو راه حق هستم، دارم وجوهات شرعیه میدم آقا خمس واجباتمو دارم میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 626.05,
   "end": 634.31,
   "text": "اما انقدر حماقتم گل کرده، این قوه وهمم چنان منو به بیراهه کشونده و از قوای عاقله منو بیرون کشونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 634.31,
   "end": 636.33,
   "text": "که دارم به او که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 636.33,
   "end": 640.45,
   "text": "نور محض است، نور على نور، ذکر محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 640.45,
   "end": 643.87,
   "text": "آیت عظمای الهی‌ست، اسم اعظم خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 643.87,
   "end": 645.47,
   "text": "خلیفه خدا رو زمینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 645.47,
   "end": 647.49,
   "text": "دارم میگم bilan به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 647.49,
   "end": 649.35,
   "text": "وظیفه‌مونو انجام دادیم. خمس دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 649.35,
   "end": 656.09,
   "text": "اینو کجا بردی؟ و خیلی از ماها گاهی اوقات این جسارت‌ها رو ناخواسته به اماممون تو قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 656.09,
   "end": 657.65,
   "text": "وهم و خیالمون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 657.65,
   "end": 660.33,
   "text": "مراقب باشیم. انشاالله عاقبت به خیر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.33,
   "end": 664.59,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 664.59,
   "end": 670.35,
   "text": "سلام بر محمد و آل محمد و هر چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}