   "start": 6.02,
   "end": 44.54
  },
  {
   "index": 1,
   "title": "## آیهٔ سیزده مائده؛ نقض میثاق و قساوت",
   "start": 44.54,
   "end": 78.7
  },
  {
   "index": 2,
   "title": "## انحراف انقلاب؛ خطر داخلی و خارجی",
   "start": 78.7,
   "end": 292.88
  },
  {
   "index": 3,
   "title": "## تحریف سخنان امام و رهبری",
   "start": 292.88,
   "end": 313.02
  },
  {
   "index": 4,
   "title": "## خاطرهٔ آقای ناصری از قاضی و امام جوان",
   "start": 313.02,
   "end": 354.42
  },
  {
   "index": 5,
   "title": "## بداء؛ عقب و جلو افتادن ظهور",
   "start": 354.42,
   "end": 585.64
  },
  {
   "index": 6,
   "title": "## سمپاشی روزمره و نتیجهٔ قساوت",
   "start": 585.64,
   "end": 670.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.48,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.48,
   "end": 7.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.12,
   "end": 11.3,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.3,
   "end": 14.22,
   "text": "یه روزی ما یه حکمی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.22,
   "end": 16.32,
   "text": "وام و این‌ها عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.32,
   "end": 21.8,
   "text": "حالا یا من بد عرض کردم یا عزیزان بد برداشت کردن اینو درست جا بندازم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.8,
   "end": 24.8,
   "text": "در استفتایی از مقام معظم رهبری که به خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.8,
   "end": 27.76,
   "text": "حقیر، هم از دفتر ایشون پرسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.76,
   "end": 37.24,
   "text": "سؤال این بوده که آیا کسی که خب وامی رو وام مثلا خرید کالا عرض کردیم وام با یک قیدی، با یک قراردادی طبق یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.24,
   "end": 44.26,
   "text": "عرض کنم ااا مع-- طبق ذیل یک معامله از عقود اسلامی باید داده بشه و الا ذاتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.26,
   "end": 46.34,
   "text": "وام در اسلام وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.34,
   "end": 50.66,
   "text": "اون قرضه. خب حالا ما گرفتیم مثلا وام خرید خودرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.66,
   "end": 53.88,
   "text": "بعد یه نفر قرض نیاز داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.88,
   "end": 57.88,
   "text": "یادتونه؟ گفت بعد سؤال شده از آقا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.88,
   "end": 60.7,
   "text": "میشه این پولو به اون آقا بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.7,
   "end": 65.78,
   "text": "بعد که گرفتیم خب حتما باید تو خرید خودرو استفاده بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.78,
   "end": 69.58,
   "text": "خودمون اینو ببریم تو خرید خودرو استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.58,
   "end": 73.34,
   "text": "آقا فرمودن اگر اون شخص که داره قرض میگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.34,
   "end": 76.72,
   "text": "یعنی آقا که یعنی خود بنده از دفترشون استفتای کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.72,
   "end": 82.14,
   "text": "استفتا کردم. فرمودن اون کسی که قرض رو میگیره در صورتی میشه که اون هم چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.14,
   "end": 84.2,
   "text": "تو همون مورد مصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.2,
   "end": 87.62,
   "text": "این نکته‌ست که میگم بعضیا شاید اشتباه برداشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.62,
   "end": 91.02,
   "text": "گفتیم میشه در صورتی که اون تو همین هزینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.02,
   "end": 97.56,
   "text": "چون وام، وام مختص مثلا خرید خودروست، خودرو، خرید مسکن عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.56,
   "end": 104.12,
   "text": "نمیشه اون که حالا قرض می خواد بده تو هرچی دوست داشت هزینه کنه بعد تو پس بگیری خودت هم تو هزینه خودرو استفاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.12,
   "end": 116.48,
   "text": "نمیشه اینطوری. در خصوص قلب قسی نکته بسیار مهمی که جا مونده تو البته توی ذیل این آیه سیزده سوره مائده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.48,
   "end": 120.74,
   "text": "اگر دقت بفرمایید خب آیه رو که با هم مورد بررسی قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.74,
   "end": 125.1,
   "text": "ابتداش کهِ ، اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.1,
   "end": 130.12,
   "text": "میثاق رو، عهد رو بشکنه دو تا پیامد داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.12,
   "end": 132.4,
   "text": "خدا این رو خودش به خودش نسبت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.4,
   "end": 135.98,
   "text": "یعنی انقدر این قضیه پیش خدا سنگینه، بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.98,
   "end": 138.96,
   "text": "مکروه، کراهت داره و زشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.96,
   "end": 142.94,
   "text": "چی؟ پیمان شکنی که می‌فرمایدِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.94,
   "end": 147.28,
   "text": "ما اینو از رحمت خودمون به دور می‌کنیمِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.28,
   "end": 149.14,
   "text": ". دچار قساوت قلبش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.14,
   "end": 155.12,
   "text": "بعد بلافاصله این رو می‌فرمایدِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.12,
   "end": 158.18,
   "text": ". نکته بسیار مهم اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.18,
   "end": 160.42,
   "text": "می‌فرماید این‌ها می‌افتند به یک کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.42,
   "end": 168.92,
   "text": "خیلی زشت و ناپسندی،ُ حرفون هم فعل مضارعه یعنی دائما مشغول به یک انحراف و تحریفی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.92,
   "end": 171.48,
   "text": "چی؟ الكلمة عن مواضع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.48,
   "end": 174.74,
   "text": "همه چی رو منحرف و تحریف میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.74,
   "end": 181.4,
   "text": "اسلام رو، دین رو، حقایق رو، انقلاب رو، همه چی رو به رأی خودشون، به تفسیر خودشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.4,
   "end": 183.86,
   "text": "به نظر خودشون تغییر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.86,
   "end": 188.16,
   "text": "یکی از خطراتی که انقلاب ما رو به جد داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.16,
   "end": 190.84,
   "text": "تهدید میکنه قربونتون برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.84,
   "end": 193.76,
   "text": "همین بحث انحراف انقلابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.76,
   "end": 196.92,
   "text": "تحریف حقایق و ارزش‌های انقلابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.92,
   "end": 199.46,
   "text": "شما همه‌تون الحمدالله بچه‌های انقلابی هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.46,
   "end": 203.2,
   "text": "باید به هوش باشیم. خیلی این قصه من خیلی وقت پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.2,
   "end": 206.7,
   "text": "عرض کردم تو خارج به یه شکل، داخل به یه شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.7,
   "end": 209.4,
   "text": "حتی گاهی اوقات داخلی‌ها خطرناک‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.4,
   "end": 213.28,
   "text": "یواش یواش قدم، خطبه خطبه مثل شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.28,
   "end": 215.84,
   "text": "این‌ها قدم به قدم مردم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.84,
   "end": 222.32,
   "text": "می برن مثل قورباغه که میذاریش تو آب یواش یواش که آب رو گرم می‌کنی حالیش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.32,
   "end": 224.9,
   "text": "بعد آب به جوش میاد باز حالیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.9,
   "end": 226.66,
   "text": "یعنی یه مثالیه که می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.66,
   "end": 229.96,
   "text": "یواش یواش یه زمانی به قول استاد میرباغری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.96,
   "end": 233.88,
   "text": "حضرت آیت الله میرباغری می‌فرمودن که یه زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.88,
   "end": 240.38,
   "text": "اینکه دختر پسر خودشون برن همدیگه رو تو پارک خیابونی جایی انتخاب کنن می‌گفتیم آخ، آخ چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.38,
   "end": 243.46,
   "text": "انح-- چه فاجعه‌ای رخ داده فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.46,
   "end": 245.82,
   "text": "اما الان بس-- به شدت عادی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.82,
   "end": 248.28,
   "text": "یعنی همینطور که غرب، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.28,
   "end": 252.94,
   "text": "شیفتگان غرب، غرب زده‌های تو کشور ما که متاسفانه خیلیاشون جزو مدیران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.94,
   "end": 256.96,
   "text": "کلان ما هستن و برای شمای مبحنه و برای همه ملت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.96,
   "end": 259.68,
   "text": "آشکاره. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.68,
   "end": 262.62,
   "text": "به هر حال سر خم میارن جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.62,
   "end": 264.82,
   "text": "سر خم می‌کنند جلوی استکبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.82,
   "end": 271.1,
   "text": "هی غرب زدگی و عجیبه که شعارشون اینه میخوایم غرب رو اسلامی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.1,
   "end": 274.12,
   "text": "غرب، اسلامی کردن غربشون بخوره تو سرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.12,
   "end": 278.96,
   "text": "دارن فرهنگ اونورو وارد اسلام و انقلاب میکنن و این رفته رفته صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.96,
   "end": 283.1,
   "text": "الان دیگه چهارشنبه‌های سفید هم دیگه رد کرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.1,
   "end": 287.96,
   "text": "جاهای دیگه کشیده که اصلاً سنت‌های پیشین ما رو زیر پا میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.96,
   "end": 290.38,
   "text": "این بسیار یه خطر جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.38,
   "end": 292.88,
   "text": "خارج از کشور یه گونه، داخل یه گونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.88,
   "end": 296.34,
   "text": "ارزش‌های انقلاب، حرف‌های امام گاهی تحریف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.34,
   "end": 299.26,
   "text": "حرف‌های رهبری ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.26,
   "end": 303.74,
   "text": "عرض کنم مصادره به نفع خودشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.74,
   "end": 308.74,
   "text": "مثلا من یادم پارسال بود فکر کنم عرض کردم خدمتتون تو فرانسه یه کتابی، یه نشریه می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.74,
   "end": 313.8,
   "text": "یه کتابی چاپ شده بود که مثلا تحلیل کرده بود انقلاب ایران چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.8,
   "end": 316.1,
   "text": "اصلا چرا امام با شاه درگیر شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.1,
   "end": 319.0,
   "text": "بعد امام رو یک ملا که بزرگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.0,
   "end": 323.18,
   "text": "اونجا یاد میکنه تو کتاب که زمین‌های فراوانی داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.18,
   "end": 325.5,
   "text": "امام میگه بیا زمین‌ها رو تحویل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.5,
   "end": 328.48,
   "text": "این زمین‌ها ما شاه این مملکتیم، زمیناتو به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.48,
   "end": 332.22,
   "text": "این دعوای بین امام و شاه رو میگه دعوای ملکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.22,
   "end": 334.3,
   "text": "دعوای زمین بوده، اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.3,
   "end": 337.3,
   "text": "بعد مردم هم نفهمیدن و ریختن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.3,
   "end": 342.14,
   "text": "گفتن این شعار نمی‌دونم خواب رهنما رو میده حتما ملکش رو به ما میده و رفتن پشت سر امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.14,
   "end": 345.2,
   "text": "یک مشت اراجیف تو کشورهای خارجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.2,
   "end": 347.22,
   "text": "اینکه امام، رهبر عزیزمون نامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.22,
   "end": 352.28,
   "text": "میزنه به جوون‌های خارج از کشور چون میدونه اونور چه اتفاقی داره میفته، چه انحرافاتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.28,
   "end": 354.64,
   "text": "اصل انقلاب و زوایای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.64,
   "end": 358.12,
   "text": "ما باید به هوش باشیم حداقل تو خونواده‌مون دیگه این چیزا رو نبینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.12,
   "end": 361.54,
   "text": "بچه هامون یعنی چنا اینا رو بار بیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.54,
   "end": 367.36,
   "text": "یه فیلمی هم اگه دوست داشتید من دارم اینو بعضیا صوتشو دارن ولی من فیلمشو دارم که قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.36,
   "end": 370.26,
   "text": "از آقای ناصری خدا حفظشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.26,
   "end": 373.92,
   "text": "ایشون اصفهان ما خی-- خیلی خدمت ایشون می‌رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.92,
   "end": 379.62,
   "text": "خیلی من ایشونو قبول دارم. یکی از زсходان زمان و عرفا و علمای زمانه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.62,
   "end": 382.06,
   "text": "از-- واقعاً میشه گفت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.06,
   "end": 388.68,
   "text": "بزرگان و اساتید ماست. زی قیمت وجود ایشون و هر کسی هم متاسفانه ایشونو نمی‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.68,
   "end": 392.42,
   "text": "ما هم البته نمی‌شناسیم. اصفهان که می‌رفتیم خدمتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.42,
   "end": 394.52,
   "text": "چیزای عجیبی ما ازشون می‌دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.52,
   "end": 398.36,
   "text": "یه فی-- یه صوتی ازشون پخش شده که من تصویریشو دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.36,
   "end": 401.5,
   "text": "که ایشون سالگرد ارتحال امام امسال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 401.5,
   "end": 404.6,
   "text": "همین امسال، شب سالگرد امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.6,
   "end": 409.16,
   "text": "رحمت الله علیه یه خاطره‌ای رو از آشیخ عباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.16,
   "end": 412.58,
   "text": "قوچانی که وصی آقای قاضی بوده نقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.58,
   "end": 416.2,
   "text": "البته خیلی مفصله من خلاصشو عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.2,
   "end": 420.6,
   "text": "که میگه که خود ایشون میگه \"من خودم از آشیخ عباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.6,
   "end": 425.64,
   "text": "قوچانی که وصی آقای قاضی بود، شاگرد بلا فصل آقای قاضی بود، شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.64,
   "end": 430.24,
   "text": "خیلی زمان‌های قدیم ظاهراً برمی‌گرده به بیست سال قبل انقلاب ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.24,
   "end": 434.14,
   "text": "یه روز امام، آیه سید روح‌الله خب سنش کمتره اون موقع‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.14,
   "end": 437.44,
   "text": "آقای قاضی داشته تو کلاس بیست سی نفری درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.44,
   "end": 440.16,
   "text": "ولایت می‌داده که آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.16,
   "end": 444.74,
   "text": "قوچانی اونجا بوده. میگه یه دفعه دیدیم این آقا سید یعنی آیه سید روح‌الله یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.74,
   "end": 446.9,
   "text": "امام عزیز ما وارد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.9,
   "end": 451.2,
   "text": "آقای قاضی جلوی حضرت امام بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.2,
   "end": 454.02,
   "text": "جلوی حضرت امام جوان بلند می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.02,
   "end": 455.64,
   "text": "و خیلی احترام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.64,
   "end": 458.02,
   "text": "ایشون صدر مجلس جا می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 458.02,
   "end": 462.2,
   "text": "وقتی امام جلوس می‌فرمایند بحثو اصلاً عوض می‌کنه آقای قاضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.2,
   "end": 465.1,
   "text": "از موضوع ولایت بحثو میاره به قیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 465.1,
   "end": 468.76,
   "text": "و وجوب قیام بر علیه ظالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.76,
   "end": 473.38,
   "text": "میگه یه تقریباً یک یک ساعتی بحث اینطوری گذشت و ما همه متعجب شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 473.38,
   "end": 475.92,
   "text": "اون احترام چی بود؟ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.92,
   "end": 481.36,
   "text": "انحراف بحث به سمت قیام، وجوب قیام در برابر ظلم و ظالم چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.36,
   "end": 486.92,
   "text": "و همش هم تکرار می‌کرد آقای قاضی و به امام نگاه می‌کرده که در شما واجب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.92,
   "end": 489.02,
   "text": "قیام در برابر ظالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.02,
   "end": 494.0,
   "text": "تموم شد و به هر حال برای همه‌ی ما بیست سی نفر شاگردها تعجب بود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.0,
   "end": 495.8,
   "text": "چه رفتاری بود از آقای قاضی دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 495.8,
   "end": 499.26,
   "text": "خب اون استوانه عرض کنم توحید رو می‌دونستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.26,
   "end": 503.28,
   "text": "همه حرکاتش رو حساب و بعدم که امام پا شد بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.28,
   "end": 505.34,
   "text": "تا دم در بدرقه امامو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 505.34,
   "end": 513.66,
   "text": "کی؟ آقای قاضی. بعد ایشون آقای قوچانی میگه من خودم از آقای قاضی بعد از جلسه پرسیدم قصه این جریان چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.66,
   "end": 518.2,
   "text": "این مثلاً رفتار شما، عوض شدن بحث و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.2,
   "end": 520.34,
   "text": "خلاصه آقای قاضی می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.34,
   "end": 523.4,
   "text": "این سید بزرگوار توفیق پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.4,
   "end": 527.84,
   "text": "که انقلابی رو بکنه که اهدی نتونسته این کارو انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.84,
   "end": 529.98,
   "text": "و حکومت اسلامی در ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.98,
   "end": 538.64,
   "text": "برقرار می‌کنه و بعد از خودش به نیابت خودش می‌رسه و بعد از نیابت خودش انشاالله منجر به ظهور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.64,
   "end": 542.06,
   "text": "که آقای ناصری بالا منبر میاد حرف فیلمشو من دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.06,
   "end": 545.3,
   "text": "میگه ما حتی پیرمردهام امیدواریم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.3,
   "end": 550.74,
   "text": "حالا البته اینم عرض کنم یه وقت این اتفاقا انشاالله که می‌شه ولی یه وقت یه درصدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 550.74,
   "end": 553.52,
   "text": "نشه بعد بعضیا بگن آقا پس چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.52,
   "end": 558.22,
   "text": "مثل اینکه آقای بهجت فرموده بود ما پیرمردها و ریش سفیدا هم امید داریم ظهور آقا رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.22,
   "end": 560.9,
   "text": "پس چی شد؟ میگیم بدا حاصل می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.9,
   "end": 564.46,
   "text": "یعنی با خیلی اتفاقات م-مثلاً گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.46,
   "end": 569.32,
   "text": "و خصوصاً عدم وحدت کلمه و عدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 569.32,
   "end": 574.06,
   "text": "وحدت بین قلوب اهل ایمان بدا حاصل می‌شه و ظهور دوباره عقب می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 574.06,
   "end": 578.68,
   "text": "همینطور که می‌تونه جلو بیفته. مثلاً انقلاب امام، ذات انقلاب امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 578.68,
   "end": 581.54,
   "text": "حداقل می‌گفتن دویست سال ظهور آقا رو جلو انداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 581.54,
   "end": 584.8,
   "text": "آقای بهائ‌الدینی فرموده بودند. خب کم نیست دویست سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 584.8,
   "end": 589.68,
   "text": "بخوام عرض کنم که همین انحرافات و برعکس تو جوونا میان میگن که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 589.68,
   "end": 591.72,
   "text": "آره استغفرالله یه مشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.72,
   "end": 594.42,
   "text": "آخوندها جمع شدن دور هم و یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.42,
   "end": 598.2,
   "text": "مثلاً حکومتی تشکیل دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.2,
   "end": 602.72,
   "text": "جیب مردمو ب-بچاپن و و امثال اینا که روزمره دارید می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.72,
   "end": 609.48,
   "text": "من چند روز پیش پرای-پرایدمو جلو در پارک کردم می‌خواهم برم خونه یه آقایی رد می‌شد تازه به ما خیلی احترام گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 609.48,
   "end": 613.24,
   "text": "گفت حاج آقا می‌بینم که پراید به شما رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 613.24,
   "end": 617.84,
   "text": "پرایدش به شما رسیده. بنز و نمی‌دونم بی‌ام‌و اینا نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 617.84,
   "end": 619.98,
   "text": "و اینها واقعاً گمانشون اینه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.98,
   "end": 622.58,
   "text": "شما میری وقتی با بعضیاشون می‌شینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.58,
   "end": 625.4,
   "text": "به هر حال از بعضی جاها تقصیرم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 625.4,
   "end": 632.54,
   "text": "انقدر که سمپاشی می‌شه، انقدر که تحریف انقلاب صورت می‌گیره و انقدر که متاسفانه بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 632.54,
   "end": 638.46,
   "text": "لباس روحانیت به تنها خیانت کردن، اینا اینطوری می‌بینن و واقعاً به واقع اینطوری فکر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.46,
   "end": 642.36,
   "text": "انشاالله که امام عصر ما رو کمک کنه جزو این یحرفون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.36,
   "end": 645.12,
   "text": "یحرفون الكلم عن مواضعه نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 645.12,
   "end": 647.94,
   "text": "این نتیجه‌ش چیه؟ قساوت قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.94,
   "end": 651.96,
   "text": "که حرامخوری و گناه و معصیت باعث می‌شه انسان به اون سمت بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.96,
   "end": 656.14,
   "text": "اصلاً دیگه چشم حق‌بینش، گوش حق‌بینش کر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.14,
   "end": 658.22,
   "text": "چرا؟ چون دلش سنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 658.22,
   "end": 659.98,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 659.98,
   "end": 663.24,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.24,
   "end": 665.46,
   "text": "اللهم صل علی محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 665.46,
   "end": 670.46,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}