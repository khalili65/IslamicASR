 "chapters": [
  {
   "index": 0,
   "title": "## وام مشروط به خواباندن پول",
   "start": 2.4,
   "end": 52.56
  },
  {
   "index": 1,
   "title": "## ثم قست قلوبکم من بعد ذلک",
   "start": 52.56,
   "end": 296.82
  },
  {
   "index": 2,
   "title": "## معجزهٔ قرن؛ انقلاب اسلامی",
   "start": 296.82,
   "end": 413.58
  },
  {
   "index": 3,
   "title": "## سدیر و امتحان امام؛ علم حضوری",
   "start": 413.58,
   "end": 565.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.4,
   "end": 5.82,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.82,
   "end": 9.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.24,
   "end": 13.2,
   "text": "آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.2,
   "end": 18.22,
   "text": "استفتای دیگری که از رهبر عزیزمون شده پیرامون وام و قرض و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.22,
   "end": 22.7,
   "text": "این هستش که ما میریم از یک صندوق قرض‌الحسنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.7,
   "end": 27.88,
   "text": "قرضی، وامی چیزی می‌گیریم. اون‌ها مشروط می‌کنند دادن این وام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.88,
   "end": 33.78,
   "text": "به اینکه شما تو صندوقی حساب باز کنید، ن تومن پول بریزید مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.78,
   "end": 37.16,
   "text": "بیست ماهه، چهل، چهل و پنج ماهه چه می‌دونم شصت ماهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.16,
   "end": 39.56,
   "text": "بعد این پول تا آخر دست بهش نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.56,
   "end": 41.66,
   "text": "سودی هم بهش تعلق نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.66,
   "end": 46.76,
   "text": "این شرط دادن وامه. خب الان شما برید معمولا چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.76,
   "end": 49.42,
   "text": "آیا این وام و این قرض اشکال داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.42,
   "end": 56.38,
   "text": "چون همه مراجع فرمودن هر گونه شرطی در گرفتن وام و قرض حرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.38,
   "end": 60.02,
   "text": "آقا جوابشون این هست که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.02,
   "end": 65.96,
   "text": "در اون برگه‌ای که شما داری وام می‌گیری بالاخره یه شرgyiط داره گرفتن وام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.96,
   "end": 71.9,
   "text": "جزو شرایط گرفتن این قرض و این وام از این موسسه و این بانک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.9,
   "end": 77.42,
   "text": "این هست که شما بخشی از پول رو بخوابونی، دست بهش نزنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.42,
   "end": 80.46,
   "text": "حالا شرطش اینه که پول قبلش بخوابونی، این میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.46,
   "end": 83.68,
   "text": "قرض یا وام ربوی و حرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.68,
   "end": 87.48,
   "text": "البته توجه بکنید فرق می‌کنه به اینکه حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.48,
   "end": 89.94,
   "text": "خیلی معمولا به این دقت نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.94,
   "end": 96.04,
   "text": "این کار حرامه. یعنی در حقیقت رفتن زیر بار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.04,
   "end": 100.58,
   "text": "قرارداد حرامه و الا خود اصل قرض اشکالی نداره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.58,
   "end": 104.46,
   "text": "اینو متوجه باشید. یعنی اون پولی که می‌خوابونی اونجا، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.46,
   "end": 112.2,
   "text": "شکل گرفتن وام یا قرض حرامه و الا اون پول رو گرفتی، تحت تصرفت گرون می‌ها-- می‌تونی براش تصرف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.2,
   "end": 115.1,
   "text": "مالک پولی، پوله هم حلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.1,
   "end": 118.24,
   "text": "اما این کار حرامه. یعنی شما فعل حرام مرتکب شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.24,
   "end": 123.28,
   "text": "اینو با هم خلط بحث نشه. نکته دیگه آقا فرمودن اگر نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.28,
   "end": 125.22,
   "text": "صندوق میاد چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.22,
   "end": 127.28,
   "text": "تو توضیح همین استفتائه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.28,
   "end": 130.46,
   "text": "آقا می‌فرمایند صندوق میاد میگه آقا بیاید حساب باز کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.46,
   "end": 132.78,
   "text": "هر کی دوست داره میره حساب باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.78,
   "end": 141.36,
   "text": "بعد میگه حالا به اون‌هایی که تو این صندوق حساب باز کردن وام میدیم یا قرض میدیم این اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.36,
   "end": 146.86,
   "text": "این بی‌اشکاله. چون ضابطه‌ایه در داخل صندوق برای کسایی که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.86,
   "end": 150.4,
   "text": "حساب دارن. در خصوص قلب قسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.4,
   "end": 154.34,
   "text": "و قلبی که سخت شده یا بدتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.34,
   "end": 156.74,
   "text": "سنگ شده، داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.74,
   "end": 159.4,
   "text": "تا پیرامون تازه یه دونه از آیات کار می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.4,
   "end": 162.88,
   "text": "نکته خیلی، خیلی و خیلی مهم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.88,
   "end": 166.6,
   "text": "به فضل الهی از این آیه امروز برداشت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.6,
   "end": 173.04,
   "text": "اگر دقت بفرمایید آیه هفتاد و چهار، سی بقره همون ابتداش نکته‌ای رو به دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.04,
   "end": 176.88,
   "text": "فرمود «ثم قست قلوبکم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.88,
   "end": 180.28,
   "text": "شما ای بنی اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.28,
   "end": 183.02,
   "text": "سپس دل‌هاتون سنگ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.02,
   "end": 185.7,
   "text": "«من بعد ذلك»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.7,
   "end": 189.48,
   "text": "بعد از آن. این ذلك بر می‌گرده به چی بحث ما اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.48,
   "end": 191.74,
   "text": "بعد چی شما دلتون سنگ شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.74,
   "end": 193.92,
   "text": "این خیلی مهمه، این موضوعیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.92,
   "end": 200.68,
   "text": "که بعد می‌فرماید ՝ «فیک الحجاره» مثل سنگ شد دل‌هاتون «أشد قسوه» بلکه سخت‌تر و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.68,
   "end": 203.12,
   "text": "بعد از چی شما دلتون سنگ شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.12,
   "end": 205.36,
   "text": "آیات قبل رو مرور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.36,
   "end": 208.5,
   "text": "معجزات زمان بنی اسرائیل رو خدا ذکر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.5,
   "end": 211.84,
   "text": "یاد کنید از اون موقعی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.84,
   "end": 215.3,
   "text": "شما رو رهبری معصوم دادیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.3,
   "end": 221.1,
   "text": "اون همه نعمت دادیم. من و سلوی و ترنجبین و نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.1,
   "end": 227.98,
   "text": "آرامش و نجات از دست فرعون و شکافته شدن دریا و اون معجزه عصای موسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.98,
   "end": 231.5,
   "text": "ها؟ رهبری، رهبری پیغمبر معصوم رو به شما دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.5,
   "end": 236.48,
   "text": "شوخی نیست. این همه نعمت، کوه شکافته شدن کوه طور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.48,
   "end": 238.6,
   "text": "یا اینکه ابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.6,
   "end": 242.5,
   "text": "به خواست خدا رو سر شما و شهر و دیارتون قرار می‌گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.5,
   "end": 244.78,
   "text": "سایه می‌انداخت روتون، بارون می‌بارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.78,
   "end": 253.26,
   "text": "برای شما خاص بود. «ثم قست قلوبکم من بعد ذلك» بعد از این همه معجزه دل‌های شما سخت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.26,
   "end": 256.5,
   "text": "یعنی چی؟ یعنی وای به کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.5,
   "end": 259.88,
   "text": "ببینه معجزات رو و لجاجت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.88,
   "end": 263.3,
   "text": "وای به اینکه به کسی که براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.3,
   "end": 266.0,
   "text": "عرض کنم حجت تمام بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.0,
   "end": 269.38,
   "text": "ببینه با چشمش حجت رو باز انکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.38,
   "end": 271.46,
   "text": "این میفته به دام چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.46,
   "end": 276.48,
   "text": "قساوت قلب. یعنی در حقیقت این نکته از این آیه بیرون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.48,
   "end": 278.8,
   "text": "که باید حواسمون جمع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.8,
   "end": 284.08,
   "text": "که اگر برای ما حجتی تموم میشه، معجزه‌ای می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.08,
   "end": 286.5,
   "text": "چه فردی، چه اجتماعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.5,
   "end": 288.98,
   "text": "این مسئولیت ما رو سنگین‌تر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.98,
   "end": 291.46,
   "text": "اگه بخوایم انکار کنیم و لجاجت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.46,
   "end": 293.62,
   "text": "دچار قساوت قلب می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.62,
   "end": 296.82,
   "text": "الان مثلا معجزه ما هم قرن ما چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.82,
   "end": 300.9,
   "text": "امام فرمود معجزه قرن انقلاب اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.9,
   "end": 308.18,
   "text": "ما اینو با چشممون دیدیم که یکی از علما به امام اشکال می‌کرد که بابا چی میگی شاه باید برود، شاه باید برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.18,
   "end": 311.96,
   "text": "یه مستأجر از خونه‌مون نمی‌تونیم بیرون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.96,
   "end": 316.04,
   "text": "شما میگید باید برود. مسخره می‌کردن بعضیا امام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.04,
   "end": 319.24,
   "text": "امام می‌فرمود ما گفتیم باید برود، باید برود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.24,
   "end": 322.4,
   "text": "و رفت. ببینید این معجزه است واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.4,
   "end": 324.86,
   "text": "الان شما چقدر کشورها دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.86,
   "end": 327.78,
   "text": "بیداری اسلامی شدند. همین فرانسه که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.78,
   "end": 332.1,
   "text": "داره بر علیه سرمایه‌داری هشتاد و چهار درصد مردمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.1,
   "end": 335.46,
   "text": "تقریباً انقلاب کردن. سه هفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.46,
   "end": 337.56,
   "text": "چه وضعیه تو فرانسه ما موفق نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.56,
   "end": 340.26,
   "text": "اگرچه اونا بره سرمایه‌دار هستن بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.26,
   "end": 343.04,
   "text": "کاملاً لیبراله. هیچ ربطی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.04,
   "end": 345.54,
   "text": "مثلا معارف نداره. نتونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.54,
   "end": 349.46,
   "text": "نمی‌تونن. ببینید این معجزه قرن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.46,
   "end": 353.08,
   "text": "خب آدم بیاد نسبت به این معجزه بی‌تفاوت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.08,
   "end": 357.76,
   "text": "لجاجت کنه، چشمشو ببنده قطعاً دچار قساوت قلب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.76,
   "end": 361.04,
   "text": "گاهی اوقات آدم وقتی اینطوری فکر می‌کنه قربونتون برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.04,
   "end": 365.16,
   "text": "عزیزان دلم میگه خداروشکر ما زمان اهل بیت نبودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.16,
   "end": 368.04,
   "text": "این يا ليتني كنت معك بحثش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.04,
   "end": 372.54,
   "text": "ما میگیم كنت معك یعنی من ای کاش با تو بودم نه در زمان تو بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.54,
   "end": 378.64,
   "text": "این اشتباه نشه. هر جا بودم ای کاش با تو بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.64,
   "end": 385.0,
   "text": "نه اینکه در زمان تو بودم. اگه ما زمان امیرالمؤمنین بودیم سلمان یه لحظه خلط جان تو ذهنش ایجاد شد تو کوچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.0,
   "end": 389.78,
   "text": "جریانشو براتون گفتم. امیرالمؤمنین فرمود ولایتت رو تجدید کن با ما عهدت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.78,
   "end": 394.72,
   "text": "خیلی داستانا الان گاهی آقا دم می‌شه خدا رو شکر اصلاً تو زمان غیبتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.72,
   "end": 398.24,
   "text": "که خدا به ما سخت نگرفته انکار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.24,
   "end": 402.42,
   "text": "به ما خیلی خدا لطف داشته امثال من ضعیف النفسو این موقع آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.42,
   "end": 409.02,
   "text": "یه مثال بزنم استاد لوجردی این روایت رو می‌گفت فکر کنم در اصول کافی بنده حقیر دیدم که صدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.02,
   "end": 413.06,
   "text": "درستش بعضی صدع هم تلفظ کردن ما از اساتید شنیدیم صدیر درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.06,
   "end": 416.94,
   "text": "صدیر سیرافی از شاگردهای امام صادق سلام الله علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.94,
   "end": 420.72,
   "text": "این روایتو گوش بدین قشنگ متوجه میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.72,
   "end": 425.24,
   "text": "اِممم تو مسجد خودش میگه پول کلانی از حضرت دست من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.24,
   "end": 427.94,
   "text": "حالا وجوهات بود یا هرچی بود سهم امام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.94,
   "end": 430.1,
   "text": "حضرت که تشریف آوردن من برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.1,
   "end": 435.84,
   "text": "حضرت رو امتحان کنم یه مشت از این پول رو برداشتم پنهان کردم ببینم حضرت متوجه می‌شه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.84,
   "end": 441.24,
   "text": "تا حضرت به من رسید فرمود صد-صدیر به من، به ما خیانت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.24,
   "end": 444.88,
   "text": "اگرچه بعد دقت کنین مبنای خیانت رو چجوری بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.88,
   "end": 447.86,
   "text": "فرمود اگرچه تو قصد نداشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.86,
   "end": 450.7,
   "text": "عناد با ما نداشتی، قصد نداشتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.7,
   "end": 454.52,
   "text": "عناد و دشمنی کنی چون نمی‌خواستی این پول رو ورداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.52,
   "end": 457.02,
   "text": "یعنی برداشته بودی که از ما جدا بشی و بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.02,
   "end": 461.98,
   "text": "قصد دزدی نداشتی. اما حواست نبود که آنچه علم است نزد ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.98,
   "end": 466.98,
   "text": "بعد اشاره می‌کنه به این آیه که و کل شی این آیه رو نخوندی صدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.98,
   "end": 471.34,
   "text": "که کل شیء احصیناه فی امام مبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.34,
   "end": 473.4,
   "text": "هر چیزی تعریف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.4,
   "end": 477.1,
   "text": "شمارش شده در امام، امام مبین و اون مایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.1,
   "end": 479.74,
   "text": "اصن همه علم در محضر ما حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.74,
   "end": 481.58,
   "text": "حاضره نه که حاصل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.58,
   "end": 484.06,
   "text": "حاضره. علم حضوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.06,
   "end": 489.46,
   "text": "داشته شد میگه این امتحانی که تو از ما کردی خیانت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.46,
   "end": 496.56,
   "text": "تشر زد امام بهش. اگر اینطوری بود اگه آدم بخواد امامشو امتحان کنه، بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.56,
   "end": 499.0,
   "text": "حقایق رو نسبت بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.0,
   "end": 502.78,
   "text": "با دیده شک و ریب و تردید نگاه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.78,
   "end": 505.8,
   "text": "معجزات الهی اینا همش تشر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.8,
   "end": 509.88,
   "text": "تشرش رفته، رفته، رفته ثُمَّ قَسَتْ قُلُوبُکُمْ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.88,
   "end": 514.42,
   "text": "انسان به سمتی میره که دیگه دلش چنان سفت و سخت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.42,
   "end": 518.22,
   "text": "که هرچی هم جلوش حقایق رو ببینه انکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.22,
   "end": 521.56,
   "text": "یکی از دلایلی که بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.56,
   "end": 527.72,
   "text": "گفتن از علما وقتی آقا تشریف بیارن جلوی حضرت وایمیسن مگه علمشو نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.72,
   "end": 531.3,
   "text": "همین انکارهاست. فقط یاد گرفته بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.3,
   "end": 533.34,
   "text": "ولی اون علم حضوری رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.34,
   "end": 535.6,
   "text": "حاصل کرده فقط. یه چیزایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.6,
   "end": 539.26,
   "text": "تو ذهنش جمع کرده. خیلی خطرناکه این قصه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.26,
   "end": 542.38,
   "text": "اگر می‌خوایم دچار قلب قسی نشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.38,
   "end": 547.52,
   "text": "باید چشم نبندیم به روی معجزات، به روی حکمت، حکمت بالغه الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.52,
   "end": 550.26,
   "text": "به روی آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.26,
   "end": 552.88,
   "text": "به سمت امام عصر توجهمون دائمی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.88,
   "end": 555.52,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.52,
   "end": 558.62,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.62,
   "end": 562.24,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.24,
   "end": 565.56,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}