   "start": 13.94,
   "end": 33.94
  },
  {
   "index": 1,
   "title": "## نه دی و نکتهٔ مغفول در تحلیل فتنه",
   "start": 33.94,
   "end": 54.26
  },
  {
   "index": 2,
   "title": "## اصل اصول فتنه از زبان امام",
   "start": 54.26,
   "end": 94.16
  },
  {
   "index": 3,
   "title": "## نه دی و خط قرمز اهل‌بیت",
   "start": 94.16,
   "end": 178.34
  },
  {
   "index": 4,
   "title": "## حدیث حیوانات در شب عاشورا",
   "start": 178.34,
   "end": 839.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 4.6,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.6,
   "end": 8.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.38,
   "end": 13.94,
   "text": "آياته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.94,
   "end": 17.78,
   "text": "استفتای دیگری که از رهبر عزیز شده پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.78,
   "end": 21.98,
   "text": "طهارت و این‌ها، اینه که اگر روغن نجس بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.98,
   "end": 25.76,
   "text": "یه وقت هست روغن جامده، خب اون مقداری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.76,
   "end": 28.34,
   "text": "چون روغن جامده ما این نجاسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.34,
   "end": 31.84,
   "text": "به جاهای دیگه مرتبط نشد، انتقال پیدا نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.84,
   "end": 37.62,
   "text": "رطوبت نداشته که اون مقدار نجاست رو با یه مقدار دور و برش رو جمع می‌کنه، بر می‌داره، هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.62,
   "end": 39.54,
   "text": "اون اما روغن مایع چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.54,
   "end": 43.54,
   "text": "سؤال اینه که اگر این روغن، خب اگر روغن مایع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.54,
   "end": 45.66,
   "text": "نجس شد دیگه کلش نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.66,
   "end": 48.32,
   "text": "خب حالا سؤال اینه که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.32,
   "end": 53.12,
   "text": "این روغن روش فعل و انفعالاتی صورت بگیره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.12,
   "end": 56.58,
   "text": "دارای خواص جدیدی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.58,
   "end": 59.82,
   "text": "آیا این حکم استحاله رو پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.82,
   "end": 64.14,
   "text": "و مثلاً استحاله می‌شه، دیگه پاک می‌شه یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.14,
   "end": 67.32,
   "text": "باز هم محکومه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.32,
   "end": 70.58,
   "text": "نج-نجاسته، ن-نجس بودنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.58,
   "end": 75.72,
   "text": "آقا فرمودن که نه صرف فعل و انفعالات شیمیایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.72,
   "end": 81.3,
   "text": "که خاصیت حالا اون ماده رو عوض کنه، دلیل بر طهارت نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.3,
   "end": 85.04,
   "text": "اینطوری نیست که حالا بگیم حکم استحاله رو پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.04,
   "end": 91.34,
   "text": "ولو اگر خواصش عوض شده، روش فعل و انفعالات شیمیایی انجام شده، باز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.34,
   "end": 96.34,
   "text": "این نجس هست و نمی‌شه ازش استفاده کرد، در روغن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.34,
   "end": 102.26,
   "text": "خب در خصوص امروز خب بحث ما امروز منقطع بشه البته می‌شه ربطش داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.26,
   "end": 105.94,
   "text": "بحث فتنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.94,
   "end": 113.3,
   "text": "سالروز نه دی و این‌ها رو می‌شه به بحث همون قلب قسی که داشتیم در قرآن ارتباطش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.3,
   "end": 117.42,
   "text": "اما برای اینکه راحت‌تر بحث کنیم، دامنه بحث بازتر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.42,
   "end": 122.4,
   "text": "خب و ضمن این که اهمیت امروز مشخص بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.4,
   "end": 130.2,
   "text": "یه نکته‌ای رو عرض کنم، اونم البته به نظر حقیر یه بررسی اجمالی که انجام دادم غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.2,
   "end": 136.2,
   "text": "تریبون‌به‌دست‌ها، مقاله‌نویس‌ها، متوجه‌های این عرصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.2,
   "end": 139.8,
   "text": "از این نکته غافل بودن. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.8,
   "end": 148.46,
   "text": "تحلیل‌های متعدد و مختلفی رو من پیرامون قصه نه دی و قضیه فتنه دیدم و شنیدم و مستندها و حرف‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.46,
   "end": 152.02,
   "text": "سخنرانی‌ها و برام عجیب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.02,
   "end": 157.12,
   "text": "اکثراً یا شاید بشه گفت غریب به اتفاق از این نکته غافل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.12,
   "end": 160.1,
   "text": "حالا من این رو عرض می‌کنم. حالا البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.1,
   "end": 164.58,
   "text": "روش‌های متعددی که رهبر عزیزمون تونست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.58,
   "end": 168.38,
   "text": "این فتنه رو خنثی کنه و این‌ها خودش اون‌ها جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.38,
   "end": 171.32,
   "text": "من اون‌ها رو نقد نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.32,
   "end": 176.7,
   "text": "مثل حالا چیزهایی که گفته شده براش تو تریبون‌ها یا سخنرانی‌ها یا مقاله‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.7,
   "end": 181.2,
   "text": "اولاً روشنگری مردم و بسیج عمومی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.2,
   "end": 186.74,
   "text": "که رهبر ایجاد کردن، بیان شاخصه‌های فرد صالح یا اصلح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.74,
   "end": 189.36,
   "text": "تأکید بر بصیرت خواص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.36,
   "end": 191.98,
   "text": "مقابله با شبهه تقلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.98,
   "end": 195.26,
   "text": "تأکید بر امنیت و سلامت انتخابات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.26,
   "end": 198.76,
   "text": "دعوت به وحدت و جلوگیری از انشقاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.76,
   "end": 201.64,
   "text": "دعوت به مسیر قانونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.64,
   "end": 205.96,
   "text": "هشدار نسبت به توطئه دشمنان خارجی و داخلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.96,
   "end": 210.42,
   "text": "جذب حد అక్కثری و دفع حد اقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.42,
   "end": 215.64,
   "text": "یا مرزبندی جریان‌های سیاسی و آگاهی‌بخشی به مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.64,
   "end": 222.24,
   "text": "که تو هر جریان سیاسی هستی مرز خودت رو با این فتنه‌گرا مشخص کن که متأسفانه خیلیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.24,
   "end": 224.82,
   "text": "نکردن حتی تو طراز بالای نظام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.82,
   "end": 227.66,
   "text": "حالا ترسیدن، مصلحت اندیشی کردن، چه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.66,
   "end": 232.58,
   "text": "این‌ها همه درست. اما یه نکته‌ای رو که بهش توجه نکردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.58,
   "end": 234.78,
   "text": "که خیلی مهمه، اصلاً به نظر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.78,
   "end": 237.94,
   "text": "جان مطلب همینه که جا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.94,
   "end": 244.04,
   "text": "بدتر از اون اینه که بعضیا تحلیل غلط ارائه دادن و این رو یک نقطه ضعف از رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.04,
   "end": 246.62,
   "text": "دادن یا مخصوصاً این تحلیل‌گرای خارجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.62,
   "end": 252.06,
   "text": "اون نماز جمعه‌ای که یادتونه آقا با یک بغضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.06,
   "end": 255.64,
   "text": "خطاب به امام عصر سلام الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.64,
   "end": 258.76,
   "text": "سید و مولای ما دعا کن برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.76,
   "end": 267.48,
   "text": "نمی‌دونم من جان ناقابلی دارم و بدن، بدن ناقصی دارم و آبر-- مختصر آبرویی دارم که اونم تو به ما دادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.48,
   "end": 270.0,
   "text": "تو صاحب مایی. عین کلمات آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.0,
   "end": 273.74,
   "text": "تو صاحب این کشوری، تو صاحب این کشوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.74,
   "end": 279.14,
   "text": "توجه کردی؟ این نشان‌دهنده اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.14,
   "end": 282.28,
   "text": "بالاترین مقام این کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.28,
   "end": 287.02,
   "text": "چگونه خضوع تام در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.02,
   "end": 289.56,
   "text": "صاحب به واقع صاحب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.56,
   "end": 293.92,
   "text": "و ما معتقدیم صاحب این نظام داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.92,
   "end": 296.94,
   "text": "و او معتقده که کسی دیگه داره رهبری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.94,
   "end": 302.34,
   "text": "این رو باید بهش توجه کرد. یعنی قصه رهبری امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.34,
   "end": 310.0,
   "text": "رهبری امام عصر در بالاترین مقام، ببینید ما نمی‌تونیم خیلی درک کنیم این قصه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.0,
   "end": 313.5,
   "text": "شما دیدید معمولاً یه کسی پرستیژ یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.5,
   "end": 318.18,
   "text": "خ-- پستش و مقامش و مسئولیتش می‌خواد تو عرصه امروزی حفظ بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.18,
   "end": 321.12,
   "text": "متأسفانه یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.12,
   "end": 323.74,
   "text": "دید روشنفکری پیدا، پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.74,
   "end": 329.3,
   "text": "و اصلاً قیافه‌ش عوض می‌شه. مثلاً می‌ترسه ریش بذاره، پشت میز ریاست کل بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.3,
   "end": 331.84,
   "text": "معمولاً شما ببینید اونایی که مدیر می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.84,
   "end": 334.4,
   "text": "حالا مگر مصلحتی جواب کنه، ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.4,
   "end": 338.54,
   "text": "معمولاً دل‌نگران می‌شن از ارزش‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.54,
   "end": 340.68,
   "text": "خیلی دم از ارزش‌ها نمی‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.68,
   "end": 346.56,
   "text": "می‌خوان همه رو داشته باشن، منتقدینشون هم داشته باشن، دور خودشو شلوغ کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.56,
   "end": 349.86,
   "text": "اون خط رو گم می‌کنن. فکر می‌کنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.86,
   "end": 352.52,
   "text": "مثلاً وامدار اینان. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.52,
   "end": 356.82,
   "text": "جرات نمی‌کنن خیلی با جسارت از ارزش‌ها بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.82,
   "end": 361.42,
   "text": "یه تقریباً پز روشنفکری بهشون دست می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.42,
   "end": 363.68,
   "text": "که این دقیقاً این فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.68,
   "end": 368.04,
   "text": "نشأت گرفته از تفکرات لیبرال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.04,
   "end": 370.5,
   "text": "سکولاره دیگه ما معتقدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.5,
   "end": 372.94,
   "text": "یعنی تو همین سازمان در عرصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.94,
   "end": 378.9,
   "text": "آسیب‌های اجتماعی، اون چهارگانه که رهبر دستور داده بود، نمی‌دونم حاشیه نشینی و اعتیاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.9,
   "end": 382.3,
   "text": "عرض کنم خدمتتون فساد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.3,
   "end": 384.7,
   "text": "این‌ها یا طلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.7,
   "end": 386.96,
   "text": "خب اون چیزی که ساعت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.96,
   "end": 391.48,
   "text": "صدها یا شاید هزاران جلسه متخصصی دارم تو ادارات مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.48,
   "end": 394.18,
   "text": "انجام شده بود، اومده بود تو اداره ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.18,
   "end": 398.72,
   "text": "وقتی اینا رو دادن به عنوان یک پاور پوینت به ما نشون دادن که ما نظر بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.72,
   "end": 402.8,
   "text": "دیدیم همش نظرات غربی و شرقی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.8,
   "end": 409.24,
   "text": "خلاصه خارج از دین. یه بند هم بله خالی نبودن عریضه نوشتن البته توجه به آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.24,
   "end": 413.66,
   "text": "که ما اونجا داد زدیم گفتیم آقا این سکولاره، اخ این چه وضعشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.66,
   "end": 417.6,
   "text": "ما کشور اسلامی می‌خوایم در مورد یه آسیبی بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.6,
   "end": 420.54,
   "text": "اصلاً کد دین توی این عرصه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.54,
   "end": 423.66,
   "text": "می‌ترسن. توجه کردی متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.66,
   "end": 426.28,
   "text": "حالا بماند این سمت نریم به حاشیه بکشه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.28,
   "end": 429.7,
   "text": "اما رهبر بالاترین مقام نظام ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.7,
   "end": 435.82,
   "text": "توی همچون موقعیت حساسی دم می‌زنه که ما پا و رکاب شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.82,
   "end": 440.58,
   "text": "همه وجودمون فدای شما، آبرومون هم می‌دیم، جسم ناقصمون هم می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.58,
   "end": 442.64,
   "text": "اصلاً همه کارهای ما شمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.64,
   "end": 445.92,
   "text": "ببینید تواضع و خضوع محض و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.92,
   "end": 448.54,
   "text": "اصلاً ریشه‌ای از تکبر و فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.54,
   "end": 451.5,
   "text": "و تبختر شما می‌بینی توش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.5,
   "end": 454.52,
   "text": "تا اینا باید درس باشه برای ما. حالا این جمله رو از امام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.52,
   "end": 457.6,
   "text": "امام ببینید شما تو صحیفشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.6,
   "end": 461.38,
   "text": "من امروز دیدم خیلی جالب بود برام تختی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.38,
   "end": 465.52,
   "text": "که می‌فرماید: \"فرزندم از خودخواهی و خودبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.52,
   "end": 468.58,
   "text": "به در آی.\" خودخواهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.58,
   "end": 472.28,
   "text": "خودبینی \"که این ارث شیطان است.\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.28,
   "end": 482.32,
   "text": "\"که به واسطه خودبینی و خودخواهی از امر خدای تعالی به خضوع برای ولی و صفی او سر باز زد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.32,
   "end": 484.24,
   "text": "به خاطر خودبرتربینی، تکبرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.24,
   "end": 491.18,
   "text": "\"و بدان که تمام گرفتاری‌های بنی‌آدم از این ارث شیطانی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.18,
   "end": 494.72,
   "text": "اصل اصول فتنه است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.72,
   "end": 497.6,
   "text": "عجب! اصل اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.6,
   "end": 500.1,
   "text": "فتنه، ارث شیطان. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.1,
   "end": 502.34,
   "text": "خودبرتربینی، خودبزرگ‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.34,
   "end": 509.0,
   "text": "\"و شاید آیه\"-- امام داره می‌فرماید \"و شاید آیه شریفه وقاتلوهم حتی لا تکون فتنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 509.0,
   "end": 511.38,
   "text": "و یکون الدین دین الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.38,
   "end": 517.08,
   "text": "در بعض مراحل آن اشاره به جهاد اکبر و مقاتله با ریشه فتنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.08,
   "end": 523.56,
   "text": "که شیطان بزرگ و جنود آن که در تمام اعماق قلوب انسان‌ها شاخه و ریشه داره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.56,
   "end": 532.2,
   "text": "دارد باشد و هرکس برای رفع فتنه از درون و برون خویش باید مجاهده نماید و این جهاد است که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.2,
   "end": 535.9,
   "text": "به پیروزی رسید همه چیز و همه کس اصلاح می‌شود.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.9,
   "end": 538.14,
   "text": "یعنی مخ-- یعنی دقیقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.14,
   "end": 542.24,
   "text": "فتنه جایی بلند می‌شه که خودبرتربینی وجود داره، تکبر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.24,
   "end": 545.48,
   "text": "اصلاً دقیقاً ریشه فتنه این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.48,
   "end": 551.52,
   "text": "حالا اون مقام عالی کشور چنین خاضعانه و خاشعانه میاد وسط گود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.52,
   "end": 555.48,
   "text": "در عرصه بین الملل، اون تریبونی که تو کل دنیا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.48,
   "end": 560.34,
   "text": "بوقش پخش می‌شه، فریاد می‌زنه خاشعانه با بغض گلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.34,
   "end": 563.08,
   "text": "که این کشور صاحب شمایی، ما هم هیچ‌کاره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.08,
   "end": 565.46,
   "text": "ما هم یه فدایی به داد برس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.46,
   "end": 572.5,
   "text": "آقا این خیلی-- شما فکر می‌کنید اصلاً در عرصه عمومی و اجتماعی و مردمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.5,
   "end": 577.98,
   "text": "ای کاش بین شما یه دست به قلم تو این روزنامه‌های رسمی بود اینو می‌نوشت می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.98,
   "end": 581.5,
   "text": "همین نکته‌ای که ما داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.5,
   "end": 584.72,
   "text": "که من ندیدم جایی نقل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 584.72,
   "end": 587.96,
   "text": "تو عرصه اجتماعی عمومی شما فکر می‌کنید کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.96,
   "end": 591.88,
   "text": "بساط فتنه جمع شد؟ بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.88,
   "end": 594.62,
   "text": "شکستن شک-- خود شکستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.62,
   "end": 597.22,
   "text": "به واقع و حقیقی رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.22,
   "end": 600.06,
   "text": "بعد هم کشیده شدن قصه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.06,
   "end": 605.32,
   "text": "امام حسین. دیدید من فکر می‌کنم دو روز بعد از قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.32,
   "end": 610.36,
   "text": "اون روز کذایی که روز عاشورا دو روز بعدش بود دیگه نهم دی، سه روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.36,
   "end": 612.06,
   "text": "سه روز بعد نهم دی بوده. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.06,
   "end": 615.66,
   "text": "ببخشید سه روز بعد از عاشورا بوده نهم دی رخ داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.66,
   "end": 618.26,
   "text": "که بعد از تشییع ات امام بز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.26,
   "end": 621.76,
   "text": "خبرگزاری‌های خارجی گفتن بزرگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.76,
   "end": 625.15,
   "text": "مشارکت مردمی بوده در عرصه اجتماعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.15,
   "end": 628.02,
   "text": "چرا؟ چون قصه امام حسین کشیده-- انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.02,
   "end": 632.1,
   "text": "یعنی خدا عقلو ازشون گرفت، شعورو ازشون گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 632.1,
   "end": 634.8,
   "text": "مثل اربعین امسال تا هشتگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.8,
   "end": 638.48,
   "text": "نه به اربعینو زدن قبر خودشونو کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.48,
   "end": 642.04,
   "text": "مردم، مردم ایران من یه چیزی به شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.04,
   "end": 645.8,
   "text": "خ-- فصل الخطاب و براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.8,
   "end": 649.38,
   "text": "یه حالا این حدیث تو کانالم میره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.38,
   "end": 653.0,
   "text": "صحبت ما اما و هرکس، هرکسی درک این چیزا رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.0,
   "end": 656.04,
   "text": "حدیث هم براش داریم. مردم ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.04,
   "end": 657.92,
   "text": "خط قرمزشون اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.92,
   "end": 662.04,
   "text": "بدترین‌هاشون اینطورین. شما ببین حتی بهائیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.04,
   "end": 666.06,
   "text": "عه، ببخشید ارمنی‌ها حتی اهل تسنن اهل بیتو دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.06,
   "end": 672.82,
   "text": "بهشون می‌گن سنی محبی. اصلاً خط قرمز هر کجا بخواد به ساحت اهل بیت جسارت بشه میان وسط گود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.82,
   "end": 676.22,
   "text": "تا قصه به امام حسین کشیده شد، اونطوری ریختن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.22,
   "end": 679.02,
   "text": "درسته؟ مردم بدای امام حسین رو دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.02,
   "end": 681.6,
   "text": "نمی‌تونن اصلاً خونشون-- این یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.6,
   "end": 686.36,
   "text": "واقعاً لطف بزرگ الهی‌ست که به ما کرده، به مردم ایران کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.36,
   "end": 688.58,
   "text": "که اینقدر امنیت درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 688.58,
   "end": 691.02,
   "text": "و یه چیز، یه حدیث به شما بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 691.02,
   "end": 693.6,
   "text": "این حدیث خیلی حدیث عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 693.6,
   "end": 701.14,
   "text": "الان شاید بهتره، شاید جاش الان باشه که می‌فرماید: \"در شب عاشورا حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.14,
   "end": 705.88,
   "text": "ب-برای خاطر امام حسین و عزای امام حسین علیه السلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 705.88,
   "end": 710.92,
   "text": "حیوانات گرد هم جمع می‌شن، اعم از وحشی و اهلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.92,
   "end": 713.26,
   "text": "و در شب عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.26,
   "end": 719.14,
   "text": "به حرمت امام حسین گرد هم‌اند در حالی که به هم تعرضی ندارند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.14,
   "end": 722.52,
   "text": "حالا شما به نظر شما شب عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.52,
   "end": 724.66,
   "text": "گرگ میاد کنار مثلاً مرغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.66,
   "end": 727.16,
   "text": "کنار گوسفند کاری باهاش نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 727.16,
   "end": 729.88,
   "text": "کسی همچین صحنه‌ای تا حالا دیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 729.88,
   "end": 732.84,
   "text": "تازه این همه ما آ-- ما تازه حیوونی می‌کشیم اون شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 732.84,
   "end": 734.56,
   "text": "این همه قربونی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 734.56,
   "end": 738.54,
   "text": "قصه چیه؟ قصه بر می‌گرده به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 738.54,
   "end": 741.48,
   "text": "ماها رو داره می‌گه. چون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 741.48,
   "end": 745.14,
   "text": "ااا، علامه یه روز فرموده بودن که این حیواناتی که می‌بینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 745.14,
   "end": 751.12,
   "text": "گاو و میش و گوسفند و خر و سگ و الاغ و مرغ و این‌ها ملکات نفسانی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 751.12,
   "end": 754.02,
   "text": "شما دارید ملکات درونی خودتون رو می‌بینید بیرونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.02,
   "end": 756.5,
   "text": "باغ وحش در درون خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.5,
   "end": 762.76,
   "text": "اینکه می‌گه به نام عزاداری آقا شب عاشورا د-- گرد هم اهلی و وحشی جمع می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 762.76,
   "end": 766.36,
   "text": "یعنی همه اینایی که حتی از درون هم شبیه سگ و خوک و چی و این‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.36,
   "end": 771.1,
   "text": "دیدی تو عاشورا بدترینام حتی لباس مشکی می‌پوشن میان حتی دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 771.1,
   "end": 774.48,
   "text": "یللی تللی خودشون بعضا تو خیابونا، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 774.48,
   "end": 776.66,
   "text": "اما میان سیاه لشگر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 776.66,
   "end": 779.6,
   "text": "به اسم آقا میان. اون لحظه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.6,
   "end": 783.78,
   "text": "ید واحده می‌شن. به هم تعرض نمی‌کنن، کاری به هم ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.78,
   "end": 786.56,
   "text": "یعنی همون حیوانات اهلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.56,
   "end": 789.04,
   "text": "وحشی گرد هم اومدن به نام امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.04,
   "end": 791.9,
   "text": "این حالا یه تعبیرش رو من عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 791.9,
   "end": 795.1,
   "text": "دوست داشتید پیرامونش مفصل با هم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 795.1,
   "end": 800.32,
   "text": "می‌خواد بگه حتی قصه امام حسین یه کاری می‌کنه وحشی و اهلی کنار هم میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 800.32,
   "end": 802.34,
   "text": "این بود که فتنه جمع شد. اصلاً نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 802.34,
   "end": 810.2,
   "text": "اهل بیت، نام امام عصر، نام ابی عبدالله که بر تارک این کشور می‌درخشه و احدی نمی‌تونه جسارت بهش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 810.2,
   "end": 812.66,
   "text": "همین خواستم، زور زدم که این نکته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 812.66,
   "end": 816.12,
   "text": "برای خودم حدیث نفس بخونم که حواسمون جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 816.12,
   "end": 821.88,
   "text": "این امنیت و این ولایت و این عزت از کجا اومده و افتخار کنیم به رهبر ایران که وقتی نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 821.88,
   "end": 824.96,
   "text": "اهل بیت میاد چنین خاضعانه و خاشعانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 824.96,
   "end": 830.62,
   "text": "سر به زیر می‌اندازه. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 830.62,
   "end": 834.32,
   "text": "یا الله صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 834.32,
   "end": 839.96,
   "text": "محمد آله محمد عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}