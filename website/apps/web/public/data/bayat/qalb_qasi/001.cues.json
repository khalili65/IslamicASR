 "chapters": [
  {
   "index": 0,
   "title": "## استفتای قرض‌الحسنه در بانک ربوی",
   "start": 0.86,
   "end": 95.54
  },
  {
   "index": 1,
   "title": "## دهمین نوع قلب؛ قلب قسی",
   "start": 95.54,
   "end": 130.12
  },
  {
   "index": 2,
   "title": "## دلیل قرآن بر سخت‌تر بودن دل از سنگ",
   "start": 130.12,
   "end": 320.88
  },
  {
   "index": 3,
   "title": "## وما الله بغافل؛ داروی قساوت",
   "start": 320.88,
   "end": 428.73
  },
  {
   "index": 4,
   "title": "## سه نوع سنگ و سیر جمادی تا انسانی",
   "start": 428.73,
   "end": 561.97
  },
  {
   "index": 5,
   "title": "## مصداق امروز؛ سنگ‌دلی در برابر رنج",
   "start": 561.97,
   "end": 625.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 4.36,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 8.0,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.0,
   "end": 12.54,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.54,
   "end": 15.46,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.46,
   "end": 20.18,
   "text": "آیا در بانک‌هایی که برای ما مسجل شده این بانک‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.18,
   "end": 22.9,
   "text": "کارشون کار ربوی‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.9,
   "end": 29.66,
   "text": "حالا وام و قرض و این‌هاشون همه به صورت ربوی یعنی کاری که تو اون بانک صورت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.66,
   "end": 32.12,
   "text": "از نوع حرام و ربا و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.12,
   "end": 35.28,
   "text": "آیا اجازه داریم توی اون بانک‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.28,
   "end": 40.66,
   "text": "که سیستم کاری‌شون این شکلیه ما قرض بدیم به اون بانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.66,
   "end": 43.18,
   "text": "یا از بانک قرض بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.18,
   "end": 45.56,
   "text": "وام نه ها قرض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.56,
   "end": 49.78,
   "text": "قرض‌الحسنه یا بدیم بعضی بانک‌ها هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.78,
   "end": 55.98,
   "text": "قرض‌الحسنه از شما می‌گیرن که مثلاً دعاییشون اینه که خب اینو میدیم به نیازمند قرض میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.98,
   "end": 59.38,
   "text": "با سیستم قرض‌الحسنه. اجازه هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.38,
   "end": 63.22,
   "text": "رهبری فرمودن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.22,
   "end": 69.5,
   "text": "صرفاً قرض‌الحسنه باشه، یعنی شما اون پولی که می‌ذاری واقعاً قرض‌الحسنه بذاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.5,
   "end": 72.66,
   "text": "هیچ سودی نخواهی گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.66,
   "end": 75.5,
   "text": "به تبعش سودی نخوان بهت بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.5,
   "end": 81.8,
   "text": "یا اگرم پولی خودت گرفتی صرفاً قرضی باشه قرض‌الحسنه محض باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.8,
   "end": 86.2,
   "text": "قرض ربوی نباشه که تعریفش رو داره اسلام این اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.2,
   "end": 90.16,
   "text": "ولو سیستم اون بانک دادن ربا و اینجور چیزام باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.16,
   "end": 95.26,
   "text": "اما چون شما قرض میدی و قرض هم می‌گیری اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.26,
   "end": 100.4,
   "text": "خب یکی دیگه از قلب‌ها که دهمین نوع قلب در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.4,
   "end": 105.86,
   "text": "قرآن هست ما دیگه از قلب سلیم که نهمین قلب بود بررسی می‌کردیم گذشتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.86,
   "end": 109.52,
   "text": "نکاتی رو عرض کردیم. به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.52,
   "end": 113.8,
   "text": "عنوان دیگه‌ای از قلب در قرآن رو بحث می‌کنیم درباره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.8,
   "end": 115.42,
   "text": "آیاتش رو مرور می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.42,
   "end": 119.56,
   "text": "ذیلش روایات رو می‌بینیم به نام قلب قسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.56,
   "end": 121.7,
   "text": "با قاف و سه دندونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.7,
   "end": 126.52,
   "text": "قلبی که قساوت گرفته، سخت شده، محکم شده، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.52,
   "end": 131.4,
   "text": "سفت شده. ببینیم آیاتی که پیرامونش اومده در قرآن چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.4,
   "end": 137.42,
   "text": "یکی از ترجمه‌های نوع قلب در قرآن مثلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.42,
   "end": 145.62,
   "text": "آیه هفتاد و چهار سوره بقره این چنین اومده: \"ثم قصد قلوبهم\" \"ثم قصد قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.62,
   "end": 151.92,
   "text": "فرمود که اینا چون آیات قبلش برمی‌گرده به معجزاتی که بنی اسرائیل دیده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.92,
   "end": 156.42,
   "text": "میگه با اینکه اینا این همه معجزه دیدن \"ثم قصد قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.42,
   "end": 160.92,
   "text": "قلوبکم\" خطاب قرار داده ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.92,
   "end": 163.82,
   "text": "که شما با همه این معجزات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.82,
   "end": 166.22,
   "text": "باز همچنان سخت دل شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.22,
   "end": 169.14,
   "text": "\"قصد قلوبکم من بعد ذلك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.14,
   "end": 171.34,
   "text": "بعد از اون همه معجزات \"فهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.34,
   "end": 174.7,
   "text": "کالحجارة\" کأنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.7,
   "end": 178.22,
   "text": "دل‌های شما مثل سنگه \"کالحجارة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.22,
   "end": 182.32,
   "text": "تعبیر قرآن این چنین است \"أو أشد قسوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.32,
   "end": 186.26,
   "text": "أشد قسوة\" بلکه شدیدتر از سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.26,
   "end": 190.86,
   "text": "بعضیا دیگه دل سنگ‌تر از سنگ میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.86,
   "end": 193.84,
   "text": "عجیبه تعبیر قرآن. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.84,
   "end": 196.3,
   "text": "حالا قرآن این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.3,
   "end": 199.76,
   "text": "برای خودش، برای بیان خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.76,
   "end": 202.52,
   "text": "اه شاهد میاره یا دلیل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.52,
   "end": 208.32,
   "text": "مثل اینکه ما نقد می‌کنیم بی‌اساس نقد می‌کنیم، دلیل و شاهدی نداریم فقط یه چیزی شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.32,
   "end": 213.24,
   "text": "اما قرآن میگه ما دلیل داریم براش میگیم از سنگ سفت‌تره دل شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.24,
   "end": 217.12,
   "text": "چرا؟ می‌فرماید \"وإن من الحجارة لما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.12,
   "end": 219.12,
   "text": "يتفجر منه الأنهار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.12,
   "end": 223.64,
   "text": "بعضی از سنگ‌ها هستن که آب می‌جوشه ازشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.64,
   "end": 228.88,
   "text": "اما دل شما انقدر سخت شده، سفت شده، هیچ جوششی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.88,
   "end": 232.44,
   "text": "بعد می‌فرماید \"وإن منها لما يشقق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.44,
   "end": 236.76,
   "text": "فيخرج منه الماء\" تازه بعضی از سنگ‌ها هستن که اصلاً متلاشی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.76,
   "end": 239.52,
   "text": "\"يشقق\" اینا اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.52,
   "end": 243.54,
   "text": "می‌ترکن، پخش میشن، تیکه تیکه میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.54,
   "end": 246.8,
   "text": "باز ازشون آب می‌زنه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.8,
   "end": 248.94,
   "text": "ولی شما اصلاً دلتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.94,
   "end": 250.74,
   "text": "این به این راه‌ها نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.74,
   "end": 254.26,
   "text": "\"وإن\" تازه خیلی جالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.26,
   "end": 259.48,
   "text": "نوع بعدی رو می‌فرماید \"وإن منها لما يهبط من خشية الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.48,
   "end": 263.24,
   "text": "از این سنگ‌هایی که ما داریم مثال می‌زنیم یه نوعش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.24,
   "end": 265.54,
   "text": "به شما میگیم که این سنگ‌ها چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.54,
   "end": 267.78,
   "text": "\"يهبط\" می‌افتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.78,
   "end": 273.5,
   "text": "\"من خشية الله\" از ترس خدا، از خشیت خدا که حالا تو ب- قلب خاشع ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.5,
   "end": 276.26,
   "text": "فرق خشیت رو با خوف گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.26,
   "end": 278.72,
   "text": "از خشیت خدا می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.72,
   "end": 282.66,
   "text": "یعنی این سنگ‌هایی که ما به ظاهر می‌بینیم از کوه افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.66,
   "end": 286.66,
   "text": "یهو کوه منفجر شد یا زلزله اومد سنگ افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.66,
   "end": 290.46,
   "text": "ظاهراً قصه طبیعت است و دگرگونی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.46,
   "end": 294.44,
   "text": "زمین و مثلاً آتشفشان و زلزله و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.44,
   "end": 299.98,
   "text": "اما حقیقت باطنش قرآن داره می‌فرماید \"يهبط من خشية الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.98,
   "end": 305.42,
   "text": "این سنگ‌هایی که میفتن از خشیت خدا میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.42,
   "end": 311.74,
   "text": "با این حال میگه که شما دلتون اصلاً به سمت خدا سجود و کرنش و افتاده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.74,
   "end": 318.08,
   "text": "پس برای همین می‌فرماید \"أو أشد قسوة\" بلکه سخت‌تر است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.08,
   "end": 320.88,
   "text": "سنگ دل‌های شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.88,
   "end": 324.2,
   "text": "و آخرش یه خطاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.2,
   "end": 334.38,
   "text": "خیلی خطرناکی خدا داره که \"وم الله بغافل مما تعملون\" خدا غافل نیست از اونچه که شما عمل می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.38,
   "end": 340.06,
   "text": "که حالا مفسرین بعضی مثلاً قراعی در تفسیر سوره نورش این رو داروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.06,
   "end": 342.7,
   "text": "سخت‌دلی و قساوت قلب معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.7,
   "end": 345.16,
   "text": "می‌فرماید اینکه خدا آخرش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.16,
   "end": 348.32,
   "text": "\"وم الله بغافل مما تعملون\" خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.32,
   "end": 354.8,
   "text": "درسته تشر زده به قول آقای مکارم دیدم تفسیرشون می‌فرماید این تشر خیلی جدی و خطرناک خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.8,
   "end": 357.72,
   "text": "برای هر کسی که مثل بنی‌اس- بنی‌اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.72,
   "end": 360.58,
   "text": "بهانه بگیره، معجزات رو ببینه، ایمان نیاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.58,
   "end": 365.01,
   "text": "دلش سنگ بشه. اما آقای قراعی می‌فرماید اتفاقاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.01,
   "end": 371.71,
   "text": "یک دلیل یعنی خدا انتهای آیه با یک لطائف الیگلی داره داروی قساوت قلب رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.71,
   "end": 373.73,
   "text": "می‌فرماید داروی قساوت قلب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.73,
   "end": 378.47,
   "text": "توجه به علم خدا. این که بدونی \"وما الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.47,
   "end": 381.99,
   "text": "خدا این چنین نیست. چی؟ \"بغافل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.99,
   "end": 387.29,
   "text": "غافل نیست. \"اما تعملون\" به اونچه که شما عمل می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.29,
   "end": 393.21,
   "text": "تو surah عرض کنم فکر کنم هفتاد و یک اسرا باشه حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.21,
   "end": 398.19,
   "text": "شک از منه که \"فسیر الله عملکم و رسوله والمؤمنون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.19,
   "end": 405.75,
   "text": "قبلاً بحث کردیم که پس قطعاً خدا و پیغمبر و مؤمنون که اهل بیت‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.75,
   "end": 407.73,
   "text": "آن به آن عمل شما رو می‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.73,
   "end": 410.99,
   "text": "\"فسیر الله\". \"یر الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.99,
   "end": 414.11,
   "text": "می‌بینند نه اینکه بدانند‌ ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.11,
   "end": 416.93,
   "text": "اون دیگه خیلی بالاتر از دانستن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.93,
   "end": 420.35,
   "text": "دیدن است. وقتی انسان اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.35,
   "end": 423.13,
   "text": "متوجه قصه شد خیلی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.13,
   "end": 426.59,
   "text": "مراقب میشه کاری نکنه که س-- دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.59,
   "end": 428.39,
   "text": "به سمت این چنین قساوت بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.39,
   "end": 433.19,
   "text": "حالا انواع سنگ رو اگه شما دقت کرده باشید تو همین آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.19,
   "end": 437.59,
   "text": "به نظر سه نوع سنگ رو خدا بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.59,
   "end": 443.05,
   "text": "یه نوع سنگی که ازش آب می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.05,
   "end": 445.13,
   "text": "اممم ازش آب بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.13,
   "end": 448.11,
   "text": "جوشش حالا یا خودش متلاشی میشه و از زیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.11,
   "end": 449.97,
   "text": "بالاخره آب می‌جوشه ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.97,
   "end": 453.01,
   "text": "یه خیری از این سنگ سر می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.01,
   "end": 455.99,
   "text": "که متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.99,
   "end": 461.61,
   "text": "قلب امثال من که سخت شده، سفت شده هیچ خیری انگار ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.61,
   "end": 467.33,
   "text": "هیچ جوششی نداره. نوع دوم خیلی جالبه که میگه افتادن این سنگ‌ها از رو خشیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.33,
   "end": 470.03,
   "text": "یعنی سجود دارن در برابر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.03,
   "end": 472.55,
   "text": "خشیت در دلشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.55,
   "end": 474.57,
   "text": "در دل این سنگ‌ها خشیت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.57,
   "end": 478.45,
   "text": "کسی که دلش خالی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.45,
   "end": 483.33,
   "text": "خشیت خداست از سنگ هم پست‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.33,
   "end": 486.73,
   "text": "و نوع سوم فرمود همون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.73,
   "end": 489.81,
   "text": "تکوینی که در سنگ‌ها وجود داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.81,
   "end": 492.39,
   "text": "\"یسبح لله ما في السماوات وما...\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.39,
   "end": 496.03,
   "text": "یعنی نه فقط خشیت دارن میگه \"یهبط\" می‌افتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.03,
   "end": 498.21,
   "text": "یعنی شاید این افتادنشون ذکرشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.21,
   "end": 501.67,
   "text": "نمی‌دونیم. اما در هر حال در حال تسبیح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.67,
   "end": 505.61,
   "text": "اما دل ما هیچ تسبیحی نداره، هیچ خروجی‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.61,
   "end": 511.59,
   "text": "ببینید این یکی از آیاتیه که حالا من فقط ترجمه ظاهری کردم هنوز ورود به بحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.59,
   "end": 514.33,
   "text": "بررسی تفاسیر و نکات شارحی نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.33,
   "end": 517.49,
   "text": "انشاالله روزهای بعد چند آیه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.49,
   "end": 521.63,
   "text": "ما فقط به ظاهر آیه بسنده کردیم، توجه کردیم دیدیم عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.63,
   "end": 526.51,
   "text": "چه اسراری در این عالم هست و چه سیری رو ما باید طی کنیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.51,
   "end": 529.21,
   "text": "جمادی به نباتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.21,
   "end": 531.89,
   "text": "به حیوانی و انسانی این سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.89,
   "end": 536.93,
   "text": "زندگی باید سیر کنیم به انسانیت برسیم و ما تو همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.93,
   "end": 544.13,
   "text": "متاسفانه جمادیش که سنگ زندگی کردن سنگی یا بدتر از سنگ موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.13,
   "end": 546.83,
   "text": "چرا؟ چون دل قساوت پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.83,
   "end": 549.77,
   "text": "حالا اینا مصداق‌هاشو باید پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.77,
   "end": 554.75,
   "text": "مثال‌هایی که خدا می‌زنه ممثل داره، ممثل‌هاشو باید پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.75,
   "end": 559.33,
   "text": "و مراقب بود که خدا نکرد ما دلمون به اون حالت نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.33,
   "end": 561.97,
   "text": "که الان بعضیا واقعاً اینطوری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.97,
   "end": 565.51,
   "text": "بچه‌های یمن دارن از گرسنگی می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.51,
   "end": 571.07,
   "text": "بچه مثلاً هشت نه ساله می‌بینی ده کیلو دوازده کیلو وزنشه می‌میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.07,
   "end": 574.57,
   "text": "از گرسنگی. اصلاً عین خیالش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.57,
   "end": 576.29,
   "text": "اصلاً ککش هم نمی‌گیرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.29,
   "end": 580.93,
   "text": "تازه اعتراض هم داره که چرا صندوق کمک به یمن دارید می‌ذارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.93,
   "end": 583.83,
   "text": "و مگه تو مملکت خودمون فقیر نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.83,
   "end": 587.11,
   "text": "خیر بسم الله اگه راست میگی تو همین مملکت خودمون کمک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.11,
   "end": 590.95,
   "text": "چرا کمک نمی‌کنی؟ چرا عید که می‌شه میلیاردها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.95,
   "end": 598.77,
   "text": "دلار صرف کشورهای اروپایی و خارجی و یللی تللی و عشق و عشق و عیش و نوشتون می‌شه هیچی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.77,
   "end": 602.19,
   "text": "ولی تا اربعین می‌شه پولا رو سرازیر کنین برای فقرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.19,
   "end": 605.07,
   "text": "اینطوری بحث می‌شه. اصلاً عین خیال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 605.07,
   "end": 610.31,
   "text": "سنگ شده چنان دل‌ها که هیچ با هیچ چیزی تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.31,
   "end": 615.33,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.33,
   "end": 619.13,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.13,
   "end": 625.33,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}