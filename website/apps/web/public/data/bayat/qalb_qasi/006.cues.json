 },
 "chapters": [
  {
   "index": 0,
   "title": "## وام بانکی؛ فقط در ظرف عقود صحیح",
   "start": 12.84,
   "end": 46.66
  },
  {
   "index": 1,
   "title": "## قلب قسی و نقض میثاق",
   "start": 46.66,
   "end": 416.29
  },
  {
   "index": 2,
   "title": "## رأفت امام و شدت عقوبت",
   "start": 416.29,
   "end": 436.33
  },
  {
   "index": 3,
   "title": "## جمع جلسه",
   "start": 436.33,
   "end": 617.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 4.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.7,
   "end": 8.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 12.54,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.54,
   "end": 16.12,
   "text": "یه موضوع کلی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.12,
   "end": 24.68,
   "text": "قصه وام‌های بانکی رو عرض کنم که همه مراجع متفق القولن سر این حکم که هر وامی که شما می‌گیرید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.68,
   "end": 29.18,
   "text": "مؤسسات و بانک‌ها و این‌ها باید در قالب یک قرارداد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.18,
   "end": 31.94,
   "text": "اون قرارداد از عقود اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.94,
   "end": 38.28,
   "text": "که صحیح باشه. قرض رو کاری ندارم که هیچ قرض که هیچ سودی هم بهش تعلق نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.28,
   "end": 41.7,
   "text": "اما این وام‌هایی که خب یه بخش، یه درصدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.7,
   "end": 49.36,
   "text": "سود بهش تعلق می‌گیره و شما مکلفید این سودو برگردونید فقط در صورتی ربا نیست که در قالب اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.36,
   "end": 53.8,
   "text": "عقود اسلامی که تو بانک تنظیم شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.8,
   "end": 65.28,
   "text": "در غیر این صورت اصلاً ما چیزی به عنوان وام نداریم در اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.28,
   "end": 67.6,
   "text": "بله. اینم که ااا اینجا داره میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.6,
   "end": 69.36,
   "text": "بله من پرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.36,
   "end": 74.94,
   "text": "اون‌ها هم در قالب یه قراردادیه که شما وقتی داری می‌گیری اون رو میری امضا می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.94,
   "end": 77.26,
   "text": "حالا باید زرنگ باشی اونو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.26,
   "end": 83.28,
   "text": "یک قراردادی که حالا عقود اسلامی مثل جعاله و مشارکت و مضاربه و نمی‌دونم این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.28,
   "end": 89.08,
   "text": "باید شما بخونید ببینید مفادش چیه که البته این‌ها معمولاً چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.08,
   "end": 92.04,
   "text": "بله شما باید رعایت و اون هم ملزمه که رعایت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.04,
   "end": 96.48,
   "text": "یعنی همینطوری نمی‌تونه بانک به شما وام بده، انقدرم سود بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.48,
   "end": 99.1,
   "text": "باید در قالب یه قراردادی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.1,
   "end": 103.86,
   "text": "فروش مش-- مثلاً مشارکت باشه، فروش نمی‌دونم تسهیلاتش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.86,
   "end": 107.62,
   "text": "نمی‌دونم این چیزها که حالا مفصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.62,
   "end": 111.44,
   "text": "و از حوصله این فرصت کم ما بیرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.44,
   "end": 116.52,
   "text": "در خصوص قلب قسی یه آیه دیگه از قرآن هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.52,
   "end": 118.34,
   "text": "خیلی این آیه تکان دهندس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.34,
   "end": 122.82,
   "text": "آیه سیزده سوره مائده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.82,
   "end": 128.26,
   "text": "می‌فرماید که «فبما نقضهم ميثاقهم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.26,
   "end": 132.16,
   "text": "وقتی که این‌ها یعنی بنی‌اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.16,
   "end": 137.2,
   "text": "عهدشون و پیمانشون رو شکستن، نقض پیمان کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.2,
   "end": 139.28,
   "text": "خدا می‌فرماید «لعناهم».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.28,
   "end": 144.46,
   "text": "الله اکبر. خدا می‌فرماید ما اون‌ها رو از رحمت خودمون دورشون کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.46,
   "end": 147.5,
   "text": "یعنی لعن‌شون کردیم. مورد لعن ما واقع شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.5,
   "end": 150.96,
   "text": "«وجعلنا قلوبهم قاسية»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.96,
   "end": 154.1,
   "text": "و دلا اینا رو مثل سنگ سخت کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.1,
   "end": 157.62,
   "text": "سفت کردیم. بعد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.62,
   "end": 159.32,
   "text": "این تا همینجا تموم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.32,
   "end": 165.34,
   "text": "آیه می‌فرماید «يحرفون الكلم عن مواضعه» اینا تف-- تحریف ایجاد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.34,
   "end": 171.36,
   "text": "یا تحریف ایجاد می‌کنن و این چون فعل مضارع هم هست که الان این کار ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.36,
   "end": 173.6,
   "text": "از اینکه اینا دلشون سنگ شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.6,
   "end": 179.0,
   "text": "مشغول به تحریف فرهنگی و محتوایی میشن، دین رو تحریف می‌کنن و که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.0,
   "end": 182.6,
   "text": "قصه داره. «ونسو حذا من ذکر به»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.6,
   "end": 185.68,
   "text": "بعد اون عهدشونو فراموش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.68,
   "end": 189.6,
   "text": "حالا می‌تونه برگرده به کتاب آسمانی‌شون تورات یا هر چیز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.6,
   "end": 191.68,
   "text": "فراموش کردن اون چیزی که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.68,
   "end": 196.0,
   "text": "متوجهش می‌بودن. که البته این فراموشی قطعاً از نوع عمدیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.0,
   "end": 198.94,
   "text": "نه سهوی. سهوی که اشکال نداره آدم یه چیزی رو فراموش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.94,
   "end": 200.9,
   "text": "«ولا تزال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.9,
   "end": 205.06,
   "text": "تطلع على خائنة» و تو دائما مطلعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.06,
   "end": 208.18,
   "text": "«لا تزال» دائماً خبر داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.18,
   "end": 212.74,
   "text": "«تطلع» اطلاع داری. «على خائنة منهم» از خیانت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.74,
   "end": 215.44,
   "text": "«الا قليلا منهم» مگر یه عده کمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.44,
   "end": 217.42,
   "text": "یعنی اکثرشون اینا خیانتکارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.42,
   "end": 220.22,
   "text": "«فاعفو عنهم» ببخششون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.22,
   "end": 224.14,
   "text": "«واصفح» مثل صفحه کاغذ که ورق می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.14,
   "end": 227.64,
   "text": "میگه ندید بگیر. ب-بگو این صفحه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.64,
   "end": 231.68,
   "text": "ورق بزن برو. «إن الله يحب المحسنين».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.68,
   "end": 236.22,
   "text": "حالا این بحث قلب قاسية و قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.22,
   "end": 239.36,
   "text": "قس-- که دچار قساوت شده اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.36,
   "end": 242.4,
   "text": "در پس یک نقض پیمان معرفی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.4,
   "end": 246.94,
   "text": "جالبه که این سوره رو اگر شما کلشو بررسی کنی، سوره مائده، می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.94,
   "end": 250.92,
   "text": "اولین آیه این سوره اصلاً پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.92,
   "end": 253.28,
   "text": "وفای به عقد و پیمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.28,
   "end": 255.88,
   "text": "می‌فرماید «أوفوا بالعقود»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.88,
   "end": 260.26,
   "text": "آیه اول. آیه دوازده‌ش می‌فرماید «ولقد أخذ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.26,
   "end": 265.4,
   "text": "أخذ الله ميثاق بني إسرائيل» باز بحث میثاق رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.4,
   "end": 269.98,
   "text": "آیه سیزده که همینجاست می‌فرماید «فبما نقضهم ميثاقهم» اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.98,
   "end": 276.96,
   "text": "نقض پیمان کردن. آیه چهارده دوباره می‌فرماید «ومن الذين قالوا إنا نصارى أخذنا ميثاقهم».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.96,
   "end": 279.42,
   "text": "هی تکرار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.42,
   "end": 284.04,
   "text": "قصه میثاق و عهد رو که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.04,
   "end": 286.9,
   "text": "نقض پیمان بده، چقدر زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.9,
   "end": 291.08,
   "text": "شما می‌دونید عهدشکنی و نقض پیمان کفاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.08,
   "end": 294.7,
   "text": "اینجوری نیست که حالا طرف پشیمون بشه تو توبه بگه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.7,
   "end": 301.58,
   "text": "خدایا ما رو ببخش و این عهد هر چقدر که کسی که باهاش عهد بستگی ترازش بالاتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.58,
   "end": 305.52,
   "text": "گناهش سنگین تره. اینکه ما مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.52,
   "end": 307.76,
   "text": "با خدا گاهی اوقات عهد می‌بندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.76,
   "end": 311.72,
   "text": "خدایا اگر این بشه من دیگه گناه نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.72,
   "end": 314.1,
   "text": "ها؟ بعد دوباره گناه رو تکرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.1,
   "end": 317.46,
   "text": "اگه به من پول بدی این کار خیر رو انجام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.46,
   "end": 319.58,
   "text": "پول میده، اون کار خیر صورت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.58,
   "end": 324.2,
   "text": "عهدشکنیه. اگه به من خونه بزرگ بدی برای امام حسین هیئت می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.2,
   "end": 326.04,
   "text": "میده هیچ خبری از هیئت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.04,
   "end": 328.84,
   "text": "و، و، و خیلی عهدشکنی‌ها ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.84,
   "end": 334.76,
   "text": "و این چون طرف حساب ما اینجور جاها خدا و اهل بیتن خیلی اتفاقاً خطرناک‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.76,
   "end": 340.7,
   "text": "خیلی سنگین تره. خدا رحمت کنه شهید دستغیب رو در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.7,
   "end": 345.22,
   "text": "داستان‌های شگفتش صفحه دویست شصت و دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.22,
   "end": 348.66,
   "text": "به قول علامه شیخ محمد حسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.66,
   "end": 351.98,
   "text": "مولوی قندهاری بزرگ رحمة الله عليه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.98,
   "end": 357.4,
   "text": "یه داستانی نقل می‌کنه که ایشون یعنی علامه قندهاری میگه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.4,
   "end": 360.48,
   "text": "در پای وعظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.48,
   "end": 362.69,
   "text": "نصیرالاسلام بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.69,
   "end": 366.73,
   "text": "ابوالواعظنگ که معروف بود در مسجد گوهرشاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.73,
   "end": 371.29,
   "text": "مشهد ماه ر-- مبارک رمضان می‌رفت مثلا سی شب منبر می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.29,
   "end": 379.45,
   "text": "میگه من پ-- از ایشون شنیدم که خودش بالا منبر تو مسجد گوهرشاد مشهد رضا انشاالله به زودی قسمتشو بریم با معرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.45,
   "end": 385.53,
   "text": "داشت یکی از کراماتی که خودش تو حرم دیده بود رو نقل می‌کرد این عالم بزرگوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.53,
   "end": 388.35,
   "text": "که می‌گفت یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.35,
   "end": 393.37,
   "text": "ز-زنی که حالا دو تا خ-خانم بودند هر دو تا سید حسینی بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.37,
   "end": 396.35,
   "text": "در عقد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.35,
   "end": 399.95,
   "text": "نکاح یک، یکی از اعیان تهران بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.95,
   "end": 404.73,
   "text": "و این دو به هم قول دادند که هیچوقت خیانت نکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.73,
   "end": 407.99,
   "text": "نرن پیش شوهرشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.99,
   "end": 410.69,
   "text": "خیانت کنن، نمامی کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.69,
   "end": 413.35,
   "text": "مثلا فتنه گری کنن، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.35,
   "end": 415.45,
   "text": "هوگری رو بذارن کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.45,
   "end": 423.31,
   "text": "بعد گفته بودند امام رضا ضامن باشه بین ما شاهد باشه اگر کسی نقض پیمان کرد امام رضا کورش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.31,
   "end": 425.87,
   "text": "یعنی قشنگ طرف حسابشونم کرده بودند کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.87,
   "end": 429.69,
   "text": "امام رضا. خب حالا خیلی دیگه جدی می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.69,
   "end": 432.87,
   "text": "بعد می‌گفتش که یکی از اینا نقض پیمان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.87,
   "end": 435.43,
   "text": "میره پیش شوهر و خیانت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.43,
   "end": 439.67,
   "text": "و چغولی می‌کنه و خلاصه تو همون هفته کور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.67,
   "end": 442.01,
   "text": "بعد توبه می‌کنه ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.01,
   "end": 444.93,
   "text": "میگه حالا بریم از خود حضرت شفا بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.93,
   "end": 450.73,
   "text": "میاد خب یکی از-- همسر یکی از اعیان تهران و وضعش خوب بوده میره چهل شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.73,
   "end": 456.01,
   "text": "بالا سر آقا علی بن موسی الرضا علیه ما صلوة الله السلام خلوت می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.01,
   "end": 460.81,
   "text": "دخیل می‌بنده و اتفاقا همین س-- عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.81,
   "end": 463.01,
   "text": "نصيرالاسلام هم مو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.01,
   "end": 467.49,
   "text": "عرض کنم اون شب‌ها تا صبح براش عین چهل شب روضه می‌خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.49,
   "end": 470.57,
   "text": "بعضی از علما و سادات هم جمع می‌شدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.57,
   "end": 473.21,
   "text": "اونجا تا صبح خلاصه گریه و زاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.21,
   "end": 476.51,
   "text": "چهل روز گذشت خبری نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.51,
   "end": 479.93,
   "text": "صبح علی طلوع چهل و یکم دیگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.93,
   "end": 482.57,
   "text": "میگه زیارت وداع خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.57,
   "end": 484.51,
   "text": "مایوسانه اومدیم برگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.51,
   "end": 486.93,
   "text": "همه دیدن که یک نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.93,
   "end": 490.29,
   "text": "از حرم آقا از ضریح آقا بیرون اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.29,
   "end": 494.35,
   "text": "و اومد سمت مردم و اومد بالا سر، از بالا سر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.35,
   "end": 498.95,
   "text": "زن رد شد. همه صلوات فرستادن فکر کردن دیگه شفا گرفت این زن تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.95,
   "end": 501.19,
   "text": "دیدیم این نور رفت. همه هم دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.19,
   "end": 503.83,
   "text": "رفت از پنجره وارد شد رفت تو دارالسیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.83,
   "end": 505.85,
   "text": "اونجا صدای صلوات بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.85,
   "end": 508.51,
   "text": "دویدیم رفتیم دیدیم یه پیرمرد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.51,
   "end": 513.51,
   "text": "پیرزن زابلی که خیلی سال نابینا بوده شفا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 513.51,
   "end": 516.35,
   "text": "چشاش خوب شده. اتفاقا اصلا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 516.35,
   "end": 521.17,
   "text": "خودش می‌گفته که مثلا من، من دخیل نبستم، اصلا توسلی هم برای چشام نکرده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.17,
   "end": 525.39,
   "text": "اومده بودم زیارت. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.39,
   "end": 527.47,
   "text": "یعنی یه نقض پیمان بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.47,
   "end": 533.73,
   "text": "ایشون اینطوری نتیجه می‌گیره که اینطور نیست که به همین راحتی نقض پیمان با امام معصوم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.73,
   "end": 536.33,
   "text": "بعد به راحتی هم بخواهیم توبه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.33,
   "end": 539.93,
   "text": "حالا اولا توبه مراتب داره در درون طرف رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.93,
   "end": 542.33,
   "text": "ما نمی‌تونیم بگیم که توبه‌ش قبول شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.33,
   "end": 544.65,
   "text": "چرا امام رضا شفاش نداده، یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.65,
   "end": 550.43,
   "text": "دوما اینکه اگر واقعا توبه کرده باشه باید بره از همسرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.43,
   "end": 552.69,
   "text": "یا هوی خودش رضایت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.69,
   "end": 555.77,
   "text": "خیانت کرده. ث Buما کفاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.77,
   "end": 559.27,
   "text": "یک بنده آزاد کردن یا شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.27,
   "end": 563.59,
   "text": "فقیر رو اطعام کردن یا شصت روز روزه گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 563.59,
   "end": 565.25,
   "text": "کفاره‌ی نقض پیمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 565.25,
   "end": 568.23,
   "text": "چیز کمی نیست. اینا رو باید انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.23,
   "end": 570.87,
   "text": "ضمن اینکه این خودش یک حجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.87,
   "end": 573.27,
   "text": "امام رضا درسته امام الرهوفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.27,
   "end": 579.71,
   "text": "شاید خواسته حجت تمام کنه بر امثال ماها که حواستون جمع باشه اگر خدا ارحم الراحمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.71,
   "end": 583.33,
   "text": "فی موضع العفو والرحمه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.33,
   "end": 588.17,
   "text": "همون خدا اشد المعاقبین فی موضع النکال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.17,
   "end": 590.57,
   "text": "النقمم هم هست. نقمه‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 590.57,
   "end": 592.45,
   "text": "و حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.45,
   "end": 598.65,
   "text": "عهد امامت شکستن، عهد نبوت شکستن، عهد ولایت شس-شکستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.65,
   "end": 602.75,
   "text": "خیلی سنگینه. خلاصه ختم کلام اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.75,
   "end": 611.51,
   "text": "صراحتا قرآن می‌فرماید چون این‌ها نقض پیمان کردند، از رحمت من دور شدند و ما این‌ها رو دچار قسابت قلب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.51,
   "end": 617.09,
   "text": "ان شا الله که عاقبت ما ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}