 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.68,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 7.52,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.52,
   "end": 11.6,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 14.86,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.86,
   "end": 18.62,
   "text": "آیا جای نجس رو میشه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.62,
   "end": 21.06,
   "text": "دستمال مرطوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.06,
   "end": 24.24,
   "text": "سه بار بکشیم روش و پاک بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.24,
   "end": 32.22,
   "text": "آقا فرمودن که در صورتی که آب جاری نشه از دستمال آب به گونه‌ای نباشه که جاری بشه رو محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.22,
   "end": 36.02,
   "text": "نجس شده، نه نمی‌شه. خب یه بار که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.02,
   "end": 39.44,
   "text": "عین نجاست برطرف شه، دو بارم آب جاری بشه روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.44,
   "end": 46.7,
   "text": "باید آب از اون دستمال انقدر جوری باشه که جاری بشه رو محل نجاست نه با رطوبت دستمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.7,
   "end": 52.5,
   "text": "جا پاک بشه. خب ما امروز دیگه بحث به فضل الهی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.5,
   "end": 56.42,
   "text": "قلب قسی رو جمع کنیم به جهت که آیاتش تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.42,
   "end": 60.46,
   "text": "ما اگر بخوایم به روایات هم ذیل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.46,
   "end": 63.0,
   "text": "قصه بپردازیم که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.0,
   "end": 66.3,
   "text": "تا آخر سال باید فقط تو اینجا باقی بمونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.3,
   "end": 73.72,
   "text": "تو این مبحث. خیلی گذرا فقط عناوینشو بگم دیگه هر کی دوست داره میره روایات رو بررسی می‌کنه که عوامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.72,
   "end": 78.08,
   "text": "سنگدلی در روایات رو هم یه نگاهی کرده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.08,
   "end": 84.66,
   "text": "که اولاً فرمودن فزونی گناهان که روایتشم یه بار فرمودی-- عرض کردیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.66,
   "end": 87.78,
   "text": "فرمایش امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.78,
   "end": 90.98,
   "text": "که حضرت فرمودن که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.98,
   "end": 94.64,
   "text": "چشم خشک می‌شه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.64,
   "end": 96.94,
   "text": "چیه؟ کثرت گناهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.94,
   "end": 99.62,
   "text": "خشکی چشمم به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.62,
   "end": 103.0,
   "text": "قسابت قلبه. اینو قبلاً روایتشو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.0,
   "end": 107.6,
   "text": "دوم فرمودن پرحرفی در غیر از یاد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.6,
   "end": 111.12,
   "text": "گاهی اوقات ما عادت می‌کنیم همش حرف بزنیم، همش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.12,
   "end": 113.9,
   "text": "به هم که می‌رسیم اصلاً سکوت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.9,
   "end": 116.44,
   "text": "از سر جان همدیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.44,
   "end": 118.94,
   "text": "نه خبری داریم نه بهره‌ای می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.94,
   "end": 122.38,
   "text": "همش می‌خوایم حرف بزنیم. خیلی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.38,
   "end": 128.66,
   "text": "من سراغ داشته‌م و دارم آدمایی که به هم می‌رسن از سکوت هم استفاده می‌کنند، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.66,
   "end": 131.48,
   "text": "درون سر درون خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.48,
   "end": 133.9,
   "text": "حالا بحثی داره که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.9,
   "end": 137.44,
   "text": "از حضرت عیسی مثلاً در کتاب نصیب حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.44,
   "end": 140.34,
   "text": "جلد هشت صفحه سی و هشت روایتی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.34,
   "end": 148.88,
   "text": "حضرت فرمودن بدون ذکر خدا زیاد حرف نزنید که موجب قسابت قلب است و قلب چنین انسانی از خدا دور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.88,
   "end": 151.72,
   "text": "اگه ذکر و یاد خدا باشه چرا تا می‌تونید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.72,
   "end": 157.16,
   "text": "خدا با هم حرف بزنید. از من-- مظاهر خدا با هم حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.16,
   "end": 161.56,
   "text": "سوم فرمودن سخنان بیهوده شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.56,
   "end": 164.92,
   "text": "اون زیاد حرف زدن بود این شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.92,
   "end": 168.1,
   "text": "میگه حتی شنیدن حرفای بیخودی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.1,
   "end": 174.18,
   "text": "باعث می‌شه که قلبت بمیره. وقت انسان ارزش داره اینطور که نباید وقتو تلف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.18,
   "end": 176.56,
   "text": "چهارم شکار کردن حیوونا‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.56,
   "end": 179.72,
   "text": "مثلاً قصابی چرا کراهت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.72,
   "end": 183.88,
   "text": "به خاطر اینکه انقدر لاشه می‌بینه، انقدر گوسفند می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.88,
   "end": 187.72,
   "text": "که دیگه چی می‌شه؟ یواش یواش دل قسی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.72,
   "end": 191.84,
   "text": "پنجم فرمودن رفت و آمد به دربار سلاطین و حاکمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.84,
   "end": 195.2,
   "text": "خب الان که سلطان و حاکم به اون معنا خیلی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.2,
   "end": 198.24,
   "text": "می‌تونه مثلاً شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.24,
   "end": 202.48,
   "text": "مدیران و مسئولان آنچنانی البته دیگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.48,
   "end": 207.2,
   "text": "صفات پادشاهی به خودشون گرفتن و تبختر و تکبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.2,
   "end": 213.48,
   "text": "که متأسفانه. میگه اونجاها نرید که انگیزه‌تون الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.48,
   "end": 215.94,
   "text": "شر-- مشرک گونه می‌رید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.94,
   "end": 220.12,
   "text": "قلب به قسابت میفته. شش، مال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.12,
   "end": 222.72,
   "text": "ثروت فراوان، زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.72,
   "end": 225.96,
   "text": "مثل سلطان سکه که اون که دیگه هیچی، اون اصلاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.96,
   "end": 228.3,
   "text": "اصلاً افسانه بود اصلاً واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.3,
   "end": 232.38,
   "text": "هرکی زیاد، زیادتر از کفافش داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.38,
   "end": 235.18,
   "text": "هفتم نگاه کردن به چهره انسان بخیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.18,
   "end": 239.46,
   "text": "خیلی عجیبه. آدمی که بخیله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.46,
   "end": 243.36,
   "text": "همش هرچی جمع کرده برای خودش به هدیه هم نمیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.36,
   "end": 247.0,
   "text": "میگه اصلاً نگاش نکن. انقدر از چشم خدا افتاده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.0,
   "end": 252.52,
   "text": "عجیبه. هشتم فرمود لجاجت و عناد ورزیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.52,
   "end": 254.26,
   "text": "بعضیا عنودن، لجوجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.26,
   "end": 257.38,
   "text": "هرچی میگی نرود می‌خواهند این در سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.38,
   "end": 264.74,
   "text": "رو حرف خودش وایساده. نهم فرمود نقض عهد و پیمان که این بحثش یه روز گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.74,
   "end": 266.94,
   "text": "کسی که عهد و پیمانشو بشکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.94,
   "end": 270.78,
   "text": "بی‌معرفت‌ه، بهش میگن بی‌مرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.78,
   "end": 273.52,
   "text": "دهم عادت به پرخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.52,
   "end": 277.82,
   "text": "بعضیا اصلاً عادت دارن. حالا یه وقتی یه کسی خیلی یه روز گشنه شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.82,
   "end": 283.9,
   "text": "مثلاً یه دفعه گاهی اوقات دیدی یه حسی به آدم دست می‌ده خیلی گرسنه‌ست، اون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.9,
   "end": 286.96,
   "text": "اما اینکه همش بخوره، پرخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.96,
   "end": 292.16,
   "text": "قسابت قلب میاره. یازده، داشتن آرزوهای طولانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.16,
   "end": 298.9,
   "text": "که اگر بررسی کنیم خیلیا اون گرفتار این قصه هستیم و بهش هم نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.9,
   "end": 306.46,
   "text": "به عنوان تبرک در کتاب میزان الحکمة جلد دو صفحه هشت-- هشتصد و پنجاه و سه روایت حضرت موسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.46,
   "end": 311.08,
   "text": "على النبي و آله و عليه الصلاة والسلام که خدا بهش فرموده ای موسی در دنیا آرزوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.08,
   "end": 317.24,
   "text": "خود را دراز نکن که در نتیجه دلت سخت می‌شود و آدم سخت دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.24,
   "end": 321.78,
   "text": "یعنی همان قسی القلب از من خدا دور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.78,
   "end": 327.4,
   "text": "خیلی از موقع‌ها دوری ما از خدا به واسطه همین سنگدلی‌هاست که ما بی‌خبریم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.4,
   "end": 333.6,
   "text": "چرا انقدر ما از خدا دوریم؟ کسی به امام رضا علیه الصلاة والسلام عرض کرد آقا چرا ما خدا رو نمی‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.6,
   "end": 336.88,
   "text": "فرمود به خاطر اینکه دل، بخواه-- مشکل تو دلتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.88,
   "end": 341.9,
   "text": "امیرالمؤمنین فرمود من خدایی رو که ندیدم که عبادتش نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.9,
   "end": 345.42,
   "text": "ها؟ حالا این دیدن چگونه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.42,
   "end": 347.54,
   "text": "از درون اتفاق می‌افته با چشم دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.54,
   "end": 352.02,
   "text": "ببینید توی اینجا یه پرانتز من باز کنم خیلی سریع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.02,
   "end": 359.42,
   "text": "خوب اینو گوش بدید. خب چون ما الان تو دل بحث هستیم و عده‌ای خب نبودن از ابتدا تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.42,
   "end": 361.96,
   "text": "وارد بحث می‌شن، میان می‌پیوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.96,
   "end": 365.36,
   "text": "یا یادشون نیست این بحثا چیه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.36,
   "end": 368.4,
   "text": "چه روندی رو ما داریم میریم. حواسمون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.4,
   "end": 373.45,
   "text": "که ما به هر حال معرفت النفس انفع المعارفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.45,
   "end": 376.05,
   "text": "امیرالمؤمنین علیه السلام فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.05,
   "end": 380.01,
   "text": "شناخت نفس، نفس وجود انسانی، نفس ناطق انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.01,
   "end": 382.03,
   "text": "که همه عالم قیام برای او کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.03,
   "end": 385.37,
   "text": "دیروز عرض کردیم همه عوالم هستی برای او قیام کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.37,
   "end": 388.75,
   "text": "همه میخوان خودشونو خرج و نذر و وقف این نفس کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.75,
   "end": 391.73,
   "text": "انسان انسان و به ما هو انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.73,
   "end": 397.13,
   "text": "این باید شناخته بشه که من-- پرمنفعت‌ترین علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.13,
   "end": 398.91,
   "text": "حالا این شعونی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.91,
   "end": 402.75,
   "text": "نفس شعونی دارد، قوایی دارد، ابزاری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.75,
   "end": 405.35,
   "text": "اولینش همین حواس پنج گانه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.35,
   "end": 408.37,
   "text": "بصره و سامعه و نمیدونم ذائقه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.37,
   "end": 411.29,
   "text": "لامسه و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.29,
   "end": 414.31,
   "text": "حس بویایی و. این‌ها رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.31,
   "end": 417.79,
   "text": "چند ماه روش اون اوایل بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.79,
   "end": 420.83,
   "text": "بعد شناخت این حواس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.83,
   "end": 423.15,
   "text": "قوه‌ی خیال، خیال انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.15,
   "end": 427.73,
   "text": "مثال. این‌ها چون ما همین حواس رو در قوه مثالمون هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.73,
   "end": 432.49,
   "text": "مثالی یا خیالی یا همون وقت که می‌خوابیم از همین قوا داریم استفاده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.49,
   "end": 434.05,
   "text": "ما می‌خوابیم هم می‌بینیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.05,
   "end": 435.65,
   "text": "می‌خوابیم هم حرف می‌زنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.65,
   "end": 438.19,
   "text": "اما با اون قوه در عالم خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.19,
   "end": 442.01,
   "text": "این‌ها رو هم ما چند جلسه یادمه قبل‌ها بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.01,
   "end": 444.49,
   "text": "بعد قوه واهمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.49,
   "end": 446.79,
   "text": "این هم چند جلسه بحث کردیم. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.79,
   "end": 449.19,
   "text": "چی‌ان؟ میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 449.19,
   "end": 451.75,
   "text": "درون نفسن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.75,
   "end": 455.75,
   "text": "ابزار نفسن، قوای نفس انسانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.75,
   "end": 458.15,
   "text": "بعد قوای عاقله است. قوه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.15,
   "end": 462.07,
   "text": "مثلا عقل. این هم چند جلسه ما بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.07,
   "end": 465.67,
   "text": "تا رسیدیم به چی؟ قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.67,
   "end": 468.25,
   "text": "یا دل. حالا رسیدیم به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.25,
   "end": 471.63,
   "text": "قسمت از بحث حالا نفس‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.63,
   "end": 477.73,
   "text": "البته ما خیلی عامیانه، خیلی اکابری، خیلی پیش پا افتاده داریم بحث می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.73,
   "end": 480.41,
   "text": "یعنی اگه بخواهیم علمی مصاحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.41,
   "end": 484.51,
   "text": "مطمئنم خیلیا ریزش می‌کنند و دیگه نمیان حوصله‌شو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.51,
   "end": 486.89,
   "text": "اگه دوست داشتید تو مبحث س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.89,
   "end": 489.93,
   "text": "روح و سر و جان که اگر خدا خواست رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.93,
   "end": 493.25,
   "text": "یه ذره علمی بحث می‌کنیم ببینیم کی طاقت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.25,
   "end": 498.47,
   "text": "یا یه جلسه حتی. به هر حال به قلب رسیدیم و این قلب خودش گفتیم حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.47,
   "end": 503.41,
   "text": "شصت نوع هم تازه فقط در قرآنشو ما داریم بررسی می‌کنیم روایات رو نمی‌بینیم و بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.41,
   "end": 506.03,
   "text": "علمی آنچنانی نداریم و الا غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.03,
   "end": 508.75,
   "text": "حالا این بحث رو هم ما به دهمیش رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.75,
   "end": 512.29,
   "text": "تقریباً یک سال گذشته. شصت نوع قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.29,
   "end": 515.95,
   "text": "تازه ما هم سریع رد میشیم. بعدش انشاالله به روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.95,
   "end": 521.45,
   "text": "به روح می‌رسیم که مافوق قلب است و بعدش به سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.45,
   "end": 524.69,
   "text": "که این‌ها سر و سر دوباره داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.69,
   "end": 528.61,
   "text": "این‌ها همه چی هم قوای نفسن و ما باید اینو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.61,
   "end": 531.87,
   "text": "اگر نشناسیم نمی‌دونیم چی تو وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.87,
   "end": 538.27,
   "text": "این \"اتزعم الانك جرم صغیر وفيك انت العالم الاكبر\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.27,
   "end": 540.39,
   "text": "عالم بزرگی در وجود تو نهفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.39,
   "end": 542.37,
   "text": "اینو نش-- و باید زحمت بکشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.37,
   "end": 546.79,
   "text": "باید کار کنیم. این چند دقیقه که گرد هم می‌شینیم رو اینو غنیمت بشمارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.79,
   "end": 550.09,
   "text": "یه مدخلی قرار بدید برای خودتون این رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 550.09,
   "end": 554.31,
   "text": "برای ورود به یک عالم جدیدی برید دنبالش و وقت بگذارید براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.31,
   "end": 556.99,
   "text": "واقعاً تو زندگیمون وقت بگذاریم برای این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 556.99,
   "end": 559.59,
   "text": "اصلاً چاره‌ای جز این نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.59,
   "end": 567.07,
   "text": "و کتاب‌ها، جلسه‌ها، این‌ها رو درس و بحث‌ها از جهت علمی خودمون رو بشناسیم و الا نمی‌رسیم به اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.07,
   "end": 569.37,
   "text": "باید برسیم و اگر نرسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.37,
   "end": 572.29,
   "text": "باختیم. زحمت باید بکشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.29,
   "end": 578.49,
   "text": "تا حدود صد و نود سال پیش یه عالمی رو از دست دادیم به نام حاج ملا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 578.49,
   "end": 583.65,
   "text": "حاج ملا علی نوری رحمت‌الله‌علیه که ماز-- مازندران ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.65,
   "end": 587.85,
   "text": "سنگ‌کشی می‌کرد. بعد اونجا تحصیل علم هم می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.85,
   "end": 591.57,
   "text": "و عالمی بود برای خودش. ولی مردم نمی‌شناختنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.57,
   "end": 595.07,
   "text": "فتحعلی‌شاه اومد صد و حدود نود سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.07,
   "end": 601.23,
   "text": "ایشون البته از دنیا رفت. همون حدود مثلا دویست و اندی سال پیش فتحعلی‌شاه اومد مازندران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.23,
   "end": 602.99,
   "text": "البته مرکز پادشاهیش کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.99,
   "end": 605.99,
   "text": "اصفهان بود. اومد خب سرکشی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.99,
   "end": 609.13,
   "text": "اومد مازندران پرسید. اون قدیم‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 609.13,
   "end": 611.17,
   "text": "آخوندها رو دوست داشتن حتی پادشاه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.17,
   "end": 616.55,
   "text": "تو دربار تو همه، همه پادشاه‌ها با علما، ملاها، آخوندها مرتبط بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.55,
   "end": 621.29,
   "text": "این قصه آخوند زدگی از رضاخان ملعون به بعد به وجود اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 621.29,
   "end": 624.67,
   "text": "اینطوری نبود. رض-- فـ-فتحعلی‌شاه اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 624.67,
   "end": 629.49,
   "text": "اونجا مازندران اولین کاری که کرد پرسید گفت اینجا ملا دارید یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.49,
   "end": 631.25,
   "text": "آخوند دارید یا نه؟ گفت آره دو تا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.25,
   "end": 633.27,
   "text": "یکیش خیلی خوبه با همه می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.27,
   "end": 635.77,
   "text": "میاد، می‌گه، می‌خنده مثل بیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 635.77,
   "end": 637.61,
   "text": "با همه خوبه فلان. اون یکی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 637.61,
   "end": 641.11,
   "text": "اون اصلاً تعویل نمی‌گیره. همش یه گوشه‌ست و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.11,
   "end": 642.79,
   "text": "فتحعلی‌شاه حالیش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 642.79,
   "end": 645.49,
   "text": "فهمید که اون حتماً یه وزانتی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.49,
   "end": 649.13,
   "text": "عمرشو مفت نمیده. خلاصه گفت بگید دوتاشون بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 649.13,
   "end": 652.73,
   "text": "رفتن. اون که با همه خوب و خوش و اینا بود اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 652.73,
   "end": 655.55,
   "text": "اون یکی حاج ملا علی نوری رحمت‌الله‌علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 655.55,
   "end": 659.09,
   "text": "نیومد. گفت بهش بگید آدم گوشت میخواد میره قصابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.09,
   "end": 663.33,
   "text": "یعنی اگه تو چیزی میخوای بی-- تو بیا من برای چی-- من کاری باهاتون ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.33,
   "end": 665.21,
   "text": "البته جرات نکردن به فتحعلی‌شاه بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 665.21,
   "end": 667.59,
   "text": "گفتن گردنمونو می‌زنه. گفتن نیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 667.59,
   "end": 669.57,
   "text": "گفت خب ما میریم. ما میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 669.57,
   "end": 672.07,
   "text": "عجب! این با دارو دسته‌ش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 672.07,
   "end": 674.55,
   "text": "محضر کی؟ این عالم ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 674.55,
   "end": 677.91,
   "text": "ملا علی نوری رحمت‌الله‌علیه رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 677.91,
   "end": 680.39,
   "text": "نشست و چهار تا سؤال علمی مطرح کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 680.39,
   "end": 682.55,
   "text": "دید نه غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.55,
   "end": 684.97,
   "text": "عظمتیه. یه گوشه نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 684.97,
   "end": 687.37,
   "text": "گفت پاشو بریم. دستشو گرفت گفت تو جا اینجانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 687.37,
   "end": 689.15,
   "text": "اینا ارزش تو رو نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 689.15,
   "end": 693.17,
   "text": "پاشو بریم. آوردش اصفهان حوزه علمیه در اختیارش گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 693.17,
   "end": 698.57,
   "text": "آقا غوغایی کرد همین حاج ملا علی نوری که من میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 698.57,
   "end": 701.19,
   "text": "چهارصد تا فیلسوف تربیت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 701.19,
   "end": 707.93,
   "text": "یکیش حاج میرزا اسماعیل سبزواری بود که شاگرد حاج میرزا اسماعیل سبزواری، حاج ملا هادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 707.93,
   "end": 710.99,
   "text": "سبزواری اون غول عرفان و غول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 710.99,
   "end": 716.19,
   "text": "عرض کنم فلسفه بود. به هر حال می‌خوام بگم که ببین-- چهارصد تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 716.19,
   "end": 718.27,
   "text": "میگن سطح علمیش به قدری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 718.27,
   "end": 725.49,
   "text": "بالا بود که کس-- از بزرگان و علما نمی‌تونستن بکشن بار علمی ایشونو و الا به مراتب خیلی بیشتر از چهارصد تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 725.49,
   "end": 727.73,
   "text": "چرا؟ زحمت کشید، وقت گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 727.73,
   "end": 730.13,
   "text": "اینطوری نبود عمرشو تلف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 730.13,
   "end": 732.81,
   "text": "همینطوری هرجا هر حرفی هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 732.81,
   "end": 737.13,
   "text": "خیلی موقع‌ها این گده‌های ما نشست و برخاست ما بگو بخندهای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 737.13,
   "end": 741.39,
   "text": "آقا مسائل سیاسی برای هم میگیم، فلانی رو نقد می‌کنیم، اینو زیر سؤال می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 741.39,
   "end": 746.45,
   "text": "همش بیخوده. عمر ما که از سر راه پیدا نشده داره تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 746.45,
   "end": 748.97,
   "text": "چند روز دیگه میگن بلند بگو لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 748.97,
   "end": 753.93,
   "text": "این نفس ناطق هم را اگر تو نشناختی، نمی‌تونیم خدا رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 753.93,
   "end": 755.85,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 755.85,
   "end": 759.11,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 759.11,
   "end": 762.17,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 762.17,
   "end": 765.19,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}