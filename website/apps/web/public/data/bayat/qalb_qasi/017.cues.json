 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا دربارهٔ آبِ کر در منبع",
   "start": 1.9,
   "end": 23.18
  },
  {
   "index": 1,
   "title": "بر پایهٔ آیهٔ بیست‌ودومِ سورهٔ زمر، قلبِ قسی و قساوت محلِ مداقه قرار گرفته بود:",
   "start": 23.18,
   "end": 164.48
  },
  {
   "index": 2,
   "title": "## نگاهِ خدا به دنیا",
   "start": 164.48,
   "end": 432.58
  },
  {
   "index": 3,
   "title": "## آب در قرآن؛ مظهرِ ولایت و علم",
   "start": 432.58,
   "end": 544.16
  },
  {
   "index": 4,
   "title": "## تمثیلِ هتل؛ مسافر مغرور نمی‌شود",
   "start": 544.16,
   "end": 569.44
  },
  {
   "index": 5,
   "title": "## داستانِ نوح و غار",
   "start": 569.44,
   "end": 726.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.9,
   "end": 6.66,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.66,
   "end": 10.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.2,
   "end": 14.8,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.8,
   "end": 19.88,
   "text": "استفتای دیگه‌ای که از رهبر عزیزمون شده اینه که خب بعضی از جاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.88,
   "end": 21.84,
   "text": "مخصوصا با این کمبود آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.84,
   "end": 24.1,
   "text": "اومدن منابعی رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.1,
   "end": 29.8,
   "text": "پشت بومشون یا حیاطشون و این‌ها قرار دادن یا بعضی‌ها حتی زیر زمین و پمپاژ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.8,
   "end": 35.14,
   "text": "یه منبع آبی هست که به قدر کر یا بیش از اون درش آب وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.14,
   "end": 39.74,
   "text": "خب اینا هر روز که غسل و طهارت و این‌ها که انجام میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.74,
   "end": 44.38,
   "text": "وضو می‌گیرن یا هر چیز شیء متنجسی رو تمیز می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.38,
   "end": 46.86,
   "text": "این خیالشون راحته که این آب کره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.86,
   "end": 50.48,
   "text": "به قدر کر و بیشتر از کر در اون منبع وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.48,
   "end": 56.9,
   "text": "لکن حالا برای اینکه خیلی دست در دسترس نیست باید مثلا پله‌ای رو بالا برن یا زیر زمینی برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.9,
   "end": 59.88,
   "text": "خیلی حوصله ندارن که خیلی بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.88,
   "end": 64.86,
   "text": "برن سر بزنن که آب الان مثلا چه مقدار توش باقی مونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.86,
   "end": 70.14,
   "text": "به حدس و گمان که حالا ما انقدر که هنوز که خیلی مصرف نکردیم الان این آب کره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.14,
   "end": 76.3,
   "text": "هنوز هم کره. حالا سؤال اینه که این منبع آب یا هر چیز دیگه‌ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.3,
   "end": 78.74,
   "text": "نی-- ما باید حتما علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.74,
   "end": 82.26,
   "text": "یقینی به این پیدا کنیم که الان کره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.26,
   "end": 85.86,
   "text": "آبش کره که باهاش طهارت انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.86,
   "end": 88.56,
   "text": "و باهاش حکم آب کر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.56,
   "end": 91.58,
   "text": "در طهارت لحاظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.58,
   "end": 95.02,
   "text": "یعنی آثار شرعی که مترتب میشه بر آب کر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.02,
   "end": 102.88,
   "text": "طهارت. آقا فرمودن اگر که اون منبع قبل از این یعنی سابقه‌ش این بوده که کر بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.88,
   "end": 107.66,
   "text": "یعنی قبلاً مطمئن بودی که آب به میزان کر یا بیشتر درش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.66,
   "end": 110.2,
   "text": "الان می‌تونی چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.2,
   "end": 112.3,
   "text": "اعتنا به همون علم کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.3,
   "end": 116.62,
   "text": "و بگی که بنا رو بذاری بر اینکه انشاالله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.62,
   "end": 122.52,
   "text": "انشاالله کر هست. اما نه، اگر کر نبوده اون منبع الان شک داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.52,
   "end": 126.52,
   "text": "حالا یه منبعی بوده که یه زمانی کر به میزان کر توش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.52,
   "end": 131.08,
   "text": "الان یه وفس شک کردی که این منبع کر هست یا نه، کر شده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.08,
   "end": 134.82,
   "text": "مثلا یه منبعی میان جدید نصب می‌کنن، جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.82,
   "end": 138.04,
   "text": "تو میخوای طهارت بگیری نمی‌دونی که الان این کره یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.04,
   "end": 140.72,
   "text": "این یعنی شروعه. تازه سابقه‌ای نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.72,
   "end": 142.8,
   "text": "اینجا نه، باید علمت به یقین برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.8,
   "end": 144.98,
   "text": "باید تحقیق کنی، بررسی کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.98,
   "end": 146.72,
   "text": "بری نگاه کنی مطمئن بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.72,
   "end": 149.86,
   "text": "اما نه، اگر از قبل کر بوده نیازی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.86,
   "end": 153.82,
   "text": "بررسی مجدد نداره. خب ما عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.82,
   "end": 158.98,
   "text": "بر اساس آیه بیست و دو سوره زمر که قلب قسا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.98,
   "end": 161.52,
   "text": "با قساوت یا قلب قسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.52,
   "end": 166.38,
   "text": "مورد مراد مداقه قرار داده بودیم، اشاره کردیم به یک روایتی از ابن مسعود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.38,
   "end": 168.98,
   "text": "ش-- عرض کنم تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.98,
   "end": 172.54,
   "text": "شریف نور الثقلین. یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.54,
   "end": 179.3,
   "text": "وقتی بر اساس این آیه که می‌فرمود \"أفمن شرح الله صدره للإسلام فهو على نور من ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.3,
   "end": 183.12,
   "text": "فويل للقاسية قلوبهم من ذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.12,
   "end": 185.62,
   "text": "أولئك في ضلال مبين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.62,
   "end": 191.22,
   "text": "اینجا ابن مسعود یه زرنگی کرد و از پیغمبر عظیم الشأن اسلام سؤال کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.22,
   "end": 197.08,
   "text": "که نشونه این کسی که خدا بهش شرح صدر داده، سینشو گشایش داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.08,
   "end": 199.08,
   "text": "و بر نور سوارش کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.08,
   "end": 204.58,
   "text": "لذا از قلب قسی و سختی دل نجاتش داده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.58,
   "end": 207.42,
   "text": "خیلی سؤال قشنگی بود که حالا پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.42,
   "end": 212.2,
   "text": "فرمودن \"إذا دخل النور في القلب انشرح وانفتح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.2,
   "end": 215.72,
   "text": "این خدا نوری رو در قلبش ایجاد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.72,
   "end": 219.52,
   "text": "که شرح صدر و گشادگی درش ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.52,
   "end": 221.76,
   "text": "بعد دوباره زرنگی کرد خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.76,
   "end": 226.82,
   "text": "علائمش چیه؟ علائم این گشادگی سینه که این نوری که خدا درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.82,
   "end": 229.06,
   "text": "در وجودش القا کرده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.06,
   "end": 232.34,
   "text": "یکیشو عرض کردیم. گفتیم که طبق این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.34,
   "end": 235.58,
   "text": "پیغمبر سه تا نشونه، سه تا علامت دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.58,
   "end": 237.92,
   "text": "که معمولا هم این‌ها به گوش ما آشناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.92,
   "end": 241.5,
   "text": "در بحث عملیات ما مشکل داریم در حد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.5,
   "end": 244.56,
   "text": "موضوع نظر همه ما الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.56,
   "end": 246.44,
   "text": "عالمیم و می‌دونیم مشکل عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.44,
   "end": 250.86,
   "text": "اینجا پیغمبر فرمودن که العنابة إلى دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.86,
   "end": 255.22,
   "text": "یادتون باشه عرض کردیم که نوب رو یا عنابه رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.22,
   "end": 259.6,
   "text": "آن به آن در حال برگشته به سمت آخرت و دار الخلود باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.6,
   "end": 263.96,
   "text": "یعنی از صبح که میزنه بیرون تا شب که بر می‌گرده تا شب که می‌خوابه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.96,
   "end": 270.94,
   "text": "عملیات خوابش که خواب هم به واقع یک عملیات بسیار مهم و مهم‌تر از روز هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.94,
   "end": 274.0,
   "text": "آغاز می‌کنه، نگاهش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.0,
   "end": 278.14,
   "text": "افق نگاهش دار الخلود است، آخرت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.14,
   "end": 280.28,
   "text": "دو تا نشونه موند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.28,
   "end": 288.44,
   "text": "دیگه فرصت نشد. پیغمبر فرموده و هم نشونه دوم و تجافي عن دار القرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.44,
   "end": 292.02,
   "text": "تجافي میگن که وقتی که در نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.02,
   "end": 295.54,
   "text": "جماعت شما می‌رسی به وضعیتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.54,
   "end": 298.88,
   "text": "امام و جماعت توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.88,
   "end": 303.62,
   "text": "تشهدن یا سلامن و ولی تو الان وظیفت تشهد و سلام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.62,
   "end": 305.3,
   "text": "میگن به حال تجافي بشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.3,
   "end": 310.04,
   "text": "دیدی چجوری می‌شینن؟ بین نشسته و بلند ایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.04,
   "end": 313.46,
   "text": "از زمین، در حقیقت از زمین کنده شده، آماده باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.46,
   "end": 317.38,
   "text": "تجافي یعنی کنده شده. به اون میگن تجافي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.38,
   "end": 321.0,
   "text": "در شریعت. این حقیقتش یعنی از زمین کنده بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.0,
   "end": 323.42,
   "text": "یعنی اینکه آماده باش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.42,
   "end": 327.36,
   "text": "حالا تجافي برای از کجا بکنی خودتو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.36,
   "end": 330.32,
   "text": "عن دار القرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.32,
   "end": 333.78,
   "text": "این خیلی مهمه. دو تا نکته اینجا هست، دو تا نکات مهم اینجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.78,
   "end": 337.66,
   "text": "یکیش اینه که آماده باش باشی و کنده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.66,
   "end": 340.44,
   "text": "دو اینه که زمین رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.44,
   "end": 344.16,
   "text": "این دنیا رو دار غرور بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.16,
   "end": 347.3,
   "text": "دار باقی ندونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.3,
   "end": 350.66,
   "text": "دار غرور بدونی که از تو دل فنا بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.66,
   "end": 355.26,
   "text": "کسی مغرور میشه که در فنا قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.26,
   "end": 361.34,
   "text": "نه فنای عرفانی‌ها. کسی که به باقی وصل شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.34,
   "end": 364.9,
   "text": "او هیچ وقت دچار غرور نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.9,
   "end": 367.08,
   "text": "چون هرچی می‌ره به آخر نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.08,
   "end": 370.46,
   "text": "وجود لایتناهی‌ست حتی در علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.46,
   "end": 377.14,
   "text": "این کندن خیلی مهمه اینکه انسان از زمین کنده شده باشه از علائق کنده شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.14,
   "end": 379.76,
   "text": "خیلی درش سر هست. می‌گه تجافي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.76,
   "end": 382.42,
   "text": "می‌گه کن فین‌ناس ولا تکن معهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.42,
   "end": 384.72,
   "text": "بین مردم باش اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.72,
   "end": 388.08,
   "text": "با اون‌ها نباش. حواست باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.08,
   "end": 392.96,
   "text": "بر اثر ارتباط با خیلی‌ها ما متنجس می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.96,
   "end": 396.02,
   "text": "خیلی‌ها وجودشون ناپاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.02,
   "end": 397.68,
   "text": "خیلی‌ها دچار خباثت‌ются.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.68,
   "end": 400.2,
   "text": "اصلاً این دنیا خبیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.2,
   "end": 403.04,
   "text": "دنیا چرا بهش می‌گن دنیا؟ از دنی میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.04,
   "end": 405.96,
   "text": "ریشه‌ش از دنیه یعنی پست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 405.96,
   "end": 408.64,
   "text": "یه بار یه روایتی گفتم خیلی بعضیا تکون خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 408.64,
   "end": 411.14,
   "text": "امیرالمؤمنین علیه‌السلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.14,
   "end": 415.38,
   "text": "که از وقتی خدا این دنیا رو خلق کرده بهش نگاه نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.38,
   "end": 421.44,
   "text": "نه اون نگاه تکوینی‌ها نه، اون نگاه از روی محبت و رحیمیتش نه رحمانیتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.44,
   "end": 424.44,
   "text": "رحمانیتش رو برداره که همه چی از بین می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.44,
   "end": 429.32,
   "text": "نگاه رحیمیتش رو به دنیا انقدر که دنیا نزد خدا پسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.32,
   "end": 432.58,
   "text": "حالا ما چسبیدیم به این دنیا به انحاء مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.58,
   "end": 440.04,
   "text": "اگر کسی زیرک باشه از شئونات مختلف دنیویه در مسیر دار خلود بهره بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.04,
   "end": 441.94,
   "text": "مثلاً این تازه ابتداییاته ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.94,
   "end": 443.92,
   "text": "این‌ها خیلی هم ابتداییاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.92,
   "end": 448.86,
   "text": "دلمون هم خوش نکنیم. مثلاً غذا می‌خوره برای اینکه قوت پیدا کنه عبادت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.86,
   "end": 450.54,
   "text": "و الا بدون این هم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.54,
   "end": 453.52,
   "text": "یعنی خیلی‌ها بدون غذا خوردن عبادت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.52,
   "end": 458.32,
   "text": "موسی کلیم تو کوه طور چهل شبانه روز عبادت کرد بدون اینکه نه آب بخوره نه غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.32,
   "end": 461.34,
   "text": "این‌ها یه مقدار چون ماها مد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 461.34,
   "end": 464.66,
   "text": "س-- خودم رو عرض می‌کنم سیر نکردم تو اون عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 464.66,
   "end": 468.08,
   "text": "اینطوره. و الا خود آب فقط صرفاً مادی نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 468.08,
   "end": 473.74,
   "text": "آب چطور اگه مادیه چرا تو قرآن این همه می‌گه ولایت و من و جعلنا من الماء کل شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 473.74,
   "end": 478.16,
   "text": "حي و ان لبست قاموا الی الطريق لأسقینا ما عن غدغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.16,
   "end": 484.54,
   "text": "ها قل ان قل ارایتم ان اصبح ماؤکم غورا فمن یأتیکم بماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.54,
   "end": 487.22,
   "text": "معین. این آب، آب، آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.22,
   "end": 491.58,
   "text": "آب در قرآن همش بر ولایت و علم امام و قدرت امام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.58,
   "end": 494.68,
   "text": "این‌ها انتفاع به علم امام و این‌ها شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.68,
   "end": 498.34,
   "text": "پس اون یک موجود معنوی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.34,
   "end": 502.94,
   "text": "می‌شه اگر می‌شه کسی حتی تشنه بشه ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.94,
   "end": 508.18,
   "text": "تشنگی ظاهری پیدا کنه لکن از اون آب معنوی بهره بگیره سیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.18,
   "end": 514.26,
   "text": "حالا این بحث می‌خواد که یه ذره الان تو ف-- نه تو فرصتش هستیم، نه تو بحثش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.26,
   "end": 516.58,
   "text": "لکن می‌خوام بگم که خیلی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.58,
   "end": 519.54,
   "text": "امثال من خیلی دوریم. به دنیا چسبیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.54,
   "end": 524.56,
   "text": "می‌گه بکن از اینکه این دنیا رو موای خودت بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.56,
   "end": 529.2,
   "text": "از اینکه دنیا رو افق نگاه خودت قرار بدی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.2,
   "end": 534.52,
   "text": "اصلاً دنیا برات مو-- تو فرمول زندگی و سبک زندگیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.52,
   "end": 538.56,
   "text": "ورود پیدا نکنه. تو همه نگاهت با آخرت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.56,
   "end": 540.82,
   "text": "این دنیا رو مثل یک گذرگاه ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.82,
   "end": 543.38,
   "text": "اینم که تجافي دیگه. بعدم می‌گه دار الغرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.38,
   "end": 545.24,
   "text": "خیلی جالبه. همه مغرورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.24,
   "end": 548.48,
   "text": "چرا مغرورن؟ چون نمی‌دونن اینجا مسافرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.48,
   "end": 552.32,
   "text": "خداوکیلی وقتی ما می‌ریم یه هتلی جایی تو مشهدی انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.32,
   "end": 555.68,
   "text": "توفیق شه بریم یه هت-- بهترین هتل رو به ما بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.68,
   "end": 559.08,
   "text": "بگن آقا ده روز اینجا باش اصلاً یه ماه اینجا باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.08,
   "end": 563.02,
   "text": "خدایی پز می‌دیم به اون تخت و تاج و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.02,
   "end": 566.66,
   "text": "سرویس آنچنانی اون چیزایی که تو اون خونه هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.66,
   "end": 568.6,
   "text": "اصلاً پز نمی‌ده. اصلاً پز بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.6,
   "end": 571.14,
   "text": "چرا؟ چون مال ما نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.14,
   "end": 573.96,
   "text": "اصلاً کسی-- شما کسی رو دعوت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.96,
   "end": 576.04,
   "text": "اصلاً توجهش رو جلب نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 576.04,
   "end": 577.66,
   "text": "کسی هم میاد توجهی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 577.66,
   "end": 579.88,
   "text": "تو رو می‌خواد، تو هم او رو می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 579.88,
   "end": 581.8,
   "text": "اصلاً توجه-- چرا؟ چون مال تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 581.8,
   "end": 585.58,
   "text": "قرار نیست این مال تو-- اگر نگاه ما به دنیا این چنین شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 585.58,
   "end": 589.1,
   "text": "اون موقع این اتفاق این تجافي عن دار الغرور رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 589.1,
   "end": 593.72,
   "text": "وقتی حضرت نوح علیه النبي و آله و عليه الصلاة والسلام شنیدید همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 593.72,
   "end": 595.86,
   "text": "از دنیا حضرت جبرئیل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 595.86,
   "end": 599.58,
   "text": "حضرت عزرائیل سلام الله علیه آمد قبض روحش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 599.58,
   "end": 601.16,
   "text": "حالا می‌دونید تو یه غاری داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 601.16,
   "end": 604.34,
   "text": "اون موقع که خونه‌های اینطوری نمی‌ساختن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.34,
   "end": 608.3,
   "text": "کوه رو می‌تراشیدن. تو کوه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 608.3,
   "end": 612.06,
   "text": "قوم عاد، قوم ثمود اینا تو خونه، تو کوه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 612.06,
   "end": 617.0,
   "text": "تراشیده بودن حتی تو کوه‌ها چه قصر‌هایی درست کرده بودن که تو تاریخ اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 617.0,
   "end": 620.52,
   "text": "با کمک اجنه و چه و چه. جر ثقیل نبوده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 620.52,
   "end": 624.08,
   "text": "حالا حضرت نوح یه غاری برای خودش درست کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 624.08,
   "end": 626.9,
   "text": "و حضرت وقتی اومد قبض روح کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 626.9,
   "end": 631.38,
   "text": "دراز کشیده بود حضرت نوح پاش از در غار زده بود بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 631.38,
   "end": 638.68,
   "text": "مرحوم مجلسی آورده این روایتی که حضرت عزرائیل بهش گفت این چه وضع خونه درست کردنه حضرت پات بیرون از در خونته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 638.68,
   "end": 645.0,
   "text": "فرمود که اگر می‌دونستم انقدر زود تو میای سراغ من، همینم درست نمی‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.0,
   "end": 647.52,
   "text": "کی داره می‌گه؟ نوح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 647.52,
   "end": 650.58,
   "text": "که قرآن می‌گه نوح صد و پنجاه سال فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 650.58,
   "end": 654.36,
   "text": "نبوتش بوده. بعضیا تا چهار هزار سال براش عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 654.36,
   "end": 656.4,
   "text": "نوشتن. حالا حداقل دو هزارا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 656.4,
   "end": 660.92,
   "text": "دو هزار رو داشته. چق-- چند نسل ما باید بیان برن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 660.92,
   "end": 664.82,
   "text": "دو هزار سال رو هم بشه. من نمی‌دونم چه غروری گرفته منو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 664.82,
   "end": 666.9,
   "text": "آخه چی دارم من؟ چی‌ام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 666.9,
   "end": 669.24,
   "text": "یکی دماغمو بگیره تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 669.24,
   "end": 673.18,
   "text": "خفه خون می‌گیرم برای همیشه. و این تجافي حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 673.18,
   "end": 678.26,
   "text": "نمی‌خواستم انقدر توضیح بدم. به بند بعدش می‌خواستیم برسیم نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 678.26,
   "end": 680.08,
   "text": "موضوع اینه که بفهمیم و رشد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 680.08,
   "end": 688.66,
   "text": "پس دومین نشانه از کسی که خدای منان به او نظر کرده است و از قساوت قلب نجاتش داده و به او شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 688.66,
   "end": 693.34,
   "text": "صدر داده و سوار بر نورش کرده بر اساس آیه بیست و دو سوره زمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 693.34,
   "end": 696.8,
   "text": "در این فرمایش پیغمبر در تفسیر نور الثقلین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 696.8,
   "end": 698.92,
   "text": "التجافي عن دار الغروره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 698.92,
   "end": 702.12,
   "text": "کنده خودش رو از زمین. اصلاً بی‌قرار عالم بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 702.12,
   "end": 705.0,
   "text": "حتی می‌خوابه تو عالم بالا سیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 705.0,
   "end": 706.98,
   "text": "خوابش هم عالم بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 706.98,
   "end": 711.88,
   "text": "اینطوری نیست که وقتی می‌خوابه کیف و کوک بدنی بکنه و نوش جان بدنی بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 711.88,
   "end": 715.5,
   "text": "این حرفا نیست. انشاالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 715.5,
   "end": 717.88,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 717.88,
   "end": 723.0,
   "text": "اللهم صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 723.0,
   "end": 726.86,
   "text": "و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}