 ],
 "cues": [
  {
   "i": 0,
   "start": 1.38,
   "end": 5.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.64,
   "end": 9.4,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.4,
   "end": 13.66,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 15.98,
   "text": "پیرامون وام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.98,
   "end": 21.54,
   "text": "عرض کنم قرض و احکام بانکی و این‌ها داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.54,
   "end": 24.12,
   "text": "استفتائات رهبر عزیز رو بررسی می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.12,
   "end": 32.38,
   "text": "یکی دیگه از جاهایی که سؤال شده اینه که آیا اگر ما بریم وامی، قرضی جایی از مؤسسه‌ای، بانکی، صندوقی بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.38,
   "end": 35.26,
   "text": "و اون‌ها شرط کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.26,
   "end": 42.7,
   "text": "این پولی که شما حالا قبلاً عرض کردیم اگر جزو شرایط وام باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.7,
   "end": 45.3,
   "text": "این پولی که تو حساب می‌خوابونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.3,
   "end": 47.74,
   "text": "ربا حساب می‌شه و حرامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.74,
   "end": 55.66,
   "text": "مگر نه شرط عضو در صندوق شدن این باشه که پول در حساب بخوابه این اشکال نداره اما شرط وام نمی‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.66,
   "end": 58.22,
   "text": "حالا عضو صندوق شدی، پول گذاشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.22,
   "end": 60.26,
   "text": "وام می‌گیری. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.26,
   "end": 65.1,
   "text": "شرط گرفتن وام این باشه که حساب شما مسدود می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.1,
   "end": 68.14,
   "text": "هر مقدار که تو حساب پول گذاشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.14,
   "end": 74.24,
   "text": "مسدود می‌شه تا مثلاً انتهای آخرین قسطی که دادی نمی‌تونی پول رو برداشت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.24,
   "end": 78.48,
   "text": "این رو هم فرمودن حرام است و ربا حساب می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.48,
   "end": 85.7,
   "text": "نه تو حق داری این کارو بکنی، نه بانک حق داره این کارو انجام بده یا مؤسسه و صندوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.7,
   "end": 88.44,
   "text": "در خصوص قلب قسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.44,
   "end": 92.76,
   "text": "یا قلبی که دچار قساوت و سختی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.76,
   "end": 96.12,
   "text": "که شما خوبان نرا- ناراحت نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.12,
   "end": 102.4,
   "text": "مرض امروزه امثال منه که واقعاً گرفتار هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.4,
   "end": 108.44,
   "text": "و عرض کنم نکات رو داریم عرض می‌کنیم بر اساس آیه هفتاد و چهار سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.44,
   "end": 111.84,
   "text": "یکی دیگه از اون نکات که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.84,
   "end": 123.42,
   "text": "زیبایی تمام این آیه داره ازش پرده برمی‌داره و علت قسی القلب شدن ما رو میگه، میگه ثم قست قلوبکم من بعد ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.42,
   "end": 132.16,
   "text": "یعنی اینکه شما وقتی قساوت قلب گرفتید که به علم رسیدید چون قبلاً مثلاً رهبریات معصومی مثل حضرت موسی علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.16,
   "end": 134.36,
   "text": "النبی و آلهم و علیه الصلاة والسلام رو به شما دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.36,
   "end": 136.66,
   "text": "آیات قبل اینا رو بررسی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.66,
   "end": 139.38,
   "text": "اون معجزات و این‌ها رو که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.38,
   "end": 141.92,
   "text": "در حقیقت داره میگه شما علمش رو داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.92,
   "end": 144.22,
   "text": "آیا قرائتی در تفسیر سوره نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.22,
   "end": 146.06,
   "text": "در تفسیر نورشون ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.06,
   "end": 148.36,
   "text": "ذیل این آیه می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.36,
   "end": 151.16,
   "text": "منظور این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.16,
   "end": 158.76,
   "text": "علم داشتن به تنهایی منهای یقین یا علم بدون عمل فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.76,
   "end": 161.94,
   "text": "علم داشتن بدون عمل یا علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.94,
   "end": 166.5,
   "text": "بدون ایمان یا علم بدون پشتوانه یقین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.5,
   "end": 168.5,
   "text": "این سبب قساوت قلب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.5,
   "end": 175.02,
   "text": "یعنی طرف اگر عمل نکنه هرچی بیشتر بدونه تو مفقوداتش بیشتر فرو میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.02,
   "end": 177.8,
   "text": "و دچار سختی و سفتی قلب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.8,
   "end": 182.58,
   "text": "تا جایی که دیگه اصلاً پا موعظه دیگران هم حاضر نیست بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.58,
   "end": 186.38,
   "text": "چون انقدر شنیده و عمل نکرده دیگه خسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.38,
   "end": 190.02,
   "text": "خسته شنیدنه، خسته دانستنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.02,
   "end": 192.12,
   "text": "و چنین کسی خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.12,
   "end": 195.66,
   "text": "یعنی باید ما خ-- مراقب باشیم مخصوصاً ما سخنران‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.66,
   "end": 200.84,
   "text": "به قول آقای بهجت بعضیمون عادت کردیم فقط بشنویم و بگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.84,
   "end": 208.4,
   "text": "همین. عمل در کار نیست و این یک خطر بسیار بزرگه برای ما و امثال ما گوینده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.4,
   "end": 212.46,
   "text": "حالا من خیلی جالبه که در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.46,
   "end": 220.9,
   "text": "شریف ارشاد القلوب صفحه صد و پنجاه و یک یه حدیثی دیدم خیلی جالب بود که نقش خاتم امام حسین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.9,
   "end": 223.28,
   "text": "یعنی رو انگشتر بالاخره هرکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.28,
   "end": 227.4,
   "text": "اون چکیده آنچه که براش خیلی مهم هست رو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.4,
   "end": 230.1,
   "text": "نگین انگشترش می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.1,
   "end": 235.38,
   "text": "اینجا ابی عبدالله نقش نگینش دو کلمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.38,
   "end": 238.1,
   "text": "خیلی جالبه. علمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.1,
   "end": 240.74,
   "text": "یاد گرفتی؟ عالم شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.74,
   "end": 243.0,
   "text": "فعمل. پس عمل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.0,
   "end": 247.62,
   "text": "تمام. نقش نگین امام حسین سلام الله علیه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.62,
   "end": 250.56,
   "text": "علمت فعمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.56,
   "end": 253.88,
   "text": "هر چیزی که یاد گرفتی عمل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.88,
   "end": 256.6,
   "text": "این باعث واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.6,
   "end": 258.92,
   "text": "تأسف امثال منه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.92,
   "end": 262.44,
   "text": "مثلاً این نقش نگین امام حسین رو اصلاً توجه بهش ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.44,
   "end": 265.88,
   "text": "در حالی که شاید هر روز برا آقا سینه بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.88,
   "end": 271.26,
   "text": "در کتاب شریف غرر الحکم حدیث شش هزار و صد و نود و شش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.26,
   "end": 276.42,
   "text": "یه حدیث جالبی دیدم. مولامون امیرالمؤمنین علیه الصلاة والسلام فرمودن علی العالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.42,
   "end": 283.66,
   "text": "این عالم نه به معنای خاص که مثلاً علما و مراجع، نه هرکسی به اندازه خودش علومی دارد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.66,
   "end": 287.68,
   "text": "علی العالم ان يعمل بما علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.68,
   "end": 290.14,
   "text": "بر عالم است یعنی فریضه است براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.14,
   "end": 294.86,
   "text": "واجبه که چی؟ آنچه می‌داند به کار بندد، عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.86,
   "end": 298.62,
   "text": "ثم یطلب تعلم ما لم يعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.62,
   "end": 303.04,
   "text": "سپس بره دنبال یادگیری اون چیزایی که نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.04,
   "end": 306.14,
   "text": "این خیلی نکته مهمیه ها. شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.14,
   "end": 308.7,
   "text": "کمتر پیش اومده دیده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.7,
   "end": 311.76,
   "text": "بین سائلین از آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.76,
   "end": 314.38,
   "text": "که آقا یه نصیحتی بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.38,
   "end": 317.06,
   "text": "که اینو نگفته باشه بهش آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.06,
   "end": 320.66,
   "text": "که آقا اونچه که عمل-- آنچه که بلدی عمل کن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.66,
   "end": 324.44,
   "text": "بعد اون چیزایی که بلد نیستی رو خدا بهت آموزش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.44,
   "end": 328.06,
   "text": "بارها یعنی انقدر اینو گفت، گفت، گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.06,
   "end": 332.6,
   "text": "کلید واژه اصلاً همینه. ما خودمون هم خیلی خب ایشون رو اذیت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.6,
   "end": 336.3,
   "text": "هر وقت محضرش می‌رفتیم برای شما گفتم داستان‌هاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.3,
   "end": 340.4,
   "text": "و خیلی اذیت می‌کردیم. دیگه از سر و کله ایشون بالا می‌رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.4,
   "end": 342.12,
   "text": "که یه وقتی به ما بده و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.12,
   "end": 349.64,
   "text": "همش حرفش همین بود. آخر انقدر ما دیگه به تهدید افتادیم و ایشونم داد زد سر ما و داستانشو گفتم براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.64,
   "end": 354.38,
   "text": "آخر سر اون چیزی که نوشت ماحصل و به ما داد بازم همین بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.38,
   "end": 357.04,
   "text": "که تو دروغ میگی. میگی نمی‌دونم چه کنم، چه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.04,
   "end": 359.86,
   "text": "همون چیزایی که بلدی عمل کن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.86,
   "end": 364.2,
   "text": "اگر ماها بدونیم اصلاً سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.2,
   "end": 370.3,
   "text": "نجات همینه. همونچه که بلدی رو عمل کنی برگرد به اون دانست و اون عمل کن تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.3,
   "end": 372.44,
   "text": "یعنی راه سعادت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.44,
   "end": 376.08,
   "text": "در صورتی ما متاسفانه جای دیگه دنبالش می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.08,
   "end": 380.44,
   "text": "در خطبه صد و شصت و چهار نهج البلاغه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.44,
   "end": 386.9,
   "text": "دقت بفرمایید که پیرامون این قصه امیرالمؤمنین چقدر زیبا فرمودن \"ان العالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.9,
   "end": 393.82,
   "text": "العامل بغير علمه\" اون عالمی که به غیر علمش عمل می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.82,
   "end": 399.94,
   "text": "کل-- یعنی علم داره اما عمل به علمش نمی‌کنه \"كالجاهل الخائر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.94,
   "end": 403.62,
   "text": "خائر یعنی سرگشته مثل نادون سرگشته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.62,
   "end": 409.48,
   "text": "\"الذي لا يستفيق من جهله\" که این جهلش از خواب بیدارش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.48,
   "end": 412.48,
   "text": "\"بل الحجة\" بترسیم امثال ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.48,
   "end": 414.74,
   "text": "\"بل الحجة عليه اعظم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.74,
   "end": 418.46,
   "text": "حجت براش بیشتر از دیگران تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.46,
   "end": 420.9,
   "text": "\"والحسرة له الزم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.9,
   "end": 423.86,
   "text": "اصلاً اون اتفاقا حسرتش از دیگران بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.86,
   "end": 427.42,
   "text": "\"وهو عند الله الوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.42,
   "end": 430.66,
   "text": "خدا بیشتر از همه اونو سرزنش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.66,
   "end": 433.52,
   "text": "چون می‌دانست و عمل نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.52,
   "end": 436.1,
   "text": "این خیلی ترس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.1,
   "end": 439.56,
   "text": "حالا من قرآن و روایات رو بررسی می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.56,
   "end": 442.72,
   "text": "شدیدترین وجوه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.72,
   "end": 449.0,
   "text": "مثل‌ها رو قرآن و روایت پیرامون کسی که می‌داند و عمل نمی‌کند زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.0,
   "end": 452.3,
   "text": "هم تو قرآن هم تو روایات مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.3,
   "end": 455.54,
   "text": "آیه صد و هفتاد و شش اعراف میگه \"فمثله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.54,
   "end": 462.62,
   "text": "كمثل الكلب\". میگه کسی که عالمه که به سمت دنیا میره و به علمش عمل نمی‌کنه مثل سگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.62,
   "end": 465.42,
   "text": "مثل سگی که زبونشو بیرون میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.42,
   "end": 467.4,
   "text": "و حالا آیه طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.4,
   "end": 474.04,
   "text": "یا در آیه پنج سوره جمعه میگه \"كمثل الحمار يحمل اسفارا\" مثل الاغی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.04,
   "end": 477.84,
   "text": "کتاب بارش کردن فقط کشنده باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.84,
   "end": 484.78,
   "text": "سختی بار رو می‌کشه. یا تو روایات مثلاً من یه بررسی امروز کردم تقریباً دو ساعتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.78,
   "end": 487.34,
   "text": "خدا لطف کرد بررسی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.34,
   "end": 493.32,
   "text": "حالا خلاصه بگم وقت نیست. مثلاً پیامبر عظیم الشأن اسلام مثلی که می‌زنن میگن:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.32,
   "end": 498.34,
   "text": "عالمی که عمل نمی‌کنه به علمش مثل چراغیه که خودش می‌سوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.34,
   "end": 504.94,
   "text": "اما به دیگران نوری نمیده. حضرت عیسی علی النبیین و آله و علیه صلوة السلام می‌فرماید که مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.94,
   "end": 510.5,
   "text": "کسیه که پشت بومش چراغ روشن کرده اما اتاقاش تاریکه، تو خونه‌ش تاریکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.5,
   "end": 514.14,
   "text": "دوباره پیغمبر می‌فرماید مثل تیرانداز بی‌خشابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.14,
   "end": 518.32,
   "text": "تیر، تیر، تیر در اسلحه دستشه اما تیر نداره بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.32,
   "end": 524.64,
   "text": "گمان می‌کنه مسلحه. مولامون علی علیه الصلاة والسلام می‌فرماید مثل درخت بی‌ثمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 524.64,
   "end": 527.6,
   "text": "یا فرموده مثل گنجیه که ازش انفاق نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.6,
   "end": 530.48,
   "text": "پیشش مونده داره می‌گنده، خاک می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.48,
   "end": 535.26,
   "text": "یا امام صادق صلوة الله علیه فرمود اصلاً موعظه‌ای که عالم بی‌عمل می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.26,
   "end": 538.04,
   "text": "و ولی ما نباید پای صحبت هر کسی هم بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.04,
   "end": 541.36,
   "text": "فرمود اثر اون موعظه مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.36,
   "end": 544.26,
   "text": "اون بارش بارونیه که می‌زنه به سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.26,
   "end": 546.5,
   "text": "هیچ اثری در سنگ نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.5,
   "end": 549.5,
   "text": "خشک می‌شه میره. به هر حال ما در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.5,
   "end": 557.6,
   "text": "خطر بزرگی قرار داریم که این آیه داره به شدت گوشزد می‌کنه که دل-- یکی از دلایل اینکه شما دل سنگ شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.6,
   "end": 561.02,
   "text": "اینه که به اونچه که بلدید عمل نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.02,
   "end": 564.56,
   "text": "و الا تبدیل شدن علم به یقین و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.56,
   "end": 572.22,
   "text": "ایمان عرض کنم اینکه انسان علمش به یقین و ایمان بدل بشه هم گفتن تو سه وجه باید کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 572.22,
   "end": 576.9,
   "text": "یکی ذکر مدام. دائما ذاکر الذکر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 576.9,
   "end": 579.98,
   "text": "ذ-ذکر لسانی. دو، ذکر عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 579.98,
   "end": 582.48,
   "text": "یعنی دائما سعی کنه عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 582.48,
   "end": 587.7,
   "text": "چهارم ذکر قلبی. دائما حضور قلب داشته باشه در کارهای عبادتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.7,
   "end": 591.52,
   "text": "این سه تا رو تمرین کنه تا انشالله یقین براش حاصل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 591.52,
   "end": 593.44,
   "text": "انشالله که عاقبتمون ختم بخیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 593.44,
   "end": 596.5,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 596.5,
   "end": 600.18,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.18,
   "end": 605.44,
   "text": "محمد و آل محمد وعجل لفرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}