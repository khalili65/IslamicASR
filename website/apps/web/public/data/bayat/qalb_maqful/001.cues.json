 "chapters": [
  {
   "index": 0,
   "title": "بحث پیرامون دلِ قفل‌شده است، بر پایهٔ آیهٔ بیست‌وچهار سورهٔ محمد صلی‌الله‌علیه‌وآله:",
   "start": 36.34,
   "end": 140.94
  },
  {
   "index": 1,
   "title": "## واردات دل و صادرات آن",
   "start": 140.94,
   "end": 231.88
  },
  {
   "index": 2,
   "title": "## طعام ظاهر و طعام باطن",
   "start": 231.88,
   "end": 271.86
  },
  {
   "index": 3,
   "title": "آیهٔ بیست‌وچهار سورهٔ عبس را باید ملاحظه کرد:",
   "start": 271.86,
   "end": 292.08
  },
  {
   "index": 4,
   "title": "## داستان طعامِ بی‌باطن در خانهٔ امیرالمؤمنین",
   "start": 292.08,
   "end": 375.14
  },
  {
   "index": 5,
   "title": "## به‌روزرسانی قلب نزد اهل‌بیت",
   "start": 375.14,
   "end": 471.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.56,
   "end": 5.12,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.12,
   "end": 9.8,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.8,
   "end": 12.68,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.68,
   "end": 15.56,
   "text": "بحث ما پیرامون دل قفل شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 23.88,
   "text": "بر اساس آیه بیست و چهار سوره حضرت محمد صلى الله عليه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.88,
   "end": 27.68,
   "text": "که فرمودند \"أفلا يتدبرون القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.68,
   "end": 31.3,
   "text": "أم على قلوب أقفالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.3,
   "end": 40.8,
   "text": "که اساسا قرآن نازل شده است تنز-- یکی از علل تنزل قرآن تدبر ما در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.8,
   "end": 46.26,
   "text": "آیه بیست و نه سوره انبیا می فرماید \"کتاب أنزلناه إليك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.26,
   "end": 49.48,
   "text": "این کتابی که نازل شده به سوی تو که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.48,
   "end": 52.16,
   "text": "اولا \"مبارك\". این کتاب مبارک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.16,
   "end": 54.46,
   "text": "مثل کتاب‌های دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.46,
   "end": 57.56,
   "text": "حالا وظیفه تو چیه؟ \"لتدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.56,
   "end": 61.76,
   "text": "آياته\". برای اینکه اهل تدبر در آیاتش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.76,
   "end": 68.54,
   "text": "اگر کسی دقت بفرمایید تدبر در قرآن نکند، در آیات قرآن نکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.54,
   "end": 70.44,
   "text": "به این کتاب مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.44,
   "end": 73.96,
   "text": "بی‌احترامی کرده، بی‌حرمتی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.96,
   "end": 75.52,
   "text": "یعنی ما چاره‌ای جز این نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.52,
   "end": 79.6,
   "text": "لکن بر اساس این آیه بیست و چهار که عرض کردیم در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.6,
   "end": 84.8,
   "text": "رسول خدا دقت بفرمایید می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.8,
   "end": 87.78,
   "text": "آیا تدبر نمی‌کنید شما تو قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.78,
   "end": 94.48,
   "text": "\"أم على قلوب\". بلافاصله بحث قلب رو میاد کنار تدبر در قرآن معرفی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.48,
   "end": 99.4,
   "text": "اونم قلوبی که دچار قفل زدگی شدن، قفل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.4,
   "end": 104.12,
   "text": "درشون بسته شده به سوی حقایق و ملکوت نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.12,
   "end": 107.02,
   "text": "خب این نشون میده که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.02,
   "end": 110.12,
   "text": "قلب باید تدبر در قرآن صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.12,
   "end": 115.22,
   "text": "در حقیقت تدبر در قرآن صرفا علم فکری نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.22,
   "end": 121.68,
   "text": "که با حوزه عقل و اندیشه و فکر و این‌ها بری سمتش بلکه باید دل بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.68,
   "end": 124.88,
   "text": "چون بلافاصله بعد از قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.88,
   "end": 128.98,
   "text": "تدبر در قرآن مشکل رو می‌بره سر قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.98,
   "end": 133.92,
   "text": "پیاده می‌کنه. میگه قلب مشکل داره که اهل تدبر نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.92,
   "end": 139.82,
   "text": "پس عزیز دلم اگر قفل دل باز بشه ق-- بقیه قصه‌ها حل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.82,
   "end": 147.04,
   "text": "حالا همه این‌ها هم بستگی داره وضعیت قلب ما اگر قفل شده بستگی داره به ورودی‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.04,
   "end": 150.86,
   "text": "ورودی‌هاش در حقیقت واردات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.86,
   "end": 152.86,
   "text": "دل صادرات رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.86,
   "end": 159.74,
   "text": "یه کارخونه وار-- بر اساس مواد اولیش وارداتی که در اون کارخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.74,
   "end": 166.54,
   "text": "وارد میشه هر چقدر اون واردات همون مواد اولیه مرغوب‌ترند صادراتش بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.54,
   "end": 170.46,
   "text": "باید دید چی وار-- چی وارد دل ما شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.46,
   "end": 180.86,
   "text": "اینکه پیامبر عظیم الشأن اسلام فرمودند \"غضوا أبصاركم ترون العجائب\" چشماتون رو ببندید تا ببینید عجائب روزگارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.86,
   "end": 187.22,
   "text": "مگه چه اتفاقی میفته؟ اگر ما چشممون رو ببندیم بعد عجائب رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.22,
   "end": 189.12,
   "text": "خب چشمو که بستیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.12,
   "end": 191.34,
   "text": "غ-غضوا أبصاركم ببندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.34,
   "end": 196.64,
   "text": "خب بستیم. در حقیقت وقتی ما چشم بستیم دیگه چیزی نباید ببینیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.64,
   "end": 199.34,
   "text": "ولی چرا میگه تازه چشمت باز میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.34,
   "end": 202.02,
   "text": "اون چشم دله. چشم قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.02,
   "end": 207.18,
   "text": "میگه اگر این ورودی‌ها یعنی نگاه‌ها درست شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.18,
   "end": 211.82,
   "text": "اون موقع یعنی چشم ظاهرت درست عمل کرد، چشم باطنت باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.82,
   "end": 216.86,
   "text": "در حقیقت ورودی اگر درست شد خروجی درستی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.86,
   "end": 221.54,
   "text": "اینجا ارزش و اهمیت کنترل نگاه، کنترل زبان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.54,
   "end": 226.84,
   "text": "شنیده‌ها، تفکرات، جهت‌گیری‌ها، نیات، اینا مشخص میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.84,
   "end": 229.62,
   "text": "که این ورودی‌ها خروجی‌ها رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.62,
   "end": 231.52,
   "text": "بله از ظاهر بگیر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.52,
   "end": 234.8,
   "text": "دیگه حالا بحث ظاهر و باطن خیلی بحث عمیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.8,
   "end": 237.2,
   "text": "اینکه ما برای جسممون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.2,
   "end": 240.48,
   "text": "وظیفه داریم که مراقب باشیم هر غذایی رو نخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.48,
   "end": 242.98,
   "text": "غذای مسموم ظاهری نخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.98,
   "end": 245.5,
   "text": "مسموم باطنی هم نباید بخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.5,
   "end": 250.76,
   "text": "چطور روایت داریم که برای امیرالمؤمنین قربونش بریم یه طعامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.76,
   "end": 254.52,
   "text": "هدیه آوردن مثل اینکه یه وقت نذری در خونه ما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.52,
   "end": 256.78,
   "text": "حضرت فرمودن هر چیزی رو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.78,
   "end": 260.84,
   "text": "هر چیزی رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.84,
   "end": 263.42,
   "text": "عرض شود تحمیل به وجود خودتون نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.42,
   "end": 265.76,
   "text": "اون آیه بیست و چهار سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.76,
   "end": 269.9,
   "text": "عبس رو برید ملاحظه کنید. \"فلينظر الإنسان إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.9,
   "end": 271.86,
   "text": "طعامه\". خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.86,
   "end": 276.42,
   "text": "آیا پس وقتی که انسان نگاه می‌کنه به طعامش این چه طعامیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.42,
   "end": 278.32,
   "text": "ظاهراً این غذای ظاهریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.32,
   "end": 284.3,
   "text": "درسته؟ در حالی که امام صادق-- امام باقر صلوات الله علیه فرمودن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.3,
   "end": 289.36,
   "text": "باطنش چون آیات قرآن باطن داره، ظاهرش اینه که غذای مسموم نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.36,
   "end": 294.72,
   "text": "غذای که مریضت کنه جسم و بدنت رو ظاهر تو مریض کنه نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.72,
   "end": 301.04,
   "text": "یه لایه پنهان‌ترشو امام باقر باز کرده فرموده ببین علمت رو از کجا اخذ می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.04,
   "end": 307.48,
   "text": "علم. این \"فلينظر الإنسان إلى طعامه\" یعنی إلى طعام روحش، علمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.48,
   "end": 311.8,
   "text": "اعتقاداتت چیه؟ اگه اعتقاداتت درست نباشه میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 311.8,
   "end": 313.6,
   "text": "حوزه قلبت رو بیچاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.6,
   "end": 317.02,
   "text": "در قلبتو قفل می‌کنه و نمی‌تونی تدبر در قرآن بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.02,
   "end": 321.4,
   "text": "اونجا که برای امیرالمؤمنین غذا آوردن مولا بو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.4,
   "end": 325.96,
   "text": "نه بوی ظاهری. متوجه شد که این غذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.96,
   "end": 329.9,
   "text": "باطن درستی نداره. حالا شبحناکه، حرامه، هرچی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.9,
   "end": 332.26,
   "text": "فرمود که کسی از این غذا نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.26,
   "end": 336.6,
   "text": "ولی خب تو روایت میگه حضرت زینب سلام الله علیها که بچه سال بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.6,
   "end": 340.32,
   "text": "گرسنه بودن. عجله کرده بودن مقداری از این غذا خورده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.32,
   "end": 344.02,
   "text": "به محض اینکه مولا ف-- متوجه شد زینبش رو خواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.02,
   "end": 346.12,
   "text": "دست برد تو حلق حضرت زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.12,
   "end": 349.66,
   "text": "تو روایت میگه یه کاری کرد که خانم پس بزنه غذا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.66,
   "end": 352.2,
   "text": "بعد فرمود که این تو رو آلوده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.2,
   "end": 358.22,
   "text": "یعنی ببینید یه غذا ظاهرش مشکلی نداره که غذای نذری آوردن هدیه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.22,
   "end": 360.98,
   "text": "اما باطنش میگه زینب جان این تو رو تاریک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.98,
   "end": 364.92,
   "text": "چرا؟ باطن نداره این غذا شبحناکه یا حرام هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.92,
   "end": 367.62,
   "text": "می‌خوام عرض کنم که حتی غذایی که ما می‌خوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.62,
   "end": 374.62,
   "text": "ظاهرش هم درست باشه اما باطن وقتی نداشته باشه میزنه قلب انسان رو قفل می‌کنه روی حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.62,
   "end": 379.66,
   "text": "حالا این اگر ورودی‌ها چه غذا برای بدنمون، چه غذا برای باطنمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.66,
   "end": 383.82,
   "text": "درست نشه، قلب قفل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.82,
   "end": 387.52,
   "text": "مثل یه دستگاهی حالا کامپیوتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.52,
   "end": 390.06,
   "text": "تلفن همراه هرچی که یهو قفل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.06,
   "end": 392.62,
   "text": "باید ریست بشه. باید به روز بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.62,
   "end": 397.1,
   "text": "برگرده به کارخانش. اون کارخانه هم چیزی نیست جز اهل بیت و ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.1,
   "end": 401.1,
   "text": "باید به دامان اون‌ها برگردیم و قلبمون رو باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.1,
   "end": 404.2,
   "text": "اگر ختم کلام خستتون نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.2,
   "end": 410.84,
   "text": "اگر چنانچه ما از ظاهر قرآن به باطن عبور نمی‌کنیم، اگر نمی‌تونیم تدبر در قرآن کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.84,
   "end": 413.62,
   "text": "علت اصلی این است که قلب قفل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.62,
   "end": 416.74,
   "text": "چرا قلب، قلب قفل شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.74,
   "end": 423.02,
   "text": "احتیاج به به‌روزرسانی دارد به جهت اینکه ورودی‌ها، اون مواد اولیه مسموم بوده، خراب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.02,
   "end": 425.52,
   "text": "شنیده‌ها، دیده‌ها، گفته‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.52,
   "end": 435.24,
   "text": "چشیده‌ها، ملموسات، این‌هایی که لمس کردیم، هرچی تفکرات، نیات خراب بوده، مسموم بوده، قلب رو قفل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.24,
   "end": 437.84,
   "text": "قلب باید دو، دو، دو مرتبه چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.84,
   "end": 440.36,
   "text": "به‌روزرسانی بشه، باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.36,
   "end": 449.3,
   "text": "علت شرکت کردن ما در جلسات روضه سید الشهدا که بر-- به قول مرحوم نراقی بهترین کار و سریع‌ترین کار برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.3,
   "end": 451.48,
   "text": "به‌روزرسانی قلبه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.48,
   "end": 456.28,
   "text": "علت زانو زدن در برابر قرآن، علت نشستن پای جلسات علما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.28,
   "end": 459.94,
   "text": "این قلب به‌روز بشه، قفلش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.94,
   "end": 465.02,
   "text": "یواش یواش شروع کنیم به به‌روزرسانی وجودمون و انشاالله حقایق رو بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.02,
   "end": 467.22,
   "text": "این بحث ادامه داره. انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.22,
   "end": 471.4,
   "text": "عاقبت هممون ختم به خیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.4,
   "end": 471.74,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}