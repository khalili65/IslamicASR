  {
   "index": 1,
   "title": "## قلب؛ قوه‌ای از قوای نفس",
   "start": 254.44,
   "end": 318.16
  },
  {
   "index": 2,
   "title": "## توحید صمدی؛ شؤون حق",
   "start": 318.16,
   "end": 476.42
  },
  {
   "index": 3,
   "title": "## لا یشغله شأن عن شأن",
   "start": 476.42,
   "end": 549.68
  },
  {
   "index": 4,
   "title": "## منجم عرّاف و چهار هزار عالم",
   "start": 549.68,
   "end": 644.62
  },
  {
   "index": 5,
   "title": "## اتصال انقلاب به امام عصر",
   "start": 644.62,
   "end": 664.68
  },
  {
   "index": 6,
   "title": "## بیابان و طرید شرید",
   "start": 664.68,
   "end": 804.14
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 6.0,
   "text": "و به 你 استعین. السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.0,
   "end": 8.96,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.96,
   "end": 11.16,
   "text": "ضمن تبریک به مناسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.16,
   "end": 15.24,
   "text": "این شب بسیار با عظمت و بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.24,
   "end": 21.3,
   "text": "عرض شود خدمتتون که حالا هدیه این صحبت‌ها که کم هم نیست این صحبت‌ها وزنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.3,
   "end": 24.94,
   "text": "درسته از دهانه آلوده‌ای مثل ما بر میاد، بیرون میاد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.94,
   "end": 29.02,
   "text": "چون شاخه‌نباتی از آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.02,
   "end": 32.16,
   "text": "نور داره انشاالله برسه به روح امام عزیز و شاهدامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.16,
   "end": 35.8,
   "text": "بحث ما پیرامون قلب مغفول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.8,
   "end": 40.56,
   "text": "قبل-- قلبی که قفل زده شده که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.56,
   "end": 49.36,
   "text": "وقتی بحث تدبر در قرآن که وظیفه ما هست مطرح میشه بلافاصله قرآن می‌فرماید \"ام على قلوب اخفالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.36,
   "end": 52.22,
   "text": "اگر کسی درگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.22,
   "end": 55.4,
   "text": "تدبر در قرآن نبود گيره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.4,
   "end": 58.46,
   "text": "به جهت قفل بودن قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.46,
   "end": 65.12,
   "text": "ما وقتی که بحث قلب رو و شهود رو مطرح کردیم شاید برای بعضی از اذهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.12,
   "end": 68.02,
   "text": "این پیش بیاد که آقا چرا انقدر سختش می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.02,
   "end": 70.4,
   "text": "چرا انقدر مشکلش می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.4,
   "end": 75.0,
   "text": "چرا انقدر دست‌انداز جلوی مسیر مثلاً بندگی ما قرار میدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.0,
   "end": 78.58,
   "text": "حالا یه قرآنه می‌خونیم، کیف هم می‌کنیم، لذت هم می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.58,
   "end": 84.94,
   "text": "دیگه تدبر و شهود قلبی و رفتن از ظاهر به باطن قرآن، این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.94,
   "end": 88.42,
   "text": "اینا همه به جهت اینه که متأسفانه ما مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.42,
   "end": 90.36,
   "text": "وجودی خودمون رو خوب نشناختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.36,
   "end": 93.88,
   "text": "یعنی در سیر معرفت نفس درست حرکت نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.88,
   "end": 97.82,
   "text": "من یه سوال از شما بکنم. شما عزیزان که حالا کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.82,
   "end": 101.22,
   "text": "مخاطب بحث ما هستند فقط نه همه شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.22,
   "end": 107.28,
   "text": "بفرمایید ببینم وقتی که شما خواب هستید این نفس ناطقه شما مشغول چه کارهاییه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.28,
   "end": 111.98,
   "text": "مگر شما معتقد نیستید که رفته به برزخ، رفته به عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.98,
   "end": 116.64,
   "text": "این نفس ناطقه شما انصراف قطعیه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.64,
   "end": 120.24,
   "text": "بدن حاصل نشده بینش که، انصراف نداده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.24,
   "end": 123.94,
   "text": "توجهش کم شده به این بدن دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.94,
   "end": 126.58,
   "text": "ولی هنوز متوجه به این بدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.58,
   "end": 132.44,
   "text": "در عین حال توجه بیشترش به بدن برزخی شما شده لذا اون بدن فعال شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.44,
   "end": 136.12,
   "text": "و در عالم خواب شما می‌رید این همه صور و اشکال می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.12,
   "end": 137.78,
   "text": "این همه جاها می‌رید می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.78,
   "end": 140.18,
   "text": "این همه با این و اون حرف می‌زنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.18,
   "end": 144.9,
   "text": "در آن واحد بدن شما تمام قواش داره کار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.9,
   "end": 147.4,
   "text": "تو رو خدا رو این قسمت فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.4,
   "end": 153.62,
   "text": "یعنی همین بدنی که ظاهراً نفس ناطقه شما تازه توجهش بهش کم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.62,
   "end": 155.78,
   "text": "مخصوصاً مثال خواب رو زدم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.78,
   "end": 158.98,
   "text": "و الا همین الان تو بیداری که شما ببینی نفس شما چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.98,
   "end": 167.12,
   "text": "تدبیری داره نسبت به همین نظام ظاهری وجود شما که بدن شماست و انزل مراتب وجودی شماست داره انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.12,
   "end": 169.5,
   "text": "ببینید حواس ظاهریتون همه مشغوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.5,
   "end": 176.78,
   "text": "اینا ز-- در حقیقت ااا آثار وجودی نفسن و الا یک لحظه انصراف ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.78,
   "end": 180.36,
   "text": "ل-لولا الحجة لساخت الأرض بأهلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.36,
   "end": 185.38,
   "text": "یک حالا می‌تونیم بگیم لولا نفس ناطقه لساخت البدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.38,
   "end": 189.5,
   "text": "یک آن نفس ناطقه تو انصراف بده از بدن، این بدن متلاشی می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.5,
   "end": 193.98,
   "text": "همون مرگه. درست شد این جسمیت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.98,
   "end": 200.26,
   "text": "ولی در عین حال تمام حواس پنج گانه شما داره کار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.26,
   "end": 203.88,
   "text": "و قوای حاظمه، دافعه، ماسکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.88,
   "end": 208.42,
   "text": "نامیه، جاذبه همه داره کار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.42,
   "end": 213.2,
   "text": "و در عین حال میلیاردها بعضیا که میگن تریلیون تریلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.2,
   "end": 216.08,
   "text": "وقتی جزئی‌تر می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.08,
   "end": 219.26,
   "text": "سلول در بافت‌های مختلف بدن ما وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.26,
   "end": 222.46,
   "text": "همه اینا رو به عینه داره نفس ناطقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.46,
   "end": 224.82,
   "text": "آن به آن مدیریت می‌کنه، تدبیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.82,
   "end": 229.82,
   "text": "همش کار نفسه. آخه شوخی نیست قدرت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.82,
   "end": 233.48,
   "text": "حالا شما برو تو خوابشو اصلاً دیگه خواب مثال زنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.48,
   "end": 235.94,
   "text": "خب میگم توجه، دقت کنید به این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.94,
   "end": 239.5,
   "text": "توجه نفس به حداقل رسیده به این بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.5,
   "end": 242.5,
   "text": "با این حال تمام قواش داره کار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.5,
   "end": 247.18,
   "text": "بعد از اون طرف چقدر عالم میری می‌بینی در عالم خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.18,
   "end": 249.42,
   "text": "همه اینا به چه قدرتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.42,
   "end": 251.94,
   "text": "به قدرت نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.94,
   "end": 254.44,
   "text": "ما متأسفانه نفسمون رو خوب نشناختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.44,
   "end": 258.22,
   "text": "یکی از قوای نفس ما قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.22,
   "end": 263.2,
   "text": "این همه قوا رو داره مدیریت می‌کنه یکیش قوا، یکیش قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.2,
   "end": 267.96,
   "text": "که دیگه اون باطنی‌ترین لایه‌های درونی‌مون است که البته از اون باطنی‌تر هم ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.96,
   "end": 272.46,
   "text": "دیگه بعدش می‌شه روح و سر و سر و سر و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.46,
   "end": 277.56,
   "text": "میگیم آقا جان شما می‌تونی، چرا نمی‌تونی با قلبت به کشف و شهود برسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.56,
   "end": 279.98,
   "text": "چرا؟ چرا فکر می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.98,
   "end": 282.1,
   "text": "اینکه آقا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.1,
   "end": 283.98,
   "text": "نمی‌شه اینا مال نفوس ضعیفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.98,
   "end": 289.62,
   "text": "ما نفسمون رو نشناختیم. انقدر ولش کردیم مثل بدنی که تو رهاش کن بهش نرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.62,
   "end": 291.42,
   "text": "آیا چند روز می‌تونه تحمل کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.42,
   "end": 294.36,
   "text": "ضعیف و لاغر و بعدشم می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.36,
   "end": 297.98,
   "text": "نفسمون چون نشناختیمش غذاش چیه، چگونه باهاش رفتار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.98,
   "end": 302.0,
   "text": "اینطوری ولش کردیم این داره هی ضعیف می‌شه، هی بنیه‌اش از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.0,
   "end": 306.38,
   "text": "اینطوری شده که می‌خوایم نماز بخونیم صدای کلاغ ما رو آزار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.38,
   "end": 310.14,
   "text": "س-- بدتر از اون صدای دعا خوندن یکی بغلمون آزارمون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.14,
   "end": 314.84,
   "text": "میگه آقا آهسته‌تر دعا کن من حواسم پرت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.84,
   "end": 317.84,
   "text": "مگر این، مگر ما توحیدمون توحید صمدی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.84,
   "end": 321.44,
   "text": "مگر هو الاول والآخر والله الرا والباطن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.44,
   "end": 325.38,
   "text": "مگر صمد این نیست که الذي لا جوف له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.38,
   "end": 328.2,
   "text": "پره، پره. هیچ جا خالی از خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.2,
   "end": 330.54,
   "text": "پس اون صدای کلاغ هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.54,
   "end": 332.88,
   "text": "خودش نشانه حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.88,
   "end": 336.06,
   "text": "اونم شأنی. خود کلاغ اصلاً یکی از شؤون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.06,
   "end": 340.2,
   "text": "ولایت کلیه‌ست. کلاغ که چه عرض کنم همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.2,
   "end": 342.9,
   "text": "تمام ذرات موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.9,
   "end": 345.02,
   "text": "همه و همه به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.02,
   "end": 347.92,
   "text": "شؤون حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.92,
   "end": 350.88,
   "text": "یکیش هم شمایی. اصلاً همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.88,
   "end": 353.76,
   "text": "در حقیقت شؤون خداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.76,
   "end": 356.54,
   "text": "طورهای مختلف حضرت حق‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.54,
   "end": 359.96,
   "text": "جلوه کردن در عالم. یه طورش اینه، یه طورش اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.96,
   "end": 365.18,
   "text": "مثل تو که یه طورت نشستنه، یه طورت خوابیدنه، یه طورت حرف زدنه، یه طورت دیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.18,
   "end": 369.34,
   "text": "خدای منان هم اصلاً چیزی جز خدا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.34,
   "end": 371.52,
   "text": "به طورهای مختلف ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.52,
   "end": 373.94,
   "text": "آیاتشم. نشون داده خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 373.94,
   "end": 381.12,
   "text": "بعد تو میخوای بشینی بگی آقا کلاغه، آقا مثلا سگه شما هاپ هاپ نکنید، قاقار نکنید آقا ذکرتو نگو آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.12,
   "end": 382.58,
   "text": "درا رو ببندید آقا یه جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.58,
   "end": 390.14,
   "text": "سکوت من میخوام یه خدایی رو پیدا کنم جداای از این کلاغ و سگ و آسمان و زمین و انسان‌ها و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.14,
   "end": 393.58,
   "text": "یه خدایی یه گوشه‌ای هست میخوام اونو پیداش کنم باهاش مرتبط شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 393.58,
   "end": 399.24,
   "text": "این چه خداییه؟ مگر خدایی نیست که همه جا هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.24,
   "end": 400.78,
   "text": "میشه کلاغ بی‌خدا باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.78,
   "end": 403.96,
   "text": "یعنی کلاغ جدایی از خدا باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.96,
   "end": 406.8,
   "text": "میشه آسمان و زمین جدایی از خدا باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.8,
   "end": 408.84,
   "text": "نه. این بحث‌ها بحث‌های قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 408.84,
   "end": 412.02,
   "text": "یعنی بحث‌هایی که اینا قلب باید به شهودش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.02,
   "end": 414.9,
   "text": "توحید قلبی، توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 414.9,
   "end": 422.38,
   "text": "صمدی قرآن چون بحث قلبه البته انقدر نفوس ضعیف شده هرکسی هم نمی‌تونه بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 422.38,
   "end": 425.42,
   "text": "زجر می‌کشه از شنیدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.42,
   "end": 430.16,
   "text": "ولی ج-- راهی جز این نیست. مگر یه خدا بیش ما- بیشتر ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 430.16,
   "end": 436.86,
   "text": "اگر قرار باشه این کلاغه، این صدای این سگه، این س-- آسمان و زمین جدایی از خدا باشن پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.86,
   "end": 440.3,
   "text": "میشه توحید، توحید عددی که پس این آسمون و زمین چی‌ند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.3,
   "end": 443.56,
   "text": "یعنی یه خدای یه گوشه یه آسمون خلق کرده گذاشته اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.56,
   "end": 446.32,
   "text": "پس این آسمونه چیه؟ جدایی از خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.32,
   "end": 448.26,
   "text": "مگر خدا نمیگه همه جا هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.26,
   "end": 450.72,
   "text": "مگر الذي لا جوف له نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.72,
   "end": 454.12,
   "text": "اصلا پره پره. هیچ جا خالی از خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 454.12,
   "end": 458.14,
   "text": "تو وقتی اینطوری دیدی همه چی رو شؤون حضرت حق می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.14,
   "end": 460.62,
   "text": "قرآن هم یک تجلی اعظم حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.62,
   "end": 465.14,
   "text": "بعد به شهود قلبی می‌رسی. میگی اصلا قرآن داره، خدا داره با من حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.14,
   "end": 469.08,
   "text": "وقتی تو اینو اینطوری دیدی س-- وقتی قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.08,
   "end": 472.78,
   "text": "حرف خدا با خودت دیدی با تمام وجودت می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 472.78,
   "end": 476.42,
   "text": "بعد هیچ‌چی هم رهزن وجود تو نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.42,
   "end": 478.88,
   "text": "حالا شما بیا اینطوری نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 478.88,
   "end": 484.4,
   "text": "اشکالاتی که می‌گن چطور امیرالمؤمنین صلوات الله علیه در حال رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.4,
   "end": 489.68,
   "text": "صدقه داد، انگشترشو درآورد، حواسش پرت نشد از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.68,
   "end": 492.18,
   "text": "ببین نفوس ضعیفه اینطوری میگن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.18,
   "end": 494.54,
   "text": "اصلا حوا-- چرا حواسش پرت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 494.54,
   "end": 498.4,
   "text": "اساسا بدونید عزیزان رو این کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 498.4,
   "end": 505.96,
   "text": "اصلا نفس ناطقه من و شما بدون استثنا مظهر اسم يا من لا يشغله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 505.96,
   "end": 510.04,
   "text": "شأن عن شأن. یکی از اسمای خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 510.04,
   "end": 512.56,
   "text": "نفس ناطق ما مظهر این اسم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.56,
   "end": 517.74,
   "text": "یعنی هیچ شأنی از شؤون دیگه اونو غافل نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.74,
   "end": 521.16,
   "text": "رفته تو باطن وجود این عالم، تو خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.16,
   "end": 523.0,
   "text": "باطنه دیگه. عالم مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.0,
   "end": 527.92,
   "text": "برزخ. رفته اونجا. ولی از بدن که ظاهره، مرتبه ظاهریه غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.92,
   "end": 531.08,
   "text": "باز بدن نفس می‌کشه، قلب داره کار می‌کنه همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.08,
   "end": 534.4,
   "text": "غافل نیست. اص-اصلا یک لحظه تدبیرشو برنمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.4,
   "end": 536.46,
   "text": "چطور ما از خودمون دست کم بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.46,
   "end": 541.92,
   "text": "بگیم نه من فعلا با فکرم قرآن بخونم، با قوای سامعه‌م فقط بشنوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 541.92,
   "end": 543.66,
   "text": "فقط ه-- تکلم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 543.66,
   "end": 547.54,
   "text": "نمی‌خوام برم، نمی‌تونم برم به مرتبه باطن با قلبم به کشف و شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.54,
   "end": 552.16,
   "text": "این حرفا چیه؟ مگر اون داستان منجم عراف رو نشنیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 552.16,
   "end": 555.96,
   "text": "آخه چرا-- کی دیگه ما می‌خوایم اینارو بشینیم با همدیگه بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.96,
   "end": 560.28,
   "text": "محضر امام سجاد صلوات الله علیه رسید منجم عـ-عراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 560.28,
   "end": 564.46,
   "text": "عراف بر وزن فعال یعنی خیلی دانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.46,
   "end": 566.34,
   "text": "منجم بود، ستارشناس، دانشمند بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.34,
   "end": 570.34,
   "text": "رسید به حضرت. خب حضرت این استعدادو درش دید که گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.34,
   "end": 580.12,
   "text": "فرمود که آقا، آقای عراف شما بفرمایید ببینم میشه یک انسان همین الان چهار هزار عالم رو بره طی کنه بیاد یک آن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.12,
   "end": 583.36,
   "text": "ایشون چون دانا بود حرف شنیده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.36,
   "end": 585.12,
   "text": "رد نکرد اما براش سنگین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.12,
   "end": 587.22,
   "text": "گفت چطور میشه حاج آقا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 587.22,
   "end": 591.46,
   "text": "آقا، حضرت عرض کرد چگونه میشه آقا اینطوری بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 591.46,
   "end": 596.42,
   "text": "یا علی ابن الحسین. حضرت فرمودند که ببینید یه جلوه‌ای کرد حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.42,
   "end": 600.68,
   "text": "فرمودند که شما یه صندوقچه‌ای تو خونه‌ت نداری تو کمدت این نشونه‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 600.68,
   "end": 604.12,
   "text": "بعد انقدر درهم توش پول داری اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.12,
   "end": 607.72,
   "text": "این چه می‌دونم لای بخچه گذاشته همه رو آدرس داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 607.72,
   "end": 610.38,
   "text": "گفت چرا؟ حضرت-- گفت چرا اینا رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 610.38,
   "end": 614.7,
   "text": "حضرت فرمود یک آن من چهار هزار عالمو تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.7,
   "end": 617.9,
   "text": "لحظه‌ای که محضر شما بودم سیر کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.9,
   "end": 621.3,
   "text": "همه چی رو دیدم اما در حال حاضر در ها-- آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.3,
   "end": 624.0,
   "text": "همین آن از شمام غافل نشدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.0,
   "end": 626.74,
   "text": "و اون صندوقچه شمارم خواستم ببینم، دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.74,
   "end": 628.98,
   "text": "میشه پس رفت و اومد. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.98,
   "end": 636.5,
   "text": "ما نمیگیم تا اون حد که. اما نفس ناطقه ما این قدرت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 636.5,
   "end": 641.06,
   "text": "که خب اون نفس کلیه البته به کمک ما میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.06,
   "end": 644.62,
   "text": "نفس کلیه کیه؟ امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 644.62,
   "end": 648.54,
   "text": "جمعه محضر حضرت آقای صدیقی بودیم این خاطره‌م بگیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 648.54,
   "end": 652.34,
   "text": "چون شب بیست و دو بهمن هم هست تبرک هم بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 652.34,
   "end": 654.52,
   "text": "محضر آقای صدیقی بودیم. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 654.52,
   "end": 659.1,
   "text": "خاطراتی می‌گفتن تو امامزاده صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 659.1,
   "end": 661.72,
   "text": "اونجا منبر می‌رفتند ما پا منبرشون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 661.72,
   "end": 665.98,
   "text": "ایشون فرمودند که در اثبات اینکه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 665.98,
   "end": 669.2,
   "text": "انقلاب متصله به حضرت ولی عصر و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 669.2,
   "end": 675.44,
   "text": "یه خاطره‌ای می‌گفت. از آقای مظاهری اصفهان یادش به خیر ما محضر ایشون درس می‌خوندیم اصفهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 675.44,
   "end": 678.52,
   "text": "با آقای مظاهری یه نامه نوشت به آقا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.52,
   "end": 680.44,
   "text": "آبستن فتنه شده اصفهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 680.44,
   "end": 683.06,
   "text": "یه فکری بکنید. آقا فرمودند-- من خلاصشو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 683.06,
   "end": 686.62,
   "text": "آقا فرمودند به نظر-- شما چه پیشنهادی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 686.62,
   "end": 692.58,
   "text": "آقای مظاهری فرمودند یه بیانیه‌ای، نامه‌ای چیزی بنویسید خطاب به مردم ولایتی اصفهان و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 692.58,
   "end": 695.32,
   "text": "آقام رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 695.32,
   "end": 697.12,
   "text": "پای برهنه زد به بیابون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 697.12,
   "end": 699.4,
   "text": "هیچکس هم اجازه نداد دنبالش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 699.4,
   "end": 702.94,
   "text": "با یه لباس مبدل و رفت تو بیابون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 702.94,
   "end": 704.94,
   "text": "سر برهنه، پای برهنه کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 704.94,
   "end": 708.82,
   "text": "بیابون چرا؟ الطرید الشرید الفرید الوحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 708.82,
   "end": 713.06,
   "text": "امام عصرمون رو امیرالمؤمنین تو نهج البلاغه اینطوری معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 713.06,
   "end": 716.58,
   "text": "ترید طرد شده. شرید آواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 716.58,
   "end": 719.7,
   "text": "تو بیابونه دیگه. آقا رهبر زد به بیابون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 719.7,
   "end": 721.6,
   "text": "حالا چی شد؟ چی نشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 721.6,
   "end": 728.52,
   "text": "چجوری اتصال با-- دیدی هر وقتم گره‌ای تو انقلاب می‌افته ایشون ج-- یا جمع-جمع کرانه یا مشهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 728.52,
   "end": 736.06,
   "text": "رفت و برگشت و به توسط و با توجه به امام عصر یه بیانیه نوشت خطاب به انقلابیون اصفهان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.06,
   "end": 741.88,
   "text": "بعد مردم ولایتی اصفهان ریختن بیرون و اصلا بساط هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 741.88,
   "end": 744.26,
   "text": "مخالف ولایت و انقلاب بودو برچیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 744.26,
   "end": 748.0,
   "text": "اصلا کسی دیگه جرات نکش-- نکرد بیاد بیرون نفس بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 748.0,
   "end": 754.6,
   "text": "ببین اون نفس کلیه الهیه میاد ضعف‌هایی هم اگر هست تو ماها رو برطرف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 754.6,
   "end": 756.78,
   "text": "همیشه تو این چالش‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 756.78,
   "end": 759.54,
   "text": "انقلاب توسط اونا حمایت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 759.54,
   "end": 765.84,
   "text": "من و شما حالا به جزء شؤون کل جزء شم-من و شمام نفس داریم که یک جزئی از اون کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 765.84,
   "end": 772.02,
   "text": "چرا نشینیم به توجه عرفانی و قلب-قلبی بر سفره قرآن در حالی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 772.02,
   "end": 781.04,
   "text": "یه بار دیگه بگم یادآوری. در حالی که قرآن می‌فرماید افلا يتدبرون القرآن آیا تدبر در قرآن نمی‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 781.04,
   "end": 784.04,
   "text": "أم على قلوب أقفالها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 784.04,
   "end": 790.52,
   "text": "خب این قفل، قلب قفلو باز کنیم تا بتونیم به کشف و شهود قرآن بنشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 790.52,
   "end": 793.58,
   "text": "قفل شده قلب باید باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.58,
   "end": 798.7,
   "text": "ان شا الله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 798.7,
   "end": 804.14,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}