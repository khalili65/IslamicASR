   "start": 96.8,
   "end": 141.28
  },
  {
   "index": 2,
   "title": "## حدیث امام صادق؛ فتح و ختم مسامع قلب",
   "start": 141.28,
   "end": 384.37
  },
  {
   "index": 3,
   "title": "## تفسیر انفسی و آفاقی؛ حرف‌شنو باش",
   "start": 384.37,
   "end": 536.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.96,
   "end": 5.14,
   "text": "به فضل الهی ما از دیروز به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 8.18,
   "text": "شروع و آغاز دهه فجر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.18,
   "end": 11.66,
   "text": "قدوم مبارک حضرت امام نیت کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.66,
   "end": 15.7,
   "text": "دل به دریا زدیم و رسماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.7,
   "end": 19.5,
   "text": "برنامه نمازخونه رو طبق روال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.5,
   "end": 23.56,
   "text": "ادامه دادیم و شروعش کردیم دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.56,
   "end": 27.12,
   "text": "تا توکل به خدا ببینیم به کجا می‌انجامد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.12,
   "end": 30.78,
   "text": "به قول خودتون بعضی از دوستان گفتن دلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.78,
   "end": 34.22,
   "text": "خیلی تنگه این جماعت‌ها بود، تنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.22,
   "end": 36.24,
   "text": "حتی وعظ و موعظه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.24,
   "end": 42.9,
   "text": "گفتن از آیات و روایات بوده و هست که این البته نشانه خوبیست، نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.9,
   "end": 45.18,
   "text": "مفتوح بودن قلب‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.18,
   "end": 49.2,
   "text": "اینکه کسی دلش تنگ بشه برای موعظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.2,
   "end": 55.86,
   "text": "نشانه مفتوح بودن قلبشه نه مغفول با قاف یعنی قفل شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.86,
   "end": 57.7,
   "text": "و خیلی خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.7,
   "end": 63.06,
   "text": "بعضیا گوششون پر شده، اصلاً حوصله شنیدن حرف رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.06,
   "end": 65.16,
   "text": "این خیلی خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.16,
   "end": 68.62,
   "text": "نشون دهنده قلب قفل شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.62,
   "end": 73.56,
   "text": "که اصلاً حوصله شنیدن حرف حتی حق رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.56,
   "end": 76.5,
   "text": "در حالی که قرآن یکی از خصوصیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.5,
   "end": 79.26,
   "text": "پیرامون پیامبر اعظم شأن اسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.26,
   "end": 82.66,
   "text": "می‌فرماید گوش خوبیه، گوش، گوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.66,
   "end": 87.88,
   "text": "خوب گوش میده. اصلاً می‌خواید محک بزنید خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.88,
   "end": 91.9,
   "text": "ببینیم که آیا ما قلبمون انشاالله مفتوح هست یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.9,
   "end": 96.8,
   "text": "اینه که ببینیم خوب حرف گوش میدیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.8,
   "end": 103.94,
   "text": "بحث ما قبلاً که بعد منقطع شد متأسفانه به جهت کرونا بحث قلب مغفول بود اساساً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.94,
   "end": 114.28,
   "text": "مونده بودیم رو آیه بیست و چهار سوره حضرت محمد صلى الله عليه و آله وسلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.28,
   "end": 116.26,
   "text": "که چند جلسه بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.26,
   "end": 121.44,
   "text": "افلا يتدبرون القرآن ام على قلوب اقفالها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.44,
   "end": 125.4,
   "text": "که می‌فرماید، \"آیا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.4,
   "end": 128.86,
   "text": "تدبر نمی‌کنند در قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.86,
   "end": 133.9,
   "text": "یا اینکه علت اینکه این‌ها تدبر نمی‌کنند به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.9,
   "end": 136.02,
   "text": "قلבشون مغفول شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.02,
   "end": 139.0,
   "text": "ام على قلوب اقفالها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.0,
   "end": 142.66,
   "text": "قلب قفل شده.\" حالا یه حدیث خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.66,
   "end": 149.3,
   "text": "شیرین و قشنگ از امام صادق صلوات الله علیه بگم ما که بلد نیستیم که آیات رو باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.3,
   "end": 153.02,
   "text": "باید ببینیم معصوم که لسان قرآنه چی فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.02,
   "end": 156.82,
   "text": "حضرت زیل این آیه این چنین فرمودند در تفسیر جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.82,
   "end": 160.86,
   "text": "ام على قلوب اقفالها. اینو هدیه کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.86,
   "end": 166.12,
   "text": "نوش جان عزیزان. حضرت فرمودند ان لك قلبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.12,
   "end": 173.0,
   "text": "و مساماً قطعاً برای تو قلبی است که این قلب گوش‌هایی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.0,
   "end": 176.26,
   "text": "و ان الله اذا اراد ان يهدي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.26,
   "end": 184.32,
   "text": "عبداً هر وقت که خدا اراده کنه هدایت کنه بنده‌شو فتح مسام قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.32,
   "end": 191.74,
   "text": "این گوش‌های دقت کنید بحث گوش، گوش‌های قلب رو گفتم نشونه قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.74,
   "end": 194.3,
   "text": "مفتوح اینه که گوش میده خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.3,
   "end": 197.3,
   "text": "اهل گوش دادنه. مسام قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.3,
   "end": 201.48,
   "text": "این گوش‌های قلبش رو خدا باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.48,
   "end": 205.62,
   "text": "فتح مسام قلب و اذا اراد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.62,
   "end": 208.8,
   "text": "خدایی نکنه که یه وقت خدا اراده کنه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.8,
   "end": 214.36,
   "text": "اعمال خود بنده اراده کنه که چی کار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.36,
   "end": 217.02,
   "text": "این گوش رو کر کنه به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.02,
   "end": 219.24,
   "text": "و اذا اراد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.24,
   "end": 222.48,
   "text": "غير ذلك، غير ذلك یعنی غیر هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.48,
   "end": 226.6,
   "text": "یعنی اگر خدا خواست که بنده‌ای رو رها کنه برا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.6,
   "end": 229.12,
   "text": "به قاعده اعزال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.12,
   "end": 231.88,
   "text": "یا یضل میه شو رهاش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.88,
   "end": 236.12,
   "text": "حالا بهتره بگیم گمراه رها ک-رها کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.12,
   "end": 241.0,
   "text": "نگیم گمراه کنه چون خدا که گمراه نمی‌کنه، رها می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.0,
   "end": 244.28,
   "text": "خود بنده قدم به سمت گمراهی برمیداره، خدا رها می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.28,
   "end": 246.24,
   "text": "غير ذلك یعنی غیر هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.24,
   "end": 250.8,
   "text": "چه اتفاقی میفته؟ ختم مسام قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.8,
   "end": 254.34,
   "text": "مهر می‌زنه خدا رو اون گوش‌های قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.34,
   "end": 256.44,
   "text": "ببینید بحث، بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.44,
   "end": 259.3,
   "text": "مغفوله. قلب مغفوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.3,
   "end": 262.78,
   "text": "اما تو روایت آقا داره اشاره به گوش قلب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.78,
   "end": 264.96,
   "text": "میگه هرچی هست از گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.96,
   "end": 269.96,
   "text": "اینه که از تعلم حسن زاده حفظه الله تعالی بسیار اون از آنی که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.96,
   "end": 273.92,
   "text": "آثار ایشون حشر و نشر دارن می‌دونن خیلی تأکید رو حرف شنیدن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.92,
   "end": 276.56,
   "text": "میگه باید حرف بشنوید. حرف بشنوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.56,
   "end": 281.18,
   "text": "تا این حرف‌ها انقدر بشنوید تا پیاده بشه تو وجودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.18,
   "end": 286.88,
   "text": "خود ایشونم چندین سال دیگه قبلاً عرض شده دیگه هفده سال صبح علی التلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.88,
   "end": 288.78,
   "text": "تا آخر شب زانو می‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.78,
   "end": 291.26,
   "text": "همش حرف می‌شنیده از اساتید و بزر...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.26,
   "end": 293.72,
   "text": "ما چند چقدر حرف می‌شنویم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.72,
   "end": 297.34,
   "text": "خود بنده چقدر؟ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.34,
   "end": 301.28,
   "text": "بعدش هم که چندین سال یک یک اساتید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.28,
   "end": 305.8,
   "text": "می‌فرماید ختم مسامع مسامع قلب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.8,
   "end": 308.56,
   "text": "قلبش گوش قلبش مهر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.56,
   "end": 311.06,
   "text": "دیگه حاضر نیست حرف بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.06,
   "end": 315.18,
   "text": "فلا يصلح خیلی خطره‌ها اینو آخر حدیثو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.18,
   "end": 317.46,
   "text": "نهیب عجیبی حضرت زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.46,
   "end": 321.16,
   "text": "کسی که حاضر نیست حرف گوش بده فلا يصلح ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.16,
   "end": 326.3,
   "text": "اصلاً ابدا اصلاً ابداً دیگه براش صلح، صلاحی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.3,
   "end": 330.96,
   "text": "اصلاح در کارش نیست. مگه نمیگی يا أبا صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.96,
   "end": 334.92,
   "text": "أين بقية الله؟ کجاست این آقایی که قراره بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.92,
   "end": 339.74,
   "text": "صلح و عرض شود اصلاح ایجاد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.74,
   "end": 344.3,
   "text": "که همه از یک ریشه است. صلاح، اصلاح، عمل صالح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.3,
   "end": 347.5,
   "text": "مصلح، أبا صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.5,
   "end": 352.3,
   "text": "خب اگر من قلبم قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.3,
   "end": 357.46,
   "text": "مغفول بود آقام بیاد برای من هیچ فایده‌ای نداره چون می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.46,
   "end": 359.86,
   "text": "فلا يصلح ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.86,
   "end": 363.42,
   "text": "أبا صالح هم بیاد فلا يصلح ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.42,
   "end": 370.37,
   "text": "اینه که بسیاری متأسفانه از دیندارها حدیث داریم جلوی حضرت می‌ایستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.37,
   "end": 372.15,
   "text": "جلای علم دین می‌ایستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.15,
   "end": 377.73,
   "text": "در حالی که وجهه‌ی دین دارد حتی متأسفانه کسانی که لباس پیغمبر تن‌شون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.73,
   "end": 381.51,
   "text": "وجهه‌ی علم و دیانت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.51,
   "end": 384.37,
   "text": "تو روایات داریم. خیلی خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.37,
   "end": 385.91,
   "text": "و هو قول الله تعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.91,
   "end": 389.81,
   "text": "اینجا حضرت اشاره میکنه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.81,
   "end": 392.45,
   "text": "آیه قرآن. چون اون‌ها چیزی جز قرآن نمیگن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.45,
   "end": 399.35,
   "text": "اون‌ها در ح-حقیقت اح-- اساساً احادیث و روایات اهل بیت علیهم الصلاة والسلام به قول علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.35,
   "end": 401.71,
   "text": "تفسیر انفسی آیات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.71,
   "end": 405.45,
   "text": "یعنی اینکه تو این آیه رو میخوای چگونه در وجود خود پیاده کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.45,
   "end": 407.81,
   "text": "میشه تفسیر انفسی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.81,
   "end": 414.69,
   "text": "اینکه آیه کی نازل شده، شأن نزولش چیه، بر اساس چه تاریخی نازل شد، چرا، اینا میشه تفسیر آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.69,
   "end": 418.25,
   "text": "تفسیر انفسی یعنی این قرآن پیاده شده--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.25,
   "end": 420.03,
   "text": "بشود در تو. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.03,
   "end": 427.77,
   "text": "با روایات، با احادیث. مثل الان که امام صادق داره توضیح میده چگونه این آیه پیاده میشه در وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.77,
   "end": 430.91,
   "text": "باید به گونه‌ای رفتار کنی که حرف‌شنو باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.91,
   "end": 437.99,
   "text": "این ختم کلامه. تمام همه‌ی حرف این آیات و این حدیث رو من تو یه کلمه جمع کنم، این حرف‌شنو باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.99,
   "end": 442.39,
   "text": "بعد حضرت اشاره میکنه همه‌ی این بحث‌ها رو جمع میکنه زیر همین آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.39,
   "end": 445.25,
   "text": "\"و هو قول الله تعالی عز وجل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.25,
   "end": 447.19,
   "text": "که چی؟ \"ام على قلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.19,
   "end": 453.41,
   "text": "اقفالها\" که حالا باید مراقب باشیم قفل نخوره که خوش به حال کسی که قلبش مفتوحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.41,
   "end": 455.51,
   "text": "نشانه قلب مفتوح هم اینه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.51,
   "end": 459.35,
   "text": "خوب حرف گوش میده. یه نشونه‌ی دیگه‌ای هم داره اگه گفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.35,
   "end": 462.85,
   "text": "امروز صبح اینجا الحمد لله بعضیا جمع شدن زیارت عاشورا خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.85,
   "end": 467.37,
   "text": "یه نشونه‌ی دیگه‌ای که در عرفان براش بیان شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.37,
   "end": 475.53,
   "text": "فرمودن حالا تو فلسفه در حکمت میگن حرف گوش کردن تو مسائل علمی حق، حکمت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.53,
   "end": 478.87,
   "text": "تو عرفان بهش میگن تقلب قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.87,
   "end": 483.67,
   "text": "تقلب. اصلاً قلب اسمش قلب از جهته که دائم در انقلابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.67,
   "end": 489.69,
   "text": "دهه انقلاب هم هست دیگه. پیروزی انقلاب، انقلاب، منقلب شدن یا مقلب القلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.69,
   "end": 493.55,
   "text": "والابصار. اساساً خداست که این تقلب رو ایجاد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.55,
   "end": 497.33,
   "text": "تقلب، منقلب میشه از درون و اشک جاری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.33,
   "end": 500.07,
   "text": "سوز، اشک، آه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.07,
   "end": 502.39,
   "text": "که یکی از اسماء خداست آه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.39,
   "end": 505.91,
   "text": "اینم یه نشونه‌ی دیگه‌ایه برای کسی که انشاالله قلبش مفتوحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.91,
   "end": 508.93,
   "text": "مراقب باشیم این بسته نشه و قفل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.93,
   "end": 514.35,
   "text": "البته این بحث ادامه داره. باید ببینیم اصلاً \"يتدبرون\" چه نوع تدبریه، چه نوع فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.35,
   "end": 516.91,
   "text": "اصلاً این تفکر بر اساس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.91,
   "end": 520.35,
   "text": "تو واژه‌ها و لغت‌ها انشاالله روزهای بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.35,
   "end": 524.03,
   "text": "قول کنیم. انشاالله که عاقبتمون به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.03,
   "end": 529.81,
   "text": "این انفجار نور انقلاب ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.81,
   "end": 536.59,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}