 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 2.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.74,
   "end": 5.46,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.46,
   "end": 12.14,
   "text": "و ربانی ای آیه. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.14,
   "end": 15.96,
   "text": "شب میلاد حضرت صدیقه کبرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.96,
   "end": 17.88,
   "text": "ان شا الله فردا البته ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.88,
   "end": 20.92,
   "text": "بچه‌ها یه جشن کوچولو اینجا می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.92,
   "end": 23.8,
   "text": "ما بحثمون رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.8,
   "end": 31.18,
   "text": "ان شا الله که عیدی‌های خیلی خوب امام عصر که امشب قطعاً شادن به همه شما متعلّدين و خانواده‌هاتون عطا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.18,
   "end": 34.3,
   "text": "صلوات دیگری ختم کنید. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.3,
   "end": 37.7,
   "text": "صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.7,
   "end": 41.12,
   "text": "و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.12,
   "end": 54.68,
   "text": "در خصوص آیه \"ام الا قلوبا اقفالها\" که عرض شده بود \"افلا يتدبرون في القرآن\"، \"ام الا قلوبا اقفالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.68,
   "end": 59.7,
   "text": "تو حوزه تدبّر گفتیم نکته‌ای رو عرض کنیم دیروز جاموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.7,
   "end": 63.08,
   "text": "دقت بفرمایید که وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.08,
   "end": 66.32,
   "text": "خدای منّان اینجا وظیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.32,
   "end": 69.86,
   "text": "ما رو، وظیفه اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.86,
   "end": 72.88,
   "text": "اسلام و ایمان رو، اهل این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.88,
   "end": 76.66,
   "text": "در حقیقت مؤمنین رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.66,
   "end": 82.2,
   "text": "تدبّر در قرآن معرفی می‌کنه که وظیفه اهل ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.2,
   "end": 85.14,
   "text": "حالا ما چقدر تدبّر در قرآن داریم نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.14,
   "end": 87.66,
   "text": "علامت سوالیه که هرکی خودش باید جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.66,
   "end": 91.16,
   "text": "وظیفه اهل ایمان تدبّر در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.16,
   "end": 97.36,
   "text": "لذا با نهیب خدا می‌فرماید \"افلا يتدبرون في القرآن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.36,
   "end": 101.26,
   "text": "منتها اینجا تدبّر رو باید درست ترجمه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.26,
   "end": 105.42,
   "text": "بسیاری از مفسرین متأسفانه درست ترجمه نکرده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.42,
   "end": 111.26,
   "text": "آمدن تفکّر رو، تدبّر رو مساوی با تفکّر گرفته‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.26,
   "end": 114.46,
   "text": "یا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.46,
   "end": 118.44,
   "text": "خیلی مثلاً عمیق‌تر شده باشن گفته‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.44,
   "end": 124.88,
   "text": "فکر عمیق، فکر عمیق کردن، تفکّر ژرف کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.88,
   "end": 127.38,
   "text": "در صورتی که این هم غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.38,
   "end": 131.5,
   "text": "فکر مربوط به در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.5,
   "end": 134.9,
   "text": "حوزه تفکّر و حواجس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.9,
   "end": 139.5,
   "text": "فکری‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.5,
   "end": 145.2,
   "text": "می‌شه گفت خیلیا علم فکری دارن یعنی کار فکری انجام دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.2,
   "end": 148.04,
   "text": "اما بازم اهل تدبّر در قرآن نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.04,
   "end": 154.12,
   "text": "اینجا سؤال پیش میاد آیا کسی که به آیات قرآن تفکر می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.12,
   "end": 157.16,
   "text": "چنین کسی هم آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.16,
   "end": 159.04,
   "text": "اهل تدبّر در قرآنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.04,
   "end": 164.42,
   "text": "یعنی وظیفه‌ش رو انجام داده؟ ببینید معمولاً ما امروزه قرآن رو تندتند می‌خونیم می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.42,
   "end": 167.26,
   "text": "یا برای ثوابش یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.26,
   "end": 170.32,
   "text": "اینکه شنیدیم دل‌ها زنگار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.32,
   "end": 174.86,
   "text": "پیغمبر فرموده راه برطرف کردن این زنگ دل قرآن خوندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.86,
   "end": 180.42,
   "text": "یا دل‌ها مریض می‌شه. دل‌ها مرض می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.42,
   "end": 183.6,
   "text": "\"في قلوبهم مرض فزادهم الله خزي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.6,
   "end": 187.52,
   "text": "حالا این راه برطرف کردنش فرمودن دو چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.52,
   "end": 192.14,
   "text": "مریضی دل. یکیش موعظه است، یکی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.14,
   "end": 199.82,
   "text": "خب یا مثلاً کسی می‌خواد به درجات برسه، به ثواب برسه، مشکلات و گره‌هاش باز شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.82,
   "end": 203.98,
   "text": "هرچی. معمولاً به این خاطر ما میریم سمت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.98,
   "end": 209.76,
   "text": "یا خیلی بخواهیم کار علمی انجام بدیم، میریم سراغ تفسیر قرآن که این آیه چرا نازل شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.76,
   "end": 213.52,
   "text": "کی نازل شد؟ هدف از نزولش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.52,
   "end": 217.76,
   "text": "سیر انف-- در حقیقت تفسیر آفاقی قرآن رو بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.76,
   "end": 221.84,
   "text": "اینا هیچ کدومش عزیز دلم منظور این آیه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.84,
   "end": 227.26,
   "text": "کسانی هم که اینطوری ترجمه کردن، ذیل این آیه اشتباه ترجمه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.26,
   "end": 230.26,
   "text": "همه بزرگان رو چشم ما اما اشتباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.26,
   "end": 232.84,
   "text": "باید فقه اللغه درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.84,
   "end": 238.58,
   "text": "بررسی بشه. یعنی بحث لغت شناسی در تفسیر یا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.58,
   "end": 241.98,
   "text": "عرض شود تدبّر در قرآن حرف اول رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.98,
   "end": 249.62,
   "text": "ما باید سیر تطوری لغات رو که طورهای مختلف در هر زمانی پیدا کردن رو بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.62,
   "end": 257.06,
   "text": "باید معنای اصطلاحی‌شو پیدا کنیم، معنای لغوی‌شو پیدا کنیم، ریشه لغت رو بشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.06,
   "end": 262.78,
   "text": "لغت شناسا چی گفتن، بعد الان در زمان ما چگونه است، اون موقع چه-چگونه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.78,
   "end": 266.26,
   "text": "اینا خیلی مهم‌اند در فهم عمیق آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.26,
   "end": 270.02,
   "text": "حالا خسته‌تون نکنیم بره از شاخه نباتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.02,
   "end": 275.88,
   "text": "اینجا خ-خیلی جالبه اگر شما خودتون اهل دقت باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.88,
   "end": 283.68,
   "text": "حوزه تدبّر در قرآن رو، اون وسیله تدبّر رو خود آیه معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.68,
   "end": 286.56,
   "text": "کجا رو معرفی کرده؟ فکر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.56,
   "end": 290.54,
   "text": "فرموده \"افلا يتدبرون القرآن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.54,
   "end": 295.64,
   "text": "اینا یا اهل قرآن، یا اهل تدبرن یا یه اتفاقی رخ داده که نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.64,
   "end": 300.24,
   "text": "اون اتفاق چیه؟ \"ام الا قلوبا اقفالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.24,
   "end": 302.74,
   "text": "اصلاً خود قرآن داره معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.74,
   "end": 306.36,
   "text": "وقتی دچار قلب مقفول شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.36,
   "end": 310.9,
   "text": "قلبی که در حقیقت قفل شده، دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.9,
   "end": 316.14,
   "text": "مقابل قلب مفتوح است و تقلب و انقلاب درش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.14,
   "end": 321.4,
   "text": "سوز و اشک و آه و اینا ندارد، خشک شده، این قلب سنگ شده هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.4,
   "end": 324.5,
   "text": "این قلب مقابله با تدبّر قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.5,
   "end": 327.5,
   "text": "پس شما بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.5,
   "end": 330.9,
   "text": "تدبّر درست رو بخواهیم معنا کنیم چی باید بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 330.9,
   "end": 338.44,
   "text": "باید بگیم در حقیقت تدبّر در قلب صورت می‌گیره، نه در فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.44,
   "end": 340.9,
   "text": "چون میگن \"الا قلوبا اقفالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.9,
   "end": 345.24,
   "text": "نمیگه یا اینکه اهل تفکر نیستن، یا اهل تدبرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.24,
   "end": 348.1,
   "text": "یا اگه نیستن علتش اینه که اهل تفکر نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.1,
   "end": 354.08,
   "text": "نه همچین حرفی نزده قرآن که شما میای تدبّر رو م-مساوی با تفکر می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.08,
   "end": 356.94,
   "text": "قلب هم جایگاه علم فکری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.94,
   "end": 359.7,
   "text": "خیلیا هستن علم فکری ندارن، علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.7,
   "end": 362.62,
   "text": "حصولی ندارن، تحصیل نکرده‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.62,
   "end": 368.73,
   "text": "اما بهتر از خیلیا شاید امثال من که به ظاهر مثلاً تحصیلاتی هم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.73,
   "end": 371.39,
   "text": "خیلی، خیلی، خیلی بیشتر بفهمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.39,
   "end": 375.07,
   "text": "اون فهم مربوط به قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.07,
   "end": 383.09,
   "text": "جایگاه شهوده. و چرا قرآن جای جای-- اصلاً ما بحث قلب رو حدود الان فکر می‌کنم جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.09,
   "end": 386.49,
   "text": "دیگه نزدیک دویست و نود و این جلسه باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.49,
   "end": 389.51,
   "text": "که داریم صحبت می‌کنیم در خصوص قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.51,
   "end": 393.69,
   "text": "چون قبلاً عرض کردیم ماهسل ما بعد از مرگ همین قلب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.69,
   "end": 397.69,
   "text": "و قلب جایگاه شهوده و قرآن می‌خواد ما رو به اونجا برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.69,
   "end": 401.21,
   "text": "علم فکری نیست که تو تدبر رو مساوی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.21,
   "end": 404.07,
   "text": "تفکر در قرآن بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.07,
   "end": 405.91,
   "text": "باید عمیق‌تر از این حرفا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.91,
   "end": 409.31,
   "text": "یعنی باید اهل شهود شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.31,
   "end": 414.17,
   "text": "قلب محل شهوده و شهود جایی‌ست که خطا به درش راه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.17,
   "end": 416.33,
   "text": "جایگاه عصمته، جایگاه معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.33,
   "end": 422.87,
   "text": "انبیا قلبشون به چنان جایگاهی رسیده بود، چنان مفتوح شده بود این اون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.87,
   "end": 426.01,
   "text": "که به شهود کامل رسیده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.01,
   "end": 429.83,
   "text": "یعنی عالم غیب براشون شهود محض بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.83,
   "end": 433.65,
   "text": "می‌دیدن. دیگه جای خطا درش نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 433.65,
   "end": 439.59,
   "text": "شما بفرما ببینم کسی که فقط شنیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.59,
   "end": 442.43,
   "text": "خطاش بیشتره یا کسی که دیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.43,
   "end": 448.33,
   "text": "بالاتر برو، اون کسی که دیده خطاش بیشتره یا اون کسی که چشیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.33,
   "end": 450.17,
   "text": "تازه بالاتر از اینام باز ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.17,
   "end": 454.99,
   "text": "ما علم اليقين داريم و عين اليقين داريم و حق اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.99,
   "end": 456.93,
   "text": "علم اليقين علم پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.93,
   "end": 461.67,
   "text": "علم، علم فکری. میره تحصیلات و علم و کارهای...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.67,
   "end": 464.03,
   "text": "عين اليقين می‌بینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.03,
   "end": 468.01,
   "text": "عینه دیگه. عين، عينشو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.01,
   "end": 470.15,
   "text": "حق اليقين می‌چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.15,
   "end": 472.05,
   "text": "علامه حسن زاده میگه برو بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.05,
   "end": 474.97,
   "text": "تعال. برد اليقين هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.97,
   "end": 482.11,
   "text": "یعنی انقدر می‌چشه که اصلاً در درونه-- اصلاً خودش اتحاد وجودی با اون قصه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.11,
   "end": 485.07,
   "text": "توجه کردید؟ اصلاً می‌آرمَد به اص-اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.07,
   "end": 488.13,
   "text": "یعنی دیگه آرامش محض پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.13,
   "end": 493.33,
   "text": "اگر کسی کار شهودی کرد، وظیفه‌ش رو در قبال قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.33,
   "end": 496.33,
   "text": "انجام داده، یعنی تدبر در قرآن کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.33,
   "end": 499.77,
   "text": "دل به قرآن بسپره. شما ببینید الان خب دهه‌ی فجر هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.77,
   "end": 503.81,
   "text": "بسیاری از کسانی که در مسیر انقلاب بودند و هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.81,
   "end": 507.85,
   "text": "و بعدها خواهید دید که نخواهند ماند در مسیر انقلاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.85,
   "end": 510.49,
   "text": "کسایین که دل به انقلاب ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.49,
   "end": 516.73,
   "text": "انقلاب نوندونیشونه. از جهت علم فکری تو بهش بگی می‌شینه تجزیه تحلیل می‌کنه انقلاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 516.73,
   "end": 519.59,
   "text": "انقلاب رو بهتر از من و تو شاید ترجمه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.59,
   "end": 525.99,
   "text": "اما در سیر عملیش می‌بینی انقلاب تو هیچ‌کدوم از لایه‌های مختلف زندگیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.99,
   "end": 528.71,
   "text": "در سبک زندگیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.71,
   "end": 532.11,
   "text": "بعد توجیهات هم میاره. ببین توجیهات مربوط به علم فکریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.11,
   "end": 534.63,
   "text": "توجیهات میاره که بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.63,
   "end": 538.23,
   "text": "میگه خذوا زينتکم عند کل مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.23,
   "end": 541.37,
   "text": "می‌رید هر مسجد که می‌خواید برید محل سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.37,
   "end": 545.49,
   "text": "خذوا زينتکم. زینت کنید برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.49,
   "end": 548.55,
   "text": "زیبایی‌هاتونو مثلاً بهترین لباسو بپوشید، عطر بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.55,
   "end": 553.51,
   "text": "الان میگن بعضی تحلیل‌گران که مثلاً شاید باباشون یکی از گنده‌های انقلاب هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.51,
   "end": 561.61,
   "text": "خب از این جهت پس باید بهترین زندگی رو داشت، بهترین جایگاه رو ایجاد کرد، بهت-- بله، این بهترنا کی مخالف اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 561.61,
   "end": 566.81,
   "text": "اما نه در حالی که تو گرفتار تجمل و اشرافی‌گری بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 566.81,
   "end": 570.99,
   "text": "نبایست انحراف در خط و خطوط کلی انقلاب ایجاد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 570.99,
   "end": 575.41,
   "text": "بعد مثلاً اینکه امام توی جم-جماران به اون سادگی بشینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 575.41,
   "end": 580.29,
   "text": "تمام مدیران و رهبران کشورهای دیگه و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 580.29,
   "end": 584.85,
   "text": "مدیران داخلی‌مون می‌خوان بیان دیدنش، بیان تو همون فسقل اطاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 584.85,
   "end": 587.49,
   "text": "ساده و بی‌آلایش بشینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 587.49,
   "end": 593.67,
   "text": "بعد مثلاً فلان رئیس مثلاً یکی از قوا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 593.67,
   "end": 596.07,
   "text": "حالا از دنیا هم رفت بره تو کاخ بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 596.07,
   "end": 599.19,
   "text": "بعد توجیه ما این باشه، این انحرافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 599.19,
   "end": 602.87,
   "text": "بیایم بگیم امام هیچ جا نرفت، با کسی ارتباط نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 602.87,
   "end": 604.93,
   "text": "اصلاً نه زیارت رفت، نه هیچ جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.93,
   "end": 608.87,
   "text": "چون گفته شد تو سیما اگه دیدید امروز و دیروز این گفته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.87,
   "end": 612.31,
   "text": "امام با کسی کاری نداشت، اینجا بود دیگه جایی هم نمی‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 612.31,
   "end": 615.97,
   "text": "از ترس اینکه مبادا بخواد بره دچار تشریفات بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.97,
   "end": 618.11,
   "text": "تو بنز ضد گلوله بشینه، هیچ جا نرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.11,
   "end": 621.67,
   "text": "این چه تفکر بسیار خطرناک و غلطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.67,
   "end": 625.85,
   "text": "ولی مثلاً بابای ما کسی بود که تمام کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.85,
   "end": 632.17,
   "text": "که مثلاً دولتی‌های کشورهای مختلف اعم از داخل و خارج باهاش ارتباط داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 632.17,
   "end": 635.11,
   "text": "مثلاً مجبور بود بره توی جایی مثل کاخ زندگی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.11,
   "end": 640.55,
   "text": "این انحراف فکریه. این اصلاً دل به انقلاب نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.55,
   "end": 642.57,
   "text": "به این میگن انحراف فکری ایجاد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.57,
   "end": 646.31,
   "text": "بعد این باعث می‌شه که مردم دل بکنند از انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 646.31,
   "end": 648.37,
   "text": "بعد یعنی این با دل نرفته جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 648.37,
   "end": 652.25,
   "text": "اونایی که دل کندن هم یه دفعه دل می‌کنند چون انحراف ایجاد می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 652.25,
   "end": 655.37,
   "text": "میگن بس که اشتباه ما دل بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 655.37,
   "end": 662.47,
   "text": "یا اون آخوندهایی که خدا لعنتشون کنه، بسیارشون از علمای متأسفانه سنگین وزن ما بودند متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 662.47,
   "end": 665.55,
   "text": "که بعد از انقلاب وقتی امام رفت تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 665.55,
   "end": 669.61,
   "text": "تفسیر surah حمد، کسی که خودش بنیانگذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 669.61,
   "end": 675.23,
   "text": "انقلاب شده میره تفسیر-- پنج جلسه چقدر surah حمد رو میگه بر اساس فلسفه و حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 675.23,
   "end": 678.73,
   "text": "اسم محی الدین عربی شیخ ال-- شیخ الاکبر رو میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.73,
   "end": 682.31,
   "text": "اسم ملا صدرا رو میاره، عینش اسم شیخ الرئیس رو میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.31,
   "end": 687.43,
   "text": "آقا شروع می‌شه. چه بلایی سر امام آوردن از خارج و داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 687.43,
   "end": 689.15,
   "text": "چقدر بزرگان نامه نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 689.15,
   "end": 691.75,
   "text": "اصلاً گفتن کفن‌پوش میایم تو خیابون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 691.75,
   "end": 694.05,
   "text": "و اعلام می‌کنیم شما گول زدی سر ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.05,
   "end": 698.25,
   "text": "شما ما رو به انحراف-- شما الکی گفتین می‌خوایم انقلاب کنیم بر اساس اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 698.25,
   "end": 703.15,
   "text": "حالا همین کفریات شده که فلسفه و حکمت و ملاصدراها پیشتازند که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 703.15,
   "end": 705.47,
   "text": "اونا گفتن اگه شما ادامه بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 705.47,
   "end": 709.15,
   "text": "ما میایم حکم به کفرت می‌کنیم به استهزاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 709.15,
   "end": 714.11,
   "text": "این انحرافات فکریه. خب این یه همچین عالمی فقط کار فکری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 714.11,
   "end": 717.67,
   "text": "اصلاً وارد به حوزه‌ی قلب نشده، دل نداده اصلاً به انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 717.67,
   "end": 725.21,
   "text": "لذا جلوی امام هم وایسادن. یکی از مهم‌ترین ریشه‌های مشکلات درونی ما و حتی خ-خارجی و داخلی همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 725.21,
   "end": 728.69,
   "text": "برمی‌گرده به علمایی که جلوی امام وایسادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.69,
   "end": 732.71,
   "text": "علما، بزرگان و الی-- کسی جرات نمی‌کرد با امام در بیفته که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 732.71,
   "end": 736.85,
   "text": "وقتی دیدن بزرگان جا زدن، اینام جا زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 736.85,
   "end": 740.01,
   "text": "خیلیا ما از قطار انقلاب پیاده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 740.01,
   "end": 742.49,
   "text": "پس اینو حواسمون باشه. نکته‌ی خیلی مهمیه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 742.49,
   "end": 744.41,
   "text": "این خیلی مهمه توجه بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 744.41,
   "end": 747.27,
   "text": "اصلاً وظیفه‌ی ما تدبر در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 747.27,
   "end": 750.85,
   "text": "اونم با قلب، به علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 750.85,
   "end": 753.15,
   "text": "قلب المؤمن عرش الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 753.15,
   "end": 755.49,
   "text": "عرش خداست قلب مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 755.49,
   "end": 757.51,
   "text": "قرآن هم که جایگاهش عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 757.51,
   "end": 761.87,
   "text": "انما کلت لاقل قرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 761.87,
   "end": 767.19,
   "text": "یعنی علم لدن نیست، یعنی از اون بالا بالاها اومده، تنزل پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 767.19,
   "end": 771.11,
   "text": "پس جایگاه تدبر در قرآن می‌شه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 771.11,
   "end": 777.25,
   "text": "اشتباه نشه. نه علم فکری که چهار تا کتاب تفسیر بخونیم بگیم وظیفه‌مونو انجام دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 777.25,
   "end": 780.95,
   "text": "حالا انشاالله این بحثو ادامه می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 780.95,
   "end": 783.83,
   "text": "انشاالله که به برکت همین آیات و همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 783.83,
   "end": 787.49,
   "text": "شرافت این موضوع قرآن وساطت کن و دست ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 787.49,
   "end": 792.13,
   "text": "عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 792.13,
   "end": 799.17,
   "text": "اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}