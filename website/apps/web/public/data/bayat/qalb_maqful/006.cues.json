 },
 "chapters": [
  {
   "index": 0,
   "title": "بحث پیرامون قلب مقفول است؛ قلبی که قفل بر آن زده شده، بر اساس آیه:",
   "start": 26.88,
   "end": 537.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.1,
   "end": 5.34,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.34,
   "end": 9.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.02,
   "end": 13.52,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.52,
   "end": 16.88,
   "text": "بحث ما پیرامون قلب مقفول بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.88,
   "end": 20.26,
   "text": "قفل زده شده بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.26,
   "end": 23.8,
   "text": "آیه \"أفلا يتدبرون القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.8,
   "end": 29.2,
   "text": "أم على قلوب أقفالها\" عرض کردیم که موضوع تدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.2,
   "end": 34.4,
   "text": "برمی‌گرده به قلب انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.4,
   "end": 41.92,
   "text": "که متاسفانه غالبا حتی بعضی از مفسرین بلکه بسیاری از مفسرین اشتباه انجام داده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.92,
   "end": 47.68,
   "text": "و همون سیر تفکری یا فکر عمیق رو بیان کردن در صورتی که چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.68,
   "end": 52.16,
   "text": "بلافاصله بعد از تدبر موضوع قلب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.16,
   "end": 56.44,
   "text": "خدای متعال متذکر میشه نشون میده که حوزه تدبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.44,
   "end": 60.18,
   "text": "حوزه قلب است. یکی از آیاتی که به زیبایی این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.18,
   "end": 66.14,
   "text": "تبیین کرده آیه سی و هفت سوره قاف هست \"إن في هذا لَبِكْرٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.14,
   "end": 68.66,
   "text": "لمن كان له قلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.66,
   "end": 71.84,
   "text": "ببینید كان له قلب لمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.84,
   "end": 74.22,
   "text": "برای کسی که كان له قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.22,
   "end": 77.28,
   "text": "این ذکر است. این یادآوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.28,
   "end": 79.62,
   "text": "این قرآن سرتاسر ذکر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.62,
   "end": 85.38,
   "text": "برای کی؟ كان له قلب برای کسی که قلب داره یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.38,
   "end": 87.92,
   "text": "قلبش قفل نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 90.72,
   "text": "\"أو ألقى السمع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.72,
   "end": 97.0,
   "text": "که البته اگر کسی قلبش قفل نشد اون موقع القاء شنیداری بهش صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.0,
   "end": 100.54,
   "text": "یعنی که می‌شنوه صداهای ملکوت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.54,
   "end": 104.34,
   "text": "\"وهو شهيد\" باز بحث شهود هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.34,
   "end": 107.9,
   "text": "شهود هم برمی‌گرده به عالم قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.9,
   "end": 113.02,
   "text": "شهود قلبی. این آیه به زیبایی داره بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.02,
   "end": 117.98,
   "text": "اساسا قرآن اومده برای اینکه شما باهاش کار قلبی انجام بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.98,
   "end": 119.74,
   "text": "و ولایت هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.74,
   "end": 123.22,
   "text": "ولایت هم بحث قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.22,
   "end": 125.8,
   "text": "بحث دل دادن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.8,
   "end": 128.74,
   "text": "ایمان بحث قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.74,
   "end": 134.04,
   "text": "چرا ما حدیث داریم که اگر کسی شهادت عین واجب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.04,
   "end": 136.64,
   "text": "گفت مثلا این اذان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.64,
   "end": 139.76,
   "text": "به نحو واجب رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.76,
   "end": 141.54,
   "text": "این رو گفت مسلمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.54,
   "end": 145.86,
   "text": "لذا ما معتقدیم که تمام اهل تسنن مسلمان‌اند چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.86,
   "end": 152.0,
   "text": "شهادت واجب رو که در اذان هست به صورت واجب گفته میشه اونا هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.0,
   "end": 155.8,
   "text": "اما اون بقیه اذان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.8,
   "end": 159.16,
   "text": "به نیت واجب گفته نمیشه البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.16,
   "end": 164.3,
   "text": "مقلدین حضرت آیه الله حکیم که در جلد پنج فقهش عرض شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.3,
   "end": 168.74,
   "text": "بیان کرده واجب است که هیچی اونا به نیت وجود میگن اما بقیه به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.74,
   "end": 171.88,
   "text": "استحباب میگن غیر از اذان واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.88,
   "end": 176.58,
   "text": "چرا اون‌ها یا چرا ما دستور داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.58,
   "end": 181.9,
   "text": "که به تأسی از بزرگانمون میگیم أشهد أن عليًا ولي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.9,
   "end": 184.44,
   "text": "چون ولایت امر قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.44,
   "end": 188.68,
   "text": "اون‌ها اسلام است، این ایمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.68,
   "end": 193.52,
   "text": "ایمان جایگاهش قلبه. ولایت جایگاهش قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.52,
   "end": 198.52,
   "text": "اونم به نحو شهود یعنی پذیرش قلبی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.52,
   "end": 201.44,
   "text": "قلباً بپذیر ولایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.44,
   "end": 205.66,
   "text": "نه اینکه لسانا و سر سفره ولایت به طمع دنیا باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.66,
   "end": 211.96,
   "text": "قلباً باشه. و جالبه که اون حدیثی که داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.96,
   "end": 215.3,
   "text": "در خانه هیچ بهشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.3,
   "end": 220.46,
   "text": "در بهشت هیچ خانه‌ای نیست از اهل ایمان مگر اینکه شاخه‌ای از درخت توبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.46,
   "end": 230.26,
   "text": "حالا یا همون شجرة طیبه کشیده شده که اصل اون شاخه یعنی تنه اون درخت در خانه امیرالمؤمنین صلوات الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.26,
   "end": 233.02,
   "text": "این در حقیقت مثله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.02,
   "end": 236.5,
   "text": "مثال قرآنی چون ما با این اشکال و صور دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.5,
   "end": 238.7,
   "text": "محشوری مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.7,
   "end": 242.68,
   "text": "اخروییش هم خدا با همین اشکال و صور و درخت زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.68,
   "end": 247.14,
   "text": "میگه ریشه، تنه، در حقیقت تنه این درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.14,
   "end": 249.24,
   "text": "در خانه امیرالمؤمنینه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.24,
   "end": 255.22,
   "text": "این درخت، درخت ولایته. چرا میگه در هر خانه بهشتی اهل ایمان شاخش رفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.22,
   "end": 259.46,
   "text": "چون پذیرش قلبی دارن یعنی قلبشون پذیرش کرده ولایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.46,
   "end": 268.18,
   "text": "اینا مؤمنن. لذا هر کسی که ولایت امیرالمؤمنین صلوات الله عليه رو قلباً نپذیرفته است، او مسلمان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.18,
   "end": 270.56,
   "text": "اگر شهادتین واجب رو گفته اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.56,
   "end": 276.42,
   "text": "مؤمن نیست. و ما بر اساس این روایت میگیم که اهل تسنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.42,
   "end": 280.1,
   "text": "مؤمن نیستن، مؤمنین نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.1,
   "end": 286.62,
   "text": "فقط شیعه تمام فرقه‌ها به جز شیعه دوازده امامی بقیه هیچ کدوم مؤمن نیستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.62,
   "end": 289.72,
   "text": "مسلمانن. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.72,
   "end": 292.56,
   "text": "کسانی که پذیرش ولایت کردن ایمان دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.56,
   "end": 298.8,
   "text": "حالا البته در عین شصت و سه عیون مسائل نفس الزکيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.8,
   "end": 302.98,
   "text": "شرح مبسوطی داره تو این موضوع که می‌تونید برید در صور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.98,
   "end": 306.7,
   "text": "تمثلات برزخی که این اصل ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.7,
   "end": 313.5,
   "text": "اصل ها ثابت اصل و یعنی ریشه این درخت رو قلب مقدس پیغمبر می‌شمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.5,
   "end": 319.46,
   "text": "ریشه درخت ولایت، قلب مقدس پیغمبر، از جان ایشون ولایت جوشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.46,
   "end": 321.76,
   "text": "و امیرالمؤمنین و به بقیه رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.76,
   "end": 327.22,
   "text": "و فرع ها في السماء دیگه جان اهل ایمان دیگه هرکی به سعه وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.22,
   "end": 329.36,
   "text": "از این ولایت بهره جست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.36,
   "end": 333.64,
   "text": "باز میشه بحث شهود، بحث قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.64,
   "end": 337.34,
   "text": "که اگر کسی اینو نداشت، اگر کسی به نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.34,
   "end": 341.98,
   "text": "شهود یعنی قلباً ولایت رو نپذیرفت اینم مؤمن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.98,
   "end": 344.96,
   "text": "چنین کسی هم به ایمان نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.96,
   "end": 348.88,
   "text": "چرا گرفتاری‌هایی ما داریم تو روزمرگمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.88,
   "end": 353.58,
   "text": "چرا التزام عملی به گفتار و دستورات اهل بیت نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.58,
   "end": 356.14,
   "text": "چون قلب به شهود نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.14,
   "end": 360.51,
   "text": "یعنی ما گرفتاریم. حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.51,
   "end": 365.49,
   "text": "حالا میخوای تعال و بیا بالاتر، بالاتر بری به قول علامه حسن زاده و ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.49,
   "end": 372.51,
   "text": "فاطمة الزهرا بنت رسول الله عِصمة الله الكبرى و حجة الله على الحجاج رو هم در اذانت بیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.51,
   "end": 375.33,
   "text": "که دستت رو بگیرن به تعالی برسوننت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.33,
   "end": 379.75,
   "text": "دیگه اون سر رو سر عالم هستی حضرت زهرا اقرارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.75,
   "end": 383.81,
   "text": "خیلی خوبه. اما در هر حال باید به شهود-- ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.81,
   "end": 389.07,
   "text": "قبل از اینکه بیایم به نماز محضر یکی از مدیران خوبش مجموعه شما یه سوالی طرح کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.07,
   "end": 392.73,
   "text": "اینم بگم و السلام. عرض کردیم که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.73,
   "end": 398.59,
   "text": "من هرچی دقت می‌کنم البته مطلق نیست اما غالباً، عموماً چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.59,
   "end": 401.75,
   "text": "اینایی که از جهت حیثیت اجتماعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.75,
   "end": 406.37,
   "text": "جایگاه و اعتبارات دقت کنید اعتبارات نه حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.37,
   "end": 409.09,
   "text": "اعتبارات اجتماعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.09,
   "end": 413.05,
   "text": "شغل خیلی پایین دستی دارن یعنی خیلی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.05,
   "end": 416.95,
   "text": "شغل آنچنانی ندارن، مدیر نیستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.95,
   "end": 419.15,
   "text": "مثلاً دکتر مهندس نیستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.15,
   "end": 422.47,
   "text": "مدیریتی ندارن، مسئولیتی-- مثلاً چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.47,
   "end": 425.37,
   "text": "خدماتی‌اند مثلاً. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 425.37,
   "end": 433.49,
   "text": "این‌ها وقتی بهشون می‌رسی می‌بینی ورود و خروجشون به ماها مخصوصاً ماهایی که لباس پیغمبر تنمون هست خیلی با ادب‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.49,
   "end": 436.23,
   "text": "خیلی با خضوع و خشوع بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.23,
   "end": 440.15,
   "text": "خیلی با کرنش بیشتره. خیلی با آداب اجتماعی بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 440.15,
   "end": 442.43,
   "text": "خیلی خضوع و خشوع دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.43,
   "end": 444.79,
   "text": "خیلی گرم می‌گیرن با دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.79,
   "end": 450.89,
   "text": "اما برعکس غالباً و عموماً کسایی که یه وجاهت اجتماعی دارن حالا یا مدیریت دارن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.89,
   "end": 455.01,
   "text": "علم دارن چه می‌دونم یا پول دارن یا شهرت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.01,
   "end": 462.11,
   "text": "سلبریتی‌اند هرچی. اینا رو می‌بینی یک تکبری یه جوری اصلاً خشک‌اند خیلی نمی‌جوشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.11,
   "end": 465.13,
   "text": "سلام خداحافظ. و چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.13,
   "end": 469.89,
   "text": "این علت چیه؟ و عزیزم خیلی خوب جواب دادن گفتن این سؤال رو که حضرت امام جواب دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.89,
   "end": 473.67,
   "text": "فرمودن وای به حال کسی که قبل از اینکه خودش رو بسازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 473.67,
   "end": 480.33,
   "text": "این قلبش رو خاشع کنه، تهذیب نفس کنه، اعتبار اشتباهی پیدا کنه، مردم بهش رجوع کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.33,
   "end": 485.39,
   "text": "چرا؟ چون وقتی قلب به شهود نرسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.39,
   "end": 488.67,
   "text": "ملکوت رو شهود نکرد، شاهد ملکوت عالم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.67,
   "end": 491.55,
   "text": "همه رو تو همین دنیا می‌بینه. همه رو تو این اعتبارات می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.55,
   "end": 495.67,
   "text": "پول اعتباره، مدیریت اعتباره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.67,
   "end": 500.87,
   "text": "مدرک اعتباره، علم حتی این علم فکری حصولی اعتباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 500.87,
   "end": 503.09,
   "text": "بذارنت تو قبر اینا مفت نمی‌ارزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 503.09,
   "end": 505.83,
   "text": "اصلاً به دردت نمی‌خوره. مال همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.83,
   "end": 508.19,
   "text": "اون ور دیگه شهوده که به درد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.19,
   "end": 510.31,
   "text": "کسی که به شهود رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.31,
   "end": 514.25,
   "text": "خواضع می‌شه، خاشع می‌شه، قلبش کمک حالش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.25,
   "end": 516.53,
   "text": "و می‌بینی می‌فهمه که هیچی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.53,
   "end": 520.17,
   "text": "همه چی خداست و به همه حرمت قائله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.17,
   "end": 524.45,
   "text": "پس عزیزان همه چی شهود قلبی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.45,
   "end": 528.07,
   "text": "که ما خیلی متاسفانه ازش دور و کم بهره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.07,
   "end": 533.11,
   "text": "ان‌شاءالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.11,
   "end": 537.01,
   "text": "الله صلي على محمد و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}