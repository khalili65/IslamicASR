   "start": 265.92,
   "end": 330.42
  },
  {
   "index": 5,
   "title": "## نشئهٔ طبیعت تحت مشیت الهی؛ آخرت تحت مشیت انسانی",
   "start": 330.42,
   "end": 425.74
  },
  {
   "index": 6,
   "title": "## لهم ما یشاءون؛ کن فیکون",
   "start": 425.74,
   "end": 493.92
  },
  {
   "index": 7,
   "title": "## از صفت تا ملکه و مقام",
   "start": 493.92,
   "end": 580.86
  },
  {
   "index": 8,
   "title": "## دنیا مزرعهٔ آخرت؛ سر سفرهٔ خود",
   "start": 580.86,
   "end": 600.88
  },
  {
