 },
 "chapters": [
  {
   "index": 0,
   "title": "## قلب مقفول؛ قفل بر اسرار هستی",
   "start": 9.0,
   "end": 74.86
  },
  {
   "index": 1,
   "title": "## مزاج‌شناسی عالم؛ اعتدال و طهارت",
   "start": 74.86,
   "end": 250.74
  },
  {
   "index": 2,
   "title": "## بی‌طهارتی انسان از ظاهر تا باطن",
   "start": 250.74,
   "end": 304.28
  },
  {
   "index": 3,
   "title": "نظام هستی سرباز خدا و جنود الهی‌اند:",
   "start": 304.28,
   "end": 456.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 6.38,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.38,
   "end": 9.0,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.0,
   "end": 12.16,
   "text": "بحث ما پیرامون قلب مغفول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.16,
   "end": 19.36,
   "text": "قبل قلبی که قفل شده، دلی که بر روی اسرار و حقایق نظام هستی درش قفل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.36,
   "end": 23.72,
   "text": "و حقایق و نور الهی در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.72,
   "end": 27.54,
   "text": "تجلی نمی‌کنند. این آیه‌ای که ام می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.54,
   "end": 32.92,
   "text": "\"افلا یتدبرون القرآن ام على قلوب اقفالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.92,
   "end": 34.84,
   "text": "دو تا اشکال رو به ما وارد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.84,
   "end": 39.3,
   "text": "میگه یا شما اهل تدبر در قرآن نیستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.3,
   "end": 41.54,
   "text": "یا اینکه قلب‌تون دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.54,
   "end": 45.4,
   "text": "قفل زدگی شده و حقایق درش وارد نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.4,
   "end": 47.38,
   "text": "هر دوشو اگر بررسی کنیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.38,
   "end": 51.62,
   "text": "چه اونجایی که اهل تدبر نیستیم، سنگین شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.62,
   "end": 54.72,
   "text": "تدبر در قرآن برای ما گران شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.72,
   "end": 58.8,
   "text": "سخت شده، جان‌کاه شده، دشوار شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.8,
   "end": 65.76,
   "text": "چه اونجایی که قلب قفل شده بر روی حقایق نظام هستی، هر دو در پس یک اتفاق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.76,
   "end": 69.48,
   "text": "اون هم بی‌طهارتی. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.48,
   "end": 74.86,
   "text": "نکته خیلی مهمی رو عارضم خدمت شما که خیلی هم به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.86,
   "end": 80.72,
   "text": "در بحث مزاج شناسی عالم، می‌دونید عالم هستی همونطور که ما تک تک‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.72,
   "end": 89.16,
   "text": "یه مزاجی داریم و البته باید مزاج معتدل باشد که اعدل امزجه رو اهل بیت دارن و شیخ الرئیس در نمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.16,
   "end": 93.08,
   "text": "نهم اشاراتشون ثابت می‌کنند که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.08,
   "end": 98.94,
   "text": "کسی اعتدال مزاج پیدا کرد همیشه جوان خواهد ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.94,
   "end": 101.6,
   "text": "و هیچوقت نمی‌میرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.6,
   "end": 105.04,
   "text": "که بحث شی-- بسیار شیرینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.04,
   "end": 108.14,
   "text": "همین‌طور عالم هستی هم مزاجی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.14,
   "end": 114.3,
   "text": "م- مزاج این عالم رو اگر همونطور که شما برخلاف مزاج خودتون اگر عمل کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.3,
   "end": 120.6,
   "text": "دچار مریضی اصطلاحاً می‌شید، نظام وجودتون به هم می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.6,
   "end": 124.78,
   "text": "مریض می‌شید. اگر یک ویروسی، یک میکروبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.78,
   "end": 128.72,
   "text": "وارد بدن، کشور وجود شما بشود، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.72,
   "end": 134.32,
   "text": "سربازان مدافع کشور وجودتون که حالا، حالا اسمشو هرچی بخواید بگذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.32,
   "end": 142.26,
   "text": "نمی‌دونم گلبول‌های سفید یا هرچی اینج-- این‌ها مسلح میان به دفاع از کشور بدن تا جایی که کشته می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.26,
   "end": 146.94,
   "text": "تا کشور بدن شما حفظ شود در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.94,
   "end": 151.8,
   "text": "هجوم دشمن و بیگانه که مزاج وجود شما به هم نریزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.8,
   "end": 155.38,
   "text": "همین‌طور نظام هستی هم یک مزاجی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.38,
   "end": 159.04,
   "text": "این نظام آفاقی یک مزاجی دارد که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.04,
   "end": 164.16,
   "text": "برخلاف این مزاج کسی عمل کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.16,
   "end": 170.1,
   "text": "همه نظام هستی دست به دست هم میدن که با اون وجود مسمومه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.1,
   "end": 174.02,
   "text": "میکروب، حالا اسم هرچی می‌خواید بگذارید، ویروس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.02,
   "end": 176.62,
   "text": "اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.62,
   "end": 181.66,
   "text": "معارض که وارد این کشور وجود شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.66,
   "end": 186.06,
   "text": "و می‌خواد شری ایجاد کند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.06,
   "end": 188.84,
   "text": "دشمنی بلند می‌شن. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.84,
   "end": 193.92,
   "text": "یعنی اگر ما همینطوری که برخلاف مزاج‌مون کاری بکنیم، چیزی بخوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.92,
   "end": 196.38,
   "text": "کشور وجود ما به هم می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.38,
   "end": 200.4,
   "text": "نظام آفاقی عالم هم اگر برخلاف مزاجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.4,
   "end": 202.86,
   "text": "کاری صورت بگیره به هم می‌ریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.86,
   "end": 209.34,
   "text": "و همه دست به دست هم میدن، تمام نظام هستی دست به دست هم میدن بر علیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.34,
   "end": 212.14,
   "text": "معارض، این چیزی که می‌خواد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.14,
   "end": 214.38,
   "text": "یعنی مزاج عالم رو به هم بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.38,
   "end": 217.8,
   "text": "مزاج عالم چیه؟ تمام حکما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.8,
   "end": 222.68,
   "text": "من جمله حضرت علم آل حسن زاده می‌فرمایند مزاج عالم بر اساس طهارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.68,
   "end": 228.26,
   "text": "طهارت. یک پارچه نظام هستی طهارت محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.26,
   "end": 229.98,
   "text": "آفتاب طهارت محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.98,
   "end": 236.26,
   "text": "زمین طهارت محض است. هوا طهارت، آب، هرچی که شما فکرشو بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.26,
   "end": 240.42,
   "text": "سر سوزنی میکرونی در نظام آفاقی و هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.42,
   "end": 247.5,
   "text": "بی‌طهارتی نیست. سر سوزنی کسی تا حالا از خورشید تخطی ندیده، خطا، بی‌طهارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.5,
   "end": 250.74,
   "text": "از زمین، از نظام آفاقی هیچکس ندیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.74,
   "end": 255.72,
   "text": "این انسان دو پا وقتی بی‌طهارتی می‌کند، حالا از نظام این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.72,
   "end": 260.1,
   "text": "خاصه انسان، این حواس پنج گانه ظاهریه که مربوط به نش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.1,
   "end": 268.34,
   "text": "به وادی ظاهر و بدن ماست بگیر برو تا باطن ما، باطن وجود ما، عوالم وجودیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.34,
   "end": 270.64,
   "text": "وقتی خیال ناپاک شد، وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.64,
   "end": 278.02,
   "text": "وهم ناپاک شد، وقتی حتی عقل ما مشوب به وهم شد، قلب ما محضر حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.02,
   "end": 281.8,
   "text": "نور الهی نشد، محل حضور شیاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.8,
   "end": 288.3,
   "text": "و خباثات شد و، و همینطور تا جان ما متأسفانه هر وقت این بی‌طهارتی‌ها آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.3,
   "end": 291.38,
   "text": "مثل اون ویروسی که وارد کشور وجود می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.38,
   "end": 295.74,
   "text": "به هم می‌ریزه، نظام هستی دست به دست هم میدن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.74,
   "end": 298.66,
   "text": "خلل رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.66,
   "end": 301.72,
   "text": "نظام هستی سرباز خدا، جنود الهی‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.72,
   "end": 304.28,
   "text": "\"و ما یعلم جنود ربک الا هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.28,
   "end": 311.44,
   "text": "این جنود الهی، نظام آفاقی دست به دست هم میدن به مبارزه بر علیه بی‌طهارتی بلند می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.44,
   "end": 314.28,
   "text": "حالا وقتی در نشئه طبیعتی‌ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.28,
   "end": 315.98,
   "text": "به این شکل خودشو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.98,
   "end": 319.86,
   "text": "قلب قفل می‌شه، حقایق رو نمی‌فهمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.86,
   "end": 321.64,
   "text": "قرآن رو درک نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.64,
   "end": 325.66,
   "text": "لذا نظام آفاقی به جنگ ما بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.66,
   "end": 327.54,
   "text": "دچار زنگ محیشتی می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.54,
   "end": 331.3,
   "text": "مصائب، مشکلات، بدبختی‌ها، بیچارگی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.3,
   "end": 333.82,
   "text": "اضطراب‌ها، تشویش‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.82,
   "end": 336.64,
   "text": "حتی مشکلات جسمی و برو تا روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.64,
   "end": 343.18,
   "text": "و اع-- خرد شدن اعصاب‌ها و به هم ریختگی از درون و لجانگسیختگی کشور وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.18,
   "end": 349.64,
   "text": "اون طرف چی می‌شه؟ بعد از نشئه طبیعت هم باز اگر کسی از اینجا با خودش بی‌طهارتی برد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.64,
   "end": 353.68,
   "text": "یعنی نظام آفاقی زورش نرسید که اینو تطهیر کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.68,
   "end": 356.5,
   "text": "برد با خودش بعد از مرگ، اونجا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.5,
   "end": 360.84,
   "text": "وحشتناک، فشار قبر، ظلمت، نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.84,
   "end": 363.26,
   "text": "مار و ان-- عرض شود این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.26,
   "end": 366.62,
   "text": "امم، میگن عقرب و مار و چی و اینها می‌گزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.62,
   "end": 369.22,
   "text": "اینا همونان. همون چیزهایی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.22,
   "end": 372.24,
   "text": "اون طرف میخوان ما رو طاهر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.24,
   "end": 374.2,
   "text": "حالا جهنم هم همین شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.2,
   "end": 379.38,
   "text": "یعنی نظام آفاقی که در تجلی خدای منان عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.38,
   "end": 384.34,
   "text": "کلاً یک تجلی، یک قرآن خدا خلق کرده به سه شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.34,
   "end": 388.14,
   "text": "یک نز-- یک قرآن هستی‌ست، همین نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.14,
   "end": 395.4,
   "text": "یک قرآن کتبی‌ست، این قرآنی که دست من و شماست و یک نز-- یک قرآن انفسی‌ست، جان من و شما که قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.4,
   "end": 399.52,
   "text": "همه قرآن‌اند. قرآن هم میگه \"لا یمسه الا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.52,
   "end": 402.48,
   "text": "نمی‌شه مس کرد حقایق عالم رو با-- جز با طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.48,
   "end": 406.66,
   "text": "بی‌طهارتی، کوچک‌ترین بی‌طهارتی عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.66,
   "end": 411.34,
   "text": "قلب رو قفل می‌کنه، نظام وجود رو به هم می‌ریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.34,
   "end": 413.48,
   "text": "دنیا دیگه می‌بینی برات می‌شه جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.48,
   "end": 417.58,
   "text": "اصلاً جهنم یعنی همین. چه در این نظام، نظام نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.58,
   "end": 420.96,
   "text": "طبیعت، چه در نشأت بعدی، برزخ و مثال و هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.96,
   "end": 424.1,
   "text": "برو بالاتر در آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.1,
   "end": 430.16,
   "text": "همه این جهنم‌ها که ما هی براش می‌ذاریم مثال می‌زنیم چاه و آتش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.16,
   "end": 434.44,
   "text": "ملائکه غلاظ و شداد برای اینه بی‌طهارتیه رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.44,
   "end": 439.9,
   "text": "همه دست به دست هم میدن طهارت از دست رفته ما رو چیکار کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.9,
   "end": 442.96,
   "text": "برطرف کنن. ب-- یعنی ازاله نجاست کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.96,
   "end": 447.8,
   "text": "چیزی جز این نیست. این گرفتاری ماست که حالا انشالله این بحث ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.8,
   "end": 449.36,
   "text": "بیشتر از این وقتتون رو نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.36,
   "end": 451.82,
   "text": "عاقبتمون به امید خدا ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.82,
   "end": 456.18,
   "text": "انشالله به برکت صلوات بر محمد و آل محمد. امين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}