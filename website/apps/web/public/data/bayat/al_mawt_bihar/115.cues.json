   "title": "## هزینه برای حجت خدا؛ کعبهٔ دل‌ها",
   "start": 39.16,
   "end": 111.24
  },
  {
   "index": 2,
   "title": "## روایت صله به امام؛ افضل از هزار هزار درهم",
   "start": 111.24,
   "end": 131.42
  },
  {
   "index": 3,
   "title": "## نیت صله و موج عشق دوطرفه",
   "start": 131.42,
   "end": 504.15
  },
  {
   "index": 4,
   "title": "## خلقت الأشیاء لأجلک؛ خرج الهی برای انسان",
   "start": 504.15,
   "end": 667.51
  },
  {
   "index": 5,
   "title": "## فروعات؛ حق‌الناس و ناموس خدا",
   "start": 667.51,
   "end": 687.67
  },
  {
   "index": 6,
   "title": "## سه کار از شیخ انصاری؛ قضاوت نکنید",
   "start": 687.67,
   "end": 824.75
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.04,
   "end": 10.8,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.8,
   "end": 13.62,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.62,
   "end": 16.56,
   "text": "و ربانیه آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.56,
   "end": 18.96,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.96,
   "end": 22.28,
   "text": "در ادامه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.28,
   "end": 25.84,
   "text": "روایت نهم از باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.84,
   "end": 31.62,
   "text": "بهار در خصوص خرج کردن بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.62,
   "end": 37.36,
   "text": "به فرمایش اون حدیث قدسی که ابن عربی در فسوس آوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.36,
   "end": 40.52,
   "text": "اگر می‌خوای دلت آسمونی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.52,
   "end": 44.38,
   "text": "خرج آسمون کن. اگر می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.38,
   "end": 48.96,
   "text": "به باطن راه پیدا کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.96,
   "end": 54.34,
   "text": "خرج باطن کن. اکثر خرج‌هایی که ما می‌کنیم سر، صرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.34,
   "end": 58.24,
   "text": "ظواهره در، یعنی صرف ظاهر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.24,
   "end": 62.24,
   "text": "خرج ظاهر می‌شه. باطن خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.24,
   "end": 69.82,
   "text": "مدنظر نیست و الا ما قطعاً راهی به باطن پیدا می‌کردیم و علقه بسیار زیادی نسبت به باطن پیدا می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.82,
   "end": 75.92,
   "text": "این البته عکسش هم هست. یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.92,
   "end": 83.1,
   "text": "اگر می‌فرمود دل مردم جایی است که پول خرجش می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.1,
   "end": 86.28,
   "text": "می‌شه گفت که این چ-- این چنین هم گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.28,
   "end": 89.78,
   "text": "که پولت رو جایی خرج کن که قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.78,
   "end": 96.24,
   "text": "دلبستن باشه. چون هر کجا که خرج کنی دل به اون سمت متمایل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.24,
   "end": 99.64,
   "text": "میل دل، رغبت دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.64,
   "end": 103.12,
   "text": "به سمت جایی میره که به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.12,
   "end": 105.28,
   "text": "سمت پول هزینه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.28,
   "end": 110.96,
   "text": "لذا جایی که ارزشمنده پولت رو هزینه کن تا دلت به اون سمت رغبت پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.96,
   "end": 116.58,
   "text": "اینم یک وجه. خب کی از در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.58,
   "end": 123.12,
   "text": "نشئه اولی کی ارزشش بالاتر از اینه که ما پولمون رو پاش بریزیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.12,
   "end": 129.22,
   "text": "جز حجت خدا؟ کی قیمتش بالاتر از اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.22,
   "end": 139.14,
   "text": "کی دل‌ها به او معطوف بشود ارزشش بیشتر از اینه که دل معطوف به حجت خدا بشه که او کعبه دل‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.14,
   "end": 143.02,
   "text": "کعبه یک سنگ نشانی‌ست که ره گم نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.02,
   "end": 147.22,
   "text": "حاجی احرام دگر بند ببین یار کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.22,
   "end": 150.38,
   "text": "اصلاً فصل الخطاب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 150.38,
   "end": 152.56,
   "text": "عندکمه دیگه، نزد اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.56,
   "end": 157.64,
   "text": "تو جامعه کبیره می‌خونیم فصل الخطاب دست اونا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.64,
   "end": 165.22,
   "text": "رابطه ما با امام زمانمون هر مقداری هست، رابطه ما با خدا همان گونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.22,
   "end": 169.04,
   "text": "اصلاً اون میزان حجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.04,
   "end": 175.6,
   "text": "حتی اینکه امام رضا صلی الله علیه فرمود قامت السماوات والأرض بالحجة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 175.6,
   "end": 178.8,
   "text": "خیلی فرمایش عزی-- عظیمی‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 178.8,
   "end": 184.64,
   "text": "حجت، برهان. منظور این حجت قاطع، این برهان قاطع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.64,
   "end": 190.4,
   "text": "دلیل قاطع، انسان کامله، امام زمان هر نشئه ایست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 190.4,
   "end": 196.28,
   "text": "هر عصری‌ست که الان در عصر ما والعصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 196.28,
   "end": 202.52,
   "text": "در این عصر که بهش می‌گن عصر محمدی صلی الله علیه و آله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.52,
   "end": 205.4,
   "text": "صلی الله محمد و آله .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.4,
   "end": 211.32,
   "text": "که زبده و خلاصه و برجسته و چکیده همه فضائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 211.32,
   "end": 215.42,
   "text": "در اون جمعه، اون شخص برگزیده امـ– امام زمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.42,
   "end": 219.74,
   "text": "خوشا به سعادت کسی که پولش رو هزینه امام زمان کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 219.74,
   "end": 221.32,
   "text": "و در خدمت حضرت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 221.32,
   "end": 223.86,
   "text": "حالا اون خمس و زکات و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 223.86,
   "end": 229.22,
   "text": "اونکه واجبه. کسی، کسی اون رو ادا نکنه که هیچی اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.22,
   "end": 232.28,
   "text": "از دایره دیانت خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 232.28,
   "end": 235.18,
   "text": "نه ما فعلاً در بحث انفاق داریم، انفاق مستحب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 235.18,
   "end": 238.82,
   "text": "می‌گه می‌خواد مستحب کار خیر انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.82,
   "end": 241.32,
   "text": "یه روایت براتون بخونم کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 241.32,
   "end": 244.8,
   "text": "اینایی که در راه امام زمان، در راه امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.8,
   "end": 250.36,
   "text": "اینا پول هزینه می‌کنند اما بحث باطن رو در نظر داشته باشید چون روایت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 250.36,
   "end": 254.94,
   "text": "که اون شخص گفت آقا چرا من از مرگ بدم میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.94,
   "end": 258.52,
   "text": "پیغمبر فرمود چون پول خرج نمی‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.52,
   "end": 262.5,
   "text": "پیشکش نمی‌کنی برای مرگت که ما گفتیم مرگ چون سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.5,
   "end": 265.62,
   "text": "ظاهر به باطنه یعنی پولت رو خرج باطن نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.62,
   "end": 269.5,
   "text": "حقایق مکنون، پشت پرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.5,
   "end": 273.78,
   "text": "اصول کافی، جلد یک، صفحه پانصد و سی و هشت، باب صله به امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.78,
   "end": 275.96,
   "text": "این یک منبع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.96,
   "end": 280.18,
   "text": "مکيال المكارم، جلد دو، صفحه سیصد و پنجاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.18,
   "end": 287.26,
   "text": "و دو. اینم یک منبعی که من قبلاً عرض کردم اگه کسی می‌خواد امام زمانی که الان تو ذهنشه بذارش کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 287.26,
   "end": 293.62,
   "text": "یه امام زمان جدیدی رو پیدا کنه، این کتاب دو جلدی مکيال المكارم رو قطعاً بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 293.62,
   "end": 298.24,
   "text": "بعد بره سراغ کتاب أبغری الحسان که اون دیگه عالی، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 298.24,
   "end": 304.36,
   "text": "امام صادق صلی الله علیه فرمود درهم و یوصل به الامام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 304.36,
   "end": 309.4,
   "text": "درهمی که وصل بشه به امام، صله داده بشه به در راه امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 309.4,
   "end": 313.3,
   "text": "برسه به امام، در راه امام زمانت هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.3,
   "end": 316.92,
   "text": "افضل و برتر از چیه به نظرتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 316.92,
   "end": 319.96,
   "text": "مقایسه رو ببینید. از چند درهم بالاتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.96,
   "end": 322.46,
   "text": "یه درهم، حالا یه تومن به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.46,
   "end": 325.14,
   "text": "بدی در راه امام زمانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.14,
   "end": 326.76,
   "text": "افضل، این قیاس رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 326.76,
   "end": 329.76,
   "text": "اونم قیاس نسبت به کارهای خیرها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 329.76,
   "end": 332.3,
   "text": "در هم-- مطلق کارهای خیره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 332.3,
   "end": 335.0,
   "text": "نه کار غیر خیر، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.0,
   "end": 340.06,
   "text": "کار، کار خیره. مطلق کارهای خیر رو بذار یه طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.06,
   "end": 343.58,
   "text": "یه تومنی که در راه امام زمانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.58,
   "end": 346.68,
   "text": "خرج کنی فرمود افضل من الف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.68,
   "end": 350.58,
   "text": "الف درهم. الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.58,
   "end": 355.28,
   "text": "که فيما سواه من وجوه البر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.28,
   "end": 357.06,
   "text": "این البر رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.06,
   "end": 361.8,
   "text": "یعنی وجوهی که در راه خیر و نیکی و اینا هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.8,
   "end": 365.91,
   "text": "دو میلیون برابر. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.91,
   "end": 370.07,
   "text": "یعنی دو میلیون کار خیر رو در نظر بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.07,
   "end": 376.07,
   "text": "اینطوری میشه گفت. یه کار خیری که برای امام زمان در راه آقا صله به حضرت بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 376.07,
   "end": 381.03,
   "text": "وصل به حضرت بشه. تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.03,
   "end": 386.57,
   "text": "یعنی حد و اندازه‌ش میگه تازه خیر برتر از دو میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.57,
   "end": 390.39,
   "text": "دو میلیون هم دیگه اون موقع اصلا نمی‌تونستن دو میلیون رو بشمرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 390.39,
   "end": 393.71,
   "text": "حالا می‌گفتن هزار، حالا طرف شاید می‌تونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.71,
   "end": 396.75,
   "text": "می‌گفت به عدد گله مثلا فلان جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.75,
   "end": 401.33,
   "text": "ولی دو میلیون دیگه هزار هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.33,
   "end": 404.73,
   "text": "، کی می‌تونست بگه؟ یا دو هزار تا هزار تا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.73,
   "end": 412.43,
   "text": "نمی‌تونستن. عدد یعنی این، یعنی انقدر اصلا غیر قابل شمارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 412.43,
   "end": 414.49,
   "text": "دو هزار تا هزار تا نمیدونم دو میلیون تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 414.49,
   "end": 417.09,
   "text": "اینا تو روایات همچنین زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 417.09,
   "end": 421.39,
   "text": "عدد بالای هزار رو دیگه اصلا عرب نمی‌تونست بشماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.39,
   "end": 427.61,
   "text": "خب حالا چقدر خوبه که آدم یه راهی پیدا کنه هزینه امام زمانش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 427.61,
   "end": 432.69,
   "text": "نیت کنیم بگیم آقا مثلا من یه هر تا یه پول کمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.69,
   "end": 435.21,
   "text": "ها از مالم کنار بذارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 435.21,
   "end": 438.19,
   "text": "آقا دوست دارم اینو صله در راه شما بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 438.19,
   "end": 440.59,
   "text": "شما مشخص کن به کی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 440.59,
   "end": 442.95,
   "text": "نیت کنید ببینید آقا براتون مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 442.95,
   "end": 445.91,
   "text": "معامله کنید با آقا در راه عشق حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.91,
   "end": 449.21,
   "text": "هیچ‌وقت یادم نمیره این فرمایش‌های برجس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.21,
   "end": 451.81,
   "text": "که به خود بنده فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 451.81,
   "end": 455.17,
   "text": "دو ساعت نشستم تا از ایشون یه فیضی بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 455.17,
   "end": 458.73,
   "text": "یه نگاه عمیقی به بنده کردن و حالا مفصل قبلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.73,
   "end": 461.31,
   "text": "بخشیشو گفتم و همین رو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.31,
   "end": 466.27,
   "text": "در راه امام زمان مفاتیح، دعاها، زیارات و صدقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.27,
   "end": 470.77,
   "text": "به نیت آقا. بعد موج عشق شما تو دل حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.77,
   "end": 474.83,
   "text": "میفته و بالعکس محبت آقا تو دل شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 474.83,
   "end": 478.97,
   "text": "این یکی از بهترین راه‌هایی که انسان عاشق امام زمان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 478.97,
   "end": 481.39,
   "text": "میگه آقا من نمی‌تونم. نمی‌دونم چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.39,
   "end": 487.05,
   "text": "بسیار تو همین محرم مخصوصا نوجوونا، جوونا می‌اومدن می‌گفتن حاج آقا ما نمی‌تونیم ارتباط با امام حسین بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 487.05,
   "end": 488.77,
   "text": "ملت خودشونو می‌کشن ما نمی‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.77,
   "end": 492.91,
   "text": "راه رو، یه راهش اینه. پول خرج کن در راه امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 492.91,
   "end": 496.61,
   "text": "دلت میره. این سر روایته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 496.61,
   "end": 504.15,
   "text": "خب چرا ما متاسفانه ما تا بحث، بحث پول میاد جبهه می‌گیریم، فاصله می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 504.15,
   "end": 510.07,
   "text": "حالا اتفاقا امروز داشتم فکر می‌کردم و واقعا هم مردد بودم اینو بگم خدمت شما یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.07,
   "end": 511.87,
   "text": "امیدوارم درست برداشت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.87,
   "end": 517.31,
   "text": "خیلی حرفا دوست داریم بزنیم بنا به دلایلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.31,
   "end": 519.57,
   "text": "، جیگر گفتنش رو داریم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 519.57,
   "end": 522.05,
   "text": "اما نمی‌دونم شما جگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.05,
   "end": 523.79,
   "text": "شنیدنشو داشته باشید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 523.79,
   "end": 528.81,
   "text": "تحمل می‌خواد بعضی حرفا هم گفتنش هم شنیدنشه و بعد برداشت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.81,
   "end": 534.57,
   "text": "به نظر شما خدا خرج کی کرده همه دارایی‌شو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 534.57,
   "end": 539.51,
   "text": "اولا کیو بیشتر از همه دوست داره بین خلائقش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.51,
   "end": 544.55,
   "text": "دو، همه‌ی خلق، اون دارایی‌شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.55,
   "end": 547.15,
   "text": "خرج کی کرده؟ پای کی ریخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 547.15,
   "end": 550.73,
   "text": "مشخصه. از هر دو راه میشه اینو تشخیص داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 550.73,
   "end": 553.47,
   "text": "یه روایت براتون بخونم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.47,
   "end": 557.97,
   "text": "همین رو حالا من خیلی تصریحا نگفتم، تلویحا گفتم رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 557.97,
   "end": 560.17,
   "text": "اما این روایت تصریح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.17,
   "end": 564.09,
   "text": "جواهر الثانیه صفحه سیصد و شصت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 564.09,
   "end": 568.09,
   "text": "شش. خلقت الأشیا لأجلك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 568.09,
   "end": 571.17,
   "text": "آدم، همه‌ی اشیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.17,
   "end": 573.31,
   "text": "همه‌ی خلائق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 573.31,
   "end": 576.17,
   "text": "به خاطر تو آفریدم. لأجلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 576.17,
   "end": 579.19,
   "text": "پای تو ریختم به این معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 579.19,
   "end": 583.73,
   "text": "و خلقتک و تو رو برای کی خلق کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.73,
   "end": 585.75,
   "text": "لأجلی برای خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.75,
   "end": 590.29,
   "text": "که تو پا، تو خودتو خرج من کنی به این معنا بریزی پای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.29,
   "end": 596.25,
   "text": "یعنی اصلا نمی‌تونی کسی رو پیدا کنی که وزن‌گیری کنی، وزن‌کشی کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.25,
   "end": 598.87,
   "text": "ارزش این معامله رو داشته باشه جز خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 598.87,
   "end": 600.99,
   "text": "خدا میگه بنده من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.99,
   "end": 604.93,
   "text": "تو فقط خودت رو خرج من کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.93,
   "end": 606.87,
   "text": "همه چی رو برای تو خرج کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.87,
   "end": 610.07,
   "text": "تو خودت رو برای من خرج کن چون تو رو برای خودم خلق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.07,
   "end": 611.89,
   "text": "حالا اینکه این معناش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 611.89,
   "end": 614.43,
   "text": "یعنی همه چی رو برای تو خلق کردم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.43,
   "end": 616.97,
   "text": "یعنی دارایی‌م رو ریختم پای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.97,
   "end": 621.21,
   "text": "ببینید این بود که گفتم انشاالله بد برداشت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.21,
   "end": 623.75,
   "text": "ما روایت میگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.75,
   "end": 626.85,
   "text": "دل آدما جاییه که بابتش پول خرج می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.85,
   "end": 631.65,
   "text": "حالا به یک وجه، به یک معنا، جهت سهولت فهم اشکال نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.65,
   "end": 634.25,
   "text": "اینطوری مثال می‌زنیم. تمثیله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.25,
   "end": 641.77,
   "text": "برای اینکه قوه خیال قوی بشه بتونه صورت و شکل بیاره تو وجود ما، ما ببینیمش این حقیقت رو تا بچشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.77,
   "end": 643.71,
   "text": "خدا هم پولشو کجا ریخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 643.71,
   "end": 647.21,
   "text": "خرج کی کرده؟ دارایی‌شو پای کی ریخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.21,
   "end": 651.93,
   "text": "انسان. برای همینه که اهدی رو مثل انسان دوست نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 651.93,
   "end": 659.19,
   "text": "اصلا انسان. حالا این انسان، انسان کامل که شد دیگه شوق و حب خدا بهش شدت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 659.19,
   "end": 661.83,
   "text": "تام می‌گیره و نسبت به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 661.83,
   "end": 664.35,
   "text": "حالا اینکه در مسیر حق باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.35,
   "end": 668.87,
   "text": "این حب کمتر می‌شه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.87,
   "end": 672.15,
   "text": "اینجا وقتی آدم یه مقدار توجه می‌کنه چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.15,
   "end": 674.25,
   "text": "کثیر الفروع این حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.25,
   "end": 677.59,
   "text": "که چه فروعاتی از این اصل بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.59,
   "end": 680.63,
   "text": "مثلا چقدر آدم باید مراقب چی باشه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 680.63,
   "end": 686.19,
   "text": "حق الناس. انقدر که ناس مردم، مردم ناموس خدا، عیال خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 686.19,
   "end": 688.91,
   "text": "انقدر خدا دوست داره این مردمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.91,
   "end": 690.77,
   "text": "اصلا از این وجه نگاهش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.77,
   "end": 693.29,
   "text": "نه اینکه مردم سخت گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 693.29,
   "end": 695.77,
   "text": "نه، خدا سخت پسنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.77,
   "end": 698.01,
   "text": "فقط انسان رو اختیار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 698.01,
   "end": 700.63,
   "text": "بقیه رو پاش ریخته، خرجش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 700.63,
   "end": 704.81,
   "text": "بعد خدا میگه حق الناس داری برو از خودش راضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 704.81,
   "end": 710.21,
   "text": "رضایت بگیر. چون این ب، این، این آدم، انسان، این انسانه برای من عزیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 710.21,
   "end": 715.83,
   "text": "چرا نمیره و نمیگه برو معذرت بخواه، عذر می‌خوام از این سگه، از این گاوه، از این گوساله، از این خره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 715.83,
   "end": 720.61,
   "text": "حلالیت بطلب؟ میگه برو از این انسان حق الناس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.61,
   "end": 726.03,
   "text": "اینو حلالیت بطلب. انقدر که پیش خدا ارزش پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.03,
   "end": 728.25,
   "text": "ببینید اینا چیزاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.25,
   "end": 731.65,
   "text": "آدم رو یه مقدار مراقب می‌شه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.65,
   "end": 736.13,
   "text": "مراقبت انسان رو زیاد می‌کنه که حواسش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.13,
   "end": 741.57,
   "text": "که با کی طرفه. اینایی که دل می‌شکنن، اینایی که آبرو می‌برن، اینایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 741.57,
   "end": 744.47,
   "text": "به راحتی نون این و اون رو می‌برونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 744.47,
   "end": 747.13,
   "text": "به راحتی قضاوت در رابطه با دیگران می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 747.13,
   "end": 749.59,
   "text": "اینا خیلی کارشون خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 749.59,
   "end": 752.73,
   "text": "این بچه‌های امنیتی، این بچه‌های نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 752.73,
   "end": 755.83,
   "text": "صیانتی، حراستی، چی بگم حالا هر اسم بخوای بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.83,
   "end": 757.97,
   "text": "اینا خیلی کارشون سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 757.97,
   "end": 760.57,
   "text": "خیلی باید مراقب باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 760.57,
   "end": 768.25,
   "text": "پوست می‌کنه خدا. اینم بهتون ق-قبلا گفتم حالا که بحث به اینجا رسید اینم باز دوباره بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 768.25,
   "end": 773.63,
   "text": "جدیدن بشنون، بشنویم هممون باز هم که شیخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 773.63,
   "end": 777.27,
   "text": "شیخ مرتضی بزرگ، شیخ مرتضی امصاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 777.27,
   "end": 783.15,
   "text": "فرمودن یه کار رو فقط برای خدا انجام بده، برای غیر خدا ترکش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 783.15,
   "end": 787.93,
   "text": "اونم امام جماعت شدنه. اگه برای خداست انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 787.93,
   "end": 792.29,
   "text": "یه کار رو چه برای خدا بود، چه برای غیر خدا هم بود انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 792.29,
   "end": 795.21,
   "text": "عجب! چیه اون؟ تحصیل علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 795.21,
   "end": 797.05,
   "text": "چون نور، علم نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 797.05,
   "end": 799.99,
   "text": "خود به خود هدایتت می‌کنه، می‌کشونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.99,
   "end": 806.23,
   "text": "و یه کار رو اینجاست عجیب، چه برای خدا بود، چه غیر خدا مطلقا انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 806.23,
   "end": 812.79,
   "text": "فرمود قضاوت. قضاوت نکنین اینو اونو به راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 812.79,
   "end": 817.55,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 817.55,
   "end": 824.75,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}