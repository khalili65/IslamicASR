 },
 "chapters": [
  {
   "index": 0,
   "title": "## تتمیم روایت چهارم؛ نور مؤمن و نار کافر",
   "start": 8.24,
   "end": 121.1
  },
  {
   "index": 1,
   "title": "## اصل رویداد در درون انسان",
   "start": 121.1,
   "end": 166.66
  },
  {
   "index": 2,
   "title": "## کسانی که همّشان خوردن است؛ آیات حجر و محمد",
   "start": 166.66,
   "end": 189.54
  },
  {
   "index": 3,
   "title": "## جمجمهٔ کافر و سنگ چخماق؛ آشکار شدن باطن",
   "start": 189.54,
   "end": 456.06
  },
  {
   "index": 4,
   "title": "## موت سفر از ظاهر به باطن؛ بل الإنسان علی نفسه بصیرة",
   "start": 456.06,
   "end": 687.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.3,
   "end": 9.72,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.72,
   "end": 14.7,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.7,
   "end": 17.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.8,
   "end": 21.08,
   "text": "می‌رسیم سراغ بحثی که دیروز نیمه کارموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.08,
   "end": 25.82,
   "text": "به فضل الهی دیگه شاید جمع کردیم دیگه بحثمون رو پیرامون روایت چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.82,
   "end": 28.78,
   "text": "شما متوجه شدید دقیقا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.78,
   "end": 36.14,
   "text": "به گزاف نگفتیم این روایت بسیار درون مایه داره و می‌طلبه که ده‌ها منبر باهاش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.14,
   "end": 38.6,
   "text": "با توجه به صدر و ذیل آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.6,
   "end": 41.4,
   "text": "به اینجا رسیدیم که اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.4,
   "end": 45.0,
   "text": "می‌فرماد یبسر ویعمل بالنور اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.0,
   "end": 47.94,
   "text": "این در صدر روایت اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.94,
   "end": 52.02,
   "text": "با-- اگر کسی مبدأ اعمالش شد نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.02,
   "end": 56.02,
   "text": "خب چنین کسی کارش به جایی میره که می‌رسه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.02,
   "end": 61.1,
   "text": "ذیل روایت می‌فرماید فما کان من نفس المؤمن فهو نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.1,
   "end": 66.14,
   "text": "نفس مؤمن اونچه که از نفس مؤمن باقی می‌مونه خودش نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.14,
   "end": 68.12,
   "text": "که البته مؤیدٌ بالعقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.12,
   "end": 71.54,
   "text": "به عقل تأیید شده‌ست. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.54,
   "end": 76.48,
   "text": "باز به صدر آیه دقت کنیم که يأکل ويشرب بالنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.48,
   "end": 82.12,
   "text": "روایت ببخشید. این‌ها می‌خورند و می‌آشامند با نار با آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.12,
   "end": 87.76,
   "text": "بعد ذیل روایت می‌فرمود که وما کان من نفس الكافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.76,
   "end": 90.22,
   "text": "آنچه که از نفس کافر می‌مونه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.22,
   "end": 92.36,
   "text": "فهو نار خودش ناره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.36,
   "end": 97.94,
   "text": "مؤیدٌ بنکر که بعد فها له صورت نار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.94,
   "end": 99.92,
   "text": "و هاله صورت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.92,
   "end": 102.34,
   "text": "که حالا توضیح اجمالی دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.34,
   "end": 105.4,
   "text": "این نکته‌جامون که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.4,
   "end": 108.0,
   "text": "مؤید بنکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.0,
   "end": 111.86,
   "text": "یعنی از طریق بدیه‌ها شیطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.86,
   "end": 115.24,
   "text": "یا اون ابلیس درونش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.24,
   "end": 118.12,
   "text": "که نفس اماره‌ست اینا تأیید می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.12,
   "end": 123.66,
   "text": "کیا نار. ما هی می‌شینیم مثلا بین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.66,
   "end": 130.5,
   "text": "اشرار و آشوبگران و چه و اینا می‌گردیم دنبال عوامل بیرونی در حالی که اصلش تو خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.5,
   "end": 133.94,
   "text": "یعنی اصل این خودش یک نکته مهمی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.94,
   "end": 136.14,
   "text": "روانشناسی تربیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.14,
   "end": 140.44,
   "text": "هرچه اتفاق میفته در درون خود انسان اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.44,
   "end": 145.56,
   "text": "قیامت هم وقتی عده می‌ریزن سر شیطان که آقا یا ابالسه یا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.56,
   "end": 149.36,
   "text": "شیطان خودشونو پیدا می‌کنن میگن آقا تو من رو اغوا کردی، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.36,
   "end": 155.4,
   "text": "ابالسه مخصوصا اون ابلیس اصلی میگه آقا ما فقط دعوت کردیم خودت خواستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.4,
   "end": 160.92,
   "text": "ما نبودیم که عمل کردیم، تو عمل کردی و هرچه که هست در درون انسان رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.92,
   "end": 164.86,
   "text": "لذا اینجا توضیح هم دادیم که فهو نور باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.86,
   "end": 168.22,
   "text": "فهو نار. حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.22,
   "end": 170.6,
   "text": "می‌فرماید اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.6,
   "end": 176.14,
   "text": "بر اساس اون ذیل روایت، اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.14,
   "end": 180.52,
   "text": "صرفا همتش شده خوردن و خوابیدن به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.52,
   "end": 183.32,
   "text": "يأكل ويشرب همش توجهش به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.32,
   "end": 185.86,
   "text": "این صدر روایت بود که چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.86,
   "end": 188.6,
   "text": "شکم پر کنه خالی کنه به قول حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.6,
   "end": 194.44,
   "text": "این بعد آخرش در ذیل روایت میشه فهو نار خودش میشه آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.44,
   "end": 203.24,
   "text": "آیا در آیات قرآن ما داریم که توجه ما رو جلب کرده به اینکه چه کسانی‌اند که همشون خوردنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.24,
   "end": 208.86,
   "text": "شکم پر کردنه. بفرمایید آیه سه سوره حجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.86,
   "end": 212.44,
   "text": "می‌فرمود و ارهم پیغمبر اینا رو رهاشون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.44,
   "end": 215.96,
   "text": "چرا اینا رو رها کنیم؟ اینکه میگه و ارهم یعنی دیگه امیدی به اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.96,
   "end": 220.32,
   "text": "کارشون تمومه. چرا؟ چه اتفاقی افتاده که به اینا امیدی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.32,
   "end": 223.24,
   "text": "يأكل و يتمتع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.24,
   "end": 226.12,
   "text": "این‌ها همش کارشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.12,
   "end": 229.96,
   "text": "اینکه بخورن يأكل و يتمتع تمتع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.96,
   "end": 232.28,
   "text": "دنیایی پیدا کنن و ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.28,
   "end": 236.56,
   "text": "و فرمود و یلههم العمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.56,
   "end": 241.16,
   "text": "این‌ها، این‌ها سرگرم اون آرزوهاشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.16,
   "end": 244.46,
   "text": "آرزوهاشون این چیزاست. اگر تو این آشوب‌ها می‌بینی یکی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.46,
   "end": 248.46,
   "text": "مثلا تحلیل می‌کنی، می‌بینی انتهای خواسته تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.46,
   "end": 251.06,
   "text": "بعد میبینی آخر آخرش مثلا عریانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.06,
   "end": 256.66,
   "text": "اینو آزادی می‌دونه. یعنی حیوانی زندگی کردن رو آزادی خودش می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.66,
   "end": 258.3,
   "text": "این یعنی سرگرم همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.3,
   "end": 261.34,
   "text": "یعنی دقیقا همین آیه داره می‌زنه به همین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.34,
   "end": 263.26,
   "text": "که حالا باید بهش گفت بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.26,
   "end": 270.54,
   "text": "حضرت آدم و حوا اگر به اون میوه ممنوعه نزدیک شدن، به محض اینکه از اون خوردن قرآن می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.54,
   "end": 273.98,
   "text": "چی-- چه اتفاقی افتاد؟ لباساشون افتاد، عریان شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.98,
   "end": 276.44,
   "text": "زشتی‌هاشون آشکار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.44,
   "end": 282.1,
   "text": "درسته؟ یعنی این یه، یه تمدن نیست، این هنر نیست عریانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.1,
   "end": 286.0,
   "text": "یه چیز پلید زشته از چشم خدا افتادنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.0,
   "end": 291.96,
   "text": "آیا باز آیه دیگه‌ای داریم؟ حالا بله من یکی دو تا چون وقت کمه تبرکی به شما میگم و الا زیادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.96,
   "end": 300.14,
   "text": "آیه دوازده سوره محمد صلى الله عليه و آله وسلم رو برید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.14,
   "end": 303.7,
   "text": "می‌فرماید يتمتعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.7,
   "end": 308.84,
   "text": "و يأكلون. چگونه این‌ها اهل تمتع دنیایی و خوردنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.84,
   "end": 312.6,
   "text": "اینجا قشنگ بازش می‌کنه. كما مثل اینکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.6,
   "end": 315.48,
   "text": "تأكل الأنعام. چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.48,
   "end": 319.78,
   "text": "اانعام چهارپاها همش، همشون خوردن و خوابیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.78,
   "end": 323.52,
   "text": "اینام اینطوری می‌شن. وقتی به این سوره البته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.52,
   "end": 326.24,
   "text": "تفاسیر روایی اگر دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.24,
   "end": 331.64,
   "text": "این منظور از این دسته آدم که قرآن از این‌ها به کفار یاد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.64,
   "end": 338.4,
   "text": "فرمودن مخلص کلام جان کلام در تفاسیر روایی فرمودن مخ-- این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.4,
   "end": 342.2,
   "text": "دشمنان امیرالمؤمنینن. کسایی که اصلا کارشون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.2,
   "end": 345.96,
   "text": "این نشون میده که از نور ولایت دور شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.96,
   "end": 350.18,
   "text": "میفتی تو آتش غضب خدا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.18,
   "end": 353.24,
   "text": "انگار که پشت کردی به خورشید، سایه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.24,
   "end": 355.36,
   "text": "رو کن به خورشید چه سایه‌ای می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.36,
   "end": 362.8,
   "text": "همش نوره. پشت که کنی به خورشید ولایت همش تاریکی می‌بینی، آتش می‌بینی، خودت یکپارچه آتش میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.8,
   "end": 367.52,
   "text": "حالا جالبه که در یک جایی دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.52,
   "end": 371.92,
   "text": "در روایت حالا هرچی امروز بررسی کردم پیداش نکردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.92,
   "end": 375.54,
   "text": "یه جا نا-- یادداشت کردم منبعش هم بود پیداش نکردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.54,
   "end": 381.86,
   "text": "که کجا دیدم. که شخصی اومد پیش امیرالمؤمنین گفت شما گفتید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.86,
   "end": 386.98,
   "text": "مثلا آدمی که گناهکاره، کافره، مشرکه، منافقه این‌ها خودشون آتش میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.98,
   "end": 389.92,
   "text": "حضرت فرمود بله قرآن داره میفرماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.92,
   "end": 393.56,
   "text": "اتفاقا این آیه هم آیه چهل و نهم سوره توبه هم اینو میفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.56,
   "end": 396.84,
   "text": "\"ان جهنم لمحيطة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.84,
   "end": 400.8,
   "text": "بالكافرين\". احاطه کامل پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.8,
   "end": 404.78,
   "text": "لام تأکید هم داره، ان هم داره چند تا تأکید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.78,
   "end": 407.94,
   "text": "قشنگ آتش با وجود اینا عجین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.94,
   "end": 410.2,
   "text": "اصلا خودشون آتش میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.2,
   "end": 412.72,
   "text": "بعد حضرت فرمود بله قرآن میفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.72,
   "end": 417.0,
   "text": "این شخص یک جمجمه‌ای از یک کافری رو پیدا کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.0,
   "end": 419.16,
   "text": "می‌دونست این شخص کافر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.16,
   "end": 422.08,
   "text": "حالا مثلا بخواد نچ مولا ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.08,
   "end": 427.24,
   "text": "این جمجمه رو داد دست مولا علی گفت آقا مگه نمیگید که این خودش آتشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.24,
   "end": 431.88,
   "text": "ببینید چقدر سرده این جمجمه استخوان این آدم کافر سرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.88,
   "end": 434.22,
   "text": "چگونه آتش در درونشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.22,
   "end": 438.78,
   "text": "مولا هم خیلی قشنگ و شیرین یه سنگ چخماق آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.78,
   "end": 442.46,
   "text": "گفتن دست بزن به این سنگ ببینم دستت گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.46,
   "end": 444.74,
   "text": "س-- خیلی سرده. گفت آره خنکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.74,
   "end": 448.16,
   "text": "حضرت اینو زد به هم آتش زد بیرون فرمود دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.16,
   "end": 450.34,
   "text": "در داخلش آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.34,
   "end": 452.42,
   "text": "چقدر زیبا فهموند به طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.42,
   "end": 455.86,
   "text": "این شکلی. یعنی هرچی که هست در درون ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.86,
   "end": 459.3,
   "text": "و اصلا موت عزیزان گوش بده عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.3,
   "end": 461.04,
   "text": "نیومده اینجا با هم گفت‌وگو کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.04,
   "end": 463.7,
   "text": "گفت‌مان ما یه جای دیگه‌ست. اینجا صحبت فعلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.7,
   "end": 466.82,
   "text": "یه طرف است. ما آخوندها میگیم شما گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.82,
   "end": 472.66,
   "text": "بعد از جلسه گفت‌وگان-- گفت‌مان می‌کنیم، یقه همدیگه رو می‌گیریم دوست داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.66,
   "end": 475.32,
   "text": "اینجا عزیز دلم داره چی رو اثبات می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.32,
   "end": 479.04,
   "text": "اینکه حتی موت هم یعنی سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.04,
   "end": 481.04,
   "text": "اونجا مولا علی چی کار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.04,
   "end": 483.06,
   "text": "باطن این جمجمه رو آشکار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.06,
   "end": 486.1,
   "text": "مثل سنگ چخماق که باطنش را آشکار-- اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.1,
   "end": 488.9,
   "text": "در درونشه. الانم این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.9,
   "end": 496.94,
   "text": "در حقیقت اموات ما دیگه مخلص جان مطلب در مورد روایت چهارم دیگه پرونده‌شو ببندیم فعلا تو جلسه‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.94,
   "end": 499.58,
   "text": "جان مطلب چیه از موت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.58,
   "end": 507.06,
   "text": "درسته کفار میرن به سمت آتش و اصلا خودشون آتش میشن و مؤمنین به سمت نور فهو النور خودشان هم نور میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.06,
   "end": 509.08,
   "text": "اما مخلص کلام چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.08,
   "end": 511.48,
   "text": "از ظاهر به باطن رفتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.48,
   "end": 515.76,
   "text": "از رقیقت که نشئه طبیعته به حقیقت سفر کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.76,
   "end": 522.52,
   "text": "یعنی هرچه که اگر موت یعنی از این نشئه طبیعت از ملک به ملکوت رفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.52,
   "end": 527.22,
   "text": "یعنی از اسم الظاهر به اسم الباطن سفر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.22,
   "end": 532.48,
   "text": "پس موت میشه از ظاهر خودت به باطن خودت سفر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.48,
   "end": 534.24,
   "text": "باطن خودت الان چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.24,
   "end": 536.18,
   "text": "خودت بهتر از هر کسی می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.18,
   "end": 538.58,
   "text": "نمی‌خواد بدی اشراف تو رو بررسی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.58,
   "end": 542.0,
   "text": "پرونده‌تو باز کنه و اینا. اونجا خیلیاش راست و دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.0,
   "end": 545.44,
   "text": "معلوم نیست طرف پدرکشتگی با یکی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.44,
   "end": 548.0,
   "text": "جسارت به شما نشه. متاسفانه هست تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.0,
   "end": 549.62,
   "text": "بوروکراسی اداری این چیزا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.62,
   "end": 551.78,
   "text": "تهمت، غیبت، زیراب زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.78,
   "end": 555.88,
   "text": "اوه، اوه می‌خواد مثلا یکی رو از چشم خودش به از چشم دیگران بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 555.88,
   "end": 559.72,
   "text": "اون متاسفانه غضب نفساش-- نفسانیش رو خالی کنه، می‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.72,
   "end": 561.34,
   "text": "الکی از کاه کوه می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 561.34,
   "end": 563.58,
   "text": "شاید کاهی هم هست اما کوهش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 563.58,
   "end": 566.26,
   "text": "اونا رو ول کن خودت آیا آیه‌ای بر این داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 566.26,
   "end": 569.34,
   "text": "بله. بل الإنسان على نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 569.34,
   "end": 576.74,
   "text": "بصيرة. آقا هر کسی به خودش بصیر هم یعنی شدت آگاهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 576.74,
   "end": 580.3,
   "text": "بصیر بر وزن فعیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 580.3,
   "end": 583.04,
   "text": "هر کسی به شدت به خودش آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 583.04,
   "end": 584.88,
   "text": "خودمون می‌دونیم در درونمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 584.88,
   "end": 587.46,
   "text": "چه خبره. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.46,
   "end": 595.52,
   "text": "ولی وقت موت خودمون می‌دونیم چی کاره‌ایم و اون که می‌ترسه، می‌لرزه، وحشت می‌کنه اینا معلوم در درونش چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 595.52,
   "end": 597.58,
   "text": "اما نه اون که لحظه موت ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.58,
   "end": 601.76,
   "text": "لحظه موت. اون کسی مثل شهید حججی هی می‌زننش، هی می‌زننش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.76,
   "end": 604.52,
   "text": "هی می‌زننش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.52,
   "end": 609.78,
   "text": "مثلا اقرار به ندامت کنه یا مثلا خدای نکرده به رهبر چیزی بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 609.78,
   "end": 612.44,
   "text": "اینا مثل شهید آرمان علی‌وردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 612.44,
   "end": 617.36,
   "text": "نه. تا اسم رهبر رو بردن جسارت به رهبر کن گفت ایشون نور چشم ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 617.36,
   "end": 619.0,
   "text": "من دیدم عین کلام ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.0,
   "end": 622.08,
   "text": "ایشون نور چشم ماست. شما بخواید بزنید بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.08,
   "end": 623.76,
   "text": "یا این چطور میشه که اینطوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.76,
   "end": 628.4,
   "text": "بعد شهید حججی هی بزنن شکنجه‌ش بدن هر بلایی سرش بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 628.4,
   "end": 636.18,
   "text": "آخر اون عزیزی که تنها کسی که کلیپ لحظه شهادتشو دیده ایشونه که ما کنار مزار شهید و پدر شهید دیدیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.18,
   "end": 638.32,
   "text": "دیگه بعد پاک شد به دلایلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 638.32,
   "end": 640.68,
   "text": "دیگه هیچکس ندیده. هرکی گفته دروغ میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.68,
   "end": 642.38,
   "text": "هرکی هم رو کنه همچین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 642.38,
   "end": 645.18,
   "text": "مال کسای دیگه‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.18,
   "end": 651.34,
   "text": "وقتی کادرو اون داعشی معلوم می‌کشه بشینه رو سینه شهید حججی بعد چند ساعت شکنجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 651.34,
   "end": 654.2,
   "text": "شهید حججی می‌خنده، لبخند می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.2,
   "end": 656.52,
   "text": "یک آرامش عجیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 656.52,
   "end": 659.58,
   "text": "خب این محصل چیه فکر می‌کنی بل الإنسان على نفسه بصيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 659.58,
   "end": 663.92,
   "text": "می‌دونه چی کاره‌ست. می‌دونه داره سفر می‌کنه به باطن وجود خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 663.92,
   "end": 665.58,
   "text": "و هر اتفاقی می‌افته اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 665.58,
   "end": 668.42,
   "text": "این قبر که اینجا هست این قبر فقهیه، خاکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 668.42,
   "end": 671.02,
   "text": "برای قبر برای جسم من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.02,
   "end": 676.66,
   "text": "قبر واقعی بدن برزخی‌مونه که نفس و روح ما میره در قالب اون قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 676.66,
   "end": 679.66,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 679.66,
   "end": 683.96,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 683.96,
   "end": 687.9,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}