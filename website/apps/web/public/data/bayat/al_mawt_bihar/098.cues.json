 },
 "chapters": [
  {
   "index": 0,
   "title": "سخن در بابِ بسیار شیرینِ موت است؛ از کتابِ الموت، بابِ چهارم، حدیثِ هفتم. امیرالمؤمنین علیه‌السلام فرموده‌اند:",
   "start": 38.2,
   "end": 153.98
  },
  {
   "index": 1,
   "title": "## داستانِ گورستان و پیامبرِ بنی‌اسرائیل",
   "start": 153.98,
   "end": 174.0
  },
  {
   "index": 2,
   "title": "## اغوای شیطان و حبّ دنیا",
   "start": 174.0,
   "end": 233.9
  },
  {
   "index": 3,
   "title": "## زیارتِ آلِ‌یاسین و توجه در همهٔ اطوار",
   "start": 233.9,
   "end": 812.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.38,
   "end": 6.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.74,
   "end": 10.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.7,
   "end": 17.52,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.52,
   "end": 22.26,
   "text": "سخن در باب بسیار شیرین موت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.26,
   "end": 26.84,
   "text": "از کتاب الموت، باب چهارم، حدیث هفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.84,
   "end": 31.88,
   "text": "قال امیرالمؤمنین سلام الله علیه \"أيها الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.88,
   "end": 36.06,
   "text": "کل امرئ لاقٍ في فراره ما منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.06,
   "end": 44.18,
   "text": "یفر\". همه اینچنین‌اند که بالاخره می‌رسند به اون چیزی که ازش فرار می-می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.18,
   "end": 47.84,
   "text": "که اینجا فرمود \"والأجل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.84,
   "end": 52.06,
   "text": "اون منظور اینجا، منظور از این منطوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.06,
   "end": 59.98,
   "text": "اجل هست، مرگ. که همه، همه ازش فرار می‌کن-- فکر می‌کنند دارند فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.98,
   "end": 63.12,
   "text": "در حالی که \"والأجل مساق النفس الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.12,
   "end": 66.28,
   "text": "نفستو داره همینطوری به اون سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.28,
   "end": 71.62,
   "text": "سوق پیدا می‌کنه. \"والهرب منه موافاته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.62,
   "end": 77.14,
   "text": "در همین طور که فکر می‌کنی داری فرار می‌کنی بالاخره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.14,
   "end": 79.68,
   "text": "بهش برخورد می‌کنی، بهش می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.68,
   "end": 84.86,
   "text": "موافاته. که اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.86,
   "end": 87.54,
   "text": "این باور بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.54,
   "end": 91.38,
   "text": "باور بشه من الان می‌بینم همین پنج تا شهید گمنام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.38,
   "end": 94.96,
   "text": "معمولاً خب انشاالله شما می‌چنین هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.96,
   "end": 99.32,
   "text": "همین از کنارش تا رد می‌شید یه سلامی، یه حمدی، یه توسلی کمک کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.32,
   "end": 103.12,
   "text": "اینا زنده‌اند \"الأحياء عند ربهم یرزقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.12,
   "end": 107.36,
   "text": "کمک کنید این حرف‌هایی که ما می‌زنیم خودمون عامل بشیم در خودمون پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.36,
   "end": 111.3,
   "text": "اینا باورش خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.3,
   "end": 114.76,
   "text": "که باور کنیم واقعاً اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.76,
   "end": 120.82,
   "text": "همین الان اصلاً ما میشه گفت به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.82,
   "end": 125.34,
   "text": "میت هستیم. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.34,
   "end": 129.96,
   "text": "نه م-- إنك ميت وإنهم میتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.96,
   "end": 134.98,
   "text": "به پیغمبر فرمود حتی تو مرده‌ای، دیگران هم مردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.98,
   "end": 139.34,
   "text": "منتها یکی خبر داره، یکی خبر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.34,
   "end": 141.16,
   "text": "که مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.16,
   "end": 143.88,
   "text": "حالا این مرده اینجا منظور پیغمبر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.88,
   "end": 146.22,
   "text": "قبلاً بحث کردیم منظورش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.22,
   "end": 148.98,
   "text": "باورش مهمه، باور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.98,
   "end": 153.98,
   "text": "که متأسفانه اکثراً تا لحظه‌ی مرگ ما این رو توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.98,
   "end": 157.22,
   "text": "در کتاب کلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.22,
   "end": 159.38,
   "text": "جامع التمثیل می‌دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.38,
   "end": 161.96,
   "text": "صفحه دویست و بیست و دو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.96,
   "end": 166.5,
   "text": "یکی از پیامبران بنی‌اسرائیل از گورستونی عبور می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.5,
   "end": 171.24,
   "text": "مردم تا ایشون رو دیدن بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.24,
   "end": 174.9,
   "text": "از اولیای زمانه، می‌دونن صاحب نفسه، ریختن دورش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.9,
   "end": 181.4,
   "text": "مثل الان نبوده که علما انقدر غریب واقع بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.4,
   "end": 184.36,
   "text": "و ریختن دورش. یه چه تقاضای عجیبی هم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.36,
   "end": 187.04,
   "text": "گفتن آقا شما پیغمبر خدایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.04,
   "end": 189.24,
   "text": "یه حجتی برای ما بیار. چی می‌خواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.24,
   "end": 193.88,
   "text": "یه دونه از این میت‌های مرده‌هایی که اینجا تو گور‌اند زنده کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.88,
   "end": 197.96,
   "text": "ما ازش سؤال بپرسیم در خصوص چگونگی جان کندنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.96,
   "end": 201.26,
   "text": "سؤال نکیر و منکر و این همه به ما می‌گید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.26,
   "end": 206.48,
   "text": "بالاخره ما حجتی برای ما تموم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.48,
   "end": 211.56,
   "text": "و خدا نکنه بر کسی حجت تمام بشود و باز ره معصیت بگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.56,
   "end": 214.84,
   "text": "این دیگه خیلی مثل ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.84,
   "end": 219.5,
   "text": "ظهور امام عصر رو به یک معنا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.5,
   "end": 221.42,
   "text": "ظهور انقلاب اسلامی درک کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.42,
   "end": 225.32,
   "text": "به قول حضرت استاد علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.32,
   "end": 230.26,
   "text": "انقلاب اسلامی بین طلوعین ظهور امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.26,
   "end": 235.28,
   "text": "یا به قول خود حضرت امام مقدمه‌ی ظهوره بلکه ابتدای ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.28,
   "end": 239.12,
   "text": "نه مقدمه به معنای ذی المقدمه نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.12,
   "end": 245.54,
   "text": "ابتدای ظهوره. یعنی ظهور رو دیدیم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.54,
   "end": 254.42,
   "text": "خطرناکه. ایشون تفضلی کردن و بالاخره آبرو مایه گذاشتن و از خدا خواستن یکی از این اموات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.42,
   "end": 257.42,
   "text": "سر از قبر بیرون آورده زنده شد و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.42,
   "end": 261.54,
   "text": "و ازش شروع کردن سؤال و جواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.54,
   "end": 264.58,
   "text": "ایشون این جمله رو حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.58,
   "end": 268.7,
   "text": "صحبت زیاد کرده. بخشی از صحبت‌های این میتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.7,
   "end": 272.06,
   "text": "به معجزه‌ی این پیغمبر بیدار شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.06,
   "end": 278.7,
   "text": "بهتون عرض می‌کنم. گفت \"یا أهل الدنيا\" اینکه یا أهل الدنيا به همه‌ی ماست از اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.7,
   "end": 281.56,
   "text": "هم کما اینکه الان روزی شما شده شما هم بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.56,
   "end": 287.9,
   "text": "\"یا أهل الدنيا أنا مت تسعين سنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.9,
   "end": 289.78,
   "text": "من نود ساله که مرده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.78,
   "end": 292.34,
   "text": "\"فما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.34,
   "end": 296.02,
   "text": "ذهب مرارة الموت من حلقی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.02,
   "end": 300.5,
   "text": "هنوز اون سختی و تلخی جان کندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.5,
   "end": 305.98,
   "text": "از حلقم، اصطلاحاً از گلویم، از جانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.98,
   "end": 308.36,
   "text": "نرفته. بعد نود سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.36,
   "end": 312.02,
   "text": "به، به یک معنا می‌گن تب مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.02,
   "end": 315.06,
   "text": "وقتی تا می‌میره کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.06,
   "end": 318.06,
   "text": "، اون آشناهاش که اون ورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.06,
   "end": 322.44,
   "text": "تازه اگه اهل ایمان باشه میخوان بیان دورشو بگیرن به همدیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.44,
   "end": 324.5,
   "text": "تذکر میدن فعلاً نزدیکش نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.5,
   "end": 327.02,
   "text": "الان تب موت داره و حالیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.02,
   "end": 331.6,
   "text": "اصلاً ما رو نمی‌شناسه الان. تو حالت بیهوشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.6,
   "end": 334.88,
   "text": "انقدر اون لحظه حساس. خوشا به حال اون کس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.88,
   "end": 337.38,
   "text": "قبل از اینکه بمیره، بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.38,
   "end": 340.2,
   "text": "قبل از اینکه او را بمیرانند بمیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.2,
   "end": 342.88,
   "text": "یعنی موت سفره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.88,
   "end": 345.98,
   "text": "پوست‌اندازی. من هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.98,
   "end": 350.34,
   "text": "قبل نماز داشتم فکر می‌کردم به این ماره‌هایی که پوست می‌اندازند اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.34,
   "end": 353.42,
   "text": "اینا اصلاً دارن با ما حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.42,
   "end": 356.12,
   "text": "دقیقاً وقت موت یه همچین اتفاقی می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.12,
   "end": 359.44,
   "text": "چیز خاصی نیست. \"إنما تنتقلون من دار إلى دار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.44,
   "end": 362.86,
   "text": "پیغمبر فرمود منتقل می‌شید از داری به دار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.86,
   "end": 365.4,
   "text": "هستید و خواهید بود تا ابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.4,
   "end": 368.86,
   "text": "این پوستت عوض می‌شه. الان این پوست ما اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.86,
   "end": 373.5,
   "text": "این پوست می‌افته. یه پوست دیگه‌ای اون زیریه هنوز هست، الانم باهامونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.5,
   "end": 376.8,
   "text": "حواسمون بهش نیست. موقع خواب حواسمون به اونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.8,
   "end": 378.4,
   "text": "و با اون میریم اینور اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.4,
   "end": 383.84,
   "text": "حالا داریم اونم شکل می‌دیم با اعمالمون که بسطش گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.84,
   "end": 387.44,
   "text": "خلاصه اینکه پیغمبر خدا به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.44,
   "end": 391.12,
   "text": "فرمود که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.12,
   "end": 393.5,
   "text": "چگونه بودی تو دنیا که بودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.5,
   "end": 399.62,
   "text": "چه اعمالی داشتی که بعد نود سال هنوز تلخی جان کندن تو حلقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.62,
   "end": 403.5,
   "text": "ایشون گفت من شیطان مرا اغوا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.5,
   "end": 406.54,
   "text": "امان از شیطان. شیطان این دشمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.54,
   "end": 408.66,
   "text": "دشمن درونه. شیطان درونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.66,
   "end": 410.44,
   "text": "بیرونیه خیلی قوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.44,
   "end": 415.72,
   "text": "این درون که هرچی ما می‌کشیم اهل ایمان از این درون خودمونه، از خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.72,
   "end": 419.0,
   "text": "اصلاً این سر اعوذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.0,
   "end": 423.0,
   "text": "که بزرگان فرمودن آهسته بگو قبل از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.0,
   "end": 424.5,
   "text": "می‌دونید مستحبه قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.5,
   "end": 431.58,
   "text": "حمد در نماز شما اعوذ بالله من الشيطان الرجيم بگی بعد بگی بسم الله الرحمن الرحیم سوره حمدو شروع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.58,
   "end": 433.84,
   "text": "بسم الله رو جهر باید بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.84,
   "end": 436.24,
   "text": "درسته؟ جهر می‌گی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 436.24,
   "end": 438.6,
   "text": "شیعه اینطوری می‌گه. امامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.6,
   "end": 442.88,
   "text": "اما اعوذ بالله رو چرا من ندیدم هیچ بزرگی بلند بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.88,
   "end": 446.62,
   "text": "همه آهسته می‌گن. چرا؟ برای خود من سؤال بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.62,
   "end": 449.08,
   "text": "تا یکی از اساتیدمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.08,
   "end": 452.82,
   "text": "سرش در اینه که شیطان نشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.82,
   "end": 455.4,
   "text": "تو داری استعاذه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.4,
   "end": 459.68,
   "text": "که بالاخره یعنی مثل اینکه نقشتو بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.68,
   "end": 462.96,
   "text": "بشنوه آها پناه بردی حالا ببینم چیکارت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.96,
   "end": 466.24,
   "text": "اینقدر مترصد ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.24,
   "end": 469.6,
   "text": "اینقدر رصد می‌کنه ماها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.6,
   "end": 475.34,
   "text": "و ما بی‌توجه. اتفاقاً جاهایی هم که گمان نمی‌کنیم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.34,
   "end": 479.26,
   "text": "جاهای حساس. حالا بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.26,
   "end": 482.28,
   "text": "ایشون گفتش که شیطان مرا اغوا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.28,
   "end": 485.54,
   "text": "میت که بعد نود سال بیرون اومده از قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.54,
   "end": 488.48,
   "text": "و من دنیا رو دوست داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.48,
   "end": 490.84,
   "text": "سعی می‌کردم جمع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.84,
   "end": 497.78,
   "text": "الان می‌بینم هرچی که جمع کرده بودم گذاشتم و اومدم وارث دارن می‌خورن یاد من هم نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.78,
   "end": 502.94,
   "text": "یه روزی بشه چند جلسه‌ای به فضل الهی پیرامون تکامل برزخی صحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.94,
   "end": 509.08,
   "text": "و اثر ا اون صدقات جاریه‌ای که می‌مونه چه بد، چه خوب اینجا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.08,
   "end": 512.72,
   "text": "تکامل برزخی. چه برای اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.72,
   "end": 517.74,
   "text": "عصیان و عصیان و معصیت، چه برای اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.74,
   "end": 521.24,
   "text": "که اینا رو چگونه شدت رو-- ضریب می‌خوره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.24,
   "end": 527.72,
   "text": "سرعتشون. چه به سمت اسماء جلال که جهنمه، چه به سمت اسماء جمال که بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.72,
   "end": 533.96,
   "text": "اون صدقات جاریه مثل فرزند و کتاب نوشتن و سخن و هدایت دیگران و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.96,
   "end": 536.7,
   "text": "نمی‌دونم کاشتن درخت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.7,
   "end": 541.58,
   "text": "اینایی که در روایاتе بنایی رو تأسیس کنی و فرشی رو وقت مسجد و حسینیه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.58,
   "end": 545.64,
   "text": "اون البته سبقت الله باشه دیگه رنگ خدایی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.64,
   "end": 551.3,
   "text": "در-در فکر می‌کنم جلسه‌ فکر نکنم دیگه یقیناً امروز گوش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.3,
   "end": 555.38,
   "text": "بله جلسه دهم مثقال ons حضرت علامه حسن زاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.38,
   "end": 558.92,
   "text": "شرح مثقال ons. ایشون فرمودن که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.92,
   "end": 562.38,
   "text": "که از دوستان ما گفت یه حسینیه ساخته بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.38,
   "end": 567.26,
   "text": "می‌زنن حسینیه مثلاً وقف می‌کنن بعد به ایات صالحات دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.26,
   "end": 570.4,
   "text": "بعد یه کسی اومد دید لوستر نداره حسینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.4,
   "end": 576.86,
   "text": "یه لوستر بانی شد. یه لوستر خوشگل بزرگ و اینا خوب قیمتی نصب کنن تو حسینیه امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.86,
   "end": 578.84,
   "text": "هرچی بهش گفتن شما اسمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.84,
   "end": 581.28,
   "text": "از کجا اومدی؟ اهل کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.28,
   "end": 584.06,
   "text": "هیچی نگفت. خاموش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.06,
   "end": 588.2,
   "text": "دهان بسته. برعکس بعضی از ما یه قرون کمک می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.2,
   "end": 590.3,
   "text": "گوشه فرشه می‌گیم بنویس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.3,
   "end": 593.0,
   "text": "جناب افخم اعظم اکرم فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.0,
   "end": 595.8,
   "text": "فلان فلانه به فرزند فلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.8,
   "end": 600.96,
   "text": "اینا بوی خدا خیلی توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.96,
   "end": 604.16,
   "text": "اظهار خودیت، منیّت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.16,
   "end": 607.0,
   "text": "حالا یه وقتی انشاالله بشه در خواستمون صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 607.0,
   "end": 608.98,
   "text": "وقتتون رو نگیرم روایت رو جمع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.98,
   "end": 613.56,
   "text": "طولانیه این روایت. صحبت‌ها شد بین نبی خدا و ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.56,
   "end": 616.1,
   "text": "و گفت که خب حالا نصیحتی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.1,
   "end": 620.22,
   "text": "این کسی که با اهل با محبت دنیا از دنیا رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.22,
   "end": 624.15,
   "text": "و اهل عذاب بوده گرفتار شده، داره پیغمبر خدا را نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.15,
   "end": 626.84,
   "text": "بعد چی بودن این انبیا که از داود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.84,
   "end": 629.84,
   "text": "داشتن رجز می‌کردن، یه سنگسار می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.84,
   "end": 633.84,
   "text": "یه جا دیگه فرمود سلیمان نبی می‌خواست یکی رو به دار بیاویزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.84,
   "end": 637.44,
   "text": "مثلا حالا حد رو اجرا کنه، هرچی بود تازیانه بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.44,
   "end": 640.16,
   "text": "اول می‌گفت منو نصیحت کن. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 640.16,
   "end": 643.1,
   "text": "چقدر ما متب-- خیلی متبخترانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.1,
   "end": 646.02,
   "text": "حالا حالت تبختر و تکبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.02,
   "end": 648.78,
   "text": "بچه نصیحت-- ساکت باش تو هنوز نمی‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.78,
   "end": 651.14,
   "text": "من بزرگتر-- اصلاً توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.14,
   "end": 653.6,
   "text": "به نصایح دیگران نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 653.6,
   "end": 656.52,
   "text": "ایشون نصیحت کرد پیغمبر خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 656.52,
   "end": 662.6,
   "text": "الله اکبر. گفت مراقب باشید که اونجا یه چند تا گفته من یکی دو تاشو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.6,
   "end": 669.4,
   "text": "خیلی عجیبه. به پیغمبر خدا می‌گه اونجا دیگه عذرخواهی هیچ فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.4,
   "end": 673.74,
   "text": "هیچ سودی نداره اونجا. اینجا گریه کن همه نوازش رو می‌خرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 673.74,
   "end": 675.72,
   "text": "چته؟ چی شده؟ از جمله خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.72,
   "end": 678.26,
   "text": "دلجویی می‌کنه. عنف یقول بمنكسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.26,
   "end": 680.64,
   "text": "اونجا گریه کنی تو صورتت می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 680.64,
   "end": 687.0,
   "text": "این حرفا نیست. و یه نکته جالب دیگه که ایشون اشاره به آیه قرآن می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 687.0,
   "end": 689.64,
   "text": "اینجا فریاد همه بلنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.64,
   "end": 692.36,
   "text": "یا حسرتا على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 692.36,
   "end": 696.14,
   "text": "آیه پنجاه و شش سوره زمر باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 696.14,
   "end": 698.54,
   "text": "نگاه کنید اگه اشتباه نکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 698.54,
   "end": 701.3,
   "text": "یا حسرتا على ما فرطت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 701.3,
   "end": 704.88,
   "text": "في جنب الله. اینجا نبی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 704.88,
   "end": 706.54,
   "text": "همه فریادشون بلنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 706.54,
   "end": 711.86,
   "text": "حسرت می‌خورن از کوتاهی‌هایی که در خصوص جنب الله کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 711.86,
   "end": 713.46,
   "text": "و مرحوم شیخ صدوق در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 713.46,
   "end": 720.7,
   "text": "کمال الدین و تمام النعمت زیر این آیه حدیث چند تا آورده از اهل بیت علیهم السلام که این جنب الله انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 720.7,
   "end": 728.62,
   "text": "امام زمان عصرته. هرکس که از امام زمانش غافل باشه که بعدا قبلاً چندین جلسه درباره‌ش حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 728.62,
   "end": 731.8,
   "text": "غافل باشه، حواسش به امام زمانش نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.8,
   "end": 734.72,
   "text": "قطعاً این فریاد رو سر خواهد داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 734.72,
   "end": 741.06,
   "text": "که شما ببینید تو زیارت آل یاسین، آل یاسین چیه که السلام علیک حین تقوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.06,
   "end": 742.94,
   "text": "السلام علیک حین تقعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 742.94,
   "end": 746.54,
   "text": "السلام علیک حین تصلی و تقنت، السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 746.54,
   "end": 748.98,
   "text": "حین تنکع و تستشرد، السلام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 748.98,
   "end": 753.84,
   "text": "همش در اتوار مختلف طورهای مختلف آقا رو داری سلام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 753.84,
   "end": 755.92,
   "text": "یعنی چی؟ السلام علیک حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 755.92,
   "end": 758.46,
   "text": "تسبح و تمسی. صبح و شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 758.46,
   "end": 760.48,
   "text": "ظهر و نمی‌دونم عشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.48,
   "end": 762.7,
   "text": "هم آن، آن به آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 762.7,
   "end": 766.6,
   "text": "سجده، رکوع، قنوت، استغفار، تکبیر، تهلیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 766.6,
   "end": 769.86,
   "text": "یعنی چی؟ شما بفرمایید این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 769.86,
   "end": 772.02,
   "text": "این یعنی چی؟ زیارت آل یاسین داره چی داره به ما می‌گه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 772.02,
   "end": 775.22,
   "text": "چی رو تصویر می‌کنه؟ قربون صدقه آقا داری میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.22,
   "end": 781.02,
   "text": "اما در جمیع اتوار وجودی امامت حواست بهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 781.02,
   "end": 788.12,
   "text": "این دیگه درسه. حداقل وقت شروع نماز بگیم السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 788.12,
   "end": 790.24,
   "text": "حین تصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 790.24,
   "end": 793.82,
   "text": "و تقنت. سلام به تو میدم در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 793.82,
   "end": 799.38,
   "text": "صلات و قنوتت. که انشاالله نمازمون به برکت نماز امام عصر نماز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 799.38,
   "end": 804.8,
   "text": "امیدوارم که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 804.8,
   "end": 811.14,
   "text": "الله- اللهumma صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 811.14,
   "end": 812.2,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}