 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت دوم باب چهارم؛ منادی هر روز",
   "start": 2.2,
   "end": 187.66
  },
  {
   "index": 1,
   "title": "## اجمع للفناء و ابن للخراب",
   "start": 187.66,
   "end": 264.06
  },
  {
   "index": 2,
   "title": "## چرا هر روز؛ ذکر کائنات و اسم حی و ممیت",
   "start": 264.06,
   "end": 640.92
  },
  {
   "index": 3,
   "title": "## خاموش کردن آتش فراق با مهربانی خدا",
   "start": 640.92,
   "end": 727.66
  },
  {
   "index": 4,
   "title": "## جان‌کندن موسی و جملهٔ خدا؛ دل از آنجا بکن",
   "start": 727.66,
   "end": 989.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.2,
   "end": 6.12,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.12,
   "end": 9.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.66,
   "end": 15.48,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.48,
   "end": 19.08,
   "text": "می‌رسیم به روایت دوم از باب چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.08,
   "end": 21.16,
   "text": "روایت بسیار عجیبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.16,
   "end": 27.86,
   "text": "خیلی روایت قابل توجه و تأمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.86,
   "end": 30.22,
   "text": "امام باقر صلی الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.22,
   "end": 33.72,
   "text": "«ینادی مناد کل يوم».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.72,
   "end": 36.42,
   "text": "هر روز یه منادی ندا بر می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.42,
   "end": 41.34,
   "text": "هر روز \"کل يوم\". چی میگه این منادی که هر روز ندا بر می‌داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.34,
   "end": 44.3,
   "text": "توجه داشته باشید که روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.3,
   "end": 49.94,
   "text": "مثل آیات چون آنچه که پیغمبر می‌فرمود و اهل بیت می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.94,
   "end": 53.2,
   "text": "این‌ها وحی حساب-- مثل وحی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.2,
   "end": 55.48,
   "text": "\"انه والا وحی یوحى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.48,
   "end": 60.08,
   "text": "هرچی میگه، هرچی بر زبانش جاری می‌شه مثل وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.08,
   "end": 65.1,
   "text": "لذا روایات اهل بیت علیهم السلام هم مثل آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.1,
   "end": 70.76,
   "text": "زبان فطرتم. یعنی با لسان فطرت انسان‌ها صحبت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.76,
   "end": 82.08,
   "text": "بقیه نمی‌تونن. هر چقدرم انسان کاملی باشن نمی‌تونن مثل کلام الله و کلام اهل بیت با زبان و لسان فطرت سخن بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.08,
   "end": 88.88,
   "text": "لذا صحبت‌های دیگران مثل لسان خدا و اهل بیت تأثیر نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.88,
   "end": 90.96,
   "text": "اون مرده رو زنده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.96,
   "end": 93.4,
   "text": "چرا؟ چون لسان فطرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.4,
   "end": 96.32,
   "text": "هر فطرتی رو می‌تونه بیدار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.32,
   "end": 104.08,
   "text": "لذا این روایات، این که هم که ما مستقیم خود متن روایت رو می‌خونیم بعد حرف‌های خودمون رو زیرش می‌زنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.08,
   "end": 106.12,
   "text": "اینه که اون لسان فطرته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.12,
   "end": 110.44,
   "text": "با لسان شما داره سخن می‌گونه، می‌گ-- میگه امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.44,
   "end": 116.3,
   "text": "حالا ببینید چقدر زیبا این منادی هر روز داره ندا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.3,
   "end": 121.7,
   "text": "که می‌فرماید سه تا ندا داره \"لد للموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.7,
   "end": 123.78,
   "text": "متولد کن، به دنیا بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.78,
   "end": 126.24,
   "text": "برای چی؟ برای چی متولد می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.24,
   "end": 130.4,
   "text": "برای چی این همه زاد و ولد و به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.4,
   "end": 133.2,
   "text": "نسل‌پروری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.2,
   "end": 135.3,
   "text": "ابقاء نسل و چی و اینا برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.3,
   "end": 138.02,
   "text": "می‌فرماید \"للموت\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.02,
   "end": 140.96,
   "text": "یعنی تولدها همه برای موتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.96,
   "end": 146.7,
   "text": "بله. البته اگر معنای موت درست جا بیفته که ما چندین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.7,
   "end": 150.56,
   "text": "بیش از پانزده ترجمه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.56,
   "end": 155.14,
   "text": "حقیقت موت رو قبلاً برای شما در جلسات مختلف گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.14,
   "end": 159.26,
   "text": "اونجا کاملاً این توجیهه که چرا، یعنی چی برای موت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.26,
   "end": 162.06,
   "text": "که مثلاً سفر ظاهر به باطن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.06,
   "end": 167.24,
   "text": "هر چیزی بهش می‌گن موت. سفره، یه سفر ظاهر به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.24,
   "end": 173.2,
   "text": "یعنی از اسم الظاهر حضرت حق به اسم الباطن حرکت کردن، حرکت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.2,
   "end": 178.7,
   "text": "خب این کاملاً توجیهین. اما وقتی به ظاهر نگاه می‌کنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.7,
   "end": 182.3,
   "text": "مرگ یک چیز تلخیه. متولد کن برای مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.3,
   "end": 184.98,
   "text": "آخه چرا؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.98,
   "end": 187.66,
   "text": "توضیحش رو ان‌شاءالله می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.66,
   "end": 190.98,
   "text": "دو قسمت بعدیشم عرض کنم چقدر جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.98,
   "end": 194.28,
   "text": "اصلاً سراسر این سه جمله حکمت محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.28,
   "end": 198.0,
   "text": "\"و اجمع\" جمع کن \"للفناء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.0,
   "end": 201.84,
   "text": "برای فانی شدن. جمع کن برای فانی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.84,
   "end": 207.6,
   "text": "حالا این همه ثروت‌هایی که الان زیر زمینه یه زمانی مال آدمایی بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.6,
   "end": 210.88,
   "text": "رفتن دفن. قبلاً که بانک نبوده که می‌ذاشتن زیر زمین و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.88,
   "end": 213.24,
   "text": "الان دست کیه؟ دست اونا که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.24,
   "end": 216.5,
   "text": "اونا زیر خاکن. می‌رسه دست کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.5,
   "end": 218.74,
   "text": "کاشف این گنج خان یا بعد اینا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.74,
   "end": 222.32,
   "text": "س-- امانت دارن تا همینطوری نه-- دست‌به‌دست می‌چرخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.32,
   "end": 225.54,
   "text": "\"وابن\" قسمت سوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.54,
   "end": 228.54,
   "text": "بنا کن برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.54,
   "end": 232.6,
   "text": "برای پز دادن؟ \"للخراب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.6,
   "end": 235.28,
   "text": "برای خراب شدن بنا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.28,
   "end": 239.8,
   "text": "شما عمارت رو سراغ دارید که همینطوری صاف و استوار محکم مونده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.8,
   "end": 242.02,
   "text": "اصلاً نشئ‌، نشئ‌، تدریج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.02,
   "end": 246.1,
   "text": "طبیعت تدریجاً هی همه چی داره از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.1,
   "end": 248.22,
   "text": "این و در همه چی هم این جاریه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.22,
   "end": 251.66,
   "text": "تو بدن خودت ببین چگونه داره تخریب می‌شه همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.66,
   "end": 253.88,
   "text": "و الان نشاط جوونی تو داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.88,
   "end": 257.42,
   "text": "اینا همه آلارمه. داره چشمک می‌زنه بهت میگه آماده شو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.42,
   "end": 262.0,
   "text": "رفتن نزدیکه. حالا این دو قسمت رو فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.0,
   "end": 269.22,
   "text": "بهش توجه نکنیم. اول نکته‌ای که عرض می‌کنیم \"کل يوم\".\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.22,
   "end": 274.58,
   "text": "زبان روایت می‌فرماید هر روز این مدا، منادی ندا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.58,
   "end": 276.64,
   "text": "اولاً چرا گوش ما نمی‌شنوه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.64,
   "end": 280.02,
   "text": "این یه سؤال جدیه. چه بلایی سر ما اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.02,
   "end": 283.42,
   "text": "چه مونه؟ چه خواب مرگی، ببخشید ما رو گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.42,
   "end": 287.72,
   "text": "که این ندا رو نمی‌شنویم. امام معصوم داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.72,
   "end": 291.38,
   "text": "کاشف علم اولین و آخرین ما باقر می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.38,
   "end": 294.22,
   "text": "که چی؟ هر روز این منادی داره ندا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.22,
   "end": 296.5,
   "text": "می‌تونه این ندا در درون هر کسی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.5,
   "end": 300.28,
   "text": "می‌تونه ندای فطرت باشه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.28,
   "end": 303.58,
   "text": "و \"کل يوم\" خودش مسأله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.58,
   "end": 308.7,
   "text": "هر روز، وقتی که یه چیزی هر روز اتفاق افتاد، عزیزان توجه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.7,
   "end": 313.64,
   "text": "بهش می‌گن ذکر. اصطلاحاً بهش می‌گن، دیگه ورد نمیگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.64,
   "end": 318.1,
   "text": "ورد چیزی که به زبان جاری شد اما وقتی دائمی شد می‌شه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.1,
   "end": 324.32,
   "text": "یعنی اصلاً ذکره. دقت کنید ذکر این کائنات این سه تا چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.32,
   "end": 326.8,
   "text": "دائماً دارن القا می‌کنن به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.8,
   "end": 329.38,
   "text": "که \"لد، لد للموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.38,
   "end": 332.24,
   "text": "متولد کن برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.24,
   "end": 336.08,
   "text": "اصلاً غایت این دنیا موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.08,
   "end": 339.4,
   "text": "اینو ما باور داریم؟ الان شما بچه به دنیا میاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.4,
   "end": 342.26,
   "text": "خودت خوشحال‌تر از همه، همه هم بهت تبریک میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.26,
   "end": 348.42,
   "text": "اما اصلاً توجه داریم اون لحظه که این به دنیا اومده برای موت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.42,
   "end": 353.86,
   "text": "اصلاً به این توجه داریم؟ و اونم هر روز این ندا داره سر داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.86,
   "end": 358.74,
   "text": "در کل کائنات. اصلاً اینو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.74,
   "end": 360.84,
   "text": "در حول و حوش ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.84,
   "end": 363.42,
   "text": "صبح تا شب دائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.42,
   "end": 366.96,
   "text": "یه حیات رخ می‌ده، یه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.96,
   "end": 371.7,
   "text": "درسته؟ دائماً هم حیات کلی آدم دارن به دنیا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.7,
   "end": 376.78,
   "text": "هم موت. یعنی دائماً هی آلارم داره برای ما میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.78,
   "end": 379.5,
   "text": "هی پیام‌ها داره برای ما ارسال میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.5,
   "end": 383.72,
   "text": "به قول یکی از بزرگان می‌فرمود پیام رسان و پیامگیر ما خراب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.72,
   "end": 386.66,
   "text": "اینا رو نمیگیره. قساوت قلب پیدا کرده دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.66,
   "end": 389.98,
   "text": "اصلاً متوجه این چیزا نیست. اما دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.98,
   "end": 392.08,
   "text": "اسم الحي و اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.08,
   "end": 395.28,
   "text": "الممیت حق در کارن دارن پیاده میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.28,
   "end": 397.44,
   "text": "اونم دا-- نه فقط در انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.44,
   "end": 404.16,
   "text": "شما بگیرید که همه چی \"سخر لك ما في السماوات وما في الأرض\" آنچه که در آسمان و زمین مسخر برای انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.16,
   "end": 409.52,
   "text": "خلق شدن برای انسان. اصلاً همه‌ی این‌ها برای این اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.52,
   "end": 414.5,
   "text": "این حیوانات دائماً دارن هر روز متول-- حیوانات حتی متولد میشن، می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.5,
   "end": 418.26,
   "text": "جمادات حتی سنگ‌ها متولد میشن، می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.26,
   "end": 421.66,
   "text": "یه سنگ هی داره زمخت می‌شه، بزرگ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.66,
   "end": 427.04,
   "text": "در دل معدن و به، به صورت کانی هی داره برای خودش جلوه نمایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.04,
   "end": 430.74,
   "text": "یه دفعه میفته دست یه آدمی با پتک می‌زنه روش پودرش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.74,
   "end": 434.96,
   "text": "یا اون سنگ رو تبدیل می‌کنه به پودر و خاک و چی و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.96,
   "end": 437.54,
   "text": "دائماً در حال فرسایش‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.54,
   "end": 441.04,
   "text": "اونم حیات و موت داره به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.04,
   "end": 442.94,
   "text": "قاعده‌ی زمین همیشه این شکلی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.94,
   "end": 450.34,
   "text": "اون نیست که انتهای دوره‌ی ما هم از دوره‌های مختلف انسانی بر اساس رساله‌ی رصد غفت علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.34,
   "end": 454.02,
   "text": "آب همه جا رو می‌گیره. آب که میاد مذهل می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.02,
   "end": 456.9,
   "text": "این استحکام سنگ‌ها و جمادات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.9,
   "end": 460.52,
   "text": "همه رو مذهل می‌کنه آب. همه جا رو می‌گیره و موت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.52,
   "end": 465.06,
   "text": "قیامت کبیرای این دوره که ایشون محاسبه کردن از جهت علم هئیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.06,
   "end": 470.78,
   "text": "و نجوم و ریاضیات و چه و اینا که صد و هشتاد و شش هزار سال بعد این اتفاق خواهد افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.78,
   "end": 474.4,
   "text": "حالا در نباتات هم این تو-- این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.4,
   "end": 478.36,
   "text": "در فصل بهار و پاییز شما ببینید چه اتفاقی میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.36,
   "end": 483.56,
   "text": "بهار حیاته. اسم حی حق حضرت حق جلوه نمایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.56,
   "end": 486.46,
   "text": "همه چی زنده می‌شه. در پاییز همه دوباره الممیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.46,
   "end": 491.4,
   "text": "\"یخرج الحي من المیت و یخرج المیت من الحي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.4,
   "end": 496.56,
   "text": "همین داره اتفاق میفته. دائماً دور و بر ما حتی در درون خود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.56,
   "end": 505.06,
   "text": "دائماً بر اساس اون \"کل يوم هو فی شأن\" که خدا دائم داره تجلی می‌کنه در وجود ما و ما ظهور حضرت حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.06,
   "end": 508.38,
   "text": "ما ظهور اسم ابواهر حضرت حق هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.38,
   "end": 514.52,
   "text": "یعنی خدا داره در ما تجلی، در ما نه، خدا داره تجلی می‌کنه ما تجلی حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.52,
   "end": 520.84,
   "text": "ظهور حقیم و آنفاً آن سلول‌های بدن ما دارن می‌میرن، زنده می‌شن، می‌میرن، زنده می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.84,
   "end": 525.74,
   "text": "در هر تجلی یک اسم الممیت در کار یه اسم الحي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.74,
   "end": 530.8,
   "text": "ممیت این حالت الان سلول بدن من میلیاردها سلول مرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.8,
   "end": 533.76,
   "text": "الحي سلول بعدی احیا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.76,
   "end": 540.26,
   "text": "تجلی حضرت حقه. یعنی اسم الممیت و اسم الحي حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.26,
   "end": 544.84,
   "text": "دائماً داره چی می‌شه؟ یا محی، المحی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.84,
   "end": 547.58,
   "text": "دائماً داره در وجود ما پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.58,
   "end": 552.14,
   "text": "برای چی؟ چه در وجود ما، چه در بیرون از ما دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.14,
   "end": 555.18,
   "text": "دقت بفرمایید یه بار دیگه متن اول حدیث رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.18,
   "end": 558.04,
   "text": "\"ینادی مناداً کل يوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.04,
   "end": 561.12,
   "text": "دائم این ندا داره سر داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.12,
   "end": 563.42,
   "text": "برای چی؟ برای این پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.42,
   "end": 566.5,
   "text": "اینه که من و شما این پیام‌ها رو بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.5,
   "end": 569.16,
   "text": "بدانیم که عالم به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.16,
   "end": 570.94,
   "text": "حضرت حق در حرکت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.94,
   "end": 574.52,
   "text": "در سوره‌ی یونس دیروز داشتیم می‌خوندیم یهو دیدم آیه سی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.52,
   "end": 577.56,
   "text": "چه قشنگ می‌فرمود \"وردوا الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.56,
   "end": 580.54,
   "text": "ان الیه راجعون\" که داریم. ردوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.54,
   "end": 585.86,
   "text": "الی الله. همه دارن برمی‌گردن به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.86,
   "end": 588.54,
   "text": "اینو ما باید باور کنیم یا نکنیم بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.54,
   "end": 594.98,
   "text": "یعنی یک پیامی داره دائماً آنفاً آن در درون ما و بیرون ما \"کل يوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.98,
   "end": 597.22,
   "text": "میاد که آقا آماده موت شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 597.22,
   "end": 602.44,
   "text": "اصلاً این هرچه موت در عالم داره اتفاق میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.44,
   "end": 606.3,
   "text": "ظهور اسم الباقی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.3,
   "end": 608.42,
   "text": "اسم ال-- که \"کل يوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 608.42,
   "end": 611.94,
   "text": "کل نفس ذائقة الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.94,
   "end": 614.72,
   "text": "همه نفس‌ها می‌چشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.72,
   "end": 620.72,
   "text": "می‌چشن موت رو. یعنی بالاخره اینو ظهور اسم الباقی حق خواهند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.72,
   "end": 623.08,
   "text": "یعنی خداست که باقی‌ست و باقی‌ست و باقی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.08,
   "end": 626.18,
   "text": "و چقدر این شیرینه که با همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.18,
   "end": 629.38,
   "text": "به همین وزان ما می‌تونیم آرامش پیدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.38,
   "end": 632.52,
   "text": "که آقا بالاخره داریم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.52,
   "end": 634.6,
   "text": "خب اسم خدا داره ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.6,
   "end": 637.14,
   "text": "درسته؟ متفرد بالوحدانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.14,
   "end": 639.58,
   "text": "متفرد بالبقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.58,
   "end": 643.76,
   "text": "یعنی هر موتی. این یکی از راه‌های چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.76,
   "end": 648.3,
   "text": "خاموش شدن آتیش جیگر در از دست دادن دوستان‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.3,
   "end": 653.28,
   "text": "من هر وقت بچه‌هام مریض می‌شن، خانمم بی‌قرار می‌شه، بهش می‌گم عیال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.28,
   "end": 659.7,
   "text": "حضرت حوا، شما بدون که آیا شما به بچه‌ات مهربان‌تری یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 659.7,
   "end": 663.04,
   "text": "خدا بهش دلسوزتره یا تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.04,
   "end": 666.44,
   "text": "آیا در تحت قدرت خدا ایشون مریض شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 666.44,
   "end": 670.54,
   "text": "یا حتی اگر عزیزی از، عزیزی از دست بده یه نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 670.54,
   "end": 675.32,
   "text": "می‌گم آقا در تحت تدبیر متفرد بالوحدانیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 675.32,
   "end": 678.98,
   "text": "خ-- در تحت تدبیر و قدرت خدا این شخص موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 678.98,
   "end": 681.98,
   "text": "به موت رسید یا تو؟ در تحت قدرت تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 681.98,
   "end": 685.12,
   "text": "می‌گه قطعاً می‌گه خدا. قطعاً می‌گه خدا مهربان‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 685.12,
   "end": 692.06,
   "text": "می‌گیم پس چرا ناراحتی؟ ببین چه آتشی رو خاموش می‌کنه این تحت تب-- این توجه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 692.06,
   "end": 694.64,
   "text": "سیری که در عالم داره اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 694.64,
   "end": 696.92,
   "text": "آقا خ-- بالاخره اینو یاد بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 696.92,
   "end": 701.44,
   "text": "خدا مهربان‌تره به من و تو و زن و بچه‌مون و نسل‌مون و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 701.44,
   "end": 705.3,
   "text": "اونچه که ما دل بستیم و علاقه پیدا کردیم یا ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 705.3,
   "end": 706.94,
   "text": "قطعاً هممون می‌گیم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 706.94,
   "end": 709.98,
   "text": "پس چرا، چمونه ما؟ چرا انقدر مضطربیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 709.98,
   "end": 714.16,
   "text": "چرا نفس مطمئنه نداریم بلکه نفس مضطربه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 714.16,
   "end": 716.42,
   "text": "البته این سخته‌ها در عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 716.42,
   "end": 719.28,
   "text": "من دارم می‌گم در حوزه نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 719.28,
   "end": 721.54,
   "text": "ب-- عرض می‌کنم و رد می‌شیم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.54,
   "end": 724.4,
   "text": "اما عملیاتی کردنش کار اولیاء خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.4,
   "end": 730.2,
   "text": "من همینطور دارم یه چیزی می‌گم. در هر صورت چون امروز خیلی بیشتر صحبت نکنیم مهمان داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 730.2,
   "end": 736.91,
   "text": "یه روایت هم تقدیم کنم در، اَز چه باید شرح دعای مکارم الاخلاق اونجا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 736.91,
   "end": 742.66,
   "text": "خیلی شیرین. حالا این روایت در خصوص نحوه جان کندن حضرت موسی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.66,
   "end": 746.66,
   "text": "من مقصودم بیشتر یه جمله ایه که خدا به حضرت موسی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 746.66,
   "end": 750.26,
   "text": "اینو دقت کنید. حضرت موسی وقتی می‌خواد از دنیا بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 750.26,
   "end": 752.68,
   "text": "حضرت قابض الارواح تشریف میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 752.68,
   "end": 754.88,
   "text": "میگن موسی آماده باش می‌خوام ببرمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 754.88,
   "end": 759.26,
   "text": "خب بالاخره کریم الله. به حضرت قابض الارواح میگه میشه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 759.26,
   "end": 761.24,
   "text": "چند لحظه به من مهلت بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 761.24,
   "end": 763.76,
   "text": "میگه نخیر مطلقا آماده باش باید بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 763.76,
   "end": 767.36,
   "text": "هیچ مهلتی در کار نیست حتی به کلیم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 767.36,
   "end": 769.08,
   "text": "حضرت موسی افتاد به سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 769.08,
   "end": 773.98,
   "text": "بالاخره سوز دل حضرت موسی گل کرد و از خدا خواست که مهلت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 773.98,
   "end": 778.98,
   "text": "خدا هم به برکت سجده حضرت موسی، عجیبه این سجده‌های حضرت موسی عجیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 778.98,
   "end": 780.78,
   "text": "که فرمود می‌دونی چرا تو رو اختیار کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.78,
   "end": 783.74,
   "text": "\"و استنعتک لنفسی\" برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 783.74,
   "end": 787.22,
   "text": "چون بیشتر از همه بعد از نمازات سجده می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 787.22,
   "end": 789.36,
   "text": "به سجده افتاد خواست، خدا مهلت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 789.36,
   "end": 792.3,
   "text": "گفت یا عزرائیل بهش مهلت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 792.3,
   "end": 795.74,
   "text": "مهلت چی شد؟ حضرت موسی پاشد رفت با مادرش وداع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 795.74,
   "end": 798.02,
   "text": "کجا میری مادر؟ گفت سفر مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 798.02,
   "end": 801.12,
   "text": "مادرش گریه و زاری. اومد پیش زن و بچه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 801.12,
   "end": 804.2,
   "text": "حالا مفصله. با خانمش وداع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 804.2,
   "end": 808.6,
   "text": "گریه‌ش گرفت. بچه‌ش، یکی از بچه‌های حضرت موسی تو بغل مادر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 808.6,
   "end": 810.76,
   "text": "تو بغل همسر حضرت موسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 810.76,
   "end": 812.6,
   "text": "این بچه دامن موسی رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 812.6,
   "end": 816.96,
   "text": "هی گریه کرد. موسی آتیش دلش گر-- بالاخره پدر عاطفه پدریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 816.96,
   "end": 823.72,
   "text": "آتیش دلش گر گرفت. اینجا خدا به داد موسی رسیده و الا این تعلق نمیذاشت جون بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 823.72,
   "end": 826.5,
   "text": "با دو جمله سه جمله موسی رو آروم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 826.5,
   "end": 829.76,
   "text": "این دو جمله سه جمله رو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 829.76,
   "end": 832.38,
   "text": "عین روایت می‌فرماید که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 832.38,
   "end": 835.04,
   "text": "به موسی فرمود که \"ای موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 835.04,
   "end": 840.08,
   "text": "دل از آنجا بکن.\" نه از آنها از آنجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 840.08,
   "end": 842.52,
   "text": "اصلا از کل اینجا دل بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 842.52,
   "end": 847.32,
   "text": "چرا دل بکنم؟ خدا ببینید داره می‌فرماد من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 847.32,
   "end": 851.12,
   "text": "این با من و شماست ها. من از آنها نگهداری می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 851.12,
   "end": 853.7,
   "text": "من خدا، خودم حافظ اونام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 853.7,
   "end": 859.62,
   "text": "اونها رو نگهداری می‌کنم و آنها را در آغوش محبتم می‌پرورانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 859.62,
   "end": 863.04,
   "text": "الان دم مرگ ما که بالاخره می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 863.04,
   "end": 866.92,
   "text": "خدا این ندا رو تو گوش ما بگه، آیا آرامش پیدا نمی‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 866.92,
   "end": 869.0,
   "text": "یا من از تو به اینا مهربان‌ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 869.0,
   "end": 871.44,
   "text": "من می‌پرورانمشون. من نگهدارمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 871.44,
   "end": 876.1,
   "text": "چته؟ اینجا روایت، عین روایت میگه دل حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 876.1,
   "end": 878.06,
   "text": "آروم شد و آماده شد برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 878.06,
   "end": 880.48,
   "text": "که حالا بعد حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 880.48,
   "end": 884.34,
   "text": "اومدن موسی گفت از کجا می‌خواید جان منو بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 884.34,
   "end": 889.1,
   "text": "گفت از دهانت. به حضرت موسی قابض الارواح گفت از دهانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 889.1,
   "end": 894.6,
   "text": "چون قاعده اینه. گفت آخه از دهان، چقدر زرنگ و زیرک بوده این آقا حضرت موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 894.6,
   "end": 898.5,
   "text": "گفت از دهانی می‌خوای جان رو بگیری که مستقیم با خدا تکلم کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 898.5,
   "end": 902.12,
   "text": "گفت از دستت. گفت از دستی که الواح تورات رو گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 902.12,
   "end": 906.18,
   "text": "گفت از پات. گفت از پایی که به کوه طور رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 906.18,
   "end": 910.7,
   "text": "و با خدا منا-مناجات کرده، ملاقات داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 910.7,
   "end": 913.64,
   "text": "خلاصه دیگه عزرائیل و قل ما اینجا کمه و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 913.64,
   "end": 919.86,
   "text": "دیگه میگن که روایت میگه یه نارنج خوشبو داد حضرت موسی بو کرد و جان داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 919.86,
   "end": 923.48,
   "text": "خیلی جالبه که اونجا وقتی ایشون جون داد اینم بشنوید خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 923.48,
   "end": 926.98,
   "text": "ملائکه دور حضرت موسی رو گرفتن و این عبارت رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 926.98,
   "end": 930.6,
   "text": "\"یا اهون الأنبياء موتا\" عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 930.6,
   "end": 934.44,
   "text": "ای کسی که بین انبیا از همه راحت‌تر جون دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 934.44,
   "end": 937.46,
   "text": "\"كيف وجدت الموت؟\" موت رو چگونه دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 937.46,
   "end": 940.9,
   "text": "حالا جواب حضرت موسی و دلیلش البته بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 940.9,
   "end": 944.24,
   "text": "این دلیلی داره باید باز بشه براتون، طلبتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 944.24,
   "end": 948.5,
   "text": "حضرت موسی فرمود \"کشاه تسلخ هیه تحیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 948.5,
   "end": 951.5,
   "text": "تحیه از حی میاد. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 951.5,
   "end": 954.76,
   "text": "میگن رفت به مسلخ یا سلاخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 954.76,
   "end": 957.24,
   "text": "تسلخ و منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 957.24,
   "end": 960.56,
   "text": "تو-- مثل اینکه پوستمو کندن سلاخیم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 960.56,
   "end": 963.12,
   "text": "هیه تحیه. حیه در حالی که زنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 963.12,
   "end": 965.82,
   "text": "یعنی زنده زنده پوستم رو کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 965.82,
   "end": 968.38,
   "text": "کی اینو میگه؟ موسی کلیم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 968.38,
   "end": 970.92,
   "text": "عجب! پس یه نکته‌ای درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 970.92,
   "end": 974.1,
   "text": "موسی زنده زنده پوستشو کندن مثل گوسفند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 974.1,
   "end": 976.34,
   "text": "العیاذ بالله. چیه این قصه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 976.34,
   "end": 978.38,
   "text": "این باید براتون باز بشه. ان شا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 978.38,
   "end": 981.18,
   "text": "طلب‌تون اگر تشنه بودید بحثو پیگیر کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 981.18,
   "end": 983.38,
   "text": "ان شا الله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 983.38,
   "end": 986.08,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 986.08,
   "end": 989.52,
   "text": "الله- اللهُم صلي علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}