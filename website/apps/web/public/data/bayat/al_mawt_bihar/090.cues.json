 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایتِ پنجم؛ استحقاقِ ولایتِ شیطان",
   "start": 19.58,
   "end": 112.06
  },
  {
   "index": 1,
   "title": "## مصباح الشریعه؛ غربالِ نسبیِ نجات",
   "start": 112.06,
   "end": 221.22
  },
  {
   "index": 2,
   "title": "سپس «هلک العالمون إلا الصادقون»؛ عالمان نیز مگر صادقان. نجات در صدق است. دعایِ قرآنی:",
   "start": 221.22,
   "end": 277.74
  },
  {
   "index": 3,
   "title": "## هلک المخلصون إلا المتقون؛ سپس الموقنون",
   "start": 277.74,
   "end": 501.63
  },
  {
   "index": 4,
   "title": "## غالبِ مردم اهلِ نجات‌اند؛ سخنِ شیخ‌الرئیس",
   "start": 501.63,
   "end": 785.27
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.02,
   "end": 10.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.2,
   "end": 14.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.12,
   "end": 19.58,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.58,
   "end": 23.86,
   "text": "در روایت پنجم از باب چهارم کتاب الموت بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.86,
   "end": 36.22,
   "text": "\"اذا استحققت ولایه الشيطان و الشقاوه\" وقتی کسی مستحق دوستی و ولایت شیطان و بدبختی شد، \"جعل العمل بین العينین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 36.22,
   "end": 38.38,
   "text": "چشمش پره، اونم چشم‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.38,
   "end": 42.36,
   "text": "اینم نکته‌ست. نمیگه چشمش، چشم‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 42.36,
   "end": 45.16,
   "text": "پر می‌شه از آرزوهای طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.16,
   "end": 48.6,
   "text": "یعنی نمی‌بینه مگر اینکه آرزو می‌کنه هی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.6,
   "end": 52.64,
   "text": "گرفتار می‌شه \"و ذهب الأجل و بره الوهر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.64,
   "end": 55.04,
   "text": "اما مهم‌ترین مشخصه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.04,
   "end": 58.62,
   "text": "چون بحث موت هست اینکه فراموشی موت بهش دست میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.62,
   "end": 61.84,
   "text": "اصلا انگار نه انگار قراره از این دنیا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.84,
   "end": 63.76,
   "text": "همه قاعده‌هاش بر اساس دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.76,
   "end": 67.76,
   "text": "عرض کردیم که در خصوص ولایت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.76,
   "end": 71.26,
   "text": "و تقابلش با ولایت الله این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.26,
   "end": 74.68,
   "text": "ولایت شیطان اساسش بر گمراهی و ضلالت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.68,
   "end": 78.52,
   "text": "ولایت الله هدایت و سعادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.52,
   "end": 81.44,
   "text": "و این ضلالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.44,
   "end": 86.28,
   "text": "در ولایت شیطان تا انسان رو هلاک نکنه رها نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.28,
   "end": 91.64,
   "text": "یعنی تمام سعی و تلاششو قدم به قدم انجام میده تا لحظه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.64,
   "end": 97.02,
   "text": "نفس آخر. آنی پیش از موت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.02,
   "end": 98.74,
   "text": "ما رو به هلاکت بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.74,
   "end": 102.94,
   "text": "حالا یه فرقی البته بین هلاکت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.94,
   "end": 107.78,
   "text": "خسران هست. پیش از اینکه این فرق رو عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.78,
   "end": 111.68,
   "text": "یه روایت پیرامون هلاکت عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.68,
   "end": 117.3,
   "text": "که در مصباح الشریعه صفحه سی و هفت می‌تونید این روایت رو ببینید از امام صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.3,
   "end": 125.2,
   "text": "کلاً مصباح الشریعه مجموعه‌ای از بیانات امام صادق صلوات الله علیه، روایات خیلی شیرین و عالی‌ای در اونجا جمع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.2,
   "end": 130.06,
   "text": "که نسبی بودن هلاکت و نجات انسان‌ها رو داره بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.06,
   "end": 133.7,
   "text": "اول هم می‌فرماید \"هلک العاملون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.7,
   "end": 139.06,
   "text": "همه عمل کنندگان هلاک می‌شن \"الا العابدون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.06,
   "end": 145.92,
   "text": "مگر اون کسی که عبده، دربنده، بر اساس شریعت رفتار می‌کنه، عملش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.92,
   "end": 149.26,
   "text": "بر مبنای عبودیت محض است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.26,
   "end": 152.72,
   "text": "از خودش من درآوردی ریاضت نمی‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.72,
   "end": 156.44,
   "text": "و البته و \"هلک العابدون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.44,
   "end": 158.96,
   "text": "حتی این عباد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.96,
   "end": 161.62,
   "text": "هلاک می‌شن \"هالکن الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.62,
   "end": 167.02,
   "text": "العالمون\". اونایی که علم دارن با علم و اندیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.02,
   "end": 172.86,
   "text": "و تفکر میرن جلو، حوزه نظرشون رو هم تقویت می‌کنند \"تواصوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.86,
   "end": 177.64,
   "text": "بالحق\" توصیه اهل ایمان به هم در حوز-- در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.64,
   "end": 180.0,
   "text": "معارف حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.0,
   "end": 183.74,
   "text": "علوم و اندیشه و معارف و تعقل و تدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.74,
   "end": 186.9,
   "text": "و \"تواصوا بالصبر\" هم صبر بر اعماله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.9,
   "end": 193.18,
   "text": "این حوزه عمله. امم باز می‌فرماید و \"هلک العالمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.18,
   "end": 199.36,
   "text": "حتی اهل علم هم \"هالکن الا الصادقون\" مگر اونایی که با صدق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.36,
   "end": 201.74,
   "text": "\"ان نجاته في الصدق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.74,
   "end": 203.66,
   "text": "رب ادخلني مدخل صدق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.66,
   "end": 205.36,
   "text": "چه دعای قرآنی و شیرینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.36,
   "end": 209.9,
   "text": "\"رب ادخلني مدخل صدق واخرجني مخرجا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.9,
   "end": 215.84,
   "text": "صدق. خدایا ورود و خروج من رو در هر وادی بر مبنای صدق قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.84,
   "end": 218.84,
   "text": "نتیجه‌ش چی می‌شه؟ \"واجعل لي من لدنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.84,
   "end": 225.46,
   "text": "سلطانا نصيرا\" که رب-- در تفاسیر فرمودن این سلطان یاریگر امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.46,
   "end": 228.92,
   "text": "کسی که با صداقت رفتار کنه آقا می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.92,
   "end": 236.06,
   "text": "سلطان وجودش، دولت می‌گیره در وجودش، فرج فردی اتفاق می‌افته و یاریش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.06,
   "end": 239.54,
   "text": "صدق، صدق، خیلی صدق، صداقت، راستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.54,
   "end": 244.78,
   "text": "پس همه عالم‌ها هم علما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.78,
   "end": 247.96,
   "text": "هلاک‌اند مگر اونایی که با صداقت رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.96,
   "end": 252.76,
   "text": "وا باز می‌فرماید و \"هلک الصادقون الا المخلصون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.76,
   "end": 254.96,
   "text": "اونام که صدق دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.96,
   "end": 259.94,
   "text": "اون کسایی ازشون هلاک نمی‌شن که اخلاص ورزیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.94,
   "end": 262.92,
   "text": "و البته عرض کردیم که این اخلاص مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.92,
   "end": 268.12,
   "text": "وقتی شدت می‌گیره می‌شه خلوص، اخلاص شدت بگیره می‌شه خلوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.12,
   "end": 271.18,
   "text": "و رفته رفته انسان به مخلصین می‌پیونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.18,
   "end": 277.66,
   "text": "مخلصه می‌شه مخلص. و این‌هام باز هلاک‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.66,
   "end": 281.92,
   "text": "و \"هلک المخلصون الا المتقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.92,
   "end": 289.62,
   "text": "تقوی اینجا از فحوای روایت پیداست که شدت تقواست و الا بعد از مخلص نمی‌اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.62,
   "end": 292.06,
   "text": "چون مخلص خودش تقوی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.06,
   "end": 296.42,
   "text": "یعنی به یک معنا اینجا ورعه، منظور ورعه، شدت تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.42,
   "end": 299.26,
   "text": "این‌ها آیا هلاک می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.26,
   "end": 302.94,
   "text": "مگه، مگه می‌شه اهل تقوی هلاک بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.94,
   "end": 307.38,
   "text": "اینا پیداست که یه منظور خاصی از این رتبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.38,
   "end": 312.22,
   "text": "یعنی بحث نسبی بودن درجاته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.22,
   "end": 317.54,
   "text": "مدرج بودن این مراتبه که هر کسی یه رتبه‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.54,
   "end": 323.5,
   "text": "حالا اون رتبه ی انتهایی، اون بالا، بالا، بالا، \"تعالَوا\" هی قرآن می‌گه بیا بالا، بیا بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.5,
   "end": 326.64,
   "text": "می‌خواد بگه هر کسی دستش به اونجا نمی‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 326.64,
   "end": 332.1,
   "text": "همه هلاک می‌شن. اما منظور از این هلاکت اینجا الان هلاکت از بین رفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.1,
   "end": 336.2,
   "text": "دیگه نیستی و نابودی و یا اینکه مثلاً کلاً از دایره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.2,
   "end": 339.3,
   "text": "هدایت خارج بشن نیست چون متقیه بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.3,
   "end": 343.98,
   "text": "تقوی پیشه کرده و \"اکرمکم عندالله اتقاکم\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.98,
   "end": 348.32,
   "text": "حالا باز می‌فرماید و \"هلک المتقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.32,
   "end": 352.82,
   "text": "پیداست که یک رتبه خیلی بالایی رو داره می‌زنه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.82,
   "end": 357.2,
   "text": "حتی اهل تقوی هم \"هالکن الا الموقنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.2,
   "end": 360.3,
   "text": "اونایی که، کسایی که به حد یقین رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.3,
   "end": 363.61,
   "text": "\"واعبد ربک حتى یأتیک الیقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.61,
   "end": 366.63,
   "text": "از عبادت سیر به جایی می‌رسه که یقین حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.63,
   "end": 370.61,
   "text": "\"ولاکل لیطمئن قلبی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.61,
   "end": 380.17,
   "text": "همین اطمینان. \"یا ایتها النفس المطمئنة ارجعي الى ربك راضية مرضية فادخلي في عبادي وادخلي جنتي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.17,
   "end": 382.21,
   "text": "حضرت امام علیه الرحمه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.21,
   "end": 385.23,
   "text": "این یای اینجا جنتی، عبادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.23,
   "end": 387.71,
   "text": "این‌ها همه اشاره به ذات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.71,
   "end": 390.19,
   "text": "بهشت ذاته، عبادی‌اند که غرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.19,
   "end": 391.77,
   "text": "در ذات حضرت حق شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.77,
   "end": 395.77,
   "text": "یعنی دیگه نشون می‌ده که چی؟ اون رتبه‌های بالای بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.77,
   "end": 398.37,
   "text": "هر کسی دستش به اونجا نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.37,
   "end": 407.33,
   "text": "می‌فرماید و \"پس متقین هم چیا هلاک‌اند مگر اونا که به یقین رسیدن.\" باور قلبیشونه، اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.33,
   "end": 410.73,
   "text": "بعد تازه این‌ها در خصوص این‌ها هم عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.73,
   "end": 414.33,
   "text": "می‌فرماید \"و ان الموقنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.33,
   "end": 416.71,
   "text": "لعلى قطعا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.71,
   "end": 419.73,
   "text": "در چی‌اند؟ \"خطر عظیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.73,
   "end": 422.69,
   "text": "عجب! چه غربالی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.69,
   "end": 424.79,
   "text": "اونا هم حتی دیگه خطر بزرگند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.79,
   "end": 427.03,
   "text": "یعنی چی خطر عظیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.03,
   "end": 431.75,
   "text": "اینو داره تصریح می‌کنه قربونت برم ما همه اینو خوندیم برای این که بدونیم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.75,
   "end": 435.19,
   "text": "دشمن تا آن اون آخر دست از ما برنمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.19,
   "end": 437.91,
   "text": "این خطر عظیم یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.91,
   "end": 445.91,
   "text": "یعنی که نه یعنی که اینا همه بدن، نه همشون خوبن، متقین خوبن، مخلصین خوبن، عالمین خوبن، عابدین خوبن، همه خوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.91,
   "end": 452.49,
   "text": "اما میگه حواست باشه حتی اونکه به درجه آخر هم رسیده \"في خطر عظيم لعلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.49,
   "end": 456.17,
   "text": "خطر عظيم\" یعنی تو اون لحظه‌ی آخر که نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.17,
   "end": 459.17,
   "text": "هنوز داری شیطان مترصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.17,
   "end": 462.91,
   "text": "اینه که ما رو اغوا کنه. منظور اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.91,
   "end": 467.13,
   "text": ". نه یعنی که این اهل تقوا مثلا هلاک‌اند که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 467.13,
   "end": 471.51,
   "text": "بعد حالا اون هلاکتی که به اون معنا می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.51,
   "end": 477.17,
   "text": "که کلا از دایره هدایت خارج می‌شن، میرن تحت تصرف ولایت شیطان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 477.17,
   "end": 481.07,
   "text": "اون یعنی دیگه از-- کلا دیگه بهش نمیشه گفت اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.07,
   "end": 483.07,
   "text": "یعنی اصلا ایمان رو گذاشت کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.07,
   "end": 485.39,
   "text": "عمل که هیچی، ایمان رو هم گذاشت کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.39,
   "end": 488.93,
   "text": "رفت در زمره‌ی مشتکین و منافقین و کفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.93,
   "end": 494.17,
   "text": "اون بله هلاکه. ولی خسران غالب مردم خاصر هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.17,
   "end": 496.67,
   "text": "می‌فرماید ان ال-- ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.67,
   "end": 499.11,
   "text": "الانسان لفی خسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.11,
   "end": 501.63,
   "text": "قطعا تو خسران‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.63,
   "end": 504.13,
   "text": "این خسران یعنی بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.13,
   "end": 509.79,
   "text": "همه نمی‌تونن به این موقنین، به این یقین، اون مراتب عالیه برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.79,
   "end": 517.19,
   "text": "لذا خاصرند. به هر مقداری که از اون مراتب عالیه جا موندن خسران زدن ولی هلاک که نمی‌شن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.19,
   "end": 520.25,
   "text": "هالك که نیستن. این فرقشو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.25,
   "end": 522.93,
   "text": "یعنی غالبا ماها خاصر هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.93,
   "end": 526.49,
   "text": "اما هالك انشاالله نیستیم چون در مسیر ولایتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.49,
   "end": 531.61,
   "text": "اما اگر حتی به مدارج عالی هم برسیم \"في خطر عظيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.61,
   "end": 534.65,
   "text": "یعنی شیطان آنی از دست، دست از سر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.65,
   "end": 539.21,
   "text": "برنمی‌داره. و این دست صحبت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.21,
   "end": 545.65,
   "text": "که از آینه روایات و آیات بیرون میاد نشون میده که غالب مردم اهل نجات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 545.65,
   "end": 547.45,
   "text": "غالب مردم اهل نجات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.45,
   "end": 552.67,
   "text": "خاصر هستیم. کم میاریم اما هالك نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.67,
   "end": 559.75,
   "text": "اکثر مردم درسته قرآن می‌فرماید اکثرهم لا يعقلون لا یتدبرون لا يتفكرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 559.75,
   "end": 564.63,
   "text": "اما قاعده ولایت الله اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 564.63,
   "end": 567.35,
   "text": "همه رو به هدایت و سعادت بکشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.35,
   "end": 570.21,
   "text": "و بهشت و جهنم و اینا و نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 570.21,
   "end": 574.03,
   "text": "شیطان و این‌هام که به قول عرفا و حکما سگ در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 574.03,
   "end": 577.25,
   "text": "درگاه الهی‌اند که پارس کنن ما رو به سمت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 577.25,
   "end": 581.73,
   "text": "بکشونن، ما فرار کنیم ازشون اونا پارس کنن حتی شیاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.73,
   "end": 584.17,
   "text": "اینا همه من حیث الجمع برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.17,
   "end": 587.45,
   "text": "\"يا من سبقت رحمته غضبه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.45,
   "end": 590.57,
   "text": "سب، سبقت گرفته رحمت خدا بر غضبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.57,
   "end": 594.57,
   "text": "یعنی اصلا قاعده اینه که همه رو خدا ببره به بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 594.57,
   "end": 597.59,
   "text": "مثال اون فرمایش مولا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.59,
   "end": 603.13,
   "text": "عرض کردم قبلا حسن بصری که جزو ظاهرا زهاد ثمانیه بود اما زاهد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 603.13,
   "end": 605.71,
   "text": "عوام فریبی بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.71,
   "end": 609.03,
   "text": "کاری به امیرالمؤمنین نداشت. مواصل مولا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.03,
   "end": 613.27,
   "text": "این شخص که خیلی اهل عبادت و اینا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 613.27,
   "end": 616.41,
   "text": "که سی شا یه ارزش نداشت چون بدون ولایت بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.41,
   "end": 619.61,
   "text": "می‌گفت من تع-- در تعجبم با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.61,
   "end": 625.41,
   "text": "سختگیری که خدا داره، این غضب و این جهنم و فلان چگونه بعضی‌ها بهشتی می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.41,
   "end": 628.65,
   "text": "بعد امیرالمؤمنین که شنیدند فرمودند که اتفاقا بلعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 628.65,
   "end": 633.47,
   "text": "من در تعجبم با این رحمت وسیعی که خدا دارد و بهشتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 633.47,
   "end": 638.39,
   "text": "پهن کرده سفره بارعامی که داده اینا چگونه بعضی جهنمی می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.39,
   "end": 640.25,
   "text": "اینطوری نگاه اینه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 640.25,
   "end": 644.01,
   "text": "اکثرا حتی ما حدیث داریم طبقه اول بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 644.01,
   "end": 646.13,
   "text": "اونایی‌اند که ضعیف الإيمان بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 646.13,
   "end": 648.73,
   "text": "مثل اهل تسنن. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.73,
   "end": 651.39,
   "text": "طبقه اول بهشت میرن. اونایی که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.39,
   "end": 653.13,
   "text": "سنی متهبی باشن اصطلاحا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.13,
   "end": 655.89,
   "text": "یعنی دشمنی با ولایت ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.89,
   "end": 661.35,
   "text": "اینا قاعده است. اینا یعنی اینطوری که نگاه می‌کنی اکثر مردم اهل نجات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 661.35,
   "end": 664.63,
   "text": "به قول شیخ الرئیس شما می‌فرماید شما نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.63,
   "end": 667.89,
   "text": "می‌بینید که غالب مردم، همین الان شما الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.89,
   "end": 670.51,
   "text": "توجه کنید شیخ الرئیس چه شیرین قشنگ صحبت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.51,
   "end": 674.39,
   "text": "فکر می‌کنم در اشاراتشه. می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.39,
   "end": 679.45,
   "text": "غالب مردم رو نگاه کنید چهره‌شون متعارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.45,
   "end": 682.49,
   "text": "اینطوری نیست؟ یعنی مشمئز کننده نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.49,
   "end": 684.65,
   "text": "یا حتی خیلی جذاب هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.65,
   "end": 688.17,
   "text": "متعارفه. یعنی اهل نجات‌اند انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.17,
   "end": 693.53,
   "text": "چه می‌دونی لحظه آخر عمرش خدا یه معامله‌ای کرده با همون لحظه آخر قبولش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 693.53,
   "end": 698.67,
   "text": "توجه کردی؟ ولی بعد شیخ الرئیس فرمود یه عده قليلي‌اند که مسخ شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.67,
   "end": 702.81,
   "text": "چهره‌شون، انقدر گناه کردن که نگاه می‌کنی حالت بد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.81,
   "end": 708.33,
   "text": "بله هستن عده قليلي. و بعد فرمودن عده قليلي هم هستند انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 708.33,
   "end": 711.71,
   "text": "غرق در حضرت حق شدن که چهره‌های این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 711.71,
   "end": 714.21,
   "text": "اصلا داد می‌زنه اینا الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.21,
   "end": 717.65,
   "text": "صورت رهبر رو دیدید مثل خورشید می‌درخشه واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 717.65,
   "end": 721.23,
   "text": "اصلا از نزدیک که ببینی واقعا رعشه به بدنت می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 721.23,
   "end": 727.15,
   "text": "امام که دیگه هیچی. اصلا حرف از امام علیه الرحمه کسی نزدیکش می‌شد به لرزه می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 727.15,
   "end": 729.23,
   "text": "اینا دیگه کمّلين‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 729.23,
   "end": 732.79,
   "text": "کم هم هستند اما غالبا متعارف‌اند و اهل نجات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 732.79,
   "end": 735.17,
   "text": "اینو حواسمون باشه. شیطان تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 735.17,
   "end": 738.19,
   "text": "نفس آخر مترصده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 738.19,
   "end": 740.75,
   "text": "ما رو از این رتبه‌هایی بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 740.75,
   "end": 744.63,
   "text": "رتبه و مراتب هم که در همه مراتب محفوظه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 744.63,
   "end": 750.11,
   "text": "\"تلک الرسول\" حتی رسولان هم \"فبل بعضهم على بعض\" بر هم برتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 750.11,
   "end": 752.37,
   "text": "انسان‌ها هم اینچنین‌اند. رتبه به رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.37,
   "end": 757.29,
   "text": "شیطان می‌خواد حداقل دیگه ما رو اگر به هلاکت نمی‌رسونه به خسران بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.29,
   "end": 759.77,
   "text": "یعنی بیاد بکشونه بیاره تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 759.77,
   "end": 762.87,
   "text": "این حد انزل مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.87,
   "end": 764.69,
   "text": "سیر و سلوک که دیگه همین جاها باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.69,
   "end": 767.19,
   "text": "یعنی بریم معذرت می‌خوام عذرخواهی از شما می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 767.19,
   "end": 769.49,
   "text": "بریم مثلا طویله‌های بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 769.49,
   "end": 771.85,
   "text": "بریم اون پایین‌شهر بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 771.85,
   "end": 774.89,
   "text": "آره عزیزم انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 774.89,
   "end": 777.93,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.93,
   "end": 785.27,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}