 "chapters": [
  {
   "index": 0,
   "title": "## ذیل روایت پنجم؛ بیش از یک موت",
   "start": 12.14,
   "end": 60.08
  },
  {
   "index": 1,
   "title": "## بدن دنیوی در طول بدن برزخی",
   "start": 60.08,
   "end": 88.84
  },
  {
   "index": 2,
   "title": "## آسمان و زمین و نور؛ رشحه از اصل",
   "start": 88.84,
   "end": 171.0
  },
  {
   "index": 3,
   "title": "## مثل آتش جهنم",
   "start": 171.0,
   "end": 191.1
  },
  {
   "index": 4,
   "title": "## رشحهٔ بهشت و جهنم در دنیا",
   "start": 191.1,
   "end": 284.26
  },
  {
   "index": 5,
   "title": "## تب مؤمن؛ حداکثر بهره از جهنم",
   "start": 284.26,
   "end": 537.38
  },
  {
   "index": 6,
   "title": "## آیات حسرت بازگشت",
   "start": 537.38,
   "end": 671.26
  },
  {
   "index": 7,
   "title": "## اماته و احیای آن‌به‌آن",
   "start": 671.26,
   "end": 731.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 5.06,
   "text": "نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.06,
   "end": 10.38,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.38,
   "end": 16.56,
   "text": "نکته‌ی مهمی که ذیل روایت پنجم از باب اول کتاب الموت باید بگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.56,
   "end": 19.52,
   "text": "اینجا بحث موت رو که مطرح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.52,
   "end": 22.82,
   "text": "باید توجه داشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.82,
   "end": 25.46,
   "text": "ما فقط همین یک موت رو نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.46,
   "end": 29.12,
   "text": "و البته همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.12,
   "end": 33.5,
   "text": "می‌دونید نشئه ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.5,
   "end": 42.48,
   "text": "سایه ملکوته. همونطور که ملکوت سایه جبروته، همونطور که جبروت سایه لاهوته همینطور برو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.48,
   "end": 50.28,
   "text": "مراتب عالیه. توجه داشته باشید که هرچی که تو این دنیا می‌بینیم مثلی یا ظل و سایه ایست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.28,
   "end": 55.5,
   "text": "جلوه‌ایست، رشحه ایست از آنچه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.5,
   "end": 59.46,
   "text": "مادون مافوق یا در باطن عالم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.46,
   "end": 62.48,
   "text": "مثلا ما بدن دنیوی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.48,
   "end": 64.98,
   "text": "در طول بدن برزخی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.98,
   "end": 67.86,
   "text": "بدن برزخی‌مون الان هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.86,
   "end": 70.5,
   "text": "همینطوری ابدان داریم، بدن‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.5,
   "end": 73.64,
   "text": "در آیات قرآن هم حتی داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.64,
   "end": 76.34,
   "text": "اهل ایمان تو بهشت میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.34,
   "end": 82.22,
   "text": "این چیزی که الان روزی ما شده، اون اطعمه و أشربه ای که در بهشت می‌خورن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.22,
   "end": 84.68,
   "text": "اکل و شرب که وجود داره میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.68,
   "end": 88.0,
   "text": "شبیه اونیه که تو دنیا داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.0,
   "end": 91.3,
   "text": "این نشون میده که حتی اکل و شرب اونجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.3,
   "end": 94.52,
   "text": "مرتبه‌ی مافوق اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.52,
   "end": 96.72,
   "text": "یعنی اینجا سایه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.72,
   "end": 101.08,
   "text": "اصل اونجاست. هرچی میری بالاتر اصله، اینجا فرعشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.08,
   "end": 105.74,
   "text": "حالا متاسفانه ما چسبیدیم به فرع و اصل رو رها کردیم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.74,
   "end": 109.44,
   "text": "چسبیدیم به ملک، ملکوت رو رها کردیم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.44,
   "end": 113.76,
   "text": "در همه‌ی شعونات این چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.76,
   "end": 117.42,
   "text": "عرض شود خدمتتون حتی در آسمان و زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.42,
   "end": 124.0,
   "text": "آسمان و زمینی هم که ما اینجا داریم می‌بینیم شب و روزی هم که اینجا می‌بینیم یک رشحه ایست از اونجا؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.0,
   "end": 127.16,
   "text": "اصل اونجاست. حیات و موت هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.16,
   "end": 133.42,
   "text": "حتی جهنم و بهشت. حتی نور و نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.42,
   "end": 137.64,
   "text": "دنیا نسبت به آخرت تاریکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.64,
   "end": 141.54,
   "text": "اینجا هم نور داره. الله نور السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.54,
   "end": 143.9,
   "text": "اما یک رشحه ایست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.9,
   "end": 146.26,
   "text": "اون نور اصلی که اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.26,
   "end": 148.46,
   "text": "و اشرقت الأرض بنور ربها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.46,
   "end": 152.02,
   "text": "اونجا به نور ربش روشن می‌شه که امامشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.02,
   "end": 155.86,
   "text": "ای به نور امام. مرحوم حاج سبزواری عليه الرحمة می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.86,
   "end": 157.98,
   "text": "اینجا با چه نوری؟ خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.98,
   "end": 161.72,
   "text": "و شمس و وهی ها این شمس رو فرمودن پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.72,
   "end": 166.12,
   "text": "اینجا خورشید یک رشحه ای از نور پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.12,
   "end": 168.68,
   "text": "همه چی اونجاست. اینو میخوام عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.68,
   "end": 172.24,
   "text": "همه چی اونجاست حتی آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.24,
   "end": 175.72,
   "text": "جهنم هم که حالا چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.72,
   "end": 177.9,
   "text": "پیغمبر بخواد به ما بفهمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.9,
   "end": 181.74,
   "text": "مثل می‌زنه. تلك الأمثال نضربها للناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.74,
   "end": 185.66,
   "text": "قرآن هم می‌فرماید ما ضرب مثل می‌کنیم که مردم بفهمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.66,
   "end": 191.1,
   "text": "مثل، مثال. میگه آتش جهنم رو هفتاد بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.1,
   "end": 195.24,
   "text": "شستن با آب شستن شد آتش دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.24,
   "end": 197.84,
   "text": "خب چگونه مثال بزنه پیغمبر که ما بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.84,
   "end": 205.38,
   "text": "اینطوریه دیگه. یا فرمود آتش دنیا رو خدا هفت بار درش دمید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.38,
   "end": 212.26,
   "text": "شد آتش جهنم که هر بار البته به یک رنگی دراومد آخر سر به رنگ سیاه دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.26,
   "end": 215.22,
   "text": "این‌ها همه معانی‌ای درش نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.22,
   "end": 219.6,
   "text": "می‌خواد بگه اصل اونجاست‌ها. حواست باشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.6,
   "end": 221.92,
   "text": "حتی بهشت و جهنم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.92,
   "end": 225.82,
   "text": "اینجا ما داریم ازش؟ آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.82,
   "end": 229.52,
   "text": "خیلی موقع‌ها شما نشده یه حالت انبساط خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.52,
   "end": 232.72,
   "text": "بهت دست میده، شرح صدر بهت دست میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.72,
   "end": 237.5,
   "text": "یه ذوق و شوق خاصی داری، یه سروری، فرحی برت حاکم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.5,
   "end": 241.7,
   "text": "این یه رشحه ای از بهشته. همه با هم رفیقن، همه با هم خوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.7,
   "end": 245.04,
   "text": "کس پشت سر کسی غیبت و دروغ و اینو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.04,
   "end": 247.38,
   "text": "زیر آب همگر نمیزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.38,
   "end": 250.06,
   "text": "قرآن میگه دیگه آیه آخر سوره مریم باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.06,
   "end": 252.32,
   "text": "الذين آمنوا وعملوا الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 252.32,
   "end": 258.08,
   "text": "این دو تا که اومد، ایمان و عمل صالح سیجعل لهم الرحمن ودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.08,
   "end": 260.92,
   "text": "یه محبت شدیدی خدا بین این‌ها برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.92,
   "end": 262.86,
   "text": "دیدی تو هیئت‌ها، تو حرم‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.86,
   "end": 267.0,
   "text": "تو مساجد، تو مجالس اهل ایمان، اجتماعات علمیه این‌ها چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.0,
   "end": 270.76,
   "text": "بهشت بیشتره چشیدن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.76,
   "end": 274.62,
   "text": "جهنم هم هست وقتی عصبی می‌شی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.62,
   "end": 277.34,
   "text": "اعصابت خورد می‌شه، دیدی؟ می‌ریزی به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.34,
   "end": 280.28,
   "text": "قیافه‌ت چجوری می‌شه؟ سیاه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.28,
   "end": 283.06,
   "text": "اون همون آتش سیاه جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.06,
   "end": 289.62,
   "text": "و عجیبه که حدیث هم داریم‌ها که غضب این، این عصبیّت از دوزخ، از جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.62,
   "end": 294.3,
   "text": "یعنی معناش اینه. مثلا یکی قدیم‌ها عصبانی می‌شد می‌گفت اوه، اوه!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.3,
   "end": 298.04,
   "text": "چه جهنمی! قیافه‌ش شد جهنم، جهنمی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.04,
   "end": 302.72,
   "text": "این هم‌ش حساب کتاب داشت. اصلاً حدیث داریم تب مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.72,
   "end": 306.28,
   "text": "دقت کنید چه شیرین. تب، تب که همه داشتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.28,
   "end": 314.22,
   "text": "داغ می‌شیم. تب مؤمن حداکثر بهره‌ی مؤمن از جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.22,
   "end": 317.9,
   "text": "حداکثر ها. یعنی مؤمن هم از جهنم بهره می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.9,
   "end": 320.28,
   "text": "تب. می‌خواد خدا گناه‌هاش رو بریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.28,
   "end": 322.58,
   "text": "آتش جهنم می‌ندازه به جونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.58,
   "end": 327.06,
   "text": "اما برای مؤمن تبه. این دیگه حداکثر، حداکثر بهره‌ی مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.06,
   "end": 330.94,
   "text": "باز می‌شه چی؟ یه رشحه ای از جهنم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.94,
   "end": 335.18,
   "text": "اصلاً همه چی اینجا هست اما سایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.18,
   "end": 338.76,
   "text": "حالا ما باید تو جمع خودمون بهشت ببینیم یا جهنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.76,
   "end": 340.66,
   "text": "باید دائما بهشت ببینیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.66,
   "end": 348.18,
   "text": "ماشاالله همه اهل ایمان و اهل انقلاب و اهل ولایت و مسجد و هیئت و تسبیح دست و همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.18,
   "end": 352.32,
   "text": "چه عرض کنیم؟ داشته باشید تسبیح دستتون باشه مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.32,
   "end": 357.86,
   "text": "یعنی چی؟ یعنی ما باید الان چکار-- باید بین خودمون ببینیم بهشت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.86,
   "end": 360.44,
   "text": "چی جهنمش می‌کنه؟ دروغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.44,
   "end": 364.2,
   "text": "غیبت، آبرو بردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.2,
   "end": 366.7,
   "text": "پس حالا همه اینا رو مقدمه چیدم برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.7,
   "end": 369.96,
   "text": "اینکه بدانین ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.96,
   "end": 375.26,
   "text": "حیاتیم که الان دارین یک رشه‌ای از اون حیات کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.26,
   "end": 379.68,
   "text": "حتی موت. موتی هم که اینجا اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.68,
   "end": 382.9,
   "text": "سایه اون موته. یعنی ما قراره دوباره بمیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.9,
   "end": 387.86,
   "text": "آقا ما قراره دوباره بعد از موتی که تو دنیا حاصل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.86,
   "end": 390.38,
   "text": "بمیریم؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.38,
   "end": 393.4,
   "text": "بر اساس چی داری میگی؟ آیه شو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.4,
   "end": 398.86,
   "text": "آیه سوره غافر آیه یازده شو ب-بخونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.86,
   "end": 401.4,
   "text": "چقدر آیه قشنگه. \"قالوا\" این البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.4,
   "end": 407.98,
   "text": "مربوط به اهل دوزخه تو جهنم میگن \"قالوا\" اینا میگن که \"ربنا امتنا اثنتین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.98,
   "end": 412.3,
   "text": "تو دو بار ما رو کشتی.\"امتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.3,
   "end": 419.14,
   "text": "اثنتین\" ما رو کشتی.\"اثنتین\" دو بار.\"واحيينا اثنتين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.14,
   "end": 422.54,
   "text": "دو بار ما رو احیا کردی، زنده کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.54,
   "end": 424.5,
   "text": "صریح آیه است که داره میگه دو بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.5,
   "end": 426.82,
   "text": "ما مردیم، دو بار هم زنده شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.82,
   "end": 429.7,
   "text": "\"فاعترفنا\" پس حالا بعد از این دو بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.7,
   "end": 432.68,
   "text": "\"فاعترفنا بذنو بنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.68,
   "end": 435.18,
   "text": "حالا که اینطور شد ما دیگه به گناهامون اعتراف می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.18,
   "end": 437.88,
   "text": "\"فهل الی خروج من سبيل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.88,
   "end": 441.7,
   "text": "آیا راهی هست خدا ما از این آتش راحت بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.7,
   "end": 445.32,
   "text": "این داره صریحاً اشاره می‌کنه به اینکه ما دو بار می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.32,
   "end": 448.98,
   "text": "حالا اینجا دو بار می‌میریم، دو بار احیا می‌شیم و نظرات متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.98,
   "end": 453.6,
   "text": "بیشتر مفسرین فرمودن دو بار احیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 453.6,
   "end": 458.22,
   "text": "برمی‌گرده احیای اول به ابتدای عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.22,
   "end": 461.56,
   "text": "یعنی ما می‌میریم تازه زنده می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.56,
   "end": 465.38,
   "text": "احیای دوم برمی‌گرده به ابتدای قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.38,
   "end": 471.72,
   "text": "موت چی؟ گفتن موت اول برمی‌گرده به همین مرگی که ما تو این دنیا بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.72,
   "end": 474.66,
   "text": "میاد سراغمون. موت که بحثش رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.66,
   "end": 480.22,
   "text": "موت دوم در برزخ، انتهای برزخ، انتهای دو-دنیا موت اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.22,
   "end": 485.54,
   "text": "انتهای برزخ موت دوم که سور دمیده می‌شه حضرت اسرافیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.54,
   "end": 488.56,
   "text": "همه می‌میرن به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.56,
   "end": 493.74,
   "text": "و میرن به باطن‌تر از برزخ که می‌شه عالم عقول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.74,
   "end": 496.66,
   "text": "ملائکه، مفارقات اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.66,
   "end": 499.82,
   "text": "که این خودش نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.82,
   "end": 505.4,
   "text": "چقدر آرزو می‌شه برای اونایی که تو جهنم‌ن و تو عذابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.4,
   "end": 513.1,
   "text": "که چون آخرش میگن \"فهل الی خروج من سبيل\" آیا راهی هست ما خارج بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.1,
   "end": 517.38,
   "text": "چقدر آرزو می‌شه براشون این حالتی که الان ما داریم همین الان اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.38,
   "end": 521.6,
   "text": "ما الان خروج از اون حالтим دیگه، خارجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.6,
   "end": 526.74,
   "text": "باز آیات دیگه داریم مثلاً آیه برای اینکه اهمیتش رو بفهمیم و که الان چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.74,
   "end": 530.2,
   "text": "چه نعمتی غرق درش هستیم و نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.2,
   "end": 532.7,
   "text": "تو اون ضیق قرار نگرفتیم هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.7,
   "end": 537.38,
   "text": "اگرم حتی الان تو جهنمیم، سایه جهنمه عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.38,
   "end": 544.04,
   "text": "شعراء آیه چهل و چهار \"هل الی مردٍّ من سبيل\" آیا راهی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.04,
   "end": 547.26,
   "text": "من برگردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.26,
   "end": 552.08,
   "text": "آیه پنجاه و هشت زمر \"لئن ان لي كرهةً فأكون من المحسنين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.08,
   "end": 555.94,
   "text": "ای کاش عمر دیگری بود \"كرهةً\" دوباره تکرار می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.94,
   "end": 559.8,
   "text": "که چی؟ \"فأكون من المحسنين\" تا من نیکوکار باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.8,
   "end": 562.02,
   "text": "اونجا دارن میگن. خب الان که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.02,
   "end": 568.72,
   "text": "جاشو دارم، عده و عدشو دارم، زمانشو مکانشو دارم، موقعیتشو م-- دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.72,
   "end": 573.72,
   "text": "چرا الان این کارو نکنم؟ دو مرتبه آیه صد و هفت مؤمنون \"ربنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.72,
   "end": 578.3,
   "text": "اخرجنا منها\" خدایا ما رو از اینجا خارج کن.\"فإن عدنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.3,
   "end": 584.32,
   "text": "اگه اونجا خارج کن ببر دنیا اگه اونجا \"فإن عدنا\" اگه دوباره ادا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.32,
   "end": 589.02,
   "text": "کار زشت کردیم، ز-- اهل ظلم و ستم بودیم \"فإنا ظالمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.02,
   "end": 591.3,
   "text": "دیگه ما قطعاً دیگه ظالمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 591.3,
   "end": 596.34,
   "text": "تو ما رو یه بار دیگه ببر. دوباره ببر امتحانمون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.34,
   "end": 599.4,
   "text": "مؤمنون آیه صد \"رب ارجعونه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.4,
   "end": 603.02,
   "text": "پروردگار من \"ربه\" اون کسر زیر ب یعنی ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.02,
   "end": 608.46,
   "text": "یعنی پروردگار من. همه قائل به ربوبیت حضرت حق می‌شن اونجا حتی جهنمیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.46,
   "end": 610.06,
   "text": "ما رو برگردون. برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.06,
   "end": 612.42,
   "text": "\"لعلی اعمل صالحاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.42,
   "end": 617.12,
   "text": "یه عمل صالح انجام بدم. تو رو خدای خود و هرکی دوست داری ما رو برگردون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.12,
   "end": 621.64,
   "text": "الان اینجایی که. الان اینجایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.64,
   "end": 627.16,
   "text": ". آیه دوازده سجدة \"فارجعنا نعمل صالحا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.16,
   "end": 629.76,
   "text": "خدایا ما رو بازگردون تا کار نیک انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 629.76,
   "end": 631.98,
   "text": "\"نعمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.98,
   "end": 639.18,
   "text": "صالحا\" عمل صالح. حالا رهبر عزیزمون فرمودن به جانبازای روز خیلی شیرین بود این تذکر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 639.18,
   "end": 641.42,
   "text": "فرمودن آرزوی شهادت داشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.42,
   "end": 646.02,
   "text": "خب گمان کن شهید شدی حالا دوباره برگشتی.\"رب ارجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.02,
   "end": 650.56,
   "text": "رجعت برگشتی. جانبازا شهدا زنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 650.56,
   "end": 653.22,
   "text": "اند. آقا دوباره بهت مهلت دادن برگشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 653.22,
   "end": 660.6,
   "text": "یا م-- حضرت استاد علامه حسن زاده علیه الرحمه بعد از برگشتن از تشییع عزیزی من کلیپ فیلمشو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.6,
   "end": 665.12,
   "text": "فرمودن شما گمان کنید جایی که ایشونید الان مردید تموم شده دوباره برتون گردوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 665.12,
   "end": 667.9,
   "text": "گفتن آقا یه فرصت دوباره‌ای بهت دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.9,
   "end": 671.26,
   "text": "بسم الله شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.26,
   "end": 673.9,
   "text": "پس بحث ما چی بود؟ اون موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.9,
   "end": 676.2,
   "text": "حالا حالاها ما موت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.2,
   "end": 682.18,
   "text": "حالا بخوایم بحث فلسفی بکنیم که شما هم حوصلشو ندارید که ما دائم در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 682.18,
   "end": 685.62,
   "text": "اماته و احیا در معرض اماته و احیا ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 685.62,
   "end": 690.72,
   "text": "چرا؟ چون \"وكل يومٍ كل يومٍ هو فيه شن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 690.72,
   "end": 698.0,
   "text": "آنفآن خدا داره در من و تو تجلی می‌کنه، ظهور می‌کنه، ظهور حضرت حق شدم من همین الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.0,
   "end": 701.84,
   "text": "دو مرتبه خدا می‌خواد تجلی جدید کنه، اون ظهور قبلی رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.84,
   "end": 703.8,
   "text": "اماته. موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.8,
   "end": 707.44,
   "text": "ظهور قبلی رفت. تجلی جدید، احیای جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 707.44,
   "end": 712.2,
   "text": "آنفآن. نظام هستی در حال اماته و احیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.2,
   "end": 721.4,
   "text": "اما ما خبر نداریم. خدا داره آنفآن تجلی می‌کنه در جمع موجودات و ظهور حضرت حق شدیم ما اما کاملاً از این بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 721.4,
   "end": 726.1,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 726.1,
   "end": 731.92,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}