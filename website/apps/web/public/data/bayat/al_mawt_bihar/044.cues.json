 "chapters": [
  {
   "index": 0,
   "title": "## تطابق نفس و بدن؛ شمشیر و غلاف",
   "start": 50.12,
   "end": 139.0
  },
  {
   "index": 1,
   "title": "## حکایت انصاری همدانی؛ تأثیر روح در بدن",
   "start": 139.0,
   "end": 275.14
  },
  {
   "index": 2,
   "title": "## هندسهٔ موت؛ یک‌بار، تدریجی، خواب، هر نفس، آن‌به‌آن",
   "start": 275.14,
   "end": 295.14
  },
  {
   "index": 3,
   "title": "و آیهٔ شریفه:",
   "start": 295.14,
   "end": 519.42
  },
  {
   "index": 4,
   "title": "## فلسفهٔ جعل موت؛ خشوع و کندن از تعلقات",
   "start": 519.42,
   "end": 595.3
  },
  {
   "index": 5,
   "title": "## سردار سلیمانی؛ رمز نترسیدن از مرگ",
   "start": 595.3,
   "end": 885.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.02,
   "end": 4.8,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 9.06,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.06,
   "end": 14.96,
   "text": "در روایت هفتم بودیم از کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.96,
   "end": 23.48,
   "text": "که بحث از سی و سه سال تا چهل سال یه روند تقریباً ثابت، از چهل و یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.48,
   "end": 30.7,
   "text": "تا پنجاه سالگی رو به افول و زوال و از پنجاه سالگی حالت نذر رو در این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.7,
   "end": 37.44,
   "text": "امام صادق صلوات الله علیه فرمودند که \"و ینبغي لصاحب الخمسین ان يكون كمن هو في النذر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 37.44,
   "end": 41.22,
   "text": "\"کمن هو في النذر\" یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.22,
   "end": 45.12,
   "text": "پنجاه سالگی موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.12,
   "end": 50.12,
   "text": "تدریجی شروع شده. اینجا بودیم که توجه یه نکته‌ای رو داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.12,
   "end": 54.88,
   "text": "در رابطه نفس با بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.88,
   "end": 57.14,
   "text": "اینطور نیستش که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.14,
   "end": 61.46,
   "text": "نفوس وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.46,
   "end": 65.32,
   "text": "رو به کهولت سن می‌گذارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.32,
   "end": 68.76,
   "text": "بدنشون بسوزه و بدنشون رو به زوال بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.76,
   "end": 73.06,
   "text": "این مال همه نیست. اکثراً اینطوری هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.06,
   "end": 75.64,
   "text": "چرا؟ چون بین نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.64,
   "end": 79.44,
   "text": "و بدن تطابق وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.44,
   "end": 81.74,
   "text": "یه مثل هندی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.74,
   "end": 89.26,
   "text": "شاید شنیده باشید. میگن شمشیر تیز و سنگین و برنده غلافش رو خورد خورد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.26,
   "end": 93.54,
   "text": "اصطلاحاً میگن شمشیر تیز غلافش رو می‌سوزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.54,
   "end": 96.82,
   "text": "جان قوی، نفس قوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.82,
   "end": 100.74,
   "text": "بدن رو می‌سوزونه. یعنی رفته رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.74,
   "end": 105.24,
   "text": "بدن به جایی می‌رسه که دیگه توان کشیدن همچین نفس و روحی رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.24,
   "end": 109.3,
   "text": "چون هرچی سن میره بالا بدن به کهولت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.3,
   "end": 111.34,
   "text": "نفس بالعکس قوی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.34,
   "end": 114.34,
   "text": "عقل قوی می‌شه که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.34,
   "end": 116.4,
   "text": "اما این برای کیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.4,
   "end": 120.8,
   "text": "برای کسایی که تطابق بین بدن و نفس رو یا تطابق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.8,
   "end": 124.22,
   "text": "آدم و عالم رو رعایت نکردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.22,
   "end": 126.24,
   "text": "که بحث بسیار دقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.24,
   "end": 129.98,
   "text": "و مهمی‌ست که قبلاً درباره‌ش ما سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.98,
   "end": 135.9,
   "text": "خیلی مهمه تطابق که لذا انسان کامل ما معتقدیم انسان کامل یعنی امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.9,
   "end": 141.12,
   "text": "صلوات الله علیه که الان با بدن عنصری زندگی می‌کنند در این نشئه طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.12,
   "end": 149.6,
   "text": "ایشون به جهت رعایت تبا-- تطابق بین نفسشون و بدنشون هیچ‌وقت بدنشون نمی‌سوزه، رو به کهولت نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.6,
   "end": 152.6,
   "text": "و اون اعتدال مزاج و اینا که بحثاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.6,
   "end": 154.46,
   "text": "اما در غیر این صورت چرا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.46,
   "end": 159.8,
   "text": "حالا چون ماها بلد نیستیم متأسفانه دستمون از دامان وحی کوتاه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.8,
   "end": 163.78,
   "text": "خدا لعنت کنه اونه که غصب کردند مقام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.78,
   "end": 170.46,
   "text": "مقام رو که غصب نکردند، ریاست ظاهری رو غصب کردند و الا ولایت در کل جهان ساری و جاریست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.46,
   "end": 173.18,
   "text": "و دست ما کوتاه شد والا ما هم می‌شد به اینجا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.18,
   "end": 176.04,
   "text": "علت اینکه امم پیشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.04,
   "end": 181.2,
   "text": "دوران انبیای پیشین عمرها هزار ساله بوده یکیش این بوده که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.2,
   "end": 184.88,
   "text": "اینم خودش یک موضوعیه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.88,
   "end": 187.48,
   "text": "مثلاً مرحوم در حالات مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.48,
   "end": 190.56,
   "text": "خدا رحمت کنه مرحوم بهاری همدانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.56,
   "end": 196.62,
   "text": "انصاری همدانی. مرحوم انصاری همدانی یکی از عرفا و بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.62,
   "end": 199.82,
   "text": "کمال شیعه بود. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.82,
   "end": 203.26,
   "text": "زودم از دنیا رفت. اینطور که یادمه زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.26,
   "end": 207.56,
   "text": "سن چهل سال. حالا اگه اشتباه نکنم زندگی‌نامه‌شون رو خیلی سال پیش خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.56,
   "end": 210.32,
   "text": "پزشکی که ایشون رو قلبشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.32,
   "end": 213.2,
   "text": "عمل کرده بودند رفته بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.2,
   "end": 216.9,
   "text": "نمی‌دونستن حالا خیلی ارتباط با مسئله معنوی ظاهراً نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.9,
   "end": 221.06,
   "text": "به نزدیکان این بزرگوار گفته بودند که ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.06,
   "end": 223.68,
   "text": "ایشون خیلی عاشق کسی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.68,
   "end": 226.74,
   "text": "عاشق کسی شده اینا حواستون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.74,
   "end": 230.46,
   "text": "چرا؟ حدود قلبش تکه تکه است، پاره پاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.46,
   "end": 232.86,
   "text": "اصلاً قلبش سوخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.86,
   "end": 235.94,
   "text": "ببینید تأثیر روح در بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.94,
   "end": 242.8,
   "text": "اینطوری هست وقتی که نفس قوی می‌شه، روح بزرگ می‌شه، دیگه این بدن کشش اونو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.8,
   "end": 246.74,
   "text": "لذا رفته رفته موت به صورت تدریجی شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.74,
   "end": 248.38,
   "text": "موت تدریجی شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.38,
   "end": 253.72,
   "text": "که حالا اهل بیت فرمودند دیگه از پنجاه سالگی خودت رو دیگه میت بدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.72,
   "end": 256.86,
   "text": "إنك ميت و إنه ميت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.86,
   "end": 259.04,
   "text": "تمام کار. این کار دیگه تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.04,
   "end": 261.48,
   "text": "یعنی موت آغاز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.48,
   "end": 264.94,
   "text": "قوای وجودی سفرشون رو با آخرت شروع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.94,
   "end": 268.2,
   "text": "یک یک قوای وجودی دارن میرن رو به ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.2,
   "end": 271.56,
   "text": "زوال و ضعف میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.56,
   "end": 273.86,
   "text": "اما در انسان کامل اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.86,
   "end": 282.24,
   "text": "حالا اینجا اگر یک منظومه‌ای رو شما بخواید توجه کنید، یه هندسه‌ای رو از حیث موت و مراتبش دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.24,
   "end": 284.46,
   "text": "یه روندی رو ما تا اینجا اومدیم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.46,
   "end": 288.32,
   "text": "اینو دقت کنید. یک بار گفتیم که موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.32,
   "end": 292.24,
   "text": "تو کل عمر یک بار اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.24,
   "end": 298.2,
   "text": "اینو که دیگه همه می‌پذیرند. بعد بر اساس روایات و آیات اومدیم گفتیم که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.2,
   "end": 300.46,
   "text": "نه، مثل همین روایت هفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.46,
   "end": 305.48,
   "text": "باب-- کتاب الموت. از پنجاه سالگی به بعد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.48,
   "end": 309.14,
   "text": "موت تدریجی شروع می‌شه. اینم یه موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.14,
   "end": 312.52,
   "text": "دوباره قبلاً سخن گفته بودیم که آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.52,
   "end": 316.28,
   "text": "چون انبیای پیشین می‌خواستن زندگی پس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.28,
   "end": 319.48,
   "text": "این زندگی رو به مردم تفهیم کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.48,
   "end": 326.3,
   "text": "نمی‌فهمیدند خداوند بنابر فرمایش ملا محسن فیض در وافی‌شون که روایت شریفی هم اونجا میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.3,
   "end": 328.9,
   "text": "خدای من یه روایته یعنی ما نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.9,
   "end": 331.28,
   "text": "خداوند منان جعل چی کار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.28,
   "end": 335.5,
   "text": "جعل خواب رو کرد. ایجاد کرد خواب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.5,
   "end": 339.72,
   "text": "که حدیث هم داریم \"النوم أخو الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.72,
   "end": 343.94,
   "text": "و اون آیه شریفه که \"الله يتوفى الأنفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.94,
   "end": 346.96,
   "text": "حين موتها\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.96,
   "end": 350.18,
   "text": "خدا توفی می‌کنه در ادامه‌ش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.18,
   "end": 354.48,
   "text": "و کسی که در خواب رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.48,
   "end": 360.2,
   "text": "و این عرض شود خدمتتون که نشون می‌ده که کسی هم که به خواب رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.2,
   "end": 363.18,
   "text": "در، در حقیقت موت براش اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.18,
   "end": 366.88,
   "text": "منتها اونی که قراره برای همیشه بره دیگه برگشت براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.88,
   "end": 371.28,
   "text": "اون که خوابیده و قراره برگرده دو مرتبه نفس و روح برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.28,
   "end": 377.46,
   "text": "حالا پس این در صریح آیات و این‌ها هم هست که نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.46,
   "end": 383.06,
   "text": "ما نه مثل این که از پنجاه سالگی به بعد نه مثل اینکه هر شب داریم می‌میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.06,
   "end": 386.44,
   "text": "و زنده می‌شیم. احیا این حیات و موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.44,
   "end": 390.8,
   "text": "هر-- belki کسی که روزی چند بار هم بخوابه روزی چند بار اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.8,
   "end": 393.9,
   "text": "بعد میریم جلوتر میبینیم نخیر دقیق‌تر از این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.9,
   "end": 396.8,
   "text": "اصلا در هر نفسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.8,
   "end": 399.64,
   "text": "در هر نفس حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.64,
   "end": 405.12,
   "text": "در ذیل شرح دعای شریف سحر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.12,
   "end": 411.28,
   "text": "اونجا یه روایتی رو میاره مقصود خیلی شیرین بحث میکنه که ما در هر نفس در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.28,
   "end": 415.48,
   "text": "اماته و احیا ایم. قوای عزرائیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.48,
   "end": 419.36,
   "text": "میان اینو حضرت امام می‌فرماید بر استنباطش از اون روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.36,
   "end": 422.72,
   "text": "قوای عزرائیلی میان قبض می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.72,
   "end": 427.18,
   "text": "قوای اسرافیل میاند نفخ می‌کنند، می‌دمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.18,
   "end": 429.78,
   "text": "یعنی در هر دم ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.78,
   "end": 433.62,
   "text": "هر دم در حال احیا باز دم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.62,
   "end": 436.32,
   "text": "وقتی میدیم بیرون تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.32,
   "end": 442.72,
   "text": "اماته رخ میده. یعنی قوای اسرافیل در حقیقت عزرائیل و اسرافیل دائماً در ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.72,
   "end": 447.04,
   "text": "در حال کارند، در حال پیاده شدن در نظام هستی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.04,
   "end": 450.22,
   "text": "بازم جزئی‌تر از این هم داریم دقیق‌تر از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.22,
   "end": 455.58,
   "text": "بله اصلاً در کائنات حرکت جوهری بر اساس فلسفه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.58,
   "end": 458.48,
   "text": "ذیل آیات و روایات تبین شده وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.48,
   "end": 461.74,
   "text": "یعنی اینکه آن‌فآن اینو بحثا بین ما گذشته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.74,
   "end": 464.34,
   "text": "\"فکل یوم هو فی شأن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.34,
   "end": 470.82,
   "text": "آن‌فآن چون صورت جدیدی میخواد ایجاد بشه در هر شیئی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.82,
   "end": 473.1,
   "text": "اون صورت قبلی باید بمیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.1,
   "end": 475.7,
   "text": "و الا این صورت قبلی چگونه احیا بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.7,
   "end": 482.32,
   "text": "لذا اون صورت قبلی که الان من دارم یک آن بعد از این، این می‌میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.32,
   "end": 489.54,
   "text": "اماته. یک آن بعد از این صورت جدیدی برای من احیا می‌شه توسط حضرت اسرافیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.54,
   "end": 492.98,
   "text": "اماته و احیا پس بر اساس این نکته آخر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.98,
   "end": 497.56,
   "text": "دائماً آن‌فآن داره در کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.56,
   "end": 500.76,
   "text": "رخ میده نه فقط در من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.76,
   "end": 507.32,
   "text": "که اماته و احیا در کارند بر اساس نظرات بزرگان ما دائماً داریم می‌میریم و زنده می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.32,
   "end": 510.64,
   "text": "\"یخرج الحي من المیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.64,
   "end": 513.82,
   "text": "و یخرج المیت من الحي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.82,
   "end": 516.9,
   "text": "آیه شریف قرآن استناد بر همین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.9,
   "end": 519.04,
   "text": "خب این یعنی که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.04,
   "end": 522.18,
   "text": "اصلاً چرا خدا این‌ها رو جعل کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 522.18,
   "end": 524.82,
   "text": "ما بارها عرض کردیم وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.82,
   "end": 528.24,
   "text": "تنه بحث فلسفی‌مون می‌خوره به بحث‌های اخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.24,
   "end": 530.28,
   "text": "میگیم سرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.28,
   "end": 535.34,
   "text": "اینه که انسان بیفته به خشوع و کندن از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.34,
   "end": 539.3,
   "text": "همین. اصلاً سرش در اینه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.3,
   "end": 543.88,
   "text": "بیفته به خشوع از اون حالت تبختر بیاد پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.88,
   "end": 553.28,
   "text": "بیفته به خاک و دماغش رو قبل از اینکه در قبر بخواب-- بمالونن خودش با عبادت به خاک بمالونه و بیفته به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.28,
   "end": 556.7,
   "text": "تواضع و خشوع. یعنی از تعلقات کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 556.7,
   "end": 560.58,
   "text": "این یکی از مهم‌ترین فلسفه‌های جعل موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.58,
   "end": 563.44,
   "text": "اونم آن‌فآن. برای اینکه ما از تعلقاتمون بکاهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.44,
   "end": 566.8,
   "text": "آقا تعلقات پدر ما رو درآورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.8,
   "end": 573.26,
   "text": "بارها هم عرض کردیم یکی تعلق شاید مثل من مثلاً به این لباس و جایگاه و چه می‌دونم اینا داشته باشه یکی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.26,
   "end": 580.32,
   "text": "میز ریاست و مدیریتش، یکی به پست و یکی به مدرک تحصیلی و مشهوریتش و یکی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 580.32,
   "end": 584.7,
   "text": "پولش و زن و بچه و نسب و اصلش و هرکی به یه چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.7,
   "end": 588.12,
   "text": "بدبخت کسیه که اصلاً بر چیز نداشته‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.12,
   "end": 591.14,
   "text": "دل ببنده. بر چیزی که نداره تعلق داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 591.14,
   "end": 594.76,
   "text": "اونکه دیگه هیچی. پس موت میاد ما رو از تعلقات بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.76,
   "end": 597.76,
   "text": "شما ببینید امروز سالروز سردار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.76,
   "end": 600.84,
   "text": "شهادت سردار دلها حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.84,
   "end": 603.58,
   "text": "شهید سلیمانی عزیزم هست روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.58,
   "end": 606.84,
   "text": "ما زبانمون قاصره از این بزرگوار حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.84,
   "end": 608.4,
   "text": "تسلیت عرض می‌کنیم امروزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.4,
   "end": 612.14,
   "text": "واقعا من در اون حد نمی‌بینم خودم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.14,
   "end": 614.62,
   "text": "گناه می‌کنم از ایشون بخوام حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.62,
   "end": 618.98,
   "text": "اما چه کنیم؟ شما عاشقید، دوست دارید یه چیزکی عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.98,
   "end": 625.2,
   "text": "یه فیلمی داشتم می‌بینم، می‌دیدم از لحظه‌ای که ایشون داشت نیروها رو توجیه می‌کرد برن بزنن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.2,
   "end": 628.78,
   "text": "مثلاً کمین بزنن به داعشی‌ها همه آماده شهادت بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.78,
   "end": 630.96,
   "text": "سردار خودش هم آماده بود. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 630.96,
   "end": 633.82,
   "text": "چند جمله‌ی خیلی شیرین با اینا صحبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.82,
   "end": 639.4,
   "text": "مثال زد. گفت می‌دونید چرا من و شما از مرگ نمی‌ترسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 639.4,
   "end": 643.02,
   "text": "نمی‌ترسیم مثلاً از داعشی‌ها نمی‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 643.02,
   "end": 652.4,
   "text": "و چرا آمریکایی‌ها انقدر از ما می‌ترسند که با وجود اینکه یک میلیون نیرو در منطقه پیاده کردند باز پوشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.4,
   "end": 654.58,
   "text": "میارن برای نیروهاشون. پوشک!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 654.58,
   "end": 658.62,
   "text": "جسارتاً پوشک به نیروهاشون، سربازاشون دادن که تو تانک وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.62,
   "end": 663.04,
   "text": "نیاز به تخلی پیدا کردن همونجا فلان کنن تو پوشکشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.04,
   "end": 666.4,
   "text": "از ترس اینکه وقت از تانک پیاده نشن با ما مواجه بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.4,
   "end": 671.3,
   "text": "اما ما این ترسا نداریم. ما همینطوری با دل شیر میریم تو دلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 671.3,
   "end": 678.1,
   "text": "چرا؟ سردار اینجا رمزگشایی کرد برای اونا فرمود به جهت اینکه ما از دادن جان دریغ نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.1,
   "end": 684.98,
   "text": "چی بالاتر از جان؟ الان به پیرمرد فرتوت نود ساله، صد ساله می‌گی آقا داری می‌میری کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 684.98,
   "end": 690.76,
   "text": "داره جون میده در حال نزع جان کندنه میگه آخ خدایا تو رو خدای امیاژیم برا من بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.76,
   "end": 692.96,
   "text": "من دوست دارم دوباره بیشتر تو این دنیا بمونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.96,
   "end": 694.9,
   "text": "تعلقه دیگه. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.9,
   "end": 698.56,
   "text": "اصن همه دوست دارن بمونن. اما چرا حاضره بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.56,
   "end": 705.84,
   "text": "کندن از تعلقات. کسی که جان که عزیزترین و شریف‌ترین چیزشه حاضره بده پس هیچ تعلقی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 705.84,
   "end": 708.28,
   "text": "اصلاً رمز و راز پرواز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 708.28,
   "end": 712.24,
   "text": "شهدا اون کندن‌شون از تعلقاته قربونتون برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 712.24,
   "end": 714.3,
   "text": "که می‌تونن اینجوری حماسه بیافرینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.3,
   "end": 716.5,
   "text": "این رمزو اونجا سردار دلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.5,
   "end": 722.64,
   "text": "رمزگشایی کرده. حالا به نظر بنده یکی از قشنگ‌ترین سخن‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 722.64,
   "end": 728.76,
   "text": "ااا الحمدالله عزیزان حالا اساتید ما اخیراً پیرامون سردار سلیمانی گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 728.76,
   "end": 733.48,
   "text": "یه تشبیهی، تمثیلی، تنزیری بود بین کار ایشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 733.48,
   "end": 736.92,
   "text": "حضرت موسی با صحرای فرعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.92,
   "end": 743.3,
   "text": "فرعونه زمان اومدن دعایش رو راه انداختن تسخیر کنن مردم رو به دین قلابی بکشونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.3,
   "end": 747.52,
   "text": "اسلام قلابی. اما ایشون اژدهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 747.52,
   "end": 754.6,
   "text": "مقاومت رو که رها کرد، رها کرد نیروهای مقاومت رو تونست به صحرای فرعونه زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 754.6,
   "end": 756.92,
   "text": "چیره بشه و دل‌ها رو تسخیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 756.92,
   "end": 759.76,
   "text": "این یک معجزه بود در قرن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 759.76,
   "end": 761.62,
   "text": "چی باعث می‌شه قربونتون برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 761.62,
   "end": 764.86,
   "text": "به خدا قسم فقط کندنه از تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 764.86,
   "end": 770.68,
   "text": "آیا به نظر شما سردار سلیمانی نمی‌تونست بالاترین جایگاه‌های سیاسی رو تو کشور ما به دست بیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 770.68,
   "end": 773.54,
   "text": "بالاترین رانت‌ها، بالاترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 773.54,
   "end": 780.12,
   "text": "رسیدن به جایگاه‌های حالا پولی، اقتصادی، نبض اقتص-- هر جا اراده می‌کرد می‌تونست برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 780.12,
   "end": 782.62,
   "text": "اما نکرد. اون نامه‌ای که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 782.62,
   "end": 786.22,
   "text": "دخترش نوشته بود دیگه ختم کلامه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 786.22,
   "end": 788.3,
   "text": "فرموده بود من نشستم فکر کردم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 788.3,
   "end": 791.18,
   "text": "کردنه خودشم راه رو برای خودش باز می‌دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 791.18,
   "end": 794.96,
   "text": "هر طرف بخوام برم، برم دنبال پول، مقام، شهرت همه هست اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 794.96,
   "end": 798.06,
   "text": "برم سکه جمع کنم یه چند تا سکه، پولی چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 798.06,
   "end": 800.64,
   "text": "آخرش چی؟ خلاصه خستتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 800.64,
   "end": 805.08,
   "text": "خودش به دخترش میگه من خدا رو انتخاب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 805.08,
   "end": 807.22,
   "text": "تمام. و تو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 807.22,
   "end": 812.94,
   "text": "دست نوشته‌هاشم که الحمدالله شهرداری کار قشنگی کرده ماهانه نقد می‌کنیم کارهای قشنگشونم بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 812.94,
   "end": 816.94,
   "text": "توی بزرگراه تهران زده این دست خطو بارها هی زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 816.94,
   "end": 820.64,
   "text": "که خدایا عاشق دیدارتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 820.64,
   "end": 822.46,
   "text": "سردار سلیمانی، عاشق دیدارتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 822.46,
   "end": 825.06,
   "text": "اینطوری می‌شه که خدا می‌برش. بعد اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 825.06,
   "end": 829.2,
   "text": "خود سردار وصیت کرده بود که منو ایشون دفن کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 829.2,
   "end": 831.94,
   "text": "وقتی که دفنش کردن چند روز بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 831.94,
   "end": 836.62,
   "text": "دفن سردار ازش پرسیدن از این پیرمرد نورانی ریش سفید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 836.62,
   "end": 839.66,
   "text": "شما خواب سردارم دیدی اینا، گفت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 839.66,
   "end": 843.38,
   "text": "دو سه شب بعد از دفنش بهش گفتم سردار اون لحظه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 843.38,
   "end": 848.06,
   "text": "شما مورد حمله قرار گرفتید چه حالتی داشتید، چی به شما چی گذشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.06,
   "end": 850.42,
   "text": "فرمود ما اصلاً اون لحظه هیچی نفهمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 850.42,
   "end": 856.12,
   "text": "یک آن به ما گفتن که مولى الموحدین کار داره با شما صداتون زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 856.12,
   "end": 860.8,
   "text": "ما رفتیم محضر امیرالمؤمنین در آغوش امیرالمؤمنین محضر مولا بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 860.8,
   "end": 864.48,
   "text": "برگشتیم دیدیم تمام بدن‌ها و اشلاشو رو زمین ریخته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 864.48,
   "end": 869.64,
   "text": "این می‌شه وقتی کندی از تعلقات ببین به کجا می‌رسی و همه هم دوسش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 869.64,
   "end": 875.08,
   "text": "دشمنان براش با عظمت یاد می‌کنند از یادش رو یعنی با عظمت ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 875.08,
   "end": 880.9,
   "text": "ذکر می‌کنند. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 880.9,
   "end": 885.6,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}