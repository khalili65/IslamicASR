 },
 "chapters": [
  {
   "index": 0,
   "title": "## تبریک روز فرخندهٔ امام رضا علیه‌السلام",
   "start": 19.68,
   "end": 129.54
  },
  {
   "index": 1,
   "title": "## مراتب آتش از دنیا تا جدایی از آل‌الله",
   "start": 129.54,
   "end": 384.3
  },
  {
   "index": 2,
   "title": "## الکرة المبارکه و الکرة الخاسرة",
   "start": 384.3,
   "end": 449.4
  },
  {
   "index": 3,
   "title": "## دمیدن در آتش و درجات رنگ‌ها",
   "start": 449.4,
   "end": 589.8
  },
  {
   "index": 4,
   "title": "## تسلی نار حامیة؛ آتش جنگ با قائم",
   "start": 589.8,
   "end": 757.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 10.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.4,
   "end": 14.16,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.16,
   "end": 19.68,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.68,
   "end": 26.5,
   "text": "تبریک عرض می‌کنم این روز بسیار فرخنده و مبارک رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.5,
   "end": 30.62,
   "text": "ان‌شاءالله که همیشه با این خانواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.62,
   "end": 37.94,
   "text": "و با الاخص حضرت علی ابن موسی الرضا محشور باشیم دنیا و آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 37.94,
   "end": 41.64,
   "text": "که ولی نعمت ما ایشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.64,
   "end": 45.06,
   "text": "واقعاً جدایی از امام رئوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.06,
   "end": 47.14,
   "text": "مصداق جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.14,
   "end": 49.44,
   "text": "اصلاً جهنمی شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.44,
   "end": 54.48,
   "text": "به دوزخ رفتن یعنی جدایی از این خانواده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.48,
   "end": 59.88,
   "text": "اصلاً نار جایی‌ست که نور اون‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.88,
   "end": 63.16,
   "text": "البته کجا هست که نور اون‌ها نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.16,
   "end": 68.42,
   "text": "و اشرقت الأرض بنور ربها ای بنور امامه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.42,
   "end": 72.96,
   "text": "همه جا حتی در جهنم هم نور اون‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.96,
   "end": 77.96,
   "text": "پس چگونه است که نور اونجا ناره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.96,
   "end": 82.18,
   "text": "نـ– نار قبلاً عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.18,
   "end": 86.66,
   "text": "همان جنسش، اصلیتش، حقیقتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.66,
   "end": 90.28,
   "text": "موجودیتش همون نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.28,
   "end": 97.32,
   "text": "همون نوره اما بسته به ظرف وجودی هر کسی خودش رو چگونه نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.32,
   "end": 101.32,
   "text": "مثل قابض الارواح که یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.32,
   "end": 106.42,
   "text": "چون ما در آیینه وجود او خودمون رو منعکس می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.42,
   "end": 108.98,
   "text": "اگر زشتیم زشت می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.98,
   "end": 112.74,
   "text": "زیباییم زیبا می‌بینیم. خودمون رو، نه که اون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.74,
   "end": 116.74,
   "text": "این چنینه. پس جهنم هم به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.74,
   "end": 118.54,
   "text": "تجلی نور اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.54,
   "end": 125.0,
   "text": "اما نور ناری‌ست که جهنم تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.0,
   "end": 128.98,
   "text": "جلال اون‌هاست و بهشت هم تجلی جمال اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.98,
   "end": 132.14,
   "text": "این بحث‌ها بین ما گذشته. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.14,
   "end": 136.62,
   "text": "نار جایی‌ست که اون‌ها نیستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.62,
   "end": 141.02,
   "text": "تازه متوجه می‌شیم چرا اینقدر در ادعیه خصوصاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.02,
   "end": 144.18,
   "text": "زمان‌ها و مکان‌های خاص ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.18,
   "end": 150.96,
   "text": "تکرار می‌کنیم، التماس می‌کنیم، التجاگونه که ما را از نار نجات بده، از جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.96,
   "end": 157.54,
   "text": "و برای خودم بعضاً سؤال می‌شد خیلی وقت‌ها پیش از این که این مباحث رو پی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.54,
   "end": 161.86,
   "text": "خب شب قدر قرآن سر می‌گیری با اون همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.86,
   "end": 164.94,
   "text": "ریزش و نزول فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.94,
   "end": 173.3,
   "text": "خب این همه دعا یعنی واقعاً مهم‌تر از ان تجعلنی من اتقاءکم من النار نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.3,
   "end": 178.94,
   "text": "اگر بود می‌گفت بگو. دعای مجیر ایام البیض سه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.94,
   "end": 181.72,
   "text": "سیزدهم، چهاردهم، پانزدهم هر ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 181.72,
   "end": 184.72,
   "text": "وارده. نه فقط ماه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.72,
   "end": 187.16,
   "text": "مبارک رمضان. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.16,
   "end": 196.54,
   "text": "چند بار اونجا میگی؟ خلصنا من النار يا رب الغوث الغوث خلصنا من النار يا رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 196.54,
   "end": 200.32,
   "text": "خدایا ما را خلاص کن از نار، پروردگار من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.32,
   "end": 204.56,
   "text": "خب پیداست که قصه خیلی جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.56,
   "end": 211.1,
   "text": "نار، عرفا خلاصه‌ش اینه، عرفا گفتن نار جایی‌ست که حضرت زهرا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.1,
   "end": 214.0,
   "text": "نار جایی‌ست که امام رضا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.0,
   "end": 219.32,
   "text": "پس اگر اینه بهترین دعاست که خدایا ما را از نار خلاص کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 219.32,
   "end": 225.8,
   "text": "از آتش خلاص کن. اونجا وقتی جایگاه آل الله مشخص می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.8,
   "end": 230.8,
   "text": "اون موقع خدایا وقتی که متوجه می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.8,
   "end": 233.44,
   "text": "چه جایگاهی اون‌ها دارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 233.44,
   "end": 242.44,
   "text": "عزیزان خدا اون‌هایی که از خدا دلبری کردن، عاشقان و محبین این خانواده‌اند، بله، اون موقع يا ليتني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 242.44,
   "end": 249.52,
   "text": "كنت ترابا همه دعا می‌کنند ای کاش خاک بودند که ابو تراب پدرشون باشه علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 249.52,
   "end": 252.2,
   "text": "علیه الصلاة والسلام. اونجا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 252.2,
   "end": 258.14,
   "text": "کسی که این حقیقت رو در دنیا استیضاح نکرده، به این حقیقت نرسیده، دیگه آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 258.14,
   "end": 260.98,
   "text": "اونجا دیگه آتشه براش. سوختنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 260.98,
   "end": 264.8,
   "text": "سوزاندنه. خودش خودش رو سوزونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.8,
   "end": 269.46,
   "text": "خود کرده را تدبیر نیست. مثل این که لحظه‌ی موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 269.46,
   "end": 274.84,
   "text": "این تعلقات، جدا شدن از این تعلقات انسان رو می‌سوزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 274.84,
   "end": 279.7,
   "text": "طرف آتیش می‌گیره از این که داره از چیزایی که بهش علقه داشته جدا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 279.7,
   "end": 285.0,
   "text": "این یه نوع آتشه، یه مرتبه نازله آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.0,
   "end": 289.92,
   "text": "انزل مراتب آتش که همین آتشیش که آتشیش که در دنیا در دسترس ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 289.92,
   "end": 293.94,
   "text": "آتش. شعله‌ور می‌شه، می‌سوزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 293.94,
   "end": 298.18,
   "text": "جسم رو می‌سوزونه. یه رتبه بالاترش اون سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 298.18,
   "end": 303.66,
   "text": "هنگام موته که آدم به چیزهایی که دلبسته، به چی دلبسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.66,
   "end": 307.78,
   "text": "به هرچی دلبسته. با اون، اونو میخوان ازش بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 307.78,
   "end": 313.08,
   "text": "چون گفتیم موت کنده شدن از اضافاته، از اعتباراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 313.08,
   "end": 317.04,
   "text": "به یک معنا جدا شدن از هرچه غیر خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 317.04,
   "end": 320.7,
   "text": "اون سوختن داره. چیزایی که بهش دلبسته دارن ازش می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 320.7,
   "end": 326.9,
   "text": "سوختن داره. اینم یه معناست. ولی وقتی میری بالاتر دیگه اون اعلی مرتبه نار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 326.9,
   "end": 329.18,
   "text": "می‌شه چی؟ جدایی از آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 329.18,
   "end": 333.02,
   "text": "اونجا متوجه وقتی می‌شه که چه جایگاهی این‌ها دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 333.02,
   "end": 334.74,
   "text": "این می‌شه آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 334.74,
   "end": 339.24,
   "text": "آتش اصلی اینه. مگر آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 339.24,
   "end": 341.34,
   "text": "درجه داره؟ بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 341.34,
   "end": 344.58,
   "text": "فقط این نیستش که بهشت درجه داشته باشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 344.58,
   "end": 347.36,
   "text": "والذین عوت العلم درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 347.36,
   "end": 351.4,
   "text": "این درجات در بهشت هست، در جهنم هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 351.4,
   "end": 355.6,
   "text": "همونطور که الان عرض کردم. اتفاقا یه روایت خیلی شیرینی دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 355.6,
   "end": 359.6,
   "text": "البته ظاهر روایت ظاهراً تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 359.6,
   "end": 366.3,
   "text": "اما وقتی با توجه به این مباحث بهش دقت می‌کنی یه گره‌های کوی رو از ذهنت باز می‌کنه، می‌بینی شیرین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 366.3,
   "end": 368.44,
   "text": "ذیل آیه یازده سوره قارعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 368.44,
   "end": 371.64,
   "text": "اتفاقاً اونجا هم بحث ناره. نار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.64,
   "end": 374.72,
   "text": "حامیه. ناری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.72,
   "end": 378.52,
   "text": "سوزاننده است. الان ما کجاییم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 378.52,
   "end": 384.3,
   "text": "درسته روز میلاد بود و با امام رضا بحث رو شروع کردیم اما تو دل متن حدیثیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 384.3,
   "end": 386.94,
   "text": "در حدیث چهارم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 386.94,
   "end": 389.12,
   "text": "کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.12,
   "end": 395.24,
   "text": "می‌فرمود اون‌هایی که یعنی جا اب الموت به ما فیه، اون چیزی که در موت وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.24,
   "end": 399.64,
   "text": "بعد عرض کردیم نسبت به اعمال انسان‌ها موت‌ها متغیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 399.64,
   "end": 404.88,
   "text": "الکرة المبارکه برگشت به خود وقتی مبارکه که اینا میرن به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 404.88,
   "end": 407.48,
   "text": "الى جنة عالية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 407.48,
   "end": 411.02,
   "text": "جنة عالية اعلی درجات بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 411.02,
   "end": 413.64,
   "text": "کسی که مرگش، موت‌ش مبارکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.64,
   "end": 418.06,
   "text": "حالا وقتی که الکرة الخاسرة شد، برگشت به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.06,
   "end": 421.24,
   "text": "خسران زده شد. وقتی چشمش باز شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.24,
   "end": 425.46,
   "text": "و بصر کر یوم حدید چشمش تیز شد، حقایق رو فهمید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.46,
   "end": 431.98,
   "text": "جایگاه این آل الله رو متوجه شد، جایگاه امام رضا رو متوجه شد که دستش از دامن چه کسی کوتاه شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 431.98,
   "end": 433.86,
   "text": "می‌شه الى نار حامية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 433.86,
   "end": 437.42,
   "text": "این تو متن حدیثه. همین مد- حدیث که دستمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 437.42,
   "end": 439.62,
   "text": "به سوی آتشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 439.62,
   "end": 443.52,
   "text": "حامیه از حما یعنی شدیداً سوزاننده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 443.52,
   "end": 446.42,
   "text": "می‌سوزه. خودش خودش رو سوزونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 446.42,
   "end": 451.64,
   "text": "اون آتش هم از خودشه. حالا این نار حامیه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 451.64,
   "end": 454.72,
   "text": "سوره آیه یازده سوره غار آمده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.72,
   "end": 458.54,
   "text": "پیامبر در کتاب تفسیر اهل بیت می‌تونید این رو ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 458.54,
   "end": 461.02,
   "text": "این روایت رو. تفسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 461.02,
   "end": 463.9,
   "text": "که اونجا فرمودن حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.9,
   "end": 466.46,
   "text": "جلدهژده صفحه هفتاد و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.46,
   "end": 468.96,
   "text": "چند تا روایت ذیل این اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 468.96,
   "end": 474.32,
   "text": "یکیش پیغمبر فرمود که جبرائیل اومد غضبناک، خیلی ناراحت، ابوس پیش من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 474.32,
   "end": 477.08,
   "text": "سؤال کردم یا جبرائیل چرا هر وقت می‌اومدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 477.08,
   "end": 480.9,
   "text": "گشاده رو بودی امروز چرا انقدر غضبناکی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.9,
   "end": 484.36,
   "text": "عرض کرد که یا رسول الله به این جهت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.36,
   "end": 487.46,
   "text": "فوران آتش شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.46,
   "end": 491.0,
   "text": "چگونه شروع شد؟ حضرت جبرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.0,
   "end": 499.38,
   "text": "در جواب سؤال پیغمبر عرض کرد یا رسول الله خداوند هزار سال در آتش دمید سفید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.38,
   "end": 502.58,
   "text": "هزار بار دیگر دمید سرخ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.58,
   "end": 505.24,
   "text": "این نشون می‌ده درجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.24,
   "end": 510.98,
   "text": "هر کدوم از این رنگ‌ها مال یه آدمایی‌اند که رنگ‌هاشون مشخص می‌کنه کجا جاشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 510.98,
   "end": 513.06,
   "text": "آتش سفید برای یه عده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.06,
   "end": 517.32,
   "text": "آتش سرخ که دو هزار سال خدا درش دمیده برای یه عده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.32,
   "end": 520.22,
   "text": "و هزار سال دیگه دمید، سه هزار سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.22,
   "end": 522.32,
   "text": "حالا این سال‌ها باید تعبیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.32,
   "end": 524.9,
   "text": "یعنی چی؟ دمیدن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.9,
   "end": 527.22,
   "text": "این رنگ‌ها یعنی چی؟ الان جاش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.22,
   "end": 533.58,
   "text": "انشاالله باشه طلبتون. بار سوم که دمید سیاه شد، ظلمانی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 533.58,
   "end": 538.62,
   "text": "بعد فرمود از اون بوته و خار جهنم که اونجا آتش ازش فوران می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.62,
   "end": 543.76,
   "text": "اگر بیاد تو این دنیا و یک قطره‌ش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 543.76,
   "end": 550.8,
   "text": "شراب این دنیا یعنی آب این دنیا، این همه آب در این دنیا هست، اقیانوس‌ها این همه تلاطم دارن، یه قطره از اون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 550.8,
   "end": 554.5,
   "text": "اینجا بو تعفن دنیا رو برمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 554.5,
   "end": 557.24,
   "text": "حالا چه خبره اونجا؟ چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 557.24,
   "end": 562.56,
   "text": "چی اونجا آماده کردیم ما با اعمالمون که همش محصل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 562.56,
   "end": 568.52,
   "text": "اعمالمونه. یه روایت خیلی حالا شیرین‌تر از این باز ظاهرش تلخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 568.52,
   "end": 572.36,
   "text": "اما چون گره گشایی می‌کنه از افکار ما خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 572.36,
   "end": 574.86,
   "text": "ذیل آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 574.86,
   "end": 579.16,
   "text": "چهار سوره قاشیه. اونجا می‌فرماید تسلی نار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 579.16,
   "end": 583.24,
   "text": "حامیه. باز بحث نار حامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 583.24,
   "end": 586.26,
   "text": "اینا وارد می‌شن در آتشی به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 586.26,
   "end": 588.64,
   "text": "گدازنده و سوزاننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 588.64,
   "end": 592.38,
   "text": "اینجا در ذیل این آیه دیدم در تفسیر همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.38,
   "end": 596.06,
   "text": "مجلدی که عرض کردم تسلی انا پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.06,
   "end": 601.2,
   "text": "از قول امام صادق، امام صادق علیه السلام از قول پیغمبر تسلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 601.2,
   "end": 603.28,
   "text": "نار حامیه قال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 603.28,
   "end": 608.96,
   "text": "این چیه؟ می‌فرماید قال تسلی نار الحرب في الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.96,
   "end": 611.5,
   "text": "علی احد القائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.5,
   "end": 614.24,
   "text": "یعنی این برمی‌گرده این آتشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.24,
   "end": 617.74,
   "text": "اینجا فرموده تسلی نار حامیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.74,
   "end": 626.92,
   "text": "اون آتشی‌ست که ابتدا شروع شده در زمانی که امام عصر ظهور می‌کنه آتش جنگ با آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 626.92,
   "end": 629.82,
   "text": "یعنی ک-قیسه این آتش، آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 629.82,
   "end": 631.68,
   "text": "سوزاننده سیاه رنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 631.68,
   "end": 634.1,
   "text": "ببین رتبه‌ها داره مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.1,
   "end": 636.24,
   "text": "به شدت شکننده وحشتناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.24,
   "end": 640.86,
   "text": "مال کیاست؟ مال کساییه که در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 640.86,
   "end": 647.34,
   "text": "امام زمان ما حضرت ولی عصر آخرین یادگار حضرت زهرا می‌ایستند، با او می‌جنگند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 647.34,
   "end": 649.32,
   "text": "اینجا امام صادق داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 649.32,
   "end": 652.2,
   "text": "و في الآخرة نار جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 652.2,
   "end": 656.62,
   "text": "این آتشی که تو دنیا یعنی خودشون این آتش رو به پا کردن در برابر حجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 656.62,
   "end": 659.74,
   "text": "خدا، آخرین حجت خدا، اونور می‌شه نار جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 659.74,
   "end": 662.82,
   "text": "این نار حامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 662.82,
   "end": 666.44,
   "text": "که اونجا می‌گه چی؟ کسی که موت‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 666.44,
   "end": 669.7,
   "text": "الکرة الخاسرة است خسران زده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.7,
   "end": 671.76,
   "text": "الى نار حامية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.76,
   "end": 677.82,
   "text": "به سوی اون. پس کسی که در برابر امام عصرش قد علم می‌کنه جاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 677.82,
   "end": 680.52,
   "text": "تو چیه؟ نار حامیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.52,
   "end": 684.3,
   "text": "یعنی چه آتشی که به شدت سوزان-- یعنی از این دنیا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.3,
   "end": 688.34,
   "text": "خلاصه‌ش رو به شما عرض کنم که اون آتش از کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.34,
   "end": 692.68,
   "text": "از این دنیا میره. یعنی هرکس از این دنیا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 692.68,
   "end": 695.58,
   "text": "با رضایت خاطر امام عصرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.58,
   "end": 698.88,
   "text": "امام زمانش، امام رضا، خب دیگه آتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 698.88,
   "end": 700.48,
   "text": "الى جنة عالية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 700.48,
   "end": 706.56,
   "text": "اتفاقاً الان به ذهنم متبادر شد در انتهای زیارت جامعه یه عبارتی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 706.56,
   "end": 711.74,
   "text": "که يا ولي الله ان بيني و بين الله عز و جل ذنوبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 711.74,
   "end": 714.66,
   "text": "لا يعطيها الا رضاكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 714.66,
   "end": 720.9,
   "text": "درسته؟ فبحق من اتمنكم علی سره و ستركم و امر خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 720.9,
   "end": 725.34,
   "text": "حالا اینطوریه که ای ولی خدا به امام رضا عرض می‌کنه ای ولی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 725.34,
   "end": 727.1,
   "text": "بین من و خدای گناهانیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 727.1,
   "end": 730.56,
   "text": "تا شما راضی نشی اینا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.56,
   "end": 733.04,
   "text": "رضایت امام رضا می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 733.04,
   "end": 738.02,
   "text": "جنة عالية. خدا نکنه غضب امام رضا می‌شه نار حامية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 738.02,
   "end": 739.7,
   "text": "پناه می‌بریم به حضرت رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 739.7,
   "end": 745.36,
   "text": "انشاالله که حضرت دعا کنه امروز ما رو به زودی از زود زیارت حضرت نصیبمون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 745.36,
   "end": 748.52,
   "text": "نصر علی ابن موسی الرضا صلوات قشنگ خط کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.52,
   "end": 755.22,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 755.22,
   "end": 757.68,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}