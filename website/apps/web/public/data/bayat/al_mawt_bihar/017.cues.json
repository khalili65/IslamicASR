 },
 "chapters": [
  {
   "index": 0,
   "title": "## روح و نور؛ چرا هر دو در موت بازمی‌گردند",
   "start": 14.22,
   "end": 81.26
  },
  {
   "index": 1,
   "title": "## از انوار اهل‌بیت چه آفریده شد",
   "start": 81.26,
   "end": 247.84
  },
  {
   "index": 2,
   "title": "## بازگشت روح و نور به قدس اولی؛ طینت شیعه",
   "start": 247.84,
   "end": 465.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.74,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 9.88,
   "text": "محمد. بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.88,
   "end": 14.22,
   "text": "السلام علیک يا داعی الله و رباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.22,
   "end": 17.02,
   "text": "در ادامه نکاتی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.02,
   "end": 24.62,
   "text": "روایت دو، روایت چهارم از فصل اول کتاب الموت مرحوم مجلسی برداشت می‌کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.62,
   "end": 27.64,
   "text": "وعده داده بودیم که پیرامون روح و نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.64,
   "end": 31.58,
   "text": "صحبت کنیم به جهت اینکه در حقیقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.58,
   "end": 36.0,
   "text": "که اینجا حضرت داره تشریح می‌کنه که موت به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.0,
   "end": 40.46,
   "text": "می‌فرماید فردت. حالا این ردت رو جلسه پیش توضیح دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.46,
   "end": 44.64,
   "text": "که پیداست ما اونوری هستیم و دو مرتبه بر می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.64,
   "end": 46.94,
   "text": "چرا فردت روح و نور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.94,
   "end": 51.26,
   "text": "چرا فقط نگفته روح؟ چرا اضافه کرده نور رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.26,
   "end": 53.64,
   "text": "روح و نور بر می‌گردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.64,
   "end": 56.66,
   "text": "الى القدرة القدس الأولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.66,
   "end": 59.76,
   "text": "حالا این قدس اولی رو جلسه بعد صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.76,
   "end": 66.74,
   "text": "فرصت نمی‌شه الان تو این چند دقیقه کوتاه بگیم که چرا روح و نور اینجا بر می‌گردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.74,
   "end": 72.18,
   "text": "مگر ما یک روح، حالا اون چهار تا روحی که در ما هست و در اهل بیت پنج تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.18,
   "end": 78.5,
   "text": "در هر حال باید بگه ارواح بر می‌گردند نهایت یا بگه روح به صورت کلی بگه روح بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.5,
   "end": 82.88,
   "text": "چرا روح و نور؟ این بر می‌گرده به اصل خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.88,
   "end": 85.76,
   "text": "اصل خلقت ما از امتزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.76,
   "end": 88.92,
   "text": "روح و نور بوده. البته ابتدا نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.92,
   "end": 93.18,
   "text": "به چه شکلی؟ این روایت خیلی شیرینی‌ست از ابن عباس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.18,
   "end": 99.02,
   "text": "سؤال می‌کنه از نبی اکرم اسلام که شما چگونه خلق شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.02,
   "end": 101.3,
   "text": "و حضرت می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.3,
   "end": 105.12,
   "text": "ابتدا خدای منان، این روایت رو البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.12,
   "end": 110.2,
   "text": "در اصول کافی امام صادق صلوات الله علیه هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.2,
   "end": 111.88,
   "text": "ولی همه استناد می‌دن به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.88,
   "end": 114.16,
   "text": "به فرمایش رسول خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.16,
   "end": 116.4,
   "text": "خیلی شیرینه اینو بدونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.4,
   "end": 118.66,
   "text": "خدای منان اول تکلم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.66,
   "end": 121.38,
   "text": "اراده خلقت که می‌کنه تکلمی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.38,
   "end": 125.0,
   "text": "حالا این چه تکلم یعنی چی تو فلسفه و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.0,
   "end": 127.38,
   "text": "حرف‌های زیادی باید در رابطه باهاش زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.38,
   "end": 133.24,
   "text": "ولی ما هم قبلاً مطالبی رو پیرامون کلمه الله گفتیم و اثبات کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.24,
   "end": 138.88,
   "text": "همه ما کلمات الله هستیم و کلمه تامه‌ الهی حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.88,
   "end": 144.78,
   "text": "ک- تکلمی خدا می‌کنه از تکلم اولش نور رو خلق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.78,
   "end": 148.56,
   "text": "تکلم دوم روح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.56,
   "end": 151.14,
   "text": "بعد این دو رو با هم ممزوج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.14,
   "end": 153.0,
   "text": "امتزاج، مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.0,
   "end": 156.2,
   "text": "اصلاً عالم مزاج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.2,
   "end": 159.38,
   "text": "از امتزاج نور و روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.38,
   "end": 162.1,
   "text": "یک حقیقتی ایجاد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.1,
   "end": 165.28,
   "text": "که از اون حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.28,
   "end": 168.38,
   "text": "نور پیغمبر عزیز عالم خلق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.38,
   "end": 174.24,
   "text": "منشق می‌شه. از انشقاق نور پیغمبر مولامون علی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.24,
   "end": 176.76,
   "text": "اینجا دو دسته روایت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.76,
   "end": 185.28,
   "text": "بعضیا مثل مرحوم مجلسی در چهارده معصومشون می‌فرماین دو مرتبه خدا از نور ذات خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.28,
   "end": 187.88,
   "text": "نور حضرت زهرا سلام الله علیها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.88,
   "end": 191.86,
   "text": "انشا می‌کنه. بعضیا اکثراً گفتن نه از همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.86,
   "end": 195.24,
   "text": "از همین امتزاجی که نور پیغمبر و امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.24,
   "end": 200.64,
   "text": "منشق شدن از همین نور، نور فاطمه زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.64,
   "end": 205.22,
   "text": "منشق می‌شه. انشقاق در نور ایجاد می‌شه در این حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.22,
   "end": 210.06,
   "text": "اینکه میگه کلهم من نور واحد بر می‌گرده به این نور واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.06,
   "end": 215.38,
   "text": "و اینجا باز خیلی شیرین از نور امیرالمؤمنین ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.38,
   "end": 221.12,
   "text": "منشق می‌شه. از نور حضرت فاطمه زهرا، امام حسن مجتبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.12,
   "end": 227.5,
   "text": "لذا امام حسن فاطمی بود و البته ابا عبدالله صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.5,
   "end": 230.2,
   "text": "روایت می‌فرماید که علوی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.2,
   "end": 233.28,
   "text": "هیبت مولا علی صلوات الله علیه درش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.28,
   "end": 241.48,
   "text": "لذا فرمودن که وقتی که ابا عبدالله وارد می‌شد در حجره امام حسن صلوات الله علیه جلوی پای ایشون بلند می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.48,
   "end": 243.8,
   "text": "سؤال کردن آقا شما برادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.8,
   "end": 246.38,
   "text": "بزرگتری چرا جلوی برادر کوچک پا می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.38,
   "end": 250.6,
   "text": "می‌فرمود هیبت بابام علی در پیشانی حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.6,
   "end": 256.12,
   "text": "اینا همه رموزن. و همینطور خلقت خلاصه ادامه پیدا کرد تا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.12,
   "end": 260.22,
   "text": "پیغمبر فرمودن که از نور من عرش آفریده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.22,
   "end": 262.4,
   "text": "عرش هم باید تعویل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.4,
   "end": 266.44,
   "text": "به یک معنا قدرت حضرت حقه، به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.44,
   "end": 271.36,
   "text": "علم حضرت حقه و اینا. حالا از نور مولامون علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.36,
   "end": 276.08,
   "text": "ملائکه خلق شدن که روایت داریم بیشترین خلق خدا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.08,
   "end": 279.68,
   "text": "ذکر پرواز ملائک یا علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.68,
   "end": 282.36,
   "text": "جنس نور، نور مولا علی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.36,
   "end": 286.66,
   "text": "از نور حضرت زهرا سلام الله علیها چی خلق شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.66,
   "end": 289.44,
   "text": "آسمان و زمین. به به، به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.44,
   "end": 294.58,
   "text": "لذا کسی می‌خواد از زمین پل بزنه به آسمون، راهش حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.58,
   "end": 298.24,
   "text": "حالا از نور امام مجتبی چی خلق شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.24,
   "end": 302.12,
   "text": "فرمودن خورشید و ستارگان و کواکب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.12,
   "end": 305.1,
   "text": "سیارات و این افلاک و اینا همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.1,
   "end": 307.88,
   "text": "سبحان الله! چه خبره، چه عظمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.88,
   "end": 310.14,
   "text": "النور ابا عبدالله. به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.14,
   "end": 312.98,
   "text": "فرمود بهشت و حورالعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.98,
   "end": 314.74,
   "text": "لذا بهشت بوی حسین می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.74,
   "end": 317.42,
   "text": "اصلاً کسی وارد بهشت بشه میگه اع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.42,
   "end": 320.3,
   "text": "من اینجا قبلاً بودم. اینجا همون کربلائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.3,
   "end": 322.1,
   "text": "اصلاً کربلا همون بهشت بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.1,
   "end": 327.08,
   "text": "همون کربلائه. بوش بوی بهشت، بوی کربلائه، بوی کربلا، بوی بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.08,
   "end": 330.58,
   "text": "هر کی بره تو بهشت میگه اینجا کربلائه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.58,
   "end": 332.68,
   "text": "حورالعین جنسش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.68,
   "end": 335.74,
   "text": "نورش از حسینه صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.74,
   "end": 338.62,
   "text": "لذا کسی که حسینی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.62,
   "end": 342.16,
   "text": "اصلاً بهشتیه. کسی که بهس- بهشتی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.16,
   "end": 345.7,
   "text": "حسینیه. نمی‌شه کسی بهشتی بشه و حسینی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.7,
   "end": 350.88,
   "text": "چون از یک جنسن، یک سنخ‌ن، از یک نور واحدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.88,
   "end": 354.84,
   "text": "اصلاً کسی که به امام حسین رسید یعنی به بهشت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.84,
   "end": 358.16,
   "text": "لذا کسی که حسینی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.16,
   "end": 360.28,
   "text": "شوق به بهشت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.28,
   "end": 363.74,
   "text": "کسی که شوق به بهشت پیدا کرده قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.74,
   "end": 366.44,
   "text": "ریزه خور خوان سفره ابا عبدالله بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.44,
   "end": 368.04,
   "text": "اینا با هم ممزوج‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.04,
   "end": 370.12,
   "text": "حالا بحث ما الغرض چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.12,
   "end": 372.52,
   "text": "اینکه بگیم چرا فردت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.52,
   "end": 377.52,
   "text": "روح و نور الى القدس الأولى یا الى القدرة القدس الأولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.52,
   "end": 381.4,
   "text": "چرا روح و نور هر دو با هم بر می‌گردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.4,
   "end": 384.12,
   "text": "بر می‌گرده به اصل خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 384.12,
   "end": 388.18,
   "text": "که این دو یک حقیقت بودن با هم ممزوج شدن و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 388.18,
   "end": 392.08,
   "text": "امتزاج این‌ها اهل بیت و از اون‌ها خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 392.08,
   "end": 397.4,
   "text": "ما کجا قرار گرفتیم؟ فرمود همه اینا که خلق شدن از اضافه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.4,
   "end": 401.56,
   "text": "گل اون‌ها شیعیان ما، محبین ما خلق شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.56,
   "end": 405.06,
   "text": "یعنی دیگه اون صدرن، اون بالای بالان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 405.06,
   "end": 408.74,
   "text": "یعنی کأن همه دو مرتبه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 408.74,
   "end": 411.16,
   "text": "اضافه گل یعنی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.16,
   "end": 416.84,
   "text": "جایی که همه اهل بیت به اونجا برگشت می‌کنن از اون گل اضافه گل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.84,
   "end": 420.62,
   "text": "حالا این گل هم باید ازش رد شد، تعویل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 420.62,
   "end": 423.32,
   "text": "طینت اینجا یعنی چی؟ گل اینجا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 423.32,
   "end": 425.34,
   "text": "اون حقیقت کلیه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 425.34,
   "end": 427.38,
   "text": "که تو رو بکشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.38,
   "end": 430.0,
   "text": "حب مولا علی از وجودت بیرون نمی‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.0,
   "end": 436.12,
   "text": "چون طیبی، طیبی، پاکی و بر می‌گرده به پدر مادر و نطفهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 436.12,
   "end": 440.58,
   "text": "لذا امام صادق بهش گفت یکی آقا من دوستت دارم، فرمود پدر و مادرتو دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 440.58,
   "end": 443.44,
   "text": "هی گفت آقا من شما رو دوست دارم. فرمود من میگم پدر و مادرتو دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 443.44,
   "end": 445.64,
   "text": "هی اصرار حضرت فرمود دست نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 445.64,
   "end": 448.28,
   "text": "اگر پدر و مادرت ما رو دوست نداشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.28,
   "end": 453.9,
   "text": "شما هم دوست نداشتید که الطيبات للطيبين والخبيثات للخبيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.9,
   "end": 456.28,
   "text": "خبيث با خبيث جمع می‌شه، طيب با طيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 456.28,
   "end": 458.32,
   "text": "پدر و مادرتونو دعا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.32,
   "end": 459.92,
   "text": "نصابشون صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 459.92,
   "end": 465.68,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}