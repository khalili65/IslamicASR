 },
 "chapters": [
  {
   "index": 0,
   "title": "## صورة نور؛ شیشه و رنگ نطفه",
   "start": 135.2,
   "end": 222.46
  },
  {
   "index": 1,
   "title": "## صورة نار؛ غربال آخرالزمان",
   "start": 222.46,
   "end": 474.44
  },
  {
   "index": 2,
   "title": "## آموزش پس از مرگ؛ رزق شهدا معرفت است",
   "start": 474.44,
   "end": 494.56
  },
  {
   "index": 3,
   "title": "## حکایت جهانگیرخان و تار دل",
   "start": 494.56,
   "end": 836.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 4.54,
   "text": "و بهین استعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.54,
   "end": 13.3,
   "text": "و ربانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.3,
   "end": 19.36,
   "text": "یکی دیگه از نکات جالب توجهی که در متن روایت چهارم از باب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.36,
   "end": 23.7,
   "text": "کتاب الموت هست این هستش که اگر مبدأ حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.7,
   "end": 26.38,
   "text": "ما با توجه به متن حدیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.38,
   "end": 29.04,
   "text": "مبدأ حرکت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.04,
   "end": 35.52,
   "text": "نور بود، ما خودمون می‌شیم صورتی از نور و خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.52,
   "end": 37.98,
   "text": "اتحاد وجودی پیدا می‌کنیم و نور می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.98,
   "end": 46.0,
   "text": "از کجا میگی اینو؟ خود متن حدیث می‌فرماید که \"یبصر و يعمل بالنور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.0,
   "end": 50.04,
   "text": "اینو حضرت فرمودن. خب یه وجه ظاهرش این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.04,
   "end": 52.32,
   "text": "آنچه که ما عمل می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.32,
   "end": 57.34,
   "text": "و می‌بینیم با نور می‌بینیم، با نوره که اگر نور نباشه ما چگونه حرکت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.34,
   "end": 59.24,
   "text": "چگونه عمل کنیم؟ چگونه ببینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.24,
   "end": 61.8,
   "text": "این وجه ظاهرش بود که صحبت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.8,
   "end": 65.96,
   "text": "اما وجه باطنیش اینه که اصلا عمل بر اساس نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.96,
   "end": 69.46,
   "text": "دیدن، بصیرت، دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.46,
   "end": 76.3,
   "text": "بر اساس نوره. اگر کسی الله نور السماوات والارض دیروز هم عرض کردیم که ابوه نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.3,
   "end": 83.02,
   "text": "پدر این‌ها نوره. اگر کسی ببینه این نور رو و بر اساس اون حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.02,
   "end": 87.12,
   "text": "نوری بشه نه ناری، چنین کسی می‌شه مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.12,
   "end": 90.84,
   "text": "چیز عجیبی نیست. خود متن حدیث تصریح می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.84,
   "end": 94.1,
   "text": "\"یبصر و يعمل بالنور\" بعد می‌فرماید \"فهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.1,
   "end": 96.16,
   "text": "نور\". دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.16,
   "end": 99.16,
   "text": "\"فهو\". هو به کی بر می‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.16,
   "end": 101.86,
   "text": "همون کسی که داره عمل می‌کنه، می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.86,
   "end": 104.62,
   "text": "\"فهو نور\". خودش می‌شه نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.62,
   "end": 108.3,
   "text": "عجب! این اتحاد عملی، اتحاد عاقل به معقول دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.3,
   "end": 111.3,
   "text": "\"انه عمل غير صالح\" که به حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.3,
   "end": 115.78,
   "text": "گفتن پسرت عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.78,
   "end": 119.28,
   "text": "عمل غیر صالحه. نگفتن صاحب عمل غیر صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.28,
   "end": 124.12,
   "text": "اصلا عمل غیر صالحه. ما اتحاد وجودی پیدا می‌کنیم با اونچه که عمل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.12,
   "end": 127.42,
   "text": "حالا اگر، اگر بر اساس نور بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.42,
   "end": 131.7,
   "text": "می‌شیم مؤمن. بعد دوباره خیلی جالب اینو بخ-- نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.7,
   "end": 135.2,
   "text": "رد شم خیانته، بایستم فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.2,
   "end": 137.38,
   "text": "\"وحاله صورة نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.38,
   "end": 139.96,
   "text": "حالا اینجا دیگه صورت نور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.96,
   "end": 145.12,
   "text": "اینجا هم یه بحثی درشه که حالا یه وجهش اینه من عرض کنم برای اهل تأمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.12,
   "end": 147.72,
   "text": "که یعنی همه نور نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.72,
   "end": 152.46,
   "text": "صورتی از نوره. دقت بفرمایید حالا خورشید که می‌تابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.46,
   "end": 157.48,
   "text": "وقتی به این شبکه‌هایی دقت کردیم پنجره‌های قدیمی هر شبکه‌ش یه رنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.48,
   "end": 161.2,
   "text": "نسبت به اینکه این شیشه چه رنگی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.2,
   "end": 163.26,
   "text": "خورشید که به اون می‌تابه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.26,
   "end": 165.44,
   "text": "وجود واحده، یک نور واحده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.44,
   "end": 167.38,
   "text": "اما از اون طرف بازتابش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.38,
   "end": 171.46,
   "text": "نسبت به نوریه که یعنی رنگیه که این شیشه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.46,
   "end": 177.44,
   "text": "یعنی صورت نور. یعنی باز یه رنگ‌هایی در تو که از نطفه آغاز می‌شه این رنگ‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.44,
   "end": 181.0,
   "text": "بر اثر حالا اونچه که پدر مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.0,
   "end": 183.0,
   "text": "تغذیه کردن یا هرچی که بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.0,
   "end": 185.14,
   "text": "این‌ها، این رنگ در نطفه ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.14,
   "end": 191.5,
   "text": "بعد نور که میاد باز اگر من و تو نوری هم رفتار کنیم باز یه رنگ‌هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.5,
   "end": 197.08,
   "text": "اصطلاحاً در قالب علم اخلاق میگیمش، اِاِ-- جسارت می‌کنم، یه شیشه خرده‌هایی در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.08,
   "end": 199.42,
   "text": "باز همه نور ما نمی‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.42,
   "end": 202.08,
   "text": "صورت، صورت من نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.08,
   "end": 204.8,
   "text": "اینم خیلی نکته مهمیه که حالا گفتیم و رد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.8,
   "end": 213.36,
   "text": "\"وحاله صورة نور\". بعد اگر برعکس بشه کسی ناری رفتار کنه باز تو متن حدیثه، اینا از من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.36,
   "end": 217.38,
   "text": "\"و يأكل\" فرمود \"يأكل ويشرب بالنار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.38,
   "end": 221.44,
   "text": "اگر کسی بخوره و بیاشامه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.44,
   "end": 225.26,
   "text": "نار، با آتش که حالا وجه ظاهریش این بود که گفتیم اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.26,
   "end": 227.5,
   "text": "اون گرمای معده داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.5,
   "end": 232.88,
   "text": "خوراک رو هضم می‌کنه حتی در هضم‌های چهارگانه به نه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.88,
   "end": 235.94,
   "text": "به فرمایش ارسطو که قبلاً گفتیم همه با آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.94,
   "end": 238.14,
   "text": "اما وجه باطنیش یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.14,
   "end": 241.8,
   "text": "اگر چنانچه کسی در بدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.8,
   "end": 244.16,
   "text": "این نار غلبه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.16,
   "end": 246.58,
   "text": "می‌شه ناری، می‌شه کافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.58,
   "end": 249.68,
   "text": "حالا یعنی چی غلبه کنه؟ خود متن حدیث داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.68,
   "end": 252.58,
   "text": "چگونه است؟ \"يأكل ويشرب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.58,
   "end": 255.8,
   "text": "ببینید \"يأكل ويشرب بالنار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.8,
   "end": 262.42,
   "text": "یعنی چی؟ یعنی همش اهل خوردن و خوابیدن بشه اصطلاحاً در علم اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.42,
   "end": 268.74,
   "text": "یک معجونی بحث امروز ما از مسئله حکمت و عرفان به علاوه اخلاق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.74,
   "end": 270.86,
   "text": "یعنی اینکه ما داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.86,
   "end": 274.62,
   "text": "پشت پرده موت رو می‌سنجیم اما عجین می‌شه از این سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.62,
   "end": 281.3,
   "text": "حالا معنای فلسفی و عرفانی موت رو می‌سنجیم از این طرف خودش داره عجین می‌شه با مباحث اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.3,
   "end": 285.82,
   "text": "اگر چنانچه کسی به قول حضرت استاد علامه علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.82,
   "end": 289.8,
   "text": "بشه هم و غمش بشه پر کردن و خالی کردن شکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.8,
   "end": 293.94,
   "text": "چنین کسی ناریست. حالا خود متن حدیث معرفیش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.94,
   "end": 296.36,
   "text": "\"يأكل ويشرب بالنار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.36,
   "end": 298.94,
   "text": "حالا این بعد ادامه میده انتهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.94,
   "end": 302.72,
   "text": "حدیث. می‌فرماید \"فهو نار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.72,
   "end": 306.28,
   "text": "اگر کسی اینطوری رفتار کرد خود ناره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.28,
   "end": 310.04,
   "text": "خودش می‌شه آتش. \"معید بن نکر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.04,
   "end": 313.96,
   "text": "اون بالا یه می‌فرمود \"فهو نور معید بالعقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.96,
   "end": 315.66,
   "text": "عاقلانه زندگی می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.66,
   "end": 325.26,
   "text": "عاقلانه می‌بینه، عاقلانه می‌شنوه، عاقلانه لمس می‌کنه، عاقلانه می‌بویه، عاقلانه تخیل می‌کنه، عاقلانه توهم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.26,
   "end": 329.48,
   "text": "همش بر اساس عقله. اما کافر چی که ناری زندگی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.48,
   "end": 333.0,
   "text": "فرمود \"فهو نار معید بن نکر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.0,
   "end": 338.12,
   "text": "یعنی همش همه چیزش بر اساس یک سردرگمیه، حیرتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.12,
   "end": 341.32,
   "text": "و خودشم نمی‌فهمه چیکار داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.32,
   "end": 346.9,
   "text": "زشته، کرihe، بدمنظره، ناشناسه، اصلا شناخته شده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.9,
   "end": 352.42,
   "text": "مؤمن رو ملائکه میگن آخ خدا ما اینو تا صداش بلند می‌شه خدایا این صداش در درگاه تو آشناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.42,
   "end": 355.12,
   "text": "حدیث داریم. اما کافر نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.12,
   "end": 362.48,
   "text": "حالا یه تقی بتوقی بخوره در درگاه خدا بره انقدر صداش ناشناسه در درگاه خدا ملائکه میگن زود حاجتشو بده بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.48,
   "end": 366.2,
   "text": "بگو گمشو این اصلا صداش تا حالا شنیده نشده در درگاه تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.2,
   "end": 369.0,
   "text": "خدا بده بره. اینا همش حساب کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.0,
   "end": 371.0,
   "text": "بعد دو مرتبه می‌فرمود \"فهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.0,
   "end": 373.38,
   "text": "صورت نارن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.38,
   "end": 375.34,
   "text": "دو مرتبه حواستون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.34,
   "end": 378.64,
   "text": "این کافره، این مشرکه، این منافده، این آدم بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.64,
   "end": 381.0,
   "text": "اینم همه نار نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.0,
   "end": 385.78,
   "text": "تو کسی نیستی که بخوای خط‌کشی کنی بگی این صد در صد جهنمیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.78,
   "end": 389.08,
   "text": "صورت ناره. احتمال داره از آتش بیاد بیرون یه روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.08,
   "end": 392.32,
   "text": "تو چه می‌دونی؟ همین‌ها یه دفعه می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.32,
   "end": 394.84,
   "text": "چنان انقلابی درشون ایجاد می‌شه ما زیاد دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.84,
   "end": 397.7,
   "text": "بالعکسشم دیدیم. الان اصلاً داره اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.7,
   "end": 404.86,
   "text": "خیلی جالبه که بدانید امام صادق صلی الله علیه فرمودن آخرالزمان در زمان آخرین یادگار ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.86,
   "end": 407.2,
   "text": "زمان غربالگریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.2,
   "end": 409.3,
   "text": "اصلاً زمان غربال ما اون موقع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.3,
   "end": 412.86,
   "text": "جاها عوض می‌شه. مولا علی می‌فرمود مثل نخودی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.86,
   "end": 417.26,
   "text": "نخود و لوبیا که تو آش زیر شعله پخ-- می‌پزه داره بالا پایین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.26,
   "end": 418.96,
   "text": "همین‌طوری جاها عوض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.96,
   "end": 421.62,
   "text": "طرف تا دیروز صف اول جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.62,
   "end": 427.3,
   "text": "جای می-- مهر رو پیشونیش یهو اونوری می‌شه از اون طرف بالعکس آدمای اون طری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.3,
   "end": 429.88,
   "text": "شما زیاد دیدید. ما هم زیاد داریم می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.88,
   "end": 432.26,
   "text": "عاقبت هممون رو خدا ختم به خیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.26,
   "end": 434.96,
   "text": "خیلی دوران عجیبیه. مال الانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.96,
   "end": 436.96,
   "text": "غربال الانه به خاطر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 436.96,
   "end": 439.5,
   "text": "چون داره اون اتفاق جهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.5,
   "end": 441.98,
   "text": "رخ میده که همه انبیا منتظرش بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 441.98,
   "end": 444.54,
   "text": "هر بی‌سر و پای اجازه نداره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.54,
   "end": 448.46,
   "text": "پر طاووس به خودش وصل کنه که همه کرکسی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.46,
   "end": 451.12,
   "text": "او طاووس اهل جنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.12,
   "end": 453.32,
   "text": "المهدی طاووس اهل الجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.32,
   "end": 454.92,
   "text": "اون طاووس اهل بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.92,
   "end": 457.48,
   "text": "هرکسی رو راه نمیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 457.48,
   "end": 460.0,
   "text": "اون که پر کرکس داره که راه نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 460.0,
   "end": 462.4,
   "text": "خیلی باید مراقب، مراقب دلمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 462.4,
   "end": 467.56,
   "text": "حالا تا اینجای که رسیدیم بحث اگرچه اِاِاِ نیمه کاره می‌مونه این بحث هم مهمی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.56,
   "end": 471.5,
   "text": "فردا رو که ازمون نگرفتن. نشد برزخ رو که ازمون نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 471.5,
   "end": 473.74,
   "text": "اونجا هم قراره دور هم جمع شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 473.74,
   "end": 478.86,
   "text": "اونجا ما اهل ایمان ایشالله عاقبت به خیرشن دور هم جمع میشیم می‌گیم آخ، اوخ، اوخ اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 478.86,
   "end": 482.1,
   "text": "اونورم ما رو ول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 482.1,
   "end": 484.58,
   "text": "اونورم با ما کار دارن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 484.58,
   "end": 486.38,
   "text": "اونجا هم باید ما رو تحمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 486.38,
   "end": 488.88,
   "text": "حدیثه. امام صادق فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 488.88,
   "end": 494.56,
   "text": "محبین ما اولین کاری که خدا باهاشون می‌کنه یه ملکی رو مامور می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.56,
   "end": 499.86,
   "text": "حالا اون م-ملکه قطعاً آخونده، یه عمامه‌ای به سرشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 499.86,
   "end": 503.48,
   "text": ". میان اون احکام و حالا د--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.48,
   "end": 508.66,
   "text": "فرموده قرآن، اون درون مایه ای که از قرآن رو بهش نرسیدن رو آموزش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 508.66,
   "end": 512.6,
   "text": "حالا اونایی که اینجا خودشون ملک گونه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 512.6,
   "end": 515.52,
   "text": "و رفتار جبرائیلی داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 515.52,
   "end": 518.42,
   "text": "اونا چی می‌شه؟ خب خودش بلد بوده مثلاً ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 518.42,
   "end": 520.16,
   "text": "چی اینم همینجوری از بین میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 520.16,
   "end": 524.36,
   "text": "نه اونور آموزش هست چون همه به کنع قرآن که نرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 524.36,
   "end": 525.94,
   "text": "اما این می‌شه خودش استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 525.94,
   "end": 529.84,
   "text": "اوه، اوه، اوه. چشم ابلد اون طرف دوباره ما یه آخوندا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 529.84,
   "end": 533.6,
   "text": "اونا می‌شینن تدریس و اصلاً اونور عالم، عالم معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 533.6,
   "end": 535.98,
   "text": "حالا اون \"ان درک بهم یرزقون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 535.98,
   "end": 540.6,
   "text": "یادش بخیر فکر می‌کنم نوزده جلسه ما تو همون فصل اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 540.6,
   "end": 547.2,
   "text": "رساله سیر و سلوک سید بحر العلوم grupای جمعه داشتیم موندیم متأسفانه ایشالله توفیق شه ادامه‌ش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 547.2,
   "end": 554.1,
   "text": "اونجا رسیدیم که سید بحر العلوم بارها عرض کردیم اون رزقی که شهدا \"ان درک بهم یرزقون\" می‌خورن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 554.1,
   "end": 556.58,
   "text": "اون معرفته. رزق معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 556.58,
   "end": 559.04,
   "text": "دنبال حوری و قصر و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 559.04,
   "end": 562.36,
   "text": "نرو. سرت کلاه میره. آخرش می‌ذارنت تو سرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 562.36,
   "end": 564.68,
   "text": "می‌شняяت میگن بشین که برات کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 564.68,
   "end": 568.64,
   "text": "دوباره گیر گرفته رو هر طرف بری با آخوندا برخورد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 568.64,
   "end": 573.76,
   "text": "آخرش خدا عاقبت هممون رو به خیر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 573.76,
   "end": 576.02,
   "text": ". آره. حالا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 576.02,
   "end": 581.0,
   "text": "وقت زیاده، بله. حالا که کامتون شیرین شد، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 581.0,
   "end": 585.1,
   "text": "خاطره براتون بگم از دوران طلبگی‌مون تو اصفهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 585.1,
   "end": 588.54,
   "text": "یه دو سالی اونجا محضر حضرت آیت الله مظاهری بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 588.54,
   "end": 593.74,
   "text": "این رو عرض کنیم که بدونیم یعنی چی یهو دل عوض می‌شه اینا شاید دیده باشید، شنیده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 593.74,
   "end": 596.68,
   "text": "ما خیلی می‌رفتیم محضر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 596.68,
   "end": 600.42,
   "text": "یعنی می‌رفتیم کنار قبر حضرت جه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 600.42,
   "end": 602.82,
   "text": "حضرت حالا بعضیا گفتن علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 602.82,
   "end": 609.5,
   "text": "آیت الله جهانگیر خان قشقایی بزرگ از ایل قشقایی از اهل سم-سمیرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 609.5,
   "end": 612.26,
   "text": "اصفهان بودن ایشون. اِمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 612.26,
   "end": 616.74,
   "text": "شاگردان بزرگی رو تربیت کردن مثل آقای بوجردی مثل مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 616.74,
   "end": 621.0,
   "text": "حاج رحیم ارباب که مردم اصفهان خیلی بهش مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.0,
   "end": 627.24,
   "text": "میرزا قومی بزرگ تو قم که نذر و نیاز می‌کنن حاجت می‌گیرن اصفهانی‌ها به حاج میرزا رحیم ارباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 627.24,
   "end": 632.6,
   "text": "ایشون هم یه بزرگی بود. بسیار آدما رو تربیت کرد و اصلاً هم لباس آخوندی نپوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.6,
   "end": 636.78,
   "text": "فقط یه عبا مینداخت. در صورتی که م-- برای خودش یه عالمی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 636.78,
   "end": 639.24,
   "text": "خب اینا شاگرداش بودن. بسیاری از بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 639.24,
   "end": 641.3,
   "text": "حالا ایشون کی بود؟ تار می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 641.3,
   "end": 645.4,
   "text": "باورتون می‌شه؟ الان به من و شما بگن فلانی تار می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.4,
   "end": 647.68,
   "text": "اوه، اوه، اوه این دیگه ته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 647.68,
   "end": 650.26,
   "text": "جهنمه. تار می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 650.26,
   "end": 654.48,
   "text": "اصلاً فلان. در صورتی که ایشون تار می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 654.48,
   "end": 656.88,
   "text": "تا کی؟ بیست سالگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 656.88,
   "end": 659.26,
   "text": "بیست و مثلاً بیست و پنج سالگی سی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 659.26,
   "end": 663.92,
   "text": "مثلاً جوونی، جوونی که تا چهل سالگی تار می‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 663.92,
   "end": 666.5,
   "text": "باورتون می‌شه این عالمه بود. من هر روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 666.5,
   "end": 672.72,
   "text": "هر هفته می‌رفتم سر قبر ایشون و توسل می‌کردم که ما هم می‌شه مثل شما بشیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 672.72,
   "end": 674.4,
   "text": "حالا ما یه لات نظام آباد بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 674.4,
   "end": 676.36,
   "text": "شما برای خود تارزن بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 676.36,
   "end": 679.68,
   "text": "شبیه هم بودیم. بعضیا خوششون میاد این حرفو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 679.68,
   "end": 684.18,
   "text": "معلومه هم جنس ما. لات کدوم محله‌اید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 684.18,
   "end": 690.64,
   "text": "خلاصه- هرکی بگه یه جو محله‌ست شما نظام آبادید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 690.64,
   "end": 694.78,
   "text": ". آره این که مسلمه. اِاِاِ فردا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 694.78,
   "end": 699.4,
   "text": "پس فردا تولد حضرت امام حسن عسکریه ظاهراً یا جمعه اگه اشتباه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 699.4,
   "end": 702.06,
   "text": "حالا ما پیشواز رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 702.06,
   "end": 704.84,
   "text": "و خلاصه می‌رفتیم ازش خواهش کردیم دست ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 704.84,
   "end": 710.4,
   "text": "ایشون اومد خستتون نکنم، اومد اِاِاِ اصفهان تارش خراب شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 710.4,
   "end": 712.26,
   "text": "دنبال یه جا می‌گشت که تارشو درست کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 712.26,
   "end": 715.86,
   "text": "یه تار خیلی خوبی داشت. اِاِ بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 715.86,
   "end": 718.48,
   "text": "هی اینور اونور زد. یه پیرمردی دیده یه جا وایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 718.48,
   "end": 720.36,
   "text": "بعضیا من دو تا نقل شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 720.36,
   "end": 727.82,
   "text": "یه جا گفتن یکی از علمای برجسته اون زمان رو بعضیا میگن یه پیرمردی ایستاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 727.82,
   "end": 730.58,
   "text": "گفت آقا شما این تارم خراب شده کجا ببرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 730.58,
   "end": 733.8,
   "text": "این پیرمردها گفت ببر فلان محله، اونجا تار رو درست می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.8,
   "end": 736.14,
   "text": "اما باز اینجا دو تا نقل من شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 736.14,
   "end": 739.2,
   "text": "دو تاشو به شما میگم صدق حرف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 739.2,
   "end": 744.24,
   "text": "بعضیا گفتن فرمود که تار دلت رو بنواز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 744.24,
   "end": 747.0,
   "text": "مراقب تار دلت باش نه این تار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 747.0,
   "end": 752.76,
   "text": "بعضیا گفتن نه مراقب باش اگه این تار ظاهری خراب شد دلت هم خراب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 752.76,
   "end": 756.22,
   "text": "مراقب تار دلت باش که اون خراب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 756.22,
   "end": 758.0,
   "text": "حالا هرچی گفته مضمون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 758.0,
   "end": 760.46,
   "text": "ایشون یهو منقلب می‌شه. پیداست که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 760.46,
   "end": 762.36,
   "text": "پیرمرد خیلی صاحب نفس بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 762.36,
   "end": 765.16,
   "text": "مثل من نبوده اینجا خودشو بکشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 765.16,
   "end": 768.58,
   "text": "به سر از من خبری نشه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 768.58,
   "end": 772.24,
   "text": "خیلی صاحب نفس بوده. گفت و گفت خلاصه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 772.24,
   "end": 774.2,
   "text": "یه جمله گفت و تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 774.2,
   "end": 778.12,
   "text": "ایشون رنگش پرید و گفت خب کجا تار دلو تعمیر می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 778.12,
   "end": 780.76,
   "text": "گفت اینا اینجا. یه مدرسه‌ای بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 780.76,
   "end": 787.7,
   "text": "ملا عبدالله، مدرسه ملا عبدالله اگه اشتباه نکنم تو اصفهان که دیگه الان ت-- خراب شده اون مدرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 787.7,
   "end": 791.4,
   "text": "خلاصه ایشون رو راهنمایی کرد رفت تو حوزه علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 791.4,
   "end": 795.8,
   "text": "چه سالی، چه سالی از عمرش، چهل سالگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 795.8,
   "end": 799.34,
   "text": "رفت تو حوزه علمیه. شد کسی که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 799.34,
   "end": 802.94,
   "text": "بزرگان اهل معرفت رو تر-تربیت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 802.94,
   "end": 809.52,
   "text": "حالا حواسمون جمع باشه تو این جوونا اینا پونزده سالشه حالا مثلاً رپ گوش میده نمی‌دونم تار می‌زنه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 809.52,
   "end": 812.96,
   "text": "اخ، تخ تو دیگه فلانی سریع مرزبندی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 812.96,
   "end": 818.06,
   "text": "اینا خیلی بده. دیگه بدتر از اون بین ما Hezbollahیا و هیئتی‌ها که هیئت اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 818.06,
   "end": 821.3,
   "text": "مسجد اون، اداره اون، حزب اون، گروه اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 821.3,
   "end": 823.5,
   "text": "حالا اینا دیگه خدا عاقبت هممون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 823.5,
   "end": 827.34,
   "text": "ختم به خیر کنه. به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 827.34,
   "end": 836.2,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}