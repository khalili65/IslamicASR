 ],
 "cues": [
  {
   "i": 0,
   "start": 1.3,
   "end": 4.54,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.54,
   "end": 6.66,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.66,
   "end": 11.6,
   "text": "محمد. بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 16.34,
   "text": "السلام علیک يا داعي الله و رباني يا آياته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.34,
   "end": 19.28,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.28,
   "end": 25.16,
   "text": "عزیزان می‌دونید که در تکبیرة الاحرام گفتن الله اکبر واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.16,
   "end": 31.02,
   "text": "دست بردن تا بناگوش واجب نیست، مستحبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.02,
   "end": 36.48,
   "text": "و همین که الله اکبر رو گفتید کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.48,
   "end": 40.98,
   "text": "در خصوص کتاب الموت ما رسیدیم به روایت ششم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.98,
   "end": 43.7,
   "text": "امروز روایت رو تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.7,
   "end": 46.9,
   "text": "باب چهارم روایت ششم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.9,
   "end": 54.56,
   "text": "سئل رسول الله صلى الله عليه و آله و سلم أي المؤمنين أكياس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.56,
   "end": 56.96,
   "text": "از حضرت سؤال شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.96,
   "end": 61.28,
   "text": "باهوش‌ترین، زیرک‌ترین، کییس‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.28,
   "end": 66.64,
   "text": "اهل ایمان کیه؟ أي المؤمنين أكياس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.64,
   "end": 71.9,
   "text": "خب هرکی این سؤال ازش بپرسن یه ترجمه‌ای برای خودش داره بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.9,
   "end": 75.76,
   "text": "یه نظری داره. صاحب نظران الا ماشاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.76,
   "end": 80.42,
   "text": "اما ببینیم فرمایش پیغمبر چیه که دنیای امروز آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.42,
   "end": 84.62,
   "text": "یه همچین فرمایشی رو در خودش حذف کرده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.62,
   "end": 88.38,
   "text": "قال پیغمبر فرمودن اكثرهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.38,
   "end": 93.38,
   "text": "نظر شما کیه؟ اون کسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.38,
   "end": 96.84,
   "text": "چی رو زیاد داره که از همه باهوش‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.84,
   "end": 99.4,
   "text": "الان میگیم که اون که نبض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.4,
   "end": 104.84,
   "text": "بالا و پایین شدن دلار و سکه و بورس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.84,
   "end": 107.18,
   "text": "اینا رو دستش داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.18,
   "end": 111.52,
   "text": "به هر حال چنان بازی میکنه تو بورس که بیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.52,
   "end": 113.96,
   "text": "مثلا یه خونه‌شو کرده ده تا خونه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.96,
   "end": 117.98,
   "text": "این الان اینطوریه. طبق اون فرمایشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.98,
   "end": 121.64,
   "text": "فرمودن که وقتی امام صادق علیه السلام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.64,
   "end": 126.44,
   "text": "وقتی سر دنیا میره اونایی که تو دنیا میگن چی جا گذاشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.44,
   "end": 134.62,
   "text": "چی از خودش جا گذاشته. اما اونایی که اون ورن یعنی ملائکه، اون ور میگن که چی با خودش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.62,
   "end": 140.28,
   "text": "اینجا هرکی پولش بیشتره، شهرتش بیشتره، مدیریتی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.28,
   "end": 144.94,
   "text": "معروف‌تره، مشهورتره و اینها نس-- اصل و نسبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.94,
   "end": 149.14,
   "text": "مدرک تحصیلیش آقای دکتر، آقای فلان، مهندس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.14,
   "end": 153.96,
   "text": "آقای حضرت آقای آیت الله فلان اینا بله اینجا یه اعتباری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.96,
   "end": 156.2,
   "text": "همه اعتباره تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.2,
   "end": 161.26,
   "text": "دیگه گذاشتن تو خاک ما رو اونجا نمی‌پرسن که مدرک تحصیلیت چیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.26,
   "end": 165.72,
   "text": "عنوانت چی بوده. مثلا آقا ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.72,
   "end": 168.48,
   "text": "آیت الله بوده مثلا آسون بهش بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.48,
   "end": 171.54,
   "text": "اتفاقا سخت‌ترم می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.54,
   "end": 174.22,
   "text": "آقا دکتر مهندس بوده بلده دیگه نپرسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.22,
   "end": 179.34,
   "text": "اتفاقا بیشتر اونجا سخت‌تر می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.34,
   "end": 181.26,
   "text": "اینجا یه قواعدی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.26,
   "end": 187.58,
   "text": "دنیاست. اکثرا هم متاسفانه پیگیر اون قواعد اعتباری‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.58,
   "end": 193.5,
   "text": "مثل اینکه اون اسکناسای زمان شاه وقتی انقلاب شد دیگه اعتبارش از بین رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.5,
   "end": 197.1,
   "text": "یعنی دیگه با خاک برابر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.1,
   "end": 199.72,
   "text": "اونجا هم اینطوری می‌شه. این اعتبارات از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.72,
   "end": 201.3,
   "text": "کی از همه باهوش‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.3,
   "end": 205.1,
   "text": "اونجا کی رو میگن این خیلی زیرک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.1,
   "end": 212.2,
   "text": "حضرت فرمود اكثرهم ذکرا للموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.2,
   "end": 216.74,
   "text": "اون که بیشتر از همه یاد موت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.74,
   "end": 223.14,
   "text": ". یعنی الان کسی زیاد یاد موت می‌کنه بهش میگن آدم افسرده‌ای بدبخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.14,
   "end": 230.14,
   "text": "اكثرهم ذكرا للموت و أشدّهم استعدادا له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.14,
   "end": 234.38,
   "text": "صرفا اینکه یاد موت می‌کنه و قبرستون میره نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.38,
   "end": 238.04,
   "text": "ما الان زیاد می‌بینیم که کنار قبرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.04,
   "end": 239.9,
   "text": "مثلا مراسمای تشییع هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.9,
   "end": 242.8,
   "text": "میره کسیو بخوان دفن کنن زیاد دیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.8,
   "end": 244.92,
   "text": "اونجا طرف حجابشو رعایت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.92,
   "end": 251.9,
   "text": "اونجا وایستاده داره غیبت می‌کنه. اونجا وایستاده داره معامله می‌کنه تو بورس با موبایل بغل قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.9,
   "end": 255.9,
   "text": "که یه روایت تکان‌دهنده‌ای هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.9,
   "end": 258.54,
   "text": "خیلی این روایت ترسناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.54,
   "end": 261.64,
   "text": "پیغمبر فرمود اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.64,
   "end": 267.32,
   "text": "چند جا حرف از دنیا بزنه، عبادت هفتاد ساله‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.32,
   "end": 270.32,
   "text": "حبط می‌شه. یکیش وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.32,
   "end": 273.3,
   "text": "کنار قبره، یکیش تو تشییه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.3,
   "end": 276.48,
   "text": "یکیش وقت اذان گفتنه، اذان دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.48,
   "end": 281.32,
   "text": "یکیش وقت اقامه‌ست، یکیش وقت قرائت قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.32,
   "end": 284.96,
   "text": "بعد اینکه میگه عبادت هفتاد ساله‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.96,
   "end": 290.08,
   "text": "نابود می‌شه نه یعنی که حالا مثلا خط می‌زنن روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.08,
   "end": 293.3,
   "text": "یعنی منظور اینه که اصلا این آقا عابد نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.3,
   "end": 296.42,
   "text": "اصلا عب-- فکر می‌کرده هفتاد سال عبادت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.42,
   "end": 300.9,
   "text": "تو اگر هفتاد سال عبادت می‌کردی واقعا عابد بودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.9,
   "end": 306.0,
   "text": "الان باید همه وجودت متمرکز این قبر باشه، این تشییع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.0,
   "end": 308.94,
   "text": "چنان بریزی به هم که نوبت تو هم می‌خواد برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.94,
   "end": 312.88,
   "text": "داره اذان میگه آماده معراج باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.88,
   "end": 315.1,
   "text": "آماده الصلاة معراج المؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.1,
   "end": 318.58,
   "text": "اصلا مگه می‌شه انسان وقت اذان گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.58,
   "end": 321.46,
   "text": "حرف از دنیا بزنه؟ یکیش تو مسجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.46,
   "end": 323.88,
   "text": "اصلا تو مسجد، تو مسجد نشستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.88,
   "end": 327.08,
   "text": "سرم که تو مسجد صرفه نشستن تو مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.08,
   "end": 332.1,
   "text": "حرف از دنیا بزنی. اینها عبادت هفت سال، هفتاد ساله رو می‌سوزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.1,
   "end": 337.54,
   "text": "یعنی اصلا این عبادتی نداشته که الان جرات می‌کنه در یه همچین مکان مقدسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.54,
   "end": 339.3,
   "text": "حرف از دنیا بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.3,
   "end": 343.02,
   "text": "چه برسه به اونکه بغل ضریح نشسته هروکر می‌خنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.02,
   "end": 348.08,
   "text": "ضریح دیگه اونجا که دیگه م-مسجدی بالاتر از اونجا ما نداریم که دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.08,
   "end": 352.42,
   "text": "بغل ضریح انسان کامل نشسته داره هروکر می‌خنده یا لنگشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.42,
   "end": 356.52,
   "text": "دراز کرده با رفیقاش اینا هژگویی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.52,
   "end": 360.84,
   "text": "اینا نشون میده که اصلا نفهمیده کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.84,
   "end": 363.8,
   "text": "پس این که می‌فرماید ذكرا للموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.8,
   "end": 369.94,
   "text": "زیاد اکثرهم ذکر الموت زیاد یاد مرگ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.94,
   "end": 374.32,
   "text": "زیاد یاد کردنی، زیاد تردد کردنی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.32,
   "end": 378.08,
   "text": "اهل قبر که چی بشه و أشدهم استعدادا له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.08,
   "end": 381.62,
   "text": "که باعث بشه مستعد بشه استعداداتش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.62,
   "end": 386.9,
   "text": "در مسیر که رسیدن به موت شکوفا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.9,
   "end": 389.28,
   "text": "یعنی همون موت قبل ان تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.28,
   "end": 396.7,
   "text": "آقا بالاخره یه راهی رو میخوای بری، یه جایی که تا حالا نرفتی میخوای بری از چهار نفر پرس‌وجو می‌کنی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.7,
   "end": 399.26,
   "text": "نقشه‌راهت رو بررسی می‌کنی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.26,
   "end": 405.12,
   "text": "میری تو مپ و نمی‌دونم این چیزا نشان و بلد و اینا رو بیای نگاه می‌کنی آقا از کجا باید برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.12,
   "end": 410.26,
   "text": "مسیر کدوم طرفه یا نه؟ موت قبل ان تموتو یعنی یه بار برو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.26,
   "end": 414.26,
   "text": "همینجا برو که بعد اونجا یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.26,
   "end": 418.22,
   "text": "فکشفنا انک-- فکشفنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.22,
   "end": 420.14,
   "text": "انک قطاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.14,
   "end": 424.52,
   "text": "اگر وقتی این قطاء پرده برداشته شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.52,
   "end": 428.92,
   "text": "وقتی کشف شد قطاء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.92,
   "end": 430.74,
   "text": "فکشفنا ان کل قطاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.74,
   "end": 434.66,
   "text": "اگه اشتباه نخونده باشم عبارت عربیشو چه اتفاقی میوفتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.66,
   "end": 438.48,
   "text": "فبصر الیوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.48,
   "end": 441.26,
   "text": "این چشمت چنان تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.26,
   "end": 447.16,
   "text": "چرا تیز می‌شه؟ چون ندیدی، نرفتی، نچشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.16,
   "end": 452.0,
   "text": "پس این‌ها نشون میده که اصلاً قاعده اون ور با این ور متفاوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.0,
   "end": 455.1,
   "text": "و ما باید برای اون ور خودمون رو بسازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.1,
   "end": 458.62,
   "text": "یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.62,
   "end": 460.6,
   "text": "چیزهایی که ما رو هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.6,
   "end": 464.56,
   "text": "دنیا فشل می‌کنه هم آخرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.56,
   "end": 470.72,
   "text": "گناهه. اصلاً آدم گناهکار نه تو دنیا سعادت می‌بینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.72,
   "end": 475.46,
   "text": "مزه شیرینی زندگی رو می‌چشه، نه اون طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.46,
   "end": 480.46,
   "text": "اینکه میگه اینا خیلی زیرکن بلکه زیرک‌ترینن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.46,
   "end": 482.7,
   "text": "موت باعث می‌شه که اینا گناه نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.7,
   "end": 486.66,
   "text": "به همین راحتی و گناه اینا به اینا آرامش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.66,
   "end": 489.82,
   "text": "حرص طمع‌شون رو می‌خشکونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.82,
   "end": 492.2,
   "text": "حرص و طمع‌شون رو برمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.2,
   "end": 499.4,
   "text": "یکی از بدترین بازار‌های دنیا الان بازار طمع و حرصه به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.4,
   "end": 503.24,
   "text": "شما تا حالا دیدید یه آدمی رو پل بره خونه بسازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.24,
   "end": 506.16,
   "text": "بهش نمیگید دیوانه. آخه پل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.16,
   "end": 512.06,
   "text": "محل خونه ساختنه. وقتی دقت می‌کنی به موضوع می‌بینی آقا کار، کار عاقلاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.06,
   "end": 515.78,
   "text": "اون کسی که خونه ساخته بی‌عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.78,
   "end": 518.2,
   "text": "فقط در حدی که کفایت عمرش رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.2,
   "end": 519.96,
   "text": "بعد هی میگه بچه‌هام ندارم، بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.96,
   "end": 522.44,
   "text": "هی حرص و جوش بچه‌هاشو می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 522.44,
   "end": 525.76,
   "text": "بارها گفتیم تو به پدر ماد-- تو به بچه‌هات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.76,
   "end": 528.72,
   "text": "به عنوان پدر، مادر مهربان‌تری یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.72,
   "end": 536.2,
   "text": "نمیگیم آینده‌نگری نکنیم اما نه اینکه حرص و طمع ورمون داره فقط کارمون بشه جمع کردن دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.2,
   "end": 540.04,
   "text": "ضمن اینکه حدیث، این احادیث به انسان آرامش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.04,
   "end": 548.64,
   "text": "احادیثی مثل موت که روایات و آیاتی مثل موت مثل اینکه الان داریم قرائت می‌کنیم روایت ششوم به انسان آرامش میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.64,
   "end": 552.54,
   "text": "که بالاخره راه رو، نقشه راه رو داره مشخص می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.54,
   "end": 556.2,
   "text": "که آدم آرامش می‌گیره که آخرش اونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.2,
   "end": 563.34,
   "text": "از این طرف هم یه سری احادیث مثل اینکه روزی‌ها تعیین شده‌ست آرامش به انسان نمیده به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.34,
   "end": 566.74,
   "text": "یا روزی‌ها تعیین شده‌ست چرا من باید حرص بزنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.74,
   "end": 569.5,
   "text": "چند تا آدم داریم به طمع اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.5,
   "end": 574.72,
   "text": "روزیشونو بیشتر کنن رفتن کار دوم، سوم، بعد با کله خوردن زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.72,
   "end": 577.42,
   "text": "چنان بدهکاری‌هایی بالا آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.42,
   "end": 582.68,
   "text": "آقا تا یه حد معقولی اسلام گفته هشت ساعت تلاش برای امرار معاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.68,
   "end": 585.36,
   "text": "بقیه‌شو بسپر به من خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.36,
   "end": 588.94,
   "text": "برکتش با منه. اون روایتی یادمون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.94,
   "end": 591.94,
   "text": "اینم تقدیم کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.94,
   "end": 594.7,
   "text": "روایت فصل الخطاب هممون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.7,
   "end": 597.52,
   "text": "که امیرالمؤمنین علیه‌السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.52,
   "end": 601.82,
   "text": "اسبشون رو کنار مسجد پارک، حالا به قول ما پارک کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 601.82,
   "end": 604.66,
   "text": "به قول ا-- اسب اون موقع الان می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.66,
   "end": 608.96,
   "text": "ماشین الان ما. فکر کن ماشینت رو یه جا پارک کردی، یه کارگر رو می‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.96,
   "end": 610.8,
   "text": "آقا مراقب ماشین من باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 610.8,
   "end": 619.1,
   "text": "آقا مرکبشو یه جا پارک کرد گفت آقای کارگر آقای فلان، آقای غلام بیا مراقب ماش-- این مثلاً مرکب من باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.1,
   "end": 624.04,
   "text": "بعد رفت آقا کارشو انجام داد مسجد نمازشو خوند برگشت دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.04,
   "end": 627.22,
   "text": "ااا نیست. آقا غلامه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.22,
   "end": 630.12,
   "text": "که هیچی، اون همایل روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 630.12,
   "end": 633.18,
   "text": "اسب آقا هم نیست. همایلی که تو گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.18,
   "end": 636.7,
   "text": "اسب می‌انداختن نیست. دزدیده برده با خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.7,
   "end": 642.0,
   "text": "یه بالاخره ساعتی گذشت آقا برخورد کرد به یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.0,
   "end": 643.96,
   "text": "آدمی دید داره همایل می‌فروشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 643.96,
   "end": 646.66,
   "text": "نگاه کرد دید همایل خودشه مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.66,
   "end": 651.32,
   "text": "گفت اینو از کجا آوردی؟ گفت یه جوونی تو بازار اومد اینو به ما فروخت به دو درهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 651.32,
   "end": 656.1,
   "text": "حضرت دو درهم رو داد بهش همایل خودشو خرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.1,
   "end": 658.18,
   "text": "حق به صاحبش برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.18,
   "end": 664.46,
   "text": "فرمود افسوس که من نیت کرده بودم تو دلم وقتی از مسجد اومدم بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.46,
   "end": 667.94,
   "text": "دو درهم به این غلام فقر کمک کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.94,
   "end": 672.96,
   "text": "اون عجله کرد همون دو درهم رزق خودشو حرام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.96,
   "end": 675.76,
   "text": "یعنی اگر این کارو نمی‌کرد باز اون دو درهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 675.76,
   "end": 678.42,
   "text": "از دست امیرالمؤمنین بهش می‌رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.42,
   "end": 680.74,
   "text": "این کجا تا اون دزدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 680.74,
   "end": 684.68,
   "text": "این چه برکتی داشت، اون چه فلاکت و نکبتی توش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.68,
   "end": 691.74,
   "text": "اینه، این حرص و طمع و عجول بودن ما تو رسیدن رزقمون می‌زنه همه چی رو خراب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 691.74,
   "end": 695.92,
   "text": "اینکه می‌فرماید بین الطلوعین کاری که با رزقتو می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.92,
   "end": 700.12,
   "text": "برتر است از اینکه صبح تا شب بدوی برای رزقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.12,
   "end": 701.98,
   "text": "نه اینکه ندوی و بشینی تو خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 701.98,
   "end": 704.52,
   "text": "می‌خواد بگه این برکت میده به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 704.52,
   "end": 710.44,
   "text": "یه دو دو تا چهارتایی تو زندگی یه روه-روش‌هایی اسلام داده که اینا برکت میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.44,
   "end": 716.42,
   "text": "یعنی یه کاری می‌کنه همه میگن آقا این خیلی پول در نمیاره اما خیلی زندگی قشنگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 716.42,
   "end": 723.5,
   "text": "از اون طرف، این طرف صد برابر این یکی داره در میاره همش بدبختی و بیچارگی و چه کنم، چه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.5,
   "end": 728.4,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 728.4,
   "end": 731.64,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 731.64,
   "end": 736.84,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}