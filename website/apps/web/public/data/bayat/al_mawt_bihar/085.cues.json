 },
 "chapters": [
  {
   "index": 0,
   "title": "## نتیجهٔ روایت پنجم؛ موت را پیش رو ببین",
   "start": 0.92,
   "end": 85.84
  },
  {
   "index": 1,
   "title": "## ولایت الله و ولایت شیطان؛ جدی‌گرفتن حضور",
   "start": 85.84,
   "end": 268.76
  },
  {
   "index": 2,
   "title": "## حیمان؛ غرق در قرب حق",
   "start": 268.76,
   "end": 295.44
  },
  {
   "index": 3,
   "title": "## بابافرج و بشر حافی؛ نمونه‌های حیمان",
   "start": 295.44,
   "end": 673.8
  },
  {
   "index": 4,
   "title": "## سعدی و نمک شعر؛ تمسخر ندانسته‌ها",
   "start": 673.8,
   "end": 831.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 7.82,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.82,
   "end": 11.78,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.78,
   "end": 16.7,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.7,
   "end": 22.4,
   "text": "روایت پنجم از باب چهارم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.4,
   "end": 25.66,
   "text": "بر اساس اون روایت به این نتیجه رسیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.66,
   "end": 37.9,
   "text": "نتیجه خیلی مهم، که ما هیچ چاره‌ای نداریم الا اینکه دائماً موت، اجل، مرگمون رو پیش روی خودمون ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 37.9,
   "end": 42.7,
   "text": "تا نریم تحت تصرف ولایت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 42.7,
   "end": 46.74,
   "text": "این از نتایج بسیار مهم، اساسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.74,
   "end": 50.26,
   "text": "و به دردبخور این روایت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.26,
   "end": 53.98,
   "text": "که حالا شما خودتون الان تصور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.98,
   "end": 57.5,
   "text": "میشه واقعاً انسان دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.5,
   "end": 59.66,
   "text": "موت رو رو در روی خودش ببینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.66,
   "end": 66.72,
   "text": "چون تو روایت میگه کسانی تحت تصرف ولایت شیطان قرار میگیرن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.72,
   "end": 73.24,
   "text": "بدبختن، آرزوها جلوی چشمشون رژه میره و موت رو پشت سر خودشون قرار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.24,
   "end": 78.22,
   "text": "یعنی توجه ندارن. یعنی داره تصریح میکنه اگر میخوای بدبخت نشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.22,
   "end": 84.82,
   "text": "آرزوها جلوی چشمت رژه نرن و تو رو غافل کنن و در نتیجه تحت ولایت شیطان نری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.82,
   "end": 89.02,
   "text": "موت رو دائم رو در روی خودت ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.02,
   "end": 94.58,
   "text": ". که متأسفانه الان این رو شما به هرکی بگی غالباً پس میزنن این فرمول رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.58,
   "end": 98.38,
   "text": "میگن آقا این حرفا چیه؟ چرا میخوای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.38,
   "end": 101.7,
   "text": "افسرده بشیم؟ پژمرده بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.7,
   "end": 107.52,
   "text": "یه مقدار از موت و مرگ و اینا تو تلویزیون زیاد گفته بشه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.52,
   "end": 109.92,
   "text": "تفحص شهدا، برگردوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.92,
   "end": 113.82,
   "text": "یه مشت استخون به قول بعضیا اینا، این صدای بعضی مردم در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.82,
   "end": 118.4,
   "text": "خیلی‌هام صداشون در میاد که آقا بچه‌هامون افسرده میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.4,
   "end": 120.28,
   "text": "یعنی این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.28,
   "end": 126.8,
   "text": "شما وقتی دقت میکنی حالا بحث ولایت شیطان و ولایت الله رو باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.8,
   "end": 130.74,
   "text": "نمیگم مفصل چون در حوصله این جلسه نیست اما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.74,
   "end": 133.6,
   "text": "نکاتی درباره‌ش بگیم انشاالله به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.6,
   "end": 137.3,
   "text": "چون تو متن روایت میگه ولایت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.3,
   "end": 140.42,
   "text": "و ما مدعی هستیم که ولایت الله و آل الله رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.42,
   "end": 146.92,
   "text": "در صورتی که بعد میبینی سرمون که به سنگ لحد خورد میفهمیم که نه تحت ولایت شیطان بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.92,
   "end": 151.64,
   "text": "چرا آقا؟ چون موت رو پشت سرمون قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.64,
   "end": 156.66,
   "text": "نتیجه این که موت رو پشت سرمون قرار دادیم از کجا حاصل شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.66,
   "end": 159.28,
   "text": "از نداشتن حضور و مراقبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.28,
   "end": 164.72,
   "text": "از نداشتن توجه به، به اینکه انسان در حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 164.72,
   "end": 170.72,
   "text": "یه عزیزی در محضر امام رئوف بود به ما پیامک داد سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.72,
   "end": 175.44,
   "text": "، که آره همین سحره گذشته که آقا ما اونجا یادتون و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.44,
   "end": 179.46,
   "text": "ما، میخواستم جوابشو بدم تعلل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 179.46,
   "end": 182.9,
   "text": "خواستم بگم که خوشحالم که در محضر امام رئوف هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.9,
   "end": 185.88,
   "text": "پیش خودم گفتم مگه تو نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.88,
   "end": 189.1,
   "text": "مگه تو خودت الان در محضر امام نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.1,
   "end": 192.28,
   "text": "چطور میخوای با اون همچین حرفی بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.28,
   "end": 197.46,
   "text": "به خدا. مگه ما الان در حضور نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.46,
   "end": 199.24,
   "text": "عالم محضر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.24,
   "end": 204.42,
   "text": "یعنی چی امام فرمود در محضر خدا معصیت نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.42,
   "end": 207.72,
   "text": "وقتی انسان نگاهش این شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.72,
   "end": 212.12,
   "text": "و جدی گرفت، فرق ما با اولیای خدا بارها عرض کردم چیه عزیزان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.12,
   "end": 214.3,
   "text": "یادتونه؟ بارها اینو عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.3,
   "end": 216.68,
   "text": "فرق ما اینه که ما جدی نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.68,
   "end": 221.74,
   "text": "اونا جدی گرفتن، باور کردن عقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.74,
   "end": 225.42,
   "text": "یعنی وقتی که یه روایت میشنون چشاشون چهار تا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.42,
   "end": 232.44,
   "text": "انگار یه چیز مثلاً آیات قرآن را حتی همین قل هو الله احد که یک عمر باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.44,
   "end": 237.0,
   "text": "عجین بوده تازه که دوباره که میخونه میبینه انگار چشاش چهار تا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.0,
   "end": 239.26,
   "text": "انگار یه چیز جدید داره میشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.26,
   "end": 245.58,
   "text": "چطور بعضیا بر بسم الله الرحمن الرحیم نوزده جلد تفسیر نوشتن به عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.58,
   "end": 248.46,
   "text": "آیات، حروف همین آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.46,
   "end": 252.3,
   "text": "از کجا اینا رو آوردن؟ از کجا ابن عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.3,
   "end": 255.96,
   "text": "نود و پنج جلد تفسیر بر قرآن گفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.96,
   "end": 261.32,
   "text": "الان به من گفتن آقا در رابطه همین آیه، همین آیه سوره حمد که هر روز داری میخونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.32,
   "end": 268.6,
   "text": "یه صفحه بنویس ببینم. اینا متوجه عالم بودن دائماً در حضور و مراقبه، در حیمان بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.6,
   "end": 271.06,
   "text": "اون ملائکه‌ای که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.06,
   "end": 277.98,
   "text": "یا به اخلاق الله، اخلاق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.98,
   "end": 282.56,
   "text": "همه اسماء اینا. حیمانین کیا بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.56,
   "end": 284.1,
   "text": "کسانی‌ان که اصلا خبر ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.1,
   "end": 292.06,
   "text": "ملائکه‌ای‌اند که انقدر غرق در حضرت حق‌اند، در مقام قرب‌اند و حیمانن، خبر از خلقت ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.06,
   "end": 295.4,
   "text": "اصلا خبر ندارن خدا خلق داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.4,
   "end": 298.78,
   "text": ". در صورتی که خودشون خلق‌اند .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.78,
   "end": 302.12,
   "text": "یعنی راه جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.12,
   "end": 307.14,
   "text": "اگر کسی، اگه پیغمبر فرمود رب زدنی فیک علما بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.14,
   "end": 309.56,
   "text": "یا رب زدنی علما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.56,
   "end": 313.2,
   "text": "بعد فرمود رب زدنی فیکه تحیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 313.2,
   "end": 316.2,
   "text": "همه عرفا فرمودن علمه که تحیر میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.2,
   "end": 318.84,
   "text": "دانستن پشت پرده‌هاست که تحیر میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.84,
   "end": 324.26,
   "text": "حیرت، حیمان. تا حالا شده انسان اینطوری بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.26,
   "end": 328.84,
   "text": "یعنی نماز حداقل آقا اینو که این توقع رو میشه از خودمون بب-داشته باشیم که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.84,
   "end": 332.28,
   "text": "نمازمون با حیمان و حیرت باشه حداقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.28,
   "end": 338.66,
   "text": "بیرون از این پیشکش. پیغمبر اصلا صورت نماز پیغمبر، آقا پیغمبر الگو ما هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.66,
   "end": 343.54,
   "text": "ولکن فی رسول الله اسوه حسنه مگه قرآن نفرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.54,
   "end": 346.82,
   "text": "چرا من سر خودم رو کلاه میذارم میگم اینا مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.82,
   "end": 352.7,
   "text": "استغفرالله افسانه است یا حالا اینو که ما نمیگیم میگیم مال مثلاً اون دونه درشتاست، مال چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.7,
   "end": 355.8,
   "text": "نه مال همه است. لکن برای همه شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.8,
   "end": 358.42,
   "text": "صورت نماز پیغمبر واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.42,
   "end": 362.24,
   "text": "عجیبه که پیغمبر اصلا انگار خواب نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.24,
   "end": 364.94,
   "text": "ببینید ما هممون متعارف می‌خوابیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.94,
   "end": 368.64,
   "text": "می‌خوابیم، ساعت هم کوک می‌کنیم، ده بارم زنگ می‌زنه، به به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.64,
   "end": 373.08,
   "text": "خفه‌اش می‌کنیم می‌خوابیم. این وضعیت ما نمازخون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 373.08,
   "end": 375.06,
   "text": "جسارت به شما نشه انشاالله شمایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.06,
   "end": 377.44,
   "text": "حالا دل خودمو دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.44,
   "end": 379.44,
   "text": "آقا پیغمبر اصلا خواب نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.44,
   "end": 381.56,
   "text": "یعنی صورت نمازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.56,
   "end": 385.48,
   "text": "میگن وقتی می‌خوابید مثل حیرت‌زده‌ها و خائفین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.48,
   "end": 387.08,
   "text": "می‌پرید از خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.08,
   "end": 389.66,
   "text": "حالا ما میگیم خواب. می‌رفت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.66,
   "end": 392.88,
   "text": "از حجره خارج می‌شد. آسمونو نگاه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.88,
   "end": 396.72,
   "text": "کسی جرات نداشت اون لحظه صورت پیغمبر نگاه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.72,
   "end": 399.14,
   "text": "و نگاه می‌کرد به آسمون که \"ربنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.14,
   "end": 401.72,
   "text": "ما خلقت هذا باطلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.72,
   "end": 403.76,
   "text": "تو به باطل خلق نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.76,
   "end": 407.48,
   "text": "\"سبحانک فاقنا عذاب النار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.48,
   "end": 411.24,
   "text": "بعد اشک می‌ریخت. دوباره می‌رفت دور کرد نماز شب می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.24,
   "end": 414.1,
   "text": "دوباره مثلاً به خیال ما می‌رفت می‌خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.1,
   "end": 421.52,
   "text": "دو مرتبه بعد لحظه. خدا رحمت کنه مرحوم سردار سلیمانی خودشون فرموده بودن سی و دو سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.52,
   "end": 428.02,
   "text": "حدوداً سی و دو سال این شکل سعی کرده بودم نماز شب بخونم و قضا هم نشده بود ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.02,
   "end": 431.9,
   "text": "یعنی یک بار پشت سر هم نمی‌خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.9,
   "end": 435.02,
   "text": "یکی از نزدیکان ایشون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.02,
   "end": 438.6,
   "text": "خب بالاخره باید تشبه بگیریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.6,
   "end": 442.66,
   "text": "حیمان پیغمبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.66,
   "end": 444.86,
   "text": "بالاخره بودن تو تاریخ بعضی از مشایخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.86,
   "end": 448.48,
   "text": "شما درس من نشونه میدم از خودم نیست این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.48,
   "end": 452.64,
   "text": "درس دویست و سی و پنج شرح فصوص علامه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.64,
   "end": 460.42,
   "text": "فصوص الحکم علامه. از خاطراتش از اساتیدش همین جا تو همین حیث که دارم حرف می‌زنم میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.42,
   "end": 462.64,
   "text": "مثلاً میگه می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.64,
   "end": 465.54,
   "text": "یکی از مشایخ بوده که شیخ عباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.54,
   "end": 470.22,
   "text": "تو رجالش کتاب رجالی‌ش اسم ایشون رو آورده از بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.22,
   "end": 475.18,
   "text": "فرمود ایشون از وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.18,
   "end": 482.0,
   "text": "خودش رو پیدا کرد و خدا رو شناخت هیچ‌وقت پاهاشو دراز نکرد و دو زانو خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.0,
   "end": 485.36,
   "text": "آخه شما اینا رو ببینید بالاخره یه ذره اینام به گوش ما بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.36,
   "end": 490.32,
   "text": "من نمیگم این کارو بکنین. یه ذره به گوش ما بخوره مثلاً بگیم بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.32,
   "end": 493.1,
   "text": "مثل اینکه خبرهایی هم هست و ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.1,
   "end": 499.88,
   "text": "بعد اتفاقاً استاد بابافرج رو حضرت علامه بابافرج رو مثال زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.88,
   "end": 504.34,
   "text": "این شعر رو گفتن ماره بابافرج و من نمی‌دونستم ماره بابافرجه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.34,
   "end": 508.32,
   "text": "فرج بابافرج تبریزی بزرگ یکی از عرفا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.32,
   "end": 510.36,
   "text": "فرج تا دید تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.36,
   "end": 512.2,
   "text": "که دیده بگشاده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.2,
   "end": 516.32,
   "text": "یعنی تا چشمش باز شده چشم او بر جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.32,
   "end": 522.66,
   "text": "افتاده است یا نیفتاده است؟ تا دیده بش-بگشاده است چشم او بر جهان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.66,
   "end": 526.0,
   "text": "آفرین. نیفتاده است. اصلاً دیگه جهان ندیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.0,
   "end": 527.92,
   "text": "هرچه دیده ظهور حق دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.92,
   "end": 532.38,
   "text": "این می‌شه حیمان. خداوکیلی ما اینطوری هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.38,
   "end": 539.38,
   "text": "بعد یه بش مثلاً اشتباهی میگیم بوش ما بوش ولی معروفه به بوش و بش درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.38,
   "end": 542.76,
   "text": "بشره حافی، حافی پا برهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.76,
   "end": 546.28,
   "text": "داستانشو دیگه می‌دونید. مسلم بن جعفر اومد دم در خونه‌شو زد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.28,
   "end": 548.6,
   "text": "حالا اه ساز و آواز و اینا تو خونه‌ش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.6,
   "end": 551.72,
   "text": "بعد ا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.72,
   "end": 553.58,
   "text": "غلامش اومد آشغال بذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.58,
   "end": 556.62,
   "text": "مسلم بن جعفر فرمود این بنده‌ست یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.62,
   "end": 561.56,
   "text": "قل چیز آزاده مولاس مثلاً آزاده یا بنده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.56,
   "end": 563.42,
   "text": "اون گفت نه بابا این برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.42,
   "end": 565.52,
   "text": "آزادیه. بنده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.52,
   "end": 567.66,
   "text": "خودش کلی بنده داره غلام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.66,
   "end": 570.46,
   "text": "فرمود همونه. همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.46,
   "end": 574.06,
   "text": "آزاد بنده اگر بود اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.06,
   "end": 576.2,
   "text": "عیاشی نمی‌کرد. همین. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.2,
   "end": 579.56,
   "text": "اومد بهش گفت چرا دیر اومدی؟ بش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.56,
   "end": 582.84,
   "text": "و غلامش. اونم گفت آره یه آقای نورانی دم در اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 582.84,
   "end": 588.42,
   "text": "نفس با واسطه‌ی امام زمانش گرفتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.42,
   "end": 590.92,
   "text": "پا برهنه دوید به سمت که گفت این کی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.92,
   "end": 592.58,
   "text": "رفت دنبال سر آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.58,
   "end": 595.22,
   "text": "دیگه بعد از اون که بعد که توبه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.22,
   "end": 597.7,
   "text": "تا آخر عمرش پا برهنه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.7,
   "end": 601.62,
   "text": "و می‌گفت عجیبه این جمله مال ایشونه اصلاً اختصاص ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.62,
   "end": 606.32,
   "text": "می‌فرمود می‌گفت آقا چرا پا برهنه ای تو کوچه بازار دیگه پابه کفش پات کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.32,
   "end": 612.66,
   "text": "شیشه میره تو پات تیغ میره. می‌گفت این زمین تخت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.66,
   "end": 614.86,
   "text": "رو تخت با کفش نمیرن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.86,
   "end": 616.48,
   "text": "تخت پادشاهی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.48,
   "end": 619.36,
   "text": "الله اکبر. حالا شما بیا اینو چیکار کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.36,
   "end": 628.4,
   "text": "تو بازار امروز بگو. تو متن کار و بحبوحه کار و پشت میز ریاست و اینا بیا اینو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.4,
   "end": 631.98,
   "text": "اصلاً خنده‌ش می‌گیره آدما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 631.98,
   "end": 637.5,
   "text": "من خودم به شخصه بگم چند بار امتحان کردم بدون اینکه دراز بکشم بخوابم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 637.5,
   "end": 639.64,
   "text": "اومدم ادای عرفا رو در بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 639.64,
   "end": 642.62,
   "text": "از پا درد و کمردرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.62,
   "end": 644.44,
   "text": "تا نماز صبح رو خوندیم ولا شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.44,
   "end": 646.42,
   "text": "گفتم اصلاً تعقیباتم ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.42,
   "end": 648.98,
   "text": "اصلاً شب تا صبح دو زانو نشستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 648.98,
   "end": 652.3,
   "text": "اصلاً ما این کاره نیستیم. باید بیاد باید اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.3,
   "end": 657.92,
   "text": "حالت به قول حضرت علامه حامل این معانی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.92,
   "end": 660.92,
   "text": "باید موت رو دائم رو در روی خودت ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.92,
   "end": 665.04,
   "text": "و الا بعد نمی‌چشی اینا رو که می‌شنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 665.04,
   "end": 667.2,
   "text": "العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.2,
   "end": 671.7,
   "text": "ان كذبوا بآيات الله. میگه این دروغ‌ها این چخام پخانا چیه اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 671.7,
   "end": 673.8,
   "text": "اینطوری می‌شه. به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.8,
   "end": 676.66,
   "text": "فاضل تونی فرمود که یکی اومد پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 676.66,
   "end": 679.68,
   "text": "سعدی. حالا بعضی از شعرها هم اینجا نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 679.68,
   "end": 681.58,
   "text": "اومده بود محضر سعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 681.58,
   "end": 685.2,
   "text": "سعدی شیرازی بزرگ. خود ایشون شعر می‌گفته این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 685.2,
   "end": 687.78,
   "text": "میاد پیش سعدی مثلاً آقا رو کنف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 687.78,
   "end": 691.1,
   "text": "سعدی شیرازی بزرگ عارفی بوده ایشون برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.1,
   "end": 694.48,
   "text": "بهش میگه آقا این حالا آ مرحوم سعدی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.48,
   "end": 697.04,
   "text": "غزل خیلی خوبی برای ایشون می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.04,
   "end": 701.72,
   "text": "و حالا یه قصیده ظاهراً. بعد این آقا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.72,
   "end": 704.18,
   "text": "شعر شما نمک نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.18,
   "end": 706.76,
   "text": "نمک نداشت. بعد سعدی می‌خنده میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 706.76,
   "end": 710.06,
   "text": "خب معلومه که نمک نداشت چون شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.06,
   "end": 713.42,
   "text": "شما شعرات کدو و چغندره باید بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.42,
   "end": 716.48,
   "text": "نمک بزنن. شعر ما شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.48,
   "end": 719.28,
   "text": "کسی که نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 719.28,
   "end": 723.04,
   "text": "نمی‌دونه این چیزا رو، نه چشیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.04,
   "end": 729.2,
   "text": "مسخره می‌کنه. در نتیجه از تمسخر و این چیزا ما نباید بهراسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 729.2,
   "end": 731.46,
   "text": "بترسیم بگیم آقا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 731.46,
   "end": 734.74,
   "text": "اگر بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.74,
   "end": 736.6,
   "text": "نمی‌دونم چی می‌شه، مسخره‌مون می‌کنن فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 736.6,
   "end": 740.54,
   "text": "نه باید گفت. باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 740.54,
   "end": 745.46,
   "text": "و من گاهی اوقات خیلی ق-- دلم می‌سوزه، جیگرم می‌سوزه برای رهبر عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 745.46,
   "end": 748.9,
   "text": "برای اینایی که منصب دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 748.9,
   "end": 751.78,
   "text": "جایگاه اجتماعی دارن، می‌خوان اونطوری زندگی بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 751.78,
   "end": 756.72,
   "text": "یعنی حیمان گرفته‌شون. ولی منصب اجتماعی نمی‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 756.72,
   "end": 759.78,
   "text": "نمی‌ذاره. مجبورن تو خلوت‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 759.78,
   "end": 766.02,
   "text": "بله بعضیا هم به تأیید سرشونو تکون میدن که الان اینجا نشستن نمی‌تونن حیمان، حیمانشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 766.02,
   "end": 769.04,
   "text": "بیرون بریزن. بله بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 769.04,
   "end": 774.66,
   "text": "فرق هست دیگه کسی که به قول استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 774.66,
   "end": 779.4,
   "text": "حسن زاده می‌فرمود که تا بلغت الحلقوم خورده بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 779.4,
   "end": 783.84,
   "text": "می‌خواد که بفهمه یعنی چی بعضیا دائم الصومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 783.84,
   "end": 787.64,
   "text": "نمی‌شه. مثلاً مرحوم علامه طباطبایی می‌فرمود اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 787.64,
   "end": 792.08,
   "text": "بگم انتهای بحث. می‌فرمود که کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 792.08,
   "end": 797.88,
   "text": "اومده بود و گفته بود حافظ شعرهاش به هم ربط نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 797.88,
   "end": 799.58,
   "text": "حافظ شناسی اینم کردید یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 799.58,
   "end": 802.64,
   "text": "مثلاً شعرهاش اصلاً همه دنبال همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 802.64,
   "end": 804.84,
   "text": "گفت اصلاً هیچ کدوم به هم ربطی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 804.84,
   "end": 812.96,
   "text": "جمله‌ی علامه رو ببینید. فرموده بود حافظ باید شد تا بفهمی ربط دارد یا ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 812.96,
   "end": 818.26,
   "text": "همینطوری دهنشو باز می‌کنه، چشاشو می‌بنده، اینو اونو تحلیل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 818.26,
   "end": 820.24,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.24,
   "end": 823.26,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 823.26,
   "end": 826.34,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 826.34,
   "end": 831.78,
   "text": "محمد و آل محمد. الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}