 "chapters": [
  {
   "index": 0,
   "title": "## روایت اول باب دوم؛ أرذل العمر",
   "start": 0.1,
   "end": 102.86
  },
  {
   "index": 1,
   "title": "## پاسخ به اشکال؛ استثناها و عمومیت",
   "start": 102.86,
   "end": 300.3
  },
  {
   "index": 2,
   "title": "## وجه باطنی کلال البصر",
   "start": 300.3,
   "end": 467.53
  },
  {
   "index": 3,
   "title": "## وجه باطنی انحناء الظهر و رقة القدم",
   "start": 467.53,
   "end": 773.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 4.28,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 7.4,
   "text": "صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.4,
   "end": 12.32,
   "text": "محمد بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.32,
   "end": 15.58,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.58,
   "end": 17.56,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.56,
   "end": 20.8,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.8,
   "end": 23.48,
   "text": "بحث ما رسید به روایت اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.48,
   "end": 26.3,
   "text": "از باب دوم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.3,
   "end": 32.74,
   "text": "گفتیم این روایت جای بحث داره، جای بررسی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.74,
   "end": 36.56,
   "text": "خب وقتی که ارزلال العمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.56,
   "end": 39.92,
   "text": "اهل بیت علیهم السلام به عنوان نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.92,
   "end": 43.44,
   "text": "فرارسیدن موت معرفی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.44,
   "end": 48.04,
   "text": "که دیگه آمادگی پیدا کنی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.04,
   "end": 52.3,
   "text": "ببخشید مالوندن دماغت به خاک قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.3,
   "end": 55.16,
   "text": "یه آماده باشی. این دیگه لطف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.16,
   "end": 61.48,
   "text": "ارزلال العمر. پست‌ترین حالت رو در انسان ایجاد می‌کنه، انسان برمی‌گرده به حالت بچگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.48,
   "end": 66.9,
   "text": "حالا سه تا نشانه‌ای که در این روایت اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.9,
   "end": 71.52,
   "text": "سباح غلام آزاد شده امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.52,
   "end": 74.92,
   "text": "از این حالت بیان کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.92,
   "end": 80.72,
   "text": "عرض کردیم که فرمود علامة الكبر ثلاث علامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.72,
   "end": 87.34,
   "text": "کبر سن، زیاد شدن سن و این حالت ارزلال العمر رو اینجا حضرت سه تا نشونه براش داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.34,
   "end": 92.5,
   "text": "کلال البصر گفتیم کم سو شدن چشم، سنگینی چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.5,
   "end": 98.58,
   "text": "و انحناء الظهر پشت منحنی می‌شه، پشت قوز پیدا می‌کنه، خمیدگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.58,
   "end": 102.48,
   "text": "و رقت القدم سست می‌شه قدمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.48,
   "end": 110.0,
   "text": "حالا پیش از اینکه ورود کنیم به اینکه یه وجه باطنی این ظاهر چی می‌تونه باشه، یه اشکالی رو جواب بدیم که یه عزیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.0,
   "end": 114.94,
   "text": "گفتن که آقا خب اگر این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.94,
   "end": 120.68,
   "text": "بعضیا می‌بینید بچه‌ان اصلا پیرم نشدن چشمشون کم سو می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.68,
   "end": 123.6,
   "text": "ها یا ضعف در قدم پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.6,
   "end": 127.74,
   "text": "بله امکانش هست اما این عمومی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.74,
   "end": 133.14,
   "text": "باز ایشون گفتن که ولی می‌بینیم بعضیا پیرن این حالت رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.14,
   "end": 135.94,
   "text": "می‌گیم که آقا جون اینو حواسمون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.94,
   "end": 140.92,
   "text": "خدای منان در همه چیز خداست و خدایی می‌کنه به قول حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.92,
   "end": 144.66,
   "text": "استثناء گذاشته. چگونه‌ست که خوردن خاک حرامه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.66,
   "end": 148.56,
   "text": "حرامه خوردن خاک. اما آیا خاک امام حسین هم حرامه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.56,
   "end": 151.04,
   "text": "بلکه مستحب مؤکده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.04,
   "end": 153.58,
   "text": "ببینید همه جا خدای استثنایی گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.58,
   "end": 156.6,
   "text": "خداست و خدایی می‌کنه به من و شما چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.6,
   "end": 159.4,
   "text": "ما چی می‌تونیم بگیم؟ اینجا هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.4,
   "end": 166.46,
   "text": "اینطور نیست که این نشونه‌ها اگر واقعاً تو کسی بود بگیم خب دیگه صد درصد اون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.46,
   "end": 169.1,
   "text": "سن، این سنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.1,
   "end": 175.52,
   "text": "مدنظر اهل بیته رسیده کما اینکه حالا احادیث بعدی رو انشالله برسیم می‌بینیم نسبت در مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.52,
   "end": 181.58,
   "text": "عدد کبر سن، عدد شروع ارزلال العمر هم اهل بیت چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.58,
   "end": 184.82,
   "text": "صحبت کردن. اینا باید جمع بشه با هم باید دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.82,
   "end": 188.26,
   "text": "همونطور که علامه طباطبایی علیه الرحمه فرمود آیات قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.26,
   "end": 190.98,
   "text": "باید همه رو کنار هم دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.98,
   "end": 193.7,
   "text": "روایات رو هم باید کنار هم بگذاری ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.7,
   "end": 197.94,
   "text": "یک نتیجه کلی بگیری. بله، کسی که به کبر سن رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.94,
   "end": 202.12,
   "text": "بالاخره میره به این سمت. یه حالت عمومیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.12,
   "end": 204.86,
   "text": "شاید نگیم صد درصد همه اینطوری می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.86,
   "end": 208.08,
   "text": "اما به این سمت میرن که چشمشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.08,
   "end": 210.04,
   "text": "سو چشمشون کم می‌شه بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.04,
   "end": 212.12,
   "text": "هست دیگه. بدن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.12,
   "end": 215.46,
   "text": "خلاصه‌ش اینه بدن ضعف پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.46,
   "end": 221.28,
   "text": "این صریح آیه قرآنه که شما رو از ضعف، ضعف کودکی به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.28,
   "end": 224.7,
   "text": "بلوغ می‌بریم، قوت جوانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.7,
   "end": 229.4,
   "text": "میانسالی اینا بعد دو مرتبه برمی‌گردید به حالت ضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.4,
   "end": 233.28,
   "text": "این صریح آیه قرآنه دیگه می‌خواد امام صادق صلی الله علیه اینو بفرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.28,
   "end": 238.14,
   "text": "آقا جان این ضعف‌هایی که الان تو وجودت ایجاد می‌شه آلارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.14,
   "end": 241.64,
   "text": "چیه؟ اقتربت الساعة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.64,
   "end": 244.08,
   "text": "ساعت قیامت، ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.08,
   "end": 251.72,
   "text": "قیامت صغرا حداقل نزدیک شده که برزخته حواست باشه این آلارم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.72,
   "end": 257.82,
   "text": "لذا معمولاً هم شما ببینید آدمایی که سنشون میره بالاتر معمولاً خشیت پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.82,
   "end": 260.6,
   "text": "جوونا خیلی-- بله حدیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.6,
   "end": 263.24,
   "text": "بهترین جوون اونیه که حالت پیری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.24,
   "end": 265.26,
   "text": "یعنی چی؟ یعنی تو جوونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.26,
   "end": 268.0,
   "text": "جوونی نمی‌کنه خشیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.0,
   "end": 273.12,
   "text": "اما حدیث هم داریم که خدای منان بسیاری از بلاها رو به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.12,
   "end": 275.62,
   "text": "محاسن سفید مردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.62,
   "end": 278.44,
   "text": "و موهای سفید زنان دفع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.44,
   "end": 280.64,
   "text": "چرا؟ چون اینا می‌افتند به حالت خشوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.64,
   "end": 285.32,
   "text": "اصلاً فلسفه‌ش، فلسفه رسیدن به این ارزلال العمر همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.32,
   "end": 287.58,
   "text": "خاشع بشه، افتاده حال بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.58,
   "end": 290.5,
   "text": "حالا این سه تا وجهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.5,
   "end": 292.96,
   "text": "وجود دارد. اما نکته بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.96,
   "end": 295.74,
   "text": "خب آیا ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.74,
   "end": 300.3,
   "text": "شما گفتید که یه زمانی اینجا حالا زیادم البته گفتیم که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.3,
   "end": 305.9,
   "text": "فرمایش اهل بیت هم مثل آیات قرآن هزاران بطن و عمق دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.9,
   "end": 309.44,
   "text": "بله همینطوره. حالا یه وجهش رو با همدیگه بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.44,
   "end": 313.46,
   "text": "می‌تونه یک وجهش این باشد که منظور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.46,
   "end": 316.5,
   "text": "نشانه کلال البصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.5,
   "end": 319.12,
   "text": "این چشمش سنگین می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.12,
   "end": 321.2,
   "text": "از ه وجه باطنی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.2,
   "end": 324.04,
   "text": "شما بفرمایید اجتهاد ذهنی بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.04,
   "end": 328.1,
   "text": "چی می‌تونه باشه به نظر شما؟ بگید چی به ذهنتون می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.1,
   "end": 333.62,
   "text": "چشمش سنگین می‌شه از حیث، حیث باطنی چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.62,
   "end": 336.86,
   "text": "جان؟ حالا فروتنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.86,
   "end": 341.04,
   "text": "نه، از حیث باطنی. آفرین، آفرین به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.04,
   "end": 343.52,
   "text": "یعنی چشمش دیگه هرجایی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.52,
   "end": 345.92,
   "text": "مثل جوونا نیست که هر طرف بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.92,
   "end": 348.02,
   "text": "ببینید یه وجه باطنی‌ش رو داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.02,
   "end": 350.54,
   "text": "ظاهری بله، کم سو شدن، سنگینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.54,
   "end": 354.0,
   "text": "اما باطنی‌ش چیه؟ ببینید شما وقتی یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.0,
   "end": 357.58,
   "text": "تلاش فکری و برهانی و عقلی می‌کنید، می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.58,
   "end": 364.03,
   "text": "خودتون هم می‌تونید پل بزنید از ظاهر به باطن روایات با کمک مبانی که بزرگان دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.03,
   "end": 368.69,
   "text": "برای ایشون فرمودن. یعنی چشمش سنگین می‌شه دیگه هر چیزی رو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 368.69,
   "end": 372.47,
   "text": "هی دور نمی‌زنه اینور اونور. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 372.47,
   "end": 379.27,
   "text": "که قرآن می‌فرماید \"يعلم خائنة الاعین\" خدا می‌داند خیانت چشم‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.27,
   "end": 381.49,
   "text": "امام صادق صلوات الله علیه فرمود نه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.49,
   "end": 386.99,
   "text": "زل زدنه ها، این خیانت چشم نه اینکه مستقیم نگاه می‌کنه به گناه اینو نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.99,
   "end": 389.53,
   "text": "قرآن طبق تفاسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.53,
   "end": 394.07,
   "text": "از اهل بیت علیهم السلام مفسرین تراز اول شیعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.07,
   "end": 397.07,
   "text": "روایت آوردند که منظور گوشه‌ی نگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.07,
   "end": 400.91,
   "text": "بارها اینو عرض کردیم. زاویه‌ی نگاهت رو هم خدا می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.91,
   "end": 404.33,
   "text": "یعنی شما ظاهراً الان من دارم این مستقیم رو نگاه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.33,
   "end": 409.73,
   "text": "اما یه آقایی که الان جواب سؤال من داد این سمت چپ من نشسته رو دارم می‌بینمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.73,
   "end": 412.25,
   "text": "این زاویه‌ی نگاهه. به این میگن خیانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.25,
   "end": 415.99,
   "text": "نگاه. یعنی کسی که سنش رفت بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.99,
   "end": 419.39,
   "text": "خود به خود دیگه این حالت رو پیدا می‌کنه دیگه هرچ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.39,
   "end": 426.05,
   "text": "و عجیب اون حدیث که بارها گفتیم از معجزات قولیه‌ی امیرالمؤمنین همه روانشناسا الان باید بزنن کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.05,
   "end": 429.65,
   "text": "جلوی این فرمایش مولا که فرمود \"البصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.65,
   "end": 431.39,
   "text": "بريد القلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.39,
   "end": 433.85,
   "text": "یه جا فرمود \"بريد العقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.85,
   "end": 437.05,
   "text": "چشم بصر، چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.05,
   "end": 439.83,
   "text": "جاسوس عقله یا جاسوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.83,
   "end": 442.21,
   "text": "قلبه. ماموریتشو قلب می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.21,
   "end": 444.25,
   "text": "بخوای بدونی حال قلبت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.25,
   "end": 446.71,
   "text": "عقلت، تراز عقلت تا چه حده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.71,
   "end": 449.49,
   "text": "ببین چشمت به چه سمتی می‌دوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.49,
   "end": 452.59,
   "text": "به چه کو-- به چه جاهایی، از چی لذت می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.59,
   "end": 456.21,
   "text": "حال قلبت مشخص می‌شه. جاسوسه دیگه چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 456.21,
   "end": 457.91,
   "text": "کی ماموریت جاسوس رو میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.91,
   "end": 460.83,
   "text": "اون امیرش، امیر جا-- این بصر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.83,
   "end": 465.37,
   "text": "مولا فرمود عقل و قلبه. خب درونت داره میگه چشم من کجا رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.37,
   "end": 473.85,
   "text": "پس این‌ها مجموعاً در هر حال داره میگه آقا کسی که به حالت پیری افتاد دیگه نشونه‌ش نشون، دیگه می‌بینه موت نزدیکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 473.85,
   "end": 477.19,
   "text": "متأسفانه از حیثی و از حیثی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.19,
   "end": 481.25,
   "text": "خوشبختانه شما مساجد و اینا رو ببینید غالباً پیرمرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.25,
   "end": 484.85,
   "text": "و معذرت می‌خوام ظاهراً زوار در رفته و پیرزنی که دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.85,
   "end": 491.81,
   "text": "دیگه نمی‌تونه تو خونه بشینه میاد اینجا دور تا دورم صندلی چیدن و نشستن و برای خودشون بیتوته کردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.81,
   "end": 494.71,
   "text": "خب این خوبه. الحمدلله خداروشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.71,
   "end": 501.67,
   "text": "فرزندان همینا ان‌شاءالله نفس اینا می‌گیره،شون رشد اما اون کجا در جوانی پاک بودن شیوه‌ی پیامبری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.67,
   "end": 505.19,
   "text": "و نه هر گبری به پیری می‌شود پرهیزگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.19,
   "end": 508.43,
   "text": "باید به پیری که می‌رسی حالت خشوع پیدا کنی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.43,
   "end": 514.07,
   "text": "حالا متأسفانه در سیستم مدیریتی کشورمان دو تا خلل همیشه این خلل‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 514.07,
   "end": 518.79,
   "text": "یا همه رو جوون می‌کنن. یه پیر کارکشته‌ی کاربلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 518.79,
   "end": 525.49,
   "text": "که نگاه عمیق داشته و تجربیات به قول ما چند تا لباس همو پاره کرد، بیشتر پاره کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.49,
   "end": 528.29,
   "text": "بالا سرشون نیست. کارهای جوانی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.29,
   "end": 532.09,
   "text": "همینطوری چکشی، کی-- معذرت می‌خوام کیلویی همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.09,
   "end": 536.43,
   "text": "بدون هیچ تدبیر و پشتوانه‌ی فکری و عقلی و تجربه، تجربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.43,
   "end": 539.93,
   "text": "من به شما ثابت می‌کنم هفده جای قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.93,
   "end": 544.77,
   "text": "ثابت می‌کنه قرآن که تجربه بالاتر از علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.77,
   "end": 549.47,
   "text": "توجه کردین؟ این یه مشکل اصلیه تو مدیریت کشور ما هی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.47,
   "end": 551.83,
   "text": "هی می‌خواد بره به سمت جوون‌گرایی ولی این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.83,
   "end": 556.73,
   "text": "اینو توجه نداره که رهبر فرمود البته بعضیا کارکشته‌ان از اون‌ها باید استفاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.73,
   "end": 560.31,
   "text": "بعضیا رو باید نگه داشت. اینایی که پیر میدانن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.31,
   "end": 564.53,
   "text": "نگه داشت. از اون طرف هم افتادیم قبلاً همه پیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.53,
   "end": 566.37,
   "text": "مدیرای کشور اینا خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.37,
   "end": 569.47,
   "text": "دو تاش باید با هم یه عجب معجونی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.47,
   "end": 574.93,
   "text": "ممزوجی باشه. خب خسته‌تون نکنیم دو تای دیگه هم یه دو تا وجه بگیم هم شما می‌تونید بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 574.93,
   "end": 578.15,
   "text": "در خصوص انح-- \"انحناء الزهر\" چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 578.15,
   "end": 582.05,
   "text": "یعنی کمرش منحنی می‌شه. یعنی طاقت هر باری رو دیگه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 582.05,
   "end": 584.89,
   "text": "چه وجهی از باطنش می‌تونیم برداشت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.89,
   "end": 588.19,
   "text": "Gنا نمی‌کنه. یعنی سبک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 588.19,
   "end": 590.41,
   "text": "آفرین. سبک می‌کنه کوله‌بارش رو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.41,
   "end": 593.13,
   "text": "کوله‌بارش منحنی شده پشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 593.13,
   "end": 595.05,
   "text": "هر باری رو نمی‌تونه تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.05,
   "end": 597.73,
   "text": "سبک می‌کنه بارش رو. هر باری رو برنمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 597.73,
   "end": 599.75,
   "text": "به قول ایشون گناه نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 599.75,
   "end": 602.47,
   "text": "اینم یه وجه. حالا وجوه زیادی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 602.47,
   "end": 604.49,
   "text": "نه اینجا وقتش اقتضا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.49,
   "end": 606.77,
   "text": "نه شما حوصله‌شو دارید. بهش فکر کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 606.77,
   "end": 608.55,
   "text": "و آخریش \"رقة القدم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.55,
   "end": 614.45,
   "text": "چی بگیم مثلاً به نظر شما یه وجه باطنی، هزاران هزار وجه داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.45,
   "end": 617.39,
   "text": "ما یکیشو کشف می‌کنیم فک می‌کنیم اوه، اوه، اوه چه خبر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.39,
   "end": 619.99,
   "text": "ما رفتیم از ظاهر به باطن سفر کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.99,
   "end": 622.13,
   "text": "یکی از حقیقت‌های موت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.13,
   "end": 625.51,
   "text": "هزاران وجه داره. جابر جعفی گفت سی هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 625.51,
   "end": 627.99,
   "text": "تو یه روایت میگه هفتاد هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.99,
   "end": 631.61,
   "text": "سر. سر مگو امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.61,
   "end": 636.27,
   "text": "اونجا فرمود به مالک امیرالمؤمنین در خصوص جابر امام باقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 636.27,
   "end": 640.21,
   "text": "هفتاد هزار سر تو سینه ام جمع بود از حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.21,
   "end": 645.51,
   "text": "یه روز سنگین شد با آقا گفتم آقا سنگین شده یکیشو به یکی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.51,
   "end": 650.07,
   "text": "حضرت فرمود مطلقا. اگه قرار بود بگی که سر نبود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 650.07,
   "end": 652.79,
   "text": "قابل توجه ماها یه ذره کاسه‌مون لبریز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 652.79,
   "end": 656.15,
   "text": "بی ظرفیتیم میگیم خب حالا یک سری رو برای شما فاش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 656.15,
   "end": 660.11,
   "text": "اگه سره چرا فاش می‌کنی؟ والا بخدا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 660.11,
   "end": 662.59,
   "text": "مولا فرمود امام صادق هم همین رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.59,
   "end": 666.33,
   "text": "فرمود هروقت دلت تنگ شد بکن یه چاله‌ای درست کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.33,
   "end": 671.75,
   "text": "تو چاله با زمین حرف بزن که سر این در زمین حرف زدن هم ما قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 671.75,
   "end": 676.75,
   "text": "امثال شهید حججی و قاسم سلیمانی‌ها از نفس مولا به همین زمینه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.75,
   "end": 678.85,
   "text": "که در چاه درد دل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 678.85,
   "end": 684.35,
   "text": "اسرار رو گفت. از هم \"هو الذي انشأکم من الارض\" از همین ارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 684.35,
   "end": 688.45,
   "text": "شما رو انشا کردیم. یکیش می‌شه شهید حججی، یکیش می‌شه شهید سلیمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 688.45,
   "end": 690.69,
   "text": "شهید فخری‌زاده که فردا سالگرد شهادتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.69,
   "end": 692.29,
   "text": "اینا نفس مولا گرفتنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 692.29,
   "end": 695.99,
   "text": "نفس اسرار الهی که بزرگان در زمین زدن گرفتنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 695.99,
   "end": 698.75,
   "text": "اینم یه بحثیه که حالا بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 698.75,
   "end": 701.83,
   "text": "و \"رقة القدم\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 701.83,
   "end": 706.65,
   "text": "چی بگیم به نظرتون؟ قدم سست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 706.65,
   "end": 709.97,
   "text": "بگید. همه رو شما نگو دیگه حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 709.97,
   "end": 716.35,
   "text": "شاگرد زرنگمون نیست که شمایین. آقا یعنی هر جایی نمیره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 716.35,
   "end": 718.59,
   "text": "قدمش سست می‌شه یعنی دیگه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 718.59,
   "end": 723.37,
   "text": "این چون تابلو بود گفتیم یه چیز دیگه‌ رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 723.37,
   "end": 726.25,
   "text": "نه دیگه واقعاً به قول ایشون تابلوعه دیگه مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 726.25,
   "end": 728.81,
   "text": "پاهاش دیگه یاریش نمیده هر جایی ببرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 728.81,
   "end": 731.43,
   "text": "دیگه این پانکه از جهت قوای با-- ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 731.43,
   "end": 737.71,
   "text": "اونم هست. اما از جهت باطنی این پا دیگه پای جوون نیست هرزگی کنه هر جایی بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 737.71,
   "end": 741.57,
   "text": "این پاهاش دیگه هر جایی نمیره، هر جایی نمی‌برش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 741.57,
   "end": 744.27,
   "text": "اینا رو ببینید وجوه باطنش‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 744.27,
   "end": 750.31,
   "text": "یه سؤال می‌مونه فردا جواب بدیم که بالاخره امام صادق چشمش اون شکاف رو دید یا ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 750.31,
   "end": 753.31,
   "text": "چون تو روایت میگه من نمی‌بینم اون شکاف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 753.31,
   "end": 755.95,
   "text": "چه کنیم با این؟ با این اشکال چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 755.95,
   "end": 758.87,
   "text": "فردا از کتاب ه-- دو روزه میارمش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 758.87,
   "end": 762.61,
   "text": "از کتاب شیخ الرئیس، اشارات شیخ الرئیس جوابشو براتون میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 762.61,
   "end": 764.35,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 764.35,
   "end": 768.37,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 768.37,
   "end": 773.09,
   "text": "سلام بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}