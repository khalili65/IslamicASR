 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 4.24,
   "text": "چرا به ایشون؟ خب خودشه یه بحثه یعنی یه علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 8.28,
   "text": "یعنی اینکه انبیا چرا اسمشون اینچنین بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.28,
   "end": 11.18,
   "text": "چرا حضرت الیاس شده ادریس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.18,
   "end": 17.98,
   "text": "چرا مثلا حضرت یونس شده یونس که بر اساس این روایتی که قرائت کردیم از انس میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.98,
   "end": 21.02,
   "text": "خیلی انس با خدای منّان گرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.02,
   "end": 24.22,
   "text": "بزرگان فرمودن اگر کسی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.22,
   "end": 26.1,
   "text": "انیسش خدا باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.1,
   "end": 33.12,
   "text": "مونس و انیسش خدا باشه، این ذکر یونسیه رو درش سری هست زیاد بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.12,
   "end": 35.94,
   "text": "حالا البته در رابطه با آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.94,
   "end": 38.84,
   "text": "سوره یونس من ااا چون اون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.84,
   "end": 43.98,
   "text": "بیست جلسه‌ی پیرامون اوصاف و احراز و اینا گذشته خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.98,
   "end": 47.18,
   "text": "مطلبی نگم فقط کلیتی عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.18,
   "end": 50.32,
   "text": "مثلا در چند تا روایت خیلی شریف دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.32,
   "end": 53.28,
   "text": "خوبه اینو بدونیم همه ما از غفلت فرار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.28,
   "end": 55.22,
   "text": "متن آیه هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.22,
   "end": 58.54,
   "text": "سوره یونس هم که الان درش داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.54,
   "end": 63.68,
   "text": "بحث می‌کنیم بحث غفلته، غفلت از آیات الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.68,
   "end": 66.0,
   "text": "می‌فرمود که پیغمبر فرمود هر کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.0,
   "end": 69.74,
   "text": "دو یا سه ماه یک بار این سوره رو بخونه دیگه جزء غافلین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.74,
   "end": 73.2,
   "text": "قیامت‌ها تازه، قیامت هم تازه جزء غافلین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.2,
   "end": 76.78,
   "text": "چرا سه؟ اینجا و خدا به عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.78,
   "end": 82.54,
   "text": "اونایی که حضرت یونس رو تکذیب کردن بهش حسنه میده هر بار که این سوره رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.54,
   "end": 87.32,
   "text": "ولی دستور اولی هم پیغمبر فرمودن برای کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.32,
   "end": 94.14,
   "text": "مالش رو دزدی زده، چیزیشو دزدی برده از طریق این سوره میشه تشخیص داد دزد کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.14,
   "end": 98.74,
   "text": "که حالا اون بماند برای کسی خواست خصوصی خدمتشون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.74,
   "end": 102.3,
   "text": "خب بحث ما اینو ابتداً پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.3,
   "end": 107.04,
   "text": "جایگاه و عظمت سوره یونس و چرایی نام این بزرگوار گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.04,
   "end": 111.0,
   "text": "اما بریم تو بحثمون. بحث ما در خود آیه هفت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.0,
   "end": 119.28,
   "text": "که \"إن الذين لا يرجون لقاءنا ردوا بالحياة الدنيا وطمعوا بها والذين هم عن آياتنا غافلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.28,
   "end": 126.46,
   "text": "گفتیم که بحث لقای الهی با \"ردوا بالحياة الدنيا\" این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.46,
   "end": 130.1,
   "text": "دوگانه یعنی در حقیقت دو طرفه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.1,
   "end": 135.84,
   "text": "هرچی که لقای خدا، امید به لقای خدا بیشتر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.84,
   "end": 138.32,
   "text": "رضایت به حیات دنیا کمتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.32,
   "end": 142.2,
   "text": "هرچی که رضایت حیات دنیا بیشتر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.2,
   "end": 151.1,
   "text": "لقای خدا، امید به لقای خدا، باور داشتن ملاقات با خدا کمتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.1,
   "end": 159.24,
   "text": "و این در نهاد البته همه‌ی ما هست از بچگی \"فطرت الله التي فطر الناس عليها\" فطرت الوهی ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.24,
   "end": 162.22,
   "text": "الله فطرت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.22,
   "end": 164.72,
   "text": "یعنی فطرت الهی در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.72,
   "end": 167.74,
   "text": "لذا با یه تلنگر می‌بینی بیدار می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.74,
   "end": 174.96,
   "text": "منتها اون غفلته. بعدش می‌بینید انتهای آیه \"والذين هم عن آياتنا غافلون\" غفلت میاد سراغ ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.96,
   "end": 179.68,
   "text": "لذا چون ما وقتی به دنیا میایم به تدریج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.68,
   "end": 183.54,
   "text": "به تدریج به سن بلوغ می‌رسیم، یه دفعه که بالغ نمی‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.54,
   "end": 186.1,
   "text": "به تدریج از نفس به کمال میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.1,
   "end": 192.22,
   "text": "وقتی که به سن با-- بلوغ رسیدیم عقل‌مون یه مقدار خودش رو نشون داد، ظهور کرد نیاز به علم حصولی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.22,
   "end": 195.68,
   "text": "برای چی؟ علم حصولی ابتداً برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.68,
   "end": 199.08,
   "text": "تا اون علم کشفی و شهودی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.08,
   "end": 202.56,
   "text": "علم حضوری ایجاد بشه، اول علم حصولی نیاز داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.56,
   "end": 205.6,
   "text": "چرا؟ به خاطر این جرقه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.6,
   "end": 209.76,
   "text": "یه تلنگری باید انسان بخوره و الا این‌ها در نهاد وجود ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.76,
   "end": 212.16,
   "text": "اگر ما چند روز پیش عرض کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.16,
   "end": 214.92,
   "text": "یه چند تا مثلا بی‌حجاب همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.92,
   "end": 219.36,
   "text": "فقط بهشون گفتم که مرا-مراقب باشید که شما هم قراره یه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.36,
   "end": 222.72,
   "text": "خدای خودتون رو ملاقات کنید، آماده باشید برای اون روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.72,
   "end": 226.44,
   "text": "تمام. به قول رهبر سخنرانی هم نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.44,
   "end": 232.64,
   "text": "دیدم اصلاً اینا سرشون رو انداختن پایین به جای اینکه فحش و دری وری به ما بدن، اصلاً منقلب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.64,
   "end": 237.62,
   "text": "اون درونشون، درونیاتشون، فطرتشون یه دفعه خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.62,
   "end": 243.06,
   "text": "تلنگرها لذا با یه جمله، با یه کلمه، با یه نگاه می‌بینی ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.06,
   "end": 244.9,
   "text": "اصطلاحاً هم بهش می‌گن منزل یقظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.9,
   "end": 250.26,
   "text": "از صد منزل سیر و سلوک اولیش رو بسیاری از بزرگان یقوه نام گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.26,
   "end": 253.72,
   "text": "یعنی همین که بعضیا بهش گفتن انقطاع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.72,
   "end": 257.02,
   "text": "انقطاع یعنی منقطع بشی به یک آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.02,
   "end": 259.1,
   "text": "بیدار بشی و منقطع بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.1,
   "end": 261.64,
   "text": "وقتی این اتفاق افتاد حرکت ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.64,
   "end": 264.88,
   "text": "حرکت به سمت چی؟ به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.88,
   "end": 271.22,
   "text": "لقای خدا. یعنی و خیلی جالبه که شما بدونید وقتی اینجا در آیه بعد از \"لا يرجون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.22,
   "end": 275.52,
   "text": "لقاءنا\" می‌فرماید \"ردوا بالحياة الدنيا\" با واو عطف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.52,
   "end": 280.82,
   "text": "نشون میده که لقای خدا، لقای رب تو همین دنیا اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.82,
   "end": 284.18,
   "text": "چون \"ردوا بالحياة الدنيا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.18,
   "end": 289.32,
   "text": "نه حیات الآخره که. یعنی ملاقات با خدا تو همین جا می‌شه اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.32,
   "end": 292.84,
   "text": "چگونه است؟ بزرگان اهل معرفت فرمودن تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.84,
   "end": 295.58,
   "text": "اینو خوب توجه کنید خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.58,
   "end": 298.76,
   "text": "یعنی چی تشکیکیه؟ یعنی مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.76,
   "end": 302.5,
   "text": "یعنی اینکه هر مرتبه‌ای که مرحله به مرحله‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.5,
   "end": 308.28,
   "text": "هر مرتبه‌ای که شما چشمتو به گناه ببندی یعنی راضی نشی به حیات دنیایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.28,
   "end": 311.58,
   "text": "چشمتو به گناه ببندی یعنی راضی نیستی به این حیات دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.58,
   "end": 315.16,
   "text": "درست شد؟ به همون میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.16,
   "end": 317.58,
   "text": "لقای به رب در وجود تو گل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.58,
   "end": 320.84,
   "text": "یعنی امیدوار می‌شی به دیدار خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.84,
   "end": 323.72,
   "text": "باور می‌کنی به، به دیدار خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.72,
   "end": 329.58,
   "text": "و هر چقدر که تو بر اساس علم حصولی که ابتدا منقطعت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.58,
   "end": 334.64,
   "text": "لذا گفتن اول تخلیه یعنی همون انقطاع، یعنی یقوه، یعنی بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.64,
   "end": 337.8,
   "text": "تخلیه بعد تجلیه و تخلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.8,
   "end": 339.84,
   "text": "علمای علم اخلاق گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.84,
   "end": 343.34,
   "text": "اول یه جا-- کاسه رو تمیز کن بعد توش آب بریز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.34,
   "end": 349.54,
   "text": "اول خونه رو این آت و آشغال‌هاشو بریز بیرون تمیز کن، جارو کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.54,
   "end": 354.6,
   "text": "تو بحث نفث و رفث قبلاً ما صحبت کردیم که کدومش برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.6,
   "end": 357.48,
   "text": "یک وقت هست شما جارو می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.48,
   "end": 360.28,
   "text": "یا آشغال‌های درشتو می‌ریزی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.28,
   "end": 363.0,
   "text": "یک وقت هست نه، شما چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.0,
   "end": 368.54,
   "text": "می‌تکونی این فرش رو برمی‌داری با چوب می‌افتی به جونشون، غبارای توش هم در میاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.54,
   "end": 373.66,
   "text": "ما باید به اونجا برسیم. منتها این تشکیکیه یعنی قدم به قدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.66,
   "end": 378.3,
   "text": "یه قدم شما به سمت لقاء الله وقتی منقطع شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.3,
   "end": 381.44,
   "text": "برات ایجاد شد یعنی تخلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.44,
   "end": 387.46,
   "text": "یعنی آتش‌خانه رو ریختی بیرون. حالا وقت تجزی-- تجلیه است، جلا بدی، تحلیه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.46,
   "end": 390.4,
   "text": "حوله بپوشونی، لباس قشنگ تن کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.4,
   "end": 392.62,
   "text": "جلا بدی، زیباش کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.62,
   "end": 395.18,
   "text": "با اعمال صالح. اینا در هم تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.18,
   "end": 397.7,
   "text": "این خیلی مهم، مهمه که ما بدانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.7,
   "end": 401.42,
   "text": "یعنی منقطع شدی حالا وقت عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.42,
   "end": 409.66,
   "text": "اگر عمل کردی به سمت لقاء الله حرکت بکنی، توجه به لقاء داشته باشی نه فقط عمل توخالی و بدون تذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.66,
   "end": 413.38,
   "text": "بدون تأمل، بدون تعقل، بدون تفکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.38,
   "end": 420.04,
   "text": "لذا قلب عبارتی قرآن که بارها و بارها و بارها عرض کردیم و بسیار حضرت علامه حلی نیز روی آن تأکید داشتند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.04,
   "end": 423.02,
   "text": "يتلقف بود تلطیف سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.02,
   "end": 427.46,
   "text": "ایشون فرمودن ای تعقل، ای تأمل، ای تفکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.46,
   "end": 436.16,
   "text": "وقتی عملی می‌کنی با تأمل، با تفکر، در نماز تأمل، تفکر، حضور قلب باید باشه که اگر نباشد امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.16,
   "end": 440.88,
   "text": "امام اول و آخر همه ما فرمودن خیری درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.88,
   "end": 446.0,
   "text": "در نمازی که حضور قلب نیست خیری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.0,
   "end": 448.1,
   "text": "این یعنی چی؟ عمل مگه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.1,
   "end": 451.36,
   "text": "مگر صلاة نیست؟ مگر عینا عمل صالح نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.36,
   "end": 453.64,
   "text": "چرا بی خیره؟ چون تأمل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.64,
   "end": 461.44,
   "text": "چون حضور قلب نیست. چون اون امید به لقاء در توجه به لقاء خدا در ملاقات خدا داری میری از صلاة معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.44,
   "end": 463.46,
   "text": "معراج المؤمن داری میری معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.46,
   "end": 468.72,
   "text": "دیدار خدا. وقتی به این توجه نداری عمل صرفه و اون حجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.72,
   "end": 473.0,
   "text": "البته باز چون تشکیکیه هرچی شما مراحل لقاء خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.0,
   "end": 477.8,
   "text": "و ازت میره بالاتر و از-- به دنیا بی‌تفاوت‌تر می‌شوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.8,
   "end": 482.46,
   "text": "همون مقدار می‌بینی اون کارهایی که قبلاً بهش دل خوش کرده بودی اونا هم باز برات حجابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.46,
   "end": 487.58,
   "text": "اونا رو هم باید کنار بذاری. در کشف القمه فی معرفت الأئمه فرموده یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.58,
   "end": 490.82,
   "text": "روایته که حسنات الأبرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.82,
   "end": 495.82,
   "text": "سیئات المقربین. کسی که خیلی رفته بالا رو می‌بینی کارهای خوب أبرار هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.82,
   "end": 498.92,
   "text": "براش گناه حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.92,
   "end": 503.28,
   "text": "اینطوری نیست. یعنی ما یه زمانی نمی‌فهمیدیم حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.28,
   "end": 506.46,
   "text": "بیست و پنج سال پیش، الانم نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.46,
   "end": 512.6,
   "text": "من خودم رو به شما дозвоه. بیست و پنج سال پیش برادرزاده آقا که مدیر اجرایی هیئت ما بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.6,
   "end": 515.18,
   "text": "به ما گفت رهبر توی یه سوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.18,
   "end": 518.58,
   "text": "دلی، آه دلی اینا داشت در خصوص هیئت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.58,
   "end": 521.42,
   "text": "بهش گفتم چیه؟ ایشون فرمودن که ای کاش یه روزی می‌رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.42,
   "end": 522.82,
   "text": "حدود بیست و پنج سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.82,
   "end": 529.4,
   "text": "یه روزی می‌رسید اون موقع که ما خودمون می‌پریدیم بالا پایین، لخت می‌شدیم، سینه می‌زدیم تو هیئت‌ها خود بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.4,
   "end": 531.2,
   "text": "اون موقع از زبون ایشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.2,
   "end": 536.26,
   "text": "اون موقع آقا فرموده بود ای کاش یه روزی می‌رسید تو هیئتها لخت نمی‌شدن کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.26,
   "end": 542.54,
   "text": "یه سه دکمه‌ای، یه چیزی تو سینه‌شون بود، سینه باز می‌شد رو سینه عریانشون سینه می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.54,
   "end": 546.02,
   "text": "این-- خب اون موقع ما نمی‌فهمیدیم یعنی چی این حرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.02,
   "end": 550.02,
   "text": "خب بعد میری جلوتر می‌بینی ارتقای وجودی که پیدا می‌کنی می‌فهمی بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.02,
   "end": 554.38,
   "text": "حسنات الأبرار درسته بد نبوده ظاهراً خیلیا هم باهاش مقرب شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.38,
   "end": 558.42,
   "text": "نزدیک شدن. ولی وقتی مقرب شدن دیدن نه این کار بدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 558.42,
   "end": 562.18,
   "text": "تا یه مثال خیلی همه فهم و ساده عرض کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.18,
   "end": 570.1,
   "text": ". اگر این رو مورد توجه قرار نگیره عزیزان دلم پله پله، خطوات شیطان، خطوه خطوه، قدم به قدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 570.1,
   "end": 572.98,
   "text": "ما رو می‌بره سمت خودش. اول نمیگه بیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 572.98,
   "end": 578.74,
   "text": "مثلا مال، مال حرام ببر تو خونت، مال بیت المال ببر تو خونت نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 578.74,
   "end": 581.48,
   "text": "اول همین‌جوری نماز رو بهتون می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.48,
   "end": 583.92,
   "text": "یواش یواش بعد بی‌تفاوت به نمازت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.92,
   "end": 589.0,
   "text": "همین‌جوری رفته رفته دیدن اِ مال بیت المال رو خوردی آبم روش عین خیالت هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 589.0,
   "end": 591.96,
   "text": "قدم به قدم. همونطور عکسش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 591.96,
   "end": 595.44,
   "text": "م-مراتب لقاء الهی هم تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 595.44,
   "end": 599.34,
   "text": "یعنی قدم به قدم باید بری جلو حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 599.34,
   "end": 604.8,
   "text": "یعنی محاسبه داشته باشی، مراقبه داشته باشی، کشیک نفس بدی، مراقب خودت باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.8,
   "end": 608.2,
   "text": "اصلاً برنامه ما داریم هیئت‌هامون تشریفاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.2,
   "end": 610.24,
   "text": "البته حالا بریم یه هیئتی که رفته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 610.24,
   "end": 614.08,
   "text": "اشک ریختیم؟ ریختیم. نریختیم هم تماشاچی‌ایم بالاخره فرمودن ثواب میدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.08,
   "end": 617.96,
   "text": "بفرمایید ثواب بدید. این چه برنامه‌ایه برای بندگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.96,
   "end": 620.94,
   "text": "برنامه باید داشته باشی. هیئت رو باید انتخاب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 620.94,
   "end": 623.16,
   "text": "گوینده‌ش کیه؟ مداحش کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.16,
   "end": 626.16,
   "text": "و چه کسانی برگزار کننده هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.16,
   "end": 627.94,
   "text": "میزان خلوص این هیئت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.94,
   "end": 631.66,
   "text": "جزء برنامه‌هات باشه. چگونه کارت می‌زنی برای اداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 631.66,
   "end": 636.36,
   "text": "اگر یه ساعت دیر اومدی آنور یک ساعت بیشتر وایمیستی برای پول جیبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 636.36,
   "end": 638.78,
   "text": "برای برنامه آخرت اینطوری نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 638.78,
   "end": 640.68,
   "text": "حالا آخر ته دیگه هیئت می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 640.68,
   "end": 644.78,
   "text": "این چه برنامه بندگیه؟ این چه هیئت بازیه رخ داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.78,
   "end": 647.14,
   "text": "رشد کجاست؟ تعالی کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.14,
   "end": 650.14,
   "text": "لقاء خدا تو همین دنیا باید رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.14,
   "end": 653.58,
   "text": "ملاقات رب تو همین دنیا باید رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.58,
   "end": 655.74,
   "text": "این نکته آخر رو توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.74,
   "end": 662.12,
   "text": "به هر میزانی که ببین دقت کنید همونطور که رشد همچنین تشکیکیه و مراتب داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.12,
   "end": 666.3,
   "text": "از این طرف هم با هر گن-- هر گناهی که ما می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.3,
   "end": 670.72,
   "text": "هر گوشه‌ای که به گناه می‌سپریم، هر نگاهی که می‌ندازیم به گناه، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.72,
   "end": 676.86,
   "text": "زبانمون به غیبت، دروغ یا هرچی باز می‌شه، همون مقدار قرق الهی رو شکستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.86,
   "end": 681.48,
   "text": "قرق الهی رو شکستیم یعنی رضایت دادیم به حیات دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 681.48,
   "end": 684.18,
   "text": "چون این معصیته مربوط به دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 684.18,
   "end": 687.74,
   "text": "اونور که معصیت خبری نیست، اونجا جبروته بر محض فعلوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 687.74,
   "end": 691.54,
   "text": "جبر محضه. سلطنت الهی اونجا غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 691.54,
   "end": 694.3,
   "text": "اینجا یه مقدار به ما اختیار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.3,
   "end": 703.56,
   "text": "هر مقداری که گناه کنی، همون مقدار قرق شکستی و همون مقدار باور نسبت به لقاء خدا ازت اخذ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 703.56,
   "end": 706.02,
   "text": "این رفته رفته به کجا می‌کشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.02,
   "end": 711.26,
   "text": "انکار اولیاء خدا. والذین هم عن آیاتنا غافلون آخر آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.26,
   "end": 713.64,
   "text": "که گفتیم بزرگ‌ترین آیات الهی امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 713.64,
   "end": 718.82,
   "text": "جلوی امام عصرت وایمیسی. مثل ثمرت بن جندب که روایتش رو حتما شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 718.82,
   "end": 721.86,
   "text": "مرحوم کلینی بزرگ در کافی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 721.86,
   "end": 725.06,
   "text": "شنیدید من سریع بگم سی ثانیه‌ای رد شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 725.06,
   "end": 728.34,
   "text": "یه خونه، یه درختی داشت تو خونه یکی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 728.34,
   "end": 730.48,
   "text": "یه درخت خرما‌ای تو خونه یکی دیگه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 730.48,
   "end": 732.48,
   "text": "می‌رفت تو خونه اون بابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 732.48,
   "end": 735.7,
   "text": "راهشون مشترک بود. از درخت خرماش می‌چید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 735.7,
   "end": 738.62,
   "text": "اون طرف اومد به پیغمبر ج-- گلایه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 738.62,
   "end": 745.54,
   "text": "گفت آقا این آقا چ-حالا چه-چطوری بوده وضعیت، مالکیت به چه شکلی بوده، درختش تو خونه ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 745.54,
   "end": 750.14,
   "text": "راهمون مشترکه. میگم بابا لااقل می‌خوای بیای یا الله بگو زن و بچه من اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 750.14,
   "end": 754.42,
   "text": "میگه نه آخه این حرفا نیست. درخت منه خودت آماده باش هر وقت بخوام میام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 754.42,
   "end": 759.8,
   "text": "پیغمبر اومد بهش گفت آقا جون من یه-- فکر کن الان شما یه درخت داری پیغمبر می‌خواد با شما معامله کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 759.8,
   "end": 763.44,
   "text": "یه درخت به جز این بیرون از این باغ من به شما می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 763.44,
   "end": 765.18,
   "text": "اینو بده. نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.18,
   "end": 769.26,
   "text": "گفت ده تا ده-- پیغمبر خدا فکر کن الان امام عصر بیاد به من و شما بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 769.26,
   "end": 771.22,
   "text": "ده تا درخت بهت میدم جاهای خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.22,
   "end": 775.42,
   "text": "گفت نمی‌خوام. پیغمبر فرمود یه درخت خوب تو بهشت برات ضمانت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 775.42,
   "end": 780.94,
   "text": "گفت نمی‌خوام. گفت یه باغ درخت، یه باغ پر درخت تو بهشت من ضمانت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 780.94,
   "end": 783.54,
   "text": "گفت نمی‌خوام. گفت بزنید درخت رو ریشه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 783.54,
   "end": 787.16,
   "text": "اصلاً قاعده لا ضرر و لا ضرار فی الاسلام اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 787.16,
   "end": 790.08,
   "text": "ایجاد شد به این فرمایش پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 790.08,
   "end": 794.24,
   "text": "عزیزان دل یعنی رفته رفته قدم به قدم میری جلوی امام زمانت وایمیسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 794.24,
   "end": 797.66,
   "text": "چرا میگن اولین کسایی که امام زمان ظهور کنه اهل علمن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 797.66,
   "end": 801.54,
   "text": "اینو شنیده بودید؟ یعنی ما آخوندا اگر بگیم اهل علمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 801.54,
   "end": 804.62,
   "text": "دانشمندان، علما اینا وایمیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 804.62,
   "end": 808.48,
   "text": "خیلی خطرناکه قصه. باید مرا-مراقب خودمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 808.48,
   "end": 810.8,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 810.8,
   "end": 813.48,
   "text": "برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 813.48,
   "end": 822.1,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}