 ],
 "cues": [
  {
   "i": 0,
   "start": 1.08,
   "end": 4.52,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 7.3,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.3,
   "end": 10.02,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.02,
   "end": 14.24,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.24,
   "end": 16.88,
   "text": "در روایت شونزدهم باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.88,
   "end": 20.06,
   "text": "چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.06,
   "end": 22.72,
   "text": "روایت از این قرار بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.72,
   "end": 27.98,
   "text": "شخصی که پیغمبر عزیز عالم رفته بودن به عیادتشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.98,
   "end": 30.36,
   "text": "تمنای موت کرده بودن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.36,
   "end": 32.32,
   "text": "رسول خدا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 32.32,
   "end": 38.06,
   "text": "این کارو انجام نده. تمنای موت نکن که البته و هو شاکن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.06,
   "end": 42.7,
   "text": "شاکی بود و اینطور که از فحوای روایت برمی‌آد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.7,
   "end": 47.72,
   "text": "به جهت مریضی سختی که براش عارض شده بود تحمل نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.72,
   "end": 49.86,
   "text": "و این شکایت‌ها رو کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.86,
   "end": 53.84,
   "text": "پیغمبر فرمودند که لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.84,
   "end": 60.26,
   "text": "تتمني الموت. خیلی صریح فرمودند که موت رو تمنا نکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.26,
   "end": 62.76,
   "text": "بلکه بهتر اینکه فإنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.76,
   "end": 68.12,
   "text": "إن تك محسنا تزدد إحسانا إلى إحسانک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.12,
   "end": 71.16,
   "text": "اگه تو آدم محسن و نیکوکاری باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.16,
   "end": 74.54,
   "text": "سعی کن که احسانت رو بر احسانت زیاد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.54,
   "end": 78.92,
   "text": "این بهتر از موته دیگه. و إن كنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.92,
   "end": 82.4,
   "text": "مسيئا چون بعضیا شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.4,
   "end": 90.6,
   "text": "سریع حاضر جوابی کنن که نه ما گناهکاریم و هرچی زودتر بمیریم بهتر گناهمون کمتر و امثالهمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.6,
   "end": 93.06,
   "text": "یه عده دست بال اونارم بسته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.06,
   "end": 96.64,
   "text": "فرمودن فتأخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.64,
   "end": 100.24,
   "text": "یستعتب فلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.24,
   "end": 105.92,
   "text": "تمنّو الموت. میگه اگر چنانچه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.92,
   "end": 110.7,
   "text": "مسیء هم باشی، گناهکار هم باشی می‌تونی توبه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.7,
   "end": 113.84,
   "text": "عذرخواهی کنی، برگردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.84,
   "end": 118.5,
   "text": "و عتاب کنی خودتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.5,
   "end": 120.8,
   "text": "برای همین دو مرتبه این تکراره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.8,
   "end": 123.88,
   "text": "فلا تمنّو الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.88,
   "end": 128.36,
   "text": "دوباره تاکید می‌کنه پیغمبر که مبادا تقاضای مرگ کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.36,
   "end": 135.24,
   "text": "دو بار تاکید اومده. یه بار قبل از توضیح، یه بار بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.24,
   "end": 139.64,
   "text": "خب بخوایم رو سیاق روایت کار کنیم حرف زیاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.64,
   "end": 142.3,
   "text": "یکی اینکه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.3,
   "end": 144.26,
   "text": "دو بار پیغمبر اینجا فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.26,
   "end": 148.24,
   "text": "چون کم پیش میاد، خیلی به ندرت پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.24,
   "end": 152.68,
   "text": "اهل بیت علیهم الصلاة والسلام تکرار کنن چیزی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.68,
   "end": 156.2,
   "text": "یا ما زیاد تکرار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.2,
   "end": 160.78,
   "text": "توی صحبت‌مون ده بار یه چیزو تکرار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.78,
   "end": 168.26,
   "text": "همینطوری تسلط به بحث نداریم، فصاحت و بلاغت نداریم همینطوری یه چیزو تکرار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.26,
   "end": 171.7,
   "text": "اما اونها اینطوری نیستن. إن هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.7,
   "end": 178.6,
   "text": "إلا وحی یوحى. اصلاً از پیغمبر عزیز عالم شما بپرس اسم شما، اسم مبارک شما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.6,
   "end": 186.14,
   "text": "هرچی که بگه وحیه. اون از خودش إن هو إلا وحی یوحى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.14,
   "end": 192.38,
   "text": "اون مطلقا چیزی نمیگه مگر وحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.38,
   "end": 195.7,
   "text": "لذا فرمود که چی اقوال ماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.7,
   "end": 199.4,
   "text": "یادتونه؟ شریعت داشتیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.4,
   "end": 202.08,
   "text": "طریقت داشتیم و حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.08,
   "end": 205.36,
   "text": "فرمود که الشریعة أف اقوالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.36,
   "end": 208.74,
   "text": "این قول ما قانون دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.74,
   "end": 213.18,
   "text": "یعنی هرچی میگن بر اساس قوانین الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.18,
   "end": 216.74,
   "text": "لذا این تکرار گفت-- گویی یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.74,
   "end": 221.24,
   "text": "واژه و یه کلمه رو، یه جمله رو اهل بیت توی یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.24,
   "end": 226.16,
   "text": "صحبت تکرار کنن پیداست یه دلیلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.16,
   "end": 232.8,
   "text": "یک بار قبل از توضیحه که چرا تمنای موت نکن، یه بار بعد از توضیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.8,
   "end": 237.92,
   "text": "حالا تو اگر هوشیار باشی، اگر اهلش باشی و اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.92,
   "end": 242.7,
   "text": "دل سپرده باشی و سلمان گونه باشی اصلاً نیاز به توضیح نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.7,
   "end": 248.84,
   "text": "همین که به شما گفت تمنای موت نکن سمعاً وطاعتاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.84,
   "end": 251.0,
   "text": "اما وقتی ما اینطوری نیستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.0,
   "end": 253.9,
   "text": "پیغمبر مجبوره به توضیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.9,
   "end": 256.88,
   "text": "بعد از توضیحش دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.88,
   "end": 259.82,
   "text": "تذکر رو میده که حالا که توضیح دادم به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.82,
   "end": 261.92,
   "text": "این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.92,
   "end": 266.42,
   "text": "مثل یه بچه‌ای که هرچی پدر و مادر بهش بگن گوش نمیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.42,
   "end": 269.36,
   "text": "بعد باز می‌کنه مطلب رو براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.36,
   "end": 273.08,
   "text": "بعد میگه حالا فهمیدی پس این کارو نکن یا این کارو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.08,
   "end": 278.42,
   "text": "توضیح-- یعنی سیاق روایت بخوایم اینطوری روش کار کنیم، تجزیه کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.42,
   "end": 282.38,
   "text": "بعد تحلیل کنیم، کلمات رو جدا کنیم، جملات و اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.38,
   "end": 285.48,
   "text": "بعد بخوایم خیلی-- اصلاً یه روایتو باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.48,
   "end": 291.18,
   "text": "چندین جلسه ماه‌ها روش کار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.18,
   "end": 295.44,
   "text": "جلسه پیش ما یه سوالی ایجاد کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.44,
   "end": 302.8,
   "text": "واقعاً در هر پس هر پیروزی و فتح و نصرتی باید استغفار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.8,
   "end": 310.04,
   "text": "صریح آیه‌ قرآنه که کمتر هم بهش توجه میشه که ما دیش-- روزم که جلسه عرض کردیم یه سری تعجب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.04,
   "end": 312.16,
   "text": "که إذا جاء نصر الله والفتح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.16,
   "end": 314.34,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.34,
   "end": 317.2,
   "text": "إذا جاء نصر الله والفتح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.2,
   "end": 320.66,
   "text": "وقتی نصرت الهی و فتح اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.66,
   "end": 324.88,
   "text": "حالا ما یه فتح کلی داریم، فتح مطلقه مثل اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.88,
   "end": 328.54,
   "text": "والفتح، الفتح. این فتح مطلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.54,
   "end": 332.76,
   "text": "یه معنا داره. فتح قریب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.76,
   "end": 338.82,
   "text": "فتح مبین داریم. إنا فتحنا لك فتحا مبينا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.82,
   "end": 341.1,
   "text": "اینا با هم فرق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.1,
   "end": 342.72,
   "text": "چی‌ان اینا؟ معناشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.72,
   "end": 344.32,
   "text": "تو قرآن متفاوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.32,
   "end": 346.9,
   "text": "حالا دوست داشتید یه وقتی بهش می‌پردازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.9,
   "end": 350.56,
   "text": "این الان مورد بحث ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.56,
   "end": 358.62,
   "text": "خب وقتی که فتح و نصرت الهی اومد، یاری الهی به شما نازل شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.62,
   "end": 362.34,
   "text": "ورأيت الناس يدخلون في دين الله أفواجاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.34,
   "end": 367.22,
   "text": "و تو دیدی که داخل میشن تو دین خدا فوج فوج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.22,
   "end": 369.61,
   "text": "خود این أفواج-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.61,
   "end": 372.73,
   "text": "مثل اینکه شما درو باز کنی بگی آقا بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.73,
   "end": 376.41,
   "text": "خوب و بد میان. جاهل و عالم میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.41,
   "end": 379.55,
   "text": "محسن و مسی میان. همه جور آدم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.55,
   "end": 385.35,
   "text": "این خودش خطره. اینکه همه جور آدم وارد میشن خودش خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.35,
   "end": 387.39,
   "text": "پس نفوذ از کجا شکل می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.39,
   "end": 390.13,
   "text": "از همین جاها. نبودن گزینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.13,
   "end": 396.33,
   "text": "در همون که میگه افواجا اعلام خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.33,
   "end": 401.53,
   "text": "یک وجهش که میگه \"فسبح بحمد ربک واستغفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.53,
   "end": 403.77,
   "text": "انه كان توابا\" اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.77,
   "end": 409.11,
   "text": "یه وجهش اینه. یعنی استغفار کن از اینکه اشتباه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.11,
   "end": 415.55,
   "text": "همه اومدن. حالا در تمیز اینا \"وامتازوا اليوم ايها المجرمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.55,
   "end": 418.91,
   "text": "که تمایز رو بر چی قرار بدی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.91,
   "end": 423.65,
   "text": "خیلی باید مراقبت کنی. این مقام استغفار میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.65,
   "end": 426.49,
   "text": "طلب مغفرت از خدا میخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.49,
   "end": 436.33,
   "text": "که تو اشتباه نکنی. چون خیلی از ماها به ظاهر اکتفا می‌کنیم، به ظاهر قضاوت می‌کنیم و به باطن‌ها آشکار نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.33,
   "end": 440.63,
   "text": "یا حتی باطن رو هم اگر ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.63,
   "end": 447.19,
   "text": "تعمیم می‌کنیم، ظرفیتش رو نداریم، زود عتاب می‌کنیم، عقاب می‌کنیم و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.19,
   "end": 450.45,
   "text": "میگه تو باید مثل خود من پرده‌پوش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.45,
   "end": 454.47,
   "text": "لذا فرمود که از خدا یک صفت رو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.47,
   "end": 457.65,
   "text": "چی رو؟ ستر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.65,
   "end": 461.97,
   "text": "ستّار العیوبی رو. پوشوندن عیب خلق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.97,
   "end": 466.89,
   "text": "آیا ما گرفتیم؟ از پیغمبر عزیز عالم یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.89,
   "end": 470.55,
   "text": "صفت رو بگیر در خودت نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.55,
   "end": 474.87,
   "text": "اون چیه؟ فرمود مدارای با خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.87,
   "end": 479.09,
   "text": "با همه مدارا می‌کنه. اهل مداراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.09,
   "end": 481.69,
   "text": "سخت نمی‌گیره در معاشرت با مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.69,
   "end": 485.35,
   "text": "تکلف نداره. از امام یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.35,
   "end": 487.59,
   "text": "صفت رو بگیر. اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.59,
   "end": 494.85,
   "text": "صبر در بلاهاست. که صبر دیگه جایگاهش ویژه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.85,
   "end": 498.63,
   "text": "که البته در باطن هر کار و هر عبادتی صبر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.63,
   "end": 501.99,
   "text": "اصلاً بدون صبر نمیشه هیچ کاری اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.99,
   "end": 506.13,
   "text": "حتی خود صبر کردن هم تو باطنش صبر میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.13,
   "end": 509.25,
   "text": "صبر بر صبر. حالا بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.25,
   "end": 514.77,
   "text": "پس این یه وجهشه. که چرا باید بعد از هر نصرتی اینجا تو قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.77,
   "end": 516.99,
   "text": "شما-- مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.99,
   "end": 518.85,
   "text": "انقلاب که پیروز شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.85,
   "end": 521.89,
   "text": "تصور کنید سد شکسته شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.89,
   "end": 524.63,
   "text": "آب پشت سد با سرعت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.63,
   "end": 527.09,
   "text": "همه چی رو با خودش آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.09,
   "end": 532.91,
   "text": "بعد یه مدت می‌گذره این آب ته نشین می‌شه، اون سنگلاخ‌ها خودشونو نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.91,
   "end": 537.93,
   "text": "یعنی یه مدت که می‌گذره جامعه‌شناسی اصلاً اینو میگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.93,
   "end": 540.47,
   "text": "لذا اون شهید معروف فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.47,
   "end": 544.03,
   "text": "شهید باکری بود که فرمود مردم سه دسته میشن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.03,
   "end": 550.05,
   "text": "اینو از حیث بعضیا فکر می‌کنن شاید مثلاً چشم برزخی داشته، نه جامعه‌شناس خوبی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.05,
   "end": 552.35,
   "text": "یا بعد از هر انقلاب این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.35,
   "end": 556.27,
   "text": "یه سری کلاً برمی‌گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.27,
   "end": 563.49,
   "text": "و پشیمون میشن. یه سری که از اول اصلاً دشمن بودن و همینطور باقی می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.49,
   "end": 571.49,
   "text": "یه سری هم که بر همون کلمه‌ی حق استوار می‌مونن خون دل می‌خورن و خونجگر میشن و می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.49,
   "end": 575.27,
   "text": "این یه قاعده‌ست. حالا در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 575.27,
   "end": 581.45,
   "text": "یه وجه دیگه‌ش که میگه وقتی نصرت الهی بر شما اومد استغفار کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.45,
   "end": 584.09,
   "text": "می‌تونه بر این باشه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 584.09,
   "end": 588.71,
   "text": "چون معمولاً پس از هر یاری الهی یه غره‌ای، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.71,
   "end": 592.95,
   "text": "اصطلاحاً اج با خودشیفتگی و خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.95,
   "end": 597.79,
   "text": "برتربینی پیش میاد. فتح نصرت یاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.79,
   "end": 604.57,
   "text": "مثلاً ما، ما عرض کردیم حتی اگر مثلاً اضافه حقوقی، پاداشی چیزی بیاد تو حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.57,
   "end": 608.29,
   "text": "ما این هم بر اساس این روایت استغفار میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.29,
   "end": 614.23,
   "text": "خب؟ چون اون هم یاری خداست دیگه از جهت رزق مادی ما رو یاری رسونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 614.23,
   "end": 618.01,
   "text": "\"هو الرزاق ذو القوة المتین\" میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 618.01,
   "end": 620.93,
   "text": "سوره ذاریات. او رزق داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 620.93,
   "end": 624.55,
   "text": "نصرت خداست دیگه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 624.55,
   "end": 626.43,
   "text": "آیا اون لحظه چرا باید استغفار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 626.43,
   "end": 633.57,
   "text": "آیا اون لحظه‌ای که اضافه پولی به من رسید، اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.57,
   "end": 636.01,
   "text": "یک آنه دیگه، اون آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.01,
   "end": 639.31,
   "text": "مثل یک قضیه، قضیه حینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.31,
   "end": 643.25,
   "text": "آنی اتفاق میفته، همون آن ما امتحان پس میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 643.25,
   "end": 648.25,
   "text": "به فکر چی میفتی؟ میخوای چی به زندگیت اضافه کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 648.25,
   "end": 652.77,
   "text": "مثلاً اگر پول در حدی باشه که بشه صرف یه مسافرت درست حسابی رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 652.77,
   "end": 656.01,
   "text": "اولین سفری که به ذهنت میاد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 656.01,
   "end": 657.65,
   "text": "کربلاست یا آنتالیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 657.65,
   "end": 663.87,
   "text": "مثال میگم. اولین چیزی که به ذهنت می‌رسه برای خونه‌ت، خونه‌ت تهیه کنی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 663.87,
   "end": 671.59,
   "text": "از همون لحظه به فکرت می‌رسه که خب فلانی به من رو زده بود نذاشتم بهش بدم الان وقتشه که کمکش کنم و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.59,
   "end": 674.59,
   "text": "مثال دارم میزنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 674.59,
   "end": 676.81,
   "text": "ذهنتونو بشورونم متوجه بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 676.81,
   "end": 682.05,
   "text": "پس استغفار نیازه چون اون لحظه انسان در غفلته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 682.05,
   "end": 686.27,
   "text": "و یاری الهی رو معلوم نیست به چه معنایی برداشت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 686.27,
   "end": 693.93,
   "text": "یا اصلاً \"وما رأيت إذ رميت ولاكن الله رمى\" یادش بخیر تو جهاد بچه‌ها اینو زیاد می‌خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 693.93,
   "end": 697.49,
   "text": "ما نزدیم. ما این تیر رو شلیک نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.49,
   "end": 700.55,
   "text": "بلکه \"ولاكن الله رمى\" خدا شلیک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.55,
   "end": 707.05,
   "text": "خدا زد به هدف. آیا واقعاً اینطوری هستیم ما وقت نصرت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 707.05,
   "end": 714.99,
   "text": "خب این استغفار نیاز داره. برگشت به سمت خدا نیاز داره که حواسمون باشه فتح و نصرت مطلقاً از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 714.99,
   "end": 718.83,
   "text": "لا مؤثر في الوجود إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 718.83,
   "end": 721.15,
   "text": "این یه وجه دیگرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 721.15,
   "end": 723.71,
   "text": "وجه دیگرش می‌تونه این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 723.71,
   "end": 728.29,
   "text": "ما در حین اینکه ، دوازده دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 728.29,
   "end": 734.51,
   "text": "در حین اینکه ما به یاری خدا رسیدیم، اون رو هم از خدا می‌دونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 734.51,
   "end": 737.85,
   "text": "یعنی از خودمون نمی‌دونیم میگیم الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 737.85,
   "end": 740.23,
   "text": "تسبیح به هم می‌کنیم، اونو از یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 740.23,
   "end": 744.33,
   "text": "خدا میدونیم نه خودمون. ولاکن الله الرمى هم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 744.33,
   "end": 747.95,
   "text": "اما از اینجا به بعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 747.95,
   "end": 752.41,
   "text": "از اینجا به بعد اون حالت کبریایی دست از سر ما برنمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 752.41,
   "end": 755.33,
   "text": "یعنی فتح و نصرت رو از خدا میدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 755.33,
   "end": 757.75,
   "text": "ولی حالا که به قدرت رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 757.75,
   "end": 761.15,
   "text": "اون حالت عفو و گذشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 761.15,
   "end": 764.55,
   "text": "کرامت و بزرگواری و مردانگیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 764.55,
   "end": 767.53,
   "text": "آب میره. اینجام استغفار میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 767.53,
   "end": 772.49,
   "text": "یعنی از اینجا حالا از خدا اومد قبول کردی شکر خدا رو هم به جا آوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 772.49,
   "end": 776.69,
   "text": "حواست باشه الان که در منصب قدرتی الان از الان به بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 776.69,
   "end": 778.63,
   "text": "اینا بالاخره دلایل زیادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 778.63,
   "end": 781.83,
   "text": "حالا ما چند تا نمونه عرض کردم چون بحث ما اصلش این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 781.83,
   "end": 784.71,
   "text": "سؤال ایجاد کرده گفتیم جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 784.71,
   "end": 789.53,
   "text": "مهم اینه که ما فعلا اینو بدونیم در متن این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 789.53,
   "end": 792.31,
   "text": "ارزش و اهمیت اون نور على نور رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 792.31,
   "end": 796.05,
   "text": "اگه تو محسنی خب کارهای خیرتو بیشتر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 796.05,
   "end": 799.41,
   "text": "اگه گنهکاری خود توبه اصلاً نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 799.41,
   "end": 803.49,
   "text": "حتی اگر آدم بدی هستی خود توبه به همراه خودش نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 803.49,
   "end": 806.81,
   "text": "چگونه نور داره؟ تواب در وزن فعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 806.81,
   "end": 809.49,
   "text": "اینجا آخرش میفرما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.49,
   "end": 811.79,
   "text": "که خدا توابه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 811.79,
   "end": 815.15,
   "text": "توی همون سوره نصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 815.15,
   "end": 816.81,
   "text": "انّه کان توابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 816.81,
   "end": 819.73,
   "text": "پس اسم خداست. پس نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 819.73,
   "end": 822.39,
   "text": "توبه اصلاً همراه خودش نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 822.39,
   "end": 824.07,
   "text": "آدم اینا رو نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 824.07,
   "end": 828.85,
   "text": "یه نکته عرض کنم، یه چاشنی بحث خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 828.85,
   "end": 830.53,
   "text": "حتما گوشه ذهنتون داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 830.53,
   "end": 833.97,
   "text": "به یادگار اینو من از آقای بهجت خدمتتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 833.97,
   "end": 838.03,
   "text": "ایشون یه روزی فرمودن که، اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 838.03,
   "end": 843.59,
   "text": "چون ازشون به بنده خدایی سؤال کرد فکر کنم بعداً هم توی این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 843.59,
   "end": 848.07,
   "text": "زندگی نامه ایشون اومد. یه سه جلد کتاب از سؤالاتی که ازشون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 848.07,
   "end": 851.45,
   "text": "ازش سؤال کردن شما چکار کردی به این مقامات و رتبه و اینا رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 851.45,
   "end": 856.75,
   "text": "خب اینام دعوشون برای این بود که اخوی‌شون تعریفی نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 856.75,
   "end": 860.53,
   "text": "ایشون از مشایخ‌شون به نقل از مشایخ‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 860.53,
   "end": 863.27,
   "text": "فرمودن که من یه روز این رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 863.27,
   "end": 865.85,
   "text": "استادمون آقای کمپانی پرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 865.85,
   "end": 869.49,
   "text": "ایشونم از استادشون همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 869.49,
   "end": 871.87,
   "text": "استاد در استاد و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 871.87,
   "end": 876.17,
   "text": "جواب داد در جواب این سؤال که شما چکار کردید به این رتبه رسیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 876.17,
   "end": 880.29,
   "text": "فرمود از همون اول تکلیجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 880.29,
   "end": 884.23,
   "text": "همین یه تسبیح حضرت زهرا که گفتم نورش رو حفظ کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 884.23,
   "end": 887.95,
   "text": "هرچی انجام دادم اونو حفظ کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 887.95,
   "end": 891.65,
   "text": "آقای بهجت فرمود اشکال کار عمده ماها اینه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 891.65,
   "end": 893.97,
   "text": "توبرمون سوراخه، جیبمون سوراخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 893.97,
   "end": 896.43,
   "text": "هرچی میریزیم توش خالی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 896.43,
   "end": 901.21,
   "text": "این نگه داشتن اینجا که پیغمبر عظم میفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 901.21,
   "end": 905.61,
   "text": "تزدد احساناً الى احسانه که این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 905.61,
   "end": 907.87,
   "text": "حتی توبه هم گفتم که اونم نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 907.87,
   "end": 911.05,
   "text": "این نگهداشت این نور خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 911.05,
   "end": 914.89,
   "text": "آدم اینو نگه داره. یعنی یه تسبیح حضرت زهرا صلوات الله علیها بگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 914.89,
   "end": 921.49,
   "text": "همون اینو نگه داره تا خودشو بکشه خط و مات و اذکار و اوراد و شب نشینی‌ها و روزه و انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 921.49,
   "end": 925.41,
   "text": "بعد از اون طرف خود نگهداری نداره، مراقبه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 925.41,
   "end": 928.93,
   "text": "نداشتن مراقبه همونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 928.93,
   "end": 933.13,
   "text": "خالی شدن جیب و تو-توبرش هم همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 933.13,
   "end": 935.27,
   "text": "برای چی خودتو اذیت می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 935.27,
   "end": 942.21,
   "text": "مراقبه بهترین کاره. حالا چون من خودم خیلی اهل مراقبه نیستم بهتر میدونم که ادامه ندم صحبت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 942.21,
   "end": 944.31,
   "text": "اهلش در این خصوص صحبت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 944.31,
   "end": 948.17,
   "text": "والحمد لله رب العالمين. صلوات بفرستین. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}