   "title": "## إذ تحققت ولایة الشیطان؛ آرزو پیش چشم و اجل پشت سر",
   "start": 0.38,
   "end": 111.86
  },
  {
   "index": 1,
   "title": "## اساس دعوت شیطان: اغواء أجمعین",
   "start": 111.86,
   "end": 147.5
  },
  {
   "index": 2,
   "title": "کار خدا، ولایت الله و رسالت اولیا بر اساس هدایت است. خواه شاکر باش یا کفران بورز؛ هدایت از ماست. نیز:",
   "start": 147.5,
   "end": 282.36
  },
  {
   "index": 3,
   "title": "## ادب به روایت اباعبدالله",
   "start": 282.36,
   "end": 349.28
  },
  {
   "index": 4,
   "title": "## حسن ظن به مؤمن؛ تا چهل و هفتاد بار",
   "start": 349.28,
   "end": 398.72
  },
  {
   "index": 5,
   "title": "## استثنای خطیر: سپردن مسئولیت",
   "start": 398.72,
   "end": 428.42
  },
  {
   "index": 6,
   "title": "## رد پیشنهاد خارج از تخصص",
   "start": 428.42,
   "end": 677.88
  },
  {
   "index": 7,
   "title": "## هلاک با یکسان شمردن ائمهٔ هدی و کفر",
   "start": 677.88,
   "end": 764.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.92,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.92,
   "end": 6.56,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.56,
   "end": 9.2,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.2,
   "end": 12.6,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.6,
   "end": 18.42,
   "text": "إذ تحققت ولاية الشيطان و الشقاء وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.42,
   "end": 24.66,
   "text": "کسی مستحق ولایت و دوستی شیطان شد و بدبخت شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.66,
   "end": 28.52,
   "text": "جا الأمل بین العینین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.52,
   "end": 33.74,
   "text": "آرزوهای طولانی جلو چشمش رژه میره و ذهب الأجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.74,
   "end": 38.22,
   "text": "وراء الظهر. موت میفته پشت سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.22,
   "end": 41.64,
   "text": "یعنی فراموشی موت بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.64,
   "end": 47.1,
   "text": "با توجه به اینکه ما در مبحث ولایت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.1,
   "end": 51.28,
   "text": "و ولایت الله که در تقابلن سخن گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.28,
   "end": 53.34,
   "text": "وقتی نگاه می‌کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.34,
   "end": 58.16,
   "text": "اساس ولایت شیطان بر گمراهی و اغواء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.16,
   "end": 61.96,
   "text": "و اساس ولایت الهی بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.96,
   "end": 66.1,
   "text": "هدایته، بر عبودیت و تقواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.1,
   "end": 70.48,
   "text": "نشون میده که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.48,
   "end": 80.22,
   "text": "می‌خواهد در مسیر هدایت قرار بگیرد یعنی در ولایت الله باشد، لاجرم باید دائماً به فکر موت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.22,
   "end": 83.44,
   "text": "و اگر کسی تحت تصرف شیطان رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.44,
   "end": 86.26,
   "text": "تحت دوستی و ولایت شیطان قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.26,
   "end": 90.38,
   "text": "عرض کردیم نشونه‌ش فراموشی موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.38,
   "end": 95.8,
   "text": "اینکه اساس کار شیطان، دعوت شیطان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.8,
   "end": 98.52,
   "text": "ولایت شیطان بر گمراهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.52,
   "end": 100.76,
   "text": "خب آیاتی رو قبلاً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.76,
   "end": 106.72,
   "text": "مرور کردیم که همون مهم‌ترینش لَا أُغْوِيَنَّهُمْ أَجْمَعِينَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.72,
   "end": 109.7,
   "text": "یعنی اون می‌خواد أجمعین همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.7,
   "end": 111.86,
   "text": "اغواء کنه، همه رو گمراه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.86,
   "end": 114.42,
   "text": "این نشون میده که اساس دعوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.42,
   "end": 118.12,
   "text": "شیطان و ولایت شیطان بر گمراهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.12,
   "end": 125.12,
   "text": "یعنی کسی گمراه شد قطعاً تحت ولایت شیطان قرار گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.12,
   "end": 129.36,
   "text": "اما اساس دعوت و ولایت الله چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.36,
   "end": 134.42,
   "text": "یه جا که می‌فرماید إنا هدینا السبیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.42,
   "end": 137.94,
   "text": "ما هستیم که راه رو نشون میدیم، هدایت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.94,
   "end": 140.64,
   "text": "إما شاكرا وإما كفورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.64,
   "end": 143.16,
   "text": "حالا می‌خوای شما شاکر باش، بخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.16,
   "end": 146.5,
   "text": "کفران بورز، خودت می‌دونی اما هدایت از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.5,
   "end": 148.58,
   "text": "این قشنگ تصریح بر این داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.58,
   "end": 151.82,
   "text": "کار خدا، ولایت الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.82,
   "end": 153.96,
   "text": "رسالت اولیا همه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.96,
   "end": 157.54,
   "text": "بر اساس هدایته. یا همون آیه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.54,
   "end": 162.02,
   "text": "فرمود إن عبادي،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.02,
   "end": 165.46,
   "text": "عبادي ليس لك عليهم سلطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.46,
   "end": 168.44,
   "text": "بر بندگان من که در واد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.44,
   "end": 175.22,
   "text": "وارد بر محیط عبادت من شدن، عبودیت من شدن تو شیطان نمی‌تونی تسلط پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.22,
   "end": 179.64,
   "text": "پس اینم نشون میده که اصلاً راه خدا، طریق الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.64,
   "end": 183.74,
   "text": "طریق هدایت است و عبودیت و بندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.74,
   "end": 186.78,
   "text": "این یک نکته‌ای رو ما ازش استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.78,
   "end": 190.02,
   "text": "اون نکته بسیار، بسیار، بسیار مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.02,
   "end": 194.22,
   "text": "که در سیر و سلوک ما و ریاضات شرعیه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.22,
   "end": 197.62,
   "text": "بسیار کارساز اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.62,
   "end": 200.9,
   "text": "وقتی اساس کار شیطان بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.9,
   "end": 204.56,
   "text": "اغواگری و بیچاره کردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.56,
   "end": 207.86,
   "text": "ززز به ضلالت کشوندن و گمراهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.86,
   "end": 210.76,
   "text": "إلا عبادك منهم المخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.76,
   "end": 215.2,
   "text": "می‌خواد همه اغواء بشن. نگاه شیطانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.2,
   "end": 220.58,
   "text": "اینه که همه گمراهن. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.58,
   "end": 222.72,
   "text": "الا یه عده‌ای که خودشونو نجات میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.72,
   "end": 227.74,
   "text": "این نگاه شیطانیه. نگاه الهی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.74,
   "end": 230.62,
   "text": "نگاه الهی بر اساس هدایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.62,
   "end": 234.42,
   "text": "کل مولود یولد على الفطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.42,
   "end": 239.06,
   "text": "همه بر اساس فطرت الهی قل كل یعمل على شاکلته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.06,
   "end": 241.72,
   "text": "فطرت پیدا کردن. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.72,
   "end": 244.58,
   "text": "در نگاه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.58,
   "end": 249.66,
   "text": "ابتدا به ساکن همه خوبن مگر اینکه عکسش ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.66,
   "end": 255.2,
   "text": "برعکس اینایی که کارای امنیتی می‌کنن میگن همه مجرم‌اند مگر اینکه عکسش ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.2,
   "end": 260.54,
   "text": "در راه مسیر هدایت نگاه باید این چنین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.54,
   "end": 265.84,
   "text": "آقا همه خوبن. همه ان شا الله اهل نجاتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.84,
   "end": 267.42,
   "text": "مگر اینکه عکسش ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.42,
   "end": 272.62,
   "text": "اتفاقاً دو تا روایت خیلی جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.62,
   "end": 278.18,
   "text": "جون‌دار یعنی جانانه در این مسیر هست که یکیش فرمایش اباعبدالله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.18,
   "end": 281.22,
   "text": "از حضرت پرسیدن ادب رو میشه معنی کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.22,
   "end": 284.12,
   "text": "ادب یعنی چی؟ از امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.12,
   "end": 289.22,
   "text": "حضرت فرمودن هو أن تخرج من بيتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.22,
   "end": 291.68,
   "text": "ادب یعنی اینکه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.68,
   "end": 295.38,
   "text": "خونه‌ت که خارج شدی فلا تلقى أحدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.38,
   "end": 299.58,
   "text": "به اهدی برخورد نکنی إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.58,
   "end": 302.66,
   "text": "رأيت له الفضل عليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.66,
   "end": 308.06,
   "text": "مگر اینکه او رو بر خودت برتری بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.06,
   "end": 311.2,
   "text": "ب- حتی اگر چیزی پیدا نمی‌کنی توجیه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.2,
   "end": 315.28,
   "text": "مثلا ظاهر طرف کاملاً مغایره با ارزش‌های اسلامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.28,
   "end": 318.78,
   "text": "آقا میگی آقا شاید اون عاقبت به خیر شد، من نشدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.78,
   "end": 323.38,
   "text": "بالاخره یه راهی باید پیدا کنی. این ببینید نگاه الهی چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.38,
   "end": 325.42,
   "text": "نگاه ولایت الله این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.42,
   "end": 329.34,
   "text": "اما شیطان نه. شیطان میگه آقا همه بدن، همه فلان فلان شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.34,
   "end": 332.96,
   "text": "فقط من خوبم و دار و دسته من و حزب من و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.96,
   "end": 337.26,
   "text": "اینطوریه. یعنی میگه آقا همه بدن مگر عکسش ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.26,
   "end": 342.14,
   "text": "اینا که کارای امنیتی می‌کنن خیلی باید مراقب سلامت نفسشون باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.14,
   "end": 346.74,
   "text": "اون کار ضربه به سیر و سلوکشون نزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.74,
   "end": 354.34,
   "text": "البته این رو عرض کنم ما بله روایت داریم برای مؤمن اگر کار مبهمی دیدی از مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.34,
   "end": 359.32,
   "text": "شک کردی. حالا این کاری که این مو-مؤمن انجام داد یعنی محب امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.32,
   "end": 361.04,
   "text": "ظاهرش شکل گناه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.04,
   "end": 363.36,
   "text": "چه کنم؟ حضرت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.36,
   "end": 369.32,
   "text": "یه روایت میگه تا چهل، یکی میگه تا هفتاد بار اگه ازش کار مبهم دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.32,
   "end": 373.42,
   "text": "می‌گه فرمود که چکار کن؟ به صحت برداشت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.42,
   "end": 378.38,
   "text": "یعنی براش حتی میگه اگر دلیلی پیدا نکردی دلیل بتراش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.38,
   "end": 383.96,
   "text": "و یه روایت عجیب‌تر از همه اینا دیدم که فرمود اگر نتونستی دلیل بتراشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.96,
   "end": 388.66,
   "text": "یعنی توجیه کنی، توجیه کنی کار مؤمنو که نه انشاالله گناه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.66,
   "end": 394.6,
   "text": "و اگر نتونستی دلیل بتراشی این رو بگذار به حساب خباثت نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.6,
   "end": 397.98,
   "text": "یعنی خبث نفسه که نمیتونی برای مؤمن دلیل بتراشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.98,
   "end": 401.72,
   "text": "منتها این نکته خیلی مهمه، حائز اهمیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.72,
   "end": 407.88,
   "text": "مخصوصاً تو این جمع. اونم اینکه بحث امر به معروف و نهی از منکر اینا به جاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.88,
   "end": 411.94,
   "text": "مخصوصاً جایی که انسان میخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.94,
   "end": 415.06,
   "text": "سرنوشت یه عده‌ای رو به دست کسی بسپارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.06,
   "end": 418.58,
   "text": "یعنی در تعیین مسئولین، مدیران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.58,
   "end": 420.56,
   "text": "حالا دیگه حمله به صحت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.56,
   "end": 423.52,
   "text": "انشاالله آدم خوبیه. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.52,
   "end": 426.28,
   "text": "اینجا باید مو رو از ماست کشید بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.28,
   "end": 432.34,
   "text": "برعکس متأسفانه در سیستم مدیریتی یکی از دلایلی که ما انقدر مشکلات داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.34,
   "end": 439.78,
   "text": "اینه که رو حساب رابطه و پارتی و این از عاشق چشم و ابرو اونه، پسر عمشه، پسر خالشه، تو حزبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.78,
   "end": 441.8,
   "text": "چیشه. اینا میاره میذاره بهترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.8,
   "end": 444.16,
   "text": "خطرناک‌ترین، خطیرترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.16,
   "end": 446.72,
   "text": "مسئولیت‌ها و مدیریت‌ها رو به دست او می‌سپارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.72,
   "end": 449.02,
   "text": "در صورتی که قابلیتش رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.02,
   "end": 452.48,
   "text": "در همین راستا اجازه بدید که بریم سراغ فرمایش معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.48,
   "end": 455.7,
   "text": "ما از خودمون الکی حرف نزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.7,
   "end": 457.9,
   "text": "یادش بخیر یه بار یه همایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.9,
   "end": 460.28,
   "text": "حالا نگم چه رست-- چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.28,
   "end": 463.04,
   "text": "حالا نگم چه مسئولینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.04,
   "end": 468.28,
   "text": "یه مسئولین و مدیران کل یه نهادی از کل کشور جمع بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.28,
   "end": 470.12,
   "text": "ما مجری اجرای این برنامه بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.12,
   "end": 472.98,
   "text": "بین هر آیتم حدود بیست سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.98,
   "end": 474.94,
   "text": "همین فرمایشات امیرالمؤمنین رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.94,
   "end": 478.46,
   "text": "آخرش ما رو بازخواست کردن. گفتن به چه اجازه اینا رو گفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.46,
   "end": 480.48,
   "text": "برای چی؟ گفتم آقا فرمایش امیرالمؤمنین رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.48,
   "end": 483.2,
   "text": "گفتن نه برای چی گفتی تو منظور داشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.2,
   "end": 487.72,
   "text": "م-مدیر اون همایش می‌زد تو سرش می‌گفت منو بدبخت کردی، آبروی منو بردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.72,
   "end": 490.24,
   "text": "حالا شما بشنوید من چی گفتم اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.24,
   "end": 492.86,
   "text": "بیست سال تجدید خاطره شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.86,
   "end": 495.54,
   "text": "تجدید خاطره‌ش هر روز داره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.54,
   "end": 501.14,
   "text": "ای کاش بیست ساله بود. امیرالمؤمنین مثلا بخشی از نامه‌های شصت و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.14,
   "end": 504.56,
   "text": "نهج‌البلاغه رو من دو سه تاش رو براتون بخونم به مالک فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.56,
   "end": 506.7,
   "text": "کی؟ آقامون امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.7,
   "end": 514.36,
   "text": "حرف من نیست که. اولا فرمود ای مالک در به کارگیری کارمندان و کارگزارانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 514.36,
   "end": 517.4,
   "text": "باید زیر نظر تو کار کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.4,
   "end": 522.26,
   "text": "هیچ گونه واسطه و شفاعتی را این رابطه‌ها، پارتی‌بازی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 522.26,
   "end": 525.5,
   "text": "هیچ گونه رابطه و شفاعتی را نپذیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.5,
   "end": 528.8,
   "text": "مگر شفاعت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.8,
   "end": 531.0,
   "text": "کفایت و امانت را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.0,
   "end": 537.68,
   "text": "عجب! یعنی باید آدم می‌خواد کفیل یه ملتی بشه، یه امتی بشه، یه عده‌ای بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.68,
   "end": 542.54,
   "text": "کفایت داشته باشه، به درد این کار بخوره، تخصصش داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.54,
   "end": 546.26,
   "text": "دو، امانت یعنی تعهد هم داشته باشه، امانتدار باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.26,
   "end": 548.82,
   "text": "سر دیگران رو نبره فاش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.82,
   "end": 552.62,
   "text": "حالا اینجا چقدر حرف شما خودتون چقدر درد و دل دارید که باید بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.62,
   "end": 554.54,
   "text": "من دیگه وارد جزئیات نشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.54,
   "end": 559.52,
   "text": "فرمایش مولا رو میگم. در جای دیگه هم تو همین نامه می‌فرماید سعه صدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.52,
   "end": 563.14,
   "text": "مالک حواست باشه اون کسی که میذاری مسئول یه کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 563.14,
   "end": 567.2,
   "text": "باید گشاده سینه باشه، زود عصبانی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 567.2,
   "end": 570.22,
   "text": "اصلاً بعضیا حوصله ندارن با ارباب رجوع برخورد کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 570.22,
   "end": 573.76,
   "text": "آقا بذاریدش کنار اینایی که حوصله ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 573.76,
   "end": 576.48,
   "text": "س-- بعدیش فرمود که باتجربه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.48,
   "end": 583.14,
   "text": "افراد-- مالک، افراد باتجربه را به عنوان کارگزار انتخاب کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 583.14,
   "end": 586.88,
   "text": "یه روز ما اینجا بحث مدیریت و اینها چالش‌هاش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 586.88,
   "end": 589.62,
   "text": "نقد کردیم. یه بنده خدایی تیکه انداخت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 589.62,
   "end": 593.36,
   "text": "گربه دستش به گوش نمی‌رسه میگه پیف پیف پو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 593.36,
   "end": 596.86,
   "text": "و اونجا ما مخصوصاً عرض کردیم تو همین سازمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 596.86,
   "end": 600.56,
   "text": "سه تا مدیر کلی به بنده پیشنهاد شد تو این چند ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.56,
   "end": 605.24,
   "text": "و یکیشو شش ماه نگه داشتن تا بالاخره به اجبار من قبول کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.24,
   "end": 610.36,
   "text": "نکردم. گفتم آقا اون کاری که اونجا باید انجام بدم در تخصص من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 610.36,
   "end": 614.46,
   "text": "این خیانته اگر من در صورتی که چند برابر الان حقوقم میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.46,
   "end": 617.2,
   "text": "دیگه خودتون میدونید دیگه مدیر کلی یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 617.2,
   "end": 620.54,
   "text": "یکیش تو همین مرکز بود. پیشنهاد همین مرکز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 620.54,
   "end": 622.44,
   "text": "واقعاً باید سعی کنن اگه من حرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.44,
   "end": 629.64,
   "text": "حرفشو میذارم در لباس پیغمبر اینو میگم بعضیا فکر نکنن آقا نشستیم واقعاً عروس بلد نیست برقصه میگه زمین کجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.64,
   "end": 633.18,
   "text": "یکی دو تا دیگه فرمایش رو گلچین کنم عرض کنم که اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 633.18,
   "end": 635.62,
   "text": "همش گله، همش بو خوش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.62,
   "end": 640.38,
   "text": "مولا فرمود \"من بیم آن دارم که نابخردان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.38,
   "end": 648.0,
   "text": "نابکاران زمام امور این مدت این ملت را به دست آرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.0,
   "end": 655.3,
   "text": "و مال خدا را دست‌به‌دست گردانند و بندگان او را بردگان خود گیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.3,
   "end": 661.08,
   "text": "و با صالحان به دشمنی برخیزند و فاسقان را حزب خود قرار دهند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.08,
   "end": 669.58,
   "text": "بشه لونه زنبور. این مخصوصاً اینو که اونجا گفتم برگشتم آقا گفتم مگه ما بخور بخور از بیت‌المال کردیم که این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.58,
   "end": 673.92,
   "text": "اینطوری گفته. گفتم اگر شما نخوردید چرا آتیش گرفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.92,
   "end": 677.72,
   "text": "اگر خوردید که پس بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.72,
   "end": 680.18,
   "text": "و جمله آخر. حالا زیاد نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 680.18,
   "end": 684.46,
   "text": "یه جمله دیگه عرض کنم. این فرمایش امیرالمؤمنین به مالک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 684.46,
   "end": 686.68,
   "text": "\"بی‌گمان مردم هلاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.68,
   "end": 689.64,
   "text": "شدند آنگاه\" کی هلاک شدند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 689.64,
   "end": 697.86,
   "text": "\"آنگاه که پیشوایان هدایت و پیشوایان کفر را یکسان شمردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 697.86,
   "end": 701.18,
   "text": "و گفتند هر که به جای پیغمبر نشست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 701.18,
   "end": 704.96,
   "text": "چه نیکوکار باشد و چه بدکار اطاعت او واجب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 704.96,
   "end": 707.32,
   "text": "پس بدین سبب هلاک شدند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 707.32,
   "end": 711.44,
   "text": "یادتونه یه مدتی پیچیده بود ولایت اداری، ولایت اداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 711.44,
   "end": 714.28,
   "text": "مدیرت هرچی گفت باید بگی چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 714.28,
   "end": 718.26,
   "text": "تو همین جا پیچیده بود از من پرسیدند من از دفتر آقا برای اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 718.26,
   "end": 724.62,
   "text": "من که قبول نکردم ولی استفتاء کردم گفتم نخیر آقا همچین فرمایشی ندارند و اصلاً قبول ندارند همچین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 724.62,
   "end": 733.22,
   "text": "ولایت اداری یعنی چی؟ ولایت تعریف-- آقا ولی فقیهم اگر علیعذ بالله که ولایت داره دیگه به قول پیغ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.22,
   "end": 737.52,
   "text": "رهبر عزیزم به قول امام علیه الرحمه ولایتش ولایت کلیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.52,
   "end": 741.34,
   "text": "یعنی در طول ولایت رسول الله شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 741.34,
   "end": 744.84,
   "text": "یعنی هرچی بگه امره. امر الهی محسوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 744.84,
   "end": 750.62,
   "text": "اون هم اگر خطا کنه علیعذ بالله گناهی بکنه از عدالت همون لحظه ساقط میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 750.62,
   "end": 754.96,
   "text": "دیگه ولایت نداره. چه برسه به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.96,
   "end": 756.82,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.82,
   "end": 759.6,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 759.6,
   "end": 764.68,
   "text": "الله- اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}