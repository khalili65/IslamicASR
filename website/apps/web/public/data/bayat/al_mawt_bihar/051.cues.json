 "chapters": [
  {
   "index": 0,
   "title": "## طاعون در روایت؛ ظاهر بلا و دو باطن",
   "start": 18.74,
   "end": 147.66
  },
  {
   "index": 1,
   "title": "## امام سجاد؛ برآشفتن از اتهام به خلق",
   "start": 147.66,
   "end": 484.19
  },
  {
   "index": 2,
   "title": "## دو نگاه؛ بلای خود و بلای دیگری",
   "start": 484.19,
   "end": 529.09
  },
  {
   "index": 3,
   "title": "## جابه‌جایی جبهه‌ها؛ پاییدن خود",
   "start": 529.09,
   "end": 591.35
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 10.34,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.34,
   "end": 14.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.28,
   "end": 18.74,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.74,
   "end": 25.24,
   "text": "بر اساس روایت اول از باب سوم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.24,
   "end": 27.56,
   "text": "یه سوالی پیش میاد اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.56,
   "end": 32.2,
   "text": "بحث طاعون و به هر حال عذاب الهی رو مطرح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.2,
   "end": 37.08,
   "text": "در این روایت امام صادق صلوات الله علیه تصریح دارند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.08,
   "end": 39.82,
   "text": "طاعون اگرچه ظاهرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.82,
   "end": 43.44,
   "text": "بلا است اما برای عده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.44,
   "end": 46.48,
   "text": "عذابه برای عده‌ای رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.48,
   "end": 50.14,
   "text": "اینجا سؤال پیش میاد که آیا وقتی بلایی میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.14,
   "end": 56.7,
   "text": "مثلا امروزه مثل همین امیکرون و کرونا و یا بعضاً زلزله‌هایی که اینا میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.7,
   "end": 62.1,
   "text": "این‌ها خب به جهت معصیت دیگرانه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.1,
   "end": 66.2,
   "text": "یعنی ما حق داریم اون خطه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.2,
   "end": 71.5,
   "text": "جایی که بلا نازل شده رو بگیم اینا معصیت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.5,
   "end": 73.14,
   "text": "آیا ما همچین اجازه‌ای داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.14,
   "end": 78.26,
   "text": "کما این که متأسفانه اون زلزله بَم که رخ داد خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.26,
   "end": 80.76,
   "text": "وحشتناک بود. متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.76,
   "end": 83.74,
   "text": "آدم تو از اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.74,
   "end": 91.38,
   "text": "بعضی از مردم بدشون میاد از این لباس مقدس پیغمبر چون بعضی‌ها که تو این لباسن بعضاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.38,
   "end": 93.34,
   "text": "کارهایی می‌کنند که پیغمبر گونه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.34,
   "end": 95.28,
   "text": "حرف‌هایی که می‌زنن به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.28,
   "end": 98.4,
   "text": "مطابق با صداقت این لباس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.4,
   "end": 102.38,
   "text": "مثلا تو رسانه اعلام کرد که آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.38,
   "end": 105.46,
   "text": "اینا چوب خداست مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.46,
   "end": 110.7,
   "text": "به این مضمون که حتما معصیتی بوده و فلان و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.7,
   "end": 116.34,
   "text": "این‌ها ما همچین اجازه‌ای داریم بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.34,
   "end": 121.6,
   "text": "چون مثلا حدیث هم داریم که وقتی مثلاً ربا و زنا زیاد می‌شه زلزله میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.6,
   "end": 126.14,
   "text": "این‌ها رو داریم. ولی آیا حالا یه زلزله اومد یا همین کرونا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.14,
   "end": 130.58,
   "text": "امیکرون این‌ها واقعاً به جهت معصیت دیگرانه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.58,
   "end": 134.48,
   "text": "ما حق داریم همچین حرفی بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.48,
   "end": 138.68,
   "text": "و اگر ظاهراً نمیگیم به جهت مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.68,
   "end": 142.26,
   "text": "حفظ حرمت و شئونات اجتماعی تو خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.26,
   "end": 146.16,
   "text": "حق داریم اینطوری فکر کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.16,
   "end": 148.42,
   "text": "داریم یا نه؟ امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.42,
   "end": 151.18,
   "text": "سجاد صلوات الله علیه جواب دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.18,
   "end": 155.48,
   "text": "امام سجاد. اجازه بدید با لسان خود حضرت پاسخ گو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.48,
   "end": 158.88,
   "text": "حالا شما تو ذهنتون یه جوابی دادید ببینید امام چی فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.88,
   "end": 163.94,
   "text": "خط‌کشی کرده حضرت دیگه. شما الان فکر درست جواب داده یا غلط؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.94,
   "end": 169.36,
   "text": "مطابق امام فکرت جواب داده یا مخال-- مغایر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.36,
   "end": 173.06,
   "text": "یه شخصی اومد پیش امام سجاد صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.06,
   "end": 177.44,
   "text": "عرض کرد آقا جون یه جایی بلا اومده و طاعون و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.44,
   "end": 180.86,
   "text": "اون موقع هم طاعون زیاد بود مثل، مثل امیکرون الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.86,
   "end": 183.9,
   "text": "و یه عده زیادی رو کشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.9,
   "end": 186.0,
   "text": "این‌ها حتماً یه معصیتی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.0,
   "end": 189.4,
   "text": "معصیت‌کار بودند که این بلا نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.4,
   "end": 194.12,
   "text": "حضرت امام سجاد صلوات الله علیه بر افروخته شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.12,
   "end": 196.48,
   "text": "ناراحت شدند از این سخن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.48,
   "end": 200.96,
   "text": "فرمودند اگر اون‌ها معصیت‌کار بودند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.96,
   "end": 204.34,
   "text": "به طاعون گرفتار شدند، خدا اون‌ها رو ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.34,
   "end": 207.68,
   "text": "اصلاً یعنی این اومده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.68,
   "end": 212.0,
   "text": "گناهاشونو بخشیده دیگه. این می‌شه که اگر چنین باشه که تو میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.0,
   "end": 217.58,
   "text": "کفاره‌ی گناهاشونه. اما تو چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.58,
   "end": 220.52,
   "text": "می‌فرماید امام سجاد، امامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.52,
   "end": 225.9,
   "text": "که به رحمت اومده در این عالم می‌فرماید خدا تو را نمی‌آمرزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.9,
   "end": 229.82,
   "text": "که همچین اتهامی به خلق خدا وارد کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.82,
   "end": 232.28,
   "text": "و یه همچین نگاهی کردی به خلقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.28,
   "end": 235.34,
   "text": "به تو چه؟ تو چی کاره‌ای که تجزیه تحلیل می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.34,
   "end": 238.88,
   "text": "ارزیابی می‌کنی؟ ببینید این‌ها خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.88,
   "end": 244.24,
   "text": "خط‌کشی‌های خداست. اصلاً ستاریت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.24,
   "end": 246.32,
   "text": "محاله قروقش بشکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.32,
   "end": 251.78,
   "text": "این‌هایی که میان به راحتی میگن مثلاً یه رفیقی داشتیم آقا زنگ زده بود به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.78,
   "end": 254.04,
   "text": "افتاده بود به دست و پا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.04,
   "end": 257.06,
   "text": "اصلاً ریخته بود به هم. تازه مداح جمع کران هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.06,
   "end": 259.58,
   "text": "چقدرم ما دوستش داشتیم. چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.58,
   "end": 264.6,
   "text": "گفت حاجی یه بنده خدایی از این حالا متأسفانه هر دو هم هیئت ما می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.6,
   "end": 269.8,
   "text": "گفت فلانی گفته که تو دیگه چند روز بیشتر از عمرت نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.8,
   "end": 272.24,
   "text": "کارت تمومه و آماده باش و این‌ها و این هم ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.24,
   "end": 276.9,
   "text": "گفتم خیلی بیجا کرده، خیلی بیخود کرده این حرفو زده به تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.9,
   "end": 284.1,
   "text": "کی می‌تونه همچین حرفی بزنه؟ گفت آخه حالا حاجی دل-دلایلی آورده، یه سری چیزا گفته از زندگی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.1,
   "end": 286.02,
   "text": "مثلا شخصی و خصوصی. این درست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.02,
   "end": 291.48,
   "text": "گفتم خب بگه دلیل نداره. می‌خوای منم یه چهار پنج تا اضافه بر اون بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.48,
   "end": 297.16,
   "text": "ها کاری نداره که. وهم آدمه می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.16,
   "end": 299.52,
   "text": "بعد یه مدت گذشت دوباره زنگ زد گفت آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.52,
   "end": 305.02,
   "text": "به من گفته که اگر می‌خوای این بلا از تو دفع بشه باید یه بخشش سنگینی تو زندگی بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.02,
   "end": 309.22,
   "text": "خب چی بوده بخشش؟ گفته ماشینتو باید بدی به من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.22,
   "end": 310.9,
   "text": "حالا طرفم بچه هیئتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.9,
   "end": 313.44,
   "text": "از این آدمای دکان بازار راه بنداز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.44,
   "end": 318.66,
   "text": "شیطان اومده تو وهمش. یعنی نمی‌خوام بگم دکان بازار از اونا نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.66,
   "end": 321.02,
   "text": "مثلا دکان بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.02,
   "end": 323.52,
   "text": "نه شیطان دقت بفهمید چی دارم میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.52,
   "end": 327.5,
   "text": "بچه هیئتی و سینه زن امام حسین اون تیکه داره این ادعا رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.5,
   "end": 330.54,
   "text": "همون شیطانه دیگه. اومده تا وهمش بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.54,
   "end": 335.4,
   "text": "تا وهمش اومده فکر می‌کنه عقلشه، وهمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.4,
   "end": 338.18,
   "text": "گفتم آقا بزن تو دهنش. تو چرا قبول می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.18,
   "end": 340.12,
   "text": "می‌خوای من باهاش صحبت کنم؟ گفت نه، نه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.12,
   "end": 344.46,
   "text": "کاری نداره. یه مدت گذشت زنگ زد به من گفت حاجی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.46,
   "end": 347.76,
   "text": "می‌خوام ماشینمو بدم به تو. گفتم من ماشین شما رو می‌خوام چیکار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.76,
   "end": 349.98,
   "text": "ماشین زیر پامه. گفت نه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.98,
   "end": 352.08,
   "text": "باید یه کمک سنگینی به شما بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.08,
   "end": 357.68,
   "text": "گفتم به من برای چی؟ گفت چون تو گره بزرگی از من باز کردی و منو آرو-- آرامش دادی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.68,
   "end": 360.42,
   "text": "به من آرامش دادی که اینطوری نیست و گفتم بابا ولمون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.42,
   "end": 365.01,
   "text": "اگه اینطوری باشه من با اون چه فرقی دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.01,
   "end": 370.09,
   "text": "میشه؟ آقا اصرار، اصرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.09,
   "end": 373.57,
   "text": "گفتم آقا بی‌خیال حالا رفیقیم با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.57,
   "end": 377.67,
   "text": "دوباره بعداً گفت نه شما یه گره بزرگی از من باز کردی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.67,
   "end": 381.19,
   "text": "من رفتم به اون گفتم تو دروغ میگی و بعدم آرامش پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.19,
   "end": 383.33,
   "text": "گفتم خب من وظیفم و خلاصه کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.33,
   "end": 386.05,
   "text": "حالا نمی‌خوام داستان بگم برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.05,
   "end": 387.77,
   "text": "دردآور بود. ول نکرد مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.77,
   "end": 391.83,
   "text": "یه چند ماهی آخر زنگ زد گفت من دیشب خواب امام عصر رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.83,
   "end": 395.23,
   "text": "به آقا توسل کرده بودم. همون آقا خوبه ها مددا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.23,
   "end": 399.67,
   "text": "به آقا گفته بودم آقا من می‌خوام یه کمک سنگینی به یکی از رفیقات بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 399.67,
   "end": 402.97,
   "text": "تو به من بگو به که شما رو تو خواب آقا نشون داد به شما بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.97,
   "end": 407.07,
   "text": "گفتم بابا بیخیال ما میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.07,
   "end": 410.53,
   "text": "؟ گفتم اگه برو از طرف من سلام منو به آقا برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.53,
   "end": 415.91,
   "text": "دفعه خواب آقا رو دیدی بگو آقا اگر می‌خوای به ما ماشین بدی خودت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.91,
   "end": 419.07,
   "text": ". چرا حواله میدی؟ گفت نه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.07,
   "end": 422.55,
   "text": "قرض و بدهکاری مگه نداری؟ گفتم همه مردای امروز دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.55,
   "end": 428.13,
   "text": "کی نداره؟ گفت نه حالا بالاخره انقدر اصرار، اصرار، خواهش، تمنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.13,
   "end": 432.01,
   "text": "اینا بماند. ما می‌خوام به شما بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.01,
   "end": 437.05,
   "text": "اینطوری می‌شه. یعنی شیطون میاد آقا شما آخر عمرته فلان بشین سر جات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.05,
   "end": 439.75,
   "text": "تو چیکاره‌ای دخالت در کار خدا می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.75,
   "end": 443.07,
   "text": "یا چرا به خیلی از ماها چیزی نمیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.07,
   "end": 446.55,
   "text": "بچه‌های اشراف و امنیت و چه می‌دونم اینا دقت داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.55,
   "end": 451.25,
   "text": "به جهت اینکه همش سرمون تو پرونده خصوصی این و اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.25,
   "end": 455.35,
   "text": "به جهت اینکه همش داریم می‌پاییم این چیکار می‌کنه، اون چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.35,
   "end": 457.09,
   "text": "دزدت شدیم. دزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.09,
   "end": 462.29,
   "text": "به خدا هم نمیده. چون تو دزدی می‌کنی با علمت، با چشمت، خدا هم بهت نمیده چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.29,
   "end": 470.89,
   "text": "چون ظرفیت نداری. مگر یه جاهایی که دیگه مصلحت اسلام اقتضا می‌کنه قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.89,
   "end": 473.11,
   "text": "خلاصه حضرت ببین چه تشری زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.11,
   "end": 480.25,
   "text": "این تشرح خیلی مهمه. حالا من اینجا حرفای دیگه‌ای هم داشتم فرصت با همون داستانی که گفتیم فرصت محور ما رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.25,
   "end": 483.73,
   "text": "اما خب تو دل همین داستان‌ها چیزای آدم گیرش میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.73,
   "end": 485.87,
   "text": "فرمودن اگر بلایی نازل شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.87,
   "end": 490.91,
   "text": "به تو هم نازل شد در خصوص خودت می‌تونی بگی حتماً یه گناهی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.91,
   "end": 493.39,
   "text": "خودت. اینطوری باید نگاه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.39,
   "end": 497.95,
   "text": "و این رو البته از ناحیه حضرت حق بلایی بدانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.95,
   "end": 500.09,
   "text": "نه پدر کشتگی خدا با تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.09,
   "end": 503.21,
   "text": "بلکه هته‌ی گناهاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.21,
   "end": 505.55,
   "text": "می‌ریزه گناهاتو. نه درجاتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.55,
   "end": 511.03,
   "text": "نه اشتباه نشه. گناهاتو خدا می‌خواد بریزه پاکت کنه بازم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.03,
   "end": 517.05,
   "text": "اما در خصوص دیگران چی؟ در خصوص دیگران باز حق نداری بگی خدا می‌خواد گناهاشو پاک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.05,
   "end": 520.57,
   "text": "به تو چه؟ مگه تو خبر داری از گناهاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.57,
   "end": 522.45,
   "text": "باید بگی خدا می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.45,
   "end": 524.61,
   "text": "درجاتش رو افزون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 524.61,
   "end": 529.09,
   "text": "خدا می‌خواد امتحانش کرده انشاالله رو سفید بیرون بیاد بهش درجه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.09,
   "end": 534.45,
   "text": "باور کنید رفقا. چقدر من و شما الان خیلیا тут اینجا ریش سفید هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.45,
   "end": 541.69,
   "text": "چقدر دیدید آدمایی که خط مقدم بودند، جلودار بودند تو هیئتها، تو این مساجد حتی تو جبهه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.69,
   "end": 546.35,
   "text": "الان اونوری‌ان. اصلا تعطیل کردن این چیزا رو تمسخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.35,
   "end": 551.19,
   "text": "توبه کردن. تو قم جلسات توبه داریم از کسایی که جبهه رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.19,
   "end": 557.19,
   "text": "همین آخوندهایی که جبهه رفتن جلسات شب‌های جمعه جمع می‌شن توبه می‌کن-- توبه‌نامه امضا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.19,
   "end": 561.39,
   "text": "چقدر آدم اینطوری داریم و چقدر آدمای اونوری تو فامیل‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.39,
   "end": 563.73,
   "text": "شاهنشاهی بودن. اینا الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.73,
   "end": 567.01,
   "text": "سینه چاک رهبرن. اصلا آدم باورش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.01,
   "end": 572.53,
   "text": "خیلی مراقب باشیم. آخرالزمان جابجایی داره صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.53,
   "end": 575.31,
   "text": "هی جبهه داره عوض می‌شه. مراقب خودمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 575.31,
   "end": 579.19,
   "text": "دانه‌مون رو سفت بگیریم. هی این این کارو کرد، اون اون کارو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.19,
   "end": 585.39,
   "text": "خودمون رو بپاییم. انشاالله قولتون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.39,
   "end": 591.35,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}