 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.04,
   "end": 7.82,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.82,
   "end": 10.82,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.82,
   "end": 13.92,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.92,
   "end": 17.74,
   "text": "در محضر پنج تا شهید گمنام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.74,
   "end": 21.04,
   "text": "ان شا الله که روح این شهدا همه ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.04,
   "end": 24.94,
   "text": "مشمول ادعیه زکیه و قدسیه خودشون بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.94,
   "end": 26.94,
   "text": "نصارشون صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.94,
   "end": 29.36,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.36,
   "end": 34.92,
   "text": "صل على محمد آله محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.92,
   "end": 39.58,
   "text": "عجل فرجه. چهارشنبه‌ها ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.58,
   "end": 46.08,
   "text": "در محضر اصحاب رسانه ملی جای دیگه‌ای از این سازمان بحث موت رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.08,
   "end": 52.76,
   "text": "کتاب الموت مرحوم مجلسی رو شروع کرده بودیم به شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.76,
   "end": 57.76,
   "text": "و فکر می‌کنم جلسه صد و سی چهل این حدودا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.76,
   "end": 61.04,
   "text": "الان رسیدیم به مرحله ششم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.04,
   "end": 67.18,
   "text": "مرگ. با توجه به اینکه چهارشنبه بود و من قول داده بودم به دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.18,
   "end": 70.16,
   "text": "امروز این بحث رو ان شا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.16,
   "end": 73.8,
   "text": "ادامه میدیم تو همین حدود یک ربع وقت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.8,
   "end": 79.52,
   "text": "ان شا الله از جلسات بعد که چهارشنبه‌ها قراره بنده حقیر در خدمتتون باشم ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.52,
   "end": 85.32,
   "text": "چه موضوعی رو پیش بگیریم. شما هم می‌تونید در موضوع انتخابی‌مون سهیم باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.32,
   "end": 89.86,
   "text": "ششمین و آخرین مرحله مرگ که از حساس‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.86,
   "end": 92.66,
   "text": "مراحل مرگه بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.66,
   "end": 96.32,
   "text": "آنچه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.32,
   "end": 99.42,
   "text": "آیات و روایات مشخص می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.42,
   "end": 103.36,
   "text": "مرحله‌ای است که دیگه خود قابض الارواح دست به کار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.36,
   "end": 105.52,
   "text": "تا پیش از مرحله ششم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.52,
   "end": 109.4,
   "text": "اون مراحل اول تا پنجم که حالا شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.4,
   "end": 113.0,
   "text": "نزع روح و جان کندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.0,
   "end": 118.98,
   "text": "از نوک انگشتان پا میاد که مراحلش تو پنج مرحله پیش ما عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.98,
   "end": 122.34,
   "text": "و از پاها میاد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.34,
   "end": 126.5,
   "text": "ناف و میاد تا سینه و همینطور تا تراقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.5,
   "end": 129.84,
   "text": "که این استخوان‌های کتف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.84,
   "end": 132.14,
   "text": "اینا مراحلیه که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.14,
   "end": 135.56,
   "text": "بعد گردن خودش یه مرحله بسیار سختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.56,
   "end": 138.06,
   "text": "بعد بلغت الحلقوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.06,
   "end": 142.84,
   "text": "از حلق که می‌خواد روح کشیده بشه به بیرون از دهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.84,
   "end": 145.68,
   "text": "مرحله پنجم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.68,
   "end": 148.36,
   "text": "که هر کدوم اسامی‌ای داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.36,
   "end": 153.86,
   "text": "و ما اون‌ها رو توضیح دادیم. همه این مراحل قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.86,
   "end": 157.4,
   "text": "خودش تماشاچیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.4,
   "end": 160.3,
   "text": "سدنه و خدمه‌ش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.3,
   "end": 164.72,
   "text": "ملائکه که حالا یا نسبت به اینکه این شخص چه گونه آدمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.72,
   "end": 168.72,
   "text": "یا ملائکه غlasz شدادن یا روح ریهانن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.72,
   "end": 172.42,
   "text": "اون‌ها دست به کارن. اون مرحله آخر که دیگه می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.42,
   "end": 177.82,
   "text": "این مرحله ششم می‌خواد روح به تمامه از بینی شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.82,
   "end": 181.54,
   "text": "کشیده بشه به بیرون و بسیار مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.54,
   "end": 183.76,
   "text": "سخت و سنگینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.76,
   "end": 187.54,
   "text": "خود قابض الارواح دست به کار می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.54,
   "end": 192.82,
   "text": "که اصطلاحا بهش میگن مرحله پایانی و قبض روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.82,
   "end": 197.16,
   "text": "اونجا حضرت قابض الارواح به شخص نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.16,
   "end": 198.92,
   "text": "این البته نگاه دو طرفه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.92,
   "end": 202.74,
   "text": "حالا عرض می‌کنم هر دو به هم نگاه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.74,
   "end": 205.54,
   "text": "قابض الارواح طبق روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.54,
   "end": 208.04,
   "text": "می‌فرمایند اگر چنانچه اون شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.04,
   "end": 213.54,
   "text": "خدایی نکرده اهل گناهان کبیره و انسان خبیثی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.54,
   "end": 220.52,
   "text": "بهش می‌فرماید که \"یا أیتها الروح الخبيثة اخرج إلى نار ونيران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.52,
   "end": 224.04,
   "text": "ورب منتقم غضبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.04,
   "end": 226.28,
   "text": "خارج شو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.28,
   "end": 229.0,
   "text": "برو به سمت آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.0,
   "end": 231.52,
   "text": "اون سوزناکی آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.52,
   "end": 236.74,
   "text": "پروردگار منتقم.\" ببین قبلاً عرض کردیم که بر اساس نظریات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.74,
   "end": 241.26,
   "text": "حکمت متعالیه، جهنم تجلی اسماء جلال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.26,
   "end": 244.78,
   "text": "همونطور که بهشت تجلی اسماء جمال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.78,
   "end": 250.3,
   "text": "اینجا توی این فرمایش حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.3,
   "end": 253.32,
   "text": "اشاره به اسم جلال خدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.32,
   "end": 256.58,
   "text": "منتقم، غضبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.58,
   "end": 263.44,
   "text": "این خودش یه اشاره‌ست که اینجا میگن چهره طرف سیاه می‌شه به جهت چهره باطنی‌ش‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.44,
   "end": 266.38,
   "text": "صورتشو شما ببینید ما چیزی متوجه نمی‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.38,
   "end": 274.14,
   "text": "اینجا نشأت ماده‌ست اگرچه تأثیرگذار هست از هم متأثر هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.14,
   "end": 278.1,
   "text": "بعد در این مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.1,
   "end": 283.96,
   "text": "آیه نود و نه و صد سوره مؤمنون حرف اول رو می‌زنه که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.96,
   "end": 286.82,
   "text": "توی این وضعیت قرار گرفت این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.82,
   "end": 289.5,
   "text": "حالا اگر اهل ایمان باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.5,
   "end": 292.1,
   "text": "که بهش بشارت میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.1,
   "end": 296.34,
   "text": "و اونجا ملکوت عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.34,
   "end": 303.52,
   "text": "و چهره دلارای امام عصرش رو بگیر تا پیغمبر عزیز عالم رو نشونش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.52,
   "end": 306.48,
   "text": "اما غیر از این که خدایی نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.48,
   "end": 309.56,
   "text": "حالا چهره سیاه از درون شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.56,
   "end": 313.34,
   "text": "رب رجعون فریادشه آیه نود و نه سوره مؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.34,
   "end": 316.7,
   "text": "وقتی متوجه شد تازه اونجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.7,
   "end": 321.54,
   "text": "اونجا اون معنایی که میگن سرت به سنگ بخوره اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.54,
   "end": 325.54,
   "text": "سرش به سنگ خورد. تازه اینجا چشاش برق زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.54,
   "end": 328.34,
   "text": "\"فبصروا کالیوم حدید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.34,
   "end": 332.78,
   "text": "اینجا تازه فهمید می‌گه رب رجعون تو رو خدا منو برگردون خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.78,
   "end": 339.08,
   "text": "بذار من برگردم \"لعلّي أعمل صالحاً فيما تركت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.08,
   "end": 341.88,
   "text": "همه جفاکاران یه همچین ندایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.88,
   "end": 345.24,
   "text": "برم اون چیزی که ترک کرده بودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.24,
   "end": 348.84,
   "text": "فروگذار کردم اون رو، اون عمل صالح رو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.84,
   "end": 351.45,
   "text": "اینجا در آیه صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.45,
   "end": 355.43,
   "text": "خدا می‌فرماید که \"کلا\" این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.43,
   "end": 359.57,
   "text": "انّ داره به ما، به ما هوشیاری و بیداری می‌ده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.57,
   "end": 361.91,
   "text": "\"إنها كلمة هو قائلها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.91,
   "end": 364.09,
   "text": "این یه کلمه‌ایه که اون داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.09,
   "end": 368.79,
   "text": "یعنی به دروغ میگه. منظور اینه که اگه برگرده دوباره همون آش و همون کاسه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.79,
   "end": 371.91,
   "text": "به دروغ میگه منو برگردون تا عمل صالح انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.91,
   "end": 374.79,
   "text": "حالا این تیکش خیلی، خیلی حرف توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.79,
   "end": 377.39,
   "text": "خیلی حرف-- البته همش حرف توشه اما اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.39,
   "end": 381.85,
   "text": "بزرگان خیلی حرف‌ها پیاده کردن \"ومن ورائهم برزخا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.85,
   "end": 387.61,
   "text": "إلى يوم يبعثون\" که دیگه تو این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.61,
   "end": 395.43,
   "text": "که کار تموم می‌شه و اصطلاحاً میگن تمام اعضا و جوارح و ارکان قفل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.43,
   "end": 398.87,
   "text": "سکرة الموت اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.87,
   "end": 402.89,
   "text": "قفل می‌شن. دیگه هیچ حسی و حرکتی طرف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.89,
   "end": 406.85,
   "text": "می‌بینه که تحت قبضه قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.85,
   "end": 410.67,
   "text": "جبروت عالمه. جبروت بر وزن فعلوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.67,
   "end": 413.07,
   "text": "جبر محض. اصلاً اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.07,
   "end": 416.47,
   "text": "مثل دنیا نیست یه اختیارکی داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.47,
   "end": 418.11,
   "text": "دیگه همه چی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.11,
   "end": 424.07,
   "text": "همه چی دست اوست و تو هرچی خودت تو ساختی همون، همون هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.07,
   "end": 427.29,
   "text": "حالا این در خصوص برزخی که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.29,
   "end": 431.19,
   "text": "فرمودن که \"من ورائهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.19,
   "end": 435.49,
   "text": "برزخا إلى يوم يبعثون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.49,
   "end": 438.81,
   "text": "در تفسیر اهل بیت علیهم الصلاة والسلام رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.81,
   "end": 444.01,
   "text": "تا خب تفاسیر روایی مثل برهان، نور الثقلین اینا صافی دارن این روایات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.01,
   "end": 448.95,
   "text": "تفسیر اهل بیت جلد ده، صفحه صد و شونزده، اونجا من خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.95,
   "end": 455.95,
   "text": "از علی ابن ابراهیم به نقل ایشون از امام صادق صلوات الله علیه ذیل این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.95,
   "end": 458.25,
   "text": "داره باز می‌کنه این آیه، این برزخ رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.25,
   "end": 462.01,
   "text": "اینکه برزخ اینجا منظور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.01,
   "end": 465.47,
   "text": "حضرت فرمودن \"البرزخ القبر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.47,
   "end": 469.73,
   "text": "اینو فعلاً داشته باشین \"وهو الثواب والعقاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 469.73,
   "end": 475.59,
   "text": "بين الدنيا وهو الثواب والعقاب بين الدنيا والآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.59,
   "end": 477.75,
   "text": "والدليل على ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.75,
   "end": 483.29,
   "text": "أيضا قول العالم\" که منظور قول امام صادقه که می‌فرماید \"والله ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.29,
   "end": 485.91,
   "text": "يخاف عليكم إلا البرزخ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.91,
   "end": 489.45,
   "text": "ما برای شما هیچ ترسی نداریم مگر از برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.45,
   "end": 496.17,
   "text": "میگه برزخ اون حالت بین دنیا و آخرت یا دنیا و قيامته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.17,
   "end": 498.57,
   "text": "که بحث عقاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.57,
   "end": 506.09,
   "text": "ثواب پیش میاد. اونجا چه عقابی باشد، چه ثوابی باشد به عینه اونجا شخص می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.09,
   "end": 508.27,
   "text": "که اصطلاحاً بهش میگن قیامت صغرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.27,
   "end": 513.43,
   "text": "حالا این دیدن، این قبر که در قبر می‌بینه، این کدوم قبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.43,
   "end": 518.35,
   "text": "این قبر فقهیه، خاکیه که بدن ما رو درش می‌گذارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.35,
   "end": 525.45,
   "text": "قطعاً این نیست. چون این قبر nature مادی اصلاً ظرفیت این رو نداره که بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.45,
   "end": 527.77,
   "text": "اون سعه رو به خودش بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.77,
   "end": 532.83,
   "text": "بحث مجرده. اونجا روح که قبض می‌شه دیگه اونجا عالم مجرداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.83,
   "end": 536.35,
   "text": "اصلاً این، این یه رشه ایست، یه آیتی‌ست، یه نک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.35,
   "end": 538.63,
   "text": "یک نشانه ایست از او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.63,
   "end": 541.27,
   "text": "که چون بدن تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.27,
   "end": 545.41,
   "text": "سر الله و فاطمیه یه چیزکی اینجا عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.41,
   "end": 548.61,
   "text": "چون بدن از چرخه طبیعته برمی‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.61,
   "end": 553.69,
   "text": "چرخه طبیعت. از آب و نانیه که پدر و مادر خوردن نطفه تشکیل شده هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.69,
   "end": 555.79,
   "text": "اون قبر پس چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.79,
   "end": 559.73,
   "text": "که اینجا حضرت صادق تصریح فرمودن \"البرزخ القبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.73,
   "end": 563.79,
   "text": "وهو الثواب والعقاب بين الدنيا والآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 563.79,
   "end": 565.79,
   "text": "ثواب و عقاب اونجا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.79,
   "end": 569.31,
   "text": "و امام صادق فرموده من ترسم برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.31,
   "end": 573.33,
   "text": "اونه و الا قیامت، اون قیامت کبرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.33,
   "end": 580.03,
   "text": "بنده، امام صادق فرمودن من و اجدادم تا پیغمبر اصلاً نمی‌گذاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.03,
   "end": 583.69,
   "text": "شیعه ما، محب ما به جهنم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.69,
   "end": 589.01,
   "text": "و این قصه چیه که اینجا فرمود من از-- می‌ترسم برای اون لحظه برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.01,
   "end": 593.25,
   "text": "این قبر کدوم قبره؟ می‌خواستم از رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 593.25,
   "end": 597.77,
   "text": "نکته این کتابی که دست بنده است، هزار و یک نکته علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.77,
   "end": 602.27,
   "text": "نکته ششصد و پنجاه و چهار اگر رجوع کنید این رو باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.27,
   "end": 604.73,
   "text": "چه خوب فرصت نیست من فقط این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.73,
   "end": 610.65,
   "text": "قسمت اولش رو. ذیل همین آیه‌یه \"ومن ورائهم برزخا إلى يوم يبعثون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.65,
   "end": 614.53,
   "text": "علامه قلم می‌زنه. در این کریمه بعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.53,
   "end": 617.11,
   "text": "مبعوث شدن، برانگیخته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.11,
   "end": 620.03,
   "text": "بعث بعد از برزخ است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.03,
   "end": 624.33,
   "text": "و عذاب قبر در برزخ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.33,
   "end": 629.79,
   "text": "همین که میگه عذاب قبر در برزخ است پس منظور این قبر دنیایی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 629.79,
   "end": 633.81,
   "text": "این قبر دنیاییه. عذاب قبر تو برزخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.81,
   "end": 638.05,
   "text": "که می‌فرماید \"ومن ورائهم برزخا إلى يوم يبعثون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.05,
   "end": 642.25,
   "text": "بین بعث یعنی قیامت و برانگیخته شدن و دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.25,
   "end": 647.25,
   "text": "اون برزخی که منظور همون قبر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 647.25,
   "end": 651.73,
   "text": "علامه ادامه میدن چه قبر حقیقی انسان بیروز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 651.73,
   "end": 657.03,
   "text": "بیرون از او نیست. این نیستش که بگه حالا قبر من اینجا تو امامزاده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.03,
   "end": 660.69,
   "text": "بغل امام معصوم باشم، دیگه در روح و ریحانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.69,
   "end": 663.35,
   "text": "یا مثلاً بگیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.35,
   "end": 669.01,
   "text": "نه طرفو مثلا بغل-- دیدید تو بهشت حضرت زهرا سلام الله عليها بعضیا رو بغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.01,
   "end": 671.63,
   "text": "جسارتاً سرویس بهداشتی دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.63,
   "end": 673.77,
   "text": "یکی می‌گفت این بیچاره رو نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.77,
   "end": 676.27,
   "text": "هر روز بوی گند فلان اذیتش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.27,
   "end": 679.07,
   "text": "متوجه نیست که اصلاً این حرفا نیستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.07,
   "end": 684.97,
   "text": "قصه چیز دیگریست. اینجا علامه می‌فرماید که چه قبر حقیقی انسان بیرون از او نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.97,
   "end": 689.15,
   "text": "و وزان قبر حقیقی وزان مراتب انسان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 689.15,
   "end": 695.23,
   "text": "که قبر انسان را مراتب طولی‌ست یعنی انسان را قبرهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.23,
   "end": 698.19,
   "text": "و تفاوت به کمال و نقص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 698.19,
   "end": 703.47,
   "text": "اولین قبری که ما واردش می‌شیم و عقاب و ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.47,
   "end": 708.03,
   "text": "اونجا به ما داده می‌شه، عرضه می‌شه که در حقیقت خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 708.03,
   "end": 709.87,
   "text": "ثواب و عقاب خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.87,
   "end": 712.63,
   "text": "خودمون رو به جهنم کردیم یا بهشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 712.63,
   "end": 714.89,
   "text": "بدن برزخی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 714.89,
   "end": 718.05,
   "text": "اون بدنه که علامه می‌فرماید در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 718.05,
   "end": 720.79,
   "text": "شریف انسان در عرف عرفانشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 720.79,
   "end": 723.67,
   "text": "اونجا در یکی از نکات توضیح میدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 723.67,
   "end": 726.17,
   "text": "بدن برزخی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 726.17,
   "end": 730.07,
   "text": "از کجا ساخته می‌شه؟ همونطور که نفس برزخی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 730.07,
   "end": 733.15,
   "text": "ما در ساخت بدن دنیایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 733.15,
   "end": 736.23,
   "text": "و نفس دنیاییمون ظاهراً دخیل نبودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 736.23,
   "end": 738.33,
   "text": "اگرچه اگر بریم به سُق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.33,
   "end": 747.25,
   "text": "باریک و در علم الهی در اعیان ثابته که قبلاً بحثش اینجا گذشت، چرا زبان حال ما بود که به این شکل شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 747.25,
   "end": 748.95,
   "text": "اون باز هم ما دخیل بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.95,
   "end": 756.31,
   "text": "حالا میگیم بر فرض نبودیم در این دنیا اما بعد از این نشئه در شکل بدن برزخیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.31,
   "end": 758.79,
   "text": "و نفس برزخیمون کاملاً دخیلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 758.79,
   "end": 762.27,
   "text": "خدا سپرده به خودمون. لذا علامه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 762.27,
   "end": 766.59,
   "text": "اعمال ما مشخص بدن برزخی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 766.59,
   "end": 770.31,
   "text": "اعمال ما؛ یعنی قبر برزخی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 770.31,
   "end": 775.45,
   "text": "قبر ما، قبر اصلی ما که عقاب و ثواب اونجاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.45,
   "end": 777.67,
   "text": "همون بدن برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.67,
   "end": 781.45,
   "text": "اعمال ما اون رو می‌سازه، اون رو شکل می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 781.45,
   "end": 784.33,
   "text": "بعد باورها و اعتقادات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.33,
   "end": 786.23,
   "text": "علوم ما چی رو می‌سازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 786.23,
   "end": 787.97,
   "text": "باطن برزخی ما رو؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 787.97,
   "end": 790.35,
   "text": "یعنی نفس برزخی ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.35,
   "end": 797.77,
   "text": "در حقیقت ما به، نسبت به اینکه عملمون و علمی که اخذ می‌کنیم، باورهامون چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 797.77,
   "end": 801.19,
   "text": "داریم خودمون، خودمون رو می‌سازیم به همون شکلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.19,
   "end": 803.85,
   "text": "به همون شکلی که هستیم. لذا این کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 803.85,
   "end": 807.87,
   "text": "کتابی‌ست که نون و قلم و مایستغنی سطر، سطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 807.87,
   "end": 810.59,
   "text": "به دست خودمون داره نگاشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 810.59,
   "end": 813.95,
   "text": "خودمون داریم این کتاب وجودی خودمون رو می‌نویسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 813.95,
   "end": 819.01,
   "text": "برای همین هم در نهایت میگن اقرأ کتابک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 819.01,
   "end": 821.25,
   "text": "خودت کتاب خودت رو بخوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 821.25,
   "end": 824.35,
   "text": "کفا بنفسک اليوم عليك حسیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 824.35,
   "end": 827.77,
   "text": "خودت کفایت می‌کنی که چه کردی و چه ساختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 827.77,
   "end": 829.85,
   "text": "حالا اونجایی که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 829.85,
   "end": 831.91,
   "text": "صادق صلی الله علیه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 831.91,
   "end": 834.69,
   "text": "ما از اینجا نگرانیم، از برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 834.69,
   "end": 837.95,
   "text": "قیامت دستتونو می‌گیریم، این وجه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 837.95,
   "end": 841.75,
   "text": "امتیاز این دو. یعنی قیامت دست ما رو می‌گیرن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 841.75,
   "end": 844.45,
   "text": "ما یعنی یه دفعه قیافمون عوض می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 844.45,
   "end": 848.55,
   "text": "چون میگیم بدن برزخی رو خودمون داریم شکل میدیم با اعمالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 848.55,
   "end": 850.19,
   "text": "بعد قیامت ما رو نجات میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 850.19,
   "end": 853.33,
   "text": "این یعنی چی؟ این برمی‌گرده به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 853.33,
   "end": 855.53,
   "text": "بحث استهالة و اون روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 855.53,
   "end": 857.41,
   "text": "شریف و شیرینی که دیگه فرصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 857.41,
   "end": 864.43,
   "text": "من گذشته فقط اشاره عرض می‌کنم برید ببینید روایت رو خیلی شیرینه که خیلی عالیه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 864.43,
   "end": 866.63,
   "text": "می‌فرماید-- مفسوت هم هست. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 866.63,
   "end": 870.33,
   "text": "کسانی هستند که خب صاحب گناهان کبیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 870.33,
   "end": 873.73,
   "text": "جهنم شدن اصلاً خودشون قرینن با جهنمی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 873.73,
   "end": 875.83,
   "text": "بعد اینا در جهنم می‌سوزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 875.83,
   "end": 880.31,
   "text": "یه مدتی که می‌گذره بر اساس سیر استکمالی برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 880.31,
   "end": 884.67,
   "text": "که ما چندین جلسه در این مورد حرف زدیم، دوستانی که دوست داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 884.67,
   "end": 888.23,
   "text": "تو کانال می‌تونن رجوع کنن هست هنوز مباحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 888.23,
   "end": 892.23,
   "text": "بعد این تغییر و تحول ایجاد می‌شه چون اونجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 892.23,
   "end": 894.55,
   "text": "تبدل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 894.55,
   "end": 897.15,
   "text": "عرض شود خدمتتون اون تجدد امثال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 897.15,
   "end": 900.15,
   "text": "حرکت جوهری تو نشئه طبیعت هست فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 900.15,
   "end": 902.71,
   "text": "ولی اونجا تبدل امثال ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 902.71,
   "end": 906.43,
   "text": "اونجا از طوری به طور دیگه بدل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 906.43,
   "end": 908.95,
   "text": "بعد بالاخره به میزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 908.95,
   "end": 912.53,
   "text": "این شخص گناه کرده، عذاب که می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 912.53,
   "end": 916.29,
   "text": "بعد خدا به شفاعت، حالا باید بحث شفاعت باید اینجا باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 916.29,
   "end": 918.33,
   "text": "یعنی چی؟ خودش خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 918.33,
   "end": 919.87,
   "text": "حرف‌ها پیاده کردن بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 919.87,
   "end": 923.51,
   "text": "این شخص اهل نجات می‌شه از جهنم اصطلاحاً میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 923.51,
   "end": 926.79,
   "text": "از جهنم میاد بیرون، اینجا رو خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 926.79,
   "end": 931.07,
   "text": "فرمودن یک نشانه‌ای تو صورت این شخص هست، تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 931.07,
   "end": 934.43,
   "text": "وجهش، وجاهتش، صورتش، پیشانی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 934.43,
   "end": 936.71,
   "text": "یک صورتی هست معلومه این جهنمی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 936.71,
   "end": 940.61,
   "text": "این یعنی چی؟ آقا اهل نجات شد اومد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 940.61,
   "end": 942.43,
   "text": "چگونه‌ست که معلومه جهنمی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 942.43,
   "end": 947.41,
   "text": "همینه. اشاره به همین بدن برزخی دارد که هنوز همون شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 947.41,
   "end": 949.87,
   "text": "منتها آوردنش بیرون از اون عذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 949.87,
   "end": 956.45,
   "text": "یه مقدار راحتش کردن. بعد این شخص که بعد که بین بهشتی‌ها حرکت می‌کنه همه می‌شناسنش با انگشت نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 956.45,
   "end": 960.29,
   "text": "این صریح روایته. یعنی بدن برزخیش همون شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 960.29,
   "end": 965.27,
   "text": "اعمالش بوده. موجوده بالاخره این گناهانی کرد موجود هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 965.27,
   "end": 968.31,
   "text": "می‌شه یه چیزی، یک موجودی عدم بشه، نیست بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 968.31,
   "end": 973.75,
   "text": "نمی‌شه که. هست. التماس می‌کنه، استغاثه می‌کنه به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 973.75,
   "end": 979.71,
   "text": "حتی یک روایت دیدم که بعد از هزار سال یه نفر یهو یاد حضرت زهرا میفته، یادش میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 979.71,
   "end": 984.67,
   "text": "میگه یا زهرا. این استهالة رخ میده، تبدیل و تحول رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 984.67,
   "end": 990.79,
   "text": "عجیبه این روایات. روایات معراج مرحوم مجلسی رو بخونید غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 990.79,
   "end": 994.93,
   "text": "خستتون نکنم. خلاصه مطلب اینکه بعد خدا چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 994.93,
   "end": 998.65,
   "text": "به شفاعت اهل بیت اون نشانه رو از صورت اون ورمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 998.65,
   "end": 1001.21,
   "text": "یعنی چی؟ یعنی بدن رو استهالة می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1001.21,
   "end": 1004.07,
   "text": "بدن، چهره‌ش عوض می‌شه. مثلاً چهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1004.07,
   "end": 1007.39,
   "text": "بهشتی پیدا می‌کنه. تمام شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1007.39,
   "end": 1009.59,
   "text": "باز طرف دچار عذاب وجدانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1009.59,
   "end": 1012.21,
   "text": "وجدان که نمی‌میره. اذیت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1012.21,
   "end": 1015.17,
   "text": "قاطی بهشتی‌هاست اما خاطرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1015.17,
   "end": 1018.75,
   "text": "جهنم، خاطرات گناهانش اذیتش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1018.75,
   "end": 1020.97,
   "text": "چون اونجا هم قوه خیال داریم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1020.97,
   "end": 1024.95,
   "text": "اونجا عالم مثال دیگه. اصلاً عینیّت قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1024.95,
   "end": 1028.45,
   "text": "برزخه و مثال متصل تو وجود خود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1028.45,
   "end": 1030.83,
   "text": "و اونجا اذیت می‌شه، به مرتبه استغاثه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1030.83,
   "end": 1033.73,
   "text": "به شفاعت آل الله چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1033.73,
   "end": 1036.87,
   "text": "خدا عجیب، عجیب، ارحم الراحمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1036.87,
   "end": 1043.13,
   "text": "خدای منّان، خاطرات جهنم و خاطرات گناه رو هم از او محو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1043.13,
   "end": 1046.09,
   "text": "دیگه راحت می‌شه. دیگه در علم الهی می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1046.09,
   "end": 1051.49,
   "text": "لذا بزرگان اهل معرفت، این جمله آخر منو اهل عرفان توجه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1051.49,
   "end": 1054.11,
   "text": "ما که اهلش نبودیم ان‌شاءالله شما هستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1054.11,
   "end": 1058.07,
   "text": "که بزرگان اهل معرفت که تالی تلب معصوم می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1058.07,
   "end": 1061.15,
   "text": "گناه ازشون سر نمی‌زنه. برای چی گریه می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1061.15,
   "end": 1063.93,
   "text": "برای این علم الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1063.93,
   "end": 1067.59,
   "text": "علمی که خدا از ذهن‌ها پاک می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1067.59,
   "end": 1072.19,
   "text": "از ذهن‌ها حتی از ذهن خود طرف و حتی ملائکه و حتی اولیاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1072.19,
   "end": 1075.73,
   "text": "اما در علم خودش باقی خواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1075.73,
   "end": 1079.19,
   "text": "به این گریه می‌کنند. ان‌شاءالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1079.19,
   "end": 1082.25,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1082.25,
   "end": 1087.05,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 287,
   "start": 1087.05,
   "end": 1090.73,
   "text": "صلي على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}