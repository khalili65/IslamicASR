 "chapters": [
  {
   "index": 0,
   "title": "## میلاد اباالفضل و مرحلهٔ حلقوم",
   "start": 29.96,
   "end": 120.48
  },
  {
   "index": 1,
   "title": "مراحل شش‌گانهٔ موت را بررسی می‌کنیم. مرتبهٔ چهارم را حلقوم می‌گویند؛ برگرفته از آیات هشتاد و سه تا هشتاد و پنج واقعه:",
   "start": 120.48,
   "end": 238.04
  },
  {
   "index": 2,
   "title": "## فتنة الممات و حضور شیاطین",
   "start": 238.04,
   "end": 439.38
  },
  {
   "index": 3,
   "title": "## تمثل شیطان و ملکات نفس",
   "start": 439.38,
   "end": 487.28
  },
  {
   "index": 4,
   "title": "## تلقین، تجسم اعمال، عطر خاطره",
   "start": 487.28,
   "end": 886.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 10.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.44,
   "end": 14.68,
   "text": "السلام علیک یا...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.68,
   "end": 17.86,
   "text": "السلام علیک حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.86,
   "end": 23.6,
   "text": "تصلی وتغنت السلام علیک حین تحمد وتستغفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.6,
   "end": 28.68,
   "text": "السلام علیکم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.68,
   "end": 33.12,
   "text": "تبریک عرض میکنم امروز رو روز میلاد باب الحوائج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.12,
   "end": 39.26,
   "text": "حضرت اباالفضل، پدر همه فضیلت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.26,
   "end": 42.76,
   "text": "متاسفانه کم پیش میاد که ما به این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.76,
   "end": 45.72,
   "text": "توسل کنیم بابت مسائل معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.72,
   "end": 48.54,
   "text": "بیشتر امورات دنیوی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.54,
   "end": 50.86,
   "text": "مادی و مریضی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.86,
   "end": 55.44,
   "text": "مسائل ظاهری. میگیم باب الحوائج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.44,
   "end": 59.44,
   "text": "خب مطلب الحوائج یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.44,
   "end": 62.32,
   "text": "حاجات بزرگ ما عاقبت بخیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.32,
   "end": 66.9,
   "text": "چون چهارشنبه‌ها بحث ما بحث موته و رسیدیم به روایت دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.9,
   "end": 70.32,
   "text": "از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.32,
   "end": 73.06,
   "text": "من خواهش می‌کنم که این مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.06,
   "end": 76.12,
   "text": "از موت رو خوب امروز توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.12,
   "end": 79.26,
   "text": "توسل به حضرت اباالفضل کنیم برای این مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.26,
   "end": 81.9,
   "text": "یکی از سخت‌ترین مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.9,
   "end": 87.34,
   "text": "موته که بیداد میکنه شک در اون لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.34,
   "end": 92.4,
   "text": "چون روایت چهارم هم پیرامون شک بود روایت دهم در باب چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.4,
   "end": 95.9,
   "text": "ما داریم مراحل شش گانه موت رو بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.9,
   "end": 98.24,
   "text": "مرتبه چهارم رو بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.24,
   "end": 102.06,
   "text": "میگن مرتبه حلقوم، الحلقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.06,
   "end": 104.82,
   "text": "برگرفته شده از آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.82,
   "end": 108.22,
   "text": "هشتاد و سه تا هشتاد و پنج سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.22,
   "end": 111.2,
   "text": "واقعه است. فلولا اذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.2,
   "end": 113.74,
   "text": "بلغت الحلقوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.74,
   "end": 117.14,
   "text": "وقتی که رسید جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.14,
   "end": 120.04,
   "text": "به حلق، به این حلق‌ها رسید؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.04,
   "end": 123.02,
   "text": "گفتیم که مرحله سوم زیر حلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.02,
   "end": 128.72,
   "text": "هنوز به حلق نرسیده، گردنه حالت طراقیه بهش میگن مرحله سوم موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.72,
   "end": 131.48,
   "text": "مرگ رسیده به طراقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.48,
   "end": 136.52,
   "text": "و این استخوان‌های سینه میخواد بیاد از اینجام بالا بره از گلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.52,
   "end": 141.76,
   "text": "از گردن خارج شه روح بیاد برسه به حلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.76,
   "end": 146.04,
   "text": "در مرتبه چهارم میگه که فلولا اذا بلغت الحلقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.04,
   "end": 149.5,
   "text": "میفرماید وقتی جان رسید به حلقشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.5,
   "end": 152.02,
   "text": "و انتم حينئذ تنظرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.02,
   "end": 155.56,
   "text": "شما اون لحظه دارید نگاشون می‌کنین، نگاه می‌کنید اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.56,
   "end": 158.18,
   "text": "این آقایی که داره این خانمی که داره میمیره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.18,
   "end": 163.84,
   "text": "نگاه می‌کنین. و نحن اقرب الیه منکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.84,
   "end": 169.76,
   "text": "خیلی عجیبه ما و ما از شما به اون نزدیک‌تریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.76,
   "end": 173.58,
   "text": "ولکن لا تبصرون شما نمی‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.58,
   "end": 177.8,
   "text": "نحن اقرب الیه من حبل الورید دیگه ما از رگ گردن نزدیک‌تریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.8,
   "end": 181.92,
   "text": "هو معکم أينما كنتم او با شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.92,
   "end": 188.6,
   "text": "هر کجا باشید. خیلی جا یکی از بحث‌های توحید صمدی همین آیه است اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.6,
   "end": 193.2,
   "text": "توحید صمدی که یک وجود واحد بقیه اطوار این وجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.2,
   "end": 197.22,
   "text": "عالم اطوار وجودی حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.22,
   "end": 200.4,
   "text": "یک طور خدا همه عالم ظاهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.4,
   "end": 203.74,
   "text": "که به منزله بدن است برای اون نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.74,
   "end": 206.8,
   "text": "خدا هم نفس داره. اللهم عرفنی نفسك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.8,
   "end": 209.0,
   "text": "این عالم به منزله بدن اون نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.0,
   "end": 213.16,
   "text": "عالم، کائنات، اینم نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.16,
   "end": 217.08,
   "text": "اون لحظه‌ای که انسان میفته تو مرحله چهارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.08,
   "end": 221.68,
   "text": "اون لحظه اینو درک می‌کنه که و نحن اقرب الیه منکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.68,
   "end": 224.64,
   "text": "متاسفانه اون لحظه ما درک می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.64,
   "end": 228.12,
   "text": "که دیگه جون اومده تا حلق دیگه حلق‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.12,
   "end": 231.26,
   "text": "یعنی زبان از کار میفته اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.26,
   "end": 236.86,
   "text": "و دیگه هرچی تلقینش می‌کنن نمی‌تونه دیگه حرف بز لال شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.86,
   "end": 241.6,
   "text": "و چند تا اتفاق خیلی خطرناک اینجا میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.6,
   "end": 245.34,
   "text": "شاید شنیده باشید گفتن پناه ببریم به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.34,
   "end": 248.62,
   "text": "از فتنت الممات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.62,
   "end": 252.98,
   "text": "این عبارتو هم شنیدید یا نه؟ فتنت الممات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.98,
   "end": 256.0,
   "text": "اشاره به همین لحظه، به همین مرحله موت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.0,
   "end": 258.84,
   "text": "یعنی چی فتنت الممات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.84,
   "end": 264.02,
   "text": "اجازه بدید این رو هم به استناد به آیات قرآن بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.02,
   "end": 268.5,
   "text": "مثلاً آیه بیست و هفت و بیست و هشت سوره مؤمنون رو ملاحظه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.5,
   "end": 271.36,
   "text": "میفرماید و قل بگو ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.36,
   "end": 273.56,
   "text": "پروردگار من اعوذ بک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.56,
   "end": 277.24,
   "text": "من به تو پناه می‌برم من همزات الشياطين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.24,
   "end": 280.62,
   "text": "این همزات الشياطين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.62,
   "end": 283.86,
   "text": "چیه این وسوسه‌هایی که شیاطین می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.86,
   "end": 289.42,
   "text": "و برا کیه؟ و اعوذ بک باز تاکید می‌کنه بگو پناه می‌برم به تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.42,
   "end": 292.56,
   "text": "ربه پروردگار من ای یحضرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.56,
   "end": 294.7,
   "text": "اون لحظه‌ای که این شیاطین چی میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.7,
   "end": 299.26,
   "text": "حاضر میشن. شیاطین حاضر میشن مال این مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.26,
   "end": 302.38,
   "text": "مال مرحله بلغت الحلقومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.38,
   "end": 304.58,
   "text": "فتنت الممات اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.58,
   "end": 306.26,
   "text": "یعنی چی؟ چرا فتنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.26,
   "end": 308.98,
   "text": "آزمایش چه آزمایش بزرگیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.98,
   "end": 314.42,
   "text": "که میگن پناه ببریم؟ آقا امروز که روز میلاد آقا قمر بنی هاشمه توسل کنیم به حضرت اباالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.42,
   "end": 316.14,
   "text": "برای نجات از این مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.14,
   "end": 319.8,
   "text": "خودم رو عرض می‌کنم. خیلی مرحله خطرناکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.8,
   "end": 323.22,
   "text": "آیه شونزده سوره هشت باز اشاره به همین داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.22,
   "end": 327.32,
   "text": "که اون فتنه چیه؟ کمثل الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.32,
   "end": 332.64,
   "text": "اذ قال مثل مثلی که خدا داره میاره برای تفهیم موضوع میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.64,
   "end": 336.3,
   "text": "وقتی که میگه شیطان للانسان به انسان میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.3,
   "end": 339.78,
   "text": "اکفر اذ قال للان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.78,
   "end": 342.9,
   "text": "انسان اکفر کافر شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.9,
   "end": 345.72,
   "text": "کف بیار، ببر. برای کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 345.72,
   "end": 350.06,
   "text": "ای یحضرون. وقتی که شیاطین حاضر شدن مال همین مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.06,
   "end": 353.68,
   "text": "فلما کفر اگه کافر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.68,
   "end": 356.22,
   "text": "اون لحظه، حالا عرض می‌کنم به چه نحوی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.22,
   "end": 358.78,
   "text": "روایات این رو فرمودن به چه نحوی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 358.78,
   "end": 361.24,
   "text": "اگر کافر شد چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.24,
   "end": 363.2,
   "text": "قال انی بریء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.2,
   "end": 365.26,
   "text": "شیطان میگه انی بریء منك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 365.26,
   "end": 369.06,
   "text": "من از تو بیزارم. من شیطان از تو بیزارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.06,
   "end": 372.84,
   "text": "\"إني أخاف الله رب العالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.84,
   "end": 375.04,
   "text": "من می‌ترسم از پروردگار عالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 375.04,
   "end": 377.76,
   "text": "بله، او هم \"رب بما أغویتني\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.76,
   "end": 381.36,
   "text": "رب یعنی ربی. یعنی اه قائل به ربوبیت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 381.36,
   "end": 386.68,
   "text": "بی‌تربیتی کرد، بی‌ادبی کرد، نگاهش غلط بود اما ربوبیت حق رو قبول داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.68,
   "end": 391.96,
   "text": "لذا می‌گه اون کسی که سجده در برابر حق نمی‌کنه از شیطان پست‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.96,
   "end": 395.06,
   "text": "شیطان حاضر نشد در برابر مخلوق سجده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.06,
   "end": 397.58,
   "text": "تو در برابر حق سجده نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 397.58,
   "end": 400.26,
   "text": "حالا این چه می‌کنه که فتنه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 400.26,
   "end": 408.06,
   "text": "فرمودن که تمامه چون اونجا شیطان می‌بینه قابض الارواح داره نزدیک می‌شه به شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 408.06,
   "end": 410.24,
   "text": "جونشو گرفته داره رسیده به حلقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.24,
   "end": 414.34,
   "text": "دیگه کارش تمومه. صد درصد دیگه چنین کسی کارش تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 414.34,
   "end": 421.0,
   "text": "چون این، این علم رو داره تمام قواش رو مصرف می‌کنه بر اینکه طرف رو کافر از دنیا ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 421.0,
   "end": 422.6,
   "text": "و باورهاشو ازش بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.6,
   "end": 426.74,
   "text": "نسبت به خدا، پیغمبر، قرآن، دین، آیین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.74,
   "end": 430.82,
   "text": "و خیلی عجیب طبق روایات من یه چیز عجیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.82,
   "end": 435.58,
   "text": "براتون بگم. این‌ها روایات مقفول‌مانده شده و کمتر گفته شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 435.58,
   "end": 438.12,
   "text": "بیشتر رجایی حرف می‌زنیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 438.12,
   "end": 443.08,
   "text": "خیلی بترسین. یکی از کارهای عجیب شیطان که خدا هم این قدرت رو بهش داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 443.08,
   "end": 446.16,
   "text": "تمثلاتیه که برای من و شما میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.16,
   "end": 448.62,
   "text": "عجب! یعنی تمثل غیرواقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.62,
   "end": 453.32,
   "text": "چگونه؟ چون اون شخصی که تو این حالت قرار گرفته، حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.32,
   "end": 457.76,
   "text": "معاینه است، هم اینورو می‌بینه هم اونورو، بقیه فقط اینجا رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.76,
   "end": 460.42,
   "text": "بقیه که نشستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.42,
   "end": 463.52,
   "text": "دارن نگاه می‌کنن فقط این جایگاه‌ها رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.52,
   "end": 465.86,
   "text": "چیزی متوجه نمی‌شن اما اون دو تاشو داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 465.86,
   "end": 467.94,
   "text": "هم جایگاه ابدی رو هم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.94,
   "end": 471.94,
   "text": "فانی رو و می‌بینه ملائکه رو، شیطان و همنو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 471.94,
   "end": 480.74,
   "text": "یک دفعه چشمش باز شده بر اساس آیه بیست و دو قاف \"فکشفنا عنک غطاءک فبصرک اليوم حدید\" مال این لحظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 480.74,
   "end": 483.46,
   "text": "پرده افتاده. دیگه قشنگ داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 483.46,
   "end": 486.02,
   "text": "اونجا شیطان تمثل میاره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 486.02,
   "end": 491.28,
   "text": "چگونه؟ مثلا یکی از انبات این شخص که از دنیا رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 491.28,
   "end": 494.82,
   "text": "، اون لحظه تبانی می‌کنند دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 494.82,
   "end": 498.24,
   "text": "و این تمثلی، مثالی، مثلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 498.24,
   "end": 501.44,
   "text": "قیافه‌ای، صورتی، شکلی از اون انشاء می‌کنه شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 501.44,
   "end": 504.78,
   "text": "این قدرت رو داره. انشاء می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 504.78,
   "end": 510.54,
   "text": "که مثلاً یه عزیزی که از تو، از دو، از دست، از تو از دنیا رفته، ولا آدم خوبی هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.54,
   "end": 513.14,
   "text": "شیطان انشاء صورت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 513.14,
   "end": 515.16,
   "text": "و ظاهراً بدل انشایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 515.16,
   "end": 518.52,
   "text": "یعنی یک انشاء یک بدل کالبدی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 518.52,
   "end": 520.7,
   "text": "اون شخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 520.7,
   "end": 524.46,
   "text": "بعد داد می‌زنه، فریاد می‌زنه سر تویی که داری می‌میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 524.46,
   "end": 526.54,
   "text": "دور از جون شما، خود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 526.54,
   "end": 529.42,
   "text": "بر سر من که دارم می‌میرم می‌گه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 529.42,
   "end": 531.3,
   "text": "شهادتین رو بر لسانت جاری نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 531.3,
   "end": 537.0,
   "text": "این‌ها همه دروغه. من اومدم این دنیا دیدم دینی نیست، پیغمبری نبوده، قرآن اینا همش دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 537.0,
   "end": 541.34,
   "text": "شروع می‌کنه داد و فریاد. روایت می‌گه داد می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.34,
   "end": 543.66,
   "text": "این خودش سره درش. چرا داد می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 543.66,
   "end": 547.02,
   "text": "چرا آروم نمیگه؟ خودش می‌خواد مشوش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 547.02,
   "end": 550.84,
   "text": "اون قوه خیال طرف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 550.84,
   "end": 554.88,
   "text": "مضطربش کنه. در اضطراب آدم تصمیم غلط می‌گیره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 554.88,
   "end": 557.4,
   "text": "خیلی لحظه عجیبیه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 557.4,
   "end": 561.94,
   "text": "و اون چیزی که اونجا قربونتون برم به داد ما می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 561.94,
   "end": 564.6,
   "text": "، اون ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 564.6,
   "end": 566.76,
   "text": "توجه بفرمایید اینجا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 566.76,
   "end": 571.44,
   "text": "حالا اینجا حرف خیلی داریم ولی چون قبلاً گفتیم دیگه الان می‌فهمیم راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 571.44,
   "end": 578.74,
   "text": "ملکات نفس یعنی ملکه شده، رسوخ کرده در وجود من و من به اون‌ها عادت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 578.74,
   "end": 583.62,
   "text": "اونا به داد آدم می‌رسه. اگر عادت به معنویات داشتم، ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 583.62,
   "end": 588.18,
   "text": "نه عادت نه به معنای اینکه نمی‌فهمه چیکار داره می‌کنه، اونو نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 588.18,
   "end": 591.06,
   "text": "عادت معنا داری، یعنی ملکه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 591.06,
   "end": 599.44,
   "text": "گفتیم صور و اشکال برزخی یعنی اونچه که ما باهاش حشر و نشر داریم و می‌بینیم و می‌چشیم و میش-می‌شنویم و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.44,
   "end": 601.14,
   "text": "همش بذرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 601.14,
   "end": 604.58,
   "text": "ملکات نفسه. به چی عادت کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 604.58,
   "end": 607.34,
   "text": "به چه کارهایی؟ چه باورهایی داری اونا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 607.34,
   "end": 609.2,
   "text": "اون‌ها ملکات نفسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 609.2,
   "end": 611.62,
   "text": "اون خودش رو نشون می‌ده اون لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 611.62,
   "end": 618.04,
   "text": "اگه-- اصلاً دیگه اینجا بحث زبان و زبان ظاهری و اینا اصلاً از کار افتاده، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.04,
   "end": 623.66,
   "text": "توجه کردید و اون تلقینی هم که این لحظه وارد شده بگید اولین تلقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 623.66,
   "end": 629.8,
   "text": "کمک حال توئه برای یه به‌روزرسانی، یه یادآوری، یادت بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 629.8,
   "end": 632.02,
   "text": "یعنی از کمون ذاتت اینو بکشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.02,
   "end": 637.5,
   "text": "یه دفعه یه تلنگری. چون حالت بی‌هوشی اتفاق افتاده، اولین باره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 637.5,
   "end": 640.58,
   "text": "خدا به داد کسی برسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.58,
   "end": 644.02,
   "text": "نمرده و می‌میره. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 644.02,
   "end": 645.88,
   "text": "یعنی درک موت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.88,
   "end": 648.1,
   "text": "سفر از ظاهر به باطن نکرده تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 648.1,
   "end": 650.36,
   "text": "موت قبلاً تا موت براش رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 650.36,
   "end": 652.6,
   "text": "اصلاً نمی‌فهمه این حرفو. یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 652.6,
   "end": 658.24,
   "text": "یک رخداد عظیمی. آقا چگونه‌ست که یکی از عزیزترین کسش یه دفعه می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 658.24,
   "end": 661.2,
   "text": "این هم سکته می‌زنه. اصلاً لال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 661.2,
   "end": 662.9,
   "text": "دیدی می‌گه آقا بزن تو صورتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 662.9,
   "end": 665.98,
   "text": "این لال شده. اصلاً گریه هم نمی‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 665.98,
   "end": 669.5,
   "text": "دیدید این حالاتو تو بعضیا؟ یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 669.5,
   "end": 673.78,
   "text": "یه چه عرض کنم، یه ضربه‌ای، یه تکانه‌ای به وجودش وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 673.78,
   "end": 676.7,
   "text": "خواج و واج. اصلاً نمی‌دونه چیکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 676.7,
   "end": 680.4,
   "text": "خودش هم مثل اون بچه‌ای که طفلی تو غزه ترسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 680.4,
   "end": 682.5,
   "text": "اصلاً مونده بود چیکار کنه. نمی‌تونست گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 682.5,
   "end": 686.28,
   "text": "امدادگره بغلش کرد که این گریه کنه، کمکش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 686.28,
   "end": 688.64,
   "text": "اصلاً گریه هم نمی‌تونی بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 688.64,
   "end": 690.92,
   "text": "این تو این دنیاش پیش میاد. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 690.92,
   "end": 693.22,
   "text": "یه تکانه عجیبی به وجودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 693.22,
   "end": 694.92,
   "text": "یه رخداد عظیمی رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 694.92,
   "end": 697.38,
   "text": "یه اتفاقه، یه خبری. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 697.38,
   "end": 704.3,
   "text": "خبر عظیم اونجاست. یه دفعه آدم مواجه می‌شه با چیزی که الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 704.3,
   "end": 711.14,
   "text": "نکته‌ی بعدی و آخر که حالا اینجا اتفاقات زیادی میفته، من قصدم بر اجمال‌گویه، نه تفصیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 711.14,
   "end": 713.38,
   "text": "اینو باید بگم بعد سؤال شما رو ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 713.38,
   "end": 715.26,
   "text": "اون هم تجسم اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 715.26,
   "end": 721.8,
   "text": "آآآه ببینید تجسم اعمال که البته ریشه در روایات به اسم تجسم ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.8,
   "end": 725.66,
   "text": "تمثل داریم اما تجسم همون تمثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 725.66,
   "end": 730.1,
   "text": "خیلی هم شیرین. علامه خیلی تشکر می‌کنه از اون اولین کسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 730.1,
   "end": 732.96,
   "text": "فهم هم می‌کنه که این کی بوده این رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 732.96,
   "end": 734.82,
   "text": "کاملاً تطابق با روایات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 734.82,
   "end": 737.9,
   "text": "تجسم اعمال. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 737.9,
   "end": 742.46,
   "text": "جسمیتی از اعمال اونجا خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 742.46,
   "end": 746.6,
   "text": "هرچی کردی از اول تا آخر عمرت همش انگار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 746.6,
   "end": 749.56,
   "text": "همه رو یکبارچه نتیجه‌شو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 749.56,
   "end": 752.18,
   "text": "که خودت هستی. هرچه هستی خودت هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 752.18,
   "end": 754.02,
   "text": "کتاب وجود خودت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 754.02,
   "end": 758.04,
   "text": "\"اقرأ كتابك كفى بنفسك اليوم عليك حسيباً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 758.04,
   "end": 762.62,
   "text": "این تجسم اعمال از سنگین‌ترین مراحل موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 762.62,
   "end": 766.96,
   "text": "و اون باورها، باورهای درونی، اون چیزی که در وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 766.96,
   "end": 770.28,
   "text": "ریشه دوانده در مکمن غیبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 770.28,
   "end": 774.08,
   "text": "اون اونجا به دادت می‌رسه. اگر ذاتت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 774.08,
   "end": 780.68,
   "text": "ذاتت میگه علی، اونجا امیر-- می‌تونی بگی جانم علی و امیرالمؤمنین بیاد به دادت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 780.68,
   "end": 788.06,
   "text": "اما اگر ذاتت فطرت ثانویه پیدا کردی تبدیل به جبلی شده \"و لقد أضلل منكم جبلاً كثيرا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 788.06,
   "end": 791.68,
   "text": "شیطان بسیاری رو از این جبلی‌شون یعنی فطرت ثانویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 791.68,
   "end": 795.12,
   "text": "گمراه می‌کنه یعنی بوی بد میده وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 795.12,
   "end": 799.16,
   "text": "هرچی می‌خوای زور بزنی بوی خوش استشمام، استشمام کنی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 799.16,
   "end": 801.2,
   "text": "بوی بده. مثلاً عادته به گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 801.2,
   "end": 804.48,
   "text": "اگه عطر تیروز چون زمانه من بگم تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 804.48,
   "end": 809.56,
   "text": "و سؤال عزیزمون رو جواب بدم. زمان جنگ عطر تیروز می‌زدیم ماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 809.56,
   "end": 812.92,
   "text": "تیروز همیشه امام هم می‌زد از امام یاد گرفته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 812.92,
   "end": 818.54,
   "text": "تمام خاطرات جوانی بنده، جنگ و جبهه همینا همه با عطر تیروز اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 818.54,
   "end": 823.58,
   "text": "عجين شده. اخیراً خب مدتی بود نمی‌زدیم، پیدا نمی‌کردم اصلاً دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 823.58,
   "end": 827.76,
   "text": "این اصلش نیست. یه عزیزی از بچه‌های سازمان به ما هدیه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 827.76,
   "end": 834.1,
   "text": "باور کنید اصلاً اینو زدم نمی‌دونید چه حال و چه دگرگونی‌ای در من ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 834.1,
   "end": 836.94,
   "text": "تمام خاطرات مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 836.94,
   "end": 839.22,
   "text": "ده بیست ساله سی ساله زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 839.22,
   "end": 841.44,
   "text": "جوونیم یه دفعه اومد تو وجودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 841.44,
   "end": 846.0,
   "text": "اصلاً نمی‌دونم چجوری برای شما اینا رو تمثیل بدم که بتونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 846.0,
   "end": 849.3,
   "text": "چه ب-به ضرب من البيان به چه بیانی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 849.3,
   "end": 851.3,
   "text": "اون لحظه تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 851.3,
   "end": 854.12,
   "text": "زندگیت یه دفعه درکش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 854.12,
   "end": 857.24,
   "text": "این خاطره اگر خوشه، بهشتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 857.24,
   "end": 862.94,
   "text": "بفرمایید شما بهشتید. اگر العیاذ بالله جهنمه و بوی بد میده جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 862.94,
   "end": 866.2,
   "text": "ان‌شاءالله خدا هممون رو به حق حضرت اباالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 866.2,
   "end": 870.96,
   "text": "باب الحوائج سلام الله عليه از این مرحله، مرحله چهارم و خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 870.96,
   "end": 873.76,
   "text": "س-- خطرناک و خطیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 873.76,
   "end": 878.36,
   "text": "موت نجات بده و در پناه رحمت خودش بگیره صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 878.36,
   "end": 881.4,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 881.4,
   "end": 886.2,
   "text": "محمد و آل محمد و عجل فرجهم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}