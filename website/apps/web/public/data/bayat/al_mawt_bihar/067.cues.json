 },
 "chapters": [
  {
   "index": 0,
   "title": "## آیات باب فرار از موت و حب لقاء",
   "start": 13.96,
   "end": 171.1
  },
  {
   "index": 1,
   "title": "## فراریان جنگ و دفع موت",
   "start": 171.1,
   "end": 304.04
  },
  {
   "index": 2,
   "title": "آیهٔ هفتاد و هشتم نساء — که مجلسی آورده — می‌فرماید:",
   "start": 304.04,
   "end": 415.9
  },
  {
   "index": 3,
   "title": "## سورهٔ جمعه و بازگشت به عالم غیب",
   "start": 415.9,
   "end": 525.74
  },
  {
   "index": 4,
   "title": "## واحد شمارش عمر: نفس",
   "start": 525.74,
   "end": 546.0
  },
  {
   "index": 5,
   "title": "## حکایت لیست مرگ",
   "start": 546.0,
   "end": 808.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.1,
   "end": 6.18,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.18,
   "end": 9.26,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 13.96,
   "text": "و ربانی یا ای یوسف سلامنا علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.96,
   "end": 19.34,
   "text": "در باب چهارم کتاب الموت مرحوم مجلسی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.34,
   "end": 21.7,
   "text": "عرض کردیم که مقدمه این باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.7,
   "end": 25.7,
   "text": "مرحوم مجلسی چند تا آیات رو آورده و تفسیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.7,
   "end": 27.68,
   "text": "البته بنای ما اون روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.68,
   "end": 33.84,
   "text": "در روایت اول ورود کردیم که تمنای موت بود و ربطش به یهود رو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.84,
   "end": 38.42,
   "text": "و اینها بعد حالا دلمون نیومد از این آیات هم بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.42,
   "end": 45.16,
   "text": "بخوایم رو این آیات توقف کنیم خودش چندین جلسه میشه فقط تبرکاً بگیم چه آیاتی رو حالا آیه هفت و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.16,
   "end": 48.46,
   "text": "سوره یونس رو که گفتیم نکاتی رو هم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.46,
   "end": 54.22,
   "text": "آیاتی که در این خصوص آورده مرحوم مجلسی چون باب چهارم پیرامون فرار از موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.22,
   "end": 56.54,
   "text": "حب لقای خدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.54,
   "end": 60.72,
   "text": "یکی دیگه از آیات آیه صد و چهل و سه سوره آل عمرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.72,
   "end": 64.72,
   "text": "که میفرماید و لقد کنتم تمنون الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.72,
   "end": 68.9,
   "text": "من قبل. میفرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.9,
   "end": 73.64,
   "text": "شما وقتی که دستور جهاد اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.64,
   "end": 76.12,
   "text": "قبل از اینکه دستور جهاد بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.12,
   "end": 80.88,
   "text": "کنتم تمنون الموت تمنای موت می‌کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.88,
   "end": 84.24,
   "text": "به صورت ظاهری خدا ما عاشق شهادت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.24,
   "end": 87.32,
   "text": "ما عاشق موتیم. کجایی موت در اختیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.32,
   "end": 90.66,
   "text": "ما رو مثلا در آغوشت بگیریم و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.66,
   "end": 93.88,
   "text": "ان تلقوه فقط رایتموها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.88,
   "end": 96.14,
   "text": "حالا که دارید نگاش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.14,
   "end": 99.36,
   "text": "بسم الله پیغمبر داره میفرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.36,
   "end": 107.48,
   "text": "حالا که الان اومده یعنی الان ما رو پیش از جهاد ادعا می‌کردید ما پیش کسوت خون و شهادت و فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.48,
   "end": 111.18,
   "text": "مثل اینایی که ادعا می‌کنند ما، ما نوکر این ملتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.18,
   "end": 114.04,
   "text": "ما اصلا اومدیم خدمت کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.04,
   "end": 118.94,
   "text": "چونکه همه میگن همه ادعاها گوش فلک رو کر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.94,
   "end": 121.78,
   "text": "ما اصلا اومدیم برای خدمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.78,
   "end": 123.82,
   "text": "خب حتما خدمت پشت میز نشستنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.82,
   "end": 127.28,
   "text": "حتما مدیرکل شدنه. حتما مدیر فلان شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.28,
   "end": 131.6,
   "text": "الـ- الحمدالله مدیرای خادم هم زیاد داریم بلکه خدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.6,
   "end": 134.32,
   "text": "بر وزن فعول یعنی واقعا خادمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.32,
   "end": 139.22,
   "text": "هستن که واقعا این مد- مدیرای خوب آدم اینا باید دستشونو ببوسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.22,
   "end": 144.86,
   "text": "چون انقدر مدیر بد آدم میبینه یه چند تا خوبم که میبینه میگه واقعا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.86,
   "end": 147.44,
   "text": "خیلی اینکه خودشونو گم نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.44,
   "end": 151.02,
   "text": "خلاصه اینا ادعا می‌کردن ما پیشکسوت جهاد و شهادت و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.02,
   "end": 154.72,
   "text": "خب پیغمبر بر اساس این آیه میفرماید بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.72,
   "end": 158.74,
   "text": "فقط رایتموها حالا که دیدید موت رو الان بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.74,
   "end": 161.64,
   "text": "بفرمایید میدون مین. و انتم تنظرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.64,
   "end": 165.78,
   "text": "حالا وایسید نگاه می‌کنید. این یه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.78,
   "end": 168.26,
   "text": "حالا چقدر میشه درباره‌ش صحبت کرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.26,
   "end": 171.1,
   "text": "تو خود حدیث مفصل بخوان از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.1,
   "end": 178.62,
   "text": "آیه صد و شصت و هشت آل عمران میفرماید الذین قالوا لاخوانهم و قعدوا لو اطاعونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.62,
   "end": 183.18,
   "text": "یه عده بودن که از جنگ فرار کرده بودن به اینا به بر- به اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.18,
   "end": 185.22,
   "text": "حرف اینا رو گوش نداده بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.22,
   "end": 187.12,
   "text": "تو جنگ اهوز رفته بودن شهید شده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.12,
   "end": 192.92,
   "text": "اینا میگن اگه اینا حرف ما رو گوش می‌دادن لو اطاعونا اطاعت ما رو می‌کردن ما قتلوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.92,
   "end": 199.0,
   "text": "اینا کشته نمی‌شدن. قل بهشون بگو فدرءوا عن انفسکم الموت ان کنتم صادقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.0,
   "end": 201.7,
   "text": "چجوری می‌خواید موت رو دفع کنید از خودتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.7,
   "end": 206.62,
   "text": "اگه راست میگید الان مثلا نرفتید جنگ به قول خودتون کشته نشدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.62,
   "end": 211.54,
   "text": "بالاخره که میاد بالاخره که موت میگن قدیم‌ها می‌گفتن شتریه که در خونه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.54,
   "end": 220.54,
   "text": "می‌خوابه. تو جالبه که تو بسیج مسجد خود ما شاهد بودم بچه‌های علیه السلام مقدس صف اولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.54,
   "end": 223.58,
   "text": "که از ص نماز از امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.58,
   "end": 227.84,
   "text": "اون من بچه بودم اون موقع مسجد ما که توی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.84,
   "end": 234.88,
   "text": "جاهای نظامی کار می‌کرد نامه گرفتن که مثلا سربازیشون بیفتن تهران تو منطقه جنگی نیفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.88,
   "end": 238.42,
   "text": "بعد اینا همینا الان دکتر مهندس شدن درس خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.42,
   "end": 242.8,
   "text": "نرفتن جنگ وایسادن درس خوندن الان جاهای رو گرفتن به ادعای خدمت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.8,
   "end": 246.02,
   "text": "آقا ما نوکریم ما می‌خوایم خدمت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.02,
   "end": 253.52,
   "text": "بفرمایین باور کنید گاهی اوقات این آبدارچی اداره می‌بینی از یه مدیرکل بیشتر خدمت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.52,
   "end": 258.26,
   "text": "بارها گفتم خیلی از مدیرها اگه نیان سر کار شاید خیلی کار بهتر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.26,
   "end": 261.16,
   "text": "بارها من اینو گفتم. خیلیاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.16,
   "end": 268.0,
   "text": "نه همشونا. ولی آبدارچی‌ها این تیکش‌ها اینا یه روز نیان گند اداره رو برمی‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.0,
   "end": 273.96,
   "text": "اکرم القوم خادم. گرامی‌ترین هر قومی خادمش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.96,
   "end": 277.02,
   "text": "موت رو باید جدی گرفت. آیه هفتاد و هشت سوره نساء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.02,
   "end": 282.32,
   "text": "اینا رو مرحوم مجلسی آورده. انما تکونوا یدرکمول موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.32,
   "end": 286.1,
   "text": "هر کجا باشید موت شما رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.1,
   "end": 289.98,
   "text": "بالاخره درکتون می‌کنه. و لو کنتم فی بروج مشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.98,
   "end": 292.4,
   "text": "تو کاخ‌های محکم هم که باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.4,
   "end": 295.94,
   "text": "بالاخره موت خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.94,
   "end": 299.98,
   "text": "قدیم‌ها چقدر خوب بود قبرستون‌ها تو شهر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.98,
   "end": 303.94,
   "text": "الان چقدر باید تو جون بکنی تا بری به قبرستونی برسی قبری ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.94,
   "end": 306.42,
   "text": "یا اصلاً قبر می‌کندن تو خونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.42,
   "end": 311.1,
   "text": "من هنوز یادمه که قدیميامون قبر تو خونه‌هاشون می‌کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.1,
   "end": 314.52,
   "text": "با اینکه خیلی سی و پنجاه سالمه ولی هنوز یادمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.52,
   "end": 317.62,
   "text": "ما تو جنگ- یه چیز هیچ‌وقت یادم نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.62,
   "end": 321.54,
   "text": "تازه رفته بودیم ادای مقدس مآب‌ها هم در میاوردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.54,
   "end": 326.5,
   "text": "اینا تو ج- هم- تازه که رفته بودیم جنگ شنیده بودم آقا بچه‌ها میرن مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.5,
   "end": 329.74,
   "text": "دل شب تو قبر می‌خوابن. ما اومدیم ادا درآریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.74,
   "end": 334.12,
   "text": "رفتم ز روز تو بیابون‌های دو کوهه چند تا قبر پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.12,
   "end": 336.6,
   "text": "نشون کردم مثلا سحر بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.6,
   "end": 341.38,
   "text": "باور کنید سحر سراغ هر کدوم از اینا رفتم دیدم پره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.38,
   "end": 349.26,
   "text": ". یکی اون تو خوابیده. یکیشون یه جا رفتم بلند شد اصلاً از وحشت فرار کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.26,
   "end": 353.16,
   "text": ". اینطوری بود. ولی پیدا نمی‌کردی قبر خالی پیدا نمی‌کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.16,
   "end": 356.72,
   "text": "حالا الان تو خونه‌ها سبک زندگی، سبک معماری ما چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.72,
   "end": 359.38,
   "text": "قبر؟ اوف استغفرالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.38,
   "end": 363.68,
   "text": "زبونت رو گاز بگیر. الان باید مثلا جکوزی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.68,
   "end": 365.96,
   "text": "این چیزا تو خونه‌ها بسازن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.96,
   "end": 368.7,
   "text": "اصلا کاملا همه چی تغییر کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.7,
   "end": 375.72,
   "text": "آیه شونزده احزاب \"قل لا ينفعکم الفرار ان فررتم من الموت او القتل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.72,
   "end": 378.02,
   "text": "واذًا لا تمتعن الا قليلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.02,
   "end": 383.96,
   "text": "میگه اگر از مرگ یا کشته شدن فرار می‌کنید هیچ سودی برای حال شما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.96,
   "end": 387.26,
   "text": "مگر یه چند روزی که تا بالاخره برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.26,
   "end": 389.52,
   "text": "یعنی این جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.52,
   "end": 393.4,
   "text": "از توحید، یه بار هم عرض کردم آماری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.4,
   "end": 396.02,
   "text": "گرفتن در کل دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.02,
   "end": 400.74,
   "text": "از توحید باور به مرگ بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.74,
   "end": 405.98,
   "text": "یعنی اون‌هایی که قبول دارن بالاخره آدم می‌میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.98,
   "end": 409.98,
   "text": "می‌شه گفت همه مردم دنیا از هرکی بپرسی میگه بله می‌میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.98,
   "end": 412.28,
   "text": "اما چرا پس تو این وضعته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.28,
   "end": 415.9,
   "text": "چون باور نداره. همش مرگ رو برای همسایه می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.9,
   "end": 420.8,
   "text": "آیه هشت جمعه. چقدر خوبه این آیات رو آدم ببینه هی پشت سر هم بذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.8,
   "end": 424.4,
   "text": "خدا رحمت کنه استاد علی محمد حسن زاده رحم God یه موضوع رو بذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.4,
   "end": 428.74,
   "text": "بشین یه ختم قرآن کن در رابطه با همین موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.74,
   "end": 434.48,
   "text": "تا حالا این کارو کردی؟ من یه بار در خصوص قلب قرآن این کارو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.48,
   "end": 440.8,
   "text": "نشستم قرآن رو کلشو از اول تا آخر در جستجو پیدا کنم قلب در قرآن چند تا اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.8,
   "end": 445.34,
   "text": "و چقدر شیرینه. بعد چیزایی رو می‌بینی که دیگران ندیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.34,
   "end": 451.54,
   "text": "همین آیه بارها تو سوره جمعه حتما خوندید \"قل ان الموت الذي تفرون منه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.54,
   "end": 457.48,
   "text": "این موتی که بهشون بگو ازش \"تفرون منه\" ازش فرار می‌کنید \"فانه ملاقيکم\" بالاخره ملاقاتش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.48,
   "end": 461.54,
   "text": "حالا اون شما رو ملاقات می‌کنه. جالبه اون شما رو ملاقات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.54,
   "end": 467.24,
   "text": "\"ثم تردون الى عالم الغيب والشهادة فينبؤكم بما كنتم تعملون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.24,
   "end": 470.96,
   "text": "بعد خیلی جالبه می‌فرماید \"تردون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.96,
   "end": 474.7,
   "text": "معلومه که ما اونجا بودیم. دوباره داریم ارجاع می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.7,
   "end": 478.64,
   "text": "دوباره بر می‌گردیم. رد می‌شیم به اونجا دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.64,
   "end": 482.04,
   "text": "مثلا از اونجا اومدیم \"انا لله\" قوس نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.04,
   "end": 486.0,
   "text": "و حالا \"انا الیه راجعون\". بر می‌گردیم دوباره به اونجا عالم غیب و شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.0,
   "end": 487.96,
   "text": "اونجا حاکمه، شاهده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.96,
   "end": 491.96,
   "text": "خودش هم ناظر بوده. نیاز به اهدی هم نداره به شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.96,
   "end": 496.66,
   "text": "بسم الله. \"بما كنتم تعملون\" که چه کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.66,
   "end": 499.9,
   "text": "حضرت آیت الله کوهستانی لب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.9,
   "end": 504.42,
   "text": "موتی که از دوستانش می‌خواستن دفنش کنن، فرمود چرا از مرگ اینقدر می‌ترسین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.42,
   "end": 507.84,
   "text": "فرمود اعمالتونه. اگر اونورو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.84,
   "end": 511.4,
   "text": "تدارک کرده باشید برای چی بترسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.4,
   "end": 515.2,
   "text": "چون همش به دنیا رسیدید، اونورو هیچ فکری به حالش نکردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.2,
   "end": 518.94,
   "text": "برای همین می‌ترسید. اصلاً ترس شما از خودتونه، از عمل خودتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.94,
   "end": 527.16,
   "text": "اونور که ترس نداره که. اتفاقاً خوبه که بدونید در ذیل همین آیه هشت سوره جمعه تفسیر روایی رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.16,
   "end": 532.0,
   "text": "کتاب تفسیر روایی اهل بیت جشونزده، صفحه دویست پنجاه و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.0,
   "end": 535.18,
   "text": "یه فرمایش شیرینی از امیرالمؤمنین دیدم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.18,
   "end": 538.12,
   "text": "از حضرت ذیل این آیه سؤال کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.12,
   "end": 540.16,
   "text": "حضرت در رابطه با این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.16,
   "end": 543.08,
   "text": "نظر دادن. فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.08,
   "end": 545.34,
   "text": "حالا من بخشیشو می‌خونم چون وقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.34,
   "end": 547.44,
   "text": "\"تعد السنين\". آخه یه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.44,
   "end": 552.52,
   "text": "امیرالمؤمنین تو جمع صحابه‌ش فرمود به نظر شما واحد شمارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.52,
   "end": 557.12,
   "text": "عمر چیه؟ الان از ما بپرسن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.12,
   "end": 560.36,
   "text": "یکی گفت ساله، یکی گفت ماهه، یکی گفت هفته‌ست، یکی گفت روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.36,
   "end": 563.06,
   "text": "دیگه کمترینشون گفت ساعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.06,
   "end": 566.12,
   "text": "هیچکدومو امیرالمؤمنین قبول نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.12,
   "end": 569.66,
   "text": "واحد شمارش عمر امیرالمؤمنین فرمود نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.66,
   "end": 572.5,
   "text": "هر نفسی همه چی حساب شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.5,
   "end": 576.48,
   "text": "حالا اون نفس آخرت که رسید هر کجا باشی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.48,
   "end": 581.3,
   "text": "ما داشتیم کسایی که معذرت می‌خوام تو بیت الخلاء دستشویی و توالت به قول ما مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.3,
   "end": 583.94,
   "text": "اون نفس آخرش که رسیده اون تو بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.94,
   "end": 589.52,
   "text": "تو هیئت بوده، رو منبر مرده، تو خیابون، تو بازار مرده یا تو تصادف، تو بیمارستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 589.52,
   "end": 592.9,
   "text": "نفس آخر که اومد تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.9,
   "end": 595.38,
   "text": "اینو دقت کنید امیرالمؤمنین می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 595.38,
   "end": 597.58,
   "text": "\"تعد السنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.58,
   "end": 602.8,
   "text": "ثم تعد الشهور ثم تعد الايام ثم تعد الساعات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.8,
   "end": 606.64,
   "text": "فرمود سال‌ها شمارش شدن، ماه‌ها شمارش شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.64,
   "end": 609.54,
   "text": "سپس روزها شمارش شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.54,
   "end": 612.22,
   "text": "سپس ساعات شمارش شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.22,
   "end": 616.2,
   "text": "بعد \"ثم\" سپس \"تعد النفس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.2,
   "end": 618.44,
   "text": "نفس‌هام شمارش شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.44,
   "end": 624.04,
   "text": "\"فاذا جاء اجلهم\" اشاره کرد حضرت به این آیه سی و چهار اعراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.04,
   "end": 629.34,
   "text": "اینو آورد وسط. \"فاذا جاء اجلهم لا يستأخرون ساعة ولا يستقدمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.34,
   "end": 631.68,
   "text": "اصلاً جلو پس و پیش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.68,
   "end": 635.24,
   "text": "برسه تمامه. نفس‌ها شمارش شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 635.24,
   "end": 640.84,
   "text": "روی این یه ذره فکر کنین. بارها عرض کردم نفس‌ها شمارش شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.84,
   "end": 644.6,
   "text": "برای همین میگه تا می‌تونی مثلا بیت الخلاء اتو طول نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.6,
   "end": 648.74,
   "text": "شاید یه وجه بحث فقهیشو کاری ندارم ولی یه وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.74,
   "end": 652.22,
   "text": "معرفتی‌ش که میگن بیت الخلاء زیاد نمون شاید اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.22,
   "end": 654.98,
   "text": "میگه اون تو نشستن زیاد کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 654.98,
   "end": 658.0,
   "text": "یه دلیل‌ها حالا دلایل پزشکی داره، یه دلیلش هم می‌تونه این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.0,
   "end": 661.72,
   "text": "الان نفس آخرت برسه حیف نیست اون تو بمری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.72,
   "end": 668.1,
   "text": "یا از جهت پزشکی میگه میای بیرون با پای راست خارج شو میری تو اون تا اونجور و مسجد برعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 668.1,
   "end": 669.74,
   "text": "با پای چپ برو تو بیت الخلاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.74,
   "end": 672.04,
   "text": "حالا چون پزشکا گفتن وقتی سکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 672.04,
   "end": 676.38,
   "text": "می‌زنی بیشتر امکان این داره که به سمت راست بیفتی تا چپ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 676.38,
   "end": 679.86,
   "text": "ها؟ یعنی اگر سکته کردی بیفتی بیرون دستشویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 679.86,
   "end": 682.44,
   "text": "حیفه اون تو جون بدی. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 682.44,
   "end": 686.46,
   "text": "آنفاعن باید آدم مترصد باشه، آماده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 686.46,
   "end": 690.36,
   "text": "این خیلی مهمه. من خودم دارم میگم اینطوری نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 690.36,
   "end": 694.52,
   "text": "هی دارم حدیث نفس به خودم می‌خونم، میگم، میگم، میگم تا بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 694.52,
   "end": 701.88,
   "text": "برای خودمم جا بیفته. یه حکایتی هم میگن من باب متابعه عرض کنم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.88,
   "end": 704.22,
   "text": "که حکایته ولی خب حقیقته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 704.22,
   "end": 707.76,
   "text": "که از بزرگانمون شنیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 707.76,
   "end": 711.0,
   "text": "یه آقایی نشسته بود داشت تلویزیون نگاه می‌کرد و کیف می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 711.0,
   "end": 714.46,
   "text": "یهو حضرت مرگ، حضرت موت تشریف آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 714.46,
   "end": 717.64,
   "text": "گفتن بفرمایید می‌خوام شما رو ببریم آماده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 717.64,
   "end": 719.54,
   "text": "گفتن بابا آخه چقدر زود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.54,
   "end": 722.54,
   "text": "نمیشه وقت مطلقاً. گفت لااقل بشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 722.54,
   "end": 725.54,
   "text": "گلوت رو تر کن یه شربت برات بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 725.54,
   "end": 727.8,
   "text": "این آقا گفت باشه تا همین مقدار قبوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.8,
   "end": 731.06,
   "text": "رفت یه شربت بیاره بده به آقای مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 731.06,
   "end": 733.78,
   "text": "بخوره. توش دو تا قرص خواب انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 733.78,
   "end": 735.94,
   "text": "از این خواب سنگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.94,
   "end": 739.06,
   "text": "آورد داد این آقای مرگ اینو خورد خوابش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 739.06,
   "end": 741.68,
   "text": "اینم برای خودش کیف کرد گفت دیگه کارش تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 741.68,
   "end": 747.74,
   "text": "یهو دید حالا اینکه خواب بود لیستو برداشت نگاه کرد اسمشو پاک کرد از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 747.74,
   "end": 750.4,
   "text": "گفت آقا حضرت مرگ بهش گفته بود من کاری ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 750.4,
   "end": 753.74,
   "text": "من طبق این لیست میرم جلو. الان لیست رسیده به تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 753.74,
   "end": 760.04,
   "text": "نوبت توئه. این اسمشو که دید وقتی حضرت مرگ خواب بود اسمشو پاک کرد اون پایین پایین نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 760.04,
   "end": 765.42,
   "text": "آخرین نفر نوشت. حضرت مرگ که از خواب بیدار شد گفت دمت گرم عجب حالی دادی به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 765.42,
   "end": 768.2,
   "text": "خالی شربتت چسبید و... گفت حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 768.2,
   "end": 773.48,
   "text": "لیستو بده من به خاطر این عشق و حالی که تو امروز دادی امروز من امروز چیکار می‌کنم از ته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 773.48,
   "end": 779.4,
   "text": "لیست شروع می‌کنم. حکایت جالبیه واقعاً یعنی رد خور نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.4,
   "end": 781.48,
   "text": "من خواهش می‌کنم از خودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 781.48,
   "end": 787.56,
   "text": "خواهش می‌کنم از خودم، التماس به خودم می‌کنم قصه موت رو جدی بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 787.56,
   "end": 792.1,
   "text": "باید بریم. کسی اینجا اگه قرار بود کسی بمونه پیغمبر باید می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 792.1,
   "end": 796.96,
   "text": "قبول دارید؟ باید پیغمبر حضرت زهرا باید می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 796.96,
   "end": 799.68,
   "text": "الهی باور کنیم. الهی قبول کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 799.68,
   "end": 804.62,
   "text": "الهی که عاقبت ما ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 804.62,
   "end": 808.92,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}