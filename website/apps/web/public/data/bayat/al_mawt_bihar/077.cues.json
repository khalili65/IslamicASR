 },
 "chapters": [
  {
   "index": 0,
   "title": "## آغاز دههٔ کرامت؛ کریمهٔ اهل‌بیت",
   "start": 0.9,
   "end": 305.84
  },
  {
   "index": 1,
   "title": "## جاء الموت بما فیه؛ دو کرّه",
   "start": 305.84,
   "end": 608.66
  },
  {
   "index": 2,
   "title": "## محک رغبت؛ سوی حرکت",
   "start": 608.66,
   "end": 685.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 9.62,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.62,
   "end": 14.92,
   "text": "السلام علیک یا داعی الله و ربانیة آiate.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.92,
   "end": 17.82,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.82,
   "end": 23.24,
   "text": "تبریک عرض می‌کنم این ایام بسیار فرخنده و مبارک رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.24,
   "end": 28.34,
   "text": "شروع دهه کرامت هست و روز میلاد کریمه اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.34,
   "end": 31.1,
   "text": "حضرت فاطمه معصومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.1,
   "end": 36.74,
   "text": "سلام الله علیها که به تصریح حضرت ولی عصر زیارتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.74,
   "end": 41.16,
   "text": "مثل زیارت حضرت زهرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.16,
   "end": 47.16,
   "text": "یه تعبیر بسیار جالبی حضرت آقای بهجت داشتند در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.16,
   "end": 53.96,
   "text": "حضرت معصومه سلام الله علیها که نشان‌دهنده جایگاه ویژه ایشون در ولایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.96,
   "end": 56.3,
   "text": "این تعبیر رو به یادگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.3,
   "end": 61.46,
   "text": "داشته باشید امروز که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.46,
   "end": 65.12,
   "text": "آقا علی ابن موسی الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.12,
   "end": 70.18,
   "text": "از مهمان‌های خصوصی و ویژه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.18,
   "end": 76.18,
   "text": "در حرم خواهرشون حضرت معصومه سلام الله علیها پذیرایی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.18,
   "end": 81.34,
   "text": "چه اینکه حرم حضرت معصومه علیها سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.34,
   "end": 83.46,
   "text": "اندرونی حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.46,
   "end": 87.62,
   "text": "امام رضاست. چقدر شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.62,
   "end": 91.54,
   "text": "قدیما خونه‌ها اندرونی، بیرونی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.54,
   "end": 94.48,
   "text": "مهمونای غریبه تو بیرونی می‌نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.48,
   "end": 97.5,
   "text": "اونایی که محرم بودن می‌اومدن تو اندرونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.5,
   "end": 102.38,
   "text": "مثل الان نبود که همه چی در معرض دید باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.38,
   "end": 106.96,
   "text": "اینها. معماری اسلامی متفاوت شده باشه به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.96,
   "end": 114.54,
   "text": "معماری غربی و اینا که آشپزخونه‌ها هم دیگه در معرض-- مثلا دیگه الان اون دیوار نیم‌شت جلوشم دیگه کلاً برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.54,
   "end": 117.48,
   "text": "دیگه open هم بهش نمیشه گفت آشپزخونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.48,
   "end": 122.92,
   "text": "اندرونی، بیرونی داشت. چقدر مقام این خانم بالاست که یه عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.92,
   "end": 128.72,
   "text": "به الله مثل آقای بهجت می‌فرماید امام رضا از مهمون‌های خصوصی و محرم خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.72,
   "end": 131.26,
   "text": "در اندرونی حرمش که حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.26,
   "end": 134.18,
   "text": "حضرت معصومه است پذیرایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.18,
   "end": 137.7,
   "text": "پس این نشون میده که چقدر جایگاه داره ایشون یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.7,
   "end": 140.38,
   "text": "دو، هر کسی لیاقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.38,
   "end": 143.96,
   "text": "ارتباط با ایشون، سر سفره نشستن ایشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.96,
   "end": 146.58,
   "text": "تماس با ایشون رو نخواهد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.58,
   "end": 153.88,
   "text": "ایشون به یک معنا یکی از جلوه‌های اسمت الله کبراست، یکی از جلوه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.88,
   "end": 157.26,
   "text": "که امیدوارم شروع دهه کرامت که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.26,
   "end": 159.56,
   "text": "میمنت قدوم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.56,
   "end": 163.76,
   "text": "کریمه هست برای همه ماها اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.76,
   "end": 171.06,
   "text": "و خصوصاً دخترانمون پر از خیر و برکت باشه که بهترین الگو براشون حضرت معصومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.06,
   "end": 176.14,
   "text": "سلام الله علیهاست. اما برگردیم به بحث کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.14,
   "end": 182.82,
   "text": "چون یه مقدار از وقت گذشت من امروز فقط صورت حدیث بعدی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.82,
   "end": 187.24,
   "text": "براتون عرض کنم و انشاالله توضیحاتش، نکاتش جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.24,
   "end": 193.96,
   "text": "باب چهارم بودیم. امروز میریم سراغ حدیث و روایت جدید که روایت چهارم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.96,
   "end": 197.94,
   "text": "روایت چهارم، باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.94,
   "end": 199.86,
   "text": "عن ابی جعفر علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.86,
   "end": 204.42,
   "text": "از امام باقر سلام الله علیه نقل شده که قال ایشون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.42,
   "end": 209.7,
   "text": "قال رسول الله. ایشون به نقل از پیغمبر عظیم الشأن اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.7,
   "end": 215.82,
   "text": "دارن بیان می‌کنن صلى الله عليه وآله وسلم یه روایت خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.82,
   "end": 218.2,
   "text": "جون‌دار و پرمغز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.2,
   "end": 221.02,
   "text": "و کثیر الفروع، پرنکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.02,
   "end": 223.32,
   "text": "پیغمبر فرمودن الموت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.32,
   "end": 227.22,
   "text": "الموت. دو بار پشت سر هم تکرار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.22,
   "end": 229.54,
   "text": "این یک هشداری‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.54,
   "end": 233.66,
   "text": "یک توجه ویژه‌ست، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.66,
   "end": 238.04,
   "text": "آماده باش. مرگ را، مرگ را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.04,
   "end": 245.3,
   "text": "حواستون باشه. داره ت-تذکر میده دو بار تکرار می‌کنه که در این تکرار البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.3,
   "end": 247.28,
   "text": "بخواهیم آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.28,
   "end": 250.36,
   "text": "بنده حقیر بی‌سواد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.36,
   "end": 253.84,
   "text": "محضر اساتید و اینها اخذ کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.84,
   "end": 259.7,
   "text": "پیرامون اینکه چرا اینجا دو تا موت اومده بخواهیم حرف بزنیم خیلی حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.7,
   "end": 263.34,
   "text": "منتها دیگه به اهلش واگذار می‌کنیم رد می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.34,
   "end": 268.42,
   "text": "مثل معکم، معکم، انی معکم، معکم، لا مع غیرکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.42,
   "end": 271.94,
   "text": "یا لا مع اعدائکم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.94,
   "end": 276.7,
   "text": "یا عدوکم. در زیارت جامعه کبیره دو بار معکم، معکم اومده که اون معکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.7,
   "end": 282.32,
   "text": "اول یعنی در دنیا با شما معکم دو-دوم در آخرت هم با شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.32,
   "end": 287.82,
   "text": "معکم اول در راحتی با شما معکم دوم در سختی هم با شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.82,
   "end": 293.82,
   "text": "معکم اول در قنا با شمام، معکم دوم در فقر هم با شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.82,
   "end": 298.1,
   "text": "همین طوری شما بگیر دیگه الا ما شاء الله تا قیامت می‌تونی بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.1,
   "end": 299.72,
   "text": "بی‌خود این‌ها تکرار نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.72,
   "end": 302.34,
   "text": "اینجا هم یه وجوه خاصی دارد بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.34,
   "end": 305.72,
   "text": "الموت، الموت چرا دو بار اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.72,
   "end": 309.76,
   "text": "یه بخشش می‌تونه به این برگرده که ما دو بار می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.76,
   "end": 313.88,
   "text": "امس متین. ما دو ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.88,
   "end": 317.48,
   "text": "دوبار می‌میریم. امت مس متین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.48,
   "end": 320.16,
   "text": "دو بار می‌میریم، دو بار هم احیا می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.16,
   "end": 322.6,
   "text": "حالا این یه هشداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.6,
   "end": 326.86,
   "text": "پیغمبر بعد، بعد از اینکه دو بار تکرار کرد فرمود جا الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.86,
   "end": 330.02,
   "text": "موت اومد. مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.02,
   "end": 333.08,
   "text": "آمد. آماده‌ای یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.08,
   "end": 334.96,
   "text": "خب چگونه آمد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.96,
   "end": 339.96,
   "text": "بما فیه. اینجا خیلی حرف داریم که بماند حالا روزای بعد انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.96,
   "end": 343.94,
   "text": "مرگ با اون چیزی که درشه اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.94,
   "end": 346.4,
   "text": "یعنی مرگ یه چیز تنها نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.4,
   "end": 353.86,
   "text": "درش چیزهایی داره. حالا به یک معنا از اینجا به بعد توضیح درون‌مایه مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.86,
   "end": 357.42,
   "text": "مرگ آمد بما فیه، با اون چیزی که درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 357.42,
   "end": 360.3,
   "text": "خب چگونه میاد مرگ؟ یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 360.3,
   "end": 364.32,
   "text": "جاء آمد بالروح والراه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.32,
   "end": 370.48,
   "text": "یا با روح و ریحان و راحتی و آرا- آسایش و این‌ها آمد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.48,
   "end": 373.5,
   "text": "روح و ریحان و خوشی و این‌ها آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.5,
   "end": 376.5,
   "text": "والکرة المبارکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.5,
   "end": 379.64,
   "text": "این کرّه به یه معنا رجوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.64,
   "end": 382.46,
   "text": "برگشتی مبارک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.46,
   "end": 387.64,
   "text": "این برگشت رو اگر به معنای رجوع بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.64,
   "end": 390.86,
   "text": "که باز اینجا هم حرف‌هایی داریم باشه بعداً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.86,
   "end": 393.96,
   "text": "می‌شه انگار که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.96,
   "end": 397.36,
   "text": "دو مرتبه داریم برمی‌گردیم به یه جایی که قبلاً بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.36,
   "end": 399.56,
   "text": "این معنا از توش در میاد. حالا فعلاً باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.56,
   "end": 403.18,
   "text": "الکرة المبارکه. این برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.18,
   "end": 406.02,
   "text": "یا مبارکه، به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.02,
   "end": 407.76,
   "text": "الی جنت عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.76,
   "end": 413.02,
   "text": "به اون بهشت‌های بسیار بالا، عالی که دست هر کسی نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.02,
   "end": 417.12,
   "text": "برای چه کسانیه؟ لأهل دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.12,
   "end": 420.84,
   "text": "برای اون‌هایی که به خلد برین میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.84,
   "end": 426.64,
   "text": "یعنی همتشون اینه که به اون درجات عالیه برن و همیشه هم اونجا مستقر باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.64,
   "end": 428.36,
   "text": "نوسان در عبادتشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.36,
   "end": 431.42,
   "text": "اینطوری نیست یه روز کافر باشن، یه روز مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.42,
   "end": 433.92,
   "text": "دائماً مراقبن. الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.92,
   "end": 437.44,
   "text": "کان لها اینا چه جو- چه جور آدمایین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.44,
   "end": 439.46,
   "text": "بازش کن برای ما پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.46,
   "end": 442.86,
   "text": "لها سعيهم و فيها رغبتهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.86,
   "end": 445.2,
   "text": "خیلی پرنکته‌ست اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.2,
   "end": 449.28,
   "text": "سعی و تلاششون اصلاً اینا برای همون جا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.28,
   "end": 455.26,
   "text": "و رغبتهم. در کنار عمل و سعیشون رغبتشون هم به بهشت بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.26,
   "end": 457.96,
   "text": "اینا اصلاً بهشتی زندگی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.96,
   "end": 460.44,
   "text": "بهشتی زندگی کردن که به بهشت میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.44,
   "end": 463.42,
   "text": "به قول شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.42,
   "end": 467.26,
   "text": "سلیمانی بارها فرمود شهید زندگی کنی شهید می‌شی یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.26,
   "end": 469.9,
   "text": "بهشتی زندگی کنی بهشت می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.9,
   "end": 473.36,
   "text": "می‌گه رغبتشون اونه، سعیشون هم به اون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.36,
   "end": 475.52,
   "text": "جز این نیست. لذا به همون سمت هم میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.52,
   "end": 477.88,
   "text": "این یک نوع. بما فيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.88,
   "end": 480.6,
   "text": "اونچه که در موته. بعدیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.6,
   "end": 483.14,
   "text": "و جاء الموت باز هم موت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.14,
   "end": 486.2,
   "text": "اما این دفعه چی توشه بما فيه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.2,
   "end": 489.98,
   "text": "جاء اومد بشقوة و نغامه-- و ندامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.98,
   "end": 494.27,
   "text": "با پری- پریشانی، بدبختی، سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.27,
   "end": 499.52,
   "text": "یه معنای شقوه. سختیه، یک معناش بدبختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.52,
   "end": 501.82,
   "text": "و الندامه، پشیمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.82,
   "end": 504.06,
   "text": "والکرة الخاسرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.06,
   "end": 506.58,
   "text": "دوباره الکرّه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.58,
   "end": 513.24,
   "text": "الکرّه که رجوعه، بازگشته اما این دفعه با خسرانه، با زیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.24,
   "end": 514.84,
   "text": "به چه سمتی میرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.84,
   "end": 519.8,
   "text": "اونا به سمت جنت عالیه، اینا الی نار خامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 519.8,
   "end": 523.88,
   "text": "اینا به سمت آتش میرن. اینا باز به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.88,
   "end": 526.12,
   "text": "چون بعدش می‌فرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.12,
   "end": 530.82,
   "text": "لأهل دار الغرور الذین کان لها سعيهم و فيها رغبتهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.82,
   "end": 534.92,
   "text": "دوباره همین رو برای اهل جهنم استفاده می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.92,
   "end": 537.32,
   "text": "پیداست به سمت خودشون دارن میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.32,
   "end": 542.24,
   "text": "چون سعی و تلاششون همین بوده، رغبتشون همین بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.24,
   "end": 550.24,
   "text": "و اتحاد وجودی برقرار کردن با قول و فعلشون، با علم و عملشون به همون سمت هم دارن میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.24,
   "end": 555.2,
   "text": "یعنی اگر به سمت جهنمی-- جهنم میرن چون خودشون جهنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.2,
   "end": 558.38,
   "text": "اگر به سمت بهشت میرن چون خودشون بهشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.38,
   "end": 562.68,
   "text": "این صورت روایت که خیلی نو-- پرنکته‌ست، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.68,
   "end": 565.46,
   "text": "از همون کلمه‌ی اولش. الموت، الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.46,
   "end": 567.78,
   "text": "تکرارش، بگیر دوباره جاء الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.78,
   "end": 570.32,
   "text": "می‌شه به یک معنا گفت سه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.32,
   "end": 573.38,
   "text": "بگیر برو تا اون آخر رغبتهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.38,
   "end": 579.7,
   "text": "سعيهم. اینا همه سعی و تلاش و رغبتشون در اون چیزی بوده که به سمتش دارن میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.7,
   "end": 584.1,
   "text": "حالا یه سؤال رو جواب بدیم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.1,
   "end": 589.6,
   "text": "به نظر شما با توجه به صورت این حدیث، حالا باطنشو که ما اهلش نیستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.6,
   "end": 593.12,
   "text": "ما داریم به چه سمتی میریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 593.12,
   "end": 596.84,
   "text": "جهنم یا بهشت؟ تک تک خودمون، خودمون الان خودمون رو محک بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.84,
   "end": 599.4,
   "text": "با توجه به صورت این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 599.4,
   "end": 602.58,
   "text": "به چه سمتی داریم میریم؟ جهنمه یا بهشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 602.58,
   "end": 605.42,
   "text": "اون سمتی که ما داریم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.42,
   "end": 607.9,
   "text": "انشاالله بهشته. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 607.9,
   "end": 611.3,
   "text": "با توجه به صورت حدیث جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.3,
   "end": 616.32,
   "text": "در رابطه با هر دو گروه، اگر یه گروه رو می‌گفت حرفی نداشتیم بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.32,
   "end": 619.82,
   "text": "اما در رابطه با هر دو گروه می‌فرماید کان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 619.82,
   "end": 628.12,
   "text": "لها سعيهم برای همون جایی که دارن میرن سعی کردن و فيها رغبه تو همون هم رغبت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.12,
   "end": 630.18,
   "text": "به همون هم رغبت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.18,
   "end": 635.7,
   "text": "پس الان ما از رغبت‌هامون، لیلة الرغائب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.7,
   "end": 638.84,
   "text": "میلمون، شب لیلة الرغائب شب خیلی مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.84,
   "end": 641.44,
   "text": "کسی بفهمه بهشتیه یا جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.44,
   "end": 643.66,
   "text": "از میل دلمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.66,
   "end": 649.52,
   "text": "رغبتمون که سعی و تلاشمون بر بستر اون بنا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.52,
   "end": 651.98,
   "text": "از اینجا می‌تونیم بفهمیم کجا داریم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 651.98,
   "end": 653.86,
   "text": "الان رغبت ما به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.86,
   "end": 655.84,
   "text": "میل دل ما به چه سمتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.84,
   "end": 658.02,
   "text": "به کجا سو داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 658.02,
   "end": 661.1,
   "text": "رخ، رخ ما، وجه ما به چه سمتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.1,
   "end": 664.04,
   "text": "از چی کیف می‌کنیم؟ از چی خوشمون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.04,
   "end": 670.56,
   "text": "به چی، چی-- خیره می‌شیم، دقت می‌کنیم، چی نگاه ما رو به خودش جلب می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.56,
   "end": 673.42,
   "text": "ما اهل همونیم. به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.42,
   "end": 679.86,
   "text": "حالا تا انشاالله توضیحاتش. انشاالله عاقبتمون ختم بخیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.86,
   "end": 685.58,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}