 "chapters": [
  {
   "index": 0,
   "title": "## باب طاعون و فرار منه در کتاب الموت",
   "start": 13.36,
   "end": 47.6
  },
  {
   "index": 1,
   "title": "## موت برای مؤمن رحمت و برای کافر عذاب",
   "start": 47.6,
   "end": 68.16
  },
  {
   "index": 2,
   "title": "## نور و نار؛ ریشهٔ واحد نمای دوگانه",
   "start": 68.16,
   "end": 657.43
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 3.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 7.3,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.3,
   "end": 12.38,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 17.52,
   "text": "بریم سراغ باب جدید کتاب الموت، باب سوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.52,
   "end": 19.84,
   "text": "مرحوم مجلسی اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.84,
   "end": 24.06,
   "text": "موضوع باب سوم رو بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.06,
   "end": 28.22,
   "text": "الطاعون والفرار منه مشخص کرده، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.22,
   "end": 31.08,
   "text": "عنوان کرده. عنوان چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.08,
   "end": 32.92,
   "text": "طاعون و فرار از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.92,
   "end": 35.02,
   "text": "حالا ربطش با موت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.02,
   "end": 37.92,
   "text": "در اثنای بحث متوجه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.92,
   "end": 43.94,
   "text": "روایت اول این باب از عیون اخبار الرضا انتخاب شده است مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.94,
   "end": 47.24,
   "text": "قیل لصادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.24,
   "end": 50.32,
   "text": "سؤال شد از امام صادق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.32,
   "end": 53.14,
   "text": "أخبرنا عن الطاعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.14,
   "end": 55.04,
   "text": "به ما خبر بده آقا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.04,
   "end": 59.92,
   "text": "طاعون. یه مریضی‌ای بود که قدیما خیلی مرسوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.92,
   "end": 64.7,
   "text": "مثل مثلا الان اومیکرون و کرونای الان که به این شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 64.7,
   "end": 68.16,
   "text": "مرگ و میر داشت شبیه به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.16,
   "end": 70.6,
   "text": "فقال عذاب الله لقوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.6,
   "end": 74.62,
   "text": "ورحمة لآخرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 74.62,
   "end": 77.62,
   "text": "حضرت ظاهراً چیز عجیبی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.62,
   "end": 82.34,
   "text": "فرمودن که این طاعون برای عده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.34,
   "end": 87.4,
   "text": "عذاب الهی است و برای عده‌ای رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.4,
   "end": 91.72,
   "text": "همین عذاب برای یه سری رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.72,
   "end": 94.76,
   "text": "قالو و كيف تكون رحمة وعذابا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 94.76,
   "end": 102.44,
   "text": "آقا چگونه می‌شه که چیزی که نفسش عذابه رحمت حساب بشه برای بعضیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.44,
   "end": 105.74,
   "text": "أما قال أما تعرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 105.74,
   "end": 111.34,
   "text": "حضرت فرمود آیا نمی‌شناسید أن النيران جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.34,
   "end": 113.86,
   "text": "عذاب على الكفار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.86,
   "end": 117.68,
   "text": "آتش جهنم بر کفار عذابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.68,
   "end": 120.98,
   "text": "و خزنت جهنم معهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.98,
   "end": 123.58,
   "text": "ولی برای اون خزانه جهنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.58,
   "end": 129.06,
   "text": "خزان جهنم، اونایی که اونجا سدنه‌اند، خادمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.06,
   "end": 132.58,
   "text": "فيها معهم فيها اونایی که اونجان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.58,
   "end": 134.82,
   "text": "فهی رحمة عليهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.82,
   "end": 138.28,
   "text": "آتش جهنم برای اون خزانش رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.28,
   "end": 144.8,
   "text": "دلیلی که حضرت میاره. خیلی جالب که ما قبلاً تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.8,
   "end": 150.16,
   "text": "سیر حکمیمون گفتیم نور و نار از یک جنس‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.16,
   "end": 152.84,
   "text": "حضرت قابض الارواح یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.84,
   "end": 157.32,
   "text": "چگونه است که کافر بدشکل و بدمنظر می‌بینش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.32,
   "end": 161.08,
   "text": "مؤمن خوش منظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.08,
   "end": 164.72,
   "text": "همش بستگی به خودمون داره که او رو چگونه ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.72,
   "end": 169.76,
   "text": "آینه‌ در حقیقت اون مثل یک آینه‌ای است که ما خودمون رو در او می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.76,
   "end": 172.6,
   "text": "اگه ما زشتیم زشت می‌بینیم، زیباییم زیبا می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.6,
   "end": 175.26,
   "text": "همه چی به خود ما بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.26,
   "end": 179.84,
   "text": "و الا جنس نور و نار یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.84,
   "end": 188.14,
   "text": "خب اما موضوعی که حضرت اینجا بیان کرده برمی‌گرده به حالا طاعون و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.14,
   "end": 191.14,
   "text": "آیا قرآن هم در این خصوص مطلبی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.14,
   "end": 193.5,
   "text": "بله. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.5,
   "end": 199.92,
   "text": "دویست و چهل و سه سوره بقره می‌فرمود ألم تر إلى الذين خرجوا من ديارهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.92,
   "end": 202.76,
   "text": "آیا نگاه نمی‌کنید به اونایی که خارج شدند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.76,
   "end": 206.22,
   "text": "شهر و دیارشون؟ وهم ألوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.22,
   "end": 208.48,
   "text": "اینا تعدادشون خیلی زیاد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.48,
   "end": 213.5,
   "text": "ألوف حالا در جلد دو تفسیر طبری می‌فرمود وقتی عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.5,
   "end": 217.4,
   "text": "بیش از ده هزار نفر باشه عده‌ای بهش می‌گه ألوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.4,
   "end": 220.18,
   "text": "کمتر از ده هزار تا رو می‌گه آلاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.18,
   "end": 223.86,
   "text": "اینجا چون آیه قرآن می‌فرماید وهم ألوفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.86,
   "end": 226.3,
   "text": "نشون می‌ده بیشتر از ده هزار نفر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.3,
   "end": 229.26,
   "text": "کیا؟ که خارج شدند از شهرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.26,
   "end": 234.36,
   "text": "هذر الموت. به خاطر ترس از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.36,
   "end": 237.82,
   "text": "فقال لهم الله موتوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.82,
   "end": 241.56,
   "text": "خدا بهشون فرمود بمیرید. حالا که از ترس از مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.56,
   "end": 244.62,
   "text": "از شهرتون فرار کردید بمیرید ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.62,
   "end": 247.4,
   "text": "ثمه حالا اینا مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.4,
   "end": 251.36,
   "text": "ثمه أحیاهم. دو مرتبه خدا اینا رو احیا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 251.36,
   "end": 254.4,
   "text": "حالا چرا؟ تو شأن نزول می‌فرماید چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.4,
   "end": 257.48,
   "text": "إن الله لظوف بالعل الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.48,
   "end": 261.04,
   "text": "چونکه خدا شدیداً بر بندگانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 261.04,
   "end": 264.74,
   "text": "دارای فضله. ولكن أكثر الناس لا يشكرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 264.74,
   "end": 266.86,
   "text": "اکثر مردم شکر نمی‌گذارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 266.86,
   "end": 273.46,
   "text": "این برمی‌گرده به، اه اون روایتی که در کافی جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.46,
   "end": 277.96,
   "text": "هشت صفحه صد و نود و نه می‌تونید این روایت رو ببینید که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.96,
   "end": 280.6,
   "text": "هزقیل یکی از انبیای بنی اسرائیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.6,
   "end": 283.88,
   "text": "حضرت هزقیل. ایشون رد می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.88,
   "end": 287.56,
   "text": "حالا جریانش چی بود؟ اینا تو شهر شام حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 287.56,
   "end": 291.64,
   "text": "هفتاد هزار نفر که زندگی می‌کردن طاعون گرفت اونجا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.64,
   "end": 293.34,
   "text": "خیلیا می‌مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 293.34,
   "end": 298.66,
   "text": "اینایی که وضع مالیشون خوب بود به قول امروزی‌ها مثلا ماشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.66,
   "end": 302.06,
   "text": "فراری داشتن چی، اینا سوار شدن اینا فرار کردن از شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.06,
   "end": 305.04,
   "text": "بعضیا، بعضی از روایات فرمودن که نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.04,
   "end": 308.96,
   "text": "والی شهر حالا اون عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.96,
   "end": 314.0,
   "text": "پیغمبر زمانش یا والی شهرش هرچی که بوده دستور جهاد داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 314.0,
   "end": 316.58,
   "text": "اینا از ترس جهاد فرار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.58,
   "end": 319.58,
   "text": "بعضی روایات می‌گن از طاعون اومده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 319.58,
   "end": 324.36,
   "text": "باز از ف-- جهاد فرار کردن اما به بهانه طاعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.36,
   "end": 327.24,
   "text": "به هر حال فرار کردن که نمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.24,
   "end": 330.38,
   "text": "هرچی که بود دلیل چی بود؟ قرآن صراحتاً می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.38,
   "end": 332.9,
   "text": "هذر الموت از ترس موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 332.9,
   "end": 337.14,
   "text": "رفتن تو همون بیابونی که اینا پرتاب کرده بودن، همونجا خدا اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 337.14,
   "end": 339.48,
   "text": "به همون طاعون دچارشون کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.48,
   "end": 343.36,
   "text": "و مردن. و حضرت هزقیل نبی که رد می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 343.36,
   "end": 346.02,
   "text": "دید که جماعت زیادی اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 346.02,
   "end": 348.94,
   "text": "خب اینطوری که قرآن فرمود بیش از ده هزار نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 348.94,
   "end": 351.8,
   "text": "دست جمعی مردن، دلش به رحم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.8,
   "end": 355.72,
   "text": "دست به دعا برداشت. اینجا تأثیر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 355.72,
   "end": 361.0,
   "text": "ولی خدا معلوم می‌شه. و از خدا خواست که خدایا حالا بلا رو از اینا دفع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 361.0,
   "end": 363.9,
   "text": "ببخششون هرچی که بوده دوباره اینا رو زنده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 363.9,
   "end": 366.53,
   "text": "ایناها توبه کنن برگردن به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 366.53,
   "end": 370.87,
   "text": "این یکی از دلایل قرآنی بر اساس رجعت‌ها و موضوع رجعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 370.87,
   "end": 373.89,
   "text": "اینایی که میگن آقا کجای قرآن رجعت اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 373.89,
   "end": 377.65,
   "text": "شما معتقدید امام عصر صلوات الله علیه تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.65,
   "end": 381.29,
   "text": "رجعت جزء قطعیاته و اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 381.29,
   "end": 384.01,
   "text": "اعتقاد به رجعت نداشته باشه ایمان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 384.01,
   "end": 387.71,
   "text": "حدیث داریم ایمان، ایمان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 387.71,
   "end": 393.03,
   "text": "اینجا برمی‌گرده به همین آیه. چگونه اینا زنده بودند و مرتب برگشتن تو همین نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 393.03,
   "end": 395.71,
   "text": "به دعای نبی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 395.71,
   "end": 399.61,
   "text": "بیش از ده هزار نفر برگشتن، زنده شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.61,
   "end": 402.93,
   "text": "و خدا اینا رو بخشید و به مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.93,
   "end": 407.21,
   "text": "که این نکات زیادی در اینجا هست انشاالله به مرور عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 407.21,
   "end": 410.31,
   "text": "یکی از مهماتش حالا بحث رجعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 410.31,
   "end": 414.79,
   "text": "یکی از مهم‌ترین‌هاش بحث تاثیر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 414.79,
   "end": 421.75,
   "text": "ولی اللهه. که حالا مثلا تو همون سحره فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 421.75,
   "end": 425.81,
   "text": "تا چندین سال این‌ها بت‌پرست بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 425.81,
   "end": 429.91,
   "text": "اصلا این‌ها خدا قائل به الهیت نظام هستی نبودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 429.91,
   "end": 433.91,
   "text": "سحره و ساحرا که اومدن بر علیه پیغمبر خدا چیکار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.91,
   "end": 437.75,
   "text": "دسیسه چیدن دیگه سحر و جادوشونو ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.75,
   "end": 442.63,
   "text": "اما به یک باره یک آن نفس ولی خدا حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.63,
   "end": 444.93,
   "text": "به این‌ها خورد. این معجزه الهی رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.93,
   "end": 449.85,
   "text": "تمام. قالوا آمنا برب هارون و موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.85,
   "end": 451.85,
   "text": "اینا آم-- گفتن ما ایمان آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.85,
   "end": 457.79,
   "text": "یک آن ایمان آوردند و فرعون گفت دست و پاتونو ضربدری قطع می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.79,
   "end": 461.53,
   "text": "به دار می‌کشونم تو اینا. گفت هرچی می‌خوای بکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.53,
   "end": 463.93,
   "text": "ما دیگه راهمونو پیدا کردیم. خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.93,
   "end": 466.77,
   "text": "یک آن بعد چندین سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.77,
   "end": 469.39,
   "text": "شیطنت نفس ولی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 469.39,
   "end": 472.31,
   "text": "یا اون آیه چهل و نه سوره آل عمران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 472.31,
   "end": 475.45,
   "text": "اینو مخصوصا میگم این، این مطلبو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.45,
   "end": 477.87,
   "text": "یه وقت ناامید ش-- یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 477.87,
   "end": 483.49,
   "text": "کیدهای مهم شیطان امروز ناامیدی ما جوون‌هاست که اخیرا هم رهبر عزیزم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.49,
   "end": 486.49,
   "text": "ناامیدی. اینایی که تو طبل ناامیدی می‌زنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 486.49,
   "end": 488.59,
   "text": "تو سور ناامیدی می‌دمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 488.59,
   "end": 491.23,
   "text": "اینا همه ناامید می‌کنند جوون‌ها رو این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 491.23,
   "end": 495.31,
   "text": "که کار شیطانی می‌کنند. میام این صریح آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 495.31,
   "end": 498.47,
   "text": "چهل و نه آل عمران. اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 498.47,
   "end": 503.33,
   "text": "به ذائقتون بشینش عسل این آیه بلکه شیرین‌تر از عسل انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.33,
   "end": 506.57,
   "text": "بسه. \"أَنِّي\" اینو کی فرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 506.57,
   "end": 512.09,
   "text": "حضرت عیسی. خیلی عجیبه \"أَنِّي أَخْلُقُ لَكُم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 512.09,
   "end": 516.33,
   "text": "مِّنَ الطِّينِ\" من از گِل \"الطِّينِ\" با طای دست و پا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 516.33,
   "end": 518.49,
   "text": "\"أَخْلُقُ\" خلق می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 518.49,
   "end": 521.91,
   "text": "\"لَكُم\" برای شما \"مِّنَ الطِّينِ كَهَيْئَةِ الطَّيْرِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 521.91,
   "end": 527.83,
   "text": "مثل یک کبوتر مثل پرنده برای شما می‌سازم با دستم با گِل پرنده می‌سازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 527.83,
   "end": 531.71,
   "text": "گِله آقا. \"فَأَنفُخُ فِيهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 531.71,
   "end": 536.67,
   "text": "الله اکبر. \"فَأَنفُخُ\" میگم نفخ سود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 536.67,
   "end": 538.75,
   "text": "دیدی دلت می‌پیچه میگی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 538.75,
   "end": 541.97,
   "text": "نفخ معده پده. نفخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.97,
   "end": 544.27,
   "text": "و \"نَفَخْتُ فِيهِ مِن رُّوحِي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 544.27,
   "end": 549.33,
   "text": "این دمیدن \"فَأَنفُخُ فِيهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.33,
   "end": 552.03,
   "text": "فَيَكُونُ طَيْرًا بِإِذْنِ اللَّهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.03,
   "end": 555.21,
   "text": "همه سرشم تو اون \"إِذْنِ اللَّهِ\" هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 555.21,
   "end": 559.03,
   "text": "به اذن الله میشه پرنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 559.03,
   "end": 561.89,
   "text": "اصلا ت-دقت بکنید گِله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 561.89,
   "end": 567.03,
   "text": "شبیه پرنده‌ش کرده. اصلا ما بدتر از این که دیگه نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 567.03,
   "end": 569.41,
   "text": "ما به یه جانی داریم بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 569.41,
   "end": 575.25,
   "text": "اصلا بگو تموم جانت رفته یه تیکه پو-پوست استخون موندی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 575.25,
   "end": 577.81,
   "text": "یه گوشت و یه گِلی، یه خاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 577.81,
   "end": 581.33,
   "text": "\"فَأَنفُخُ فِيهِ فَيَكُونُ طَيْرًا بِإِذْنِ اللَّهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 581.33,
   "end": 584.83,
   "text": "نفس ولی خدا بخوره تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 584.83,
   "end": 589.77,
   "text": "اینایی که به هر حال مثل ما شاید از موت بترسن، اینا نگرانن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 589.77,
   "end": 595.81,
   "text": "کارشون خرابه یا از بلاهای زمانه مثل طاعون که اینجا مثال زده می‌ترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 595.81,
   "end": 599.17,
   "text": "بلا یه بخشش طاعونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 599.17,
   "end": 601.71,
   "text": "یه بخش موته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 601.71,
   "end": 604.79,
   "text": "قبلا گفتیم بحث‌ها رو که چرا میگیم بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.79,
   "end": 607.71,
   "text": "همونطور که طاعون برای کفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 607.71,
   "end": 611.59,
   "text": "نعمته برای اهل ایمان رحمت این حدیث فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 611.59,
   "end": 614.47,
   "text": "قبلا همین حدیثو خوندیم که موت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.47,
   "end": 618.11,
   "text": "برای کفار و مشرکین و منافقین نعمته، بدبختیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 618.11,
   "end": 621.69,
   "text": "عذابه. برای اهل ایمان، برای مؤمن رحمته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 621.69,
   "end": 623.49,
   "text": "عشقه. از قفس آزاد شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 623.49,
   "end": 627.23,
   "text": "از دنیا \"سجن المؤمن وجنة الكافر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 627.23,
   "end": 632.83,
   "text": "توجه کردید بعد این توسل به ولی خدا امیدآفرین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 632.83,
   "end": 637.37,
   "text": "یعنی اون‌هایی که گمان می‌کنند ب-- خدایی نکرده اگه بمیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 637.37,
   "end": 642.55,
   "text": "اتفاقات ناگوار منتظر-- نفس ولی خدا بسم الله توسل به امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 642.55,
   "end": 644.71,
   "text": "نگرفتن از ما که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 644.71,
   "end": 651.57,
   "text": "ما صاحب داریم غصه نخوریم انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 651.57,
   "end": 657.43,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}