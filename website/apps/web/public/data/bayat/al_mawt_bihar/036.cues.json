   "start": 11.24,
   "end": 40.5
  },
  {
   "index": 1,
   "title": "## تشبیه معقول به محسوس؛ موت تکامل است",
   "start": 40.5,
   "end": 207.22
  },
  {
   "index": 2,
   "title": "## خاک؛ مبدأ و آرامش",
   "start": 207.22,
   "end": 446.85
  },
  {
   "index": 3,
   "title": "## دو قوس صعود و نزول",
   "start": 446.85,
   "end": 468.57
  },
  {
   "index": 4,
   "title": "## منطق و استدلال پیش از قدرت",
   "start": 468.57,
   "end": 561.13
  },
  {
   "index": 5,
   "title": "## علم توشهٔ برزخ",
   "start": 561.13,
   "end": 647.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 6.16,
   "text": "به نستعین. السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.16,
   "end": 9.28,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.28,
   "end": 12.54,
   "text": "وعده داده بودیم که چند تا نکته رو پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.54,
   "end": 16.76,
   "text": "آیه پنج سوره حج که در باب دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.76,
   "end": 19.36,
   "text": "از کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.36,
   "end": 22.78,
   "text": "آورده رو عرض کنیم. اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.78,
   "end": 31.72,
   "text": "به جهت زیاد بودن وقتمون اجمالا از تفسیر نور استفاده کنم که نکات قشنگی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.72,
   "end": 36.8,
   "text": "بیان کرده. اولا پیرامون ارزش و اهمیت عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.8,
   "end": 41.7,
   "text": "و علم. اگر توجه بفرمایید در این آیه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.7,
   "end": 45.3,
   "text": "آیه پنج سوره حج أرذل العمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.3,
   "end": 51.76,
   "text": "اون پست‌ترین حالت عمر انسان رو وقتی بیان میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.76,
   "end": 53.64,
   "text": "أرذل العمر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.64,
   "end": 57.32,
   "text": "لکیلا يعلم من بعد علم شیئا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.32,
   "end": 61.4,
   "text": "هیچ علمی تو ذهنش نمونده همه رو از دست داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.4,
   "end": 67.82,
   "text": "این ارزش علم رو میرسونه که قرآن دقت کنید پست‌ترین أرذل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.82,
   "end": 73.66,
   "text": "أرذل پست‌ترین بر وزن افعل پست‌ترین حالت عمر رو وقتی بیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.66,
   "end": 75.92,
   "text": "که انسان علمی براش نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.92,
   "end": 82.7,
   "text": "این ارزش علم، علم رو میرسونه که andet جایگاه هر کسی به میزان علم و آگاهیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.7,
   "end": 89.98,
   "text": "که انسان نفسش همونطور که قبلاً عرض شد نفسش با این علم و باورهاش بعد از موت شکل می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.98,
   "end": 93.02,
   "text": "شکل نفسش شبیه علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.02,
   "end": 95.56,
   "text": "معارف و باورهاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.56,
   "end": 98.12,
   "text": "و نکته دوم اهمیت عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.12,
   "end": 100.46,
   "text": "چی باعث میشه که علم فراموش بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.46,
   "end": 104.86,
   "text": "چون ما یه مخزنی داریم پشت عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.86,
   "end": 108.98,
   "text": "بهش میگن خزانه عقل که محل حافظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.98,
   "end": 111.1,
   "text": "چرا اون حافظه مختل میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.1,
   "end": 115.6,
   "text": "همه چی از بین میره. چون عقل زایل میشه تو اون سن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.6,
   "end": 120.18,
   "text": "باز اهمیت و جایگاه عقل رو داره میرسونه که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.18,
   "end": 126.96,
   "text": "عقل ارزش داره که کسی که عقلشو از دست میده دیگه پست‌ترین حالت عمرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.96,
   "end": 129.86,
   "text": "نکته دوم تشبیه معقول به محسوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.86,
   "end": 132.94,
   "text": "چون سیر خلقت رو داره بیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.94,
   "end": 135.66,
   "text": "برای تفهیم موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.66,
   "end": 142.2,
   "text": "حتی اینکه میخواد قرآن به نوعی به ما بفهمونه که موت از بین رفتن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.2,
   "end": 147.86,
   "text": "موت إنما تنتقلون من دارٍ إلى دار از یه داری به دار دیگر رفتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.86,
   "end": 152.02,
   "text": "بلکه به یک معنا یک سیر تکاملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.02,
   "end": 156.04,
   "text": "میاد تشبیه معقول به محسوس میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.04,
   "end": 162.2,
   "text": "یعنی چی؟ میخواد یک اصل عقلی رو به ما بفهمونه که موت یه نوع تکامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.2,
   "end": 164.58,
   "text": "مثلاً میاد چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.58,
   "end": 167.66,
   "text": "سیر محسوس رو پیش میگیره که اینو همه حس میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.66,
   "end": 170.14,
   "text": "حس کردیم تجربتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.14,
   "end": 173.04,
   "text": "که از مثلاً اِمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.04,
   "end": 178.44,
   "text": "اون نطفه رسیدیم به علقه و مضغه و جنین و همینطوری به دنیا اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.44,
   "end": 180.8,
   "text": "شدیم طفل و شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.8,
   "end": 185.82,
   "text": "وجودی پیدا کردیم و بلوغ و بعدم پیری که أرذل العمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.82,
   "end": 189.42,
   "text": "ببینید این محسوسه دیگه. میخواد یه اصلو به ما بفهمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.42,
   "end": 195.26,
   "text": "چقدرم این اصل به درد بخوره که میخواد بفهمونه آقا توفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.26,
   "end": 199.76,
   "text": "این نیست که شما فکر کنید نابودیه بلکه یک سیر تکاملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.76,
   "end": 204.86,
   "text": "یعنی موت یک مرحله از تکامل انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.86,
   "end": 210.34,
   "text": "نکته بعد اینه که عرض شد ماده اولیه ما رو از خاک بر میشماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.34,
   "end": 215.52,
   "text": "آیه قرآن زیاد داریم. هو الذي أنشأكم من الأرض از همین خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.52,
   "end": 221.2,
   "text": "واستعمركم فيها. اینه که ما رو زمین ولا میشیم چه آرامشی پیدا میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.2,
   "end": 225.16,
   "text": "چون از این خاکیم. متاسفانه همش دنبال اینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.16,
   "end": 227.14,
   "text": "از این خاک فاصله بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.14,
   "end": 232.64,
   "text": "شاسی بلند سوار شیم، پنت هاوس بشینیم، از این خاک فاصله بگیریم بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.64,
   "end": 243.44,
   "text": "در حسب ظاهر. سیر هفت مرحله قبل از موت رو بیان کرده که عرض کردیم خاک، تراب، نطفه، علقه، مضغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.44,
   "end": 248.64,
   "text": "بعد طفل، طفولیت بعد بلوغه بعد پیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.64,
   "end": 255.22,
   "text": "این سیر مرحله رو سه، هفت مرحله رو داره میگه که این‌ها انسان رو میکشونه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.22,
   "end": 259.82,
   "text": "وهله موت که خودش یک سیر تکاملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.82,
   "end": 263.88,
   "text": "تمام این مراحل رو نکته بعد حضرت حق به خودش نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.88,
   "end": 266.64,
   "text": "خلقناکم. نخرجکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.64,
   "end": 271.08,
   "text": "نقرکم. ما هستیم که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.08,
   "end": 274.48,
   "text": "رحم شما رو قرار میدیم. ما هستیم که شما رو خلق میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.48,
   "end": 276.78,
   "text": "ما هستیم که شما رو خارج میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.78,
   "end": 279.9,
   "text": "این به یک معنا توحید نابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.9,
   "end": 288.6,
   "text": "همه چی به دست خداست و بیده ملکوته کل شیء ولا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 288.6,
   "end": 292.4,
   "text": "سیر تدریجی. نکته بعد سیر تدریجیه در طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.4,
   "end": 296.16,
   "text": "اینکه ثمة ثمة ثمة ثمة ثمة میاد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.16,
   "end": 298.0,
   "text": "سیر تدریجه. دفعة نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.0,
   "end": 299.98,
   "text": "دفعی مال عالم بعده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.98,
   "end": 302.06,
   "text": "عالم بعد که میری واردش میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.06,
   "end": 304.92,
   "text": "مجرد، دفعیه، به یکباره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.92,
   "end": 307.92,
   "text": "حتی ما وقتی دعا میکنیم در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.92,
   "end": 310.08,
   "text": "بالا در ملکوط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.08,
   "end": 315.74,
   "text": "اونجا یا به عبارتی عالم امر هم بهش میگن آناً دعا مستجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.74,
   "end": 317.74,
   "text": "ادعونی استجب لکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.74,
   "end": 322.52,
   "text": "اما پیاده شدن این اسباب استجابت در دنیا تدریج میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.52,
   "end": 325.78,
   "text": "زمان و مکان بر داره. دنیا دار تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.78,
   "end": 328.76,
   "text": "به یک دفعه انسان اونطور نیست که به جایی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.76,
   "end": 335.6,
   "text": "پیغمبر هم چهل سال تو همین دار تدریج زحمت میکشه تا به رسالت برگزیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.6,
   "end": 337.66,
   "text": "نکته بعد مدت حمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.66,
   "end": 341.98,
   "text": "میفرماید که این إلى أجل مسمى مدت هم دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.98,
   "end": 344.88,
   "text": "اینایی که هی میخوان دخالت کنن در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.88,
   "end": 349.56,
   "text": "بارداری و ژنتیک و اینا حواسشون باشه همه چی دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.56,
   "end": 352.38,
   "text": "نکته بعد استقرار نطفه یا صغت اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.38,
   "end": 355.12,
   "text": "حالا چه استقرارش، چه صغتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.12,
   "end": 358.5,
   "text": "میفرماید نقر في الأرحام ما نشأ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.5,
   "end": 364.51,
   "text": "اونطور که ما میخوایم قرار میدیم نقر رو استقرار میدیم نطفه رو در رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.51,
   "end": 368.67,
   "text": "یعنی باز این هم دست خداست که می‌دونید سخت بکنه، نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.67,
   "end": 371.81,
   "text": "اینا همش حکمت داره اگرچه ما بی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 371.81,
   "end": 373.93,
   "text": "ت-توجه به حکمتش را داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.93,
   "end": 380.57,
   "text": "نکته بعد این که می‌فرماید تو این آیه داره صراحتا می‌فرماید همه روز اول یک س-یک سن یک جورند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.57,
   "end": 385.09,
   "text": "چون نمی‌فرماید اطفالاً می‌فرماید طفلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.09,
   "end": 389.67,
   "text": "اطفالاً نه طفلاً. یعنی همه به یک شکل همه طفل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.67,
   "end": 392.51,
   "text": "از رحم مادر بیرون اومدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.51,
   "end": 396.05,
   "text": "یعنی همه طور وجودیتون یک طور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.05,
   "end": 399.85,
   "text": "اینم خیلی جالب که دیگه خدا پارتی بازی نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.85,
   "end": 403.33,
   "text": "نکته بعد اینکه مرگ مخصوص پیران نیست چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.33,
   "end": 408.27,
   "text": "می‌فرماید قبل از اینکه به ارزل الامور برسید یعنی تو همون شدت وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.27,
   "end": 414.73,
   "text": "\"و منکم من یتوفی\" یه عده‌تون رو همونجا تو جوونی عمر جونتون رو می‌گیریم تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.73,
   "end": 417.31,
   "text": "این نشون میده که مرگ فقط مخصوص پیرها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.31,
   "end": 424.57,
   "text": "حواسمون باید باشه. نکته بعد زوجیت در گیاهانه که عرض کردیم \"من کل زوج بهیج\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.57,
   "end": 428.39,
   "text": "از می‌فرماید در نباتات زوج زوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.39,
   "end": 431.51,
   "text": "رشد می‌کنند، شکوفا می‌شن، سرسبز می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.51,
   "end": 434.03,
   "text": "که \"خلق الازواج كله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.03,
   "end": 436.01,
   "text": "سبحان الذي خلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.01,
   "end": 440.49,
   "text": "خلقکم یا سبحان الذي خلق الازواج كله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.49,
   "end": 444.61,
   "text": "خدا کسی‌ست که همه چی رو زوج زوج آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.61,
   "end": 447.85,
   "text": "نکته بعد که خیلی شیرینه چون میگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.85,
   "end": 454.59,
   "text": "خاک به اشدکم بعد از اشدکم به ارذل الامور دو تا قوس رو داره نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.59,
   "end": 456.91,
   "text": "قوس اول قوس صعوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.91,
   "end": 460.21,
   "text": "از خاک صعود می‌کنی میری به شدت وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.21,
   "end": 463.71,
   "text": "دوباره از شدت وجودی میای به حالت پیری و کهولت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.71,
   "end": 465.29,
   "text": "خرف شدن، ارذل الامور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.29,
   "end": 468.83,
   "text": "این میشه نزول. دو تا قوس رو داره بیان می‌کنه تو این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.83,
   "end": 470.75,
   "text": "قوس صعود، قوس نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.75,
   "end": 474.41,
   "text": "اصلاً عالم این شکلیه. به قول مرحوم فارابی قوس موصعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.41,
   "end": 476.83,
   "text": "همه چی حالت قوسی شکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.83,
   "end": 479.71,
   "text": "خلائق هم شما ببینید قوسی شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.71,
   "end": 482.41,
   "text": "گنبد و بارگاه یک نماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.41,
   "end": 483.99,
   "text": "شیعه‌ست قوسی شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.99,
   "end": 486.75,
   "text": "مثلاً مسیحی‌ها قوسی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.75,
   "end": 489.25,
   "text": "صلیب که می‌کشن تیزه نوکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.25,
   "end": 491.61,
   "text": "اما مال ما منح-- انحنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.61,
   "end": 496.09,
   "text": "این در فرهنگ ماست. کلاه خود اینو ببینید انحنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.09,
   "end": 498.79,
   "text": "یا بینی، دست، صورت، سر، پا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.79,
   "end": 503.25,
   "text": "اینا همه نگاه کنید اصلاً وضعیت بدن انسان قوسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.25,
   "end": 505.95,
   "text": "عالم نظام هستی قوسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.95,
   "end": 510.97,
   "text": "هوا، آب بخار میشه میره دو مرتبه برمی‌گرده به صورت بارون قوسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.97,
   "end": 514.03,
   "text": "همه در یک مداری در حرکتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.03,
   "end": 517.37,
   "text": "\"کل فی فلك یسبحون\" همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.37,
   "end": 520.95,
   "text": "اینام نکات زیبائی‌ست که خودش جای بحث داره بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.95,
   "end": 523.63,
   "text": "و نکته دیگه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.63,
   "end": 525.83,
   "text": "استدلال و منطق با کفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.83,
   "end": 528.75,
   "text": "چون اول آیه می‌فرماید \"ان کنتم فی ریب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.75,
   "end": 530.87,
   "text": "اگر شما در شکی‌د از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.87,
   "end": 537.37,
   "text": "شما زنده می‌شید خب حالا گوش بدید \"فانا خلقناکم\" همینطوری شروع می‌کنه ما رو شما رو از خاک آفریدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.37,
   "end": 540.75,
   "text": "این نشون میده که منطق ما داریم، استدلال داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.75,
   "end": 545.27,
   "text": "فقط اه از شاید ضرب و شتم فقط باتوم که دستمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.27,
   "end": 548.69,
   "text": "اول با منطق، اول با استقلا-استدلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.69,
   "end": 552.07,
   "text": "چه جالب که یکی از عزیزان امنیتی همینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.07,
   "end": 553.91,
   "text": "چند روز پیش به ما در دل می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.91,
   "end": 555.79,
   "text": "خیلی صحبته به درازا کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.79,
   "end": 560.45,
   "text": "یکی از حرفاش این بود که تو این جریانات آشوب‌های اخیر از بعضی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.45,
   "end": 562.03,
   "text": "بازیگرا ما دعوت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.03,
   "end": 566.53,
   "text": "مثلاً می‌گفت با یکیشون سه ساعت صحبت کردیم، آخر به گریه افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.53,
   "end": 570.17,
   "text": "به گریه افتاد. گفتم نکنه اینم از بازیگریته، بازیگری دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.17,
   "end": 573.67,
   "text": "این گریه هم از بازیگریته. گریه می‌کرد می‌گفت نه به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.67,
   "end": 575.53,
   "text": "واقعاً من متوجه شدم. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.53,
   "end": 579.19,
   "text": "گفته بود هیچکس تا حالا با ما همچین حرفایی نزده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.19,
   "end": 584.53,
   "text": "حرفای ارتقا، ارتقا بهش بده، استدلال بیاره، براش منطق بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.53,
   "end": 588.15,
   "text": "با ما همچین حرفایی تا حالا هیچکس نزده بود و ما اینو خیلی تجربه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.15,
   "end": 590.63,
   "text": "تو حوزه، تو دانشگاه، مخصوصاً تو دانشگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.63,
   "end": 593.23,
   "text": "جاهای دیگه حرف با استدلال زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.23,
   "end": 600.75,
   "text": "حالا انشالله بعد میریم روزهای بعد پیرامون این صحبت می‌کنیم که این ارذل الامور چه سالی از سال‌های عمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.75,
   "end": 605.51,
   "text": "که روایات بعدی مرحوم مجلسی رو به خودش اختصاص میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.51,
   "end": 609.57,
   "text": "چند تا روایت رو انشالله روزهای بعد قبل از اینکه ورود کنیم به روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.57,
   "end": 616.23,
   "text": "او-اول و دوم و سوم و چهارم و پنجم و ششم که تقریباً یک فهم و داره در باب دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.23,
   "end": 620.37,
   "text": "تو مقدمش این روایتو میاره مرحوم مجلسی که رویا عن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 620.37,
   "end": 625.53,
   "text": "علی علیه الصلاة والسلام ان ارذل الامور شاید شما براتون سؤال شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.53,
   "end": 629.67,
   "text": "چه سالی از عمر وروده به مرحله ارذل الامور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.67,
   "end": 633.79,
   "text": "فرمودن خمسا و سبعون سنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.79,
   "end": 635.95,
   "text": "یعنی هفتاد و پنج سالگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.95,
   "end": 642.49,
   "text": "دیگه آماده باشی. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 642.49,
   "end": 645.39,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 645.39,
   "end": 647.91,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
