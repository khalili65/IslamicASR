 "chapters": [
  {
   "index": 0,
   "title": "## اکراه ابراهیم از مرگ و وجه هدایت خلق",
   "start": 0.42,
   "end": 21.24
  },
  {
   "index": 1,
   "title": "## یار پرکار کم‌هزینه و عمر انبیا در هدایت",
   "start": 21.24,
   "end": 217.3
  },
  {
   "index": 2,
   "title": "## نبوت انبائی و تشریعی",
   "start": 217.3,
   "end": 307.44
  },
  {
   "index": 3,
   "title": "## احیای نفس و غفلت از تربیت فرزند",
   "start": 307.44,
   "end": 1138.14
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 10.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.58,
   "end": 13.4,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.4,
   "end": 16.32,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.32,
   "end": 19.06,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.06,
   "end": 29.82,
   "text": "در خصوص وجه اکراه گونه حضرت ابراهیم در روایت هشتم از باب چهارم کتاب الموت مرحوم مجلسی علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.82,
   "end": 36.92,
   "text": "ما وجوهی رو عرض کردیم. وجه دیگری رو امروز به فضل الهی عرض کنیم از حیث اینکه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.92,
   "end": 40.28,
   "text": "ایشون یه حالت کراهتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.28,
   "end": 42.66,
   "text": "به قول خود خدای منان چون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.66,
   "end": 47.18,
   "text": "متن روایت خدا می‌فرماید \"چه دوستی رو دیدی که کراهت بشماره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.18,
   "end": 49.86,
   "text": "ملاقات دوستش رو؟\" چرا این چنین بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.86,
   "end": 53.18,
   "text": "یه وجهش می‌تونه وجه هدایت خلق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.18,
   "end": 57.4,
   "text": "مثلاً اون روایتی که تقدیم کردیم یه بار از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.4,
   "end": 60.02,
   "text": "اینکه از حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.02,
   "end": 65.2,
   "text": "کلیم الله علی نبینا و آله و علیه الصلاة والسلام پرسیدن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.2,
   "end": 70.48,
   "text": "چگونه جان دادی؟ فرمود مثل گوسفندی که زنده زنده پوستش رو بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.48,
   "end": 78.12,
   "text": "خب این حالت متعارف دقت کنی به روایت، به بطون توجه نکنی، به لایه‌های طولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.12,
   "end": 81.86,
   "text": "در، در طول همین معنا یعنی اون تأویل یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.86,
   "end": 85.04,
   "text": "معانی عمیق‌تر در طول همین ظاهرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.04,
   "end": 89.02,
   "text": "دقت نکنی مثلاً می‌گی این دروغه، این چه حرفیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.02,
   "end": 90.98,
   "text": "روایت رو تکذیب می‌کنی یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.98,
   "end": 94.56,
   "text": "در صورتی که باید دید اون تأویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.56,
   "end": 97.08,
   "text": "منظور از این منطوق رو چی بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.08,
   "end": 100.68,
   "text": "اون باطن این روایت. یه وجهش می‌تونه بحث هدایت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.68,
   "end": 105.74,
   "text": "یعنی حضرت موسی انقدر عاشق هدایت مردم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.74,
   "end": 109.28,
   "text": "انقدر دلسوز مردم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.28,
   "end": 114.48,
   "text": "که جان دادنش به منزله کوتاه شدن دستش از هدایت خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.48,
   "end": 121.2,
   "text": "لذا مثل گوسفندی که زنده زنده پوستش رو بکنند زجر می‌کشه و جان می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.2,
   "end": 122.98,
   "text": "از حیث جهالت مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.98,
   "end": 125.54,
   "text": "اینا غصه دار جهالت مردمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.54,
   "end": 132.18,
   "text": "مثل من و بعضی از دیگه حالا شما جسارته به شما بگم مثل من نیستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.18,
   "end": 136.28,
   "text": "حالا هم و غمشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.28,
   "end": 139.7,
   "text": "خودشون باشن فقط به فکر خودشون باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.7,
   "end": 142.16,
   "text": "مصرفی شدن هیچ خیری برای دیگران ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.16,
   "end": 145.04,
   "text": "وقتی که سـ-س-شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.04,
   "end": 149.26,
   "text": "شهادت امیرالمؤمنین علیه الصلاة والسلام محضر آقا رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.26,
   "end": 153.2,
   "text": "شنیدید دیگه این روایت مشهور و معروف رو که از حضرت چقدر زیرک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.2,
   "end": 156.04,
   "text": "گفت آقا نظر شما درباره من چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.04,
   "end": 160.06,
   "text": "ما امروز مثلاً به امام عصر بگیم آقا نظر شما درباره ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.06,
   "end": 165.44,
   "text": "حضرت فرمودن تو یار پرکار و کم هزینه منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.44,
   "end": 170.4,
   "text": "خیلی از ما برعکسیم. کم کاریم و پرهزینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.4,
   "end": 177.96,
   "text": "در صورتی که اون‌ها نه اون‌ها تمام وجودشون رو خرج کردن تا بتونن یک نفر رو هدایت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.96,
   "end": 181.58,
   "text": "آخه شوخیه مگه که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.58,
   "end": 188.18,
   "text": "دیگه حداقل من بررسی کردم هزار و پونصد و پنجاه سال بر عمر حضرت نوح گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.18,
   "end": 192.54,
   "text": "کم کمش. که نهصد و پنجاه سالش قرآن فرمود توی نبوت بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.54,
   "end": 194.82,
   "text": "هشتاد نفر رو بتونه هدایت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.82,
   "end": 198.44,
   "text": "یا مثلاً هرچی گشتم از ابراهیم سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.44,
   "end": 202.58,
   "text": "و علی نبینا و آله چند نفر رو تونسته پیدا نکردم در منابع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.58,
   "end": 205.38,
   "text": "ولی خب عمرشون صد و هفتاد و پنج سال بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.38,
   "end": 208.98,
   "text": "یکی از انبیایی هستن که خیلی کم عمر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.98,
   "end": 213.96,
   "text": "حضرت ابراهیم. ولی همه هم و غمش هدایت مردم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.96,
   "end": 217.3,
   "text": "هدایت، هدایت. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.3,
   "end": 220.6,
   "text": "بزرگان حالا ما دو نوع نبوت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.6,
   "end": 224.36,
   "text": "نبی کسی فکر نکنه الان دیگه ما نبی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.36,
   "end": 226.7,
   "text": "باب نبوت بسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.7,
   "end": 228.74,
   "text": "نه، ما هم الان نبی زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.74,
   "end": 231.7,
   "text": "بارها اینا رو بحث کردیم تو حکمت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.7,
   "end": 237.1,
   "text": "که ما نبوت انبایی داریم یا تعریفی یا عامه هم بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.1,
   "end": 240.9,
   "text": "نبوت تشریعی داریم. نبوت تشریعی از حیث قانون گذاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.9,
   "end": 243.1,
   "text": "آقا نماز صبح اینطوریه. روزه اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.1,
   "end": 245.42,
   "text": "حج اینطوریه. تمام. دیگه ختم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.42,
   "end": 250.34,
   "text": "تمام شد. دیگه کسی، امام عصر هم نمی‌تونه بیاد دست ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.34,
   "end": 253.1,
   "text": "در شریعت. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.1,
   "end": 254.94,
   "text": "نبوت انبایی بابش بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.94,
   "end": 259.42,
   "text": "یعنی ولی خدا شدن. اصلاً روح نبوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.42,
   "end": 265.34,
   "text": "ولایته. ولی گفتیم اسم خدا هست اما نبی اسم خدا نیست، روح نبوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.34,
   "end": 268.52,
   "text": "ولی به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.52,
   "end": 271.74,
   "text": "باخبر شدنش از علم الهی ولایت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.74,
   "end": 276.54,
   "text": "حالا بخشی از این‌ها مبعوثن، بعثت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.54,
   "end": 279.2,
   "text": "یعنی مأمورن به ابلاغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.2,
   "end": 285.66,
   "text": "ولی بسیاریشون به مراتب بیشتر از اون تعداد صد و چهار هزار نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.66,
   "end": 289.8,
   "text": "مأمور نیستن. اهلشو پیدا کنن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.8,
   "end": 293.0,
   "text": "ولی باز beispielsweise حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.0,
   "end": 296.1,
   "text": "مأمور نبوده که پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.1,
   "end": 299.5,
   "text": "تشریعی نبود اما قطعاً نبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.5,
   "end": 302.44,
   "text": "انبایی بود. یعنی باخبر بود از حقایق عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.44,
   "end": 306.52,
   "text": "یه ملت هم با خودش سعادتمند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.52,
   "end": 310.14,
   "text": "دغدغه داشتن این آیات قرآن رو ببینید چقدر واقعاً آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.14,
   "end": 317.48,
   "text": "سی و دو سوره مائده گاهی اوقات من بهش فکر می‌کنم انقدر هدایت برای خدا ارزشمنده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.48,
   "end": 320.52,
   "text": "تا این حد؟ چه ثوابی گذاشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.52,
   "end": 322.82,
   "text": "مثلاً شما الان یه طعام دادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.82,
   "end": 325.92,
   "text": "ها؟ یه غذا بدی برای امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.92,
   "end": 330.38,
   "text": "ارزشش چقدره؟ رفتید کامل زیارات رو دیدید چقدر ارزش داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.38,
   "end": 333.12,
   "text": "یا مثلاً عید غدیر یه طعام بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.12,
   "end": 335.66,
   "text": "یه طعام مساویست با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.66,
   "end": 338.66,
   "text": "اطعام صد و بیست و چهار هزار پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.66,
   "end": 342.1,
   "text": "این نشون میده الع-- عید غدیر چقدر با عظمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.1,
   "end": 348.46,
   "text": "حالا اینجا تو این آیه می‌فرماید \"من احیاها\" هرکس یه نفر، یه نفس رو زنده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.46,
   "end": 351.38,
   "text": "یعنی هدایت کنه، خدا چه پاداشی بهش می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.38,
   "end": 355.78,
   "text": "\"فکأنما أحیا الناس جميعا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.78,
   "end": 360.22,
   "text": "جمیعا یعنی براش خدا می‌نویسه همه مردم رو هدایت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.22,
   "end": 362.94,
   "text": "الناس همه رو. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.94,
   "end": 367.48,
   "text": "یعنی انقدر خدا براش مهمه هدایت دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.48,
   "end": 370.28,
   "text": "بگذریم الان ما هدایت بچه‌هامون هم مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.28,
   "end": 373.6,
   "text": "ولشون کردیم تو این فضای مجازی پر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.6,
   "end": 375.98,
   "text": "خباثت و کثافت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.98,
   "end": 379.64,
   "text": "آشغالدونی که مرتع شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.64,
   "end": 383.64,
   "text": "ول کردیم بچه‌هامونو. برنامه تربیتی براشون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.64,
   "end": 388.08,
   "text": "تا بچه یه ذره اذیتمون می‌کنه بشین با موبایل یه ذره بازی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.08,
   "end": 391.96,
   "text": "جهنم رو می‌ریم دستش. الان همین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.96,
   "end": 395.7,
   "text": "این بیچاره مدیرکل ارشاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.7,
   "end": 400.72,
   "text": "گیلان مثلا این آبرویی که ازش بردن هیچی هنوز اثبات نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.72,
   "end": 406.18,
   "text": "هم بچه حزب‌اللهی‌ها میان به ما نشون میدن که آقا ببین چه چهره‌ای، چه آبرویی از اصفهان برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.18,
   "end": 410.1,
   "text": "کو اثباتش؟ تو کدوم دادگاه، دادگاه اثبات شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.1,
   "end": 414.12,
   "text": "من امروز بررسی کردم فیلم‌هاش که مثلا بچه‌ها نشون میدادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.12,
   "end": 418.04,
   "text": "اصلا هیچ چهره‌ای ازش نیست. هیچی معلوم نیست اصلا واقعا این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.04,
   "end": 420.3,
   "text": "هنوز اثبات نشده جرم از روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.3,
   "end": 425.42,
   "text": "ادعاست. بعد اسامیه دقیقا وقتی که اوج دستگاه امام حسینೇ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.42,
   "end": 429.22,
   "text": "طرفو عکسشو گذاشتن با مداح با مثلا با میکروفن داره مداحی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.22,
   "end": 432.48,
   "text": "بچه‌ها تو هیئتن سر سفره‌ن اینم بغلشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.48,
   "end": 435.78,
   "text": "آره العیاذ بالله جسارتم ببخشید اینا مفعولاش بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.78,
   "end": 441.9,
   "text": "همینطوری دارن می‌زنن. بعد اصلاح‌طلبام که از اونور از خوداشونه بحث حجاب و عفاف و بزنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.9,
   "end": 444.0,
   "text": "مدعی‌ان که این آقا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.0,
   "end": 447.86,
   "text": "چه می‌دونم رییس کارگروه عفاف و حجاب استان گیلان و such اینا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.86,
   "end": 450.34,
   "text": "بعد بدتر هی دارن می‌زننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.34,
   "end": 454.44,
   "text": "هنوز ادعاها اثبات نشده که عفاف و حجاب و بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.44,
   "end": 460.3,
   "text": "در صورتی که من هرچی بررسی کردم اون همه عناوانی که ایشون داشته یه دونه‌ش مرتبط با عفاف و حجاب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.3,
   "end": 463.6,
   "text": "ببین بازی‌های کثیف سیاسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.6,
   "end": 466.04,
   "text": "متن اجتماع تو فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.04,
   "end": 468.12,
   "text": "بعد خود ما هم داریم گول می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.12,
   "end": 471.16,
   "text": "بذار ثابت شه بعد، بعد تازه بعدا آبروش حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.16,
   "end": 473.04,
   "text": "این چه کاریه؟ این چه برنامه‌ایه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.04,
   "end": 477.04,
   "text": "این چه بساطیه؟ اگه اثبات شد اون‌موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.04,
   "end": 478.96,
   "text": "درست. اما هنوز هیچی به هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.96,
   "end": 483.1,
   "text": "پر شده تو فضای... این کثافتی، خباثتی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.1,
   "end": 486.24,
   "text": "فضای مجازی هست بچه‌های ما رو داره با خودش می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.24,
   "end": 489.94,
   "text": "چقدر شیطان کیف می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.94,
   "end": 491.86,
   "text": "و ما غافل از هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.86,
   "end": 511.86,
   "text": "آیه سه سوره انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 1056.26,
   "end": 1060.02,
   "text": "السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 1060.02,
   "end": 1065.58,
   "text": "ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 1065.58,
   "end": 1070.36,
   "text": "و علی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 1070.36,
   "end": 1074.9,
   "text": "حلّت بفناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 1074.9,
   "end": 1077.74,
   "text": "علیک منّی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 1077.74,
   "end": 1082.36,
   "text": "سلام الله ابدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 1082.36,
   "end": 1087.8,
   "text": "ما بقیت و بقي الليل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 1087.8,
   "end": 1092.6,
   "text": "النهار. فالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 1092.6,
   "end": 1097.96,
   "text": "جعله الله اخر العهد منّی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 1097.96,
   "end": 1101.04,
   "text": "لزيارتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 1101.04,
   "end": 1114.3,
   "text": "همه با هم. السلام علی الحسین و علی علی ابن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 1114.3,
   "end": 1116.18,
   "text": "بگو به یاد پدر مادرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 1116.18,
   "end": 1119.36,
   "text": "و علی اولاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 1119.36,
   "end": 1126.98,
   "text": "الحسین و علی أصحاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 1126.98,
   "end": 1134.46,
   "text": "به 사랑 شهدای کربلا صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 1134.46,
   "end": 1138.14,
   "text": "اللهم صل علی محمد و آل محمد. اللهم کن له ما وعده و اجعله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}