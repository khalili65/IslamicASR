 "chapters": [
  {
   "index": 0,
   "title": "## بازگشت به جوهرِ اول و حرکتِ روح به نفس",
   "start": 12.96,
   "end": 34.4
  },
  {
   "index": 1,
   "title": "## زبانِ حالِ شهدا در حرمِ شاه‌چراغ",
   "start": 34.4,
   "end": 54.56
  },
  {
   "index": 2,
   "title": "## قیاس با روحِ خبیثه و اهمیتِ نحوهٔ مرگ",
   "start": 54.56,
   "end": 373.18
  },
  {
   "index": 3,
   "title": "## سیرهٔ حضرت عبدالعظیم حسنی",
   "start": 373.18,
   "end": 502.72
  },
  {
   "index": 4,
   "title": "## خطوطِ آشکار، جهادِ تبیین و مساجد",
   "start": 502.72,
   "end": 731.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 3.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.0,
   "end": 7.72,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.72,
   "end": 9.84,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.84,
   "end": 15.0,
   "text": "به نوبه خودم تسلیت عرض می‌کنم این واقعه دردناک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.0,
   "end": 22.36,
   "text": "به همه عزیزان و محبین اهل بیت علیهم الصلاة والسلام، انسان‌های آزاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.36,
   "end": 24.66,
   "text": "و برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.66,
   "end": 28.14,
   "text": "سیر بحث‌مون هم منقطع نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.14,
   "end": 31.56,
   "text": "اجازه بدید که اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.56,
   "end": 36.06,
   "text": "اشاره کنم به یک بخشی از حدیثی که در متن‌ش واقع شده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.06,
   "end": 39.48,
   "text": "بعد مطالبی رو پیرامون حادثه اخیر عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.48,
   "end": 45.92,
   "text": "در روایت چهارم از باب اول کتاب الموت مرحوم مجلسی رسیدیم به اینجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.92,
   "end": 52.14,
   "text": "\"و یرجع کلن\" همه چی بر می‌گردد \"إلی جوهره الأول\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.14,
   "end": 57.5,
   "text": "بعد نکته خیلی جالب توجه این بود که \"و تحرکت الروح بالنفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.5,
   "end": 60.72,
   "text": "اینجا بودیم. پیرامون نفس داشتیم سخن می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.72,
   "end": 65.94,
   "text": "دقت کنید چه عجیب که می‌فرماید روح با چی حرکت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.94,
   "end": 70.54,
   "text": "با نفس. یعنی دقت کنید نفس نشون می‌ده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.54,
   "end": 73.02,
   "text": "روح به کجا میره. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.02,
   "end": 76.42,
   "text": "چون روح و تحرکت الروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.42,
   "end": 81.24,
   "text": "بالنفس، به نفس روح حرکت می‌کنه که قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.24,
   "end": 88.68,
   "text": "اگر چنانچه روح بیاد احکام خودش رو از طریق نفس اماره پیاده کنه در بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.68,
   "end": 93.84,
   "text": "انسان صورتش می‌شه صورتی از آتش و خودش هم نار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.84,
   "end": 100.2,
   "text": "و اما اگر از طریق نفس مطمئنه احکامش رو پیاده کنه در بدن انسان می‌شود صورتی از نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.2,
   "end": 103.72,
   "text": "و خودش هم نور می‌شود. عینیت با نور پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.72,
   "end": 107.54,
   "text": "نوریان من مر نوریان را جذبم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.54,
   "end": 110.7,
   "text": "ناریان مر ناریان را جذبم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.7,
   "end": 113.1,
   "text": "این شکلی می‌شه. یعنی اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.1,
   "end": 115.04,
   "text": "جذب می‌کنن اهل خودشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.04,
   "end": 118.72,
   "text": "شما در همین اتفاقی که افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.72,
   "end": 121.54,
   "text": "در حرم حضرت شاه چراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.54,
   "end": 125.92,
   "text": "سلام الله عليه. خب خیلی صحبت‌ها می‌شه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.92,
   "end": 129.26,
   "text": "تو این فرصت کوتاه من یکی دو تا نکته عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.26,
   "end": 134.84,
   "text": "ما چه می‌دونیم در خلوت این شهدایی که چه اون‌هایی که سنشون کم بود، چه اون‌هایی که مثل اون خادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.84,
   "end": 137.3,
   "text": "ریش سفیدی که در حرم شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.3,
   "end": 140.36,
   "text": "چه می‌دونیم زبان حال این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.36,
   "end": 145.92,
   "text": "عین ثابت این‌ها در ثقل ذات حضرت حق که بحثش قبلاً گذشت چی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.92,
   "end": 148.76,
   "text": "مطمئن باشید به قول بزرگان این قبیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.76,
   "end": 151.92,
   "text": "مرگ‌ها یا شهادت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.92,
   "end": 156.36,
   "text": "سر قفلی داره. یکی عموی یکی از بچه‌های حیاط ما روضه خون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.36,
   "end": 160.66,
   "text": "سید روحانی رو منبر در حال روضه خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.66,
   "end": 164.92,
   "text": "در محرم جون داد. کی توفیق پیدا می‌کنه اینطوری جون بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.92,
   "end": 167.88,
   "text": "بزرگان فرمودن این جون مردن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.88,
   "end": 170.32,
   "text": "که شهادت حساب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.32,
   "end": 174.96,
   "text": "سر قفلی داره. یعنی نصیب هر کسی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.96,
   "end": 179.18,
   "text": "خب اینکه یه عده تو حرم اینطوری شهید می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.18,
   "end": 187.52,
   "text": "این چنین خون‌ها رو به جوش میارن که انده این انقلاب که همیشه تضمین شده به خون شهدا بوده این ه- این دفعه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.52,
   "end": 194.74,
   "text": "ضمانت چندین خون پاک یک جای خاص و مقدسی رو نیاز داشت این اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.74,
   "end": 197.4,
   "text": "همیشه این انقلاب رو موج خون شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.4,
   "end": 200.58,
   "text": "حرکت کرده نشون میده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.58,
   "end": 206.6,
   "text": "حرکت، دقت بفرمایید حرکت روح پاک این شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.6,
   "end": 211.08,
   "text": "به وسیله نفس‌شون. نشون میده نفس این‌ها چقدر پاک بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.08,
   "end": 214.16,
   "text": "که روح‌شون رو این چنین حرکت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.16,
   "end": 218.14,
   "text": "شما چه می‌دونید؟ ما چه می‌دونیم حتی اون بچه خردسال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.14,
   "end": 222.52,
   "text": "یه وقتی شاید در تشییع حاج قاسمی، شهیدی، جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.52,
   "end": 226.86,
   "text": "یه آهی کشیده خدایا میشه مثلاً منم در راه تو شهید شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.86,
   "end": 230.5,
   "text": "چه می‌دونی اون پیرمرد همچنین، اون زن‌ها همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.5,
   "end": 234.0,
   "text": "و به هر حال اون طهارت nefsi که داشتن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.0,
   "end": 237.82,
   "text": "زبان حالشون رو می‌بینه و این چنین اختیارشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.82,
   "end": 241.88,
   "text": "یادش بخیر ما تازه که انقلاب شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.88,
   "end": 245.2,
   "text": "هیچ‌وقت یادم نمیره بالای تخت سیاهمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.2,
   "end": 249.8,
   "text": "من نوجوون بودم. یه جمله‌ای از امام نوشته بود که من اون رو همیشه سر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.8,
   "end": 252.48,
   "text": "دفترم می‌نوشتم. هنوزم حفظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.48,
   "end": 257.24,
   "text": "بعد از شاید بیست سال دوباره یادم افتاد که ما نه بر نیمکت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.24,
   "end": 261.76,
   "text": "که مر- که بر موج‌های خون شهیدان نشسته ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.76,
   "end": 265.28,
   "text": "واقعاً این چنینه. هرچی داریم از خون این شهداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.28,
   "end": 267.42,
   "text": "و این هم از نفوس پاک اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.42,
   "end": 269.52,
   "text": "حالا شما اینو بیایید قیاس کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.52,
   "end": 272.68,
   "text": "با حرکت روح خبیثه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.68,
   "end": 276.06,
   "text": "که نفس ناپاکش حرکتش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.06,
   "end": 279.5,
   "text": "در انقلاب زیاد داشتیم. الان هم داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.5,
   "end": 283.16,
   "text": "که یکی به درک واصل می‌شه، یکی می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.16,
   "end": 286.42,
   "text": "نفس پلیدش حرکتش می‌ده روحش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.42,
   "end": 290.86,
   "text": "به چه سمتی؟ که همه ارواح خبیثه متوجه اون می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.86,
   "end": 294.9,
   "text": "حالا دیگه اسم نبرم. تو انقلاب داشتیم به کر-- می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.9,
   "end": 300.74,
   "text": "خیلی مهمه انسان چگونه بمیره و وقت مرگش چه پیامدی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.74,
   "end": 302.86,
   "text": "اصلاً قابل قیاس هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.86,
   "end": 306.16,
   "text": "مرگ مثلاً اون خانم با مرگ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.16,
   "end": 314.98,
   "text": "کسایی که تو حرم شاه چراغ فقط امروز دیدید دیگه هنوز که ادامه داره در شاه چراغ، در شیراز چه غوغایی به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.98,
   "end": 317.06,
   "text": "یه چیزی شبیه مثلاً شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.06,
   "end": 321.38,
   "text": "حاج قاسم. این‌ها اولاً نیاز انقلابه و خوشا به سعادت اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.38,
   "end": 324.12,
   "text": "ثانیاً نشان‌دهنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.12,
   "end": 329.54,
   "text": "حرکت باز عرض می‌کنم حرکت روح پاک اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.54,
   "end": 331.6,
   "text": "به وسیله نفس پاکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.6,
   "end": 333.7,
   "text": "اگر طهارت نفس نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.7,
   "end": 336.0,
   "text": "این چنین نبود. خوشا به سعادتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.0,
   "end": 338.24,
   "text": "اشک می‌ریزیم، گریان هستیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.24,
   "end": 341.62,
   "text": "واقعاً خوشا به-- ای کاش ما جای اون‌ها بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.62,
   "end": 346.8,
   "text": "واقعاً. این برکت، یکی از معانی که بر برکت عمر دادن همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.8,
   "end": 352.88,
   "text": "اصلاً نحوه مرگ، عزیزان نحوه مرگ ما ماحصل عمر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.88,
   "end": 355.16,
   "text": "اونچه که، اونطور که ما می‌میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.16,
   "end": 357.96,
   "text": "بستگی داره به اینکه چگونه زندگی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.96,
   "end": 361.24,
   "text": "همین حضرت شاه عبدالعظیم حسنی صلوات الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.24,
   "end": 364.02,
   "text": "امشب شب میلادشونه دیگه. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.02,
   "end": 368.48,
   "text": "این بزرگوار یکی از دلایلی که گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.48,
   "end": 374.26,
   "text": "زیارت ایشون رو امام معصوم مساوی با زیارت ابا عبدالله گفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.26,
   "end": 377.7,
   "text": "آیا بر نمی‌گرده به ایام دوران زندگیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.7,
   "end": 382.06,
   "text": "که هجده بار حرم سید الشهدا تخریب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.06,
   "end": 387.96,
   "text": "این بزرگوار به اتفاق یارانشون برن حرم امام حسین رو ترمیم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.96,
   "end": 390.86,
   "text": "و کی اون موقع همچین کاری می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.86,
   "end": 395.94,
   "text": "در حالی که کسی به سمت امام حسین حرکت می‌کرد سرشو می‌زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.94,
   "end": 398.8,
   "text": "از تیغ می‌گذروندنش. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.8,
   "end": 403.34,
   "text": "شبانه در تاریخ نوشته، شبانه به یارانشون می‌رفتن ترمیم می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.34,
   "end": 406.88,
   "text": "دوباره توسط هارون الرشید و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.88,
   "end": 409.86,
   "text": "حرم تخریب می‌شد. قبر سید الشهدا تخریب می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.86,
   "end": 413.8,
   "text": "حداقل هجده بار در تاریخ نوشته حضرت عبدالعظیم حسنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.8,
   "end": 417.62,
   "text": "حرم سید الشهدا رو بعد از تخریب، تخریب ترمیم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.62,
   "end": 423.4,
   "text": "ببینید این زندگی، زندگی پربرکت، این یک وجهشه، یک شانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.4,
   "end": 427.22,
   "text": "باید همچنین برکتی کنه که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.22,
   "end": 431.16,
   "text": "زمانش بیاد بگه هرکس به زیارتش بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.16,
   "end": 434.4,
   "text": "ثواب زیارت سید الشهدا در کربلا رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.4,
   "end": 437.26,
   "text": "اینا همش حساب شده. حالا خود حضرت عبدالعظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.26,
   "end": 440.5,
   "text": "صلوات الله علیه هم در ناز و نعمت زندگی نکرده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.5,
   "end": 444.2,
   "text": "زندگی‌نامه‌ش رو بخونید در خفقان، در گرفتاری‌های شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.2,
   "end": 446.84,
   "text": "اصلاً می‌دونستید ایشون به یک روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.84,
   "end": 453.54,
   "text": "زنده به گور شدن؟ همون جایی که دفنن حضرت عبدالعظیم، یه روایت میگه همونجا زنده به گور شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.54,
   "end": 455.94,
   "text": "یعنی زنده زنده همونجا دفن شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.94,
   "end": 458.08,
   "text": "توسط حکام زمانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.08,
   "end": 462.2,
   "text": "اینجوری نبوده در ناز و نعمت زندگی کنن و بعد هم همچنین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.2,
   "end": 469.12,
   "text": "و جالب، عجیبه که واقعاً در انقلاب ما کسایی بیشتر نق می‌زنن، بیشتر داد می‌زنن، بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.12,
   "end": 475.54,
   "text": "اذیت می‌کنن مردم رو از اون بالا بگیر مسئولینی که متاسفانه یه زمانی شاید خوب بودن بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.54,
   "end": 479.62,
   "text": "منحرف شدن، جذب دنیا شدن، قدرت گرفتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.62,
   "end": 482.66,
   "text": "تا دیگران. معمولاً آدمایین که می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.66,
   "end": 489.48,
   "text": "نه حالا همه ولی غالباً وضعشون خیلی بهتر از این پا برهنه ها و طرفدارای انقلاب و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.48,
   "end": 497.33,
   "text": "یعنی اون‌ها تو ناز و نعمتن بعد از این طرف طرفداران انقلاب و اینا در سختی اما حرف حق رو، کلمه‌ی حق رو می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.33,
   "end": 500.34,
   "text": "و من یه توصیه بکنم به خودم و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.34,
   "end": 506.36,
   "text": "به هر حال دیگه اولاً که این حرکت عظیم و واقعاً بی‌نظیر مردم دیروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.36,
   "end": 510.14,
   "text": "در سرتاسر کشور نشون داد که دیگه مماشات بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.14,
   "end": 512.38,
   "text": "واقعاً دیگه باید با جدیت برخورد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.38,
   "end": 515.06,
   "text": "الان دیگه خط‌ها دیگه مشخص شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.06,
   "end": 519.44,
   "text": "ثانیاً کاملاً برهنه شد یعنی برهنه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.44,
   "end": 523.46,
   "text": "چیه این‌ها؟ اون پوزیشنی که داشتن، قیافه‌ای که داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.46,
   "end": 530.18,
   "text": "همش فحاشی و یعنی باور کنید من خودم به شخصه با بعضیاشون حاضرم با صحبت شدن فقط فحش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.18,
   "end": 532.32,
   "text": "هیچ حرفی ندارن برای زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.32,
   "end": 534.6,
   "text": "بزرگان ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.6,
   "end": 541.26,
   "text": "میان فرهیختگان مثلاً حوزه و دانشگاه حاضر شدن با مثلاً سرکرده‌های اون‌ها حتی این اخیراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.26,
   "end": 544.78,
   "text": "مناظره بذارن. فقط فحش دادن اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.78,
   "end": 548.66,
   "text": "اینو ما شاهد بودیم. یعنی اصلاً حرفی برای گفتن ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.66,
   "end": 551.34,
   "text": "جز برهنگی و فحاشی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.34,
   "end": 554.5,
   "text": "یعنی دارن خودشون رو، چهره‌شون رو فاش‌تر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.5,
   "end": 557.98,
   "text": "من خواهش می‌کنم که دو تا کار بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.98,
   "end": 561.78,
   "text": "به هر حال جهاد تبیین هست و دیگه نباید ساکت نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.78,
   "end": 567.44,
   "text": "تا می‌تونیم اولاً خودمون الان همین حرفایی که من دارم برای شما و خودم می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.44,
   "end": 573.06,
   "text": "و بیان می‌کنم، همین خودش یک جهاد تبیین و یک خودش یک تولیده، تولید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.06,
   "end": 575.06,
   "text": "محتواست. میره حالا تو یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.06,
   "end": 579.96,
   "text": "از یک وجه میره توی کانال مثلاً دوازده، سیزده هزار نفره شما می‌شنوید به این و اون می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.96,
   "end": 582.64,
   "text": "این خودش یه تولیده. اگر می‌توانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 582.64,
   "end": 585.58,
   "text": "الحمد لله بین شما اصحاب فکر زیادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 585.58,
   "end": 589.68,
   "text": "تولید محتوا کنیم و این رو نشر بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.68,
   "end": 593.06,
   "text": "نمی‌تونیم، یه کانال تو همون کا-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.06,
   "end": 598.84,
   "text": "همراه گوشی همراه خودت، یه کانال تو ایتا، یه جایی بالاخره تشکیل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.84,
   "end": 605.34,
   "text": "چند نفر رو عهد کن و شروع کن آنچه که حرف حق و مسلمه است رو ترویج بده، نشر بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.34,
   "end": 607.24,
   "text": "ما آثار و برکاتش رو زیاد دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.24,
   "end": 610.38,
   "text": "این حداقل کاریه که ما می‌تونیم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.38,
   "end": 617.6,
   "text": "حتی بعد از این حرکت عظیمی که دیروز مردم کردن در کف خیابان‌ها و این‌ها در شهرهای مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.6,
   "end": 620.92,
   "text": "باز الان وظیفه مساجد خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 620.92,
   "end": 625.22,
   "text": "یعنی م- من اگر من مثلاً امام جماعت بودم یه مسجدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 625.22,
   "end": 627.46,
   "text": "مردم محل رو جمع می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.46,
   "end": 634.46,
   "text": "به جای اینکه اونا بیان بیرون هر شب یه دو سه ساعتی مانور مردمی، مردمی نه نیروی امنیتی، مردمی می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.46,
   "end": 637.6,
   "text": "دیده شد و دیدیم جایی که تو محل خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.6,
   "end": 641.08,
   "text": "ما جوون‌هایی که مرگ بر دیکتاتور مثلاً بیست نفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.08,
   "end": 647.48,
   "text": "سی نفر به محض اینکه ما یک نفر شروع کردیم گفتیم مرگ بر منافق، همشون خفه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.48,
   "end": 649.86,
   "text": "بعد مردم دیگه با ما همراه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.86,
   "end": 655.44,
   "text": "مردم غالباً اون قشر خاکستری منتظرن یه نفر بره جلو اینا پشت سرشون بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.44,
   "end": 659.78,
   "text": "امتحان کنید. تو محله‌تون اونایی که میگن اگه جیگرشو دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.78,
   "end": 666.58,
   "text": "که الحمد لله دارید در دل اونا یا دور دست هستن از بالای پشت بومتون بگید بر مقابل اونا یه حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.58,
   "end": 669.14,
   "text": "ببینید چند نفر همراهتون میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 669.14,
   "end": 674.98,
   "text": "توجه کردید؟ یعنی راه بیفتن مردم بالاخره از مساجد که متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 674.98,
   "end": 682.04,
   "text": "حالا من پریشب یه مسجدی بودم که یکی از سردمداران نظام، یکی از چهره‌های شاخص خوب و علمی نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 682.04,
   "end": 685.1,
   "text": "اونجا امام جماعت بود. رفتیم خلوت اصلاً کسی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 685.1,
   "end": 688.78,
   "text": "خیلی غصه خوردم. خیلی واقعاً غصه خوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.78,
   "end": 695.32,
   "text": "که این مساجد باید دست کسایی بیفته که الان وظیفه اصلی به نظر بنده دست مساجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 695.32,
   "end": 698.52,
   "text": "یعنی بعد از این اتفاقات مساجد باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 698.52,
   "end": 700.46,
   "text": "بسم الله بگن قیام کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 700.46,
   "end": 704.58,
   "text": "با همین شیوه‌ای که من عرض کردم بسم الله‌شو بگن شروع کنن رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 704.58,
   "end": 707.84,
   "text": "بعد می‌بینید اینا دمشونو می‌ذارن رو کولشونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 707.84,
   "end": 711.14,
   "text": "و محله‌ها پاکسازی می‌شه. عزیز دلم بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.14,
   "end": 716.72,
   "text": "نماز ان‌شاءالله آله یاسین رو به نیت شاهدای شاه چراغ می‌خونن، روضه می‌خونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 716.72,
   "end": 723.54,
   "text": "شادی روح همشون ان‌شاءالله که ما رو دعا کنن در محضر اربابمون سید الشهدا ما هم ان‌شاءالله به این فیض‌ها برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.54,
   "end": 728.0,
   "text": "بخوانید. اللهم مغفر ورحم لمن يقرأ الفاتحة ما السلامة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.0,
   "end": 731.06,
   "text": "الله ما السلامة ما السلامة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}