   "end": 102.38
  },
  {
   "index": 1,
   "title": "## فإذا جاء الموت؛ آمدنِ خلقِ ازپیش‌موجود",
   "start": 102.38,
   "end": 158.32
  },
  {
   "index": 2,
   "title": "## دخول موت در انسان و خروج حیات",
   "start": 158.32,
   "end": 178.54
  },
  {
   "index": 3,
   "title": "## دعای تجافی؛ آمادگی برخاستن از دار غرور",
   "start": 178.54,
   "end": 263.74
  },
  {
   "index": 4,
   "title": "## موت وجودی و استعداد؛ پیش از حلول فوت",
   "start": 263.74,
   "end": 369.79
  },
  {
