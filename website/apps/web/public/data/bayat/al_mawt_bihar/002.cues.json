  {
   "index": 6,
   "title": "## تجرد شقاوتی، سعادتی و بینابینانِ فوت‌شونده",
   "start": 450.97,
   "end": 514.11
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 4.88,
   "text": "سلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.88,
   "end": 7.7,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 12.44,
   "text": "میریم سراغ دومین روایت از باب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.44,
   "end": 16.32,
   "text": "کتاب الموت بحار مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.32,
   "end": 19.22,
   "text": "روایات عجیبی رو ایشون جمع کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.22,
   "end": 24.38,
   "text": "که انشاالله سر این سفره این روایات بهره خوبی ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.38,
   "end": 28.6,
   "text": "دومین روایت از امام باقر هست پیرامون موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.6,
   "end": 31.34,
   "text": "الحیاة والموت خلقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.34,
   "end": 35.98,
   "text": "من خلق الله. خب اینجا داره نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.98,
   "end": 39.02,
   "text": "موت هم مثل حیات خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.02,
   "end": 41.8,
   "text": "یعنی یک امر عدمی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.8,
   "end": 44.6,
   "text": "وجودیه. موجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.6,
   "end": 47.26,
   "text": "موت همین الان موجوده، خلق الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.26,
   "end": 49.76,
   "text": "اینطوری نیست که شما گمان کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.76,
   "end": 53.0,
   "text": "عدمه، یه وقتی ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.0,
   "end": 56.0,
   "text": "خلق میشه. نه، خلق شده موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.0,
   "end": 60.96,
   "text": "و الان همراه ماست. مثل بدن مثالی که الان همراه ما هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.96,
   "end": 65.4,
   "text": "وقتی می‌خوابیم توجه نفس ناطقه به اون بدن میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.4,
   "end": 70.94,
   "text": "اون فعال میشه. الان همراه ماست و توجه نفس ناطقه از این جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.94,
   "end": 75.42,
   "text": "ما برداشته میشه، این میفته یه گوشه، یه لاشه‌ای میشه موقع خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.42,
   "end": 83.28,
   "text": "موت هم همینطوره. برای همین اگر کسی توجهش رو به موت بندازه می‌تونه به موت اختیاری برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.28,
   "end": 86.62,
   "text": "قبل از اینکه به اون موت اجباری ببرنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.62,
   "end": 88.56,
   "text": "لذا موت قبل ان تموتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.56,
   "end": 94.0,
   "text": "امکانش هست. پس الحیاة والموت خلقان من خلق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.0,
   "end": 96.0,
   "text": "حالا اینجا چرا خلق الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.0,
   "end": 98.22,
   "text": "خلق رحمان نه، رحیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.22,
   "end": 102.38,
   "text": "این‌ها حرف‌هایی است که بماند شاید از حوصله شما خارج باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.38,
   "end": 104.44,
   "text": "فإذا جاء الموت وقتی موت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.44,
   "end": 107.42,
   "text": "ببینید نمیگه وقتی موت خلق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.42,
   "end": 110.92,
   "text": "فإذا جاء الموت قبلاً خلق شده حالا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.92,
   "end": 113.34,
   "text": "یعنی موت یک خلقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.34,
   "end": 117.06,
   "text": "یک خلق الهیه. نگاهمون نسبت به موت عوض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.06,
   "end": 122.82,
   "text": "لذا میگه ملک الموت شاید به یک معنا اصلا موت همین ایشونه وقتی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.82,
   "end": 125.12,
   "text": "چون حقیقت موته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.12,
   "end": 129.56,
   "text": "مجری اسم الممیت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.56,
   "end": 133.94,
   "text": "همونطور که شیطان هم مجری اسم المضل حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.94,
   "end": 136.42,
   "text": "اصلا همه عالم اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.42,
   "end": 139.62,
   "text": "ظهرت الموجودات ان بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.62,
   "end": 143.3,
   "text": "شما هم بسم اللهی، شیطان هم بسم اللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.3,
   "end": 146.14,
   "text": "عجب! ملک الموت هم بسم اللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 146.14,
   "end": 153.44,
   "text": "کسی که با اسماء الهی خو کرد و توجه کرد و با طهارت نفس اون‌ها رو مسح کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.44,
   "end": 156.12,
   "text": "همین جا می‌میره. همین جا به موت میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 156.12,
   "end": 158.32,
   "text": "یک استعداده حالا بهش می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.32,
   "end": 160.4,
   "text": "فدخل في الإنسان. عجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 160.4,
   "end": 164.92,
   "text": "این موت میاد داخل میشه به انسان، داخل میشه در ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.92,
   "end": 168.36,
   "text": "لم ی-- لم يدخل في شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.36,
   "end": 170.66,
   "text": "إلا وخرجت منه الحياة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.66,
   "end": 177.34,
   "text": "این موت وارد نمیشه در چیزی مگر اینکه اول حیات از اون خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 177.34,
   "end": 180.08,
   "text": "پس پیداست حیات هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 180.08,
   "end": 182.58,
   "text": "یک خلقه. موت هم یک خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 182.58,
   "end": 185.92,
   "text": "منتها ما همش توجهمون به حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 185.92,
   "end": 188.88,
   "text": "به موت توجه نداریم لذا می‌ترسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 188.88,
   "end": 192.78,
   "text": "دل نگرانیم. حالا این روایت دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 192.78,
   "end": 198.18,
   "text": "برای اینکه این روایتو یه مقدار بهتر فهم کنیم اجازه بدید اون روایت شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.18,
   "end": 203.52,
   "text": "جلد نود و پنج صفحه شصت و سه خود بحار رو بیاریم که در ادعه هم وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 203.52,
   "end": 205.52,
   "text": "که فرمودن این دعا رو زیاد بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.52,
   "end": 209.9,
   "text": "اللهم ارزقنا تجافي، تجافي یه حالتیه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 209.9,
   "end": 211.78,
   "text": "نه نشسته‌ای نه ایستاده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 211.78,
   "end": 213.76,
   "text": "می-- اینطوری یه جوری می‌شینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 213.76,
   "end": 217.6,
   "text": "آماده بلند شدنی. میگه خدایا روزی ما کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 217.6,
   "end": 219.86,
   "text": "at تجافي عن دار الغرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 219.86,
   "end": 225.52,
   "text": "اینجا دار غروره. من آماده بشم برای بلند شدن از این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.52,
   "end": 227.38,
   "text": "خب چگونه از این عالم بلند شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 227.38,
   "end": 229.64,
   "text": "خودش داره می‌فرماید سلسله‌وار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 229.64,
   "end": 232.54,
   "text": "والعنا به إلى دار الخلود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 232.54,
   "end": 238.36,
   "text": "من برگردم توجهم برگر-- مثل کسی که پشت کرده به آفتاب، سایه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 238.36,
   "end": 241.22,
   "text": "رو بکنه آفتاب ببین اصلا دیگه سایه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 241.22,
   "end": 245.64,
   "text": "اصلو می‌بینی. چون ما پشت کردیم به دار الخلود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 245.64,
   "end": 247.66,
   "text": "همش تو سایه‌ایم، تو ظلمتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 247.66,
   "end": 253.66,
   "text": "والعنا به برگرد إلى دار الخلود نگاه کن که تو قراره به اونجا بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 253.66,
   "end": 255.98,
   "text": "منزل ابدیت رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 255.98,
   "end": 259.28,
   "text": "حالا اینجا والاستعداد للموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 259.28,
   "end": 263.74,
   "text": "اینجا موت رو همراه یک استعدادی معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 263.74,
   "end": 268.52,
   "text": "یعنی اولاً موت عرض کردیم یک امر وجودی‌ست نه عدمی، موجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 268.52,
   "end": 273.24,
   "text": "ثانیا یک استعداده. اگه مثلا ما سر تا پامون استعداده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 273.24,
   "end": 275.82,
   "text": "این استعدادها باید چی بشه؟ شکوفا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 275.82,
   "end": 282.64,
   "text": "اگر این استعداد استعداد للموت، اگر کسی استعداد موتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 282.64,
   "end": 285.56,
   "text": "اگر شکوفا نشد چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 285.56,
   "end": 292.38,
   "text": "قبل حلول الفوت، قبل از اینکه اون فوت حاصل بشه، این جزو نادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 292.38,
   "end": 295.5,
   "text": "روایاتیه که درش فوت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 295.5,
   "end": 297.82,
   "text": "همه جا وفات اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 297.82,
   "end": 302.92,
   "text": "مثلا ال-- در آیه قرآن الله يتوفى ال-- يتوفى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 302.92,
   "end": 306.02,
   "text": "الأنفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 306.02,
   "end": 310.2,
   "text": "خدا توفی می‌کنه، می‌گیره همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 310.2,
   "end": 312.5,
   "text": "حیات ما رو وقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 312.5,
   "end": 315.62,
   "text": "اما اینجا به فوت اومده. فوت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 315.62,
   "end": 317.96,
   "text": "فوت در برابر، برابر وفات یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 317.96,
   "end": 321.28,
   "text": "وفات یعنی اخذ به کامل هو-- وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 321.28,
   "end": 324.12,
   "text": "خدا امانت تو رو همه وجودتو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 324.12,
   "end": 327.1,
   "text": "هرچی هست می‌گیره. اما وفات یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 327.1,
   "end": 329.84,
   "text": "فوت یعنی چی؟ فوت یعنی نابودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 329.84,
   "end": 332.7,
   "text": "اینجا می‌فرماید قبل حلول الفوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 332.7,
   "end": 336.1,
   "text": "پس میشه که فوت اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 336.1,
   "end": 339.3,
   "text": "کی فوت یعنی نابودی اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 339.3,
   "end": 342.1,
   "text": "وقتی که استعداد موت حاصل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 342.1,
   "end": 346.9,
   "text": "عجب! پس استعداد موت باید ایجاد بشه در ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 346.9,
   "end": 349.22,
   "text": "یعنی قابلیت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 349.22,
   "end": 353.36,
   "text": "چون قراره بچشیش. تو آماده کنی خودتو برای چشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 353.36,
   "end": 355.98,
   "text": "کل نفس ذائقة الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 355.98,
   "end": 357.94,
   "text": "موت چشیدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 357.94,
   "end": 361.12,
   "text": "اگر آماده این استعداد نشدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 361.12,
   "end": 363.89,
   "text": "اون موقع فوت حاصل میشه، یعنی نابود میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 363.89,
   "end": 365.95,
   "text": "این معنی نابودی اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 365.95,
   "end": 369.55,
   "text": "جزو نوادر این حدیث که درش فوت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 369.55,
   "end": 372.63,
   "text": "حالا مثالی که برای سهولت فهم عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 372.63,
   "end": 377.17,
   "text": "برای امروز کفایت می‌کنه. مثالی که بعضی از بزرگان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 377.17,
   "end": 380.63,
   "text": "شرح این حدیث یعنی آیات گفتن خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 380.63,
   "end": 386.35,
   "text": "گفتن شما گمان کنید یه مثلاً حیوان حلال گوشتی، گوسفند کمالش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 386.35,
   "end": 388.79,
   "text": "کمال گوسفند اینه که ذبح بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 388.79,
   "end": 391.97,
   "text": "انسان بخورش بشه جزء وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 391.97,
   "end": 395.09,
   "text": "اون اتحاد آک-آکل و مأکول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 395.09,
   "end": 398.01,
   "text": "شما اون که خوردی دیگه تو می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 398.01,
   "end": 401.81,
   "text": "تو همون می‌شی. حالا این حیوان حلال گوشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 401.81,
   "end": 406.39,
   "text": "تو نخوریش ذبح نشه تو یه جوی یه گوشه‌ای از یه بیابونی بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 406.39,
   "end": 408.21,
   "text": "از بین بره، ضایع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 408.21,
   "end": 412.69,
   "text": "اصطلاحاً این میگن ضایع بشه، گم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 412.69,
   "end": 415.23,
   "text": "احسنت. به این میگن چه حالتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 415.23,
   "end": 418.03,
   "text": "فوت شدن یعنی نابود شد به کمال نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 418.03,
   "end": 422.39,
   "text": "دیگه به درد نمی‌خوره. از بین رفت. هیچ اسم و رسمی هیچی ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 422.39,
   "end": 426.65,
   "text": "اگر کسی استعداد موت پیدا نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 426.65,
   "end": 430.31,
   "text": "فوت می‌شه یعنی ضایع می‌شه از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 430.31,
   "end": 434.79,
   "text": "دیگه این تحت اون فشارها، این فشار‌ها رو بعداً تعریف می‌کنیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 434.79,
   "end": 437.33,
   "text": "فشار سکرات مرگ، فشار قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 437.33,
   "end": 439.87,
   "text": "این‌ها بحث ما اینه دیگه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 439.87,
   "end": 442.37,
   "text": "که این ملک دنیا پسش می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 442.37,
   "end": 444.17,
   "text": "ملک اون ور هم تحویلش نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 444.17,
   "end": 448.05,
   "text": "این یعنی فشار. می‌گه آماده نیست، استعداد پیدا نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 448.05,
   "end": 450.77,
   "text": "اگر کسی حالت پیدا نکرد ضایع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 450.77,
   "end": 452.99,
   "text": "دیگه حالا این استعداد آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 452.99,
   "end": 455.43,
   "text": "این حالت ضایع شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 455.43,
   "end": 459.29,
   "text": "سؤال که بعداً جواب بدیم، آیا مربوطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 459.29,
   "end": 464.01,
   "text": "به اون‌هاییه که تجرد شقاوتی دارن یا تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 464.01,
   "end": 467.69,
   "text": "سعادتی دارن؟ یا آدمای بینابین‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 467.69,
   "end": 472.35,
   "text": "نه، اون کسی که محض شقاوته پلید محض پسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 472.35,
   "end": 474.47,
   "text": "مثل دشمنان اهل بیت. این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 474.47,
   "end": 477.11,
   "text": "این‌ها تجرد شقاوتی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 477.11,
   "end": 482.27,
   "text": "میرن به اسم اسماء جل-- به سمت اسماء جلالیه حضرت حق که جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 482.27,
   "end": 485.25,
   "text": "اون‌هایی هم که مؤمنن تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 485.25,
   "end": 492.95,
   "text": "سعادتی دارن میرن به اس-- به سمت اسماء جمالیه حضرت حق که مظهرش بهشته، مظهرش بهشته توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 492.95,
   "end": 496.39,
   "text": "اون بینابینا چی؟ کسی که استعدادشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 496.39,
   "end": 498.13,
   "text": "از بین برده، ضایع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 498.13,
   "end": 501.31,
   "text": "نه اینوری نه اونوری. اونا فوت می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 501.31,
   "end": 504.11,
   "text": "حالا این باید ترجمه بشه. دیگه الان اینجا وقتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 504.11,
   "end": 506.07,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 506.07,
   "end": 508.91,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 508.91,
   "end": 511.93,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 511.93,
   "end": 514.11,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}