   "title": "## صدقه برای اموات و لیلة الدفن",
   "start": 737.19,
   "end": 783.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 6.94,
   "text": "استعین. السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.94,
   "end": 9.24,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.24,
   "end": 12.58,
   "text": "در ادامه روایت سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.58,
   "end": 17.66,
   "text": "از باب چهارم، اونجا که فرمود اکثر ذکر الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.66,
   "end": 22.78,
   "text": "انسان، انسانی که اکثر ذکر موت داشته باشه زهر هدف دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.78,
   "end": 25.62,
   "text": "خب این اکثر ذکر موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.62,
   "end": 28.96,
   "text": "بسیار یاد مرگ کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.96,
   "end": 35.14,
   "text": "آیا تنافی داره با اینکه کسی بخواد طول عمر داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.14,
   "end": 38.98,
   "text": "حالا یه جا قرآن می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.98,
   "end": 43.12,
   "text": "قبلاً هم مختصری عرض کردیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.12,
   "end": 47.8,
   "text": "آیا بالاخره انسان تمنای موت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.8,
   "end": 51.86,
   "text": "یا دعا برای طول عمر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.86,
   "end": 56.68,
   "text": "ما می‌بینیم اینکه وقتی معنای موت رو درمی‌آبیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.68,
   "end": 62.12,
   "text": "خود موت چیز شیرین و خوبیه چون سفر به باطن عالمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.12,
   "end": 70.38,
   "text": "و آزاد شدنه از داری، از یک دار ضیق به یک داری که سعه وجود داره رفتنه خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.38,
   "end": 74.12,
   "text": "اما با آمادگی و تهییء و رفتن خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.12,
   "end": 79.26,
   "text": "لذا ما در دعاها داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.26,
   "end": 83.6,
   "text": "ما داریم که تقاضا شده از خدا در طول عمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.6,
   "end": 90.6,
   "text": "پس خوبه که انسان طول عمر داشته باشه اما طول عمری که در اصلاح امور صرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.6,
   "end": 93.44,
   "text": "رفتن به دیار باقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.44,
   "end": 100.62,
   "text": "از این حس خوبه که عالم از اشرار، از پلیدی‌ها، از آدمای پست فارغ میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.62,
   "end": 104.42,
   "text": "دور میشه، جدا میشه، میره با نیکان می‌نشیند اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.42,
   "end": 111.1,
   "text": "اعمالش خوب باشه. اما طول عمر حسن‌ش در اصلاح عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.1,
   "end": 118.52,
   "text": "اگر کسی هنوز مصلح نیست، صالح نیست، اصلاح نکرده عملش رو خب بهتره که از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.52,
   "end": 122.2,
   "text": "مهلت بخواد تا انشاالله بتونه اصلاح کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.2,
   "end": 125.16,
   "text": "اتفاقاً در دعای روز سه‌شنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.16,
   "end": 126.8,
   "text": "این خیلی تصریح شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.8,
   "end": 129.9,
   "text": "اللهم أصلح لی دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.9,
   "end": 134.0,
   "text": "دینم رو اصلاح کن فإنّه عصمت أمری عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.0,
   "end": 138.68,
   "text": "امور منه وأصلح لی آخرتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.68,
   "end": 142.58,
   "text": "صالح کن، درست کن. چیه منو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.58,
   "end": 144.98,
   "text": "آخرت منو. آخرت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.98,
   "end": 147.56,
   "text": "فإنها دار مقرّی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.56,
   "end": 153.36,
   "text": "اونجا استقرار من، قرارگاه من، آرامگاه من اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.36,
   "end": 156.48,
   "text": "والهم مجاورت لعام مفرّی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.48,
   "end": 160.16,
   "text": "باعث بشه من فرار کنم برم از آدمای پست فاصله بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.16,
   "end": 163.46,
   "text": "ببینید همینه که گفتیم تو این دعا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.46,
   "end": 167.02,
   "text": "حالا این تیکه‌ش. واجعل الحیاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.02,
   "end": 169.64,
   "text": "حیات رو چگونه قرار بر من بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.64,
   "end": 172.16,
   "text": "زيادة لی فی کل خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.16,
   "end": 174.88,
   "text": "برای اینکه خیراتم رو زیاد کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.88,
   "end": 181.02,
   "text": "پس طول عمر خواستن برای اینکه خیرات انسان و برات انسان زیاد بشه خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.02,
   "end": 183.42,
   "text": "والوفاة راحة لی من کل شر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.42,
   "end": 185.94,
   "text": "از این طرف هم وفات خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.94,
   "end": 190.6,
   "text": "چرا؟ برای اینکه از همه شرها و اشرار نجات پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.6,
   "end": 192.96,
   "text": "حالا سؤال اینجا پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.96,
   "end": 195.94,
   "text": "مگر ما می‌تونیم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.94,
   "end": 200.76,
   "text": "طول عمری رو یا یک مرگی رو برای ما خودمون مشخص کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.76,
   "end": 204.54,
   "text": "که کی از دنیا بریم؟ بیشتر بمونیم، کمتر بمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.54,
   "end": 208.46,
   "text": "این رو چون قبلاً هم وعده داده بودیم اجمالاً البته امروز عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.46,
   "end": 210.82,
   "text": "با توجه به زیاده وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.82,
   "end": 215.26,
   "text": "ما یک اجل موقوف یا مشروط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.26,
   "end": 218.7,
   "text": "یا اجل معلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.7,
   "end": 223.68,
   "text": "یا غیر حتمی یا غیر مسمی همه اینا رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.68,
   "end": 227.54,
   "text": "یه اجل این چنینی داریم که مشخص نیست برای هر کسی کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.54,
   "end": 230.98,
   "text": "یعنی ماها نمی‌دونیم. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.98,
   "end": 236.08,
   "text": "یک اجل مسمی و قطعی داریم که غیر معلقه، غیر موقوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.08,
   "end": 239.2,
   "text": "اون هر کجا باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.2,
   "end": 241.1,
   "text": "آنی این ور اون ور نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.1,
   "end": 242.96,
   "text": "هر جا باشی آدمو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.96,
   "end": 247.38,
   "text": "اون اجل حتمیه. در آیات هم اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.38,
   "end": 251.74,
   "text": "خیلی تصریح شده بهش که حالا سه تا نمونه من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.74,
   "end": 253.74,
   "text": "مثلاً آیه دو انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.74,
   "end": 260.46,
   "text": "البته بدونید بیست و یک بار من نگاه کردم تفسیر نور حضرت آقای قرائتی می‌فرمایند بیست و یک بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.46,
   "end": 262.3,
   "text": "من خودم این تحقیق رو نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.3,
   "end": 267.2,
   "text": "آقای قرائتی فرمودن بیست و یک بار اجل مسمی در قرآن ذکر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.2,
   "end": 274.8,
   "text": "حالا تعبیر ایشون فرق بین اجل مسمی با غیر مسمی یا اجل حتمی و غیر حتمی مثل چراغ نفتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.8,
   "end": 279.02,
   "text": "میگه چراغ نفتی آقای قرائتی می‌فرمایند چراغ نفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.02,
   "end": 281.9,
   "text": "اجل ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.9,
   "end": 288.4,
   "text": "مسمی و حتمی مثل اون نفت چراغه که تا نفت هست این می‌سوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.4,
   "end": 291.2,
   "text": "و به محض اینکه نفت تموم شد خاموش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.2,
   "end": 292.8,
   "text": "این اجل حتمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.8,
   "end": 295.78,
   "text": "تموم شد. دیگه هر جا باشه خاموش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.78,
   "end": 299.84,
   "text": "اجل غیر حتمی یا معلق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.84,
   "end": 304.58,
   "text": "ااا نسبت به اعمال انسان وقتش تعیین میشه که حالا عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.58,
   "end": 307.54,
   "text": "اونو فرمود مثل چراغ نفتی که روشنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.54,
   "end": 309.82,
   "text": "ببریش در معرض باد و طوفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.82,
   "end": 312.1,
   "text": "طوفان می‌زنه یهو اینو خاموش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.1,
   "end": 314.68,
   "text": "نفت داره، نفت توش هنوز هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.68,
   "end": 316.9,
   "text": "اما خاموش میشه. چرا؟ باد و طوفان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.9,
   "end": 320.3,
   "text": "یعنی اعمال انسان. این تعبیر آقای قرائتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.3,
   "end": 324.12,
   "text": "مثلاً در آیه دو سوره انعام می‌فرماید أجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.12,
   "end": 327.68,
   "text": "عرض شود .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.68,
   "end": 333.0,
   "text": "او کسی‌ست که شما را از یک گل خشکیده آفریده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.0,
   "end": 337.08,
   "text": ". مشخص کرده یک اجلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.08,
   "end": 341.28,
   "text": ". یه اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.28,
   "end": 347.06,
   "text": "مشخص و مسمایی رو برای شما قرار داد که اجل معلوم نزد خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.06,
   "end": 349.4,
   "text": "و عرض شود آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.4,
   "end": 355.7,
   "text": "ده سوره ابراهیم. قالت رسلهم افالله شک فاتری السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.7,
   "end": 359.28,
   "text": "آیا به اینا بگو که آیا شک دارید در اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.28,
   "end": 362.18,
   "text": "خدا آسمانها و زمین رو آفریده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.18,
   "end": 368.21,
   "text": "کدوم خدا؟ اون که شما رو داره می‌خونه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.21,
   "end": 373.25,
   "text": "اینکه ببخشه گناهاتونو و يؤخرکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.25,
   "end": 375.49,
   "text": "إلى أجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.49,
   "end": 378.45,
   "text": "تا شما رو بکشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.45,
   "end": 382.05,
   "text": "تأخیر بندازه عمر شما رو تا أجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.05,
   "end": 386.23,
   "text": "این نشون میده که میشه به غیر اجل مسمى انسان بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.23,
   "end": 388.85,
   "text": "هم اسم اجل مسمى رو آورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.85,
   "end": 392.81,
   "text": "اجل حتمی، هم يؤخرکم إلى أجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.81,
   "end": 397.27,
   "text": "یعنی مرگ شما رو بکشه، بکشه، بکشه تا برسونه به اجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.27,
   "end": 402.49,
   "text": "یعنی زود نمیری. پس میشه انسان زودتر از اون اجل مسمى بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.49,
   "end": 407.51,
   "text": "همش به اعمال بستگی داره. در روایتی که قبلاً هم عرض کردیم، امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.51,
   "end": 413.05,
   "text": "علیه السلام فرمود: این محدث قمی در سفینة البحار آورده، جلد یک، صفحه چهارصد و هشتاد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.05,
   "end": 419.37,
   "text": "من يموت بالذنوب کسایی که با گناه می‌میرن أكثر من من يموت بالأجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.37,
   "end": 423.53,
   "text": "بیشتر از اونایی‌ان که بر اثر اجل حتمیشون می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.53,
   "end": 431.55,
   "text": "و من يعيش بالإحسان اون کسی که زندگیش طولانیه به خاطر نیکی‌های عملش أكثر من من يعيش بالأعمار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.55,
   "end": 436.27,
   "text": "بیشتر از تعدادشون بیشتر از اوناییه که به صورت معمول طول عمر دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.27,
   "end": 440.15,
   "text": "پس اثر اعمال اینجا کاملاً خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.15,
   "end": 443.63,
   "text": "یاد مرتبه امام صادق علیه السلام داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.63,
   "end": 447.01,
   "text": "در یک دعایی که در اصول کافی جلد دو، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.01,
   "end": 453.05,
   "text": "چهارصد و چهل و هشت اومده. نعوذ بالله من الذنوب پناه می‌بریم به خدا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.05,
   "end": 457.69,
   "text": "گناهان. کدوم گناهان؟ التي تعجل الفنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.69,
   "end": 464.83,
   "text": "نابودی رو شتاب میده و تقرب الآجال نزدیک میکنه اجل‌ها رو، مرگ‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.83,
   "end": 470.33,
   "text": "و تخل الديار خانه‌ها رو، دیارها رو خالی میکنه از اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.33,
   "end": 472.47,
   "text": "وهي قطيعة الرحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.47,
   "end": 475.47,
   "text": "حالا داره اینجا میشماره چه چیزهایی باعث، باعث میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.47,
   "end": 477.69,
   "text": "اون چیه؟ وهي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.69,
   "end": 482.71,
   "text": "اون چیه که خانه‌ها رو زود خالی میکنه، خراب میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.71,
   "end": 486.27,
   "text": "آجال رو نزدیک میکنه، فنا و نابودی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.27,
   "end": 488.27,
   "text": "سریع، سرعت بهش ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.27,
   "end": 490.19,
   "text": "اینجا سه تا امام فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.19,
   "end": 492.51,
   "text": "سه تا عمل رو مخصوصاً فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.51,
   "end": 495.95,
   "text": "هي قطيعة الرحم قطع رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.95,
   "end": 498.75,
   "text": "کسی که صله رحم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 498.75,
   "end": 500.57,
   "text": "و الحق و العقوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.57,
   "end": 503.31,
   "text": "عقوق برمی‌گرده به عاق والدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.31,
   "end": 506.59,
   "text": "خدا نکنه کسی پدر و مادر ازش عاق بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.59,
   "end": 510.77,
   "text": "اینم زود می‌میره. کسی که پدر و مادر عاقش کرده زود می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.77,
   "end": 513.79,
   "text": "و ترکل البر کسی که نیکی کردن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.79,
   "end": 516.87,
   "text": "ترک کرده، اصلاً نیکی ازش سر نمیزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.87,
   "end": 520.35,
   "text": "اینم سریع می‌میره. برای چی زنده باشه اصلاً چنین کسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.35,
   "end": 524.13,
   "text": "حالا عواملش رو من دیگه چون فرصت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.13,
   "end": 529.97,
   "text": "تندتند براتون بخونم. آیه یازده رو هم البته بذارید براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.97,
   "end": 532.37,
   "text": "اینم شیرین آیه یازده فاطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.37,
   "end": 535.15,
   "text": "و ما يعمر من مؤمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 535.15,
   "end": 539.45,
   "text": "من مؤمر ولا ينقص من عمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 539.45,
   "end": 542.31,
   "text": "یا عمره إلا في كتاب إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.31,
   "end": 544.47,
   "text": "إن ذلك على الله يسير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.47,
   "end": 553.31,
   "text": "میگه ااا کسی عمر طولانی نمی‌کنه یا از عمرش کاسته نمیشه جز تو یه کتاب مشخصی هست نزد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.31,
   "end": 557.95,
   "text": "یعنی نشون میده که میشه عمر کم و زیاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.95,
   "end": 559.55,
   "text": "حالا این به اعمال بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.55,
   "end": 561.65,
   "text": "چه چیزهایی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.65,
   "end": 563.53,
   "text": "که عمر رو طولانی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.53,
   "end": 568.21,
   "text": "بعضیا از عرفا اینو اسمشو گذاشتن چانه زدن معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.21,
   "end": 570.41,
   "text": "چطور باید دنیا چونه می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.41,
   "end": 572.85,
   "text": "بگی تخفیف بده. تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.85,
   "end": 580.59,
   "text": "مسیر اصلاح امور آخرتیت که هنوز یه سری واجباتت فوت شده ازت مونده رو دوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.59,
   "end": 585.55,
   "text": "بدهکاری داری، هنوز آمادگی این سفر نیستی از خدا چونه بزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.55,
   "end": 588.07,
   "text": "عمر طولانی‌تری بخوای تا اونا رو اصلاح کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.07,
   "end": 590.61,
   "text": "نه اینکه به عیش و نوش دنیا برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.61,
   "end": 594.01,
   "text": "این‌ها رو من سریع عرض کنم مهماتش رو البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.01,
   "end": 596.65,
   "text": "فرمودن اجابت دعوت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.65,
   "end": 601.19,
   "text": "هر کجا خدا تو رو دعوت کرده اجابت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.19,
   "end": 604.19,
   "text": "اطاعت از پیغمبران. مطیع محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.19,
   "end": 606.07,
   "text": "دستورات پیغمبران باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.07,
   "end": 610.83,
   "text": "تقوا. تقوا یکی از بهترین راهکارها برای طولانی شدن عمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.83,
   "end": 614.73,
   "text": "ببینید بزرگان و علمای ما ببینید غالباً طول عمر دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 614.73,
   "end": 617.39,
   "text": "ریش‌ها سفید، قد خمیده میشه چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.39,
   "end": 620.81,
   "text": "به خاطر تقواشون، عبودیت و بندگی‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.81,
   "end": 623.25,
   "text": "و رهایی از شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 623.25,
   "end": 626.61,
   "text": "کسی که از شک دوری می‌کنه یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.61,
   "end": 630.55,
   "text": "براش حاصل هست برای حضرت حق و معاد و این‌ها خدا نگهش می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.55,
   "end": 632.53,
   "text": "برای چی؟ ببرش به این زودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.53,
   "end": 634.75,
   "text": "دیگران رو هم به یقین بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.75,
   "end": 638.07,
   "text": "خصوصاً، خصوصاً این سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.07,
   "end": 640.11,
   "text": "در طول عمر خیلی تأثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.11,
   "end": 643.75,
   "text": "یکی بر و نیکی. تا می‌تونه انسان نیکی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.75,
   "end": 647.45,
   "text": "یکی صدقه که خیلی، خیلی، خیلی تأکید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.45,
   "end": 651.55,
   "text": "یکی هم صله رحم. اینا از مهماتشه من روایات رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.55,
   "end": 654.21,
   "text": "حتی یه روایتی دیدم جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.21,
   "end": 656.35,
   "text": "امام صادق یه جوونی رو دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 656.35,
   "end": 658.85,
   "text": "هی می‌خندید. حضرت می‌خندید ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 658.85,
   "end": 661.09,
   "text": "هی این جوون رو نگاه می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 661.09,
   "end": 666.05,
   "text": "لبخند می‌زد. مثلاً سرش رو مینداخت پایین مشغول بود دوباره اینو نگاه می‌کرد می‌خندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.05,
   "end": 670.37,
   "text": "حالا یکی اونجا باشه بگه امام صادق، امام زمان برای چی هی نگاه می‌کنی می‌خندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 670.37,
   "end": 674.73,
   "text": "چی ما؟ یا خود طرف بگه آقا چی شده هی ما رو نگاه می‌کنی می‌خندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 674.73,
   "end": 676.49,
   "text": "خوشت اومده؟ چشت ما رو گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 676.49,
   "end": 679.71,
   "text": "چیه جریان؟ سؤال کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 679.71,
   "end": 682.17,
   "text": "حضرت فرمود که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 682.17,
   "end": 687.31,
   "text": "خیلی شیرینه. حضرت فرمود من از این می‌خندم که سه بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 687.31,
   "end": 693.07,
   "text": "اجل تو رسیده. سه بار مرگت رسیده اما نمردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.07,
   "end": 696.67,
   "text": "چیکار کردی؟ حالا خود حضرت که میدونه عالم به سر و نهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.67,
   "end": 698.63,
   "text": "می‌خواد اون ببینه خودش میدونه چه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 698.63,
   "end": 701.85,
   "text": "اون یه ذره تأمل کرد گفت نه من کار خاصی نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 701.85,
   "end": 708.19,
   "text": "ولی یه پسرعمویی دارم اینو خیلی از لحاظ اعتقادی با هم خوب نیستیم مثلاً مشکل داریم با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.19,
   "end": 713.15,
   "text": "ایشون خی-- اصلاً کاری با من نداره چون من مثلاً پیرو شمام کاری با من نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.15,
   "end": 716.27,
   "text": "اما مشکل مالی داره. من از چنگالی به ایشون کمک کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 716.27,
   "end": 718.57,
   "text": "حضرت فرمود به خاطر همین دو تا کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.57,
   "end": 721.39,
   "text": "یه صله رحمه، یکی بخششه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 721.39,
   "end": 724.17,
   "text": "به خاطر همین سه بار اجلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.17,
   "end": 728.09,
   "text": "تأخیر افتاده. اینو اگه کسی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.09,
   "end": 732.09,
   "text": "از خدا چونه بزنه، خدایا یه ذره بیشتر به من محل بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.09,
   "end": 735.91,
   "text": "بسم الله شروع کنه که بتونه اصلاح امور کنه البته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 735.91,
   "end": 739.01,
   "text": "بهترین راهش حتی برای امواتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 739.01,
   "end": 743.77,
   "text": "من اینو به شما تحقیقاً عرض می‌کنم، بهترین کار برای اموات صدقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 743.77,
   "end": 750.21,
   "text": "صدقه. اون نماز لیلة الدفن هم بارها عرض کردم متأسفانه بالامنبر‌ها نصفه و نیمه اونو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 750.21,
   "end": 752.57,
   "text": "بعداً که ما خود روایت رو دیدیم نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 752.57,
   "end": 756.55,
   "text": "دیدیم پیغمبر میگه اون شبی که دفن شد میتت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 756.55,
   "end": 758.59,
   "text": "اون شب صدقه به نیتش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 758.59,
   "end": 764.63,
   "text": "اونم صدقه سنگین. اگه توانش رو نداری نماز وحشت یا لیلة الدفن بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.63,
   "end": 767.77,
   "text": "هیچ چیزی اندازه صدقه به درد مؤمن نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 767.77,
   "end": 770.29,
   "text": "میگن جگرش رو خنک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 770.29,
   "end": 772.09,
   "text": "ان شاء الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 772.09,
   "end": 775.19,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.19,
   "end": 783.91,
   "text": "اللهم صل على محمد و آله طاهرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}