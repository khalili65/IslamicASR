   "start": 9.24,
   "end": 122.54
  },
  {
   "index": 1,
   "title": "## دعایِ روزِ سه‌شنبه؛ حیات و وفات",
   "start": 122.54,
   "end": 142.58
  },
  {
   "index": 2,
   "title": "## اجلِ مسمّی و اجلِ معلّق",
   "start": 142.58,
   "end": 320.64
  },
  {
   "index": 3,
   "title": "## آیهٔ دومِ انعام و آیهٔ دهمِ ابراهیم",
   "start": 320.64,
   "end": 370.27
  },
  {
   "index": 4,
   "title": "و در آیهٔ دهمِ سورهٔ ابراهیم:",
   "start": 370.27,
   "end": 403.99
  },
  {
   "index": 5,
   "title": "## روایتِ سفینة البحار؛ مرگ با گناه و زندگی با احسان",
   "start": 403.99,
   "end": 447.83
  },
  {
   "index": 6,
