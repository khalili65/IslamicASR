  {
   "index": 8,
   "title": "## ارذل العمر به‌مثابهٔ لطف پیش از موت",
   "start": 587.38,
   "end": 618.26
  },
  {
   "index": 9,
   "title": "## زیربنای بحث؛ حسن‌زاده",
   "start": 618.26,
   "end": 771.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.2,
   "end": 4.0,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.0,
   "end": 8.3,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 10.38,
   "text": "بحث ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.38,
   "end": 13.66,
   "text": "کتاب الموت مرحوم مجلسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.66,
   "end": 18.56,
   "text": "پیرامون موت کشیده شد به قصه ارزلال عمر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.56,
   "end": 24.46,
   "text": "دیروز تا حدودی عرض کردیم یکی از البته علل اینکه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.46,
   "end": 36.26,
   "text": "در روایات دوم و سوم و چهارم و پنجم همینطور بعضی از روایات هم کتاب الموت هم روایات دیگه سن ارزلال عمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.26,
   "end": 41.14,
   "text": "یعنی اون پنج-- پس‌ترین حالتی که انسان گرفتارش میشه رو متغیر گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.14,
   "end": 44.44,
   "text": "یه دلیلش اختلاف مزاج انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.44,
   "end": 50.22,
   "text": "پیرامون اهمیت مزاج و ربطش با روح بخاری صحبت کردیم که به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.22,
   "end": 52.32,
   "text": "معرفت نفس بوده عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.32,
   "end": 56.4,
   "text": "حالا ببینید ما بخوایم رو هر کدوم از این احادیث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.4,
   "end": 60.28,
   "text": "مطالبی که داریم عنوان می‌کنیم پافشاری کنیم خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.28,
   "end": 64.52,
   "text": "همین موضوع مزاج او ده ها جلسه می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.52,
   "end": 67.22,
   "text": "اما اجازه بدید چون موضوع ما موته رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.22,
   "end": 71.26,
   "text": "اشارتاً خیلی کوتاه عرض می‌کنم چیزهای دیگه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.26,
   "end": 73.68,
   "text": "مرتبط‌اند با این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.68,
   "end": 76.98,
   "text": "تغذیه انسان. روایات داریم حتی تو آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.98,
   "end": 80.76,
   "text": "\"فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.76,
   "end": 86.38,
   "text": "آیا انسان به اون طعامی که می‌خوره، حالا یه وجه ظاهرش البته اینه، باطنش علمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.38,
   "end": 89.04,
   "text": "نگاه نمی‌کنه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.04,
   "end": 91.94,
   "text": "نشون میده که تغذیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.94,
   "end": 95.12,
   "text": "رسیدن به سن ارزلال عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.12,
   "end": 98.56,
   "text": "تأثیرگذاره و منابعی هم داریم ما ازش رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.56,
   "end": 103.22,
   "text": "بروید کتاب‌های مزاج شناسی اصیل رو بررسی کنید متوجه میشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.22,
   "end": 105.64,
   "text": "که حالا البته اینجا تو روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.64,
   "end": 109.44,
   "text": "ششم به عنوان نمونه مرحوم مجلسی یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.44,
   "end": 112.44,
   "text": "موضوعی رو آوردن در خصوص خربزه خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.44,
   "end": 115.66,
   "text": "اگر رسیدیم امروز میگیم نشد که جلسه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.66,
   "end": 120.38,
   "text": "آب و هوا خیلی تأثیر داره در اون سن ارزلال عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.38,
   "end": 123.32,
   "text": "و در مزاج. آب و هوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.32,
   "end": 129.86,
   "text": "قطعاً آدم‌هایی که تو تهران با این آلودگی محیطی زندگی می‌کنند، این‌ها زودتر به ارزلال عمر می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.86,
   "end": 132.5,
   "text": "اینو عقل انسان هم اینو تأیید می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.5,
   "end": 137.48,
   "text": "تجربه تأیید می‌کنه. نیازی نیست یکی بگه آقا این حرفا چیه شیخ رئیس گفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.48,
   "end": 140.18,
   "text": "این حرفا چیه علامه زده؟ این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.18,
   "end": 144.22,
   "text": "تجربه ما داره این‌ها رو میگه. خود مزاج تأثیر مستقیم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.22,
   "end": 149.12,
   "text": "نطفه، نطفه که عرض کردیم پدر و مادرت از چه رحیمی، از چه سلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.12,
   "end": 152.72,
   "text": "این‌ها خیلی مهمن. یعنی از مهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.72,
   "end": 158.48,
   "text": "اینه که انسان این بنیه به اص-اصطلاحاً بنیه جسمیش چقدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.48,
   "end": 161.9,
   "text": "خیلی ربطه به اون عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.9,
   "end": 164.14,
   "text": "اجداد و جداد انسان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.14,
   "end": 169.8,
   "text": "چرا امیرالمؤمنین خواستن ازدواج کنن بعد از حض-حضرت صدیقه سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.8,
   "end": 171.94,
   "text": "چرا فرستادن عقیل رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.94,
   "end": 175.74,
   "text": "چون نسب شناس بود رفت دنبال ام البنین چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.74,
   "end": 178.3,
   "text": "فرمود که شما می‌شناسی قبایل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.3,
   "end": 182.56,
   "text": "حالا اون خصوصیات که تو تاریخ ذکر شده، یک زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.56,
   "end": 190.64,
   "text": "که خیلی شجاع و نترس و در عین حال نجیب و عفیف باشه چه نشانه‌هایی داره حتی تو روایات اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.64,
   "end": 199.82,
   "text": "حتی از جهت جسمی، از جهت جسمی روایاتی اومده که یک زنی که مثلاً بنیه خوبی داره یعنی بچه‌هاش قوی بار میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.82,
   "end": 202.18,
   "text": "چه خصوصیت‌هایی داره؟ اینا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.18,
   "end": 205.88,
   "text": "ماها متأسفانه روایات اهل بیت داره خاک می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.88,
   "end": 208.26,
   "text": "تو زندگیمون. و پوشاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.26,
   "end": 214.1,
   "text": "اونچه که می‌پوشی یا باهاش ارتباط و تماس داری یا حتی فرشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.1,
   "end": 218.18,
   "text": "فرشی که چه بلایی سر ما این فرش‌های ماشینی آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.18,
   "end": 221.14,
   "text": "یا حتی بستری که روش می‌خوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.14,
   "end": 224.3,
   "text": "اینا ببین هر کدوم جای بحث و بررسی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.3,
   "end": 226.26,
   "text": "دیگه من واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.26,
   "end": 229.02,
   "text": "چون بحث ما موته این‌ها رو خیلی ورود نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.02,
   "end": 234.86,
   "text": "اگرچه قبلاً پیرامون مزاج شناسی چیزهایی ما گفتیم قبلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.86,
   "end": 240.14,
   "text": "و موضوع خیلی مهم تطابق بین انسان یا آدم و عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.14,
   "end": 244.84,
   "text": "اگر بین آدم و عالم تطابق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.84,
   "end": 248.3,
   "text": "که باید باشه نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.3,
   "end": 250.02,
   "text": "مزاج می‌ریزه به هم. می‌ریزه به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.02,
   "end": 252.64,
   "text": "در نتیجه ارزلال عمر زودتر خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.64,
   "end": 257.46,
   "text": "حالا باز تطبیق بین آدم و عالم به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.46,
   "end": 259.84,
   "text": "ما قبلاً گفتیم. اینا رو باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.84,
   "end": 261.8,
   "text": "یه چیزک‌هایی در سیر بحث گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.8,
   "end": 265.54,
   "text": "اینا ازش رد میشیم. اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.54,
   "end": 267.44,
   "text": "حدیث پنجم رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.44,
   "end": 269.78,
   "text": "اینم نکته خوبی درش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.78,
   "end": 276.82,
   "text": "که حضرت فرمودند \"أن أرزل العمر أن يكون عقله أقل من سبع سنین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.82,
   "end": 281.88,
   "text": "حالا هر وقت چه پنج-- چهل سالگی، شصت سالگی، چه صد سالگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.88,
   "end": 284.64,
   "text": "اون حالت ارزلال عمر کسی رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.64,
   "end": 289.16,
   "text": "نشونش چیه؟ فرمود عقلش مثل یه بچه هفت ساله میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.16,
   "end": 291.04,
   "text": "اینم باز موهبت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.04,
   "end": 294.3,
   "text": "چرا؟ شما بفرمایید چرا موهبت الهیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.3,
   "end": 299.44,
   "text": "به جهت اینکه ما حدیث داریم قیامت هر کسی نسبت به عقلش سنجیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.44,
   "end": 302.5,
   "text": "یعنی اگر کسی با عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.5,
   "end": 306.06,
   "text": "با شدت عقل یعنی عقل هم که مقدس‌ترین-- مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.06,
   "end": 309.76,
   "text": "کلینی اعلا الله مقامه الشریف در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.76,
   "end": 314.08,
   "text": "کافی‌ش میاره که مقدس‌ترین چیزی که خدا خلق کرده عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.08,
   "end": 319.4,
   "text": "خیلی مقدسه. کسی بی‌حرمتی به مقدسات کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.4,
   "end": 321.52,
   "text": "حرمت قرین الهی رو شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.52,
   "end": 324.34,
   "text": "حرمت شکسته و باهاش برخورد جدی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.34,
   "end": 329.82,
   "text": "لذا اینایی که می‌بینید تا آخر عمر این حالت براشون پیش میاد مثلاً لطف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.82,
   "end": 333.3,
   "text": "یعنی در حد خودش حساب کتابش می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.3,
   "end": 337.0,
   "text": "قیامت. اینا همش میشه گفت موهبت‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.0,
   "end": 340.32,
   "text": "یه آیه هم در قرآن هست که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.32,
   "end": 346.06,
   "text": "\"ولا نكلف نفساً إلا وسعها\" آیه شصت و دو سوره مؤمنینم-- مؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.06,
   "end": 350.5,
   "text": "\"ولدينا كتاب ينتقم بالحق وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.5,
   "end": 354.52,
   "text": "لا يظلمون\". تفاسیر زیبا اینجا قلم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.52,
   "end": 358.14,
   "text": "اولاً این \"ولا نكلف نفساً إلا وسعها\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.14,
   "end": 361.04,
   "text": "هر کسی تکلیف نشده الا به وسعش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.04,
   "end": 362.78,
   "text": "وسع گفته نه طاقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.78,
   "end": 365.02,
   "text": "اینم باز موهبت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.02,
   "end": 367.12,
   "text": "طاقت بالاتر از وسعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.12,
   "end": 370.2,
   "text": "یعنی چی؟ گوش بدید عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.2,
   "end": 373.38,
   "text": "طاقت یعنی اینکه من الان بارها مثال زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.38,
   "end": 377.06,
   "text": "الان مثلاً شکم ما طاقت اینو داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.06,
   "end": 379.56,
   "text": "سه پرس غذا بخوره. جا میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 379.56,
   "end": 381.68,
   "text": "پر میشه، باد می‌کنه مثل بادکنک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.68,
   "end": 384.42,
   "text": "معده این توان رو داره دیگه این طاقت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.42,
   "end": 387.5,
   "text": "اما وسعش چقدره؟ وسعش یه پرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.5,
   "end": 391.48,
   "text": "خوردی طاقت داشتی خوردی اما بیچاره میشی بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.48,
   "end": 394.6,
   "text": "رونه‌ی بیمارستان میشی. پس این وسع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 394.6,
   "end": 396.74,
   "text": "وسع همراهش آرامش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 396.74,
   "end": 399.96,
   "text": "مثل اینکه من از اینجا تا خونه می‌تونم طاقت دارم بدوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 399.96,
   "end": 402.32,
   "text": "می‌دوم اما رسیدم پنچر می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.32,
   "end": 405.36,
   "text": "می‌افتم به حالت بی‌هوشی میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.36,
   "end": 408.88,
   "text": "این که طاقت این وسع نشد، این طاقت منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 408.88,
   "end": 411.94,
   "text": "خدا رحم کرده فرموده الا وسعها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.94,
   "end": 415.32,
   "text": "حالا این وسع هر کسی به اندازه‌ی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 415.32,
   "end": 418.14,
   "text": "به اندازه‌ی عقلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.14,
   "end": 421.86,
   "text": "عقلش. که البته خدای منان لطف کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 421.86,
   "end": 423.92,
   "text": "اومده بدن رو هم دخیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 423.92,
   "end": 430.52,
   "text": "ذیل همین آیه شریفه از کتاب تفسیر اهل بیت جلد ده صفحه هشتاد و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.52,
   "end": 432.7,
   "text": "روایت-- تفسیر رواییه این تفسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 432.7,
   "end": 435.36,
   "text": "مثل البراهین. اونجا همین روایت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 435.36,
   "end": 438.1,
   "text": "به کتاب کافی هم حتی دیدم این روایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 438.1,
   "end": 442.22,
   "text": "خیلی قدیمی‌ه. فرمود کی این دو فرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 442.22,
   "end": 444.72,
   "text": "عن علی بن اسبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 444.72,
   "end": 449.88,
   "text": "ایشون میگه نقل می‌کنه که قال سألت ابا الحسن الرضا از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 449.88,
   "end": 455.18,
   "text": "رضا صلی الله علیه پرسیدم عن الاستطاعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 455.18,
   "end": 458.34,
   "text": "از این استطاعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.34,
   "end": 462.88,
   "text": "پرسیدم از این وسعی که تو این آیه خدا فرموده این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 462.88,
   "end": 466.42,
   "text": "فقال چقدر قشنگ حضرت حدودش رو مشخص کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.42,
   "end": 469.7,
   "text": "فقال يستطيع العبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 469.7,
   "end": 471.96,
   "text": "بعد اربع خصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 471.96,
   "end": 475.96,
   "text": "بعد چهار تا خصلت استطاعت هر کسی مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.96,
   "end": 480.48,
   "text": "یعنی پیداست که باید به این چهار تا خصلت هر کسی نگاه کنی وسعش معلوم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.48,
   "end": 484.46,
   "text": "خب حضرت امام رئوف بفرما این چهار تا خصلت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 484.46,
   "end": 489.18,
   "text": "ما استطاعت، استطاعت خودمونو بسنجیم که براساس اون خدا تکلیف کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 489.18,
   "end": 493.4,
   "text": "فرمود ان يكون مخلص السرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 493.4,
   "end": 499.28,
   "text": "صحيح الجسم سليم الجوارح له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 499.28,
   "end": 501.52,
   "text": "سبب وارد من الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 501.52,
   "end": 506.28,
   "text": "اولیش اینه که فرمود راه براش باز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 506.28,
   "end": 510.66,
   "text": "اون راهی که باید بره ازش توقع هست راه براش باز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.66,
   "end": 513.96,
   "text": "مثل الان کسی که یه مدت بود مکه بسته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 513.96,
   "end": 516.0,
   "text": "خب دیگه وسع این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 516.0,
   "end": 517.9,
   "text": "وسع در وسع کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 517.9,
   "end": 520.12,
   "text": "لذا اینجا خدا تکلیف نمی‌کنه. چوب نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 520.12,
   "end": 523.12,
   "text": "چرا نرفتی حج که. باید راه باز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 523.12,
   "end": 526.16,
   "text": "حالا یه مثال ما زدیم. تعمیمش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 526.16,
   "end": 528.86,
   "text": "دو فرمود تندرست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 528.86,
   "end": 531.3,
   "text": "سه اعضا و جواره‌ش سالم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 531.3,
   "end": 536.0,
   "text": "حالا اینم نکته‌ست که این یه جا میگه تندرست یعنی جسمش سالم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 536.0,
   "end": 538.98,
   "text": "یه جا میگه اعضا و جوارح. می‌شه یه وقت کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 538.98,
   "end": 542.62,
   "text": "اعضا و جوارحش سالمه اما جسمش مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 542.62,
   "end": 544.74,
   "text": "بنیه‌ی جسمیش ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 544.74,
   "end": 547.86,
   "text": "اعضا و جوارح سالم‌اند. بنیه‌ی جسمیش ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 547.86,
   "end": 550.8,
   "text": "پا می‌شه سرش گیج میره. طاقت روزه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 550.8,
   "end": 555.74,
   "text": "این‌ها با هم فرق می‌کنند. سه فرمود و حجتی از خدا بهش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 555.74,
   "end": 560.68,
   "text": "این حجت چیه؟ از بچگی می‌خوندیم تو کتابای دینی مدارس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 560.68,
   "end": 563.16,
   "text": "خدا یه حجت بیرون، بیرونی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 563.16,
   "end": 566.14,
   "text": "حجج الهی‌اند. پیغمبران و انبیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 566.14,
   "end": 569.78,
   "text": "ائمه و امامانند. یه حجت هم در درون ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 569.78,
   "end": 572.0,
   "text": "عقله. عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 572.0,
   "end": 575.2,
   "text": "اینم باز داره تصریح می‌کنه که اون برداشتی که ما از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 575.2,
   "end": 579.58,
   "text": "حدیث پنجّم کردیم. یعنی به میزان عقلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 579.58,
   "end": 584.18,
   "text": "البته در کنار جسمت و اون که راه برات باز باشه این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 584.18,
   "end": 587.38,
   "text": "وسعت مشخص می‌شه و براساس اون تکلیف می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 587.38,
   "end": 592.12,
   "text": "یکی از کمک‌هایی که خدا به بندگانی که بهش لطف می‌کنه داره اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 592.12,
   "end": 595.86,
   "text": "به یه حالتی رسید که دیگه به هر حال می‌بینه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 595.86,
   "end": 601.0,
   "text": "س-- رو مرض افتاده. احتمال داره یهو به بیراهه بره، به گمراهی بکشه کارش اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 601.0,
   "end": 603.44,
   "text": "خدای نکرده به گناه و معصیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 603.44,
   "end": 605.14,
   "text": "کفر و چیزای-- یهو چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 605.14,
   "end": 606.88,
   "text": "به ارز الامور گرفتارش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 606.88,
   "end": 609.46,
   "text": "عقلش رو طبق این روایت مثل بچه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 609.46,
   "end": 614.08,
   "text": "دیگه حرجی براش نیست. یعنی دیگه خدا سخت نمی‌گیره به یه همچین کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 614.08,
   "end": 617.12,
   "text": "این از الطاف الهیه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 617.12,
   "end": 620.34,
   "text": "چرا این لطف رو می‌کنه؟ برای اینکه موت در پیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 620.34,
   "end": 622.1,
   "text": "قراره بره برای همیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 622.1,
   "end": 625.88,
   "text": "آمادش می‌کنه برای اونجا که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 625.88,
   "end": 629.94,
   "text": "لا 非 ه پرانتز این آخر سر یه نکته‌ای هم تأمل کنید بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 629.94,
   "end": 632.62,
   "text": "گه-- جانم؟ سؤال پرسیدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 632.62,
   "end": 634.6,
   "text": "گهگاه داریم ما چیزی می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 634.6,
   "end": 638.76,
   "text": "بعد بعضیا اِاِ یه وقت سؤال هست فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 638.76,
   "end": 643.96,
   "text": "سؤال رو خب بعد از منبر یا حتی بین منبر اگه سؤال خیلی سریع بشه جوابش داد در خدمتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 643.96,
   "end": 646.9,
   "text": "اما جسارت به حریم نباید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 646.9,
   "end": 651.36,
   "text": "به حریم ما. این چیزایی که من دارم میگم اگر استنباط خودم باشه میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 651.36,
   "end": 658.28,
   "text": "میگم این استنباط بنده‌ست. به غیر از این یا قرآنه یا روایت اهل بیته یا نظرات بزرگانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 658.28,
   "end": 660.34,
   "text": "لذا حواسمون جمع باشه. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 660.34,
   "end": 663.32,
   "text": "از عزیزی هم که دیروز یه اشکالی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 663.32,
   "end": 667.2,
   "text": "وسط نماز و بعضیا هم ناراحت شدن به ایشون خرده گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 667.2,
   "end": 671.14,
   "text": "اولین حرفی که زدم اینو گفتم. شما بهتر می‌فهمید یا علامه حسن زاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 671.14,
   "end": 673.28,
   "text": "شما بهتر می‌فهمید یا شیخ الرئیس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 673.28,
   "end": 676.78,
   "text": "شما بهتر می‌فهمید یا حاجی سبزواری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 676.78,
   "end": 679.06,
   "text": "انصافاً ببینید یه مثال بزنم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 679.06,
   "end": 683.5,
   "text": "خود علامه حسن زاده فرمود ظاهراً نوزده سالشون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 683.5,
   "end": 686.22,
   "text": "کتاب منظومه ملا هادی زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 686.22,
   "end": 689.54,
   "text": "بغلش بوده. یه آدم حالا ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 689.54,
   "end": 697.1,
   "text": "شیخ نادانی می‌گیره یه بخشی از این کتابو می‌خونه میگه این کفر و فلان که بحث معاد بوده بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 697.1,
   "end": 699.5,
   "text": "میگه این کتابو نخون و خطرناکه و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 699.5,
   "end": 703.8,
   "text": "علامه میگه من ریختم و مأنوس شده بودم با این کتاب‌هایی که سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 703.8,
   "end": 705.86,
   "text": "تفسیر انفسی قرآن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 705.86,
   "end": 708.58,
   "text": "این کتاب‌های عرفانی و فلسفی و حکمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 708.58,
   "end": 710.6,
   "text": "رفتم خونه یه چیز نجاتم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 710.6,
   "end": 715.32,
   "text": "نشستم فکر کردم. این چقدر آدم اهل تدبر و تفکر باشه نجات پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 715.32,
   "end": 717.48,
   "text": "حسن خودش میگه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 717.48,
   "end": 722.16,
   "text": "حسن تو بیشتر عالمی یا شیخ الرئیس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 722.16,
   "end": 724.76,
   "text": "علم تو بیشتره یا ملا صدرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 724.76,
   "end": 727.06,
   "text": "علم تو بیشتره یا مرحوم حاجی سبزواری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 727.06,
   "end": 730.36,
   "text": "علم تو بیشتره یا خواجه طوسی اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 730.36,
   "end": 732.96,
   "text": "تقوای اونا بیشتره یا تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 732.96,
   "end": 735.66,
   "text": "نمی‌دونم مراقبه اونا بیشتره یا تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 735.66,
   "end": 741.72,
   "text": "ها؟ فهم علمی-- هرچی نش-نش-نشستم فکر کردم دیدم خب از هر جهت اونا از من سرترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 741.72,
   "end": 747.04,
   "text": "گفتم سمعاً وطاعة. چرا بس دیگه من سری که دردم کنه چرا دستمال ببندیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 747.04,
   "end": 751.98,
   "text": "برای همین اینکه ما اینجا عزیزان توجه کنن ما مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 751.98,
   "end": 761.16,
   "text": "زیربنای بحثمون علامه حسن زاده است چون ما جامع الاطراف‌تر از ایشون در معاصر نیافتیم که نیافتیم که نیافتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 761.16,
   "end": 763.9,
   "text": "لذا پشت سر ایشون راه می‌افتیم با خیال راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 763.9,
   "end": 765.58,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 765.58,
   "end": 768.78,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 768.78,
   "end": 771.38,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}