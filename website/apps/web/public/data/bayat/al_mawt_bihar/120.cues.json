 "chapters": [
  {
   "index": 0,
   "title": "## روایت نهم؛ ترس از موت چون خرج نمی‌کنیم",
   "start": 2.4,
   "end": 58.62
  },
  {
   "index": 1,
   "title": "## آیهٔ شصت‌وهفت فرقان؛ قوام",
   "start": 58.62,
   "end": 124.14
  },
  {
   "index": 2,
   "title": "## روایت کفن؛ پیامبر و حق فرزند",
   "start": 124.14,
   "end": 175.62
  },
  {
   "index": 3,
   "title": "## امام حسن سه بار؛ وکالت خمینی",
   "start": 175.62,
   "end": 320.14
  },
  {
   "index": 4,
   "title": "## بخل روزانه و مهر به‌مثابهٔ صداق",
   "start": 320.14,
   "end": 421.29
  },
  {
   "index": 5,
   "title": "## خدیجه و شعار روز مبادا",
   "start": 421.29,
   "end": 465.17
  },
  {
   "index": 6,
   "title": "## بذل اباعبدالله و خرید کربلا",
   "start": 465.17,
   "end": 948.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.4,
   "end": 5.82,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.82,
   "end": 9.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.88,
   "end": 14.1,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.1,
   "end": 19.32,
   "text": "در روایت نهم بودیم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.32,
   "end": 26.62,
   "text": "ما به اینجا رسیدیم که در این روایت عرض کردیم که علت اینکه ما از موت می‌ترسیم اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.62,
   "end": 30.8,
   "text": "خرجش نمی‌کنیم و از این رسیدیم به اینکه خرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.8,
   "end": 32.78,
   "text": "در باطن عالم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.78,
   "end": 36.9,
   "text": "در باطن امور خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.9,
   "end": 39.92,
   "text": "بکنیم که مرگ به یک معنا سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.92,
   "end": 46.78,
   "text": "از ظاهر به باطن بود و، و به اونجا رسیدیم که سوالی ایجاد شد که وقتی این بذل و بخشش‌ها حرف ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.78,
   "end": 50.54,
   "text": "زده می‌شه ما تا چه میزان حق داریم ببخشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.54,
   "end": 54.96,
   "text": "یه وقت یکی جوگیر بشه بگه آقا من همه دارایی‌مو می‌خوام ببخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.96,
   "end": 58.62,
   "text": "آیا اجازه داریم انقدر ببخشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.62,
   "end": 64.24,
   "text": "اولا یه آیه‌ای از قرآن بخونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.24,
   "end": 66.94,
   "text": "خط، خطوط ریل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.94,
   "end": 70.34,
   "text": "سیر و سلوکی ما بر اساس آیات باید باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.34,
   "end": 72.26,
   "text": "آیه شصت و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.26,
   "end": 79.26,
   "text": "سوره فرقان می‌فرماید \"والذین اذا انفقوا لم يسرفوا ولم يقتروا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.26,
   "end": 85.88,
   "text": "اونایی که پیرو ولایت‌اند، ایمان آوردند یعنی پیرو ولایت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.88,
   "end": 88.46,
   "text": "آمنوا یعنی محبین اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.46,
   "end": 94.82,
   "text": "این‌ها \"لم يسرفوا\" اسراف نمی‌کنند \"ولم يقتروا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.82,
   "end": 96.54,
   "text": "یعنی بخل هم نمی‌ورزند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.54,
   "end": 101.74,
   "text": "\"وکان بین ذلک قواما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.74,
   "end": 106.64,
   "text": "بی، یه بینابینی، حد وسط، امت وسط‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.64,
   "end": 109.02,
   "text": "نه دستشون بسته‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.02,
   "end": 111.52,
   "text": "به طوری که بخل ورزند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.52,
   "end": 116.94,
   "text": "بی‌تفاوت نسبت به نیازهای مردم و اجتماع و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.94,
   "end": 119.46,
   "text": "باشن، نه اینکه نه کلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.46,
   "end": 122.18,
   "text": "چنان دستشون بازه که هرچی دارن می‌ریزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.18,
   "end": 125.06,
   "text": "این هم غلطه. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.06,
   "end": 129.52,
   "text": "یه روایت عجیبیه، روایت خیلی شدید اللحنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.52,
   "end": 136.16,
   "text": "که شخصی از دنیا رفت و پیغمبر گفتند یا رسول الله ایشون همه‌ی دارایی‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.16,
   "end": 141.56,
   "text": "ما که زنده بود تازه نه الان، همه رو بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.56,
   "end": 145.38,
   "text": "با یه کفن داره میره از دنیا. مثلا به عنوان افتخار اینو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.38,
   "end": 149.5,
   "text": "پیغمبر فرمود ببینم مگر ایشون فرزندی نداشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.5,
   "end": 155.46,
   "text": "گفتن چرا. پیغمبر فرمود پس چطور چیزی برای فرزنداش نذاشته همه رو بخشیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.46,
   "end": 162.14,
   "text": "اگر زودتر به من می‌گفتید اجازه نمی‌دادم که در قبرستان مسلمونا دفنش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.14,
   "end": 166.34,
   "text": "ببینید این شدت و لحن این روایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.34,
   "end": 167.92,
   "text": "این‌ها خط قرمزهای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.92,
   "end": 173.88,
   "text": "باید این‌ها لحاظ بشه. همینطوری نیست حتی انسان در بذل و بخششش هم باید حساب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.88,
   "end": 177.48,
   "text": "عمل کنه. البته خب سؤال پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.48,
   "end": 184.82,
   "text": "سؤاله دیگه که آقا چگونه‌ست که پس امام حسن صلوات الله علیه سه بار تمام دارایی‌ش رو بخشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.82,
   "end": 190.84,
   "text": "یا شیخ جعفر مشتدی که شما تو دیروز صحبتتون گفتید همه‌ی دارایی‌ش رو بخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.84,
   "end": 196.54,
   "text": "چگونه است؟ یا خود حضرت امام زهیم و بزرگ ما، بنیانگذار انقلاب ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.54,
   "end": 201.36,
   "text": "ایشون هم مظهر رحمت صلوات الله جلالیه خمینی که بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.36,
   "end": 208.24,
   "text": "و از ایشون اذن اجازه‌ی جمع آوری وجوهات، وجوهات از همه مراجع رو گرفتن روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.24,
   "end": 213.2,
   "text": "ایشون خودشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.2,
   "end": 217.76,
   "text": "امام منو وکیل کرد برای بخشش هر آنچه که ملک و املاک داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.76,
   "end": 220.9,
   "text": "خب از پدرشون بهشون رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.9,
   "end": 224.8,
   "text": "باغ و املاک و اینا همه رو به ایتام بخشیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.8,
   "end": 227.14,
   "text": "خب باز سؤال پیش میاد یعنی پس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.14,
   "end": 232.78,
   "text": "اولاً اونجا با اجازه و رضایت فرزندان این اتفاق صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.78,
   "end": 235.3,
   "text": "امام در زمان حیاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.3,
   "end": 236.92,
   "text": "از فرزندانش رضایت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.92,
   "end": 240.28,
   "text": "همه با هم به این اتفاق. یه وقت شما می‌خوای ببخشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.28,
   "end": 242.42,
   "text": "یه بخشی‌ام بالاخره حق فرزندته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.42,
   "end": 244.5,
   "text": "حق تو نیست که ببخشی. رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.5,
   "end": 246.74,
   "text": "همسرت و فرزندت اومده دست تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.74,
   "end": 254.88,
   "text": "تو چی کاره‌ای که ببخشی؟ ولی وقتی با اون‌ها مصالحه می‌کنی اون‌ها هم همراه می‌شن اینجا دیگه اشکالش برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.88,
   "end": 259.58,
   "text": "این یک. نکته دوم اینکه رهبر عزیزمون در درس خارج‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.58,
   "end": 267.9,
   "text": "یه روزی روایتی رو فرمودن و توضیحی دادن در خصوص همین بخش، بذل و بخشش‌های امام مجتبی صلوات الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.9,
   "end": 274.38,
   "text": "امام مجتبی چون می‌دونست که بلافاصله می‌تونه تأمین کنه نیازهاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.38,
   "end": 281.34,
   "text": "و راه‌هاشو بلد بود، کننده بود به قول ماها اینطور نبود که خودشو خونوادش فلج بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.34,
   "end": 286.6,
   "text": "بخشید یعنی راهی بود برای ادامه‌ی اون مسیر تجارت و چی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.6,
   "end": 289.36,
   "text": "مثل اینکه شما چند تا ملک داشته باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.36,
   "end": 292.88,
   "text": "آدم‌های نیازمندو ببری تو املاک خودت بنشونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.88,
   "end": 296.66,
   "text": "بعد اون ملکی که خودت هم توش هستی رو ببخشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.66,
   "end": 301.02,
   "text": "اما یه فرصت بگیری. بگی آقا من فعلاً مستأجر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.02,
   "end": 303.66,
   "text": "الان به نام شما می‌زنم شش ماه بعد خالی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.66,
   "end": 306.92,
   "text": "این مثال، مثالی که می‌شه تو ذهن آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.92,
   "end": 311.86,
   "text": "بالاخره اون‌ها رهبر عزیز فرمود چون می‌دونست که می‌تونه جبران کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.86,
   "end": 317.98,
   "text": "پس حواسمون جمع باشه که اینطور هم نیست که دیگه بریز به پاش طوری باشه که انسان زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 317.98,
   "end": 320.14,
   "text": "عادی‌ش فلج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.14,
   "end": 322.76,
   "text": "اما گرفتاری ما این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.76,
   "end": 327.78,
   "text": "این نیست که حالا بیاییم بگیم خط طور ترمز بذاریم برای آدمایی که می‌خوان بذل و بخشش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.78,
   "end": 331.72,
   "text": "چون اصلا این نیست. اتفاقا بذ، بخشش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.72,
   "end": 334.86,
   "text": "اتفاقا باید از اون طرف هل بدیم خودمونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 334.86,
   "end": 337.48,
   "text": "که بابا یه ذره ببخش، یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.48,
   "end": 339.44,
   "text": "خرج کن. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.44,
   "end": 341.26,
   "text": "مثلا همسرم منو دوست نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.26,
   "end": 343.56,
   "text": "انقدر که ب-با بخیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.56,
   "end": 346.48,
   "text": "تنگی، دستتو بستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.48,
   "end": 351.68,
   "text": "خرج نمی‌کنی. اصلاً یه دلیل اینکه ما عاشق همسر و فرزندانمونیم می‌دونید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.68,
   "end": 353.94,
   "text": "طبق سیر بحث بگیم ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.94,
   "end": 358.04,
   "text": "طبق فرمایش پیغمبر چون خرجشون می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.04,
   "end": 363.06,
   "text": ". چون خرج همسر و فرزند می‌کنی، به زی، به میزانی که خرجشون می‌کنیم دوسشون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.06,
   "end": 365.87,
   "text": "اصلاً از بذل و بخشش مرد معلوم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.87,
   "end": 370.63,
   "text": "اصلاً چرا میگن مهر، مهریه یا صداق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.63,
   "end": 374.71,
   "text": "از صداقت میاد. مهر و مهر و عاطفه و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.71,
   "end": 381.13,
   "text": "یعنی همون اول مرد از دارایی‌ش نه وعده بده هزار تا سکه، پنج صد تا، دویست تا بعد بمونه توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.13,
   "end": 384.83,
   "text": "الان چی داری؟ الان چی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.83,
   "end": 389.27,
   "text": "بخشی از دارایی‌تو، صداقتت رو به همسرت نشون بده از الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.27,
   "end": 393.07,
   "text": "از همین الان ببخش. یه فیلم مجلسه دیگه مطالبه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.07,
   "end": 395.81,
   "text": "اما الان واجبه که بده به همسرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.81,
   "end": 398.05,
   "text": "این محبت رو از اینایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.05,
   "end": 400.65,
   "text": "کی دید، کی داده، کی گرفته مهر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.65,
   "end": 404.19,
   "text": "این قطعاً مهر و محبت بین همچین زوجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.19,
   "end": 408.61,
   "text": "خیلی کمه. یا برای بچه‌هاش به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.61,
   "end": 411.75,
   "text": "پس خرج کردن باید حساب کتاب داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 411.75,
   "end": 417.97,
   "text": "اما جاهایی هست که انسان دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.97,
   "end": 421.29,
   "text": "میبینه که نیاز هست دارایی‌ش رو بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.29,
   "end": 428.19,
   "text": "مثل حضرت خدیجه. برای اسلام دیگه بحث، بحث اسلامه، مصلحت اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.19,
   "end": 433.75,
   "text": "بگذریم از بعضیا که شعار میدادن ما ثروتمون رو تخیره کردیم برای روز مبادای انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.75,
   "end": 436.63,
   "text": "نمیدونیم این مبادای انقلاب کی رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.63,
   "end": 445.53,
   "text": "کی میرسه که دیگه آقایون هفت تا کفن هم پوسوندن و در استخر هم خفه شدن، دارایی‌شون هم با خودشون بردن به گور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.53,
   "end": 448.41,
   "text": "اما دارایی‌مون رو گذاشتیم برای روز مبادای انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.41,
   "end": 454.15,
   "text": "کو؟ کجا خرج کردی؟ اما حضرت خدیجه به محض اینکه نیاز رو احساس کرد همه رو ریخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.15,
   "end": 455.99,
   "text": "و وقتی می‌خواست بره یه کفن نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 455.99,
   "end": 462.55,
   "text": "ببینید اینا خیلی مهمه تصمیمی که انسان می‌خواد بگیره چه موقع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.55,
   "end": 465.17,
   "text": "اقتضای زمان و مکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.17,
   "end": 468.17,
   "text": "در به نظر شما ریخته پاشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.17,
   "end": 473.73,
   "text": "در عالم بذل و بخشش ریخته پاشی که اباعبدالله کرده کی کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.73,
   "end": 476.57,
   "text": "لیستنق عبادک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 476.57,
   "end": 480.77,
   "text": "تو اون آخرین قطره خونت رو دادی که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.77,
   "end": 483.83,
   "text": "تو زیارت اربعین انشاالله قسمت شه به زودی بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.83,
   "end": 485.95,
   "text": "که چی بشه؟ برای چی بخشیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.95,
   "end": 489.65,
   "text": "برای چی صغیر و کبیرتو بردی زیر تیغ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.65,
   "end": 493.35,
   "text": "ناموست رو به اسارت بردی حتی دختر سه سالتو و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.35,
   "end": 496.31,
   "text": "هرکسی حاضر نمیشه که. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.31,
   "end": 502.45,
   "text": "آقا ما نمیگیم که زیارت صریح اربعین لیستنق و عبادک من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 502.45,
   "end": 507.91,
   "text": "که چی؟ من الجھاله از جهالت و حیرت ضلاله از ضلالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 507.91,
   "end": 511.77,
   "text": "و جهالت من العالم رو نجات بدی، کائنات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.77,
   "end": 514.07,
   "text": "لذا همه چیزشو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.07,
   "end": 516.45,
   "text": "یه ذره با عقل جور در نمیاد این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 516.45,
   "end": 518.57,
   "text": "خب مردا تو می‌بردی. همسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.57,
   "end": 520.13,
   "text": "چرا ناموس تو؟ ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.13,
   "end": 523.01,
   "text": "حتی زمین کربلا رو خرید ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.01,
   "end": 527.99,
   "text": "به یه قیمت چند برابر خرید زمین کربلا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.99,
   "end": 531.43,
   "text": "بعد باهاشون شرط کرد اینکه اربعین میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.43,
   "end": 534.29,
   "text": "یک قرون پول از شما نمیگیرن، هی پذیرایی میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.29,
   "end": 537.51,
   "text": "این وصیت اباعبدالله به سرزمین کربلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 537.51,
   "end": 540.71,
   "text": "خرید با یه قیمت بالایی و شرط کرد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 540.71,
   "end": 544.95,
   "text": "بیعنامه نوشتن به شرط اینکه هرکس وارد این سرزمین شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.95,
   "end": 546.57,
   "text": "بعد قید اربعین هم نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.57,
   "end": 549.11,
   "text": "اونا فقط دارن اربعین رو رعایت میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.11,
   "end": 556.35,
   "text": "وارد زیارت بر زیارت هم وارد این سرزمین شد بر شماست که سه شبانه روز خرجشو بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.35,
   "end": 560.33,
   "text": "این بذل و بخشش امام حسین ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.33,
   "end": 563.47,
   "text": "هرچی داره ریخته و برای همینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.47,
   "end": 567.81,
   "text": "حالا به نظر شما انقدر که ما امام حسین رو دوست داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.81,
   "end": 571.07,
   "text": "ما بیشتر دوست داریم یا امام حسین ما رو بیشتر دوست داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 571.07,
   "end": 573.41,
   "text": "کی خرج ما کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.41,
   "end": 575.73,
   "text": "امام حسین. ما چقدر خرج آقا کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.73,
   "end": 579.23,
   "text": "حالا یه بخشی از درآمدمون با منت و هزار تا چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.23,
   "end": 581.49,
   "text": "فیس و افاده میدیم به مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.49,
   "end": 584.03,
   "text": "یه نمکی هم ما بپاشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.03,
   "end": 587.31,
   "text": "مطمئنا امام حسین به مراتب عاشق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.31,
   "end": 591.59,
   "text": "چرا؟ به سیر بحث که بگیم انقدر که پول خرج ما کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.59,
   "end": 594.35,
   "text": "گفتیم دل‌ها اونجاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 594.35,
   "end": 599.79,
   "text": "مال‌ها هست. انقدر که اباعبدالله ریخته پاش کرده عاشق من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.79,
   "end": 603.31,
   "text": "عاشق انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.31,
   "end": 606.41,
   "text": "حالا یه رشه‌ای از محبت او به ما هم رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.41,
   "end": 608.05,
   "text": "البته دل به دل راه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.05,
   "end": 610.99,
   "text": "یه بار یه، یه جلسه ای درباره‌ش با هم صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.99,
   "end": 617.05,
   "text": "یه اصل عجیبیه. حالا نمیگم رکین و رسین مخصوصاً کلمه عجیب رو استفاده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 617.05,
   "end": 620.15,
   "text": "شما خیلی موقع‌ها شده یهو یاد یکی میفتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 620.15,
   "end": 623.61,
   "text": "همینطوری بی‌خ-- اونم یاد شما افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 623.61,
   "end": 627.53,
   "text": "یا بلافاصله بعد از یاد شما اونم یاد شما می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.53,
   "end": 632.23,
   "text": "این یه اصله. یا میری زیارت هزار و یک نفر بهت میگن یاد ما باش زیارت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 632.23,
   "end": 634.69,
   "text": "خیلیا رو اصلاً تو ذهنت نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.69,
   "end": 637.11,
   "text": "بعضیا اصلاً از ذهنت رفته میبینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.11,
   "end": 639.87,
   "text": "یکی شبیه اونو میبینی که یاد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.87,
   "end": 641.61,
   "text": "اونم بلافاصله یاد تو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 641.61,
   "end": 643.59,
   "text": "اینا یکی از ارتباطاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 643.59,
   "end": 647.07,
   "text": "عالم بر اساس ارتباطاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.07,
   "end": 650.11,
   "text": "حالا اینکه شما این ناصیه ات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.11,
   "end": 654.57,
   "text": "این زلفت به کی گره خورده اون مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.57,
   "end": 656.67,
   "text": "یکی خرج شیطان میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.67,
   "end": 658.97,
   "text": "یکی خرج خدای رحمان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 658.97,
   "end": 661.11,
   "text": "بعد این عاشق شیطان میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.11,
   "end": 663.61,
   "text": "اون عاشق خدای رحمن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.61,
   "end": 665.87,
   "text": "پولتو کجا خرج کردی؟ زلفت کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 665.87,
   "end": 667.99,
   "text": "اینا، اینا خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.99,
   "end": 671.87,
   "text": "که انسان حالا این دیگه فرمول شده از این به بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 671.87,
   "end": 673.51,
   "text": "میخوام عاشق قرآن بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 673.51,
   "end": 676.57,
   "text": "بفرمایید خرج قرآن کن. میخوام عاشق امام زمان بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 676.57,
   "end": 678.35,
   "text": "بفرما خرج قم، امام زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.35,
   "end": 681.73,
   "text": "میخوام عاشق علم باشم. سینه ام گشاده باشه برای علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.73,
   "end": 685.27,
   "text": "بفرما خرج قم، خرج علم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.27,
   "end": 690.97,
   "text": "یا چند تا اهل علم رو پوشش دادی خرج و مخارجشون رو گفتی شما درس بخونید پولتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 690.97,
   "end": 694.03,
   "text": "اجاره خونه‌تون با من. مخارج درمانتون با من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 694.03,
   "end": 696.85,
   "text": "جهیزیه دخترت با من. تو دغدغه اینو نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 696.85,
   "end": 700.65,
   "text": "تو به علمت، درستو بخون. دانشجو، طلبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 700.65,
   "end": 703.65,
   "text": "حافظ قرآن، این مدارس قرآنی که هستن چقدرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 703.65,
   "end": 705.79,
   "text": "بیست میلیون، چقدر بعضیاشون دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 705.79,
   "end": 708.95,
   "text": "سالیانه پول میگیرن مجبورن واسه مخارج رو ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.95,
   "end": 711.11,
   "text": "بچه های بیچاره که ندارن چیکار کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 711.11,
   "end": 714.65,
   "text": "خب تو بیا مثلاً یکیشونو دو تاشونو هزینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 714.65,
   "end": 716.95,
   "text": "مدارس قرآنی رو پوشش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 716.95,
   "end": 722.37,
   "text": "این ده تا نوجوان، این یه دونه نوجوان مخارج سالیانش با من حافظ قرآن بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 722.37,
   "end": 725.07,
   "text": "رهبر می‌فرماید ده میلیون حافظ قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 725.07,
   "end": 728.83,
   "text": "چند تا، چند هزار تا الان داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.83,
   "end": 731.37,
   "text": "اینا همش برمی‌گرده به دل آقا، دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 731.37,
   "end": 733.67,
   "text": "دل که بزرگ باشه می‌تونه این کارا رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 733.67,
   "end": 737.05,
   "text": "دل کوچیک از آدمای کوچیک و کوتوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 737.05,
   "end": 744.03,
   "text": "نمی‌تونه. مگر، اگرم انجام بده با فیس و ifade و توقع پاداش و بهشت و فرار از جهنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 744.03,
   "end": 747.01,
   "text": "از شود به به و چه چه و تشکر و فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 747.01,
   "end": 750.37,
   "text": "و چشم داشت. اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 750.37,
   "end": 753.49,
   "text": "دل، دل. خدا رحمت کنه اگر رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 753.49,
   "end": 755.83,
   "text": "اگه نمی‌دونم ایشون زنده باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 755.83,
   "end": 758.29,
   "text": "مال خیلی سال‌های پیشه. حاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 758.29,
   "end": 761.29,
   "text": "جواد فرشچی شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.29,
   "end": 764.83,
   "text": "به ز-- به اسمتون، اسمش به گوشتون خورده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 764.83,
   "end": 767.59,
   "text": "یه آدم خیلی خاصی بود از عاشقا و مردا امام حسین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 767.59,
   "end": 770.41,
   "text": "اینو بگم چاشنی بحثمون کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 770.41,
   "end": 774.99,
   "text": "ببینید دل وقتی بزرگ بود چی می‌کنه، چه می‌کنه، چه ها می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 774.99,
   "end": 781.33,
   "text": "که من به بعضیا گفتم اشک تو چشاشون جمع شد در صورتی که من روضه براشون نخوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 781.33,
   "end": 784.61,
   "text": "حالا دلتو محک بزن نسبت به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 784.61,
   "end": 789.79,
   "text": "داستان حقیقی. یه که از دوستان ابا عبدالله به مشکل مالی بر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 789.79,
   "end": 793.27,
   "text": "هرچی نگاه می‌کنه هیچی نداره بفروشه جز فرشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 793.27,
   "end": 795.07,
   "text": "تو خونه قدیمی داره و اینو بفروشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 795.07,
   "end": 799.55,
   "text": "حالا روضه می‌گرفته خونه‌شون از قضای روز منقل که میذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 799.55,
   "end": 803.31,
   "text": "زغال رو این منقل که مثلا اسفند و اینا برای روضه سیدالشهدو دود کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 803.31,
   "end": 807.09,
   "text": "این زغاله برمی‌گرده رو فرش، یه گوشه فرش می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 807.09,
   "end": 811.41,
   "text": "می‌خواسته این فرش رو بفروشه هر جا می‌برده تو این بازار فرش‌فروشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 811.41,
   "end": 812.93,
   "text": "اینا قیمتو کم می‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 812.93,
   "end": 815.45,
   "text": "میگن آقا این پونصد هزار تومن ارزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 815.45,
   "end": 819.47,
   "text": "فرشه اما چون اینطوری شده صد تومن بیشتر نمی‌خریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 819.47,
   "end": 824.43,
   "text": "این مغازه، این حجره. حالا آخرین نفر میگه صد و پنجاه تومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 824.43,
   "end": 826.13,
   "text": "تا دیگه یه جا میره پیش کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 826.13,
   "end": 829.73,
   "text": "حاج جواد فرشچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 829.73,
   "end": 832.29,
   "text": "بهش، میاره فرشو نشون میده آقا چند می‌خری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 832.29,
   "end": 837.31,
   "text": "اولین تذکری که می‌ده حاج جواد میگه این فرش خوبی بوده چرا محافظتش نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 837.31,
   "end": 839.95,
   "text": "اون میگه آقا این تقصیر من نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 839.95,
   "end": 841.89,
   "text": "تو روضه امام حسین اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 841.89,
   "end": 845.87,
   "text": "تا حرف روضه رو می‌شنوه تو روضه امام حسین چطور سوخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 845.87,
   "end": 848.79,
   "text": "میگه زغال اسفند آقا افتاد سوخت و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 848.79,
   "end": 854.09,
   "text": "میگه خب این فرش قبل از اینکه سوخته بشه برای امام حسین بسوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 854.09,
   "end": 856.17,
   "text": "قبل از اون پونصد هزار تومن ارزش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 856.17,
   "end": 860.79,
   "text": "اما الان که برای امام حسین سوخته یه میلیون ارزششه، دو برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 860.79,
   "end": 864.29,
   "text": "من دو برابر پول میدم اینو ازت می‌خرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 864.29,
   "end": 866.35,
   "text": "دو برابر میده. گره اونو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 866.35,
   "end": 868.43,
   "text": "بعد این فرش رو چیکار می‌کنه به نظرتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 868.43,
   "end": 870.75,
   "text": "می‌ندازه تو حجره‌ش بفروشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 870.75,
   "end": 873.61,
   "text": "دل رو ببین. دو برابر هم پول میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 873.61,
   "end": 876.03,
   "text": "کدوم یکی ما همچین نگاه‌هایی داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 876.03,
   "end": 879.47,
   "text": "اینه که اینو بکشیش عشقش از امام حسین ظاهر نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 879.47,
   "end": 882.19,
   "text": "روز به روزم بیشتر می‌شه چون هر روز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 882.19,
   "end": 884.07,
   "text": "اصلا ارتباطش با آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 884.07,
   "end": 887.81,
   "text": "معامله‌ش با آقاست. منظور نظرش در زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 887.81,
   "end": 890.83,
   "text": "غایت اعمال و آرزوش حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 890.83,
   "end": 892.57,
   "text": "فرش رو میندازه رو میز کارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 892.57,
   "end": 895.17,
   "text": "اون قسمتی که سوخته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 895.17,
   "end": 897.71,
   "text": "قلپی میذاره قشنگ تو چشم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 897.71,
   "end": 904.23,
   "text": "بعد هر روز گل محمدی می‌گیره این گلبرگا رو می‌ریزه رو اون قسمت سوخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 904.23,
   "end": 907.63,
   "text": "تبرکن. میگه این سوخته‌ی امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 907.63,
   "end": 910.83,
   "text": "این گل محمدیا رو، گلبرگا رو می‌ریزه اون قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 910.83,
   "end": 916.69,
   "text": "به هر کی مهموناش چایی می‌خواد بده از این گلبرگا می‌ریزه تبرکن تو این چایه میگه بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 916.69,
   "end": 919.73,
   "text": "این متبرک سوخته راه امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 919.73,
   "end": 927.83,
   "text": "شما نگاه رو ببین. اینطوریه این بزرگان ما الان این سینه به سینه موج عشق امام حسین زده به من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 927.83,
   "end": 930.17,
   "text": "اینچنین انتقال پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 930.17,
   "end": 932.01,
   "text": "عشق رو ما اینطوری تلقی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 932.01,
   "end": 935.03,
   "text": "و الا با حرف و حدیث من که جور در نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 935.03,
   "end": 940.93,
   "text": "عمل. ان‌شاءالله عاقبتهم و خاتمه به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 940.93,
   "end": 948.17,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}