 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 5.14,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 9.04,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.04,
   "end": 15.62,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.62,
   "end": 22.64,
   "text": "کتاب الموت مرحوم مجلسی روایت یازدهم باب چهارم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.64,
   "end": 26.42,
   "text": "یک بار دیگه روایت رو تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.42,
   "end": 29.0,
   "text": "امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.0,
   "end": 32.66,
   "text": "فرمودند \"عن ابیه عن جده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.66,
   "end": 37.46,
   "text": "علیه السلام قال\" از قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.46,
   "end": 39.3,
   "text": "آباهاشون تا امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.3,
   "end": 42.72,
   "text": "\"سئل امیر المؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.72,
   "end": 45.76,
   "text": "بماذا احببت لقاء الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.76,
   "end": 54.34,
   "text": "اگر کسی ادعا می‌کنه که عاشق لقاء خداست و دیدن خداست ازش سؤال کن برای چی انقدر عاشق دیدن خدا هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.34,
   "end": 58.6,
   "text": "عاشق موتی. ببین چی جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.6,
   "end": 60.66,
   "text": "علت عشقش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.66,
   "end": 66.48,
   "text": "لقاء الله چیه؟ حالا این سؤال از امیرالمؤمنین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.48,
   "end": 70.4,
   "text": "قال حضرت جواب می‌فرماید \"لما رأيته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.4,
   "end": 74.24,
   "text": "وقتی من دیدم که \"قد اختار لي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.24,
   "end": 78.12,
   "text": "دين ملائكته و رسله و أنبيائه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.12,
   "end": 83.22,
   "text": "وقتی دیدم که خدا اختیار کرده برای من دین بهترین‌هاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.22,
   "end": 89.04,
   "text": "که ملائکهند، رس-رسولان و فرستاده‌دگانش و انبیااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.04,
   "end": 91.88,
   "text": "انبیا، نبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.88,
   "end": 96.22,
   "text": "نابع، نبی می‌شه اسم مشبّهش دیگه اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.22,
   "end": 98.44,
   "text": "مبالغه ش. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.44,
   "end": 101.26,
   "text": "به شدت باخبر. نبع خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.26,
   "end": 103.9,
   "text": "\"أَمَّ يَتَسَاءَلُونَ عَنِ النَّبَإِ الْعَظِيمِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.9,
   "end": 105.94,
   "text": "خبر بزرگ عالم که امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.94,
   "end": 109.96,
   "text": "ولایت کلیه است. انبیا باخبران از عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.96,
   "end": 112.24,
   "text": "رسولان فرستاده‌گانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.24,
   "end": 115.68,
   "text": "یه وقتی من دیدم که \"قد اختار لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.68,
   "end": 118.3,
   "text": "خدا اینو برای من اختیار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.3,
   "end": 121.88,
   "text": "یعنی خیر محض رو، خیر مطلقه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.88,
   "end": 127.12,
   "text": "\"علمت\" و دانستم که \"أن الذي أكرمني بهذا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.12,
   "end": 131.74,
   "text": "اون که این‌طوری به من تکریم کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.74,
   "end": 135.0,
   "text": "و به من لیاقت داده، منو انتخاب کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.0,
   "end": 139.58,
   "text": "\"ليس ينساني\" قطعاً اون ور هم منو فراموش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.58,
   "end": 143.16,
   "text": "اینجا بهترین چیزهاش رو نصیب من کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.16,
   "end": 146.16,
   "text": "اون طرفم بهترین چیزهاش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.16,
   "end": 149.52,
   "text": "نصیب من خواهد کرد. \"فأحببت لقاءه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.52,
   "end": 151.64,
   "text": "پس من عاشق دیدارشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.64,
   "end": 156.2,
   "text": "چرا نباشم؟ نگاه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.2,
   "end": 163.18,
   "text": "چقدر ما در حال نق زدن از خدا و قانون دنیا و عالم آفاقی و نفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.18,
   "end": 166.74,
   "text": "از خودمون نق می‌زنیم. اه این چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.74,
   "end": 171.82,
   "text": "از خودمو، این چه جسمیه، این چه بدنیه، این چه آدمیه، تو کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.82,
   "end": 176.94,
   "text": "ای ف-- به خودمون فحش و دری وری میدیم تا نظام آفاقی زمین و آسمان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.94,
   "end": 180.58,
   "text": "ای سرنوشت، ای روزگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.58,
   "end": 183.6,
   "text": "تا بگیرید خدا و امم پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.6,
   "end": 188.18,
   "text": "امیرالمؤمنین نگاهش رو ببین چقدر زیبا می‌بینه همه چی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.18,
   "end": 190.1,
   "text": "چقدر خدا ما رو تکریم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.1,
   "end": 198.96,
   "text": "دینش رو به ما بخشیده. که خلاصه دین خدا می‌شه اختیار و التزام به ولایت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.96,
   "end": 204.2,
   "text": "که اومد پیش امام صادق علیه السلام گفت آقا من شما رو دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.2,
   "end": 211.12,
   "text": "و اول عرض کرد که آقا من خیلی فقیرم، خیلی بیچاره‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.12,
   "end": 212.96,
   "text": "خودزنی کرد. من خیلی بیچاره‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.96,
   "end": 214.72,
   "text": "حضرت فرمود چرا میگی تو بیچاره‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.72,
   "end": 217.84,
   "text": "چرا میگی فقیری؟ گفت آقا هستم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.84,
   "end": 220.48,
   "text": "مفلسم اینا. حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.48,
   "end": 223.32,
   "text": "آیا ما رو دوست نداری؟ گفت چرا آقا دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.32,
   "end": 225.5,
   "text": "فرمود حاضری محبتتو بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.5,
   "end": 227.68,
   "text": "هرچی از این عالم می‌خوای بهت بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.68,
   "end": 230.9,
   "text": "فرمود نه. گفت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.9,
   "end": 235.32,
   "text": "حضرت فرمود پس تو داراترین‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.32,
   "end": 238.96,
   "text": "نگاه ما سطحیه. فقط همین چند ساله رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.96,
   "end": 241.68,
   "text": "باز تازه همینش هم درست نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.68,
   "end": 247.56,
   "text": "امیرالمؤمنین وقتی اینجا درست رصد می‌کنه و نگاه می‌کنه میگه بهترین نعمت‌ها رو در اختیار من گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.56,
   "end": 250.78,
   "text": "\"قد اختار لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.78,
   "end": 253.6,
   "text": "خدا این اختیار، این رو برا من اختیار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.6,
   "end": 258.4,
   "text": "چه زیبا بر اساس آیه \"ما أصابك من حسنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.4,
   "end": 261.98,
   "text": "اصابت نمی‌کنه به تو حسنه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.98,
   "end": 264.7,
   "text": "الا از کیه؟ \"فمن الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.7,
   "end": 267.62,
   "text": "از الله. این حسنه هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.62,
   "end": 272.08,
   "text": "اختیار دین خدا برای ما حسنه هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.08,
   "end": 273.9,
   "text": "پس انتسابش میده به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.9,
   "end": 277.62,
   "text": "\"قد اختار لي\" خدا اختیار کرد برای من دین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.62,
   "end": 281.2,
   "text": "ولی من باشم میگم خودم بچه زرنگ بودم دینو اختیار کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.2,
   "end": 284.74,
   "text": "خودم زحمت کشیدم به اینجا رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.74,
   "end": 291.72,
   "text": "حاصل زحمات و تلاش یک عمرمه این عبادت و بندگی و فهم و علم و درایت و ولایت و هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.72,
   "end": 294.36,
   "text": "نه امیرالمؤمنین اینطوری نیست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.36,
   "end": 299.38,
   "text": "هرچی خوبیه بر اساس این آیه قرآن، ما ترجمان آیاتند دیگه، از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.38,
   "end": 302.34,
   "text": "اما از اون طرفش این آیه قرآن رو می‌خونما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.34,
   "end": 304.98,
   "text": "\"وما أصابك من سيئة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.98,
   "end": 306.92,
   "text": "به تو اصابت نمی‌کنه بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.92,
   "end": 310.02,
   "text": "سیئه. الا چی؟ \"فمن نفسك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.02,
   "end": 313.42,
   "text": "از نفس خودته. هرچی بدیه از خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.42,
   "end": 316.44,
   "text": "هرچی خیره از خداست. دیگه خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.44,
   "end": 320.04,
   "text": "فحش به این ور اون ور و به آسمان و زمین و عالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.04,
   "end": 323.68,
   "text": "العیاذ بالله رسولان الهی و خدا نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.68,
   "end": 327.92,
   "text": "اونا کارشونو بلدن. راضی باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.92,
   "end": 330.46,
   "text": "راضی باش که بهترین خدا رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.46,
   "end": 334.88,
   "text": "خدا واسه تو خدایی می‌کنه. و این ملائکه و چقدر شیرین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.88,
   "end": 338.06,
   "text": "\"دين ملائكته\" اول اشاره به ملائکه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.06,
   "end": 340.64,
   "text": "این دین، دین ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 340.64,
   "end": 342.46,
   "text": "ملائکه دیگه معصومن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 342.46,
   "end": 344.92,
   "text": "هیچ گناه و آلودی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 344.92,
   "end": 348.06,
   "text": "پاک پاک. درسته عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.06,
   "end": 351.02,
   "text": "عقل کل عقلن. کلاً عقلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.02,
   "end": 354.06,
   "text": "و نفس ندارن که بتونن گناه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 354.06,
   "end": 358.58,
   "text": "اما مگه عقل چیز بدیه؟ یه رشت هشت تو ما اومده ببین چه کرده با ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 358.58,
   "end": 361.12,
   "text": "آپولو که رو آسمون نشونه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 361.12,
   "end": 363.42,
   "text": "وجود عقله دیگه عقل انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 363.42,
   "end": 365.66,
   "text": "این موشک‌هایی که سپاه زد نشونه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 365.66,
   "end": 369.82,
   "text": "عقله. عقل به اینجا میرسه و الا کدوم حیوان تونسته موشک اختراع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 369.82,
   "end": 373.78,
   "text": "اصلاً کدوم حیوان می‌تونه اختراع یا اکتشاف داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 373.78,
   "end": 377.6,
   "text": "هیچ. ببینید به قول علامه حائری یزدی علیه الرحمه در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.6,
   "end": 382.1,
   "text": "اسفارشون فکر می‌کنم جلسه پنجم بود می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.1,
   "end": 384.44,
   "text": "جلسه پنجم شرح اسفار ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 384.44,
   "end": 387.9,
   "text": "می‌فرمودن شما این نگاه کنید پرنده‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 387.9,
   "end": 390.76,
   "text": "از اول خلقت تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.76,
   "end": 393.64,
   "text": "لونه‌ای که می‌سازه همین شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 393.64,
   "end": 398.04,
   "text": "هیچ خلاقیتی، تنوعی، ابداعی درش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 398.04,
   "end": 402.54,
   "text": "همش همین شکله. لونه موش رو نگاه کن همش همین شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.54,
   "end": 404.64,
   "text": "کندوی زنبور اصلاً شکلش تغییر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 404.64,
   "end": 407.58,
   "text": "همینه که هست. اما انسان چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 407.58,
   "end": 413.9,
   "text": "اصلاً قابل قیاس الان اختراعات و اکتشافات انسان با مثلاً همین صد سال پیش، دورتر هم نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 413.9,
   "end": 417.66,
   "text": "این نتیجه‌ش چیه؟ نتیجه عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 417.66,
   "end": 422.02,
   "text": "حالا ملائکه عقلن. میگه این دین اون‌ها رو خدا به من داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.02,
   "end": 427.6,
   "text": "چیز کمی نیست. اون ملائکه‌ای که واسطه‌ی خیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 427.6,
   "end": 430.48,
   "text": "و دیروز بر اساس اون \"لَنَذَرُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 430.48,
   "end": 434.7,
   "text": "\"لَنَذَرُ إِلَى مَلَکُوتِ السَّمَاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 434.7,
   "end": 438.24,
   "text": "یا \"إِلَى مَلَکُوتِ\". کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 438.24,
   "end": 442.42,
   "text": "اگر شیاطین دور قلب کسی نچرخن تو قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 442.42,
   "end": 450.04,
   "text": "تو بحث اون کلمه شصت صد کلمه در معرفت نفس گفتیم شیاطین دور قلب کسی نگردن که اون حرم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 450.04,
   "end": 454.66,
   "text": "نتیجه‌ش چی می‌شه؟ قطعاً نظر می‌اندازه به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 454.66,
   "end": 457.6,
   "text": "ملکوت عالم ملائکت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.6,
   "end": 460.14,
   "text": "تازه اون ملائکه برزخی‌اند تو ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.14,
   "end": 464.42,
   "text": "در جبروت که دیگه اون اصل ملائکه، ریشه‌ی ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 464.42,
   "end": 466.48,
   "text": "مقربین‌اند. بالاتر از اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.48,
   "end": 472.78,
   "text": "داریم ملائکه مهیمین‌اند که اصلاً غرق در خدا هستند از خلق خدا خبر ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 472.78,
   "end": 475.52,
   "text": "این ملائکه کم کسایی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 475.52,
   "end": 477.66,
   "text": "شما اینا رو ورداری عالم می‌پاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.66,
   "end": 480.78,
   "text": "واسطه‌ی فیض‌اند. واسطه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.78,
   "end": 483.34,
   "text": "هرچی به من و شما می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.34,
   "end": 484.96,
   "text": "اینا مدبرات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 484.96,
   "end": 489.36,
   "text": "قرآن چی می‌فرماید؟ تالیات، ذاکرات، زاجرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 489.36,
   "end": 493.06,
   "text": "ها؟ مرسلات، مفارقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 493.06,
   "end": 496.46,
   "text": "اینا غول، ملائکه‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 496.46,
   "end": 499.62,
   "text": "و اینام قابل دیدنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 499.62,
   "end": 503.52,
   "text": "مثلاً پیغمبر عزیز عالم اشاره می‌کرد، وحی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.52,
   "end": 505.84,
   "text": "نازل می‌شد \"هذا جبرائیل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 505.84,
   "end": 510.22,
   "text": "عرق می‌کرد حضرت حالشو. هرچی نگاه می‌کردن کسی چیزی نمی‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 510.22,
   "end": 514.7,
   "text": "پیغمبر که می‌دید \"إِنْ هُوَ إِلَّا وَحْيٌ يُوحَى\" وحیه هرچی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.7,
   "end": 516.62,
   "text": "\"مَا يَنطِقُ عَنِ الْهَوَى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 516.62,
   "end": 519.66,
   "text": "دیگه از رو هوا که نمیگه. میگه \"هذا جبرائیل\" قطعاً جبرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 519.66,
   "end": 524.68,
   "text": "پس چرا هیچکس رو نمی‌بینه؟ چون تمثلش برای پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 524.68,
   "end": 530.2,
   "text": "فقط پی-- دیگران مثلا آ-- خدا رحمت کنه آقای بهجت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 530.2,
   "end": 536.86,
   "text": "کسانی که از نزدیک با ایشون زیاد بودن، زیاد اینو از ایشون شنیدن که آقا حریم حرم رو نگه دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 536.86,
   "end": 538.66,
   "text": "خیلی با احتیاط اینجا حرکت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 538.66,
   "end": 541.98,
   "text": "اینجا مملو از ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.98,
   "end": 547.92,
   "text": "حریم حرم حضرت معصومه صلوات الله علیها رو ایشون می‌فرمود که پر است از ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 547.92,
   "end": 551.64,
   "text": "و اون ملائکه‌ای که اونجا هستن و دیده می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 551.64,
   "end": 554.38,
   "text": "کاملاً آگاه‌اند بر حریم حرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 554.38,
   "end": 557.64,
   "text": "حدود حرم. اصلاً می‌بینن همه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 557.64,
   "end": 561.96,
   "text": "حالا یه کسی مثل آقای بهجت به جایی می‌رسه که بر کشیش نفس میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 561.96,
   "end": 564.44,
   "text": "کشیک نفس می‌دهش، مراقب نفسش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 564.44,
   "end": 569.26,
   "text": "می‌شه چی؟ می‌شه آقای بهجت که ملائکه رو می‌بینه با اونا گفت‌و‌گو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 569.26,
   "end": 571.36,
   "text": "اصلاً السلام علیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 571.36,
   "end": 573.68,
   "text": "و رحمة الله و برکاته. به کی سلام میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 573.68,
   "end": 578.96,
   "text": "سلام آخر نمازت. قبلاً یه بحثی داشتیم اینجا گفتیم به کیا می‌خوره این سلام دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 578.96,
   "end": 582.04,
   "text": "یکیش ملائکه‌اند که پر کردن ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 582.04,
   "end": 584.62,
   "text": "دور تا دور ما پرن. می‌شه دید اینا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 584.62,
   "end": 588.96,
   "text": "بله می‌شه دید. اگه نمی‌شد دید چرا دستور داریم شب نیمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 588.96,
   "end": 591.1,
   "text": "حالا گذشت ولی یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 591.1,
   "end": 595.24,
   "text": "ها؟ یه یادگاری از مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 595.24,
   "end": 599.82,
   "text": "شیخ طوسی خدمتتون عرض کنم از در کتابی که تهذیب الأحکامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 599.82,
   "end": 603.7,
   "text": "تهذیب از تهذیب یکی از کتب اربعه‌شی هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 603.7,
   "end": 607.9,
   "text": "تهذیب و استبصار مال شیخ طوسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 607.9,
   "end": 611.02,
   "text": "درسته؟ ملایحضر مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 611.02,
   "end": 615.0,
   "text": "شیخ صدوق. اصول، ااا کافی هم که مال مرحوم کلینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 615.0,
   "end": 619.4,
   "text": "کتب اربعه. دیگه ما با-- جامع‌ترین کتب اربعه‌مان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 619.4,
   "end": 623.7,
   "text": "تو از تهذیبش اونجا اگه خواستید سندشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 623.7,
   "end": 626.84,
   "text": "جلد سه، صفحه شصت و دوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 626.84,
   "end": 630.52,
   "text": "روایتی رو میاره که حالا یادتون باشه برای سال بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 630.52,
   "end": 634.6,
   "text": "ها؟ راه دیدن ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 634.6,
   "end": 637.2,
   "text": "یه راهشه البته. یه راهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 637.2,
   "end": 640.9,
   "text": "کسانی هستند و بودن امتحان کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 640.9,
   "end": 645.44,
   "text": "حتی به امتحان انجام دادن و دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 645.44,
   "end": 648.16,
   "text": "که فرمود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 648.16,
   "end": 652.9,
   "text": "شب نیمه ماه مبارک رمضان کسی صد رکعت نماز بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 652.9,
   "end": 656.72,
   "text": "در هر رکعت ده تا بعد از هم ده تا قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 656.72,
   "end": 659.88,
   "text": "می‌شه چند تا؟ هزار تا مجموعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 659.88,
   "end": 666.02,
   "text": "هزار تا قل هوالله بخونه. یعنی هزار تا قل هوالله رو تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 666.02,
   "end": 669.72,
   "text": "سه ساعت و نیم اینطورا طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 669.72,
   "end": 672.62,
   "text": "کسی اون شب انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 672.62,
   "end": 675.62,
   "text": "نمی‌میره تا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 675.62,
   "end": 677.36,
   "text": "این حداقلشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 677.36,
   "end": 682.42,
   "text": "حداقل کف کفش که برای هرکسی این کارو انجام بده اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.42,
   "end": 685.48,
   "text": "مگر اینکه اون شرطی که قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 685.48,
   "end": 689.3,
   "text": "لحاظ نکرده باشه. گناه عقلو زایل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 689.3,
   "end": 695.12,
   "text": "اگر تو خواب ببینی و یادت نیاد این نشانه نقصان عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 695.12,
   "end": 698.3,
   "text": "یک وقت هست خواب ندیدی، خب ندیدی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 698.3,
   "end": 702.32,
   "text": "اتفاقاً قوت نفسه. آدمی که قویه خواب کم می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 702.32,
   "end": 704.26,
   "text": "خوابم می‌بینه خواب درست و حسابی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 704.26,
   "end": 708.28,
   "text": "اتفاقاً چرا تو خواب ببینه، تو بیداری می‌بینه آدمی که نفسش قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 708.28,
   "end": 711.42,
   "text": "حالا حداقلش اینه که در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 711.42,
   "end": 714.74,
   "text": "که طرف بپذیره، اون شخصی که مخاطب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 714.74,
   "end": 717.62,
   "text": "ب-بپذیره این فرمایشو و الا نه در بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 717.62,
   "end": 720.58,
   "text": "در بیداری چرا در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 720.58,
   "end": 723.78,
   "text": "می‌بینه صد تا فرشته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 723.78,
   "end": 726.42,
   "text": "هزار تا قل و بلا در صد رکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 726.42,
   "end": 732.94,
   "text": "که نه اینو حالا من ازش رد میشم اجازه بدید متوقف نشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 732.94,
   "end": 735.98,
   "text": "می‌ترسم خیلی بازش کنم. هر رکعت یه فرشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 735.98,
   "end": 740.16,
   "text": "صد رکعته دیگه. هر رکعت یه فرشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 740.16,
   "end": 743.7,
   "text": "چگونه که میگن از عرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 743.7,
   "end": 749.2,
   "text": "کسی که در جلسه ذکر ما و امام حسین بشینه هر عرقش یه ملک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 749.2,
   "end": 753.2,
   "text": "برای هر کسی نمیشه اینا رو گفت. یه مقدار برای بعضیا سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 753.2,
   "end": 756.6,
   "text": "یا آب، آب که وضو می‌گیری قطراتش هر کدوم یه ملک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 756.6,
   "end": 758.78,
   "text": "حالا صد تا فرشته میشه. اینا چیکار می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 758.78,
   "end": 762.62,
   "text": "اینا رو می‌بینی. این صد تا فرشته رو که دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 762.62,
   "end": 766.34,
   "text": "سی تاشون به تو مژده بهشت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 766.34,
   "end": 769.7,
   "text": "سی تاشون مژده ایمنی از آتش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 769.7,
   "end": 773.48,
   "text": "سی تاشون تو رو از خطا حفظ می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 773.48,
   "end": 776.7,
   "text": "مراقبتت می‌کنند که از خطا حفظ بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 776.7,
   "end": 781.84,
   "text": "ده تاشون هم هرکس به تو نیرنگ بزنه اینا بهش نیرنگ می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 781.84,
   "end": 784.18,
   "text": "مدافعت میشن. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 784.18,
   "end": 786.78,
   "text": "و چه عجیب، چه عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 786.78,
   "end": 788.7,
   "text": "و چرا عجیب؟ عجیب چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 788.7,
   "end": 794.16,
   "text": "خیلی هم درست و خوش و عالی که شب نیمه ماه مولد کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 794.16,
   "end": 801.78,
   "text": "امام حسن مجتبی. شیخ حر عاملی الان تا ذهنم اومد مثلا به این فکر نکردم الان یه دفعه متواتر شد به ذهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 801.78,
   "end": 806.48,
   "text": "که در کتاب شریف وسائل شیعه‌ش قبلاً هم این روایت رو تقدیم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 806.48,
   "end": 808.72,
   "text": "در خصوص تک تک اهل بیت صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 808.72,
   "end": 811.34,
   "text": "یه روایت میاره. می‌فرما تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 811.34,
   "end": 814.22,
   "text": "عقل رو خدا به امام حسن بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 814.22,
   "end": 816.52,
   "text": "عقل رو همه رو به امام حسن بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 816.52,
   "end": 819.18,
   "text": "ملائکه چیه جنسشون؟ عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 819.18,
   "end": 825.3,
   "text": "عقولن. شب نیمه ماه مبارک رمضان میگه این صد رکعت رو باید انجام بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 825.3,
   "end": 827.16,
   "text": "پس دیدنشون خیلی هم آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 827.16,
   "end": 833.4,
   "text": "اینطوری نیست که سخت باشه. یه مقدار آدم مراقبت مثلا اونا خادم ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 833.4,
   "end": 836.46,
   "text": "خادمه، اونا خ-خدمه عالم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 836.46,
   "end": 840.0,
   "text": "ما فکر می‌کنیم چیزای غلمبه سلمبه و عجیب غریبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 840.0,
   "end": 844.72,
   "text": "اونا خادم مان. امیرالمؤمنین فرمود، امام صادق فرمود، پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 844.72,
   "end": 849.84,
   "text": "که ملائکه خدام شیعیان و محبین ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 849.84,
   "end": 851.76,
   "text": "منتها ما نمی‌بینیمشون اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 851.76,
   "end": 854.44,
   "text": "چرا نمی‌بینیم؟ چون شیاطین دور قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 854.44,
   "end": 858.92,
   "text": "بحث صحبت دیروزمون. گشتن حجاب ایجاد کردن، غافل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 858.92,
   "end": 861.52,
   "text": "حاج چی؟ حافظ از میان برخیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 861.52,
   "end": 864.38,
   "text": "تو خود حجاب خودی. حافظ از میان برخیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 864.38,
   "end": 866.84,
   "text": "حجاب خودمونیم. شیاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 866.84,
   "end": 869.74,
   "text": "وجودی خودمونه. ان شا الله که عاقبت بخیر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 869.74,
   "end": 872.52,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 872.52,
   "end": 876.4,
   "text": "اللهumma صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}