 "chapters": [
  {
   "index": 0,
   "title": "## ولهرب منه موافاته",
   "start": 25.22,
   "end": 143.5
  },
  {
   "index": 1,
   "title": "## لوحِ محفوظ و ارکانِ چهارگانه",
   "start": 143.5,
   "end": 319.84
  },
  {
   "index": 2,
   "title": "## مثالِ آتش برای وجه الله",
   "start": 319.84,
   "end": 415.16
  },
  {
   "index": 3,
   "title": "## ملائکه خادمِ محبین",
   "start": 415.16,
   "end": 537.64
  },
  {
   "index": 4,
   "title": "## الگوی پس از رسول؛ علی",
   "start": 537.64,
   "end": 821.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 11.62,
   "end": 15.24,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.24,
   "end": 20.88,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 20.88,
   "end": 25.22,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 25.22,
   "end": 29.32,
   "text": "حدیث هفتم بودیم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 29.32,
   "end": 34.72,
   "text": "قال امیر المؤمنین علیه السلام ایها الناس کل امر ان لاقٍ فی فراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.72,
   "end": 40.04,
   "text": "ما منه یفر ولعجله مصاق النفس الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 40.04,
   "end": 45.14,
   "text": "تا اینجا رو توضیح دادیم. این قسمتش مونده بود که ولهرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 45.14,
   "end": 48.56,
   "text": "منه موافاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.56,
   "end": 53.48,
   "text": "فرار از مرگ عین رسیدن به این، به اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 53.48,
   "end": 57.0,
   "text": "ولهرب منه فرار کردن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 57.0,
   "end": 61.06,
   "text": "مرگ موافاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.06,
   "end": 63.92,
   "text": "عین رسیدن بهشه، عین درک اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.92,
   "end": 68.14,
   "text": "هرچی که شما فرار کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.14,
   "end": 73.24,
   "text": "این سوق نفس به اون سمت داره طی میشه و شما رو میرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.24,
   "end": 77.26,
   "text": "مصاق النفس الیه. بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.26,
   "end": 82.5,
   "text": "گمان می‌کنند که می‌تونند از مرگ فرار کنند کما این که قدیم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.5,
   "end": 85.26,
   "text": "این که قرآن می‌فرماید إن کنت في بروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.26,
   "end": 87.52,
   "text": "مشیده حتی اگر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.52,
   "end": 89.86,
   "text": "برج‌ها و کاخ‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.86,
   "end": 94.16,
   "text": "به ظاهر محکم هم باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.16,
   "end": 98.72,
   "text": "مرگ شما رو، یقه شما رو خواهد گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.72,
   "end": 101.02,
   "text": "درک خواهید کرد مرگ رو یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.02,
   "end": 104.46,
   "text": "چون فرار می‌کردن فکر می‌کردن که می‌تونند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.46,
   "end": 109.44,
   "text": "یه جایی پنهان بشن. فکر می‌کردن ملک الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.44,
   "end": 112.88,
   "text": "جنسش ماده‌ست. میشه از ماده میشه فرار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.88,
   "end": 116.8,
   "text": "شما از ماده فاصله بگیری داری دور میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.8,
   "end": 119.52,
   "text": "اما وقتی یک چیزی جنسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.52,
   "end": 123.14,
   "text": "مادی نبود، از نشئه طبیعت نبود یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.14,
   "end": 127.98,
   "text": "مجرد بود دیگه فرار معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.98,
   "end": 131.56,
   "text": "شما به هر طرف بری رو به او کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.56,
   "end": 134.68,
   "text": "چون ملک الموت جنسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.68,
   "end": 138.38,
   "text": "مجرده دیگه. مثلا این لوح محفوظ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.38,
   "end": 143.5,
   "text": "خیلی هم درباره‌ش روایات عجیب و غریبی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.5,
   "end": 148.64,
   "text": "لوح محفوظ چهار رکن داره دیگه که قبلاً اون رکن‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.64,
   "end": 152.76,
   "text": "خانه خدا، بیت المعمول و عرش رو گفتیم بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.76,
   "end": 159.82,
   "text": "تسبیحات أربعة سبحان الله والحمدالله ولا اله الا الله والله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.82,
   "end": 166.44,
   "text": "که عظمت تسبیح حضرت زهرا سلام الله علیها اینجا مشخص می شد که لا اله الا الله هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.44,
   "end": 169.56,
   "text": "امام صادق علیه السلام فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.56,
   "end": 174.46,
   "text": "اضافه کنید به اون تسبیحات که تکمیل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.46,
   "end": 177.74,
   "text": "این چهار تا رکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.74,
   "end": 183.06,
   "text": "لوح محفوظ، علم و حیات و اراده و قدرت حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.06,
   "end": 188.06,
   "text": "که علمش مجری علم، مجری علم حضرت حق حضرت جبرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.06,
   "end": 190.6,
   "text": "یعنی هر کجا که بحث علمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.6,
   "end": 194.8,
   "text": "حضرت جبرائیل اونجا مصرحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.8,
   "end": 199.56,
   "text": "پاش در میونه. حیات مجریش حضرت اسرافيله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.56,
   "end": 203.14,
   "text": "حیات. اماته و حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.14,
   "end": 207.0,
   "text": "اراده میکائيله. حضرت میکائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.0,
   "end": 210.04,
   "text": "که بر اساس اراده حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.04,
   "end": 211.92,
   "text": "رزق هر کسی رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.92,
   "end": 216.54,
   "text": "کیله. پر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.54,
   "end": 220.46,
   "text": "اندازه هر کسی رو و قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.46,
   "end": 222.72,
   "text": "مجریش حضرت عزرائيله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.72,
   "end": 227.7,
   "text": "که حضرت عزرائیل هرچه می‌کنه به قدرت حق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.7,
   "end": 229.64,
   "text": "و خودش هم چهار بال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.64,
   "end": 234.62,
   "text": "عجیبه. چهار بال داره که باز کنه شرق و غرب عالم رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.62,
   "end": 236.68,
   "text": "همه جای عالم رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.68,
   "end": 240.94,
   "text": "حالا این‌ها باید تعب- تعبیر بشه، تأویل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.94,
   "end": 245.7,
   "text": "عبور کنی از ظاهر عبارت به باطنش یعنی چهار، چهار تا بال داره یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.7,
   "end": 248.76,
   "text": "یعنی قدرت خدا همه جا رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.76,
   "end": 252.02,
   "text": "همونطور که وجه خدا همه جا رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.02,
   "end": 255.76,
   "text": "عزرائیل هم یکی از وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.76,
   "end": 263.0,
   "text": "یا وجوه حقه. یعنی فأینما تولوا فثم وجه الله که داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.0,
   "end": 266.6,
   "text": "شما به هر طرف رو کنید رو به وجه خدا کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.6,
   "end": 270.86,
   "text": "وجه محل ظهور اثره، آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.86,
   "end": 276.94,
   "text": "اثره. حق هر کجا که آشکار، آشکار بشه اونجا وجه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.94,
   "end": 278.96,
   "text": "حالا قرآن می‌فرماید قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.96,
   "end": 281.74,
   "text": "آیه هشت سوره جمعه قل إن کنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.74,
   "end": 286.56,
   "text": "قل إن الموت الذي تفرون منه فإنه ملاقیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.56,
   "end": 291.76,
   "text": "اون چیزی که ازش فرار می‌کنید قطعاً ملاقاتش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.76,
   "end": 297.36,
   "text": "یه وجهش به خاطر همینه که چون اون وجه خداست شما به هر طرف رو کنید رو به او کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.36,
   "end": 302.32,
   "text": "شما فرار می‌کنی از حضرت عزرائیل که نه اصلاً به سوی او داری میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.32,
   "end": 305.68,
   "text": "چون قدرت خدا همه جا رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.68,
   "end": 309.62,
   "text": "رشا، رضا، رشحات، رشحات وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.62,
   "end": 313.14,
   "text": "این فرشته عظیم الشأن الهی همه جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.14,
   "end": 317.34,
   "text": "اینطور نمیشه فرار کرد. محل ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.34,
   "end": 323.9,
   "text": "اثر حقه. این که از امیرالمؤمنین علیه السلام پرسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.9,
   "end": 327.06,
   "text": "وجه خدا کدوم سمته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.06,
   "end": 329.6,
   "text": "به چه جهته وجه خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.6,
   "end": 332.22,
   "text": "این که قرآن می‌فرماید فأینما تولوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.22,
   "end": 335.44,
   "text": "به هر طرف رو کنید فثم وجه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.44,
   "end": 337.7,
   "text": "به وجه خدا رو کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.7,
   "end": 339.88,
   "text": "این چگونه است؟ نمی‌فهمیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.88,
   "end": 343.56,
   "text": "مولا با یک مثال ساده قبلاً هم عرض کردیم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.56,
   "end": 348.86,
   "text": "فرمود بهشون آتشی رو روشن کرد فرمود این شعله‌های آتش روش به کدوم سمته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.86,
   "end": 351.7,
   "text": "همه جای قسمت‌های این آتش سوزاننده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.7,
   "end": 354.02,
   "text": "داره می‌سوزانه. اثرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.02,
   "end": 357.02,
   "text": "داره ظهور می‌کنه. اثر آتش داره ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.02,
   "end": 361.72,
   "text": "حالا کدوم سمته؟ هرچی فکر کردن سمتی براش پیدا نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.72,
   "end": 366.44,
   "text": "شرق و غرب و جنوب و شمال و بالا و پایین و همه طرف رو داره می‌سوزونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.44,
   "end": 370.3,
   "text": "اثر داره میکنه. آثارش ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.3,
   "end": 373.1,
   "text": "مولا فرمود به همین مثال ساده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.1,
   "end": 375.9,
   "text": "فرمود که وجه خدا این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.9,
   "end": 378.44,
   "text": "هر کجا که اثر حق اونجا وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.44,
   "end": 380.68,
   "text": "البته خب ما وجه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.68,
   "end": 387.08,
   "text": "اعظم هم داریم که اون دیگه کسیه که همه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.08,
   "end": 392.04,
   "text": "وجوه شأن وجودی او می شوند که عرض کردیم عزرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.04,
   "end": 394.38,
   "text": "از این جهت نمی تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.38,
   "end": 400.52,
   "text": "جان وجه الله اعظم و اتم الهی رو بگیره چون شأنی از شؤون وجودی اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.52,
   "end": 404.18,
   "text": "بحثش گذشت در دعای ندبه که می‌خونیم \"أین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.18,
   "end": 413.48,
   "text": "الله الذي الیه يتوجه الأولياء\" کجاست اون وجه الهی که اولیای خدا به او توجه می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.48,
   "end": 418.4,
   "text": "او وجه اتمه. امام زمان هر ا-اصریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.4,
   "end": 421.48,
   "text": "انسان کامله. امام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.48,
   "end": 424.56,
   "text": "محل پیاده‌سازی همه اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.56,
   "end": 429.84,
   "text": "مصداق و مظهر اسم الله که اسم جامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.84,
   "end": 432.6,
   "text": "یا أین دوباره تو ندبه‌ست \"أین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.6,
   "end": 435.52,
   "text": "الله الذي منه یطاع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.52,
   "end": 440.6,
   "text": "از اونجا وارد میشن هر کسی میخواد به خدا به الله برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.6,
   "end": 444.58,
   "text": "وجه الله دیگه منه یطاع از اون وجه باید برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.58,
   "end": 446.6,
   "text": "اصلاً راهی جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.6,
   "end": 448.6,
   "text": "همه عالم رو پر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.6,
   "end": 456.18,
   "text": "تو دعای کمال می‌خونیم \"و أصلک بنور وجهک الذي اضاء له کل شی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.18,
   "end": 459.52,
   "text": "همه چی رو نورانی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.52,
   "end": 465.92,
   "text": "وجه خدا. منظور اون \"أشرقت الأرض بنور ربها\" ای به نور امام ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.92,
   "end": 468.72,
   "text": "به نور امام همه جا روشنه \"بیوم نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.72,
   "end": 472.02,
   "text": "یروز قلبرا\". عزرائیل هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.02,
   "end": 474.48,
   "text": "نوچه به یک معنا خادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.48,
   "end": 478.04,
   "text": "صدنه همه ملائکه صدنه و خادمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.04,
   "end": 480.2,
   "text": "انسان کاملاً در خدمت او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.2,
   "end": 486.18,
   "text": "اتفاقاً محبین و شیعیان امیرالمؤمنین، امام صادق صلی الله علیه فرمود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.18,
   "end": 491.48,
   "text": "سیر استکمال تو همین ن-نشئه طبیعت به جایی میرسن که ملائکه خادمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.48,
   "end": 493.42,
   "text": "محبین اهل بیت هم میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.42,
   "end": 498.04,
   "text": "تا جایی که حدیث داریم ملائکه میان با بچه های اینها بازی می کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.04,
   "end": 502.22,
   "text": "گاهی دیدید بچه های شما طفل معصوم زبانم نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.22,
   "end": 505.42,
   "text": "با یه کسی انگار داره بازی می کنه مشغوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.42,
   "end": 508.78,
   "text": "شما تشخیص نمیدی با ملائکه داره بازی می کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.78,
   "end": 512.38,
   "text": "حالا اینها به وقتش باید باز بشه صحبت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 512.38,
   "end": 514.86,
   "text": "بله وجه اتم الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.86,
   "end": 520.7,
   "text": "اوست که همه جای عالم رو پر کرده و حضرت عزرائیل هم در خدمت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.7,
   "end": 524.42,
   "text": "اینجاست که ما افتخار می کنیم به اینکه علوی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.42,
   "end": 527.78,
   "text": "فاطمی هستیم. حسنی و حسینی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.78,
   "end": 531.42,
   "text": "شما وقتی نگاه می کنید در هر حیثی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.42,
   "end": 541.18,
   "text": "یکی رو میخوای امام خودت، مولای خودت، زعیم و جلودار خودت و الگوی خودت قرار بدی \"ولکم فی رسول الله أسوة حسنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.18,
   "end": 543.74,
   "text": "بعد از پیغمبر کی رو ما الگو قرار بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.74,
   "end": 547.76,
   "text": "کسی که پیغمبر در خصوصش فرمود یا علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.76,
   "end": 552.04,
   "text": "الله اکبر از این جمله \"إنک تسمع ما أسمع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.04,
   "end": 559.7,
   "text": "علی جان تو می شنوی هرچی که من می شنوم و \"ترى ما أرى\" هرچی که من می بینم تو می بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.7,
   "end": 562.08,
   "text": "خب کی بهتر از امیرالمؤمنین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.08,
   "end": 566.42,
   "text": "اینهایی که در انتخاب جلودار و پیشوا و امامشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.42,
   "end": 570.3,
   "text": "اشتباه کردن و خیانت کردن به همه تاریخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.3,
   "end": 574.22,
   "text": "بن عباس اینها لعنت الله علیهم اجمعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.22,
   "end": 577.64,
   "text": "دست همه رو کوتاه کردن از اونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.64,
   "end": 581.18,
   "text": "اگر بدونن چ-چه کسی رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.18,
   "end": 583.62,
   "text": "یعنی با چه کسی مخالفت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.62,
   "end": 588.1,
   "text": "یعنی با خدا مخا-مخالفت کردن با الله مخالفت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.1,
   "end": 596.12,
   "text": "یا حالا در شما میخوای یه کسی رو زعیم خودت، بزرگ خودت، مولای خودت انتخاب کنی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 596.12,
   "end": 599.7,
   "text": "اون چیزهایی که معمولاً مطرحه شجاعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.7,
   "end": 602.22,
   "text": "طهارت، علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.22,
   "end": 606.18,
   "text": "نسب، عرض شود تولد و شهادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.18,
   "end": 611.42,
   "text": "ارتباط با غیب. هر کدوم از اینا رو نگاه می‌کنی می بینی امیرالمؤمنین صدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.42,
   "end": 617.36,
   "text": "تو یه دقیقه من تندتند اینا رو عرض کنم خدمتتون از حیث شجاعت زدن اون مرحب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.36,
   "end": 620.74,
   "text": "عمرو بن عبد ود یک یک بزرگان عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 620.74,
   "end": 627.2,
   "text": "اینا. یعنی کسی جگر نداشت به قول معروف به جای-- به جز، به جز امیرالمؤمنین بخواد با اینها طرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.2,
   "end": 630.88,
   "text": "تا جایی که آیه نود و پنج سوره نساء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.88,
   "end": 635.76,
   "text": "\"فضل الله المجاهدین على القاعدین أجرا عظيما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.76,
   "end": 638.56,
   "text": "برتری داده امیرالمؤمنین رو بر همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.56,
   "end": 642.4,
   "text": "این در مصداقش امیرالمؤمنین در خصوص امیرالمؤمنین نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.4,
   "end": 645.92,
   "text": "خب چه کسی بهتر از چنین کسی امام انسان باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.92,
   "end": 653.48,
   "text": "خلیفه و جلودار. طهارت \"إنما یرید الله لیذحب عنکم الرجس أهل البيت و یطهرکم تطهيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 653.48,
   "end": 659.0,
   "text": "نسب \"کنتم في الأسلاب الشامخة والأرحام المطهرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 659.0,
   "end": 663.8,
   "text": "کسی که اجدادش همه پاک باشن، مادرانش پاک باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.8,
   "end": 666.22,
   "text": "بعد تو دامن پیغمبر بزرگ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.22,
   "end": 670.6,
   "text": "خانواده‌ش همه معصوم باشن از همسرش بگیر تا فرزندانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 670.6,
   "end": 674.76,
   "text": "شوخیه مگه؟ حتی حضرت اباالفضل و حضرت زینب هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 674.76,
   "end": 677.76,
   "text": "مرحوم سید قزوینی به هجده یا هفده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 677.76,
   "end": 684.6,
   "text": "اگه اشتباه نکنم تو کتابش می‌خوندم دلیل بر اثبات عصمت حضرت اباالفضل و حضرت زینب داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.6,
   "end": 687.6,
   "text": "که اونها هم معصوم بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 687.6,
   "end": 693.7,
   "text": "علمش. خود حضرت فرمود \"إنها هنا لعلم جمع\" به سینه مبارکش اشاره کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 693.7,
   "end": 697.34,
   "text": "علم جمع، جام جمع میگن همه چی توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.34,
   "end": 701.36,
   "text": "این صداوسیمایی‌ها مثل شماها مدعی هستید که همه چی تو شماها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 701.36,
   "end": 705.16,
   "text": "همه چی اینجا هست. بله تا همه چی رو چی بدونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 705.16,
   "end": 714.32,
   "text": "همه چی هست بله. ولی جام جمع امیرالمؤمنین فرمود تو سینه منه هرچی بخوای تو سینه منه \"سينحد را عن السل\" تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 714.32,
   "end": 718.58,
   "text": "خطبه شقشقیه \"ولا یرقى الیه طير\" اصلاً افق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 718.58,
   "end": 724.42,
   "text": "پرواز پرنده‌ای به علم علی نمی‌رسه وقتی سیل علم علی راه بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 724.42,
   "end": 727.04,
   "text": "ارتباطش با غیب که پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 727.04,
   "end": 733.78,
   "text": "هر-- اصلاً اسمشو فقط وحی نمیشه گذاشت از حیث اینکه ایشون دیگه نبی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 733.78,
   "end": 738.96,
   "text": "اما جالبه که نبی اسم خدا نیست اما ولی اسم خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 738.96,
   "end": 743.76,
   "text": "و همیشه پابرجاست. تولد و شهادت چی رو پیدا می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 743.76,
   "end": 746.08,
   "text": "که در خانه خدا به دنیا بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 746.08,
   "end": 748.38,
   "text": "اونم در کعبه. اونم به اون صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 748.38,
   "end": 751.94,
   "text": "پ-- شکاف بخوره. کجا رو می‌تونید بپوشونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 751.94,
   "end": 755.24,
   "text": "الان شکاف کعبه رو تلویزیون نشون می‌داد هنوز شکافش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 755.24,
   "end": 759.04,
   "text": "نتونستن بپوشونن. این همه وهابی نابکار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 759.04,
   "end": 761.28,
   "text": "چجوری می‌خواید رو حق رو بپوشونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 761.28,
   "end": 764.34,
   "text": "شهادتش هم در مسجد در محراب عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 764.34,
   "end": 771.02,
   "text": "یعنی هرچی شما نگاه می‌کنی ما بهتر، بالاتر، عزیزتر، شجاع‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 771.02,
   "end": 776.48,
   "text": "طاهرتر، عالم‌تر از امیرالمؤمنین علی علیه الصلاة والسلام نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 776.48,
   "end": 783.02,
   "text": "نسبت بهش صلوات بفرستیم. اللهم صل على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 783.02,
   "end": 785.58,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 785.58,
   "end": 793.2,
   "text": "و من گلایه دارم از دوستانمون از محبین امیرالمؤمنین که ما از مولا علی میگیم اونا با هم گپ می‌زنن میگن می‌خندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 793.2,
   "end": 794.86,
   "text": "بارها من این شکایت رو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 794.86,
   "end": 797.22,
   "text": "ادامه ندید خوب نیست. جسارته به مولاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 797.22,
   "end": 801.0,
   "text": "این حرفا حرفای من نیست. حرفای بزرگان دین ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 801.0,
   "end": 806.42,
   "text": "از قرآن و عترته. اگر اینجا از من چیزی از خود من می‌شنوید بزنید تو دهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 806.42,
   "end": 809.08,
   "text": "همش گفتار بزرگان حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 809.08,
   "end": 814.02,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 814.02,
   "end": 817.5,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 817.5,
   "end": 819.48,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 819.48,
   "end": 821.3,
   "text": "محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}