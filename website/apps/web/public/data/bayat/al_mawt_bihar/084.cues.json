 "chapters": [
  {
   "index": 0,
   "title": "## روایت پنجم؛ ولایت شیطان و رفتن اجل به پشت دریا",
   "start": 15.92,
   "end": 57.14
  },
  {
   "index": 1,
   "title": "## محک خروج از ولایت آل‌الله",
   "start": 57.14,
   "end": 105.16
  },
  {
   "index": 2,
   "title": "## پس از امام؛ عالم‌ترین شخص آن زمان شیطان است",
   "start": 105.16,
   "end": 230.16
  },
  {
   "index": 3,
   "title": "## علوم آشنا که غریبه نام گرفته‌اند",
   "start": 230.16,
   "end": 716.35
  },
  {
   "index": 4,
   "title": "## مزاج، خوردن، خواب، تکلم و ولایت",
   "start": 716.35,
   "end": 767.63
  },
  {
   "index": 5,
   "title": "## انباشتهٔ علوم و اندک بودن بهرهٔ ما",
   "start": 767.63,
   "end": 820.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.06,
   "end": 5.2,
   "text": "عجل فرجهم. بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 12.08,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.08,
   "end": 15.92,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.92,
   "end": 20.16,
   "text": "و قال إذا استحقت ولاية الشيطان و الشقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.16,
   "end": 26.14,
   "text": "جاء العمل بین العينين وذهب الأجل وراء البحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.14,
   "end": 31.06,
   "text": "بحث در روایت پنجم باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.06,
   "end": 34.56,
   "text": "به این نقطه بسیار حساس رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.56,
   "end": 38.06,
   "text": "که نتیجه ولایت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.06,
   "end": 42.84,
   "text": "بر آدم‌ها انتهاش این می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.84,
   "end": 45.46,
   "text": "وذهب الأجل وراء البحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.46,
   "end": 48.9,
   "text": "اجل رو، مرگ رو، موت رو پشت سرشون قرار می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.9,
   "end": 50.86,
   "text": "یعنی نمی‌بینن، نگاهش نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.86,
   "end": 54.42,
   "text": "چون چیزی که پشت سرته نمی‌بینیش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.42,
   "end": 57.14,
   "text": "یعنی اصلا توجه به موت ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.14,
   "end": 65.22,
   "text": "اگر کسی می‌خواد خودش رو محک بزنه که آقا من تحت ال-- العیاذ بالله تحت تصرف ولایت شیطان قرار گرفتم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.22,
   "end": 66.76,
   "text": "سر خوردم به اون سمت یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.76,
   "end": 69.84,
   "text": "از ولایت آل الله خروج پیدا کردم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.84,
   "end": 72.98,
   "text": "العیاذ بالله این نشونه‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.98,
   "end": 79.36,
   "text": "چقدر به فکر موتی، چقدر به فکر اجل و مرگتی که حتمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.36,
   "end": 81.74,
   "text": "هر مقدار تشکیکیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.74,
   "end": 85.02,
   "text": "اینا مراتبش تشکیکیه. هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.02,
   "end": 93.52,
   "text": "که ما کمتر به موت فکر می‌کنیم، همون مقدار سر خوردیم ش-- سمت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.52,
   "end": 98.52,
   "text": "و ما دیروز عرض کردیم این نکته‌ای که دیروز ما عرض کردیم خودش باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.52,
   "end": 101.46,
   "text": "ده ها منبر می‌طلبه که باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.46,
   "end": 105.16,
   "text": "و چقدر مهمه دونستن این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.16,
   "end": 110.44,
   "text": "شیطان هم که ما داریم بعد از امام عجب، عجب حرفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.44,
   "end": 113.28,
   "text": "بعد از امام هر زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.28,
   "end": 115.28,
   "text": "عالم‌ترین مردم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.28,
   "end": 119.88,
   "text": "اشخاص اون زمان شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.88,
   "end": 123.58,
   "text": "توجه کردید چی عرض کردم؟ بعضیا شاخک‌هاشون تیز شد یهو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.58,
   "end": 126.28,
   "text": "بله روایت داریم مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.28,
   "end": 130.12,
   "text": "بعد از امام زمان هر دوره ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.12,
   "end": 136.0,
   "text": "عالم‌ترین شخص شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.0,
   "end": 140.7,
   "text": "اون اسم اعظم هم بلده. در خون ما می‌تونه نفوذ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.7,
   "end": 145.2,
   "text": "حالا سؤالاتی پیش میاد چرا خدا اینقدر بهش دور داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.2,
   "end": 148.82,
   "text": "برای اینکه تو با یه حریف قدر قدرت مبارزه کنی مچت قوی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.82,
   "end": 152.78,
   "text": "وگرنه با آدم ضعیف، با یه دشمن ضعیف بجنگی که هنر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.78,
   "end": 155.08,
   "text": "که بچه رو مچش رو بخوابونی که هنر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.08,
   "end": 159.2,
   "text": "خدا بهت عزت داده. بعد اون می‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.2,
   "end": 164.38,
   "text": "چو-- تو چه دوره‌ای چگونه به ما حمله ور بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.38,
   "end": 169.14,
   "text": "دوره، دوره که دیروز پنج تا دوره از عمرمون رو شمردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.14,
   "end": 174.12,
   "text": "و راه‌های برخورد شیطان، تعامل شیطان با انسان‌ها در این دوره‌ها رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.12,
   "end": 178.34,
   "text": "انقدر این قصه مهمه، انقدر این قصه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.34,
   "end": 183.18,
   "text": "ببینید اصلاً عالم که حرکتش دوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.18,
   "end": 186.94,
   "text": "دایره می‌چرخه. لز-- لاستیک ماشین رو چرا دایره‌اش کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.94,
   "end": 190.16,
   "text": "که بچرخه. اگه مستطیل بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.16,
   "end": 194.0,
   "text": "اگر مثلث بود می‌چرخید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.0,
   "end": 196.1,
   "text": "کلن فی فælکه یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.1,
   "end": 198.2,
   "text": "این شناگری همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.2,
   "end": 201.82,
   "text": "افلاک به جهت حرکت دوریشونه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.82,
   "end": 205.36,
   "text": "دوره دوره‌ست. الان دوره دنیا ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.36,
   "end": 208.42,
   "text": "تموم می‌شه دوره برزخ. همه چی دوره دوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.42,
   "end": 210.08,
   "text": "بعد قوسی شکله همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.08,
   "end": 213.72,
   "text": "قوس موس به قول مرحوم فارابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.72,
   "end": 217.18,
   "text": "این دوره‌ها انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.18,
   "end": 218.92,
   "text": "شما یه دونه‌شو در نظر بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.92,
   "end": 222.26,
   "text": "یه دونه‌شو می‌خوایم ما امروز توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.26,
   "end": 225.68,
   "text": "حالا بحث ما چیز دیگه‌ای بود ولی به جهت اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.68,
   "end": 229.6,
   "text": "قصه خوبه ما یه نکته‌ای عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.6,
   "end": 233.26,
   "text": "ببینید این همه کتاب‌هایی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.26,
   "end": 236.52,
   "text": "حالا ماها می‌گیم اصطلاحاً علوم غریبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.52,
   "end": 238.48,
   "text": "در صورتی که علوم آشناست. غریبه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.48,
   "end": 243.86,
   "text": "الان به ما غریبه شده اینا. علوم اعداد مثلا، حروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.86,
   "end": 246.6,
   "text": "ارسماتیقی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.6,
   "end": 250.68,
   "text": "هیأت، نجوم که الان اینا اصلاً میگی همه تعجب می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.68,
   "end": 255.18,
   "text": "اینا چیه داره میگه حاجی؟ که قدیم‌ها اینا همه تو حوزه تدریس می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.18,
   "end": 261.84,
   "text": "این‌ها همه اسباب و لوازم‌اند که مقرب ما باشن به سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.84,
   "end": 266.88,
   "text": "یعنی مقرباً یعنی چی؟ برای اینکه ما رو مقرب بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.88,
   "end": 268.78,
   "text": "شما الان نماز خوندی گفتی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.78,
   "end": 271.96,
   "text": "چهار رکعت نماز ظهر اقامه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.96,
   "end": 274.38,
   "text": "واجب قربتاً الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.38,
   "end": 277.46,
   "text": "قربتا. می‌خوای مقرب باشی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.46,
   "end": 280.84,
   "text": "برای مقرب شدن زیاد نیاز به مقرب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.84,
   "end": 284.46,
   "text": "چیزایی ما رو نزدیک بکنه. دانستن این علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.46,
   "end": 287.4,
   "text": "چقدر می‌تونه ما رو نزدیک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.4,
   "end": 291.34,
   "text": "این دوره‌ها، کوره ها. اصلاً خود عالم دوره دوره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.34,
   "end": 295.46,
   "text": "الان ما یکی از دوره‌های حضرت آدم زمان خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.46,
   "end": 299.28,
   "text": "قبل از ما دوره بوده، بعد از ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.28,
   "end": 302.24,
   "text": "تو اون علوم غریبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.24,
   "end": 309.68,
   "text": "حتی صاحبان این علوم مثل مثلا اون بزرگانشون مثل خود ابن عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.68,
   "end": 312.8,
   "text": "در المکنونش مثلا کتاب عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.8,
   "end": 316.48,
   "text": "یا مثلا خود شیخ بها استادش مرحوم ایانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.48,
   "end": 321.4,
   "text": "اینا کتاب‌هایی در این زمینه دارن حتی در تکمیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.4,
   "end": 327.64,
   "text": "جداول افقی یه جدول‌هایی هست دیدید بعضی موقع‌ها میری یکی برات دعا می‌نویسه دستت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.64,
   "end": 330.82,
   "text": "می‌بینی اِ جدول توش حروف نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.82,
   "end": 335.52,
   "text": "علمش هم داره ولی می‌بینی من قبلاً هم گفتم به هر کسی رجوع نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.52,
   "end": 337.94,
   "text": "اگر خودت علمشو نداری ننویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.94,
   "end": 345.08,
   "text": "به هر کسی نده. داریم که تو دوره‌های ماه، ماه دوره دیگ-- دوره داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.08,
   "end": 348.76,
   "text": "ماه هم منازل ماه، منازل مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.76,
   "end": 352.8,
   "text": "ماه قمری. منازل ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.8,
   "end": 356.28,
   "text": "حالا اگر بگیریم بیست و نه، سی روز این حدودا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.28,
   "end": 359.48,
   "text": "دو سه روزش که محاقه، دیده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.48,
   "end": 363.97,
   "text": "نصفش که اول ماه می‌شه می‌ره به سمت فزونی ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.97,
   "end": 368.11,
   "text": "نیمه دوم ماه میاد به نفس، به نفس، به سمت ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.11,
   "end": 371.35,
   "text": "نقص، ناقص میشه ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.35,
   "end": 377.87,
   "text": "اون دوره اولی که ماه به سمت فزونی میره میگن باید اون جدولو بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.87,
   "end": 380.69,
   "text": "آقا عین یک جدول حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.69,
   "end": 384.19,
   "text": "داره با یه علم خاصی نوشته میشه و تاثیر خاصی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.19,
   "end": 387.11,
   "text": "میگه تو اون جا دوره اول باید بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.11,
   "end": 391.77,
   "text": "چه ربطی داره دوره اول که ماه داره به سمت فزونی میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.77,
   "end": 395.55,
   "text": "با اون دوره دوم که به نفس-- به سمت نقص میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.55,
   "end": 399.17,
   "text": "این دوره دوره‌ها تأثیراتیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.17,
   "end": 404.39,
   "text": "در حقیقت بهش میگن تاثیرات در طبایع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.39,
   "end": 407.21,
   "text": "اِاِاِ طبیعیه و جویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.21,
   "end": 409.17,
   "text": "اینا تاثیر میگذارن در هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.17,
   "end": 414.13,
   "text": "همه عالم دارن در هم تاثیر میذارن، از هم متأثر میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.13,
   "end": 417.61,
   "text": "چرا میگه از گنهکار دوری کن نفسش بهت نخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.61,
   "end": 421.47,
   "text": "چرا امام صادق علیه السلام به اون شخص فرمود چون دعات مستجاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.47,
   "end": 425.71,
   "text": "مستجاب نمیشه به جهت اینکه بغل یه آدمی خونه گرفتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.71,
   "end": 429.37,
   "text": "دزده، حرامخواره، شرابخواره، فلانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.37,
   "end": 433.49,
   "text": "هوای خونه اون میاد تو هوای خونه تو، جا به جا میشه فضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.49,
   "end": 436.23,
   "text": "تو میخوای دعا کنی بالا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.23,
   "end": 439.15,
   "text": "چرا میگن هجرت؟ اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.15,
   "end": 441.73,
   "text": "هم-همه ربط، یه علومیه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.73,
   "end": 444.11,
   "text": "حالا میگی که آقا به شما چه این علوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.11,
   "end": 450.87,
   "text": "یعنی چی به شما چه؟ آ انسان وظیفه داره در حین اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.87,
   "end": 457.05,
   "text": "قوه عملیه‌ش رو تقویت میکنه، آقا نماز شب بخون، آقا قرآن بخون، آقا زیارت برو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.05,
   "end": 460.83,
   "text": "عباديات. قوه نظریه‌ش هم باید تقویت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.83,
   "end": 465.09,
   "text": "وظیفه ماست. مگه میشه کسی تشنه باشه آب دستش ندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.09,
   "end": 471.53,
   "text": "اصلا آل الله اومدن که به تشنه گان اهل معرفت آب بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.53,
   "end": 473.31,
   "text": "این دوره‌ها انقدر مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.31,
   "end": 475.77,
   "text": "شما تو همین دوره ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.77,
   "end": 479.67,
   "text": "نیمه ماه میشه بعضی از حیواناتی که مثل زن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.67,
   "end": 485.05,
   "text": "دوره دارن، دوره ماهانه دارن نیمه ماه مثلا خرگوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.05,
   "end": 486.97,
   "text": "جالبه خرگوش این حالت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.97,
   "end": 489.39,
   "text": "نیمه ماه دقیقا این اتفاق براش میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.39,
   "end": 494.95,
   "text": "یا معمولا بیشتر خانوما براشون اتفاق میفته نیمه‌ش، نیمه ماه، ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.95,
   "end": 499.39,
   "text": "دقت کنید دوره‌های ماه رو، ماه قمری رو داریم میگیم نه شمسی الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.39,
   "end": 503.41,
   "text": "دوره مثلا نیمه ماه مزاجشون به هم میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.41,
   "end": 511.41,
   "text": "چه ربطی داره؟ چرا بزرگان اهل معرفت گفتن مسائل سنگین و پیچیده عقلی رو تو دوره اول ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.41,
   "end": 514.85,
   "text": "بررسی کن، مطالعه کن، برو سمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.85,
   "end": 520.93,
   "text": "اگه کلاس درس ماهی یک بار داری با یه آدم عاقل، با یه عارف به الله، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.93,
   "end": 523.61,
   "text": "مثلا نیمه اول ماه بگذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.61,
   "end": 526.87,
   "text": "اینا همه درسه برای ما. اینا خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.87,
   "end": 529.29,
   "text": "جزر و مد معمولا نیمه ماهه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.29,
   "end": 532.27,
   "text": "نیمه ماه جزر و مد اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.27,
   "end": 537.75,
   "text": "چه ربطی داره؟ چرا مورچه‌ها، حالا هی الان تو ذهن من هی مثال‌ها داره میاد دور میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.75,
   "end": 540.39,
   "text": "و الا من نمیخواستم این‌ها رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.39,
   "end": 546.25,
   "text": "چرا نی-نیمه شب مورچه‌هایی که دانه‌ها رو تو خونه‌هاشون جمع کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.25,
   "end": 549.45,
   "text": "این دانه‌ها یه دفعه میبینی کپک میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.45,
   "end": 552.21,
   "text": "چگونه این کپک‌ها رو به نظرتون برطرف می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 552.21,
   "end": 556.15,
   "text": "علم تجربی ثابت کرده سحری که ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.15,
   "end": 560.55,
   "text": "کامله یعنی وسط ماهه تقریبا، ماه بدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.55,
   "end": 563.55,
   "text": "چهاردهم، پونزدهمه. اینا رو میریزن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.55,
   "end": 568.39,
   "text": "خ-- لونه‌شون بیرون. نور ماه این کپک‌ها رو از بین میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.39,
   "end": 570.45,
   "text": "دو مرتبه صبح میبرن تو خونه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.45,
   "end": 574.19,
   "text": "آخه چه ربطی داره اینا به هم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.19,
   "end": 579.23,
   "text": "ماه چه ربطی داره به جزر و مد اصلا، به مزاج انسان‌ها چه ربطی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.23,
   "end": 584.09,
   "text": "به فکر آدم‌ها. اصلا معمولا آدم‌ها اینچنینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 584.09,
   "end": 588.75,
   "text": "یهو میبینی حالت بد شد. نمیدونم چرا قبض گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.75,
   "end": 592.69,
   "text": "معمولا نیمه دوم ماه این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.69,
   "end": 595.61,
   "text": "حالت انبساط دارم. شرح و بسط دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.61,
   "end": 598.15,
   "text": "معمولا نیمه اول ماه این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.15,
   "end": 602.57,
   "text": "خب چه ربطی داره؟ حتی دوره‌های شمسی رو شما دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.57,
   "end": 605.21,
   "text": "حالا مفصله اونکه دیگه الا ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.21,
   "end": 608.61,
   "text": "دوره‌های شمسی ببینید شش ماه سرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.61,
   "end": 613.61,
   "text": "که انّخرشید داره خمیر میکنه زمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.61,
   "end": 617.35,
   "text": "سرما میده، خمیر میکنه، شش ماه دوم می پزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.35,
   "end": 619.27,
   "text": "فصل گرما همه چی رشد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.27,
   "end": 622.09,
   "text": "رشد و نمو هست، می پزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.09,
   "end": 625.43,
   "text": "این، ببین این دوره‌ها همش رو قاعده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.43,
   "end": 632.69,
   "text": "همش رو حسابه. یه برگ از درخت نمی افته مگر به اذن الله و در عالم به قول علامه طباطبایی تاثیر گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 632.69,
   "end": 636.69,
   "text": "یه برگی بیفته. همه در هم دارن تاثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 636.69,
   "end": 640.17,
   "text": "می‌کنن، تأثر می‌گیرن. اینا رو نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.17,
   "end": 644.53,
   "text": "شوخی گرفت. برای اینکه ما در سیر و سلوکمون، اعتقاداتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 644.53,
   "end": 650.87,
   "text": "اخلاقیاتمون برای اینکه در تحت ولایت شیطان قرار نگیریم و در این سیر موفق باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 650.87,
   "end": 654.61,
   "text": "اصلا واجبه تحصیل این علوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 654.61,
   "end": 656.57,
   "text": "حالا ما چقدر اهل مطالعه هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.57,
   "end": 660.63,
   "text": "چقدر وقت برای برنامه‌های دنیاییمون که پول درمیاریم، پول درمیاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 660.63,
   "end": 666.05,
   "text": "از نوسان دلار و سکه و چی جانمونی‌مون وقت داریم میگذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 666.05,
   "end": 669.03,
   "text": "هم مطالعه‌ش هم کار عملی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 669.03,
   "end": 671.75,
   "text": "اما برای این چی؟ برای این مهماتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.75,
   "end": 678.37,
   "text": "او صریحا این روایت داره میگه کسی که تحت تصرف ولایت شیطان قرار گرفت نشونه‌ش اینه مرگ رو یادش میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 678.37,
   "end": 680.81,
   "text": "پشت سرش میندازه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.81,
   "end": 683.43,
   "text": "شیطان میخواد ولایتشو بر تو اعمال کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.43,
   "end": 685.15,
   "text": "دوره‌ها رو متوجه شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.15,
   "end": 687.71,
   "text": "شیطان دوره به دوره بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.71,
   "end": 691.87,
   "text": "آن به آن، لحظه به لحظه مترصد و کمین کردن به ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 691.87,
   "end": 697.33,
   "text": "لذا علامه حسن زاده علیه الرحمه می‌فرماید ما کاری مهم‌تر از حضور و مراقبه نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.33,
   "end": 699.43,
   "text": "که اون هم مبتنی است به معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.43,
   "end": 704.41,
   "text": "و پس ما کاری مهم‌تر از معرفت نفس یعنی شناخت خود نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.41,
   "end": 707.55,
   "text": "باید این دوره‌ها، این کوره ها، اینا رو در نظر گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.55,
   "end": 710.11,
   "text": "این‌ها کمک حال ما باید باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.11,
   "end": 712.53,
   "text": "برای اینکه مقرب بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 712.53,
   "end": 716.35,
   "text": "که ما مقرب شویم. ما رو نزدیک بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.35,
   "end": 718.83,
   "text": "حالا بعد این حرفا رو که بزنیم بعضی ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 718.83,
   "end": 723.37,
   "text": "کسایی که حال و حوصله ندارن اصلا عقلشو تعطیل کرده، عقلش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.37,
   "end": 727.81,
   "text": "قشر خاکستری مغزش نمی‌دونم آسیب دیده، چی شده، چی خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 727.81,
   "end": 729.85,
   "text": "خوردن‌ها آقا اوه، اوه، اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 729.85,
   "end": 733.13,
   "text": "خوردن‌ها چقدر تاثیر داره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 733.13,
   "end": 735.37,
   "text": "انسان، در فهم انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.37,
   "end": 738.61,
   "text": "یکی سریع قرآن رو حفظ میکنه، یکی زور میزنه نمیتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 738.61,
   "end": 742.87,
   "text": "باور کنید یه بحثی چند روز ما داشتیم پیرامون مزاج شناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 742.87,
   "end": 745.05,
   "text": "خوردن‌ها، پوشیدنی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 745.05,
   "end": 747.55,
   "text": "ساعت خواب، ساعت بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 747.55,
   "end": 751.73,
   "text": "حتی تکلم با دیگران، با جنس مخالف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 751.73,
   "end": 755.27,
   "text": "افکار اون شخصی که با تو داره حرف میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 755.27,
   "end": 756.93,
   "text": "چه شب بخوابی یا روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 756.93,
   "end": 760.29,
   "text": "اینا همه در مزاج تاثیر گذاره و همه در فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.29,
   "end": 767.63,
   "text": "و فهم در مستقیما در عمل و در تاثیر ولایت شیطان یا ولایت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 767.63,
   "end": 769.57,
   "text": "یعنی ما در معرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 769.57,
   "end": 773.05,
   "text": "یک عالم انباشته‌ای از علوم هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 773.05,
   "end": 778.85,
   "text": "که حالا هی-- تازه اگر به ظن خودمون اینو دقت کنید جمله آخر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 778.85,
   "end": 783.25,
   "text": "اگر به ظن خودمون تا تهش هم بریم، همه این کتاب‌ها رو بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 783.25,
   "end": 786.61,
   "text": "باز به فرمایش قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 786.61,
   "end": 789.73,
   "text": "\"و ما أوتيتم من العلم إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 789.73,
   "end": 794.25,
   "text": "قليلا\". اصلا به شما علمی جز یک قلیلی داده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 794.25,
   "end": 795.97,
   "text": "همش تو سینه حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 795.97,
   "end": 803.61,
   "text": "و چقدر ما باید بگیم خدا لعنت کنه اونایی که دست ما رو از دامن اهل بیت کوتاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.61,
   "end": 807.23,
   "text": "که ما زمین خوردیم. ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 807.23,
   "end": 809.91,
   "text": "و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 809.91,
   "end": 814.85,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.85,
   "end": 820.25,
   "text": "و آل محمد. الله اکبر، الله اکبر. اشهد ان لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}