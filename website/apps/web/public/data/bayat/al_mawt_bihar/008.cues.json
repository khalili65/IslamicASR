 "chapters": [
  {
   "index": 0,
   "title": "## روایت سوم باب اول؛ مکروه بودنِ «استأثر الله بفلان»",
   "start": 12.4,
   "end": 32.68
  },
  {
   "index": 1,
   "title": "## یفتح فاه عند موته؛ دیدن ثواب الهی",
   "start": 32.68,
   "end": 52.86
  },
  {
   "index": 2,
   "title": "گزینش به معنای انفعال در حق تعالی راه ندارد. همه چیز از آنِ اوست.",
   "start": 52.86,
   "end": 268.18
  },
  {
   "index": 3,
   "title": "## خروج روح از پا تا بینی؛ گشودن دهان",
   "start": 268.18,
   "end": 416.23
  },
  {
   "index": 4,
   "title": "## صد جزء رحمت؛ نود و نه جزء آن‌سو",
   "start": 416.23,
   "end": 493.09
  },
  {
   "index": 5,
   "title": "## شهادت امام عسکری؛ فرزند به بالین پدر",
   "start": 493.09,
   "end": 620.09
  },
  {
   "index": 6,
   "title": "## تشییع و تدفین؛ اشک و نظر امام عصر",
   "start": 620.09,
   "end": 827.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 2.96,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.96,
   "end": 6.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.88,
   "end": 12.4,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.4,
   "end": 16.02,
   "text": "روایت سوم باب اول کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.02,
   "end": 19.28,
   "text": "مرحوم مجلسی. عن محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.28,
   "end": 22.64,
   "text": "بن سکیت. محمد بن سکیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.64,
   "end": 26.88,
   "text": "روایت میکنه که قال میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.88,
   "end": 32.68,
   "text": "ایشون گفت که سئل ابو عبدالله سؤال شده از امام صادق صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.68,
   "end": 37.9,
   "text": "عن رجل یقول استعثر الله بفلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.9,
   "end": 40.88,
   "text": "اینکه گفته بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.88,
   "end": 43.6,
   "text": "یه کسی که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.6,
   "end": 45.68,
   "text": "مرد از دنیا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.68,
   "end": 49.5,
   "text": "بگیم استعثر الله بفلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.5,
   "end": 52.86,
   "text": "فلانی رو خدا برش داشت برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.86,
   "end": 55.66,
   "text": "این بعضاً مصطلحه بین ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.66,
   "end": 58.0,
   "text": "یکی از دنیا میره میگن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.0,
   "end": 60.36,
   "text": "مثلاً اون رو برای خودش برگزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.36,
   "end": 61.98,
   "text": "اونو خدا برای خودش برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 61.98,
   "end": 64.56,
   "text": "خدا بردش پیش خودش. از اینجور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 64.56,
   "end": 66.64,
   "text": "چیزها الفاظی که بین ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 66.64,
   "end": 70.02,
   "text": "خدا خواستش. خدا برای خودش برش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 70.02,
   "end": 72.32,
   "text": "انتخابش کرد از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 72.32,
   "end": 76.18,
   "text": "آیا این حرف درسته در خصوص موت کسی بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 76.18,
   "end": 79.18,
   "text": "حضرت فرمودند فقال وا مكروه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 79.18,
   "end": 82.58,
   "text": "این زشته، این حرف اشتباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 82.58,
   "end": 87.36,
   "text": "فقيل فلان يجود بنفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 87.36,
   "end": 91.38,
   "text": "خب اگه بعد پرسید که حالا اگر بگیم که فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 91.38,
   "end": 94.02,
   "text": "يجود بنفسه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 94.02,
   "end": 96.68,
   "text": "جواد گونه يجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 96.68,
   "end": 101.18,
   "text": "یعنی بخشید جانش رو خودش جانش رو بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 101.18,
   "end": 105.04,
   "text": "این درسته؟ بگیم یعنی آمادگی رو پیدا کرد و بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 105.04,
   "end": 106.68,
   "text": "خ-فلانی خودش جون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 106.68,
   "end": 110.68,
   "text": "خودش جونش رو داد، بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 110.68,
   "end": 113.22,
   "text": "ببینیم درسته یا نه. فقال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 113.22,
   "end": 115.34,
   "text": "لا بأس. نه اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 115.34,
   "end": 117.68,
   "text": "حضرت فرمود این اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 117.68,
   "end": 122.86,
   "text": "بعد توضیح حضرت. اما تراه آیا ندیدی که يفتح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 122.86,
   "end": 126.68,
   "text": "این، این حالت برای همه ما پیش خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 126.68,
   "end": 133.52,
   "text": "ان‌شاءالله با عاقبت بخیری. يفتح فاه عند موته مرتين أو ثلاثًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 133.52,
   "end": 137.58,
   "text": "آیا ندیدی که وقتی شخص داره جون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 137.58,
   "end": 142.72,
   "text": "این دهانش رو دو بار یا سه بار باز و بسته میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 142.72,
   "end": 148.68,
   "text": "ناخودآگاه. فذلك حين يجود بها لما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 148.68,
   "end": 151.2,
   "text": "يري من ثواب الله عز وجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 151.2,
   "end": 154.8,
   "text": "این مال اون لحظه‌ایه که شخص داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 154.8,
   "end": 156.4,
   "text": "ثواب الهی رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 156.4,
   "end": 160.32,
   "text": "انگار که مثلاً بگیم دهانش باز میمونه از این عظمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 160.32,
   "end": 162.54,
   "text": "یه چیزایی رو داره میبینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 162.54,
   "end": 164.86,
   "text": "کأنَّ دهانش باز میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 164.86,
   "end": 169.58,
   "text": "تو بین ما این مصطلحه. میگه اه یه چیزی دیدم دهون، دهنم وا موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 169.58,
   "end": 175.62,
   "text": "ها؟ یه چیزایی نشون میدن به میت که دهانش هی باز و بسته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 175.62,
   "end": 177.9,
   "text": "عجب! حالا اینها تعویل باید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 177.9,
   "end": 181.72,
   "text": "من الآن امروز هم فرصت نداریم. خیلی هم قصد تفس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 181.72,
   "end": 184.72,
   "text": "از به تفصیل صحبت کردن نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 184.72,
   "end": 187.28,
   "text": "روز شهادت امام عسکری صلوات الله علیه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 187.28,
   "end": 190.5,
   "text": "میخوایم یه اتصال کوتاهی هم داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 190.5,
   "end": 194.02,
   "text": "اینا باید تعویل بشه. حالا میگذریم ازش که یعنی چی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 194.02,
   "end": 198.16,
   "text": "دهان باز و بسته میشه، دیدن ثواب به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 198.16,
   "end": 201.58,
   "text": "یا چرا نمیتونیم بگیم کسی رو خدا انتخاب کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 201.58,
   "end": 203.18,
   "text": "چون خدا انتخاب کرد نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 203.18,
   "end": 205.0,
   "text": "خدا اونو برای خودش برداشت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 205.0,
   "end": 208.28,
   "text": "مگه خدا انفعال داره؟ همه چی مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 208.28,
   "end": 211.7,
   "text": "له ملك السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 211.7,
   "end": 214.8,
   "text": "لمن اليوم؟ لمن الملك اليوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 214.8,
   "end": 217.14,
   "text": "امروز ملک مال کیه؟ خود خدا جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 217.14,
   "end": 219.24,
   "text": "لله الواحد القهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 219.24,
   "end": 225.98,
   "text": "که این واحدیت کنار قهاریت که وقتی میاد مرتبه احدیت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 225.98,
   "end": 230.68,
   "text": "فرق احدیت و واحدیت رو قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 230.68,
   "end": 235.12,
   "text": "این یعنی دیگه اصلاً هرچی که هست خداست و ظهور حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 235.12,
   "end": 237.9,
   "text": "اصلاً عالم اطوار وجودی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 237.9,
   "end": 241.44,
   "text": "ظهور حقه. شما هر کدومتون یک شأن و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 241.44,
   "end": 246.8,
   "text": "ظهوری از حضرت حق هستید که دائماً خدا دلش از شما تجلی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 246.8,
   "end": 252.94,
   "text": "چیزی جدای از حق نیست. اینو ببینید یه نکته‌ای عرض کردم که الصاق بشه به مباحث قبلیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 252.94,
   "end": 256.84,
   "text": "چرا ما نمی‌تونیم بگیم کسی رو خدا انتخاب کرد، انتخاب کرد نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 256.84,
   "end": 259.54,
   "text": "برداشت برای خودش نداره. همه چی اصلاً خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 259.54,
   "end": 263.84,
   "text": "ظهور خداست. برای اوست، مال اوست، از اوست، به اوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 263.84,
   "end": 272.08,
   "text": "در اوست. و اینکه دهان چرا باز و بسته میشه دیروز حالا یه نکته‌ای عرض کردیم که مخصوصاً اهل ایمان وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 272.08,
   "end": 274.56,
   "text": "مرگ بالاخره خدا راضیشون میکنه میبرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 274.56,
   "end": 280.14,
   "text": "این دهانی که باز میشه حالا از یه جهت هم میشه اینچه-اینچنین ف-گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 280.14,
   "end": 283.52,
   "text": "روایت هم داریم زیاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 283.52,
   "end": 286.68,
   "text": "وقتی که انسان میخواد جون بده روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 286.68,
   "end": 292.26,
   "text": "از ته شروع میشه وقتی حضرت قابض الارواح میاد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 292.26,
   "end": 297.48,
   "text": "نوک انگشتای پا شروع میکنه از شست پا شروع میکنه هی روح رو بیرون میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 297.48,
   "end": 302.46,
   "text": "البته روح تجزیه‌بردار نیست که یک حقیقت کلیه است برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 302.46,
   "end": 306.38,
   "text": "تقریب به ذهن به ضرب من البيان ما عرض میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 306.38,
   "end": 309.0,
   "text": "و الا یک حقیقت کلیه است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 309.0,
   "end": 314.5,
   "text": "اون قسمت‌هایی از بدن که خالی میشه از این حقیقت کلیه از پا شروع میشه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 314.5,
   "end": 316.86,
   "text": "آخرین جا میرسه به سر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 316.86,
   "end": 319.46,
   "text": "اینکه دهان باز میشه یعنی دیگه کأنَّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 319.46,
   "end": 324.02,
   "text": "تا گلوگاه تا زیر دهان دیگه بی روح شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 324.02,
   "end": 328.48,
   "text": "بعد اون لحظه سر فقط روح داره که بعد آخرین جا دیگه بینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 328.48,
   "end": 330.72,
   "text": "عجیبه که روح از بینی خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 330.72,
   "end": 336.12,
   "text": "حالا، حالا اینجا خیلی حرفا ما داریم خیلی صحبت‌ها داریم که بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 336.12,
   "end": 338.66,
   "text": "وقت مرگ، وقت خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 338.66,
   "end": 343.8,
   "text": "خیلیامون میبینی اتفاقاتی برای بینیمون و دهنمون، دهانمون میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 343.8,
   "end": 346.94,
   "text": "خرخر که میکنه یا از دهانه یا از بینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 346.94,
   "end": 350.56,
   "text": "که برای مؤمن مرگش فرمود مثل خرخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 350.56,
   "end": 353.58,
   "text": "یه خ اینطوری میکنه تموم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 353.58,
   "end": 355.56,
   "text": "ااا اینم حدیث داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 355.56,
   "end": 357.14,
   "text": "این‌ها تعویل باید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 357.14,
   "end": 359.44,
   "text": "یعنی چی این‌ها؟ برای چی این اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 359.44,
   "end": 362.75,
   "text": "خیلی حرفای گفتنی هست بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 362.75,
   "end": 368.85,
   "text": "و در هر حال این مهمه که اونچه که نشونش میدن بعضیا مراتب بهشتی رو نشونش میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 368.85,
   "end": 371.87,
   "text": "بعضیا رو پیغمبر عزّ عالم رو نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 371.87,
   "end": 376.83,
   "text": "\"مَن یَمُت یَلْقَنی\" هر کس بمیره میبینه منو، مولا علی رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 376.83,
   "end": 379.03,
   "text": "امام عصرش رو قطعاً هر کسی میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 379.03,
   "end": 381.79,
   "text": "حالا مؤمن باشه یا کافر فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 381.79,
   "end": 386.71,
   "text": "این دهان باز موندن یه وجهش دیدن وجه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 386.71,
   "end": 391.81,
   "text": "وجه خدا رو میبینن و چه جالب که حضرت اینچنین می‌فرمود \"وَقَدْ کانَ بها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 391.81,
   "end": 398.81,
   "text": "وَ نِینا\". قبل از این، قبل از اون لحظه‌ای که دهانش رو باز می‌کنه مدنون بود به موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 398.81,
   "end": 400.55,
   "text": "یعنی بدش میومد از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 400.55,
   "end": 405.95,
   "text": "دوست نداشت بمیره. الان که دهنش باز موند دوست داره با شوق بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 405.95,
   "end": 408.85,
   "text": "این واقعاً اون طرف غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 408.85,
   "end": 414.75,
   "text": "عجیبه. خـ این خیلی روایت عجیبیه بارها شنیدیم از این روایات به راحتی نگذریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 414.75,
   "end": 419.01,
   "text": "که خدا فرمود در جواهر الثنیه شیخ حر عاملیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 419.01,
   "end": 425.09,
   "text": "فرمود که خداوند رحمتش رو صد قسمت کرده یک قسمتش در قالب رحمت این دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 425.09,
   "end": 431.07,
   "text": "که حتی جاذبه بین قطبت، قطب‌های قطبین مثبت و منفی از همین رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.07,
   "end": 434.01,
   "text": "حتی حیوانات به هم علاقه‌مند می‌شن از همین رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 434.01,
   "end": 439.47,
   "text": "رح، این علاقه بین زن و شوهر، پدر و فرزند، مادر و-- اصلاً رفیق به فقر رفیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 439.47,
   "end": 446.51,
   "text": "اینا همه جذب جذب عالم همین نظام جاذبه عالم همه شقوق این رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.51,
   "end": 448.63,
   "text": "غوغاست. بعد حالا این یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.63,
   "end": 452.35,
   "text": "قسمت از رحمت خداست نود و نه تاشو گذاشته اون ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 452.35,
   "end": 454.79,
   "text": "می‌خواد چه کنه که لحظه‌ی مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.79,
   "end": 456.45,
   "text": "دهان طرف باز می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 456.45,
   "end": 461.49,
   "text": "عجیبه. حالا این یه وجه یه قصه‌ایه خودش که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.49,
   "end": 465.11,
   "text": "بعد برای همین میان شؤون تعیین می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 465.11,
   "end": 470.49,
   "text": "شرع دین حتی ما بر اساس اینکه خیلی خوبه فرزند بیاد کنار پسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 470.49,
   "end": 474.77,
   "text": "پ-پدر. فرزند خیلی توصیه شده فرزند بیاد کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 474.77,
   "end": 478.81,
   "text": "پدر یا مادر. فرزند باشه، نزدیکان باشن حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 478.81,
   "end": 481.63,
   "text": "وقتی از دنیا رفت میگن اون جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 481.63,
   "end": 486.99,
   "text": "بیشتر پدر یا مادر حاضر بوده فرزند بره اونجا بشینه و اونجا براش نماز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 486.99,
   "end": 489.33,
   "text": "اینا عجیبه حرف‌هایی درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 489.33,
   "end": 493.73,
   "text": "بزرگان رمزگشایی‌هایی کردن که حالا حوصله‌ش باید باشه و چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 493.73,
   "end": 500.33,
   "text": "عجیب که امشب هم که شهادت، شهادت امام عسکری، پدر امام عصر ماست همین اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.33,
   "end": 504.85,
   "text": "برای همه اهل بیت شما دقت کنی پسر آمد به بالین پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.85,
   "end": 508.01,
   "text": "امام عصر ما تشریف آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 508.01,
   "end": 511.77,
   "text": "و سر مبارک پدرشون رو به آغوش گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 511.77,
   "end": 514.87,
   "text": "عجیبه دیدن پدر تشنه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 514.87,
   "end": 523.63,
   "text": "و رفتن یه دمنوشی به قول ما مستکی دمنوشی روایت میگه تهیه کردن که کام پدر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.63,
   "end": 525.91,
   "text": "بردارن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.91,
   "end": 528.83,
   "text": "پدر با عطش از دنیا نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.83,
   "end": 533.81,
   "text": "حالا چه سریه فرمودن این رو دستورات هست که میت اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.81,
   "end": 537.21,
   "text": "تشنه شه حتما آب بهش برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.21,
   "end": 541.05,
   "text": "آقا سر امام عسکری رو به آغوش گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 541.05,
   "end": 544.01,
   "text": "خودش با دست مبارک این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 544.01,
   "end": 547.77,
   "text": "حالا بگیم لیوان و جام رو هرچی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.77,
   "end": 550.65,
   "text": "نزدیک آورد به دهان پدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 550.65,
   "end": 553.11,
   "text": "تلاش کرد که پدر کامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 553.11,
   "end": 561.01,
   "text": "عطشان نمونه. میگن انقدر حضرت حالش نزار بود دندان‌های حضرت اصابت می‌کرد به این لیوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.01,
   "end": 562.83,
   "text": "و صدا بلند می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 562.83,
   "end": 567.69,
   "text": "ولی سعی‌شو کرد امام عصر که پدر رو سیراب کنه اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 567.69,
   "end": 569.87,
   "text": "یکی دو جرعه ظاهراً بیشتر نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 569.87,
   "end": 573.81,
   "text": "بعد شروع کردن دو تایی با هم گریه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.81,
   "end": 577.61,
   "text": ". به نظر شما این گریه آخر برای چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.61,
   "end": 580.85,
   "text": "میشه خودشون توصیه کنن \"شیعتی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.85,
   "end": 584.45,
   "text": "شربت ماء عذبی فاذکرونی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 584.45,
   "end": 588.83,
   "text": "شیعه ما هر وقت آب گوارا خوند، خوردید یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 588.83,
   "end": 591.01,
   "text": "عطش من و حسین باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.01,
   "end": 593.75,
   "text": "بعد خودشون این رو انجام ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 593.75,
   "end": 602.37,
   "text": "قطعاً دو تایی اون لحظه با هم شروع کردن زیر لب \"السلام علـ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 602.37,
   "end": 608.69,
   "text": "السلام علی من السلام علی ساكن كربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 608.69,
   "end": 612.77,
   "text": "السلام علی من بكتہ ملائكت السماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 612.77,
   "end": 618.27,
   "text": "با هم گریه کردن بعد آقا رو چقدر قشنگ تشییع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 618.27,
   "end": 622.25,
   "text": "کفن خیلی خوب و قیمتی آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.25,
   "end": 631.61,
   "text": "شیعیان جمع شدن اگرچه در محاصره بودن اما تشییع قشنگی بالاخره آقا برش نماز خوند امام عصر پنج ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 631.61,
   "end": 635.93,
   "text": "کفن کردن، غسل دادن، تدفین کردن با عظمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.93,
   "end": 642.07,
   "text": "\"السلام علی من دفله اهل القری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.07,
   "end": 645.87,
   "text": "\". سلام بر اون آقایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 645.87,
   "end": 652.05,
   "text": "انقدر غریب بود مردم دهات اومدن بدنش رو برداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.05,
   "end": 658.01,
   "text": ". \"السلام علی مقطع الاعضاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 658.01,
   "end": 663.81,
   "text": "السلام علی الرأس المرفوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.81,
   "end": 668.05,
   "text": ". یا أبا محمد. یا حسن بن علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.05,
   "end": 674.57,
   "text": "ای جا-- ای جا زکی ال عسکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 674.57,
   "end": 677.21,
   "text": "ابن رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 677.21,
   "end": 679.33,
   "text": "یا حجة الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.33,
   "end": 681.97,
   "text": "علی الخلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 681.97,
   "end": 686.37,
   "text": "یا سیدنا و مولانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.37,
   "end": 693.87,
   "text": "انا توجهنا و استشفعنا و توسط الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 693.87,
   "end": 699.89,
   "text": "کرم الله و قدمنا کبدنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.89,
   "end": 702.11,
   "text": "فاجعلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 702.11,
   "end": 705.37,
   "text": "یا وجیها عند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 705.37,
   "end": 710.51,
   "text": "الله اشفع لنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 710.51,
   "end": 714.07,
   "text": "عند\". این اشکی که یکباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 714.07,
   "end": 716.33,
   "text": "تو شادون جر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.33,
   "end": 720.77,
   "text": "هدیه کنید مدرد راه پسرش مهدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.77,
   "end": 727.47,
   "text": "خدا رحمت کنه آیه بن جزمی می‌فرمود هر وقت ناخودآگاه اشکت جاری شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 727.47,
   "end": 730.79,
   "text": "بدون امام زمانت یادت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 730.79,
   "end": 732.69,
   "text": "نگاحت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 732.69,
   "end": 734.75,
   "text": "توجه بت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 734.75,
   "end": 740.29,
   "text": "نمی‌شکنه دل. مگر اینکه امام عصر توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 740.29,
   "end": 742.99,
   "text": "دست آقا رو تو ببوس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.99,
   "end": 744.99,
   "text": "حالا که حالت خوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 744.99,
   "end": 750.47,
   "text": "بگو سلام ما هم تحویل کنیم به یاد اربعین حسین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 750.47,
   "end": 753.23,
   "text": "هر any قشنگتر عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 753.23,
   "end": 761.05,
   "text": "\"السلام علیک، السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.05,
   "end": 764.85,
   "text": "أبا عبد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.85,
   "end": 768.43,
   "text": "و علی روحک التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 768.43,
   "end": 771.97,
   "text": "هللت بها الفناء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 771.97,
   "end": 776.01,
   "text": "یادم تن تن. \"عليك مني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.01,
   "end": 778.73,
   "text": "سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.73,
   "end": 782.55,
   "text": "أبدا ما بقيته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 782.55,
   "end": 786.35,
   "text": "و بقي الليل والنهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 786.35,
   "end": 789.61,
   "text": "ولا جعلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.61,
   "end": 799.59,
   "text": "آخر العهد من لزيارتك شفعنا يوم القيامة بين الزاني و الزني و بي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 799.59,
   "end": 802.47,
   "text": "السلام على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 802.47,
   "end": 808.03,
   "text": "الحسين و على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 808.03,
   "end": 812.07,
   "text": "علي ابن الحسين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 812.07,
   "end": 815.53,
   "text": "و على اولاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 815.53,
   "end": 818.71,
   "text": "الحسين و على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 818.71,
   "end": 821.27,
   "text": "اصحاب الحسين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 821.27,
   "end": 823.59,
   "text": "سه sid شهدا یاران شهیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 823.59,
   "end": 827.31,
   "text": "سه تا برای امام عصرون برای سلامتی آقامون صلوات بفرست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}