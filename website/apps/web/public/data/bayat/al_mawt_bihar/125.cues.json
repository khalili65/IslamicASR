   "title": "## بازگشت به شک روایت دهم",
   "start": 754.11,
   "end": 780.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 5.42,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.42,
   "end": 9.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.64,
   "end": 14.34,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.34,
   "end": 16.98,
   "text": "تبریک عرض می‌کنم شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.98,
   "end": 19.74,
   "text": "دهه‌ی مبارک فجر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.74,
   "end": 25.58,
   "text": "ان شا الله که بازخوانی این ایام البته به شرط طبیعی و درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.58,
   "end": 29.2,
   "text": "برای هممون مبارک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.2,
   "end": 35.5,
   "text": "اگر کسی در نماز جماعت اقتدا کنه به امام جماعت در رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.5,
   "end": 41.18,
   "text": "به ی-- گمان اینکه یقین داره می‌رسه به رکوع امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.18,
   "end": 47.72,
   "text": "که اگه یقین نداره که می‌رسه حق نداره اقتدا کنه به رکوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.72,
   "end": 50.12,
   "text": "حالا یقین کرد که به رکوع می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.12,
   "end": 53.8,
   "text": "امام تو رکوع بود، ایشون اومد اقتدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.8,
   "end": 58.16,
   "text": "الله اکبر رو گفت، دو تا حالت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.16,
   "end": 61.96,
   "text": "اگر چنانچه به حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.96,
   "end": 64.66,
   "text": "رکوع خم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.66,
   "end": 67.1,
   "text": "بعد امام بلند شد، ایشون نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.1,
   "end": 72.1,
   "text": "یعنی تا حدی رفت پایین که دیگه مثلاً کسی نگاه کرد گویی دیگه رفت به رکوع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.1,
   "end": 76.94,
   "text": "منتها هنوز دستش به زانو نرسیده، رکوع رو درک نکرده، امام بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.94,
   "end": 82.28,
   "text": "ایشون متوجه شد که رکوع امام رو درک نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.28,
   "end": 85.86,
   "text": "اینجا تکلیفش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.86,
   "end": 88.52,
   "text": "همین امروز اتفاقا من برای اطمینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.52,
   "end": 93.18,
   "text": "چون بالاخره فراره آدم یه دفعه یادش میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.18,
   "end": 95.78,
   "text": "زنگ زدم گاهی اوقات که یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.78,
   "end": 98.18,
   "text": "مغبر میشه فضا تو ذهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.18,
   "end": 102.18,
   "text": "در خصوص احکام مخصوصاً زنگ می‌زنم، استفتاء می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.18,
   "end": 111.04,
   "text": "مطمئن میشم. استفتاء کردم از دفتر آقا فرمودن که اگر چنین حالتی پیش بیاد نماز فراداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.04,
   "end": 112.96,
   "text": "اون یک رکعت هم حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.96,
   "end": 118.32,
   "text": "یعنی هم که رفتی و درک نکردی رکوع اما رفتی به رکوع امام پا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.32,
   "end": 121.06,
   "text": "اون یک رکعت حساب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.06,
   "end": 123.52,
   "text": "ولی دیگه نمازت فراداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.52,
   "end": 129.54,
   "text": "اما اگر قبل از اینکه بری خم بشی به حالت رکوع برسی، امام پا شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.54,
   "end": 133.68,
   "text": "الله اکبر رو گفتی یقین داشتی که به رکوع می‌رسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.68,
   "end": 136.3,
   "text": "تا الله اکبر گفتی امام پا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.3,
   "end": 138.74,
   "text": "اینجا تکلیف چیه؟ دو تا راه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.74,
   "end": 142.42,
   "text": "یا می‌تونی نیت فرادا کنی نمازو ادامه بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.42,
   "end": 144.16,
   "text": "که رکعت اولت حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.16,
   "end": 147.06,
   "text": "یعنی باید با حمد و سوره شروع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.06,
   "end": 151.6,
   "text": "می‌تونی نیت، می‌تونی صبر کنی تا امام به رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.6,
   "end": 157.62,
   "text": "رکعت بعدیش برسه. به رکعت بعدیش که رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.62,
   "end": 161.66,
   "text": "شما به جماعت با امام ادامه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.66,
   "end": 164.38,
   "text": "حالا اگر امام رکعت آخرش بود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.38,
   "end": 167.86,
   "text": "هیچی دیگه. هیچ چاره‌ای نیست جز اینکه نیت فرادا کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.86,
   "end": 173.12,
   "text": "نمازو ادامه بدی. بحث چهارشنبه‌های ما بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.12,
   "end": 178.18,
   "text": "موت بود. شرح کتاب الموت مرحوم مجلسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.18,
   "end": 181.42,
   "text": "رسیده بودیم به روایت دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.42,
   "end": 184.44,
   "text": "از باب چهارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.44,
   "end": 190.78,
   "text": "این یقینی‌ست که هیچ شکی درش نیست قصه موت در صورتی که مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.78,
   "end": 197.22,
   "text": "نسبت به این طوری رفتار می‌کنند انگار که شکیه که هیچ یقینی درش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.22,
   "end": 200.66,
   "text": "به موت. بعد رفتیم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.66,
   "end": 205.32,
   "text": "اینکه این شک تا کجاها به دنبال انسان در هنگام موت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.32,
   "end": 207.0,
   "text": "رسیدیم به مراحل موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.0,
   "end": 210.28,
   "text": "گفتیم موت به یکباره اتفاق نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.28,
   "end": 213.6,
   "text": "مراحل داره. مرحله اول رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.6,
   "end": 217.6,
   "text": "امروز اجمالاً مرحله، مرحله‌ی دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.6,
   "end": 220.68,
   "text": "شروع مرگ رو عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.68,
   "end": 224.08,
   "text": "مرحله نزع روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.08,
   "end": 227.26,
   "text": "از انگشت پاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.26,
   "end": 232.42,
   "text": "یعنی شروع، شروع نزع روح که بهش میگن جان کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.42,
   "end": 234.7,
   "text": "جان رو، روح رو میخوان بگیرن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.7,
   "end": 240.7,
   "text": "اعضا، از جوارح. از کف پا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.7,
   "end": 244.72,
   "text": "نوک انگشت‌ها و کف پا شروع می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.72,
   "end": 247.3,
   "text": "حضرت، حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.3,
   "end": 251.3,
   "text": "علیه السلام شروع می‌کنه به قدرت الهیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.3,
   "end": 255.16,
   "text": "روح رو بیرون کشیدن. منتها جالبه که بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.16,
   "end": 261.72,
   "text": "توی این مرحله هم یعنی تو مرحله دوم هم انسان خبر نداره که داره جان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.72,
   "end": 266.62,
   "text": "الا اوحدی از اولیاء الله که قبل از موتشون هم می‌دونن اونو که کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.62,
   "end": 272.48,
   "text": "ولی این تو این لحظه هم این مرحله هم طرف خبر نداره داره جان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.48,
   "end": 278.36,
   "text": "که همینجوری خورد خورد شروع می‌کنه روح رو قابض الارواح از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.36,
   "end": 284.64,
   "text": "نوک انگشت و کف پا می‌کشه بیرون از ساق پا بیرون میاره زانوها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.64,
   "end": 289.0,
   "text": "از هر کدوم که روح رو بیارون-- بیرون میاره اون قسمت دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.0,
   "end": 292.66,
   "text": "از کار میفته. یعنی اصطلاحاً می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.66,
   "end": 296.72,
   "text": "سر شد، بی‌حس شد. دیگه هیچ حرکتی نمی‌تونی بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.72,
   "end": 300.72,
   "text": "میاد تا ناف انسان و شکم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.72,
   "end": 302.56,
   "text": "همینجوری سینه و میاد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.56,
   "end": 304.7,
   "text": "دیگه همه اینا از کار می‌افتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.7,
   "end": 308.3,
   "text": "بی‌حس می‌شن. باز میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.3,
   "end": 314.84,
   "text": "خبر نداره. شخص که داره جان میده اینجا حتی تا اینجام خبر نداره که باز داره جان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.84,
   "end": 317.8,
   "text": "یه علائمی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.8,
   "end": 319.8,
   "text": "فرمودن مثل افت فشار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.8,
   "end": 322.38,
   "text": "آدم فکر می‌کنه فشارش افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.38,
   "end": 324.08,
   "text": "قوای وجودیش تحلیل رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.08,
   "end": 326.8,
   "text": "یه دفعه ضعف مف-- مفرط می‌گیرتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.8,
   "end": 329.78,
   "text": "سرگیجه بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.78,
   "end": 334.66,
   "text": "یه همچین حالتی و مثلاً اگر ایستاده باشه میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.66,
   "end": 338.34,
   "text": "نمی‌تونه وایسته رو پاش. میفته نه یعنی مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.34,
   "end": 342.5,
   "text": "نه، هنوز مراحل ادامه داره که گفتیم شش مرحله‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.5,
   "end": 349.44,
   "text": "تا کلاً جان کنده بشه. اما هنوز خبر نداره که داره جان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.44,
   "end": 353.06,
   "text": "کی متوجه می‌شه؟ تو مرحله سوم که دیگه بهش میگن مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.06,
   "end": 355.8,
   "text": "طراقی. تا قبل از مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.8,
   "end": 361.62,
   "text": "طراقی رو که تو قرآن هم اومده که الان داریم ما توضیح میدیم متوجه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.62,
   "end": 364.52,
   "text": "فکر می‌کنه حالش بده. فکر می‌کنه مثلاً یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.52,
   "end": 366.84,
   "text": "خستگی شدیدی بهش ع-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.84,
   "end": 374.23,
   "text": "عارض شده و این‌ها حتی چون دهانش هنوز کار می‌کنه، روح از دهانش که بیرون نیومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.23,
   "end": 375.95,
   "text": "می‌تونه حرف بزنه تو این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.95,
   "end": 379.63,
   "text": "د-دست و پاش از کار افتاده اما هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.63,
   "end": 383.67,
   "text": "دهانش کار می‌کنه. حتی می‌تونه بگه که آقا مثلا افتاده نمی‌تونه حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.67,
   "end": 385.45,
   "text": "می‌تونه بگه یه لیوان آب برام بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.45,
   "end": 390.77,
   "text": "نمی‌دونم یه زیرزبونی برام بیارید، تسبیح دو شهده بده، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.77,
   "end": 392.83,
   "text": "حرف می‌زنه حتی ولی کارش تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.83,
   "end": 397.37,
   "text": "باز بی‌خبره. که در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.37,
   "end": 402.43,
   "text": "جالبه که بدونیم در surه قیامت این مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.43,
   "end": 406.65,
   "text": "از آیه بیست و شش وقتی به همین اشاره می‌کنه که \"کلا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.65,
   "end": 409.41,
   "text": "این چنین نیست. که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.41,
   "end": 412.37,
   "text": "که اون می‌پنداره، اون شخص می‌پنداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.37,
   "end": 414.83,
   "text": "\"إذا بلغت التراقي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.83,
   "end": 418.65,
   "text": "اینجا ببینید این مرحله سوم شروع مرحله سومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.65,
   "end": 423.55,
   "text": "\"إذا بلغت التراقي\" هنگامی که جان به گلوگاه برسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.55,
   "end": 425.91,
   "text": "قبل از این مرحله، این مرحله دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.91,
   "end": 428.43,
   "text": "قبل از اینکه برسه به گلوگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.43,
   "end": 432.15,
   "text": "یعنی برسه به جایی که دیگه طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.15,
   "end": 434.97,
   "text": "دهانش از کار می‌افته. یعنی دیگه نمی‌تونه صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.97,
   "end": 438.65,
   "text": "اون مرحله سومه. مرحله دوم هنوز به اینجا نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.65,
   "end": 444.67,
   "text": "حالا ادامه داره آیات که آیه بیست و هفت فرمود \"وقيل من راق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.67,
   "end": 449.57,
   "text": "اون شخص حالا بیمار که تو این حالت قرار گرفته \"من راق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.57,
   "end": 451.83,
   "text": "میگه کیه که درمان کنه منو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.83,
   "end": 454.13,
   "text": "بیمار، بیمار رو درمان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.13,
   "end": 458.47,
   "text": "\"و ظن\" آیه بعد \"و ظن أنه الفراق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.47,
   "end": 462.97,
   "text": "گمان می‌کنه یا مثلا یقین می‌کنه \"أنه الفراق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.97,
   "end": 465.99,
   "text": "می‌فهمه که یه خبریه. مثل اینکه وقت جدایی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.99,
   "end": 469.11,
   "text": "دیگه کی اینو میگه؟ \"أنه الفراق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.11,
   "end": 473.27,
   "text": "از تراقی به بعد. یعنی نفس دیگه از گلو دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.27,
   "end": 475.21,
   "text": "بیرون نمیاد. یعنی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.21,
   "end": 478.07,
   "text": "دیگه نمی‌تونه صحبت کنه. اونجا می‌فهمه، یقین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.07,
   "end": 481.27,
   "text": "اون مرحله سومه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.27,
   "end": 485.71,
   "text": "قرآن فرمود \"والتفت الساق بساق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.71,
   "end": 489.35,
   "text": "این آیه بعده، آیه بیست و نه. این ساق‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.35,
   "end": 491.81,
   "text": "التفات که میگی، التفات داری آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.81,
   "end": 493.97,
   "text": "یعنی حواست به من هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.97,
   "end": 496.43,
   "text": "این پاها چنان حواسشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.43,
   "end": 503.23,
   "text": "میره که دیگه \"والتفت الساق\" و این ساق بساق، می‌چسبن به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.23,
   "end": 507.95,
   "text": "دیگه تکون نمی‌خورن. دیگه روح از پاها خارج شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.95,
   "end": 511.31,
   "text": "تکون نمی‌خورن. که حالا این تراقی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.31,
   "end": 513.25,
   "text": "جمع رقیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.25,
   "end": 515.63,
   "text": "رقیه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.63,
   "end": 517.87,
   "text": "بالا رفتن و بالا بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 517.87,
   "end": 522.43,
   "text": "تفسیر نور آقای قرائتی رو دقت کنید، اینو همونجا اینو توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.43,
   "end": 528.13,
   "text": "که چون نفس توی گلو بالا پایین میره و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.13,
   "end": 531.17,
   "text": "بهش میگن استخوان ترقوه شنیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.17,
   "end": 538.29,
   "text": "یا بین پایین حلق، پایین حلق گلوئه یا گردنه بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 538.29,
   "end": 541.33,
   "text": "پایین حلق انسان پایین دهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 541.33,
   "end": 546.15,
   "text": "گلوئه. این دو طرف گلو یه دو تا استخوان کشیده شده تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.15,
   "end": 548.97,
   "text": "طرفین شانه‌ها، تا کتف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.97,
   "end": 551.79,
   "text": "اینا رو بهش میگن استخوان ترقوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.79,
   "end": 557.05,
   "text": "یعنی این مرحله‌ست که دیگه از اینکه زد بالا دیگه مرحله سومه که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 557.05,
   "end": 559.37,
   "text": "روح داره از دهان خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.37,
   "end": 565.39,
   "text": "اون مرحله تراقیه. که دقت کنید چه شیرو-- چقدر با ظرافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 565.39,
   "end": 569.41,
   "text": "همین رو آیه داره می‌گه. که حالا اونجا آقای قرائتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.41,
   "end": 573.89,
   "text": "ادامه میده بحث عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 573.89,
   "end": 576.33,
   "text": "ریشه‌یابی کلمه رو. راغن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 576.33,
   "end": 578.51,
   "text": "که از در اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 578.51,
   "end": 582.87,
   "text": "از می‌شه گفت راغی‌ست اسم فاعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 582.87,
   "end": 586.55,
   "text": "رقیه. می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 586.55,
   "end": 591.55,
   "text": "به اوراد و اذکاری که موجب شفای مریض بشه می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 591.55,
   "end": 594.41,
   "text": "و مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 594.41,
   "end": 596.71,
   "text": "رقیه که می‌گن، رقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 596.71,
   "end": 600.01,
   "text": "بعضیا رق-رقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.01,
   "end": 604.75,
   "text": "یا رق-رق-رقیه من دیدم تلفظ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.75,
   "end": 607.11,
   "text": "رقیه، رقیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.11,
   "end": 610.81,
   "text": "رقیه. همه اینا رو تلفظ دیدم می‌کنن تو محاوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.81,
   "end": 613.85,
   "text": "این همون چیزی‌ست که موجب شفا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 613.85,
   "end": 618.91,
   "text": "مثلا حضرت رقیه از این جهت بهش می‌گن رقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 618.91,
   "end": 625.55,
   "text": "که یا اون نامه‌هایی که تو جمع کران تو چاه قدیم مینداختن بهش می‌گفتن رقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.55,
   "end": 629.35,
   "text": "یا رقیه. یعنی چون موجب شفا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.35,
   "end": 633.41,
   "text": "در هر حال، ااا اونجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 633.41,
   "end": 637.85,
   "text": "شخص میگه که \"وقيل\". میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.85,
   "end": 641.27,
   "text": "\"من راق\". کیه که منو شفا بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 641.27,
   "end": 644.91,
   "text": "من بیمار رو. شفا دهنده کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 644.91,
   "end": 648.61,
   "text": "که از من میگه من رقیه، رقیه کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.61,
   "end": 650.73,
   "text": "این تو اون حالته که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 650.73,
   "end": 654.23,
   "text": "از اینجا هنوز هم متوجه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.23,
   "end": 657.43,
   "text": "به محض اینکه روح از اینجا کشید بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 657.43,
   "end": 659.83,
   "text": "دیگه از به حالت تراقی رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 659.83,
   "end": 664.11,
   "text": "یعنی از این استخوان دیگه گذر کرد رفت خورد به گلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 664.11,
   "end": 666.99,
   "text": "دیگه روح رو می‌خوان از اون مرحله به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.99,
   "end": 670.01,
   "text": "که مرحله سومه انشاالله جلسه بعد عرض می‌کنیم بکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 670.01,
   "end": 673.27,
   "text": "اونجا دیگه متوجه می‌شه چون دیگه نمی‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 673.27,
   "end": 675.87,
   "text": "هنوز می‌بینه‌ها، می‌بویه، می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 675.87,
   "end": 678.53,
   "text": "اما حرف دیگه زبانش بند میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 678.53,
   "end": 682.09,
   "text": "اصطلاحا می‌گن زبانش بند میاد میت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 682.09,
   "end": 685.27,
   "text": "که اونجا تازه می‌فهمه. بعد م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.27,
   "end": 688.29,
   "text": "زبان حال اشیا رو متوجه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 688.29,
   "end": 691.13,
   "text": "باطن اشیا خیلی عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 691.13,
   "end": 694.97,
   "text": "اون سکره یا بیهوشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 694.97,
   "end": 697.47,
   "text": "سکران که قبلاً درباره‌ش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.47,
   "end": 701.43,
   "text": "سکرات موت، باطن اشیا رو متوجه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 701.43,
   "end": 703.71,
   "text": "مثلا روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 703.71,
   "end": 709.59,
   "text": "اونجا مال بهش میگه من دیگه در دسترس تو نیستم، از دسترس تو خارج شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 709.59,
   "end": 712.23,
   "text": "اینو دیگران نمی‌فهمن که، اون می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 712.23,
   "end": 715.49,
   "text": "اون قشنگ اینو می‌فهمه که مالش داره اینو بهش میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 715.49,
   "end": 718.23,
   "text": "حتی فرزندانش بهش میگن این روایته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 718.23,
   "end": 721.03,
   "text": "تا دم، تا، تا دم قبر باهاتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 721.03,
   "end": 725.33,
   "text": "همین. دیگه تا دم قبر همراهت می‌کنیم و دیگه نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 725.33,
   "end": 728.43,
   "text": "چه غمی می‌گیره دل میت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 728.43,
   "end": 733.57,
   "text": "و عملش چی؟ اعمالش میگن ما تا خیالت راحت تا ابد با تواییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 733.57,
   "end": 736.21,
   "text": "الله اکبر. اعمال ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.21,
   "end": 739.73,
   "text": "اون علم و عمل که به قول علامه حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 739.73,
   "end": 742.09,
   "text": "جوهرند و انسان‌ساز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 742.09,
   "end": 745.53,
   "text": "این دیگه ما رو ساختن دیگه که تا وجودی ما با اون‌ها رقم خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 745.53,
   "end": 747.45,
   "text": "دیگه تا ابد با ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 747.45,
   "end": 751.39,
   "text": "خلاصه پناه می‌بریم به حضرات حق از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 751.39,
   "end": 755.73,
   "text": "لحظات که عجیبه چون بحث شک بود در روایت دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 755.73,
   "end": 759.37,
   "text": "تو این حالات هم انسان باز حالت شک داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 759.37,
   "end": 761.33,
   "text": "هنوز باور نداره که می‌خواد بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 761.33,
   "end": 766.07,
   "text": "فکر می‌کنه یه مریضیه، یه افت فشاریه، یه سرگیجه‌ایه و رفع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 766.07,
   "end": 768.57,
   "text": "خبر نداره که نه آخه کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 768.57,
   "end": 773.83,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 773.83,
   "end": 780.41,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}