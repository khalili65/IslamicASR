 "chapters": [
  {
   "index": 0,
   "title": "## رضایت اهل ایمان هنگام موت و تجلیات",
   "start": 7.14,
   "end": 126.74
  },
  {
   "index": 1,
   "title": "تجلیات گونه‌گونه‌اند. تجلی یعنی ظهور حق؛ پرتوی نور او.",
   "start": 126.74,
   "end": 147.44
  },
  {
   "index": 2,
   "title": "## تجلی اعظم و پیامبر اعظم",
   "start": 147.44,
   "end": 288.86
  },
  {
   "index": 3,
   "title": "## وللمؤمنین بوعدک؛ وفا به عهد",
   "start": 288.86,
   "end": 395.7
  },
  {
   "index": 4,
   "title": "## آمادگی فیزیک و متافیزیک برای تجلی روضه",
   "start": 395.7,
   "end": 507.14
  },
  {
   "index": 5,
   "title": "## شیخ پیاده و چای هیئت",
   "start": 507.14,
   "end": 736.08
  },
  {
   "index": 6,
   "title": "## فهم تجلی حسین هنگام موت",
   "start": 736.08,
   "end": 803.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.14,
   "end": 11.36,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.36,
   "end": 15.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.54,
   "end": 21.18,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.18,
   "end": 27.3,
   "text": "حیفم اومد که در خصوص تجلیات بیشتر از این صحبت نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 27.3,
   "end": 34.04,
   "text": "موضوع مهمی‌ست و ما دائماً در بهش درگیر در، درگیر در این قصه هستیم چه بدانیم چه ندانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.04,
   "end": 40.58,
   "text": "بحث در روایت هشتم باب چهارم کتاب الموت بود و نحوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 40.58,
   "end": 46.48,
   "text": "رضایت اهل ایمان هنگام موت بود که با تجلیات الهیه اینا رضایت پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 46.48,
   "end": 51.06,
   "text": "که البته از اونجا بحث به اینجا کشیده شد که حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 51.06,
   "end": 55.76,
   "text": "علیه و علی نبينا و آله السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 55.76,
   "end": 59.4,
   "text": "این سؤال رو پرسید که چگونه دوستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.4,
   "end": 62.08,
   "text": "م-موت و مرگ دوستش رو می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 62.08,
   "end": 68.24,
   "text": "که بعد خدا فرمود چگونه دوستی اکراه داره، کراهت داره دیدار دوستش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.24,
   "end": 73.54,
   "text": "بعد کشیده شد به بحث کراهت اهل ایمان از رفتن از دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 73.54,
   "end": 77.1,
   "text": "که برای همه ما به جهت تعلقات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.1,
   "end": 81.6,
   "text": "لکن اهل بیت علیهم الصلاة والسلام اینجا میانجی گری می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.6,
   "end": 85.8,
   "text": "یعنی شفاعت اون‌ها از همین دنیا با ما میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.8,
   "end": 91.52,
   "text": "ان‌شاءالله. به برکت این لباس مشکی‌هایی که تنتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 91.52,
   "end": 97.58,
   "text": "که این که فرمودن شفاعت رو باید از همین دنیا با خودت ببری، همین جا نصیبت بشه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 97.58,
   "end": 101.2,
   "text": "اون لحظات آخر که هنوز تو همین دنیا هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 101.2,
   "end": 104.9,
   "text": "اون‌ها باید رضایت تو رو کسب کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 104.9,
   "end": 107.92,
   "text": "رضایت تو رو بگیرن، رضایت تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.92,
   "end": 115.08,
   "text": "اعلان کنن به حضرت حق تا قبض روح صورت بگیره و اون کار، کار امام ماست با نشان دادن خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.08,
   "end": 118.12,
   "text": "این تجلیات گونه‌گونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 118.12,
   "end": 120.72,
   "text": "تجلیات یعنی ظهور حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.72,
   "end": 122.68,
   "text": "یعنی پرتوی نوری او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.68,
   "end": 125.84,
   "text": "الله نور السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.84,
   "end": 130.38,
   "text": "در هر جایی، در هر نشئه به گونه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.38,
   "end": 132.58,
   "text": "نور حق وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.58,
   "end": 138.86,
   "text": "در این آسمان و زمین هم از نور حق‌اند که برپاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.86,
   "end": 143.44,
   "text": "که این تجلیات حالا در ادعیه هم اومده چند تاشو من مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.44,
   "end": 147.44,
   "text": "اولاً در زیارت پیغمبر در شب مبعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.44,
   "end": 149.88,
   "text": "مفاتیح رو دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.88,
   "end": 154.7,
   "text": "هست که ب-بتجلی الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.7,
   "end": 157.38,
   "text": "بتجلی الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.38,
   "end": 161.28,
   "text": "تجلی اعظم که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.28,
   "end": 165.04,
   "text": "همون تجلی حقی اما اعظمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.04,
   "end": 167.7,
   "text": "لذا میگیم پی- پیغمبر اکرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.7,
   "end": 173.22,
   "text": "رهبر یه چند سالی‌ست رهبر عزیز فرمودن پیغمبر اک-- اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.22,
   "end": 177.26,
   "text": "شاید از همین روایت، همین جا از همین زیارت اقتباس کردن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.26,
   "end": 180.34,
   "text": "چون قبل از ایشون من ندیده بودم کسی بگه پیغمبر اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.34,
   "end": 183.58,
   "text": "همه می‌گفتیم اکرم حتی که بار بزرگواران ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.58,
   "end": 185.7,
   "text": "شاید از اینجا باشه بتجلی الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.7,
   "end": 187.28,
   "text": "تو تجلی اعظم حقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.28,
   "end": 190.64,
   "text": "یعنی بالاترین تجلی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.64,
   "end": 192.34,
   "text": "پیغمبر عزیز عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.34,
   "end": 195.2,
   "text": "یعنی خدا خودش رو به تمامه در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.2,
   "end": 203.0,
   "text": "تا اونجایی که در ممکنات دقت بفرمایید امکانش وجود داشته در پیغمبر تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.0,
   "end": 207.72,
   "text": "لذا شده خاتم، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.72,
   "end": 214.18,
   "text": "و عرض شود مثلاً وتجلیت لإبراهیم في مسجد الخيف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.18,
   "end": 219.68,
   "text": "اینجا دیگه حضرت ابراهیم تجلی اعظم نیست بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.68,
   "end": 227.44,
   "text": "لإبراهیم في مسجد الخيف یعنی خداوند منان تجلی کرده است در مسجد خیف برای حضرت ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.44,
   "end": 230.34,
   "text": "حالا این تجلیات در روایات اومده منظور چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.34,
   "end": 235.46,
   "text": "مثل تجلی در کوه تور و تکه، تکه شدن اون کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.46,
   "end": 238.66,
   "text": "که جلسه پیش عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.66,
   "end": 247.08,
   "text": "که پرتویی از نور ولایت تجلی می‌کنه برای پیغمبر و عصرتش تمام نور ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.08,
   "end": 250.52,
   "text": "یا مثلاً و لإسحاق بحلفک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.52,
   "end": 252.4,
   "text": "حالا اینم بیان شده در روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.4,
   "end": 255.28,
   "text": "الان اینجا فرصتش نیست بگیم رد می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.28,
   "end": 262.58,
   "text": "و لیعقوب نبيه که عليه السلام، سلام بميثاقك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.58,
   "end": 266.96,
   "text": "باز اینجا میثاق که اونجا حلف اینجا میثاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.96,
   "end": 269.74,
   "text": "بین یعقوب و به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.74,
   "end": 272.72,
   "text": "نبی خدا با خبر از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.72,
   "end": 275.62,
   "text": "نابع، نبع، نابع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.62,
   "end": 279.9,
   "text": "نبی. أما يتساءلون عن النبع العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.9,
   "end": 284.62,
   "text": "خبر که او چون باخبر است از عالم یه میثاقی ازش گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.62,
   "end": 287.38,
   "text": "تو برو دیگران را آگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.38,
   "end": 292.0,
   "text": "وللمؤمنين آیا برای ما هم تجلی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.0,
   "end": 295.22,
   "text": "بلافاصله فرمود وللمؤمنين بوعدك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.22,
   "end": 298.66,
   "text": "به وعده‌ای که، به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.66,
   "end": 305.26,
   "text": "وعده‌ای که تو دادی به مؤمنین اینم تجلی حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.26,
   "end": 309.12,
   "text": "حالا می‌تونه برگرده به اون عهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.12,
   "end": 311.92,
   "text": "الهی. عهدی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.92,
   "end": 316.18,
   "text": "در سوره یاسین باید باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.18,
   "end": 320.18,
   "text": "فرمودن. آلم عهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.18,
   "end": 323.0,
   "text": "آیا ما با شما عهد نبستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.0,
   "end": 329.48,
   "text": "ألم أعهد إليكم يا بني آدم ألا تعبدوا الشيطان إنه لكم عدو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.48,
   "end": 332.22,
   "text": "مبين وأن اعبدوني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.22,
   "end": 334.32,
   "text": "هذا صراط مستقيم. عهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.32,
   "end": 336.44,
   "text": "یکی از عهد‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.44,
   "end": 339.32,
   "text": "این می‌تونه همون تجلی حضرت حق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.32,
   "end": 346.66,
   "text": "یعنی اگر کسی می‌خواهد خدای منان در او تجلی کند، هرکس او را دید یاد خدا بیفتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.66,
   "end": 353.9,
   "text": "هرکس او را دید جلوه‌ای از حجت خدا و ولایت رو ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.9,
   "end": 358.48,
   "text": "یعنی بار ولایت بکشد و در نتیجه هنگام موتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.48,
   "end": 362.88,
   "text": "حضرت ولایت کلیه تشریف بیارن به بالینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.88,
   "end": 365.64,
   "text": "باید چه کنه؟ به عهدش وفا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.64,
   "end": 370.26,
   "text": "به وعده‌های الهی دل بسپره و اطمینان حاصل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.26,
   "end": 376.86,
   "text": "یکی از وجوه این تجلیات در وعده‌های الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.86,
   "end": 381.5,
   "text": "فهمه. ما گفتیم تجلی از جلیه به معنای روشن شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.5,
   "end": 385.08,
   "text": "یه چیزی رو که می‌فهمی میگی آها روشن شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.08,
   "end": 391.42,
   "text": "یعنی پرده‌ها میره کنار. در حقیقت علم و معرفت شما بیشتر از قبل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.42,
   "end": 393.94,
   "text": "علم و معرفتی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.94,
   "end": 398.0,
   "text": "ثغور نفس شما در باطن نفس شما رسوخ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.0,
   "end": 401.54,
   "text": "نه علم فکری باشه صرفاً ورزش فکری کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.54,
   "end": 403.46,
   "text": "یعنی می‌چشی یعنی می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.46,
   "end": 406.24,
   "text": "خیلی موقع‌ها روضه برای من و شما می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.24,
   "end": 411.2,
   "text": "این روضه‌ها تجلیش من و شما در ما تجلی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.2,
   "end": 415.86,
   "text": "چرا؟ آمادگی نداریم. به هر دلیل حالا یا فیزیک ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.86,
   "end": 419.48,
   "text": "یا متافیزیک ما مشکل پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.48,
   "end": 422.02,
   "text": "مثلاً بی‌خوابم، اعصابم خورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.02,
   "end": 424.2,
   "text": "جسمم، فیزیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.2,
   "end": 427.18,
   "text": "الان آمادگی نداره. نشستم پر روضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.18,
   "end": 428.92,
   "text": "خب خوابت میاد چرتت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.92,
   "end": 431.38,
   "text": "چرا؟ خودتو زده می‌کنی از این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.38,
   "end": 434.38,
   "text": "با نشاط برو به زیارات اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.38,
   "end": 437.52,
   "text": "و و و. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.52,
   "end": 439.88,
   "text": "گاهی اوقاتم متافیزیکه درون آماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.88,
   "end": 442.84,
   "text": "چرا؟ درون چرا آماده نیست؟ \"لا یمسّهُ الاّ المتَهَرّون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.84,
   "end": 448.76,
   "text": "وقتی پیغمبر فرمود این لباس رو بشورید، این لباس وقتی کثیفه نمی‌تونه ذکر بگه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.76,
   "end": 452.18,
   "text": "یعنی نمی‌تونه محل فیض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.18,
   "end": 455.72,
   "text": "یعنی فیض رو نمی‌تونه بگیره. مگه اینام فیض می‌گیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.72,
   "end": 458.22,
   "text": "مگه مادیات هم فیض می‌گیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.22,
   "end": 460.66,
   "text": "بله. مگر وجود نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.66,
   "end": 466.62,
   "text": "هر چیزی که موجوده از حق فیض گرفته که موجوده چون وجود مطلق و سمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.62,
   "end": 469.36,
   "text": "حضرت حقه. بقیه ظهور او هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.36,
   "end": 473.36,
   "text": "حیات دارن، هستن. مظهری از اسم 活",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.36,
   "end": 478.28,
   "text": "حضرت حق‌اند. اینه که می‌بینی در دستگاه اباعبدالله این تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.28,
   "end": 485.36,
   "text": "به بهترین وجه ممکن خودش رو نشون می‌ده حتی در همین جمادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.36,
   "end": 489.08,
   "text": "دستگاه ارباب. مثل همین پرچم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.08,
   "end": 491.56,
   "text": "چقدرها از این پرچم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.56,
   "end": 494.38,
   "text": "شفا گرفتن، حاجت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.38,
   "end": 500.96,
   "text": "از این پرچم نگرفتن که ما می‌گیم یعنی این واسطه‌ی فیض شده فیض از طریق ایشون رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.96,
   "end": 503.96,
   "text": "چای امام حسین نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.96,
   "end": 507.52,
   "text": "اون با دوستان داشتم عرض می‌کردم اون شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.52,
   "end": 511.9,
   "text": "پیاده که خیلی معروف بود از زمان آقای بروجردی و مرحوم آقای خراسانی و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.9,
   "end": 517.76,
   "text": "قطعاً شنیدید شیخ پیاده، پیاده چون زیاد می‌رفت زیارت اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.76,
   "end": 521.68,
   "text": "پیاده زیارت امام رضا، حضرت معصومه اینا، جمکران پیاده می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.68,
   "end": 524.66,
   "text": "معروف شده بود به شیخ پیاده. انقدر پیاده رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.66,
   "end": 526.26,
   "text": "حالا من و شما به چی معروفیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.26,
   "end": 530.74,
   "text": "الله اعلم. آقا ایشون معروف شده بود به شیخ پیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.74,
   "end": 535.38,
   "text": "بی-- خود ایشون نقل می‌کنه که می‌دیدم کسی میاد توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.38,
   "end": 542.4,
   "text": "هیئت، هر وقت ما هیئت داریم مخصوصاً دهه‌ی محرم این هر شب آقا قدیمیا سی شب می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.4,
   "end": 547.34,
   "text": "بعضیا که تا ماه، تا اربعین می‌کشوندن، پنجاه شب می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.34,
   "end": 550.8,
   "text": "حالا الان ما یه ده شبش هم جون می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.8,
   "end": 555.32,
   "text": "می‌دید، می‌اومد می‌نشست تو هیئت نه گریه‌ای هست، سینه‌ای می‌زد، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.32,
   "end": 559.5,
   "text": "استکانی می‌شست، نه هیچی. فقط چایی می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.5,
   "end": 562.0,
   "text": "می‌اومد اون چای هیئت کجا چایی می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.0,
   "end": 564.7,
   "text": "چایی می‌خورد. چای امام حسین می‌خورد می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.7,
   "end": 567.56,
   "text": "این شیخ پیاده خب یکی از بزرگان بوده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 567.56,
   "end": 570.34,
   "text": "حالا ما می‌گیم شیخ پیاده از علما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.34,
   "end": 574.7,
   "text": "خیلی میگه تو ذهن من این خلعجانی اومد که خب این یعنی چی به چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.7,
   "end": 579.58,
   "text": "او فقط میاد چایی بخوره بره. تو فقط به خاطر چایی می‌خوای بیای هیئت امام حسین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 579.58,
   "end": 585.38,
   "text": "خلاصه مدتی گذشت این تو ذهن من این سؤال بود تا اینکه این آقا از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.38,
   "end": 589.16,
   "text": "این کسی که فقط چای آقا رو می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 589.16,
   "end": 592.92,
   "text": "یه بعد ما به هر حال متوجه او شدیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.92,
   "end": 598.1,
   "text": "این سؤال برای ما موند. این ببین این خودش یه تجلیه تو ذهن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 598.1,
   "end": 601.5,
   "text": "توی شرح فسوس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.5,
   "end": 607.06,
   "text": "فسوس ابن عربی هست عالم حسن زاده علیه الرحمه می‌فرمود که اونجا یه عبارتی داره بر شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 607.06,
   "end": 611.32,
   "text": "علامه قیصری. می‌فرمود خدا در فهم من و شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.32,
   "end": 614.04,
   "text": "فهمیدن من و شما تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.04,
   "end": 619.08,
   "text": "یعنی شما نمی‌فهمی چیزی رو مگر اینکه خدا تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 619.08,
   "end": 622.08,
   "text": "نمی‌چشی چیزی رو مگر اینکه خدا تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.08,
   "end": 624.36,
   "text": "روضه که خونده می‌شه یهو می‌گیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.36,
   "end": 630.06,
   "text": "می‌گیردت روضه. یهو درک می‌کنی نسبت به سه وجودت و می‌سوزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.06,
   "end": 632.1,
   "text": "آتش می‌گیری، اشکت جاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 632.1,
   "end": 634.24,
   "text": "این یعنی تجلی حق در تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 634.24,
   "end": 635.8,
   "text": "در وجود تو رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.8,
   "end": 639.84,
   "text": "این یه تجلیه، یه نورافشانیه، پرتو افشانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 639.84,
   "end": 642.86,
   "text": "چرا دیگری نمی‌گیره؟ سنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.86,
   "end": 646.12,
   "text": "خلاصه می‌گه در رؤیای صادقه اون شخصو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.12,
   "end": 649.26,
   "text": "شیخ پیاده اون شخصو که چایی می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 649.26,
   "end": 652.54,
   "text": "دیدم نه توی باغ خیلی بزرگ و خوبی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.54,
   "end": 655.08,
   "text": "گفتم شما اینجا؟ گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.08,
   "end": 661.1,
   "text": "ما رو که دف کردن اربابمون امام حسین تشریف آوردن و فرمودن این فعلاً اینجا پیشکش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 661.1,
   "end": 665.8,
   "text": "اینجا باش قیامت یه جای بهتر از اینجا هم بهت میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 665.8,
   "end": 668.72,
   "text": "بعد من تو اونجا سؤال کردم، اون سؤال رو عرضش مطرح کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.72,
   "end": 671.4,
   "text": "گفتم تو که فقط می‌اومدی چایی می‌خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.4,
   "end": 674.66,
   "text": "ندیدیم، ما یه بار ندیدیم تو گریه کنی، سینه بزنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.66,
   "end": 677.68,
   "text": "پرچمی بزنی. فقط چایی خوردی رفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.68,
   "end": 683.38,
   "text": "عجب جمله‌ای گفته. اونجا چشمش باز می‌شه دیگه می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 683.38,
   "end": 685.16,
   "text": "می‌گه که خیلی جمله معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.16,
   "end": 692.16,
   "text": "به شیخ پیاده تو اون عالم رؤیای صادقه می‌فرمود که مگر من چای غیر امام حسین رو می‌خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.16,
   "end": 698.94,
   "text": "عجب! یعنی چای امام حسین خوردم این نور توش بوده نه که چای این و اون و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 698.94,
   "end": 703.1,
   "text": "چون چای امام حسین بود می‌اومدم بخورم و الا چایی که خیلی جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 703.1,
   "end": 706.52,
   "text": "دیدی بعضیا وضعشون توپه. خیلی وضعشون خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.52,
   "end": 711.76,
   "text": "با شاسی بلند میاد تو صف غذا وایمیسته جلوی هیئت یه دنده غذا بگیره ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.76,
   "end": 715.28,
   "text": "این وضع مالیش کی یه سال به همه می‌تونه غذا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 715.28,
   "end": 719.7,
   "text": "برای چی اومده وایساده؟ چون می‌دونه تو این غذا یه خبری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 719.7,
   "end": 722.64,
   "text": "زرنگ‌ها یه پرست برنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 722.64,
   "end": 724.98,
   "text": "هیئت امام حسین رو ورمیدارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 724.98,
   "end": 728.5,
   "text": "خشکش می‌کنن قاطی گونی برنجشون می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 728.5,
   "end": 730.88,
   "text": "دیگه همیشه دارن برنج امام حسین می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 730.88,
   "end": 732.52,
   "text": "این نوری که درونه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 732.52,
   "end": 735.92,
   "text": "تجلی اربابه. حالا فهم تجلی اربابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 735.92,
   "end": 738.9,
   "text": "تو حسین بن علی رو بفهمی تجلی اربابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 738.9,
   "end": 743.08,
   "text": "موقع موت ارباب تشریف آوردن بچشی ارباب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 743.08,
   "end": 745.8,
   "text": "ببینی و بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 745.8,
   "end": 749.82,
   "text": "این تجلیه. این تجلی حسین بن علیه که تو بشناسیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 749.82,
   "end": 752.34,
   "text": "اگر این بود می‌بینی چنان موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.34,
   "end": 755.88,
   "text": "راحته برات. الان یه دفعه بهت بگن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 755.88,
   "end": 758.24,
   "text": "خالی و ذهن باشی یه دفعه بگن آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 758.24,
   "end": 762.08,
   "text": "تذکره کربلا بفرما. اصلاً می‌شینی دو سه تا چهار تا کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.08,
   "end": 765.96,
   "text": "آخ کمرم درد می‌کنه، آخ مریضَم، آخ شکم فلانه، آخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 765.96,
   "end": 768.32,
   "text": "اداره دارم، آخ مشکل فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 768.32,
   "end": 771.42,
   "text": "اصلاً سر از پا نمی‌شناسی دیگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 771.42,
   "end": 776.74,
   "text": "میگی خب تمام. مثل پرنده از قفس آزاد شده می‌پری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 776.74,
   "end": 780.34,
   "text": "درسته؟ بر کربلا. حالا دیگه اونجا خود ارباب رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 780.34,
   "end": 783.88,
   "text": "الله اکبر. منتظر باشیم ان‌شاءالله این تجلیات رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 783.88,
   "end": 787.02,
   "text": "هر چه طهارت نفس بیشتر، تجلیات بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 787.02,
   "end": 789.58,
   "text": "و راحت‌تر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 789.58,
   "end": 792.64,
   "text": "تن به موت می‌ده. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 792.64,
   "end": 795.74,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 795.74,
   "end": 803.96,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}