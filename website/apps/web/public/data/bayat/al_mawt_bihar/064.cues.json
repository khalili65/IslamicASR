  {
   "index": 6,
   "title": "## سبک زندگی و سنگینی ادعا",
   "start": 447.85,
   "end": 564.09
  },
  {
   "index": 7,
   "title": "## سنجش یهود با مشرک نه با پیامبر",
   "start": 564.09,
   "end": 614.35
  },
  {
   "index": 8,
   "title": "مساجد از کودکان خالی شده و پس‌گردنی بسیار دیده‌اند. پیامبر پنج خصلت کودکان را دوست داشت:",
   "start": 614.35,
   "end": 712.13
  },
  {
   "index": 9,
   "title": "## کاسهٔ علی و زهد نمایشی",
   "start": 712.13,
   "end": 811.87
  },
  {
   "index": 10,
   "title": "## نماد مدیریت انقلابی",
   "start": 811.87,
   "end": 842.13
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.96,
   "end": 4.88,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.88,
   "end": 9.64,
   "text": "و آل محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.64,
   "end": 13.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.1,
   "end": 16.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.82,
   "end": 21.9,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.9,
   "end": 28.58,
   "text": "در ادامه‌ی باب چهارم از کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.58,
   "end": 35.28,
   "text": "آیاتی که عرض کردیم مقدمه‌ی این باب آوردند ما در روایت اول بودیم، تمنای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.28,
   "end": 39.2,
   "text": "که دیروز از یهود سخن گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.2,
   "end": 44.4,
   "text": ". در ابتدای این باب گفتیم سلسله آیاتی رو مرحوم مجلsi آورده و تفسیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.4,
   "end": 47.62,
   "text": "یکی دیگه از اون آیات که مورد توجه هست در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.62,
   "end": 52.9,
   "text": "لقاء الله و ترس از موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.9,
   "end": 56.76,
   "text": "آیات هفت و هشت سوره‌ی یونسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.76,
   "end": 60.3,
   "text": "می‌فرماید إن الذين لا يرجون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.3,
   "end": 63.68,
   "text": "لقاءنا قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.68,
   "end": 67.24,
   "text": "کسانی که امید ندارند لقاء ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.24,
   "end": 71.96,
   "text": "اصلاً باور ندارند که قراره به ملاقات ما بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.96,
   "end": 80.64,
   "text": "در صورتی که صریح آیات قرآن این رو تأکید کرده که يا أَيُّهَا الْإِنسَانُ إِنَّكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.64,
   "end": 87.74,
   "text": "كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.74,
   "end": 92.24,
   "text": "حالا خیلی وقته این آیه رو ندیده بودم فکر می‌کنم سوره‌ی انشقاق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.24,
   "end": 94.88,
   "text": "آیه شش انشقاق یا حدودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.88,
   "end": 97.56,
   "text": "یه آی-- خیلی آیه عجیبیه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.56,
   "end": 99.4,
   "text": "پیرامونش زیاد ما سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.4,
   "end": 104.88,
   "text": "يا أَيُّهَا الْإِنسَانُ مطلق داره میگه همه‌ی انسان‌ها مخاطب این آیه اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.88,
   "end": 109.3,
   "text": "چیه؟ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.3,
   "end": 113.84,
   "text": "كَدْحًا با سختی داری میری حواست جمع باشه خیلی سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.84,
   "end": 118.9,
   "text": "اما فَمُلَاقِيهِ قطعاً قراره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.9,
   "end": 121.78,
   "text": "ملاقات کنی. این یه چیز قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.78,
   "end": 126.76,
   "text": "حالا در این آیه هفت و هشت سوره‌ی یونس می‌فرماید اینا امید ندارن چنین چیزی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.76,
   "end": 130.2,
   "text": "چرا امید ندارن؟ چرا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.2,
   "end": 134.72,
   "text": "امید لقاء خدا رو ندارن لذا تمنای موت هم ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.72,
   "end": 139.56,
   "text": "صراحتا بعد از همین کلمه داره خود خدا می‌فرماید و رضوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.56,
   "end": 142.62,
   "text": "بالحياة الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.62,
   "end": 144.7,
   "text": "وطمعا بها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.7,
   "end": 150.24,
   "text": "دو تا خصلت دارن اینا. یکی راضی شدن به حیات دنیایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.24,
   "end": 152.28,
   "text": "دیروز ما بحث یهود رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.28,
   "end": 155.46,
   "text": "گفتیم این‌ها بر اساس آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.46,
   "end": 160.12,
   "text": "نود و چهار تا نود و شش بقره که دیروز خوندیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.12,
   "end": 164.36,
   "text": "قرآن می‌فرماید که این‌ها حتی از مشرکین هم چی‌ترن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.36,
   "end": 168.04,
   "text": "پریزترن به اینکه تو دنیا بمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.04,
   "end": 171.3,
   "text": "عمر هزار ساله هم بدین بهشون بازم کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.3,
   "end": 174.28,
   "text": "اینا به شدت حرص به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.28,
   "end": 176.9,
   "text": "حیات دنیوی دارن. در حالی که معت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.9,
   "end": 180.8,
   "text": "اعتراف می‌کنن که آخرت مال ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.8,
   "end": 182.76,
   "text": "اصلاً آخرت مال ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.76,
   "end": 187.02,
   "text": "انگار سند شش دنگش به نام اینا خورده و بقیه نوکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.02,
   "end": 190.4,
   "text": "کنیز اینان. اما اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.4,
   "end": 192.66,
   "text": "این‌ها الکی اینو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.66,
   "end": 196.04,
   "text": "و رضوا بالحياة الدنيا اصلاً این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.04,
   "end": 198.24,
   "text": "اگر-- اصلاً بحث فتمَنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.24,
   "end": 203.5,
   "text": "الموت اینجا بود دیگه. اگه راست میگید آخرت مال شماست تمنای موت کنید یهودیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.5,
   "end": 206.4,
   "text": "اما نمی‌کنید. چرا نمی‌کنید؟ این آیه دوباره داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.4,
   "end": 207.96,
   "text": "پرده‌برداری می‌کنه از این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.96,
   "end": 212.1,
   "text": "رمزگشایی می‌کنه. چون و رضوا بالحياة الدنيا یعنی راضی‌اند به حیات دنیاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.1,
   "end": 215.08,
   "text": "عشق کو-- عشق و همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.08,
   "end": 218.88,
   "text": "اون چیزی که کوکشون می‌کنه تو این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.88,
   "end": 221.94,
   "text": "اصلاً آخرت و دین و اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.94,
   "end": 225.7,
   "text": "یه بهانه‌ای قرار دادن برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.7,
   "end": 232.98,
   "text": "دنیاشونو آباد کنن. من بارها اینو به خودم نهیب زدم، حدیث نفس خوندم که اگر یک روزی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.98,
   "end": 239.82,
   "text": "سنت خداست اما خب حالا بگیم یه روزی سنت خدا اینطوری بشه که دین‌داری سود دنیوی نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.82,
   "end": 244.64,
   "text": "دقت بفرمید چی عرض می‌کنم. دین‌داری، انقلابی بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.64,
   "end": 247.94,
   "text": "ها؟ سود دنیوی مطلقا نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.94,
   "end": 250.16,
   "text": "مثل زمان امیرالمؤمنین که مطلقا نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.16,
   "end": 252.08,
   "text": "کسی دم از علی می‌زد می‌کشتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.08,
   "end": 254.22,
   "text": "هیچ معامله‌ای باهاش نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.22,
   "end": 259.04,
   "text": "زن و بچه‌ش و قار-- خونه و زندگیشو غارت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.04,
   "end": 262.88,
   "text": "اونجا هم مرد کسی پای مولا وایساد .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.88,
   "end": 271.88,
   "text": "اگر اینو یعنی سود دنیوی دین رو برداری چند تا اون پای رکاب دین و انقلاب می‌مونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.88,
   "end": 274.72,
   "text": "رضوا بالحياة الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.72,
   "end": 277.82,
   "text": "که انّ بین این دو تا یک ملازمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.82,
   "end": 281.66,
   "text": "دو طرفه هست. یعنی هرچی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.66,
   "end": 285.02,
   "text": "به حیات دنیا، به زندگی دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.02,
   "end": 287.96,
   "text": "دل خوش کنی و راضی به اینجا باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.96,
   "end": 290.18,
   "text": "منکر میشی ملاقات خدا رو قلباً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.18,
   "end": 293.88,
   "text": "اگرچه اقرار کنی بله ملاقاتی هست إنّا لله وإنّا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.88,
   "end": 297.72,
   "text": "اما نه عملاً می‌بینی هیچ فرقی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.72,
   "end": 301.62,
   "text": "همچنین اگر کسی از این طرفش هم هست، دوگانه است، دو طرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.62,
   "end": 304.98,
   "text": "اگر کسی راضی شد به حیات دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.98,
   "end": 307.7,
   "text": "لقاء الله رو از ذهنش بیرون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.7,
   "end": 314.3,
   "text": "کسی هم اگر لقاء الله رو فراموش کرد و قبول نکرد قطعاً راضی میشه به فر-- به زندگی دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.3,
   "end": 317.82,
   "text": "حتی دین‌داریش هم دنیاییست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.82,
   "end": 320.9,
   "text": "دیگه بیشتر از این در این خصوص حرف نزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.9,
   "end": 323.78,
   "text": "نکته دوم وطمعا بها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.78,
   "end": 328.68,
   "text": "آیه قرآن دارم می‌خونم. اینا اطمینان کردن به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.68,
   "end": 331.6,
   "text": "محل اتکا و اطمینانشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.6,
   "end": 337.84,
   "text": "اون آرامش‌شون، طمأنینه‌شون با دنیاست، با سکه است، با دلاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.84,
   "end": 340.84,
   "text": "با زر و زوره، با این چیزا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.84,
   "end": 343.82,
   "text": "میزن میشن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.82,
   "end": 347.82,
   "text": "اصلاً کاری به آخرتشون و فقط یه لقلقه ای بر زبانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.82,
   "end": 355.86,
   "text": "والذین هم عن آياتنا غافلون اصلاً همینه که اینا غفلت کردن از آیات ما که بزرگ‌ترین آیه الهی حجت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.86,
   "end": 358.22,
   "text": "و این‌ها غافل از زمام زمانشون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.22,
   "end": 362.06,
   "text": "أولئك مأواهم النار بما كانوا يكسبون باز كسب رو داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.06,
   "end": 365.95,
   "text": "همون اتحاد كسب و كاسب و مكسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.95,
   "end": 367.59,
   "text": "یعنی اینا همه یک حقیقت میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.59,
   "end": 370.95,
   "text": "هرچی کسب می‌کنی اعمال ما اینجا داره اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.95,
   "end": 372.65,
   "text": "اتحاد وجودی با ما برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.65,
   "end": 375.97,
   "text": "خود ما همون مكتسباتمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.97,
   "end": 378.09,
   "text": "هرچی کسب می‌کنیم ما همونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.09,
   "end": 380.55,
   "text": "اگه جهنم کسب می‌کنیم جهنمی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.55,
   "end": 384.51,
   "text": "بهشت کسب می‌کنیم بهشتی‌م. همونطورم محشور میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.51,
   "end": 387.95,
   "text": "چون جهنمی زندگی کردم می‌دونم چه کارم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.95,
   "end": 390.19,
   "text": "از لقای خدا فرار می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.19,
   "end": 392.31,
   "text": "چون می‌دونم برم اونور اوه، اوه!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.31,
   "end": 398.97,
   "text": "کلا پس مرکه است. یک ملاحظه دوگانه بین این دو تا هست که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.97,
   "end": 402.81,
   "text": "که این‌ها چیکار می‌کنن؟ اطمینانشون به اسباب دنیویه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.81,
   "end": 405.33,
   "text": "به پولشونه، به شهرتشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.33,
   "end": 409.51,
   "text": "به میز و مدیریت و مقامشونه، به شان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.51,
   "end": 416.71,
   "text": "اعتباریشونه که اصلاً هم توجه نداره که بابا این که الان همین امروز حالا اسمش یادم رفت یکی از مدیر کلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.71,
   "end": 418.27,
   "text": "گفتن سکته کرد مرد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.27,
   "end": 420.87,
   "text": "خدا رحمتش کنه. تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.87,
   "end": 425.29,
   "text": "الان مثلاً ملائکه میگن مدیرکل فلان جا تشریف آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.29,
   "end": 429.91,
   "text": "راه باز کنید. آب زنید راه را مژده دهید باغ را مدیرکل فلان تشریف آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.91,
   "end": 432.45,
   "text": "ما بزنیم واسه مدیرکل خدا تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.45,
   "end": 436.13,
   "text": "طول عمر و برکت بده به هرکسی که خدمت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.13,
   "end": 438.31,
   "text": "اما اینطوریه اونور. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.31,
   "end": 442.71,
   "text": "اینا اعتبار دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.71,
   "end": 446.73,
   "text": "و نکته‌ی دیگه‌ای که خیلی باید بهش توجه داشت عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.73,
   "end": 449.99,
   "text": "اینه که سبک زندگی-- اینو خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.99,
   "end": 452.53,
   "text": "سبک زندگی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.53,
   "end": 455.27,
   "text": "به عنوان یک آدم دین‌مدار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.27,
   "end": 459.99,
   "text": "ولایی، انقلابی. اوه، اوه چقدر ما عنوان داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.99,
   "end": 462.05,
   "text": "با آدم‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.05,
   "end": 465.33,
   "text": "غیر این هستن یعنی انقلابی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 465.33,
   "end": 470.03,
   "text": "یعنی صدا و سیمایی نیستن. چون اینجاش خط مقدم جبهه فرهنگی نظامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.03,
   "end": 472.39,
   "text": "ما خیلی ادعا داشتیم اومدیم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.39,
   "end": 476.01,
   "text": "بعضی از بچه‌های شما می‌گفتن اینجا رو ما فدک حضرت زهرا می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 476.01,
   "end": 478.75,
   "text": "اوه، اوه، اوه، اوه خیلی حرف سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.75,
   "end": 481.79,
   "text": "ادعاها، ح-حرف قشنگه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.79,
   "end": 484.63,
   "text": "حرف قشنگه. من رد نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.63,
   "end": 486.55,
   "text": "اما نسبت به همه می‌سنجنتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.55,
   "end": 492.21,
   "text": "می‌سنجنمون. اگر من رفتم محضر یکی از بزرگان می‌خواستم برای هیئتم اسم بذارم گفت قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.21,
   "end": 495.95,
   "text": "با صاحب-- با عنوان هیئتتون محشورتون می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.95,
   "end": 499.03,
   "text": "\"یوم یندض کل ناص مع امامهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.03,
   "end": 501.83,
   "text": "ترسیدم بذارم محبین، عشاق، متوسلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 501.83,
   "end": 505.41,
   "text": "گذاشتیم یا زهرا تموم شد رفت با خودشونه به ما چه یا زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 505.41,
   "end": 509.97,
   "text": "ما هم می‌گیم یا زهرا میریم. اینطوریه الان ادعات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 509.97,
   "end": 513.47,
   "text": "همونطوری هم چوب تو آستینت می‌کنن اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 513.47,
   "end": 518.39,
   "text": "یه به زبان نظام آبادی بگم. ادعات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 518.39,
   "end": 521.55,
   "text": "م-- جبهه فرهنگیه. الان مثلا میگن شما کجا کار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.55,
   "end": 524.75,
   "text": "صدا و سیما. اه دیگه شما پسر پیامبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.75,
   "end": 528.79,
   "text": "باید پشت سرت نماز-- آقا بالاتر از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.79,
   "end": 532.77,
   "text": "صدا و سیما که خط مقدم جبهه فرهنگی نظامه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 532.77,
   "end": 534.67,
   "text": "صیانت و حفاظت صدا و سیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.67,
   "end": 536.79,
   "text": "اون دیگه پیشانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 536.79,
   "end": 542.61,
   "text": "صدا و سیماست. یعنی دیگه باید دست به میت بزنی زنده شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.61,
   "end": 544.61,
   "text": "حالا این سبک زندگی ادعاهای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.61,
   "end": 547.77,
   "text": "ببین من خط-- خطوط رو خیلی عاقلانه بازش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.77,
   "end": 554.87,
   "text": "خط‌ها رو مشخص کردم. کسی منکر این نیست که رهبر عزیزمون فرموده اینجا خط جبهه مقدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 554.87,
   "end": 558.67,
   "text": "خط عرض شود مقدم جبهه فرهنگی نظامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 558.67,
   "end": 561.97,
   "text": "دانشگاهه. چه، چه، چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 561.97,
   "end": 564.53,
   "text": "حالا همین طور که چه ربطی به این آیه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 564.53,
   "end": 568.23,
   "text": "دقت کنید. آیه‌ای که دیروز قرائت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.23,
   "end": 571.81,
   "text": "یهود رو میاره مینشونه کنار مشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 571.81,
   "end": 574.05,
   "text": "یهود اهل کتابه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 574.05,
   "end": 575.97,
   "text": "قائل به کتاب آسمانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 575.97,
   "end": 577.89,
   "text": "قائل به چیه؟ پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 577.89,
   "end": 580.65,
   "text": "به غیب ایمان داره ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 580.65,
   "end": 584.91,
   "text": "اما میاراش کنار مشرک. میگه تازه اینا بدتر از مشرکینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 584.91,
   "end": 589.53,
   "text": "چرا؟ وقتی نگاه می‌کنه می‌بینه همونطور که مشرکین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 589.53,
   "end": 593.17,
   "text": "اِطمینان به حیات دنیایی کردن و دلشون به دنیا خوشه، دوست دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 593.17,
   "end": 599.07,
   "text": "هزاران سال اینجا زندگی کنن، اینا بدتر، بدتر از مشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.07,
   "end": 604.29,
   "text": "عجب! یعنی اصلاً نمی‌واد اینجا سنجش رو امیرالمؤمنین قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 604.29,
   "end": 607.47,
   "text": "توجه کنید. نگفته با پیغمبرشون بسنجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 607.47,
   "end": 609.63,
   "text": "نه، گفته با مشرکین اینا رو بسنجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 609.63,
   "end": 612.05,
   "text": "اینا از مشرکین پست‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 612.05,
   "end": 615.91,
   "text": "بابا اینا اهل کتابن. اینا به یک معنا مسلمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.91,
   "end": 618.21,
   "text": "چون همشون مسلمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.21,
   "end": 621.01,
   "text": "این دینشون به خاطر دلایلی اسماشون عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.01,
   "end": 624.91,
   "text": "همه‌ی اینا \"إن الدين عند الله الإسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 624.91,
   "end": 627.35,
   "text": "چگونه با مشرک خدا یه جا گذاشته‌ش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 627.35,
   "end": 631.05,
   "text": "آقا جون سبک زندگیشونو با هم می‌سنجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 631.05,
   "end": 636.51,
   "text": "پیغمبر چرا فرمود من بچه‌ها رو دوست دارم، بچه‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 636.51,
   "end": 639.27,
   "text": "که الان مساجد ما چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 639.27,
   "end": 645.97,
   "text": "از بچه‌ها خالی شده. انقدر پس گردنی خوردن بچه‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.97,
   "end": 649.15,
   "text": "فرمود پنج تا خصلت بچه‌ها رو من دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 649.15,
   "end": 650.95,
   "text": "خیلی این روایت شیرین و قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 650.95,
   "end": 653.07,
   "text": "هر از چند گاهی بهش توجه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 653.07,
   "end": 656.37,
   "text": "قطعاً شنیدید، دیدید. یه ذره بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 656.37,
   "end": 658.89,
   "text": "پیغمبر عزیز عالم چرا بچه‌ها رو دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 658.89,
   "end": 661.47,
   "text": "فرمود به پنج تا خصلت. یک:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 661.47,
   "end": 665.41,
   "text": "این‌ها فرمود که خاک بازی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 665.41,
   "end": 667.83,
   "text": "یعنی اصلاً اهل غرور و خود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 667.83,
   "end": 670.81,
   "text": "تکبر و این حرفا نه مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 670.81,
   "end": 673.25,
   "text": "فرمود چیزی رو درست می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 673.25,
   "end": 677.05,
   "text": "خراب می‌کنن. یعنی دل نمی‌بندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 677.05,
   "end": 680.61,
   "text": "فرمود چیزی رو ذخیره نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 680.61,
   "end": 685.59,
   "text": "یه پفک بهش بدی به قول آقا مجتبی یه پفک بهش بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 685.59,
   "end": 687.77,
   "text": "همشو میخوره. میگه نصفشو بذارم فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 687.77,
   "end": 690.57,
   "text": "نه، مصداق این حرف نیست. اعتماد داره به پدرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 690.57,
   "end": 694.97,
   "text": "میگه پدرم رازق منه روزی فردا مو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 694.97,
   "end": 696.81,
   "text": "تو آیه میگه چی؟ \"و اتمنوا بها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 696.81,
   "end": 700.71,
   "text": "اینا به دنیا دل خوش کردن. اصلاً وعده الهی رو قبول ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 700.71,
   "end": 704.31,
   "text": "الکی شکمی دارن و حرف میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 704.31,
   "end": 706.25,
   "text": "توی احوالاتی که من میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 706.25,
   "end": 712.13,
   "text": "می‌دونم باعث تعجب خیلی‌ها میشه چون با سبک زندگی ما کاملاً مغایرت پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 712.13,
   "end": 718.81,
   "text": "آقا بزرگ تهرانی رو یکی از بزرگان رفته بود خدمتش می‌گفت من اونجا بودم، یه کیسه برنج براش آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 718.81,
   "end": 721.55,
   "text": "الان برای من و شما یهو ده کیسه برنج میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.55,
   "end": 723.27,
   "text": "یه دونشو میدیم به همسایمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 723.27,
   "end": 725.29,
   "text": "خودمو میگم. اصلاً کاری به شما ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 725.29,
   "end": 732.83,
   "text": "کلام حدیث نص. فرمود یه کاسه به ایالش گفت هوای منزلش گفت حضرت هوا یه کاسه بردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 732.83,
   "end": 737.75,
   "text": "زد یه کاسه غذای اون روزشو گذاشت کنار گفت بقیه‌شو بدید به همسایه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 737.75,
   "end": 739.37,
   "text": "از کجا معلوم من فردا زنده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 739.37,
   "end": 743.33,
   "text": "حالا ما نمیگیم دیگه انقدر زاهدانه، یه کاسه، یه گونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 743.33,
   "end": 747.81,
   "text": "ده تا گونی می‌گیره میذاره تو خونه بعد چپش میزنه بعد همه رو میده بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 747.81,
   "end": 750.29,
   "text": "بعد میاد نذر خیریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 750.29,
   "end": 754.31,
   "text": "خب خیریه ما بنده خدایی چند تا کیسه برنج داد آوردیم باز کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 754.31,
   "end": 758.37,
   "text": "پر جوجه‌ست. جوجه زده توش فهمیدیم که برای چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 758.37,
   "end": 762.93,
   "text": "روغن سوخته رو نذر خیریه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 762.93,
   "end": 766.69,
   "text": "فرمود زیاد گریه می‌کنن بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 766.69,
   "end": 769.91,
   "text": "کلید بهشته. چند تامون گریه می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 769.91,
   "end": 777.71,
   "text": "مرحوم ملا صدرا فرمود من اسفارشو که همه بزرگان اهل معرفت حیرونشن فرمود با اشک چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 777.71,
   "end": 780.23,
   "text": "سحرها اینو از خدا گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 780.23,
   "end": 782.85,
   "text": "چند تامون اهل گریه کردن هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 782.85,
   "end": 786.01,
   "text": "و فرمود که اینا دعوا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 786.01,
   "end": 788.51,
   "text": "آخریش دعوا می‌کنن ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 788.51,
   "end": 791.35,
   "text": "با هم سریع آشتی می‌کنن. کینه نمی‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 791.35,
   "end": 798.33,
   "text": "حالا سبک زندگی ما رو بذاریم کنار اونایی که اصلاً ادعا نه از اسلام دارن، نه از انقلاب دارن، نه جبهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 798.33,
   "end": 801.53,
   "text": "فرهنگی نظام دارن. ببینیم چجوری ما داریم زندگی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 801.53,
   "end": 804.85,
   "text": "بعداً قیامت ببینیم سرمون بالاست یا پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 804.85,
   "end": 810.49,
   "text": "این‌هایی که من دارم میگم همش آیه قرآنه، روایات اهل بیته، گفتار بزرگانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 810.49,
   "end": 819.01,
   "text": "باید شیوه مدیریت ما کسی که تو مرکز صیانت نشسته پشت میییز با مدیریت سیما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 819.01,
   "end": 823.31,
   "text": "صدا، با مراکز دیگه زمین تا آسمون فرق کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 823.31,
   "end": 825.73,
   "text": "باید نماد انقلاب باشه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 825.73,
   "end": 828.43,
   "text": "که انشاالله هست. ما که تو دل شما خیلی نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 828.43,
   "end": 830.79,
   "text": "میایم نماز می‌خونیم میریم. انشاالله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 830.79,
   "end": 834.73,
   "text": "اینا تذکریه \"فإن الذکرى تنفع المؤمنین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 834.73,
   "end": 836.35,
   "text": "انشاالله عاقبت بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 836.35,
   "end": 839.19,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 839.19,
   "end": 842.13,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}