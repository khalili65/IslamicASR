 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت یازدهم؛ حبّ امیرالمؤمنین به لقاء الله",
   "start": 23.34,
   "end": 43.52
  },
  {
   "index": 1,
   "title": "## دینِ نازل‌شده؛ نه دین مردم‌درآوردی",
   "start": 43.52,
   "end": 501.15
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 10.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.5,
   "end": 14.14,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.14,
   "end": 17.52,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.52,
   "end": 21.72,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.72,
   "end": 25.52,
   "text": "اجازه بفرمایید که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.52,
   "end": 29.22,
   "text": "روایت یازدهم از باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.22,
   "end": 35.8,
   "text": "نکته‌ای رو عرض کنیم و بعد ربطش بدیم به مسائل روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.8,
   "end": 38.92,
   "text": "اونجا اگر چنانچه خاطرتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.92,
   "end": 45.62,
   "text": "مولا امیرالمؤمنین علت حبش به لقاء الله رو فرمودن \"قد اختار لی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.62,
   "end": 50.54,
   "text": "دین ملائکته\". خدا از این حیث که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.54,
   "end": 56.62,
   "text": "اختیار کرده بین بهترین چیزها رو که گفتیم ناموس خدا دین خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.62,
   "end": 61.5,
   "text": "برای همین اون‌ور منو فراموش نمی‌کنه لذا من عاشق دیدارشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.5,
   "end": 65.72,
   "text": "نکته‌ای که اینجا باید بهش توجه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.72,
   "end": 74.58,
   "text": "اینه که امیرالمؤمنین علیه الصلاة والسلام که وقتی به سینه مبارکش اشاره می‌کنه که \"إنها هنا لعلم جمع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.58,
   "end": 79.48,
   "text": "همه علم تو سینه من علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.48,
   "end": 82.42,
   "text": "و پرنده‌ای به اون قله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.42,
   "end": 87.04,
   "text": "علم علی صلوات الله علیه نمی‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.04,
   "end": 89.2,
   "text": "چنین کسی باز میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.2,
   "end": 92.14,
   "text": "\"قد اختار لی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.14,
   "end": 94.86,
   "text": "خدا اختیار کرد برای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.86,
   "end": 99.26,
   "text": "دین ملائکه‌ش رو، ملائکه از عالم عقول‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.26,
   "end": 101.54,
   "text": "و انبیاش رو و رسولانش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.54,
   "end": 104.82,
   "text": "یعنی چی؟ یعنی من علی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.82,
   "end": 109.6,
   "text": "از خودم حرف نمی‌زنم، از خودم دینی رو نمی‌تراشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.6,
   "end": 111.64,
   "text": "هرچی که از بالا نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.64,
   "end": 114.08,
   "text": "ملائکه رتبه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.08,
   "end": 117.12,
   "text": "مافوق دنیاست دیگه، مافوق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.12,
   "end": 119.38,
   "text": "ما الان در نشئه انزل مراتبیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.38,
   "end": 122.12,
   "text": "اسفل، اسفلیم ما الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.12,
   "end": 125.14,
   "text": "پست‌ترین از جهت فلسفی رتبه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.14,
   "end": 128.26,
   "text": "از اونجا باید بیاد. دین باید از اونجا بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.26,
   "end": 130.84,
   "text": "دین، دین خداست که ملائکه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.84,
   "end": 137.18,
   "text": "از عالم عقول نازل می‌کنند، انبیاش اخذ می‌کنند، رسولانش اخذ می‌کنند و ما هم پیرویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.18,
   "end": 139.82,
   "text": "دقت بفرمایید این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.82,
   "end": 142.9,
   "text": "دین‌های مردم‌درآوردی امروز زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.9,
   "end": 147.8,
   "text": "هرچی انسان عالم‌تره سکوتش بیشتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.8,
   "end": 149.76,
   "text": "آروم‌تره چون حقیقت رو داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.76,
   "end": 152.18,
   "text": "چرا لحظه موت انسان لال می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.18,
   "end": 155.88,
   "text": "حقیقت رو براش مکشوف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.88,
   "end": 158.6,
   "text": "یادتونه دیگه اون آیه رو وقتی ما این قطار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.6,
   "end": 163.56,
   "text": "قطار رو برمی‌داریم \"فبصرک اليوم حدید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.56,
   "end": 167.24,
   "text": "این چشمت تیز می‌شه چون حقیقت رو می‌بی-- حقیقت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.24,
   "end": 169.54,
   "text": "حقیقت رو که می‌بینی لال می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.54,
   "end": 171.86,
   "text": "هرچی آدم بی‌سواد‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.86,
   "end": 176.52,
   "text": "حقیقت نچشیده‌تره بیشتر حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.52,
   "end": 178.96,
   "text": "شما ببینید علما چقدر آرومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.96,
   "end": 183.1,
   "text": "به نظر شما الان امام عصر صلوات الله علیه می‌تونه نماز ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.1,
   "end": 186.78,
   "text": "صبح رو تصرف کنه بگه آقا سه رکعت بخون، چهار رکعت بخون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.78,
   "end": 190.32,
   "text": "یا اصلاً نخون یا وقتش رو عوض کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.32,
   "end": 193.38,
   "text": "اصلاً نبوت تشریعی تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.38,
   "end": 195.88,
   "text": "خاتم الانبیاست تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.88,
   "end": 198.68,
   "text": "البته نبوت انوایی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 198.68,
   "end": 201.7,
   "text": "راهش به روی همه بازه. نبع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.7,
   "end": 204.66,
   "text": "اسم فاعلش می‌شه نابع یعنی باخبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.66,
   "end": 207.92,
   "text": "به شدت باخبر می‌شه نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.92,
   "end": 214.86,
   "text": "که هر چقدر باخبر از حقایق عالمی از پشت پرده اشیا باخبری که همون اسماء‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.86,
   "end": 217.84,
   "text": "\"علم آدم الأسماء كلها\" تو حکیم‌تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.84,
   "end": 223.78,
   "text": "اصلاً حکیم یعنی این. به باطن اشیا که یکیش خودتی بیشتر پی می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.78,
   "end": 226.54,
   "text": "ولی این از کجا میاد؟ مگر ما از خدا نیومدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.54,
   "end": 234.28,
   "text": "در غص نزول \"إنا لله\" پس از الله اومدیم چون لقاء الله می‌خواد صورت بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.28,
   "end": 237.14,
   "text": "مسیر لقاء الله از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.14,
   "end": 240.7,
   "text": "از لله. باید از بالا دین نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.7,
   "end": 245.32,
   "text": "لذا \"إنا أنزلناه في ليلة القدر\" أنزلناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.32,
   "end": 249.46,
   "text": "باید نازل بشه. دین هم باید نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.46,
   "end": 252.76,
   "text": "این نکته اینجاست که می‌گه دین ملائکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 252.76,
   "end": 259.02,
   "text": "نه هر دینی. لذا انسان باید پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.02,
   "end": 265.0,
   "text": "انسان عالم جامع الاطراف حرکت کنه حتی نه هر عالمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.0,
   "end": 267.3,
   "text": "همه چیز باید اصولی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.3,
   "end": 270.98,
   "text": "قرآن اصول امهات رو به ما تلقین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.98,
   "end": 273.68,
   "text": "اصول، اصولی بار اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.68,
   "end": 279.14,
   "text": "الان من داشتم فکر می‌کردم که شب اول دعاشون کردم عزیزانی که اینجا اسقا صلواتی زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.14,
   "end": 283.3,
   "text": "نوار حالا عزا دار اینا پخش می‌شه خیلی هم قشنگ، خوب، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.3,
   "end": 286.44,
   "text": "وقتی وقت اذان که شد این دیگه اصولی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.44,
   "end": 290.2,
   "text": "این اصل نیست، این متفرعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.2,
   "end": 294.6,
   "text": "می‌شه یه دین مردم‌درآوردی. وقتی اذان باید اون قطع بشه، اذان پخش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.6,
   "end": 299.62,
   "text": "و حتی یه تعملی بشه نماز تموم بشه بعد دوباره پخش بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.62,
   "end": 307.56,
   "text": "مگر نفرمود که \"إذا مکنّاهم في الأرض أقاموا الصلاة\" اولین نشانه اونا که تمکن پیدا می‌کنند اقامه، اقامه نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.56,
   "end": 312.06,
   "text": "اصلاً این نمازخونه توی این سازمان، توی این اداره، توی این حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.06,
   "end": 315.84,
   "text": "باید بهترین جا باشه. بیشترین امکانات درش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.84,
   "end": 320.56,
   "text": "شلوغ‌ترین جا باشه. منظم‌ترین، نظیف‌ترین از هر حیث باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.56,
   "end": 322.7,
   "text": "اشرف باشه، اجل باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.7,
   "end": 326.52,
   "text": "اینجا و بیشتر بهش توجه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.52,
   "end": 334.3,
   "text": "الان انصافاً تو حوزه شما بیشتر مسائل امنیتی داره توجه می‌شه یا نماز جماعت ظهرهای اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.3,
   "end": 340.24,
   "text": "اگر به نماز جماعت ظهر اینجا کمتر توجه می‌شه این دین نیست، یه دین ساختگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.24,
   "end": 344.56,
   "text": "حالا یه سوءاستفاده بلکه حسن استفاده بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.56,
   "end": 349.04,
   "text": "همونطور که باید دین از بالا بیاد امیرالمؤمنین هم ادعایی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.04,
   "end": 350.68,
   "text": "می‌گه آقا این خبر از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.68,
   "end": 357.64,
   "text": "\"أَمْ يَتَسَاءَلُونَ عَنِ النَّبَإِ الْعَظِيمِ\" اصلاً نبی چون از خ-- اخبار عالم باخبره میگن نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.64,
   "end": 360.76,
   "text": "منبع خبر کجاست؟ دین ملائکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.76,
   "end": 366.52,
   "text": "مثل این که الان هم شما در فضای مجازی در خصوص مثلاً نحوه شهادت شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.52,
   "end": 370.27,
   "text": "رئیسی و اع-- مثلاً اعوان و انصارش یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.27,
   "end": 374.93,
   "text": "تبعات بعدش. اینها انواع و اقسام خبرها بهتون می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.93,
   "end": 377.13,
   "text": "خب اول باید دنبال منبع خبر بگردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.13,
   "end": 379.59,
   "text": "همینطور که این مشخ-- قبول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.59,
   "end": 382.39,
   "text": "ها؟ یه بحث کاملاً مبحنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.39,
   "end": 385.29,
   "text": "دیروز یکی از بچه‌های خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.29,
   "end": 390.95,
   "text": "سازمان اِاِ، فیلمی رو آورد نشون داد که لحظه سقوط، گفت این لحظه سقوط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.95,
   "end": 394.73,
   "text": "هلیکوپتر آقای رئیسی رو فیلمشو پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.73,
   "end": 398.37,
   "text": "خب بیایید ببینیم. آوردیم دیدیم که یه عکس پایین زده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.37,
   "end": 401.01,
   "text": "یه فیلم هم بالاست. دقیقاً با هم تطبیق داده میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.01,
   "end": 405.25,
   "text": "همون عکس فیلمش بالا بود. بعد اینو نوشته بود ترامپ اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.25,
   "end": 407.25,
   "text": "در صفحه خودش منتشر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.25,
   "end": 410.99,
   "text": "اولاً اگه ترامپ این کار کرده باشه که یعنی دو دست قبر خودشو کنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.99,
   "end": 413.11,
   "text": "یعنی قبول کرده مسئولیت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.11,
   "end": 419.59,
   "text": "ترور. دو، وقتی نشستیم با بچه‌ها بررسی کردیم بالاخره درش آوردیم که آقا این فیلم مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.59,
   "end": 423.17,
   "text": "نمیدونم دو هزار و چنده، حالا تو کانال بچه‌ها نوشتن گذاشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.17,
   "end": 426.75,
   "text": "تحلیلشو که اصلاً ربطی-- مال یه کشور دیگه‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.75,
   "end": 432.15,
   "text": "که هلیکوپترشون سقوط میکنه و ربطش دادن به مثلا آقای رئیسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.15,
   "end": 435.53,
   "text": "الان باید بیاییم بشینیم بگیم که آقا این آقا کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.53,
   "end": 440.05,
   "text": "ز-- ببین حیاتش چه برکاتی داشت که مماتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.05,
   "end": 442.37,
   "text": "به قول رهبر شهادت گونه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.37,
   "end": 446.83,
   "text": "یک سوم دنیا رو عزادار کرده، یک سوم دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.83,
   "end": 450.71,
   "text": "یا اعلام عزا عمومی کردن از سه روز تا یک روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.71,
   "end": 452.93,
   "text": "یا اعلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.93,
   "end": 457.53,
   "text": "مثلا گفتن ما بهترین رفیقمونو از دست دادیم یا پرچمشونو مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.53,
   "end": 459.55,
   "text": "روسیه نیمه برافراشته کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.55,
   "end": 462.05,
   "text": "اینا از حیث دیپلماسی کارهای کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.05,
   "end": 466.89,
   "text": "کسایی که تو کارهای دیپلماسی بین المللی هستن میدونن این اتفاقات یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.89,
   "end": 472.75,
   "text": "ما نداشتیم نمونه‌ش رو. جز یکی مثل حضرت امام که شما الان نقشه جغرافیا رو رو ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.75,
   "end": 475.41,
   "text": "مثلاً کشورهایی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.41,
   "end": 483.01,
   "text": "عزا، اعلام عزا کردن یا همدردی کردن، تسلیت گفتن، پرچمشونو نیمه برافراشته کردن، چه، چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.01,
   "end": 487.57,
   "text": "اینا رو رنگ مثلا سرخ بزنی روش، می‌بینی یک سوم زمین سرخ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.57,
   "end": 491.83,
   "text": "تازه هنوزم مونده. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.83,
   "end": 495.19,
   "text": "رو این فکر کنی. خسته نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.19,
   "end": 501.15,
   "text": "ببخشید. به روح شهدامون مخصوصاً سید و سالارشون که شهید رئیسی بود صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}