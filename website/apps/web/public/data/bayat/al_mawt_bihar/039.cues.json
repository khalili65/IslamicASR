 "chapters": [
  {
   "index": 0,
   "title": "## سه علامت کهولت و آمادگی مرگ",
   "start": 12.42,
   "end": 107.52
  },
  {
   "index": 1,
   "title": "## وجوه قبل از برهان؛ باطن لفظ یا خطای راوی",
   "start": 107.52,
   "end": 144.38
  },
  {
   "index": 2,
   "title": "## اعدل امزجه؛ شرح اشارات و علامه حسن‌زاده",
   "start": 144.38,
   "end": 164.6
  },
  {
   "index": 3,
   "title": "## ضعف جسم از خروج مزاج است",
   "start": 164.6,
   "end": 318.74
  },
  {
   "index": 4,
   "title": "## شاکله و قوام عالم به امام",
   "start": 318.74,
   "end": 656.61
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.86,
   "end": 7.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.62,
   "end": 12.2,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.2,
   "end": 16.54,
   "text": "خب در روایت اول از باب دوم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.54,
   "end": 20.5,
   "text": "عرض کردیم که حضرت امام صادق صلی الله علیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.5,
   "end": 24.22,
   "text": "غلام آزاد شده خودش سباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.22,
   "end": 28.18,
   "text": "سه تا نشونه بر ارزلال امور رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.18,
   "end": 31.2,
   "text": "و کهولت سن رو بیان کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.2,
   "end": 35.42,
   "text": "آمادگی برای درک و پذیرش موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.42,
   "end": 38.82,
   "text": "یکی از الطاف الهیه بر بندگانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.82,
   "end": 42.86,
   "text": "بد نگاه نکنیم بهش. آماده بشن، دل بکنند از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.86,
   "end": 44.72,
   "text": "این سه تا، این سه تا نشونه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.72,
   "end": 47.94,
   "text": "کلال البصر رو که حالا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.94,
   "end": 51.76,
   "text": "بهش سو-- اِمم کم سو شدن نور چشم میگن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.76,
   "end": 54.78,
   "text": "خستگی چشم بعضی جاها تعبیر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.78,
   "end": 56.74,
   "text": "بعضی جاها سنگینی چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.74,
   "end": 58.8,
   "text": "انحناء الوهر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 58.8,
   "end": 61.66,
   "text": "خمیدگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 61.66,
   "end": 68.44,
   "text": "رقت القدم. این سه تا رو عرض کردیم و گفتیم یه سؤال میمونه، اونم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.44,
   "end": 72.74,
   "text": "چون قبل از اینکه این سه تا نشونه رو حضرت بفرماد به غلامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.74,
   "end": 75.94,
   "text": "میفرماد که اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.94,
   "end": 78.18,
   "text": "أنا فلست أراه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 78.18,
   "end": 80.78,
   "text": "من نمیبینم اون رو. چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 80.78,
   "end": 82.52,
   "text": "اون ثقد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 82.52,
   "end": 85.4,
   "text": "شکاف داخل کوه احد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 85.4,
   "end": 90.98,
   "text": "حالا اینجا این سؤال پیش میاد که واقعاً امام معصوم نمی‌دید شکاف رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 90.98,
   "end": 94.2,
   "text": "یعنی امام میشه به جایی برسه که مثلا نبینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 94.2,
   "end": 97.74,
   "text": "کم سو بشه؟ اولا جواب که منفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 97.74,
   "end": 102.38,
   "text": "یعنی نخیر مطلقا ما الان عرض می‌کنیم با براهین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 102.38,
   "end": 105.9,
   "text": "حداقل یک برهان میاریم که چنین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 105.9,
   "end": 107.52,
   "text": "بعد دیگه باید رفت سراغ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 107.52,
   "end": 110.78,
   "text": "دلایل دیگه. حالا قبل از اینکه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 110.78,
   "end": 113.04,
   "text": "عرض شود برهان رو ارائه بدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 113.04,
   "end": 115.08,
   "text": "دو سه جلسه‌ست منتظرشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 115.08,
   "end": 124.24,
   "text": "عرض کنم که اون وجوه متعدد یکی برمی‌گرده به باطن لفظ که چند نمونه گفتیم که آقا منظور از این منطوق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 124.24,
   "end": 129.58,
   "text": "منظور از اینکه امام صادق صلی الله علیه میفرماید من اونو نمی‌بینم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 129.58,
   "end": 134.1,
   "text": "یا اینکه بگیم آقا اصلاً اشکالی پیش اومده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 134.1,
   "end": 138.96,
   "text": "متن حدیث. یعنی راوی‌ها بالاخره همه که امانتدار نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.96,
   "end": 142.56,
   "text": "یه وقت اشتباهی هم شده. بله زیاد داریم در روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 142.56,
   "end": 151.38,
   "text": "که بعداً در مثلا وقتی چند تا روایت که با یه مضمونن کنار هم می‌گذاری متوجه میشی که راوی‌ها اشتباه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.38,
   "end": 156.54,
   "text": "مثلا می‌بینی پنج تا ده تا راوی با یک لفظ روایت رو نقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.54,
   "end": 161.26,
   "text": "یه نفر یه دفعه یه اشکال مثلا یه لفظ دیگه‌ای تو متن حدیث آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.26,
   "end": 164.6,
   "text": "این نشون میده بعضی از راوی‌ها اشتباهاتی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.6,
   "end": 168.42,
   "text": "این هم میتونه برگرده به اون اشتباهات راوی‌ها در متن حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.42,
   "end": 171.88,
   "text": "اگر این رو نپذیریم باید چکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.88,
   "end": 175.78,
   "text": "تعویل کنیم. یعنی بگیم مثلا به عنوان نمونه‌بازی یه مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.78,
   "end": 177.86,
   "text": "مثلا اینکه میتونه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.86,
   "end": 180.58,
   "text": "منظورش از اینکه من اونو نمی‌بینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.58,
   "end": 182.84,
   "text": "این باشه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.84,
   "end": 189.88,
   "text": "مثلا فل-- قرآن میفرماید \"أفلا ينظرون إلى الإبل كيف خلقت\" بعد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.88,
   "end": 194.96,
   "text": "جاهای مختلف \"إلى السماء إلى الأرض إلى الجبال\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.96,
   "end": 198.16,
   "text": "نگاه کن، نگاه نمی‌کنید به کوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 198.16,
   "end": 200.38,
   "text": "به کوه رو میگه نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 200.38,
   "end": 204.66,
   "text": "حضرت شاید به یک معنا میخواد به غلامش اینو بگه آقا جون انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.66,
   "end": 207.62,
   "text": "بازیگوش نباش. چه کار با اون شکاف کوه داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.62,
   "end": 211.0,
   "text": "کوه رو نگاه کن. ببین اینم یه نگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.0,
   "end": 214.38,
   "text": "من شکاف رو نمی‌بینم. یعنی توجه به شکاف ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.38,
   "end": 218.12,
   "text": "من کوه رو می‌بینم. حالا من دارم به شما نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.12,
   "end": 224.18,
   "text": "رو، یه نگاهی رو جلوی، یه منظر جدیدی رو جلو چشمتون میگذارم که ببینید چگونه میشه تعویل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.18,
   "end": 228.02,
   "text": "حالا بماند ما این جواب رو بالاخره بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.02,
   "end": 237.78,
   "text": "که بر اساس چه برهانی شما میگید که نمیشه امام معصوم نبینه مثلا شکاف رو، چشم امام معصوم کم سو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.78,
   "end": 240.64,
   "text": "این کتابی که دست بنده است یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.64,
   "end": 243.16,
   "text": "واقعاً ارشیوترین کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.16,
   "end": 245.26,
   "text": "در حکمت متعالی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.26,
   "end": 248.84,
   "text": "البته این کتابی که الان دست منه شرحه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 248.84,
   "end": 250.78,
   "text": "اشارات شیخ الرئیسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 250.78,
   "end": 253.54,
   "text": "نمت دومش هم هست. کی شرح داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 253.54,
   "end": 257.38,
   "text": "هم شیخ طوسی علیه الرحمة هم علامة حسن زاده علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.38,
   "end": 260.66,
   "text": "الرحمة بر شرح شیخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.66,
   "end": 265.26,
   "text": "بر شرح شیخ شده نور على نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.26,
   "end": 268.48,
   "text": "سه تا نور در هم تنیده شدن شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.48,
   "end": 277.58,
   "text": "خب بعد از اینکه متن عربیش هم تو کتاب حضرت استاد میاره، اونجایی که در انتهای نمت دوم شیخ الرئیس علیه الرحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.58,
   "end": 280.08,
   "text": "بحث اعتدال مزاج رو مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.08,
   "end": 284.92,
   "text": "اصلاً مزاج انسانی رو مطرح می‌کنه که همه ما باهاش درگیریم و مزاج داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.92,
   "end": 291.36,
   "text": "اگر خدا توفیق داد جلسات بعد عرض می‌کنیم مثلا این مزاج چگونه به وجود میاد که اگرچه قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.36,
   "end": 293.72,
   "text": "یه هفت هشت جلسه صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.72,
   "end": 300.52,
   "text": "خب اینجا این متن رو که از خود استاد هست براتون می‌خونم ببینید چه متوجه میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.52,
   "end": 303.48,
   "text": "این کلام خود حضرت علامة حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.48,
   "end": 307.98,
   "text": "میفرماید انسان کامل که از أعدل امزجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.98,
   "end": 311.6,
   "text": "أعدل بر وزن أفل. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.6,
   "end": 314.56,
   "text": "معتدل‌ترین مزاج رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.56,
   "end": 320.62,
   "text": "انسان کامل که از أعدل امزجه برخورداره است قطب عالم امکان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.62,
   "end": 324.62,
   "text": "اینکه قطب یعنی قطب الاقطاب همه گردش می‌گردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.62,
   "end": 329.42,
   "text": "کو-- یعنی سر سوزنی نقص نمی‌تونی شما وارد کنی به قطب الاقطاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.42,
   "end": 333.12,
   "text": "چه به جسمش، چه به روحش، چه به ظاهرش، چه به باطنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.12,
   "end": 338.12,
   "text": "دیگه. مظهر اتم اسم شریف الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.12,
   "end": 342.6,
   "text": "و شما ظاهر و باطن امام رو نمی‌تونی از هم منفک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.6,
   "end": 344.46,
   "text": "ظاهر ایشون هم عنوان باطنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.46,
   "end": 352.02,
   "text": "اصلاً یک بحثی هست که نسبت به باری که هر کسی می‌کشه جسمش ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.02,
   "end": 355.96,
   "text": "اما علمای ما چرا نود سال، صد سال آقای بهجت صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.96,
   "end": 358.32,
   "text": "پنج سال چه می‌دونم بالای صد سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.32,
   "end": 363.69,
   "text": "ماشاالله از ما هم سرحال‌تر چشمش نه عینک زد تا آخر عمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.69,
   "end": 365.35,
   "text": "چی می‌شه؟ چه اتفاقی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.35,
   "end": 367.97,
   "text": "این جسم مطابق با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.97,
   "end": 371.99,
   "text": "روحه. روح چنان بزرگ می‌شه که جسم هم با خودش می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.99,
   "end": 378.93,
   "text": "یک بحثی اینجا هست که اهل بیت علیهم الصلاة و السلام هم قطعاً جسمشون مطابق با روحشون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.93,
   "end": 380.85,
   "text": "یعنی جسمشون فرق می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.85,
   "end": 383.97,
   "text": "جسم اونا هم با اه-- با دیگران فرق می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.97,
   "end": 387.77,
   "text": "حتی در خصوص حضرت صدیقه طاهره سلام الله علیها داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.77,
   "end": 391.17,
   "text": "که اگر مثلاً دختران معمولی در عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.17,
   "end": 399.55,
   "text": "در مثلاً یک ساله چقدر رشد جسمی داشتن، حضرت دو برابر رش-رشد جسمی داشت، قوه جسمی داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.55,
   "end": 402.27,
   "text": "یا چندین برابر هم در روایات داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.27,
   "end": 405.59,
   "text": "این‌ها نشون می‌ده که جسم اون‌ها مطابق با روحشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.59,
   "end": 408.15,
   "text": "یعنی هم‌تراز میره با جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.15,
   "end": 414.81,
   "text": "نمی‌شه اصلاً این که چشم کم سو می‌شه از خروج از اعتدال مزاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.81,
   "end": 418.65,
   "text": "وقتی مزاج انسان از اعتدال خارج می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.65,
   "end": 421.93,
   "text": "چون مزاج اثر مستقیم داره در جسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.93,
   "end": 426.69,
   "text": "حالا بعداً می‌گیم چگونه. این قطعاً ضعف در جسم رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.69,
   "end": 433.97,
   "text": "وقتی امام اعدل امزجه است یعنی مزاجش معتدل‌ترینه پس هیچ ضعفی در جسمش نباید وارد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.97,
   "end": 437.87,
   "text": "مگر از بیرون وارد بشه کسی اشکال نکنه پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.87,
   "end": 440.45,
   "text": "نه منم شهید کردن، کشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.45,
   "end": 442.65,
   "text": "یا تب کردن امام حسن و امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.65,
   "end": 446.95,
   "text": "این تب‌ها از بیرون اومده در جسم نبوده از بیرون واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.95,
   "end": 451.57,
   "text": "چشم خوردن مثلاً \"لیزلقونک بأبصارهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.57,
   "end": 453.15,
   "text": "تو رو زدن با چشم‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.15,
   "end": 456.89,
   "text": "این‌ها بحث‌های اهریمنیه و چیز دیگه‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.89,
   "end": 459.91,
   "text": "و بحث حضرت آلمه رو تو کامل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.91,
   "end": 463.25,
   "text": "او آیت‌الله به معنای حقیقی‌اش می‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.25,
   "end": 468.15,
   "text": "او مصداق \"أكمل و کل شیء أحصيناه في كتاب مبين\" است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.15,
   "end": 473.49,
   "text": "آیه دوازده سوره یس یعنی همه‌چی شمارش شده در امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.49,
   "end": 475.63,
   "text": "همه‌چی. جسم امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.63,
   "end": 479.09,
   "text": "ببینید کو-- تو فکر می‌کنم سوره اسرا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.09,
   "end": 483.15,
   "text": "که می‌فرماید \"قل کل يعمل على شاكلته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.15,
   "end": 487.71,
   "text": "همه بدون استثناء بر اساس شاکله‌شون عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.71,
   "end": 489.73,
   "text": "عالم یه ظاهر داره یه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.73,
   "end": 494.59,
   "text": "باطن عالم بر اساس شاکله‌ی باطن امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.59,
   "end": 500.99,
   "text": "ظاهر عالم هم بر اساس یعنی قیام ظاهر عالم هم به قوام چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.99,
   "end": 502.85,
   "text": "ظاهر امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.85,
   "end": 505.29,
   "text": "ظاهر عالم، قیامش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.29,
   "end": 509.65,
   "text": "قوامش بر اساس ظاهر امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.65,
   "end": 512.57,
   "text": "یعنی ش-- این که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.57,
   "end": 515.47,
   "text": "اگر سر سوزنی لطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.47,
   "end": 520.45,
   "text": "به شکل امام وارد بشه، به جسم امام وارد بشه، عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.45,
   "end": 524.07,
   "text": "متزلزل می‌شه. امام حسین رو کشتن چرا زلزله اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.07,
   "end": 526.11,
   "text": "چرا باد سرخ اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.11,
   "end": 528.55,
   "text": "چرا زمین و زمانو دود گرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.55,
   "end": 530.45,
   "text": "چون \"قل کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.45,
   "end": 534.19,
   "text": "يعمل على شاكلته\". اگر به شکل امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.19,
   "end": 539.17,
   "text": "که شکل عالم، ظاهر عالم تطابق داره با اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.17,
   "end": 543.07,
   "text": "آسیبی برسه به شکل عالم آسیب می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.07,
   "end": 549.69,
   "text": "لذا بلا نازل می‌شه. نمی‌شه یعنی اصلاً نشدنیه شکل امام نقص توش داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.69,
   "end": 554.79,
   "text": "اینایی که میان می‌گن امیرالمؤمنین حالا اینجا بحث‌های زیادی پیش میاد خودتون برید دنبال کنید فرصت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.79,
   "end": 561.87,
   "text": "اینایی که میان می‌گن امیرالمؤمنین استغفرالله العزی بالله قدش کوتاه بوده العزی بالله کچل بوده شکمش فلان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.87,
   "end": 564.07,
   "text": "اینا رو هیچ کدومشون ما قبول نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 564.07,
   "end": 567.67,
   "text": "بر اساس این براهین عقلی انسان باید با عقلش بره جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.67,
   "end": 572.87,
   "text": "کی این حرف رو زده؟ بعد یکی دیگه هم میاد بالا منبر می‌خواد مثلاً یه حرف قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.87,
   "end": 574.89,
   "text": "مد هم هست امروز روشنفکری بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.89,
   "end": 579.69,
   "text": "بله، اونم یه ابتلاء امتحانی بوده برای شیعیان اون روز که یه امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.69,
   "end": 582.31,
   "text": "آیا این آقا تبعیت می‌کنه از همچین کسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.31,
   "end": 585.17,
   "text": "این چه حرفیه آخه؟ این چه نگاهیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.17,
   "end": 588.91,
   "text": "چرا ما نگاهمون عقلی نیست به مباحث دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.91,
   "end": 591.85,
   "text": "که امیرالمؤمنین هم باید تنزل بدیم به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.85,
   "end": 593.79,
   "text": "ابتلاء مردم. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.79,
   "end": 596.91,
   "text": "در بهترین شکل ممکن بوده بدن مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.91,
   "end": 599.67,
   "text": "در زیباترین شکل. یه حدیث هم به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.67,
   "end": 604.91,
   "text": "حتی صدای اهل بیت هم اون صدای واقعیشون رو اهدی نشنیده جز خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.91,
   "end": 609.89,
   "text": "اصلاً کسی طاقت نداره صدای اهل بیت رو به صورت صوت واقعی بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 609.89,
   "end": 611.45,
   "text": "ملکوتیان رو به هم می‌ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.45,
   "end": 617.89,
   "text": "این‌ها ظاهر و باطن‌شون در هم تنیده است و \"کل شیء أحصيناه في كتاب مبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.89,
   "end": 619.93,
   "text": "همه‌چی در اون مندمجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.93,
   "end": 623.25,
   "text": "آیه دو سوره جمعه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.25,
   "end": 630.89,
   "text": "\"هو الذي بعث في الأميين رسولاً منهم يتلوا عليهم آياته ويزكيهم ويعلمهم الكتاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.89,
   "end": 639.35,
   "text": "علامه می‌فرماید تمام عالم‌ها، اندیشمندا، حکما، عرفا، انبیا همه رو جمع کنی در برابر پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.35,
   "end": 642.07,
   "text": "امین یعنی بی‌سوادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.07,
   "end": 643.99,
   "text": "بعد این آقا بیاد نقص داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.99,
   "end": 647.79,
   "text": "مثلاً چشمش سو نداشته باشه شکاف فکو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 647.79,
   "end": 649.31,
   "text": "اینا رو مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.31,
   "end": 653.85,
   "text": "Allah عاقبت مو ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.85,
   "end": 656.61,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}