   "start": 84.7,
   "end": 166.08
  },
  {
   "index": 2,
   "title": "## شأن دنیا و شأن آخرت",
   "start": 166.08,
   "end": 220.98
  },
  {
   "index": 3,
   "title": "## موت جدایی دو شأن",
   "start": 220.98,
   "end": 316.52
  },
  {
   "index": 4,
