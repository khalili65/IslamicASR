 "chapters": [
  {
   "index": 0,
   "title": "## حرکت روح به نفس و نفس به باد؛ اسرافیل",
   "start": 20.16,
   "end": 184.2
  },
  {
   "index": 1,
   "title": "## تسخیر آسمان و زمین؛ کمال جماد و نبات و حیوان",
   "start": 184.2,
   "end": 316.6
  },
  {
   "index": 2,
   "title": "## معجزۀ کیمیاگری وجود؛ غذا جان می‌شود",
   "start": 316.6,
   "end": 440.64
  },
  {
   "index": 3,
   "title": "## لقمۀ ناپاک؛ حق‌الناس و تباهی تربیت",
   "start": 440.64,
   "end": 565.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 2.82,
   "text": "لا حول ولا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.82,
   "end": 4.7,
   "text": "الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 4.7,
   "end": 8.74,
   "text": "محمد آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.74,
   "end": 12.16,
   "text": "最 好 . بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.16,
   "end": 15.28,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.28,
   "end": 20.16,
   "text": "و ربانی آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.16,
   "end": 22.56,
   "text": "در این قسمت بودیم که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.56,
   "end": 26.28,
   "text": "روایت چهارم از باب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.28,
   "end": 32.86,
   "text": "کتاب الموت مرحوم مجلسی علیه الرحمه که تحرکت روح و نفس عرض کردیم که روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.86,
   "end": 36.26,
   "text": "به وسیله نفس حرکت میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.26,
   "end": 39.58,
   "text": "و نکته جالب توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.58,
   "end": 43.04,
   "text": "اینکه بلافاصله حضرت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.04,
   "end": 47.92,
   "text": "حالا خب روح به وسیله نفس حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.92,
   "end": 50.18,
   "text": "نفس چگونه حرکت میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.18,
   "end": 52.84,
   "text": "حرکت نفس از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.84,
   "end": 60.24,
   "text": "فرمودند که تحرکت روح و نفسه حالا حرکت ها اینها برمیگرده به نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.24,
   "end": 63.24,
   "text": "حرکت ها من الريح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.24,
   "end": 67.34,
   "text": "حرکت نفس از ریحه از باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.34,
   "end": 70.52,
   "text": "این باد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.52,
   "end": 73.44,
   "text": "شما ما ظاهراً باد رو نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.44,
   "end": 77.48,
   "text": "ظاهراً دیده نمیشه. حرکت نفس ظاهراً دیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.48,
   "end": 82.64,
   "text": "اما وقتی باد برخورد میکنه به شاخه‌های درخت از حرکت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.64,
   "end": 86.76,
   "text": "از حرکت شاخه‌های درخت متوجه باد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.76,
   "end": 89.42,
   "text": "درسته؟ این چنینه. حالا این باد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.42,
   "end": 93.32,
   "text": "میدونی در این عالم هر چیزی متولی‌ای دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.32,
   "end": 98.98,
   "text": "این که میگه نفخ صور میکنه میدمه، دمیدن باده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.98,
   "end": 102.86,
   "text": "نسیمه. حالا تند و خیز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.86,
   "end": 108.94,
   "text": "این نفخ صور میشه همون حرکت دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.94,
   "end": 112.18,
   "text": "باد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.18,
   "end": 116.42,
   "text": "اون متولی اصلیش کیه که نفخ صور میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.42,
   "end": 121.88,
   "text": "حضرت اسرافیل. پس حرکت نفس به وسیله باده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.88,
   "end": 124.14,
   "text": "باد در تسخیر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.14,
   "end": 127.98,
   "text": "حضرت اسرافیل. اینا همش رو حسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.98,
   "end": 135.32,
   "text": "اینا همش روی حساب خاصیه که حالا وقتی که حضرت قابض الارواح تشریف میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.32,
   "end": 140.36,
   "text": "اینجا این بادی که داره حرکت میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.36,
   "end": 146.78,
   "text": "جهت مسیر باد عوض میشه و با تشریف فرمایی حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.78,
   "end": 152.72,
   "text": "و حرکت میکنه روح به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.72,
   "end": 157.42,
   "text": "یرجع کل الی جوهره الاول به سمت اون جوهره اولش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.42,
   "end": 162.98,
   "text": "حالا این جوهره اول انسان کامل میره و میرسه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.98,
   "end": 169.54,
   "text": "و رسیده به اون صادر اول که عرض کردیم که همه حقایق و کثرات در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.54,
   "end": 174.68,
   "text": "متنقشن. اما بقیه انسان‌ها به اون نهایت نمی‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.68,
   "end": 177.88,
   "text": "در اون طبقات و لایه‌های میانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.88,
   "end": 180.76,
   "text": "حالا یکی میره به سمت اسم جلال خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.76,
   "end": 184.2,
   "text": "یکی میره به سمت اسم جلا-- جمال خدا که اینو بحثش گذاشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.2,
   "end": 186.9,
   "text": "حیوانات، نباتات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.9,
   "end": 190.94,
   "text": "جمادات این‌ها همه به سمت انسان در حرکت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.94,
   "end": 193.06,
   "text": "اتفاقاً آیه شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.06,
   "end": 196.58,
   "text": "سیزده سوره جاسية هم فرمود سخر لکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.58,
   "end": 199.62,
   "text": "ما فی السماوات وما فی الارض آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.62,
   "end": 206.16,
   "text": "در آسمان و زمینه همه تسخیر شماست، دست شماست، برای شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.16,
   "end": 209.68,
   "text": "و یه جا دیگه می‌فرماید هو الذی سخر لکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.68,
   "end": 212.98,
   "text": "اوست که این کارو کرده. همه چی مال شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.98,
   "end": 216.82,
   "text": "یعنی ما میریم به سمت اون صدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.82,
   "end": 220.12,
   "text": "صادر اول، به سمت اون جوهر اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.12,
   "end": 223.56,
   "text": "به سمت فیض مقدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.56,
   "end": 227.64,
   "text": "که تنزل یافته فیض اقدس بود که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.64,
   "end": 230.76,
   "text": "حیوانات میخوان بیان بشن انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.76,
   "end": 233.6,
   "text": "جمادات میخوان بیان بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.6,
   "end": 238.24,
   "text": "انسان. نباتات همه به سمت انسان حرکت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.24,
   "end": 242.52,
   "text": "یعنی کمال یک جماد چیه عزیزم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.52,
   "end": 244.84,
   "text": "وقتی که بشه نطفه یک انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.84,
   "end": 246.94,
   "text": "نون و آب جماده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.94,
   "end": 250.16,
   "text": "پدر مادر بخورنش تبدیل بشه به نطفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.16,
   "end": 254.58,
   "text": "کمال یک نبات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.58,
   "end": 256.76,
   "text": "کمال یک جم-- نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.76,
   "end": 259.58,
   "text": "اینه که انسان بخورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.58,
   "end": 262.42,
   "text": "و بشه چی؟ انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.42,
   "end": 265.58,
   "text": "حالا الان میکن-- عرض می‌کنم یعنی چی بشه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.58,
   "end": 270.12,
   "text": "این از معجزات الهیه. چک-- کمال یک حیوان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.12,
   "end": 273.16,
   "text": "مثلاً یکی گوسفند کی به کمال میرسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.16,
   "end": 276.84,
   "text": "وقتی که حیوانی بخورش گرگی مثلاً یه گـ-- نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.84,
   "end": 279.72,
   "text": "انسان ذبحش کنه این به کمال میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.72,
   "end": 282.88,
   "text": "حالا بین این کمالات هم باز یکی اکمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.88,
   "end": 287.62,
   "text": "اون کسی که در راه سید الشهدا، اون حیوانی که در راه سید الشهدا قربانی بشه بره تو بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.62,
   "end": 289.68,
   "text": "اهل ایمان اینا دیگه اکمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.68,
   "end": 297.06,
   "text": "کمالش بالاتره. در هر حال اون کسی که همه موجودات رو میبره به سمت حضرت حق کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.06,
   "end": 300.4,
   "text": "انسانه. اونا به تنهایی نمی‌تونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.4,
   "end": 303.94,
   "text": "انسان میره. اما خب عرض کردم اون انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.94,
   "end": 310.08,
   "text": "کامله که میره دیگه به اون نهایت بقیه در میانه ها نسبت به درجاتی که دارن حالا این درجه میتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.08,
   "end": 313.04,
   "text": "شقاوت باشه، میتونه سعادت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.04,
   "end": 316.6,
   "text": "پس حیوانات، نباتات، جمادات اینا میخوان انسان بشوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.6,
   "end": 319.84,
   "text": "چرا میشه انسان؟ این نکته‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.84,
   "end": 323.1,
   "text": "مرحوم فارابی به نوعی نه-- فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.1,
   "end": 325.22,
   "text": "مرحوم شیخ الرئیس به نوعی فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.22,
   "end": 329.46,
   "text": "خلاصشو عرض کنم خصوص حضرت علامه حسن زاده علیه الرحمه خیلی زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.46,
   "end": 334.14,
   "text": "می‌فرماید این از معجزات الهی در وجود ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.14,
   "end": 337.26,
   "text": "که همین غذایی که میخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.26,
   "end": 344.3,
   "text": "حالا این غذا میتونه حالا اصلیتش از جماد پا شده دیگه از اون عناصری که در خاک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.3,
   "end": 351.12,
   "text": "اومده شده حالا یا نبات شده، یک گیاهیه داری میخوری یا حیوان شده گوشت داری میخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.12,
   "end": 355.8,
   "text": "درسته؟ این میاد تو وجود تو چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.8,
   "end": 364.44,
   "text": "کارخانه ای خدا در انسان، در وجود انسان قرار داده، چه کیمیاگری در وجود انسان رخ میده که همون گوشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.44,
   "end": 367.76,
   "text": "همون گیاه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.76,
   "end": 370.34,
   "text": "از اصلیتش از جماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.34,
   "end": 372.92,
   "text": "همون‌ها بدل می‌شه به جان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.92,
   "end": 375.22,
   "text": "جان. که یادمه قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.22,
   "end": 379.82,
   "text": "یه جلسه در ارتباط با همین موضوع و معجزه الهی در وجود خودمون صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.82,
   "end": 384.64,
   "text": "این از معجزات الهیه. می‌شود جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.64,
   "end": 389.6,
   "text": "اصلاً خود روح مگر ما جسمانیة الهدوس نبودیم و روحانیة البقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.6,
   "end": 393.32,
   "text": "خود روح نفس ناطقه از کجا متکون می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.32,
   "end": 395.66,
   "text": "از کجا بیرون میاد اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.66,
   "end": 398.02,
   "text": "رشد می‌کنه؟ از تو دل همین جسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.02,
   "end": 401.68,
   "text": "همین نطفه. دقت فرمودید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.68,
   "end": 404.08,
   "text": "حالا این غذایی که می‌خوری می‌شه جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.08,
   "end": 409.0,
   "text": "آقا می‌خوای جانت طیب باشه، پاک باشه یا خبیث باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.0,
   "end": 414.26,
   "text": "ببین چقدر ارتباط مستقیم وجود داره بین خوراک و جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.26,
   "end": 416.86,
   "text": "خوراکت پاکه، جانت پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.86,
   "end": 420.08,
   "text": "خوراکت ناپاکه، خدایی نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.08,
   "end": 423.88,
   "text": "جانت ناپاکه. اینه که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.88,
   "end": 426.78,
   "text": "عبادت، اسلام می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.78,
   "end": 429.16,
   "text": "ده جزء داره، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.16,
   "end": 432.83,
   "text": "جزءش رزق حلاله، کسب حلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.83,
   "end": 435.48,
   "text": "این، این الان متوجه می‌شی یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.48,
   "end": 438.86,
   "text": "همش تحت شعاع همین قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.86,
   "end": 444.52,
   "text": "انقدر مهمه. حالا داشتیم در حکما اینا زیاد این قصه رو داشتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.52,
   "end": 447.64,
   "text": "از میان سرکرده‌هاشون این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.64,
   "end": 454.42,
   "text": "مثلاً زیردستاشون کسایی بودن که به هیچ عنوان دست از ولایت و اهل بیت نمی‌کشیدن اما با اونا هم همکاری می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.42,
   "end": 459.7,
   "text": "حاضر نبودن مثلاً نامه‌ای رو امضا کنن بر علیه اهل بیت، بر علیه اونا حرفی بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.7,
   "end": 461.82,
   "text": "اونا می‌دونستن چی-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.82,
   "end": 463.48,
   "text": "نظام عالم چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.48,
   "end": 466.36,
   "text": "جالبه بعضیاشون از ما عالم‌تر بودن ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.36,
   "end": 471.22,
   "text": "دعوتشون کردن، یه لقمه‌ی ناپاک سر سفره‌ی اینا خوردن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.22,
   "end": 475.26,
   "text": "بر علیه امام زمانشون رأی دادن، حرف زدن، ایستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.26,
   "end": 479.02,
   "text": "اینه. بسیاری از این مشکلات، این آشوب‌ها می‌دونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.02,
   "end": 483.72,
   "text": "این نابسامانی‌ها اینا بسیاریشو ریشه‌یابی کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.72,
   "end": 491.08,
   "text": "از حیث روانشناسی تربیت بری بررسی کنی می‌بینی برمی‌گرده بالاخره برمی‌گرده به لقمه‌ی ناپاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.08,
   "end": 492.9,
   "text": "تربیت ناپاک از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.9,
   "end": 496.18,
   "text": "از لقمه‌ی ناپاک، نطفه ناپاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.18,
   "end": 498.98,
   "text": "اینا همه اومده چیکار کرده؟ این بلا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.98,
   "end": 502.94,
   "text": "به جان من و شما آورده. وای به حال کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.94,
   "end": 504.62,
   "text": "گرفتار حق الناس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.62,
   "end": 509.78,
   "text": "ما اونایی که تو مخصوصاً ادارجات حالا کاسبه اون یه بحث خودشو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.78,
   "end": 514.08,
   "text": "اونایی که تو ادارجات کم‌کاری کنن، کم‌کاری‌ها این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.08,
   "end": 519.24,
   "text": "خیلی خطر جدی که مدیون هشتاد میلیون آدم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.24,
   "end": 522.98,
   "text": "آقا یه مسئولیتی رو بهش سپردن تنبلی می‌کنه، درست انجام نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.98,
   "end": 527.08,
   "text": "در هر حوزه‌ای. این حق الناس هشتاد میلیونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.08,
   "end": 530.18,
   "text": "شوخی نیست، خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.18,
   "end": 531.86,
   "text": "بعد این جان رو ناپاک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.86,
   "end": 534.08,
   "text": "تربیت بچه به مشکل بر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.08,
   "end": 537.76,
   "text": "می‌کشی خودتو می‌بینی بچه به راه نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.76,
   "end": 541.28,
   "text": "این‌ها رو مراقبت کنیم و تو دل چی داریم این‌ها رو ما می‌کشیم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 541.28,
   "end": 544.36,
   "text": "ما یه بحث کردیم. کجا بودیم تو حدیث؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.36,
   "end": 548.0,
   "text": "تحرکت الروح بالنفس حرکتها من الري.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.0,
   "end": 551.72,
   "text": "به کجا رفتیم؟ اینا همه اینجا مندمج شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.72,
   "end": 558.0,
   "text": "حالا این بحث ادامه داره. ان شا الله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 558.0,
   "end": 560.74,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 560.74,
   "end": 565.92,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}