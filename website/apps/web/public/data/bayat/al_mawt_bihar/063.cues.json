   "start": 24.12,
   "end": 79.72
  },
  {
   "index": 1,
   "title": "## ادعای یهود دربارهٔ آخرت",
   "start": 79.72,
   "end": 207.6
  },
  {
   "index": 2,
   "title": "## و لن یتمنوه أبدا",
   "start": 207.6,
   "end": 228.68
  },
  {
   "index": 3,
   "title": "## أحرص الناس علی الحیاة",
   "start": 228.68,
   "end": 370.97
  },
  {
   "index": 4,
   "title": "## بنی‌اسرائیل؛ دو فساد و علو کبیر",
   "start": 370.97,
   "end": 445.69
  },
  {
   "index": 5,
   "title": "## قتل علی و طعن حسن؛ کربلا علو کبیر",
   "start": 445.69,
   "end": 723.67
  },
  {
   "index": 6,
   "title": "## وعدهٔ انتقام و گروه برانگیخته",
   "start": 723.67,
   "end": 753.55
  },
  {
   "index": 7,
   "title": "## مخاطب فتمنوا الموت",
   "start": 753.55,
   "end": 879.29
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 11.38,
   "text": "اللهم عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.38,
   "end": 14.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.86,
   "end": 20.1,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.1,
   "end": 24.12,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.12,
   "end": 28.5,
   "text": "در باب چهارم کتاب الموت مرحوم مجلسی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.5,
   "end": 31.78,
   "text": "به روایت اول که رسیدیم از تمنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.78,
   "end": 36.1,
   "text": "موت درش سخن گفت و اون رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.1,
   "end": 39.72,
   "text": "ابتدای این باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.72,
   "end": 42.8,
   "text": "که حب لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.8,
   "end": 45.18,
   "text": "عشقه به دیدار به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.18,
   "end": 48.34,
   "text": "و وמו فرار من الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.34,
   "end": 53.2,
   "text": "مذمت فرار کردن از موته چون همه قراره بهش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.2,
   "end": 57.8,
   "text": "ابتدا یه سری آیات میاره مرحوم مجلسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.8,
   "end": 61.24,
   "text": "پیرامون این آیات توضیحاتی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.24,
   "end": 68.48,
   "text": "یکی از اون آیات، آیات نود و چهار تا نود و شش سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.48,
   "end": 71.76,
   "text": "بقره‌ست. می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.76,
   "end": 75.7,
   "text": "\"قل ان كانت لکم الدار الآخرة عند الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.7,
   "end": 78.76,
   "text": "خالصة من دون الناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.76,
   "end": 83.18,
   "text": "به این‌ها بگو خطاب به یهودیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.18,
   "end": 88.4,
   "text": "به این یهودیا بگو که اگر این‌ها گمان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.4,
   "end": 92.34,
   "text": "این دار آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.34,
   "end": 98.72,
   "text": "، یعنی آخرت مخصوص این‌هاست چون این‌ها معتقد بودند که این تیکه رو خوب گوش بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.72,
   "end": 104.46,
   "text": "برای اطلاعات و آگاهی ما نسبت به این دشمن خطرناک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.46,
   "end": 107.76,
   "text": "دین و اسلام و انقلابمون خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.76,
   "end": 111.62,
   "text": "صریح آیه قرآن و روایات ما دارن میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.62,
   "end": 115.78,
   "text": "یهودیا معتقدند که اینا قوم برترن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.78,
   "end": 120.72,
   "text": "و اصلا آخرت هرچه نعمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.72,
   "end": 124.34,
   "text": "اونجا آماده کرده مخصوص این‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.34,
   "end": 129.46,
   "text": "و در دنیا هم همه برای این‌ها خلق شدن حتی انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.46,
   "end": 136.24,
   "text": "چگونه‌ست که قرآن می‌فرماید \"سخر لکم ما في السماوات وما في\" آنچه که در آسمان و زمینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.24,
   "end": 140.84,
   "text": "تسخیر دست شماست، حیوانات و این چگونه رام شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.84,
   "end": 145.8,
   "text": "جمادات، نباتات اینا. اینا حتی به انسان‌ها هم یه همچین اعتقادی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.8,
   "end": 151.6,
   "text": "العیاذ بالله میگن انسان‌ها به جز قوم یهود همه حیوانات دست مان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.6,
   "end": 155.56,
   "text": "یعنی ماها رو ابزار دست خودشون می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.56,
   "end": 160.7,
   "text": "یه اعتقادات عجیب و غریبی دارن که حالا ازشون در قرآن به بنی اسرائیل یاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.7,
   "end": 164.54,
   "text": "اینجا قرآن باهاشون می‌فرماید که پیغمبر بهشون بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.54,
   "end": 168.22,
   "text": "اگر \"ان كانت لکم الدار الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.22,
   "end": 171.3,
   "text": "عند الله خالصة من دون الناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.3,
   "end": 173.78,
   "text": "اگه اون دار آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.78,
   "end": 176.12,
   "text": "خالصاً، مخلصاً مال شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.12,
   "end": 179.16,
   "text": "من دون الناس، نه بقیه مردم فقط مال شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.16,
   "end": 185.08,
   "text": "مگه ادعا نمی‌کنید مال شماست؟ مگه نمیگید آخرت هرچی نعمت خدا مهیا کرده مال شماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.08,
   "end": 189.08,
   "text": "خب حالا که اینطوره \"فتمنوا الموت ان كنتم صادقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.08,
   "end": 194.02,
   "text": "این عطف به همون تمنای موت جلسه پیش تو روایت اول که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.02,
   "end": 198.8,
   "text": "خطاب به یهودیاس. اگه همچین ادعایی دارید بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.8,
   "end": 202.1,
   "text": "تمنای موت کنید. چرا نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.1,
   "end": 205.08,
   "text": "خود قرآن باز آیه بعد می‌فرماید \"ولن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.08,
   "end": 207.6,
   "text": "يتمنوه ابدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.6,
   "end": 210.48,
   "text": "مطلقا، ابدا اینا تمنای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.48,
   "end": 214.12,
   "text": "نمی‌کنن. چرا؟ به ما \"قدمت ايديهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.12,
   "end": 217.22,
   "text": "به خاطر غلط‌هایی که کردن، به خاطر کارهایی که کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.22,
   "end": 222.98,
   "text": "که عرض کردیم انسان اگر می‌ترسه از موت به‌خاطر خودشه، کارهای خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.98,
   "end": 227.16,
   "text": "والا موت که فی نفسه ترس نداره، یه انتقاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.16,
   "end": 231.94,
   "text": "\"انما تنتقلون من دارٍ الى دار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.94,
   "end": 235.92,
   "text": "قرآن می‌فرماید نه اینا اصلا این کارو نمی‌کنن چون خودشون می‌دونن چه کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.92,
   "end": 238.16,
   "text": "\"والله عليم بالظالمین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.16,
   "end": 241.14,
   "text": "خدا آگاه به ظالمین. آیه بعد، آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.14,
   "end": 245.36,
   "text": "نود و شش. اینجا خیلی نکته عجیبی باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.36,
   "end": 249.24,
   "text": "\"ولا\" قطعاً \"تجدنهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.24,
   "end": 251.92,
   "text": "قطعاً این‌ها رو می‌یابید شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.92,
   "end": 255.24,
   "text": "که چی‌ان؟ \"أحرص الناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.24,
   "end": 259.26,
   "text": "حریص‌ترین مردم‌اند \"على الحياة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.26,
   "end": 263.84,
   "text": "در زندگی دنیایی و عجیب‌تر از اونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.84,
   "end": 269.44,
   "text": "از اون که عرض می‌کنیم اینه که می‌فرماید \"ومن الذين أشركوا\" تو آیه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.44,
   "end": 271.88,
   "text": "از کسایی که حتی مشرکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.88,
   "end": 274.36,
   "text": "یعنی یهودیا با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.36,
   "end": 280.6,
   "text": "اهل کتابند ظاهراً از آدمای مشرک هم نسبت به دنیا حریص‌ترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.6,
   "end": 287.82,
   "text": "صریح آیه قرآن داره میگه. اینا نشون میده که از یک حس چون مشرکین رو کنار یا اینا رو کنار مشرکین میذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.82,
   "end": 290.72,
   "text": "پیداست که این‌ها هم شرک به خدا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.72,
   "end": 295.4,
   "text": "این‌ها هم توحید ندارن که میذارشون کنار مشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.4,
   "end": 297.76,
   "text": "بلکه میگه از اون‌ها هم چی‌ترن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.76,
   "end": 302.48,
   "text": "حریص‌ترن به دنیا. بعد این چنین خدا بازترش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.48,
   "end": 308.24,
   "text": "\"يود\" اینا خیلی شدیداً دوست دارن \"أحدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.24,
   "end": 313.0,
   "text": "أو يعمر أو يعمر ألف سنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.0,
   "end": 315.58,
   "text": "اگر اینا رو هز-- ألف سنة یعنی هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.58,
   "end": 318.72,
   "text": "هزار سال به اینا عمر بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.72,
   "end": 321.44,
   "text": "باز اینا چی‌اند؟ دوست دارن که عمر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.44,
   "end": 325.36,
   "text": "حالا این نماد کثرته دیگه هزار نه فقط هزار سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.36,
   "end": 328.36,
   "text": "یعنی به شدت اصلاً دوست دارن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.36,
   "end": 330.26,
   "text": "آخر دنیا اینجا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.26,
   "end": 333.42,
   "text": "آقای شما که اگه میگی آخرت مال ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.42,
   "end": 336.84,
   "text": "برای چی انقدر دوست داری تو دنیا هزار ساله بمونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.84,
   "end": 342.42,
   "text": "این خودشه تضاده. میگه تو میگی آخرت مال ماست بعد اینجا همش دوست داری بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.42,
   "end": 345.82,
   "text": "بعد می‌فرماید \"وما هو بمزحزحه من العذاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.82,
   "end": 350.54,
   "text": "حواستون جمع باشه که این، این‌ها را از عذاب نگه نمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.54,
   "end": 358.82,
   "text": "\"أو يعمر أو يعمر\" اگرچه به این‌ها عمر طولانی بدیم اگرچه هزار ساله هم بشن باز اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.82,
   "end": 361.16,
   "text": "تبرّی از آتش نیست براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.16,
   "end": 364.76,
   "text": "\"والله بصير بما يعملون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.76,
   "end": 370.57,
   "text": "این اینجا تموم شد برای اینکه بحث ما کامل‌تر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.57,
   "end": 373.65,
   "text": "می‌دونید قرآن از یهودیا به بنی‌اسرائیل یاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.65,
   "end": 376.77,
   "text": "هر کجا میگه بنی‌اسرائیل منظور یهودیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.77,
   "end": 383.07,
   "text": "آیه چهار و پنج سوره بنی‌اسرائیل رو توصیه می‌کنم بریم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.07,
   "end": 386.73,
   "text": "برای خود من همیشه سؤال بود چرا در این آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.73,
   "end": 389.63,
   "text": "در این آیه دو تا آیه، در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.63,
   "end": 393.15,
   "text": "چهار خدا می‌فرماید که شما دو بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.15,
   "end": 394.79,
   "text": "فساد می‌کنید در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.79,
   "end": 400.49,
   "text": "حالا آیه شو می‌خونم و تکبر جانانه‌ای می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.49,
   "end": 404.93,
   "text": "یه تکب-- قطعاً یک تکبری می‌کنید که رو دستش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.93,
   "end": 407.99,
   "text": "علواً کبیرا، یه تکبر بزرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.99,
   "end": 413.29,
   "text": "خب اینا چیه؟ خدا داره در قرآن خطاب به بنی‌اسرائیل، اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.29,
   "end": 416.89,
   "text": "از چی سخن میگه؟ این دو بار فسادشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.89,
   "end": 420.89,
   "text": "این علو کبیرشون چیه که بعد میگه یه عده‌ای میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.89,
   "end": 426.83,
   "text": "شما با اونا هم سر جنگ دارید اما اونا شده از تو خونه‌هاتون شما رو بیرون می‌کشن و به قتل می‌رسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.83,
   "end": 431.67,
   "text": "اینا هنوز که زنده‌اند که. هنوز که یهودیه دارن سر و صدا گنده راه میرن و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.67,
   "end": 435.91,
   "text": "و نبض دنیا از جهت ثروت و قدرت ظاهراً دست اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.91,
   "end": 438.59,
   "text": "پس پیداست که این قطعه آخرش هنوز نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.59,
   "end": 441.13,
   "text": "بریم سراغ روایات. ما که این کاره نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.13,
   "end": 444.79,
   "text": "بتونه آیات و آیات رو نمی‌دونیم که چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.79,
   "end": 447.67,
   "text": "کارشناس داریم که امام صادق ع باید بفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.67,
   "end": 451.29,
   "text": "این روایتی که تقدیم می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.29,
   "end": 453.89,
   "text": "تقدیم با عشق خدمت شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.89,
   "end": 457.21,
   "text": "از خیلی کتاب‌ها هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.21,
   "end": 460.11,
   "text": "کتاب‌هایی که خیلی دم دست نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.11,
   "end": 463.43,
   "text": "و کتاب‌هایی که هست. من چند تاشو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.43,
   "end": 467.69,
   "text": "بخوام مت، متقن باشه، محکم باشه بدونید چقدر سند قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.69,
   "end": 470.45,
   "text": "مثلا خود کتاب تفسیر اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.45,
   "end": 472.59,
   "text": "جلد هشت، صفحه هشتاد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.59,
   "end": 475.57,
   "text": "ذیل همین آیه چهار و پنج سوره بنی‌اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.57,
   "end": 480.03,
   "text": "البته در هر کتاب تفسیر روایی می‌تونید اینو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.03,
   "end": 482.11,
   "text": "مثل البرهان مثل نور الثقلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.11,
   "end": 484.95,
   "text": "اینا تفاسیر روایی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.95,
   "end": 488.79,
   "text": "الكافی مرحوم کلینی، جلد هشت، صفحه دویست و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.79,
   "end": 492.45,
   "text": "بحار خود مرحوم مجلسی، جلد پنجاه و دو اینو میاره همین روایتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.45,
   "end": 496.17,
   "text": "در تأویل آیات ظاهره از صفحه دویست و هفتاد و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.17,
   "end": 499.25,
   "text": "ای- العیاشی، جلد دو، صفحه دویست و هشتاد و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.25,
   "end": 504.11,
   "text": "کامل الزيارات که از قدیمی‌ترین مصادر روایی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.11,
   "end": 506.63,
   "text": "پیرامون قصه کربلا و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.63,
   "end": 513.03,
   "text": "صفحه شصت و دو. این کتاب رو من دارم توصیه می‌کنم همه بگیرید و قطعاً اگر دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.03,
   "end": 516.75,
   "text": "تو من باید تذکر عرض می‌کنم خیلی کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.75,
   "end": 520.59,
   "text": "عالی است. مرحوم ابن غولوی قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.59,
   "end": 523.77,
   "text": "که امام زمان ضریح ایشون رو می‌بوسید، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.77,
   "end": 529.37,
   "text": "این کتاب رو نوشته. ذیل اون آیه امام صادق این فرمایش رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.37,
   "end": 531.73,
   "text": "دقت بفرمایید خیلی به اطلاعاتتون اضافه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.73,
   "end": 534.67,
   "text": "بعد تازه یه ذره بیشتر می‌فهمیم که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.67,
   "end": 539.61,
   "text": "انقدر امام و رهبر عزیزمون با یهودیا سر ستیز دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.61,
   "end": 543.11,
   "text": "با صهیونیست مطلقا کنار نمیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.11,
   "end": 545.69,
   "text": "و اصلاً خـ- حرف اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.69,
   "end": 549.45,
   "text": "الان انق-- اخیراً هم رهبر عزیزمون فرمودن دیگه تشریح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.45,
   "end": 553.11,
   "text": "اصلاً مسئله اول جهان اسلام مسئله فلسطینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.11,
   "end": 556.83,
   "text": "آقا چرا؟ بابا یا حالا بحث، بحث انسانی هست درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.83,
   "end": 559.29,
   "text": "بحث انسانی‌ست. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.29,
   "end": 563.11,
   "text": "اما وقتی اینطوری نگاه می‌کنیم این از نظر ریشه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 563.11,
   "end": 566.57,
   "text": "از خیلی فراتر از بحث انسانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.57,
   "end": 569.11,
   "text": "این، این روایت رو ذیل اون آیه ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.11,
   "end": 573.21,
   "text": "من خلاصه‌شو بگم. خود آیه رو دیگه نخونم فرصت رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.21,
   "end": 577.21,
   "text": "امام صادق صلوات الله علیه فرمود فی قوله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.21,
   "end": 581.15,
   "text": "در خصوص فرمایش خدا در آیه چهار سوره بنی‌اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.15,
   "end": 585.67,
   "text": "خدا فرموده و قلنا الى بني اسرائيل في الكتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.67,
   "end": 587.83,
   "text": "ما قضای ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.83,
   "end": 593.51,
   "text": "قضای ما حالا باید اینجا بحث بشه سر قضا و قدر چه فرقی با هم می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 593.51,
   "end": 596.19,
   "text": "مثلا شما بگیر لوح محفوظ الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.19,
   "end": 598.69,
   "text": "ما اینطوری مقدر کردیم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.69,
   "end": 600.99,
   "text": "لا تفسدن مخاطبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.99,
   "end": 604.19,
   "text": "شماها یا بنی‌اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.19,
   "end": 606.85,
   "text": "لا تفسدن في الارض مرتين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.85,
   "end": 610.23,
   "text": "شما دو بار رو ز-- تو زمین فساد می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.23,
   "end": 615.37,
   "text": "این دو بار اومده یا تموم شده به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.37,
   "end": 621.01,
   "text": "حضرت فرمود قال قل-- اِاِاِ قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 621.01,
   "end": 623.99,
   "text": "قتل و این اولین بارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 623.99,
   "end": 626.29,
   "text": "و دومین بارش اینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.29,
   "end": 629.87,
   "text": "داره حضرت بطن این آیه رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 629.87,
   "end": 638.11,
   "text": "قال قتل علی ابن ابی طالب و طعن الحسن یعنی نیزه‌ای که به امام حسن، خود خنجری که به حضرت خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.11,
   "end": 643.37,
   "text": "این میشه دو تا فسادی که رو زمین شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 643.37,
   "end": 648.59,
   "text": ". عجب! آخه یهود چه ربطی داره به ابن ملجم مرادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 648.59,
   "end": 652.01,
   "text": "یهود چه ربطی داره به اونایی که دور امام حسن بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.01,
   "end": 654.89,
   "text": "ببین صریح آیه قرآن و روایتی که ذیلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.89,
   "end": 659.53,
   "text": "از خودمون حرف نمی‌زنیم. اصل ریشه دشمنیه با اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.53,
   "end": 661.93,
   "text": "و توحید در یهود خلاصه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.93,
   "end": 665.35,
   "text": "اینجا داره تصریح می‌کنه اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 665.35,
   "end": 669.15,
   "text": "فساد بنی‌اسرائیل یعنی یهودیا کشتن امیرالمؤمنین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.15,
   "end": 671.87,
   "text": "آقا هرچی که دخالت داشته یهودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 671.87,
   "end": 675.07,
   "text": "تمام شد. حضرت داره تصریح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 675.07,
   "end": 677.61,
   "text": "و حتی امام حسن. تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 677.61,
   "end": 680.27,
   "text": "نخیر. و لتعلن علوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.27,
   "end": 683.21,
   "text": "كبيرا. این چیه دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.21,
   "end": 688.21,
   "text": "که میگه لتعل-- قطعاً شما یه برتری‌جویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 688.21,
   "end": 692.51,
   "text": "دوباره تصریح می‌کنه علواً کبیرا خیلی بزرگی رو انجام میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 692.51,
   "end": 700.83,
   "text": "این چیه؟ حضرت در ادامه فرمودند که منظور کشته شدن امام حسین صلوات الله عليه، قصه کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.83,
   "end": 705.33,
   "text": "عجب! یعنی شمر و یزید و معاوی-- عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 705.33,
   "end": 710.55,
   "text": "اون خولی و عمر سعد و اینا که همه نماز می‌خوندن، اینا همه یهودی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.55,
   "end": 713.19,
   "text": "بله به تصریح آیه قرآن فرمود اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 713.19,
   "end": 717.85,
   "text": "یهودی بودن در، اینا در حقیقت گرگی بودن که اومده بودن تو لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.85,
   "end": 719.87,
   "text": "میش. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 719.87,
   "end": 723.37,
   "text": "این هم از امام حسین. حالا منظور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 723.37,
   "end": 727.47,
   "text": "اون فإذا جاء وعد أولاهما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 727.47,
   "end": 729.87,
   "text": "فرمود که اینجا حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 729.87,
   "end": 734.05,
   "text": "یه وقتی فرا برسه یاری خون حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 734.05,
   "end": 737.09,
   "text": "این آمدن وعده ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 737.09,
   "end": 741.25,
   "text": "ن-- گرفتن انتقام خون امام حسین صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 741.25,
   "end": 744.91,
   "text": "و به اثنا ادامه آیه و در مورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 744.91,
   "end": 750.31,
   "text": "به اثنا علیکُم عباد لنا اولی بعث شدید فجاسو خیال الدیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 750.31,
   "end": 754.51,
   "text": "آیه قرآن اینجا. امام صادق صلوات الله علیه فرمود پیرامون این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 754.51,
   "end": 759.61,
   "text": "که میان از هر راه سنبه‌ای باشن پشت دیوارا تو خونه‌هاتون باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 759.61,
   "end": 761.37,
   "text": "عده‌ای میان شما رو بیرون می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.37,
   "end": 764.33,
   "text": "فرمود منظور گروهین که خدا قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.33,
   "end": 769.09,
   "text": "قیام آخری یادگار ما اون‌ها رو برمی‌انگیزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.09,
   "end": 773.69,
   "text": "که میشه تعبیر به انقلابمون و این حرکت نهضت عظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.69,
   "end": 776.59,
   "text": "اسلامی و انقلابی اینا در ایران کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.59,
   "end": 779.27,
   "text": "و هیچ ظالم و جنایتکاری نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.27,
   "end": 784.47,
   "text": "بر پیغمبر که می‌فرماید اون‌ها میخوانش دعوتش می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 784.47,
   "end": 786.83,
   "text": "مگر اینکه اون‌ها رو می‌سوزونن این عده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 786.83,
   "end": 790.93,
   "text": "یعنی با اون‌ها درگیر میشن و این وعده قطعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.93,
   "end": 792.61,
   "text": "وعده قطعی خداست در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 792.61,
   "end": 798.97,
   "text": "امام صادق می‌فرما چی؟ جنگ جهانی انتهایی جنگ بین کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 798.97,
   "end": 802.59,
   "text": "جنگ بین یهود و اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 802.59,
   "end": 806.73,
   "text": "جنگ بین یهود و خونخواهان امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 806.73,
   "end": 809.07,
   "text": "جنگ بین یهود و امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 809.07,
   "end": 811.83,
   "text": "یعنی نقطه سر خط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.83,
   "end": 816.23,
   "text": "دشمنان امام زمان ما هم یهودی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 816.23,
   "end": 820.75,
   "text": "دشمنان یعنی اصلی‌ترین دشمنان ما خط مقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 820.75,
   "end": 825.27,
   "text": "جبهه مخالفت با انقلاب، با اسلام، با قرآن، با توحید یهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.27,
   "end": 829.65,
   "text": "و در یک روایتی می‌خوندم برید ببینید دیگه توضیح ندن فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 829.65,
   "end": 836.47,
   "text": "فرمودن اونی هم که امام زمان را آخر سر به شهادت می‌رسونه چون همشون باید به شهادت از دنیا برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 836.47,
   "end": 837.99,
   "text": "اونی هم که آخر سر امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 837.99,
   "end": 843.99,
   "text": "صادق امام زمان صلوات الله علیه رو به شهادت می‌رسونه طبق یه روایت از پشت سر با خنجر به حضرت می‌زنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 843.99,
   "end": 851.01,
   "text": "اون هم یهودیه. گفتن یک زن یهودیه که در وجود خودش نفاق رو پنهان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 851.01,
   "end": 856.21,
   "text": "این یه سلسله بحثی بود پیرامون اهمیت دشمنی با یهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 856.21,
   "end": 858.63,
   "text": "و اینکه چرا اینجا می‌فرماید فتمنو الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 858.63,
   "end": 861.67,
   "text": "مگه شما نمیگید آقا تمنای موت کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 861.67,
   "end": 863.47,
   "text": "نباید از خدا مرگ خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 863.47,
   "end": 865.65,
   "text": "باید دید مخاطب خدا اینجا کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 865.65,
   "end": 867.75,
   "text": "یهوده. ان شا الله عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 867.75,
   "end": 871.27,
   "text": "بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 871.27,
   "end": 877.89,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 877.89,
   "end": 879.29,
   "text": "و آل محمد. اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}