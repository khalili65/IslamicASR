 },
 "chapters": [
  {
   "index": 0,
   "title": "## خواب برادر مرگ؛ روح و عقل در نوم",
   "start": 11.58,
   "end": 91.78
  },
  {
   "index": 1,
   "title": "## سه چیز که عقل را تباه می‌کند؛ حدیث کاظم به هشام",
   "start": 91.78,
   "end": 391.51
  },
  {
   "index": 2,
   "title": "## کم‌خوابی و پرخوابی؛ قل هو الله و إنا أنزلناه",
   "start": 391.51,
   "end": 579.61
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 5.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.04,
   "end": 8.22,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.22,
   "end": 10.2,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.2,
   "end": 12.9,
   "text": "دیروز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.9,
   "end": 17.36,
   "text": "شرح حدیث چهارم از کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.36,
   "end": 22.12,
   "text": "مرحوم مجلسی در اونجایی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.12,
   "end": 27.96,
   "text": "خواب برادر مرگه، در تعریف موت رسیدیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.96,
   "end": 30.7,
   "text": "شباهت‌گیری بین موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.7,
   "end": 35.6,
   "text": "نوم یعنی خواب. یه حدیثی رو ارائه دادیم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.6,
   "end": 38.24,
   "text": "خواب که سؤال‌برانگیز شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.24,
   "end": 44.48,
   "text": "و جا هم داشت البته که اون قسمتی از حدیث امام صادق صلوات الله علیه که فرمود:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.48,
   "end": 51.04,
   "text": "فإذا خرج الروح تَبِعَهُ العقل فإذا أرى الروح شیئاً حفظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.04,
   "end": 55.44,
   "text": "عليه العقل. وقتی انسان می‌خوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.44,
   "end": 61.62,
   "text": "و رو-- اون چهار تا روحی که در انسان هست خود اصل روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.62,
   "end": 65.3,
   "text": "و عقل از انسان خارج می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.3,
   "end": 70.4,
   "text": "اونجا گفتیم هرچی که روح ببینه عقل در خزانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.4,
   "end": 73.8,
   "text": "حافظه خودش اینو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.8,
   "end": 78.6,
   "text": "بعد یه اشاره‌ای کردیم که پس اگر کسی از خواب بیدار می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.6,
   "end": 80.68,
   "text": "خوابش یادش نیست معمولاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.68,
   "end": 84.78,
   "text": "حالا یه بار دو بار یه دلایلی می‌تونه داشته باشه که عرض می‌کنم اون‌ها چی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.78,
   "end": 87.86,
   "text": "اما نه معمولاً این‌جوریه، نه این نقصان عقل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.86,
   "end": 91.04,
   "text": "برای بعضیا این خیلی عجیب بود این نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.04,
   "end": 94.48,
   "text": "اجازه بدید که در تأیید همین نو-موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.48,
   "end": 98.32,
   "text": "یه روایت تقدیم کنم از کافی جلد یک صفحه هفده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.32,
   "end": 100.82,
   "text": "اینو امام کاظم صلوات الله علیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.82,
   "end": 103.74,
   "text": "هوشام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.74,
   "end": 106.12,
   "text": "هر کسی که سه چیز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.12,
   "end": 109.76,
   "text": "مسلط کنه بر سه چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.76,
   "end": 113.5,
   "text": "سه چیز رو بر سه چیز تسلط بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.5,
   "end": 117.2,
   "text": "این مثل کسیه که هوای نفسش رو از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.2,
   "end": 123.76,
   "text": "دقت کنید اینجا، هوای نفسش رو در از بین بردن عقلش یاری بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.76,
   "end": 125.9,
   "text": "از بین بردن چی؟ عقلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.9,
   "end": 129.0,
   "text": "پس عقل انسان از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.0,
   "end": 130.62,
   "text": "اون حالا سه تا چیز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.62,
   "end": 135.52,
   "text": "فرمود کسی که نور تفکرش رو با آرزوهای طولانی خاموش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.52,
   "end": 139.46,
   "text": "انقدر اهل آرزوهای طولانی هستن، اهل تفکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.46,
   "end": 145.94,
   "text": "این عقل رو ضایع می‌کنه. دو، کسی که دقایق حکمتش رو با حرف‌های زیادی نهی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.94,
   "end": 151.9,
   "text": "همش حرف می‌زنه. یه چهار تا کلام حکمت‌آمیز و درست و حسابی نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.9,
   "end": 154.82,
   "text": "اباطیل میگه، چرت و پرت میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.82,
   "end": 160.24,
   "text": "سه، فرمود کسی که نور عبرت را با خواهش‌های نفسانی خاموش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.24,
   "end": 165.62,
   "text": "گویی که هوای نفسش را در از بین بردن عقلش یاری می‌رساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.62,
   "end": 167.6,
   "text": "پس عقل از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.6,
   "end": 171.32,
   "text": "با چی؟ با گناه. یه جای دیگه هم یه حدیثی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.32,
   "end": 176.34,
   "text": "که پیغمبر فرمود با هر گناهی بخشی از عقل شما میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.34,
   "end": 181.28,
   "text": "و دیگه برنمی‌گرده. در این دیگه برنمی‌گردش تأمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.28,
   "end": 186.44,
   "text": "چرا؟ خب حدیث داریم مقدس‌تر از عقل خدا خلق نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.44,
   "end": 192.68,
   "text": "شما اگر یک چیز مقدس و ارزشمندی رو دست کسی بدی هی خیانت کنه دوباره میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.68,
   "end": 196.78,
   "text": "خدا وکیلی میدی؟ من و شما میدیم که خدا بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.78,
   "end": 200.02,
   "text": "اتفاقاً آیه پنجاه و سه سوره نساء همین رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.02,
   "end": 202.36,
   "text": "فرمود إن الله يأمركم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.36,
   "end": 204.54,
   "text": "أن تؤدوا الأمانات إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.54,
   "end": 210.04,
   "text": "أهلها. اصلاً امر خداست که امانت رو بسپر به کسی که اهلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.04,
   "end": 212.02,
   "text": "اگر کسی اهلش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.02,
   "end": 215.44,
   "text": "هی خیانت در امانت می‌کنه ازش می‌گیرن، اخذ می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.44,
   "end": 218.38,
   "text": "عقل هم امانت الهیه دست ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.38,
   "end": 221.92,
   "text": "اتفاقاً آیه صد، آخه برای بعضیا سؤال شد آخه مگه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.92,
   "end": 226.88,
   "text": "یعنی مثلاً هر کسی که کلاً خواباش هی یادش میره یعنی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.88,
   "end": 231.74,
   "text": "نقصان عقل. گفتم بله. گفت پس اینطوری باشه که همه مردم، خب بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.74,
   "end": 237.54,
   "text": "تعارف نداریم. یعنی اکثریت ما دچار نقصان عقل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.54,
   "end": 241.34,
   "text": "چیز عجیبی نیست. آیه صد سوره یونس رو چند بار با هم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.34,
   "end": 245.42,
   "text": "اون بخش اخ-- انتهایش که یجعل الرجس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.42,
   "end": 247.98,
   "text": "یجعل الرجس، الرجس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.98,
   "end": 252.82,
   "text": "ناپاکی رو یجعل الرجس على الذي لا يعقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.82,
   "end": 255.58,
   "text": "کسی که عقلش رو تعطیل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.58,
   "end": 257.3,
   "text": "آلودگی براش وارد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.3,
   "end": 259.56,
   "text": "یعنی اصلاً اهل تفکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.56,
   "end": 263.04,
   "text": "بعد آلودگی که اومد می‌زنه عقل رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.04,
   "end": 270.84,
   "text": "عقل از بین رفت. اینجا شما خودتون بفرمایید وقتی عقل ناقص شد، از بین رفت، یه بخشیش با گناه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.84,
   "end": 276.54,
   "text": "توی این حدیث امام صادق می‌فرماید آنچه که روح در خواب مشاهده می‌کنه کجا ذخیره می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.54,
   "end": 279.58,
   "text": "تو خزانه عقل. خب وقتی عقل ناقص شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.58,
   "end": 282.16,
   "text": "چگونه یادش بیاد وقتی بیدار شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.16,
   "end": 285.66,
   "text": "ببینید به همین راحتی می‌شه این‌ها رو مفت-- متوجه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.66,
   "end": 287.64,
   "text": "بله اکثرهم لا يعقلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.64,
   "end": 291.12,
   "text": "اکثر مردم قرآن می‌فرماید اهل تعقل نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.12,
   "end": 294.6,
   "text": "پس اکثراً دش-- گرفتار این موضوع هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.6,
   "end": 300.98,
   "text": "دلیل نداره اگر اکثر مردم گرفتار یه موضوعی هستند بگیم مگه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.98,
   "end": 304.54,
   "text": "همه اینطورین. خب باشن. خب به باطل‌ان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.54,
   "end": 309.64,
   "text": "اما اینم-- نکته‌ام برای اینکه تکمیل بشه بحث ما توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.64,
   "end": 312.1,
   "text": "گاهی اوقات هستش که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.1,
   "end": 315.78,
   "text": "خوابی رو می‌بینه و یادش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.78,
   "end": 319.94,
   "text": "این البته همیشه نیست، بعضی از موقع‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.94,
   "end": 322.36,
   "text": "این حکمتی درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.36,
   "end": 324.44,
   "text": "یعنی بحث نقصان عقل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.44,
   "end": 328.38,
   "text": "چطور؟ مثل کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.38,
   "end": 331.78,
   "text": "مثلاً من سراغ دارم کسی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.78,
   "end": 333.8,
   "text": "توسل به امیرالمؤمنین صلوات الله عليه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.8,
   "end": 336.48,
   "text": "مداح و ذاکر اهل بیت بود. دوست داشت شعرهای خودشو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.48,
   "end": 342.22,
   "text": "نمی‌تونست شعر بخ-- بگه. حالا توسل به امیرالمؤمنین کرد و خواب مولا علی علیه الصلاة والسلام دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.22,
   "end": 344.9,
   "text": "مولا تو خواب دو-- یه دو بیتی به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.9,
   "end": 347.28,
   "text": "فرمودن، القا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.28,
   "end": 351.6,
   "text": "ایشون وقتی بیدار شد مصرع آخر دو بیتی رو یادش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.6,
   "end": 354.28,
   "text": "هرچی فکر کرد داشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.28,
   "end": 356.36,
   "text": "خیلی گریه می‌کرد که مثلاً اینو پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.36,
   "end": 358.9,
   "text": "آخر محضر آقای بهجت رسیده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.9,
   "end": 365.23,
   "text": "ایشون تأیید کرده بود و بعد شاگرد آقای بهجت فرموده بودند که اصلاً این عادت اهل بیت این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.23,
   "end": 368.37,
   "text": "می‌خوان یه کسی رو به یه جایی برسن مثلا شاعرش کنن، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.37,
   "end": 374.73,
   "text": "نکته‌ی آخر، کلمه‌ی آخر، مصرع آخر رو از ذهنش، از عقل، از اون خز-خزانه‌ی عقلش، حافظه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.73,
   "end": 376.67,
   "text": "می‌گیرن که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.67,
   "end": 381.55,
   "text": "تا آخر عمرش هرچی شعر داره می‌گه دنبال اون مصرع گمشده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.55,
   "end": 384.41,
   "text": "این باز حکمته. این دیگه ربطی به نقصان عقل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.41,
   "end": 387.97,
   "text": "اما خب به ندرت اتفاق میفته این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.97,
   "end": 391.51,
   "text": "یه نکته‌ی دیگه هم بگیم باز بحث کامل‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.51,
   "end": 394.45,
   "text": "احتمال داره اصلا آدم خواب نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.45,
   "end": 397.05,
   "text": "می‌شه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.05,
   "end": 400.79,
   "text": "می‌شه. انسان‌هایی خیلی خواب کم ببینه یا بخوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.79,
   "end": 402.85,
   "text": "چ-چطور می‌شه که اینطور بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 402.85,
   "end": 407.33,
   "text": "حالا بعضیا خوشحال شدن، خوششون اومد گفتن ما حتما از این نوع هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.33,
   "end": 410.55,
   "text": "اون‌هایی که نفسشون قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.55,
   "end": 415.99,
   "text": "اینو حضرت استاد علامه حسن زاده علیه الرحمه می‌گه آقا محسن شما به خودت نگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.99,
   "end": 418.57,
   "text": "می‌فرماید بعضیا نفسشون قویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.57,
   "end": 420.89,
   "text": "مثلا دستورالعمل داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 420.89,
   "end": 423.83,
   "text": "شما می‌خوای خواب نبینی یا کم ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 423.83,
   "end": 425.69,
   "text": "سوره قل هوالله رو زیاد بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 425.69,
   "end": 429.21,
   "text": "چرا وقتی قل هوالله رو زیاد بخونی خواب کم می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 429.21,
   "end": 432.39,
   "text": "چرا؟ چون سوره‌ی وحدت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 432.39,
   "end": 435.03,
   "text": "می‌برت تو عالم وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 435.03,
   "end": 437.97,
   "text": "از واحدیت می‌کشاند به اهدیه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.97,
   "end": 442.87,
   "text": "که مح-- مندمج شدن همه‌ی حقایق و کثرات در اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.87,
   "end": 444.63,
   "text": "یعنی یک حقیقت کلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.63,
   "end": 448.41,
   "text": "مقام جمع الجمعه. کثرت بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.41,
   "end": 450.69,
   "text": "خواب دیدن کثرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 450.69,
   "end": 453.07,
   "text": "کثراته. حالا برعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 453.07,
   "end": 459.45,
   "text": "اگر کسی بخواد خواب زیاد ببینه اما خواب خوب ببینه، خواب زیاد ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 459.45,
   "end": 461.03,
   "text": "یعنی مرتبط باشه با کثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.03,
   "end": 464.85,
   "text": "چه surه ای رو بخونه؟ سوره انا انزلناه رو زیاد بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 464.85,
   "end": 466.75,
   "text": "خواب زیاد می‌بینه، خواب‌های خوب هم می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 466.75,
   "end": 469.49,
   "text": "تصفیه می‌شه خواب‌هاش. پس این‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 469.49,
   "end": 474.55,
   "text": "نشانه است که بعد حضرت علامه حسن زاده می‌فرماید اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 474.55,
   "end": 479.13,
   "text": "کسی که نفسش قوی شد اتفاقا خواب کم می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 479.13,
   "end": 482.35,
   "text": "چرا؟ برای چی تو خواب ببینه؟ تو بیداری می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 482.35,
   "end": 484.73,
   "text": "حقایق رو انکشاف می‌کنه در بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 484.73,
   "end": 487.39,
   "text": "برای چی خا-- تو خواب ببینه؟ خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 487.39,
   "end": 491.93,
   "text": "رفته تو از عالم طبیعت، از نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 491.93,
   "end": 495.65,
   "text": "پل زده رفته ورود کرده به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 495.65,
   "end": 497.91,
   "text": "مثال یا برزخ وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 497.91,
   "end": 502.41,
   "text": "مثال متصل. همون برزخی که الان ارواح رفتگان ما هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 502.41,
   "end": 504.73,
   "text": "در درون ما هم اون عالم رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 504.73,
   "end": 506.85,
   "text": "اون رتبه و اون مرتبه رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 506.85,
   "end": 508.77,
   "text": "بهش می‌گن عالم مثال یا برزخ وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 508.77,
   "end": 514.43,
   "text": "وقتی ما می‌خوابیم میریم اونجا. آنچه که ما اونجا می‌بینیم، می‌چشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 514.43,
   "end": 517.73,
   "text": "می‌شنویم اینا همه حقایقی‌اند که از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 517.73,
   "end": 523.41,
   "text": "عقول و یعنی یه رتبه بالاتر تنزل پیدا کردن، اومدن می‌خوان برسن به نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 523.41,
   "end": 525.05,
   "text": "اما ما زودتر بهشون رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 525.05,
   "end": 527.59,
   "text": "تو نشئه مثال یا برزخ رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 527.59,
   "end": 535.37,
   "text": "اونا رو استیاد می‌کنیم. بعد این هنر ماست که از اون صور و اشکالی که در برزخ وجودی‌مون یعنی در عالم خواب می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 535.37,
   "end": 538.27,
   "text": "عبور کنیم. تعبیر که میگن یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 538.27,
   "end": 540.25,
   "text": "عبور کنیم به اون حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 540.25,
   "end": 544.23,
   "text": "این ظاهری که من تو خواب صور و اشکالی که دیدم می‌خواد از چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 544.23,
   "end": 548.13,
   "text": "حکایت کنه؟ اون دیگه علمی‌ست که مال هرکسی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 548.13,
   "end": 551.37,
   "text": "انشاالله خدا ما رو آگاه کنه. پس خلاصه چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 551.37,
   "end": 553.67,
   "text": "اینکه اگر کسی معمولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 553.67,
   "end": 556.13,
   "text": "خواب می‌بینه، می‌فهمه خواب دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 556.13,
   "end": 562.53,
   "text": "معمولا اینطوریه. نه یکی دو بار و خوابش یادش میره دلیل بر نقصان در عقلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 562.53,
   "end": 568.27,
   "text": "دلایل نقصان عقل رو هم امام کاظم در اون سه چیز برشمردن که خلاصه‌ش می‌شه گناه و معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 568.27,
   "end": 573.23,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 573.23,
   "end": 576.67,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 576.67,
   "end": 579.61,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}