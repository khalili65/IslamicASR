 "chapters": [
  {
   "index": 0,
   "title": "## آغاز کتاب الموت؛ غفلت از لقاء و رضایت به دنیا",
   "start": 0.66,
   "end": 112.26
  },
  {
   "index": 1,
   "title": "نکته‌ای که خدا رحمت کند حضرت ملاصدرا دارند ذیل آیهٔ شصت‌ودو سورهٔ واقعه بسیار شیرین است:",
   "start": 112.26,
   "end": 147.44
  },
  {
   "index": 2,
   "title": "## روایت اول؛ قومی که خواستند موت برداشته شود",
   "start": 147.44,
   "end": 418.66
  },
  {
   "index": 3,
   "title": "## ربک؛ رب پیامبر و لقاء الله",
   "start": 418.66,
   "end": 546.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.66,
   "end": 4.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.38,
   "end": 8.26,
   "text": "آیه سه سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.26,
   "end": 13.58,
   "text": "بعد از این وقفه‌ای که بین ما و شما در انتقال حقایق و معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.58,
   "end": 23.18,
   "text": "افتاد، نیت کردیم با توجه به بعضی از مسائل و گفت‌وشمودها و این‌ها بریم سراغ کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.18,
   "end": 25.28,
   "text": "بهار مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.28,
   "end": 28.22,
   "text": "یه کتاب یکی از مجلدات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.22,
   "end": 34.42,
   "text": "ایشون هست که موت رو روایات و احادیث پیرامون موت رو میاره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.42,
   "end": 36.28,
   "text": "متأسفانه یکی از علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.28,
   "end": 42.7,
   "text": "اصلی اینکه ما غافل شدیم و توجهمون به دنیا خیلی زیاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.7,
   "end": 44.94,
   "text": "و گرفتار غفلت شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.94,
   "end": 47.8,
   "text": "بی‌توجهی به موت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.8,
   "end": 51.04,
   "text": "که یک حقیقتی‌ست که قطعاً رخ خواهد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.04,
   "end": 55.96,
   "text": "آیه هفت سوره یونس می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.96,
   "end": 64.7,
   "text": "قطعاً اون‌هایی که امید ندارن لقای ما رو حواسشون نیست که قراره وقتی از این دنیا رفتن به لقای ما برسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.7,
   "end": 70.32,
   "text": "، داره می‌فرماید که گره کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.32,
   "end": 75.62,
   "text": "میگه اینا به حیات دنیا راضی شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.62,
   "end": 77.72,
   "text": "و اطمینان پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.72,
   "end": 81.02,
   "text": "اطمینان‌شون در دنیا اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.02,
   "end": 90.04,
   "text": "یعنی دیگه پشتوانه‌شون شد همون دنیا و مال و ثروت و مدیریت و مسئولیت و آنچه که در دنیا اعتبار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.04,
   "end": 94.64,
   "text": "و البته این‌ها از آیات ما غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.64,
   "end": 100.1,
   "text": "غفلت. غفلتی که از لقای حضرت حق رخ می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.1,
   "end": 109.68,
   "text": "اینجاست. حالا نکته‌ای که خدا رحمت کنه حضرت ملاصدرا دارن در ذیل آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.68,
   "end": 112.26,
   "text": "آیه شصت و دو سوره واقعه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.26,
   "end": 116.0,
   "text": "خیلی شیرینه. می‌فرماید اون نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.0,
   "end": 119.96,
   "text": "اونایی که میگن آقا چرا میگی نشئه طبیعت، نشئه برزخ، نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.96,
   "end": 123.96,
   "text": "اینجا آیه قرآنه. به قرآن هم اشکال کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.96,
   "end": 127.68,
   "text": "همه کلماتی که عرفا و حکما گفتن برخاسته از قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.68,
   "end": 132.58,
   "text": "یک نمونه‌اش همین .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.58,
   "end": 141.86,
   "text": "اونجا وقتی ما رفتیم اونجا به اون میگن که شما شناختید نشئه اولی رو یعنی نشئه طبیعت رو یعنی دنیا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.86,
   "end": 144.32,
   "text": "چرا متذکر نشدید؟ چرا غافل بودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.32,
   "end": 146.78,
   "text": "شما که دنیا رو شناختید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.78,
   "end": 152.76,
   "text": "ملاصدرا در اسرار الآیاتش می‌فرماید اگر کسی بخوا-- این نکته خیلی مهمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.76,
   "end": 156.04,
   "text": "و خودش یه منبر مستقل می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.04,
   "end": 158.08,
   "text": "برید اهلش تحقیق کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.08,
   "end": 162.08,
   "text": "می‌فرماید اگر کسی بخواد از دنیا خارج بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.08,
   "end": 165.96,
   "text": "به سر سلامتی خارج بشه باید دنیا رو بشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.96,
   "end": 171.32,
   "text": ". و اگر کسی هم بخواد وارد آخرت بشه که همه قراره بریم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.32,
   "end": 173.22,
   "text": "لقای خود رب خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.22,
   "end": 179.0,
   "text": "اونجا هم باید دنیا رو بشناسه که بتونه به سر سلامتی وارد آخرت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.0,
   "end": 181.1,
   "text": "و مطلع همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.1,
   "end": 182.68,
   "text": "سند همین آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.68,
   "end": 186.52,
   "text": "اونجا میگن شما نشئه طبیعت رو نشناختید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.52,
   "end": 189.18,
   "text": "شناختید دیگه. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.18,
   "end": 191.52,
   "text": "متذکر نشدید؟ چرا غافل شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.52,
   "end": 196.26,
   "text": "غفلت ما به جهت اینه که حواس‌مون نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.26,
   "end": 199.2,
   "text": "موت بغل گوشمون بیخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.2,
   "end": 200.88,
   "text": "به قول بعضیا ریشمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.88,
   "end": 204.4,
   "text": "قراره همه بدون استثناء فقیر و غنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.4,
   "end": 210.7,
   "text": "زیردست و مدیر، ها بالا و پایین همه الحمد لله خداروشکر یه دونه مال همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.7,
   "end": 214.06,
   "text": "دیگه رسمی و غیررسمی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.06,
   "end": 218.0,
   "text": "آره مدیر و مرئوس و مسئول و غیرمسئول اینا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.0,
   "end": 221.32,
   "text": "بالا و پایین نداره. همه قراره سرشون رو بذارن رو اون خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.32,
   "end": 223.48,
   "text": "البته موت باید تعریف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.48,
   "end": 229.46,
   "text": "اجازه بدید تو این فرصت کوتاه یه حدیث چون شما تشنه حدیثید بیشتر دوست دارید حدیث بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.46,
   "end": 232.2,
   "text": "بفرمایید اینم یه حدیث .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.2,
   "end": 238.62,
   "text": "روایت اول رو براتون بخونم که البته باز عرض می‌کنم به واقع عرض می‌کنم این روایت خودش ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.62,
   "end": 240.96,
   "text": "منبر می‌طلبه در اون مایع‌ش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.96,
   "end": 243.78,
   "text": "اما من عرض می‌کنم میرم دیگه خودتون می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.78,
   "end": 248.3,
   "text": "باب اول از کتاب الموت مرحوم بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.3,
   "end": 258.28,
   "text": ". روایت امام صادق صلوات الله علیه فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.28,
   "end": 260.72,
   "text": "یه عده‌ای جمع شدن پیش پیغمبرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.72,
   "end": 266.12,
   "text": "این پیغمبر می‌تونه مال دوره‌های پیشین باشه نه دوره ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.12,
   "end": 268.74,
   "text": "چون مشخص نکرده امام صادق تو دوره ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.74,
   "end": 273.08,
   "text": "یه پیغمبری بود امت‌ش دورش رو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.08,
   "end": 276.72,
   "text": "و گفتن که دعا کن برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.72,
   "end": 279.84,
   "text": "پیش پروردگار خودت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.84,
   "end": 282.5,
   "text": "موت رو خدا از ما برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.5,
   "end": 289.62,
   "text": "خب پیغمبر دعا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.62,
   "end": 292.46,
   "text": ". چی شد؟ موت رو خدا از بین این‌ها برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.46,
   "end": 294.34,
   "text": "چه پیغمبر چه آبرویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.34,
   "end": 300.54,
   "text": "خدا موت رو به خاطرش برداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.54,
   "end": 303.7,
   "text": ". اینا زیاد شدن تعدادشون زیاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.7,
   "end": 308.36,
   "text": "منازلشون منازلشون کوچولو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.36,
   "end": 311.98,
   "text": "تعدادشون زیاد شد دیگه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.98,
   "end": 317.88,
   "text": "نسلشون خیلی زیاد شد .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.88,
   "end": 326.2,
   "text": "همین‌طوری آبا و اجداد و مادر پدرهاشون رو بچ‌کان کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.2,
   "end": 330.9,
   "text": "روزی می‌دادن. موت رو خدا برداشت نه زمین‌گیری رو، نه مریضی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.9,
   "end": 334.28,
   "text": "خب حالا طرف زمین‌گیر شده، گرفتار شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.28,
   "end": 336.84,
   "text": "این‌ها باید غذا بذارن دهنش تر و خشکش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.84,
   "end": 347.52,
   "text": "همین‌طوری آبا و اجداد پشت هم کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.52,
   "end": 352.02,
   "text": ". اینا مشغول شدن به رسیدگی به این خانواده‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.02,
   "end": 353.92,
   "text": "باز موندن از طلب معاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.92,
   "end": 357.6,
   "text": "نتونستن برن سر کار گرفتار شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.6,
   "end": 362.78,
   "text": ". دوباره برگشتن یعنی سؤال کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.78,
   "end": 366.94,
   "text": "خواهشیه. سؤال کن ربکه از پروردگار خودت ای پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.94,
   "end": 374.5,
   "text": "ای را، ای ردنا که برگردونه به ما چی رو الا آجالنا آقا همون موت رو به ما برگردون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.5,
   "end": 376.88,
   "text": "التي كنا عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.88,
   "end": 380.96,
   "text": "فسأل ربه عز وجل فرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.96,
   "end": 383.62,
   "text": "فردهم إلى آجالهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.62,
   "end": 389.28,
   "text": "دو بار برگشتن به همون حالت و موت برگشت اینو تازه فهمیدن چه حکمتی درش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.28,
   "end": 393.74,
   "text": "چه مصلحتی در موت هست که ما متاسفانه توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.74,
   "end": 398.46,
   "text": "یه موت رو برداشت خدا نظام طبیعت ریخت به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.46,
   "end": 403.06,
   "text": "حالا در مصلحت موت و حکمت موت کتاب‌ها نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.06,
   "end": 405.6,
   "text": "ارباب عرض شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.6,
   "end": 409.7,
   "text": "کتب و صحف نوریه عرفانیه مطالب عالی ای گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.7,
   "end": 418.66,
   "text": "ما هم قبلاً در پونزده مورد از حقایق موت و حقیقت موت رو که یکیش خروج از ظاهر به باطن دنیا بود رو بیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.66,
   "end": 420.94,
   "text": "این حدیث اول که درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 420.94,
   "end": 426.48,
   "text": "مطالب عالی ای داره، مخصوصاً اونجایی که میرن پیش پیغمبرشون اینم گوش بدید و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.48,
   "end": 430.3,
   "text": "میگن که از پروردگار خودت بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.3,
   "end": 436.52,
   "text": "حالا بعضی از شُرّاح مثل حضرت آقای عابدینی، حجت الاسلام عابدینی در کتاب زندگی تا ابدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.52,
   "end": 439.26,
   "text": "تعبیرش اینه که اینا معلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.26,
   "end": 449.22,
   "text": "رب کلاً نسبت به رب و ربوبیت عالم ضعیف بودن که حالت مثلاً تمسخر وار به پروردگار خودت دعا کن بگو اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 449.22,
   "end": 450.78,
   "text": "اما تعبیر بنده این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.78,
   "end": 454.58,
   "text": "بنده استنباط بنده اینه که نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.58,
   "end": 457.82,
   "text": "شاید اتفاقاً اطلاعاتشون خیلی بالا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 457.82,
   "end": 465.98,
   "text": "از این حیث که یا ایها الانسان انک كادح الی ربك كتحنف ملاقهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.98,
   "end": 470.32,
   "text": "آیه شش سوره انشقاق همه میرید تا رب خودتون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.32,
   "end": 480.26,
   "text": "ملاقات کنید. قبلاً یه بحث مفصلی داشتیم که هرکی ربی دارد، اون کانال وجودیش که به دریای لایتناهی وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.26,
   "end": 483.96,
   "text": "و توحید الصمدی خدای منّان وصل می‌شه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 483.96,
   "end": 489.32,
   "text": "کانال وجودیش رب بشه یا به یک معنا اون اسمی از اسامی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 489.32,
   "end": 491.86,
   "text": "که در ما پیاده شده رب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 491.86,
   "end": 495.62,
   "text": "و ما قراره وقتی بمیریم اون رب رو، اون اسم رو زیارت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 495.62,
   "end": 499.3,
   "text": "می‌تونه اون اسم، اسم جلالی باشه که مظهرش بشه جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.3,
   "end": 502.14,
   "text": "می‌تونه اسم جمالی باشه که مظهرش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 502.14,
   "end": 508.52,
   "text": "بهشت. حالا من می‌تونم، من حالا تعبیر بنده اینه شاید اتفاقاً اطلاعات خیلی بالا و خوبی داشتن این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 508.52,
   "end": 513.0,
   "text": "که میگن از پروردگار خودت بخواه چون می‌دونن رب پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 513.0,
   "end": 517.54,
   "text": "به مراتب خیلی بالاتره که حالا رب پیغمبر ما می‌شه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 517.54,
   "end": 520.6,
   "text": "لذا او به لقاء الله می‌ره نه به لقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.6,
   "end": 526.38,
   "text": "رب خودمون. انشاالله که خدای منّان همین قلیل رو از ما بپذیره و تذکره‌ای بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 526.38,
   "end": 528.74,
   "text": "برای کندنمون از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 528.74,
   "end": 533.76,
   "text": "مخصوصاً بعضیامون که از تو بحبوحه کار اداری و پشت میز و کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 533.76,
   "end": 536.76,
   "text": "رفت و آمد مراجعین و چی و این‌ها میان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.76,
   "end": 540.14,
   "text": "یه، یه تذکری باشه، تلنگری باشه برای هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 540.14,
   "end": 546.66,
   "text": "عاقبتمون انشاالله ختم بخیر باشه به برکت صلوات بر محمد و آل محمد. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}