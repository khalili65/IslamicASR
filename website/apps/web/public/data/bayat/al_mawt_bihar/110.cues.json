 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ روایت هشتم؛ توجه به کثرات",
   "start": 22.12,
   "end": 163.38
  },
  {
   "index": 1,
   "title": "## تمثیل قلعهٔ خیبر و قوت نفس",
   "start": 163.38,
   "end": 311.24
  },
  {
   "index": 2,
   "title": "یکی از بهترین وجوه فرمایش پیامبر اعظم در بحارالانوار، جلد شصت، صفحهٔ صد و هشتاد و سه، همین رابطه با بحث سیر در کثرت است:",
   "start": 311.24,
   "end": 389.78
  },
  {
   "index": 3,
   "title": "## تار و کابل؛ لطافت و بلندی ناله",
   "start": 389.78,
   "end": 452.32
  },
  {
   "index": 4,
   "title": "## المراقبات؛ حضور معصوم و عین ثابت",
   "start": 452.32,
   "end": 685.68
  },
  {
   "index": 5,
   "title": "## ابراهیم؛ صالحین و شیعه بودن",
   "start": 685.68,
   "end": 803.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 6.42,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.42,
   "end": 9.42,
   "text": "على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.42,
   "end": 13.74,
   "text": "محمد بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.74,
   "end": 19.46,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.46,
   "end": 22.12,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.12,
   "end": 24.28,
   "text": "در ادامه بحث روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.28,
   "end": 27.76,
   "text": "هشتم از باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.76,
   "end": 30.32,
   "text": "نکته بسیار مهمی رو که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.32,
   "end": 35.7,
   "text": "عرض می‌داریم از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.7,
   "end": 38.46,
   "text": "توجه به کثرات هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.46,
   "end": 41.42,
   "text": "این خلائق، کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.42,
   "end": 44.82,
   "text": "ما همه الیه ترجعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.82,
   "end": 51.36,
   "text": "الی المصیر. انا لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.36,
   "end": 54.54,
   "text": "به سمت الله در حرکتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.54,
   "end": 63.46,
   "text": "لکن این حرکت ناخودآگاه چه بخواهیم چه نخواهیم از دل کثرات صورت می‌گیره به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.46,
   "end": 66.76,
   "text": "یعنی همه حتی مکملین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.76,
   "end": 72.26,
   "text": "انبیا، خاتم الانبیا، ائمه علیهم الصلاة والسلام همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.26,
   "end": 76.82,
   "text": "مأمورن که از دل این کثرت، این خلقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.82,
   "end": 80.64,
   "text": "این طبیعت برن به سمت اون وحدت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.64,
   "end": 84.06,
   "text": "اون وحدت مطلقه، به سمت احدیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.06,
   "end": 89.06,
   "text": "یه وجه اینکه قرآن می‌فرماید ام در خصوص جهنم فرمود \"ام منهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.06,
   "end": 93.28,
   "text": "الا واردها\" هیچ کس نیست مگر اینکه واردش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.28,
   "end": 99.28,
   "text": "یه وجه جهنم اینجا منظور همین نشئه طبیعته، همین کثراته، همین خلائقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.28,
   "end": 102.08,
   "text": "بالاخره این‌ها حد خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.08,
   "end": 108.0,
   "text": "حد دارن. اون شدت و هدت و قدرت وحدت رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.0,
   "end": 112.84,
   "text": "ببینید الان نفس \"النفس فی وحدته کل القوی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.84,
   "end": 115.42,
   "text": "نفس، نفس من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.42,
   "end": 117.42,
   "text": "یک و-- یک حقیقته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.42,
   "end": 121.22,
   "text": "اما قوا و شعون متعدد داره، سایه‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.22,
   "end": 124.46,
   "text": "همین دست شما یک شأن نفس شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.46,
   "end": 129.26,
   "text": "دست شما به خودی خود که حرکت نمی‌کنه، نفس حرکتش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.26,
   "end": 135.2,
   "text": "در حقیقت این هم تحت امر نفسه و نفس داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.2,
   "end": 138.26,
   "text": "اما نفس قوی‌تره یا دست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.26,
   "end": 143.42,
   "text": "نفس قوی‌تره یا پا؟ قطعاً هرچی که به بالا میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.42,
   "end": 147.92,
   "text": "یعنی به سمت وحدت میری \"النفس فی وحدته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.92,
   "end": 152.48,
   "text": "یک حقیقته. مقام جمعی داره در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.48,
   "end": 157.42,
   "text": "هرچی میری به اون سمت این قوی‌تره، نفس قویه، شدید القوی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.42,
   "end": 159.46,
   "text": "اما دست می‌بینی نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.46,
   "end": 162.66,
   "text": "نفس خیلی ضعیف‌تره. هر کاری نمی‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.66,
   "end": 166.46,
   "text": "مثلاً قلعه خیبر رو، اون دروازه‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.46,
   "end": 169.16,
   "text": "به نظر شما حالا فارغ از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.16,
   "end": 174.08,
   "text": "خالی از ذهن نگاه کنید، فارغ از روایتی که خود مولا فرمودن چگونه کندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.08,
   "end": 180.64,
   "text": "این قلعه‌ای که هفتاد و پنج مرد جنگی فقط می‌تونست هلش بده بازش کنه، هلش بده به بندش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.64,
   "end": 184.48,
   "text": "مولا با دست مبارک کنده یا با نفسش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.48,
   "end": 191.26,
   "text": "به نظر شما؟ دست یا نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.26,
   "end": 194.24,
   "text": "ها؟ نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.24,
   "end": 203.54,
   "text": "احسنت. اصلاً ام-- وقتی هفتاد و پنج مرد هلش میدن که بسته بشن چگونه ممکنه با دست بکنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.54,
   "end": 207.46,
   "text": "ها؟ عالم خلقت اینا دو تا، چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.46,
   "end": 210.86,
   "text": "خود مولا فرمودن که به قول، به قوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.86,
   "end": 212.88,
   "text": "به قوت ربانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.88,
   "end": 218.64,
   "text": "لا به قوت جسمانیه یا به ق-- به قوه جسمیه نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.64,
   "end": 223.02,
   "text": "نوریه با نفسم، به قوت نفسیه، با قوه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.02,
   "end": 227.7,
   "text": "اصلاً فرمود دست من مس نکرد، لمس نکرد درو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.7,
   "end": 230.78,
   "text": "پس با نفسش به یک معنا با نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.78,
   "end": 234.46,
   "text": "خودش مولا با قدرت نفسش کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.46,
   "end": 240.0,
   "text": "توجه کردید؟ این نشون میده که چقدر نفس قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.0,
   "end": 244.7,
   "text": "اون نفس قدسی می‌تونه چه‌ها بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.7,
   "end": 246.62,
   "text": "خب وقتی که شما میای به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.62,
   "end": 249.64,
   "text": "کثرت، هرچی میای به مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.64,
   "end": 253.16,
   "text": "رتبه‌های پایین‌تر ضعف رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.16,
   "end": 254.86,
   "text": "ضعی-ضعیفی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.86,
   "end": 258.28,
   "text": "اصلاً این ضعف مال نشئه طبیعته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.28,
   "end": 261.16,
   "text": "سردرد، دل‌درد، پا درد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.16,
   "end": 263.54,
   "text": "گرفتاری، خواب‌آلودگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.54,
   "end": 265.88,
   "text": "ش-شكم‌سیری، گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.88,
   "end": 268.06,
   "text": "اینا، اینا همه مال اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.06,
   "end": 275.08,
   "text": "اونجا این حرفا نیستش که. خب اینجا وقتی که شما گرفتار کثرات می‌شی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.08,
   "end": 280.26,
   "text": "چی میاد؟ غبار میاد، غبار کثرت میاد، ضعف میاد، گرفتاری میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.26,
   "end": 283.48,
   "text": "اینکه پیغمبر عزیز عالم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.48,
   "end": 287.8,
   "text": "وجوه متعددی از این فرمایش پیغمبر فرمودن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.8,
   "end": 292.28,
   "text": "یکی از بهترین وجوهش همینه که الان عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.28,
   "end": 295.54,
   "text": "رابطه با ب-بحثی که داریم در سیر بحثمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.54,
   "end": 302.0,
   "text": "در بحار جلد شصت، صفحه صد و هشتاد و سه این روایت رو از پیغمبر عظیم الشأن اسلام می‌تونید ببینید که \"و انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.0,
   "end": 309.32,
   "text": "ليغان على قلبی\" که گه، گهگداری پیغمبر فرمود قلبم رو یه غباری می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.32,
   "end": 313.46,
   "text": "لیغان غین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.46,
   "end": 316.82,
   "text": "اِمم، به، در لغت‌شناسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.82,
   "end": 322.06,
   "text": "در کتاب‌های لغت به ابر متراکم می‌گن که بیاد آسمونو بپوشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.06,
   "end": 324.6,
   "text": "یا درختی که انبوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.6,
   "end": 326.82,
   "text": "شاخ‌هاش در هم پیچیده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.82,
   "end": 331.54,
   "text": "پوشیده شده. پیغمبر فرمود \"و انه ليغان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.54,
   "end": 336.24,
   "text": "على قلبی\" یه پوشیدگی، یه ابری، یه غباری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.24,
   "end": 339.2,
   "text": "میاد قلب من رو گه گداری می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.2,
   "end": 342.5,
   "text": "خب پیغمبر عزیز عالم چه می‌کنه که این غبار برطرف شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.5,
   "end": 346.0,
   "text": "\"فاستغفر الله فی، فی اليوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.0,
   "end": 351.24,
   "text": "سبعين مرة\". هفتاد بار هر روز استغفار می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.24,
   "end": 354.58,
   "text": "چرا؟ چون غباره. چرا این غبار از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.58,
   "end": 357.68,
   "text": "بخاطر جدات، ارتباط با کثرته، کثراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.68,
   "end": 360.42,
   "text": "مأموره، چاره‌ای هم نیست. امر الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.42,
   "end": 363.16,
   "text": "امر خداست که با خلق طرف شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.16,
   "end": 367.28,
   "text": "این‌ها آیات الهی‌اند، آثار الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.28,
   "end": 371.86,
   "text": "هیچ چاره‌ای نیست با این‌ها متو-- روبه‌رو شو، مقابل شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.86,
   "end": 374.84,
   "text": "اما بالاخره کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.84,
   "end": 380.94,
   "text": "دور از وحدته. اصلاً ناله‌های اهل بیت علیهم السلام به همین جهته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.94,
   "end": 383.68,
   "text": "شما ببینید بارها این مثال رو ما زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.68,
   "end": 386.1,
   "text": "به نظر شما کابل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.1,
   "end": 390.76,
   "text": "با نوک ناخنت بگیری ولش کنی یک کابل کشیده شده ضخیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.76,
   "end": 394.22,
   "text": "این بیشتر صدا میده یا یک تار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.22,
   "end": 396.96,
   "text": "با نوک ناخنت بکشی ولش کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.96,
   "end": 401.1,
   "text": "تار بیشتر صدا میده یا کابل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.1,
   "end": 403.32,
   "text": "ها؟ معلومه تار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.32,
   "end": 406.38,
   "text": "چرا جواب نمیدین؟ معلومه تار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.38,
   "end": 409.12,
   "text": "چرا؟ چون ظریف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.12,
   "end": 413.1,
   "text": "ظریف ها نه ضعیف نه ظریف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.1,
   "end": 415.82,
   "text": "خب کابل ضخیمه، زمخته صدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.82,
   "end": 418.96,
   "text": "اما هرچی که انسان لطیف می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.96,
   "end": 422.02,
   "text": "شریف می‌شه، ظریف می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.02,
   "end": 424.74,
   "text": "صداش بیشتر ناله‌ش بلنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.74,
   "end": 427.38,
   "text": "اون‌ها انقدر پاک‌اند، انقدر لطیف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.38,
   "end": 435.22,
   "text": "اون سر دنیا یکی گناه می‌کنه غبار گناه اون کسی که اون سر دنیا گناه کرده میاد رو دل پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.22,
   "end": 438.74,
   "text": "العیاذ بالله نه قلب خود پیغمبر العیاذالله دچار غفلت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.74,
   "end": 442.84,
   "text": "نه گناه دیگرانه. ارتباط با کثرته دیگه مجبوره چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.84,
   "end": 449.06,
   "text": "برای هدایت خلق اومده. اومده هدایت خلق کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.06,
   "end": 451.98,
   "text": "اما مجبوره. پس اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.98,
   "end": 456.92,
   "text": "حالا در المراقبات رو یادش بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.92,
   "end": 459.32,
   "text": "عزیزان بعضیا اینجا هستن یه زمان خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.32,
   "end": 462.88,
   "text": "سنشون کم بود، نوجوون بودن این المراقبات رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.88,
   "end": 465.64,
   "text": "با هم بر-بر بحث می‌کردیم درباره‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.64,
   "end": 470.6,
   "text": "اونجا تو این المراقبات امیر جواد آقای ملکی تبریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.6,
   "end": 474.24,
   "text": "که حضرت علامه صدرزاده خیلی با عظمت ازشون یاد می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.24,
   "end": 480.34,
   "text": "ایشون تو کتاب المراقباتش می‌فرماید حتی معصومین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.34,
   "end": 484.0,
   "text": "وقتی از دنیا خارج می‌شوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.0,
   "end": 488.26,
   "text": "حضورشان نسبت به دنیا تام و دائم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.26,
   "end": 493.4,
   "text": "یعنی اون حضوری که معصوم حتی به فرمایش ایشون ما نمیگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.4,
   "end": 497.66,
   "text": "از دنیا خارج میشه یعنی از کثرت فارغ می‌شه میره به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.66,
   "end": 501.52,
   "text": "اون حضوری که اونجا داره فرق می‌کنه با حضوری که اینجا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.52,
   "end": 504.42,
   "text": "لذا حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.42,
   "end": 512.74,
   "text": "حسینی تهرانی، سید حسین حسینی تهرانی علیه رحمة که بارها گفتم قبرش رو بو می‌کنی بوی بهشت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.74,
   "end": 517.5,
   "text": "ایشون در کتاب الله شناسیشون ببخشید در کتاب شرح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.5,
   "end": 520.88,
   "text": "شرح رساله سید بحر العلوم خود بنده دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.88,
   "end": 525.28,
   "text": "اونجا اشاره می‌کنند که از مرحوم دهلوی عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.28,
   "end": 531.9,
   "text": "میاره که ایشون می‌فرماید به من آگاهانیدند یعنی القا شد به من از طریق غیب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.9,
   "end": 536.62,
   "text": "پونصد سال بعد از مرگ، بعد از مرگ پونصد سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.62,
   "end": 539.44,
   "text": "تعلق روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.44,
   "end": 541.8,
   "text": "به عین ثابت باقی می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.8,
   "end": 544.5,
   "text": "یعنی بالاخره این ارتباط با کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.5,
   "end": 551.54,
   "text": "چه کنیم؟ یعنی می‌خوام بگم که لقای خدا هم مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.54,
   "end": 558.32,
   "text": "سوز و گدازی که اولیای خدا در دنیا داشتن از همین دور شدن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.32,
   "end": 562.7,
   "text": "مقام وحدت هست. اینجا هم براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.7,
   "end": 565.7,
   "text": "قرائت کنم خیلی شیرین از دعای عرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.7,
   "end": 573.34,
   "text": "ببینید واقعاً من اینا رو که توجه می‌کنم میگم ما با چه جیگری می‌شینیم سر سفره دعای عرفه می‌خونیم همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.34,
   "end": 576.58,
   "text": "به امیدی که یه فیضی بیاد اصلاً نمی‌فهمیم چی میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.58,
   "end": 578.76,
   "text": "مثل این که اصلاً قابل قیاس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.76,
   "end": 582.56,
   "text": "مثلاً بگیم تانجان ضربدر کوتانجان مساوی با دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.56,
   "end": 585.7,
   "text": "اصلاً نفهمی تانجان چیه، کوتانجان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.7,
   "end": 587.52,
   "text": "مساوی یک، یک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.52,
   "end": 590.02,
   "text": "اصلاً یک فرقش با دو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.02,
   "end": 594.4,
   "text": "همینطوری بگی. خب. نباید تو دهنمون بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.4,
   "end": 597.88,
   "text": "ابا عبدالله در دعای عرفه ببین چی می‌فرماید، چی عرض می‌کنه به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.88,
   "end": 602.08,
   "text": "\"الهی امرت بالرجوع إلى الآثار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.08,
   "end": 605.64,
   "text": "تو امر کردی که من رجوع کنم به آثار، آثار تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.64,
   "end": 608.56,
   "text": "یعنی همین خلائق. امر کردی چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 608.56,
   "end": 611.44,
   "text": "اما ببین سوز ابی عبدالله چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.44,
   "end": 618.86,
   "text": "\"فرج عنی\". انگار که میگه تو رو به خودت قسم، تو رو خدا \"فرج عنی\" منو برگردون \"إلیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 618.86,
   "end": 623.4,
   "text": "به سوی خودت. \"بکسب، بکسبة الأنوار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.4,
   "end": 627.98,
   "text": "به اون پوشش انوار خودت برگردم و \"هدایت الاستبصار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.98,
   "end": 634.0,
   "text": "برگردم با اون هدایت که بی-- همراه با بینش به سوی توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.0,
   "end": 637.08,
   "text": "\"حتی أرجع إليك منها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.08,
   "end": 639.3,
   "text": "منها این ضمیرها بر می‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.3,
   "end": 644.04,
   "text": "به آثار. تا برگردم به سوی تو از، از دست این آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.04,
   "end": 646.24,
   "text": "یعنی از این کثرت‌ها، خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.24,
   "end": 649.52,
   "text": "سوزو ببین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.52,
   "end": 654.6,
   "text": "كما دخلت ادامه‌شه \"كما دخلت إليك منها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.6,
   "end": 657.42,
   "text": "كما دخلت إليك منها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.42,
   "end": 659.52,
   "text": "به گونه‌ای من وارد بشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.52,
   "end": 662.86,
   "text": "\"إلك منها\" از دست این آثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.86,
   "end": 667.06,
   "text": "\"دخلت إليك\" به سوی تو وارد شم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.06,
   "end": 670.2,
   "text": "\"منصون السر عن النظر الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.2,
   "end": 678.52,
   "text": "به گونه‌ای که این سرم، قلبم، باطنم مصون باشه از نظر نگاه کردن الیه به اون آثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.52,
   "end": 681.84,
   "text": "یعنی اصلاً منو بکن منو ببر از این عالم راحتم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.84,
   "end": 685.36,
   "text": "\"اللهم عجل وفاتی سریعا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.36,
   "end": 687.5,
   "text": "ببین حضرت زهرا سلام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 687.5,
   "end": 691.38,
   "text": "حالا شما اینو ما در مقام قیاس نیستیم خدا در دهان ما می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 691.38,
   "end": 695.14,
   "text": "ولی بالاخره وقتی امام معصوم رو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.14,
   "end": 697.52,
   "text": "میگه حضرت ابراهیم هم شیعت اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 697.52,
   "end": 699.2,
   "text": "شیعه اونه، پیرو اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.2,
   "end": 702.4,
   "text": "\"وإنه، وإنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 702.4,
   "end": 709.78,
   "text": "لشیعته لإبراهیم\". قرآن می‌فرماید که حضرت ابراهیم هم شیعه‌اش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.78,
   "end": 714.38,
   "text": "حالا اینجا حضرت ابراهیم در این روایت میگه خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.38,
   "end": 718.94,
   "text": "برگردیم به روایت و تمام. خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.94,
   "end": 722.7,
   "text": "کدوم دوستو دیدی بخواد جون دوستشو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.7,
   "end": 724.72,
   "text": "توجه کردی؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.72,
   "end": 728.2,
   "text": "امام حسین چی میگه؟ میگه خدایا منو ببر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.2,
   "end": 731.26,
   "text": "راحت کن اصلاً من نگاه نکنم آثار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.26,
   "end": 735.44,
   "text": "\"الهی ترددی في الآثار یوجب بعد المزار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.44,
   "end": 739.68,
   "text": "این رفت و آمد من بین آثار تو، بین کثرات، بین خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.68,
   "end": 742.1,
   "text": "دورم می‌کنه از زیارت تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.1,
   "end": 744.92,
   "text": "الله اکبر. این آقا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 744.92,
   "end": 750.96,
   "text": "اینطوری سعه داره که بتونه دست همه خلائقو بگیره سوار کشتی خودش بکنه ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 750.96,
   "end": 761.28,
   "text": "حضرت ابراهیم به مقام صالحین می‌رسه و ای-ولی در آیه سیصد و سی بقره می‌فرماید \"وإنه في الآخرة لمن الصالحین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 761.28,
   "end": 765.28,
   "text": "مقام صالحین رو در آخرت به حضرت ابراهیم میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.28,
   "end": 767.84,
   "text": "آقا اینطوری نیست که ما فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 767.84,
   "end": 774.1,
   "text": "یعنی من متأسفم با یکی از عزیزان که هفده سال درس خارج یکی از مراجع اعلم اسلامی برا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 774.1,
   "end": 780.46,
   "text": "رفته بود ما بحثمون بالا گرفت که ایشون قبول نداشت امیرالمؤمنین بالاتر از حضرت ابراهیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 780.46,
   "end": 785.64,
   "text": "گفت نخ انبیا مخصوصاً اولو العظم از حضرت امیر بالاترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 785.64,
   "end": 791.34,
   "text": "حالا ما چی بگیم به اینا؟ درس خونده هفده سال درس خارج بخونه نفهمه اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 791.34,
   "end": 793.16,
   "text": "انشاالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 793.16,
   "end": 796.38,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 796.38,
   "end": 798.42,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 798.42,
   "end": 803.42,
   "text": "على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}