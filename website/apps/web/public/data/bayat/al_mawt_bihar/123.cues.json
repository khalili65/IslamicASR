 "chapters": [
  {
   "index": 0,
   "title": "## حکم اقتدا به نماز قضای احتیاطی",
   "start": 20.7,
   "end": 40.82
  },
  {
   "index": 1,
   "title": "## بازگشت به روایت دهم از باب چهارم",
   "start": 40.82,
   "end": 138.9
  },
  {
   "index": 2,
   "title": "## یقینی‌ترین مخلوق؛ مرگ",
   "start": 138.9,
   "end": 482.6
  },
  {
   "index": 3,
   "title": "## مرگ؛ قیامت صغری",
   "start": 482.6,
   "end": 563.8
  },
  {
   "index": 4,
   "title": "## زیارت؛ ترازوی رابطه با امام",
   "start": 563.8,
   "end": 691.0
  },
  {
   "index": 5,
   "title": "## اقرأ کتابک؛ نوشتن و خواندنِ خود",
   "start": 691.0,
   "end": 781.96
  },
  {
   "index": 6,
   "title": "## دگرگونی زندگی با معرفت موت",
   "start": 781.96,
   "end": 832.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 2.74,
   "text": "صلی الله علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.74,
   "end": 11.68,
   "text": "و آل محمد. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.68,
   "end": 15.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.38,
   "end": 20.7,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.7,
   "end": 23.84,
   "text": "اگر کسی احتیاطاً نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.84,
   "end": 27.68,
   "text": "قضا داره می‌خونه ما نمی‌تونیم بهش اقتدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.68,
   "end": 36.46,
   "text": "یعنی احتیاط می‌کنه، شک داره که آیا نماز قضا داره یا نه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.46,
   "end": 42.14,
   "text": "از این حیث وایساده احتیاطاً نماز قضا برای خودش داره می‌خونه، نمی‌تونیم بهش اقتدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.14,
   "end": 45.44,
   "text": "خودش می‌تونه احتیاطاً برای خودش نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.44,
   "end": 50.5,
   "text": "قضا بخونه به جهت که اما کسی نمی‌تونه بهش اقتدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.5,
   "end": 58.84,
   "text": "و اگر می‌خواد خودش می‌دونه که می‌خواد جماعت وایسته، یه سری می‌خوان بهش اقتدا کنن، حق نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.84,
   "end": 61.92,
   "text": "احتیاطاً نماز قضا بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.92,
   "end": 64.62,
   "text": "حالا اگر خودش نماز قضا نداشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.62,
   "end": 68.12,
   "text": "نمازشو خونده، می‌خواد یه عده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.12,
   "end": 70.36,
   "text": "میگن حاج آقا وایسا جلو. میگه من نماز خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.36,
   "end": 74.48,
   "text": "میگن نماز قضا بخون. خب نماز قضا ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.48,
   "end": 78.92,
   "text": "احتیاط، حالا احتیاطاً شاید قضا داری بخون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.92,
   "end": 85.92,
   "text": "مگر به نیت از میتی که از دنیا رفته و ایشون یقین داره که اون میت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.92,
   "end": 90.94,
   "text": "قضا داره به نیت اون آقا، اون شخص، اون خانم وایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.94,
   "end": 96.12,
   "text": "نماز قضای اونو بخونه بقیه بهش اقتدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.12,
   "end": 100.24,
   "text": "میریم سراغ روایت دهم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.24,
   "end": 102.72,
   "text": "کتاب الموت مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.72,
   "end": 106.4,
   "text": "یه اشکالی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.4,
   "end": 110.74,
   "text": "اشتباهی که مرتکب شدم جلسه پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.74,
   "end": 113.44,
   "text": "حواسم نبوده و دو تا روایت رو جا انداختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.44,
   "end": 119.12,
   "text": "این روایت دهم و یازدهم رو من نخوندم، رفتم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.12,
   "end": 124.48,
   "text": "دوازدهم. هیچکس هم هیچی به ما نگفت که حاج آقا دهم و یازدهم رو نگفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.48,
   "end": 127.42,
   "text": "حالا برگشت می‌کنیم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.42,
   "end": 130.98,
   "text": "روایت دهم. اون روایت دوازدهم رو که ما تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.98,
   "end": 137.06,
   "text": "شروع کردیم به بیانش، اون باشه بر سلسله بحث‌ها بعداً که انشاالله بهش رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.06,
   "end": 140.22,
   "text": "در این روایت، روایت از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.22,
   "end": 143.5,
   "text": "صادق صلوات الله علیه هست که حضرت فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.5,
   "end": 150.64,
   "text": "\"لم يخلق الله عز وجل یقیناً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.64,
   "end": 155.32,
   "text": "لا شک فيه\" خدا خلق نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.32,
   "end": 159.1,
   "text": "چیزی رو که یقینیه و هیچ شکی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.1,
   "end": 164.7,
   "text": "\"أشبه بشک لا يقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.7,
   "end": 168.78,
   "text": "فيه من الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.78,
   "end": 176.42,
   "text": "شبیه‌تر از موت که البته مردم چگونه باهاش رفتار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.42,
   "end": 182.24,
   "text": "به شکل برعکس، به شکل لا يقين فیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.24,
   "end": 186.28,
   "text": "به یک شکی که اصلا هیچ یقینی انگار توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.28,
   "end": 188.94,
   "text": "یعنی به شدت به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.94,
   "end": 193.28,
   "text": "مشکوکن. یه بار دیگه عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.28,
   "end": 197.4,
   "text": "مضمون روایت اینه. خدا میگه هیچ چیزی رو بین خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.4,
   "end": 200.36,
   "text": "عرض کردیم که خلق الموت و الهیات دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.36,
   "end": 203.78,
   "text": "موت هم یک خلقه که ما قراره بچشیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.78,
   "end": 206.42,
   "text": "کل نفس ذائقه الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.42,
   "end": 208.2,
   "text": "قراره بچشیمش، نه بمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.2,
   "end": 211.12,
   "text": "قراره بچشیم مثل یه جور نوشابه که یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.12,
   "end": 214.32,
   "text": "شربت و آب که می‌خوری اینجوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.32,
   "end": 217.98,
   "text": "میگه خدا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.98,
   "end": 221.14,
   "text": "امام صادق صلوات الله علیه فرمود خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.14,
   "end": 225.88,
   "text": "خلق نکرده هیچ چیزی رو که به این یقینی باشه که هیچ شکی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.88,
   "end": 233.36,
   "text": "چی؟ موت. یعنی انقدر یقینیه دیگه یقینی‌ترین چیزهاست که هیچ شکی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.36,
   "end": 236.12,
   "text": "اما مردم باهاش چجوری رفتار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.12,
   "end": 239.42,
   "text": "مثل شکی که هیچ یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.42,
   "end": 243.52,
   "text": "برعکس. یعنی به شدت مشکوکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.52,
   "end": 249.78,
   "text": "یعنی واقعاً ها، واقعاً طبق این روایت این گوش ما رو داره می‌پیچونه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.78,
   "end": 251.92,
   "text": "واقعاً خودم، خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.92,
   "end": 256.04,
   "text": "الان تو وجدان و خلوت کده وجود خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.04,
   "end": 261.7,
   "text": "اگر واقعاً ما یقین، یقین، یقین داشتیم که قراره بریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.7,
   "end": 272.9,
   "text": "اینجوری زندگی می‌کردیم؟ یعنی واقعاً یقین داشتیم که کار تمام است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.9,
   "end": 275.88,
   "text": "قیامت داشته باشیم گناه نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.88,
   "end": 279.62,
   "text": "اون هم می‌شه بحثه. حاج آقا می‌فرمایند که شاید منظور قیامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.62,
   "end": 283.94,
   "text": "اولاً صریحاً و تصریحاً روایت داره میگه موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.94,
   "end": 288.52,
   "text": "اما اون صحبت رو هم می‌شه فرمایش امام خمینی علیه الرحمه رو هم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 288.52,
   "end": 291.14,
   "text": "بهش یعنی در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.14,
   "end": 295.94,
   "text": "قرار داد. چگونه است؟ این‌که موت یه رشه‌ای از قیامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.94,
   "end": 297.94,
   "text": "اصلا پیغمبر انگشتاشو اینجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.94,
   "end": 304.38,
   "text": "دو تا انگشت اشاره سمت راست و چپ و انگشت چپ و راستو اینجوری به هم چسبوندن به این شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.38,
   "end": 307.36,
   "text": "و فرمودن \"أن و القيامة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.36,
   "end": 309.62,
   "text": "كهاتان كهاتان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.62,
   "end": 312.62,
   "text": "مثل این دو تا من و قیامت یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.62,
   "end": 315.42,
   "text": "چسبیدیم به هم، انقدر به هم نزدیکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.42,
   "end": 318.54,
   "text": "پیغمبر، قیامت چه ربطی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.54,
   "end": 320.82,
   "text": "بزرگان فرح-- حالا الان عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.82,
   "end": 327.22,
   "text": "فرمودن که همین جا الان قیامت عارف قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.22,
   "end": 329.9,
   "text": "همین الان شما نمی‌دونی حالت چطوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.9,
   "end": 332.9,
   "text": "وقتی کارا خوب می‌کنی چگونه ابه-- ابتهاج داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.9,
   "end": 334.68,
   "text": "انبساط داری؟ یعنی بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.68,
   "end": 336.74,
   "text": "الان داری بهشتو درک می‌کنی. قیام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.74,
   "end": 341.38,
   "text": "قیامتت قیام کرده. خدایی نکرده یه گناهی، معصیتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.38,
   "end": 346.26,
   "text": "ازمون سر بزنه، چجوری؟ قشنگ درون خودم احساس می‌کنم تاریک شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.26,
   "end": 348.0,
   "text": "حالم بده. دست از سرم بردارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.0,
   "end": 350.5,
   "text": "حالم خوب نیست. این یعنی جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.5,
   "end": 354.54,
   "text": "یه رشه‌ای از جهنمه. که حالا تو مسائل طبیعی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.54,
   "end": 360.18,
   "text": "فرمود بیشترین نصیبی که مؤمن از آتش جهنم می‌بره چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.18,
   "end": 362.6,
   "text": "بیشترین نصیبی که مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.6,
   "end": 365.94,
   "text": "از آتش جهنم می‌بره همین تبه که تو این دنیا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.94,
   "end": 370.76,
   "text": "تب داغ می‌کنی. این بیشترین نصیب مؤمن از آتش جهنمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.76,
   "end": 373.24,
   "text": "اینم یه رشفه هست. حالش بد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.24,
   "end": 375.92,
   "text": "سرش داغ می‌شه. سردرد می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.92,
   "end": 378.9,
   "text": "اینم از اونجاست. برای این از دست یه سر یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.9,
   "end": 381.8,
   "text": "یتیم می‌کشی، یه کار خیر می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.8,
   "end": 389.1,
   "text": "سنگ رو از جلوی عابر برمی‌داری و اول اصلاً احساس انبساط خاطر می‌کنی یعنی بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.1,
   "end": 393.52,
   "text": "یک رشفه است. قیامت همین جا به پا کرده، به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.52,
   "end": 396.86,
   "text": "خیلی از ما ادعا می‌کنیم آقا بیا آقا بیا سربازت باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.86,
   "end": 400.62,
   "text": "خب آقا تشریف بیارن می‌خوای چیکارش می‌خوای چیکار کنی برای آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.62,
   "end": 403.32,
   "text": "ها؟ مثلاً می‌خوای کمک حال حضرت باشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.32,
   "end": 406.92,
   "text": "خب چرا الان کمک حال همین مردم نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.92,
   "end": 414.58,
   "text": "به قول خیلی جمله‌ی شیرینی فرمودن خدا رحمتشون کنه از آیش حضرت آیش شیرازی، آیش خائری شیرازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.58,
   "end": 417.48,
   "text": "ایشون می‌فرمودند که آقا کسی که ادعا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.48,
   "end": 419.8,
   "text": "اللهم عجل لولیک الفرج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.8,
   "end": 422.1,
   "text": "آقا بیا من منتظرتم فلان، دروغ می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.1,
   "end": 426.52,
   "text": "اگر الان مثل یه پوست موز می‌بینه رو زمین افتاده برش نمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.52,
   "end": 428.8,
   "text": "الان گره از کار کسی باز نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.8,
   "end": 431.5,
   "text": "انبساط در وجود کسی ایجاد نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.5,
   "end": 433.86,
   "text": "مردم از دست و زبانش در امان نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.86,
   "end": 436.1,
   "text": "خب الان فرج داشته باش برای مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.1,
   "end": 439.3,
   "text": "تو محل گشایش برای دیگران باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.3,
   "end": 441.86,
   "text": "تا وقتی آقا اومد به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.86,
   "end": 446.24,
   "text": "کلی‌تر، بیشتر، برکتش بیشتر با عنایت حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.24,
   "end": 449.14,
   "text": "الان فرج ایجاد کن که اون موقع باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.14,
   "end": 454.84,
   "text": "با ادعا و این‌ها که حالا حضرت تشریف بیارن من الامدارش بشم، قاسم سلیمانی‌ش بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.84,
   "end": 457.28,
   "text": "ادعا من از همه شما مدعی‌ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.28,
   "end": 460.64,
   "text": "الان چی کاره‌ای؟ کسی که نشونه داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.64,
   "end": 463.32,
   "text": "کسی که به قول شهید سلیمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.32,
   "end": 465.9,
   "text": "کیو شهید می‌کنند؟ کسی که شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.9,
   "end": 469.24,
   "text": "کسی که شهید زندگی می‌کنه شهیدش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.24,
   "end": 473.54,
   "text": "کسی الان سرباز آقاست بار برمی‌داره از روی دوش مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.54,
   "end": 477.2,
   "text": "قطعاً اون موقع حضرت هم تشریف بیارن سرباز حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.2,
   "end": 479.94,
   "text": "می‌خوام بگم اینا یک تلازمی بینش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.94,
   "end": 483.76,
   "text": "قیامت همین الان به پاست. اصلاً خود موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.76,
   "end": 487.1,
   "text": "خود موت رو بعضیا بهش گفتن حاج آقا مرادی که فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.1,
   "end": 491.54,
   "text": "خود موت رو بعضیا فرمودن یعنی قیامت صغری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.54,
   "end": 496.64,
   "text": "قیامت صغری. وکشف ما عن قطاعک فبصرک اليوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.64,
   "end": 499.54,
   "text": "وقتی پرده بیفته چشم تیز می‌شه حقایق رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.54,
   "end": 501.28,
   "text": "سفر از ظاهر به باطن می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.28,
   "end": 504.58,
   "text": "حقیقت يوم تبلی السرائر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.58,
   "end": 507.9,
   "text": "سریرت‌ها اون باطن خودش برای خودش آشکار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.9,
   "end": 511.5,
   "text": "باطن عالم، باطن خودش، باطن اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.5,
   "end": 513.58,
   "text": "همه چی رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.58,
   "end": 518.44,
   "text": "این قیامت صغراست. حالا باش تا اون حسابرسی کلی و آخری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.44,
   "end": 522.66,
   "text": "حالا پیغمبر هم که می‌فرمود ان ولقیامه کهاتا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.66,
   "end": 524.92,
   "text": "این دو تا انگشتش رو می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.92,
   "end": 529.38,
   "text": "اگر اهلش بود، اگر اهلش اونجا جلو پیغمبر بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.38,
   "end": 531.68,
   "text": "پیغمبر شاید می‌فرمود اصلاً ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.68,
   "end": 534.68,
   "text": "ان ان القيامه اصلاً قیامت منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.68,
   "end": 541.44,
   "text": "نه اینکه بخواد به خاطر اینکه یه سری ظرفیتشو ندارن بگه من و قیامت مثل این دو تا انگشت چسبیده به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.44,
   "end": 545.4,
   "text": "چون امیرالمؤمنین فرمود به کمیل فرمود قیامت منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.4,
   "end": 550.52,
   "text": "اصلاً من قیامتم. چگونه است که شما یه بار ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.52,
   "end": 553.46,
   "text": "یه بحثی رو مطرح کردیم بچه‌ها هم تو کانال گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.46,
   "end": 559.24,
   "text": "نمی‌دونم پنج جلسه چقدر طول کشید تو حرم علی ابن موسی الرضا علیه السلام صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.24,
   "end": 563.8,
   "text": "اونجا حرفمون چی بود؟ اقامه قیامت در محضر امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.8,
   "end": 567.4,
   "text": "وقتی شما میری زیارت می‌کنی قیامتت به پا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.4,
   "end": 571.92,
   "text": "اصلاً بعد و قربت به امام مشخص می‌کنه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.92,
   "end": 576.64,
   "text": "جایگاهت کجاست. ارتباطت، انتصابت با امام همه می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.64,
   "end": 579.48,
   "text": "اصلاً قیامت به پا می‌شه. وقتی میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.48,
   "end": 583.18,
   "text": "حرم چه حالتی داری؟ حالت-- حضرت با تو چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.18,
   "end": 585.48,
   "text": "مشخص می‌شه چون او میزانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.48,
   "end": 588.62,
   "text": "الان تو رو سوار میزان نشستی رو ترازو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.62,
   "end": 594.34,
   "text": "خودتو داری می‌کشی. یک در حقیقت یک وزن کشی صورت می‌گیره در حرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.34,
   "end": 596.86,
   "text": "در حرم امام، انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.86,
   "end": 599.06,
   "text": "مشخص می‌شه تعارفم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.06,
   "end": 603.04,
   "text": "معلوم می‌شه رابطه‌ت با امام چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 603.04,
   "end": 606.52,
   "text": "یعنی یک کسی میره از همون اول تا انتها اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.52,
   "end": 610.42,
   "text": "وقتی وارد صحن حرم می‌شه واقعاً وارد بهشت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.42,
   "end": 613.88,
   "text": "واقعاً معراج رفته اصلاً حال خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.88,
   "end": 616.6,
   "text": "یک پارچه انبساط و ابتهاج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.6,
   "end": 618.92,
   "text": "قربونت برم حضرت. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.92,
   "end": 621.66,
   "text": "دائماً قربون صدقه حضرت می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 621.66,
   "end": 624.1,
   "text": "نمی‌ره بشینه خب حاج-- حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.1,
   "end": 630.04,
   "text": "آقا دفعه پیش که من خدمتتون رسیدم این چکم رو پاس کردی حالا این چکم مونده نوبت این رسیده لطفاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.04,
   "end": 634.78,
   "text": "این حرفا چیه؟ می‌رسه محضر حضرت رابطه‌ش با حضرت معلوم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 634.78,
   "end": 637.52,
   "text": "کسی هم اومده مریضش شفا بگیره اونم درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.52,
   "end": 640.18,
   "text": "کجا بره جز اینجا؟ فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 640.18,
   "end": 642.94,
   "text": "اذا نزلت بکم خود حضرت فرمودند، امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.94,
   "end": 645.6,
   "text": "چقدر شیرینه این روایت. اذا نزلت بکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 645.6,
   "end": 647.76,
   "text": "بکم شدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.76,
   "end": 651.98,
   "text": "وقتی یک موضوع مثل شدیدی مشکلی برای شما پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.98,
   "end": 654.32,
   "text": "فاستعینوا بنا از ما کمک بخواهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.32,
   "end": 660.52,
   "text": "درست، به حق. اما شدیدتر از موت و قیامت هم داریم که توقع-- اصلاً توجه بهش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.52,
   "end": 664.98,
   "text": "فقط مسائل دنیا. همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.98,
   "end": 666.82,
   "text": "وقتی رفت حرم مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 666.82,
   "end": 669.74,
   "text": "یکی هم بیچاره اصلاً حوصله نداره زیارتنامه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.74,
   "end": 672.24,
   "text": "حوصله نداره بلکه نماز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.24,
   "end": 674.8,
   "text": "چرا؟ جهنمه وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 674.8,
   "end": 676.64,
   "text": "رابطه‌ش با امام مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 676.64,
   "end": 678.8,
   "text": "همین جا قیامتش به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 678.8,
   "end": 682.86,
   "text": "اصلاً همین جا بل الإنسان على نفسه بصيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 682.86,
   "end": 685.38,
   "text": "بصیره. بصیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.38,
   "end": 689.38,
   "text": "مبالغه است. به شدت هر کسی خودش می‌دونه چی‌کاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 689.38,
   "end": 691.0,
   "text": "خودش سر خودش کلاه نزاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 691.0,
   "end": 694.34,
   "text": "اقرأ كتابك. آخرش هم خودت کتاب خودتو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 694.34,
   "end": 697.38,
   "text": "کتاب هم خودتی. خودت داری با اعمال و علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.38,
   "end": 700.0,
   "text": "و علم و عملت که جوهره اند انسان‌ساز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 700.0,
   "end": 707.24,
   "text": "انسان‌ساز داری کتاب وجودی خودت رو سطر به سطر نون والقلم و مایسترون می‌نویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 707.24,
   "end": 710.3,
   "text": "خودت رو داری خودت می‌نویسی، می‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 710.3,
   "end": 712.66,
   "text": "خودتم قراره خودت رو بخوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 712.66,
   "end": 714.92,
   "text": "آشکار می‌شه باطن خودت. این یعنی موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 714.92,
   "end": 717.14,
   "text": "چیزی جز این نیست. موت یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 717.14,
   "end": 720.7,
   "text": "آشکار شدن باطن خودت برای خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 720.7,
   "end": 723.34,
   "text": "البته دو وجه داره یا دو قدم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 723.34,
   "end": 726.06,
   "text": "یه قدمش برای خودته، خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 726.06,
   "end": 727.94,
   "text": "یه قدمش هم نظام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 727.94,
   "end": 730.94,
   "text": "نظام افقی برای تو آشکار می‌شه هر دوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 730.94,
   "end": 735.06,
   "text": "یعنی وقتی می‌میری نه اینکه از این دنیا خارج شیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 735.06,
   "end": 738.08,
   "text": "پیغمبر فرمود آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 738.08,
   "end": 740.64,
   "text": "در دل تو همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 740.64,
   "end": 746.84,
   "text": "همراه همین دنیاست. یعنی تو همین دنیا باطن این دنیا رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 746.84,
   "end": 752.36,
   "text": "الان از حیث مکانی ارواح ما مکان خاصی ندارن تو بری دنبالش بگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 752.36,
   "end": 754.96,
   "text": "مثلاً یه کجا اون مکانو نشونم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 754.96,
   "end": 759.72,
   "text": "باطن همین عالمن. مثل اینکه من و شما می‌خوابیم ان نام اخی الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 759.72,
   "end": 762.38,
   "text": "می‌ریم تو باطن خودمون. مگه همینجا نیستی الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 762.38,
   "end": 764.62,
   "text": "همینجا که خوابیدی. همینجایی الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 764.62,
   "end": 767.28,
   "text": "اما باطن رفتی تو باطن وجودی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 767.28,
   "end": 769.96,
   "text": "در اون چی؟ رتبه مثالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 769.96,
   "end": 772.78,
   "text": "مثال متصل وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 772.78,
   "end": 774.44,
   "text": "حالا ارواح مثال منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 774.44,
   "end": 777.48,
   "text": "بیرون از توئه. ولی اون‌ها باطن این عالمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 777.48,
   "end": 780.36,
   "text": "تو هم ما هم قراره بریم. چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 780.36,
   "end": 783.04,
   "text": "یعنی بارها اینو ما عرض کردیم. سفر موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 783.04,
   "end": 786.78,
   "text": "اگر ما بدونیم چه گره‌هایی حالا بسه دیگه وقت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 786.78,
   "end": 788.66,
   "text": "حالا تو اصل حدیث موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 788.66,
   "end": 793.04,
   "text": "سؤال عزیز دلم بذار ما رو با حاشیه برده نمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 793.04,
   "end": 799.46,
   "text": "اگر ما بدونیم چه گره‌هایی از ما باز می‌شه، از حیث معرفت نسبت به موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 799.46,
   "end": 802.52,
   "text": "شناخت موت و قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 802.52,
   "end": 805.84,
   "text": "و سیر استکمالی برزخ که بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 805.84,
   "end": 808.84,
   "text": "نشئ ما چه، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 808.84,
   "end": 814.56,
   "text": "راه‌هایی رو باید طی کنیم و کجاها و منازلی که قراره بریم، چه اتفاقاتی قراره بیفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 814.56,
   "end": 816.74,
   "text": "اصلاً زندگی‌مون دگرگون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 816.74,
   "end": 818.86,
   "text": "طرز فکرمون از این رو به اون رو می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 818.86,
   "end": 821.96,
   "text": "یه آدم دیگه‌ای می‌شیم اینطوری به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 821.96,
   "end": 823.74,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 823.74,
   "end": 826.82,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 826.82,
   "end": 832.86,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}