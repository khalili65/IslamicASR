 },
 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از ابراهیم؛ چرا زمان مرگ اعلام نمی‌شود",
   "start": 9.6,
   "end": 116.06
  },
  {
   "index": 1,
   "title": "## کافی؛ أنتم لنا فرط و إنا بکم لاحقون",
   "start": 116.06,
   "end": 236.28
  },
  {
   "index": 2,
   "title": "## وصف الموت؛ نسیم برای مؤمن، نیش برای کافر",
   "start": 236.28,
   "end": 414.06
  },
  {
   "index": 3,
   "title": "## چرا بعضی آسان و بعضی سخت جان می‌دهند",
   "start": 414.06,
   "end": 715.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.22,
   "end": 6.76,
   "text": "به این استعین. السلام علیک ای داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.76,
   "end": 9.6,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.6,
   "end": 15.46,
   "text": "در روایتی دیدم که از حضرت ابراهیم سؤال قشنگی شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.46,
   "end": 23.56,
   "text": "پرسیده بودند که آقا چقدر خوب می‌شد که شما که پیغمبر خدا هستید قبل از اینکه ما بمیریم خبر می‌دادید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.56,
   "end": 26.2,
   "text": "به ما می‌گفتید کِی می‌میرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.2,
   "end": 28.84,
   "text": "بالاخره شما عالم به غیبید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.84,
   "end": 31.36,
   "text": "و موت هم که برای همه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.36,
   "end": 33.98,
   "text": "الذي خلق الموت والحياة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.98,
   "end": 36.7,
   "text": "ليبلوكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.7,
   "end": 39.54,
   "text": "أیكم أحسن عملا. برای همه‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.54,
   "end": 43.1,
   "text": "حالا که همه قراره بمیریم و بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.1,
   "end": 47.8,
   "text": "روایت پنجم از باب اول کتاب الموت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.8,
   "end": 55.32,
   "text": "این موت رو خدا جعل کرده، خدا ایجاد کرده در کنار مریضی و فقر که ما رو از تکبر به زیر بکشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.32,
   "end": 59.6,
   "text": "و خاشع کنه. خب ما هم خیلی شاید آمادگی نداشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.6,
   "end": 66.9,
   "text": "اما اگه بدونیم که کِی قراره بمیریم مثلا فردا قراره بمیریم، پس فردا، دور از جون همه‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.9,
   "end": 69.24,
   "text": "بالاخره آدم آماده‌تر می‌شه دیگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.24,
   "end": 74.7,
   "text": "اینطوریه قاعده. چقدر قشنگ حضرت ابراهیم جواب دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.7,
   "end": 78.86,
   "text": "فرمودند که به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.86,
   "end": 82.36,
   "text": "علامت‌هاش و اعلاماتش بیان نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.36,
   "end": 84.56,
   "text": "شما توجه ندارید. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.56,
   "end": 89.76,
   "text": "فرمودند چطور نمی‌بینی در همسایگانت کسانی مریض می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.76,
   "end": 93.12,
   "text": "حالشون بد می‌شه، به حال نزار می‌افتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.12,
   "end": 95.86,
   "text": "یا خبر موت دور و بریا بهت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.86,
   "end": 99.04,
   "text": "این اعلام اینه که تو هم آماده باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.04,
   "end": 103.0,
   "text": "تو هم آماده باش که نوبت تو هم می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.0,
   "end": 106.22,
   "text": "خیلی قشنگ جواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.22,
   "end": 108.8,
   "text": "واقعاً دندان شکنیه به قولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.8,
   "end": 115.24,
   "text": "دهن‌ها رو می‌بنده. خب این همه در کنار ما چرا ما برای خودمون باور نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.24,
   "end": 120.2,
   "text": "و اتفاقاً در روایتی دیدم خیلی جالب بود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.2,
   "end": 124.48,
   "text": "اهل بیت علیه السلام پیغمبر فرمودند امام صادق صلوات الله علیه فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.48,
   "end": 129.0,
   "text": "که کتاب کافی خدا رحمت کنه ما خیلی جوون‌تر بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.0,
   "end": 133.52,
   "text": "حدود شاید بیست سالمون بود. این دوره کافی رو خوندیم و یه جا تدریس کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.52,
   "end": 137.32,
   "text": "ما که هیچی نمی‌فهمیدیم البته الان پشیمونیم میگیم اون موقع خام بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.32,
   "end": 143.08,
   "text": "اینا رو کار می‌کردیم اما الان همون درون مایه اون موقع ما رو حفظ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.08,
   "end": 147.32,
   "text": "کافی مرحوم کلینی اولین کتاب 四 arbaعه شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.32,
   "end": 149.56,
   "text": "به به به. که مؤنَن کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.56,
   "end": 152.9,
   "text": "عنوان‌بندی کرد احادیث رو برای اولین بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.9,
   "end": 156.0,
   "text": "از بین چهارصد اصلی که امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.0,
   "end": 162.26,
   "text": "از امام صادق و شاگردانش به دستش رسیده بود، از شش هزار و ششصد اصل که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.26,
   "end": 166.9,
   "text": "جلد سه صفحه دویست و بیست و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.9,
   "end": 169.8,
   "text": "فرمود وقتی دیدید یکی مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.8,
   "end": 174.08,
   "text": "رو کنید بهش و بگید حالا یا قبرستون رفتید یا بالاخره خبر رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.08,
   "end": 181.92,
   "text": "مثلا دیروز عزیز دل ما حاج حسین آقای قربانی خبر دادن که پدرشون از دنیا رفت و دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.92,
   "end": 185.26,
   "text": "روحش شاد. روح رفتگان هممون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.26,
   "end": 190.04,
   "text": "به پشت سر این شخص رو شنیدید بگید أنتم لنا فَرَطٌ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.04,
   "end": 196.08,
   "text": "شما زودتر از ما رفتید، پیشی گرفتید و أنا و قطعاً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.08,
   "end": 199.14,
   "text": "إن شاء الله بكم لاحقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.14,
   "end": 202.76,
   "text": "عجب و انشاالله ما هم به شما ملحقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.76,
   "end": 208.02,
   "text": "چقدر ما بدمون میاد از موت. اما دیگه میگه ما برای خیلی کارها میگیم انشاالله، انشاالله اینطور بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.02,
   "end": 210.58,
   "text": "انشاالله. میگه بهش بگو انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.58,
   "end": 214.6,
   "text": "ما هم به شما ملحق می‌شیم که باور کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.6,
   "end": 217.36,
   "text": "یعنی باورش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.36,
   "end": 220.0,
   "text": "انشاالله ما هم به شما ملحق می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.0,
   "end": 222.66,
   "text": "الحاقه. قراره بریم ملحق شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.66,
   "end": 226.3,
   "text": "متأسفانه غفلت بیچاره کرده ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.3,
   "end": 228.78,
   "text": "بیچاره کرده واقعاً. که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.78,
   "end": 234.4,
   "text": "این چه برای آدم بد، چه برای خوب، برای هر دو موت خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.4,
   "end": 241.34,
   "text": "توجه داشته باشید. درسته در روایت چهارم، چهارم عرض کردیم در کتاب الموت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.34,
   "end": 247.78,
   "text": "برای مؤمن رحمت و بشارته، برای کافرین و این‌ها عذاب و نقمته، بدبختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.78,
   "end": 251.2,
   "text": "اما از این جهت نگاه کنی برای هر دو خیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.2,
   "end": 256.34,
   "text": "که مؤمن میره به ثواب کارهاش می‌رسه، در روح و ریحان الهی قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.34,
   "end": 259.7,
   "text": "کافر چی؟ دیگه بیشتر از این گناه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.7,
   "end": 262.06,
   "text": "بسه. یعنی دیگه می‌برنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.06,
   "end": 267.78,
   "text": "قصش می‌کنند. که انکه عذابش رو دارن کمتر می‌کنند چون هرچی می‌مونه عذابش بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.78,
   "end": 273.48,
   "text": "بازم به یک معنا موت برای کفار هم حتی از این حیث نگاه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.48,
   "end": 276.12,
   "text": "بازم خوبه. باز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.12,
   "end": 278.18,
   "text": "رحمت حضرت حقه به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.18,
   "end": 281.3,
   "text": "مثل جهنم هم به قول حضرت امام علیه الرحمه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.3,
   "end": 284.42,
   "text": "رحمت خداست. تبعیدگاه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.42,
   "end": 287.88,
   "text": "بسوز تا اصلاح شی، نخالصی‌هات بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.88,
   "end": 289.74,
   "text": "خدا هم پدر کشتگی با کسی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.74,
   "end": 292.1,
   "text": "در صلح و آشتی دائم با بندگانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.1,
   "end": 296.42,
   "text": "همه رو می‌خواد ببره در بهشت نعیم خودش استقرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.42,
   "end": 298.74,
   "text": "اما ماها فرار می‌کنیم. حواسمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.74,
   "end": 302.44,
   "text": "در یه روایت قشنگ و شیرینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.44,
   "end": 304.4,
   "text": "دیدم که اینو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.4,
   "end": 306.44,
   "text": "خیلی قشنگه از تفسیر اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.44,
   "end": 308.48,
   "text": "حالا سه جا می‌تونید اینو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.48,
   "end": 316.02,
   "text": "یکی تفسیر اهل بیت جلد شونزده صفحه چهارصد و چهارده، یکی عین اخبار رضا جلد یک صفحه دویست و هفتاد و چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.02,
   "end": 321.6,
   "text": "یکی هم نور الثقلین. اینجا نور الثقلین که تفسیر خیلی خوبی‌ست، تفسیر روایی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.6,
   "end": 324.72,
   "text": "موسی بن جعفر صلوات الله علیهما می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.72,
   "end": 328.6,
   "text": "یه شخصی از امام صادق سؤال کرد، پرسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.6,
   "end": 332.44,
   "text": "صِفْ لَنا الموتُ آقا جان موت رو برای ما وصف کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.44,
   "end": 334.62,
   "text": "موت یعنی چی؟ چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.62,
   "end": 337.7,
   "text": "توصیف کن. قال للمؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.7,
   "end": 340.4,
   "text": "حضرت فرمودند برای مؤمن این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.4,
   "end": 343.62,
   "text": "كأَتِيَ بِالرِّيحِ يَشُمُّهُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.62,
   "end": 347.06,
   "text": "به به به. فَيَنْعَسُ لِطِيبِهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.06,
   "end": 350.48,
   "text": "مثل یه نسیم رحمتی که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.48,
   "end": 353.72,
   "text": "و این نسیم که میاد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.72,
   "end": 356.52,
   "text": "از خوشی این نسیم یه حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.52,
   "end": 359.08,
   "text": "چرت بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.08,
   "end": 363.24,
   "text": "مثل یه چیز شبیه خواب، اینطوری خواب شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.24,
   "end": 368.1,
   "text": "حالا اینجا خیلی حرف‌ها، حکم‌ها پیاده کردم بماند حالا در حوصله بحثمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.1,
   "end": 374.92,
   "text": "\"و ینقطع تعب و الألم.\" به به، به هرچی درد و تعب و سختی و رنج داره \"ینقطع.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.92,
   "end": 378.98,
   "text": "منقطع می‌شه تموم شد. اصلاً اول راحتیه مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.98,
   "end": 382.18,
   "text": "آقا من و شما نمی‌خوایم به اول راحتی‌مون برسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.18,
   "end": 385.74,
   "text": "حاج آقا شما چرا اصرار داری ما رو بکشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.74,
   "end": 389.64,
   "text": "نه یه اصل باورش خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.64,
   "end": 394.24,
   "text": "و البته این از شما به دوره دیگه انشاالله از ماها به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.24,
   "end": 396.68,
   "text": "\"وللكافرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.68,
   "end": 406.24,
   "text": "كلسع الأفاعی\" جمع أفعی \"ولضغ العقارب.\" ولی برای کسی که کافره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.24,
   "end": 412.24,
   "text": "مثل گزیدن مار أفعی‌ها و نیش عقرب‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.24,
   "end": 414.98,
   "text": "وای وای. \"وأشد قیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.98,
   "end": 417.78,
   "text": "وأشد.\" بلکه شدیدتر از اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.78,
   "end": 421.36,
   "text": "نسبت به مراتبش. \"قيل\" گفته شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.36,
   "end": 422.98,
   "text": "حالا با دو مرتبه سؤالشو ادامه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.98,
   "end": 425.46,
   "text": "\"فإن قوم يقولون أنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.46,
   "end": 428.7,
   "text": "أشد من نشر بالمناشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.7,
   "end": 432.1,
   "text": "وقرض بالمقاریب ورضخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.1,
   "end": 437.84,
   "text": "بالأحجار وتدوير قطب الأرحية على الأحداق.\" عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.84,
   "end": 442.52,
   "text": "یا آقا جون ما از یه قومی شنیدیم که مرگ خیلی بدتر از این حرف‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.52,
   "end": 448.4,
   "text": "مثل برش با ارّه به برنت اینطوری با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.4,
   "end": 451.08,
   "text": "حالا بعضی‌ها گفتن ناخن‌گیر بعضی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.08,
   "end": 454.8,
   "text": "گفتن قیچی. تیکه تیکه ات کنن یا مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.8,
   "end": 460.38,
   "text": "مثلاً انگار که با سنگ تو رو بکوبن یا مثل اینکه سنگ اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.38,
   "end": 463.78,
   "text": "آسیاب رو در چشمانت بگردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.78,
   "end": 471.0,
   "text": "اینطوری شنیدیم. \"قال\" حضرت فرمود \"كذلك هو على بعض الكافرين.\" خیلی الحمد لله خداروشکر راحت شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.0,
   "end": 478.42,
   "text": "\"والفاجرين.\" این تازه میگه برای همه کافرین و فاجرین هم اینطوری نیست دیگه اینقدر سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.42,
   "end": 480.34,
   "text": "میگه برای بعضی از اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.34,
   "end": 484.84,
   "text": "\"ألا ترون منهم\" ندیدی \"من يعاين تلك الشدائد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.84,
   "end": 488.64,
   "text": "ندیدی که این‌ها به این حالت میفتن و این شدت‌ها رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.64,
   "end": 493.02,
   "text": "\"فذلك للذي هو أشد من هذا الأمر.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.02,
   "end": 494.82,
   "text": "بلکه شدیدتر از اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.82,
   "end": 500.54,
   "text": "حالا \"عذاب الآخرة فإنه أشد من عذاب الدنيا.\" حواست باشه آقا جون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.54,
   "end": 502.38,
   "text": "حضرت میگه صبر کن انگار مچ بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.38,
   "end": 504.94,
   "text": "بگو آقا صبر کن. اینایی که تو داری میگی مال دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.94,
   "end": 509.18,
   "text": "عذاب آخرت به مراتب، به مراتب سخت‌تر از عذاب دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.18,
   "end": 512.58,
   "text": "\"قيل\" دو مرتبه شروع کرد به سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.58,
   "end": 515.52,
   "text": "\"فما بالنا نرى كافراً يسهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.52,
   "end": 519.38,
   "text": "يسهل عليه النزع فينتفي وهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.38,
   "end": 523.7,
   "text": "يحدث ويضحك ويتكلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.7,
   "end": 528.82,
   "text": "وفي المؤمنين أيضاً.\" آقا جون ما بعضی از کافرین و مؤمنین رو می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.82,
   "end": 535.76,
   "text": "که این‌ها خیلی راحت \"يسهل عليه النزع\" اون نزعشون لحظه جون دادنشون خیلی راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.76,
   "end": 537.88,
   "text": "چه مؤمن، چه کافر ما اینو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.88,
   "end": 540.62,
   "text": "داره حرف می‌زنه به عینه صریح روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.62,
   "end": 543.44,
   "text": "\"يحدث يضحك.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.44,
   "end": 547.7,
   "text": "داره می‌خنده یا داره \"ويتكلم.\" داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.7,
   "end": 550.72,
   "text": "اینا یهو جون میده راحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.72,
   "end": 557.04,
   "text": "ظاهراً. \"من يكون كذلك وفي المؤمنين والكافرين.\" دو مرتبه هم در مؤمن هم در کافر می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.04,
   "end": 561.78,
   "text": "\"من يقاسي عند سكرات الموت هذه الشدائد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.78,
   "end": 566.7,
   "text": "قیاس می‌کنیم می‌بینیم اوه، اوه چقدر شدید و سخت اینا جون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.7,
   "end": 569.0,
   "text": "چگونه است که ما تو دوتاشون هم می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.0,
   "end": 571.28,
   "text": "هم کافر هم مؤمن. حالا جواب حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.28,
   "end": 578.46,
   "text": "\"وما كان.\" فرمود \"فقال ما كان الراحة للمؤمن هناك فهو تعجيل الثواب.\" به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.46,
   "end": 582.96,
   "text": "اگه می‌بینی مؤمن راحت جون داد بدون خدا تعجیل کرده در ثوابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.96,
   "end": 585.5,
   "text": "اینقدر اینو دوست داره میخواد سریع کارش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.5,
   "end": 589.08,
   "text": "برسونش به ثوابش. یعنی انگار گناهی بین او و خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.08,
   "end": 592.24,
   "text": "این معنا رو میده. \"وما كان من شديد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.24,
   "end": 595.9,
   "text": "فتمحيصه.\" اصل تمحیص که تو قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.9,
   "end": 606.3,
   "text": "\"من ذنوبه ليرد الآخرة نقيا نظيفا مستحقا لثواب الأبد لا مانع له دونه وما كان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.3,
   "end": 608.58,
   "text": "سهل له هناك.\" حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.58,
   "end": 611.8,
   "text": "می‌فرماید که اگر می‌بینی مؤمنی راحت جون داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.8,
   "end": 615.26,
   "text": "به جهت این که خودش کار کرده تسهیل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.26,
   "end": 617.44,
   "text": "و که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.44,
   "end": 619.78,
   "text": "اگر شدید جون جون داد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.78,
   "end": 624.5,
   "text": "اگر شدید جون داد باز رحمت خداست که پاکش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.5,
   "end": 631.2,
   "text": "و اون گناهانی که بین او و خدا هست از بین بره که راحت دیگه بره به ثواب آخرتیش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 631.2,
   "end": 636.0,
   "text": "در هر حال از لحظه، لحظه‌ای که نفس ناطقه انصراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 636.0,
   "end": 641.2,
   "text": "کامل از بدن میده، لام انصراف می‌کنه و خارج می‌شه دیگه راحتیه مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 641.2,
   "end": 648.16,
   "text": "حالا قبل موت یعنی اون لحظات سكرات چرا سختی‌هایی است به جهت گناهان اما بعدش دیگه راحتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.16,
   "end": 652.36,
   "text": "البته بعد برای کافر هم فرمود که \"على الكافرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.36,
   "end": 657.8,
   "text": "فليوفى أجر حسناته في الدنيا ليرد الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.8,
   "end": 662.76,
   "text": "وليس إلا ما يجبا عليه العذاب.\" اگه می‌بینی کافر راحت جون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.76,
   "end": 666.74,
   "text": "یه حسناتی داشته، یه خوبی‌هایی بین او و خدا بالاخره بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.74,
   "end": 668.64,
   "text": "دست یکیو گرفته اینا ولی کافر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 668.64,
   "end": 671.0,
   "text": "خدا اون لحظه راحت جونشو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 671.0,
   "end": 673.88,
   "text": "\"وما كان من شدة على الكافرة هناك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 673.88,
   "end": 675.76,
   "text": "فهو ابتداء عذاب الله.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 675.76,
   "end": 681.68,
   "text": "پناه می‌بریم به خدا. اگه دیدی نه، اون کافر هم داره بد جون میده این دیگه ابتدای عذابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.68,
   "end": 684.56,
   "text": "تازه شروع شده. \"و ذلك،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 684.56,
   "end": 688.5,
   "text": "ذلك بأن الله عدل لا يظلم.\" خیالتون راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 688.5,
   "end": 692.64,
   "text": "کلمه آخر. خدا به عهدی ستم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.64,
   "end": 695.1,
   "text": "هرچی که خودت هستی همونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.1,
   "end": 697.56,
   "text": "اگه الان بهشتی، بهشتی میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 697.56,
   "end": 699.76,
   "text": "اگه الان جهنمی، جهنمی میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 699.76,
   "end": 703.86,
   "text": "انشاالله هممون بهشت بشیم و بهشتی باشیم و با بهشتی‌ها محشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 703.86,
   "end": 710.78,
   "text": "عاقبتمون ختم به خیر بشه. به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 710.78,
   "end": 715.18,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}