 "chapters": [
  {
   "index": 0,
   "title": "## ارواح جمع و جسد مفرد",
   "start": 0.08,
   "end": 97.96
  },
  {
   "index": 1,
   "title": "## بنای جسد بر چهار چیز",
   "start": 97.96,
   "end": 266.34
  },
  {
   "index": 2,
   "title": "## اشتباه مجلسی در اطلاق بر موت",
   "start": 266.34,
   "end": 398.11
  },
  {
   "index": 3,
   "title": "## آیهٔ توفی انفس در زمر",
   "start": 398.11,
   "end": 663.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 2.76,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.76,
   "end": 5.88,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.88,
   "end": 10.96,
   "text": "و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.96,
   "end": 13.76,
   "text": "نکته‌ی دیگری که در حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.76,
   "end": 21.52,
   "text": "چهارم باب اول کتاب الموت هست توجه به این قسمت هست که \"و ذالک انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.52,
   "end": 24.78,
   "text": "یفرق بین الارواح والجسد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.78,
   "end": 28.06,
   "text": "وقتی که موت اتفاق میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.06,
   "end": 32.96,
   "text": "عرض کردیم بر اساس این روایت شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.96,
   "end": 36.48,
   "text": "شأن اخروی از شأن دنیوی جدا میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.48,
   "end": 41.18,
   "text": "و اینجا حضرت می فرمایند تفرق حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.18,
   "end": 43.18,
   "text": "جدایی حاصل میشه. بین چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.18,
   "end": 46.22,
   "text": "بین الارواح والجسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.22,
   "end": 48.68,
   "text": "جالبه که اینجا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.68,
   "end": 50.96,
   "text": "روح رو جمع آورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.96,
   "end": 53.36,
   "text": "جسد رو مفرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.36,
   "end": 59.22,
   "text": "یه بار دیگه می خونم ببینید \"و ذالک انه یفرق بین الارواح والجسد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.22,
   "end": 63.38,
   "text": "مگه ما چند تا روح داریم که اینجا حضرت روح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.38,
   "end": 66.88,
   "text": "جمع آورده؟ آیا ما چند تا روح داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.88,
   "end": 69.9,
   "text": "حتما چند تا روح داریم که امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.9,
   "end": 74.74,
   "text": "صلی الله علیه اینجا فرموده ارواح در کنار جسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.74,
   "end": 77.86,
   "text": "بر اساس روایات، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.86,
   "end": 80.98,
   "text": "ما حداقل چهار تا روح درمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.98,
   "end": 83.82,
   "text": "صد درصد اثبات شده که تو روایات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.82,
   "end": 86.16,
   "text": "ما چهار تا روح داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.16,
   "end": 89.34,
   "text": "یکیش رو فرمودن روح الشهوه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.34,
   "end": 91.88,
   "text": "دیگرش روح القوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 91.88,
   "end": 97.6,
   "text": "سومیش روح الحياة، چهارمیش هم روح الإيمان و همه‌ی این‌ها هم تعریف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.6,
   "end": 101.64,
   "text": "حالا ما در اون مقام نیستیم که این‌ها رو بخوایم تعریف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 101.64,
   "end": 103.8,
   "text": "این‌ها چهار تا روحی‌اند که در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 103.8,
   "end": 107.56,
   "text": "حالا اهل بیت علیهم الصلاة و السلام پنج تا روح دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 107.56,
   "end": 113.32,
   "text": "اونا چهار تا ندارن. اون‌ها روح القدس یا اون روح اعظم رو هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.32,
   "end": 117.06,
   "text": "یعنی تأیید شده‌ی به روح القدس یا روح اعظمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.06,
   "end": 121.0,
   "text": "که تنزل الملائكة و الروح، اون روح اعظم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.0,
   "end": 126.6,
   "text": "ماه مبارک رمضان درباره‌ش چند جلسه سخن گفتیم حقیقت اون روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.6,
   "end": 129.94,
   "text": "اون روح فاطمی. که حالا کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.94,
   "end": 136.2,
   "text": "پس این چهار تا روح حداقل در ما هست که حالا هر کدوم کارکرد خاصی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.2,
   "end": 138.64,
   "text": "اتفاقاً در یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.64,
   "end": 143.24,
   "text": "حدیثی که در همین بحار اومده امام صادق صلی الله علیه می فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.24,
   "end": 148.54,
   "text": "بین الجسد على أربعة أشیا-- بنی الجسد على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.54,
   "end": 153.92,
   "text": "أربعة أشیا. جسد بنا شده بر چهار چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.92,
   "end": 161.24,
   "text": "همین چهار تا روح‌اند. حضرت می فرمایند که الروح و العقل و الدم و النفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.24,
   "end": 167.94,
   "text": "خود اصل روح که از اون روح اعظم ناشی می‌شه یعنی شأنی از شؤون اون روحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.94,
   "end": 171.28,
   "text": "و خود عقل که مقدس‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.28,
   "end": 173.12,
   "text": "چیزی‌ست که خدا خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.12,
   "end": 176.84,
   "text": "دم که خونه و خود نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.84,
   "end": 181.94,
   "text": "حضرت فرمودند \"فإذا خرج الروح تبعه العقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.94,
   "end": 184.8,
   "text": "دقت کنید اینجا خیلی جالبه این نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.8,
   "end": 188.62,
   "text": "وقتی که روح خارج شد عقل هم ازش تبعیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.62,
   "end": 192.68,
   "text": "یعنی تا روح خارج بشه عقل هم باهاش خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.68,
   "end": 198.58,
   "text": "خب، فإذا أرأ الروح هر چیزی رو که روح ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.58,
   "end": 202.7,
   "text": "شی-- أرأ الروح شیئاً حفظه عليه العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.7,
   "end": 206.44,
   "text": "عقل حفظش می‌کنه مثل قوه‌ی حافظه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.44,
   "end": 210.2,
   "text": "هر طرف، یعنی شما چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.2,
   "end": 213.44,
   "text": "بعد از موت حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.44,
   "end": 217.72,
   "text": "اون موت اجباری بگیم یا هرچی یا همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.72,
   "end": 221.52,
   "text": "مو-- چیزی که شبیه به موته یعنی خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.52,
   "end": 224.74,
   "text": "روح وقتی خارج شد عقل هم به تبعش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.74,
   "end": 227.86,
   "text": "هرچی روح ببینه عقل حفظش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.86,
   "end": 230.84,
   "text": "پس یه نتیجه. حالا نتیجه‌های زیادی از این روایت می‌شه گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.84,
   "end": 232.96,
   "text": "ما خیلی نمی‌خوایم وقتتون بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.96,
   "end": 238.96,
   "text": "کسی اگر از خواب بیدار شد یادش رفت خوابش رو، معلومه که مشکل عقلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.96,
   "end": 241.86,
   "text": "اینو حواسمون باشه یعنی عقلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.86,
   "end": 245.22,
   "text": "مشکلاتی داره. حالا چه مشکلاتی داره باید روش بحث کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.22,
   "end": 248.74,
   "text": "جاهاش الان نیست. و بقیت دم و نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.74,
   "end": 250.98,
   "text": "چی باقی می‌مونه تو جسد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.98,
   "end": 253.1,
   "text": "نفس و دم، خون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.1,
   "end": 257.02,
   "text": "این دو تا باقی می‌مونن. نفس که باید بمونه که اگه نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.02,
   "end": 264.98,
   "text": "که حالا جالبه که اینجا مرحوم مجلسی به فرمایش بعضی از بزرگان یه اشتباهی کرده اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.98,
   "end": 268.34,
   "text": "در شرحی که خود مرحوم مجلسی در بحار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.34,
   "end": 270.36,
   "text": "ذیل این حدیث آورده، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.36,
   "end": 274.46,
   "text": "حدیث رو فرموده بر موت اطلاق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.46,
   "end": 280.28,
   "text": "فرموده منظور موته. اگه موت باشه چرا فرموده که خون و نفس می‌مونن تو جسد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.28,
   "end": 283.62,
   "text": "اون دو تا میرن و اینجا اشتباهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.62,
   "end": 286.48,
   "text": "نه، این مال زمان خواب انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.48,
   "end": 291.38,
   "text": "که اون دو تا روح میرن، روح اصلی و روح عقل خارج میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.38,
   "end": 297.82,
   "text": "عقل هم میره کمکش که هرچی دیدی با-- رؤیت کردی با روحت، اون حفظش کنه تو قوه‌ی حافظت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.82,
   "end": 301.28,
   "text": "تو مخزن وجودیت و در مکمن وجودیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.28,
   "end": 306.76,
   "text": "اما اون دو تا خون و نفس می‌مونن که تو زنده بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.76,
   "end": 309.46,
   "text": "نفس اصلاً چیه؟ چرا بهش میگن نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.46,
   "end": 311.64,
   "text": "یکی از شؤون نفس ناطقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.64,
   "end": 313.8,
   "text": "یکی از شؤون همون روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.8,
   "end": 319.84,
   "text": "چرا؟ منزله‌ایست، به منزله‌ایست که مرتبه‌ای از وجود است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.84,
   "end": 324.0,
   "text": "اون روح شما تدبیر می‌کنه جسمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.0,
   "end": 328.74,
   "text": "یعنی هنوز تو قوای وجودی در جسمت دارن کار می‌کنن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.74,
   "end": 331.2,
   "text": "هنوز نمردی که، خوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.2,
   "end": 334.1,
   "text": "لذا باید نفس باشه. نفس برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.1,
   "end": 336.66,
   "text": "وساطت بین روح و بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.66,
   "end": 342.38,
   "text": "تدبیر کننده است. نگاه به پایین داره از مافوق به پایین توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.38,
   "end": 344.38,
   "text": "این توجه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.38,
   "end": 346.32,
   "text": "تربیتی، پرورشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.32,
   "end": 348.74,
   "text": "نه نگاه بالا به پایین بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.74,
   "end": 350.28,
   "text": "مسئولین و مدیران ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.28,
   "end": 352.32,
   "text": "این که آدمو اذیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 352.32,
   "end": 354.96,
   "text": "بعضیا نگاشون بدجوری بالا به پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 354.96,
   "end": 359.2,
   "text": "فکر می‌کنن چون مدیر شدن، چون مسئول شدن، چون مدیر کل شدن، چه می‌دونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.2,
   "end": 366.41,
   "text": "چون لباس پیغمبر مثلا تن کردن یا مثلا این دیگه مثلا نگاه بالا به-- نه اینا که آسیب‌زننده است به همه و خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.41,
   "end": 369.73,
   "text": "نه این نگاه بالا به پایین پرورش‌دهنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.73,
   "end": 372.13,
   "text": "خیلی جالبه که قابل‌توجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.13,
   "end": 378.23,
   "text": "اون هر کسی که ظاهراً جایگاه بالاتری از دیگران داره باید نگاهش پرورش‌دهنده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.23,
   "end": 380.63,
   "text": "مثل پدر باشه، مثل مادر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.63,
   "end": 382.53,
   "text": "پرورش بده نیروهاشو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.53,
   "end": 386.85,
   "text": "زیردست‌شو. حالا اینجا حرف‌های زیادی است بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 386.85,
   "end": 391.15,
   "text": "اتفاقاً یه حدیث دیگه‌ای هم هست که خیلی اینم شیرینه براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.15,
   "end": 393.01,
   "text": "جالبه که همین رو تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.01,
   "end": 395.67,
   "text": "پیرامون آیه چهل و دو زمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.67,
   "end": 401.37,
   "text": "این فرمایش رو اصلاً امام موسی کاظم ذیل همین آیه بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.37,
   "end": 403.61,
   "text": "ذیل همین آیه‌ای که الان می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.61,
   "end": 407.91,
   "text": "در چندین درس شرح فصوص علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 407.91,
   "end": 413.33,
   "text": "حضرت علامه حسن زاده علیه الرحمه بارها ازشون من شنیدم که پیرامون این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.33,
   "end": 419.07,
   "text": "سخن گفتن. چقدر این آیه رو باز کردن در چند-چندین جلسه شیرین و خوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.07,
   "end": 422.37,
   "text": "می‌تونید رجوع کنید. مثلاً در جلسه صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 422.37,
   "end": 426.95,
   "text": "شصت و هفت حضرت استاد به این نکته اشاره کردن در شرح فصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.95,
   "end": 432.53,
   "text": "حالا آیه چیه؟ \"الله یتوفی الانفس حين موتها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.53,
   "end": 435.59,
   "text": "وقتی که موت اتفاق می‌افته الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.59,
   "end": 438.79,
   "text": "توفی می‌کنه به صورت کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.79,
   "end": 441.81,
   "text": "چی رو؟ أنفس، اون جان‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.81,
   "end": 446.73,
   "text": "حالا اینجا سؤال پیش میاد پس جبر-- حضرت عزرائیل اینجا چیکار است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.73,
   "end": 453.25,
   "text": "که واسطه موته. اگه خدا \"الله يتوفی الانفس حين موتها\" حضرت عزرائیل اینجا چیکار است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.25,
   "end": 455.85,
   "text": "جواب برمی‌گرده به همون توحید صمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.85,
   "end": 460.15,
   "text": "که یک وجود است. یک حقیقت در عالم جاری است و خداست و خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 460.15,
   "end": 462.01,
   "text": "این‌ها شعون وجودی او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.01,
   "end": 464.01,
   "text": "اتوار وجودی او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.01,
   "end": 472.91,
   "text": "مثل شما که یک وجود واحدی، طورهای مختلف داری، قوای مختلف داری که این قوای وجودی تو همون ملائکه الله وجودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.91,
   "end": 476.73,
   "text": "خب دیگه چی؟ اینجا فقط خدا توفی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.73,
   "end": 479.13,
   "text": "نه خیر. ادامشو ببینید. \"ولم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.13,
   "end": 481.85,
   "text": "والتي لم تمت في منامها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.85,
   "end": 484.49,
   "text": "منامها. در چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.49,
   "end": 487.95,
   "text": "خوابش. و کسی هم که \"لم تمت\" نمرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.95,
   "end": 491.59,
   "text": "ولی تو چیه؟ \"في منامها\" تو خوابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.59,
   "end": 496.15,
   "text": "یعنی چی؟ یعنی در خواب هم چیزی شبیه مرگ اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.15,
   "end": 498.91,
   "text": "شبیه موت. اینه که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.91,
   "end": 503.71,
   "text": "ان النوم اخ الموت از این، از این آیات گرفته شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.71,
   "end": 508.67,
   "text": "که حالا ما وقتی از خواب بیدار می‌شیم دنبال تعبیر اونچه می‌گردیم که در اون عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.67,
   "end": 511.23,
   "text": "مثال متصل خودمون دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.23,
   "end": 512.89,
   "text": "یعنی برزخ وجودیمون دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.89,
   "end": 514.57,
   "text": "دنبال تعبیرهای اون می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.57,
   "end": 519.53,
   "text": "حقایقی از عالم بالا تنزل پیدا کرده از عالم عقول اومده رسیده به عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 519.53,
   "end": 523.61,
   "text": "ما رفتیم تو اون عالم دیدیم. دیگه آدم باید عبور کنه از ظاهر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.61,
   "end": 528.03,
   "text": "صور و اشكال به باطنش. وقتی هم که موت اتفاق می‌افته همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 528.03,
   "end": 530.43,
   "text": "ما از این دنیا میریم دنبال چی می‌گردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.43,
   "end": 533.99,
   "text": "بگید. دنبال تعبیر اون چیزهایی که دیدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.99,
   "end": 537.79,
   "text": "این چیزهایی که اتفاق افتاد تو این دنیا برامون مثل یه خوابی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.79,
   "end": 541.05,
   "text": "انگار الان داریم خواب می‌بینیم و الان دنبال تعبیرشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 541.05,
   "end": 543.79,
   "text": "باید اینجا حالا صور و اشكالی که اونجا می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 543.79,
   "end": 547.27,
   "text": "پایه‌ریزی‌ش تخم‌گذاری‌ش تو همین دنیا شکل گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.27,
   "end": 549.11,
   "text": "پس خسته‌تون نکنم این رو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.11,
   "end": 556.11,
   "text": "آیه بسیار زیبا که بعد ادامه میده \"فيمسك التي قضي عليها الموت ويرسل الاخرى الى اجل مسمی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.11,
   "end": 558.51,
   "text": "این هست تا اون اجل مسمی رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 558.51,
   "end": 563.07,
   "text": "اینجا وقتی موت اتفاق می‌افته هم اینجا می‌فرماید \"الله يتوفی الانفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.07,
   "end": 567.63,
   "text": "خدا می‌گیره جان‌ها رو. خدا اینجا چی رو می‌گیره که هنوز موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 567.63,
   "end": 570.19,
   "text": "ااا تمام شده نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.19,
   "end": 573.79,
   "text": "شبیه به موته. روح و عقل رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.79,
   "end": 575.87,
   "text": "خون و نفس باقی می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 575.87,
   "end": 579.03,
   "text": "حدیثی که ذیل این آیه است بگو و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.03,
   "end": 581.51,
   "text": "به به، به به. امام کاظم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 581.51,
   "end": 584.65,
   "text": "جلد پنجاه و هشت همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 584.65,
   "end": 588.77,
   "text": "بحار صفحه چهل و سه می‌تونین این حدیث رو کاملشو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 588.77,
   "end": 595.49,
   "text": "ذیل همین آیه. حضرت فرمودن \"انما يسير اليه ارواح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.49,
   "end": 598.07,
   "text": "ببینید \"ارواح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 598.07,
   "end": 605.55,
   "text": "جمع بسته. \"ارواح العقول فاما ارواح الحیاة فانها في الابدان لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.55,
   "end": 607.47,
   "text": "یخرج الا بالموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.47,
   "end": 609.67,
   "text": "می‌فرماید اون روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.67,
   "end": 612.39,
   "text": "روح‌ها، ارواح که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 612.39,
   "end": 616.99,
   "text": "در حقیقت مؤید عقلم و عقلم در کنار اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.99,
   "end": 619.89,
   "text": "به یک معنا عقل اصلاً مؤید اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 619.89,
   "end": 623.01,
   "text": "این‌ها میرن. ببینید \"ارواح العقول\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 623.01,
   "end": 624.85,
   "text": "اینا میرن \"يسير اليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 624.85,
   "end": 627.71,
   "text": "میرن به سمت چی؟ \"الله يتوفی الانفس\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 627.71,
   "end": 630.67,
   "text": "میرن. \"فاما ارواح الحیاة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 630.67,
   "end": 634.09,
   "text": "روح‌های حیات باز جمع بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 634.09,
   "end": 636.43,
   "text": "اینا چی میشن؟ \"فانها في الابدان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 636.43,
   "end": 640.63,
   "text": "اینا تو بدن میمونن. \"لا يخرج الا بالموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 640.63,
   "end": 642.73,
   "text": "فقط وقت موت خارج میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 642.73,
   "end": 648.07,
   "text": "اونا چی‌ان؟ طبق روایات همون نفسه و همون دم یعنی خون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 648.07,
   "end": 651.07,
   "text": "اونام دیگه گرفته میشن. یه شباهتی بود بین خواب و بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 651.07,
   "end": 654.27,
   "text": "خوبه این‌ها رو ما بدونیم. ان‌شاءالله عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 654.27,
   "end": 657.31,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 657.31,
   "end": 660.41,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 660.41,
   "end": 663.45,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}