   "title": "## تسلیت بقیع و روایت یازدهم کتاب الموت",
   "start": 16.88,
   "end": 150.44
  },
  {
   "index": 1,
   "title": "## امکان دیدن ملائکه؛ تهذیب الأحکام",
   "start": 150.44,
   "end": 313.42
  },
  {
   "index": 2,
   "title": "## ملاصدرا؛ دیباچهٔ اسفار و تزکیه پیش از کتاب",
   "start": 313.42,
   "end": 617.99
  },
  {
   "index": 3,
   "title": "## علم مجرد؛ اتحاد عاقل و معقول",
   "start": 617.99,
   "end": 712.71
  },
  {
   "index": 4,
   "title": "## تعلق با تعقل جمع نمی‌شود؛ حضور یعنی توحد",
   "start": 712.71,
   "end": 921.3
  },
  {
   "index": 5,
   "title": "## اساس معرفت؛ سپس ارق ذریا",
   "start": 921.3,
   "end": 986.44
  },
  {
   "index": 6,
   "title": "## حکایت لنگه کفش و شتر؛ شرط تقوا برای تمثل",
   "start": 986.44,
   "end": 1118.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 2.7,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.7,
   "end": 9.66,
   "text": "و به این استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.66,
   "end": 16.88,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.88,
   "end": 18.86,
   "text": "ضمن عرض تسلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.86,
   "end": 22.54,
   "text": "به مناسبت روز تخریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.54,
   "end": 28.08,
   "text": "قبور ائمه بقی، انشاالله به زودی زود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.08,
   "end": 30.76,
   "text": "با ریشه‌کن شدن دشمنانمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.76,
   "end": 35.02,
   "text": "اول یهود و صهیونیست انشاالله بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.02,
   "end": 40.54,
   "text": "آل سعود انشاالله این با گنبد و بارگاه بهتر از مشهد رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.54,
   "end": 46.4,
   "text": "ساخته بشه با کسب اجازه از استاد عزیزم حضرت آقای رنجبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.4,
   "end": 51.64,
   "text": "مطالبی رو تقدیم می‌کنم تو این فرصت کوتاه نثار این پنج شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.64,
   "end": 65.14,
   "text": "گمنامی که در محضرشون هستیم صلواتی را خطب بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.14,
   "end": 69.18,
   "text": "ما روز گذشته در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.18,
   "end": 72.58,
   "text": "دوستان که بعضیاشون الان حضور دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.58,
   "end": 77.36,
   "text": "در خصوص روایت یازدهم از کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.36,
   "end": 80.2,
   "text": "مرحوم مجلسی در بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.2,
   "end": 82.96,
   "text": "نکاتی رو گفتیم. روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.96,
   "end": 86.72,
   "text": "خلاصه‌ش رو عرض کنم این بود که از امیرالمؤمنین صلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.72,
   "end": 90.58,
   "text": "الله علیه پرسیدن که آقا چرا شما عاشق لقاء الله هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.58,
   "end": 94.94,
   "text": "چرا عاشق موت به یک معنا هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.94,
   "end": 107.9,
   "text": "و حضرت فرمودند که وقتی دیدم که خدای منان اختیار کرده بر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.9,
   "end": 114.74,
   "text": "دین ملائکش، رسولان و انبیاش رو یعنی بهترین چیز این عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.74,
   "end": 122.46,
   "text": "به من هبه کرده. اینو دونستم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.46,
   "end": 125.74,
   "text": "اون کسی که این چنین تو این نشئه من رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 125.74,
   "end": 133.9,
   "text": "تکریم کرده منو فراموش نخواهد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 133.9,
   "end": 136.76,
   "text": "به خاطر همین عاشق لقای خدا شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.76,
   "end": 140.56,
   "text": "بعد چون حضرت امیر مقدم کرده اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.56,
   "end": 146.8,
   "text": "دین ملائکه رو بر رسولان و انبیا نکته‌ای رو ما عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 146.8,
   "end": 150.44,
   "text": "و پیرامون ملائکه کمی سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 150.44,
   "end": 155.64,
   "text": "سؤالاتی ایجاد شد که آیا امکان دیدن ملائکه وجود دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 155.64,
   "end": 160.22,
   "text": "گفتیم بله. مثال زدیم از جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 160.22,
   "end": 167.98,
   "text": "سه صفحه شصت و دو کتاب التهذیب الأحکام یکی از کتب أربعة شیعه مرحوم شیخ طوسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 167.98,
   "end": 176.48,
   "text": "دستور العملی رو توضیح دادیم دیروز پیرامون شب نیمه ماه مبارک رمضان و ربطش رو هم با شب نیمه عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 176.48,
   "end": 179.6,
   "text": "که کسی اون دستور رو انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 179.6,
   "end": 185.98,
   "text": "صد فرشته براش متمثل میشه در خواب و البته توضیح داریم در بیداری هم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 185.98,
   "end": 188.32,
   "text": "بعضیا حاصل شده و میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 188.32,
   "end": 190.44,
   "text": "این دیدن ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 190.44,
   "end": 195.84,
   "text": "چگونه است؟ این نکته رو من اینجا عارض بشم که از دلش یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 195.84,
   "end": 198.96,
   "text": "بهره‌برداری کرده باشیم. میدونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 198.96,
   "end": 202.2,
   "text": "ملائکه مجردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 202.2,
   "end": 207.02,
   "text": "از اون عالمی که ما می‌خوایم طی کنیم و به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 207.02,
   "end": 210.16,
   "text": "سفر مرگ یا موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 210.16,
   "end": 212.38,
   "text": "ما رو به اونجا میرسه، مجردات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.38,
   "end": 218.38,
   "text": "حالا هرچه که در قوس صعود شما حرکت می‌کنی و إنا إليه راجعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 218.38,
   "end": 221.24,
   "text": "میری به بالا این تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 221.24,
   "end": 227.1,
   "text": "شدیدتر میشه. به یک معنا تأکد بر توحد اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.1,
   "end": 229.46,
   "text": "وحدت به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 229.46,
   "end": 232.78,
   "text": "خودش رو نشون میده تا جایی که وقتی به عالم عقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 232.78,
   "end": 235.98,
   "text": "ما فوق عالم مثال یا برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 235.98,
   "end": 238.28,
   "text": "می‌رسی اونجا دیگه جبروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 238.28,
   "end": 243.58,
   "text": "قر-- عرض کردیم بر وزن فعوت به شدت دیگه سلطنت دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 243.58,
   "end": 249.02,
   "text": "ولایت کلیه الهیه است که امامش و سلطانش امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 249.02,
   "end": 255.2,
   "text": "اونجا جبر به این معناست که سلطنت یکپارچه اونجا دست و اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 255.2,
   "end": 261.08,
   "text": "عقول هم که از نور مولا علی خلق شدن در سلسله طولی بافت چینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 261.08,
   "end": 265.46,
   "text": "نظام هستی قبلاً عرض کردیم که هر کدوم از این‌ها کدوم از اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 265.46,
   "end": 268.48,
   "text": "خلق شدن از نور مولا علی هستند عالم عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 268.48,
   "end": 272.88,
   "text": "اونجا چون مجردند به شدت لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 272.88,
   "end": 276.04,
   "text": "چشم دیدن اون‌ها باید مجرد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 276.04,
   "end": 277.88,
   "text": "این چشم ظاهری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 277.88,
   "end": 284.6,
   "text": "همونطور که عرض کردیم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.6,
   "end": 287.8,
   "text": "متمثل شد حضرت جبرائیل برای حضرت مریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 287.8,
   "end": 289.36,
   "text": "دیگری اونجا بود نمی‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 289.36,
   "end": 292.78,
   "text": "همونطور که پیغمبر عظیم الشأن اسلام ملائکه رو می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 292.78,
   "end": 297.2,
   "text": "هاذا جبرائیل. اما کسی نمی‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 297.2,
   "end": 301.82,
   "text": "این تمثل برای چشمی‌ست که مجرد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 301.82,
   "end": 308.56,
   "text": "برای اینکه این رو راهش رو بفهمیم و پیدا کنیم اجازه بدید من از خودم حرف نزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 308.56,
   "end": 313.02,
   "text": "هم از آیات قرآن بهره بگیریم از و هم فرمایشات بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 313.02,
   "end": 315.7,
   "text": "خب کی بهتر از امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.7,
   "end": 319.82,
   "text": "شیخ الرئیس‌ها، ملاصدراها که زعیم ما، بزرگ ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 319.82,
   "end": 323.34,
   "text": "بنیانگذار و معمار کبیر انقلاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.34,
   "end": 326.92,
   "text": "عقلا رو دعوت به سفره این بزرگواران کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 326.92,
   "end": 332.96,
   "text": "اگر عزیزان اسفار أربعه ایشون که البته اسم اصلیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 332.96,
   "end": 335.54,
   "text": "در حکمت متعالیه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 335.54,
   "end": 339.36,
   "text": "مسائل حکمت-- مسائل ربوبی در حکمت متعالیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 339.36,
   "end": 341.34,
   "text": "دیگه حالا معروف شد به اسفار أربعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 341.34,
   "end": 344.12,
   "text": "در دیباچه این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 344.12,
   "end": 348.14,
   "text": "که حیرت دهنده حیرت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 348.14,
   "end": 352.02,
   "text": "این الفاظ و این خطوط و عرض شود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.02,
   "end": 354.82,
   "text": "کتاب عظیم الشأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 354.82,
   "end": 357.08,
   "text": "نهفته‌ست. یعنی کسی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 357.08,
   "end": 362.37,
   "text": "درست این کتاب رو ورق بزنه و تورق کنه به حیرت میفته قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 362.37,
   "end": 368.99,
   "text": "در دیباچه‌ش ایشون بعد از اینکه آهی می‌کشه مفصل از کسانی که مانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 368.99,
   "end": 374.71,
   "text": "خیر بودن و نگذاشتن حقایق و معارف منتشر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.71,
   "end": 379.13,
   "text": "بعد اینچنین ادامه می‌ده که فبد-فبدع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 379.13,
   "end": 383.11,
   "text": "خطاب به ماها. فبدع یا حبيبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.11,
   "end": 385.35,
   "text": "خب ایشون می‌دونید ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.35,
   "end": 388.41,
   "text": "بیش از چهارصد و پنجاه سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.41,
   "end": 393.75,
   "text": "که تبعید شد به کهک قم و با شاگردان خاصش مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 393.75,
   "end": 399.33,
   "text": "ملا محسن فیض که دامادشون هم بود یا ف-ملا فیاض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 399.33,
   "end": 402.19,
   "text": "این‌ها به‌هرحال اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.19,
   "end": 410.19,
   "text": "مشغول به درس و بحث شدن. خودش می‌فرمود این‌ها رو من با اشک نیمه‌شب سر سجده از حضرت حق تلقی کردم این حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.19,
   "end": 415.01,
   "text": "و حضرت علامه حسن زاده در درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.01,
   "end": 417.21,
   "text": "، اگر اشتباه نکنم چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 417.21,
   "end": 421.41,
   "text": "شرح اسفار می‌فرمودند که در جلسه چهارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 421.41,
   "end": 427.71,
   "text": "می‌فرمودند که از قول مشایخ‌شون می‌فرمودند که ملا صدرا لطف خدا به زمانه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.71,
   "end": 429.63,
   "text": "که اون موقع دیگه غرب داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 429.63,
   "end": 435.95,
   "text": "همه رو می‌کشوند به سمت خودش با نهله‌های عجیب و غریب خودش به سمت فساد و شهوت‌رانی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 435.95,
   "end": 441.37,
   "text": "بعد خدا یه گوشه‌ای یه نفر رو برانگیخت، لطف به قاعده لطف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 441.37,
   "end": 444.15,
   "text": "که اون ملا صدرا بود که آقا حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 444.15,
   "end": 445.75,
   "text": "اینه و این هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 445.75,
   "end": 448.63,
   "text": "می‌خواید برید به سمت غرب و تباهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 448.63,
   "end": 450.65,
   "text": "این سفره‌ی حقایق هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 450.65,
   "end": 455.21,
   "text": "ما رو سنگ زدید با سنگ حوادث اما ما براتون حقایق رو گفتیم و رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 455.21,
   "end": 459.41,
   "text": "بسیار ایشون-- یعنی لطف خدا به ما بوده و هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.41,
   "end": 463.13,
   "text": "خب چرا ما زانو نزنیم برار برار آثار ایشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 463.13,
   "end": 466.35,
   "text": "ابتدا ایشون فرمود فبدع یا حبيبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 466.35,
   "end": 468.65,
   "text": "ابتدا کن دوست من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.65,
   "end": 470.61,
   "text": "به عنوان محبت بهت میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 470.61,
   "end": 473.61,
   "text": "چه-- لفظ رو ببینید یا حبيبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 473.61,
   "end": 479.35,
   "text": "قبل قراعة-قراعة هذا الكتاب قبل از اینکه این کتاب رو بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.35,
   "end": 482.67,
   "text": "فبدع ابتدا کن به چی به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 482.67,
   "end": 485.99,
   "text": "توصیه به چی می‌کنه قبل از خوندن این کتاب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 485.99,
   "end": 490.11,
   "text": "بتزكية نفسك عن هواها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 490.11,
   "end": 495.71,
   "text": "به تزکیه نفس و یزکیهم بعد و يعلمهم الكتاب و الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.71,
   "end": 500.63,
   "text": "میگه قبل از اینکه کتابو شروع کنی دست بگیری به تزکیه نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 500.63,
   "end": 503.69,
   "text": "مشغول باش. چرا؟ علت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.69,
   "end": 505.83,
   "text": "چون تزکیه نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.83,
   "end": 508.55,
   "text": "راه مجرد شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.55,
   "end": 512.81,
   "text": "حالا عرض می‌کنم. بعد ایشون عین فرمایش‌شونو دارم می‌خونم فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.81,
   "end": 520.23,
   "text": "أفلح من زكاها اشاره به آیات سوره شمس می‌کنه و قد خام من دساها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.23,
   "end": 524.81,
   "text": "که من ندیدم. اگر شما دیدید یا حضرت استاد به بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 524.81,
   "end": 528.35,
   "text": "تذکر بدن که ندیدم در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 528.35,
   "end": 532.37,
   "text": "یازده بار خدا قسم بخوره برای یک چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 532.37,
   "end": 536.21,
   "text": "جواب قسم چیه؟ قد أفلح من زكاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 536.21,
   "end": 538.45,
   "text": "این یازده تا قسم و شمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 538.45,
   "end": 543.01,
   "text": "یه دونش و ضحاها د-دومیش ضحاها اون شدت نورش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 543.01,
   "end": 546.45,
   "text": "والقمر اذا تلاها این سومیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 546.45,
   "end": 549.35,
   "text": "والليل اذا جلاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.35,
   "end": 551.57,
   "text": "و النهار اذا جلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 551.57,
   "end": 556.81,
   "text": "نهار روز، روز وقتی درخشش همه جا رو می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 556.81,
   "end": 558.99,
   "text": "اذا جلاها اینم یک قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 558.99,
   "end": 562.29,
   "text": "بعد والليل اذا يغشاها به شب و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 562.29,
   "end": 564.69,
   "text": "پرده‌ای که همه جا رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 564.69,
   "end": 570.93,
   "text": "بعد والسماء این یه قسم و ما بناها و اون کسی که بناش کردم یه قسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.93,
   "end": 574.17,
   "text": "والأرض و ما طحاها اینم باز دو قسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 574.17,
   "end": 575.89,
   "text": "زمین و اون کسی که گستران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.89,
   "end": 577.57,
   "text": "ونفس اینم یه قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.57,
   "end": 580.43,
   "text": "عجب قسم به نفس خورده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.43,
   "end": 583.61,
   "text": "و ما سواها و اون کسی که او رو آراسته، تع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.61,
   "end": 588.87,
   "text": "بهش عدالت ااا عذر شود تعدیلش کرده، سامان بهش بخشیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 588.87,
   "end": 591.41,
   "text": "معتدلش کرده که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 591.41,
   "end": 596.75,
   "text": "فألهمها فجورها وتقواها برای چی فجور و تقوی رو بهش الهام کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.75,
   "end": 599.97,
   "text": "چرا این همه قسم خوردی خدا یازده قسم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.97,
   "end": 603.31,
   "text": "این فرمایش ملا صدرا اینجا قد أفلح من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.31,
   "end": 611.91,
   "text": "زكاها بسکاری مال کسیه که این نفس رو تزکیه کرده و قد خاب من چقدر بیچاره‌ست اون کسیه که اینو آلوده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.91,
   "end": 614.55,
   "text": "حالا شما دقت بفرمایید بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.55,
   "end": 617.99,
   "text": "روش ارتباط با مجردات که یکیش ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.99,
   "end": 619.97,
   "text": "چیز عجیبی نیست. اصلاً علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.97,
   "end": 623.01,
   "text": "شما بیاید یه مقدار ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.01,
   "end": 629.83,
   "text": "متعارف‌تر حرف بزنیم. الان شما اخذ علم می‌کنی، این علم مجرده یا ماده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 629.83,
   "end": 634.15,
   "text": "خود حقیقت علم که برای تو در ثغر نفست معلوم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.15,
   "end": 640.25,
   "text": "این نوشته و این سیاه‌‌ای که رو کاغذ نوشته و این صوتی که از من داری می‌شنوی اینا ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 640.25,
   "end": 643.75,
   "text": "اینا رو ما کاری نداریم. اینا معدات‌اند کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 643.75,
   "end": 646.05,
   "text": "شخم می‌زنن وجودتو که بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 646.05,
   "end": 649.53,
   "text": "اما از کجا گرفتن؟ اخذ و تلقی از کجا رخ می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 649.53,
   "end": 653.11,
   "text": "از ملکوت وجود خودت. تو وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 653.11,
   "end": 656.61,
   "text": "از درون خودته. اصلاً علم مجرده، ماده نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 656.61,
   "end": 659.97,
   "text": "عاری از لوازم و اسباب ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 659.97,
   "end": 662.93,
   "text": "نفس هم وقتی می‌تونه علم رو حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 662.93,
   "end": 667.81,
   "text": "نفس هم وقتی می‌تونه علم رو اخذ کنه به تمام تلقی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 667.81,
   "end": 673.25,
   "text": "حالا یا به انزل مراتبش که به نحو اعلامه حالا برو بالا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.25,
   "end": 677.81,
   "text": "حالا مثلاً القا، بعد الهام، بعد ایحاء همینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 677.81,
   "end": 680.69,
   "text": "یا از این سمت بخوای حساب کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.69,
   "end": 683.77,
   "text": "اعلام بعد بیای حالا مثلاً بخوای رشد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.77,
   "end": 687.47,
   "text": "می‌شه مثلاً کشف بعد می‌شه شهود بعد می‌شه احسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 687.47,
   "end": 692.49,
   "text": "همه این‌ها بارش رحمت الهی بر سر من در کجا اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 692.49,
   "end": 695.59,
   "text": "در وجود خودم، در درون خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 695.59,
   "end": 701.79,
   "text": "یعنی در اون نفسم. نفس کی می‌تونه این‌ها رو معلوم خودش قرار بده و اتحاد عاقل به معقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 701.79,
   "end": 705.49,
   "text": "رخ بده؟ وقتی که نفس هم مجرد شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 705.49,
   "end": 707.61,
   "text": "وقتی که عاری بشه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 707.61,
   "end": 709.87,
   "text": "تعلق. اصلاً و ابداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 709.87,
   "end": 712.21,
   "text": "ببینید این اصل رو حفظ کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 712.21,
   "end": 715.11,
   "text": "علامه بسیار در درس و بحث‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 715.11,
   "end": 718.57,
   "text": "این اصل رو فرمودن و القا کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 718.57,
   "end": 721.19,
   "text": "و الان هم شما پای درس ایشون نشستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.19,
   "end": 724.25,
   "text": "بنده یه واسطه‌ام انشاالله اگر قابل باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 724.25,
   "end": 730.0,
   "text": "فرمودند مطلقا تعلق با تعقل جمع نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.0,
   "end": 734.42,
   "text": "و لیتلطف که قبلاً عرض کردیم قلب عبارتی قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 734.42,
   "end": 739.22,
   "text": "یعنی از اون نق-- وسط قرآن می‌تونی به باطن قرآن برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 739.22,
   "end": 741.18,
   "text": "و لیتلطف. چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 741.18,
   "end": 745.24,
   "text": "تلطیف سر. فرمودن ای تعقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 745.24,
   "end": 748.12,
   "text": "با تعقل. تعقل یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.12,
   "end": 750.3,
   "text": "مخالف تعلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 750.3,
   "end": 754.78,
   "text": "هرچه تعلق به دنیا و ماده بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 754.78,
   "end": 757.02,
   "text": "شدت تعقل کمتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 757.02,
   "end": 758.94,
   "text": "و شدت توحد کمتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 758.94,
   "end": 761.46,
   "text": "اصلاً حضور اتفاق نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 761.46,
   "end": 766.28,
   "text": "مرحوم لاهوری این بزرگوار در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 766.28,
   "end": 773.96,
   "text": "عرض شود شرح عرفانی حافظ که عزیز دلم این‌ها رو باید بفرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 773.96,
   "end": 776.9,
   "text": "جایی که عقاب پر بریزد از پشه لاغری چه خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 776.9,
   "end": 780.7,
   "text": "اونجا می‌فرماید که منظور از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 780.7,
   "end": 786.68,
   "text": "وقتی که بحث حضور رو می‌خواد مطرح کنه میگه حضور که حافظ اونجا تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 786.68,
   "end": 789.24,
   "text": "شعرش آورده و من حفظ نیستم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 789.24,
   "end": 791.12,
   "text": "براتون شعر حافظ رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 791.12,
   "end": 794.02,
   "text": "یه قسمتی از شعر حافظ هست توش بحث حضور را آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 794.02,
   "end": 797.64,
   "text": "اونو که می‌خواد توضیح عرفانی بده میگه حضور یعنی وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 797.64,
   "end": 802.84,
   "text": "یعنی توحد. یعنی فردانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 802.84,
   "end": 807.4,
   "text": "تفرّد. یعنی تجرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 807.4,
   "end": 812.04,
   "text": "اصلاً نمی‌شه غیر از این. حضور یعنی می‌خوایم نماز بخونیم با حضور قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 812.04,
   "end": 816.44,
   "text": "با تعلق نمی‌شه با علقه داشتن، با این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 816.44,
   "end": 819.84,
   "text": "ماده و به هر حال کثرات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 819.84,
   "end": 823.58,
   "text": "تعلقات ما به زن و بچه و کار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 823.58,
   "end": 826.94,
   "text": "عذرخواهی می‌کنم دنیا و مافی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 826.94,
   "end": 835.0,
   "text": "اصلاً سازگار نیست. هرچه این کمتر شد، اتفاقاً قبلاً هم شبای قدر اینجا حضور عزیزان که بودند عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 835.0,
   "end": 837.58,
   "text": "فشار قبر به یک معنا کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 837.58,
   "end": 840.86,
   "text": "به یک معنا طول برزخ کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 840.86,
   "end": 843.7,
   "text": "اصلاً برزخ به جهت تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 843.7,
   "end": 847.38,
   "text": "هرچه تعلقات ما بیشتره تو برزخ بیشتر نگهامون می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 847.38,
   "end": 849.48,
   "text": "این همه خدا قسم خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 849.48,
   "end": 852.46,
   "text": "میگه آقا حالا تزکیه کنین نفس رو که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 852.46,
   "end": 856.04,
   "text": "که بتونی حقایق رو استیاد کنی از عالم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 856.04,
   "end": 858.28,
   "text": "تا نفس مجرد نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 858.28,
   "end": 861.18,
   "text": "نمی‌شه. می‌فرماید رو مجرد شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 861.18,
   "end": 866.5,
   "text": "این رو در جلسه‌ی پنج شرح اسفار علامه می‌فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 866.5,
   "end": 869.66,
   "text": "رو مجرد شو مجرد را ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 869.66,
   "end": 873.04,
   "text": "رو مجرد شو مجرد را ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 873.04,
   "end": 876.7,
   "text": "دیدن هر چیز را شرط است این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 876.7,
   "end": 880.74,
   "text": "هر چیزی رو بخوای ببینی با دل نگاه باطنت باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 880.74,
   "end": 882.86,
   "text": "به تجرد برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 882.86,
   "end": 884.86,
   "text": "الان کسی امام عصرش در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 884.86,
   "end": 888.72,
   "text": "در سوق نفسش فرج حاصل بشه امام عصرش رو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 888.72,
   "end": 892.64,
   "text": "اصلاً نمی‌شه جز با تجرد. حالا به بحث دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 892.64,
   "end": 895.8,
   "text": "اون جسم مبارک و مقدس ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 895.8,
   "end": 900.28,
   "text": "اونم یک عشقیه. اما اصل اون دیدن باطنی حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 900.28,
   "end": 906.14,
   "text": "اصلاً تو حضرت رو ببینی خود جسم حضرت رو هم ببینی شبای قدر ثابت کردیم در درون خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 906.14,
   "end": 909.58,
   "text": "اگر درون غل و غش داره فضای درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 909.58,
   "end": 916.12,
   "text": "مغبر غبار آلوده، حضرت رو هم ببینی نه می‌شناسی و نه اگرم بشناسی یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 916.12,
   "end": 920.8,
   "text": "یک چهره‌ی نادرستی تو وجود خودت از حضرت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 920.8,
   "end": 923.48,
   "text": "بعد حضرت ملاصدرا این چنین ادامه میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 923.48,
   "end": 927.8,
   "text": "که \"و استحکم اولاً\" محکم کن اول چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 927.8,
   "end": 931.74,
   "text": "\"أساس المعرفة و الحكمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 931.74,
   "end": 933.44,
   "text": "ثم ارق زرارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 933.44,
   "end": 936.8,
   "text": "زرارا جمع ذروه یا ذروه دوتاش هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 936.8,
   "end": 938.76,
   "text": "یعنی اون ارتفاع یعنی اون قله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 938.76,
   "end": 942.16,
   "text": "میگه اول مستحکم کن اساس معرفت و حکمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 942.16,
   "end": 944.18,
   "text": "چی بود اساس معرفت و حکمت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 944.18,
   "end": 948.68,
   "text": "تزکیه نفس. این کارو انجام بده \"ثم ارق\" میگه ارق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 948.68,
   "end": 951.42,
   "text": "اقرأ ورقة بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 951.42,
   "end": 956.24,
   "text": "امیرالمؤمنین به فرزندش ابن حنفیه فرمود محمد حنفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 956.24,
   "end": 958.46,
   "text": "این ارق بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 958.46,
   "end": 962.48,
   "text": "میگه \"ثم ارق زرارا\" بعد برو تو ارتفاع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 962.48,
   "end": 965.22,
   "text": "و الا با سر نقش زمین میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 965.22,
   "end": 969.92,
   "text": "و بیچاره میشی. با تزکیه نفس هیچ راهی جز این رفقا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 969.92,
   "end": 972.0,
   "text": "و ما این غفلت بیچاره‌مون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 972.0,
   "end": 976.08,
   "text": "من بحث رو ختم کنم به اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 976.08,
   "end": 982.72,
   "text": "که گرفتاری ما از عدم توحد لذا نداشتن حضور قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 982.72,
   "end": 985.44,
   "text": "همین تعلقاته. تعلقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 985.44,
   "end": 987.58,
   "text": "یا حالا حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 987.58,
   "end": 990.16,
   "text": "این مثال رو می‌زدن برای فهم تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 990.16,
   "end": 994.48,
   "text": "می‌فرمودن طرف داشت-- حکایتی نقل می‌کنند داشت تو بیابون می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 994.48,
   "end": 1000.8,
   "text": "شترش و با انبان‌ش و تجهیزاتش همه سوار شتر داشت می‌رفت تو راه یهو یه لنگه کفشی رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1000.8,
   "end": 1004.18,
   "text": "دید لنگه کفش خوبیه ولی خب یه لنگه اس به چه دردی می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1004.18,
   "end": 1007.9,
   "text": "رد شد رفت. تو راه دومین لنگه‌ش هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1007.9,
   "end": 1012.12,
   "text": "گفت اِ! دومی‌ش که اینجا هست پس مغتنم بشکن این فرصتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1012.12,
   "end": 1014.58,
   "text": "شترو با انبانش رها کرد برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1014.58,
   "end": 1019.02,
   "text": "برگشت جفت اول رو برداشت که مثلاً جفت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1019.02,
   "end": 1024.52,
   "text": "حالا اومد برگشت اومد سراغ شترش دید شتر با انبان رفته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1024.52,
   "end": 1027.4,
   "text": "غفلت این چنین بلا رو سر آدم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1027.4,
   "end": 1029.5,
   "text": "یه تعلق، تعلقش به این کفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1029.5,
   "end": 1032.36,
   "text": "دار و ندارشو به باد هست، به باد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1032.36,
   "end": 1034.58,
   "text": "اینه که خیلی باید مراقب این قصه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1034.58,
   "end": 1036.7,
   "text": "حدیث نفس برای خودم خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1036.7,
   "end": 1042.16,
   "text": "تا این اتفاق نش-- نیفته ما نمی‌تونیم حقایق عالم رو معلوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1042.16,
   "end": 1044.24,
   "text": "م-معلوم نفس خودمون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1044.24,
   "end": 1048.76,
   "text": "چون تجرد نیست، تجانس نیست، هم جنسی نیست، سنخیت وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1048.76,
   "end": 1052.76,
   "text": "درسته؟ و از اون طرف هم خب ملائکه رو ما چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1052.76,
   "end": 1057.78,
   "text": "متمثل بشن برامون که بب-- اگرم هستن ما متوجه نمی‌شیم، ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1057.78,
   "end": 1064.3,
   "text": "لذا اون دستور اولی که ما دیروز گفتیم برای بعضیا سؤال شد گفت نخوه چگونه می‌شه و این‌ها قطعاً با گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1064.3,
   "end": 1066.8,
   "text": "نخواهد شد. حسره إنما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1066.8,
   "end": 1069.28,
   "text": "یتقبل-- یتقبل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1069.28,
   "end": 1072.78,
   "text": "از کی خدا فقط و فقط و فقط قبول می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1072.78,
   "end": 1076.48,
   "text": "همه این خطومات، این اذکار، این اوراد آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1076.48,
   "end": 1084.76,
   "text": "صد بار-- آقا شیخ رجب علی خیاط آقا روزی صد بار این آیه رو بخون \"رب أدخلني مدخل صد و أخرجني مخرج صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1084.76,
   "end": 1087.5,
   "text": "واجعل لي من لدنك سلطانا نصيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1087.5,
   "end": 1091.02,
   "text": "اگر مح-محضر امام عصر رو درک نکردی تف کن تو صورت من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1091.02,
   "end": 1093.44,
   "text": "بسیاری از بزرگان اینو گفتن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1093.44,
   "end": 1096.78,
   "text": "اما شرط اساسیش همین آیه‌ای که خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1096.78,
   "end": 1099.76,
   "text": "من المتقین فقط از اهل تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1099.76,
   "end": 1104.54,
   "text": "یعنی نفس به حالت تجرد برسه که بتونه این حقایق رو معلوم خودش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1104.54,
   "end": 1106.86,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1106.86,
   "end": 1110.06,
   "text": "به برکت صلوات محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1110.06,
   "end": 1118.76,
   "text": "اللهم صلي على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}