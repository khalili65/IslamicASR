 "chapters": [
  {
   "index": 0,
   "title": "## امتنان ثبت حسنهٔ جوانی",
   "start": 19.54,
   "end": 86.28
  },
  {
   "index": 1,
   "title": "## مدیر و آیه",
   "start": 86.28,
   "end": 437.84
  },
  {
   "index": 2,
   "title": "## مسجد قبا و ضرار؛ مبدأ میل",
   "start": 437.84,
   "end": 567.46
  },
  {
   "index": 3,
   "title": "## حدیث همّ دنیا و آخرت",
   "start": 567.46,
   "end": 670.28
  },
  {
   "index": 4,
   "title": "## جمع امر و بهشت و دوزخ",
   "start": 670.28,
   "end": 703.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.18,
   "end": 11.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.98,
   "end": 15.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.66,
   "end": 19.54,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.54,
   "end": 23.68,
   "text": "در ادامه‌ی بحث روایت هشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.68,
   "end": 26.5,
   "text": "باب دوم از کتاب الموت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.5,
   "end": 30.2,
   "text": "خب حدیثی رو بیان کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.2,
   "end": 34.8,
   "text": "و عرض کردیم چرایی اینکه خدای منّان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.8,
   "end": 38.06,
   "text": "آنچه که در جوانی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.06,
   "end": 47.3,
   "text": "از رو بساطت وجودی و انبساط خاطر انجام می‌ده رو در پیری و ضعف براش می‌نویسه در حسنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.3,
   "end": 52.68,
   "text": "و در سیئات هم اگر ملکه‌ی وجودیش باشه دیگه باهاش هست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.68,
   "end": 55.32,
   "text": "تو وجودش خودش ثبت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.32,
   "end": 58.72,
   "text": "آیا آیه‌ای داریم بر این امتنان الهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.72,
   "end": 62.2,
   "text": "بله. آیات زیاد داریم مثلاً آیه صد و شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.2,
   "end": 68.48,
   "text": "سوره‌ی انعام. می‌فرماید \"من جاء بالحسنة فله عشر أمثالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.48,
   "end": 76.68,
   "text": "البته این ابتدا اینطور بود که هرکس با یک حسنه بیاد مثل همون حسنه رو خدا بهش اجر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.68,
   "end": 81.14,
   "text": "در آیه اومده بعد خدا-- پیامبر عظیم الشأن اسلام از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.14,
   "end": 83.76,
   "text": "تقاضا کرد که خدا لطفش رو بیشتر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.76,
   "end": 88.26,
   "text": "زِدنی زیادش کن. بعد خدا این آیه رو نازل کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.26,
   "end": 93.92,
   "text": "که اگر کسی با یک حسنه بیاد \"له عشر أمثالها\" ده برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.92,
   "end": 99.72,
   "text": "بهش پاداش میدیم که بعد حالا دو مرتبه پیغمبر عرض کرد خدایا زیادترش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.72,
   "end": 104.3,
   "text": "بعد اون آیه‌ی قرض الحسنه نازل شد که هجده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.3,
   "end": 108.1,
   "text": "باز پیغمبر خواهش کرد و خدا دیگه به غیر حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.1,
   "end": 111.34,
   "text": "اجر قرار داد و پیغمبر آرامید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.34,
   "end": 117.7,
   "text": "خب اینجا بعد می‌فرمود که ادامه‌ی آیه که \"ومن جاء بالسيئة فلا يجزا مثلها وهم لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.7,
   "end": 119.94,
   "text": "يظلمون\". اما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.94,
   "end": 123.02,
   "text": "با سيئة بیاد همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.02,
   "end": 127.02,
   "text": "یه گناه و خطایی که کرده براش ثبت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.02,
   "end": 129.74,
   "text": "و به کسی هم ظلم نمی‌شه. البته این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.74,
   "end": 137.36,
   "text": "جزو بسیاری از آیات قرآنه که منشور مدیریت اسلامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.36,
   "end": 142.02,
   "text": "یعنی یه مدیر اسلامی، یه مدیر خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.02,
   "end": 144.64,
   "text": "و تراز اون کسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.64,
   "end": 148.6,
   "text": "در نحوه‌ی مدیریتش به این آیه عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.6,
   "end": 153.84,
   "text": "خدا وقتی این چنینه با بندگانش چرا ما نباشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.84,
   "end": 159.96,
   "text": "چرا ما ده برابر پاداش ندیم و به اندازه‌ی خود خطایی که کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.96,
   "end": 166.58,
   "text": "مثلاً توبیخش کنیم. حالا الان نمی‌دونم شما بفرمایید زبان حال ادارجات ما و سازمان‌ها به چه صورته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.58,
   "end": 170.94,
   "text": "آیا بالعکس اینه؟ هرچه که هست نحوه‌ی مدیریت صحیح اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.94,
   "end": 175.18,
   "text": "ده برابر پاداش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.18,
   "end": 177.36,
   "text": "همون اندازه توبیخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.36,
   "end": 179.18,
   "text": "تازه \"ولا يظلمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.18,
   "end": 184.26,
   "text": "ظلمی هم مطلقاً به کسی نشه که حالا بحث مدیریت بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.26,
   "end": 187.04,
   "text": "همونطور که قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.04,
   "end": 191.26,
   "text": "این برمی‌گرده به همون جبلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.26,
   "end": 196.94,
   "text": "جبلی که حالا دیروز ما تا گفتیم جبلی خنده‌ی عزیزان به آسمون بلند شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.94,
   "end": 201.78,
   "text": "بله حاج آقا دیگه رییس سازمانم زیر سؤال برده این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.78,
   "end": 205.24,
   "text": "بله جبل-- اون جبلت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.24,
   "end": 208.58,
   "text": "که فطرت ثانویه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.58,
   "end": 214.98,
   "text": "دقت بفرمایید اینجا باز برای تکمیل بحث جلسه پیش یه نکته‌ی مهمی رو عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.98,
   "end": 217.12,
   "text": "که باز این هم الحمدالله آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.12,
   "end": 221.68,
   "text": "از خودمون حرفی نداریم. آیه دویست و هشتاد و شش بقره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.68,
   "end": 226.52,
   "text": "توجه فرمودید. \"لا يكلف الله نفسا إلا وسعها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.52,
   "end": 228.74,
   "text": "که بحثش قبلاً گذشت. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.74,
   "end": 233.5,
   "text": "هیچکس رو جز به وسعش، نه طاقتش، وسعش تکلیف نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.5,
   "end": 237.78,
   "text": "بعد اینجا نکته‌ی خیلی مهمی اشاره شده که مربوط، مرتبط با بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.78,
   "end": 240.72,
   "text": "\"لها ما كسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.72,
   "end": 242.8,
   "text": "وعليها ما اكتسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.8,
   "end": 246.9,
   "text": "\"لها ما كسبت\" اونچه که كسب می‌کنه لها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.9,
   "end": 250.1,
   "text": "براشه و علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.1,
   "end": 252.06,
   "text": "بر علیهش چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.06,
   "end": 255.74,
   "text": "مكتسبت. این دو با هم چه فرق می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.74,
   "end": 259.68,
   "text": "دوتاش از ریشه‌ی کاف و سین و به که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.68,
   "end": 262.82,
   "text": "این كسبه، اون اكتسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.82,
   "end": 268.28,
   "text": "چه فرقی با هم دارن این مکسبات و اكتسابات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.28,
   "end": 271.32,
   "text": "که اینجا آیه قرآن صریحاً می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.32,
   "end": 273.8,
   "text": "كسبشون به نفعشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.8,
   "end": 277.02,
   "text": "اكتسابشون بر وزن افتعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.02,
   "end": 281.08,
   "text": "به ضررشونه. این برمی‌گرده به همونچه که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.08,
   "end": 285.66,
   "text": "یعنی انسان بر اثر اصرار بر عملش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.66,
   "end": 288.98,
   "text": "اصرار، اصرار، مداومت هر کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.98,
   "end": 294.6,
   "text": "که اون ملکه‌ی وجودیش تشکیل شد و روسخ کرد در وجودش، در نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.6,
   "end": 298.0,
   "text": "و جانش رو داره آنفعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.0,
   "end": 303.7,
   "text": "همونی می‌کنه که داره عمل می‌کنه و عملش اتحاد وجودی با خودش برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.7,
   "end": 307.54,
   "text": "اگر چنانچه مطابق با فطرت اولیه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.54,
   "end": 312.64,
   "text": "این كسبه. قرآن عنوان كسب به این داده و فرموده لها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.64,
   "end": 315.88,
   "text": "چون بر اساس فطرت اولیه‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.88,
   "end": 318.16,
   "text": "یعنی بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.16,
   "end": 320.66,
   "text": "آفرینشیه که خدا قرار داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.66,
   "end": 324.56,
   "text": "ارتباط با ملکوت داره لذا لها براشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.56,
   "end": 327.36,
   "text": "كسبش براشه. اما اكتساب چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.36,
   "end": 329.92,
   "text": "اكتساب و علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.92,
   "end": 333.52,
   "text": "مكتسبت به علیهشه، به ضررشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.52,
   "end": 339.34,
   "text": "چرا؟ چون این مطابق با فطرت ثانویه‌ایه که خودش برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.34,
   "end": 342.22,
   "text": "ایجاد کرد، ایجاد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.22,
   "end": 345.0,
   "text": "بر اساس اصرار بر عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.0,
   "end": 348.26,
   "text": "و مداومت. که اینجا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.26,
   "end": 350.46,
   "text": "در دو جمله خلاصه‌ش کنم همین بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.46,
   "end": 355.06,
   "text": "كسب مطابق با فطرت اولیه و عقل‌گراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.06,
   "end": 358.06,
   "text": "مرتبط با عالم معناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.06,
   "end": 361.98,
   "text": "مرتبط با ملکوته، كسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.98,
   "end": 365.2,
   "text": "و بر اساس عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.2,
   "end": 371.38,
   "text": "کارش رو انجام میده. یعنی همه چیش عاقلانه‌ست، نگاهش عاقلانه‌ست، خوردنش عاقلانه‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.38,
   "end": 374.32,
   "text": "گوش دادنش عاقلانه‌ست، نوشتنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.32,
   "end": 380.68,
   "text": "خوابیدنش، خوردنش، زناشویی‌ش، بچه‌داری‌ش، سبک زندگی‌ش همه عاقلانه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.68,
   "end": 386.92,
   "text": "که \"ویجعل الرجس على الذين لا يعقلون\" که اگر این نباشه آلودگی و ناپاکی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.92,
   "end": 389.96,
   "text": "این اما اکتساب بر اساس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.96,
   "end": 394.32,
   "text": "اکتساب بر اساس اون فطرت ثانویه و طبع و غریزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.32,
   "end": 397.84,
   "text": "شهواته، طبعشه، طبیعت بدنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.84,
   "end": 404.24,
   "text": "توجه به عرض وجودش که زمینه بدن وجودش، طبیعت وجودش، طبع، عالم طبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.24,
   "end": 406.6,
   "text": "نفس منتبعه کرده فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.6,
   "end": 409.8,
   "text": "فقط به ظهور، همون ظهور دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.8,
   "end": 413.18,
   "text": "عرض شود شؤونات ظاهری دنیا پرداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.18,
   "end": 418.54,
   "text": "به قول حضرت استاد جسارتا ببخشید شکمی پر کنه و خالی کنه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.54,
   "end": 421.26,
   "text": "این می‌شه چی؟ و علیها مكتسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.26,
   "end": 425.76,
   "text": "اما کسی که عاقلانه زندگی می‌کنه این‌طوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.76,
   "end": 428.54,
   "text": "هرچه که کسب می‌کنه براش می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.54,
   "end": 433.1,
   "text": "و برای همین اون اختلاف این دو در کجاست عزیزان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.1,
   "end": 436.52,
   "text": "الان متوجه شدین. ببینید یه مثال می‌زنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.52,
   "end": 440.56,
   "text": "برای سهولت فهم. دو نفر میان یه مسجد می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.56,
   "end": 445.58,
   "text": "هر دو مسجد می‌سازن. یکی مسجد قبا می‌سازه، یکی مسجد ضرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.58,
   "end": 447.82,
   "text": "هر دو یک عمل انجام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.82,
   "end": 452.06,
   "text": "دو نفر اصلاً نماز می‌خونن عین هم بغل هم وایسادن نماز می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.06,
   "end": 454.4,
   "text": "ها؟ ظاهراً یک عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.4,
   "end": 456.8,
   "text": "هیچ فرق و تفاوتی با هم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.8,
   "end": 460.28,
   "text": "چی باعث می‌شه زمین تا آسمون این‌ها با هم متفاوت بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.28,
   "end": 462.84,
   "text": "از یکی قبول بشه از یکی قبول نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.84,
   "end": 466.72,
   "text": "ظاهر که یکیه. پس معلومه این مربوط به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.72,
   "end": 469.5,
   "text": "یا نفس منتبعه یا ظاهر عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.5,
   "end": 471.76,
   "text": "ظاهر که همه هر دو یک کار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.76,
   "end": 475.94,
   "text": "برمی‌گرده به باطن. برمی‌گرده به اون سیرورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.94,
   "end": 482.58,
   "text": "برمی‌گرده به اون سیرتش، به اون مبدأ میلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.58,
   "end": 486.94,
   "text": "حالا اینجا تو مبدأ میل علما، علمای اخلاقی‌ها ما خیلی حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.94,
   "end": 491.3,
   "text": "خیلی خطرناکه اگه انسان مبدأ میلش عوض شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.3,
   "end": 493.42,
   "text": "میلش به چیزی-- اون موقع چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.42,
   "end": 500.66,
   "text": "شما بفرمایید. اگر مبدأ میل کسی به سمت دنیا رفت، نماز می‌خونه برای دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.66,
   "end": 502.96,
   "text": "زیارت می‌ره برای دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.96,
   "end": 506.18,
   "text": "پول صدقه می‌ده به این و اون. دست اینو اون رو می‌بره ولی برای دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.18,
   "end": 510.92,
   "text": "برای شهرت، برای اینکه حاج آقا به به حاج آقا سلام علیکم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.92,
   "end": 513.12,
   "text": "شهرت، برای معروفیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.12,
   "end": 515.7,
   "text": "کتاب می‌نویسه اما در خدمت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.7,
   "end": 519.0,
   "text": "یکی از علما حالا مخصوصاً اسمشو نمی‌برم، از بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.0,
   "end": 523.56,
   "text": "خودش می‌گه تو زندگی نامه‌ش. یه کتاب خیلی معروفی هم داره بر علیه شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.56,
   "end": 526.24,
   "text": "بر علیه شیطان کتاب نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.24,
   "end": 530.68,
   "text": "بعد خیلی به به چه چه و به خودش می‌بالید تا تمثلاً شیطان رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.68,
   "end": 533.34,
   "text": "گفت دیدی چجوری ضربه فنی‌ت کردم با این کتاب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.34,
   "end": 538.84,
   "text": "شیطان قه قه خندید بهش گفت خودم وسطت کردم این کتاب رو بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.84,
   "end": 541.2,
   "text": "می‌شه حالا یه دفعه ده جلد کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 541.2,
   "end": 544.6,
   "text": "بر اساس مبانی ولایت فقیه بنویسه ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.6,
   "end": 548.66,
   "text": "مکتوبه است دیگه نوشت. اما در نهایت جلوی ولی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.66,
   "end": 551.36,
   "text": "ولی فقیه زمانش بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.36,
   "end": 553.94,
   "text": "می‌شه. چرا؟ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.94,
   "end": 557.26,
   "text": "معلومه که غریز، اون غرائز، اون غرضش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.26,
   "end": 560.6,
   "text": "اون میل درونی‌ش دنیا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.6,
   "end": 567.46,
   "text": "خیلی از این بترسیم. برای اینکه ترس باطن نهی ما اینجا بیشتر بشه یه حدیث تقدیم کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.46,
   "end": 569.82,
   "text": "کافی کلینی اهل العلم مقام أبو شریف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.82,
   "end": 572.22,
   "text": "جلد دو، صفحه سیصد و نوزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.22,
   "end": 575.46,
   "text": "امام صادق سلام الله علیه. خواهش می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.46,
   "end": 580.08,
   "text": "با دید عقل این روایت رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.08,
   "end": 582.26,
   "text": "چقدر ترسناکه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.26,
   "end": 586.34,
   "text": "\"من أصبح وأمسى والدنيا أكبر همه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.34,
   "end": 590.82,
   "text": "اگر کسی شب و روز کنه در حالی که بزرگترین همه‌ش دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.82,
   "end": 597.08,
   "text": "خدا باهاش چی کار می‌کنه؟ \"جعل الله تعالی الفقر بین عینيه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.08,
   "end": 600.02,
   "text": "خدا فقر رو تو بین چشاش قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.02,
   "end": 602.6,
   "text": "سیر مونی نداره. هرچی بهش بدی بازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.6,
   "end": 606.06,
   "text": "این حالت قنا نداره. بازم حالت بدبختی و فقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.06,
   "end": 609.76,
   "text": "دیدی بعضیا خیلی دارن الان همش هم مغروزن، همش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 609.76,
   "end": 614.7,
   "text": "در به در از این میخوان پول قرض بگیرن، چک‌شونو پاس کنن، از اون بگیرن این چاله شونو پر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.7,
   "end": 617.86,
   "text": "بدبختن و \"شتت أمره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 617.86,
   "end": 622.28,
   "text": "بدتر از اون اینه که امورش رو خودش چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 622.28,
   "end": 623.86,
   "text": "درش تفرق ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.86,
   "end": 627.24,
   "text": "\"شتت أمره\". اشتداد، دگرگونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.24,
   "end": 629.48,
   "text": "از-- به هم ریختگی. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.48,
   "end": 634.68,
   "text": "\"ولم، ولم نیل من الدنيا الا ما قسم الله له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.68,
   "end": 639.74,
   "text": "تازه از اون چیزی هم که فکر می‌کنه به دنیا رسیده، جز این که خدا تقسیم کرده نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.74,
   "end": 646.32,
   "text": "فکر می‌کنه که داره مثلاً زور بازوشو می‌خوره و اما \"ومن أصبح وأمسى والآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.32,
   "end": 651.28,
   "text": "أكبر همه\". اگر کسی صبح و شب کرد اکبر همه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.28,
   "end": 653.24,
   "text": "بیشترین همه‌ش چی بود؟ آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.24,
   "end": 658.1,
   "text": "خدا چیکار می‌کنه؟ \"جعل الله تعالی القنا في قلبه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 658.1,
   "end": 660.6,
   "text": "تو قلبش قنا و توانگری قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.6,
   "end": 664.26,
   "text": "اگرچه ظاهراً هیچ چیزی نداره اما اصلاً چشمش سیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.26,
   "end": 667.5,
   "text": "اصلاً و ابداً چشم به لذت‌های دنیایی ندوخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.5,
   "end": 670.0,
   "text": "\"وجمع له أمره\". به به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.0,
   "end": 671.76,
   "text": "خدا جمع امر می‌کنه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 671.76,
   "end": 675.38,
   "text": "یعنی از اون تفرق امورش رو سر و سامان می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 675.38,
   "end": 678.54,
   "text": "خب چی بالاتر از این؟ همه اینا برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 678.54,
   "end": 680.78,
   "text": "به باطن. به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.78,
   "end": 684.46,
   "text": "فطرت که انسان اون اصراری که بر اعمالش داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.46,
   "end": 688.08,
   "text": "اونه که در نهایت مبدأ میله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 688.08,
   "end": 691.94,
   "text": "مشخص می‌کنه ما چی کاره هستیم، بهشتی هستیم یا دوزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.94,
   "end": 696.78,
   "text": "انشاالله عاقبتمون ختم بخیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 696.78,
   "end": 699.88,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 699.88,
   "end": 701.98,
   "text": "و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.98,
   "end": 703.9,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}