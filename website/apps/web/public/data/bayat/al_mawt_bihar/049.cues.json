 "chapters": [
  {
   "index": 0,
   "title": "## پذیرش عذر تا شصت سالگی و دام تسویف",
   "start": 11.2,
   "end": 113.02
  },
  {
   "index": 1,
   "title": "## جوانی بستر برکت یا خباثت",
   "start": 113.02,
   "end": 421.2
  },
  {
   "index": 2,
   "title": "## حواریون عیسی و صید انسان",
   "start": 421.2,
   "end": 621.52
  },
  {
   "index": 3,
   "title": "## افلاطون و ظرف وجود جوان؛ با هدایت ریش‌سفید",
   "start": 621.52,
   "end": 720.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.22,
   "end": 5.8,
   "text": "و به مهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.8,
   "end": 11.2,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.2,
   "end": 13.72,
   "text": "در روایت نهام بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.72,
   "end": 17.44,
   "text": "می‌فرمود خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.44,
   "end": 21.86,
   "text": "تا شصت سالگی قبول عذر می‌کنه از انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.86,
   "end": 26.44,
   "text": "از شصت سال به بعد دیگه خدا پذیرش عذر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.44,
   "end": 30.94,
   "text": "کار تمومه. هرچه کرده هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.94,
   "end": 34.7,
   "text": "تا سن شصت سال کرده و این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.7,
   "end": 41.68,
   "text": "رفتش دادیم به بحث بزرگ‌ترین کید و دام شیطان در مسیر انسان که تسویف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.68,
   "end": 45.74,
   "text": "صوفه، صوفه. حالا فردا، حالا فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.74,
   "end": 50.16,
   "text": "در ادامه‌ی این موضوع نکته‌ای را عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.16,
   "end": 52.52,
   "text": "حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.52,
   "end": 57.9,
   "text": "تسویف با تفکر این‌ها جابجا نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.9,
   "end": 61.38,
   "text": "یعنی این نباشه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.38,
   "end": 68.08,
   "text": "تفکر رو تعطیل کنه به بهانه‌ی اینکه مبادا تو دام تسویف بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.08,
   "end": 77.16,
   "text": "تسویف دقت بفرمایید یک وقت هنوز ما خیر و شر رو تشخیص ندادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.16,
   "end": 79.78,
   "text": "نمی‌دونیم الان این کار خیره یا شره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.78,
   "end": 83.0,
   "text": "چی نیازمندش که ما تشخیص بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.0,
   "end": 85.88,
   "text": "چه چیزی لازمه این تشخیص بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.88,
   "end": 87.62,
   "text": "این کار خیره یا شره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.62,
   "end": 90.68,
   "text": "تفکر، تعقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.68,
   "end": 96.32,
   "text": "وقتی تعقل کردی، تفکر کردی، تأمل کردی، تدبر کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.32,
   "end": 99.1,
   "text": "تشخیص دادی این راه خیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.1,
   "end": 101.88,
   "text": "حالا در انجامش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.88,
   "end": 104.26,
   "text": "انجام اون کار خیر و ترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.26,
   "end": 107.16,
   "text": "شر تسویف میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.16,
   "end": 111.12,
   "text": "توجه کردید؟ یعنی تسویف بعد از تفکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.12,
   "end": 116.52,
   "text": "این‌ها جابجا نشن. صوفه، صوفه، حالا فردا و این‌ها که دام بزرگی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.52,
   "end": 120.46,
   "text": "که متأسفانه معمولاً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.46,
   "end": 124.52,
   "text": "چون جوانی انسان میگه حالا فرصت داریم، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.52,
   "end": 126.48,
   "text": "جوونیم بذار عشق و حالمونو بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.48,
   "end": 129.88,
   "text": "یه چند روزه دنیاست اینا بیشتر تو جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.88,
   "end": 134.6,
   "text": "خودش رو نشون میده. لذا بسیار اهل بیت علیهم الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.6,
   "end": 139.12,
   "text": "تأکید کردن که مراقب جوانیتون باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.12,
   "end": 142.68,
   "text": "جوانی هر طور که باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.68,
   "end": 145.88,
   "text": "دیگه تا آخر عمر معمولاً این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.88,
   "end": 149.08,
   "text": "در بر بستر جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.08,
   "end": 151.7,
   "text": "عمر انتها پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.7,
   "end": 158.18,
   "text": "این یک نکته‌ی مهمیه. اگر جوانی پربرکت بوده تا آخر عمر آدم با برکت میره جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.18,
   "end": 161.1,
   "text": "اگر خدایی نکرده با خباثت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.1,
   "end": 167.54,
   "text": "با خباثت میره جلو. یه جمله‌ای رهبر عزیزمون دارن بارها من عرض کردم خیلی جمله‌ی طلاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.54,
   "end": 170.48,
   "text": "فرمودن ما هنوز داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.48,
   "end": 175.18,
   "text": "این پیشرفت‌هایی که تو مملکت هست و این استقامت و ایستادگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.18,
   "end": 181.32,
   "text": "چه و اینا رو همه رو از می‌فرمود بارها حالا به زبان‌های مختلف به الفاظ مختلف یه مضمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.32,
   "end": 187.16,
   "text": "فرمودن که از توبه‌ی زمان جنگ می‌خوریم، از اخلاص جوونی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.16,
   "end": 189.58,
   "text": "اون موقع. واقعاً هم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.58,
   "end": 192.5,
   "text": "خیلی از ما الان چیزی که داریم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.5,
   "end": 195.5,
   "text": "اون صفاء و اون خلوص و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.5,
   "end": 198.06,
   "text": "همون توبه‌ی زمان جوانی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.06,
   "end": 202.38,
   "text": "چون حالا به برکت نفس امام و شهدا و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.38,
   "end": 204.16,
   "text": "یه برکتی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.16,
   "end": 206.44,
   "text": "این‌ها این برکت ادامه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.44,
   "end": 208.7,
   "text": "که حالا برکت خیلی مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.7,
   "end": 211.58,
   "text": "خیلی نکته‌ی بسیار مهمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.58,
   "end": 216.22,
   "text": "که جای جای قرآن هم بهش اشاره کرده در مقابل خباثت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.22,
   "end": 219.5,
   "text": "و بی‌برکتی. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.5,
   "end": 222.54,
   "text": "آیه‌ی پنجاه و هشت سوره‌ی اعراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.54,
   "end": 226.92,
   "text": "اشاره به همین داره که \"والبلد الطيب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.92,
   "end": 230.56,
   "text": "یه سرزمین پاک \"يخرج نباته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.56,
   "end": 233.42,
   "text": "باذن ربه\" به اذن پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.42,
   "end": 237.82,
   "text": "این نباتش، این رویش‌هاش، رستنی‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.82,
   "end": 240.52,
   "text": "هی زیاده، برکت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.52,
   "end": 243.26,
   "text": "چی؟ زمین پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.26,
   "end": 246.74,
   "text": "زمین، زمین پاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.74,
   "end": 249.72,
   "text": "ز-- با زمینه‌ی جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.72,
   "end": 254.76,
   "text": "برکت پیدا می‌کنه. که بعد حالا بعدش دو مرتبه ادامه‌ی همین آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.76,
   "end": 261.52,
   "text": "\"والذي خبث\" چیزی که حالا اون سرزمینی که خبیث شد \"لا يخرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.52,
   "end": 265.84,
   "text": "الا نكدا\" ازش رشد نمی‌کنه مگر تک و توک اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.84,
   "end": 270.96,
   "text": "کج و معوج و عرض شود بی‌برکت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.96,
   "end": 275.5,
   "text": "بی‌خاصیت و چه جالب که حالا در تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.5,
   "end": 277.94,
   "text": "اهل بیت علیهم الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.94,
   "end": 283.06,
   "text": "جلد پنج صفحه صد و هشتاد و شش می‌تونید این روایتو ببینید در تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.06,
   "end": 285.96,
   "text": "نور الثقلین هم ذیل همین آیه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.96,
   "end": 293.78,
   "text": "روایت شیرینیه که به امام حسین صلوات الله علیه رسید عمر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.78,
   "end": 295.92,
   "text": "اِاَ عمرو آس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.92,
   "end": 299.82,
   "text": "عمرو آس ملعون. حالا س-سر اینم که چرا عمرو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.82,
   "end": 304.4,
   "text": "و آس بهش گفتن چون پدرش معلوم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.4,
   "end": 307.04,
   "text": "ده تا پدر داشت ملعون خبیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.04,
   "end": 311.46,
   "text": "بین این‌ها اون که از همه معروف‌تر بود و پولدارتر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.46,
   "end": 314.66,
   "text": "عمرو بود و آس. این دو تا رو بهش چسبوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.66,
   "end": 318.86,
   "text": "شد عمرو آس. می‌گفتن حالا این دو تا رو داشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.86,
   "end": 322.36,
   "text": "بی پدر مادرهایی که جلوی اهل بیت ما اینطوری وایسادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.36,
   "end": 324.38,
   "text": "این ملعون رسید به امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.38,
   "end": 327.44,
   "text": "حالا محاسن پرپشت و پربرکت امام حسین رو که دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.44,
   "end": 329.76,
   "text": "حالا مثلا حالا یه روایتی هم یه جا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.76,
   "end": 332.22,
   "text": "در خصوص امام حسن هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.22,
   "end": 336.28,
   "text": "صلوات الله علیه. حالا این در تفسیر روایی هست ذیل همین آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.28,
   "end": 338.52,
   "text": "که آقا چرا، گفت چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.52,
   "end": 345.52,
   "text": "به امام حسین صلوات الله علیه گفت چرا محاسن شما اینقدر پرپشته بعد محاسن ما اینقدر کمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.52,
   "end": 348.42,
   "text": "و معاویه هم داریم که مثل کوسه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.42,
   "end": 351.06,
   "text": "محاسن نداشت، خیلی کم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.06,
   "end": 355.26,
   "text": "تک و توک. بعد امام حسین اشاره به همین آیه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.26,
   "end": 359.28,
   "text": "که \"والبلد الطيب يخرج نباته باذن ربه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.28,
   "end": 363.92,
   "text": "اشاره به محاسن مبارک خودش کرد که پره به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.92,
   "end": 366.1,
   "text": "این سرزمین پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.1,
   "end": 371.38,
   "text": "مادرم زهرا. بعد اشاره به مغاسن اون خبیث کرد \"والذی خَبَثَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 371.38,
   "end": 373.48,
   "text": "لا یخرج إلا نَکدا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.48,
   "end": 376.56,
   "text": "اون سرزمینی که خبیثه تک و توک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.56,
   "end": 381.3,
   "text": "حالا از فردا کسی رو دیدیم کوسه بود نگیم خبیثه و فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.3,
   "end": 385.68,
   "text": "تفسیر به رای نکنیم. حالا اونجا قصه‌ش هم تو روایت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.68,
   "end": 388.6,
   "text": "باز به یک مضمون دیگه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.6,
   "end": 397.64,
   "text": "که ه-- ذیل همین آیه باز امام فرمود که منظور از این بلد طیب علم امامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.64,
   "end": 400.28,
   "text": "که از خداست و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.28,
   "end": 409.26,
   "text": "سرزمین خبیث آگاهی‌های دشمنانه که تک و توکه، بی‌خاصیته، برکتی هم توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.26,
   "end": 411.64,
   "text": "و و. حالا بماند. پس بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.64,
   "end": 413.92,
   "text": "جوانی رو خیلی جدی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.92,
   "end": 417.52,
   "text": "فرصت هم نیست. داشتم درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.52,
   "end": 420.4,
   "text": "فکر می‌کنم صد و نود و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.4,
   "end": 422.7,
   "text": "فسوس حضرت استاد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.7,
   "end": 425.04,
   "text": "گوش می‌دادم جلسه صوتی‌ش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.04,
   "end": 429.98,
   "text": "ایشون خیلی اونجا تا-- توصیه به جوانی می‌کردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.98,
   "end": 433.36,
   "text": "می‌فرمودن اون داستان معروفِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.36,
   "end": 437.88,
   "text": "ااا حواریون حضرت عیسی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.88,
   "end": 444.0,
   "text": "یحیی-- یوحنا بن زبیدی یا زیدی هم گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.0,
   "end": 450.48,
   "text": "که ایشون معروفه به یوحنای الهی، یوحنای انجیلی، یوحنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.48,
   "end": 453.5,
   "text": "عیسیوی. اینا چند تا لقب بهش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.5,
   "end": 456.6,
   "text": "ااا که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.6,
   "end": 459.88,
   "text": "نویسنده‌ی اناجیل اربعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.88,
   "end": 463.56,
   "text": "و تا آخر عمرش هم همراه حضرت عیسی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.56,
   "end": 468.8,
   "text": "خیلی مهربون بود. مکاشفات حضرت عیسی رو می‌نوشت ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.8,
   "end": 473.54,
   "text": "خیلی در رابطه با عظمت این بزرگوار مطلب نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.54,
   "end": 476.62,
   "text": "تو جوونیش ایشون و داداشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.62,
   "end": 480.06,
   "text": "داشتن با همراهی پدرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.06,
   "end": 482.12,
   "text": "چی کار می‌کردن؟ ماهی می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.12,
   "end": 486.48,
   "text": "حالا این رو هم من از حضرت استاد شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.48,
   "end": 490.74,
   "text": "هم در کتاب دیدم. در کتابی روایتی دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.74,
   "end": 492.68,
   "text": "که ماهی می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.68,
   "end": 495.46,
   "text": "حضرت عیسی از کنار اینا داشت گذر می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.46,
   "end": 499.32,
   "text": "اینجا حضرت استاد علامه حسن زاده داره تاکید می‌کنه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.32,
   "end": 501.56,
   "text": "اهمیت جوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.56,
   "end": 504.82,
   "text": "این دو تا داداش جوون بودند. پدرشون دیگه سنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.82,
   "end": 508.52,
   "text": "بالای شصت سال بود به قول حالا روایت امروز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.52,
   "end": 510.72,
   "text": "بعد حضرت عیسی اینا رو دید رفت نزدیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.72,
   "end": 518.16,
   "text": "بالاخره پیغمبره. کارش دام انداختن برای صید انسان‌هاست، برای رسوندنشون به انسانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 518.16,
   "end": 521.96,
   "text": "که حالا جالب توجه اینایی که میان میگن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 521.96,
   "end": 527.26,
   "text": "چرا پیغمبرها برای ما ارابه و ماشین و موشک و چه و اینا نساختن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.26,
   "end": 532.42,
   "text": "جواب اینه که اه-انبیا اومدن برای انسانیت ما، برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.42,
   "end": 534.18,
   "text": "رشد و تعالی معنوی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.18,
   "end": 536.98,
   "text": "همون فرمایشی که حضرت امام اوایل انقلاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.98,
   "end": 540.58,
   "text": "کنار شهدا فرمودن بعد سوء استفاده شد ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.58,
   "end": 543.28,
   "text": "فرمودن حالا گیریم که همچنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.28,
   "end": 547.76,
   "text": "حکومت موقت گفته بودند که ما آب و برق رو برای شما مجانی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.76,
   "end": 550.76,
   "text": "امام فرمود گیریم هم که مثلا اینطوری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 550.76,
   "end": 554.38,
   "text": "آب و برق شما مجانی. ولی ما اومدیم برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.38,
   "end": 557.88,
   "text": "برای تعالی، برای رشد شما، برای آخرت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.88,
   "end": 562.46,
   "text": "ما برای انس-انسان کردن ما اوم-- انسان کردن شما اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.46,
   "end": 564.96,
   "text": "اصلا تعالیم انبیا این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.96,
   "end": 568.68,
   "text": "حضرت عیسی نکته جالبی به این جوونا گفت و پدرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.68,
   "end": 572.22,
   "text": "سه نفر بودند دیگه. فرمود تا حالا ماهی صید می‌کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.22,
   "end": 575.04,
   "text": "بیایید دست به من پیغمبر خدا بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.04,
   "end": 579.58,
   "text": "با همدیگه بریم انسان صید کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.58,
   "end": 583.62,
   "text": "همین یه جمله. بیایید انسان صید کنیم بندازیم تو دام خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.62,
   "end": 586.24,
   "text": "نه ماهی تو شکم مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.24,
   "end": 588.64,
   "text": "خیلی جالب اومد برای اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 588.64,
   "end": 592.4,
   "text": "دو تا داداشا جوون بودند قبول کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.4,
   "end": 596.92,
   "text": "تاثیر کرد تو وجودشون. اما در پدره تاثیر نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.92,
   "end": 601.18,
   "text": "اون دو تا اومدن جزو حواریون حضرت عیسی شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 601.18,
   "end": 605.08,
   "text": "اما پدره موند. حضرت استاد می‌فرمودن این همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.08,
   "end": 607.0,
   "text": "ا-اتفاقا اشاره به همین جا می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.0,
   "end": 611.84,
   "text": "می‌گفت چرا پدره موند؟ چون اثر کرده بود دنیا تو وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.84,
   "end": 613.56,
   "text": "دیگه شصت سال رو رد کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 613.56,
   "end": 617.7,
   "text": "اما این دو تا نه. اتفاقا افلاطون هم در احوالاتش خوبه اینو بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 617.7,
   "end": 621.52,
   "text": "که این همه هم به عظمت ازش حکما و عرفا یاد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.52,
   "end": 624.48,
   "text": "افلاطون خیلی عاشق جوونا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.48,
   "end": 629.22,
   "text": "مثلا می‌گفت آقا من علمم رو نمیام تو پوست حیوان بنویسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 629.22,
   "end": 636.5,
   "text": "این جوونا بیان من در وعاء قلبشون، در ظرف وجودشون علمم رو بریزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 636.5,
   "end": 640.88,
   "text": "اصلا اینایی که پا به سن گذاشته بودن بود کلاس درسش راه نمیداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.88,
   "end": 644.2,
   "text": "حکمت و عرفان درس میداد. اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 644.2,
   "end": 648.24,
   "text": "به همین خاطر هم در کتاب‌ها به ایشون توهین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 648.24,
   "end": 653.82,
   "text": "یه سری که نفهمیدن جسارتا یه حرفایی درباره افلاطون زدن که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 653.82,
   "end": 657.86,
   "text": "فلان باز بوده مثلا. جوونا دورش بودن و از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 657.86,
   "end": 662.54,
   "text": "خیلی هم حضرت استاد رگ غیرتش می‌جوشید سر این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.54,
   "end": 664.86,
   "text": "که بستن به حضرت افلاطون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 664.86,
   "end": 668.96,
   "text": "علیه الرحمه. فرمود علتش این بود چون می‌گفت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 668.96,
   "end": 672.38,
   "text": "ظرف وجود جوان آماده‌ست، استعداد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.38,
   "end": 675.44,
   "text": "دیگه اونی که سنش پا به سن گذاشته و ریشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 675.44,
   "end": 678.86,
   "text": "سفید شده، اون دیگه کارش تمومه دیگه ول کن بی‌خیال اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 678.86,
   "end": 684.42,
   "text": "بیا جوونا رو بساز. البته این دلیل نمی‌شه که انسان بدون پیر خردمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 684.42,
   "end": 687.46,
   "text": "و بدون آدم با تجربه بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 687.46,
   "end": 691.18,
   "text": "تو وسط میدان و گود میدان، اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 691.18,
   "end": 694.52,
   "text": "خراب می‌کنه. این نه، این بحث اینجا نیست حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 694.52,
   "end": 697.22,
   "text": "همونطور که رهبر فرمودن جوان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 697.22,
   "end": 700.46,
   "text": "شاب، اصلا چقدر روایت پیرامون شاب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.46,
   "end": 703.08,
   "text": "جوان. جوان‌ها برن خط مقدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 703.08,
   "end": 706.06,
   "text": "اما با هدایت ریش سفیدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 706.06,
   "end": 710.5,
   "text": "نه اینکه فقط جوون‌ها بیان پا کار بعد بدون تجربه کار رو خراب کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 710.5,
   "end": 715.42,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 715.42,
   "end": 720.08,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}