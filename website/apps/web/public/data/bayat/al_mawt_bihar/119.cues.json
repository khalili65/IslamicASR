 ],
 "cues": [
  {
   "i": 0,
   "start": 3.06,
   "end": 6.42,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.42,
   "end": 10.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.62,
   "end": 16.24,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.24,
   "end": 18.24,
   "text": "یه سؤال خیلی جدی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.24,
   "end": 23.8,
   "text": "از خودم می‌پرسم شما بشنوید دوست داشتید شما هم جواب بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.8,
   "end": 26.7,
   "text": "چون روایتی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.7,
   "end": 29.82,
   "text": "درش قرار گرفتیم به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.82,
   "end": 33.7,
   "text": "روایت نهم از باب چهارم کتاب الموت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.7,
   "end": 39.62,
   "text": "پیغمبر در سؤالش از اون شخصی که موت رو دوست نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.62,
   "end": 42.32,
   "text": "می‌فرماید \"فقد دمته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.32,
   "end": 44.38,
   "text": "آیا اون مالت رو تقدیم می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.38,
   "end": 50.56,
   "text": "پیشکش می‌کنی؟ این تقدیم می‌کنی، پیشکش می‌کنی مطلق اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.56,
   "end": 55.08,
   "text": "که بعد گفت نه، پیغمبر فرمود برای همین از موت بدت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.08,
   "end": 59.3,
   "text": "یعنی مصداق برای محل خرج کرد و هزینه‌ش نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.3,
   "end": 64.8,
   "text": "پیشکش موت. این وقتی به صورت کلی اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.8,
   "end": 71.78,
   "text": "یعنی می‌شه اینطوری گفت که سؤال رو اینطوری مطرح کرد که چقدر پولت رو خرج موت می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.78,
   "end": 73.58,
   "text": "فرش قرمز موتت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.58,
   "end": 77.42,
   "text": "اصلاً برای موت چقدر پول خرج می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.42,
   "end": 83.6,
   "text": "که قبلاً ما یه وجهش رو گفتیم یعنی برای باطن چقدر خرج می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.6,
   "end": 87.66,
   "text": "خب ما یه موت دیگه داریم به نام موت اختیاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.66,
   "end": 91.32,
   "text": "دیگه می‌دونید. موت قبل ان تموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.32,
   "end": 94.68,
   "text": "اصلاً این روایتی که الان من خوندم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.68,
   "end": 98.74,
   "text": "بمیرید قبل از اینکه بمیرانند شما را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.74,
   "end": 103.9,
   "text": "دیدم بعضیا شلوغش کردن که این حرف متصوفه‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.9,
   "end": 106.92,
   "text": "صوفیا این حرف رو زدن که حالا اگه صوفی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.92,
   "end": 109.9,
   "text": "به معنای اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.9,
   "end": 114.92,
   "text": "محب حکمت و فلسفه و عرفان بگیریم که خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.92,
   "end": 117.3,
   "text": "که در کتاب فخر رازی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.3,
   "end": 122.2,
   "text": "اما وقتی می‌بینیم بزرگانمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.2,
   "end": 127.1,
   "text": "مثل مثلاً آصد ملا آصد حیدر آملی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.1,
   "end": 131.06,
   "text": "جامع الاسرار و منبع الانوارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.06,
   "end": 134.44,
   "text": "این روایت رو به عنوان یک حدیث نبوی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.44,
   "end": 138.36,
   "text": "اگر خواستید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.36,
   "end": 143.12,
   "text": "همین کتابی که عرض کردم خدمتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.12,
   "end": 146.1,
   "text": "کتاب صفحه سیصد و هفتاد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.1,
   "end": 150.0,
   "text": "اینجا من نوشتم. رجوع کنید این روایت رو می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.0,
   "end": 153.3,
   "text": "کتاب بسیار عالی. اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.3,
   "end": 156.88,
   "text": "جامع الاسرار و منبع الانوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.88,
   "end": 160.06,
   "text": "که خیلی از علامه حسن زاده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.06,
   "end": 164.14,
   "text": "این تعریف ایشون ما حرف شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.14,
   "end": 166.68,
   "text": "و یکی هم ملا محسن فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.68,
   "end": 175.88,
   "text": "داماد ملا صدرا در وافی جلد چهار صفحه چهارصد و دوازده اینو به عنوان یک حدیث مشهور بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.88,
   "end": 181.76,
   "text": "حدیث مشهور که بین عرفا و حکما اینا مشهوره که این حدیث اهل بیت یا نبوی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.76,
   "end": 184.68,
   "text": "در هر حال منسوب به اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.68,
   "end": 188.94,
   "text": "خب معناش هم که یعنی چی؟ یعنی بمیر قبل از اینکه تو رو ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.94,
   "end": 195.74,
   "text": "برو بمیر. حالا این موت رو معنای موت اختیاری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.74,
   "end": 200.1,
   "text": "اگر ما بگیریم سفر به باطن یعنی همینجا به باطن سفر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.1,
   "end": 209.02,
   "text": "اگر بگیریم کندن از تعلقات یعنی همینجا قبل از اینکه بکنندت پوستتو، پوست تعلقاتتو بکنند با موت اجباری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.02,
   "end": 214.48,
   "text": "همینجا خودت بکن. اگر بگیریم کندن از اف-- اضافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.48,
   "end": 221.6,
   "text": "بعضیا موت رو اینطوری تعریف کردن که کندن از اضافات هر چیزی که اضافه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.6,
   "end": 224.94,
   "text": "بر وجود خودته، تعلقات به یک معنا یا اضافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.94,
   "end": 227.3,
   "text": "خب همینجا از اضافات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.3,
   "end": 232.0,
   "text": "بکن که از توخ-- اصلاً از، از توحید، توحید چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.0,
   "end": 235.96,
   "text": "اسقاط الاضافات. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.96,
   "end": 238.2,
   "text": "سقط کردن، انداختن اضافه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.2,
   "end": 242.76,
   "text": "هرچی اضافه است، اضافه با خودت نبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.76,
   "end": 245.98,
   "text": "اگر بگیریم موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.98,
   "end": 251.98,
   "text": "اختیاری شه-- کندن از شهواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.98,
   "end": 255.98,
   "text": "که بعضیا اینطوری فرمودن مطلق شهوات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.98,
   "end": 260.84,
   "text": "خواهش‌های دل. نه فقط بحث غریزی، هرچ-- خواهش دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.84,
   "end": 263.74,
   "text": "دوست دارم اینطوری باشم، اونطوری باشم، اینطوری ولی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.74,
   "end": 267.68,
   "text": "نمی‌تونم. این خواهشا از الان بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.68,
   "end": 272.2,
   "text": "حالا سؤال چی بود؟ حالا که این ترجمه رو کردیم و هم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.2,
   "end": 275.44,
   "text": "اونجا حضرت سؤال می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.44,
   "end": 277.74,
   "text": "آیا مالت رو هزینه کردی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.74,
   "end": 284.88,
   "text": "سؤال اینه چقدر مالت رو، چقدر دارایی‌تو هزینه کردی برای موت اختیاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.88,
   "end": 287.2,
   "text": "یعنی برای کندن از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.2,
   "end": 289.56,
   "text": "برای رسیدن به این حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.56,
   "end": 293.48,
   "text": "چطوره که ما یه زلزله محتملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.48,
   "end": 297.1,
   "text": "یه احتمال داره که در آینده نزدیک مثلاً تهران زلزله بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.1,
   "end": 299.28,
   "text": "چقدر مانور زلزله می‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.28,
   "end": 301.74,
   "text": "تو همین سازمان چند نوبت گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.74,
   "end": 304.36,
   "text": "اصرار کردن همکارا بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.36,
   "end": 309.46,
   "text": "تو مدارس گذاشتن. با یه مانور، یه مثلاً زلزله محتمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.46,
   "end": 312.6,
   "text": "یا میره الان کسی که می‌خواد خونه بخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.6,
   "end": 318.9,
   "text": "متعارفه، مرسومه میره دنبال خونه‌هایی که ضد زلزله فونداسیونش خیلی قویه ساخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.9,
   "end": 321.6,
   "text": "خب احتمال داره یه زلزله‌ای بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.6,
   "end": 325.06,
   "text": "یا میره کمک‌های اولیه می‌بینه شاید تو جاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.06,
   "end": 328.68,
   "text": "دور از جون همتون یه تصادفی شد یا یه اتفاقی افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.68,
   "end": 331.86,
   "text": "اینا شاید حالا بدونه چه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.86,
   "end": 334.88,
   "text": "ولی برای امر قطعی مثل موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.88,
   "end": 337.54,
   "text": "ما نباید مانور موت داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.54,
   "end": 341.62,
   "text": "مانور موت، تمرین موت می‌شه همین قو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.62,
   "end": 344.58,
   "text": "موت قبل ان تموت. یعنی همین الان بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.58,
   "end": 348.56,
   "text": "همین الان مثل یه میت شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.56,
   "end": 351.26,
   "text": "که بین یدی الغسال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.26,
   "end": 354.24,
   "text": "بین دو دست غسال هیچ اراده‌ای از خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.24,
   "end": 357.6,
   "text": "بسپر خودت رو به خدای عالم تطهیرت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.6,
   "end": 365.1,
   "text": "اون جمله شریف سردار سلیمانی که \"خدایا مرا پاکیزه بپذیر.\" خودش رو سپرده به دو دست غسال عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.1,
   "end": 367.84,
   "text": "شستشو شوش بده خدا پاک ببرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.84,
   "end": 376.66,
   "text": "الان قبل از اون من سوالم از خودم اینه که چقدر برای این هزینه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.66,
   "end": 378.94,
   "text": "چند بار مانور این قصه رو دادیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.94,
   "end": 382.2,
   "text": "چند تا سفر ما برای درک این موضوع رفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.2,
   "end": 386.48,
   "text": "هزینه کردیم، پول خرج کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.48,
   "end": 390.62,
   "text": "چقدر ما الان تو زندگیمون داریم هزینه برای مسائل مختلف می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.62,
   "end": 392.46,
   "text": "همش هم ضروریاته انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.46,
   "end": 395.86,
   "text": "اما برای این چی؟ حالا این ضروری نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.86,
   "end": 398.36,
   "text": "آیا ضروری‌ترین نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.36,
   "end": 401.06,
   "text": "چقدر هزینه کردیم؟ چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.06,
   "end": 409.12,
   "text": "آدم رو دیدیم که کارشناس و خبره این قصه بودن باهاشون مشورت گرفتیم، وقت گذاشتیم، سفر رفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.12,
   "end": 417.54,
   "text": "خلوت کردیم، زانو غم بغل گرفتیم، فکر کردیم، دغدغه‌مون شد، سؤال پرسیدیم، کتاب خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.54,
   "end": 419.36,
   "text": "برای این آمادگی برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.36,
   "end": 423.04,
   "text": "اینام همش فقط دم تو-- فقط دم تهوئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.04,
   "end": 424.94,
   "text": "که آیا تقدیم کردی چیزی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.94,
   "end": 427.56,
   "text": "وقتت رو، عمرت رو، پولت رو، مالت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.56,
   "end": 430.42,
   "text": "اصن سفر رفتی برای درک این چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.42,
   "end": 435.26,
   "text": "این حقیقت. الان بخوایم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.26,
   "end": 437.5,
   "text": "خونه ب-بفروشیم میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.5,
   "end": 440.9,
   "text": "بیست تا بنگاه میگیم آقا اون که از همه بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.9,
   "end": 446.14,
   "text": "میخره، اون که-- یا می‌خوایم یه چیزی بخریم میریم صد تا جا می‌گردیم که از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.14,
   "end": 447.94,
   "text": "ک-- ارزون‌تر میفروشه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.94,
   "end": 450.48,
   "text": "برای همه چی وقت میذاریم، پول هزینه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.48,
   "end": 453.18,
   "text": "ولی برای این موت، برای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.18,
   "end": 460.18,
   "text": "چقدر ما هزینه می‌کنیم؟ چقدر داریم وقت می‌گذاریم انصافاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.18,
   "end": 465.82,
   "text": "این اتفاقاً بحث فقط دم تهو که در این روایت اومده رو من در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.82,
   "end": 468.96,
   "text": "و بررسی کردم که مشابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.96,
   "end": 471.42,
   "text": "لفظی در یا معنایی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.42,
   "end": 475.04,
   "text": "روایات پیدا می‌شه. چند تا پیدا کردم اگر اجازه هست تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.04,
   "end": 478.74,
   "text": "در قرر الحکم جلد یک صفحه سیصد و هفتاد و شش می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.74,
   "end": 482.6,
   "text": "فرمایشات آقا امیرالمؤمنین علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.6,
   "end": 484.88,
   "text": "که می‌فرماید \"انما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.88,
   "end": 486.72,
   "text": "انما هم چیه؟ حسره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.72,
   "end": 489.2,
   "text": "فقط و فقط. \"لک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.2,
   "end": 491.8,
   "text": "برای توست \"من مالک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.8,
   "end": 497.82,
   "text": "از مالت. یعنی الان چه مقدار مال من، مال منه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.82,
   "end": 500.66,
   "text": "ها؟ چه مقدار از خودم، مال خودمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.66,
   "end": 504.72,
   "text": "چه مقدار از دارایی‌م هرچی که هست مال خودمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.72,
   "end": 507.16,
   "text": "مولا اینجا سر رو آشکار کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.16,
   "end": 511.38,
   "text": "رمز رو باز کرده. \"ما قدمته للآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.38,
   "end": 515.14,
   "text": "ببین قدمته اونجا فرمود فقط دمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.14,
   "end": 521.4,
   "text": "اینجا مولا فرمود \"ما قدمته للآخرة\" که تقدیمش کنی برای آخرتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.4,
   "end": 524.68,
   "text": "پیشکش کنی، بفرستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.68,
   "end": 527.94,
   "text": "خرج کنی در راه‌ها. این مقدار مال توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.94,
   "end": 531.88,
   "text": "بقیش چی می‌شه؟ فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.88,
   "end": 533.88,
   "text": "\"وما أخرته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.88,
   "end": 536.22,
   "text": "اون مقداری که باقی می‌ذاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.22,
   "end": 539.44,
   "text": "\"فللوارث\" مال وارثه، مال بقیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.44,
   "end": 544.0,
   "text": "اون مال تو نیست. حالا البته این در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.0,
   "end": 550.64,
   "text": "زیاده‌روی در بخشش اجازه بدید فردا ورود کنیم که بگیم آیا ما اجازه داریم مثلاً همه‌ی مالمونو چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.64,
   "end": 553.12,
   "text": "صحبت‌ها رو که می‌کنیم به عنوان یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.12,
   "end": 557.34,
   "text": "هیجانی می‌شه. البته ای کاش پیدا بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.34,
   "end": 558.94,
   "text": ". اینجوری اگه می‌دونیم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.94,
   "end": 565.52,
   "text": "بالعکسش هست زیاد. اما اینکه یه دفعه یکی هیجانی بشه خب همه آتش زدم مالم همه رو بخشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.52,
   "end": 569.18,
   "text": "نه شیخ جعفر مجتهدی‌ها رو می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.18,
   "end": 573.74,
   "text": "که مهند-- از آلمان دستگاه آوردن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.74,
   "end": 576.5,
   "text": "حالا صنعت قطعه‌زنی بود، چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.5,
   "end": 579.0,
   "text": "راه انداخته بودن این دستگاه‌ها خراب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.0,
   "end": 581.48,
   "text": "مهندس‌های آلمانی هم ناز می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.48,
   "end": 583.2,
   "text": "نمی‌تونستن اینا رو تعمیر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.2,
   "end": 586.32,
   "text": "مونده بود رو دستشون. چقدر پول هزینه کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.32,
   "end": 589.78,
   "text": "حالا چقدر دلار، یورو به روز چی بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.78,
   "end": 592.48,
   "text": "اون موقع که اصلاً اینا شاید نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.48,
   "end": 595.8,
   "text": "جورای دیگه بود. به هر حال معامله شده بود از آلمان آورده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.8,
   "end": 597.66,
   "text": "تو زندگی‌نامه ایشون من می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 597.66,
   "end": 599.88,
   "text": "بعد مونده بودن چه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.88,
   "end": 604.68,
   "text": "کارخونه مونده بود رو دست بچه‌های ارزشی به قول ما که می‌خوان چهار نفر رو نون برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.68,
   "end": 607.0,
   "text": "بعد مهندس‌های آلمانی ناز می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 607.0,
   "end": 609.34,
   "text": "پیش ایشون گلایه کردن. فرمود برید کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 609.34,
   "end": 614.12,
   "text": "اومد اینا رو تو بازار تهران بگی با چوب دنبالت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.12,
   "end": 616.8,
   "text": "رفت دست گذاشت رو این دستگاه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 616.8,
   "end": 619.56,
   "text": "بلند گفت یا علی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.56,
   "end": 624.86,
   "text": "راه افتادن. بله شیخ جعفرش مجتهدی‌ها می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 624.86,
   "end": 630.42,
   "text": "که همه مالشو ببخشه که اینطوری تقدیم کنن بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.42,
   "end": 634.26,
   "text": "البته حالا در خصوص این باید حرف بزنیم که آیا ما حق داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.26,
   "end": 639.62,
   "text": "همه مالمونو ببخشیم. اگر حق نداریم چرا امثال ایشون یا امام حسن بخشیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 639.62,
   "end": 642.44,
   "text": "اجازه بدید فردا این رمز باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.44,
   "end": 644.32,
   "text": "اما در هر حال س-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 644.32,
   "end": 647.3,
   "text": "نکته بسیار مهمه که هر مقدار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.3,
   "end": 654.0,
   "text": "هزینه کردی برای موتت الان، همین الان هزینه موتت کردی، چه ظاهر، چه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.0,
   "end": 656.44,
   "text": "بحث موت. همون مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.44,
   "end": 658.8,
   "text": "تو آماده موتی و خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 658.8,
   "end": 662.24,
   "text": "عاشق موتی. چرا من بدم میاد از موت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.24,
   "end": 667.08,
   "text": "همه داره پافشاری داریم می‌کنیم اینو بفهمیم و اینو بچشیم البته، نه بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.08,
   "end": 671.2,
   "text": "چون خرجش نمی‌کنیم. یکی از دوستان خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.2,
   "end": 674.16,
   "text": "پیگیر و پرسش و سؤال و چی بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 674.16,
   "end": 676.64,
   "text": "مثلاً شاگرد خوب بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 676.64,
   "end": 679.88,
   "text": "ما قبل از نماز تا دیدیمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 679.88,
   "end": 683.86,
   "text": "ما مثلاً از ما با نگاهش سؤال می‌کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.86,
   "end": 687.66,
   "text": "حقیقت جلسه امروز چیه و فلان و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 687.66,
   "end": 690.78,
   "text": "که خودش انشاالله نخنده به این حرفای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 690.78,
   "end": 699.14,
   "text": "ما یه جمله گفتیم ماحصل صحبت امروز ما اینه که رفیق خوب، دوست خوب اونه که پول خرجت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.14,
   "end": 703.2,
   "text": "الان میگه آقا جون برات میدم‌ها، اما شرمنده پول نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.2,
   "end": 705.06,
   "text": "چرا؟ رو چه حسابی داری اینو میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.06,
   "end": 709.58,
   "text": "رو همین حسابی که الان داریم چند جلسه‌ست داریم صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.58,
   "end": 711.58,
   "text": "تو اگر رفیقت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 711.58,
   "end": 714.36,
   "text": "دوست داری پول خرجش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 714.36,
   "end": 717.98,
   "text": "اصلاً خرجش نکنی دوستش نداری، دروغ میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 717.98,
   "end": 722.24,
   "text": "به فرمایش پیغمبر، امام صادق اینا این همه روایت داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 722.24,
   "end": 724.26,
   "text": "چرا ما امام زمان رو خیلی دوست نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.26,
   "end": 727.3,
   "text": "چون خرج آقا خیلی نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 727.3,
   "end": 729.42,
   "text": "چرا علمامون رو خیلی دوست نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 729.42,
   "end": 734.42,
   "text": "شاید البته جسارتاً چون خب خمس و زکاتمونو با اکراه و فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 734.42,
   "end": 736.98,
   "text": "چرا قرآن؟ چون خرج قرآن نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.98,
   "end": 740.42,
   "text": "چرا مثلا این رفیقمونو بیشتر از اون دوست داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 740.42,
   "end": 743.44,
   "text": "چون برای این خرج می‌کنیم، برای اون نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 743.44,
   "end": 748.12,
   "text": "اینا همش حساب کتابه. فرمود ببین ابن عربی اون روایت رو آورد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 748.12,
   "end": 751.12,
   "text": "کتاب شریفش که قبلاً گفتیم چی فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 751.12,
   "end": 753.54,
   "text": "فرمود که دل‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 753.54,
   "end": 756.74,
   "text": "حدیث قدسی، دل‌ها جاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 756.74,
   "end": 758.9,
   "text": "مالتو اونجا هزینه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 758.9,
   "end": 761.76,
   "text": "اگه این رفیقت واقعاً دلت پیششه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.76,
   "end": 764.78,
   "text": "پول خرجش کن. شده یه بار رفیقتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 764.78,
   "end": 767.6,
   "text": "ادعا می‌کنی دوستت دارم، رفیقتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 767.6,
   "end": 773.18,
   "text": "یهو یه سفر هزینه کنی خرج کنی با خودت ببریش کربلا بگی همه‌ی خرجت با من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 773.18,
   "end": 775.46,
   "text": "نداری یه جور دیگه، یه سفره پهن کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.46,
   "end": 780.2,
   "text": "چه می‌دونم بالاخره این ادعا صرف ادعا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 780.2,
   "end": 783.48,
   "text": "چرا اینو بیشتر دوست داری؟ اتفاقاً یکی از رمزوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 783.48,
   "end": 786.58,
   "text": "اینو خیلی سربسته بگم برن بعد ازش سوءاستفاده نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 786.58,
   "end": 788.24,
   "text": "همین یه ده تا منبر می‌خوادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 788.24,
   "end": 791.34,
   "text": "یعنی می‌خواد پر ملاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 791.34,
   "end": 793.76,
   "text": "یه سریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 793.76,
   "end": 796.84,
   "text": "رمز دلبری کردن یه رمزش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 796.84,
   "end": 802.36,
   "text": "یه رمز خیلی خوب و موفق و مجربش همین پول خرج کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 802.36,
   "end": 804.0,
   "text": "چه کنم فلانیو دوست داشته باشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 804.0,
   "end": 809.26,
   "text": "پول خرجش کن. به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 809.26,
   "end": 812.6,
   "text": "حالا این فلانی کیه؟ دیگه مصادیقش با خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 812.6,
   "end": 816.7,
   "text": "چرا فلانی منو دوست نداره؟ خب پول خرجش نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 816.7,
   "end": 820.64,
   "text": "چرا خدا به پیغمبر فرمود می‌خوای بفهمی کیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 820.64,
   "end": 823.06,
   "text": "واقعاً منو می‌خوان تو رو می‌خوان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 823.06,
   "end": 826.96,
   "text": "بگو از فردا هرکی سؤال، سؤال داره بیاد پول بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 826.96,
   "end": 831.46,
   "text": "پول بده سؤال بده. حالا یه آخوندی بیاد توی مسجدی و‌ها میگیم اون وحی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 831.46,
   "end": 833.92,
   "text": "آره خود ما بیایم یه دفعه یه چیزی بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 833.92,
   "end": 836.26,
   "text": "با چوب دنبالمون می‌کنید همین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 836.26,
   "end": 839.54,
   "text": "با باتوم. کاش با چوب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 839.54,
   "end": 842.9,
   "text": "که دکون بازار راه انداخته برا خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 842.9,
   "end": 846.26,
   "text": "خدا دستور داد پول بگیر سؤال‌هارو جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 846.26,
   "end": 850.24,
   "text": "پول بگیر سؤال جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 850.24,
   "end": 853.14,
   "text": "بعد این کارو کردن هیچکس نیومد جز امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 853.14,
   "end": 855.74,
   "text": "حالا سلمان و ابوذر هم پولاشون تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 855.74,
   "end": 859.62,
   "text": "امیرالمؤمنین قرض کرد اومد سؤالاتشو باز ادامه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 859.62,
   "end": 867.58,
   "text": "اینه که میشه امیرالمؤمنین. اینه که اثبات میشه که واقعاً عاشق خداست، عاشق پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 867.58,
   "end": 872.3,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 872.3,
   "end": 878.94,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 878.94,
   "end": 879.58,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}