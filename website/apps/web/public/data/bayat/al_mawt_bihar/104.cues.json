 "chapters": [
  {
   "index": 0,
   "title": "## روایت هشتم؛ ابراهیم و کراهت مرگ",
   "start": 25.18,
   "end": 216.44
  },
  {
   "index": 1,
   "title": "دلایل بسیار است. قرآن می‌فرماید:",
   "start": 216.44,
   "end": 236.68
  },
  {
   "index": 2,
   "title": "## حره و آیات؛ برتری بر آدم و نوح و لوط",
   "start": 236.68,
   "end": 671.35
  },
  {
   "index": 3,
   "title": "## ابراهیم و موسی و سلیمان؛ لو کشف الغطاء",
   "start": 671.35,
   "end": 692.25
  },
  {
   "index": 4,
   "title": "## بازگشت به وجه کراهت ابراهیم",
   "start": 692.25,
   "end": 901.57
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 5.82,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.82,
   "end": 10.82,
   "text": "صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.82,
   "end": 16.08,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.08,
   "end": 20.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.28,
   "end": 25.18,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.18,
   "end": 27.68,
   "text": "در روایت هشتم بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.68,
   "end": 30.52,
   "text": "از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.52,
   "end": 39.86,
   "text": "عرض کردیم که وقتی حضرت قابض الارواح جهت قبض روح حضرت ابراهیم تشریف آوردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.86,
   "end": 44.14,
   "text": "حضرت ابراهیم سؤال کردند که چگونه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.14,
   "end": 48.4,
   "text": "دوستی مرگ دوستش رو بخواهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.4,
   "end": 53.16,
   "text": "و ایشان رفتند در مقام قرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.16,
   "end": 55.82,
   "text": "حضرت عزرائیل و این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.82,
   "end": 59.58,
   "text": "به خدا واگذار کردند جواب این سؤال رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.58,
   "end": 62.08,
   "text": "و حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.08,
   "end": 71.04,
   "text": "فرمودند با یک جواب بسیار قانع کننده که چگونه است که دوستی کراهت داشته باشه ملاقات دوستش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.04,
   "end": 73.42,
   "text": "گفتیم یکی از وجه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.42,
   "end": 77.82,
   "text": "اون وجوه متعددی که می‌تونه مترتب باشه بر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.82,
   "end": 80.66,
   "text": "سؤال حضرت ابراهیم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.66,
   "end": 89.14,
   "text": "اقتضا می‌کنه اینکـ‌ ایشون که خلیل الرحمن‌اند بلافاصله پس از دعوت حضرت حق لبیک بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.14,
   "end": 96.56,
   "text": "چگونه است که اینجا حضرت قابض الارواح رو متحیر می‌کنه و ایشون رو به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.56,
   "end": 104.32,
   "text": "قرب برمی‌گردونه که رجوع به باطن عالم کنه دو مرتبه توجه به ظاهر عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.32,
   "end": 108.92,
   "text": "و بخواد چنین جوابی رو از حضرت حق به حضرت ابراهیم برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.92,
   "end": 112.64,
   "text": "گفتیم یه وجهش می‌تونه این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.64,
   "end": 115.76,
   "text": "انبیا درسته نبوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.76,
   "end": 121.0,
   "text": "داشتن حتی انبیاء اولو العظم به جز پیغمبر ختمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.0,
   "end": 125.0,
   "text": "پیغمبر عزیز ما بقیه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.0,
   "end": 129.68,
   "text": "تمام مراتب، مراتب قرب نرسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.68,
   "end": 132.3,
   "text": "یعنی می‌شه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.3,
   "end": 134.5,
   "text": "یک درجاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.5,
   "end": 141.52,
   "text": "نتونستند دیگه ظرفیتشون اقتضا نمی‌کرد که تمام اون درجات رو برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.52,
   "end": 145.7,
   "text": "اون ظرف وجودی پیغمبر عزیز عالم بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.7,
   "end": 148.12,
   "text": "القرآن بر او نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.12,
   "end": 153.46,
   "text": "یعنی همه علم حضرت حق که امکان داشت تنزل پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.46,
   "end": 156.1,
   "text": "انبیاء دیگه کتاب‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.1,
   "end": 158.46,
   "text": "مثل قرآن نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.46,
   "end": 160.72,
   "text": "یه بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.72,
   "end": 167.12,
   "text": "علوم الهی بوده. بعضی از انبیا یک صفحه، یک صفحه کتابشون بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.12,
   "end": 169.48,
   "text": "دو صفحه کتابشون بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.48,
   "end": 172.88,
   "text": "سه صفحه کتابشون بوده. این‌چنینی نبوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.88,
   "end": 178.5,
   "text": "قرآن فقط در ظرف وجود پیغمبر نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.5,
   "end": 183.18,
   "text": "حالا دلایلی بر این آیا هست که انبیا به همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.18,
   "end": 186.96,
   "text": "درجات نرسیدند لذا حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.96,
   "end": 192.18,
   "text": "علت این به یک معنا کراهتش از مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.18,
   "end": 201.08,
   "text": "می‌تونه این باشه که دوست داشت در دنیا بماند تا بقیه اون درجات رو بتواند طی کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.08,
   "end": 205.6,
   "text": "لکن حکمت حضرت حق بر این تعلق گرفت که نه او را ببرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.6,
   "end": 214.08,
   "text": "حالا دلایل زیاد \"تلک الرسل فضلنا بعضهم على بعض\" قرآن می‌فرماید که انبیا رو فضیلت دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.08,
   "end": 216.44,
   "text": "برخی رو بر، بر برخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.44,
   "end": 224.2,
   "text": "یکی از دلایل بسیار مهم و متقن ما که از لسان مبارک خود حضرت امیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.2,
   "end": 226.96,
   "text": "صلوات الله علیه خارج شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.96,
   "end": 231.64,
   "text": "بر فضیلت ایشون بر انبیاء پیشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.64,
   "end": 234.24,
   "text": "مخصوصاً حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 234.24,
   "end": 236.68,
   "text": "روایتی‌ست که مشهور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.68,
   "end": 243.06,
   "text": "فریقین جالبه که بدانید این روایت رو نقل کردند و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.06,
   "end": 246.16,
   "text": "در بحار جلد چهل و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.16,
   "end": 249.8,
   "text": "صفحه صد و سی و چهار تا صد و سی و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.8,
   "end": 253.82,
   "text": "یه روایت دیگه‌ای خیلی شیرین وارد شده که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.82,
   "end": 255.78,
   "text": "اجمالاً این روایت رو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.78,
   "end": 260.28,
   "text": "همون فرمایش مولا است اما به یک نقل تاریخی زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.28,
   "end": 262.82,
   "text": "که حره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.82,
   "end": 265.78,
   "text": "دختر حلیمه سعدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.78,
   "end": 268.34,
   "text": "که بـ- خواهر رضاعی پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.34,
   "end": 271.9,
   "text": "یعنی چی؟ رضاعی با عین یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.9,
   "end": 275.14,
   "text": "شیر خورده بودند از یک مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.14,
   "end": 280.64,
   "text": "خواهر رضاعی حلیمه سعدیه، خواهر رضاعی پیغمبر شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.64,
   "end": 283.1,
   "text": "و دخترش به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.1,
   "end": 287.24,
   "text": "حره. ایشون وقتی وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.24,
   "end": 289.88,
   "text": "تاج و تخت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.88,
   "end": 295.28,
   "text": "پایگاه حکومتی حجاج بن یوسف ثقفی با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.28,
   "end": 297.8,
   "text": "سفاکی و خونریزی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.8,
   "end": 299.96,
   "text": "اصلاً اعتنا به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.96,
   "end": 302.7,
   "text": "ظاهراً جلالت حجاج نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.7,
   "end": 305.24,
   "text": "خیلی وزین قدم برمی‌داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.24,
   "end": 306.92,
   "text": "و ظاهراً کسی رو کار داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.92,
   "end": 309.36,
   "text": "اونجا رفت و البته حجاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.36,
   "end": 315.22,
   "text": "شنیده بود در شأن ایشون که یه کسی هست دختر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.22,
   "end": 318.88,
   "text": "حلیمه سعدیه، خواهر رضاعی پیغمبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.88,
   "end": 322.86,
   "text": "و عقیده دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.86,
   "end": 330.04,
   "text": "امیرالمؤمنین علی ابن ابی طالب برتر است از صحابه، از اولی و دومی و سومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.04,
   "end": 333.34,
   "text": "برتر از اینا. خیلی دوست داشت که ایشون رو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.34,
   "end": 335.28,
   "text": "به جهت نسبش به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.28,
   "end": 338.56,
   "text": "خب جرات نمی‌کرد جسارتی به ایشون بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.56,
   "end": 341.18,
   "text": "ولی خب شما می‌دونید حجاج خیلی سفاک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.18,
   "end": 346.76,
   "text": "یعنی می‌گن از زنگ تفریح‌های این ملعون خبیث این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.76,
   "end": 348.84,
   "text": "می‌گفت دل ما گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.84,
   "end": 354.8,
   "text": "به جای دلقک آوردن می‌گفت برید بگردید یه محب علی رو پیدا کنید جلوی من سرش رو ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.8,
   "end": 357.62,
   "text": "این جلوی من دست و پا بزنه من دلم باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.62,
   "end": 363.56,
   "text": "مثلاً اینطوری بود. می‌گشتند یه کسی که محب امیرالمؤمنین پیدا کنند جلوش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.56,
   "end": 365.68,
   "text": "وقتی در پرپر می‌زنه کیف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.68,
   "end": 368.47,
   "text": "یه همچین آدمی بود. حالا حساب کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.47,
   "end": 371.57,
   "text": "توی یه همچین تاج و تختی حره وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.57,
   "end": 375.67,
   "text": "یه دختری، یه زنی با اون صلابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.67,
   "end": 378.75,
   "text": "و متانت البته. بهش گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.75,
   "end": 380.85,
   "text": "تو کی هستی؟ گفت من حره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.85,
   "end": 385.07,
   "text": "فهمید از طرز وجاهت این دختر و زن فهمید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.07,
   "end": 387.03,
   "text": "زن عادی نیست. گفت تو کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.03,
   "end": 391.31,
   "text": "گفت من حره‌ام. دختر حلیمه سعدیه اینها تا گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.31,
   "end": 395.43,
   "text": "گفت عجب! پس تو هستی. من مدت‌هاست که منتظر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.43,
   "end": 398.85,
   "text": "مترصد این بودم تو رو ببینم و از تو یه سوالی بپرسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.85,
   "end": 402.71,
   "text": "شنیدم که تو اقرار کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.71,
   "end": 406.57,
   "text": "علی ابن ابی طالب برتر از، از صحابه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.57,
   "end": 409.89,
   "text": "حتی اولی و دومی و سومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.89,
   "end": 416.31,
   "text": "و ایشون هم با شجاعت تمام جلوی اون ملعون خبیث گفت نه اینکه برتر است از اون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.31,
   "end": 425.19,
   "text": "بلکه از کسانی که از صحابه پیغمبر هم بالاترند علی ابن ابی طالب بالاتر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.19,
   "end": 429.01,
   "text": "حجاج گفت ادعای سنگینی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.01,
   "end": 434.59,
   "text": "چه کسانی‌اند که از اون خلفا برترند که اگر نتونی این رو ثابت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.59,
   "end": 439.95,
   "text": "همینجا تو رو می‌کشم. و ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.95,
   "end": 443.41,
   "text": "با صلابت و با تمسک به قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 443.41,
   "end": 448.95,
   "text": "فرمود که اون کسانی که برتر از صحابه پیغمبرند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.95,
   "end": 456.03,
   "text": "انبیاء الهی‌اند. مثل بعد اسم برد مثل حضرت آدم و نوح و لوط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.03,
   "end": 459.03,
   "text": "ابراهیم و حضرت ابراهیم رو هم اسم برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.03,
   "end": 464.33,
   "text": "ابراهیم و موسی و سلیمان و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.33,
   "end": 468.83,
   "text": "بعد حجاج گفت خب ادعایی که می‌کنی ثابت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.83,
   "end": 471.61,
   "text": "چگونه تو همچین چیزی رو ادعا می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.61,
   "end": 477.51,
   "text": "شروع کرد. حالا تمسک زیبایی کار حره اینه که با آیات قرآن جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.51,
   "end": 481.15,
   "text": "حالا بخشی‌ش رو من خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 481.15,
   "end": 485.81,
   "text": "در خصوص برتری علی ابن ابی طالب بر حضرت آدم اشاره کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.81,
   "end": 488.07,
   "text": "به آیه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.07,
   "end": 491.47,
   "text": "\"وعصى آدم ربه فغوى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.47,
   "end": 494.87,
   "text": "آدم پروردگارش رو عصیان کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.87,
   "end": 498.17,
   "text": "فغوى گمراه شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.17,
   "end": 500.75,
   "text": "ایشون حضرت حره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.75,
   "end": 503.93,
   "text": "به حجاج صفاک داره میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.93,
   "end": 506.99,
   "text": "تو ببین این آیه در حق آدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.99,
   "end": 510.93,
   "text": "که امـ-- جزو انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.93,
   "end": 517.89,
   "text": "لکن در خصوص خانواده امیرالمؤمنین فرمود \"وکان سعیک مشکوراً\" قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.89,
   "end": 520.35,
   "text": "بعد دو مرتبه اشاره کرد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.35,
   "end": 525.43,
   "text": "قصه‌ی اینکه تمام نعمت‌های بهشت در اختیار حضرت آدم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.43,
   "end": 531.93,
   "text": "و حوا فقط خدا منع‌شون کرد از یک درخت \"ولا تقربا هذه الشجرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.93,
   "end": 534.81,
   "text": "فتكونا من الظالمین\". نزدیک این درخت نشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.81,
   "end": 537.35,
   "text": "که از ظالمین می‌شید. اتفاقاً همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.35,
   "end": 541.09,
   "text": "درخت منهی رو هم نزدیک شدند و از اون خوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.09,
   "end": 545.39,
   "text": "اما امیرالمؤمنین با این همه نعمت‌هایی که حلال او بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.39,
   "end": 548.17,
   "text": "لب به هیچی نزد که هیچی حتی نان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.17,
   "end": 550.25,
   "text": "گندم رو هم در دنیا نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.25,
   "end": 553.29,
   "text": "مولا قوت غالبشون نان جو بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.29,
   "end": 556.15,
   "text": "نان گندم که حلالش بود نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.15,
   "end": 559.55,
   "text": "پس این دلیل بر برتریه. البته این رو دارم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.55,
   "end": 565.55,
   "text": "چندین روایت دیگه داریم که خود امیرالمؤمنین این‌ها رو به سعسعة بن صوهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.55,
   "end": 569.79,
   "text": "در سؤال از مولا که می‌پرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.79,
   "end": 572.91,
   "text": "د-دلیل برتری شما بر انبیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.91,
   "end": 575.77,
   "text": "پیغمبر-- امیرالمؤمنین این‌ها رو می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.77,
   "end": 577.81,
   "text": "این‌ها هم بزرگ شده این مکتبن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.81,
   "end": 582.13,
   "text": "از خودشون حرف نمی‌زنن. حضرت حره هم داره به اون‌ها اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.13,
   "end": 587.75,
   "text": "بعد طوری بیان کرد از قرآن که حجاج گفت احسنت، احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.75,
   "end": 593.27,
   "text": "حالا دلالت بر برتر بودن علی ابن ابی طالب از لوط و نوح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.27,
   "end": 597.77,
   "text": "می‌دونید در قرآن همسر نوح و لوط جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.77,
   "end": 604.09,
   "text": "اه کفار و این‌ها شناخته شدند و این‌ها اهل اطف-- آتش‌اند، اهل نجات نشدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.09,
   "end": 607.39,
   "text": "قرآن میگه ما تو رو و اهلت رو نشا-- نجات میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.39,
   "end": 613.59,
   "text": "هم در خواست حضرت لوط هم نوح \"الا ام لمراة لك الا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 613.59,
   "end": 616.53,
   "text": "همسرت \"وکان من الغابرین\" که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.53,
   "end": 620.07,
   "text": "اونجا مونده، اون جزو اهل نجات نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 620.07,
   "end": 623.31,
   "text": "چقدر قشنگ حضرت حره اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.31,
   "end": 627.01,
   "text": "همسران اون‌ها با اینکه انبیا بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 627.01,
   "end": 629.95,
   "text": "اهل آتش‌اند. اما خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.95,
   "end": 635.67,
   "text": "پیغمبر عزیز عالم در خصوص دخترش فاطمه که همسر علی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 635.67,
   "end": 639.89,
   "text": "فرمود که \"والله مع رضا Fatemeh\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 639.89,
   "end": 645.79,
   "text": "رضایت و خشنودی خدا به اتفاق رضایت فاطمه‌ست و غضبش هم به اتفاق غضب او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.79,
   "end": 649.05,
   "text": "با این استدلال ایشون بر برتریته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 649.05,
   "end": 651.51,
   "text": "و باز ایشون گفت احسنت، احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 651.51,
   "end": 656.23,
   "text": "یعنی یه کاری کرد که شقی‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 656.23,
   "end": 658.61,
   "text": "دشمنان ولایت داره احسنت میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 658.61,
   "end": 663.21,
   "text": "چقدر خوبه آدم اینطوری دفاع کنه از ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 663.21,
   "end": 666.25,
   "text": "بعد عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 666.25,
   "end": 668.81,
   "text": "در خصوص برتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 668.81,
   "end": 671.19,
   "text": "بعد حالا وقتی حجاج این رو گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.19,
   "end": 674.05,
   "text": "گفت در خصوص ابراهیم چی داری به ما بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 674.05,
   "end": 680.05,
   "text": "برتری ابراهیم. اشاره کرد حضرت حره به این آیه \"واذ قال ابراهیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 680.05,
   "end": 685.29,
   "text": "وقتی حضرت ابراهیم گفت \"رب ارنی كيف تحی الموتى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 685.29,
   "end": 687.79,
   "text": "خدایا به من نشون بده چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 687.79,
   "end": 689.45,
   "text": "مرده‌ها رو زنده می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 689.45,
   "end": 692.25,
   "text": "\"قال اولم تومن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.25,
   "end": 694.33,
   "text": "خدا گفت آیا ایمان نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.33,
   "end": 698.17,
   "text": "\"قال بلی\". بله، ایمان دارم \"ولکی لیطمئن قلبی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.17,
   "end": 703.53,
   "text": "حضرت ابراهیم به خدا عرض کرد دوست دارم قلبم مطمئن بشه، آروم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 703.53,
   "end": 707.63,
   "text": "اینجا امیرالمؤمنین علیه الصلاة والسلام به سعسعة هم همین رو می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 707.63,
   "end": 710.53,
   "text": "حره هم همین رو میگه به حوج-- حجاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.53,
   "end": 712.73,
   "text": "میگه که ولی در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.73,
   "end": 714.93,
   "text": "ام-- حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.93,
   "end": 719.67,
   "text": "که دیگه به مقام امامت هم در میان انبیا رسیده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.67,
   "end": 721.77,
   "text": "باز اینجا می‌خواد به اطمینان قلبی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.77,
   "end": 725.79,
   "text": "در حالی که امیرالمؤمنین علی ابن ابی طالب فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.79,
   "end": 729.53,
   "text": "\"لو كشف القطا لمزددت يقينا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 729.53,
   "end": 732.47,
   "text": "اگه پرده‌ها بیفته اصلاً به یقین من اضافه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.47,
   "end": 738.21,
   "text": "اطمینان قلبی چیه؟ یعنی انقدر رفته تردید کرده بین عالم غیب و شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 738.21,
   "end": 741.71,
   "text": "براش یکسانه. چه در عالم شهود باشه چه عالم غیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 741.71,
   "end": 743.57,
   "text": "براش یکسانه. پس برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 743.57,
   "end": 748.69,
   "text": "باز گفت احسنت، احسنت. در خصوص موسی چی داری که برتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 748.69,
   "end": 752.53,
   "text": "ایشون اشاره کرد به آیه \"فيخرج منها خائفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.53,
   "end": 754.75,
   "text": "يترقب\" که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 754.75,
   "end": 756.85,
   "text": "موسی می‌دونید با مشت زد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 756.85,
   "end": 759.35,
   "text": "قبطی، قبطی رو کشت و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.35,
   "end": 761.17,
   "text": "در مصر بعد فراری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 761.17,
   "end": 764.43,
   "text": "\"يترقب خائفا يترقب\" ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 764.43,
   "end": 767.07,
   "text": "فرار کرد که نکشنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 767.07,
   "end": 770.65,
   "text": "بعد ایشون اشاره کرد به \"ليلة المبيت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 770.65,
   "end": 775.85,
   "text": "و این آیه‌ای که در شأن امیرالمؤمنین نازل شده که \"ومن الله ما يشري",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.85,
   "end": 778.81,
   "text": "نفسه ابتغاء مرضات الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 778.81,
   "end": 780.91,
   "text": "که امیرالمؤمنین با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 780.91,
   "end": 786.19,
   "text": "قطعاً یعنی هر عاقلی می‌گفت هرکی اون شب بخوابه جای پیغمبر کشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.19,
   "end": 788.41,
   "text": "با این حال امیرالمؤمنین نترس و رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 788.41,
   "end": 792.11,
   "text": "نترسید و رفت خوابید جای پیغمبر و این آیه درباره‌ش نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 792.11,
   "end": 796.51,
   "text": "پس از موسی بالاتر است و در خصوص سلیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 796.51,
   "end": 800.61,
   "text": "دیگه هی گفت، گفت، گفت. حالا در خصوص سلیمان چی داری به ما بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 800.61,
   "end": 804.85,
   "text": "در خصوص سلیمان هم ایشون چقدر زیبا اشاره کرد به این آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 804.85,
   "end": 808.15,
   "text": "قرآن می‌فرماید سلیمان از خدا تقاضا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 808.15,
   "end": 810.55,
   "text": "\"واغفر رب اغفر لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.55,
   "end": 816.21,
   "text": "خدایا منو ببخش \"وهب لي ملكا لا ينبغي لأحد من بعدي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 816.21,
   "end": 819.31,
   "text": "یه سلطنتی، پادشاهی به من بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 819.31,
   "end": 822.37,
   "text": "که به احدی بعد از من ندادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 822.37,
   "end": 825.13,
   "text": "این خواستگاه سلیمان نبی از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 825.13,
   "end": 828.89,
   "text": "در حالی که امیرالمؤمنین علیه الصلاة والسلام علی ابن ابی طالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 828.89,
   "end": 833.39,
   "text": "چنان دنیا رو سه طلاقه کرده بود که اصلاً توجه به دنیا نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.39,
   "end": 836.75,
   "text": "می‌گفت اصلاً برو دنیا برو در خانه کسی دیگه رو بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 836.75,
   "end": 842.61,
   "text": "ما رو با تو کاری نیست. پس برتر از سلیمان است که دیگه خلاصه دستبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 842.61,
   "end": 845.53,
   "text": "هجاج بسته شد و و اعلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 845.53,
   "end": 847.81,
   "text": "آزادی این زن رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 847.81,
   "end": 854.65,
   "text": "سابقه نداشت یه امیرالمؤمنین بره تو کاخ این ملعون بعد بره سر سلامت به در ببره و از اونجا بره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 854.65,
   "end": 857.55,
   "text": "این ببین تیزیه. حالا بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 857.55,
   "end": 862.09,
   "text": "وقتی این‌ها از امیرالمؤمنین مقامشون پا-بالا-- پایین‌تره یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 862.09,
   "end": 866.67,
   "text": "یعنی باز رتبه‌ها و مراتبی مونده بوده که این‌ها برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 866.67,
   "end": 872.87,
   "text": "من جمله حضرت ابراهیم که حضرت امیرالمؤمنین تا اون انتها رو رفته بود اما حضرت ابراهیم هنوز نرسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 872.87,
   "end": 880.23,
   "text": "لذا این وجه می‌تونه درست باشه که تقاضای یعنی این حالا جسارتاً کراهت حضرت ابراهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.23,
   "end": 885.21,
   "text": "دیگه لفظ نداریم چی بگیم. برای یا سؤالش برای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 885.21,
   "end": 890.85,
   "text": "اینه که دوست داشت بیشتر در دنیا بمونه و اون مراتبی که هنوز نرفته رو ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 890.85,
   "end": 895.75,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 895.75,
   "end": 901.57,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}