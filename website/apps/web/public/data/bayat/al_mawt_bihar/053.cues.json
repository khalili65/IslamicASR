 "chapters": [
  {
   "index": 0,
   "title": "## مرز تشخیص عذاب و امتحان",
   "start": 26.34,
   "end": 173.64
  },
  {
   "index": 1,
   "title": "## امام هادی؛ تربیت کودک شش‌ساله و شکستِ نقشهٔ دربار",
   "start": 173.64,
   "end": 413.9
  },
  {
   "index": 2,
   "title": "## شماتتِ بی‌تحقیق؛ بار سنگین بر دوش آل‌الله",
   "start": 413.9,
   "end": 616.32
  },
  {
   "index": 3,
   "title": "## حضرت ایوب و تلخی شماتت دوستان",
   "start": 616.32,
   "end": 842.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 13.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.78,
   "end": 18.56,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.56,
   "end": 21.2,
   "text": "تسلیت عرض می‌کنم روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.2,
   "end": 24.78,
   "text": "شهادت جانسوز حضرت امام هادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.78,
   "end": 28.3,
   "text": "صلوات الله عليه رو بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.3,
   "end": 31.82,
   "text": "رسید به چنانچه خاطرتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.82,
   "end": 35.24,
   "text": "روایت اول از باب سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.24,
   "end": 39.72,
   "text": "کتاب الموت مرحوم مجلسی در بحث این بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.72,
   "end": 42.76,
   "text": "گفتیم ما نمی‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.76,
   "end": 45.44,
   "text": "صراحتاً بگیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.44,
   "end": 52.1,
   "text": "این از ظاهراً بلاهایی که نازل می‌شه مثل کرونا، اومیکرون، زلزله‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.1,
   "end": 54.2,
   "text": "سیل‌ها اینا عذاب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.2,
   "end": 58.74,
   "text": "ما در اون حد نیستیم، علمش رو نداریم، حکمتش رو نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.74,
   "end": 62.82,
   "text": "و در اون حدم نیستیم که کسی رو که بلا زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.82,
   "end": 69.52,
   "text": "تشخیص بدیم که این واقعاً عذاب معذب شده، عذاب الهی براش نازل شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.52,
   "end": 71.74,
   "text": "گناه و معصیت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.74,
   "end": 76.34,
   "text": "یا اینکه نه یک امتحانیه که خدا بهش درجه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.34,
   "end": 78.68,
   "text": "اینجا بودیم، بحث اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.68,
   "end": 82.58,
   "text": "سؤال پیش میاد پس این همه عذاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.58,
   "end": 87.2,
   "text": "معذب شدن و عقابی که صراحتاً در قرآن اومده چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.2,
   "end": 90.18,
   "text": "قوم عاد، قوم ثمود، قوم لوط، قوم حضرت نوح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.18,
   "end": 97.06,
   "text": "اینا همه گرفتار بلا شدن، عذاب صراحتاً قرآن میگه عذاب نازل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.06,
   "end": 100.24,
   "text": "این‌ها چگونه است؟ یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.24,
   "end": 103.54,
   "text": "در رفتار اهل بیت می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.54,
   "end": 107.82,
   "text": "یا اباعبدالله در کربلا نفرین کردند در جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.82,
   "end": 111.86,
   "text": "عذاب نازل شد به درک واصل شدند یه سری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.86,
   "end": 118.88,
   "text": "می‌گیم این‌ها بله اینجایی که صراحتاً قرآن و اهل بیت فرمودن این آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.88,
   "end": 124.5,
   "text": "می‌شه شماتتش کرد. اینجایی که اهل بیت و قرآن صراحتاً گفتن عذابه، می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.5,
   "end": 130.04,
   "text": "اون قومی که عذاب برش نازل شده رو گفت معذب شدند و شماتتشون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.04,
   "end": 134.92,
   "text": "یا شخصی که اهل بیت دست گذاشتن که حالا روایات تاریخی زیاد داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.92,
   "end": 140.8,
   "text": "و البته اهل بیت علیهم الصلاة والسلام هم روایات در خصوص همه آل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.8,
   "end": 144.84,
   "text": "حتی امام عصر عزیزمون داشتیم و داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.84,
   "end": 147.8,
   "text": "شماتت کردند بعضی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.8,
   "end": 151.48,
   "text": "توبیخ کردند. این‌ها رو داشتیم، داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.48,
   "end": 156.74,
   "text": "اصلاً پیغمبر بعضی‌ها رو گفت اینا مرتدند برن بکشینشون توبه هم کردن بکشینشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.74,
   "end": 160.28,
   "text": "مثل اون ملعونی که در هجرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.28,
   "end": 164.5,
   "text": "شتری که حضرت زهرا سلام الله عليها سوارش بود رو رم داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.5,
   "end": 169.32,
   "text": "خانم افتاد. حالا اتفاقاً امیرالمؤمنین اون رو به درک واصل کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.32,
   "end": 172.08,
   "text": "همون شخص رو. داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.08,
   "end": 177.98,
   "text": "یا مثلاً همین عزیزی که امروز روز شهادت‌شونه امام هادی صلوات الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.98,
   "end": 181.62,
   "text": "حالا کتاب دویست و پن-- انسان دویست و پنجاه ساله‌ی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.62,
   "end": 184.42,
   "text": "رهبر عزیزمون رو که خونده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.42,
   "end": 189.18,
   "text": "نکات خیلی شنیدنی و جالبی پیرامون زندگانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.18,
   "end": 194.7,
   "text": "ائمه داره از رسول الله بگیر تا امام عصر دوصد و پنجاه سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.7,
   "end": 198.58,
   "text": "شما فرض کنی انسان دویست و پنجاه ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.58,
   "end": 203.26,
   "text": "اونجا پیرامون امام هادی نک-نکات خیلی شیرین رو آقا پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.26,
   "end": 206.98,
   "text": "خیلی جالب. به عنوان نمونه می‌فرمایند که خب می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.98,
   "end": 211.3,
   "text": "وقتی که معتصم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.3,
   "end": 214.14,
   "text": "امام جواد رو در سال دویست و هجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.14,
   "end": 217.04,
   "text": "قمری تبعید کرد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.04,
   "end": 226.16,
   "text": "مدینه به بغداد. خب هدفش این بود که کلاً نسل حضرت زهرا رو قطع کنه، قطع نسل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.16,
   "end": 230.76,
   "text": "با حضرت جواد الائمه که گفت‌وگو می‌کرد، متوجه شد که ایشون یه بچه‌ای داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.76,
   "end": 234.44,
   "text": "فرزندی داره شش ساله به نام علی ابن محمد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.44,
   "end": 237.06,
   "text": "مدینه. خیلی برأفتخته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.06,
   "end": 239.82,
   "text": "گفت عجب پس حالا که اینطوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.82,
   "end": 247.68,
   "text": "اگر ما اینم بکشیم هنوز نسلش تو مدینه هست، یکی رو می‌فرستم اونو مرتد کنه، اصلاً از راه به درش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.68,
   "end": 250.1,
   "text": "که شخصی رو حالا فرستاد رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.1,
   "end": 253.4,
   "text": "از بغداد به مدینه. می‌دونید روایتشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.4,
   "end": 256.88,
   "text": "که یه عالمی رو اونجا که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.88,
   "end": 260.74,
   "text": "عالم درباری بود پیدا کرد به نام الجُنَیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.74,
   "end": 263.86,
   "text": "تو تاریخ اومده که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.86,
   "end": 266.1,
   "text": "بغض اهل بیت تو سینش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.1,
   "end": 270.04,
   "text": "اینو مأمور کرد که شما برو سراغ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.04,
   "end": 276.3,
   "text": "نوجوان شش ساله و اون رو تحت تربیت خودت قرار بده و منزجر کن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.3,
   "end": 280.56,
   "text": "کلاً اجدادش و بکش اون سمت دربار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.56,
   "end": 286.48,
   "text": "ایشون هم رفت و پیدا کرد امام هادی رو مثلاً مشغول تربیت امام هادی شش ساله شد در مدینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.48,
   "end": 295.14,
   "text": "یه مدتی گذشت و اون پی که دربار دو مرتبه اومد بپرسه چه خبره بالاخره مثلاً علی ابن محمد مرتد شده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.14,
   "end": 297.76,
   "text": "اومد الجُنَیدی رو دید گفت از این بچه چه خبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.76,
   "end": 301.1,
   "text": "گفت بچه؟ کی؟ الجُنَیدی اون عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.1,
   "end": 304.94,
   "text": "اونچنان گفت بچه؟ دهانت را بشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.94,
   "end": 308.56,
   "text": "بچه چیه؟ اصلاً اینا علم رو قورت دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.56,
   "end": 316.38,
   "text": "من ادب می‌خوام مثلاً بابی از ادب رو می‌خوام بهش بگم، او ابوابی از آداب الهی رو برای من باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.38,
   "end": 318.18,
   "text": "گاهی اوقات می‌خوام معذبش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.18,
   "end": 321.04,
   "text": "اذن ورود به حجره که می‌گیره بچه بود آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.04,
   "end": 323.78,
   "text": "می‌گم یه سوره طولانی رو می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.78,
   "end": 328.68,
   "text": "می‌گم مثلاً آل عمران کل آل عمران رو می‌خونه بعد تفسیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.68,
   "end": 330.82,
   "text": "تأویل می‌کنه. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.82,
   "end": 333.24,
   "text": "ما شیفته‌ش شدیم. خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.24,
   "end": 337.28,
   "text": "سرتون رو درد نیارم. همین عالم یکی از شیعیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.28,
   "end": 340.9,
   "text": "مخلص آقا امام هادی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.9,
   "end": 342.5,
   "text": "ببینید بعد حالا بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.5,
   "end": 345.06,
   "text": "بحث شماتت بود. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.06,
   "end": 349.66,
   "text": "خب زورشون نرسید. بعداً خب کلاً ایشون چهل و دو سال زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.66,
   "end": 354.74,
   "text": "کردن امام هادی. بیست سالشو تو سامرا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.74,
   "end": 357.56,
   "text": "یعنی بیست و دو سال مدینه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.56,
   "end": 360.78,
   "text": "بعد که تبعید شدند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.78,
   "end": 364.1,
   "text": "سامرا، اونجا به اتفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.1,
   "end": 369.1,
   "text": "امام عسکری فرزند خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.1,
   "end": 370.76,
   "text": "خیلی محبوبیت پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.76,
   "end": 374.8,
   "text": "مردم دورشون رو گرفتن و اونجا اون زمان زمان دیگه متوکل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.8,
   "end": 376.48,
   "text": "معتصم به درک واصل شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.48,
   "end": 378.74,
   "text": "متوکل نتونست این جریان رو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.74,
   "end": 382.28,
   "text": "هرچی فکر کرد چرا اینا انقدر محبوبن و ما نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.28,
   "end": 385.42,
   "text": "چرا مردم گرد اینان و گرد ما نیستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.42,
   "end": 388.58,
   "text": "حسدش گل کرد. بعد به یه رمزی پی برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.58,
   "end": 392.04,
   "text": "گفت اینا قداست دارن، آدمای مقدسی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.04,
   "end": 395.38,
   "text": "لذا باید تقدس‌شون رو بشکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.38,
   "end": 400.78,
   "text": "همین کاری که الان در نظام ما رخ داد، تقدس شکنی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.78,
   "end": 403.82,
   "text": "مثلاً چادر نماد تقدس دینی ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.82,
   "end": 407.5,
   "text": "عمامه پیغمبر نماد تقدس دین ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.5,
   "end": 411.26,
   "text": "رهبر عزیزمون اصلی‌ترین نماد تقدس ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.26,
   "end": 413.9,
   "text": "اینا رو زدن، شکستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.9,
   "end": 417.96,
   "text": "متأسفانه تا حدی هم موفق بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.96,
   "end": 420.96,
   "text": "چیکار کرد؟ مجلس شراب به پا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.96,
   "end": 424.28,
   "text": "یه مجلس شراب و همه رو هم دعوت کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.28,
   "end": 428.2,
   "text": "به امام هادی هم گفت شما حالا جوان رشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.2,
   "end": 431.02,
   "text": "شما تشریف بیارید تو مجلس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.02,
   "end": 434.32,
   "text": "امر هم هست باید بیاید. والی وقت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.32,
   "end": 438.72,
   "text": "مثلاً حکومت گفته حضرت هم خب مجبوره تبعیت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.72,
   "end": 440.94,
   "text": "خب حالا ما بودیم اگه میرفتیم چیکار می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.94,
   "end": 445.24,
   "text": "می‌زدیم این خیلی می‌خواستیم مقدس مقابی راه بندازیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.24,
   "end": 448.22,
   "text": "پاتیل‌های شراب و جام‌ها رو همه رو می‌زدیم می‌شکستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.22,
   "end": 452.1,
   "text": "داد و فریاد و اینا. حسد که حضرت تشریف فرودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.1,
   "end": 457.72,
   "text": "خیلی عجیبه. شروع کردن شعرهای معرفتی خوندن بلند بلند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.72,
   "end": 462.86,
   "text": "اصلاً مجلس بزم شراب رو بدل کردن به مجلس معنویت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.86,
   "end": 464.52,
   "text": "بعد رو کردن بحث اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.52,
   "end": 467.5,
   "text": "همه اینا رو گفتم به اینجا برسیم. رو کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.5,
   "end": 469.94,
   "text": "متوکل ملعون و شماتتش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.94,
   "end": 473.5,
   "text": "اینجا میگم شماتت امام می‌تونه بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.5,
   "end": 477.62,
   "text": "یا کسی رو که امام شماتت کرده ما هم می‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.62,
   "end": 480.24,
   "text": "شروع کرد شماتت کردن حضرت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.24,
   "end": 484.68,
   "text": "ابهت و اون هیمنه توخالی‌شو شکست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.68,
   "end": 486.86,
   "text": "و حتی جریان موت رو که بحث ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.86,
   "end": 493.7,
   "text": "کتاب الموت مرحوم مجلسیه خیلی شیرین حضرت بیان کرد طوری که بعضی از روایات می‌گن متوکل به گریه افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.7,
   "end": 496.74,
   "text": "گفت تو چطور غافلی از اینکه روزی خواهی مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.74,
   "end": 504.54,
   "text": "بعد یک یک این پله پله‌های مرگ رو بردش تا وقتی که تو قبر می‌خوابوننش و کرم به بدنش میفته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.54,
   "end": 508.24,
   "text": "چشمش و دماغش و گوشش کرم میاد بیرون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.24,
   "end": 513.22,
   "text": "اصلاً مجلس ریخت به هم. ببین این شماتت امام هادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.22,
   "end": 516.26,
   "text": "می‌دونه چه کنه. حضرت آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.26,
   "end": 519.06,
   "text": "امامه. تشخیص می‌ده موقعیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.06,
   "end": 522.28,
   "text": "پس ما می‌تونیم. ولی خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.28,
   "end": 526.32,
   "text": "متأسفانه ماها اهلش نیستیم که تشخیص بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.32,
   "end": 533.3,
   "text": "باید پشت سر امام معصوم و اولیاء خدا حرکت کنیم تا تشخیص بدیم چی رو باید شماتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.3,
   "end": 539.98,
   "text": "ما الان متأسفانه بچه خیلی خوب باصفا یه مشکلی براش پیش اومده مثلاً خانمش مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.98,
   "end": 543.44,
   "text": "نمی‌دونم مریضی‌های جسمی پیدا کرده، مریضی‌های اقتصادی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.44,
   "end": 547.06,
   "text": "مثلاً تق و لق میاد سر کار یا مشکلات دیگه‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.06,
   "end": 554.06,
   "text": "اینا. اصلاً نمی‌ریم پیگیری کنیم بشینیم دعوتش کنیم تو اتاقمون به عنوان مثلاً کارفرماش، مدیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.06,
   "end": 557.5,
   "text": "دردشو بچشیم. بفهمیم چیه آقا مشکل تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.5,
   "end": 560.9,
   "text": "اگه از ما مسئله‌ای داری. همون در جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.9,
   "end": 563.68,
   "text": "معرفی می‌کنیم مثلاً به اداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.68,
   "end": 566.92,
   "text": "اینا چوب خوردن داره. اینا بیایم شماتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.92,
   "end": 569.02,
   "text": "آدم‌هاست. شماتت به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.02,
   "end": 575.72,
   "text": "شاخ و دم که نداره که. بدون تحقیق، بدون هیچ بررسی، بدون اینکه با طرف آقا طرف رو می‌خوان بالای دار بکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.72,
   "end": 579.4,
   "text": "میگن آقا حرف آخرت چیه؟ بعد حکم رو اجرا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.4,
   "end": 581.6,
   "text": "همین‌طوری ما قصاص می‌کنیم قبل از جنایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.6,
   "end": 588.16,
   "text": "بماند. یکی از بدترین شماتت‌ها شماتت به امام موسی بن جعفر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.16,
   "end": 593.52,
   "text": "که اصلاً می‌دونید یکی از بارهای سنگین دوش ایشون بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.52,
   "end": 597.48,
   "text": "که اون واقفیه که متوقف شدن، اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.48,
   "end": 600.74,
   "text": "دیگه امام رضا رو قبول نکردن به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.74,
   "end": 606.1,
   "text": "امام، تمام وجوبات شرعی که پیششون بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.1,
   "end": 607.96,
   "text": "دیگه ندادن به امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.96,
   "end": 610.42,
   "text": "العیز بالله گفتن اینا دروغه، این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.42,
   "end": 614.08,
   "text": "امامت ادامه نداره و شماتت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.08,
   "end": 618.96,
   "text": "یکی از شماتت‌های بد مثلاً برای که قرآن میگه اینم بگم و بسه امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.96,
   "end": 623.12,
   "text": "برای حضرت ایوب. می‌خوام به شما بگم تلخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.12,
   "end": 627.9,
   "text": "شماتت رو در کام آل الله اینو حواسمون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.9,
   "end": 632.94,
   "text": "تا جایی که حضرت وقتی دید یکی از دوستان مریدانش داره میاد پیشش راهش نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 632.94,
   "end": 636.5,
   "text": "طرف گفت به امام صادق آقا چرا من مرید شمام، شیعه شمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.5,
   "end": 638.78,
   "text": "گفت تو راه که میومدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.78,
   "end": 643.86,
   "text": "یکی از دوستان ما داشتی و میومدی می‌تونستی سوارش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.86,
   "end": 645.8,
   "text": "متکبرانه از کنارش رد شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.8,
   "end": 648.88,
   "text": "این شماتت دوست ماست. ما رو خوار کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 648.88,
   "end": 654.06,
   "text": "چرا سوارش نکردی اومدی؟ ببینید اصلاً حساب کتاب دین یه چیز عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 654.06,
   "end": 658.58,
   "text": "ما برای خودمون دین ساختیم. بعد امام زمان تشریف بیارن میگیم دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.58,
   "end": 665.74,
   "text": "جدید آورده. حساب کتاب‌های ما کاملاً متأسفانه از دین خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 665.74,
   "end": 670.14,
   "text": "حضرت ایوب شنیدید دیگه اینو می‌خواستم بگم روایت قرآنی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.14,
   "end": 672.52,
   "text": "حضرت ایوب هفت سال گرفتار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.52,
   "end": 679.62,
   "text": "هفت سال. الان مثلاً فکر کنید رهبر ما اصلا امام عصر رو نگیم رهبر ما یهو هفت سال بیفته تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.62,
   "end": 684.6,
   "text": "بستر، بچه‌هاش از دنیا برن، مالش رو از دست بده، مریض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 684.6,
   "end": 687.58,
   "text": "من و شما متزلزل نمی‌شیم خداوکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 687.58,
   "end": 691.34,
   "text": "یه تب می‌کنه آقا خیلی‌ها چپ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 691.34,
   "end": 695.2,
   "text": "بعد هفت سال مریضی شدید دیگه تو روایات اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.2,
   "end": 698.04,
   "text": "همه از حضرت ایوب بریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.04,
   "end": 700.6,
   "text": "باز حضرت به کامش تلخ نیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 700.6,
   "end": 703.78,
   "text": "یه جایی رو دور از مردم گز-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.78,
   "end": 707.64,
   "text": "انتخاب کرد رفت برای عبادت. سه نفر پای حضرت روایت میگه موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.64,
   "end": 713.18,
   "text": "همه مرتد شدن. این سه نفر یکیشون اتفاقاً جوون بود، دو تا پیر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 713.18,
   "end": 716.94,
   "text": "اینام تو اون کوه‌های اطفا- اطراف حضرت ایوب عبادت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.94,
   "end": 721.78,
   "text": "می‌رفتن به حضرت سرکش می‌کردن. یه روز سه تایی رفتن دیدن حضرت ایوب دیدن خیلی حالش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 721.78,
   "end": 724.24,
   "text": "اون دو تا که سنشون بالا بود شماتت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 724.24,
   "end": 730.0,
   "text": "گفتن یا-- یا ح-- یا ایوب ببین چه کردی که خدا اینطوری زدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 730.0,
   "end": 735.66,
   "text": "استغفرالله. ببین چه گناهی، چه کا- چیکار کردی که خدا اینطوری معذبت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 735.66,
   "end": 738.72,
   "text": "اون جوونه که حالش بد گفت خجالت بکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 738.72,
   "end": 741.36,
   "text": "تازه این سه تا پای حضرت مونده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 741.36,
   "end": 743.86,
   "text": "این جوونه گفت خجالت بکشید. این نبی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 743.86,
   "end": 746.6,
   "text": "این چه طرز صحبت کردنه با پیغمبر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 746.6,
   "end": 751.9,
   "text": "اونجا بود که حضرت ایوب از تلخی شماتت دوستانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 751.9,
   "end": 754.7,
   "text": "آه کشید و اون آیه معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 754.7,
   "end": 757.06,
   "text": "که \"از نادا ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.06,
   "end": 760.84,
   "text": "انی مسنی البر و انت ارحم الراحمین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 760.84,
   "end": 762.82,
   "text": "تا این ذکرو گفت بلا دفع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.82,
   "end": 766.22,
   "text": "فرزندانش زنده شدن. مال و منالش برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.22,
   "end": 769.26,
   "text": "حضرت عافیت پیدا کرد. عزت پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 769.26,
   "end": 771.68,
   "text": "یه لب تر کرد. اینا اسم اعظم‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 771.68,
   "end": 774.96,
   "text": "چقدرم با ادب. گفته ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 774.96,
   "end": 777.02,
   "text": "که می‌تونید اینطوری بگید تو دعاهاتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 777.02,
   "end": 778.8,
   "text": "من خودم این دعا رو زیاد می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 778.8,
   "end": 782.32,
   "text": "ربه انی چون خیلی شماتت تو عمرم شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 782.32,
   "end": 785.1,
   "text": "\"ربه انی مسنی بر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 785.1,
   "end": 788.48,
   "text": "خدایا قطعاً من گرفتار پریشونی شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 788.48,
   "end": 790.7,
   "text": "\"و انت ارحم الراحمین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.7,
   "end": 793.26,
   "text": "نگفت برطرفش کن. ادب رعایت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 793.26,
   "end": 795.9,
   "text": "نگفت اصلاً پریشونی من چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.9,
   "end": 799.26,
   "text": "ریش و قیچی رو داد دست خدا. مثل حضرت موسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 799.26,
   "end": 801.54,
   "text": "تشنه‌ش بود، گرسنه‌ش بود، خسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 801.54,
   "end": 804.66,
   "text": "اصلاً هیچی نگفت. من آب می‌خوام، غذا می‌خوام، پناه می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 804.66,
   "end": 808.36,
   "text": "\"عرض کرد رب انی لما انزلت الي من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 808.36,
   "end": 811.2,
   "text": "خیر فقیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.2,
   "end": 813.62,
   "text": "من به خیر تو فقیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 813.62,
   "end": 816.9,
   "text": "ادب رو ببینید. ادب، ادب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 816.9,
   "end": 820.42,
   "text": "بحث اینجا بود که اونا شماتت کردن حضرت دلش شکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.42,
   "end": 824.1,
   "text": "حالا حواسمون جمع باشه ما که دستمون به امام عصر نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.1,
   "end": 827.88,
   "text": "دوستان حضرت رو اگه شماتت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 827.88,
   "end": 830.32,
   "text": "اوه اوه خدا زدنش. خدا فلانش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 830.32,
   "end": 832.8,
   "text": "چنان می‌زنه ما رو روزگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 832.8,
   "end": 839.58,
   "text": "حواسمون باشه. ان شا الله عقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 839.58,
   "end": 842.9,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}