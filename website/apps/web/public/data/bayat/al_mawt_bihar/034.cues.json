  {
   "index": 6,
   "title": "## سیالیت کوه و آسمان",
   "start": 444.12,
   "end": 704.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.94,
   "end": 5.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.86,
   "end": 9.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.68,
   "end": 15.08,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.08,
   "end": 18.22,
   "text": "یه جمله و فرمایش بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.22,
   "end": 23.68,
   "text": "عرشی حضرت استاد علامه حسن زاده الله الرحمن دارن تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.68,
   "end": 26.2,
   "text": "خیلی نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.2,
   "end": 30.3,
   "text": "جدیدی رو به انسان میده این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.3,
   "end": 36.2,
   "text": "می‌فرمودن که یعنی من اولین بار که این صحبت رو از حضرت استاد شنیدم واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.2,
   "end": 41.9,
   "text": "انگار که شیرین‌ترین عسل عالم رو به کامم گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.9,
   "end": 49.52,
   "text": "فرمودن ما اوایل گمان می‌کردیم که فقط حروف مقطعه قرآن رموزن، رمزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.52,
   "end": 52.46,
   "text": "به صورت رمزی آمدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.46,
   "end": 55.68,
   "text": "ح، م مثلاً ع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.68,
   "end": 58.26,
   "text": "س، ق، ا، ل، ر، ک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.26,
   "end": 65.66,
   "text": "ح، ی، ع، ص. اینا به صورت رمزی‌ان بین پیغمبر و خدای منّان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.66,
   "end": 69.16,
   "text": "بعداً رفته رفته متوجه شدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.16,
   "end": 74.2,
   "text": "آیات قرآن هم خود آیات چینشش، بافتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.2,
   "end": 77.34,
   "text": "ازدواج حروف با هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.34,
   "end": 82.64,
   "text": "تشکیل کلمات، ازدواج کلمات با هم، تشکیل جملات و آیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.64,
   "end": 86.26,
   "text": "صدر و ذیل آیات، شروح و خاتمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.26,
   "end": 90.34,
   "text": "سور. اینا همه دیدیم اینا هم رمزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.34,
   "end": 92.64,
   "text": "این‌ها هم به صورت رمزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.64,
   "end": 98.42,
   "text": "اینجوری نیست که فقط اون کلمات ظاهراً حروف مقطعه رمزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.42,
   "end": 104.64,
   "text": "یعنی آیات قرآن همه حروف مقطعه‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.64,
   "end": 107.26,
   "text": "ما گمان می‌کنیم همین‌ین که ما می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.26,
   "end": 110.46,
   "text": "بعد دو مرتبه دقت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.46,
   "end": 113.76,
   "text": "دیدیم که اصلاً تمام کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.76,
   "end": 119.54,
   "text": "نظام وجود، همه‌ی این آیات، همه‌ی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.54,
   "end": 122.08,
   "text": "ظهور حق در تک تک موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.08,
   "end": 125.1,
   "text": "اینام همه حروف مقطعه‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.1,
   "end": 129.24,
   "text": "کدوم یکی از ما به کنع وجود خودمون پی بردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.24,
   "end": 132.06,
   "text": "که چی هستیم؟ کی هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.06,
   "end": 135.66,
   "text": "خودمون اصلاً بیرون از خودمون خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.66,
   "end": 138.82,
   "text": "چی هستیم؟ کی هستیم؟ باطنمون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.82,
   "end": 142.08,
   "text": "اون کمون ذاتمون چی داره میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.08,
   "end": 145.66,
   "text": "می‌بینیم ما هم یک حرف مقطعه‌ایم از سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.66,
   "end": 150.32,
   "text": "می‌بینیم هر طرف نگاه می‌کنی آسمان، زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.32,
   "end": 152.38,
   "text": "اصلاً ما یک جزئی از کل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.38,
   "end": 155.06,
   "text": "چگونه می‌تونیم احاطه پیدا کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.06,
   "end": 160.14,
   "text": "وقتی اهل بیت علیهم الصلاة والسلام فرمیدند وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.14,
   "end": 163.36,
   "text": "انسان به چیزی علم پیدا می‌کنه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.36,
   "end": 166.12,
   "text": "احاطه‌ای به او پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.12,
   "end": 171.36,
   "text": "محیط بر اون می‌شه. در حالی که قرآن فرمود \"و لا یحیطون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.36,
   "end": 175.34,
   "text": "علما\". بهی علما. اصلاً نمی‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.34,
   "end": 179.58,
   "text": "مطلقاً نمی‌تونید احاطه علمی پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.58,
   "end": 183.32,
   "text": "به او. نظامش هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.32,
   "end": 187.7,
   "text": "این یک تحیری، یک حیمانی در انسان ایجاد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.7,
   "end": 190.58,
   "text": "که دیگه فقط می‌تونی بگی-- یعنی زبان لال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.58,
   "end": 194.6,
   "text": "فقط می‌تونی بگی کلت کلت الألسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.6,
   "end": 198.66,
   "text": "این زبان چیه؟ کل لاله قاصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.66,
   "end": 201.34,
   "text": "عن غایت صفت. اصلاً نمی‌شه حرف زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.34,
   "end": 206.14,
   "text": "یه حیمانیه. شبیه به ملائکه مهیمین می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.14,
   "end": 208.16,
   "text": "اون عالیین یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.16,
   "end": 211.5,
   "text": "عالین یا علیین. اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.5,
   "end": 215.5,
   "text": "در حیمانن. هیچ خبری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.5,
   "end": 218.48,
   "text": "هیچ چیزی جز خدا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.48,
   "end": 220.1,
   "text": "خداست و داره خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.1,
   "end": 225.24,
   "text": "جز خدا نمی‌بینن. وقتی اینطوری نگاه کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.24,
   "end": 227.46,
   "text": "یکپارچه حیمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.46,
   "end": 230.5,
   "text": "اصلاً دیگه تکبر کجا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.5,
   "end": 236.7,
   "text": "که بیان بهت بگن مجبور بشن تمثیل بیارن بگن آقا کسی که متکبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.7,
   "end": 241.36,
   "text": "اولاً خدا موت رو گذاشته که از تکبر بکشینش به زیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.36,
   "end": 245.88,
   "text": "مریضی رو، فقر رو گذاشته طبق روایت پنجم از باب اول کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.88,
   "end": 248.72,
   "text": "یا بیان دو مرتبه تمثیل کنن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.72,
   "end": 252.32,
   "text": "کسی که این دنیا تکبر داره مثل مورچه محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.32,
   "end": 255.76,
   "text": "حق. این حرف حقه. حقه این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.76,
   "end": 262.32,
   "text": "اما و کسی اینطوری نگاه کرد به قضیه اصلاً تکبر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.32,
   "end": 267.56,
   "text": "اصلاً دیگه انانیتی وجود نداره ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.56,
   "end": 269.7,
   "text": "یکپارچه هرچی می‌بینه حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.7,
   "end": 273.52,
   "text": "اصلاً موت رو هم فقط موتی نمی‌بینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.52,
   "end": 278.56,
   "text": "اون \"إنّا الیه راجعون\" مثلاً اون موت اجباریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.56,
   "end": 283.76,
   "text": "که بالاخره قراره به اون شکل نفس ناطقه اعلام انصراف از بدن بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.76,
   "end": 290.1,
   "text": "بدن رو، این بدن جسم دنیایی رو رها کنه بره در قالب بدن برزخی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.1,
   "end": 293.42,
   "text": "که در طول این بدنه راهش رو ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.42,
   "end": 296.68,
   "text": "نه اصلاً حیات و موت رو آنفآن می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.68,
   "end": 299.16,
   "text": "\"کل يوم هو فيه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.16,
   "end": 305.22,
   "text": "اون رساله شعنیه شیخ اکبر عجب رساله ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.22,
   "end": 308.18,
   "text": "رساله شعنی. ذیل همین آیه فقط یه رساله داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.18,
   "end": 311.16,
   "text": "\"کل يوم هو فيه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.16,
   "end": 315.16,
   "text": "آن به آن خدا در شان جدیدی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.16,
   "end": 318.1,
   "text": "یعنی در ظهور جدیدی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.1,
   "end": 322.02,
   "text": "که اون عارف فرمود دقت بفرمایید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.02,
   "end": 325.08,
   "text": "ظهور، ببخشید ظهور تو به من است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.08,
   "end": 327.7,
   "text": "یعنی تو ظهورت با چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.7,
   "end": 331.0,
   "text": "به منه. من ظهور تو هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.0,
   "end": 333.78,
   "text": "به خدا میگه ظهور تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.78,
   "end": 337.36,
   "text": "به من از تو، وجود من از تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.36,
   "end": 340.88,
   "text": "اگر تو نبودی منم نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.88,
   "end": 344.26,
   "text": "اما بالاخره باید ظهور می‌کردی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.26,
   "end": 346.88,
   "text": "اسم ظاهر تو که نباید معطل می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.88,
   "end": 353.48,
   "text": "خب ظهور تو شده من. حالا این که من ز-- تو ظهور کردی شدی من همین تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.48,
   "end": 357.96,
   "text": "آنفآن تو در حال تجلی هستی، در حال ظهور هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.96,
   "end": 360.58,
   "text": "در حال اماته و احیایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.58,
   "end": 363.26,
   "text": "آنفآن حضرت اسرافیل داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.26,
   "end": 366.2,
   "text": "می‌دمه \" و نفخ فيه من روحه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.2,
   "end": 369.12,
   "text": "دم می‌زنه که احیا صورت بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.12,
   "end": 374.78,
   "text": "آن فعآن حضرت عزرائیل داره قبض میکنه که اماته صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.78,
   "end": 377.9,
   "text": "یعنی چی؟ یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.9,
   "end": 381.08,
   "text": "الان که من هستم خدا تجلی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.08,
   "end": 383.62,
   "text": "حضرت اسرافیل میدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.62,
   "end": 387.0,
   "text": "وقتی که نبودم وجود پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.0,
   "end": 389.52,
   "text": "دمید ظهور کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.52,
   "end": 392.44,
   "text": "حالا این آن فعآن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.44,
   "end": 396.42,
   "text": "یعنی ه-- این یک لحظه که دمید و من الان هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.42,
   "end": 399.74,
   "text": "خدای منان تجلی جدید میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.74,
   "end": 402.78,
   "text": "یک آن مساوی با اون قبلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.78,
   "end": 407.36,
   "text": "تجلی جدید میکنه. اینجا اماته رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.36,
   "end": 409.2,
   "text": "حیات الان من میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.2,
   "end": 412.92,
   "text": "حضرت قابض الارواح قبض میکنه آن فعانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.92,
   "end": 416.68,
   "text": "نه فقط در من و تو، در تمام موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.68,
   "end": 419.42,
   "text": "و دو مرتبه نیاز به احیای جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.42,
   "end": 421.78,
   "text": "دو مرتبه حضرت اسرافیل دم میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.78,
   "end": 424.68,
   "text": "دائم من و شما در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.68,
   "end": 427.84,
   "text": "چی؟ حیات و مماتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 427.84,
   "end": 432.32,
   "text": "یعنی موت دائم داره در ما اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.32,
   "end": 439.58,
   "text": "همونطور که حیات دائم داره. وقتی اینطوری نگاه میکنی قربونت برم یک سنگ رو هم شما در حرکت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 439.58,
   "end": 441.78,
   "text": "هیچ چیزی ثابت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.78,
   "end": 447.28,
   "text": "همه چی سیاله. زمین و آسمان، این سنگی که تو میگ-- آقا این کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.28,
   "end": 449.2,
   "text": "تا اونجا که من یادم همین شکلی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.2,
   "end": 452.16,
   "text": "تو اینطوری میبینی، تو ثابتش میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.16,
   "end": 455.12,
   "text": "حرکت جوهری که در فلسفه ثابت شده یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.12,
   "end": 457.48,
   "text": "من به هم-- به یک زبان همه فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.48,
   "end": 460.34,
   "text": "و عرض کردم. چیز عجیبی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.34,
   "end": 466.32,
   "text": "چرا میترسیم از این مباحث علمی که در کنه آیات و روایات ما اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.32,
   "end": 472.86,
   "text": "مثال قشنگی که میزنن میگن آقا شما توی رودخونه وایسادی عکس تو روی این رود داری میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.86,
   "end": 474.82,
   "text": "عکست ثابته، درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 474.82,
   "end": 477.32,
   "text": "عکست رو روی این رودخونه ثابت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.32,
   "end": 480.06,
   "text": "اما آقا به واقع ثابته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.06,
   "end": 482.38,
   "text": "آن فعآن این آب داره میره، آب جدید میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 482.38,
   "end": 487.26,
   "text": "دقیقاً عین همینه. تجلی که خدا در من و شما و در تمام کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 487.26,
   "end": 492.34,
   "text": "داره انجام میده. موت و حیات پشت سر هم دارن اتفاق میفتن، تکرار میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.34,
   "end": 495.98,
   "text": "یا مثل این لامپی که الان روشنه، این چراغه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.98,
   "end": 499.56,
   "text": "به ظاهر این لامپ رو نورش رو شما ثابت میبینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.56,
   "end": 501.98,
   "text": "اما از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 501.98,
   "end": 505.94,
   "text": "علمی میبینی آن فعآن این الکترون‌ها در حال چین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 505.94,
   "end": 508.38,
   "text": "تغییر و تبدلن، حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 508.38,
   "end": 512.2,
   "text": "شما نور رو ثابت میبینی اما دائماً در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 512.2,
   "end": 515.66,
   "text": "اصلاً چیزی ما ثابت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 515.66,
   "end": 521.5,
   "text": "همه چی در حال حرکته. همه چی در حال احیا و اماته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.5,
   "end": 524.5,
   "text": "شما وقتی اینطوری نگاه کنی هیچوقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.5,
   "end": 526.96,
   "text": "هیچوقت نمیای موت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.96,
   "end": 531.62,
   "text": "منحصر کنی در اون موتی که انتهای این دنیا رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.62,
   "end": 533.92,
   "text": "بگی همون یه موته تمام شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 533.92,
   "end": 537.58,
   "text": "یا فوقش دو تا امت نا افنتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 537.58,
   "end": 540.88,
   "text": "یه دونه هم بعد از انتهای برزخ رخ میده که بریم بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 540.88,
   "end": 544.16,
   "text": "قیامت. نه اونا شاخصشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.16,
   "end": 547.08,
   "text": "و الا دائماً اماته و احیا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.08,
   "end": 551.96,
   "text": "وقتی ما اینطوری نگاه کنیم به قصه، ببین نگاه ما به موت چقدر تغییر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 551.96,
   "end": 556.16,
   "text": "نگاه ما به قدرت حضرت حق، به احیاگریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 556.16,
   "end": 560.86,
   "text": "یادش بخیر در دانشکده فیزیک دانشگاه تهران یه روز درس میدادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 560.86,
   "end": 565.28,
   "text": "حالا من رو تخته دانشگاه آیات و اینا رو مینوشته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 565.28,
   "end": 567.62,
   "text": "یه دختری بلند شد وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 567.62,
   "end": 572.52,
   "text": "درس ما. الان شما ظاهرشو میدیدی به قول ما میگفتیم این شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 572.52,
   "end": 575.1,
   "text": "یه همچین چهره‌ای بلند شد به چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 575.1,
   "end": 580.4,
   "text": "داد زد گفت \"استاد چی میگی شما آیه قرآن مینویسی، پیغمبر من نیوتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.4,
   "end": 584.92,
   "text": "من اصلاً پیغمبر شما رو قبول ندارم.\" حالا شما میخوای چی بهش بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 584.92,
   "end": 587.54,
   "text": "ما دعوا با کسی نداریم که. گفتم عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 587.54,
   "end": 591.24,
   "text": "خب بفرما ببینم چرا شما پیغمبرتو نیوتن قرار دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.24,
   "end": 594.26,
   "text": "گفت یه کتاب خوندم. گفتم اون کتابو بیار با هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 594.26,
   "end": 596.58,
   "text": "بده منم بخونمش ببینم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 596.58,
   "end": 600.4,
   "text": "اگر واقعاً پیغمبر تو پیغمبر بهتر از پیغمبر منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 600.4,
   "end": 602.66,
   "text": "منم میام پیغمبرم رو پیغمبر تو قرار میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 602.66,
   "end": 605.38,
   "text": "خیلی از این ت-- حرف من تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 605.38,
   "end": 608.46,
   "text": "یه دختر دیگه ای بود اون ته دا-- کلاس میشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 608.46,
   "end": 611.7,
   "text": "حدود شصت تا دانشجوی بودن. دائم وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 611.7,
   "end": 615.66,
   "text": "درس من پک آرایششو باز میکرد، آرایش میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.66,
   "end": 618.66,
   "text": "دائم که لجمو دربیاره ولی نتونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.66,
   "end": 624.28,
   "text": "یکی هم بود با این پسرا ارتباط داشت و هی برای اینکه لجمونو دربیاره هی پسرا رو انگولک میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 624.28,
   "end": 627.86,
   "text": "خدای این نمازخونه رو شاهد میگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 627.86,
   "end": 633.9,
   "text": "خواهر و برادر، این ترم که تموم شد هر سه تای این دخترا چادری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 633.9,
   "end": 640.08,
   "text": "اومدن دم در دفتر دانشگاه اشک میریختن که میگفتن ما تازه راهمونو پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.08,
   "end": 643.86,
   "text": "چرا؟ انقدر که درون مایه دین ما قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 643.86,
   "end": 651.8,
   "text": "ما اگر محاجه میکنیم با قرآنمون، با فرمایشات اهل بیتمون چون درون مایه اینها رو هیچ کجای دیگه ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 651.8,
   "end": 655.88,
   "text": "منتها ما باید نگاهمون عمیق بشه، دقیق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 655.88,
   "end": 658.0,
   "text": "الان ما میخوایم موت رو تعریف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 658.0,
   "end": 659.6,
   "text": "میترسه بچه بدبخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.6,
   "end": 663.14,
   "text": "میگه آی چه خدای ظالمیه که میخواد منو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.14,
   "end": 666.24,
   "text": "اما تو بیا درست موت رو براش تعریف کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.24,
   "end": 669.46,
   "text": "بگو میخوای بری به درجات عالیه قبض صورت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 669.46,
   "end": 673.02,
   "text": "قابضه دیگه، قابض الارواح. مجری اسم قابض حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 673.02,
   "end": 678.02,
   "text": "تو رو از مراتب مادون همونطور که از رحم مادر اومدی به مرتبه مافوق که دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 678.02,
   "end": 680.86,
   "text": "میخواد از این مرتبه مادون ببرت به مافوق برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 680.86,
   "end": 685.06,
   "text": "همینطوری هی بهت رشد بده. ببین چقدر فرق میکنه نگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 685.06,
   "end": 689.52,
   "text": "اصلاً عاشق موت میشی. فتمنی بالموت ان کنتم صادقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 689.52,
   "end": 691.52,
   "text": "خیلی نگاه ما باید عوض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 691.52,
   "end": 694.22,
   "text": "در خصوص همه چیز، همه چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 694.22,
   "end": 696.1,
   "text": "ان شا الله که عاقبت هم ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 696.1,
   "end": 698.72,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 698.72,
   "end": 704.58,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}