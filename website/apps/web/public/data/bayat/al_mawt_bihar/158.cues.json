 "chapters": [
  {
   "index": 0,
   "title": "## تمنای مرگ؛ نهی نبوی و پرسش از جواز",
   "start": 19.44,
   "end": 119.6
  },
  {
   "index": 1,
   "title": "آیه‌ی شش سوره‌ی جمعه اتفاقاً همین موضوع را بیان می‌کند:",
   "start": 119.6,
   "end": 338.58
  },
  {
   "index": 2,
   "title": "## امیرالمؤمنین در صفین و فزتُ وربِّ الکعبة",
   "start": 338.58,
   "end": 473.93
  },
  {
   "index": 3,
   "title": "## نبی و ولی؛ زمان‌مندی نبوت و دوام ولایت",
   "start": 473.93,
   "end": 633.47
  },
  {
   "index": 4,
   "title": "## نور ولایت در میان مردم",
   "start": 633.47,
   "end": 704.55
  },
  {
   "index": 5,
   "title": "## لا خوف علیهم؛ مقابل راه‌رفتن بر شکم",
   "start": 704.55,
   "end": 812.98
  },
  {
   "index": 6,
   "title": "آیه‌ی بعد ادامه می‌دهد:",
   "start": 812.98,
   "end": 1138.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 2.62,
   "text": "سلام upon محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.62,
   "end": 9.58,
   "text": "آل محمد و على اصحاب بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.58,
   "end": 14.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.2,
   "end": 19.44,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.44,
   "end": 23.44,
   "text": "در خصوص حدیث شانزدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.44,
   "end": 26.5,
   "text": "کتاب الموت باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.5,
   "end": 31.22,
   "text": "یه نکته‌ی مغفول واقع‌مون‌مون خیلی خوبه که بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.22,
   "end": 36.16,
   "text": "هرچه تلویحاً گفتیم، تصریحاً نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.16,
   "end": 39.64,
   "text": "اینکه خب چه کسایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.64,
   "end": 43.46,
   "text": "اجازه دارن تمنای موت کنن از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.46,
   "end": 45.7,
   "text": "تو روایت این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.7,
   "end": 48.38,
   "text": "پیغمبر عزّ عالم رفتن به عیادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.38,
   "end": 51.54,
   "text": "شخصی که از خدا تمنای موت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.54,
   "end": 54.08,
   "text": "پیغمبر فرمودن این کارو نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.08,
   "end": 59.92,
   "text": "اگر تو مسیء باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.92,
   "end": 63.66,
   "text": "از خدا بخواه باقی بمونی که توبه کنی و اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.66,
   "end": 70.68,
   "text": "محسن باشی احسانت رو بر احسانت بیفزایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.68,
   "end": 74.86,
   "text": "خب بعد این سؤال پیش میاد که خب چه کسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.86,
   "end": 79.88,
   "text": "تمنای موت می‌کنند و اجازه دارن که این کارو بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.88,
   "end": 84.5,
   "text": "چون یکی از دوستانم بعد از اون جلسه پیش اینو پرسید گفتم که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.5,
   "end": 87.24,
   "text": "در اولین فرصت همین رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.24,
   "end": 90.1,
   "text": "آیه‌ی شش سوره جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.1,
   "end": 92.8,
   "text": "اتفاقاً همین موضوع رو داره بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.8,
   "end": 97.18,
   "text": "می‌فرماید قُلْ يَا أَيُّهَا الَّذِينَ آخَذُوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.18,
   "end": 100.82,
   "text": "بگو به اون کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.82,
   "end": 108.78,
   "text": "هدایت یافتن. إِنْ زَعَمْتُمْ أَنَّكُمْ أَوْلِيَاءُ لِلَّهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.78,
   "end": 112.12,
   "text": "اگر چنانچه گمان می‌کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.12,
   "end": 116.48,
   "text": "شما اولیاء خدا هستید، اولیاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.48,
   "end": 119.6,
   "text": "اگر حالا اولیاء رو باید معنا کنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.6,
   "end": 123.1,
   "text": "اگر گمان می‌کنید که از اولیاء خدا هستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.1,
   "end": 125.4,
   "text": "به یک معنا مثلاً دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.4,
   "end": 130.36,
   "text": "ویژه‌ی خدا هستید، مِنْ دُونِ النَّاسِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.36,
   "end": 134.72,
   "text": "اگر شما اینطوری هستید، نه سایر مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.72,
   "end": 141.16,
   "text": "فَتَمَنَّوُا الْمَوْتَ پس تمنای موت کنید إِنْ كُنْتُمْ صَادِقِينَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.16,
   "end": 144.86,
   "text": "اگر راست میگید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.86,
   "end": 148.4,
   "text": "یعنی بر اون ادعاتون صادق هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.4,
   "end": 150.98,
   "text": "خب این دقیقاً برعکس فرمایش پیغمبره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.98,
   "end": 154.72,
   "text": "اونجا پیغمبر می‌فرمود تمنای موت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.72,
   "end": 159.64,
   "text": "اینجا قرآن داره می‌فرماید فَتَمَنَّوُا الْمَوْتَ تمنای موت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.64,
   "end": 166.42,
   "text": "اما کیا؟ اگر ادعا می‌کنید که اولیاء الله هستید و صادرید در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.42,
   "end": 172.86,
   "text": "ادعاتون. پس از این آیه بعضی از بزرگان هم این رو استخراج کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.86,
   "end": 175.34,
   "text": "یعنی برداشتشون از این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.34,
   "end": 182.26,
   "text": "این بوده. بنده من دیدم در آثارشون که فرمودن اصلاً بر اساس همین آیه میشه فهمید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.26,
   "end": 186.18,
   "text": "فقط کسانی می‌تونن تمنای موت کنن که از اولیاء خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.18,
   "end": 193.82,
   "text": "ما جلسه پیش در خصوص شهدا صحبت کردیم که آخرین مانعی که بین اونا و خدا و لقاءشون با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.82,
   "end": 196.46,
   "text": "هست بدنه، تنه، جسمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.46,
   "end": 201.6,
   "text": "طبعشونه. لذا فلسفه شهادت اینجا خودش رو نشون میده که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.6,
   "end": 205.06,
   "text": "حاضر میشن این بدن رو هم بردارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.06,
   "end": 209.82,
   "text": "از بین خودشون و خدا این جسم رو هم-- جسمیت رو هم بردارن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.82,
   "end": 213.06,
   "text": "مرحله‌ی انتهایی لقای الله برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.06,
   "end": 221.1,
   "text": "این میشه ف-- شهادت. خب پس خود شهدا هم که از اولیاء الله‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.1,
   "end": 223.36,
   "text": "لذا شما وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.36,
   "end": 228.26,
   "text": "زندگی‌نامه‌ی اولیاء خدا رو بر-بررسی می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.26,
   "end": 239.02,
   "text": "اهم از خود اهل بیت علیهم الصلاة والسلام که دیگه مادرشون حضرت صدیقه شهیده بگیر که اللّهم عجّل في وفاتي سريعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.02,
   "end": 242.82,
   "text": "تا باباشون امیرالمؤمنین که اون چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.82,
   "end": 246.56,
   "text": "فرمود از اون عطش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.56,
   "end": 250.26,
   "text": "و شوق بچه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.26,
   "end": 256.08,
   "text": "گرسنه‌شه به سینه‌ی مادرش چطوری میچسبه می‌خواست شیر بخوره، من از اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.08,
   "end": 259.2,
   "text": "نسبت به مرگ عاشق‌ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.2,
   "end": 261.38,
   "text": "تشنه‌ترم. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.38,
   "end": 264.52,
   "text": "باباشونه. اونم که ابا عبداللهه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.52,
   "end": 269.72,
   "text": "هرچه به کوفه و کربلا نزدیک‌تر میشد روایات همه میگن که بر افروخته‌تر میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.72,
   "end": 273.26,
   "text": "از همین اولیاء خدا از اهل بیت عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.26,
   "end": 277.04,
   "text": "علیهم الصلاة والسلام بگیر تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.04,
   "end": 285.84,
   "text": "جانشینانشون چقدر از امام فریاد زدن بکشید ما را ملت ما بیدارتر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.84,
   "end": 289.06,
   "text": "ها؟ و شهدای فعلی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.06,
   "end": 291.34,
   "text": "اتفاقاً در یه روایتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.34,
   "end": 295.32,
   "text": "در تفسیر اهل بیت دیدم جالب بود برام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.32,
   "end": 297.98,
   "text": "جلد شونزده صفحه دویست و پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.98,
   "end": 302.8,
   "text": "کتاب تفسیر اهل بیت علی ابن ابراهیم قمی، اونجا روایتی رو میاره از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.8,
   "end": 307.78,
   "text": "صادق صلوات الله علیه که فرمود إن في التوراة مكتوباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.78,
   "end": 311.7,
   "text": "یعنی تو، تو تورات اصلی‌ها، اون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.7,
   "end": 316.0,
   "text": "تحریف نشده. نوشته شده بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.0,
   "end": 319.98,
   "text": "که چی؟ أولياء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.98,
   "end": 323.08,
   "text": "يتمنون الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.08,
   "end": 326.38,
   "text": "مثلاً از خصوصیات اولیاء خدا اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.38,
   "end": 328.76,
   "text": "آرزوی مرگ می‌کنند. خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.76,
   "end": 331.94,
   "text": "تو کتاب بحار جلد نه صفحه دویست و چهل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.94,
   "end": 335.2,
   "text": "سه هم می‌تونید اینو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.2,
   "end": 342.3,
   "text": "خب، یا مثلاً یه روایت دیگه‌ای هست خیلی جالب و شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.3,
   "end": 344.6,
   "text": "باز در تفسیر اهل بیت همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.6,
   "end": 347.68,
   "text": "جلد و همین صفحه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.68,
   "end": 353.34,
   "text": "این روایتو امام مجتبی صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.34,
   "end": 362.99,
   "text": "فرمود که باباشون امیرالمؤمنین در جنگ صفین بین دو صف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.99,
   "end": 366.63,
   "text": "با لباسی که لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.63,
   "end": 368.71,
   "text": "زیر زره بود. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.71,
   "end": 373.25,
   "text": "زره تن حضرت نبود با لباس زیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.25,
   "end": 376.49,
   "text": "با اون لباس دور میزد دور دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.49,
   "end": 381.09,
   "text": "با یک شجاعت و رشادت خاصی که هر آن احتمال داشت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.09,
   "end": 384.89,
   "text": "زده بشه در آن فوقان جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.89,
   "end": 387.57,
   "text": "امام حسن سبت علیه السلام عرض کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.57,
   "end": 391.57,
   "text": "این لباس جنگ نیست تن شماست بابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.57,
   "end": 397.59,
   "text": "یعنی با تعجب شما با لباس جنگ این حرکت و این رشادت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.59,
   "end": 402.51,
   "text": "این جانفشانی با، با لباس بدون جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.51,
   "end": 404.91,
   "text": "حضرت فرمودند که ای فرزندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.91,
   "end": 408.31,
   "text": "پدرت اهمیتی نمیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.31,
   "end": 414.71,
   "text": "او سراغ مرگ بره یا مرگ به سراغ او بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.71,
   "end": 418.63,
   "text": "و همیشه می فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.63,
   "end": 425.03,
   "text": "مولا می فرمود که من منتظر شقی‌ترین اونها، منظور ابن ملجم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.03,
   "end": 428.01,
   "text": "شقی‌ترین روایت، یه روایت داریم که ابن ملجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 428.01,
   "end": 432.73,
   "text": "شقی‌ترین امت بود. من منتظر شقی‌ترین اونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.73,
   "end": 436.21,
   "text": "نیستم که صورتم رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.21,
   "end": 440.09,
   "text": "خون بالای سرش رنگین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 440.09,
   "end": 444.55,
   "text": "دقت هم کردید دیگه همه گفتن به هر حال مخصوصا شواهد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.55,
   "end": 447.59,
   "text": "یه شب اون لحظه‌ای که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 447.59,
   "end": 452.93,
   "text": "سحری که حضرت ضربه خورد فزت ورب-- ورب الكبرى رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.93,
   "end": 457.23,
   "text": "قبلش نفرمود. اون لحظه فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 457.23,
   "end": 460.35,
   "text": "انقدر عاشق شهادته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.35,
   "end": 465.37,
   "text": "ملاقات با خداست که اون لحظه دیگه یقین حاصل کرد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.37,
   "end": 473.13,
   "text": "اعلام کرد فزت. اون فوز و رستگاری رو در این میدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.13,
   "end": 475.47,
   "text": "حالا پس این تا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.47,
   "end": 480.83,
   "text": "قسمت دوم بحث رو اختصاص بدیم به اینکه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.83,
   "end": 483.35,
   "text": "اه چه کسی ولی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 483.35,
   "end": 487.73,
   "text": "اولیا جمع ولیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.73,
   "end": 493.17,
   "text": "ولی الله کیه اصلاً؟ اولاً بدونیم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 493.17,
   "end": 497.61,
   "text": "اه نبی الله داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.61,
   "end": 502.49,
   "text": "و ولی الله داریم. نبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.49,
   "end": 504.45,
   "text": "طبق فرمایش حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.45,
   "end": 508.89,
   "text": "که حالا ما قبل از اینکه از استاد بشنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.89,
   "end": 514.53,
   "text": "توجه اصلاً به این نداشتیم که نبی اسم خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.53,
   "end": 518.59,
   "text": "هیچ کجا در اسماء الهی نداریم که نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.59,
   "end": 520.65,
   "text": "البته در حوزه علم باید کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.65,
   "end": 524.23,
   "text": "ما یک علم فعلی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 524.23,
   "end": 530.49,
   "text": "یک علم انفعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 530.49,
   "end": 537.91,
   "text": "خب. از یک حیث به صورت دسته‌بندی بخواهیم بکنیم به صورت کلی مرحوم دهدار هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 537.91,
   "end": 540.81,
   "text": "رساله قضا و قدرش میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.81,
   "end": 543.13,
   "text": "که علم فعلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.13,
   "end": 547.91,
   "text": "که فعالیت تام داره از جایی وارد نمیشه که به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 547.91,
   "end": 555.03,
   "text": "علم او ذاتی اوست. ما گفتیم شما همین علم رو برو بالا، برو بالا، برو بالا میگه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 555.03,
   "end": 558.51,
   "text": "علم عین ذات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 558.51,
   "end": 563.27,
   "text": "خب اون علم فعلی رو به ذات حضرت حق میزنن، به خدا میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 563.27,
   "end": 567.71,
   "text": "علم انفعالی رو به مخلوق میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 567.71,
   "end": 571.49,
   "text": "واضح شد؟ حالا اینم یه دسته‌بندیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 571.49,
   "end": 574.83,
   "text": "ولی در هر حال بحث چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 574.83,
   "end": 578.61,
   "text": "اینکه کسی که ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 578.61,
   "end": 585.43,
   "text": "خدا شد، این ولی بودن رو از کجا میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.43,
   "end": 587.93,
   "text": "از خدا میگیره. چون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 587.93,
   "end": 589.73,
   "text": "ولی الذین آمنو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 589.73,
   "end": 597.61,
   "text": "ولی اسم خداست. اسمی از خداست که یعنی یک کمالی از کمالات حضرت حقه که پیاده میشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 597.61,
   "end": 600.37,
   "text": "جانشینانش، در بنده گان صالحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 600.37,
   "end": 606.73,
   "text": "اما نبی اینطوری نیست. نبی اسم خدا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 606.73,
   "end": 610.21,
   "text": "و لذا زمان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 610.21,
   "end": 614.59,
   "text": "یعنی زمان نبوتش که تموم شد دیگه نبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 614.59,
   "end": 618.41,
   "text": "تموم شد. اما ولی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 618.41,
   "end": 623.87,
   "text": "ولی زمان بردار نیست. کسی ولی خدا بود، ولی خدا شد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 623.87,
   "end": 628.53,
   "text": "تا ابد ولی خدا خواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 628.53,
   "end": 632.57,
   "text": "این از کمالات الهیه که در او پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 632.57,
   "end": 634.87,
   "text": "حالا سلام علیکم. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.87,
   "end": 637.25,
   "text": "ولی و ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 637.25,
   "end": 640.27,
   "text": "معانی مختلفی گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 640.27,
   "end": 643.41,
   "text": "اینکه مثلاً علی ولی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 643.41,
   "end": 646.49,
   "text": "یعنی چی؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 646.49,
   "end": 650.25,
   "text": "چندین ترجمه دارن ما خیلی اونجا نمی‌خوایم حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 650.25,
   "end": 652.95,
   "text": "ولی در حسب کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 652.95,
   "end": 659.75,
   "text": "کسی ولی خدا میشه که به شدت به خاطر شدت قربش به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 659.75,
   "end": 662.95,
   "text": "و پیاده شدن اسماء الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 662.95,
   "end": 665.45,
   "text": "خصوصاً اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 665.45,
   "end": 670.79,
   "text": "که دو طرف میخواد. یا به یک معنا اسماء متضاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 670.79,
   "end": 676.59,
   "text": "اسماء جمال و جلال در او أشد على الكفار رحما بينهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 676.59,
   "end": 681.11,
   "text": "به جهت شدت وجودیش میگن اشتداد وجودی پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 681.11,
   "end": 686.95,
   "text": "در سیر الی الله به جایگاهی میرسه که ایشون میشه ولی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 686.95,
   "end": 690.89,
   "text": "یعنی چی؟ یعنی جانشین خدا میشه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 690.89,
   "end": 694.85,
   "text": "دیگران. یعنی خلافت میگیره، امامت میگیره بر دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 694.85,
   "end": 701.75,
   "text": "حتی نبی هم به میزانی که از ولایت برخوردار شده نبوت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 701.75,
   "end": 704.55,
   "text": "این بحث‌ها قبلاً بین ما گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 704.55,
   "end": 709.87,
   "text": "در آیه‌ی صد و بیست و دو سوره انعام می فرماید و جعلنا له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 709.87,
   "end": 712.49,
   "text": "نورا يمشي به في الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 712.49,
   "end": 715.57,
   "text": "ولی خدا کسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 715.57,
   "end": 720.37,
   "text": "خدا می فرماد ما براش یه نوری رو قرار میدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 720.37,
   "end": 724.43,
   "text": "يمشي به. راه میره به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 724.43,
   "end": 727.75,
   "text": "یعنی به اون نور. في الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 727.75,
   "end": 735.14,
   "text": "در مردم مثل اون آیه «من لم يجعل الله له نورا فما له من نور».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 735.14,
   "end": 739.44,
   "text": "قبلا گفتیم ذیلش روایت آوردیم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 739.44,
   "end": 747.54,
   "text": "نورا چیه؟ کسی که خدا نورارو براش قرار نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 747.54,
   "end": 749.82,
   "text": "فما له من نور هیچ نوری براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 749.82,
   "end": 752.58,
   "text": "اون نور رو فرمود امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 752.58,
   "end": 756.42,
   "text": "من ولد فاطمه صلوات الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 756.42,
   "end": 762.6,
   "text": "نورا من ولد فاطمه رحمه الله الصدیکه الشهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 762.6,
   "end": 764.84,
   "text": "این نور هم نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 764.84,
   "end": 768.16,
   "text": "ولایت کلیه الهی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 768.16,
   "end": 770.7,
   "text": "خدا به میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 770.7,
   "end": 779.66,
   "text": "مقام کسی که ولی شده، ولی الله شده، به میزان بهره گیریش و بهره برداریش از اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 779.66,
   "end": 782.68,
   "text": "الهی یا اون اسم جامع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 782.68,
   "end": 785.74,
   "text": "به همون میزان بهش ولایت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 785.74,
   "end": 789.74,
   "text": "در حقیقت به همون میزان از اسماء برخورداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 789.74,
   "end": 793.06,
   "text": "و در حقیقت به همون میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 793.06,
   "end": 797.08,
   "text": "قرب داره به ولی الله الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 797.08,
   "end": 802.24,
   "text": "ولی الله الاعظم الان در زمان ما یک نفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 802.24,
   "end": 805.92,
   "text": "امام عصر که با بدن انصوری‌ش بین ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 805.92,
   "end": 809.7,
   "text": "اما ولی الله چرا تعداد داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 809.7,
   "end": 812.98,
   "text": "یک نفر نیست. اولیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 812.98,
   "end": 817.2,
   "text": "اولیای خدا میگه. یه نشونه‌شون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 817.2,
   "end": 820.08,
   "text": "تمنای موعظ می‌کنن. یه نشونه‌شون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 820.08,
   "end": 827.56,
   "text": "این آیه می‌فرماید و جعلنا له نورا يمشي به في الناس با نور امام زمانشون بین مردم حرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 827.56,
   "end": 830.42,
   "text": "یعنی شما اینا رو نگاه می‌کنی یاد امام زمانت میفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 830.42,
   "end": 832.08,
   "text": "نور حضرت رو در این‌ها می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 832.08,
   "end": 838.08,
   "text": "یاد حضرت می‌کنی. دیگه چه خصوصیت‌هایی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 838.08,
   "end": 841.52,
   "text": "وقتو گرفتیم؟ در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 841.52,
   "end": 846.5,
   "text": "شصت و دو، شصت و سه سوره یونس می‌فرماید ألا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 846.5,
   "end": 849.86,
   "text": "چهار دقیقه. چهارده دقیقه گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 849.86,
   "end": 855.76,
   "text": "خب پس وقتمون تموم شد. می‌فرماید ألا إن أولياء الله لا خوفٌ عليهم ولا هم يحزنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 855.76,
   "end": 861.2,
   "text": "یکی از خصوصیت‌های مهمه که چند بار در قرآن هم تکرار شده اولیای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 861.2,
   "end": 866.22,
   "text": "اینه که بر اون‌ها نه خوفی هست نه حزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 866.22,
   "end": 870.76,
   "text": "اصلاً ترس ندارن. اصلاً امام علیه الرحمه چجوری بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 870.76,
   "end": 873.1,
   "text": "قسم والله قسم خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 873.1,
   "end": 877.6,
   "text": "والله که من یک بار در عمرم نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 877.6,
   "end": 882.68,
   "text": "بعد مرحوم آقای خدا رحمت کند اصغر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 882.68,
   "end": 887.24,
   "text": "اشرافی اصفهانی از مرحوم آقای بهادینی هم این-- این نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 887.24,
   "end": 892.2,
   "text": "اما من تو زندگی نامه آقای اشرافی اصفهانی شهید محراب تو اصفهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 892.2,
   "end": 895.06,
   "text": "از ایشون شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 895.06,
   "end": 898.4,
   "text": "فرمودن این یک معجزه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 898.4,
   "end": 905.34,
   "text": "که یک آدمی لفظ جلالی الله رو قسم بخوره بگه من تو کل عمرم یک بار نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 905.34,
   "end": 907.9,
   "text": "خب یعنی ولی الله دیگه. ألا إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 907.9,
   "end": 911.34,
   "text": "أولياء الله لا خوفٌ عليهم ولا هم يحزنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 911.34,
   "end": 914.66,
   "text": "دقیقا این خاصیت رو. این خ-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 914.66,
   "end": 919.46,
   "text": "مشخصه ولی الله رو در امام میشه دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 919.46,
   "end": 924.08,
   "text": "لذا وقتی که کسی جرات نداشت با آمریکا چپ نگاه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 924.08,
   "end": 927.06,
   "text": "بگه زیر و بالا چشمت ابروه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 927.06,
   "end": 930.54,
   "text": "و زیر ابروت چشمت. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 930.54,
   "end": 938.0,
   "text": "اون موقع، اون موقع خوابت پرید حاسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 938.0,
   "end": 945.82,
   "text": "اون موقع تو حیاط جماران می‌شنوه-- می‌شینه و می‌فرماد که آمریکا هیچ غلطی نمی‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 945.82,
   "end": 951.18,
   "text": "اون موقع رو باید آدم بره بررسی کنه که کسی جرات نمی‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 951.18,
   "end": 953.46,
   "text": "حرفی از آمریکا بزنه. این یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 953.46,
   "end": 958.88,
   "text": "این خصوصیت بعد ادامه میده آیه بعدش که الذين آمنوا وكانوا يتقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 958.88,
   "end": 963.3,
   "text": "اینا کیان؟ اولیای خدا کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 963.3,
   "end": 968.08,
   "text": "از تو لپ لپ در نیومدن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 968.08,
   "end": 971.02,
   "text": "آسمون دهن باز نکرده اینا ولی الله بیفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 971.02,
   "end": 973.8,
   "text": "نخیر. الذين آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 973.8,
   "end": 977.62,
   "text": "و كانوا يتقون. اصلاح دوباره رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 977.62,
   "end": 985.44,
   "text": "اینا دنبال، یعنی آمنو دل داده بودن باور یقینی داشتن به اونچه که ما هل اللغلق زبونمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 985.44,
   "end": 988.86,
   "text": "يتقون اهل تقوا بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 988.86,
   "end": 995.22,
   "text": "اهل تقوا و ورع بودن. حالا فرصت رفت این آیه هم توجه کنیم آیه چهل و پنج نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 995.22,
   "end": 997.94,
   "text": "فمنهم من يمشي على بطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 997.94,
   "end": 1005.48,
   "text": "برعکس اونا. برعکس اون کسایی که يمشي به في الناس با اون نور الهی در بین مردم حرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1005.48,
   "end": 1012.0,
   "text": "آیه چهل و پنج سوره نور می‌فرماید فمنهم از اونای یه سری هستن که يمشي اینام راه میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1012.0,
   "end": 1016.86,
   "text": "اما به چی؟ على بطنه رو شکمشون راه میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1016.86,
   "end": 1023.38,
   "text": "یعنی چی؟ یعنی انقدر سنگین شدن اینا فقط هم و غمشون شکم و زیر شکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1023.38,
   "end": 1026.8,
   "text": "شهوت و ثروت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1026.8,
   "end": 1032.66,
   "text": "قدرت و این چیزاست. بعد اینا دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1032.66,
   "end": 1036.46,
   "text": "اصلاح هم دارن مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1036.46,
   "end": 1039.8,
   "text": "یا الان سردمدار این اصلاح طلب‌ها تو دنیا کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1039.8,
   "end": 1044.92,
   "text": "ملعون خبیث ترامپه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1044.92,
   "end": 1051.66,
   "text": "خیلی راحت ادعا می‌کنن که ما از طرف خدا اومدیم برای نجات مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1051.66,
   "end": 1058.3,
   "text": "این ادعاها رو دارن دیگه. مراسم تحلیفشم که برد تور--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1058.3,
   "end": 1064.2,
   "text": "عجیب بود توی کلیسا انجام داد از تمام ادیان حتی از شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1064.2,
   "end": 1067.0,
   "text": "یه روحانی شیعه هم رفت آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1067.0,
   "end": 1071.48,
   "text": "حالا همه در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1071.48,
   "end": 1076.74,
   "text": "تعهدشون چی میگن؟ اون قولی که میدن یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1076.74,
   "end": 1085.24,
   "text": "چیزی دارن. جان؟ قسمنامه بله اون، اون رو قرائت کردن به جز اون عالم شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1085.24,
   "end": 1092.86,
   "text": "اون قسم‌نامه رو. دل و جگر خیلی خاصی می‌خواد اونجا قسم‌نامه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1092.86,
   "end": 1097.78,
   "text": "حالا به هر حال اینکه با ادعا بخوای بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1097.78,
   "end": 1102.3,
   "text": "یزید هم میشه خلیفه مسلمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1102.3,
   "end": 1104.76,
   "text": "با اون همه کثافت کاری‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1104.76,
   "end": 1109.06,
   "text": "شکستن شعن مسجד و محراب و منبر و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1109.06,
   "end": 1111.08,
   "text": "بله وقتمون خیلی گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1111.08,
   "end": 1117.14,
   "text": "ببخشید دیگه قصد داریم بیشتر از یه ربع نشه که شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1117.14,
   "end": 1119.92,
   "text": "بحث البته موند اما بحث همین مقداری که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1119.92,
   "end": 1127.96,
   "text": "یه ترجمه تحت اللفظی ولو از ولی الله بدونیم و بدونیم چه کسانی حق تمنای موعظ دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1127.96,
   "end": 1131.24,
   "text": "اگه ما به اون مقام نرسیدیم که نرسیدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1131.24,
   "end": 1136.0,
   "text": "خاموش باشیم. هی بیخود نگیم خدایا برسان برسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1136.0,
   "end": 1138.5,
   "text": "والحمد لله رب العالمين صلوات خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}