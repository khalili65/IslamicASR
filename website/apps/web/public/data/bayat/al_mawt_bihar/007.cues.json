 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.88,
   "end": 8.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.66,
   "end": 12.42,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.42,
   "end": 16.52,
   "text": "در خصوص کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.52,
   "end": 19.74,
   "text": "مرحوم مجلسی علیه الرحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.74,
   "end": 22.48,
   "text": "دیروز نکته‌ای را عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.48,
   "end": 26.0,
   "text": "می‌خواستیم تمامش کنیم باز نیمه کاره موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.0,
   "end": 30.62,
   "text": "امروز هم که شهادت حضرت سکینه سلام الله علیهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.62,
   "end": 34.74,
   "text": "و اتفاقاً اون واقعه‌ای که رخ می‌دهد برای این حضرت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.74,
   "end": 36.96,
   "text": "کنار گودی قتلگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.96,
   "end": 41.72,
   "text": "مستحضر هستید اون شعر معروفی که ایشون وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.72,
   "end": 45.74,
   "text": "وضعیت سید الشهدا رو در گودی قتلگاه می‌بینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.74,
   "end": 49.56,
   "text": "حالا به قول ما بی‌هوش میشن و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.56,
   "end": 52.5,
   "text": "از نشئه طبیعت فارغ میشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.5,
   "end": 55.7,
   "text": "به معنای درست علمیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.7,
   "end": 62.08,
   "text": "از اسم از ظاهر حضرت حق پل می‌زنن به اسم الباطن که این همان معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.08,
   "end": 64.68,
   "text": "موت هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.68,
   "end": 67.68,
   "text": "حضرت ابا عبدالله سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.68,
   "end": 70.48,
   "text": "به ایشون القاءاتی رو می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.48,
   "end": 73.1,
   "text": "من جمله همون شعر معروفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.1,
   "end": 75.26,
   "text": "حضرت فرمودن \"شیعتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.26,
   "end": 78.82,
   "text": "مهما شربت ما عذب فذكرونی\" و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 78.82,
   "end": 81.88,
   "text": "مستحضر هستید و روضه است و حضرت خودشون روضه می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 81.88,
   "end": 85.24,
   "text": "روضه علی اصغر رو می‌خونن و این‌ها که سلام ما رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 85.24,
   "end": 90.04,
   "text": "شیعیانمون تا آخر زمان محبینمون برسون و این‌ها که هر وقت آب خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.04,
   "end": 93.66,
   "text": "یاد من کنن و این‌ها که ما تا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.66,
   "end": 97.08,
   "text": "الی الابد همه محبین ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.08,
   "end": 100.0,
   "text": "مدیون و مرهون همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 100.0,
   "end": 104.44,
   "text": "مکاشفه و ارتباط حضرت سکینه سلام الله علیها هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 104.44,
   "end": 108.86,
   "text": "به یک معنا ارتباط از ملک به ملکوت ایشون؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 108.86,
   "end": 111.68,
   "text": "یک جلوه‌شون. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.68,
   "end": 117.8,
   "text": "این همونطور که قبلاً عرض کردیم اصلاً سفر از اسم از ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.8,
   "end": 121.58,
   "text": "به اسم الباطن حضرت حق می‌شود همان معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.58,
   "end": 125.08,
   "text": "موت که در حقیقت همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.08,
   "end": 127.8,
   "text": "یک جلوه‌ش پیش از موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 127.8,
   "end": 131.7,
   "text": "اضطراری که قبلاً عرض شد موت اجباری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.7,
   "end": 134.0,
   "text": "می‌شود موت اختیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 134.0,
   "end": 136.68,
   "text": "که موت قبل ان تموتو. این حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 136.68,
   "end": 141.42,
   "text": "یک وجه و یک جلوه‌ش رو صاحب امروز داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 141.42,
   "end": 144.92,
   "text": "که عرض کردیم. به هر حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 144.92,
   "end": 148.04,
   "text": "ااا خب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 148.04,
   "end": 151.2,
   "text": "به یک معنا وقتی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 151.2,
   "end": 154.6,
   "text": "ظاهر عالم به باطن سفر می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 154.6,
   "end": 157.78,
   "text": "از ملک به ملکوت پل می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 157.78,
   "end": 161.06,
   "text": "این میشه شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 161.06,
   "end": 163.9,
   "text": "از ملکوت، اخذ از ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 163.9,
   "end": 168.12,
   "text": "تلقی از ملکوت می‌شود به یک معنا دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 168.12,
   "end": 170.54,
   "text": "ملکوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 170.54,
   "end": 174.92,
   "text": "البته عالم شدن به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 174.92,
   "end": 180.58,
   "text": "که ال-- اگر این شدت بگیره یعنی شدت موت حاصل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 180.58,
   "end": 182.18,
   "text": "میشه علیم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 182.18,
   "end": 185.3,
   "text": "دیگه اسم مشبهه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 185.3,
   "end": 188.16,
   "text": "که شدت آگاهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 188.16,
   "end": 193.0,
   "text": "که اتفاقاً جالبه که در اون آیه شریفه ای که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 193.0,
   "end": 199.28,
   "text": "صادق صلی الله علیه توصیه کردن مرحوم آشیخ عباس قمی هم در مفاتیح آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 199.28,
   "end": 204.02,
   "text": "که اگه کسی می‌خواد خدا کفایت کنه زندگیشو بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 204.02,
   "end": 209.08,
   "text": "صبح و مغرب پیش از اینکه هر حرفی رو بزنه هفت مرتبه این آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 209.08,
   "end": 212.48,
   "text": "تکرار کنه که \"فسیکفیکهم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 212.48,
   "end": 215.4,
   "text": "وهو السميع العلیم\" بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 215.4,
   "end": 222.7,
   "text": "همون معنایی که مفسرین فرمودن من جمله حضرت استاد علامه حسن زاده علیه الرحمة که اسمایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.7,
   "end": 227.84,
   "text": "در انتهای واقعه میشن با موضوع مرتبط‌اند، با موضوع آیه مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.84,
   "end": 232.38,
   "text": "اینجا خب این و هو السميع العلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 232.38,
   "end": 236.64,
   "text": "سمع، شنیدن و اخذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 236.64,
   "end": 239.48,
   "text": "و از ملکوت، شنیدن از ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.48,
   "end": 242.66,
   "text": "العلیم، آگاه شدن از ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.66,
   "end": 244.94,
   "text": "که حالا چون بعضی از دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.94,
   "end": 248.66,
   "text": "فرموده بودند که مباس بعضی سنگین میشه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.66,
   "end": 250.84,
   "text": "عقلی و این‌ها ما اذیت میشیم و این‌ها؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.84,
   "end": 254.86,
   "text": "من خیلی سربسته نکته رو عرض می‌کنم و رد میشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 254.86,
   "end": 257.66,
   "text": "که این آیه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 257.66,
   "end": 260.9,
   "text": "نشون میده که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 260.9,
   "end": 263.88,
   "text": "اون شنیدن از ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 263.88,
   "end": 267.6,
   "text": "یعنی کسی به حقیقت اسم السميع و العليم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 267.6,
   "end": 275.1,
   "text": "دسترسی پیدا کنه که هرچه کشف هست به قول حضرت استاد در این عالم زیر سر همین اسم العلیم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.1,
   "end": 283.52,
   "text": "اون موقع است که خدا زندگیش رو کفایت می‌کنه که انّ کسی که از ملک به ملکوت ارتباط پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.52,
   "end": 286.82,
   "text": "تحت تکفل و کفایت الهی قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.82,
   "end": 291.24,
   "text": "اینقدر این آیه مهمه. خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.24,
   "end": 294.06,
   "text": "چاره‌ای جز ارتباط با ملکوت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.06,
   "end": 298.26,
   "text": "و البته برای خیلی از ماها خیلی موقع‌ها رخ میده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.26,
   "end": 301.02,
   "text": "از ملکوت القایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.02,
   "end": 304.92,
   "text": "بهمون صورت بگیره. حالا یا شنیداری یا دیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 304.92,
   "end": 308.8,
   "text": "به هر حال این‌ها اما به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.8,
   "end": 311.64,
   "text": "مدعیان دروغین که هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.64,
   "end": 316.18,
   "text": "خب معمولاً شما جرات نمی‌کنید بگید به دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.18,
   "end": 321.14,
   "text": "وقتی پیش میاد. و الا خب اگر انسان یه مقدار مراقبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.14,
   "end": 323.78,
   "text": "کنه این‌ها اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.78,
   "end": 327.4,
   "text": "به هر حال بحث ما چیه؟ بحث ما اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.4,
   "end": 331.86,
   "text": "ااا هر چقدر که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.86,
   "end": 338.54,
   "text": "آگاهیمون بیشتر میشه از ملکوت این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.54,
   "end": 342.44,
   "text": "به در حقیقت معنای موت بیشتر نزدیک میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.44,
   "end": 346.6,
   "text": "دیروز ما عرض کردیم که بر اساس اون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.6,
   "end": 349.18,
   "text": "صد و پنجاه و پنج سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.18,
   "end": 353.6,
   "text": "عرض کردیم که حالا قبل از اینکه آیه رو بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.6,
   "end": 359.92,
   "text": "یه مقدمه عرض کنم که این آیه رو وقتی مرحوم شیخ صدوق در کتاب شریف کما- تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.92,
   "end": 363.42,
   "text": "کمال الدین و تمام نعمت خودشون میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.42,
   "end": 366.54,
   "text": "اونجا ذیل این آیه شریف حدیثی رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.54,
   "end": 370.1,
   "text": "امام صادق صلوات الله علیه میارن و امام باقر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.1,
   "end": 374.72,
   "text": "حضرت می فرماین این آیه مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.72,
   "end": 376.78,
   "text": "آخرالزمانی‌ها از محبین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 376.78,
   "end": 379.42,
   "text": "ماست؛ یعنی شماها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 379.42,
   "end": 382.14,
   "text": "\"ولنبلونکم\" قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.14,
   "end": 387.2,
   "text": "ما شما رو مبتلا می‌کنیم به امتحانات و بلاها اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.2,
   "end": 391.1,
   "text": "از چه جنسی؟ \"ولنبلونکم بشیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.1,
   "end": 394.48,
   "text": "من الخوف والجوع ونقص من الأموال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 394.48,
   "end": 397.5,
   "text": "والأنفس والثمرات وبشر الصابرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.5,
   "end": 400.92,
   "text": "خب این سختی‌ها هم که دیروز عرض کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 400.92,
   "end": 403.98,
   "text": "می‌خواستیم بحث تموم شه اما نیمه کاره مونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.98,
   "end": 406.8,
   "text": "این سختی‌ها برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.8,
   "end": 411.7,
   "text": "برای اینکه ما تطهیر بشیم چون موت از مطهراته و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.7,
   "end": 415.02,
   "text": "به وساطت و وسیله صبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.02,
   "end": 416.74,
   "text": "چون می‌فرماید \"وبشر الصابرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 416.74,
   "end": 420.1,
   "text": "یعنی یه جمع‌بندی تا همینجا داشته باشیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.1,
   "end": 422.92,
   "text": "یعنی اینکه ما به ملکوت عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.92,
   "end": 426.62,
   "text": "دسترسی پیدا نمی‌کنیم مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.62,
   "end": 431.88,
   "text": "بر صبر بر مشکلات و مصائب و گرفتاری‌ها، مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.88,
   "end": 437.88,
   "text": "صبر حتی بر موت. مگر به وسیله صبر، صبر بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 437.88,
   "end": 442.1,
   "text": "گرفتاری‌ها و سختی‌ها که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 442.1,
   "end": 446.52,
   "text": "دیگه خود بحث صبر یه مقوله‌ای، باب مستقل خودش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 446.52,
   "end": 449.02,
   "text": "حالا در آیات قرآن زیاد پرداخته شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 449.02,
   "end": 451.4,
   "text": "\"والله يحب الصابرين\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.4,
   "end": 453.08,
   "text": "مقام حب الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.08,
   "end": 455.66,
   "text": "\"إن الله مع الصابرين\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 455.66,
   "end": 458.42,
   "text": "معیت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.42,
   "end": 461.84,
   "text": "\"يجزي عن الغرفة بما صبروا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.84,
   "end": 464.9,
   "text": "تو بهشت غرفه‌های بهشتیو به کسایی که صبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 464.9,
   "end": 471.0,
   "text": "صبر دارن میدن که حالا البته وقتی صبر شدت گرفت میشه صبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 471.0,
   "end": 480.36,
   "text": "بر وزن فعول. \"إنما يوفى الصابرون أجرهم بغير حساب\"، اجر بی‌حسابه \"وبشر الصابرين\" در همین آیه‌ای که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.36,
   "end": 485.54,
   "text": "اینها نشون میده که چقدر عرض شود خدمتتون که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 485.54,
   "end": 491.52,
   "text": "صبر ارزشمند است و ما هیچ خلاصه هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.52,
   "end": 494.38,
   "text": "چاره‌ای نداریم عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.38,
   "end": 500.52,
   "text": "الا اینکه بر مشکلات و مصائب حتی بر موت، موت خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.52,
   "end": 503.42,
   "text": "صبر کنیم. ما جالبه که بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.42,
   "end": 506.58,
   "text": "احادیث زیادی داریم که تصریح دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 506.58,
   "end": 513.52,
   "text": "که خدای منان محب امیرالمؤمنین صلوات الله علیه رو تا راضیش نکنه از دنیا نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.52,
   "end": 516.82,
   "text": "حالا بعضیا با همون ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.82,
   "end": 518.92,
   "text": "کنار رفتن پرده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.92,
   "end": 524.66,
   "text": "از جلوی چشمشون و دیدن مقامات بهشتی و در-درجات اونچنانی راضی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.66,
   "end": 528.94,
   "text": "بعضیا زرنگن نه با دیدن غرفه‌های بهشتی باز راضی نمیشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.94,
   "end": 533.84,
   "text": "که اونجا حضرت تصریح فرمودن، امام صادق صلوات الله علیه فرمودن که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 533.84,
   "end": 539.74,
   "text": "خدای منان چهره زیبای رسول خاتم و امیرالمؤمنین و حتی حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 539.74,
   "end": 543.48,
   "text": "صلوات الله علیهم اجمعین اینها رو نشون میده که طرف راضی میشه به رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.48,
   "end": 546.8,
   "text": "اینها چرا؟ انقدر که موت سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.8,
   "end": 549.98,
   "text": "و سختی موت، اون سکرات، اون عرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.98,
   "end": 554.38,
   "text": "مرگ که رو پیشانی می‌شینه و حالت معاینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.38,
   "end": 558.66,
   "text": "شخص هم این طرفو می‌بینه هم اون طرف رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.66,
   "end": 561.96,
   "text": "در هر حال این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.96,
   "end": 565.78,
   "text": "حقیقت موت باید همراه با صبر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 565.78,
   "end": 568.94,
   "text": "یعنی صبر حتی بر موت می‌طلبه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.94,
   "end": 572.98,
   "text": "داشته باشیم و از الان خودمون رو آماده کنیم برای همچین روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.98,
   "end": 575.48,
   "text": "و خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.48,
   "end": 580.0,
   "text": "باز از امام باقر صلوات الله علیه روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 580.0,
   "end": 583.58,
   "text": "که می‌دیدم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.58,
   "end": 587.56,
   "text": "به یک لفظ دیگری ولی به همین مضمون امیرالمؤمنین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.56,
   "end": 590.32,
   "text": "فرمودن که چهار گونه موت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 590.32,
   "end": 593.08,
   "text": "حالا طرف یا مومنه یا کافره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.08,
   "end": 596.44,
   "text": "حالا همین مومن و کافر یا راحت جون میدن یا سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.44,
   "end": 600.1,
   "text": "میشه چهار نوع مرگ. اگر مومنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 600.1,
   "end": 604.44,
   "text": "و راحت جون میده این مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 604.44,
   "end": 607.98,
   "text": "کساییه که درجاتشون خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.98,
   "end": 611.66,
   "text": "البته این راحتی و سختی جون دادن خیلی به ظاهر ربط نداره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.66,
   "end": 614.48,
   "text": "اینو توجه داشته باشید که اشتباه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 614.48,
   "end": 618.86,
   "text": "ماها نمی‌تونیم بگیم فلانی راحت جون داد یا سخت جون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 618.86,
   "end": 621.38,
   "text": "این بر-برمی‌گرده به اون حالت لحظه معاینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.38,
   "end": 626.9,
   "text": "که حتی حدیث داریم تو یک آن می‌بینی طرف جون داده اما برای بعضیا هفتصد سال طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 626.9,
   "end": 631.48,
   "text": "حالا اون مومنی که راحت جون میده با همین توضیحات که عرض کردیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.48,
   "end": 635.44,
   "text": "درجاتش بالاست. اما اگر سخت جون بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 635.44,
   "end": 637.68,
   "text": "پاک کننده گناهانشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 637.68,
   "end": 641.78,
   "text": "که \"الموت كفارة لذنوب المؤمنين\" دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 641.78,
   "end": 644.1,
   "text": "پیامبر اعظم و شهن اسلام فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.1,
   "end": 647.18,
   "text": "حالا اما اگر کافر باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 647.18,
   "end": 650.28,
   "text": "راحت جون بده این تسویه خیراتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 650.28,
   "end": 652.78,
   "text": "کارهای خوبی که این شخص داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 652.78,
   "end": 656.84,
   "text": "و اگر سخت جون بده اول عقاب و جهنمشه دیگه خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 656.84,
   "end": 661.94,
   "text": "حالا یکی از اینا بالاخره ما باید به یک، به یکی از این اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.94,
   "end": 664.86,
   "text": "به موت برسیم، به حقیقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.86,
   "end": 668.14,
   "text": "و باز امام باقر صلوات الله علیه در یک روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 668.14,
   "end": 673.28,
   "text": "عجیبی دارن که هر وقت خدا بخواد بنده‌ای رو اکرام کنه، خوب گوش بدید عزیزان اینجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 673.28,
   "end": 677.64,
   "text": "حواستون جمع باشه. خیلی عجیبه که می‌فرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.64,
   "end": 685.0,
   "text": "اگر خدا بر اراده اکرام بنده‌ای رو بکنه، تکریم بکنه بنده‌ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 685.0,
   "end": 689.16,
   "text": "در حالی که اون گناهانی رو داره مریضش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 689.16,
   "end": 692.78,
   "text": "مریضش می‌کنه. جالبه که چی بشه که پاکش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 692.78,
   "end": 697.16,
   "text": "یا حالا پس برعکسه معمولاً مریض به سالم میگه دعام کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 697.16,
   "end": 700.76,
   "text": "در حالی که ما باید به مریض بگیم آقا التماس دعا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.76,
   "end": 704.44,
   "text": "خدا اراده خیر براش کرده و می‌خواد پاکش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 704.44,
   "end": 707.52,
   "text": "و حالا متأسفانه تو چشم عام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 707.52,
   "end": 712.54,
   "text": "این چنینه که یکی مریض میشه میگیم خدا زدتش فلان اینها در صورتی که برعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.54,
   "end": 717.9,
   "text": "حالا اگر مریضی نتونست گناهشو پاک کنه، امام باقر صلوات الله علیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 717.9,
   "end": 724.16,
   "text": "حاجتمندش می‌کنه، گرفتارش می‌کنه، فقیرش می‌کنه که خیلی درد سختیه که گناهای دیگرش بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 724.16,
   "end": 730.28,
   "text": "اگر باز نشد فرمودن که وقت جان کندن بر او سخت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 730.28,
   "end": 732.5,
   "text": "که سخت جان بده. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 732.5,
   "end": 736.68,
   "text": "در حقیقت مطهره. داره باز تصریح می‌کنه که موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 736.68,
   "end": 738.86,
   "text": "مطهره، پاک کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 738.86,
   "end": 746.02,
   "text": "و البته اگر خدا در همین روایت امام باقر صلوات الله علیه فرمودن ادامه دادن که اگر خدا بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 746.02,
   "end": 749.56,
   "text": "اراده خاری بنده‌ای رو بکنه صحت جسمانی بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.56,
   "end": 755.06,
   "text": "عجب! کاملاً صلا-سلامت جسمی بهش میده و اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 755.06,
   "end": 758.52,
   "text": "بخواد این خاری رو براش ادامه بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.52,
   "end": 765.28,
   "text": "در چشم خدا بیشتر بیفته، رزق وسیع بهش میده، غرقش می‌کنه در نعمت‌ها که غافل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 765.28,
   "end": 770.5,
   "text": "و اگر باز بیشتر از این بخواد خارش کنه راحتم جون-جونشو می‌گیره لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 770.5,
   "end": 772.84,
   "text": "مرگ. چه عجیب! که حالا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 772.84,
   "end": 776.58,
   "text": "من حیث المجموع جمع‌بندی کنیم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 776.58,
   "end": 779.42,
   "text": "اون هم اینکه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 779.42,
   "end": 784.18,
   "text": "برای عرض شود خدمتتون برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 784.18,
   "end": 786.78,
   "text": "اینکه بتوانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 786.78,
   "end": 790.36,
   "text": "کفایت الهی رو در زندگیمون ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 790.36,
   "end": 794.82,
   "text": "باید به سمت اسم سميع و علیع حضرت حق بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 794.82,
   "end": 799.54,
   "text": "و با از ملک به ملکوت ارتباط بگیریم و تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 799.54,
   "end": 805.0,
   "text": "با ملکوت ارتباط برقرار نکنیم به مقام صبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 805.0,
   "end": 807.54,
   "text": "و ص-- اون صبری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 807.54,
   "end": 810.62,
   "text": "حتی شدتش میشه صبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 810.62,
   "end": 817.22,
   "text": "نمی‌رسیم. که اگر کسی نرسه به مقام صبر دیگه کار تمامه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.22,
   "end": 822.2,
   "text": "اون \"تواصوا بالصبر\" که در آیات قرآن فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 822.2,
   "end": 831.04,
   "text": "پس ما باید تلاش کنیم که از ملک به ملکوت پل بزنیم تا حتی به صبر بر موت خودمون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 831.04,
   "end": 833.42,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 833.42,
   "end": 835.86,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}