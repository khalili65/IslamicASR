   "start": 312.68,
   "end": 440.56
  },
  {
   "index": 1,
   "title": "## ابراهیم و شنیدن نام حق",
   "start": 440.56,
   "end": 460.56
  },
  {
   "index": 2,
   "title": "## صغرا و کبرا: حفظ جلسات حسین",
   "start": 460.56,
   "end": 786.18
  },
  {
   "index": 3,
   "title": "## دو خواسته از فرزند؛ خواب لباس",
   "start": 786.18,
   "end": 806.3
  },
  {
   "index": 4,
   "title": "## خواب آقا مجتبی و نگاه‌داری لباس",
   "start": 806.3,
   "end": 937.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.34,
   "end": 7.16,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.16,
   "end": 10.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.82,
   "end": 15.78,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.78,
   "end": 18.94,
   "text": "میریم به فضل الهی سراغ روایت بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.94,
   "end": 23.12,
   "text": "روایت هشتم رو عرض کردیم البته نکاتی موند بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.12,
   "end": 27.42,
   "text": "روایت نهم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.42,
   "end": 32.58,
   "text": "عن الصادق عن ابیه علیهم السلام قال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.58,
   "end": 36.1,
   "text": "امام صادق از پدرش یعنی امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.1,
   "end": 38.52,
   "text": "باقر نقل می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.52,
   "end": 42.18,
   "text": "ایشون فرمودن أتى النبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.18,
   "end": 47.08,
   "text": "رجل. جالبه که دقت کنید أتى خب فعله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.08,
   "end": 52.26,
   "text": "النبي اینجا مفعوله و رجل کی اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.26,
   "end": 56.74,
   "text": "یه مردی اومده خدمت پیغمبر فا اینجا فاعل میشه رجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.74,
   "end": 61.5,
   "text": "قاعده در ادبیات عرب اینه فعل و فاعل و مفعول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.5,
   "end": 67.7,
   "text": "اینجا امام چنان حرمت بره حتی نام پیغمبر قائله اینا درسه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.7,
   "end": 71.18,
   "text": "حالا کسی شاید توجه کنه خیلی متوجه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.18,
   "end": 76.72,
   "text": "اما اینجا مفعول رو میاره مقدم بر فاعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.72,
   "end": 79.0,
   "text": "أتى النبي، النبي مفعوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.0,
   "end": 82.46,
   "text": "کسی رو، یه مردی وارد شده بر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.46,
   "end": 86.3,
   "text": "درسته که درستش اینه که بگه أتى آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.3,
   "end": 91.22,
   "text": "کی؟ رجل. حالا النبي بر پیغمبر مفعول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.22,
   "end": 94.02,
   "text": "ولی اینجا نه میگه أتى النبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.02,
   "end": 96.28,
   "text": "آمد نبی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.28,
   "end": 98.3,
   "text": "نشانه مفعولیم \"را\" بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.3,
   "end": 100.26,
   "text": "کی؟ یه رجل، یه مردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.26,
   "end": 104.96,
   "text": "به به! ببین ادب رو حتی در گفتارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.96,
   "end": 109.82,
   "text": "اینا درس آموزه به خدا. أتى النبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.82,
   "end": 113.68,
   "text": "رجل. یه مردی اومد محضر پیغمبر عزیز عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.68,
   "end": 117.06,
   "text": "فقال مالي لا أحب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.06,
   "end": 123.72,
   "text": "یا رسول الله چرا من لا أحب الموت موت رو دوست ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.72,
   "end": 125.66,
   "text": "انگار که بدم میاد. اکراه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.66,
   "end": 128.58,
   "text": "دوست ندارم موت رو. دلیلش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.58,
   "end": 132.36,
   "text": "البته خب ایشون داره از پیغمبر سؤال می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.36,
   "end": 136.42,
   "text": "شاید این گفته بشه که خب ایشون اینطوری بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.42,
   "end": 139.88,
   "text": "ها؟ این شخص این گرفتاری رو داشته پیغمبر بهش گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.88,
   "end": 142.28,
   "text": "چون اول ازش سؤال می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.28,
   "end": 149.68,
   "text": "بعد جواب میده. اما وقتی یه مقدار این روایت منشرح بشه، باز بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.68,
   "end": 152.12,
   "text": "متنش شرح داده بشه می بینیم نه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.12,
   "end": 156.14,
   "text": "بلای همه گیره. سر خودمون رو کلاه نذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.14,
   "end": 157.72,
   "text": "چرا من دوست ندارم موت رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.72,
   "end": 161.08,
   "text": "عالم ما اینطوری هستیم. یک اکراه گونه‌ای از موت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.08,
   "end": 165.62,
   "text": "فقال له پیغمبر بهش فرمود ألک مال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.62,
   "end": 167.32,
   "text": "پیغمبر سریع جواب نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.32,
   "end": 169.34,
   "text": "سؤال رو با سؤال جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.34,
   "end": 172.46,
   "text": "ألک مال؟ آیا مال داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.46,
   "end": 176.88,
   "text": "مالی داری؟ آیا مثلاً ثروتی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.88,
   "end": 178.94,
   "text": "قال نعم بله دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.94,
   "end": 183.12,
   "text": "بله. قال فقدمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.12,
   "end": 187.64,
   "text": "آیا پس حالا که داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.64,
   "end": 189.96,
   "text": "چقدر تعبیر ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.96,
   "end": 192.3,
   "text": "آیا تقدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.3,
   "end": 195.82,
   "text": "می‌کنی این مال رو؟ یعنی پیشکش می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.82,
   "end": 198.62,
   "text": "یعنی فقدمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.62,
   "end": 202.06,
   "text": "اون رو پیشی پیش می‌فرستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.06,
   "end": 204.96,
   "text": "جلوتر از خودت بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.96,
   "end": 207.78,
   "text": "مثل اینکه فرش راهت میخواد بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.78,
   "end": 212.76,
   "text": "چقدر تعبیر قشنگه. نمی‌فرماید حالا انفاق می‌کنی یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.76,
   "end": 218.5,
   "text": "فقط میگه که اینو تقدیم می‌کنی، پیشکش می‌کنی، جلوتر از خودت می‌فرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.5,
   "end": 222.38,
   "text": "خیلی جالبه. چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 222.38,
   "end": 224.66,
   "text": "قال لا گفت نه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.66,
   "end": 226.84,
   "text": "این کار رو نمی‌کنم. قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.84,
   "end": 229.98,
   "text": "فمن ثم لا تحب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.98,
   "end": 235.78,
   "text": "اصلا علت اینکه تا لا تحب الموت موت رو دوست نداری همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 235.78,
   "end": 238.18,
   "text": "اینکه پیشکش نمی‌کنی. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 238.18,
   "end": 242.18,
   "text": "یعنی ما چون فرش قرمز برای خودمون پهن نکردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.18,
   "end": 247.6,
   "text": "چون برای خودمون چیزی تقدیم نکردیم، پیشکش نکردیم از موت می‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 247.6,
   "end": 250.1,
   "text": "حالا اینجا سؤال بحث ماله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.1,
   "end": 252.6,
   "text": "همه چی. روی مصداق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 252.6,
   "end": 259.2,
   "text": "مثال البته گیر و گور اصلی ما بیشتر ت-توجه کنیم می‌بینیم بحث ماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.2,
   "end": 262.96,
   "text": "ما بعضیامون حتی حاضریم جون بدیم اما مال ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.96,
   "end": 265.98,
   "text": "حالا انصافاً چقدر مگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 265.98,
   "end": 273.24,
   "text": "چند درصد می‌شینیم درصدبندی می‌کنیم از این حقوقی که می‌گیریم چند درصدش خرج پوشاک میشه، خوراک میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.24,
   "end": 278.52,
   "text": "اجاره خونه میشه، درمان میشه اینا رو ولی چند درصد انفاقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.52,
   "end": 280.9,
   "text": "چند درصدش در راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.9,
   "end": 285.0,
   "text": "و حجت خدا. حالا انشاالله فرصت بشه یه جلسه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 285.0,
   "end": 293.02,
   "text": "در خصوص توصیه‌هایی که پیرامون خرج کردن در راه خدا به خصوص حجت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.02,
   "end": 295.36,
   "text": "بیان شده رو بگیم. یه چند تاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.36,
   "end": 298.82,
   "text": "ببینید چقدر تکلیف ما سنگینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.82,
   "end": 305.02,
   "text": "که حالا انشاالله عرض می‌کنیم بعداً که کسی در راه حجت خدا خرج نکنه قطعاً مالش در راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.02,
   "end": 308.88,
   "text": "غیر حجت خدا حتی یه روایت لرزان و ترسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.88,
   "end": 312.36,
   "text": "میگه در راه دشمنیه با حجت خدا خرج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.36,
   "end": 316.24,
   "text": "یه دو سه روز پیش بود یکی از فامیل‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.24,
   "end": 319.04,
   "text": "شب فکر کنم اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.04,
   "end": 326.28,
   "text": "تاسوعا بود اینا من می‌خواستم برم هیئت یه دفعه برخورد به من بعد از چند سال به حاجی آقا فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.28,
   "end": 329.32,
   "text": "التماس به ما که می‌رسن دیگه التماس دعاها گل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.32,
   "end": 332.18,
   "text": "فکر می‌کنن حالا ما چی هستیم، چی نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.18,
   "end": 335.34,
   "text": "حالا احترام به این لباس. حاجی آقا التماس دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.34,
   "end": 337.8,
   "text": "خب چیه؟ حالا یا مریض داره یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.8,
   "end": 340.24,
   "text": "خواب دیده باید تعبیر کنیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.24,
   "end": 342.9,
   "text": "نمی‌دونم چکش داره برگشت می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.9,
   "end": 344.64,
   "text": "یه یا یه ذکر و وردی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.64,
   "end": 346.5,
   "text": "این چیزاست دیگه. سؤالاتی که از ما دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 346.5,
   "end": 350.3,
   "text": "انقدر که بی‌سوادی ایم کسی از ما سؤال‌های دقیق علمی نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.3,
   "end": 353.32,
   "text": "همین، در همینه. در حد خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.32,
   "end": 356.98,
   "text": "خلاصه گفتش که حاجی آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 356.98,
   "end": 359.66,
   "text": "دعا می‌کنیم. گفتم چشم ما که قابل نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 359.66,
   "end": 362.5,
   "text": "چشم خودش یه دفعه گفت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 362.5,
   "end": 366.8,
   "text": "ج-- جسارت نکردم مشکلت چیه؟ گفت نیم کیلو طلای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 366.8,
   "end": 372.26,
   "text": "ناب ، نیم کیلو طلای ناب جمع کرده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.26,
   "end": 374.96,
   "text": "بعد اینو دادم آقا طلا سازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 374.96,
   "end": 378.08,
   "text": "آقا دزده، آقاست دیگه آقا دز-دزده همه آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 378.08,
   "end": 380.9,
   "text": "خانم نیستن. آقا دزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 380.9,
   "end": 382.7,
   "text": "این طلاها رو برای ما چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.7,
   "end": 386.84,
   "text": "آبش کنه. آقا دیگه رفته که دیگه رفته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.84,
   "end": 389.86,
   "text": "آقا دزده نیم کیلو طلا این ناب دستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 389.86,
   "end": 392.16,
   "text": "من چی بگم به این بنده خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 392.16,
   "end": 394.24,
   "text": "باید بگم چشم دعا تون می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 394.24,
   "end": 396.58,
   "text": "اما واقعا قابل دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 396.58,
   "end": 400.04,
   "text": "نیم کیلو طلا آخه تو می‌خوای چه کنی تو خونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 400.04,
   "end": 402.84,
   "text": "من می‌گم دنبال چی ان بعضیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 402.84,
   "end": 410.66,
   "text": "اینه وقتی مالی در راه حجت خدا، در راه دین خدا، در راه خیر و صلاح خدا اما نخواستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 410.66,
   "end": 413.98,
   "text": "ف-ف-فرمود \"فقد دمتهو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 413.98,
   "end": 419.88,
   "text": "تقدیم و پیشکش راه خودمون نمیشه، فرش قرمزه راه خودمون نمیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.88,
   "end": 422.12,
   "text": "فرش قرمز آقا دزده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.12,
   "end": 427.6,
   "text": "برم داره می‌موشه جونش. وقتی من خرج نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 427.6,
   "end": 431.34,
   "text": "اینطوری یعنی باید یه کاری کرد تا از خدا چیزی گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.34,
   "end": 436.34,
   "text": "بارها من اینو گفتم بذار دوباره بگم در قصه حضرت ابراهیم سریع رد میشم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.34,
   "end": 442.26,
   "text": "چون چند بار گفتم. اونجایی که حضرت ابراهیم رسید حضرت جبرائیل خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.26,
   "end": 444.32,
   "text": "امتحانش کنه. خدا فرموده بود برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.32,
   "end": 447.92,
   "text": "چرا اینو خلیل انتخاب کردی؟ فرمود خودت، خودت امتحانش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 447.92,
   "end": 452.2,
   "text": "رو اون تپه غی-- به صورت غیبی حاطف یعنی نمی‌بینیش صدا می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 452.2,
   "end": 455.8,
   "text": "\"ص ぶ خن قد دوست ربنا غرب بل ملائکة وروح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 455.8,
   "end": 461.72,
   "text": "حضرت ابراهیم خدا رحمت کنه آیت‌الله آالناصری رو ما اصفهان می‌رفتیم پاد درسشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.72,
   "end": 465.54,
   "text": "خودم تو اون جلسه در محضر ایشون از ایشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 465.54,
   "end": 471.22,
   "text": "روایتشو ندیدم. بعدا شبیه به این روایت رو دیدم ولی عددش فرق می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.22,
   "end": 474.72,
   "text": "حالا، فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 474.72,
   "end": 484.18,
   "text": "شش هزار سگ، شش هزار سگ فقط زنگوله‌دار فقط گوسفندهای حضرت ابراهیم رو مراقبت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.18,
   "end": 488.44,
   "text": "خیییلی داشت حضرت ابراهیم ولی خب در راه خدا گله گله می‌بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 488.44,
   "end": 491.12,
   "text": "اینم مثالشه. که بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.12,
   "end": 497.12,
   "text": "وقتی این رو شنید خیلی خب معلومه که پیداست که اون موقع خیلی کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.12,
   "end": 500.6,
   "text": "تسبیح گو نبوده. خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.6,
   "end": 507.04,
   "text": "ای کاش تسبیح گو کم باشه اما تسبیح گوی ریاکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.04,
   "end": 510.02,
   "text": "زیاد نباشه. این خیلی بدتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.02,
   "end": 512.62,
   "text": "هرچی ما ضربه می‌خوریم از آدمای م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.62,
   "end": 515.36,
   "text": "جای مهر رو پیشونیه تسبیح دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.36,
   "end": 518.42,
   "text": "ادعای انقلابی‌گری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.42,
   "end": 522.6,
   "text": "چی و اینا که پدر انقلاب رو درآوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.6,
   "end": 526.26,
   "text": "و ایشون گفتش که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 526.26,
   "end": 528.72,
   "text": "نمیدونست کیه که گفت آقا صاحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 528.72,
   "end": 533.34,
   "text": "صدا میشه یه بار دیگه بگین نصف، یک سوم این دارایی‌مو به تو می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 533.34,
   "end": 538.34,
   "text": "الله. خب من و شما باشیم می‌گیم چقدر می‌بخشم خداوکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 538.34,
   "end": 540.26,
   "text": "یه دونه از اون گوسفندامو بهت میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 540.26,
   "end": 543.18,
   "text": "یه بار دیگه بگو. اگه خیلی بخشنده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.18,
   "end": 546.18,
   "text": "اونم اون شله پله رو، اون گوسفنده که داغونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.18,
   "end": 549.2,
   "text": "رو به موته میگیم این مال تو. مثل قابیل دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 549.2,
   "end": 551.8,
   "text": "قابیل چرا ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 551.8,
   "end": 554.88,
   "text": "نظرش قبول نشد؟ رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 554.88,
   "end": 557.92,
   "text": "، اون عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 557.92,
   "end": 560.92,
   "text": "بیخودی‌ترین مالشو در راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 560.92,
   "end": 566.2,
   "text": "چیز کرد. ولی حضرت حابیل اون بهترین‌ها رو، چاق و چله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.2,
   "end": 569.24,
   "text": "انتخاب کرد داد. خدا اونو قبول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 569.24,
   "end": 573.5,
   "text": "اینطوری نیست خداوکیلی ما چند تامون مثلا فرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.5,
   "end": 577.86,
   "text": "نو، نو، دیگه نو دست نخورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.86,
   "end": 582.16,
   "text": "خ-- دادیم بردیم گذاشتیم تو یه-- معمولا شما بیاید حسینیه‌ها رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 582.16,
   "end": 586.06,
   "text": "مبلهای شکسته پکسته، داغون و فرش‌های یه گوشه‌اش سوخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 586.06,
   "end": 588.38,
   "text": "و روغن سوخته و نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 588.38,
   "end": 593.14,
   "text": "حسینیه می‌کنن. اینطوریه دیگه متاسفانه امام حسین ما رو ببخشه دیگه اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 593.14,
   "end": 597.92,
   "text": "ولی بیای یه دفعه از خودت بگذری، از نیاز خودت این کم پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 597.92,
   "end": 602.44,
   "text": "حالا بماند. خلاصه گفت یک سوم دارایی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 602.44,
   "end": 604.8,
   "text": "یه بار دیگه بگو. ایشون گفت حضرت جبرائیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 604.8,
   "end": 608.76,
   "text": "\"ص ぶ خن قد دوست ربنا غرب بل ملائکة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.76,
   "end": 611.82,
   "text": "حضرت ابراهیم اینجا این نکته‌ست که به خاطر این گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.82,
   "end": 613.96,
   "text": "می‌خواست که دوباره بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 613.96,
   "end": 615.76,
   "text": "خب یه بار بخشیده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 615.76,
   "end": 617.54,
   "text": "می‌تونست بگه میشه یه بار دیگه بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 617.54,
   "end": 622.94,
   "text": "اما دوباره گفت یک سوم دیگرم بهت یعنی دو سوم می‌بخشم بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 622.94,
   "end": 627.66,
   "text": "این نکته‌ست. بزرگان از اینجا استفاده کردن که حالا بعد ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.66,
   "end": 629.26,
   "text": "بعد می‌گه کلشو می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 629.26,
   "end": 631.84,
   "text": "بعد دیگه چیزی نداره. می‌گه خودم غلامت میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 631.84,
   "end": 636.64,
   "text": "یه بار دیگه بگو. که ایشون می‌گه و بعد خب حالا متوجه می‌شه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 636.64,
   "end": 640.66,
   "text": "جبرائیل و بعد محضر خدا بار میاد به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.66,
   "end": 644.58,
   "text": "ج-جبرائیل و عرض می‌کنه که به حق که ایشون خلیل الرحمنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 644.58,
   "end": 647.42,
   "text": "خلیل تو هستن. امتحانو خوب پس داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 647.42,
   "end": 650.34,
   "text": "همه چیز رو خودش هم غلام بشه برای ذکر خدا بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 650.34,
   "end": 652.44,
   "text": "این فیلم که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 652.44,
   "end": 656.08,
   "text": "درونش می‌جوشه محبت و حب و عشق خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 656.08,
   "end": 659.22,
   "text": "اصلا دل کنده از همه تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 659.22,
   "end": 661.78,
   "text": "امانت دار خداست. همه رو هم برمی‌گردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 661.78,
   "end": 665.6,
   "text": "نکته اونجاست که می‌تونست بگه یه بار دیگه بگو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 665.6,
   "end": 670.02,
   "text": "دو بار دیگه بگو، سه بار دیگه. اما می‌بخشه و درخواست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 670.02,
   "end": 674.16,
   "text": "بزرگان گفتن برای هر تجلی، اینو تو خ-- نتیجه رو خوب دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 674.16,
   "end": 677.4,
   "text": "برای گرفتن هر تجلی جدیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 677.4,
   "end": 679.28,
   "text": "حتی یک اشک جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 679.28,
   "end": 682.46,
   "text": "دیشب اشک ریختم. حالا الان می‌خوام دوباره اشک بریزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.46,
   "end": 685.1,
   "text": "یه صدقه بده. قبلش یه کاری بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 685.1,
   "end": 688.08,
   "text": "یه کاری بکن. معامله کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 688.08,
   "end": 690.5,
   "text": "بگو خب حالا ازت چیزی می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 690.5,
   "end": 693.8,
   "text": "همینطوری مفت و مفت که خدا چیزی نمیده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 693.8,
   "end": 697.84,
   "text": "مفت و مفت خیلی چیزا رو داده ما قدر ندونستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 697.84,
   "end": 703.22,
   "text": "اینا همش به خدا دلیل محکم و متقن شما روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 703.22,
   "end": 707.82,
   "text": "منشرح کنی، آیات رو منشرح کنی، می‌رسی به این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 707.82,
   "end": 711.98,
   "text": "ولی نه همینطوری بخوای آیه رو بخونی بری میگی حالا یه بیکار و دله‌ای اومد در محضر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 711.98,
   "end": 715.14,
   "text": "جسارتا یه سوالی پرسید پیغمبر هم در حد اون جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 715.14,
   "end": 718.02,
   "text": "به ما چه؟ ما که داریم برای امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 718.02,
   "end": 724.08,
   "text": "می‌کشیم خودمونو. واقعا داریم خودمونو می‌کشیم برای امام حسین خودم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 724.08,
   "end": 726.48,
   "text": "چقدر از زندگیم بخشیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 726.48,
   "end": 732.64,
   "text": "به حیات، حیات اصلی زندگیم که به محبت حسین و جلسات حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 732.64,
   "end": 736.38,
   "text": "یه دو تا چهارتا بکنم نمی‌دونم کی تا حالا به این توجه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 736.38,
   "end": 738.78,
   "text": "اینو خودم بهش توجه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 738.78,
   "end": 742.28,
   "text": "حضرت امام یه جمله داره. فرمود این محرم و صفر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 742.28,
   "end": 746.72,
   "text": "این جلسات حسین است. این روضه‌هاست که اسلام را زنده نگه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 746.72,
   "end": 754.68,
   "text": "این یک بحث. رهبر عزیزمون فرمودن امروز از اهم واجبات حفظ اسلام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 754.68,
   "end": 756.9,
   "text": "حالا شما اینا رو کنار هم بگذارید چه نتیجه می‌گیرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 756.9,
   "end": 759.62,
   "text": "این صغرا، اون کبرا حالا قضیه شد اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 759.62,
   "end": 763.96,
   "text": "نتیجه چی؟ اهم واجبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 763.96,
   "end": 767.32,
   "text": "حفظ اسلام. ح-- اسلامو چی نگه داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 767.32,
   "end": 771.66,
   "text": "جلسات ذکر امام حسین. پس اهم واجبات می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 771.66,
   "end": 773.8,
   "text": "حفظ جلسات امام حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 773.8,
   "end": 776.14,
   "text": "تعظیم جلسات امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 776.14,
   "end": 779.04,
   "text": "تا می‌تونه انسان این جلسات رو تعظیم کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 779.04,
   "end": 786.0,
   "text": "تا می‌تونه ذکر امام حسین رو بالا ببره، پرچم بزنه، بیرق بزنه، خودشو خرج کنه، بچه‌هاشو خرج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 786.0,
   "end": 788.66,
   "text": "من همیشه به دخترم و پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 788.66,
   "end": 793.18,
   "text": "همیشه اینو گفتم که دخترم، پسرم من نه اصراری دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 793.18,
   "end": 795.62,
   "text": "چیکاره بشید، کجا برید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 795.62,
   "end": 798.14,
   "text": "نمی‌دونم چه کاری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 798.14,
   "end": 804.9,
   "text": "پیشه کنید، چه رشته تحصیلی رو بخونید، آخوند، دکتر، مهندس، شقاق بقال، اصلاً اینا مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 804.9,
   "end": 807.54,
   "text": "جارو دستت بگیر، کارمند شهرداری شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 807.54,
   "end": 810.64,
   "text": "اینا ظواهره. فقط دو چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 810.64,
   "end": 816.06,
   "text": "ازت می‌خوام دخترم، پسرم بنده خدا باش، نوکر امام زمان والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 816.06,
   "end": 818.26,
   "text": "حالا تو هر لباسی بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 818.26,
   "end": 822.98,
   "text": "من خودمو وقتی اصرار داشتن بزرگانمون که لباس بپوش نمی‌پوشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 822.98,
   "end": 827.76,
   "text": "درس خارج می‌خوندیم دیگه همه پوشیده بودن جز من تو کلاس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 827.76,
   "end": 831.52,
   "text": "دیگه استاد ما به اجبار گفت باید عید غدیر بپوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 831.52,
   "end": 834.18,
   "text": "ما کلک زدیم پاشدیم رفتیم کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 834.18,
   "end": 836.28,
   "text": "حالا قصه داره. کربلا نجف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 836.28,
   "end": 838.76,
   "text": "اونجا به زور تنمون کردن بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 838.76,
   "end": 840.62,
   "text": "شبش خواب دیدم. خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 840.62,
   "end": 844.38,
   "text": "حالا دیدید من خودم شاید اولین باره دارم یه خواب برای شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 844.38,
   "end": 847.32,
   "text": "تا حالا این کارو نکرده بودم. از این و اون گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 847.32,
   "end": 850.5,
   "text": "ولی خیلی برام جالب بود که آقا مجتبی تهرانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 850.5,
   "end": 852.76,
   "text": "در خواب به من یه، یه سری جملات گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 852.76,
   "end": 854.68,
   "text": "ایشون یه صحبت‌هایی کرد بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 854.68,
   "end": 860.9,
   "text": "یه، یه رشه‌ای از نحوه سوختن برای ابا عبدالله رو تو خواب عملاً به من نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 860.9,
   "end": 866.1,
   "text": "بعد ایشون به من گفتش که اگه می‌خوای خدمت کنی البته به شاگردش گفت شاگردش با واسطه به من گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 866.1,
   "end": 871.38,
   "text": "بعد آقا مجتبی از عشق امام حسین سوخت مثل یه شمع آب شد رفت تو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 871.38,
   "end": 876.34,
   "text": "حالا بماند. به من گفت اگه می‌خوای خدمت کنی نیازی نداره حتما این لباسو بپوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 876.34,
   "end": 878.88,
   "text": "تو هر لباسی می‌تونی خدمت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 878.88,
   "end": 885.78,
   "text": "ببین این حرفه. بعد حالا یه جمله‌ای گفت که اگر اما بدون که این لباس تو رو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 885.78,
   "end": 889.68,
   "text": "فکر نکنی تو این لباسه. این لباس تو رو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 889.68,
   "end": 893.76,
   "text": "برکت این لباس بعد خیلی جالب بود تندیس الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 893.76,
   "end": 897.26,
   "text": "آرم جمهوری اسلامیه. این تیغه وسطشو برداشت دوباره گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 897.26,
   "end": 899.88,
   "text": "تلا شکل بود گذاشت. گفت این تیغه رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 899.88,
   "end": 902.98,
   "text": "الان الله نیست. گذاشت وسط گفت دیدی الله شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 902.98,
   "end": 905.36,
   "text": "این لباس همین‌جوری تورو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 905.36,
   "end": 908.06,
   "text": "محیمنه تورو، تو رو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 908.06,
   "end": 910.34,
   "text": "و واقعاً ما دیدیم این رو درمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 910.34,
   "end": 913.1,
   "text": "من این لباسو درمیارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 913.1,
   "end": 917.08,
   "text": "دیگه بچه‌ها هم می‌دونن به ما چی میگن تو نظام آباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 917.08,
   "end": 922.16,
   "text": "این لباس تنم نیست اصلاً عنوانم عوض می‌شه، حرف زدنم عوض می‌شه، همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 922.16,
   "end": 926.98,
   "text": "ولی این تنمه بچه‌ها با ادب و کت و شلوار کشیده و آن کار کرده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 926.98,
   "end": 931.62,
   "text": "انشالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 931.62,
   "end": 937.24,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}