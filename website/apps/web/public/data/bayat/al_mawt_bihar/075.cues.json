   "end": 863.97
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.2,
   "end": 10.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.34,
   "end": 13.4,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.4,
   "end": 15.84,
   "text": "و ربانی آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.84,
   "end": 19.5,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.5,
   "end": 22.6,
   "text": "به نوبه خودم تسلیت عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.6,
   "end": 25.12,
   "text": "شب شهادت رئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.12,
   "end": 28.46,
   "text": "مذهب رو و این امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.46,
   "end": 34.74,
   "text": "کشاف حقایق، به حق ناطق، امام جعفر صادق سلام الله عليه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.74,
   "end": 42.68,
   "text": "الحمد لله حالا زیارت عاشورا خونده شده، روضه خونده شده، مصیبت‌خوانی شده فضای اینجا متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.68,
   "end": 46.66,
   "text": "ما هم راحت‌تر صحبت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.66,
   "end": 49.1,
   "text": ". که در صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.1,
   "end": 54.06,
   "text": "خواجه نصیر منسوب به خواجه نصیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.06,
   "end": 65.9,
   "text": "علیه الرحمه اونجا که می‌رسه به امام صادق، خب اولش که میگه اللهم صل وسلم وزد و بارک على صاحب الدعوة النبویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.9,
   "end": 68.78,
   "text": "منظور صاحب اینجا صاحب زمانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.78,
   "end": 76.38,
   "text": "که صاحب دعوت نبوی‌ست، سلط حیدری‌ست، عصمت فاطمی‌ست، حلم حسنی‌ست، شجاعت حسینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.38,
   "end": 80.52,
   "text": "وقتی به امام باقر می‌رسه؛ ول مآثر الباقریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.52,
   "end": 85.36,
   "text": "مآثر جمع مؤثر یعنی آثار برگزیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.36,
   "end": 88.68,
   "text": ". یعنی آثار نیک. بعد به امام صادق؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.68,
   "end": 91.16,
   "text": "والآثار الجعفریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.16,
   "end": 93.32,
   "text": "کی این آثار رو داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.32,
   "end": 96.32,
   "text": "امام عصر. یعنی وارث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.32,
   "end": 103.88,
   "text": "همه آثار امام صادق صلی الله عليه امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.88,
   "end": 108.94,
   "text": "اصلاً ما لذا میگیم رئیس مذهب هرچی که ما داریم از این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.94,
   "end": 112.38,
   "text": "لذا شاید به همین وجهه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.38,
   "end": 116.64,
   "text": "بسیاری از بزرگان مخصوصاً آقای ضحیح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.64,
   "end": 121.28,
   "text": "ایشون میفرمایند که شهادت امام صادق عاشورای دومه برای شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.28,
   "end": 126.7,
   "text": "باید خیلی تکریم بشه، تعظیم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.7,
   "end": 131.52,
   "text": "باید مثل عاشورا چه گونه مردم اینطوری شور و حرارت دارن اینطوری باشه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.52,
   "end": 135.28,
   "text": "اگر نیست خللی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.28,
   "end": 139.82,
   "text": "معرفت ما ایجاد شده نسبت به این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.82,
   "end": 144.92,
   "text": ". حالا این آقا که تمام آثارشون رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.92,
   "end": 149.08,
   "text": "به امام زمان ما، ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.08,
   "end": 154.32,
   "text": "خودشون در خصوص وقتی یاد از امام زمان ما می‌کنند امام صادق چی میفرمایند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.32,
   "end": 156.78,
   "text": "اون فرمایش معروفشون که لو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.78,
   "end": 160.72,
   "text": "خدمته، لو أدرکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.72,
   "end": 166.9,
   "text": "اگر من درک می‌کردم او را یعنی مهدی فاطمون سلام الله علیه ما رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.9,
   "end": 169.28,
   "text": "سلام الله علیه ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.28,
   "end": 171.68,
   "text": "لخدمته أيام حیاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.68,
   "end": 176.54,
   "text": "اون لامش هم تأکید قطعاً خادمش می‌شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.54,
   "end": 180.22,
   "text": "تو کل ایام زندگیم خادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.22,
   "end": 184.78,
   "text": "درگاه امام زمان من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.78,
   "end": 188.54,
   "text": "این جایگاه حضرت صاحب رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.54,
   "end": 190.38,
   "text": "و چقدر جایگاه ویژه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.38,
   "end": 194.98,
   "text": "اتفاقاً برای اینکه سنجاق کنیم بحث رو به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.98,
   "end": 200.56,
   "text": "شرح کتاب الموت. خیلی جالبه که حالا بحث به اینجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.56,
   "end": 203.06,
   "text": "در روایت سوم باب چهارم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.06,
   "end": 207.76,
   "text": "اونجا فرمود ما أكثر ذکر الموت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.76,
   "end": 211.16,
   "text": "إلا زهد في الدنيا. یه چیزکی عرض کردیم که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.16,
   "end": 213.64,
   "text": "حالا eksar",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.64,
   "end": 216.46,
   "text": "ذکر موت همه اینا رو حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.46,
   "end": 218.42,
   "text": "eksar، ذکر، ذکر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.42,
   "end": 221.34,
   "text": "موت چیه؟ چرا انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.34,
   "end": 228.16,
   "text": "اگر بسیار یاد اونم موت بکنه خروجی‌ش می‌شه زهد در دنیا این روایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.16,
   "end": 230.54,
   "text": "و حالا انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.54,
   "end": 233.86,
   "text": "ما از جهت قرآنی گفتیم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.86,
   "end": 238.96,
   "text": "کمالات باطنی. منظور هر کجا در قرآن از انسان یاد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.96,
   "end": 243.32,
   "text": "منظور به باطن انسان، استعدادها، کمالاتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.32,
   "end": 248.82,
   "text": "اما اصلاً اینکه چرا به انسان گفتن انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.82,
   "end": 252.26,
   "text": ". ااا لغت‌شناس‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.26,
   "end": 254.4,
   "text": "تقریباً متفق‌القولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.4,
   "end": 257.94,
   "text": "حالا دو تا وجه رو بیشتر بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.94,
   "end": 265.42,
   "text": "گفتن یا از انسیانه که انسیانم از نسیانه یعنی از فراموشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.42,
   "end": 268.46,
   "text": "یعنی که عهدش رو فراموش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.46,
   "end": 271.08,
   "text": "حالا اشاره به آیه‌ش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.08,
   "end": 279.5,
   "text": "انسان عهدشو فراموش کرده یا از ریشه أنسک چون انس می‌گیره اینجا با همه چی با پیرامونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.5,
   "end": 285.22,
   "text": "حالا می‌تونه این انس مطلوب باشه، می‌شونه-- می‌تونه مذموم باشه، مثبت باشه، منفی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.22,
   "end": 287.12,
   "text": "انس خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.12,
   "end": 290.12,
   "text": "با حقایق عالم انس بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.12,
   "end": 293.2,
   "text": "انس بد با-- تعلق به دنیا پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.2,
   "end": 294.94,
   "text": "در هر حال این در انسان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.94,
   "end": 298.24,
   "text": "اصلاً نفس از یک جهت میگن نفس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.24,
   "end": 302.3,
   "text": "خو می‌گیره سریع خو می‌کنه به هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.3,
   "end": 306.14,
   "text": "خب اگر اینو برگردونیم این ترجمه رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.14,
   "end": 313.3,
   "text": "حدیث یا به روایت یعنی با این نگاه ببینیمش، اینجا که می‌فرماید انسان اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.3,
   "end": 317.4,
   "text": "بسیار یاد موت کنه زاهد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.4,
   "end": 319.44,
   "text": "می‌تونیم دو تا وجه ازش برداشت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.44,
   "end": 323.9,
   "text": "اگر از ریشه‌ی نسیان و فراموشی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.9,
   "end": 327.06,
   "text": "یعنی این ذکر موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.06,
   "end": 330.44,
   "text": "بسیار ذکر موت او رو انسان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.44,
   "end": 335.98,
   "text": "یعنی چی؟ یه کاری می‌کنه که اون چیزی که فراموش کرده رو یادش بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.98,
   "end": 338.8,
   "text": "می‌تونه اینطوری وجهش این چنین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.8,
   "end": 343.42,
   "text": "اصلاً از این جهت که فراموش کرده عهدشو بهش میگن انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.42,
   "end": 347.48,
   "text": "حالا کسی که زیاد یاد مرگ کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.48,
   "end": 351.42,
   "text": "زاهد می‌شه در دنیا یعنی برمی‌گرده به خط می‌شه یعنی یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.42,
   "end": 356.02,
   "text": "عهدش میفته. این یه معنا. معنای دوم اگه از انس بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.02,
   "end": 361.08,
   "text": "یعنی میاد معنوس می‌شه با حقایق عالم و چه حقیقتی الان بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.08,
   "end": 367.05,
   "text": "حالا اون عرض شود اصول اعتقادی‌مون چه حقیقتی بالاتر از معاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.05,
   "end": 370.41,
   "text": "بعد از توحید و نبوت و ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.41,
   "end": 373.61,
   "text": "چی ب-بالاتر از موت، معاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.61,
   "end": 376.85,
   "text": "ها؟ که همه یقین داریم که میریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.85,
   "end": 383.57,
   "text": "پس این انسش در حقیقت به یک چیز خوبه توجه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.57,
   "end": 387.21,
   "text": "توجه این انسان میفته به موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.21,
   "end": 389.49,
   "text": "یک سفری که قطعیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.49,
   "end": 392.09,
   "text": "اینم به نفعشه. خروجیش میشه ذل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.09,
   "end": 397.35,
   "text": "حالا اینکه چی رو فراموش کرده بحث مبسوط زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.35,
   "end": 404.69,
   "text": "اجازه بدید من چند تا نکته عرض کنم بعد جمع بندیمونو تو همون فرمایش امام صادق صلی الله علیه بیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.69,
   "end": 407.25,
   "text": "خیلی شیرینه این بحث. اولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.25,
   "end": 412.53,
   "text": "خب این سوره یاسین آیه که همه حفظید بحث عهد الهی رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.53,
   "end": 416.49,
   "text": "\"الان عهد الیکم یا بنی ادم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.49,
   "end": 420.47,
   "text": "آیا ما از شما فرزندان آدم عهد نگرفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.47,
   "end": 424.45,
   "text": "چی بوده عهد؟ \"الا تعبدوا الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.45,
   "end": 426.35,
   "text": "عبادت شیطان رو نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.35,
   "end": 428.37,
   "text": "\"انه لکم عدو مبین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.37,
   "end": 431.05,
   "text": "اون دشمن آشکاری برای شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.05,
   "end": 434.51,
   "text": "\"وان اعبدونی هذا صراط مستقیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.51,
   "end": 436.87,
   "text": "آیا من از شما عهد نبستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.87,
   "end": 441.07,
   "text": "این فرعیه ای عهد که اینجا کاملا دیگه تسریح شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.07,
   "end": 446.17,
   "text": "یه عهد دیگه که خیلی مفسرین درباره‌ش حرف زدن آیه صد و پونزده سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.17,
   "end": 449.53,
   "text": "طه هست. برید ببینید تفاسیر ذیلش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.53,
   "end": 451.97,
   "text": "روایات ذیلش خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.97,
   "end": 458.13,
   "text": "من یکی دو تاشو عرض می‌کنم که \"ولقد عهدنا آدم من قبل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.13,
   "end": 461.33,
   "text": "ما از قبل یه عهدی از آدم گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.33,
   "end": 463.99,
   "text": "\"فنسي\". پس چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.99,
   "end": 468.71,
   "text": "فراموش کرد. \"ولم يجد-- ولم نجد له عزما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.71,
   "end": 472.59,
   "text": "ما اون رو دارای عزمی توی این عهدش ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.59,
   "end": 478.13,
   "text": "اصلا میگن پایه اینکه حضرت آدم جزو، جزو انبیا اول العزم نشده همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.13,
   "end": 480.47,
   "text": "اینجا سریعا اینجا میفرمایند \"ولم نجد له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.47,
   "end": 486.73,
   "text": "عزما\". این چی بوده که این فراموشی چی بوده که حضرت آدم فراموش کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.73,
   "end": 490.75,
   "text": "که از این جهت جزو اول العزم‌ها نشده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.75,
   "end": 494.07,
   "text": "اجازه بدید برای س-- فهم این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.07,
   "end": 496.81,
   "text": "روایتی را از تفسیر اهل بیت تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.81,
   "end": 499.73,
   "text": "ذیل همین آیه است. یعنی شما خواستید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.73,
   "end": 505.15,
   "text": "ذیل همین آیه صد و پونزده طه، جلد نه، صفحه دویست و پنجاه و دو تفسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.15,
   "end": 510.21,
   "text": "علیهم السلام که امام باقر صلی الله علیه به شخصی به نام عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.21,
   "end": 517.55,
   "text": "در خصوص این آیه فرمودند که خدا حالا مراتب خلقت رو بیان میکنه و خدا شروع میکنه از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.55,
   "end": 519.75,
   "text": "اِممم، خلائقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.75,
   "end": 524.53,
   "text": "عهد گرفتن. \"الست بربكم قالوا بلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.53,
   "end": 530.39,
   "text": "همه به رب کن، به ربوبیت خودش، به نبوت پیغمبر و به جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.39,
   "end": 534.75,
   "text": "امیر بودن امیر مؤمنان از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.75,
   "end": 537.31,
   "text": "به خصوص انبیاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.31,
   "end": 539.81,
   "text": "اقرار میگیره. حالا اینا چرا نبی شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 539.81,
   "end": 542.43,
   "text": "یه بحث خیلی شیرینی هست، جاش اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.43,
   "end": 548.47,
   "text": "فرصت میخواد. که حالا انبیا زودتر از همه شروع کردن اقرار کردن لذا، لذا نبی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.47,
   "end": 550.85,
   "text": "اینم یه بحثی درش داریم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.85,
   "end": 557.23,
   "text": "در هر حال بعد اومد بعد از اینکه اقرار بر ولایت امیرالمؤمنین گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.23,
   "end": 563.41,
   "text": "اقرار بر ولایت اهلی امام حسن تا امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 563.41,
   "end": 566.51,
   "text": "گرفت و امام عصر ما رو این چنین معرفی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 566.51,
   "end": 568.59,
   "text": "فرمود من به دست ایشون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.59,
   "end": 575.87,
   "text": "دشمنانم انتقام میگیرم و اظهار میکنم اسلام و دینم رو \"لیظهره على الدين كله\" اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 575.87,
   "end": 578.79,
   "text": "حالا اقرار کنید ببینم به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.79,
   "end": 581.83,
   "text": "به، به چی؟ به ولایت این آخری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.83,
   "end": 585.71,
   "text": "یعنی امام عصر من و شما. اینجا میگن یک مکسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.71,
   "end": 589.19,
   "text": "حالا این مکس باید از جهت فلسفی و عرفانی باز بشه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 589.19,
   "end": 591.23,
   "text": "یه مکسی در عالم رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.23,
   "end": 599.49,
   "text": "حضرت آدم علی نبينا و آله و عليه الصلاة والسلام اینجا نه انکار کرد نه اقرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 599.49,
   "end": 602.53,
   "text": "لذا از پایه اول العزم افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 602.53,
   "end": 610.33,
   "text": "فراموش کرد این عهد رو اینجا یعنی \"ولم نجد له عزما\" نسبت به عهدی که با امام عصر من و شما داشته ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 610.33,
   "end": 612.89,
   "text": "اینجا فراموش کرد این عهد رو اقرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 612.89,
   "end": 615.63,
   "text": "نه که قبول نداشته ها. نه انکار نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.63,
   "end": 618.77,
   "text": "عین روایت امام باقر فرمود انکار نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.77,
   "end": 622.91,
   "text": "اما یادش رفت اقرار کنه. این نشون میده چقدر اقرار مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.91,
   "end": 625.05,
   "text": "بیان. قولوا. قل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.05,
   "end": 628.91,
   "text": "قل. بگو. بگو. چند تا آیه قرآن هی میگه قل، قل، قل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 628.91,
   "end": 631.79,
   "text": "بگو. اصلا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.79,
   "end": 635.27,
   "text": "این یه روایت که نشون میده ما فراموش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 635.27,
   "end": 639.81,
   "text": "لذا اصلا این، اِاِاِ، در حقیقت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 639.81,
   "end": 642.25,
   "text": "موعظه ها، این منبرها، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 642.25,
   "end": 644.95,
   "text": "تذکرات \"فان الذکرى تنفع المؤمنین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 644.95,
   "end": 647.75,
   "text": "منفعتش یکیش اینه. ما رو به اقرار میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.75,
   "end": 650.53,
   "text": "به بیان میندازه. به توجه و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.53,
   "end": 653.93,
   "text": "یادآوری اون عهد فراموش شده مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.93,
   "end": 656.25,
   "text": "که برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.25,
   "end": 662.55,
   "text": "اونجا که امام صادق صلی الله علیه فرمود من اگر درک کنم امام آخر رو خادمش میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 662.55,
   "end": 669.99,
   "text": "ببینید حضرت آدم از اول العزم افتاده چون اقرار بر ولایت ایشون، اقرار فقط نکرده قبول داشته اقرار فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 669.99,
   "end": 673.13,
   "text": "یادش رفت ب کنه. انقدر این جایگاه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 673.13,
   "end": 677.17,
   "text": "و یه روایت شیرین دیگه ای هم چاشنی بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 677.17,
   "end": 683.03,
   "text": "در ذیل همین آیه اما صفحه دویست و نود و چهار اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 683.03,
   "end": 687.71,
   "text": "تفسیر روایت. باز همین امام باقر میفرمود به شخصی به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 687.71,
   "end": 691.53,
   "text": "سلام بن مستنیر یا سُلام هم میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 691.53,
   "end": 694.53,
   "text": "که ذیل همین آیه \"ولقد عهدنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.53,
   "end": 696.57,
   "text": "الی آدم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 696.57,
   "end": 702.23,
   "text": "که حضرت فرمودند که وقتی خدای منان اینو خوب دقت کنید کسانی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 702.23,
   "end": 706.99,
   "text": "اِاِاِ، خیلی تو کاراشون ان شاء الله نمیگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 706.99,
   "end": 712.23,
   "text": "خیلی جالبه که خداوند حضرت باقر فرمودند وقتی که خداوند عهد گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 712.23,
   "end": 714.35,
   "text": "که \"لا تقربا هذه الشجرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 714.35,
   "end": 717.91,
   "text": "شجرة. نزدیک این نشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 717.91,
   "end": 721.87,
   "text": "و ازش نخورید. حضرت آدم و حضرت حوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 721.87,
   "end": 724.15,
   "text": "توأمان عرض کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 724.15,
   "end": 730.71,
   "text": "بسیار خب به خدا گفتن چشم بسیار خب ما نه-- نزدیک نمیشویم و نمیخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 730.71,
   "end": 735.45,
   "text": "همین. تمام. ان شاء الله نگفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 735.45,
   "end": 742.77,
   "text": "چون ان شاء الله نگفتن یعنی اینو فراموش کردن که بگن اگر خدا بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 742.77,
   "end": 745.83,
   "text": "لا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 745.83,
   "end": 749.57,
   "text": "این باز به یک وجه به ولایت هم بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 749.57,
   "end": 754.99,
   "text": "چون من رعانی، پیغمبر فرمود هر کس منو ببینه فقط رعی الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 754.99,
   "end": 757.99,
   "text": "الله رو دیده. چون اون مظهر اسم جامع خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 757.99,
   "end": 765.07,
   "text": "همه اسمای درش هست. پس به یک معنا ان شاء الله یعنی اگر حجت خدا بخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 765.07,
   "end": 767.53,
   "text": "که فصل الخطاب لدیک و همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 767.53,
   "end": 769.93,
   "text": "فصل خطاب دست شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 769.93,
   "end": 773.95,
   "text": "شما اراده الربید. خدا اراده می‌کنه شما اراده می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 773.95,
   "end": 778.21,
   "text": "یعنی باز اگر حجت خدا بخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 778.21,
   "end": 781.65,
   "text": "در طول اراده خداست. ببینید ارتباطات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 781.65,
   "end": 784.07,
   "text": "این ان شاء الله انقدر مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 784.07,
   "end": 791.23,
   "text": "که البته بعد اونجا بحث انتهای روایت می‌خوره به اینکه باب معصیت و اطاعت و ولایت اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 791.23,
   "end": 797.73,
   "text": "اثبات شد. چرا؟ وقتی که این اقرار گرفته شد، خدا فرمود از اصحاب شمال برید سمت جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 797.73,
   "end": 801.31,
   "text": "اینا ترسیدن برن. رو کرد به اصحاب یمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 801.31,
   "end": 805.25,
   "text": "انشاالله شماها. فرم-- خدا فرمود برید به سمت آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 805.25,
   "end": 807.87,
   "text": "رفتند. همه شماها رفتید تو آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 807.87,
   "end": 811.95,
   "text": "ان منها واللا واردها. قرآن فرمود هیچکس نیست مگر واردش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 811.95,
   "end": 815.43,
   "text": "اه-اهل ایمان زودتر از اهل آتش رفتن و میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 815.43,
   "end": 817.09,
   "text": "لذا تو این دنیا داریم می‌سوزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 817.09,
   "end": 819.69,
   "text": "آتش، آتش گرفتیم دائما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 819.69,
   "end": 825.27,
   "text": "رفتن تو آتش. اون رو برد و سلام و سلام و برد شد خنک شد براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 825.27,
   "end": 828.39,
   "text": "اصحاب شمال اینو که دیدن گفتن اِ کاش ما هم می‌رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 828.39,
   "end": 831.47,
   "text": "خدایا میشه یه مهلت دیگه بدی ما بریم حالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 831.47,
   "end": 834.45,
   "text": "خدا فرمود بفرمایین اصحاب یمین بیان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 834.45,
   "end": 841.01,
   "text": "شما بفرمایید. اصحاب شمال دوباره اومدن برن تو ترسیدن باز هم نرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 841.01,
   "end": 843.35,
   "text": "این کاره نیستن. نرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 843.35,
   "end": 845.63,
   "text": "اینجا بود که حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 845.63,
   "end": 851.37,
   "text": "اطاعت، باب اطاعت و معصیت و ولایت ثابت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 851.37,
   "end": 856.35,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 856.35,
   "end": 861.21,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 861.21,
   "end": 863.97,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}