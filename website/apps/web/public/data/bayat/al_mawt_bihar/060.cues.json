 },
 "chapters": [
  {
   "index": 0,
   "title": "## بازگشت به کتاب الموت؛ روایت دهم",
   "start": 22.12,
   "end": 78.74
  },
  {
   "index": 1,
   "title": "## طاعون؛ تبری از عاصی و تمحیص مطیع",
   "start": 78.74,
   "end": 276.26
  },
  {
   "index": 2,
   "title": "## مثال خورشید؛ یک فاعل و دو اثر",
   "start": 276.26,
   "end": 449.16
  },
  {
   "index": 3,
   "title": "پرسش این است که قیامت چگونه با خورشید معذب می‌کند حال آنکه خورشید از آنِ دنیاست؟ قرآن می‌فرماید:",
   "start": 449.16,
   "end": 561.5
  },
  {
   "index": 4,
   "title": "## جهنم؛ تجلی جلال شمس نبی",
   "start": 561.5,
   "end": 634.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 4.48,
   "text": "اللهم صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.48,
   "end": 12.32,
   "text": "عجل فرجهم. بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.32,
   "end": 15.62,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.62,
   "end": 21.02,
   "text": "و ربانی آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.02,
   "end": 24.28,
   "text": "اجازه بفرمایید که بحث احراز و ادعیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.28,
   "end": 30.24,
   "text": "دستورالعمل‌ها رو دیگه ادامه ندهیم چون هرچی ما میریم جلو هی سؤالاتی پیش میاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.24,
   "end": 34.54,
   "text": "حقیقتش خیلی دعوی ما نیست این چنین صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.54,
   "end": 38.18,
   "text": "اون‌ها باشه انشاالله موردی به وقتش اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.18,
   "end": 42.7,
   "text": "ما ادامه شرح کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.7,
   "end": 46.18,
   "text": "شریف الموت مرحوم مجلسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.18,
   "end": 49.8,
   "text": "بریم به امید خدا رسیده بودیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.8,
   "end": 52.32,
   "text": "روایت دهم. ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.32,
   "end": 55.1,
   "text": "تشریح روایت دوم تا نهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.1,
   "end": 57.4,
   "text": "خیلی توقف کردیم. بعد بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.4,
   "end": 60.06,
   "text": "اون کشیده شد به بحث ادعیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.06,
   "end": 63.72,
   "text": "اجنه و این‌ها. بعد راه‌های دفعشون رفت به سمت احراز و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.72,
   "end": 69.56,
   "text": "اینقدر طول کشید فکر می‌کنم بیست و یک، دو جلسه این حدودا ما صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.56,
   "end": 75.2,
   "text": "حالا اجازه بدید که روایت دهم رو براتون قرائت کنم ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.2,
   "end": 82.28,
   "text": "پرنکته‌ست. مرحوم مجلسی این روایت رو از دعوات مرحوم راوندی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.28,
   "end": 89.44,
   "text": "سئل زین العابدین علیه السلام سؤال شد از امام سجاد علیه السلام عن الطاعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.44,
   "end": 95.58,
   "text": "از مریضی به نام طاعون حضر-- از حضرت سؤال شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.58,
   "end": 102.78,
   "text": "که سؤال کردن که عن برأ من می الحق هو فإنه معذب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.78,
   "end": 105.36,
   "text": "آیا ما دوری بجوییم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.36,
   "end": 111.48,
   "text": "بیزاری بجوییم از کسی که گرفتار طاعون شده و معذب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.48,
   "end": 113.9,
   "text": "یعنی طاعون زده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.9,
   "end": 118.72,
   "text": "فقال علیه السلام حضرت فرمود إن کان عاصیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.72,
   "end": 121.0,
   "text": "فبرأ منه. اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.0,
   "end": 125.26,
   "text": "عاصیه، اگه طرف گناهکاره ازش تبری بجوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.26,
   "end": 131.32,
   "text": "حالا طوعاً أو لم یطع بخواد طاعون بهش زده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.32,
   "end": 133.16,
   "text": "یا نزده باشه اصلاً ربطی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.16,
   "end": 136.3,
   "text": "حالا چون عذابی ظاهراً عذابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.3,
   "end": 138.72,
   "text": "ظاهراً مریضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.72,
   "end": 140.6,
   "text": "امیکرون کروناست، چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.6,
   "end": 143.5,
   "text": "زلزله‌ست، سیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.5,
   "end": 145.64,
   "text": "اینا بهش زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.64,
   "end": 147.52,
   "text": "شما برگردی بگی خب خدا زدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.52,
   "end": 153.32,
   "text": "این یه متأسفانه در عرف اجتماع ما خیلی بد جا افتاده که یه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.32,
   "end": 158.74,
   "text": "یه اتفاق بدی ظاهراً ناگواری براش میفته همه میگن خدا زدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.74,
   "end": 161.06,
   "text": "در صورتی که ما قبلاً بحث کردیم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.06,
   "end": 165.98,
   "text": "بس-بسیار نگاه غلطی‌ست و اصلاً دینی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.98,
   "end": 169.7,
   "text": "این، این نوع نگاه داشتن و باید اصلاح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.7,
   "end": 171.94,
   "text": "حضرت فرمود اگر گناهکاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.94,
   "end": 175.8,
   "text": "ازش تبری بجوی. چه کار داری که طاعون زده‌ست یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.8,
   "end": 178.34,
   "text": "أو الله عز وجل مطیعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.34,
   "end": 182.22,
   "text": "حالا اگر اطاعت کننده حضرت حق بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.22,
   "end": 185.42,
   "text": "اینجا فرمودند که فإن الطاعنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.42,
   "end": 188.78,
   "text": "مما تمه– تمحص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.78,
   "end": 192.44,
   "text": "یا تمحص به ذنوبه، تمحص درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.44,
   "end": 199.16,
   "text": "تمحص به ذنوبه. اگر تازه آدم خوبی بود، مؤمن بود و گرفتار شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.16,
   "end": 202.52,
   "text": "مثلاً طاعون بهش زده بود یا هر گرفتاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.52,
   "end": 207.1,
   "text": "بدون که این اصل تمحیص درباره‌ش پیاده میشه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.1,
   "end": 209.32,
   "text": "که گناه هاش بخشیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.32,
   "end": 211.88,
   "text": "یعنی این هم یه لطف خدا به اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.88,
   "end": 214.18,
   "text": "که إن الله عز وجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.18,
   "end": 217.46,
   "text": "أولب بهی قوما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.46,
   "end": 219.9,
   "text": "خدای منان با این بلاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.9,
   "end": 222.88,
   "text": "با این گرفتاری‌ها حالا یه نمونه‌ش طاعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.88,
   "end": 231.66,
   "text": "عده‌ای رو، قومی رو معذب میکنه و یرحم بهی آخرین عده‌ای رو هم بهشون رحم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.66,
   "end": 235.4,
   "text": "اون ربط به خدا داره. من و شما نمی‌تونیم تشخیص بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.4,
   "end": 237.54,
   "text": "خدا داره میگه با همین مریضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.54,
   "end": 242.24,
   "text": "خدای عده رو تعقیب میکنه، عقاب میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.24,
   "end": 247.98,
   "text": "یه عده رو رحمت میکنه، مغفرتشو براشون نازل میکنه، تمحیص ذنوبشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.98,
   "end": 255.86,
   "text": "اصلاً شما در اون حدی نیستید که تشخیص بدید این کسی که عذاب بهش وارد شده، این کسی که بدجوری مرده حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.86,
   "end": 257.84,
   "text": "از کتاب الموت اینطوری بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.84,
   "end": 263.52,
   "text": "اون کسی که بدجوری مرده یا ظاهراً خیلی خوب راحت جون داده اصلاً من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.52,
   "end": 268.58,
   "text": "نمی‌تونیم تشخیص بدیم. این حرفا رو واگذار کنیم به خدا و اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.58,
   "end": 274.56,
   "text": "بعد فرمودند که بله واسعت قدرته لم یشأ خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.56,
   "end": 278.98,
   "text": "خداییست که قدرتش برای هر کسی بخواد وسعت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.98,
   "end": 282.58,
   "text": "هرچی هست دست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.58,
   "end": 288.38,
   "text": "ما ترعون بعد برای اینکه حضرت بخواد اثبات کنه این صحبتشو برای این شخص دلیل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.38,
   "end": 291.2,
   "text": "چه دلیلی میاره؟ خیلی دلیل همه فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.2,
   "end": 297.16,
   "text": "آیا ندیدی ما ترعون انه جعل الشمس ضياء للعباده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.16,
   "end": 301.68,
   "text": "آیا ندیدی که خدا این شمس و خورشید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.68,
   "end": 305.86,
   "text": "نور قرار داده برای اهلش، برای بندگانش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.86,
   "end": 309.56,
   "text": "و منوجا لفمارهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.56,
   "end": 311.56,
   "text": "و باعث رسیدگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.56,
   "end": 315.3,
   "text": "ثمارهم ثمرات. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.3,
   "end": 318.46,
   "text": "منوجا یعنی اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.46,
   "end": 321.0,
   "text": "از کجاست؟ پختگی، رسیدگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.0,
   "end": 323.68,
   "text": "میگه همون خورشیدو سبب پختگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.68,
   "end": 326.14,
   "text": "ثمرات و میوه‌هاشون قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.14,
   "end": 328.68,
   "text": "برای کیا؟ برای بندگانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.68,
   "end": 333.46,
   "text": "اما و و مبلغ الاقواتهم جمع اقوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.46,
   "end": 338.0,
   "text": "و محل رسیدگی به روزی‌هاشون قرار میده که اگر این خورشید نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.0,
   "end": 342.4,
   "text": "روزی‌ها قطع میشد. همه بیچاره میشدن اصلاً زندگی مختل میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.4,
   "end": 347.6,
   "text": "و قد يعذب بها این های ضمیر برمی‌گرده به الشمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.6,
   "end": 353.84,
   "text": "و به تحقیق خدا معذب میکنه عده‌ای رو بها با خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.84,
   "end": 356.74,
   "text": "یعنی با همون یک وجود واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.74,
   "end": 360.04,
   "text": "عده‌ای رو بهشون کمک میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.04,
   "end": 363.88,
   "text": "به میوه‌هاشون میرسه، روزیشونو میگیرن، نور و رحمته براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.88,
   "end": 367.28,
   "text": "برای عده‌ای هم عذابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.28,
   "end": 371.18,
   "text": "بها قوما يبتليهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.18,
   "end": 376.56,
   "text": "بحر عجب به اون آتیش سوزاننده خورشید اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.56,
   "end": 383.36,
   "text": "مبتلا می‌کنه خدا. حالا حضرت می‌فرماید يوم القيامة بذنوبهم و في الدنيا بسوء اعمالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.36,
   "end": 386.94,
   "text": "هم بحث خورشید رو حضرت می‌زنه به دنیا هم قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.94,
   "end": 391.7,
   "text": "که هرچی هست به خاطر گناهاشونه بسوء اعمالشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.7,
   "end": 399.32,
   "text": "یعنی در دنیا هم خورشید می‌تونه عده‌ای رو بیچاره کنه، قحطی بیاره، داغی خورشید، حرارت و قحطی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.32,
   "end": 401.7,
   "text": "خشکی و بی‌آبی و اینا بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.7,
   "end": 407.44,
   "text": "که باز عرض می‌کنیم هر قحطی و بی‌آبی دلالت بر گناه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.44,
   "end": 411.44,
   "text": "اینا عوامل طبیعیه که همش هم ابتلاءاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.44,
   "end": 414.22,
   "text": "و هم اینکه قیامت خورشید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.22,
   "end": 418.14,
   "text": "چیکار می‌کنه؟ سبب معذب شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.14,
   "end": 420.88,
   "text": "آدم‌های بد و کفار و مشرکین و نافرمانی قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.88,
   "end": 425.56,
   "text": "حالا اینجا سؤال پیش میاد. خب مگه ما قیامت خورشید داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.56,
   "end": 430.32,
   "text": "خورشید مال این دنیاست. اونجا چگونه خورشید معذب می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.32,
   "end": 435.02,
   "text": "در حالا مطالب اینجا باید بگیم مقدار فلسفی خشک به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.02,
   "end": 438.6,
   "text": "فقط یه نکته عرض کنم که حالا شاید ما دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.6,
   "end": 442.4,
   "text": "شما رو ندیدیم یا شما ما رو ندیدید حداقل این رو هم عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.4,
   "end": 447.44,
   "text": "قرآن می‌فرماید و الشمس يبها و القمر اذا تلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.44,
   "end": 452.5,
   "text": "زی-- اون ظهور و شدت نور رو می‌زنه به شمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.5,
   "end": 457.26,
   "text": "بعد می‌فرماید القمر اذا تلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.26,
   "end": 460.64,
   "text": "قمر که ماهه دنبال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.64,
   "end": 464.38,
   "text": "خورشیده. یعنی ماه نورش از خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.38,
   "end": 466.04,
   "text": "هرچه نور هست تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.04,
   "end": 469.76,
   "text": "هرچه درخشندگی است در خورشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.76,
   "end": 472.68,
   "text": "خورشید کیه؟ طبق تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.68,
   "end": 476.48,
   "text": "تفاسیر امامیه این و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.48,
   "end": 481.46,
   "text": "فریقین یعنی اهل تسنن هم دارن که این شمس وجود مقدس پیامبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.46,
   "end": 485.44,
   "text": "اون صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.44,
   "end": 488.0,
   "text": "اون خ-- اون ماه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.0,
   "end": 492.54,
   "text": "فرمودن ائمه و جانشینان و خلفای بعد از او هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.54,
   "end": 495.38,
   "text": "که پیرو او هستن. تبعیت از او می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.38,
   "end": 502.42,
   "text": "پس اینجا که امام سجاد علیه السلام داره می‌فرماید این خورشید قیامت معذب می‌کنه بدها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.42,
   "end": 504.94,
   "text": "می‌تونه به یک معنا پیغمبر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.94,
   "end": 511.2,
   "text": "اونجا که در آیه پنج سوره یونس می‌فرماید هو الذي جعل الشمس ضياءا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.2,
   "end": 513.34,
   "text": "اون شدت نور مال خورشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.34,
   "end": 516.18,
   "text": "نمیشه، میشه دیدش به نظر شما خورشیدو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.18,
   "end": 519.18,
   "text": "همینجوری نگاه کنی کور میشی. اصلا دیدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.18,
   "end": 520.98,
   "text": "اما القمر نورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.98,
   "end": 523.44,
   "text": "تو همون آیه پنج سوره یونس می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.44,
   "end": 526.38,
   "text": "نور مال چیه؟ مال ماهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.38,
   "end": 530.36,
   "text": "القمر نورا. قمر نور داره که بتونی ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.36,
   "end": 534.48,
   "text": "یعنی شما ماه رو می‌تونی ببینی و به وسیله‌ی ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.48,
   "end": 538.82,
   "text": "می‌فهمی که خورشید چه نوری داره که ماه رو اینچنین روشن کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.82,
   "end": 541.86,
   "text": "یعنی طریق رسیدن به شمس میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 541.86,
   "end": 548.94,
   "text": "ماه. که تمام مفسرین باز اینجا فرمودن امام و ائمه علیهم الصلاة والسلام اینجا حکم قمر رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.94,
   "end": 551.08,
   "text": "اونا اومدن که بشه پیغمبر رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.08,
   "end": 553.66,
   "text": "اونا اومدن که بشه خدا رو دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.66,
   "end": 556.7,
   "text": "و الا نمیشد دید. شدت انقدر زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.7,
   "end": 559.58,
   "text": "تلألؤ نور انقدر تجلیش اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.58,
   "end": 564.16,
   "text": "حالا پس حرف اینجاست که اگر شمس پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.16,
   "end": 568.32,
   "text": "قیامت یعنی چیه عده معذب میشن از گرمای شمس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.32,
   "end": 570.76,
   "text": "یعنی از گرمای پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.76,
   "end": 574.84,
   "text": "یعنی بحث اینکه همون بحثی که قبلاً داشتیم آقا جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.84,
   "end": 579.72,
   "text": "تو یه جمله عرض کنیم جهنم که همه در اون معذب‌اند تجلی چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.72,
   "end": 581.66,
   "text": "یادتونه؟ تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.66,
   "end": 583.58,
   "text": "جلال پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.58,
   "end": 586.44,
   "text": "تجلی جلال سید الشهدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.44,
   "end": 589.12,
   "text": "تجلی جلال امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.12,
   "end": 592.16,
   "text": "تجلی جلال حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.16,
   "end": 594.84,
   "text": "بهشت هم تجلی چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.84,
   "end": 597.16,
   "text": "احسنت. جمال حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.16,
   "end": 606.5,
   "text": "پس اگر می‌فرمود خورشید اینا رو معذب می‌کنه به خاطر گناهانشون در قیامت یعنی میرن در تجلیات جلالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.5,
   "end": 609.42,
   "text": "پیغمبر که خورشید شمسه قرار می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 609.42,
   "end": 612.52,
   "text": "یعنی جهنم. انقدر زیبا و قشنگ امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 612.52,
   "end": 622.74,
   "text": "سجاد با مثالی یه طوری مثال زده که هم آدمای عامی بفهمند هم فلاسفه و عرفا و حکاممون بتونن قشنگ مطلب رو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.74,
   "end": 624.76,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.76,
   "end": 627.92,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.92,
   "end": 631.1,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.1,
   "end": 634.9,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}