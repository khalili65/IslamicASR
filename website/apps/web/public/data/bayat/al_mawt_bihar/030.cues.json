 "chapters": [
  {
   "index": 0,
   "title": "## بیماری و موت و فقر برای خشیت",
   "start": 8.9,
   "end": 195.9
  },
  {
   "index": 1,
   "title": "علت را آیهٔ چهل و دوم سورهٔ مائده می‌گوید:",
   "start": 195.9,
   "end": 358.18
  },
  {
   "index": 2,
   "title": "## امپراتوری دروغ و رشوه",
   "start": 358.18,
   "end": 401.3
  },
  {
   "index": 3,
   "title": "## دروغ رسانه و عمامه‌پرانی",
   "start": 401.3,
   "end": 880.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 4.26,
   "text": "[سخنگوی 1] ...استعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.26,
   "end": 6.08,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.08,
   "end": 8.72,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.72,
   "end": 11.98,
   "text": "یه سؤال جدی که پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.98,
   "end": 14.54,
   "text": "در طول بحثمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.54,
   "end": 19.48,
   "text": "بحث موت که بر اساس روایت پنجم از باب اول کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.48,
   "end": 22.44,
   "text": "عرض کردیم که خدا اصلاً این سه تا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.44,
   "end": 26.22,
   "text": "مرض، مریضی، موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.22,
   "end": 29.54,
   "text": "فقر رو گذاشته برای اینکه انسان رو به خشیت بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.54,
   "end": 31.34,
   "text": "انسان نرم بشه، دلش نرم شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 31.34,
   "end": 34.88,
   "text": "چگونه است که بعضیا علیرغم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 34.88,
   "end": 38.74,
   "text": "وجود این سه چیز باز هم خاشع نمی‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 38.74,
   "end": 44.08,
   "text": "حالا یا خودشون مریض می‌شن یا عزیزاشون یا خودشون فقیر می‌شن یا دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 44.08,
   "end": 48.12,
   "text": "یا اینکه یک ازش، از-- بپرسی آقا بالاخره شما می‌میری یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 48.12,
   "end": 49.96,
   "text": "میگه بله قطعاً من می‌میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 49.96,
   "end": 55.48,
   "text": "حالا اون موت اجباری که رخ داد که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.48,
   "end": 60.82,
   "text": "سرنگون می‌شن و بینیشون به خاک مالیده می‌شه و خاشع می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.82,
   "end": 63.68,
   "text": "اما بالاخره قبلش می‌بینه همه قر-- می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.68,
   "end": 65.36,
   "text": "چرا این خاشع نمی‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 65.36,
   "end": 69.92,
   "text": "این چرا رو اجازه بدید با یک آیه از آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 69.92,
   "end": 76.04,
   "text": "جواب بدیم که چرا عده‌ای با اینکه این حقایق براشون پیش میاد تا خاشع بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.04,
   "end": 80.92,
   "text": "باز نمی‌شن. علتش رو باید در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.92,
   "end": 83.86,
   "text": "چهل و دو سوره مائده دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.86,
   "end": 87.34,
   "text": "اینجا خدا می‌فرماید \"سماعون للكذب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.34,
   "end": 90.34,
   "text": "پرده‌برداری می‌کنه از اولین نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.34,
   "end": 93.84,
   "text": "که این‌ها همش گوششون به دروغ‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.84,
   "end": 98.96,
   "text": "امپراتی-- اِمپراتوری دروغ امروز خیلی در رسانه‌ها مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.96,
   "end": 103.6,
   "text": "قوی داره کار می‌کنه. دومیش \"أكالون للصحت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.6,
   "end": 110.42,
   "text": "اینا أكال بر وزن فعال یعنی خیلی مال حرام می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.42,
   "end": 115.56,
   "text": "حالا البته اگر سَحْت بگیریم یعنی از بین، از بین بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.56,
   "end": 120.92,
   "text": "اگر صُحْت بگیریم یعنی مستأصل شدن وقتی چیزی از بین می‌می-- میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.92,
   "end": 124.04,
   "text": "در هر حال اشاره به، آره به مال حرام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.04,
   "end": 129.48,
   "text": "بعد در این آیه به پیغمبر داره خدا خطاب می‌کنه که \"فإن جاؤك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.48,
   "end": 135.2,
   "text": "اینایی که اینطورین اگر اومدن پیش تو \"فَحْكَم بينهم أو أعرض عنهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.2,
   "end": 139.62,
   "text": "اگرچه-- اینکه می‌فرماید یا بینشون حکم کن یا پشت کن به اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.62,
   "end": 143.34,
   "text": "پیداست که حرف حق تو گوش اینا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.34,
   "end": 148.52,
   "text": "اما \"وإن تولى عنهم فلا يضرّك شيء\" اگرم به اینا پشت کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.52,
   "end": 151.04,
   "text": "بدون که نمی‌تونن به تو ضرری برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.04,
   "end": 158.02,
   "text": "قابل توجه اونایی که ابا می‌کنند از امر به معروف و نهی از منکر و حرف حق زدن از ترس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.02,
   "end": 160.18,
   "text": "از ترس اینکه مثلاً لطمه‌ای بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.18,
   "end": 165.12,
   "text": "\"وإن حكمت فَاحْكَم بينهم بالقسط إن الله يحب المقسطين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.12,
   "end": 167.78,
   "text": "البته اگر حکم کردی به قسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.78,
   "end": 172.32,
   "text": "به عدالت حکم کن. اینو در شأن نزولش فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.32,
   "end": 180.24,
   "text": "عده‌ای از یهودیا بودن اومدن به جهت اینکه زنای محصنه کرده بودن و در دین یهود جزش سنگساره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.24,
   "end": 183.98,
   "text": "اومدن پیش پیغمبر که مثلاً فرار کنن از این سنگساری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.98,
   "end": 187.7,
   "text": "که غافل بودن که نه در اسلام هم اتفاقاً حکمش سنگساره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.7,
   "end": 193.3,
   "text": "بعد حکم پیغمبر رو که شنیدن دو تا مشت بزنن تو کلشون و رفتن، گوش ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.3,
   "end": 197.52,
   "text": "مال اونجاست. اما به صراحت داره میگه چرا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.52,
   "end": 199.54,
   "text": "حرف گوش نمی‌دن؟ رسول خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.54,
   "end": 201.54,
   "text": "می‌خوای بدونی؟ به دو دلیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.54,
   "end": 204.82,
   "text": "یکی اینکه اینا انقدر حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.82,
   "end": 207.66,
   "text": "لق و بیهوده، دروغ، دروغ شنیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.66,
   "end": 209.82,
   "text": "گوششون به راست بده کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.82,
   "end": 215.58,
   "text": "دو، مال حرام. جالبه که بدونید هر دوی این رو، هر دوی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.58,
   "end": 222.42,
   "text": "نکته رو هم حضرت صدیقه طاهره سلام الله علیها خطاب به مردم مدینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.42,
   "end": 228.48,
   "text": "و هم ابا عبدالله در کربلا و هم حضرت زینب کبری سلام الله علیها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.48,
   "end": 231.46,
   "text": "کوفه و شام در خطبه‌هاش اشاره دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.46,
   "end": 235.66,
   "text": "مثلاً پشت در وقتی جالبه که بدونید وقتی اون نانجیب اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.66,
   "end": 238.66,
   "text": "با یه عده‌ای جسارت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.66,
   "end": 241.0,
   "text": "حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.0,
   "end": 244.54,
   "text": "فرموده همین. فرمودن \"سماعون للكذب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.54,
   "end": 250.16,
   "text": "انقدر شما دروغ شنیدید، دروغ شنیدید حرف راست قبول نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.16,
   "end": 253.82,
   "text": "و ابا عبد الله هم که در کربلا اون \"ملئت بطونهم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.82,
   "end": 259.12,
   "text": "بطونكم من الحرام\" که فرمودن همین اشاره به \"أكالون للصحت\" داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.12,
   "end": 265.86,
   "text": "این دو تا الان شما همین الان دقت کنید آیا این همین دو تا در کف اجتماع ما نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.86,
   "end": 268.52,
   "text": "علت اینکه خیلیا می‌بینید البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.52,
   "end": 271.62,
   "text": "خیلیا از اون عده قلیل میگم خیلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.62,
   "end": 274.22,
   "text": "از اون عده قلیلی که میان چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.22,
   "end": 278.98,
   "text": "حالا چرا با بعضیاشون که صحبت می‌کنی می‌بینی واقعاً متنبّه می‌شن اما چرا خیلیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.98,
   "end": 282.82,
   "text": "حرف تو گوششون نمیره؟ چرا حرف تو گوششون نمیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.82,
   "end": 286.16,
   "text": "وقتی شما بررسی می‌کنی می‌بینی علت عمده‌ش این دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.16,
   "end": 290.62,
   "text": "واقعاً این چنینه. الان امپراتوری دروغ داره چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.62,
   "end": 296.88,
   "text": "من بررسی کردم کمترین عددی که خود، خودشون دادن سی و شش هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.88,
   "end": 299.44,
   "text": "کمترین عدده، مال چند روز پیش هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.44,
   "end": 302.68,
   "text": "بیشتر از این هم خیلی گفتن. ده‌ها هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.68,
   "end": 306.44,
   "text": "دروغ رسانه‌ای کشف شده و گفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.44,
   "end": 309.86,
   "text": "مثلاً همین کسی که اومد بسیجیا رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.86,
   "end": 315.14,
   "text": "اون حالا چیز مواد مشتعلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.14,
   "end": 317.64,
   "text": "بندازه اون بچه‌ها، بچه‌های بسیجی آتیش بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.64,
   "end": 321.44,
   "text": "فیلمش هست. می‌زنه می‌خوره به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.44,
   "end": 324.88,
   "text": "ستون ماشین خودش برمی‌گرده به خودش آتیش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.88,
   "end": 330.44,
   "text": "خودش تو ماشین. بسیجیا لباسشونو در میارن، نه از ماشین در میارن لباسشونو میندازن رو این که اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.44,
   "end": 333.32,
   "text": "چیکارش کنن؟ آتیششو خاموش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.32,
   "end": 339.48,
   "text": "بعد توی خبرگزاری‌ها این فیلم رفت گفتن آره ببینید که یه نفر، یکی گفته بود که یکی رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.48,
   "end": 344.6,
   "text": "خودش رو جلوی بسیجیا آتیش زده به نشانه اعتراض به مثلاً این قضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.6,
   "end": 348.5,
   "text": "یکی دیگه که بدتر نوشته من خودم این فیلمو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.5,
   "end": 352.82,
   "text": "حالا یادم نیست کدوم یکی از خبرگزاری‌ها بود که پخش کرده بود که آره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.82,
   "end": 355.56,
   "text": "بسیجیا یه نفرو آتیش زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.56,
   "end": 357.54,
   "text": "به جهت اینکه مثلاً اعتراض کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.54,
   "end": 359.78,
   "text": "ببینید امپراتوری دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.78,
   "end": 362.6,
   "text": "چه می‌کنه. این تا دلت بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.6,
   "end": 368.32,
   "text": "الی ماشاءالله این قصه هست و ما نیاز به یک بازنگری اساسی تو این قص-قصه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.32,
   "end": 373.42,
   "text": "که دروغ پردازی‌ها حداقل به سمع مبارک مردممون درست برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.42,
   "end": 377.22,
   "text": "و آکالون السحت هم که در ارتباط با این‌ها باز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.22,
   "end": 380.96,
   "text": "خودشون دارن اقرار می‌کنن مثلاً یکی که تا پنجاه میلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.96,
   "end": 385.8,
   "text": "عجیبه اقرار کرده که بریم فرنگیا رو آتیش بزنیم پنجاه میلیون به ما می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.8,
   "end": 392.62,
   "text": "یکی دیگه حداقلش رو دیگه شنیدید گفت من با هر سطل آشغالی که آتیش می‌زدم پنج میلیون می‌گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.62,
   "end": 396.7,
   "text": "خب اینا چیه اینا؟ خب یک معنای آکالون السحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.7,
   "end": 400.5,
   "text": "اصلاً همین رشوه گرفتنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.5,
   "end": 403.3,
   "text": "پول گرفتنه در عوض انجام یه کاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.3,
   "end": 406.3,
   "text": "تا دلت بخواد اینو انجام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.3,
   "end": 408.94,
   "text": "که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.94,
   "end": 411.78,
   "text": "پایه‌های قرآنی‌شو شما می‌بینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.78,
   "end": 415.1,
   "text": "می‌بینید که خب دیگه قرآن از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.1,
   "end": 421.52,
   "text": "گوشزدش رو کرده که متأسفانه رعایت نکردن این دو تا قصه کار رو به اینجا رسونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.52,
   "end": 425.36,
   "text": "اما باز با تمام این حرفا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.36,
   "end": 428.22,
   "text": "نیاز داریم که گفت‌وگو کنیم، حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.22,
   "end": 436.2,
   "text": "یعنی من دیدم خودم چون وسط میدان صحبت کردم، گفت‌وگو کردم، کتک زدم، کتک خوردم، حرف زدم، حرف شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.2,
   "end": 439.96,
   "text": "دیدم که اولاً این دیگه تجربه میدانی خودمه دوستام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.96,
   "end": 442.9,
   "text": "اکثرشون حرف تو گوششون نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.9,
   "end": 446.08,
   "text": "اما عده‌ی قلیل‌شون هستن که واقعاً حرف تو گوششونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.08,
   "end": 448.2,
   "text": "حرف می‌زنی باهاشون می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.2,
   "end": 451.88,
   "text": "نه پذیرفت. تو همین جا، تو همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.88,
   "end": 454.38,
   "text": "یه به ما یه عزیزی رو گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.38,
   "end": 457.1,
   "text": "حالا به یه، به گونه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.1,
   "end": 459.48,
   "text": "ازش صوتش ضبط شده بود و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.48,
   "end": 464.42,
   "text": "که حرفای خیلی زشت به رهبر، به مراجع، به علما حتی به اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 464.42,
   "end": 470.7,
   "text": "به ما گفتن حاجی ما چیکار کنیم؟ گفتم بیاریدش بدون اینکه خودش بفهمه معرفی‌ش کنید یه جوری با من رو در روش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.7,
   "end": 476.0,
   "text": "باور کنید با همین آقایی که ن- بدجوری ناسزا گفته بود به رهبر و به نظام و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.0,
   "end": 479.06,
   "text": "علما و اینا چند جلسه من صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.06,
   "end": 481.6,
   "text": "تو همین جا، همین جا نشستیم یه گوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.6,
   "end": 488.88,
   "text": "چند جلسه صحبت کردم. باورتون میشه الان ایشون به خط شده، کتاب‌های علامه حسن‌زاده در معرفت نفس رو داره می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.88,
   "end": 491.44,
   "text": "بعضی موقع‌ها میاد می‌شینه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.44,
   "end": 497.04,
   "text": "و حرف گوش میده. یعنی واقعاً اشتباه به سمعش رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.04,
   "end": 498.96,
   "text": "میشه این‌ها و ما باید انجام بدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.96,
   "end": 501.18,
   "text": "باید بالاخره اگر امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.18,
   "end": 503.52,
   "text": "جهاد نظامی رو گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.52,
   "end": 506.46,
   "text": "رهبرمون چند تا جهاد رو برای ما بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.46,
   "end": 510.34,
   "text": "جهاد سازندگی، جهاد اقتصادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.34,
   "end": 513.08,
   "text": "ها؟ جهاد نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.08,
   "end": 515.8,
   "text": "جهاد این آخری دیگه جهاد تبیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.8,
   "end": 518.58,
   "text": "دیگه برهنه‌تر از این آقا حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.58,
   "end": 524.26,
   "text": "تبیین، بیان کردن، تبیین کنی، حقایق رو بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.26,
   "end": 527.82,
   "text": "حداقل از بچه‌های خودمون تو خونه شروع کنیم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.82,
   "end": 530.78,
   "text": "به در نرفتن از دستمون تبیین کنیم براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.78,
   "end": 533.22,
   "text": "اون‌ها هم تحت تاثیر قرار می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.22,
   "end": 536.04,
   "text": "و یه آیه براتون بخونم این آیه نهی به هممون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 536.04,
   "end": 543.24,
   "text": "من خودم امروز این آیه رو که می‌نوشتم تو خلوت دل خودم گفتم برم خونه یه کلاس بذارم برای دختر و پسرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.24,
   "end": 545.24,
   "text": "تو خونه اینو براشون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.24,
   "end": 548.28,
   "text": "منتها زودتر از اون‌ها شما به دام ما افتادید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.28,
   "end": 551.58,
   "text": "که براتون بگم که این روایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.58,
   "end": 555.68,
   "text": "کافی مرحوم کلینی علیه الله مقامه شریف جلد پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.68,
   "end": 558.02,
   "text": "کتاب الجهاد می‌تونید اونجا ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.02,
   "end": 564.84,
   "text": "امام صادق به نقل از پیغمبر می‌فرماید این واقعیت الان کف خیابون‌های ایرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 564.84,
   "end": 571.16,
   "text": "پیغمبر اون موقع فرموده كيف بكم إذا فسدت نساؤكم وفسق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.16,
   "end": 574.76,
   "text": "شبابكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.76,
   "end": 581.62,
   "text": "شما حالتون چگونه است وقتی که زن‌هاتون فاسد می‌شن و جوون‌هاتون فاسق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.62,
   "end": 586.28,
   "text": "ولم تأمروا بالمعروف ولم تنهوا عن المنکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.28,
   "end": 589.7,
   "text": "در حالی که نه امر به معروف می‌کنید، نه نهی از منکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.7,
   "end": 592.88,
   "text": "ول کردید زن‌ها رو، جوون‌ها رو کاری به کارشون ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.88,
   "end": 595.5,
   "text": "می‌گه بذار هر کاری می‌خوان بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 595.5,
   "end": 597.56,
   "text": "و جالبه که قابل-- اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.56,
   "end": 599.98,
   "text": "تعجب می‌کنند اونایی که نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.98,
   "end": 607.92,
   "text": "شاهد مسئله اینجاست. قيل له یکی گفت به پیغمبر که و یکون ذلک یعنی واقعاً اینطوری میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.92,
   "end": 611.96,
   "text": "یا رسول الله؟ پیغمبر فرمود فقاله نعم بله اینطوری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.96,
   "end": 614.54,
   "text": "بل که و شر من ذلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.54,
   "end": 616.42,
   "text": "و بدتر از اینم می‌شه. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.42,
   "end": 622.4,
   "text": "كيف بكم إذا أمرتم بالمنكر و نهيتم عن المعروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.4,
   "end": 625.1,
   "text": "شما حالتون چگونه است اون روزی که بالعکس می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.1,
   "end": 629.04,
   "text": "امرتون می‌کنند به منکر و نهیتون می‌کنند از معروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.04,
   "end": 630.98,
   "text": "فقيل له يا رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 630.98,
   "end": 635.86,
   "text": "و یکون ذلک یا رسول الله واقعاً اینطوری می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.86,
   "end": 638.26,
   "text": "قال نعم بله خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.26,
   "end": 641.72,
   "text": "می‌شه و شر من ذلک بلکه بدتر از اینم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.72,
   "end": 648.34,
   "text": "بدتر از این چیه دیگه؟ فرمود كيف بكم إذا رأيتم المعروف منكرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 648.34,
   "end": 650.62,
   "text": "شما حالتون چگونه است اون روزی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 650.62,
   "end": 653.68,
   "text": "جامعه در ملأ عام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.68,
   "end": 659.44,
   "text": "منک-- رأيتم المعروف منكرا معروف رو منکر می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 659.44,
   "end": 666.0,
   "text": "می‌بینید. و المنكر معروفا چون می‌گه إذا رأيتم می‌بینید یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.0,
   "end": 670.26,
   "text": "این به قولی به معنای استهاله دیگه رخ داده تو جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.26,
   "end": 674.18,
   "text": "استهاله منفی. یعنی یکی کار خوب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 674.18,
   "end": 677.12,
   "text": "تو چشم مردم منکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.12,
   "end": 681.84,
   "text": "الان اینطوری نیست به نظرتون؟ یعنی خیلی جاها این اتفاق افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.84,
   "end": 687.72,
   "text": "و این در پس چیه؟ اون قرآن رو، اون آیه‌ای که عرض کردیم و زیر مبنای همین بحث قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.72,
   "end": 690.3,
   "text": "الان واقعاً این در جامعه ما اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.3,
   "end": 692.76,
   "text": "وظیفه ما چیه؟ خسته‌تون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 692.76,
   "end": 696.9,
   "text": "وظیفه ما الان به شدت جهاد تبیینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 696.9,
   "end": 699.28,
   "text": "تا می‌تونیم گروه درست کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.28,
   "end": 705.66,
   "text": "تو مسجدمون، تو بسیجمون، تو پایگاهمون، تو هیئتمون، تو محلمون، تو فامیل‌هامون چند نفر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 705.66,
   "end": 709.02,
   "text": "خواهرها دو نفر، سه نفر، پنج نفر تکی‌اً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 709.02,
   "end": 711.06,
   "text": "آقایون هم همچ-همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 711.06,
   "end": 713.3,
   "text": "چطور الان کلیپ پخش می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 713.3,
   "end": 716.0,
   "text": "زنه اقرار می‌کنه که پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.0,
   "end": 719.7,
   "text": "جوون مرده اومده ز-زنه حدود مثلاً پنجاه ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 719.7,
   "end": 722.08,
   "text": "یه جوون اومده جلوشو گرفته خانم شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 722.08,
   "end": 726.38,
   "text": "این چادر رو سرت می‌کنی میشه من از شما خواهش کنم چادرتو دیگه سرت نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 726.38,
   "end": 729.12,
   "text": "چرا؟ به خاطر اینکه اولاً با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 729.12,
   "end": 731.72,
   "text": "چادر زیبایی‌هات مشخص نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 731.72,
   "end": 736.54,
   "text": "شما رو خدا زیبا آفریده. مظهر جمال خدائه بارها ما اینجا گفتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 736.54,
   "end": 740.64,
   "text": "انحراف فکری رو ببین. بعد با پول این چادر می‌تونی سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 740.64,
   "end": 744.88,
   "text": "اِاِاِ مثلاً مانتو بخری، روسری رنگین بخری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 744.88,
   "end": 749.58,
   "text": "و ببین چگونه خودت راحت می‌شی از شر این سیاهی نجات پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 749.58,
   "end": 753.14,
   "text": "این زنه باهاش مثلا یه جوونی، این داره چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 753.14,
   "end": 755.98,
   "text": "منکر رو معروف به این زن ما معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 755.98,
   "end": 759.66,
   "text": "انقدر که ما عقب نشینی کردیم اونا اومدن وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 759.66,
   "end": 761.6,
   "text": "خب باید ما شروع کنیم دیگه بسم الله از یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 761.6,
   "end": 766.5,
   "text": "جایی بالاخره از همین جا از جاهای دیگه از تو محلمون شروع کنیم حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 766.5,
   "end": 768.3,
   "text": "حرکت کنیم ببینیم نتیجه می‌گیریم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 768.3,
   "end": 773.76,
   "text": "ما که حالا به جاش افتاد کتک زدیم کتک هم خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 773.76,
   "end": 780.16,
   "text": "ما هم جزو اون آخونده رزمی کار بودیم که ده تا رشته رزمی کار کردیم با دممون کسی بازی کرد زدیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 780.16,
   "end": 781.9,
   "text": "یعنی قرار بود جسارت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 781.9,
   "end": 785.1,
   "text": "حالا جالبه که این فیلم‌هایی هم که میذارن عمامه پرونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 785.1,
   "end": 791.02,
   "text": "من مطمئنم اولاً این آخوندا، آخوندهای نظام آبادی نبودن که تونسته کسی عمامه‌شونو بپرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.02,
   "end": 795.56,
   "text": "چرا از سر ما نمیپرونن؟ من با همین لباس همه شما به من میگن حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 795.56,
   "end": 797.84,
   "text": "رو راه رعایت کن ما نگرانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 797.84,
   "end": 801.64,
   "text": "میریم تو ماشین حتی تو اون بحبحه الان که دیگه خوابید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 801.64,
   "end": 805.72,
   "text": "بوغ بزن، آتیش بزن فلان، با همین عمامه تو ماشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 805.72,
   "end": 810.66,
   "text": "ساندویچی محل بقالیای محل با همین عمامه مسجد میرم من تو محلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 810.66,
   "end": 813.52,
   "text": "به خدا قسم اگر یک فحش شنیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 813.52,
   "end": 817.58,
   "text": "یه جسارت، هیچ. اینم نیست که میگی اوه اوه دیگه همه ضد آخوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.58,
   "end": 820.28,
   "text": "نه خب من خودم دارم می‌بینم اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.28,
   "end": 823.0,
   "text": "یه عده قلیلی‌ان بعد ما جوابشونو میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 823.0,
   "end": 825.68,
   "text": "با حرف و حد نشد، اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 825.68,
   "end": 832.0,
   "text": "چکیش می‌کنیم خیلی راحت. بعد جالبه اینا اون، اینم گوش بدید، اون انتهاشو نمیذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 832.0,
   "end": 835.72,
   "text": "انتهاشو یعنی چی؟ می‌خواید فیلم خودمو براتون پخش کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 835.72,
   "end": 838.52,
   "text": "ما نذاشتیم پخش بشن. انتهاش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 838.52,
   "end": 843.24,
   "text": "مثلا طرف میاد جسارت می‌کنه اینم خب از خودش دفاع می‌کنه دیگه جسارت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 843.24,
   "end": 845.14,
   "text": "لباس پیغمبر شده اینم دفاع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 845.14,
   "end": 848.86,
   "text": "مثلا می‌زنه، یه آبچکی می‌زنه طرفو می‌خوابونه زمین مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 848.86,
   "end": 852.44,
   "text": "بعد از اونجا به بعدش رو دیگه تو فیلم نذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 852.44,
   "end": 857.24,
   "text": "اونجایی که آخونده حقشو گذاشته کف دستش ثابت کرده من بچه نظام آبادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 857.24,
   "end": 860.18,
   "text": "نیست تو فیلم. فقط اون لحظه عمامه پرونیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 860.18,
   "end": 863.32,
   "text": "اینم یه دروغ رسانه‌ایه. دوست داشتید می‌تونین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 863.32,
   "end": 866.42,
   "text": "این رو عملاً اینجا پیاده کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 866.42,
   "end": 870.8,
   "text": ". صلوات ختم کنید تا جا، کار به جای باریک نکشیده صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.8,
   "end": 878.18,
   "text": "اللهم صل علی محمد و آل محمد حاج آقا الان معلوم شد این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 878.18,
   "end": 880.62,
   "text": "می‌تونین امتحان کنید. ما داداش ما نمیاد ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}