 "chapters": [
  {
   "index": 0,
   "title": "## روایت هشتم باب چهارم؛ کراهت ابراهیم از موت",
   "start": 18.82,
   "end": 104.66
  },
  {
   "index": 1,
   "title": "اتفاقاً در قرآن می‌فرماید آنجا که می‌فرماید:",
   "start": 104.66,
   "end": 124.88
  },
  {
   "index": 2,
   "title": "## دو دلیل کراهت موت",
   "start": 124.88,
   "end": 271.88
  },
  {
   "index": 3,
   "title": "## تصریح خطبهٔ فدکیه به رغبت پیامبر",
   "start": 271.88,
   "end": 443.39
  },
  {
   "index": 4,
   "title": "## أنا مدینة الحکمة وهي الجنة؛ علی بابها",
   "start": 443.39,
   "end": 601.13
  },
  {
   "index": 5,
   "title": "## درجات بهشت به عدد آیات؛ اقرأ وارقَ",
   "start": 601.13,
   "end": 699.81
  },
  {
   "index": 6,
   "title": "## هنگام مرگ ما؛ رضایت محب علی",
   "start": 699.81,
   "end": 736.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 5.34,
   "text": "اللهم صل علی محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.34,
   "end": 9.7,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.7,
   "end": 13.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.6,
   "end": 18.82,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 22.86,
   "text": "در روایت هشتم بودیم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.86,
   "end": 28.74,
   "text": "بحث ما اینجا بود که دلیل کراهت داشتن حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.74,
   "end": 33.18,
   "text": "علیه و علی نبینا و آله السلام چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.18,
   "end": 37.98,
   "text": "یه وجهش رو هم که در بحث بودیم این عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.98,
   "end": 43.74,
   "text": "قطعاً حضرت ابراهیم چون به تمام مراتب نرسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.74,
   "end": 46.22,
   "text": "به اون وجه اتم مراتب؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.22,
   "end": 49.66,
   "text": "یعنی پیغمبر عزیز عالم که مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.66,
   "end": 56.0,
   "text": "ختمی داشتن یعنی مقامش از حضرت ابراهیم بالاتر بود یعنی راه بود هنوز برای حضرت ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.0,
   "end": 63.16,
   "text": "لذا علت کراهت داشتن، حالا به یک معنا میگیم کراهت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.16,
   "end": 68.12,
   "text": "در خصوص انبیا زشته بگیم کراهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.12,
   "end": 74.84,
   "text": "یا سوالی که ایشون داشتن که چرا حالا قابض الارواح اومده قبض روح ما کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.84,
   "end": 77.86,
   "text": "اینه که ایشون دوست داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.86,
   "end": 81.74,
   "text": "به اون مراتب عالیه‌ای که هنوز طی نکردن برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.74,
   "end": 85.92,
   "text": "این وجه بحث ما بود که در دل بحث مونده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.92,
   "end": 97.76,
   "text": "که با مثالی از روایت حره این رو اثبات کردیم که قطعاً مراتب و مقاماتی بوده که حضرت ابراهیم هم به اونا نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.76,
   "end": 103.38,
   "text": "اتفاقاً در قرآن میفرماید، اونجایی که میفرماید قل يا ايها الذين هادوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 103.38,
   "end": 110.26,
   "text": "ان ظنتم اگر گمان می‌کنید ظن شما اینه که انكم اولياء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 110.26,
   "end": 113.68,
   "text": "اگر شما گمانتون اینه که ولی خدا هستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 113.68,
   "end": 120.0,
   "text": "فتمَنَّوُا الموت پس تمنای موت کنید ان كنتم صادقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.0,
   "end": 123.48,
   "text": "اینجا خدا رحمت کنه از آقای مصباح رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 123.48,
   "end": 131.74,
   "text": "این حکیم متأله اینجا می‌فرمودند که این نشون میده که ولی خدا بودن با تمنای موت ملازم هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 131.74,
   "end": 136.64,
   "text": "اما ولی خدا تمنای موت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.64,
   "end": 139.82,
   "text": "ولی خدا اونورش رو آباد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 139.82,
   "end": 143.28,
   "text": "دنیاش از نظر ما خرابه اما اونورش آباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 143.28,
   "end": 148.48,
   "text": "لذا هیچ-- خیلی هم سینه چاک لقای خدا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 148.48,
   "end": 151.72,
   "text": "اما باز خب حضرت ابراهیم بالاخره ولی خدا بود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 151.72,
   "end": 155.24,
   "text": "قطعاً بودند. بلکه از بزرگ‌ترین اولیاء الهی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.24,
   "end": 157.18,
   "text": "چطور باز ایشون این سؤال رو کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 157.18,
   "end": 161.78,
   "text": "بر می‌گردیم به همین وجه. ببینید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 161.78,
   "end": 166.46,
   "text": "به قول آقای مصباح دو تا دلیل داریم بر کراهت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 166.46,
   "end": 172.52,
   "text": "یا اینکه به قول اباذر که ازش پرسیدن چرا ما موت رو بدمون میاد، کراهت می‌شونیم که بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.52,
   "end": 176.14,
   "text": "زشت می‌دونیم، بد می‌دونیم، کریه در منظر نگاه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.14,
   "end": 180.46,
   "text": "از اباذر فرمودن چون دنیاتون رو آباد کردید آخرت رو ویران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 180.46,
   "end": 183.06,
   "text": "خب می‌خواید از یه آبادی برید بیوار-- ویرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.06,
   "end": 188.46,
   "text": "باید هم کراهت داشته باشید. این یه وجهشه که در خصوص اکثریت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.46,
   "end": 191.62,
   "text": "اما وجه دومش که الان مورد بحث ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.62,
   "end": 197.4,
   "text": "اینه که بالاخره مراتیبی هست، این مراتب می‌خواد طی بشه فرصت می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.4,
   "end": 199.32,
   "text": "و فرصت هم همین دنیاست تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.32,
   "end": 202.08,
   "text": "البته ما ولد اینا مزید داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 202.08,
   "end": 208.84,
   "text": "یعنی اینطور نیست که دیگه صد درصد اونچه که خدا به ما عطا می‌کند صرفاً و فقط و فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.84,
   "end": 212.54,
   "text": "بر بیس و بستر و بر اساس اعمال ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.54,
   "end": 216.3,
   "text": "اینطوری باشه که جسارتا خدا کریم نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 216.3,
   "end": 221.92,
   "text": "ها؟ نه، خدا کریمه بلکه الجواد ال کریمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 221.92,
   "end": 223.82,
   "text": "و اون ولد اینا مزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.82,
   "end": 227.4,
   "text": "اون اضافه‌ش زیادیش پیش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.4,
   "end": 232.12,
   "text": "دیگه اون عنایت حضرت حق و لایتناهی و انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.12,
   "end": 235.2,
   "text": "اما بالاخره اینجا از دنیا مزرعه الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.2,
   "end": 238.14,
   "text": "اینجا مزرعه اونجاست. لذا فرصت می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.14,
   "end": 242.7,
   "text": "این فرصت به قدری مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.7,
   "end": 245.96,
   "text": "بالا است و انتها نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 245.96,
   "end": 250.22,
   "text": "که حضرت ابراهیم هم حتی نتونسته تا اون انتها بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.22,
   "end": 252.58,
   "text": "یعنی به حضرت ختمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.58,
   "end": 254.78,
   "text": "و پیغمبر عزیز ما برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.78,
   "end": 258.12,
   "text": "لذا فرصت می‌خواد. میگه حالا حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.12,
   "end": 260.62,
   "text": "حالا سواله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.62,
   "end": 265.2,
   "text": "چگونه است که یه دوستی تقاضای مرگ دوستش رو کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.2,
   "end": 269.86,
   "text": "یعنی تو دلش در میاد یه رغبتی به اینکه ما دوباره هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.86,
   "end": 271.88,
   "text": "مراتیبی هست که طی نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.88,
   "end": 275.86,
   "text": "اتفاقاً داشتم بررسی می‌کردم خطبه فدکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.86,
   "end": 281.0,
   "text": "حضرت زهرا سلام الله علیها رو در خصوص یه موضوع دیگری برخوردم به این تیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.0,
   "end": 287.44,
   "text": "دیدم چه شیرین. خود حضرت صدیقه طاهره سلام الله علیها داره تصریح می‌کنه در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.44,
   "end": 291.96,
   "text": "بخشی از این خطبه که پدرشون حضرت ختمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.96,
   "end": 294.24,
   "text": "ختم الخاتمه دیگه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.24,
   "end": 297.34,
   "text": "مهر زد تمام شد. همه مراتب رو رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.34,
   "end": 301.96,
   "text": "ایشون هیچ گونه کراهتی نسبت به رفتن نداشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.96,
   "end": 308.12,
   "text": "ببینید این قسمت از خطبه رو که می‌فرماید ثمه حضرت صدیقه طاهره سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.12,
   "end": 311.1,
   "text": "ثمه قبضه الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.1,
   "end": 313.48,
   "text": "قبضه الله الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.48,
   "end": 315.8,
   "text": "وقتی که خدا قبض کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.8,
   "end": 319.38,
   "text": "به سوی خودش، قبضه او را یعنی پدرم را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.38,
   "end": 323.36,
   "text": "قبضه چگونه قبض کرد روح پدرم رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.36,
   "end": 327.58,
   "text": "رأفته واختيار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.58,
   "end": 331.24,
   "text": "ورغبه وایثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.24,
   "end": 334.8,
   "text": "خیلی جالبه که خیلی از شارحین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.8,
   "end": 336.98,
   "text": "من جمله حضرت آقای مصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.98,
   "end": 343.12,
   "text": "اینجا می‌فرمایند این رأفت و اختیار از سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.12,
   "end": 346.8,
   "text": "رغبت و ایثار از سمت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.8,
   "end": 349.18,
   "text": "قبض روح شد پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.18,
   "end": 351.26,
   "text": "رأفته واختيار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.26,
   "end": 353.74,
   "text": "پی-- خدای منان او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.74,
   "end": 356.6,
   "text": "اختیار کرد، ورش داشت برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.6,
   "end": 360.16,
   "text": "واستنعت کل نفسي برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.16,
   "end": 366.5,
   "text": "رأفتن از رو رأفت. حالا از ناحیه پیغمبر رفتار پیغمبر نسبت به قبض روح چگونه بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.5,
   "end": 369.44,
   "text": "رغبتن بسیار راغب بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.44,
   "end": 372.89,
   "text": "و ایثار بذل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.89,
   "end": 378.95,
   "text": "در مقام بذل بوده، بذل کرده جانش رو به تمامه اونم با رغبتا با رغبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.95,
   "end": 382.49,
   "text": "کوچک‌ترین کراهتی توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.49,
   "end": 390.31,
   "text": "که جالبه که بعد حضرت ادامه میدن که فمحمدان صلی الله علیه و آلهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.31,
   "end": 393.69,
   "text": "أن تَ-- تَعَبَ هَذِه الدَّارِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.69,
   "end": 397.29,
   "text": "فِرَاحَ. از این تعب و سختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.29,
   "end": 405.69,
   "text": "این دنیا راحت شد. رفت قد حُف و در حالی که بالملائكة الأبرار ملائکه ابرار دورشو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.69,
   "end": 409.41,
   "text": "حُف یعنی هجوم آورده بودند، پر کرده بودند دور پیغمبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.41,
   "end": 411.71,
   "text": "وَرِضْوَانِ رَبِّ کدوم رب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.71,
   "end": 416.37,
   "text": "الغفار وَمُجاوَرَةِ المَلَكِ الجَبَّارِ که اینجا خیلی حرف‌ها میشه پیاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.37,
   "end": 418.87,
   "text": "بخصوص این اسلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.87,
   "end": 423.03,
   "text": "فرمایش حضرت زهرا. این نشون میده که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.03,
   "end": 425.89,
   "text": "خطمی سر سوزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.89,
   "end": 429.75,
   "text": "کراهت نسبت به موت و مرگش و لقاء نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.75,
   "end": 432.21,
   "text": "اما چرا حضرت ابراهیم داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.21,
   "end": 439.53,
   "text": "به جهت مراتب. مراتب رو پیغمبر و این آل الله و ااه اهلبیت ایشون این چهارده تا تا آخر رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.53,
   "end": 441.91,
   "text": "بقیه تا آخر نرفتن. لذا فرصت میخوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.91,
   "end": 448.49,
   "text": "یک وجهش اینه. حالا وقتی شما دقت می‌کنی می‌بینی که این مراتب، مراتب حالا تا کجا هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.49,
   "end": 454.21,
   "text": "این مراتب بالاخره که حضرت ابراهیم هم تا آخرش نرفته تا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.21,
   "end": 457.83,
   "text": "کجاشو دیگه خدا میدونه و خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.83,
   "end": 462.57,
   "text": "اونجایی که مثلاً خدا رحمت کنه مرحوم ابن بابویه و شیخ صدوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.57,
   "end": 466.01,
   "text": "ایشون در کتاب مجالس‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.01,
   "end": 468.41,
   "text": "خیلی کتاب شیرین توصیه می‌کنم بگیرید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.41,
   "end": 471.39,
   "text": "امالی شیخ صدوق معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.39,
   "end": 477.93,
   "text": "مجالس‌شون. اونجا روایتی از پیغمبر عظیم الشأن اسلام میاره که خطاب به امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 477.93,
   "end": 481.31,
   "text": "پیغمبر می‌فرماید که أنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.31,
   "end": 485.27,
   "text": "مدینة الـ. اون یه روایت دیگه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.27,
   "end": 487.33,
   "text": "أنا مدینة العلم یکی دیگه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.33,
   "end": 490.19,
   "text": "مثلا اینطوری گفتم موچتون رو بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.19,
   "end": 493.55,
   "text": "أنا مدینة الـ هرکی گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.55,
   "end": 498.31,
   "text": "یه جایزه داره. جایزه‌ش هم ماچ آبدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.31,
   "end": 501.35,
   "text": ". مدینة الـ. حکمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.35,
   "end": 503.71,
   "text": "حکمة. یه نفر من شنیدم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.71,
   "end": 507.45,
   "text": "حالا بعد از برنامه بیاد جلو در خودش رو معرفی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.45,
   "end": 511.23,
   "text": "ما در خدمتیم. أنا مدینة الحکمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.23,
   "end": 513.79,
   "text": "من شهر حکمتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.79,
   "end": 516.69,
   "text": "حالا این شهر حکمت چیه یا رسول الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.69,
   "end": 520.83,
   "text": "تو کتابه. وهي الـ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.83,
   "end": 525.37,
   "text": "هرکی گفت دو تا جایزه داره. وهي الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.37,
   "end": 528.75,
   "text": "این شهر حکمت که منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.75,
   "end": 534.25,
   "text": "بهشت اینه. قرآن میگه یَا سِین وَالْقُرْآنِ الْحَکِیمِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.25,
   "end": 537.11,
   "text": "اصلاً قرآن همه حکمت توشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.11,
   "end": 540.33,
   "text": "وَیُعَلِّمُهُمُ الْکِتَابَ وَالْحِکْمَةَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.33,
   "end": 542.51,
   "text": "حکمت همش تو قرآن خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.51,
   "end": 546.05,
   "text": "پیغمبر می‌فرمود اون منم. اصلاً قرآن منم، من قرآنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.05,
   "end": 548.19,
   "text": "أنا مدینة الحکمة وهي الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.19,
   "end": 550.89,
   "text": "اصلاً بهشت یعنی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.89,
   "end": 553.63,
   "text": "حالا وَأَنْتَ یَا عَلِيُّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 553.63,
   "end": 557.03,
   "text": "تو اینجا تکلیفت چیه؟ بَابُهَا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.03,
   "end": 560.73,
   "text": "تو در این بهشتی، تو در حکمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.73,
   "end": 565.65,
   "text": "و من أراد المدينة هرکس اراده تو نذره می‌خونیم شهر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.65,
   "end": 568.71,
   "text": "فلیأْتِ من بابها دیگه از درش باید بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.71,
   "end": 572.65,
   "text": "که اینکه میگن کولون در بهشت رو که می‌زنن بهشتیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.65,
   "end": 578.05,
   "text": "مثلاً انشاالله شما ما می‌خوایم بریم منزل شما در بهشت در می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.05,
   "end": 582.89,
   "text": "هر کدوم از شما دیگه اسم شما صداش در نمیاد که صدای زنگ بهشتیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.89,
   "end": 585.81,
   "text": "اینه یا علی، یا علی، یا علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.81,
   "end": 587.55,
   "text": "حالا اینم باید تعبیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.55,
   "end": 592.43,
   "text": "یعنی چی یا علی؟ که پیغمبر رفت معراج همه چی رو علی دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.43,
   "end": 596.09,
   "text": "یعنی چی به شکل علی به صوت علی اینا باید تعبیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.09,
   "end": 597.99,
   "text": "پس اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.99,
   "end": 600.31,
   "text": "بهشت درجاتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.31,
   "end": 602.81,
   "text": "به مثل قرآن. یا در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.81,
   "end": 605.43,
   "text": "وافی فصل سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.43,
   "end": 612.65,
   "text": "اینو خوب دقت کنید. فصل سوم وافی ملا محسن که برجسته ترین شاگرد ملا صدرا و داماد ایشون بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.65,
   "end": 616.81,
   "text": "در فصل سوم در بخش وصایاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.81,
   "end": 622.01,
   "text": "از امیرالمؤمنین روایت میاره که به فرزندش محمد حنفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 622.01,
   "end": 624.67,
   "text": "محمد چرا میگن حنفیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.67,
   "end": 629.95,
   "text": "چون مادر ایشون قبلاً یه همسری داشت به نام حنفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.95,
   "end": 634.07,
   "text": "وقتی که از دنیا رفت شوهرش اومد با امیرالمؤمنین وصلت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.07,
   "end": 635.97,
   "text": "بچه ایشون بچه علی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 635.97,
   "end": 641.29,
   "text": "علی علیه الصلاة والسلام بود اما گفتن محمد حنفیه یعنی همسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.29,
   "end": 646.95,
   "text": "حنفیه رو امیرالمؤمنین بعد از مرگ حنفیه گرفته لذا معروف شد به محمد حنفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.95,
   "end": 650.57,
   "text": "ایشون امیرالمؤمنین به محمد حنفیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.57,
   "end": 654.13,
   "text": "عدد درجات بهشت به عدد آیات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.13,
   "end": 657.17,
   "text": "اقرأ وارقَ بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.17,
   "end": 660.43,
   "text": "و اگر اینه اگر قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.43,
   "end": 664.03,
   "text": "انتها نداره پس بهشت هم انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 664.03,
   "end": 666.37,
   "text": "پس مراتب هم انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.37,
   "end": 671.07,
   "text": "پس هرچی ما تو این دنیا بمونیم کمه برای جبران مافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 671.07,
   "end": 676.19,
   "text": "جا داره که حضرت ابراهیم هم بخواد بیشتر تو این دنیا بمونه که فرصت‌ها رو جبران کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.19,
   "end": 678.89,
   "text": "حالا ایشون ما میگیم جبران مافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.89,
   "end": 680.97,
   "text": "این دیگه مافات نداره ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 680.97,
   "end": 684.99,
   "text": "طی درجات. ما میگیم جبران مافات، ایشون طی درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 684.99,
   "end": 690.97,
   "text": "لذا ایشون هم وقتی قبض روحش میخواد رخ بده یه حالتی شبیه کراهت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.97,
   "end": 693.35,
   "text": "که خداوند اینطوری موچشو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 693.35,
   "end": 696.67,
   "text": "می‌فرماید که کدوم دوسته که از دیدار دوستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 696.67,
   "end": 699.81,
   "text": "کراهت داره. سریع راضیش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.81,
   "end": 702.25,
   "text": "حالا اینجا باید چه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 702.25,
   "end": 706.35,
   "text": "اگر حضرت ابراهیم هم این حالتو داره ما چه کنیم وقت مرگ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.35,
   "end": 709.23,
   "text": "قطعاً ما هم این حالتو خواهیم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.23,
   "end": 712.71,
   "text": "چه اتفاقی میفته که ما جون بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 712.71,
   "end": 719.33,
   "text": "چون روایت داریم خدا محب علی رو جانش رو نمی‌گیره مگر اینکه راضیش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 719.33,
   "end": 722.45,
   "text": "چگونه ما رو راضی می‌کنند که ما راحت جون بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 722.45,
   "end": 724.37,
   "text": "انشاالله باشه جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 724.37,
   "end": 726.33,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 726.33,
   "end": 729.87,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 729.87,
   "end": 736.31,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}