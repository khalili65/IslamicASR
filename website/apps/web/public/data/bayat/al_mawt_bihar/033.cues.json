 },
 "chapters": [
  {
   "index": 0,
   "title": "## موت؛ از کرسی تکبر به خشوع",
   "start": 0.22,
   "end": 108.66
  },
  {
   "index": 1,
   "title": "## سرکشی به فقرا؛ اکرم القوم خادمهم",
   "start": 108.66,
   "end": 244.12
  },
  {
   "index": 2,
   "title": "## مرام امام در جماران",
   "start": 244.12,
   "end": 317.52
  },
  {
   "index": 3,
   "title": "## سیر معنوی و مرام خانوادگی امام",
   "start": 317.52,
   "end": 409.46
  },
  {
   "index": 4,
   "title": "## طلحه و زبیر؛ تکبر و حسد و حرص",
   "start": 409.46,
   "end": 526.62
  },
  {
   "index": 5,
   "title": "## موسی و شیطان؛ أبا استکبر",
   "start": 526.62,
   "end": 681.62
  },
  {
   "index": 6,
   "title": "## عظیم در رکوع؛ اعلی در سجده",
   "start": 681.62,
   "end": 759.14
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.22,
   "end": 6.64,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.64,
   "end": 10.98,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.98,
   "end": 19.52,
   "text": "قصه‌ی موت از حیث اینکه جعل شده تا ما رو به خشوع بکشونه و از تکبر بیرون بیاره رو باید جدی گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.52,
   "end": 22.96,
   "text": "یعنی اصلاً فلسفه 创 造",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.96,
   "end": 24.94,
   "text": "و خلق خود م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.94,
   "end": 28.14,
   "text": "موت همونطور که عرض کردیم خلق الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.14,
   "end": 31.08,
   "text": "و خلق موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.08,
   "end": 33.74,
   "text": "در کنار مریضی و فقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.74,
   "end": 39.18,
   "text": "کشوندن ما از کرسی تکبر به زیره، به خشوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.18,
   "end": 44.02,
   "text": "که به یک معنا اگر کسی واقعاً به خشوع لازم برسه به اون موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.02,
   "end": 46.5,
   "text": "اختیاری حتی می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.5,
   "end": 49.06,
   "text": "یعنی همینجا خودش نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.06,
   "end": 52.66,
   "text": "اماره‌شو می‌کشه و به موت رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.66,
   "end": 55.68,
   "text": "و می‌تونه به ملکوت دسترسی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.68,
   "end": 62.08,
   "text": "از اون طرف تا کسی نه اینکه اونور دقت بفرمایید، یه وجهش اونوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.08,
   "end": 65.56,
   "text": "احادیث اهل بیت باید تأویل بشه، هزاران وجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.56,
   "end": 71.2,
   "text": "اگر می‌فرماید سر سوزن تو که دیروز عرض کردیم تکبر در وجود کسی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.2,
   "end": 74.82,
   "text": "وارد بهشت نمی‌شه، همین جام اینطوریه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.82,
   "end": 77.22,
   "text": "همینجا هم اینطوریه. بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.22,
   "end": 79.6,
   "text": "گفتیم که یه رشه‌هاییش هم در دنیا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.6,
   "end": 82.84,
   "text": "وقتی انسان انبساط خاطر داره حالش خوشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.84,
   "end": 86.84,
   "text": "حال بندگی داره، حرم میره، هیئت میره، نماز با نشاط می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.84,
   "end": 91.08,
   "text": "اینا رشه‌های بهشته، سایه بهشته این حالات خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.08,
   "end": 95.76,
   "text": "اینجا هم اگه کسی تکبر داشته باشه ورود به بهشت نمی‌کنه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.76,
   "end": 98.5,
   "text": "یعنی مزه انبساط خاطر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.5,
   "end": 103.52,
   "text": "اون سعی وجودی و نشاط در عبادت و اینا رو نمی‌چشه، نمی‌چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.52,
   "end": 107.34,
   "text": "محاله. یعنی اینجا هم توجه داشته باشید به این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.34,
   "end": 109.78,
   "text": "انقدر مهمه. برای همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.78,
   "end": 114.56,
   "text": "سرکشی به فقرا، هم‌نشینی با فقرا اینا خیلی تأکید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.56,
   "end": 118.92,
   "text": "حالا علیرغم اینکه متأسفانه ماها معمولاً جلوی کسایی خم و راست می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.92,
   "end": 122.54,
   "text": "که یا وضع مالیشون خوبه که فرمود ایمان رو ذوب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.54,
   "end": 128.66,
   "text": "جلوی کسی به خاطر پولش، به خاطر شهرتش، به خاطر مقامش، به خاطر مدیریتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.66,
   "end": 132.3,
   "text": "ما اینطوریم. یا باید پول داشته باشه یا قلم به دست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.3,
   "end": 135.98,
   "text": "مثلاً یه مدیری باشه، یه رییسی باشه، یه کاره‌ای باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.98,
   "end": 140.34,
   "text": "مثلاً الان شما تصور کنید یه مدیرکل وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.34,
   "end": 145.16,
   "text": "اتاق کار ما بشه. خداوکیلی هممون تمام قد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.16,
   "end": 147.38,
   "text": "بلند نمی‌شیم. خبر داد مدیرکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.38,
   "end": 151.3,
   "text": "ولی حالا یه چایی ریز بیاد. یه کس بخواد بیاد اتاقتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.3,
   "end": 155.68,
   "text": "طی بکشه، انصافاً جلوش بلند میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.68,
   "end": 157.82,
   "text": "من امروز رفتم تو سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.82,
   "end": 159.72,
   "text": "اتاق مدیرکل رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.72,
   "end": 164.2,
   "text": "حالا جلساتی بود، صحبت‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.2,
   "end": 167.34,
   "text": "هر چایی ریزی که اومد، حالا چایی میارن دیگه مهمون که میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.34,
   "end": 170.52,
   "text": "وقتی جلوی این بنده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.52,
   "end": 175.22,
   "text": "آبدارچی‌ها پا می‌شدم تمام قد، می‌دیدم همه با تعجب منو نگاه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.22,
   "end": 178.3,
   "text": "چرا باید با تعجب نگاه کنن؟ مگر حدیث نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.3,
   "end": 181.56,
   "text": "اکرم القوم خادم. گرامی‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.56,
   "end": 183.18,
   "text": "هر قومی خادمه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.18,
   "end": 188.32,
   "text": "مگه اینا خادم نیستن؟ اصلاً نظام ما باید نگاهش عوض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.32,
   "end": 191.5,
   "text": "چرا اینا باید خیلی تحت فشار باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.5,
   "end": 195.66,
   "text": "تو اضافه حقوقشون، چه می‌دونم اضافه کاری‌شون چی و خیلی چیزاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.66,
   "end": 197.2,
   "text": "چرا اصلاً اینا باید شرکتی باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.2,
   "end": 199.14,
   "text": "دیگر این قراردادی و رسمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.14,
   "end": 202.64,
   "text": "حالا ور-- ورود نکنم به این بحث که آقا شما حرف آخوندی‌تو بزن برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.64,
   "end": 204.94,
   "text": "ولی دین که از سیاست جدا نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.94,
   "end": 207.4,
   "text": "باید حرف حق رو بزنیم. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.4,
   "end": 210.54,
   "text": "لعنت کنه باعث و بانی‌شو که خیلی شاید حدود س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.54,
   "end": 213.24,
   "text": "بیست و پنج سال پیش این حدودا این قانون گذاشته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 213.24,
   "end": 216.86,
   "text": "نه اینجا، تو شرکت‌ها، تو سازمان‌ها، چه چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 216.86,
   "end": 219.7,
   "text": "مگه ما چه-- ما تخم دو زرده‌ایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 219.7,
   "end": 223.94,
   "text": "مثلاً رسمی و غیررسمی مثل تخم مرغ رسمی و غیررسمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 223.94,
   "end": 230.46,
   "text": "اینا چیه؟ این بازی‌ها چیه؟ اونور وقتی بخوابوننت تو خاک، ما رو بخوابونن تو خاک دیگه این حرفا برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.46,
   "end": 235.58,
   "text": "آقا شما کجا بودی؟ پشت میز م-می‌نشستی یا زیر میز بودی یا بالای میز و روی میز بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 235.58,
   "end": 239.62,
   "text": "این حرفا نیستش که. عملکردت چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.62,
   "end": 243.88,
   "text": "توجه کردی؟ حالا اینا همه اومده برای چی ما رو به زیر بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.88,
   "end": 246.18,
   "text": "مثلاً حضرت امام من خیلی برام جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.18,
   "end": 250.56,
   "text": "تو خاطراتش می‌خوندم که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.56,
   "end": 252.98,
   "text": "بالاخره سربازای جماران پست می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 252.98,
   "end": 255.24,
   "text": "هوای سرد. اینا یه روز میاد سرکشی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.24,
   "end": 261.06,
   "text": "سحر می‌بینه سربازی که باید مثلاً مراقب ورود و خروج جماران باشه، امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.06,
   "end": 264.24,
   "text": "قدم می‌زد سحرا، دید این خ-- چرتش گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.24,
   "end": 265.92,
   "text": "خوابش برده بیچاره سربازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.92,
   "end": 267.82,
   "text": "خدایی من اگه بودم چیکار می‌کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 267.82,
   "end": 270.08,
   "text": "حالا نه رئیس مثلاً مملکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 270.08,
   "end": 274.06,
   "text": "مثلاً چه بگم مثلاً اون رئیس شیفت بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 274.06,
   "end": 277.04,
   "text": "لوح اینو تنظیم کرده بودن که ایشون شیفت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 277.04,
   "end": 280.16,
   "text": "گوشش رو می‌پیچوندم دو روز انفصال از خدمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 280.16,
   "end": 282.86,
   "text": "معرفیش می‌کردم به اداری چه چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 282.86,
   "end": 288.82,
   "text": "امام چیکار کرد؟ گنده ما، بزرگ ما چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 288.82,
   "end": 290.9,
   "text": "بدون اینکه بیدارش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 290.9,
   "end": 296.66,
   "text": "یواش، یواش این اسلحه‌شو از گوشتش برداشت وایساد به جاش پست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 296.66,
   "end": 302.06,
   "text": "ظاهراً یه نیم ساعت، چهل و پنج دقیقه می‌گذره، یهو از خواب بیدار می‌بینه امام وایساده داره پست میده به جاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 302.06,
   "end": 304.3,
   "text": "میگه آقا من شرمنده‌م ببخشید، این افتاده به پاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 304.3,
   "end": 305.92,
   "text": "میگه نه چیه؟ شرمنده چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 305.92,
   "end": 309.6,
   "text": "خسته بودی. برو استراحت کن من به جات وا نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 309.6,
   "end": 312.54,
   "text": "آخه این مرام انقلاب ما کجا باید دیدش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 312.54,
   "end": 317.04,
   "text": "شما بفرمایید. یعنی این یه همچین کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 317.04,
   "end": 321.8,
   "text": "بله ما محضر یکی از بزرگان از اهل معرفت رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 321.8,
   "end": 324.48,
   "text": "در حرم امام. خیلی موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 324.48,
   "end": 329.96,
   "text": "رفته بودم یه هفته در حرم امام بیتوته کرده بودم فقط نون و نمک می‌خوردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 329.96,
   "end": 333.34,
   "text": "دانشگاه قبول شم. فقط درس می‌خوندم شبانه روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 333.34,
   "end": 337.24,
   "text": "حالا خدا لطف کرد اون موقع پزشکی دانشگاه تهران قبول شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 337.24,
   "end": 338.82,
   "text": "بعد ولش کردم اومدم حوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 338.82,
   "end": 343.58,
   "text": "یه هفته پیش امام بودم. یکی از بزرگان رو اونجا ما دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 343.58,
   "end": 347.02,
   "text": "ایشون می‌ر-- سیر کرده بود بره، ایشون خودش گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 347.02,
   "end": 350.94,
   "text": "سیر کرده بود که مثلاً بره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 350.94,
   "end": 353.72,
   "text": "مقامات معنوی بزرگان رو ببینه در آسمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 353.72,
   "end": 357.24,
   "text": "خب همه رو دیده بود حتی علامه مجلسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 357.24,
   "end": 361.84,
   "text": "دیده بود. شیخ کلینی رو. اما دستش به ا-- دستش به امام ما نرسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 361.84,
   "end": 367.36,
   "text": "برگشته بود. بهش گفته بود من اگه دنبال سید روح اللهی که تو ایران قیام کرده برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 367.36,
   "end": 371.88,
   "text": "تو نمی‌تونی به اون برسی این اونجا داشت به ما می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 371.88,
   "end": 374.76,
   "text": "چرا این مرام‌نامه امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 374.76,
   "end": 378.26,
   "text": "مرام امام، مرام سیاسی‌ش، مرام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 378.26,
   "end": 383.98,
   "text": "عرض شود اخلاقی‌ش، اعتقادی‌ش، مرام اجتماعی‌ش، فردی‌ش، خانوادگی‌ش که بدون زنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.98,
   "end": 387.72,
   "text": "هیچوقت غذا نمی‌خورد. صبر می‌کرد تا همسرش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 387.72,
   "end": 390.04,
   "text": "آخه این مرام کی می‌خواد بیاد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.04,
   "end": 394.02,
   "text": "زندگی‌های ما؟ امام‌مون کجاش تکبر تو وجودش بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 394.02,
   "end": 397.24,
   "text": "اصلاً موت اومده ما رو چی کار کنه از تکبر بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 397.24,
   "end": 402.52,
   "text": "و این یکی از اصلاً اساسی‌ترین و ریشه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.52,
   "end": 406.3,
   "text": "ری-- دقت بفرمایید ریشه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 406.3,
   "end": 411.26,
   "text": "مهم در جهنمی شدن تا جایی که از مولا علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 411.26,
   "end": 415.54,
   "text": "پرسیدن آقا چی شد یکی مثل طلحه و زبیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 415.54,
   "end": 420.84,
   "text": "بابا پیغمبر در خصوص زبیر داره شمشیر زبیر رو توصیف کرد به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 420.84,
   "end": 423.52,
   "text": "می‌دونید دیگه سيف الإسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 423.52,
   "end": 426.04,
   "text": "مثل تعاریفی که بعضیا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 426.04,
   "end": 429.68,
   "text": "امام از بعضیا داشت اینجا تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 429.68,
   "end": 432.64,
   "text": "نهضت زنده است تا هاشمی زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 432.64,
   "end": 436.04,
   "text": "خب این منظور خود شخص هاشمی نبود که افکار اون موقعش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 436.04,
   "end": 439.16,
   "text": "ولی وقتی منحرف شد امام فرمود ملاک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 439.16,
   "end": 442.1,
   "text": "حال فعلی افراده. پیغمبر هم این حرفو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 442.1,
   "end": 444.42,
   "text": "اینایی که اشکال به امام می‌کنن و کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 444.42,
   "end": 447.64,
   "text": "پیغمبر داره سيف الإسلام شمشیر زبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 447.64,
   "end": 451.42,
   "text": "امیرالمؤمنین بالاتر از این فرمود از زبیر و من لا اهل البيت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 451.42,
   "end": 455.04,
   "text": "همون چیزی که در مورد سلمان گفت. اما اون وقتی منحرف شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 455.04,
   "end": 458.4,
   "text": "اینا آدم باید بدونه. باید تاریخ اسلام رو خوب مرور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 458.4,
   "end": 462.2,
   "text": "بعد چی شد؟ یا علی زبیر، طلحه جلوی تو ایستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 462.2,
   "end": 465.22,
   "text": "بعضی موقع‌ها اوه، اوه، اوه فلانی هم جلوی رهبر ایستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 465.22,
   "end": 469.76,
   "text": "پس حتما تا نباشد چیزکی مردم ن Go نکنند این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 469.76,
   "end": 473.12,
   "text": "تو اسلام شناسی‌ت ولایت شناسی‌ت دقیق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 473.12,
   "end": 476.02,
   "text": "امیرالمؤمنین فرمود سه چیز اینا رو در مقابل من قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 476.02,
   "end": 479.12,
   "text": "آقا جون اینا رو جدی بگیرم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 479.12,
   "end": 482.82,
   "text": "فرمود تکبر، حسد، حرص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 482.82,
   "end": 485.34,
   "text": "تکبر، حسد، حرص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 485.34,
   "end": 490.7,
   "text": "موت میاد اینا رو قطع کنه. مثلاً فلسفه موته تو روایت پنجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 490.7,
   "end": 494.94,
   "text": "باب اول کتاب الموت مرحوم مجلسی همینو زده این رو-- روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 494.94,
   "end": 499.72,
   "text": "همین رو داره مثل موشک‌های نقطه زن همین رو داره میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 499.72,
   "end": 504.72,
   "text": "ر-- تکبر ریشه، برای همین که تکبر ریشه‌کن بشه اصلاً خدا اینو خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 504.72,
   "end": 508.22,
   "text": "و این ریشه‌ش در شیطانه. می‌خوای شیطانی زندگی کنیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 508.22,
   "end": 512.76,
   "text": "بفرمایین. چرا بعضیا از این حرفای من بدشون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 512.76,
   "end": 515.22,
   "text": "چرا بعضیا به من میگن شما تو نمازخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 515.22,
   "end": 522.24,
   "text": "سمپاشی می‌کنی؟ این سمپاشیه مرام امام‌مون رو بگیم مرام رهبرمون رو بگیم این سمپاشیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 522.24,
   "end": 526.62,
   "text": "اگه کسی شیشه خرد نشده داره چرا ناراحت می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 526.62,
   "end": 532.22,
   "text": "به شیطان حضرت موسی بالاخره پیغمبر کلیم الله دائم در تکلم با خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 532.22,
   "end": 535.02,
   "text": "از اسامی حضرت حق المتکلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 535.02,
   "end": 539.34,
   "text": "من و شما ببخشید من زبانم بسته فقط در دنیا باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.34,
   "end": 541.76,
   "text": "دائم با خدا حرف می‌زد که آی خدا آخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.76,
   "end": 544.02,
   "text": "بابا این شیطانو ببخش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 544.02,
   "end": 546.44,
   "text": "حالا یه خطایی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 546.44,
   "end": 548.72,
   "text": "ب-ببخشش. پیغمبر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 548.72,
   "end": 551.8,
   "text": "مظهر رحمته دیگه. خب بله حرف درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 551.8,
   "end": 554.6,
   "text": "خدا هم چقدر قشنگ فرمود باشه من حرفی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 554.6,
   "end": 558.16,
   "text": "بسم الله. بهش بگو بیاد همین الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 558.16,
   "end": 561.58,
   "text": "بره سجده کنه به قبر آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 561.58,
   "end": 566.16,
   "text": "شیطان مگه نمیگی ببخشش. بره سجده کنه به قبر آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 566.16,
   "end": 570.98,
   "text": "اگر این کارو کرد نه خودشو همه کسایی هم که اغوا کرده من می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 570.98,
   "end": 574.26,
   "text": "جواب شیطان چی باشه خوبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 574.26,
   "end": 578.14,
   "text": "این ملعون إلى الأبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 578.14,
   "end": 582.16,
   "text": "چی گفت؟ کاش می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 582.16,
   "end": 584.34,
   "text": "کاش می‌رفت .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 584.34,
   "end": 587.54,
   "text": "شیطان چی جواب داد؟ گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 587.54,
   "end": 590.64,
   "text": "من اون موقع که تحمل کرد گفت اون موقع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 590.64,
   "end": 592.76,
   "text": "زنده بود من بهش سجده نکردم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 592.76,
   "end": 596.38,
   "text": "الان که مرده تو خاک و تو گوره برم بهش سجده کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 596.38,
   "end": 601.52,
   "text": "ببین نگاهو. باز یه بار دیگه حضرت موسی باز به جوش اومد رحمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 601.52,
   "end": 603.94,
   "text": "اینم بگم و بسه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 603.94,
   "end": 607.5,
   "text": "گفت آخ خدا بابا رحم کن ببخش اینا بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 607.5,
   "end": 611.72,
   "text": "میانجگری کرد. بعدش البته قبلش شیطان اومد با موسی صحبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 611.72,
   "end": 614.5,
   "text": "مفصله وقتتون رو می‌گیره. چی گفت بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 614.5,
   "end": 616.72,
   "text": "بعد موسی دوباره رفت در خونه خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 616.72,
   "end": 619.08,
   "text": "گفت خدایا شیطانو دیگه ببخشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 619.08,
   "end": 623.48,
   "text": "یه غلطی کرد اینا. خدا فرمود باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 623.48,
   "end": 630.94,
   "text": "من حرفی ندارم. همین الان پاشه بیاد جلوی تو اقرار کنه که غلط کرده من هم خودشو و هم همه طرفداراشو می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 630.94,
   "end": 633.06,
   "text": "چی گفته باشه شیطان خوبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 633.06,
   "end": 635.72,
   "text": "این نماد تکبر. أبا استکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 635.72,
   "end": 638.7,
   "text": "می‌دونید چی گفت؟ یه مقدار باز تحمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 638.7,
   "end": 641.28,
   "text": "جالب توجه بعضیا که بدون تحمل حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 641.28,
   "end": 643.28,
   "text": "شیطان هم تحمل می‌کنه حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 643.28,
   "end": 645.3,
   "text": "بعضی‌ها همینطوری قلمو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 645.3,
   "end": 648.48,
   "text": "اِ جسارت کردی برو اداری تا پدرتو دربیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 648.48,
   "end": 651.14,
   "text": "یه ذره تحمل کن، یه صحبت بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 651.14,
   "end": 654.48,
   "text": "دست سرش بکش، پدرانه رفتار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 654.48,
   "end": 657.28,
   "text": "بعد چیکار کرد؟ چی گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 657.28,
   "end": 664.36,
   "text": "گفتش که من هرچی نگاه می‌کنم تو این عالم می‌بینم موسی برو به خدا بگو سر من شلوغ‌تر از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 664.36,
   "end": 669.52,
   "text": "خدا بیاد پیش من. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 669.52,
   "end": 672.1,
   "text": "الله اکبر. آخه ببین چی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 672.1,
   "end": 675.8,
   "text": "این، این یعنی چی؟ آقا این درست بش-- نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 675.8,
   "end": 679.46,
   "text": "این تکبر سر سوزنی اگه در کسی باشه کارش تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 679.46,
   "end": 681.62,
   "text": "تو همین دنیا چه برسه اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 681.62,
   "end": 684.08,
   "text": "موت اومده که این کار دماغ ما رو به خاک بمالونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 684.08,
   "end": 687.94,
   "text": "حالا بسم الله همینجا قبل از اینکه اونجا به خاک بمالون خودت به خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 687.94,
   "end": 691.84,
   "text": "بمالون. أقم الصلاة لذکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 691.84,
   "end": 694.16,
   "text": "دماغتو تو نماز به خاک بمالون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 694.16,
   "end": 699.02,
   "text": "چه جالب وقتی شما در رکوع می‌گی سبحان ربی العظیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 699.02,
   "end": 702.14,
   "text": "چرا تو سجده می‌گی أعلی؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 702.14,
   "end": 706.92,
   "text": "به نظر شما چرا؟ سرشو من از حضرت علامه حائری یزدی علیه الرحمه هدیه کنم به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 706.92,
   "end": 709.48,
   "text": "چرا تو سجده می‌گی أعلی تو رکوع می‌گی عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 709.48,
   "end": 714.92,
   "text": "اینا اسرار عبادته. هر جایی به دست نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 714.92,
   "end": 718.26,
   "text": "آفرین. احسنت. از ما جلوتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 718.26,
   "end": 721.92,
   "text": "چون من از علامه شنیدم شما نشنیده گفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 721.92,
   "end": 724.74,
   "text": ". تو رکوع یه نیمچه‌ای کمرتو شکستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 724.74,
   "end": 727.12,
   "text": "به خاک نیفتادی. می‌گی عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 727.12,
   "end": 729.18,
   "text": "خب؟ نمیگی أعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 729.18,
   "end": 731.5,
   "text": "ولی وقتی افتادی به خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 731.5,
   "end": 736.14,
   "text": "دیگه انگار به مقام شهود، اینقدر نزدیک می‌شی به خدا می‌گی أعلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 736.14,
   "end": 739.06,
   "text": "نمیگی علی، می‌گی أعلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 739.06,
   "end": 744.76,
   "text": "نه چون میفتی به خاک اجازه میدن خدا رو به صفت افعلش صدا بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 744.76,
   "end": 750.86,
   "text": "اینا اسرار عبادته. بدنتو تا به خاک نمالی با موت به خاک می‌مالونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 750.86,
   "end": 755.68,
   "text": "ان‌شاءالله عاقبت بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 755.68,
   "end": 759.14,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}