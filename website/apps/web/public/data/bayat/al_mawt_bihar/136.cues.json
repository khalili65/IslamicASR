 "chapters": [
  {
   "index": 0,
   "title": "## روایت یازدهم؛ اختیار دین ملائکه",
   "start": 3.92,
   "end": 89.54
  },
  {
   "index": 1,
   "title": "## تمثیل چرخ خیاطی؛ قرآن دفترچهٔ لایتنهاهی",
   "start": 89.54,
   "end": 378.61
  },
  {
   "index": 2,
   "title": "## لیعبدون؛ عبودیت و کنه ربوبیت",
   "start": 378.61,
   "end": 710.33
  },
  {
   "index": 3,
   "title": "## فاستبقوا الخیرات؛ دین یعنی ولایت",
   "start": 710.33,
   "end": 880.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 3.92,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.92,
   "end": 9.06,
   "text": "در روایت یازدهم از باب چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.06,
   "end": 14.14,
   "text": "اونجایی که امیرالمؤمنین علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.14,
   "end": 16.74,
   "text": "شوقشون به لقاء الله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.74,
   "end": 22.3,
   "text": "این چنین بیان کردن که قد اختار دین ملائکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.3,
   "end": 26.4,
   "text": "و رسل هی و انبياء. چون خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.4,
   "end": 30.16,
   "text": "اختیار کرد دین ملائکه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.16,
   "end": 34.26,
   "text": "و رسولان و انبیاش رو برای من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.26,
   "end": 36.84,
   "text": "من عاشق دیدارش شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.84,
   "end": 42.7,
   "text": "فهمیدم که اینجا بهترین‌ها رو نصیب من کرده که دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.7,
   "end": 44.66,
   "text": "اولیاء خدا و ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.66,
   "end": 46.4,
   "text": "اونجا هم قطعاً این چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.4,
   "end": 48.64,
   "text": "بهترین‌ها رو برای من در نظر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.64,
   "end": 51.86,
   "text": "نگاه مثبت رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.86,
   "end": 54.6,
   "text": "و البته ما داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.6,
   "end": 57.06,
   "text": "دقت می‌کردیم در متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.06,
   "end": 60.06,
   "text": "حدیث به دین ملائکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.06,
   "end": 62.28,
   "text": "گفتیم این سبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.28,
   "end": 64.34,
   "text": "به ترتب طولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 64.34,
   "end": 70.9,
   "text": "در قوس نزول می‌تونه باشه که دین ملائکه مقدم شده بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.9,
   "end": 73.2,
   "text": "رسولان و انبیا. و چرا ملائکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.2,
   "end": 80.62,
   "text": "بحث کردیم که دین، دین عقلی‌ست چون ملائکه عقول‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.62,
   "end": 82.7,
   "text": ". و حالا می‌خوایم به خود دین بپردازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.7,
   "end": 86.26,
   "text": "اصلاً دین چرا دین ملائکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.26,
   "end": 89.54,
   "text": "اصلاً اینجا منظور از دین چی می‌تونه باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.54,
   "end": 92.92,
   "text": "اولاً حضرت علامه حزن زاده علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 92.92,
   "end": 99.78,
   "text": "جلسه‌ی پانزدهم شرح مصباح العنس مرحوم ابن فناری فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.78,
   "end": 102.02,
   "text": "مثلاً مثال زدند برای فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 102.02,
   "end": 107.16,
   "text": "بهتر دین که گفتم مثال یه چرخ خیاطی رو زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.16,
   "end": 110.92,
   "text": "فرمودند که چرخ خیاطی وقتی شما می‌خری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.92,
   "end": 115.86,
   "text": "نسبت به اینکه این چرخ خیاطی ظریف دوزه یا ضخیم دوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 115.86,
   "end": 119.82,
   "text": "صنعتی هرچی هست یه دفترچه‌ای همراه خودش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.82,
   "end": 125.66,
   "text": "و تو اون دفترچه لحاظ شده، بیان شده که آقا چگونه با این چرخ خیاطی رفتار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.66,
   "end": 129.8,
   "text": "کی روغنش بزن، کی چقدر ازش کار بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.8,
   "end": 132.98,
   "text": "آیا می‌تونی با این چرم هم بدوزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.98,
   "end": 135.48,
   "text": "مثلاً پارچه‌های زمخت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.48,
   "end": 138.7,
   "text": "خشن بدوزی یا فقط ظریف بافه به چه صورت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.7,
   "end": 142.24,
   "text": "این‌ها همه این‌ها چیزی که در اون دفترچه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.24,
   "end": 146.94,
   "text": "به اون دفترچه علامه فرمودند که میگن دین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.94,
   "end": 151.32,
   "text": "چرخ خیاطی. توجه شدید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.32,
   "end": 156.34,
   "text": "حالا دین ما به یک معنا در یک دفترچه‌ای اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.34,
   "end": 159.42,
   "text": "که نهض القرآن يهدي للتي هي أقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.42,
   "end": 163.9,
   "text": "اون قرآنه. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.9,
   "end": 169.66,
   "text": "دفترچه‌ی چرخ خیاطی یکی دو برگه و خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.66,
   "end": 173.98,
   "text": "سطحی و انتهاش هم مشخصه، ابتداش هم مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.98,
   "end": 178.28,
   "text": "اما قرآن لا یتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.28,
   "end": 182.86,
   "text": "چون انسان وجودش لا یتناهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.86,
   "end": 186.48,
   "text": "قراره نفس ناطقه بر اساس اون پرورش پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.48,
   "end": 194.86,
   "text": "حالا اینجا که می‌فرمود امیرالمؤمنین علیه الصلاة والسلام فرمودند که من دیدم خدا دین ملائکه‌ش رو به من داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.86,
   "end": 200.22,
   "text": "یعنی اینکه اون، منظور اون چیزی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.22,
   "end": 207.76,
   "text": "سعادت ابدی من بود و من رو به، به اون انتها، منتها الیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.76,
   "end": 211.22,
   "text": "الیه راجعون می‌شه، إلا الله راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.22,
   "end": 213.84,
   "text": "به الله می‌رسونه، به من بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.84,
   "end": 219.0,
   "text": "اون که به خودش می‌رسونه. اگه ما قرار بود تو بهشت بمونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.0,
   "end": 226.44,
   "text": "و حالا به صورت متداول و ظاه-ظاهری و متعارف عرض می‌کنیم مثلاً حضرت آدم همون گلابی، از اون سیب هرچی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.44,
   "end": 230.24,
   "text": "گندم هرچه درخت ممنوعه نمی‌خورد ما تو بهشت می‌موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.24,
   "end": 234.96,
   "text": "اونجا دیگه چی می‌شد؟ جنت ذاتی در کار نبود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.96,
   "end": 237.68,
   "text": "چرا ما اومدیم اینجا؟ برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.68,
   "end": 240.64,
   "text": "به جنت ذات برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.64,
   "end": 244.6,
   "text": "ادخلی فی عبادی و ادخلی جنتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.6,
   "end": 252.14,
   "text": "بریم تو اون جنتی، اون یا حضرت امام فرمودند که اینجا یعنی جنت من یعنی بهشت ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.14,
   "end": 254.88,
   "text": "همش سیب و گلابی بود اگه می‌موندیم اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.88,
   "end": 258.04,
   "text": "کلوا منها حيث شئتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.04,
   "end": 261.66,
   "text": "حيث رغد شئتم. هرچی می‌خواید ازش بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.66,
   "end": 264.7,
   "text": "این بود. اما نه، اومدیم اینجا برای اینکه به اون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.7,
   "end": 269.6,
   "text": "این می‌شه این دین ما. یعنی بهترین چیز رو خدا به ما بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.6,
   "end": 272.76,
   "text": "امیرالمؤمنین فرمود پس چرا من عاشق همچین کسی نباشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.76,
   "end": 276.22,
   "text": "که اون ور هم قطعاً بهترین‌ها رو برای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.22,
   "end": 279.76,
   "text": "منظور کرده. حالا در خصوص دین داریم تو این جلسه صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.76,
   "end": 284.0,
   "text": "علامه شهرانی یه کتاب شیرینی دارند به نام نصر توبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.0,
   "end": 287.66,
   "text": "ذیل این آیه‌ای که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.66,
   "end": 292.16,
   "text": "عرض کردیم بحث دین رو مطرح می‌کنه، اینجا می‌فرماید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.16,
   "end": 295.98,
   "text": "نظر علامه است. دین به نظر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.98,
   "end": 300.1,
   "text": "خود مقصود ذاتیست از خلقت انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.1,
   "end": 304.18,
   "text": "به این میگن دین. اصلاً چرا خدا انسان رو خلق کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.18,
   "end": 310.54,
   "text": "برای چی؟ اون قصد نهایی خدا می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.54,
   "end": 315.56,
   "text": "دین ما. حالا اون قصد نهایی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.56,
   "end": 318.46,
   "text": "گفتند تشبه به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.46,
   "end": 321.84,
   "text": "تشبه به الله پیدا کردن قصد نهاییه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.84,
   "end": 324.26,
   "text": "که اصطلاحاً بهش میگن عبادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.26,
   "end": 329.96,
   "text": "عبودیت. اون که فرمود العبودیه جوهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.96,
   "end": 333.18,
   "text": "کنه الربوبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.18,
   "end": 336.24,
   "text": "چه حرف‌ها بزرگان پیاده کردن اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.24,
   "end": 341.22,
   "text": "اولاً که خود قرآن می‌فرماید که وما خلقت الجن والانس الا ليعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.22,
   "end": 344.56,
   "text": "اینجا نظر علامه شهرانی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.56,
   "end": 348.52,
   "text": "می‌گه اون مقصود ذاتی از خلقت هرچی هست اون دین ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.52,
   "end": 352.4,
   "text": "تو این آیه می‌فرماید ما خلق نکردیم این‌ها رو مگر برای عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.4,
   "end": 354.9,
   "text": "پس مقصود نهایی عبودیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.9,
   "end": 359.64,
   "text": "اما اینجا توی این روایت شریف که می‌تونید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.64,
   "end": 363.72,
   "text": "از شاید مجامع روایی خوبمون ببینیدش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.72,
   "end": 366.06,
   "text": "می‌فرماید العبودیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.06,
   "end": 370.39,
   "text": "جوهره کنه الربوبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.39,
   "end": 373.21,
   "text": "خب این کنهُ الربوبیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.21,
   "end": 380.33,
   "text": "یعنی چی؟ عبودیت گفتیم ما برای عبادت خلق شدیم که دین ما اونه از نظر علامه شهرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.33,
   "end": 384.01,
   "text": "حالا کنهش ربوبیت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.01,
   "end": 386.79,
   "text": "دین. داریم میگیم عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.79,
   "end": 395.11,
   "text": "درست شد؟ حالا اینجا میگه عبادت جوهره ایست که کنهش یعنی باطنش یعنی ذاتش ربوبیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.11,
   "end": 399.33,
   "text": "این یعنی چی؟ که برسیم به اون که حالا تا بفهمیم دین چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.33,
   "end": 401.77,
   "text": "اجازه بدید یکی دو تا نظر عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.77,
   "end": 408.29,
   "text": "امام علیه الرحمه، حضرت امام خمینی اینطوری می فرمایند که در، در هم در تبیین العبودیه جوهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.29,
   "end": 410.29,
   "text": "این متن فرمایش حضرت امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.29,
   "end": 415.45,
   "text": "همانگونه که انسان در ظاهر بندگی می‌کند العبودیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.45,
   "end": 419.07,
   "text": "عبادت می‌کنه ظاهر. مثل الان شما اینجا نماز خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.07,
   "end": 422.69,
   "text": "در ظاهر بندگی می‌کند و مدعی عبودیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.69,
   "end": 425.55,
   "text": "در سر نیز باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.55,
   "end": 428.49,
   "text": "عبودیت کند تا عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.49,
   "end": 432.05,
   "text": "سری قلبی به اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.05,
   "end": 435.23,
   "text": "جوارحی نیز سرایت کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.23,
   "end": 441.89,
   "text": "جوارحی یعنی از اون جوانحش اون باطنش برسه به جوارحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.89,
   "end": 446.31,
   "text": "و عمل و قول و نقشه باطن و سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.31,
   "end": 454.57,
   "text": "باشد و حقیقت عبودیت به اجزای وجود چه اجزای باطنی، چه اجزای ظاهری این‌ها سرایت پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.57,
   "end": 461.99,
   "text": "حضرت امام اینطوری تعبیر می‌کنه از اینکه کنهُ الربوبیت یعنی اون عبودیت ظاهری بیاد به سرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.99,
   "end": 467.69,
   "text": "بیاد به باطنت. یعنی باطنتو خالصاً مخلصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.69,
   "end": 469.97,
   "text": "عبادت حضرت حق رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.97,
   "end": 472.83,
   "text": "اینجوری تعبیر کرده حضرت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.83,
   "end": 475.45,
   "text": "خب نظر قشنگی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.45,
   "end": 480.11,
   "text": "اما بعضیا فرمودن که اون کنهُ الربوبیت مثلا نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.11,
   "end": 483.03,
   "text": "مرحوم جورجانی رو با هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.03,
   "end": 485.65,
   "text": "ببین چقدر شیرینه. البته مست خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.65,
   "end": 490.17,
   "text": "مستوفی و مبسوط من بخشیشو براتون می‌خونم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.17,
   "end": 493.21,
   "text": "اینکه این کنهُ الربوبیت یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.21,
   "end": 495.87,
   "text": "ایشون فرموده که عبودیت مثل آهن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.87,
   "end": 499.83,
   "text": "مثالی زده همه می‌فهمید. عبودیت رو آهن بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.83,
   "end": 504.71,
   "text": "و ربوبیت که آن را جذب می‌کند آهنرباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.71,
   "end": 508.41,
   "text": "یعنی چی باعث می‌شه که آهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.41,
   "end": 511.01,
   "text": "این جواره‌تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.01,
   "end": 515.13,
   "text": "حرکت کنه. اون جوانحتو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.13,
   "end": 517.97,
   "text": "جوارح رو حرکت میده. اون آهنربائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.97,
   "end": 523.25,
   "text": "آهن رو حرکت میده. که چون با استکان سنخیت ندارد آن را جذب نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.25,
   "end": 525.55,
   "text": "چرا آهنربا سنخیتو جذب نمی‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.55,
   "end": 532.73,
   "text": "چون باهاش سنخیت نداره. در عبودیت استغنا و بقا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.73,
   "end": 535.29,
   "text": "اما در ربوبیت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.29,
   "end": 538.59,
   "text": "یعنی اصل عبادت ما بر مبنای فقر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.59,
   "end": 543.91,
   "text": "اما این عبادت که بر مبنای فقر ما رو می‌بره تا کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.91,
   "end": 546.99,
   "text": "تا فنای فالله که بقا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.99,
   "end": 551.13,
   "text": "پیش داره و اون دیگه استغنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.13,
   "end": 553.49,
   "text": "ادامه فرمایش مرحوم جورجانی رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.49,
   "end": 558.69,
   "text": "عبودیت این استعداد را دارد که مظهر ربوبیت شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.69,
   "end": 562.75,
   "text": "عجب! یعنی بنده می‌تونه مظهر رب بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.75,
   "end": 566.81,
   "text": "بله. بنده می‌تونه مظهر رب مطلق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.81,
   "end": 572.95,
   "text": "حالا فرموده که آنچه در ربوبیت مخفیست که با چشم ظاهری نمی‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.95,
   "end": 576.61,
   "text": "از ربوبیت می‌آید و به عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.61,
   "end": 581.03,
   "text": "می‌رسد. هرچی هست سیر سر ربوبیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.03,
   "end": 583.63,
   "text": "از اونجا میاد به عبودیت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.63,
   "end": 588.27,
   "text": "بعد ایشون می‌بره میره انتهاش می‌رسونه به بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.27,
   "end": 591.75,
   "text": "مثل، مثل آتش و آهن گداخته رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 591.75,
   "end": 593.97,
   "text": "میگه آهن گداخته رو می‌ذاری تو آتیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.97,
   "end": 598.17,
   "text": "دیگه فوران آتش یه کاری می‌کنه این آهن گداخته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.17,
   "end": 600.47,
   "text": "آهن هم مثل آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.47,
   "end": 603.41,
   "text": "پر از شعله و گرما و داغیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.41,
   "end": 606.97,
   "text": "درسته؟ اما آهن که آتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.97,
   "end": 609.29,
   "text": "مثل آتش از خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.29,
   "end": 612.55,
   "text": "فوران آتش. مثال این رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.55,
   "end": 617.05,
   "text": "میگه که ربوبیت رو بگیر آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 617.05,
   "end": 622.13,
   "text": "عبودیت رو بگیر اون آهنه که داره آهن گداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.13,
   "end": 624.37,
   "text": "میگه هرچی هست سیر سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 624.37,
   "end": 631.49,
   "text": "ربوبیت و بنده از مسیر عبودیت می‌تونه بره، بره، بره به جایی برسه عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.49,
   "end": 633.57,
   "text": "به جایی برسه که مثل خدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.57,
   "end": 636.87,
   "text": "شبیه حضرت حق بشه. تشبه به الله یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 636.87,
   "end": 640.61,
   "text": "کارهای الهی بکنه. تصرف در ماده کائنات بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 640.61,
   "end": 650.17,
   "text": "که عرض کردیم یعنی همین. تصرف در ماده کائناتم دیگه نسبت به صعه وجودی هر کسی قربونتون برم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.17,
   "end": 653.69,
   "text": "هر کسی نسبت به صعه وجودیش می‌تونه تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.69,
   "end": 657.83,
   "text": "حالا این دین رو در جای جای مختلف قرآن بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.83,
   "end": 660.07,
   "text": "چند تا مثلا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.07,
   "end": 663.49,
   "text": "رفرنس بدم خدمتتون از آیات برید ملاحظه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.49,
   "end": 666.37,
   "text": "مثل آیه صد و چهل و هشت سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.37,
   "end": 670.29,
   "text": "\"ولکل وجهة هو مولیها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.29,
   "end": 673.55,
   "text": "فرمود که برای هر امتی یه قبله‌ای قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 673.55,
   "end": 675.89,
   "text": "کی؟ هو. همون قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 675.89,
   "end": 678.43,
   "text": "هو الله احد. اون هو او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 678.43,
   "end": 683.03,
   "text": "برای هر که هر امتی، هر ملتی یه قبله‌ای قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 683.03,
   "end": 686.11,
   "text": "یعنی یه دینی قرار داده. اون تعیین کرده این دین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 686.11,
   "end": 688.71,
   "text": "حالا فرمود \"فاسبق الخیرات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 688.71,
   "end": 691.77,
   "text": "چه جالب! این \"فاسبق الخیرات\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 691.77,
   "end": 698.13,
   "text": "حالا که داریم واکاوی می‌کنیم بریم یه لحظه ورق بزنیم لایه‌های پا، باطنی‌ترشم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 698.13,
   "end": 702.79,
   "text": "در تفسیر اهل بیت دیدم جلد یک صفحه هفتصد و بیست و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 702.79,
   "end": 705.91,
   "text": "در کتاب شریف تأویل آیات ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 705.91,
   "end": 710.33,
   "text": "هست که یه جلد خیلی قشنگ و خوبی هم اخیرا چاپ شده من از مشهد خریدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 710.33,
   "end": 714.15,
   "text": "از امیرالمؤمنین می‌فرماید این \"فاسبق الخیرات\" چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 714.15,
   "end": 716.13,
   "text": "به چی، به این خیرات سبقت بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 716.13,
   "end": 720.55,
   "text": "به چی باید سبقت بگیریم؟ مولا فرمود \"هیه الاسلام والولایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 720.55,
   "end": 723.31,
   "text": "فاسبق الخیرات ای الیها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.31,
   "end": 728.09,
   "text": "\"فاسبق الخیرات\" یعنی به سمت اسلام و به ولایت سبقت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.09,
   "end": 730.89,
   "text": "برید به سمت اسلام و ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 730.89,
   "end": 735.97,
   "text": "پس دین یعنی اسلام \"إن الدين عند الله الإسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 735.97,
   "end": 740.83,
   "text": "اسلام چیه؟ ولایت. یعنی به سمت ولایت کلیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 740.83,
   "end": 742.73,
   "text": "یعنی به سمت امام زمانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 742.73,
   "end": 745.69,
   "text": "سبقت بگیر، فرار کن، حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 745.69,
   "end": 747.67,
   "text": "بعد ادامه آیه خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 747.67,
   "end": 752.83,
   "text": "\"أينما تكونوا\" هر جا باشید \"يأْتِ بِكُمُ اللهُ جَميعًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 752.83,
   "end": 757.59,
   "text": "إِنَّ اللهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ\" هر کجا باشید خدا شما رو جمع می‌کنه، میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 757.59,
   "end": 762.47,
   "text": "خب این یعنی چی؟ خدا رحمت کنه حضرت عبدالعظیم حسنی رو که در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 762.47,
   "end": 767.23,
   "text": "کمال الدین جلد دو صفحه سیصد و هفتاد و هفت این روایت وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 767.23,
   "end": 770.07,
   "text": "از این راوی عظیم الشأن، مرحوم حضرت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.07,
   "end": 775.45,
   "text": "عبدالعظیم حسنی. از امام جواد روایت میاره که مستقیم از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 775.45,
   "end": 779.59,
   "text": "اخذ کرده این روایت که این \"يأْتِ بِكُمُ اللهُ جَميعًا\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.59,
   "end": 782.03,
   "text": "هر کجا باشید خدا شما رو جمع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 782.03,
   "end": 785.47,
   "text": "امام جواد به حضرت عبدالعظیم حسنی فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 785.47,
   "end": 790.27,
   "text": "منظور اون روزی‌ست که سیصد به عدد اصحاب بدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 790.27,
   "end": 799.49,
   "text": "سیصد و سیزده نفر جمع میشن، ده هزار مرد جنگی هم به کمکشون میان تا مقدمات ظهور آماده بشه که حضرت تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 799.49,
   "end": 802.35,
   "text": "یعنی ببینید همه میرن به سمت او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 802.35,
   "end": 805.71,
   "text": "چرا؟ یعنی اصلاً انتها اوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 805.71,
   "end": 810.49,
   "text": "همه جمع میشن مخلص آدما، چکیده و زبده آدما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 810.49,
   "end": 813.49,
   "text": "خامه آدما جمع میشن بهترین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 813.49,
   "end": 815.73,
   "text": "که یکی بیاد. چرا او باید بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 815.73,
   "end": 817.37,
   "text": "و چرا همه به سمت او میرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 817.37,
   "end": 820.85,
   "text": "چون اون دینه. اصلاً دین یعنی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.85,
   "end": 823.63,
   "text": "پس الان فهمیدیم این دین ملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 823.63,
   "end": 826.53,
   "text": "اصلاً ملائکه جنسشون ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 826.53,
   "end": 828.75,
   "text": "عقولن. اصلاً عقل یعنی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 828.75,
   "end": 830.89,
   "text": "یعنی علم. یعنی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 830.89,
   "end": 833.59,
   "text": "هرچه بیشتر عالمی، عاقلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.59,
   "end": 837.29,
   "text": "ولایت بیشتری. من ولایت ندارم که ادعا نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 837.29,
   "end": 841.05,
   "text": "علمت چقدره؟ اندیشت چه وزنی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 841.05,
   "end": 843.15,
   "text": "چه مقدار از ولایت اخذ کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 843.15,
   "end": 845.61,
   "text": "یعنی چقدر معرفت داری؟ چقدر علم داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.61,
   "end": 847.37,
   "text": "به همون میزان قرب پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 847.37,
   "end": 849.19,
   "text": "اصلاً ولایت یعنی قرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 849.19,
   "end": 855.85,
   "text": "یعنی تشبه به الله و هر میزان این شباهت بیشتره تو ولایت بیشتری داری لذا به امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 855.85,
   "end": 859.87,
   "text": "زمانت نزدیک‌تری لذا می‌تونی نائب امام زمانت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 859.87,
   "end": 862.61,
   "text": "کسی مگه می‌تونه نائب آقا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 862.61,
   "end": 865.37,
   "text": "تا نزدیک‌تر از هر کسی به او نباشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 865.37,
   "end": 868.81,
   "text": "یعنی شبیه‌ترین آدم‌ها به او میشن نائب آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 868.81,
   "end": 875.37,
   "text": "چه خواست چه آم. ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 875.37,
   "end": 880.83,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}