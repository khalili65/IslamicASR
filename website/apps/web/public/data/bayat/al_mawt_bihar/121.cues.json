   "start": 149.18,
   "end": 221.8
  },
  {
   "index": 1,
   "title": "## نکتهٔ سوم؛ علم و تعظیم عالم",
   "start": 221.8,
   "end": 301.18
  },
  {
   "index": 2,
   "title": "## سختی قدما؛ مقدس اردبیلی",
   "start": 301.18,
   "end": 456.82
  },
  {
   "index": 3,
   "title": "## نانوای باب القبله و چوب‌خط",
   "start": 456.82,
   "end": 635.7
  },
  {
   "index": 4,
   "title": "## صلهٔ شاعر سجادیه و حساب هیئت",
   "start": 635.7,
   "end": 804.37
  },
  {
   "index": 5,
   "title": "## معلم سورهٔ حمد و صلهٔ زر",
   "start": 804.37,
   "end": 909.63
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.44,
   "end": 5.32,
   "text": "الله ま ま محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.32,
   "end": 8.92,
   "text": "رجب محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 14.86,
   "text": "الله الله على محمد وال محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.86,
   "end": 18.34,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.34,
   "end": 22.16,
   "text": "السلام علیک یا دعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.16,
   "end": 27.96,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.96,
   "end": 29.92,
   "text": "یه نکته‌ی دیگه‌ای من امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.92,
   "end": 34.42,
   "text": "در ادامه‌ی موضوع روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.42,
   "end": 38.1,
   "text": "نهوم از باب چهارم کتاب الموت عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.1,
   "end": 43.2,
   "text": "چون مورد سؤال شد و الا می خواستیم روایت دهم رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.2,
   "end": 47.1,
   "text": "سؤال این بود که در چه موردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.1,
   "end": 50.18,
   "text": "حالا یه کسی می‌خواد ببخشه، می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.18,
   "end": 53.68,
   "text": "بخشش کنه، در چه موردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.68,
   "end": 56.12,
   "text": "بهتره، افضله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.12,
   "end": 60.16,
   "text": "توصیه ها بیشتره، ترجیحشو در چه موردی قرار بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.16,
   "end": 67.64,
   "text": "این همه مورد خرج کرد و هزینه در راه خیر الی ماشاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.64,
   "end": 74.58,
   "text": "اولاً که این سؤال رو به صورت کلی ما طی طبق سیر بحث جواب دادیم، بهتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.58,
   "end": 76.8,
   "text": "خرج باطن کنه تا ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.8,
   "end": 85.96,
   "text": "این رو عرض کردیم. امروز عرض می‌کنیم که حالا از اون در مسیر باطن خرج کردن باز خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.96,
   "end": 89.64,
   "text": "بخوایم موضوع بدیم، یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.64,
   "end": 94.44,
   "text": "یعنی یکی که نه طبق باز اونچه که ما عرض کردیم در ط--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.44,
   "end": 97.46,
   "text": "طی صحبت‌هامون در چند جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.46,
   "end": 102.68,
   "text": "طبق روایات بالاترین جا در خرج کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.68,
   "end": 106.26,
   "text": "پول در مسیر امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.26,
   "end": 109.54,
   "text": "هر چیزی که ختم به حضرت بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.54,
   "end": 113.9,
   "text": "هر چیزی که حالا مواردش باز مصادیقش زیادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.9,
   "end": 118.38,
   "text": "الان مثلاً اربعین با توجه به اینکه فریاد حضرت وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.38,
   "end": 129.44,
   "text": "ظهور هست که عرض کردیم که اباعبدالله جهانی می‌شه و هر کسی الان خرج اربعین کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.44,
   "end": 132.44,
   "text": "کأنَّه خرج ظهور حضرت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.44,
   "end": 136.86,
   "text": "این موکب‌ها یا ضیا-- زائر فرستادن و این‌ها در همین مسیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.86,
   "end": 140.1,
   "text": "هر کاری که در مسیر امام عصر باشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.1,
   "end": 146.02,
   "text": "جبهه‌ای، کانونی، مسجدی، هیئتی، نشریه‌ای، کتابی، چیزی که در خصوص حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.02,
   "end": 149.18,
   "text": "داره تلاش می‌کنه آدم حمایت مالیش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.18,
   "end": 154.02,
   "text": "بعد از اون قرآنه. مثلاً در یک جنگی روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.02,
   "end": 160.8,
   "text": "پیغمبر عزیز عالم پرچم رو از دست یکی گرفت داد به دست یه جوونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.8,
   "end": 164.38,
   "text": "سؤال شد که یا رسول الله علتش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.38,
   "end": 171.82,
   "text": "شما پرچم رو عوض کردی در اثنای جنگ فرمودن این جوونی که پرچم رو دستش دادم یه سوره قرآن بیشتر از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.82,
   "end": 175.72,
   "text": "حفظ بود. یعنی افضل بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.72,
   "end": 178.26,
   "text": "کسی که قرآن رو بیشتر اهتمام داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.26,
   "end": 180.54,
   "text": "یعنی این خودش مسئله‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.54,
   "end": 187.5,
   "text": "در مسیر قرآن انسان خرج کنه باز ان-- قرآن هم که شرح کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.5,
   "end": 190.92,
   "text": "وجود انسان کامله که بحث‌هاش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.92,
   "end": 192.84,
   "text": "باز در مسیر انسان کامل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.84,
   "end": 198.74,
   "text": "در مسیر قرآن، پژوهش‌ها، تفحص‌ها، کتاب‌ها، جلسات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.74,
   "end": 202.76,
   "text": "حفظ قرآن، تجوید قرآن، مفاهیم قرآن او الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.76,
   "end": 205.44,
   "text": "ما شاء الله. در این مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.44,
   "end": 208.26,
   "text": "راه‌های خرج کردن داره آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.26,
   "end": 217.0,
   "text": "حمایت کنه از این تشکل‌ها، از این نشریه‌ها، از این کتاب‌ها، از این کانال‌ها، از این سایت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.0,
   "end": 221.8,
   "text": "تا می‌تونه. اینم یه راهه تا در حد خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.8,
   "end": 224.88,
   "text": "و نکته‌ی سوم علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.88,
   "end": 228.18,
   "text": "در مسیر علم انسان خرج کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.18,
   "end": 231.36,
   "text": "علم رو، عالم رو تعظیم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.36,
   "end": 233.62,
   "text": "این خیلی مهمه. اصلاً چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.62,
   "end": 239.3,
   "text": "شما خمس و و-ووجوهاتون و این‌ها رو می‌برید دست یه عالم دینی می‌دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.3,
   "end": 242.2,
   "text": "چرا به دکتر مهندس نمی‌دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.2,
   "end": 246.3,
   "text": "ما خودمون خیریه‌ای که داریم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.3,
   "end": 249.68,
   "text": "اون برکاتیش که عملاً وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.68,
   "end": 257.5,
   "text": "گود میدان عمل ما دیدیم پول رو دیگران می‌دن اما توسط کسی که لباس پیغمبر تنشه تقسیم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.5,
   "end": 259.96,
   "text": "مستقیم خیر-- فیضش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.96,
   "end": 266.36,
   "text": "خیرش و تبلیغش به این لباس و به دین و به پیغمبر و این‌ها بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.36,
   "end": 269.6,
   "text": "خیلیا بودن که ما رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.6,
   "end": 273.78,
   "text": "هبه و هدیه و منحت دیگران رو بهشون رسوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.78,
   "end": 279.34,
   "text": "پول از من نبوده اما وقتی که من تو لباس پیغمبرم مثلاً میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.34,
   "end": 283.04,
   "text": "برای همیشه این تو ذهنش با-- خیلی شنیدیم گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.04,
   "end": 287.54,
   "text": "که اصلاً نه مثل اینکه اصلاً نظرشون در مورد آخوندها عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.54,
   "end": 293.14,
   "text": "این لباس، این لباس پیغمبر شخص من که مهم نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.14,
   "end": 297.76,
   "text": "یعنی خودش تعظیم شعائره، تعظیم دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.76,
   "end": 301.18,
   "text": "انسان خرج علم و اهل علم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.18,
   "end": 303.58,
   "text": "مثلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.58,
   "end": 307.48,
   "text": "خاطرات علامه ملا محسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.48,
   "end": 311.58,
   "text": "امین نوشتن که در نجف وقتی قحطی بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.58,
   "end": 319.08,
   "text": "ایشون هم تحت شرایط بالاخره به سختی، علمای قدیم سختی می‌کشیدن به یه جایی برسن مثل الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.08,
   "end": 322.08,
   "text": "این‌ها نبود خیلی. الان زندگی‌ها خیلی راحت‌تر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.08,
   "end": 325.28,
   "text": "قدیم واقعاً بیچاره می‌شدن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 325.28,
   "end": 331.24,
   "text": "با اون چراغ موشی‌های قدیم و حجره‌های نمور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.24,
   "end": 334.74,
   "text": "الان وارد بعضی حجره‌های حوزه علمیه که می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.74,
   "end": 341.38,
   "text": "ت-- مثلاً مات و مبهوت این کنده کاری و آینه‌کاری و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.38,
   "end": 344.14,
   "text": "سنگ و چی و ایناش می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.14,
   "end": 348.6,
   "text": "اون موقع اینطوری نبود که. حالا این علامه ملا محسن امین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.6,
   "end": 351.22,
   "text": "انقدر گرفتار مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 351.22,
   "end": 354.78,
   "text": "مالی شده بود. اینا کسایی بودن که علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.78,
   "end": 357.04,
   "text": "کیمیا داشتن بَل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.04,
   "end": 361.14,
   "text": "بلکه بعضیشون کل حُسر رو داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.14,
   "end": 363.48,
   "text": "کیمیا و لیمیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.48,
   "end": 366.54,
   "text": "هیمیا و سیمیا و ریمیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.54,
   "end": 369.9,
   "text": "این خمسه علم علوم خمسه که همه توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.9,
   "end": 374.18,
   "text": "همه چی توشه. شما اراده کنی می‌تونی پولدارترین آدم رو زمین بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.18,
   "end": 377.52,
   "text": "کاری نداره. مثلا مرحوم محت-- مقدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.52,
   "end": 382.72,
   "text": "مقدس اردبیلی این بزرگوار دیگه شنیدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.72,
   "end": 391.4,
   "text": "شب اومد از چاه آب بکشه بیرون، دلقو انداخت آبو که بکشه بیرون نیمه شب وضو بگیره برای نماز شبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.4,
   "end": 393.24,
   "text": "دید پر سکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.24,
   "end": 395.32,
   "text": "خدا خواست دیگه امتحانش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.32,
   "end": 397.94,
   "text": "پر سکه و طلا اومد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.94,
   "end": 401.3,
   "text": "من بودم، شما بودم، شما بودید چی می‌گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.3,
   "end": 405.0,
   "text": "می‌گفتیم به به دیگه بریم باهاش حسینیه رو بسازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.0,
   "end": 408.0,
   "text": "هم نماز شب نخونده حاجت گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.0,
   "end": 410.28,
   "text": "ایشون دلقو برگردوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.28,
   "end": 411.9,
   "text": "دل خیلی باید بزرگ باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.9,
   "end": 414.18,
   "text": "اینا در حرف آسونه. قربونت برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.18,
   "end": 418.8,
   "text": "ما هزار و یک توجیه علمی و معنوی و دینی هم براش درست می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.8,
   "end": 422.08,
   "text": "نه خالی کرد. بار دوم باز طلا اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.08,
   "end": 424.64,
   "text": "بار سوم باز سکه اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.64,
   "end": 426.64,
   "text": "با خدا دعواش کش-- دعواش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.64,
   "end": 431.28,
   "text": "گفت بابا احمد از تو آب برای نماز می‌خواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.28,
   "end": 433.58,
   "text": "نه برای دنیاش طلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.58,
   "end": 436.38,
   "text": "ببین نگاه و اینا اینطوری بودن باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.38,
   "end": 439.48,
   "text": "البته یکی از بزرگان اشکالی داشت به این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.48,
   "end": 442.5,
   "text": "می‌گفت اونجا جز خدا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.5,
   "end": 445.5,
   "text": "احمد مقدس اردبیلی کسی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.5,
   "end": 448.18,
   "text": "این قصه چجوری درش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.18,
   "end": 450.76,
   "text": "دیگران فهمیدند. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.76,
   "end": 453.74,
   "text": "یه اشکال جالبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.74,
   "end": 456.82,
   "text": "بماند. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.82,
   "end": 460.24,
   "text": "بحث چی بود؟ بحث ملا محسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.24,
   "end": 466.64,
   "text": "سید ملا محسن امین. خب گرفتار مشکلات مالی در عین داشتن اینجور علوم شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.64,
   "end": 471.58,
   "text": "تحمل می‌کردن. بعد شنیدن که انقدر البته نون نمی‌تونست‌شون بخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.58,
   "end": 475.1,
   "text": "شنیدن که باب القبله‌ امیرالمؤمنین ان‌شاءالله قسمتش رو بریم نجف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.1,
   "end": 478.22,
   "text": "یه نونوایی هست به نام حاج احمد ایرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.22,
   "end": 480.72,
   "text": "فقط به طلبه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.72,
   "end": 483.6,
   "text": "اهل علم نون نسیه می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.6,
   "end": 486.1,
   "text": "ایشون رفت نوبتش شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.1,
   "end": 492.32,
   "text": "گفت دیگه لباس پیغمبر هم که تنش بود گفت \"نسیه می‌خوام.\" گفت \"بفرما.\" یه چوب، یه چوب بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.32,
   "end": 497.92,
   "text": "چوب خط می‌گن قدیما. هر نونی که بهش می‌داد، یه خط می‌کشید رو این چوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.92,
   "end": 501.32,
   "text": "گفت همرات باشه همیشه. یه مدتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.32,
   "end": 505.04,
   "text": "ایشون همراهش بود. چند روز هی می‌رفت نون می‌گرفت، خط می‌کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.04,
   "end": 511.3,
   "text": "چوبه رو گم کرد یه روز. بنده خدا علامه امین مونده بود چه‌کنه حالا بره این داد نزنه سرش بیچاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.3,
   "end": 514.1,
   "text": "رفت و گفت \"من چوبه گم کردم.\" گفت \"عیب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.1,
   "end": 518.84,
   "text": "حدس می‌زنی چقدر بوده؟\" گفت \"یادم نیست.\" گفت \"حالا حدس می‌زنی چند تا بوده؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.84,
   "end": 521.9,
   "text": "گفت \"حدس می‌زنم مثلا بیست تا چوب خط بوده.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.9,
   "end": 527.92,
   "text": "یه چوب جدید برداشت بیست تا روش خط کشید داد دستش گفت \"مراقب باش دیگه گم نکنی ملا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.92,
   "end": 530.12,
   "text": "هر روز بهش چی کار می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.12,
   "end": 531.86,
   "text": "نون نسیه می‌داد. اینطوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.86,
   "end": 535.88,
   "text": "فقطم به طلبه‌ها. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.88,
   "end": 538.7,
   "text": "دعب قدیمی‌ها بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.7,
   "end": 541.32,
   "text": "سعی می‌کردن به اهل علم، یعنی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 541.32,
   "end": 546.88,
   "text": "حتی در امام جماعت می‌دونستید اگر دو تا امام جماعت اینجا دعواشون شده می‌خوان جلو وایسن، یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.88,
   "end": 550.92,
   "text": "نه лучше بهتره بگیم شما دعواتون شده به کی اقتدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.92,
   "end": 555.88,
   "text": "؟ که حالا هر دوشون از حیث تقوا توی حدودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.88,
   "end": 559.24,
   "text": "از حیث مثلا ا-عدالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.24,
   "end": 562.98,
   "text": "توی حدودن، یه حدی‌ن، حدی‌ن مثلا مثل همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.98,
   "end": 568.54,
   "text": "خیلی تفاوت ندارن. منتها یکیشون سیده، یکیشون علمش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 568.54,
   "end": 573.5,
   "text": "نظر شما به کو- کدوم افضله که باید جلو وایسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.5,
   "end": 576.84,
   "text": "سیده، سید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.84,
   "end": 580.4,
   "text": "اینایی که زرنگ بودن چون تو سیر بحث بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.4,
   "end": 582.08,
   "text": "زرنگی هم خیلی نمی‌خواست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 582.08,
   "end": 584.2,
   "text": "تو سیر بحث بودن گفتن علم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.2,
   "end": 589.1,
   "text": "الان بحث ما چی بود؟ افضل بودن علم بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.1,
   "end": 592.74,
   "text": "تو شرع فرمودن اونکه عالم‌تره جلو وایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.74,
   "end": 595.08,
   "text": "نه اون که سیده. حتی می‌گن حالا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.08,
   "end": 601.02,
   "text": "انقدر جزئی می‌شه تو این چیز مسائل که انقدر نشون می‌ده اسلام برای هر چیزی جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.02,
   "end": 603.8,
   "text": "دین ما، شرع ما برای هر چیزی جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.8,
   "end": 608.24,
   "text": "می‌گه اگر تو همه‌چی مساوی بودن، یکیشون خوشگل‌تر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.24,
   "end": 613.4,
   "text": "نظر شما به اون بدگله باید اقتدا کرد یا خوشگله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.4,
   "end": 619.64,
   "text": "ها؟ تهذیب نفس کنیم به بدگله، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.64,
   "end": 622.28,
   "text": "باید به من اقتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.28,
   "end": 628.66,
   "text": "به خوشگله. حالا از فردا به ما نگید بچه خوشگل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 628.66,
   "end": 632.72,
   "text": "اینا چیزاییه که چقدر خوبه آدم اینا رو بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 632.72,
   "end": 638.18,
   "text": "پس علم ارجحه. یا مثلا خدا رحمت کنه آقای فاطمی‌نیا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.18,
   "end": 642.74,
   "text": "خیلی سال‌های پیش بود. فکر می‌کنم تقریبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.74,
   "end": 645.48,
   "text": "ده، دوازده سال پیش بود ما از ایشون شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.48,
   "end": 647.94,
   "text": "مخصوصا عدد سال رو می‌گم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.94,
   "end": 651.98,
   "text": "که شما محاسبه کنید. اون موقع ایشون بالا منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.98,
   "end": 657.96,
   "text": "فرمودن که یک صله‌ای که امام سجاد علیه السلام به یک شاعرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.96,
   "end": 660.64,
   "text": "شعر در مدح و سرای اهل بیت سروده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.64,
   "end": 664.66,
   "text": "مثلا به عنوان مثلا، مثلا مداحی امروز ما اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 664.66,
   "end": 667.28,
   "text": "یه جلسه قصیده‌ای خونده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.28,
   "end": 670.58,
   "text": "البته اون موقع‌ها می‌دونید شعرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.58,
   "end": 676.18,
   "text": "ک-- یعنی بزرگ‌ترین حرف‌های سیاسی روز اجتماع رو شعرا می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.18,
   "end": 679.9,
   "text": "و امام سجاد صله‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.9,
   "end": 681.74,
   "text": "اون روز به ایشون داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.74,
   "end": 688.38,
   "text": "حضرت آیت‌الله فاطمی‌ها، فاطمی‌نیا حدود ده، دوازده سال پیش می‌فرمود \"من به پول امروز محاسبه کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.38,
   "end": 691.54,
   "text": "شو-- می‌شه دویست میلیون تومان.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 691.54,
   "end": 694.14,
   "text": "یک صله تو یک جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.14,
   "end": 696.5,
   "text": "به یه کسی که در شأن اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 696.5,
   "end": 699.52,
   "text": "سروده بود شعری رو و خونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.52,
   "end": 702.02,
   "text": "اینکه بعضیا می‌گن دعا می‌زنن آقا برای چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 702.02,
   "end": 704.72,
   "text": "پول می‌دی؟ بعضی هیئت‌ها هستن اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 704.72,
   "end": 709.2,
   "text": "بناشون اینه که به روضه‌خون‌شون و آخوندشون پول ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.2,
   "end": 711.24,
   "text": "بناشون اینه. می‌گن نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.24,
   "end": 714.22,
   "text": "علیزه عذرخواهی می‌کنم. ای باریکلا، پررو نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 714.22,
   "end": 716.08,
   "text": "وظیفه‌شونه. برای چی درس خونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.08,
   "end": 717.9,
   "text": "برای چی رفت فلان کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.9,
   "end": 724.42,
   "text": "چطور این وظیفه‌شه ولی اون دکتر مهندسه که کلی پول خرجش می‌کنه بیاد یه نیم ساعت درس روانشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 724.42,
   "end": 726.44,
   "text": "چرت و پرت به شما بگه بره، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 726.44,
   "end": 729.89,
   "text": "وظیفه‌ش نبوده؟ برای این فقط وظیفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 729.89,
   "end": 734.67,
   "text": "بعد چند، چقدر ما خرج شکم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.67,
   "end": 737.11,
   "text": "می‌خواید بفهمید یه قیاس کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 737.11,
   "end": 740.59,
   "text": "مهک بزنید. هیئت، هیئت خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.59,
   "end": 743.97,
   "text": "چقدر موفق بوده در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 743.97,
   "end": 746.61,
   "text": "معنویت و باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 746.61,
   "end": 750.11,
   "text": "ببینید میزان خرج کردش برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 750.11,
   "end": 757.21,
   "text": "فکر و اندیشه و عقل و علم و معارف مردم چقدر بوده، برای شکمشون چقدر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 757.21,
   "end": 760.37,
   "text": "هیئتها غالباً هزینه‌هاشون رو شکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 760.37,
   "end": 762.25,
   "text": "اطعام اونم خوبه نه که بد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 762.25,
   "end": 767.51,
   "text": "این سنت اهل بیت بوده. اصلاً اطعام در جلسات امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 767.51,
   "end": 771.03,
   "text": "ابداعش با امام صادق صلی الله علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 771.03,
   "end": 774.07,
   "text": "امام صادق یه خونه‌ای داشتن بالای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 774.07,
   "end": 776.67,
   "text": "شریعف، اه علقمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.67,
   "end": 781.45,
   "text": "هنوزم هست منزلشون که صدام البته خراب کرد بعد دو مرتبه ساختنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 781.45,
   "end": 786.25,
   "text": "اونجا روضه می‌گرفته دائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 786.25,
   "end": 788.31,
   "text": "بیتوته‌ای بود و اطعام می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 788.31,
   "end": 790.87,
   "text": "اون مردم فقیر بودند، مستضعف بودند، گرفتار بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.87,
   "end": 795.87,
   "text": "می‌اومدن سر سفره‌ی اطعام حتی به بهونه‌ی غذا می‌اومدن و با ارباب آشنا می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.87,
   "end": 801.17,
   "text": "الان این سنت قشنگیه خوبه خیلی خوبه باشه اینم خیلی زیباست نه که نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.17,
   "end": 804.21,
   "text": "اما خب برای فکر و اندیشه‌ش چه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 804.21,
   "end": 812.57,
   "text": "یه معلمی فقط تو روایت میگه سوره حمد رو یاد بچه امام حسین داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 812.57,
   "end": 814.53,
   "text": "تو روایت میگه سوره حمد رو یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 814.53,
   "end": 822.31,
   "text": "حضرت یک کیسه زر طوری که دهانش رو پر می‌کرده یعنی اگر می‌ذاشت تو دهانش جا نمی‌شد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 822.31,
   "end": 827.49,
   "text": "این تو روایت اومده طوری که دهانش پر می‌شد بهش داد و طرف متعجب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 827.49,
   "end": 832.61,
   "text": "آقا من کاری نکردم که. یه جلسه درسی با فرزندتون داشتم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 832.61,
   "end": 838.03,
   "text": "حضرت فرمود این تازه ببخشید اگر کمه این پاداش دنیوی هدیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 838.03,
   "end": 842.89,
   "text": "صله ما به شما از دنیا قیامت براتون جبران می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 842.89,
   "end": 847.19,
   "text": "یعنی ارزش تعلیم و تربیت رو می‌رسونه که انسان پولش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 847.19,
   "end": 850.91,
   "text": "حالا تو این زمینه ما بخوایم حرف بزنیم الا ماشاالله خیلی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 850.91,
   "end": 854.37,
   "text": "اجازه بدید که دو سه دقیقه من تند و تن یه چند تا تیتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 854.37,
   "end": 857.07,
   "text": "خدمتتون عرض کنم عنوان چون پرسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 857.07,
   "end": 860.87,
   "text": "بعضیا دوست دارن خب این حرف‌ها رو شنیدن براشون جالب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 860.87,
   "end": 863.55,
   "text": "آقا ما می‌خوایم هزینه کنیم نظر شما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 863.55,
   "end": 866.35,
   "text": "مثلاً یه چند تا رو من براتون می‌نویسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 866.35,
   "end": 870.59,
   "text": "عرض، نوشتم عرض می‌کنم. بعضیاشو شنیدید بعضیاشو شاید نشنیده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 870.59,
   "end": 873.43,
   "text": "ماحصل تجربه چندین ساله بنده بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 873.43,
   "end": 876.53,
   "text": "و خوبه که اینا رو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 876.53,
   "end": 879.85,
   "text": "بعضیاش خرج که در، خرج کرده در باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 879.85,
   "end": 884.31,
   "text": "خرج کرده در ظاهر عالم، عالمه بعضیاش در مسیر ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 884.31,
   "end": 891.29,
   "text": "یا اگه سلام می‌دید اجازه بدید یه مفصل جداگونه بگیم چون دیگه الان وقت گذشت اینم تقریباً بیست سی مورده نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 891.29,
   "end": 895.63,
   "text": "ان‌شاءالله فردا براتون این‌ها رو بگیم دیگه انتخاب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 895.63,
   "end": 898.67,
   "text": "دیگه نسبت به دارایی‌تون، سعای مالی‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 898.67,
   "end": 901.67,
   "text": "و اون چیزی که به دلتون می‌شینه ادامه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 901.67,
   "end": 903.45,
   "text": "ان‌شاءالله عاقبتون به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 903.45,
   "end": 906.51,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 906.51,
   "end": 909.63,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}