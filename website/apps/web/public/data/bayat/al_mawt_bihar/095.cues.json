 "chapters": [
  {
   "index": 0,
   "title": "## تیزهوش‌ترین اهل ایمان؛ کثرتِ یاد موت",
   "start": 23.84,
   "end": 231.06
  },
  {
   "index": 1,
   "title": "## مناجات شعبانیه؛ اقرار به گناه تنها وسیله",
   "start": 231.06,
   "end": 474.78
  },
  {
   "index": 2,
   "title": "## یاد موت هنگام غنا و هنگام فقر",
   "start": 474.78,
   "end": 494.82
  },
  {
   "index": 3,
   "title": "## خروج روح مؤمن؛ مو از خمیر و خواب عارف",
   "start": 494.82,
   "end": 821.63
  },
  {
   "index": 4,
   "title": "## خواب سقوط هواپیما؛ گلِ امام رضا",
   "start": 821.63,
   "end": 898.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 5.24,
   "text": "اللهم صل علی محمد و آل محمد و قد فضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.24,
   "end": 8.84,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.84,
   "end": 10.96,
   "text": "و آل محمد و قد فضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.96,
   "end": 15.24,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.24,
   "end": 19.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.02,
   "end": 23.84,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.84,
   "end": 29.4,
   "text": "سخن در روایت ششم از باب چهارم کتاب الموت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 37.0,
   "text": "که پیامبر عظیم الشأن اسلام در جواب سوالی که تیزهوش‌ترین اهل ایمان کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.0,
   "end": 40.62,
   "text": "فرمود اكثرهم ذكراً للموت و اشدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.62,
   "end": 44.9,
   "text": "استعداداً له. کسی که از همه بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.9,
   "end": 50.44,
   "text": "یاد موت می‌کنه و خودش رو آماده می‌کنه برای چنین روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.44,
   "end": 56.5,
   "text": "در یک روایتی در تنبیه الخواطر و نزهة النواظر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.5,
   "end": 63.42,
   "text": "دیدم که شبیه به همین فرموده اکیس الناس و احزمهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.42,
   "end": 68.28,
   "text": "یعنی هم هوشیارترین، هم دوراندیش‌ترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.28,
   "end": 70.68,
   "text": "چون سفر، سفر ابدیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.68,
   "end": 74.44,
   "text": "یه مقطعی ما تو دنیا مسافریم تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.44,
   "end": 78.94,
   "text": "لذا می‌گه اونکه خیلی به فکر موته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.94,
   "end": 80.64,
   "text": "این می‌شه دوراندیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.64,
   "end": 85.46,
   "text": "بلکه دوراندیش‌ترین آدمیه که خیلی یاد اون موقع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.46,
   "end": 89.24,
   "text": "و انتهای همین روایت می‌فرماید اولئک الأکیاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.24,
   "end": 92.34,
   "text": "یعنی کسی که خیلی یاد موت می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.34,
   "end": 97.34,
   "text": "دوراندیشه اولئک الأکیاس الوهب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.34,
   "end": 100.4,
   "text": "اینا اون هوشیاران واقعی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.4,
   "end": 104.3,
   "text": "بشرف الدنيا و کرامة الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.3,
   "end": 112.36,
   "text": "یعنی هم شرف دنیا رو برای خودشون برداشته‌اند، بزرگواری دنیا رو، هم کرامت آخرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.36,
   "end": 116.64,
   "text": "چرا این چنینه؟ چرا کسی که زیاد یاد موت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.64,
   "end": 121.9,
   "text": "هم شرف دنیا رو طبق این روایت برای خودش برداشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.9,
   "end": 124.04,
   "text": "در عین اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.04,
   "end": 129.6,
   "text": "دوراندیش‌ترین و زیرک‌ترینه، کرامت آخرت رو هم برداشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.6,
   "end": 132.62,
   "text": "به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.62,
   "end": 141.0,
   "text": "هیچ چیزی مثل یاد موت انسان رو از گناه باز نمی‌داره و آنچه که سبب نکبت و خاری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.0,
   "end": 148.52,
   "text": "بیچارگی انسان چه در دنیا چه در آخرت می‌شه چیزی نیست جز گناه و عصیت و آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.52,
   "end": 153.34,
   "text": "همینه. اصلاً برزخ ما بارها عرض کردیم برزخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.34,
   "end": 155.1,
   "text": "می‌گن که حالش بده، می‌گن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.1,
   "end": 159.24,
   "text": "برزخی. گرفتار بین دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.24,
   "end": 162.76,
   "text": "نشئه، نشئه دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.76,
   "end": 164.42,
   "text": "آخرت. گرفتاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.42,
   "end": 170.2,
   "text": "چرا اونجا منتظره؟ مترصده، گرفتاره، برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.2,
   "end": 172.94,
   "text": "مونده اون وسط. گیر کرده به حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.94,
   "end": 174.92,
   "text": "چرا؟ به خاطر گناه‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.92,
   "end": 178.3,
   "text": "هر مقدار گناه کمتره به یه معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.3,
   "end": 182.82,
   "text": "تعلق کمتره، توقفش در برزخ کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.82,
   "end": 187.52,
   "text": "لذا اصلاً بعضیا برزخ فقط صرف اینکه طفر محاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.52,
   "end": 190.74,
   "text": "و همونطور که در قوس نزول انا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.74,
   "end": 195.08,
   "text": "از عالم عقول اومدیم به عالم مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.08,
   "end": 198.36,
   "text": "برزخ منفصل، مثال منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.36,
   "end": 201.54,
   "text": "اومدیم به عالم مثال. بعد اومدیم به نشئه طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.54,
   "end": 208.54,
   "text": "رفتنه در قوس صعود هم و انا الیه راجعون هم باید لاجرم از عالم برزخ یا مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.54,
   "end": 212.72,
   "text": "مثال منفصل که متصل تو خودته، قوه خیالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.72,
   "end": 215.46,
   "text": "می‌خوابی میری اونجا، منفصل بیرونه از تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.46,
   "end": 221.48,
   "text": "باید از اونجا رد شی تا برسی به عالم عقول در سیر الی الله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.48,
   "end": 224.16,
   "text": "ولی این رد شدن یک آنه برای بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.16,
   "end": 230.58,
   "text": "یعنی اصلاً وجود نداره برزخ براشون به اون معنایی که شدت عذاب و چیز این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.58,
   "end": 237.1,
   "text": "اتفاقاً در مناجات شعبانیه می‌گیم که و امکانه قد دنا اجلی و لم يدن من که عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.1,
   "end": 241.58,
   "text": "اگر دنا، اگه نزدیک شده اجل من، موت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.58,
   "end": 245.12,
   "text": "در حالی که من عملی ندارم برای اون روز آمادگی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.12,
   "end": 246.68,
   "text": "اینو امام معصوم داره به خدا می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 246.68,
   "end": 249.28,
   "text": "ببین سفر چقدر طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.28,
   "end": 252.16,
   "text": "فرمود خب حالا چه کنم؟ چه کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.16,
   "end": 255.08,
   "text": "مرگم نزدیکه و دستم خالیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.08,
   "end": 256.76,
   "text": "قد-- اینا همش درسه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.76,
   "end": 259.62,
   "text": "یعنی داره به ما درس می‌ده که تو چی بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.62,
   "end": 262.14,
   "text": "چگونه این گردنه‌ها رو رد کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.14,
   "end": 267.96,
   "text": "وسیله من در حالی که مرگم نزدیکه و عملم کمه یا ندارم عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.96,
   "end": 269.98,
   "text": "چیه این وسیله به سمت تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.98,
   "end": 275.82,
   "text": "می‌فرماید فقط جعلت الإقرار بالذنب الیک وسیلتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.82,
   "end": 280.04,
   "text": "این اقرار به گناه من وسیله‌ی من به سوی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.04,
   "end": 284.34,
   "text": "اقرار به گناه. بعضیامون خیلی پررو تشریف داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.34,
   "end": 286.96,
   "text": "مثل بنده. خیلی پررو تشریف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.96,
   "end": 292.44,
   "text": "یه مقدار کثرت دین و دیانت و تسبیح و دلق و سجاده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.44,
   "end": 298.22,
   "text": "یه مقدار بلا قربانگو هم داشته باشیم و دور بر پشت سرمون یه چند نفر راه بیفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.22,
   "end": 300.34,
   "text": "سلام علیکم و التماس دعا حاج آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.34,
   "end": 303.9,
   "text": "ریش و تسبیح و اینا دیگه گم می‌کنی فکر می‌کنی اصلاً گناها یادمون می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.9,
   "end": 310.8,
   "text": "تا جایی که حضرت سجاد تو گنا-- توی دو-- مناجاتش با خدا می‌گه به گونه‌ای شد که من اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.8,
   "end": 315.18,
   "text": "گمان کردم که گناه نکردم یا اصلاً تو ندیدی گناههای منو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.18,
   "end": 316.98,
   "text": "اصلاً یادش می‌ره گناهاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.98,
   "end": 320.34,
   "text": "اگه بخوای دقت کنی این اقرار به گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.34,
   "end": 322.5,
   "text": "وسیله به سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.5,
   "end": 327.74,
   "text": "انقدر نشون می‌ده که انقدر که آدما بی‌وسیله‌اند یعنی بی‌اقرارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.74,
   "end": 335.12,
   "text": "خدا وکیلی در شبانه روز چند بار و چند تامون اقرار به گناه در درگاه خدا داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.12,
   "end": 340.28,
   "text": "چرا امیرالمؤمنین در مشکلات مختلف آدم‌های مختلف اومدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.28,
   "end": 344.34,
   "text": "یکی گفت گیر و گور مالی دارم، یکی گفت بچه‌دار نمی‌شم، یکی گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.34,
   "end": 348.12,
   "text": "مشکلات نمیدونم چی چی دارم، کش-کشزارم بی‌برکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.12,
   "end": 352.96,
   "text": "هرکی هرچی. مولا به همشون یک نسخه ثابت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.96,
   "end": 355.92,
   "text": "کثرت اق-- استغفار زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.92,
   "end": 361.38,
   "text": "کثار استغفار. بعد اشاره به اون آیه سوره نوح کرد که قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.38,
   "end": 363.08,
   "text": "استغفار یعنی چی به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.08,
   "end": 365.84,
   "text": "یعنی داری اقرار می‌کنی که من بدم، من فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.84,
   "end": 368.18,
   "text": "اصلا کبریا ما رو خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.18,
   "end": 371.86,
   "text": "یه ذره سرمون پایین باشه اقرار کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.86,
   "end": 374.96,
   "text": "که میگه خب حالا که عمرت گذشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.96,
   "end": 379.6,
   "text": "مرگت نزدیک و دستت خالیه لااقل اقرار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.6,
   "end": 383.68,
   "text": "این نشون میده که چقدر مهمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.68,
   "end": 387.46,
   "text": "ما باز این رو هم نشون میده که چون ما یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.46,
   "end": 395.62,
   "text": "موت نبودیم به گناه افتادیم که حالا موت نزدیک شده دستمون خالیه چاره‌ای جز اقرار به گناه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.62,
   "end": 399.56,
   "text": "اتفاقا یه روایت دیگه خیلی جالب براتون بخونم از کنز المال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.56,
   "end": 402.76,
   "text": "این روایت همین رو داره تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.76,
   "end": 407.6,
   "text": "اکثر عجب بسیار زیاد اکثر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.6,
   "end": 410.08,
   "text": "کثرت. چی رو زیاد داشته باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.08,
   "end": 413.52,
   "text": "فعل امر اکثر زیاد داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.52,
   "end": 417.14,
   "text": "چی رو؟ ذکر الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.14,
   "end": 419.36,
   "text": "یاد موت رو زیاد داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.36,
   "end": 425.12,
   "text": "عجب. چرا ما باید زیاد یاد موت باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.12,
   "end": 428.9,
   "text": "فإنه یمحص الذنوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.9,
   "end": 432.96,
   "text": "چون تمحیص میبره گناه ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.96,
   "end": 435.22,
   "text": "ذوب میکنه از بین میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.22,
   "end": 439.7,
   "text": "این پیداست که چون ان الحسنات یذهب السيئات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.7,
   "end": 444.32,
   "text": "از اینجا بیرون میاد که یاد موت خودش حسنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.32,
   "end": 447.24,
   "text": "این پژمرده‌گی و افسردگی به دنبال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.24,
   "end": 452.24,
   "text": "اتفاقا هرچی ما افسردگی داریم از گناهه و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.24,
   "end": 457.96,
   "text": "چون یاد موت یمحص الذنوب گناه رو میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.96,
   "end": 461.04,
   "text": "پس یاد موت اتفاقا نشاط میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.04,
   "end": 464.74,
   "text": "ادامشو ببینید و یزهّد في الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.74,
   "end": 469.46,
   "text": "زهد در دنیا میاره. آدم بی‌رغبت به دنیا می‌شه، راحت می‌کنه، تعلقاتش کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.46,
   "end": 473.36,
   "text": "در نتیجه برزخش خیلی راحته اگرم داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.36,
   "end": 477.1,
   "text": "و ادامه‌ش چقدر شیرین. فإن ذكرتموه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.1,
   "end": 481.02,
   "text": "وقتی که یاد کنی موت رو عند الغنى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.02,
   "end": 483.84,
   "text": "وقتی آدم توانگری هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.84,
   "end": 486.82,
   "text": "غنا داری یا غنا داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.82,
   "end": 491.02,
   "text": "توانگری، داری، دستت الحمدالله پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.02,
   "end": 493.86,
   "text": "ها؟ میگه هدمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.86,
   "end": 496.4,
   "text": "حد می‌کنه از بین می‌بره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.4,
   "end": 499.68,
   "text": "غنا رو. یعنی چی؟ یعنی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.68,
   "end": 504.34,
   "text": "وقتی یاد موت می‌کنی میگی هرچی هم داشته باشم این باید بذارم برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.34,
   "end": 508.66,
   "text": "امانت دارم، مال من نیست. باعث می‌شه تکبر نکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.66,
   "end": 512.02,
   "text": "مغرور نشی، دل نبندی، سرتو بندازی پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 512.02,
   "end": 514.48,
   "text": "هدمه، حد می‌کنه این حالت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.48,
   "end": 519.04,
   "text": "اینا گیر و گور‌ها و گرفتاری‌هاییه که همه‌ی ما گرفتارشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.04,
   "end": 524.88,
   "text": "و بزرگان اهل معرفت یه عمر تلاش کردن که سر سوزنی علقه پیدا نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.88,
   "end": 530.22,
   "text": "و الا لب مرگ مشکل و-- لخ-لخ-وقتی رفتن و موت مشکل پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.22,
   "end": 532.26,
   "text": "اینجا میگه چی این رو از بین میبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.26,
   "end": 535.44,
   "text": "ذکر موت وقت غنا، توانگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.44,
   "end": 537.88,
   "text": "وقتی دستت پره یاد کنی که این امانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.88,
   "end": 543.44,
   "text": "اصلا مالک یه بنده خدایی یه کمک خیلی جانانه میلیونی به یه بنده خدایی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.44,
   "end": 546.26,
   "text": "ما فقط واسطه بودیم، آبرو گذاشته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.26,
   "end": 550.7,
   "text": "بعد الحمد-- یه کمک خیلی یعنی چند برابر نیاز طرف کمک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.7,
   "end": 555.26,
   "text": "بعد من ازش تشکر کردم. یه جمله خیلی درس‌آموزی به بنده گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.26,
   "end": 557.48,
   "text": "گفت که اصلا مالک خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.48,
   "end": 562.86,
   "text": "ما هیچکدوممون مالکیت نداریم بر هیچ چیزی حتی بر خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.86,
   "end": 569.56,
   "text": "و دیدم این داره از جانش سخن می‌گه و الا نمی‌تونست از اون چند میلیون بگذره تو این دنیای وانفسا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.56,
   "end": 572.02,
   "text": "و گفت اصلا ما میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.02,
   "end": 574.78,
   "text": "مولای یا مولای انت الملك و انا المملوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.78,
   "end": 576.9,
   "text": "من خودم مملوک او هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.9,
   "end": 579.06,
   "text": "من خودم ملک او هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.06,
   "end": 581.6,
   "text": "چی میگی این مال منه، اون مال-- الان این ماشین مال توئه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.6,
   "end": 584.88,
   "text": "بفروشش دو، یک، یه ساعت بعد یکی دیگه سوارش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.88,
   "end": 589.42,
   "text": "این خونه مال توئه؟ بفروشش. یه ساعت بعد یکی دیگه تو اون نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.42,
   "end": 591.82,
   "text": "اصلا هیچ رو ما تملیک نداریم برای خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 591.82,
   "end": 595.58,
   "text": "حتی خودمون امانت دست خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.58,
   "end": 601.22,
   "text": "و چه شیرین می‌فرماید و ان ذكرتموه هر کسی که یاد کنه موت رو دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.22,
   "end": 603.14,
   "text": "حالا نسبت به خودمون صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.14,
   "end": 607.68,
   "text": "حاج آقا از غنا و توانگری صحبت می‌کنی انگار بالا شهر داری حرف می‌زنی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.68,
   "end": 609.94,
   "text": "بین بچه‌های پایین هستی. بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.94,
   "end": 612.34,
   "text": "می‌فرماید عند الفقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.34,
   "end": 615.48,
   "text": "اروا کن و عیش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.48,
   "end": 618.1,
   "text": "کسی که نداره دستش خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.1,
   "end": 621.24,
   "text": "اینم وقتی یاد موت می‌کنه خشنود می‌شه، خوشحاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.24,
   "end": 624.22,
   "text": "می‌گه آخرش که اونه دیگه حالا نداریم تموم می‌شه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.22,
   "end": 627.66,
   "text": "دو روز دنیا می‌گه سختیش صد سال اوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.66,
   "end": 630.18,
   "text": "تموم می‌شه میره. چقدر شیرینه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.18,
   "end": 632.58,
   "text": "روایات. چقدر قشنگه این روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.58,
   "end": 635.22,
   "text": "یعنی چشم آدم رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.22,
   "end": 637.98,
   "text": "بعدم ما هی میایم از سختی موت می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.98,
   "end": 644.46,
   "text": "آی سخته آی. خب برای اهل ایمان، برای کسی که اقرار به-- حالا گناه همه مون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.46,
   "end": 647.0,
   "text": "اقرار به گناه که می‌تونیم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 647.0,
   "end": 650.54,
   "text": "استغفار که می‌تونیم بکنیم. خدا هم که ارحم الراحمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 650.54,
   "end": 653.64,
   "text": "نباید ترسید. اونجا مثل یه حمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.64,
   "end": 657.34,
   "text": "به قول امام سجاد موت حالتش برای اهل ایمان مثل حمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 657.34,
   "end": 660.62,
   "text": "حمام بده؟ بری حموم چه نشاطی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 660.62,
   "end": 662.82,
   "text": "کیسه ات می‌کشن چرکت می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 662.82,
   "end": 666.38,
   "text": "عین اینه. خب چقدر قشنگه آدم بره حمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.38,
   "end": 673.54,
   "text": "حمام بده؟ حالا درسته هرکی چرکش بیشتره باید کیسه‌شو بکشی دیگه با لیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 673.54,
   "end": 678.16,
   "text": "جواب نمی‌ده. اما بالاخره تمیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 678.16,
   "end": 682.68,
   "text": "اتفاقا یه روایت دیگه ای هست اینم تقدیم کنم خیلی قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 682.68,
   "end": 686.36,
   "text": "که همین رو داره برای ما به زبان قرآن بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.36,
   "end": 691.9,
   "text": "دیدم در روایت دیدم یه عارفی در حکایات، یه عارفی بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 691.9,
   "end": 698.2,
   "text": "این روایت رو شنیده بوده که يخرج روح الروح المؤمن من جسده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.2,
   "end": 701.48,
   "text": "كما يخرج. یه مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 701.48,
   "end": 704.54,
   "text": "روحش از بدنش یه طوری خارج می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 704.54,
   "end": 709.5,
   "text": "مثل خارج شدن يخرج الشعر من العجين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 709.5,
   "end": 713.24,
   "text": "مثل مو رو از تو ماست بکشی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 713.24,
   "end": 716.94,
   "text": "نه موه چیزی احساس می‌کنه، نه ماسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.94,
   "end": 721.6,
   "text": "درسته؟ می‌گن مو رو. حالا یه بحثش هم حساسیت و ظرافتش کار هر کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 721.6,
   "end": 724.05,
   "text": "فقط خدا و قابض الارواح می‌تونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 724.05,
   "end": 727.23,
   "text": "یه بحثش اونه که وقتی مو رو کشیده از تو ماست بیرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 727.23,
   "end": 730.95,
   "text": "ماستش احساسی نداره. میگه من مونده بودم اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 730.95,
   "end": 734.19,
   "text": "ولارت به ولایا بصن لا فی کتاب مبینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 734.19,
   "end": 738.13,
   "text": "هیچ تر و خشکی نیست مگر در این کتاب مبین هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.13,
   "end": 740.21,
   "text": "کجای قرآن می‌تونم اینو پیدا کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 740.21,
   "end": 742.31,
   "text": "مؤمن اینطوری جون میده. مؤمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.31,
   "end": 749.25,
   "text": "اهل ایمان، شما انشاالله. حالا یه بگه آقا تو هم تو ما رو نکشی ولمون نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 749.25,
   "end": 751.85,
   "text": "بعد بگی تو ما رو نکنی تو حموم ولمون نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 751.85,
   "end": 755.71,
   "text": "اینطوری بگی. ها؟ بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 755.71,
   "end": 761.47,
   "text": "هرچی قرآن-- آدمایی بودن اینا کل قرآن رو خوند تو قرآن این رو پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.47,
   "end": 768.77,
   "text": "پیدا نکرد. خواب پیغمبر رو دید تو خواب به پیغمبر عرض کرد این عارف به الله عرض کرد که حالا اسمش یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 768.77,
   "end": 770.99,
   "text": "گفت یا رسول الله من تو قرآن پیدا نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.99,
   "end": 781.01,
   "text": "پیغمبر اشاره کردن در معنای این موضوع به اونجایی که زنان مصر وقتی حضرت یوسف اومد رد شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 781.01,
   "end": 783.87,
   "text": "دستاشون رو بریدن قرآن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.87,
   "end": 787.97,
   "text": "خب؟ ایدی از دستاشونو نه تازه انگشتشونو، دستشونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 787.97,
   "end": 793.27,
   "text": "هیچی نفهمیدن. میگه اونا دستشونو چطور بریدن و هیچی نفهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 793.27,
   "end": 798.87,
   "text": "پیغمبر تو خواب چه قشنگ، چه شیرین آدم سائل باشه اونا جوابشو میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 798.87,
   "end": 803.57,
   "text": "پیغمبر تو خواب نمیاد بگه بورس چجوریه، نوسان دلار و سکه چجوریه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 803.57,
   "end": 807.21,
   "text": "میاد حقایقو که می‌تونی اونور به دردت می‌خوره بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 807.21,
   "end": 810.25,
   "text": "فرمود اینطور که اینا هیچی نفهمیدن داره تفسیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 810.25,
   "end": 815.33,
   "text": "کسی که با ایمان از دنیا میره با اقرار بر گناه و استغفار و توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 815.33,
   "end": 817.13,
   "text": "از دنیا میره همینجوری جون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 817.13,
   "end": 820.55,
   "text": "به همین راحتی. اصلاً هیچی حالیش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.55,
   "end": 824.71,
   "text": "اون نکته آخر که در تفسیر همین فرمایش پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.71,
   "end": 828.07,
   "text": "اون هواپیمایی که سقوط کرد می‌رفت مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 828.07,
   "end": 831.91,
   "text": "من خاطرات و اینا رو اه-اهل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 831.91,
   "end": 835.07,
   "text": "شهدا‌ن به یک معنا دیگه زیارت آقا می‌رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 835.07,
   "end": 841.35,
   "text": "در خاطراتشون یکی از این خانواده‌ها نوشته بود که خواب اون عزیزشون رو دیده بودن که چجوری جون دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 841.35,
   "end": 845.77,
   "text": "گفت بود ما هیچی نفهمیدیم. ما یه دفعه دیدیم یه آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 845.77,
   "end": 852.35,
   "text": "خیلی با جلالت و با عظمت، عظمت و خیلی نورانی و قد بلند و چهارشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 852.35,
   "end": 857.99,
   "text": "وارد کا-- وارد هواپیما شد و از تو کابین خلبان اومد تو هواپیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 857.99,
   "end": 860.15,
   "text": "گفت امام رضا بوده. اول نشناختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 860.15,
   "end": 863.31,
   "text": "بعد دیدیم به ما الهام شد که ایشون امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 863.31,
   "end": 865.09,
   "text": "یه گل گرفت جلوی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 865.09,
   "end": 867.75,
   "text": "این گلو بو می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 867.75,
   "end": 874.27,
   "text": "بعد می‌دیدیم که همه که بو کردیم دیدیم همه جنازه هامون، هواپیما همین آش و لاش شده رو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 874.27,
   "end": 876.55,
   "text": "اصلاً ما هیچی نفهمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 876.55,
   "end": 878.75,
   "text": "اینطوریه واقعاً برای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 878.75,
   "end": 883.39,
   "text": "حالا چیکار کنیم الان به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 883.39,
   "end": 887.39,
   "text": "انشاالله سوار هواپیما شی به زودی مشهد بری صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 887.39,
   "end": 896.73,
   "text": "اللهم صلي علي محمد و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 896.73,
   "end": 898.95,
   "text": "الله اکبر، الله اکبر، اشهد ان لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}