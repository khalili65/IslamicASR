 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت یازدهم و علت عشق به لقاء الله",
   "start": 2.38,
   "end": 50.96
  },
  {
   "index": 1,
   "title": "## دنیا دار تزاحم و تمانع",
   "start": 50.96,
   "end": 238.52
  },
  {
   "index": 2,
   "title": "آیهٔ شانزدهم سورهٔ فرقان همین معنا را پرده برمی‌دارد:",
   "start": 238.52,
   "end": 330.92
  },
  {
   "index": 3,
   "title": "## شهدا و تجلی سیدالشهدا در بهشت",
   "start": 330.92,
   "end": 508.6
  },
  {
   "index": 4,
   "title": "## دین در دار زحمت و شعلهٔ عشق حسین",
   "start": 508.6,
   "end": 704.12
  },
  {
   "index": 5,
   "title": "## خطاب «ایها المستمع» و دهان روح",
   "start": 704.12,
   "end": 904.35
  },
  {
   "index": 6,
   "title": "## دعای مولا و جمع سخن",
   "start": 904.35,
   "end": 1007.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.38,
   "end": 6.98,
   "text": "روایت یازدهم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.98,
   "end": 11.74,
   "text": "جانشین خاطر و نظر شریفتون باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.74,
   "end": 16.88,
   "text": "متن روایت مضمونش این بود که امیرالمؤمنین علیه‌السلام علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.88,
   "end": 22.56,
   "text": "عشق و حب به لقاء الله‌شون رو و موت‌شون رو در این بیان کردن که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.56,
   "end": 26.18,
   "text": "فراموش نمی‌کنه منو در قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.18,
   "end": 35.12,
   "text": "کدوم خدا؟ خدایی که اینجا دینش رو که بهترین نعمتشه، اونم دین ملائکه و انبیا و رسولانش رو روزی من کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.12,
   "end": 40.52,
   "text": "نکته‌ای که باید بهش دقت کنیم در فرمایش مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.52,
   "end": 47.28,
   "text": "این که کجا دین خدا که ناموس خداست قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.28,
   "end": 50.8,
   "text": "به ما اعطا شده؟ کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.8,
   "end": 53.48,
   "text": "تو دنیا. می‌دونید دین خدا ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.48,
   "end": 57.82,
   "text": "اونایی که میگن چگونه خدا تحمل کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.82,
   "end": 63.02,
   "text": "بدترین دشمنش بنشینه رو سینه بهترین بنده‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.02,
   "end": 66.3,
   "text": "تو کربلا. چگونه خدا تحمل کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.3,
   "end": 68.82,
   "text": "میگیم چون اون داشت فدای دین خدا میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.82,
   "end": 70.58,
   "text": "امام حسین هم فدای دین خدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.58,
   "end": 73.26,
   "text": "دین خدا ناموس خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.26,
   "end": 77.74,
   "text": "حضرت زهرا فدا شده. کلام خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.74,
   "end": 81.72,
   "text": "دین خداست. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.72,
   "end": 84.98,
   "text": "این دین کی اعطا شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.98,
   "end": 86.58,
   "text": "در کجا؟ در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.58,
   "end": 90.84,
   "text": "دنیا چه داریست؟ دار تضاهوم و تمانع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.84,
   "end": 94.14,
   "text": "اینجا دار منع و زحمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.14,
   "end": 98.56,
   "text": "گرفتاری و بیچارگی و همه چی در هم تنیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.56,
   "end": 102.7,
   "text": "نور و ظلمات در هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.7,
   "end": 108.44,
   "text": "قاطی شدن. شما به نورم که نگاه می‌کنی مشوّبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.44,
   "end": 111.52,
   "text": "یعنی همه چی با هم قاطی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.52,
   "end": 114.08,
   "text": "اینجا اراده‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.08,
   "end": 117.1,
   "text": "اراده قطعیه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.1,
   "end": 120.24,
   "text": "حالا عرض می‌کنم اگرچه عذاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.24,
   "end": 123.46,
   "text": "عذاب اینجا عذاب محضه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.46,
   "end": 125.84,
   "text": "و لذتش هم محضه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.84,
   "end": 129.02,
   "text": "مقطعیه. یک رشدهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.02,
   "end": 131.32,
   "text": "خب. یعنی برطرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.32,
   "end": 134.64,
   "text": "ماندنی نیست. دار، دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.64,
   "end": 138.48,
   "text": "تدریجه. به تدریج هی همه چی تغییر و تبدل پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.48,
   "end": 142.32,
   "text": "اما موضوع اینه که اینجا فعلاً اینو بفهمیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.32,
   "end": 144.24,
   "text": "اینجا دار تضاهومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.24,
   "end": 147.08,
   "text": "همه در زحمتن. منعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.08,
   "end": 151.92,
   "text": "در حتی چیزی که شما بخوای بهش برسی کلی مانع وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.92,
   "end": 154.36,
   "text": "حتی برای مسائل دنیویت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.36,
   "end": 162.5,
   "text": "باید زحمت بکشی. اینطوری نیست که یه عالم نود سال جون بکنه، جام به لبش برسه به قول علامه تا جام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.5,
   "end": 166.74,
   "text": "جام علم و معرفت به لبش برسه و به او بنوشانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.74,
   "end": 169.3,
   "text": "یه تاجر هم، یه آدمی که بخواد وضع مالیش خوب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.3,
   "end": 172.5,
   "text": "حالا کاری به این دوز و دلک، دغل بازی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.5,
   "end": 176.4,
   "text": "و این چیزا نداریم که طرف کلاهبرداری می‌کنه و یه شبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.4,
   "end": 178.88,
   "text": "کلی دار-- اون که هیچی، اون که تعطیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.88,
   "end": 184.26,
   "text": "نه، در از حیث حلالش چقدر باید طرف زحمت بکشه، جون بکنه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.26,
   "end": 187.72,
   "text": "مخصوصاً الان خیلی سخته پول حلال درآوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.72,
   "end": 194.32,
   "text": "دار، دار زحمته. حالا مولا داره می‌فرماید تو اینجا که شما هر اراده‌ای می‌کنی، می‌بینی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.32,
   "end": 197.58,
   "text": "هرچی زحمت بکشی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.58,
   "end": 200.94,
   "text": "خیلی از اراده‌های ما فسخ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.94,
   "end": 204.46,
   "text": "اینجا خدا اراده کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.46,
   "end": 207.2,
   "text": "و خیر من و شما رو خواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.2,
   "end": 209.72,
   "text": "بعد خدا تو اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.72,
   "end": 213.42,
   "text": "دیگه اونجا اراده‌ها قطعیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.42,
   "end": 215.94,
   "text": "عذاب محضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.94,
   "end": 218.3,
   "text": "اونجا لذت محضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.3,
   "end": 220.46,
   "text": "یعنی تمامه، تامّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.46,
   "end": 224.24,
   "text": "تا آخرشه. آخر لذته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.24,
   "end": 227.72,
   "text": "آخر عذابه. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.72,
   "end": 229.72,
   "text": "مگه می‌شه خدا ما رو فراموش کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.72,
   "end": 233.48,
   "text": "اتفاقاً در همین مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 233.48,
   "end": 238.52,
   "text": "آیه شونزده سوره فرقان به زیبایی همین رو داره پرده‌، پرده‌برداری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.52,
   "end": 243.64,
   "text": "\"لهم فیها\" برای بهشتیا اونجا چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.64,
   "end": 245.78,
   "text": "تو یه کلمه چه غوغایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.78,
   "end": 249.96,
   "text": "کرده خدا اینجا. \"لهم فیها\" می‌خواید به شما بگم اونجا چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.96,
   "end": 251.82,
   "text": "چی مهیاست برای بهشتیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.82,
   "end": 255.88,
   "text": "\"ما یشاءون\". هرچی انشا کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.88,
   "end": 259.14,
   "text": "هرچی ان-- \"ما یشاءون\" یعنی هرچی بخوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.14,
   "end": 262.9,
   "text": "یعنی هرچی اراده کنن. به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.9,
   "end": 267.38,
   "text": "اگر تو این دنیا \"من اراد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.38,
   "end": 272.86,
   "text": "بعبد خيرا\" مثلاً اگر خدا خیر بنده‌ش رو بخواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.86,
   "end": 277.02,
   "text": "اراده‌ی بند، خیر بنده‌ش رو بکنه، چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.02,
   "end": 279.54,
   "text": "چند تا روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.54,
   "end": 282.96,
   "text": "که میگه که خدا خیر بنده‌ش رو بخواد چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.96,
   "end": 285.26,
   "text": "یکیش می‌فرماید مثلاً \"غرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.26,
   "end": 289.32,
   "text": "فی قلبه\" می‌ندازه، می‌ندازه \"غرف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.32,
   "end": 294.38,
   "text": "می‌ندازه تو قلبش \"حب الحسن و حب زیارت حسین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.38,
   "end": 298.36,
   "text": "خب. اینجا وقتی به من و شما امام حسین داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.36,
   "end": 302.86,
   "text": "و اونجا نده، این فراموش مولا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.86,
   "end": 305.6,
   "text": "اینجا دینش رو داده، اونجا چی بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.6,
   "end": 308.44,
   "text": "اونجا که دیگه آخرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.44,
   "end": 313.46,
   "text": "اینجا یه رشده‌ای از امام حسین من و شما رو گرفته دیوانه خودش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.46,
   "end": 317.54,
   "text": "مردم پول جمع می‌کنن، جون می‌کردن که برن آنتال، آنتالیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 317.54,
   "end": 323.14,
   "text": "شما جون می‌کنی، پول جمع می‌کنی و هر وقت های یه ذره پول دستت میاد بریم کربلا، بریم مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.14,
   "end": 325.36,
   "text": "چرا؟ یه رشده‌ای گرفتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.36,
   "end": 330.12,
   "text": "ببین اونجا چیه که دیگه امام حسین تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.12,
   "end": 333.22,
   "text": "الله اکبر. چرا شهدا نمیرن بهشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 333.22,
   "end": 340.96,
   "text": "روایتشو دیدید دیگه. شهدا دسته‌هایین که دسته‌های، دسته، دسته‌های شهدا همه ترازه‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.96,
   "end": 345.86,
   "text": "م-مدارج‌شون هرکدوم یعنی از هر درجه‌ای کلاً شهید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.86,
   "end": 348.1,
   "text": "مطلقاً شهید وارد بهشت نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.1,
   "end": 350.44,
   "text": "اینو می‌دونستید؟ تا ببرنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.44,
   "end": 353.04,
   "text": "چرا؟ یه روایت میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.04,
   "end": 357.7,
   "text": "دم در بهشت می‌شینن میگن ما بهشت نمی‌خواستیم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.7,
   "end": 361.4,
   "text": "امام حسین رو می‌خواستیم. اصلاً اونجا هم میگن این شه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.4,
   "end": 366.18,
   "text": "حرف همه شهداست. یه روایت می‌فرماید که نه اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.18,
   "end": 369.32,
   "text": "تجلی سید الشهدا رو می‌بینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.32,
   "end": 372.32,
   "text": "چون بهشت تجلی سید الشهداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.32,
   "end": 375.56,
   "text": "یاد امام حسین میفتن اینطوری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.56,
   "end": 377.96,
   "text": "این دومیش به نظرم معقولانه‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.96,
   "end": 383.4,
   "text": "یعنی با بحث‌های ک-- فلسفی، حکمی و عرفانی ما بیشتر هم‌خوانی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 383.4,
   "end": 386.2,
   "text": "نه که اون غلط باشه. نه. به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 386.2,
   "end": 390.74,
   "text": "بهشت تجلی سید الشهداست دیگه قبلاً عرض کردیم جهنم هم تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 390.74,
   "end": 396.02,
   "text": "جلال سید الشهداست. بهشت تجلی جمال سید-- اینا بحث‌ها بین ما گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 396.02,
   "end": 401.28,
   "text": "یاد خاطره‌هاش میفتن. چگونه ادام-- چجوری مدح اهل بیت رو می‌بینی یاد امام حسین میفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 401.28,
   "end": 405.76,
   "text": "دلت می‌ره یهو، اونجا تجلی سید الشهدا که بهشته رو می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.76,
   "end": 409.02,
   "text": "دلش می‌ره پیش امام حسین، نمی‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.02,
   "end": 414.06,
   "text": "روایت داره ملائکه اینا رو به زور می‌کشن می‌برن به سمت بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.06,
   "end": 416.32,
   "text": "آقا بیاید برید دیگه بهشت منتظر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.32,
   "end": 418.78,
   "text": "چقدر شیرینه. بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.78,
   "end": 421.56,
   "text": "التماست کنه بیا پیش ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.56,
   "end": 425.66,
   "text": "چون ما داریم دیگه که یه سری هستن که اون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.66,
   "end": 427.8,
   "text": "اون‌ها آرزوی بهشت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 427.8,
   "end": 432.1,
   "text": "اهل ایمان متوسط العقل، متوسط الايمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.1,
   "end": 435.64,
   "text": "اما شهدا چی؟ بهشت آرزوی اون‌ها رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 435.64,
   "end": 438.32,
   "text": "مثل سلمان. روایت داریم سلمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 438.32,
   "end": 440.3,
   "text": "بهشت آرزوشو می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 440.3,
   "end": 444.0,
   "text": "حالا بحث رو به حاشیه نبریم اگرچه حاسی-- حاشیش عین متنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.0,
   "end": 446.98,
   "text": "خودش خیلی شنیدنی و چشیدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.98,
   "end": 451.78,
   "text": "پس چی؟ اونجا که دار تضاهوم نیست، اونجا اراده‌ها محقق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.78,
   "end": 455.78,
   "text": "هرچی اراده کنی. به به، به به، از این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.78,
   "end": 459.18,
   "text": "اونجا باید خدا به ما مثلاً فراموش کنه ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 459.18,
   "end": 463.56,
   "text": "اینجا تا اراده می‌کنی ارادت، اراده‌ی در طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.56,
   "end": 467.88,
   "text": "خیره، صلاحه، دینه، امام حسین می‌خوای، امام زمان می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.88,
   "end": 470.32,
   "text": "دنیاتم برای اون‌ها می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.32,
   "end": 473.96,
   "text": "بعد اون ور ارادت چیه که هرچی اراده کنی محققه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 473.96,
   "end": 477.46,
   "text": "عالمه. تازه بگیم تو ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 477.46,
   "end": 481.7,
   "text": "ملکوت بر وزن فعلوت، شدت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 481.7,
   "end": 486.78,
   "text": "مالکیت شل-شل-شدت سلطنت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.78,
   "end": 489.38,
   "text": "اصلاً اونجا فقط هر، هر حرف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 489.38,
   "end": 492.56,
   "text": "برو بالاتر جبروت بر وزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.56,
   "end": 495.04,
   "text": "باز فعلوت. یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 495.04,
   "end": 496.63,
   "text": "عالم امیرالمؤمنین هم هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 496.63,
   "end": 499.48,
   "text": "اونجا هرچی علی بگه همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 499.48,
   "end": 501.98,
   "text": "از این حیث میگن جبروت. جبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 501.98,
   "end": 508.42,
   "text": "به این معنا. اصلاً کسی جز امیرالمؤمنین اونجا حرفی برا گفتن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 508.42,
   "end": 515.92,
   "text": "خب اینجا که تو عاشق مولا هستی با این همه که دار تنوع من ایجاد می‌شه، تضاهوم زحمت ایجاد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 515.92,
   "end": 524.32,
   "text": "و خدا برات مهیا کرد با این همه زحمت ببین چقدر دشمنان دست به دست هم دادن دین من و شما رو ازمون بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.32,
   "end": 527.92,
   "text": "ولی باز به من و شما رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.92,
   "end": 532.3,
   "text": ". امام حسین رو کشتن. همه اهل و عیالش هم به اسارت بردن که هیچی باقی نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 532.3,
   "end": 536.86,
   "text": "اما ببین ما شعله الان برافروخته‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.86,
   "end": 541.18,
   "text": "عرض شود شعله در عالم شعله عشق امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.18,
   "end": 543.44,
   "text": "خب این تو دار زحمت تازه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.44,
   "end": 548.22,
   "text": "ببین اون ور چه خبره. حالا حتی مثلاً آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.22,
   "end": 552.34,
   "text": "سی و پنج قاف رو که می‌بینی دیگه دیوانه کننده‌ست این یه تیکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.34,
   "end": 555.12,
   "text": "\"ولدننا\" پیش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.12,
   "end": 558.64,
   "text": "چی به نظر شما پیش ماست؟ خدا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.64,
   "end": 563.88,
   "text": "آقا شما هرچی اراده کنی بسم الله ما بهت میدیم که بر اساس اعمالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.88,
   "end": 569.0,
   "text": "خب حالا یه چیزیایی هم هست که ربطی به اراده‌ی شما نداره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.0,
   "end": 573.74,
   "text": "خیلی این تیکش حیرت اندر حیرت واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.74,
   "end": 577.36,
   "text": "خدا چه کرده اگه بهشتی بفهمه اینجا خدا چی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.36,
   "end": 579.84,
   "text": "\"ولدننا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.84,
   "end": 586.3,
   "text": "مزید\" یعنی ما یه چیزایی هم نگه داشتیم پیش خودمون ربطی به تلاش تو دیگه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.3,
   "end": 589.94,
   "text": "مال ماست. میدیم به اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 589.94,
   "end": 595.96,
   "text": "توجه کردین؟ این خیلی‌ها-- علامه چه کرده ذیل این آیه در مِصباح الأنوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.96,
   "end": 599.3,
   "text": "عه فرصت نیست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 599.3,
   "end": 603.1,
   "text": "عرض کرد بعد بحث یه ذره خشک می‌شه، اذیت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.1,
   "end": 605.72,
   "text": "یه چیزای زیادی پیش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.72,
   "end": 617.14,
   "text": "خب من یه سؤال کنم به نظر شما آدم اگر آگاهی نسبت به چیزی نداره هیچوقت آرزوشو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.14,
   "end": 620.58,
   "text": "می‌کنه یا نه؟ آگاهی نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.58,
   "end": 623.84,
   "text": "آرزو بکنه اصلاً محاله عقلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.84,
   "end": 631.32,
   "text": "درست شد؟ چون ما به همه چی آگاهی نداریم، دارم بحث عقلیشو می‌کنم که نمی‌خواستم بکنم الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.32,
   "end": 634.4,
   "text": "چون آگاهی به همه چی نداریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 634.4,
   "end": 638.04,
   "text": "پس خیلی چیزا رو آرزو نمی‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 638.04,
   "end": 641.08,
   "text": "که وجود داره و اون \"لدنا مزید\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.08,
   "end": 643.74,
   "text": "نزد خداست. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.74,
   "end": 646.68,
   "text": "همه‌ی اونچه هم که در بهشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.68,
   "end": 648.3,
   "text": "نتیجه‌ی عمل ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.3,
   "end": 653.88,
   "text": "بله، بسترش اون جهش دهندش، سرعت دهندش چه عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.88,
   "end": 656.06,
   "text": "اون نیرو محرکه‌ش هرچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.06,
   "end": 661.84,
   "text": "اون ملکاتش اونا منّت هرچی بگیم استعدادش بره اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.84,
   "end": 667.94,
   "text": "اعمال ما هرچی که رو. اما اونجا یه چیزایی هست که اصلاً قابل قیاس همدیگه نیست با اعمال ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.94,
   "end": 670.84,
   "text": "این روایت البته یک بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 670.84,
   "end": 674.8,
   "text": "فرمایش امیرالمؤمنین در نهجه خطبه صد و پنجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 674.8,
   "end": 677.94,
   "text": "و صد و شصت و پنج. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 677.94,
   "end": 680.78,
   "text": "مطلب عقلی یادتون نره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 680.78,
   "end": 688.72,
   "text": "عقل عملی یعنی کاری که ما می‌کنیم یعنی دنبال یه هر-- یه چیزی می‌خوایم، آرزویی داریم در جهتش تلاش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.72,
   "end": 691.08,
   "text": "این تابع عقل نظریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 691.08,
   "end": 695.84,
   "text": "یعنی در اندیشه‌ی تو چیه که این کار رو کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.84,
   "end": 700.02,
   "text": "خب. اما خیلی چیزا در اندیشه‌ی ما نیست، اون پیش خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.02,
   "end": 702.52,
   "text": "حالا مولا داره از اون پرده‌برداری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 702.52,
   "end": 704.12,
   "text": "یه بخشیش رو من عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.12,
   "end": 709.38,
   "text": "\"ایها المستمع\" به همه‌ی شما داره میگه به کسایی که گوش دادید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.38,
   "end": 712.94,
   "text": "سمع، ج-- قوه سمع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 712.94,
   "end": 715.0,
   "text": "سامعه این تمام کن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 715.0,
   "end": 718.82,
   "text": "دهان روحه. مولا داره با جان عالم حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 718.82,
   "end": 722.42,
   "text": "یکی شمایین آقا. امیرالمؤمنین که حیات و مماتش یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 722.42,
   "end": 725.52,
   "text": "همین الان مولا داره با تو میگه \"ایها المستمع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 725.52,
   "end": 730.1,
   "text": "گوشتو بده به من. بذار جانت غذا بگیره از من علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 730.1,
   "end": 733.31,
   "text": "همونطور که ده-دهانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 733.31,
   "end": 739.01,
   "text": "ده، این دهان عرض شود همین ظاهریت غذای بدن رو می‌گیره حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 739.01,
   "end": 742.85,
   "text": "جانت از گوش تغذیه کنه که دهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 742.85,
   "end": 745.89,
   "text": "روحه. بالوصول الی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 745.89,
   "end": 753.15,
   "text": "می‌خوام به شما یه چیزی رو بگم. ما يهجم عليك من تلك المناظر المونقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 753.15,
   "end": 759.97,
   "text": "لنز-- لزهت-- لزهقت نفسك شوقا اليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 759.97,
   "end": 766.09,
   "text": "و لتح-- و لتحملت من مجلسي هذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 766.09,
   "end": 771.51,
   "text": "عجب! من مجاورة اهل القبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 771.51,
   "end": 774.79,
   "text": "اونم استعجالاً بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 774.79,
   "end": 777.79,
   "text": "استعجال بر وزن استفعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 777.79,
   "end": 780.37,
   "text": "هر چیزی که توش طلب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 780.37,
   "end": 786.33,
   "text": "میگی استفعال یعنی استعجال یعنی طلب عجله می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 786.33,
   "end": 789.31,
   "text": "یعنی می‌خوای که عجله کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.31,
   "end": 791.61,
   "text": "ج-- استعجالاً بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.61,
   "end": 795.25,
   "text": "تا اینجاشو ترجمه کنم. بعد دعای مولا چه شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 795.25,
   "end": 802.67,
   "text": "چقدر این آقا مهربونه. می‌فرماید که اگر بدونید تو بهشت چه خبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 802.67,
   "end": 808.05,
   "text": "از سر شوق، از سر شوق به بهشت و اون چیزی که تو بهشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 808.05,
   "end": 810.43,
   "text": "لدنیا مزیدها که خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 810.43,
   "end": 813.51,
   "text": "و شما ازش بی‌خبرید. چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 813.51,
   "end": 815.69,
   "text": "میگه این مجلس رو ترک می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 815.69,
   "end": 819.91,
   "text": "چجوری با شوق و ذوق کوبیدید اومدید مسجد نشستید تو این جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 819.91,
   "end": 822.87,
   "text": "که به ثواب اخروی و بهشت برسید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 822.87,
   "end": 827.43,
   "text": "اصلا یه طوری می‌شید الان یه رشه‌ای از بهشت رو نشون بدن می‌ذارید به فرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 827.43,
   "end": 830.79,
   "text": "همون بیابون گردی که من میگم. کجا میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 830.79,
   "end": 834.91,
   "text": "کدوم بیابون؟ می‌فرماید و به همسایگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 834.91,
   "end": 841.55,
   "text": "مردگان میری. الی مجاورت اهل القبور استعجالاً بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 841.55,
   "end": 846.03,
   "text": "عجله می‌کنی که دست به دامن مرده‌ها میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 846.03,
   "end": 848.07,
   "text": "چون اون‌ها رفتن اون دنیا رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 848.07,
   "end": 852.73,
   "text": "تو می‌فهمی عجب الان مثلاً مادر من اونجاست، پدر من اونجاست، اینا اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 852.73,
   "end": 858.37,
   "text": "میری سراغ اونا. مثلاً آقای قاضی بیخود نبود که چهل‌ روزه می‌گرفت تو همونجا که الان دفنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 858.37,
   "end": 862.01,
   "text": "یه اتاقک رفتید انشاالله نجف پشت قبر آقای قاضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 862.01,
   "end": 864.43,
   "text": "حضرت آقای قاضی علیه الرحمه یه اتاقکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 864.43,
   "end": 870.05,
   "text": "اونجا شبانه روز عبادت می‌کرد تو اون اتاقه که الان معمولاً درش بسته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 870.05,
   "end": 877.43,
   "text": "پر از نوره اونجا. که بهش گفتن شما از کجا می‌فهمی مثلاً خیلی از علوم غریبه و غیبی که دسترسی پیداش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 877.43,
   "end": 879.85,
   "text": "فرمود همون شب نشینی‌هام تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 879.85,
   "end": 881.91,
   "text": "با مردگان از اونا پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 881.91,
   "end": 885.07,
   "text": "مولا می‌فرماید میرید مجاور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 885.07,
   "end": 888.93,
   "text": "اهل قبور می‌شید به اون‌ها نزدیک می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 888.93,
   "end": 895.13,
   "text": "چون از بهشت، ولی چون از بهشت خبر ندارید به متاع زودگذر دنیا دل بستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 895.13,
   "end": 902.03,
   "text": "چون خبر ندارید. اگر من به شما خبر بدم دست از همه دنیا می‌کشید میرید با اهل قبور همنشین می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 902.03,
   "end": 904.09,
   "text": "اون بلایی که سر آقای قاضی اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 904.09,
   "end": 906.69,
   "text": "بعد دعای اینجای مولا خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 906.69,
   "end": 911.97,
   "text": "این دعا رو هم عرض کنم نفس مولا به هممون بخوره و بسه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 911.97,
   "end": 914.61,
   "text": "جعلنا الله مولا دعا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 914.61,
   "end": 917.11,
   "text": "جعلنا الله همه جمع ام بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 917.11,
   "end": 921.59,
   "text": "خداوند ما رو قرار بدهد و جعلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 921.59,
   "end": 925.31,
   "text": "الله. جعلنا الله و اياكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 925.31,
   "end": 927.69,
   "text": "یعنی خدا ما و شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 927.69,
   "end": 929.99,
   "text": "قرار بدهد. از کیا ممن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 929.99,
   "end": 934.31,
   "text": "يسعى. خیلی سر و رمزی گفته مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 934.31,
   "end": 938.25,
   "text": "از اون کسایی که تلاش می‌کنند بقلبهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 938.25,
   "end": 943.75,
   "text": "با دلشون دل دادن به خدا، عاشقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 943.75,
   "end": 947.95,
   "text": "بقلبهی الی منازل الابرار برحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 947.95,
   "end": 951.83,
   "text": "یعنی خدا به رحمتش ما رو قرار بده از اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 951.83,
   "end": 957.63,
   "text": "چی‌ان؟ قلب، دل سپردند به اون منازل ابرار که من به شما نمیگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 957.63,
   "end": 959.63,
   "text": "که اگه بگم بیابون گرد می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 959.63,
   "end": 963.53,
   "text": "میرید قاطی مرده‌ها. ببینید تو رو خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 963.53,
   "end": 967.13,
   "text": "مولا حالا خلاصه‌ش این. مولا می‌فرماید عزیز دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 967.13,
   "end": 969.65,
   "text": "خدایی که توی این دنیای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 969.65,
   "end": 972.73,
   "text": "حق و باطل، نور و ظلمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 972.73,
   "end": 978.29,
   "text": "شر و ح-- خیر، همه چی با هم قاطیه، همش زحمته، همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 978.29,
   "end": 984.23,
   "text": "منع این‌ها بهترین چیزش رو، همون ناموسش رو، دینش رو در، به من داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 984.23,
   "end": 986.05,
   "text": "اونجا ببین چی برای من گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 986.05,
   "end": 989.67,
   "text": "اینه، حرف اینه. چقدر حرف پخته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 989.67,
   "end": 995.21,
   "text": "چه عقلی این چانه علی رو حرکت داده، این حرفو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 995.21,
   "end": 997.77,
   "text": "امیر بیان. نسبت بهش صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 997.77,
   "end": 1004.87,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1004.87,
   "end": 1007.17,
   "text": "آقا هرکی دوست داره بشینه قرآن هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}