   "title": "## دل همان‌جاست که برایش هزینه می‌شود",
   "start": 19.88,
   "end": 47.32
  },
  {
   "index": 1,
   "title": "## روایت امام کاظم؛ خرج در خیر یا خرج زمانه در باطل",
   "start": 47.32,
   "end": 87.32
  },
  {
   "index": 2,
   "title": "## تولید ثروت آری؛ انباشت ثروت نه",
   "start": 87.32,
   "end": 176.84
  },
  {
   "index": 3,
   "title": "## نمونه‌های دزدی و ترک خمس",
   "start": 176.84,
   "end": 197.7
  },
  {
   "index": 4,
   "title": "## حکایت عجیب در عیون اخبار الرضا",
   "start": 197.7,
   "end": 529.29
  },
  {
   "index": 5,
   "title": "## نیت ثلث در بیابان؛ خواب پیامبر به دزدان",
   "start": 529.29,
   "end": 549.81
  },
  {
   "index": 6,
   "title": "## عمل به ثلث؛ ده برابر سود؛ دوام معامله با حق",
   "start": 549.81,
   "end": 767.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 10.9,
   "text": ". بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.9,
   "end": 15.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.02,
   "end": 19.88,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.88,
   "end": 22.8,
   "text": "در روایت نهم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.8,
   "end": 26.28,
   "text": "کتاب الموت بودیم در خرج کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.28,
   "end": 33.48,
   "text": "و عرض کردیم که طبق روایت دل‌ها اونجایی‌ست که بابتش پول خرج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.48,
   "end": 39.68,
   "text": "روایت می‌فرمود و اگر می‌خواید دلت هر کجا بره باید تو اون راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.68,
   "end": 42.96,
   "text": "هزینه کنی. با حلوا حلوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.96,
   "end": 47.2,
   "text": "گفتن و شنیدن دهن شیرین نمی‌شه، باید هزینه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.2,
   "end": 51.24,
   "text": "یه روایتی از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.24,
   "end": 57.8,
   "text": "کاظم صلوات الله علیه هست نشون میده که اصلا پول باید خرج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.8,
   "end": 61.62,
   "text": "اگر تو خرجش نکنی در راه خیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.62,
   "end": 66.26,
   "text": "زمانه اونو خرج خواهد کرد اما در راه باطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.26,
   "end": 69.52,
   "text": "این نشون میده که اصلا سر اینکه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.52,
   "end": 73.22,
   "text": "شاید یه وجهش‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.22,
   "end": 74.88,
   "text": "صدقه بده، انفاق کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.88,
   "end": 78.16,
   "text": "حالا مخصوصا صدقات واجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.16,
   "end": 87.32,
   "text": "خمس و زکات و اینا که واجب شده شاید یه سرش در اینه که خدا ببینه که تو همت در خرج کردن پوله نه تجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.32,
   "end": 90.2,
   "text": "اسلام مخالف انباشت پوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.2,
   "end": 92.88,
   "text": "مخالف تولید ثروت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.88,
   "end": 99.58,
   "text": "اشتباه نشه. امیرالمؤمنین بیشتر از همه کار می‌کرد، چاه می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.58,
   "end": 107.76,
   "text": "مثلا نخله، نخلستان‌هایی رو احیا می‌کرد، ابقا می‌کرد، احداث می‌کرد، انشا می‌کرد که مثلا هزار اصله نخل درش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.76,
   "end": 110.92,
   "text": "تا تموم می‌شد همون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.92,
   "end": 115.78,
   "text": "سندشو به نام یه خانواده فقیر می‌زد یا ده تا خانواده فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.78,
   "end": 122.98,
   "text": "حضرت صدیقه طاهره سلام الله علیها مهاجری که کرد به اون ملعون بابت فدک به خاطر خودش نبود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.98,
   "end": 129.58,
   "text": "چون حداقل پنج هزار خانواده فقیر از عواید باغ فدک بهره می‌بردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.58,
   "end": 132.92,
   "text": "اسلام موافق تولید ثروت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.92,
   "end": 135.0,
   "text": "اما مخالف انباشت ثروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.0,
   "end": 138.44,
   "text": "اینایی که تو حسابشون می‌بینی کلی پول جمع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.44,
   "end": 140.98,
   "text": "نمی‌دونم یا ملک و املاک و از این و از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.98,
   "end": 142.8,
   "text": "اینها مخالف اینه اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.8,
   "end": 146.38,
   "text": "یا امیرالمؤمنین علیه السلام تا پول می‌آمد تو بیت المال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.38,
   "end": 150.22,
   "text": "همون شبانه شده تا دیروقت تا سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.22,
   "end": 155.2,
   "text": "اون‌هایی که تحت امر حضرت بودندو می‌گماشت که این‌ها رو به، به فلانی برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.2,
   "end": 160.92,
   "text": "حالا می‌گفت آقا الان وقتشه که خواب ملت خوابن فردا می‌فرمود کی ضمانت داده من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.92,
   "end": 169.06,
   "text": "تا فردا زنده باشم. تا قرون آخر رو حضرت پ-- تقسیم می‌کرد بعد دامن‌شو تکون می‌داد حمد خدا رو می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.06,
   "end": 170.74,
   "text": "اینا درس عبرته برای ما دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.74,
   "end": 178.46,
   "text": "پس اینکه میگه خمس زکات یعنی خدا ببینه که همت تو در خرج کردن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.46,
   "end": 183.24,
   "text": "حالا اون خودش ضمانت حفظ و ابقای بقیه مالت رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 183.24,
   "end": 189.44,
   "text": "این دیگه حداقلشه. جالبه شما برید حتی در قوم یهود تو توراتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.44,
   "end": 192.22,
   "text": "نگاه کنید، یه حکمی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.22,
   "end": 195.44,
   "text": "حتی کم سن و سال‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.44,
   "end": 197.7,
   "text": "نوجوان و جوون‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.7,
   "end": 205.42,
   "text": "وقتی به قوم اون‌ها در میان، براشون واجب می‌شه که یه بخش البته خیلی کم اما یه بخشی از دارایی‌شون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 205.42,
   "end": 208.74,
   "text": "بدن. بدن در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.74,
   "end": 213.74,
   "text": "حالا ما اسمشو ما هم داریم اسمشو می‌ذاریم خمس و زکات که در قرآن اومده به اون شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.74,
   "end": 220.84,
   "text": "این باید هزینه بشه. اون حدیثی که عرض کردم تو حف العقول صفحه چهل و هشت می‌تونید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.84,
   "end": 225.02,
   "text": "که \"ایاک ان تمنع فی طاعت الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.02,
   "end": 227.22,
   "text": "این ایاک هم خودش خیلی حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.22,
   "end": 232.58,
   "text": "\"ایاک نعبد و ایاک\" فقط و فقط از تو هست صره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.58,
   "end": 235.52,
   "text": "\"ایاک ان تمنع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.52,
   "end": 239.12,
   "text": "ان تمنع فی طاعت الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.12,
   "end": 242.56,
   "text": "می‌فرمود که دریغ مکن بر تو باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.56,
   "end": 244.84,
   "text": "دریغ مکن. این معانی رو می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.84,
   "end": 248.98,
   "text": "بر تو باد که انکه این قطعاً بر تو واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.98,
   "end": 251.84,
   "text": "مکن، نباید دریغ کنی. بر تو واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.84,
   "end": 255.38,
   "text": "بر تو باد که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.38,
   "end": 262.98,
   "text": "که خرج کردن در راه خدا رو نباید دریغ کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.98,
   "end": 267.94,
   "text": "که اگر دریغ کردی \"ان تمنع فی طاعت الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.94,
   "end": 273.52,
   "text": "منع در خرج کردن در راه خدا کردی \"ان تمنع\" منع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.52,
   "end": 275.76,
   "text": "کردی. \"فی طاعت الله\" چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.76,
   "end": 278.58,
   "text": "تو خرج نکردی، پولو انباشت کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.58,
   "end": 281.78,
   "text": "خرج نکردی. زمانه با تو چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.78,
   "end": 284.54,
   "text": "اینجاش که میگم از این روایت استخراج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.54,
   "end": 287.06,
   "text": "یه وجهش خیلی راحت همه هم می‌فهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.06,
   "end": 290.12,
   "text": "که اگه تو خرج نکنی خرج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.12,
   "end": 295.1,
   "text": "تو چه راهی خرج می‌شه؟ اگه تو در راه طاعت خرج نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.1,
   "end": 297.4,
   "text": "بله مثل همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.4,
   "end": 301.84,
   "text": "یعنی همون چیزی که شما گذاشتی کنار، مثل همون در راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.84,
   "end": 305.7,
   "text": "\"فی معصیت الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.7,
   "end": 309.5,
   "text": "در راه معصیت خدا خرج خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.5,
   "end": 312.1,
   "text": "یعنی از دست تو هم خارجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.1,
   "end": 315.2,
   "text": "اینایی که مثلاً بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.2,
   "end": 322.08,
   "text": "چند نفری تو این چند ماهه اومدن چه از همین مرکز، چه جاهای دیگه به من گفتن پول کلانی رو ازشون دزدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.08,
   "end": 324.28,
   "text": "طلا مثلا نیم کیلو طلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.28,
   "end": 327.48,
   "text": "یکی گفت در حد دو میلیارد پول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.48,
   "end": 332.02,
   "text": "سکه و چی و اینا هم بچه‌های خودمون در حد دو میلیارد از همسرش دزدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.02,
   "end": 334.78,
   "text": "تو خونه نگه داشته بوده. چی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.78,
   "end": 338.74,
   "text": "خب دو میلیارد پول کمی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.74,
   "end": 347.98,
   "text": "و اگر خ-- به نظر شما اگر خمسشو می‌داد، اگر حداقل یک دهمشو در راه خدا انفاق می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.98,
   "end": 352.06,
   "text": "خدا حفظ نمی‌کرد اون مال رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.06,
   "end": 356.94,
   "text": "باور کنید هرکس که اومد به ما این درد و دلا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.94,
   "end": 359.62,
   "text": "حالا همه رو من جرئت نکردم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.62,
   "end": 364.19,
   "text": "ضعیف و متعددند. اما چند تاشون رو من پیگیری کردم دیدم خمس ندادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.19,
   "end": 371.49,
   "text": "یه رفیقی داشتیم مال و تجاره و مغازه و وضعش خوب یهو دزد زد همه دار و ندارشو برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.49,
   "end": 373.91,
   "text": "دار و ندارشو. می‌خواست بیچاره تازه ازدواج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 373.91,
   "end": 376.89,
   "text": "اومد گفت حاجی من، گفتم نماز اول وقتت چجوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.89,
   "end": 380.53,
   "text": "گفت باور کن نمازام همه اول وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.53,
   "end": 384.71,
   "text": "گفتم صدقه به فقرا. گفت باور کن دست به خیرم، خیریه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.71,
   "end": 388.37,
   "text": "هرچی فکر کردم یهو ذهنم اومد خدا تو ذهنم انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 388.37,
   "end": 390.43,
   "text": "گفتم سال خمسی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.43,
   "end": 393.47,
   "text": "گفت نه. یه درهم، یه قلم رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.47,
   "end": 395.97,
   "text": "گفتم خب تمومه این وعده‌ی الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.97,
   "end": 400.65,
   "text": "چرا با وعده‌ی الهی در می‌افتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.65,
   "end": 403.35,
   "text": "وعده‌ی الهیه که میگه تو بده من ضمانتش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.35,
   "end": 408.11,
   "text": "یه روایتی دیدم. این روایت خیلی جای کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.11,
   "end": 411.77,
   "text": "من همینطوری عرض کنم برم. اتفاقاً اونجا هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.77,
   "end": 416.85,
   "text": "تیتر این روایت رو در عیون أخبار الرضا میاره می‌نویسه حکایتی عجیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.85,
   "end": 423.83,
   "text": "حکایتی عجیب نقل می‌کنه که خواستید نگاه کنید جلد دو صفحه چهار در عیون أخبار الرضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.83,
   "end": 429.71,
   "text": "البته در جلد نه صفحه سیصد و نود وسائل الشیعه شیخ حر عاملی هم می‌تونید اینو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.71,
   "end": 433.07,
   "text": "امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.07,
   "end": 435.53,
   "text": "می‌رفتن. حالا کی نقل می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.53,
   "end": 438.99,
   "text": "راوی خود امام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.99,
   "end": 445.05,
   "text": "امام هفتم حضرت موسی بن جعفر نقل می‌کنه که پدرم امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.05,
   "end": 448.73,
   "text": "با یه جماعت پولداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.73,
   "end": 451.89,
   "text": "صاحب مال و منال را همراه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 451.89,
   "end": 454.29,
   "text": "حالا کجا می‌رفتن تو روایت نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.29,
   "end": 459.29,
   "text": "همراه شد، تشریف می‌بردن. تو راه خبر دادن که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 459.29,
   "end": 464.61,
   "text": "تو راه خبر دادن که تو ااا دزدان مثلاً این سارق‌ها اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.61,
   "end": 473.25,
   "text": "تو راه هرکس این مسیر و داره میره زدن و خلاصه غارت و غم کردن و همه دار و ندارشونو بردن و شما هم مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.25,
   "end": 476.49,
   "text": "ظاهراً شب بوده. چجوری بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.49,
   "end": 478.63,
   "text": "که این‌ها متوقف می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.63,
   "end": 481.89,
   "text": "جرات نمی‌کنن ادامه راه رو برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.89,
   "end": 484.39,
   "text": "به حضرت خب حضرت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.39,
   "end": 487.71,
   "text": "می‌دونستن. ایشون آدم کریمیه، امانت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 487.71,
   "end": 493.33,
   "text": "بهش گفتن آقا می‌شه پول‌های ما را امانت نگه دارید پیش خودتون دارایی‌های ما رو امانت نگه دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 493.33,
   "end": 498.13,
   "text": "معلومه که پیششون بوده مثل ما تو بانک نبوده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.13,
   "end": 505.47,
   "text": "همه رو پیش شما نگه داریم شاید اینا با شما کاری نداشته باشن به خاطر اون گل روی شما مثلاً صرف‌نظر از ما کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.47,
   "end": 511.49,
   "text": "اینا رحم ندارن. حضرت فرمود چه می‌دونید شاید اینا اومدن سراغ من، اصلاً هدف اینا منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.49,
   "end": 514.45,
   "text": "و اومدن سراغ من و اتفاقاً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.45,
   "end": 518.25,
   "text": "بار و بنه منو گشتن و اینارم برداشتن بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.25,
   "end": 521.45,
   "text": "شما چرا؟ بعد گفتن خب اگه اینطوره خب دفنشون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.45,
   "end": 523.85,
   "text": "به امام صادق پیشنهاد دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.85,
   "end": 526.47,
   "text": "روایت مبسوطه. صحبت طولانی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.47,
   "end": 530.73,
   "text": "دفن کنیم اینا رو یه جا. اینا حضرت فرمود چه می‌دونید شاید یه جا دفن کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 530.73,
   "end": 535.95,
   "text": "یکی دید یکی رفت لو داد بالاخره اومدن برداشتن بردن شما دور شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 535.95,
   "end": 538.93,
   "text": "حضرت می‌خواد تداعی راهشون رو نزدیک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.93,
   "end": 542.97,
   "text": "گفتن خب حالا چه کنیم؟ حضرت فرمود می‌خواید با کسی معامله کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 542.97,
   "end": 544.95,
   "text": "امانت به کسی بسپارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.95,
   "end": 549.81,
   "text": "که هم عین مالتون رو حفظ کنه هم به نحو احسن بهتون برگردونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 549.81,
   "end": 555.79,
   "text": "و اگر برای هر درهمش تمام دنیا یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 555.79,
   "end": 559.91,
   "text": "سودی که، سودی که تازه به شما برمی‌گرده الان میگن آقا من پول بذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 559.91,
   "end": 563.65,
   "text": "انقدر پول بذار تو بانک نمی‌دونم چند درصد به تو برمی‌گردونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.65,
   "end": 569.43,
   "text": "اون درصدی که بهت برمی‌گردونه از دنیا و اونچه که درشه بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 569.43,
   "end": 571.87,
   "text": "همه تعجب کردن. عجب چه پیشنهاد خوبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.87,
   "end": 574.45,
   "text": "کیه؟ کی همچین قدرتی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 574.45,
   "end": 576.67,
   "text": "امام صادق صلوات الله علیه فرمود اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.67,
   "end": 579.21,
   "text": "بسپارید امانت به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 579.21,
   "end": 582.13,
   "text": "گفتن یعنی چی؟ یعنی ما الان چیکار باید بکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 582.13,
   "end": 584.47,
   "text": "دنبال یه راهکار اجرایی‌ان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 584.47,
   "end": 588.39,
   "text": "حضرت فرمود که یک سوم ثلث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 588.39,
   "end": 593.43,
   "text": "مالتون رو ببخشید در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 593.43,
   "end": 599.67,
   "text": "گفتن خب الان ما تو بیابونیم اینجا فقیر از کجا گیر بیاریم که ثلث مالمون رو ببخشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.67,
   "end": 602.05,
   "text": "حضرت فرمودن که نیت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.05,
   "end": 604.77,
   "text": "به به، به قربون این خونواده بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 604.77,
   "end": 607.37,
   "text": "نیت کنید. شما نیت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 607.37,
   "end": 612.05,
   "text": "یک سوم رو ببخشید تا خدا اونچه که باید با شما بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.05,
   "end": 619.11,
   "text": "باشه آقا نیت می‌کنیم. همه نیت کردن یک سوم دارایی‌شونو ببخشن به نیازمندان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.11,
   "end": 624.39,
   "text": "آقا این دزدها اومدن. آقایان دزد تشریف آوردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.39,
   "end": 627.15,
   "text": "همه دیدن که اینا رفتن سمت امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.15,
   "end": 631.27,
   "text": "گفتن عجب حضرت مثل که راست می‌گفت اینا منو می‌خوان اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.27,
   "end": 636.09,
   "text": "دیدن سر کرده دزدها افتاد دست امام صادق و بوسید و خیلی احترام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.09,
   "end": 641.67,
   "text": "گفت اون شب گفتم ما خواب جد شما رسول خدا رو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 641.67,
   "end": 646.43,
   "text": "پیغمبر در خواب به ما دستور داد یه قافله‌ای داره میاد فرزند من درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 646.43,
   "end": 648.95,
   "text": "برید این قافله رو صیانت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 648.95,
   "end": 652.13,
   "text": "تا به مقصد برسن صیانت‌شون کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 652.13,
   "end": 654.15,
   "text": "هستیم ما کاری با اموال شما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 654.15,
   "end": 660.15,
   "text": "يا ابن رسول الله در خدمت شما هستیم تا شما رو از بقیه‌ی دزدها هم حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 660.15,
   "end": 666.95,
   "text": "امام صادق فرمود که همون خدایی که از شر شما ما رو ایمن کرده، از بقیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.95,
   "end": 669.99,
   "text": "غارتگرها هم ما رو ایمن. ما نیازی به وجود شما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.99,
   "end": 672.95,
   "text": "به سلامت. اینا رو فرستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 672.95,
   "end": 674.65,
   "text": "حالا جیب ما رو نزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 674.65,
   "end": 677.73,
   "text": "نمی‌خواد معذرت کنید. اینا رفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 677.73,
   "end": 681.47,
   "text": "خلاصه حضرت راه افتاد و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 681.47,
   "end": 684.85,
   "text": "آخر داستان به اینجا کشید که روایت قطعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.85,
   "end": 687.35,
   "text": "در منابع هم قوین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 687.35,
   "end": 690.51,
   "text": "فرمود که این‌ها حرف امام صادق را الحمد لله گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 690.51,
   "end": 695.61,
   "text": "اینطور نبود که حالا از کشتی نجات پیدا کنن بگن ارکواکی داد و که رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.61,
   "end": 698.73,
   "text": "خلاصه همون تا رسیدن به شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 698.73,
   "end": 701.01,
   "text": "یک ثلث مالشونو بخشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 701.01,
   "end": 703.67,
   "text": "جستجو کردن نیازمندا رو پیدا کردن بخشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 703.67,
   "end": 706.79,
   "text": "بعد تجارت کردن. روایت میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.79,
   "end": 710.89,
   "text": "ده برابر اون دارایی‌شون سود کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.89,
   "end": 713.69,
   "text": "برکت عجیبی تو مالشون اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 713.69,
   "end": 719.69,
   "text": "و طوری که امام صادق صلوات الله علیه فرمود که حالا که دیدید برکت الهی رو، اینا رو ادامه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 719.69,
   "end": 722.87,
   "text": "همیشه در راه خدا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 722.87,
   "end": 726.01,
   "text": "در راه معامله با حضرت حق باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 726.01,
   "end": 732.19,
   "text": "و هم ثلث مالشونو زدن هم ده برابر مالی که داشتن برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.19,
   "end": 736.69,
   "text": "و هم مالشون حفظ شد. اینا یک چیزای قطعی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 736.69,
   "end": 739.57,
   "text": "اگر انسان روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 739.57,
   "end": 748.67,
   "text": "دقت کنه این اسرار رو دربیاره می‌بینه چقدر تو آرامش زندگی روزمره ما اینا تاثیرگذارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 748.67,
   "end": 750.97,
   "text": "که ما متاسفانه بهشون دقت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 750.97,
   "end": 754.19,
   "text": "یه چند تا روایت خیلی شیرین دیگه‌ای هم بود دیگه فرصت نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 754.19,
   "end": 755.93,
   "text": "حالا روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 755.93,
   "end": 760.97,
   "text": "ان‌شاءالله که عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 760.97,
   "end": 767.45,
   "text": "اللهم صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}