 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایتِ دوازدهم؛ فرار عینِ ملاقات",
   "start": 19.86,
   "end": 180.64
  },
  {
   "index": 1,
   "title": "## فرارِ مطلق و دستورِ اخلاقی",
   "start": 180.64,
   "end": 259.7
  },
  {
   "index": 2,
   "title": "## الأجل مساق النفس",
   "start": 259.7,
   "end": 876.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.08,
   "end": 8.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.78,
   "end": 11.78,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.78,
   "end": 15.02,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 18.48,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.48,
   "end": 22.72,
   "text": "میریم سراغ روایت دوازدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.72,
   "end": 29.72,
   "text": "از باب چهارم کتاب الموت مرحوم مجلسی علیه الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.72,
   "end": 36.6,
   "text": "یه اشاره‌تکی کردیم در خصوص این روایت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.6,
   "end": 42.82,
   "text": "ظاهراً اصل این و ریشه‌ی این فرمایش امام باقر رو امیرالمؤمنین دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.82,
   "end": 49.94,
   "text": "حالا عرض می‌کنم از کجا. امام باقر صلوات الله علیه فرمودن \"کل امرئ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.94,
   "end": 52.58,
   "text": "لاقٍ في فراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.58,
   "end": 58.24,
   "text": "ای من الأمور المقدرة الحتمية كال موت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.24,
   "end": 63.44,
   "text": "هیچ چیزی مثل موت نیست که شما بخوای ازش فرار کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.44,
   "end": 67.7,
   "text": "در صورتی که امری‌ست حتمی که قطعاً تو اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.7,
   "end": 72.08,
   "text": "ملاقات می‌کنی و می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.08,
   "end": 77.28,
   "text": "بعد قال الله تعالی حضرت اشاره دارن به این آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.28,
   "end": 82.34,
   "text": "قل إن الموت الذي تفرون منه فإنه ملاقيکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.34,
   "end": 85.48,
   "text": "قطعاً اون موتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.48,
   "end": 88.38,
   "text": "شما ازش فرار می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.38,
   "end": 92.58,
   "text": "فإنه ملاقيکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.58,
   "end": 95.78,
   "text": "شما به هم می‌رسید. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.78,
   "end": 98.92,
   "text": "ریشه‌ی این فرمایش حضرت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.92,
   "end": 105.74,
   "text": "از فرمایش جدشون امیرالمؤمنین علیه الصلاة والسلامه در خطبه صد و چهل و نه نهج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.74,
   "end": 110.56,
   "text": "و من کلام له عليه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.56,
   "end": 114.74,
   "text": "قبل موته یعنی قبل از شهادتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.74,
   "end": 120.0,
   "text": "امیرالمؤمنین این فرمایش رو به لسان مبارک جاری کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.0,
   "end": 126.5,
   "text": "أيا الناس خطاب آقا به همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.5,
   "end": 129.42,
   "text": "این الناس هم که اینجا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.42,
   "end": 136.94,
   "text": "می‌تونه جنبه این باشه که من میگم، من علی میگم اگرچه شما فراموش می‌کنید ولی من میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.94,
   "end": 141.98,
   "text": "یا من میگم اگرچه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.98,
   "end": 145.18,
   "text": "به این کلام باید انس بگیرید و نمی‌گیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.18,
   "end": 149.42,
   "text": "حالا چه از ریشه انس باشه، انس یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.42,
   "end": 151.88,
   "text": "ریشه‌ی نسیه یعنی فراموشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.88,
   "end": 155.86,
   "text": "کاری نداریم. حضرت می‌فرماید کل امرئ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.86,
   "end": 161.3,
   "text": "لاقٍ ما یفر منه في فراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.3,
   "end": 165.64,
   "text": "ای مردم! بدونید که هر چیزی که ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.64,
   "end": 169.54,
   "text": "می‌گریزید وقت فرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.54,
   "end": 176.76,
   "text": "خواهید دید. حالا این یه بحث فلسفی خیلی دقیقی داره این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.76,
   "end": 180.3,
   "text": "اصلاً صرفاً بحث موت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 180.3,
   "end": 182.78,
   "text": "حضرت اینجا می‌فرماید که هر چیزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.78,
   "end": 186.1,
   "text": "کلاً مطلقاً هرچی بخوای ازش فرار کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.1,
   "end": 188.78,
   "text": "می‌بینیش، ملاقاتش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.78,
   "end": 193.96,
   "text": "خب شاید از این بر گرفته شده دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.96,
   "end": 200.02,
   "text": "علمای علم اخلاق که می‌فرمایند هر چیزی رو ازش می‌ترسی خودتو بنداز اون تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.02,
   "end": 203.72,
   "text": "مثلاً شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.72,
   "end": 207.42,
   "text": "می‌ترسی از اینکه شجاعت به خرج بدی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.42,
   "end": 211.06,
   "text": "برابر دشمن. بعضیا خب نفسشون اونطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.06,
   "end": 215.24,
   "text": "شجاع نیست. میگه خودتو بنداز در معرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.24,
   "end": 217.52,
   "text": "نگرانی از اینکه ریا کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.52,
   "end": 220.0,
   "text": "دوست داری خالص باشی، نگرانی، می‌ترسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.0,
   "end": 224.4,
   "text": "میگه خودتو بنداز. تو تظاهرتو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.4,
   "end": 227.28,
   "text": "بالاخره یه ظهوری داره عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.28,
   "end": 229.56,
   "text": "هرچند مخفی کنی می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.56,
   "end": 234.4,
   "text": "تو برو تو سمتش تا انشاالله اون خلوص رو ببینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.4,
   "end": 241.06,
   "text": "ببینیش. این یک یعنی یک بحثی‌ست که ریشه، ریشه فلسفی داره، برهان داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.06,
   "end": 245.22,
   "text": "عقل پشتشه. اما ازش استفاده شده تو مباحث اخلاقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.22,
   "end": 251.32,
   "text": "تو مباحث کلامی. حالا ما خیلی هم نمی‌خوایم به اون پا فشاری کنیم چون حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.32,
   "end": 254.16,
   "text": "اینجا میزنش به بحث موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.16,
   "end": 259.7,
   "text": "امیرالمؤمنین. بعد حضرت می‌فرمایند که الأجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.7,
   "end": 265.12,
   "text": "اجل چیه؟ اجل اون دامنه زندگیه، اون میدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.12,
   "end": 268.06,
   "text": "زندگیه. آقا شما چقدر مهلت داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.06,
   "end": 270.28,
   "text": "مهلت زندگی رو میگن اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.28,
   "end": 274.16,
   "text": "با الف، با همزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.16,
   "end": 278.16,
   "text": "اون الأجل توی دعای فرج نه، اون یعنی اجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.16,
   "end": 281.2,
   "text": "الأجل اونجا با عین یعنی عجله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.2,
   "end": 284.02,
   "text": "این یعنی میدان زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.02,
   "end": 288.78,
   "text": "آقا شما چقدر فرصت داری؟ میگه آقا اجلت تا کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.78,
   "end": 292.72,
   "text": "یعنی فرصتت چقدره؟ حالا حضرت اینجا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.72,
   "end": 297.8,
   "text": "توضیح میده که اصلاً فرصت زندگی هر کسی چقدره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.8,
   "end": 301.76,
   "text": "اصلاً چگونه‌ست؟ نگاه میده به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.76,
   "end": 303.66,
   "text": "می‌فرماید الأجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.66,
   "end": 306.62,
   "text": "مساق النفس. به به!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.62,
   "end": 313.26,
   "text": "چه تعبیر عالی. مساق مذكر میمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.26,
   "end": 318.36,
   "text": "از ریشه سوق. مذكر میمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.36,
   "end": 324.22,
   "text": "که محلی، اون میدانی، اون جایگاهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.22,
   "end": 326.4,
   "text": "سوق داده می‌شه. چی سوق داده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 326.4,
   "end": 329.34,
   "text": "مساق النفس مولا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.34,
   "end": 332.28,
   "text": "نفست میدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.28,
   "end": 334.2,
   "text": "می‌گیره، چقدر میدان می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.2,
   "end": 336.12,
   "text": "یعنی از کجا به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.12,
   "end": 338.78,
   "text": "نفست و مجالش چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.78,
   "end": 342.28,
   "text": "از کجا شروع شده و به کجا ختم می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.28,
   "end": 347.22,
   "text": "یه میدانی داره، یه محلی داره که نفس انگار داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.22,
   "end": 350.58,
   "text": "یه کسی انگار دنبالش کرده داره سوقش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.58,
   "end": 353.4,
   "text": "مثل یه کسی که سوار یه مرکبی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.4,
   "end": 357.24,
   "text": "با تازیانه می‌زنه اینو، حرکتش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.24,
   "end": 362.28,
   "text": "نفس داره سوق پیدا می‌کنه به یک سمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.28,
   "end": 366.16,
   "text": "اون سمت اگرچه إلى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.16,
   "end": 370.16,
   "text": "و انا الیه راجعون رجعت به سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.16,
   "end": 373.26,
   "text": "به سمت رب پیغمبر که و ان الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.26,
   "end": 377.3,
   "text": "ربک الرجع. و ان الی ربک المنتهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.3,
   "end": 380.16,
   "text": "رب پیغمبر که الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.16,
   "end": 383.3,
   "text": "داره به اون سمت سوق پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.3,
   "end": 385.42,
   "text": "خب این از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.42,
   "end": 388.32,
   "text": "سمت و سوی سوق نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.32,
   "end": 393.64,
   "text": "اما اجل چیه که سوق نفس مشخصش میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.64,
   "end": 397.2,
   "text": "یعنی مهلت شما. آقا چقدر مهلت داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.2,
   "end": 401.64,
   "text": "الان یه نفر سؤال کنه خدایا میشه به من بگی مهلت من چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.64,
   "end": 406.38,
   "text": "خب الان این مقدار از خدا از تو عمر گرفتم میدونم این چند ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.38,
   "end": 408.52,
   "text": "از اینجا به بعد چقدر مهلت دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.52,
   "end": 411.88,
   "text": "مولا داره میفرماید همون مقداری که نفست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.88,
   "end": 418.68,
   "text": "سوق داده میشه. سوق داده میشه به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.68,
   "end": 422.96,
   "text": "الی الله. حالا اینجا تاکید مولا است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 422.96,
   "end": 425.52,
   "text": "والهرب منه موافاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.52,
   "end": 430.84,
   "text": "حواست باشه که فرار کنی ازش موافاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.84,
   "end": 433.46,
   "text": "میبینیش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.46,
   "end": 438.5,
   "text": "اصرار حضرت بر این موضوعه که میگم میزنش به موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.5,
   "end": 441.82,
   "text": "حواست جمع باشه که نمیشه از مرگ فرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.82,
   "end": 446.7,
   "text": "هرچی تو فرار کنی میبینی اتفاقا داری بهش نزدیک‌تر میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.7,
   "end": 448.58,
   "text": "قصه اینجاست. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.58,
   "end": 453.08,
   "text": "چون آنفآن موت ما داره میرسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.08,
   "end": 457.06,
   "text": "حالا فرقی هم نمیکنه چه موت رو شما موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.06,
   "end": 461.84,
   "text": "اون اجل معلق بگیری یا اجل مسمى بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.84,
   "end": 465.28,
   "text": "موت هر نوع موتی بگیری چون ما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.28,
   "end": 467.68,
   "text": "اجلی داریم قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.68,
   "end": 472.08,
   "text": "لا یستقدمون ساعة ولا يستخرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.08,
   "end": 474.2,
   "text": "وقتی که اجل بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.2,
   "end": 477.52,
   "text": "دیگه این ساعت هم اینجا منظور شصت ثانیه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.52,
   "end": 481.6,
   "text": "یعنی آنی، آنی تأخير بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.6,
   "end": 484.58,
   "text": "جلوپیچ شدن اون اجل حتمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.58,
   "end": 492.16,
   "text": "چه اجل حتمی باشه که من و شما در هر حالتی باشیم اجل حتمی اومد تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.16,
   "end": 496.74,
   "text": "برای همین مثلاً در مستحبات میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.74,
   "end": 501.46,
   "text": "سعی کن توی معذرت میخوام بیت الخلاء زیاد نمونی، توقف نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.46,
   "end": 504.98,
   "text": "شاید اجل حتمی رسید، اون تو نمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.98,
   "end": 509.72,
   "text": "یا مثلاً میگه با پای چپ برو تو با پای راست، راست بیا بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.72,
   "end": 514.44,
   "text": "حالا پزشکی ثابت کرده که آدم سکته که میکنه معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.44,
   "end": 516.94,
   "text": "به سمت راستش متمایل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.94,
   "end": 522.1,
   "text": "اینا حالا دلایل مختلفی هم داره گفتن حالا کاری به اون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.1,
   "end": 526.36,
   "text": "میبینی که مکروهات هم میاد سوار بر این دلیل عقلی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.36,
   "end": 530.06,
   "text": "این مستحبات، مکروهات هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.06,
   "end": 534.0,
   "text": "چه اجل، اجل حتمی باشه، چه اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.0,
   "end": 538.54,
   "text": "غیر حتمی معلقه که با چی اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.54,
   "end": 541.44,
   "text": "با گناه. گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.44,
   "end": 544.0,
   "text": "اجل حتمی رو زودتر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.0,
   "end": 546.2,
   "text": "میشه اجل، میشه اجل معلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.2,
   "end": 549.18,
   "text": "یعنی روایت هم داریم که آدم‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.18,
   "end": 552.14,
   "text": "به خاطر گناهاشون میمیرن زود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.14,
   "end": 555.24,
   "text": "خیلی تعدادشون بیشتر از اونهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.24,
   "end": 558.74,
   "text": "به خاطر اجل حتمیشون زود مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.74,
   "end": 561.02,
   "text": "چون خدا مهلت میده. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.02,
   "end": 563.22,
   "text": "اصلا دلالتش بر اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.22,
   "end": 567.9,
   "text": "اصلا خدا رحمت، رحمتش بر این تعلق گرفته که تا میتونه مهلت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.9,
   "end": 571.92,
   "text": "هی مهلت میده، هی مهلت. میگن صبر خدا چهل ساله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.92,
   "end": 577.96,
   "text": "البته اینو عرض کنم این قاطی نشه با اون فرمایش امام صادق صلی الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.96,
   "end": 585.58,
   "text": "فرمود که اون آیه در قرآن هست که خدا قیامت به مردم میگه چقدر من به اندازه شما به اندازه کافی به شما مهلت دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.58,
   "end": 587.58,
   "text": "یا ملائکه از طرف خدا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.58,
   "end": 592.94,
   "text": "انسان‌ها میگن محلتی که خدا تو دنیا به شما داد بس نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.94,
   "end": 596.96,
   "text": "بعد سؤال شده از حضرت که این مهلت که اینجا معلوم نیست چقدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.96,
   "end": 600.98,
   "text": "چون یکی یه سال زندگی میکنه تو دنیا، یکی صد سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.98,
   "end": 605.62,
   "text": "این مهلت منظور چیه؟ حضرت فرمود هجده ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 605.62,
   "end": 609.66,
   "text": "هجده سال بسه برای اینکه کسی خودشو بسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.66,
   "end": 617.12,
   "text": "لذا باز علمای اخلاق از این فرمایش حضرت استفاده کردن فرمودن هرچی کردی تا هجده سالگی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 617.12,
   "end": 619.34,
   "text": "از اون دیگه زیربناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.34,
   "end": 622.24,
   "text": "اون میشه بستر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 622.24,
   "end": 624.62,
   "text": "مثل سکوی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.62,
   "end": 628.36,
   "text": "که این سکو چه مقدار فونداسیونش قویه برای پرواز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.36,
   "end": 632.9,
   "text": "همونه. دیگه حالا بقیش دیگه بر اون سوار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 632.9,
   "end": 636.46,
   "text": "توجه کردید؟ اما در هر حال این مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.46,
   "end": 639.86,
   "text": "چه اجل معلق باشه چه حتمی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.86,
   "end": 646.5,
   "text": "اصلا هر نوع اجلی باشه شما هرچی که میخوای ازش فرار کنی چون آنفآن داره میگذره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.5,
   "end": 649.2,
   "text": "این دار، دار تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 649.2,
   "end": 652.82,
   "text": "دار تدریجه یعنی زمان برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.82,
   "end": 657.48,
   "text": "اون طرف که اینطوری نیست که، اونجا زمان‌بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 657.48,
   "end": 659.7,
   "text": "اونجا دهره بعدم سرمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.7,
   "end": 663.9,
   "text": "روح زمان قبلاً عرض کردیم روح زمان میشه دهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.9,
   "end": 666.42,
   "text": "روح دهر هم میشه سرمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.42,
   "end": 670.74,
   "text": "یعنی ملکوت زمان دهره که زمان‌بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.74,
   "end": 674.26,
   "text": "یعنی یه کسی یک میلیارد سال پیش مرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.26,
   "end": 677.24,
   "text": "یه نفرم یک میلیارد سال بعد میمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.24,
   "end": 681.06,
   "text": "از اون طرف هیچ تفاوتی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.06,
   "end": 684.34,
   "text": "اون طرف اصلا زمان‌بردار نیست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.34,
   "end": 686.88,
   "text": "اینجاست که دار، دار تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.88,
   "end": 691.0,
   "text": "مثل اینکه شما الان اصلا زمان رو بر اساس چی داری محاسبه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 691.0,
   "end": 696.12,
   "text": "قربونت برم. همین میگی یک دقیقه بر اساس دقیقه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.12,
   "end": 699.36,
   "text": "شصت دقیقه یک ساعته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.36,
   "end": 700.94,
   "text": "در روز. روز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 700.94,
   "end": 703.24,
   "text": "بیست و چهار ساعته. ساعت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.24,
   "end": 706.76,
   "text": "شمسی. حالا یا قمری هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.76,
   "end": 713.98,
   "text": "یعنی یه دور، یک دور به دور خودش بچرخه بر اساس حالا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.98,
   "end": 717.1,
   "text": "خورشید یا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 717.1,
   "end": 722.52,
   "text": "قمر. خب حالا شما بیا این محاسبه رو از روی خورشید بردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.52,
   "end": 725.18,
   "text": "ببر روی اون کهکشان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.18,
   "end": 730.59,
   "text": "اون کراتی که چه میلیون برابر خورشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 730.59,
   "end": 735.97,
   "text": "ما داریم سیاره‌هایی که چند میلیون مثلا صد میلیون برابر خورشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 735.97,
   "end": 742.93,
   "text": "اصلا نمیشه تصورش کرد. اگر بخوای ساعت رو ببری یه دوره دوره اون چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 742.93,
   "end": 745.51,
   "text": "شبانه روز رو. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 745.51,
   "end": 748.33,
   "text": "کل عمر شما میشه یک ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 748.33,
   "end": 752.07,
   "text": "توجه کردینا من این مثال رو زدم حتی از حیث طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 752.07,
   "end": 755.59,
   "text": "که ذهن، ذهن رو بشورونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 755.59,
   "end": 759.33,
   "text": "ببریم به این سمت که میشه اصلا زمان رو برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 759.33,
   "end": 765.15,
   "text": "این اعتبار بین ماست. حالا شما اعتبار خورشید و ماه رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.15,
   "end": 768.51,
   "text": "مثلا میگه انتها پیدا نـ-نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 768.51,
   "end": 775.07,
   "text": "خب پس مهم اینجاست چیزی که حالا فرمایش مولا ادامه داره‌ها باشه انشاالله روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 775.07,
   "end": 780.21,
   "text": "مهم چیزی که دلالت روایته بر اینه تأکیدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 780.21,
   "end": 783.61,
   "text": "صراحتش که \"ول هرب منه موافاتو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 783.61,
   "end": 788.85,
   "text": "که اینو حواست جمع باشه که داری اصلا به سمت مرگ میدوی، حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 788.85,
   "end": 792.87,
   "text": "بعد یه چیز جالبی اینجا امیرالمؤمنین میگه باشه طلبتون خیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 792.87,
   "end": 796.97,
   "text": "من خودم وقتی این رو شنیدم از مولا، از امیر بیان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 796.97,
   "end": 800.95,
   "text": "از کسی که فرمود \"لو کشف لقط عالم ازددت یقینا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 800.95,
   "end": 807.25,
   "text": "اگه پرده بیفته بر یقین من اضافه نمیشه، خیلی برام عجیب اومد این فرمایش مولا ادامه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 807.25,
   "end": 812.19,
   "text": "فرمایششه. برید ببینید خطبه صد و چهل و نه نهج‌البلاغه تشنه نگه‌تون دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 812.19,
   "end": 814.61,
   "text": "یه جمله عجیبی اینجا فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 814.61,
   "end": 817.83,
   "text": "مولا در خصوص اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 817.83,
   "end": 820.73,
   "text": "کنز بودن، مخفی بودن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 820.73,
   "end": 824.47,
   "text": "در حقیقت پنهان بودن، مخزون بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 824.47,
   "end": 829.13,
   "text": "مرگ و اسرارشه. انگار یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 829.13,
   "end": 833.19,
   "text": "در یک کَنی، در یک پرده‌ای، فی کتاب مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 833.19,
   "end": 837.51,
   "text": "قرار گرفته که کسی خبر نداره از کم و کیفش انگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 837.51,
   "end": 839.99,
   "text": "یه چیز عجیبیه این موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 839.99,
   "end": 843.59,
   "text": "چشیدنیه رفیق. برای همین میگه \"موتوا قبلا تموتوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 843.59,
   "end": 846.63,
   "text": "قبل اینکه اونجا بشی همینجا به خودت بچشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 846.63,
   "end": 849.05,
   "text": "خودت زرنگ باش. خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 849.05,
   "end": 853.81,
   "text": "اسرار داره. تعجب نکنید که اگه ما تازه اول کتاب الموتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 853.81,
   "end": 855.87,
   "text": "صد و خرده‌ای جلسه صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 855.87,
   "end": 862.71,
   "text": "خیلی اسرار داره و قراره ما این گنجینه اسرار رو بازگشایی کنیم و ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 862.71,
   "end": 867.57,
   "text": "انشاالله آقای مرادی خوشش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 867.57,
   "end": 870.83,
   "text": "انشاالله با شهادت و عاقبت به خیری درک کنیم، بچشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 870.83,
   "end": 876.33,
   "text": "صلوات ختم کنیم. اللهم صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}