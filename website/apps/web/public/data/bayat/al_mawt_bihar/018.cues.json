 "chapters": [
  {
   "index": 0,
   "title": "## صور علمیه برای فهم روایت موت",
   "start": 35.12,
   "end": 209.22
  },
  {
   "index": 1,
   "title": "## روح و نور در متن حدیث موت",
   "start": 209.22,
   "end": 438.66
  },
  {
   "index": 2,
   "title": "## الی القدرة؛ بازگشت به قدرت و انسان کامل",
   "start": 438.66,
   "end": 458.98
  },
  {
   "index": 3,
   "title": "## مراتب نور تا بی‌رنگی",
   "start": 458.98,
   "end": 651.26
  },
  {
   "index": 4,
   "title": "## قدرت در وحدت",
   "start": 651.26,
   "end": 958.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 6.36,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.36,
   "end": 12.5,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.5,
   "end": 17.56,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.56,
   "end": 20.06,
   "text": "نکته خیلی مهمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.06,
   "end": 23.04,
   "text": "باید امروز عرض کنیم البته جای خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.04,
   "end": 29.8,
   "text": "جرح و تعدیل و بحث زیاد داره اما چون متاسفانه بعضی از شما دوستان بعض-- قبلاً البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.8,
   "end": 35.12,
   "text": "این دست صحبت‌ها رو خیلی نمی‌پسندیدید من خیلی روش پا فشاری نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.12,
   "end": 37.76,
   "text": "برای سهولت فهم از اینجا شروع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.76,
   "end": 40.28,
   "text": "برای اینکه بتونیم اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.28,
   "end": 42.9,
   "text": "قسمتی از روایت چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.9,
   "end": 47.9,
   "text": "باب اول کتاب الموت مرحوم مجلسی رو خوب متوجه بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.9,
   "end": 49.58,
   "text": "این نکته رو خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.58,
   "end": 58.34,
   "text": "ببینید ما بیرون از خودمون در متن خارج اصطلاحاً اشیایی هستند، موجوداتی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.34,
   "end": 67.58,
   "text": "ما نسبت به این اشیا و موجودات علمی داریم، اطلاعات و آگاهی‌ای داریم حتی در ذهنمون صورت و شکلی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.58,
   "end": 70.44,
   "text": "اشیا وجود داره. اون علمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.44,
   "end": 72.82,
   "text": "ما به اشیاء بیرون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.82,
   "end": 76.42,
   "text": "متن وجود خودمون، بیرون از ذاتمون داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.42,
   "end": 80.42,
   "text": "هرچی می‌خواد باشه حتی علمی که به خودمون داریم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.42,
   "end": 85.12,
   "text": "یک صورت‌هایی داره این علوم، این دانسته‌ها، این آگاهی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.12,
   "end": 87.26,
   "text": "بهش میگن صور علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.26,
   "end": 90.5,
   "text": "چیز عجیبی نیست. به چی؟ به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.5,
   "end": 94.12,
   "text": "علمی که ما به پیرامونمون و به اشیا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.12,
   "end": 98.0,
   "text": "در علم فلسفه و عرفان‌ها بهش میگن صور علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.0,
   "end": 102.54,
   "text": "چیز عجیبی نیست. که این صور علمیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.54,
   "end": 105.1,
   "text": "نفس ماست. در ثقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.1,
   "end": 108.06,
   "text": "یعنی اون پناهی و کمون ذات ماست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.06,
   "end": 112.36,
   "text": "که ما وقتی یک چیزی رو می‌بینیم در مقام مرئی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.36,
   "end": 116.18,
   "text": "ما در-- اون مرئی و ما راهی هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.18,
   "end": 120.08,
   "text": "ما می‌بینیم چیزی رو، عین اون رو نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.08,
   "end": 122.28,
   "text": "ما در خودمون اون رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.28,
   "end": 125.76,
   "text": "ما هرچی رو داریم نگاه می‌کنیم نفسمون می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.76,
   "end": 128.2,
   "text": "و نفس ما اون رو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.2,
   "end": 132.62,
   "text": "نفس ما در درون خودش داره عکس اون رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.62,
   "end": 134.56,
   "text": "حالا اینم بحثیه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.56,
   "end": 137.36,
   "text": "پس یک صورتی از علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.36,
   "end": 142.4,
   "text": "صور علمیه بهش میگن. همچین چیزی در خدا هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.4,
   "end": 145.78,
   "text": "در خدا هم پیش از اینکه-- حالا این ما میگیم پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.78,
   "end": 151.26,
   "text": "از اینکه به جهت سهولت فهمه، به ضرب من البيانه و الا پیش و پس نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.26,
   "end": 154.48,
   "text": "خدا بوده، کان الله ولم یکن شیء ان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.48,
   "end": 156.88,
   "text": "ولم یکن معه شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.88,
   "end": 159.4,
   "text": "الان کما کان. الانم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.4,
   "end": 161.04,
   "text": "خدا بود و هست و خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.04,
   "end": 164.58,
   "text": "خدا هست و خدایی می‌کنه. هرچه که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.58,
   "end": 166.84,
   "text": "شؤون حضرت حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 166.84,
   "end": 170.7,
   "text": "یعنی نمیشه خدا اسم الباطنش باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.7,
   "end": 173.46,
   "text": "اسم الظاهرش پیاده نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 173.46,
   "end": 178.06,
   "text": "یعنی چی؟ یعنی خدا بود، خلائق هم بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.06,
   "end": 182.38,
   "text": "خلائق در ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.38,
   "end": 185.68,
   "text": "صورت‌هایی دارند. همین مثالی که در خودمون زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.68,
   "end": 189.06,
   "text": "آیا-- س-سوال، آیا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.06,
   "end": 191.46,
   "text": "به اشیا علم داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 191.46,
   "end": 197.22,
   "text": "اصلاً بگو قبل از خلقت، قبل از اینکه خدا ما رو خلق کنه به ما علم داشت یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.22,
   "end": 202.78,
   "text": "اون علمی که خدا به اشیا به من جمله به ما داره و داشت بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.78,
   "end": 209.12,
   "text": "همون صور اشیا، صور علمیه اشیا در ثبع ذات ربوبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.12,
   "end": 212.78,
   "text": "از این کلمات نترسید. یعنی در ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.78,
   "end": 218.7,
   "text": "که به اون در فلسفه میگن ماهیات، در عرفان میگن اعیان ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.7,
   "end": 224.88,
   "text": "یعنی ما یک عین ثابتی داشتیم در ذات حضرت حق که علم خدا به ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.88,
   "end": 228.54,
   "text": "نترسیم از این کلمات. با این جمله متوجه می‌شیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.54,
   "end": 231.1,
   "text": "کجا رو داریم می‌زنیم. علم خدا به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.1,
   "end": 233.64,
   "text": "خدا به ما علم داشت دیگه قبل از خلقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.64,
   "end": 239.5,
   "text": "پس ما قبل از اینکه ظهور پیدا کنیم بر اساس اسم الظاهر خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.5,
   "end": 241.54,
   "text": "در علم الهی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.54,
   "end": 245.18,
   "text": "یک صورت علمیه داشتیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.18,
   "end": 247.44,
   "text": "ذات حضرت حق. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.44,
   "end": 253.06,
   "text": "وقتی خلق شدیم یک صورت عینیه پیدا کردیم که الان هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.06,
   "end": 256.38,
   "text": "پس ما یک عین داریم، یک علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.38,
   "end": 260.54,
   "text": "اینو دارم مقدمه می‌چینم به این نکته‌ای که در این حدیث هست برسیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.54,
   "end": 266.38,
   "text": "چقدر عجیب و شریف این رو بیان کرده امام صادق سلام الله علیه در خصوص حقیقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.38,
   "end": 269.88,
   "text": "و ما داریم به چه سمتی میریم؟ ناگزیریم از فهم این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.88,
   "end": 274.9,
   "text": "نگیم این حرفا چیه. اینا حقایقی که از اهل بیت تو روایاتشون ریختن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.9,
   "end": 279.72,
   "text": "حکما با ذربین طهارت نفس اینا رو استیضاح کردن به من و شما دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.72,
   "end": 281.88,
   "text": "ما داریم به چه سمتی میریم؟ ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.88,
   "end": 284.36,
   "text": "پس ما یک علم داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.36,
   "end": 288.08,
   "text": "یک عین. ما در ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.08,
   "end": 291.44,
   "text": "صورت علمیه بودیم، یعنی خدا به ما علم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.44,
   "end": 294.36,
   "text": "بعد که خلق شدیم شدیم صورت عینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.36,
   "end": 304.68,
   "text": "تا اینجا. حالا اون صورت علمیه ما در ذات حضرت حق پیش از خلقت رو که علم خدا به ما بود رو بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.68,
   "end": 309.96,
   "text": "عین ثابت که زبان حال ما اونجا تو علم خدا هرچی بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.96,
   "end": 312.22,
   "text": "خدا همون بلا رو سر ما آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.22,
   "end": 315.18,
   "text": "یعنی ما تو علم خدا که بودیم زبان حالمون چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.18,
   "end": 317.54,
   "text": "از خدا چی می‌خواستیم؟ کی به دنیا بیاییم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.54,
   "end": 321.84,
   "text": "پدر مادرمون کی باشه؟ اصلاً مذهب و دینمون چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.84,
   "end": 327.26,
   "text": "ربمون کی باشه؟ همه رو اونجا زبان حال ما هرچی بود خدا همون بلا رو سر ما آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.26,
   "end": 330.46,
   "text": "به یک معنا اون بهش، بهش میگن عالم زر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.46,
   "end": 332.62,
   "text": "عالم زر یک معناش همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.62,
   "end": 340.36,
   "text": "حالا اونجا وقتی که ما در علم حضرت حق بودیم رو بهش میگن فیض اقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.36,
   "end": 342.78,
   "text": "این‌ها رو، این کلمات رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.78,
   "end": 348.54,
   "text": "ک-سحف نوریه عرفانیه و حالا فلسفی و عرفانی و حکمی می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.54,
   "end": 350.12,
   "text": "فیض اقدس چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.12,
   "end": 353.02,
   "text": "یعنی ما قبلاً فیض اقدس بودیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.02,
   "end": 356.2,
   "text": "یعنی در علم خدا بودیم. اینو پذیرفتید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.2,
   "end": 363.22,
   "text": "فیض مقدس چیه؟ وقتی که به صورت عینی درومدیم، یعنی خلق شدیم، یعنی ظهور کرد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.22,
   "end": 366.42,
   "text": "یک شأن از شؤون خدا شد من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.42,
   "end": 370.28,
   "text": "به من میگن عینی، یک وجود عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.28,
   "end": 373.1,
   "text": "به این میگن فیض مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.1,
   "end": 377.8,
   "text": "چون اومده به عالم کثرات از اون وحدت خارج شده ضعیف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.8,
   "end": 380.26,
   "text": "کثرات اصلاً ضعف می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.26,
   "end": 384.82,
   "text": "ضعف داره. هرچی میری به سمت وحدت و توحید لا اله الا هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.82,
   "end": 387.04,
   "text": "این قدرت می‌گیره، قوت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.04,
   "end": 391.34,
   "text": "مخصوصاً به این کلمات دقت کنین چون میرین رو متن حدیث میگید عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.34,
   "end": 394.12,
   "text": "چقدر شیرین اینا رو حضرت دور هم جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.12,
   "end": 397.98,
   "text": "قدرت می‌گیره. به چه سمتی بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.98,
   "end": 400.56,
   "text": "به سمت وحدت، توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.56,
   "end": 404.18,
   "text": "لا اله الا هو. لا هو الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.18,
   "end": 408.28,
   "text": "این اش-- این که میگن اسم اعظم به یک معنا اینه، قدرت محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.28,
   "end": 412.28,
   "text": "پس متوجه قدرت، جایگاه قدرت، علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.28,
   "end": 414.6,
   "text": "خدا به اشیا، صور علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.6,
   "end": 421.28,
   "text": "این که ما اول علم، علم بودیم در ذات حضرت حق، بعد عین شدیم، شدیم و اون فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.28,
   "end": 425.2,
   "text": "اقدس است. این که الان شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.2,
   "end": 427.22,
   "text": "فیض مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.22,
   "end": 429.22,
   "text": "که تنزل پیدا کردیم اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.22,
   "end": 431.02,
   "text": "ان انزلناه فی ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.02,
   "end": 438.58,
   "text": "تنزل پیدا کردیم اومدیم. که حالا در زیارت نامه حضرت زهرا سلام الله علیها میگه یا السلام علیک یا ممتحنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.58,
   "end": 441.2,
   "text": "تا حالا فکر کردید ممتحنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.2,
   "end": 443.34,
   "text": "کسی که امتحان پس داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.34,
   "end": 445.02,
   "text": "کی؟ قبل ای خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.02,
   "end": 447.38,
   "text": "قبل اینکه خلق بشی امتحان پس دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.38,
   "end": 450.26,
   "text": "یعنی چی؟ برمی‌گرده به علم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 450.26,
   "end": 454.76,
   "text": "آیا خدا علم داشت که حضرت زهرا سلام الله علیها عمرش بیسته یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 454.76,
   "end": 458.34,
   "text": "داشت یا نه؟ خب یعنی قبل از خلقت دیگه چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 458.34,
   "end": 460.24,
   "text": "پس عین علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 460.24,
   "end": 466.92,
   "text": "علمی که خدا به حضرت زهرا داشت در صغری ذات ربوبی بود، به اون میگن صورت علمیه، یعنی فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.92,
   "end": 471.2,
   "text": "اقدس. وقتی حضرت زهرا سلام الله علیها اومد به دامن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.2,
   "end": 473.46,
   "text": "ممکنات و تش-- و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 473.46,
   "end": 478.8,
   "text": "خلق شد اصطلاحاً حد پیدا کرد، مقید شد، از اون صورت کلی خارج شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 478.8,
   "end": 481.72,
   "text": "دیگه شد فیض ورود کرد به عالم فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.72,
   "end": 483.8,
   "text": "مقدس. جانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 483.8,
   "end": 487.54,
   "text": "این علم منظور همون روحی که خدا میده به انسان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.54,
   "end": 489.36,
   "text": "احسن به شما. احسن به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.36,
   "end": 492.66,
   "text": "شما از ما جلوتری. بله، بله. وفخت فیهم الروحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.66,
   "end": 495.14,
   "text": "ما گفتیم این روح و نور برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.14,
   "end": 498.04,
   "text": "ردت فردت الروح والنور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 498.04,
   "end": 501.28,
   "text": "اصلاً تو متن حدیث این الان شما هم دقیقاً درست گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 501.28,
   "end": 504.16,
   "text": "برمی‌گرده به کی؟ به ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.16,
   "end": 506.0,
   "text": "بله. به یک معنا همون روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 506.0,
   "end": 508.9,
   "text": "به یک معنا نوره. چرا تجزیه میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 508.9,
   "end": 511.22,
   "text": "چراشو قبلاً گفتیم. خستتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 511.22,
   "end": 513.9,
   "text": "بریم سراغ متن حدیث. ببینید حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 513.9,
   "end": 522.36,
   "text": "صادق صلوات الله علیه حقیقت موت رو با توجه به این مطالبی که من مقدمه چیدم چگونه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 522.36,
   "end": 525.92,
   "text": "اولاً فرمود که فردت الروح والنور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 525.92,
   "end": 528.38,
   "text": "قبلش که فرمود ترک الجسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 528.38,
   "end": 531.76,
   "text": "ترک می‌کنه اون شأن اخروی جسد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.76,
   "end": 533.88,
   "text": "و انما فسد الجسد في الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 533.88,
   "end": 535.86,
   "text": "جسد تو دنیا می‌مونه فاسد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 535.86,
   "end": 542.9,
   "text": "علتشو هم عرض کردیم چون از نون و آبیه که پدر مادر خوردن نطفه تشکیل شده مال چرخه طبیعته باید اینجا بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 542.9,
   "end": 545.06,
   "text": "صورت منتبه است، طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 545.06,
   "end": 549.4,
   "text": "باید اینجا بمونه. که به یک معنا صورت شیطانی همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 549.4,
   "end": 551.82,
   "text": "صورت منتبه است. باید بمونه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 551.82,
   "end": 555.14,
   "text": "خب بعد چی می‌شه؟ حضرت فرمود فردت الروح والنور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 555.14,
   "end": 558.7,
   "text": "روح و نور برمی‌گردن. به کجا برمی‌گردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 558.7,
   "end": 562.52,
   "text": "یعنی وقتی من و شما موت حاصل شد در بارمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 562.52,
   "end": 566.12,
   "text": "روح و نور از وجود ما جدا میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 566.12,
   "end": 570.2,
   "text": "اون دم و شهوت می‌مونن، صورت حیوانی می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.2,
   "end": 572.62,
   "text": "این وقتی میره، چی میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 572.62,
   "end": 578.2,
   "text": "روح و نور. عرض کردیم چرا نـ-- روح و نور دیگه برمی‌گرده به اون اصلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 578.2,
   "end": 586.08,
   "text": "خلقتمون از تکلم خدا نور، تکلم دوم روح، امتزاج این دو و خلقت خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.08,
   "end": 589.72,
   "text": "حالا وقتی برگشتن به کجا برمی‌گردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.72,
   "end": 591.44,
   "text": "این انتها رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.44,
   "end": 593.88,
   "text": "الی القدرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 593.88,
   "end": 597.06,
   "text": "قدرت. الان گفتیم چی؟ هرچی میری به سمت وحدت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 597.06,
   "end": 598.84,
   "text": "قدرت ازدیاد پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 598.84,
   "end": 601.86,
   "text": "میای به سمت کثرت عالم فیض مقدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 601.86,
   "end": 604.46,
   "text": "کس-کثرات ضعف میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.46,
   "end": 607.22,
   "text": "وحدت، وحدت محض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 607.22,
   "end": 610.66,
   "text": "شدت قدرته. ببینید نکته‌ها رو امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 610.66,
   "end": 614.84,
   "text": "الی القدرة. یعنی ما میریم به سمت وحدت، توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.84,
   "end": 617.0,
   "text": "میریم به سمت اون اصلیتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 617.0,
   "end": 622.56,
   "text": "آیا به نظر شما برمی‌گردیم به سمت فیض اقدس یا مقدس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 622.56,
   "end": 626.58,
   "text": "ها؟ اقدس؟ یعنی با-- برمی‌گردیم به علم حق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 626.58,
   "end": 630.96,
   "text": "ما که دیگه عینیت پیدا کردیم، خارج شدیم از ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 630.96,
   "end": 635.16,
   "text": "حضرت می‌فرماید کجا میرید؟ الی القدرة القدس الاولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 635.16,
   "end": 637.26,
   "text": "القدس الاولى. به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 637.26,
   "end": 642.0,
   "text": "فیض، یعنی میرید به عالم، برمی‌گردید به رتبه‌های عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 642.0,
   "end": 645.4,
   "text": "فیض مقدس، نه اقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 645.4,
   "end": 648.04,
   "text": "اقدس که علم خدا بود، دیگه خارج شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 648.04,
   "end": 649.62,
   "text": "دیگه میریم به سمت مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 649.62,
   "end": 652.88,
   "text": "ببین حضرت اینجا مقدس، قدرت بعد مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 652.88,
   "end": 657.1,
   "text": "قدس الاولى. الی القدرة القدس الاولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 657.1,
   "end": 659.32,
   "text": "یعنی اون ماده اولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 659.32,
   "end": 662.2,
   "text": "حالا ماده اولیه چیه؟ صادر نخستینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 662.2,
   "end": 664.76,
   "text": "آخ، آخ، آخ. دیگه ما چی بگیم از اینجا سرتون درد میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 664.76,
   "end": 667.26,
   "text": "قبلاً البته خیلی چیزا گفتیم حوصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 667.26,
   "end": 669.26,
   "text": "بدیمیا بیشتر بود گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 669.26,
   "end": 673.46,
   "text": "صادر اول نفس الرحمن برزخ بین حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 673.46,
   "end": 681.94,
   "text": "که همه کثرات منتبه són در اون به وجود نوری که پیغمبر عزیز عالم در قوس سعود رفت به مقام صادر اول رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 681.94,
   "end": 686.04,
   "text": "رجا-- لذا همه خلائق شئون وجودی او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 686.04,
   "end": 689.86,
   "text": "ما میریم به اون سمت. یعنی داریم میریم به چه سمتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 689.86,
   "end": 694.36,
   "text": "به سمت پیغمبر عزیز عالم که به یک معنا صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 694.36,
   "end": 697.76,
   "text": "یعنی به اون مقام رسید. حالا که داریم میریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 697.76,
   "end": 701.92,
   "text": "روح و نور برمی‌گردن به اونجا که الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 701.92,
   "end": 703.88,
   "text": "دقت کنید جمع‌بندی بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 703.88,
   "end": 706.14,
   "text": "الله، اینجا خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 706.14,
   "end": 709.14,
   "text": "الله نور السماوات والارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 709.14,
   "end": 715.34,
   "text": "ما داریم میریم به اون سمت. یک نوری از خدا در ما بود که با روح ما میره به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 715.34,
   "end": 719.14,
   "text": "نور مطلق او بود. ما نور مقیده ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 719.14,
   "end": 721.16,
   "text": "قیامت یعنی این. موت یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.16,
   "end": 728.84,
   "text": "ما برمی‌گردیم نوری که در وجود ما هست با اون نور مطلقی که از اول از خدا جدا شدیم با هم چی میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 728.84,
   "end": 731.22,
   "text": "قیاس میشن، سنجیده میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 731.22,
   "end": 733.82,
   "text": "نحن موازین القسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 733.82,
   "end": 736.35,
   "text": "اون قسط قسط میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 736.35,
   "end": 739.47,
   "text": "اون سهم ما قسطی که داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 739.47,
   "end": 742.63,
   "text": "از نور وجودی خدا که در اهل بیته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 742.63,
   "end": 747.93,
   "text": "اونجا سنجیده میشه. آقا شما چند تا قسط گرفتی از نور وجود پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 747.93,
   "end": 750.07,
   "text": "چند قسط از نور تو وجودته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 750.07,
   "end": 754.81,
   "text": "شما چند قسط ماهیانه هرچقدر روزانه آن به آن قسط گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 754.81,
   "end": 763.13,
   "text": "خیلی شدت نوری داری. در حقیقت روح و نور برمی‌گردن نور ما با نور اهل بیت سنجیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 763.13,
   "end": 766.81,
   "text": "اونم که میزانه. امام معصوم میزان انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 766.81,
   "end": 769.81,
   "text": "چه میزان قسط از نور ولایت گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 769.81,
   "end": 772.93,
   "text": "همون مقدار رتبت معلومه. حالا نورا چگونه‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 772.93,
   "end": 775.87,
   "text": "جهنم هم نور داره. شب خدا نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 775.87,
   "end": 778.89,
   "text": "چون الله نور السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 778.89,
   "end": 780.73,
   "text": "شب هم تو همین آسمان و زمین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 780.73,
   "end": 783.97,
   "text": "پس شب هم نوره. منتها نورش کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 783.97,
   "end": 786.23,
   "text": "ضعیفه. کمتر از روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 786.23,
   "end": 788.89,
   "text": "چی رو میخوام بگم؟ هرکی یه نوری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 788.89,
   "end": 791.81,
   "text": "نورها رنگ‌هایی دارن. گوش بده آقا جون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 791.81,
   "end": 793.95,
   "text": "رو نورها رنگ‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 793.95,
   "end": 800.99,
   "text": "آدمایی که تو سلسله کار عملیات عرفانی میفتن از این رنگ‌ها تشخیص میدن حال خودشون رو و دیگران رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 800.99,
   "end": 806.59,
   "text": "چیز عجیبی نیست. آدمی که چشم برزخی پیدا میکنه یعنی این نورها رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 806.59,
   "end": 810.57,
   "text": "میبینه نور شما چه شکلیه، میفهمه حالت زبان حالت چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 810.57,
   "end": 817.15,
   "text": "من اینا رو سریع براتون بگم. اولین حالت نور حالا بعضی‌ها گفتن نور سیاه که وقت نفس اماره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 817.15,
   "end": 820.37,
   "text": "کسی گرفتار غرق نفس اماره است نورش سیاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 820.37,
   "end": 826.17,
   "text": "بعضیا گفتن نه، ارذل یا کبود که آدم نفسانی زندگی میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 826.17,
   "end": 830.11,
   "text": "حیوانی زندگی میکنه. نگاش کنی نورش کبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 830.11,
   "end": 835.71,
   "text": "بعد یه مقدار روش کار کنه از نفس فاصله بگیره هنوز نفسو نکشته بود، نفس اماره رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 835.71,
   "end": 838.07,
   "text": "نه رنگ نورش چه رنگی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 838.07,
   "end": 840.83,
   "text": "نورش میشه به، به رنگ سرخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 840.83,
   "end": 843.43,
   "text": "یه مقدار رو خودش کار کنه میشه زرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 843.43,
   "end": 847.51,
   "text": "یه مقدار کار کنه نفس رو کلاً بکشه میشه سفید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 847.51,
   "end": 853.61,
   "text": "بعد که دیگه کلاً روح، نور روح ممزوج شد باهاش و اینا میشه نور سبز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 853.61,
   "end": 856.85,
   "text": "سادات، سبز سادات که میگن سادات به رنگ سبزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 856.85,
   "end": 861.07,
   "text": "حالا اینا رو ما تو بحث لا اله الا الله شب جمعه تو کانال بچه ها میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 861.07,
   "end": 863.87,
   "text": "اینا رو قبلاً توضیح دادیم شب جمعه گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 863.87,
   "end": 867.39,
   "text": "الان وقت نیست. بعد بازم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 867.39,
   "end": 869.75,
   "text": "به نظر شما بعد از سبز چه رنگیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 869.75,
   "end": 875.55,
   "text": "نور خورشیدی. نور خورشیدی که دیگه شدت نوره و شمس با حاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 875.55,
   "end": 878.41,
   "text": "اون شمس پیغمبره. بازم هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 878.41,
   "end": 881.87,
   "text": "کسی از این جلوتر بره بی‌رنگیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 881.87,
   "end": 888.83,
   "text": "که پیغمبر فرمود \"لی مع الله وقت لا یصعن فیه ملک مقرب ولا نبیا مرسل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 888.83,
   "end": 895.31,
   "text": "یه وقتایی من و خدا با همیم که اونجا نه نبی مرسلی‌ست، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 895.31,
   "end": 900.19,
   "text": "عرض شود ملک مقربی‌ست و لا نبی مرسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 900.19,
   "end": 903.05,
   "text": "آیا پیغمبر خودش نبی مرسل بوده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 903.05,
   "end": 906.39,
   "text": "چرا میگه نبی مرسل هم نیست؟ یعنی اصلاً دیگه خدایتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 906.39,
   "end": 909.69,
   "text": "هرچه هست حقه. اونجا بی‌رنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 909.69,
   "end": 913.59,
   "text": "لا-- فرمود \"لیس اندربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 913.59,
   "end": 915.81,
   "text": "صباح و مساء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 915.81,
   "end": 918.21,
   "text": "اونجا اصلاً دیگه شب و روز معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 918.21,
   "end": 921.51,
   "text": "اونجا هرچه هست حق اون دیگه مقام انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 921.51,
   "end": 925.13,
   "text": "ولی این جمله‌ی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 925.13,
   "end": 930.59,
   "text": "ما داریم به سمت انسان کامل که پیغمبره برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 930.59,
   "end": 933.45,
   "text": "موت یعنی برگشت به سمت اون شدت نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 933.45,
   "end": 938.63,
   "text": "اون انسان کامل. ش-- پس مق-معنای موت میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 938.63,
   "end": 942.87,
   "text": "یه جمله از زیارت جامعه بگید شما کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 942.87,
   "end": 945.85,
   "text": "کجاست؟ ایاب الخلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 945.85,
   "end": 948.23,
   "text": "الیکم. تو زیارت جامعه کبیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 948.23,
   "end": 950.11,
   "text": "برگشت خلق به سوی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 950.11,
   "end": 953.83,
   "text": "اصلاً موت یعنی برگشت ما به سمت پیغمبر عزیز عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 953.83,
   "end": 958.01,
   "text": "ان شاء الله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}