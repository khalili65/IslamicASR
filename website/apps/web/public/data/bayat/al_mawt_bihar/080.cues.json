  {
   "index": 10,
   "title": "## کرّهٔ مبارکه و خاسره",
   "start": 825.92,
   "end": 860.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 4.08,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 6.74,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.74,
   "end": 10.84,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.84,
   "end": 14.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.86,
   "end": 19.0,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.0,
   "end": 22.14,
   "text": "نکته‌ی دیگری که به فضل الهی امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.14,
   "end": 26.48,
   "text": "در رابطه باش صحبت کنیم و سنجاقش کنیم به ادامه‌ی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.48,
   "end": 31.12,
   "text": "روایت چهارم از باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.12,
   "end": 34.14,
   "text": "بحث الكرّه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.14,
   "end": 40.02,
   "text": "ه-- در هر دو نوع موتی که در این روایت وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.02,
   "end": 44.06,
   "text": "که و جاء بالموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.06,
   "end": 47.58,
   "text": "بما فيه که دیروز بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.58,
   "end": 49.74,
   "text": "حالا یا الكرّه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.74,
   "end": 52.5,
   "text": "المبارکه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.5,
   "end": 57.26,
   "text": "الخاسره است. این الكرّه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.26,
   "end": 60.74,
   "text": "به یک وجه مثلاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.74,
   "end": 69.22,
   "text": "روز رجعت هم که از عقاید حقه ماست و اگر کسی قبول نداشته باشه رجعت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.22,
   "end": 72.0,
   "text": "ایمانش کامل نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.0,
   "end": 78.3,
   "text": "روایت داریم. این البته باید بحث بشه ان‌شاءالله به وقتش که این رجعت چگونه امکان داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.3,
   "end": 81.78,
   "text": "آیا جسمیه یا غیر جسمیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.78,
   "end": 86.38,
   "text": "اگه جسمیه خب کسی که رفت مجرد شد چگونه می‌خواد دو مرتبه به ماده برگرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.38,
   "end": 90.02,
   "text": "اینا بحث‌هایی که باید به موقعش از جهت عقلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.02,
   "end": 96.0,
   "text": "اما از خود روز رجعت هم به يوم الكرّه یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.0,
   "end": 99.62,
   "text": "تکرار. میگن كرراً این موضوع رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.62,
   "end": 103.66,
   "text": "تکرار. یعنی دو مرتبه تکرار می‌شه، بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.66,
   "end": 106.24,
   "text": "خب؟ اینکه می‌فرماید اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.24,
   "end": 108.82,
   "text": "حقیقت موت رو چه برای انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.82,
   "end": 115.58,
   "text": "انسان خاصه، چه برای کسی که مومنه و الكرّة المبارکه براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.58,
   "end": 120.22,
   "text": "بیان شده، مبارک موتش هر دو الكرّه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.22,
   "end": 123.04,
   "text": "یعنی تکراره. یعنی برگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.04,
   "end": 126.54,
   "text": "یه وجهش می‌تونه این باشه که داره برگشت می‌کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.54,
   "end": 131.86,
   "text": "اصل وجودش. به جایی که انا لله دیگه و انا الیه دوباره راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.86,
   "end": 136.48,
   "text": "یه وجهش اینه. یه وجه عمیق‌ترش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.48,
   "end": 138.22,
   "text": "که اگر ذره‌بین طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.22,
   "end": 145.96,
   "text": "نفس داشته باشی با دقت ببینی متوجه می‌شی برگشته به خودته که دیروز انتهای بحث ما به اینجا کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.96,
   "end": 149.44,
   "text": "که اصلاً عرض کردیم وجه تفاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.44,
   "end": 154.3,
   "text": "موت و اموات به جهت تفاوت نفوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.3,
   "end": 159.28,
   "text": "نفس خودشو در آیینه‌ی قابض الارواح به چه شکلی می‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.28,
   "end": 163.66,
   "text": "خودش رو می‌بینه. نه قابض الارواح رو که خیلی هم نورانی و خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.66,
   "end": 166.88,
   "text": "این الكرّه به یک معنا یعنی برگشت به خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.88,
   "end": 174.24,
   "text": "انسان خودش رو هنگام موت می‌بینه که یکی از معانی بسیار دقیق پیرامون حقیقت موت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.24,
   "end": 181.96,
   "text": "در حقیقت قبلاً عرض کردیم انسان طوری می‌میرد که همان‌گونه زندگی کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.96,
   "end": 189.34,
   "text": "پس اگر وقت موت انسان خودش رو می‌بینه یا وحشت می‌کنه یا لذت می‌بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.34,
   "end": 194.26,
   "text": "می‌شود انسان همان‌طوری‌ست که زندگی کرده است خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.26,
   "end": 199.28,
   "text": "که دیروز هم گفتیم اصلاً اتحاد وجودی برقرار می‌کنه با علم و عملش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.28,
   "end": 201.66,
   "text": "هم-- چیزی جز خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.66,
   "end": 203.84,
   "text": "حالا این نفوس یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.84,
   "end": 208.76,
   "text": "نفوس خیرن، خیرن، اهل خیرن یا شرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.76,
   "end": 211.2,
   "text": "شرورن یا شریرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.2,
   "end": 215.88,
   "text": "یا بدتر از شرور، شریرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.88,
   "end": 220.62,
   "text": "شریر دیگه بدتر از اونه. مبالغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.62,
   "end": 223.46,
   "text": "اینا همش بر می‌گرده به خود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.46,
   "end": 227.3,
   "text": "از عالم بالا امساک و بخل معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.3,
   "end": 231.76,
   "text": "یک وجود صمدی‌ست. شما واوشو وردار می‌شه جود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.76,
   "end": 236.18,
   "text": "جود محضه. به همه داره خیرش، فیضش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.18,
   "end": 238.86,
   "text": "تنزل پیدا می‌کنه و سر همه می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.86,
   "end": 244.78,
   "text": "حکما، عرفا همه میگن همون فیضی که الان سر امام عصر داره می‌ریزه سر من و شما هم داره می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.78,
   "end": 249.38,
   "text": "اما ظرف آقا لا یتناحی به اون حد لا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.38,
   "end": 251.52,
   "text": "اصلاً نمی‌شه لا تو حد و لا تو سا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.52,
   "end": 257.54,
   "text": "ما کوچولو ذیق. و الا فیض اصلاً اون چکه بخله از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.54,
   "end": 259.4,
   "text": "ما درونمون آلوده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.4,
   "end": 262.24,
   "text": "لذا نمی‌فهمیم، نمی‌گیریم، نمی‌چشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.24,
   "end": 265.84,
   "text": "باران داره می‌باره هرکی به قدر صعه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.84,
   "end": 268.12,
   "text": "لذا اون nefsi که ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.12,
   "end": 273.68,
   "text": "خبیثه، امان، امان، امان از این که خیلی ما اینو از حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.68,
   "end": 276.24,
   "text": "علیه الرحمه شنیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.24,
   "end": 280.3,
   "text": "خیلی به-- كرار همین الان شما درس و بحثای ایشون صوتاش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.3,
   "end": 283.1,
   "text": "آثارش رو نگاه کنید بسیار. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.1,
   "end": 289.62,
   "text": "فرمایش امیرالمؤمنین علیه الصلاة والسلام در خطبه‌هاشون که زیاد می‌خوندن رو ایشون خیلی تکرار می‌کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.62,
   "end": 291.32,
   "text": "نعوذ بالله من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.32,
   "end": 295.5,
   "text": "شرور نه شر. من شرور انفسنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.5,
   "end": 298.14,
   "text": "و من سیئات اعمالنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.14,
   "end": 303.04,
   "text": "و ایشون می‌فرمود وای از نفس خبیث اگر بیفته تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.04,
   "end": 307.06,
   "text": "دین. نفس خبیث اگر لباس دین بپوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.06,
   "end": 311.6,
   "text": "شما گمان کنید یه آدمی که نفسش خبیثه بیاد لباس پیغمبر به تن بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.6,
   "end": 313.92,
   "text": "بره تو وجهه‌ی انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.92,
   "end": 316.04,
   "text": "مثلاً چهره‌ی انقلابی. اوه، اوه، اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.04,
   "end": 319.84,
   "text": "دیگه اصلاً نمی‌شه جمعش کرد. چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.84,
   "end": 326.12,
   "text": "ری-- تیشه به ریشه‌ی انقلاب و دین و شرع و این‌ها می‌زنه چون نفسش خبیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.12,
   "end": 328.96,
   "text": "بعدم دادش رو سر دیگران می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.96,
   "end": 335.04,
   "text": "اصلاً علامه می‌گه اگر کسی به خدا تعرض-- اعتراض می‌کنه که آقا چرا خودت چرا نمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.04,
   "end": 337.98,
   "text": "چرا خودت رو به من نشون نمیدی؟ چرا من هرچی ازت می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.98,
   "end": 342.66,
   "text": "حالا چرا، چرا، چرا اعتراض داره این با خودش درگیره، با خودش دعوا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.66,
   "end": 346.12,
   "text": "خدا که بخل نداره، خدا امساک نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.12,
   "end": 348.94,
   "text": "خودت ظرفت کوچیکه. خودت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.94,
   "end": 352.08,
   "text": "آب مثل، مثل آب کدر شده وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.08,
   "end": 355.64,
   "text": "فضای وجودش مغبره، غبار آلوده هیچ‌چیو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.64,
   "end": 358.42,
   "text": "آب کدر شده می‌گه چرا منو نشون نمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.42,
   "end": 363.34,
   "text": "آقا آب کدره. آب باید صاف باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.34,
   "end": 370.08,
   "text": "البته انسان نفس تکویناً نفس انسان تکوین نظام هستی و تکوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.08,
   "end": 375.04,
   "text": "نفس به گونه‌ای است که اگر یه مقدار بهش سختی بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.04,
   "end": 379.26,
   "text": "یه روح‌هایی می‌ده. یعنی یه چیزهایی متوجه می‌شه می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.26,
   "end": 384.82,
   "text": "خب اما این اصیل نیست، اصل نیست، رسی نیست، رکین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.82,
   "end": 389.48,
   "text": "مثل مثلاً جسارتاً عرفا گفتن اگر یه مرتاضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.48,
   "end": 395.02,
   "text": "به غیر ریاضات شرعيه بره به چیزهایی هم برسه، به قدرت‌هایی هم برسه، یه چیزهایی هم ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.02,
   "end": 400.0,
   "text": "درسته آب بهش دادن و این آب رو اصطلاحاً مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.0,
   "end": 403.38,
   "text": "از جهت تمثیل برای سهولت فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.38,
   "end": 406.0,
   "text": "در دسترسش قرار دادن در دسترسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.0,
   "end": 408.86,
   "text": "اما این بول صافه، بوله نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.86,
   "end": 411.1,
   "text": "بول می‌تونه صاف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.1,
   "end": 413.62,
   "text": "می‌تونه مثلاً رنگی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.62,
   "end": 416.74,
   "text": "بول صافه عین-- عینیتش نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.74,
   "end": 422.26,
   "text": "چون از راه طریق شرعی نرفته جلو و این دلیل نیست، هنر نیست که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.26,
   "end": 426.14,
   "text": "چهار سباحی یه مقدار شب‌بیداری کشید، روزه گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.14,
   "end": 428.96,
   "text": "بعد مثلاً چشمش باز شد بگه تمام این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.96,
   "end": 431.54,
   "text": "خیلی راه، راه خطرناکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.54,
   "end": 436.6,
   "text": "بدون استاد انسان در این مسیر قدم بزنه قطعاً کله پا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.6,
   "end": 439.4,
   "text": "یه ملتی رو هم کله پا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.4,
   "end": 443.2,
   "text": "اینه که نفس خبیث خیلی باید مراقب بود خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.2,
   "end": 447.4,
   "text": "خدا رحمت کنه مرحوم ملا محسن فیض رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.4,
   "end": 450.16,
   "text": "که ایشون در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.16,
   "end": 452.5,
   "text": "حق الیقین‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.5,
   "end": 456.0,
   "text": "می‌فرمود که اصلاً این که انسان می‌میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.0,
   "end": 459.3,
   "text": "منقطع می‌شه از هر چیزی غیر خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.3,
   "end": 465.62,
   "text": "اصلاً وقت مرگ انقطاع پیدا می‌کنه می‌بینه آقا این چیزهایی که فکر می‌کرد مال منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.62,
   "end": 469.76,
   "text": "همسر منه، فرزند منه، ماشین منه، خونه منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.76,
   "end": 472.4,
   "text": "این اضافات اعتبارات که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.4,
   "end": 473.94,
   "text": "نشونه‌شم اینه که اعتباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.94,
   "end": 478.94,
   "text": "الان مال شماست. یه ساعت بعد این ماشینو بفروش زیر پای یکی دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.94,
   "end": 481.04,
   "text": "تا الان تو تو یه خونه بودی. بفروش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.04,
   "end": 484.34,
   "text": "فردا یه خونواده دیگه میان همین جا ساکن می‌شن، می‌گن خونه‌ی من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.34,
   "end": 491.78,
   "text": "اعتباره. وقت مرگ این انقطاع که حاصل می‌شه \"فَبَصَرُواْ كَأَنَّ يَوْمَ هَدِيدٍ\" که قرآن میگه چشم تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.78,
   "end": 494.38,
   "text": "می‌بینه هیچی مال خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.38,
   "end": 497.7,
   "text": "هرچی که براش مونده خودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.7,
   "end": 499.58,
   "text": "خودش. منقطع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.58,
   "end": 503.72,
   "text": "اتفاقاً تو کتاب النفس مرحوم ملا صدرا هم تو اسفارش همین رو می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.72,
   "end": 506.02,
   "text": "هرچی که می‌مونه خودشه. از اضافات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.02,
   "end": 508.66,
   "text": "کنده می‌شه، از انانیت کنده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.66,
   "end": 510.76,
   "text": "حالا اون خودش چیه براش مونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.76,
   "end": 514.6,
   "text": "حقیقت وجودی خودشه. \"اقْرَأْ كِتَابَكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.6,
   "end": 517.4,
   "text": "كَفَى بِنَفْسِكَ الْيَوْمَ عَلَيْكَ حَسِيبًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.4,
   "end": 522.62,
   "text": "امان اگه از اینکه این نفس یه وقت شرور، شریر باشه، شرور باشه، شر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.62,
   "end": 526.14,
   "text": "خیلی خطرناکه. بعد اونچه که می‌بینه پریشان احوالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.14,
   "end": 529.64,
   "text": "جهنم اصلاً یعنی همین. قرونتون برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.64,
   "end": 533.1,
   "text": "حالا ما متأسفانه در درون خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.1,
   "end": 534.98,
   "text": "جسارت به شما نشه خودم رو می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.98,
   "end": 538.26,
   "text": "یه رنگ‌هایی تو تار و پودمون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.26,
   "end": 545.04,
   "text": "از اینا ما بی‌خبریم. وقتی فیض تنزل پیدا می‌کنه، لطف الهی شامل می‌شه، علم، معرفت، بصیرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.04,
   "end": 547.74,
   "text": "موقعیت، جایگاه. همه این نعمت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.74,
   "end": 553.16,
   "text": "میان. اینا رو می‌بینه تو اون تار و پود و رنگ‌های وجودی من آلودگی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.16,
   "end": 557.62,
   "text": "اینا هم رنگ می‌گیرن. بعد می‌بینه که تظاهر می‌شه، ریا می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.62,
   "end": 561.88,
   "text": "شرک می‌شه، غرور می‌شه. دار الغروره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.88,
   "end": 565.92,
   "text": "لذا هیچ چیزی ب- بالاتر از خودسازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.92,
   "end": 567.92,
   "text": "یعنی کندن از تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.92,
   "end": 571.9,
   "text": "اصلاً موت عزیز دلم \"يَوْمَ تُبْلَى السَّرَائِرُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.9,
   "end": 574.44,
   "text": "یعنی این. ما کجاییم الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.44,
   "end": 576.8,
   "text": "رو تو اون روایت دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.8,
   "end": 580.74,
   "text": "امیدوارم جمعش کنیم بحثو چون روایت خیلی کثیر الفروعه خیلی طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.74,
   "end": 582.56,
   "text": "بریم جلسه بعد روایت بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.56,
   "end": 585.62,
   "text": "الکرّه برگشت به خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.62,
   "end": 588.38,
   "text": "چه کار کردی این چهل سال، پنجاه سال، بیست سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.38,
   "end": 591.1,
   "text": "هفتاد سال با خودت چه کردی حالا بفرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.1,
   "end": 595.36,
   "text": "سر سفره خودتی. الان چی داری برای خودت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.36,
   "end": 599.94,
   "text": "اضافات که کنده شد. ما همون حقیقت وجودی خودتو بفرمایید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.94,
   "end": 603.34,
   "text": "اصلاً موت یعنی این. خودت برای خودت آشکار می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.34,
   "end": 606.4,
   "text": "چه معنای قشنگی. اصلاً با کسی ما دعوا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.4,
   "end": 610.22,
   "text": "بهشت و جهنم چیه؟ خدا نیومده یه چاله درست کنه توشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.22,
   "end": 611.86,
   "text": "هیزم بریزه ما رو بکنه اون تو که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.86,
   "end": 614.96,
   "text": "مگه خدا خدای مثلاً استغفرالله فلانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.96,
   "end": 618.32,
   "text": "نه بسیار مهربانه. دائماً در صلح و آشتی با بندگانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.32,
   "end": 621.2,
   "text": "خودت کردی. خود کرده رو تدبیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 621.2,
   "end": 623.0,
   "text": "بعد چه عزتی به ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.0,
   "end": 627.54,
   "text": "خودش یه منبر می‌طلبه که بلحقیقه موت ما هم دست خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 627.54,
   "end": 630.5,
   "text": "الان داریم می‌فهمیم که ما خودمون داریم تصمیم می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.5,
   "end": 635.02,
   "text": "انتخاب می‌کنیم چگونه بمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.02,
   "end": 639.08,
   "text": "این خیلی مهمه ما چه-- آیا کندیم از تعلقاتمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 639.08,
   "end": 641.14,
   "text": "اصلاً دعواها تو عالم سر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 641.14,
   "end": 648.56,
   "text": "تعلقاته. و الا تو شما به یه مدیر بری تذکر بدی اگه تعلق نداشته باشه از پشت میزش پا می‌شه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.56,
   "end": 651.28,
   "text": "دست تو رو هم می‌بوسه میگه ممنونم از شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.28,
   "end": 653.14,
   "text": "که منو متوجه اشتباهم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 653.14,
   "end": 657.92,
   "text": "تعلق باعث می‌شه سه گرماشو توهم کنه، به هم بریزه، عصبانی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 657.92,
   "end": 660.72,
   "text": "نمی‌دونم حقوق طرفو کم کنه، اخراجش کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 660.72,
   "end": 663.7,
   "text": "اعلام نیازشو فلان کنه. اینا تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.7,
   "end": 666.26,
   "text": "مگر یه بحث‌های حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.26,
   "end": 670.62,
   "text": "بحث‌هایی که حالا حکمت اقتضا می‌کنه تو سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 670.62,
   "end": 674.3,
   "text": "اداری و این‌ها یه کسی خلافی رو مرتکب شه بله باید باهاش برخورد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 674.3,
   "end": 677.86,
   "text": "اما غرض شخصی نه. خدا رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 677.86,
   "end": 683.0,
   "text": "اینو خوب دقت کنید. حکایتیه که علامه فرمود من جایی ندیدم، بنده هم ندیدم هیچ جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.0,
   "end": 686.32,
   "text": "خود علامه به نقل از اساتیدشون فرمودن اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 686.32,
   "end": 690.0,
   "text": "که حالا می‌دونید در خصوص سید رضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 690.0,
   "end": 691.94,
   "text": "سید مرتضی که دیروز بحث شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 691.94,
   "end": 695.06,
   "text": "این دو تا بزرگوار دیگه علم اسلام بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 695.06,
   "end": 701.02,
   "text": "سید مرتضی که علم الهدى لقب گرفت از امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 701.02,
   "end": 703.14,
   "text": "معروفه به ابو الثمانین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 703.14,
   "end": 707.72,
   "text": "هشتاد هزار جلد کتاب نسخ خطی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 707.72,
   "end": 710.8,
   "text": "تو کتابخونه تو خونه‌ش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 710.8,
   "end": 713.06,
   "text": "الان شما کی انقدر کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 713.06,
   "end": 717.26,
   "text": "اونم کتابای امروزو نبینید این کتابای بازاری و این همه کثرت تألیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 717.26,
   "end": 719.44,
   "text": "نه، کتابای خطی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 719.44,
   "end": 724.02,
   "text": "پربهای، مرجع. مثلاً خدا رحمت کنه عارف بستامی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.02,
   "end": 728.28,
   "text": "پیرمرد بود این عارف بالله نوشته بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.28,
   "end": 732.56,
   "text": "الحمد لله رب العالمین الان در کتابخانه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.56,
   "end": 737.5,
   "text": "اینکه حامل و حافل دویست جلد کتاب خطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 737.5,
   "end": 739.68,
   "text": "دویست جلد رو افتخار می‌کنه حمد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 739.68,
   "end": 742.4,
   "text": "اون موقع کتاب خطی مرجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 742.4,
   "end": 745.86,
   "text": "مثل الان نبوده کتابا بازاریه میری نمایشگاه دست خالی برمی‌گردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 745.86,
   "end": 748.5,
   "text": "هیچی نیست بخونم. همه همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 748.5,
   "end": 751.82,
   "text": "کپی پیست کردن. کار تحقیقی و پژوهش کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 751.82,
   "end": 754.68,
   "text": "کاری ندارم هفت هشتاد هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 754.68,
   "end": 757.78,
   "text": "خیلی از جهت علمی قوی دیگه سید مرتضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 757.78,
   "end": 761.62,
   "text": "یه مرتضی اومد پیش-- درویشی بگیم بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.62,
   "end": 763.84,
   "text": "درویشی اومد آدم خوبی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.84,
   "end": 767.36,
   "text": "پیش سید مرتضی باهاش گفت‌وگوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 767.36,
   "end": 769.06,
   "text": "معنوی و عرفانی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 769.06,
   "end": 771.34,
   "text": "سید مرتضی گفت حرف‌هات درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 771.34,
   "end": 775.64,
   "text": "آدم باید از نفسش بکنه، از اضافات و تعلقات و اعتباراتش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 775.64,
   "end": 777.54,
   "text": "ما هم تو راه شما، ما مرید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 777.54,
   "end": 780.16,
   "text": "سید مرتضی به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 780.16,
   "end": 786.94,
   "text": "آدم ریاض-- ریاضت کشید درویش گفت آقا ما مرید شما، شما هرچی بگی ما پشت سر شما، ما به شما اقتدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 786.94,
   "end": 789.46,
   "text": "ما به شما، به شما لبیک میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 789.46,
   "end": 792.44,
   "text": "بفرمایید ما چی کار کنیم؟ گفت خب پاشو بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 792.44,
   "end": 795.54,
   "text": "این درویش سید مرتضی رو با هم پا شدن رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 795.54,
   "end": 801.58,
   "text": "تو راه یه مقدار رفتن جلو درویشه گفت آقا سید ببخشید من کشکولم رو تو خونه شما جا گذاشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 801.58,
   "end": 803.28,
   "text": "سید مرتضی گفت آها نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 803.28,
   "end": 807.6,
   "text": "نشد. ببین من از همه این داشته‌هام همه کندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 807.6,
   "end": 810.98,
   "text": "این همه خدا به من هرچی داده همه رو کندم پشت سر تو راه افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 810.98,
   "end": 813.0,
   "text": "تو که از کشکولت نمی‌گذری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 813.0,
   "end": 816.2,
   "text": "نشد. ببین تو حرف زدن آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 816.2,
   "end": 817.92,
   "text": "مثل الان من حرف می‌زنم خیلی راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 817.92,
   "end": 820.02,
   "text": "تازه اینم البته سخته گفتنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 820.02,
   "end": 823.68,
   "text": "اما باز راحت‌تره. اما اینکه در عمل پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 823.68,
   "end": 825.92,
   "text": "خلاصه، خلاصه، خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 825.92,
   "end": 830.48,
   "text": "در موت عزیز دلم الكرّه یعنی برمی‌گردی به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 830.48,
   "end": 834.92,
   "text": "اگه وجودت مبارکه، پر از خیر و برکته برای این و اون موت خوبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 834.92,
   "end": 837.44,
   "text": "اما اگر خدای نکرده همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 837.44,
   "end": 845.46,
   "text": "خباثت و شرارت و نزاع و درگیری و دعوا همه ازت شاکی‌اند، فرجی برای کسی ایجاد نکردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 845.46,
   "end": 848.7,
   "text": "بعد ببخشید این برگشت الخاسره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 848.7,
   "end": 850.46,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 850.46,
   "end": 853.58,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 853.58,
   "end": 860.26,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}