 "chapters": [
  {
   "index": 0,
   "title": "## روایت چهارم؛ تکرار الموت الموت",
   "start": 16.58,
   "end": 120.48
  },
  {
   "index": 1,
   "title": "## موت آن‌به‌آن؛ موت حیوانی و انسانی",
   "start": 120.48,
   "end": 415.79
  },
  {
   "index": 2,
   "title": "## موت آنی و تدریجی؛ مفاجات",
   "start": 415.79,
   "end": 497.21
  },
  {
   "index": 3,
   "title": "آیهٔ بیست و هشت بقره:",
   "start": 497.21,
   "end": 574.57
  },
  {
   "index": 4,
   "title": "## موت در ایمان و کفر؛ سخن عیسی",
   "start": 574.57,
   "end": 788.89
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 5.34,
   "text": "صلی الله محمد و آل محمد و تعجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.34,
   "end": 9.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.28,
   "end": 13.04,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 16.58,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 20.82,
   "text": "در روایت چهارم از باب چهارم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.82,
   "end": 26.84,
   "text": "عرض کردیم که بسیار کثیر الفروع هست این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.84,
   "end": 30.86,
   "text": "و اینکه دو بار کلمه موت در ابتداش تکرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.86,
   "end": 36.38,
   "text": "الموت، الموت قطعا فلسفه‌ای دارد که گذشته از بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.38,
   "end": 39.4,
   "text": "هشدار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.4,
   "end": 45.22,
   "text": "آماده باش بودن این قصه که پیغمبر فرمودند و اهمیتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.22,
   "end": 48.54,
   "text": "تکرارش نشانه اهمیتشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.54,
   "end": 51.44,
   "text": "موقعیتشه، جایگاهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.44,
   "end": 56.06,
   "text": "می‌تونه موت، این دو تا موت که تکرار شده یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.06,
   "end": 59.74,
   "text": "همون موت اصلیش باشه، یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.74,
   "end": 65.4,
   "text": "علی البدل یا فرعش که شبیه به اونه یعنی خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.4,
   "end": 67.6,
   "text": "در مثلا روایتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.6,
   "end": 71.7,
   "text": "از اه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.7,
   "end": 75.36,
   "text": "باقر صلوات الله عليه سؤال شد که این در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.36,
   "end": 81.14,
   "text": "بهار اومده در مرحوم مجلسی آورده \"قیل لمحمد بن علی علیهم السلام ما الموت؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.14,
   "end": 84.82,
   "text": "سؤال شد که موت چیه از امام باقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.82,
   "end": 91.46,
   "text": "قال حضرت فرمودند که \"هو النوم الذي یأتیکم کل لیلة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.46,
   "end": 96.24,
   "text": "این موت همون خوابیه که هر شب شما درکش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.24,
   "end": 99.84,
   "text": "\"الا انه طویل مدته.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.84,
   "end": 102.74,
   "text": "مگر اینکه این موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.74,
   "end": 106.32,
   "text": "مدتش طولانی‌تر از اون خوابیه که می‌خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.32,
   "end": 109.62,
   "text": "خوابتون یه چند ساعته اما این موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.62,
   "end": 113.18,
   "text": "خیلی طولانی‌تره. \"لا ینتبه منه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.18,
   "end": 120.24,
   "text": "بیدار نمی‌شید ازش، از این خوابی که اصطلاحاً بهش می‌گیم موت بیدار نمی‌شید \"الا يوم القيامة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.24,
   "end": 125.56,
   "text": "پس همون خوابه اما طولانی‌تره و قیامت ازش پا می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.56,
   "end": 128.46,
   "text": "\"فمن رأى في نومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.46,
   "end": 130.76,
   "text": "من اصناف الفرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.76,
   "end": 136.88,
   "text": "ما لا یغادره، یغادر قدره.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.88,
   "end": 139.24,
   "text": "می‌فرماید همونطور که تو خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.24,
   "end": 143.08,
   "text": "می‌بینید صنوف مختلف خواب‌های مختلف می‌بینن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.08,
   "end": 146.18,
   "text": "بعضی خواب‌ها فرح‌انگیزه، نشاط آوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.18,
   "end": 149.84,
   "text": "\"ومن اصناف الاحوال.\" بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.84,
   "end": 153.74,
   "text": "صنوف خواب‌هاشون می‌بینی هول داره، ترس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.74,
   "end": 157.64,
   "text": "\"ما لا یغادر قدره.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.64,
   "end": 163.06,
   "text": "یه هول‌ها و خطراتی در خواب داره خیلی وحشتناک، اصلاً توصیف نشدنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.06,
   "end": 165.78,
   "text": "\"فكيف حال فرح في النوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.78,
   "end": 169.38,
   "text": "و وجل فيه.\" چگونه است این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.38,
   "end": 171.4,
   "text": "شادی و ترس در خواب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.4,
   "end": 175.1,
   "text": "\"هذا هو الموت.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.1,
   "end": 177.64,
   "text": "این همون موته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.64,
   "end": 180.72,
   "text": "که حالا اون سختی‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.72,
   "end": 184.22,
   "text": "به انسان می‌رسه شبیه به خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.22,
   "end": 185.96,
   "text": "منتها عمیق‌تره، طولانی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.96,
   "end": 190.5,
   "text": "\"فاستعدوا له.\" پس براش خودتون رو آماده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.5,
   "end": 196.04,
   "text": "مهم این استعداد و آماده کردن بر اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.04,
   "end": 198.82,
   "text": "که اون معنای شفیع، نه یعنی پارتی‌بازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.82,
   "end": 202.86,
   "text": "یعنی همین استعداد رو انسان شکوفا کنه و با خودش ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.86,
   "end": 206.14,
   "text": "استعداد مضمحل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.14,
   "end": 213.8,
   "text": "این یه معنا. یه معنای دیگه از اینکه دو تا موت تکرار شده می‌تونه یه دونه موت در دنیا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.8,
   "end": 215.92,
   "text": "و می‌تونه یه دونه موت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.92,
   "end": 219.98,
   "text": "برزخ باشه. قبلاً هم بر اساس آیه یازده قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.98,
   "end": 224.86,
   "text": "گفتیم \"قالوا ربنا\" اینا میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.86,
   "end": 227.76,
   "text": "پروردگار ما \"امتش اثنتین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.76,
   "end": 234.0,
   "text": "دو بار ما رو از دنیا بردی به موت رسوندی و \"احیانا اثنتین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.0,
   "end": 238.46,
   "text": "دوبار هم زنده کردی. \"فاعترفنا بذنوبنا هل الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.46,
   "end": 242.02,
   "text": "خروج من سبيل.\" آیا یه راهی هست ما از عذاب نجات پیدا کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.02,
   "end": 246.7,
   "text": "اینم نشون میده که یه، یه موت در دنیا داریم، یه موت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.7,
   "end": 249.34,
   "text": "برزخ. هر دو تاش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.34,
   "end": 251.06,
   "text": "می‌تونه این باشه که دو بار اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.06,
   "end": 252.96,
   "text": "می‌تونه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.96,
   "end": 256.8,
   "text": "اختیاری و غیر اختیاری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.8,
   "end": 259.62,
   "text": "اختیاری \"موتوا قبلاً تموتوا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.62,
   "end": 262.8,
   "text": "یعنی شما می‌تونی همین الان سفر به باطن عالم بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.8,
   "end": 266.56,
   "text": "می‌تونی اسماء الهی درت پیاده بشه، به لقاء رب خودت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.56,
   "end": 270.7,
   "text": "اینا معنای موته. همینجا چشمت به باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.7,
   "end": 276.86,
   "text": "باز بشه. و موت غیر اختیاری که همون اجباریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.86,
   "end": 282.08,
   "text": "بالاخره اگر اینجا \"موتوا قبلاً تموتوا\" هم رخ نده بالاخره به اجبار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.08,
   "end": 285.56,
   "text": "می‌برنت. می‌تونه موت خوب و بد باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.56,
   "end": 290.62,
   "text": "به هر نحوش که تو خود روایت هم وارد شده همین روایت چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.62,
   "end": 297.76,
   "text": "که یا \"الکرة المباركة\" است یا \"الکرة الخاسرة\" است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.76,
   "end": 304.14,
   "text": "یا موت مبارک خوبه، رو-- روح و ریحانه یا به سمت عذاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.14,
   "end": 306.4,
   "text": "حسرانه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.4,
   "end": 310.9,
   "text": "دو نوع موت لذا ما داریم به صورت کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.9,
   "end": 314.08,
   "text": "می‌تونه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.08,
   "end": 317.04,
   "text": "آنفعانی باشه که اون تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.04,
   "end": 319.52,
   "text": "لا تک- لا تكرار فت تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.52,
   "end": 322.66,
   "text": "که بارها عرض کردیم که آنفعان خدا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.66,
   "end": 326.96,
   "text": "اسم الممیت و المحی خودش رو پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.96,
   "end": 329.88,
   "text": "آنفعان ما داریم می‌میریم، زنده می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.88,
   "end": 335.76,
   "text": "\"كل يوم هو في شأن.\" این ظرف ظهور ما که حق درش ظهور کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.76,
   "end": 338.58,
   "text": "این آنفعان داره می‌میره، زنده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.58,
   "end": 341.48,
   "text": "سلول‌های بدن آنفعان شکلشون عوض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.48,
   "end": 343.96,
   "text": "ما آنفعان انسان جدیدی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.96,
   "end": 348.52,
   "text": "پس در هر آنی ما یه موت داریم، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.52,
   "end": 350.22,
   "text": "حیات، یه موت، یه حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.22,
   "end": 354.16,
   "text": "همینطوری. می‌تونه موت بعد از موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.16,
   "end": 358.26,
   "text": "منظور پیغمبر باشه که توجه داشته باشید به این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.26,
   "end": 361.86,
   "text": "می‌تونه موت حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.86,
   "end": 364.38,
   "text": "و موت انسانی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.38,
   "end": 368.61,
   "text": "که باز نمی‌بینید مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.61,
   "end": 373.89,
   "text": "در قرآن آیه دو ملک \"الذي خلق الموت والحياة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.89,
   "end": 378.43,
   "text": "ليبلوكم أيهم أحسن عملا وهو العزيز الغفور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.43,
   "end": 381.21,
   "text": "اصلا موت و حیات دو تا هم خلق الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.21,
   "end": 385.53,
   "text": "هم موت خلق یعنی عدم نیست، وجود داره هم حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.53,
   "end": 388.85,
   "text": "و این‌ها برای اینه که شما به انسانیت برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.85,
   "end": 391.63,
   "text": "\"أحسن عملا\" به بهترین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.63,
   "end": 395.97,
   "text": "ممکن عمل کنید. پس انسان می‌تونه موتش انسانی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.97,
   "end": 399.75,
   "text": "\"أحسن عملا\" داشته باشه. می‌تونه حیوانی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.75,
   "end": 402.45,
   "text": "و بلکه \"بل هم أضل سبيلا\" باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.45,
   "end": 406.41,
   "text": "\"أولئك كالأنعام\" مثل حیوانات که بحث‌هاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.41,
   "end": 409.43,
   "text": "اینم دو نوع موته. می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.43,
   "end": 412.55,
   "text": "موت، ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.55,
   "end": 415.79,
   "text": "آنی و موت تدریجی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.79,
   "end": 418.59,
   "text": "موت ناگهانی و موت تدریجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.59,
   "end": 423.07,
   "text": "اینم مثلا کسی که به تدریج می‌میره بهش میگن مائت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.07,
   "end": 426.27,
   "text": "کسی که یک آن می‌میره بهش میگن میت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 426.27,
   "end": 428.91,
   "text": "موت تدریجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.91,
   "end": 433.41,
   "text": "مثل این که کسی طول عمر پیدا می‌کنه از چهل سالگی به بعد دیگه سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.41,
   "end": 436.75,
   "text": "اعضای بدنش قوای وجودی شروع می‌شه ضعف در بدن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.75,
   "end": 439.95,
   "text": "این موت تدریجیه. موت آنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.95,
   "end": 443.85,
   "text": "ناگهانی، مرگ مفاجات در روایت ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.85,
   "end": 445.97,
   "text": "استفاده شده، بیان شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.97,
   "end": 449.65,
   "text": "عنوان شده. خیلی هم بده، سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.65,
   "end": 451.63,
   "text": "یک آن اصلا طرف آماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 451.63,
   "end": 454.03,
   "text": "میاد یقه می‌کنه آدمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 454.03,
   "end": 456.53,
   "text": "که میگن پناه ببرید به خدا از موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 456.53,
   "end": 459.39,
   "text": "از شر موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 459.39,
   "end": 462.17,
   "text": "مفاجات، مرگ مفاجات ناگهانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.17,
   "end": 466.11,
   "text": "جمعاً مرگ شدن. اینا اصلا آمادگی و تهیئ نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.11,
   "end": 469.79,
   "text": "خیلی خطرناکه انسان بدون آمادگی از دنیا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.79,
   "end": 476.05,
   "text": "لذا فرمودن از یکی از عرفا شنیدم که فرمودن روایتی براش ندیدم ها از یکی از عرفا خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 476.05,
   "end": 480.13,
   "text": "شنیدم که فرمود بعد از شهادت بهترین موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 480.13,
   "end": 481.95,
   "text": "موت در بستر بیماریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.95,
   "end": 486.31,
   "text": "چون رفته، رفته، رفته، کاهیده میشی، رنجیده میشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 486.31,
   "end": 489.15,
   "text": "آب میشی، همچین سفرت خورد خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.15,
   "end": 491.55,
   "text": "یه دفعه نمی‌برنت. آمادگی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 491.55,
   "end": 496.09,
   "text": "پس می‌تونه موت ناگهانی یا تدریجی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 496.09,
   "end": 498.77,
   "text": "می‌تونه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 498.77,
   "end": 502.95,
   "text": "قبل از دنیا و بعد از دنیا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 502.95,
   "end": 506.75,
   "text": "قبل از دنیا و بعد از دنیا کجا اومده تو آیات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 506.75,
   "end": 511.05,
   "text": "یعنی چی؟ مثلا در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 511.05,
   "end": 515.29,
   "text": "بیست و هشت بقره \"كيف تكفرون بالله وكنتم أمواتا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 515.29,
   "end": 519.09,
   "text": "چگونه کفر می‌ورزید به خدا در حالی که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 519.09,
   "end": 522.55,
   "text": "میته بودید، میت بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 522.55,
   "end": 525.69,
   "text": "میت بودید. ها؟ این یه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.69,
   "end": 527.65,
   "text": "که برمی‌گرده به قبل از خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 527.65,
   "end": 529.65,
   "text": "\"فأحیاكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 529.65,
   "end": 531.47,
   "text": "زنده شدید. الان اومدی تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.47,
   "end": 534.11,
   "text": "\"ثم يميتكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.11,
   "end": 537.45,
   "text": "دوباره تو همین دنیا انتهای دنیاتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 537.45,
   "end": 539.71,
   "text": "می‌میرید. می‌شه دو تا موت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.71,
   "end": 541.97,
   "text": "\"ثم يحييكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.97,
   "end": 543.65,
   "text": "دوباره احیا می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 543.65,
   "end": 547.67,
   "text": "این حالا \"ثم إليه ترجعون\" که رنجش در اون ارجاعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 547.67,
   "end": 551.51,
   "text": "رجوع به حضرت حقه. برگشتن الکرّه دوباره برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 551.51,
   "end": 557.93,
   "text": "که این دو تا موت ما گفتیم اون موت، اون یه نمونه‌ش می‌تونه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 557.93,
   "end": 560.33,
   "text": "انتهای دنیا باشه و انتهای برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 560.33,
   "end": 567.33,
   "text": "حالا این موتی که داریم الان درباره‌ش حرف می‌زنیم می‌تونه موت قبل از دنیامون و انتهای دنیامون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 567.33,
   "end": 571.67,
   "text": "چطور شما در نماز در سجده میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 571.67,
   "end": 574.57,
   "text": "پا میشی چرا دو تا سجده اصلا انجام میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 574.57,
   "end": 577.25,
   "text": "معنای دو بار موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 577.25,
   "end": 579.45,
   "text": "در سجده اول موت اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 579.45,
   "end": 582.51,
   "text": "یعنی ما رو از كتم عدم خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 582.51,
   "end": 586.65,
   "text": "موت اول \"و كنتم أمواتا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 586.65,
   "end": 592.65,
   "text": "لذا اونجا تسبیح میگی. \"يسبح لله ما في السماوات وما في الأرض من شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 592.65,
   "end": 597.29,
   "text": "إلا يسبح بحمده\". حتی میتم تسبیح گوه به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 597.29,
   "end": 600.93,
   "text": "داره اسم المومیت حضرت حق رو می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 600.93,
   "end": 604.09,
   "text": "وقتی از سجده اول بلند شدی حالا وقت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 604.09,
   "end": 606.23,
   "text": "\"فأحياكم\" اینجای آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 606.23,
   "end": 608.41,
   "text": "زنده شدی. دنیای شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 608.41,
   "end": 610.69,
   "text": "در دنیا بهترین ذکر استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 610.69,
   "end": 614.95,
   "text": "لذا گفتن بین دو سجده، بین سجده‌هات استغفار کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.95,
   "end": 618.71,
   "text": "چون لحظه دنیاتو داری درک می‌کنی به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 618.71,
   "end": 621.23,
   "text": "نمازم که معنای جمعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 621.23,
   "end": 624.61,
   "text": "همه دنیات به یک باره بین دو سجده‌ت جمع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 624.61,
   "end": 628.13,
   "text": "استغفار می‌کنی. دو مرتبه برمی‌گردی به خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 628.13,
   "end": 631.05,
   "text": "سجده دوم. آیه رو ببین \"ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 631.05,
   "end": 634.23,
   "text": "يميتكم\". این موت دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 634.23,
   "end": 636.49,
   "text": "یعنی اون موتیه که ما منتظرشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 636.49,
   "end": 641.45,
   "text": "انتهای دنیاست. که بریم اونجا دوباره تسبیح میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 641.45,
   "end": 643.43,
   "text": "بعد که چه-- که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 643.43,
   "end": 647.61,
   "text": "وقتی از سجده دوم سر بلند کردی \"ثم يحييكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 647.61,
   "end": 652.79,
   "text": "قیامتت رخ میده. وقت آخرته که حالا وقت آخرت چی کار باید بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 652.79,
   "end": 655.09,
   "text": "شهادته اینه که به دردت می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 655.09,
   "end": 658.05,
   "text": "شهادت میدی بعد لقا حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 658.05,
   "end": 660.43,
   "text": "ملاقات می‌کنی. سلام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 660.43,
   "end": 662.73,
   "text": "دیگه مخاطب-- \"السلام علیک\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 662.73,
   "end": 665.19,
   "text": "\"السلام علينا\"، \"السلام عليكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 665.19,
   "end": 668.83,
   "text": "ببین همش سلامه. این دیگه قیامت رخ داده، آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 668.83,
   "end": 676.33,
   "text": "لقا رخ داده. اینا همش معناهایی‌ست که من تند و تند دارم میگم هر کدومش باور کنید چند تا منبر می‌طلابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 676.33,
   "end": 678.33,
   "text": "یه دونه دیگه هم بگم زیاده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 678.33,
   "end": 683.83,
   "text": "وقت داریم یه دونه دیگه بگیم که. اونم موت در ایمان و کفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 683.83,
   "end": 686.07,
   "text": "موت در ایمان و کفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.07,
   "end": 689.71,
   "text": "یعنی این که می‌تونه کسی در حالت ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.71,
   "end": 692.47,
   "text": "جون بده. خیلی خوب بهترین نوع موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 692.47,
   "end": 695.01,
   "text": "یکی هم خدایی نکرده در حالت کفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 695.01,
   "end": 700.19,
   "text": "کسی که به فرمایش حضرت عیسی علیه النبيین و آله و علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 700.19,
   "end": 704.65,
   "text": "ا بخواد به ایمان بمیره دو بار باید بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 704.65,
   "end": 707.45,
   "text": "می‌تونه معنای این دو موت اونم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 707.45,
   "end": 710.07,
   "text": "یه روایت شیرینی بود که من قبلاً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 710.07,
   "end": 713.57,
   "text": "براتون اینو خونده بودم. م-- سند و مدرکش هم گفته بودم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 713.57,
   "end": 718.33,
   "text": "حضرت عیسی فرمود \"لم يلق الملكوت السماوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 718.33,
   "end": 720.77,
   "text": "لم يلق الملكوت السماوات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 720.77,
   "end": 726.39,
   "text": "هیچکس نمی‌تونه به ملکوت، به باطن آسمان‌ها برسه که این معنای موته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 726.39,
   "end": 730.23,
   "text": "حرکت به سمت ملکوت. \"ملم يلد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 730.23,
   "end": 735.93,
   "text": "ملم يولد مرة\". مگر اینکه دو بار احیا، دو بار زنده شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 735.93,
   "end": 738.67,
   "text": "این دو بار زنده شدن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 738.67,
   "end": 742.01,
   "text": "اولاً دو بار زنده شدن دو تا موت توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 742.01,
   "end": 744.65,
   "text": "ثانیا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 744.65,
   "end": 748.49,
   "text": "زندگی دومی برمی‌گرده به زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 748.49,
   "end": 750.45,
   "text": "انسانی، ایمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 750.45,
   "end": 755.99,
   "text": "یعنی ما الان زنده‌ایم. خب بله، حیوان هم زنده است، نبات هم زنده است، جماد هم زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 755.99,
   "end": 758.39,
   "text": "اما اگر ایمان داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 758.39,
   "end": 760.87,
   "text": "این موتت می‌شه موت ایمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 760.87,
   "end": 764.91,
   "text": "یعنی اگر بمیری الان با ایمان می‌شه موت ایمانی و دو نوع موت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 764.91,
   "end": 767.57,
   "text": "لذا حضرت عیسی فرمود اگر دومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 767.57,
   "end": 774.07,
   "text": "حیات رو نداشته باشی نمی‌تونی به اون موت ایمانی یعنی به ملکوت آسمان‌ها برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 774.07,
   "end": 778.95,
   "text": "و، و، و، و قس علی هذا تا دلتون بخواد دو تا، دو تا، دو تا همینجوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 778.95,
   "end": 783.93,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 783.93,
   "end": 788.89,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}