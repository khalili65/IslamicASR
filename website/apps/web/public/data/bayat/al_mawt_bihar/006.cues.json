 },
 "chapters": [
  {
   "index": 0,
   "title": "## خروج حیات با ورود موت",
   "start": 0.36,
   "end": 173.2
  },
  {
   "index": 1,
   "title": "## ظاهر مؤمن و سخن امام حسن",
   "start": 173.2,
   "end": 465.2
  },
  {
   "index": 2,
   "title": "آیه‌ای عجیب که بارها قرائت و ده‌ها جلسه درباره‌اش سخن رفته:",
   "start": 465.2,
   "end": 513.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 4.52,
   "text": "الهدی المستقيم. السلام علیک یا دعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 6.92,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.92,
   "end": 9.98,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.98,
   "end": 12.64,
   "text": "نکته خیلی مهمی جا مونده بود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.64,
   "end": 15.42,
   "text": "کتاب الموت مرحوم مجلسی علیه الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.42,
   "end": 19.62,
   "text": "روایت دوم باب اول بودیم اگه یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.62,
   "end": 24.42,
   "text": "که می‌فرمود موت هم مثل حیات خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.42,
   "end": 26.96,
   "text": "و به محض اینکه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.96,
   "end": 30.98,
   "text": "داخل می‌شه \"خرجت منه الحیاة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.98,
   "end": 35.82,
   "text": "این \"خرجت منه الحیاة\" یه نکته‌ای درش هست، نکات زیادی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.82,
   "end": 38.82,
   "text": "تبرّکن این رو عرض کنم به دردمون می‌خوره بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.82,
   "end": 43.48,
   "text": "خب اینکه می‌دونید حیات در این زندگی دنیوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.48,
   "end": 46.0,
   "text": "اِاِاِ نفس کشیدن ذیل اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.0,
   "end": 48.0,
   "text": "ال، از ظاهر حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 48.0,
   "end": 52.24,
   "text": "یعنی از باطن‌ها کسی خبر نداره، ظاهر هویداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.24,
   "end": 54.9,
   "text": "موت یعنی ظهور اسم الباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 54.9,
   "end": 56.98,
   "text": "این‌ها رو قبلاً بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 56.98,
   "end": 62.32,
   "text": "میگه وقتی که موت داخل شد \"خرجت منه الحیاة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.32,
   "end": 66.6,
   "text": "حیات چی بود؟ ظهور اسم از ظاهر حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.6,
   "end": 70.9,
   "text": "یعنی اون ظواهر برداشته می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.9,
   "end": 75.34,
   "text": "برای مؤمن ظواهر برداشته می‌شن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.34,
   "end": 77.44,
   "text": "برای مشرک و کافر و منافق فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.44,
   "end": 81.02,
   "text": "آقا برای مؤمن ظواهر برداشته می‌شن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 81.02,
   "end": 86.04,
   "text": "یعنی اینکه تعبیری که اهل بیت علیهم الصلاة والسلام کردن فرمودن مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.04,
   "end": 88.26,
   "text": "مثل سکه طلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 88.26,
   "end": 90.38,
   "text": "ذاتش با گناه تغییر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 90.38,
   "end": 93.82,
   "text": "آلودگی میاد می‌نشینه روی این سکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 93.82,
   "end": 97.24,
   "text": "اینکه ظاهرش برداشته می‌شه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 97.24,
   "end": 102.56,
   "text": "یعنی اینکه اون کثافت‌ها، خباثت‌ها و آلودگی‌ها با موت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 102.56,
   "end": 106.6,
   "text": "لذا ما گمان می‌کنیم اگر کسی بد جون داد آدم بدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 106.6,
   "end": 111.14,
   "text": "در صورتی که اینطوری نیست. حضرت موسی ابی نبی نبی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.14,
   "end": 115.74,
   "text": "رد می‌شد دید یه پادشاهی از دنیا رفته خیلی با عظمت دارن تشییعش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.74,
   "end": 120.66,
   "text": "خیلی هم خوب و تو رختخواب زربفتش مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.66,
   "end": 123.44,
   "text": "رفت جلوتر دید یه مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.44,
   "end": 125.82,
   "text": "دیوار ریخته روش داره بد جون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 125.82,
   "end": 127.52,
   "text": "داد می‌زنه، دست و پا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 127.52,
   "end": 133.52,
   "text": "تعجب کرد. خدا فرمود بین من و اون مؤمن گناهانی بود با این شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 133.52,
   "end": 136.34,
   "text": "موتش اون‌ها رو، اون ظواهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 136.34,
   "end": 139.52,
   "text": "ظاهر حیات، اونو دارن برمیدارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 139.52,
   "end": 142.22,
   "text": "و بین من و اون آدم سلطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 142.22,
   "end": 144.56,
   "text": "کافر و منافق حالا مشرک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 144.56,
   "end": 149.1,
   "text": "اون هم یه خیراتی بود، کارهایی کرده بود با این عزت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 149.1,
   "end": 152.22,
   "text": "ظاهراً راحت جون دادنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 152.22,
   "end": 154.82,
   "text": "تصفیه شد که اونور یه راست بره عقاب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 154.82,
   "end": 158.16,
   "text": "این نکته مهمیه که این بردا-- اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 158.16,
   "end": 163.08,
   "text": "دار دنیا اینطوریه. همش همراه با سختیه برای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 163.08,
   "end": 167.02,
   "text": "حرارت-- حلاوة الدنيا مرارة الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 167.02,
   "end": 171.86,
   "text": "عجب حدیثیه. مرارة الدنيا حلاوة الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 171.86,
   "end": 174.26,
   "text": "اصلاً اینطوریه. جالبه که امام حسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 174.26,
   "end": 176.26,
   "text": "البته باید تأویل بشه اینا احادیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 176.26,
   "end": 179.0,
   "text": "امام حسن قربونش بریم خیلی تیپ خوبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 179.0,
   "end": 183.16,
   "text": "به قول ما خوش تیپ کرده بود و خوش عطر و اینا و لباس قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 183.16,
   "end": 189.58,
   "text": "حالا ظهور-- اِاِاِ حلول ماه ربیع هم به همتون تبریک میگیم که باید در ظاهرمون هم گل کنه دیگه این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 189.58,
   "end": 191.84,
   "text": "فرق باید بکنه با ماه قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 191.84,
   "end": 197.82,
   "text": "بعد یه کافری اونجا رد می‌شد گفت آقا شما خیلی گدا بود، فقیر بود، بیچاره بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 197.82,
   "end": 200.9,
   "text": "ژنده‌پوش بود. آقا، آقا شما میگید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 200.9,
   "end": 204.9,
   "text": "از دنیا اِاِاِ جنت الكافر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 204.9,
   "end": 207.52,
   "text": "دنیا بهشت کافره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 207.52,
   "end": 212.62,
   "text": "و مثلاً جای بدیه، سختیه برای مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 212.62,
   "end": 219.54,
   "text": "چطور الان شما انقدر خوب پوشیدی، انقدر خوب عطر زدی فلان منی که کافرم انقدر بدبختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 219.54,
   "end": 222.42,
   "text": "امام، امام حسن فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 222.42,
   "end": 227.92,
   "text": "اگر بدونی اون طرف خدا چه نعمت‌هایی برای ما اهل ایمان قرار داده، میگی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.92,
   "end": 231.68,
   "text": "چیزی نیست، این خوش پوشی من اصلاً در برابر اون چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 231.68,
   "end": 235.58,
   "text": "این یعنی اینا باید تأویل بشه، حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 235.58,
   "end": 243.66,
   "text": "حواسمون جمع باشه که دنیا کاملاً عجینه با مکاره، با سختی‌ها، با بد-- با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.66,
   "end": 247.16,
   "text": "گرفتاری‌ها. اون آیه صد و پنجاه و پنج سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 247.16,
   "end": 249.42,
   "text": "آل، سوره بقره رو حفظ باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.42,
   "end": 255.76,
   "text": "\"ولنبلونکم بشیء من الخوف والجوع ونقص من الأموال والأنفس والثمرات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.76,
   "end": 258.6,
   "text": "که چی بشه؟ \"فبشر الصابرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 258.6,
   "end": 263.22,
   "text": "برای اینکه اهل صبر باشی و بشارت بگیری از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.22,
   "end": 270.76,
   "text": "جالبه که- جانم. حدیثی که روایت کردید گفتید که \"خرجت منه الحیاة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.76,
   "end": 274.18,
   "text": "میگه منظور این ضمیره‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 274.18,
   "end": 279.68,
   "text": "منه‌هایی که گفته به موت برمی‌گرده یعنی اینکه خود حیات هم از مرگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.68,
   "end": 282.28,
   "text": "بله تا aman یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.28,
   "end": 284.86,
   "text": "حالا شما چهره‌تون آشناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.86,
   "end": 287.82,
   "text": "مباحث قبلی رو چون نبودید قبلاً ما بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 287.82,
   "end": 292.24,
   "text": "حیات و موت یک حقیقتن با دو جلوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.24,
   "end": 294.18,
   "text": "یک حقیقتن با دو جلوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.18,
   "end": 300.2,
   "text": "حالا این چیزی که الان ما می‌خوایم اینجا بگیم و مهمه توجه به اینه که ما اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.2,
   "end": 305.86,
   "text": "ایمان به جهت اون آلودگی‌هایی که می‌خواد بره مخصوصاً وقت موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.86,
   "end": 307.82,
   "text": "یه شیشه خرده‌هایی باید بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.82,
   "end": 313.46,
   "text": "اینو حواسمون جمع باشه که اون برداشته بشه، اون آلودگی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.46,
   "end": 318.9,
   "text": "و جالبه که اِاِاِ یه روایت دیدم اینم تقدیم کنم خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.9,
   "end": 320.7,
   "text": "خیلی این روایتو من دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.7,
   "end": 325.92,
   "text": "زیاد می‌بینمش که در که-- جلد هفده بهاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.92,
   "end": 329.06,
   "text": "امیر المؤمنین، امیر البیان صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.06,
   "end": 334.24,
   "text": "دید جابر ابن عبدالله انصاری از صحابه بزرگ پیغمبره خیلی غمگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.24,
   "end": 335.96,
   "text": "گفت چی شده؟ چرا انقدر ناراحتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 335.96,
   "end": 340.1,
   "text": "گفت از گرفتاری‌های دنیا که هممون داریم می‌دونم دیگه، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.1,
   "end": 343.3,
   "text": "اینطوری نیست؟ از گرفتاری‌های دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.3,
   "end": 349.68,
   "text": "قربون این آقا برم چقدر حکیمانه فرمودن که جابر غصه نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.68,
   "end": 354.1,
   "text": "شیرین‌ترین چیزها، لذت‌ها در دنیا هفت تا چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.1,
   "end": 357.14,
   "text": "من اینا رو برات تبیین کنم. مولا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.14,
   "end": 359.78,
   "text": "می‌فرماید یکیش خوردنیه که از عسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.78,
   "end": 362.18,
   "text": "شیرین‌ترین خوردنی، بهترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.18,
   "end": 364.84,
   "text": "عسله که از استفراغ زنبوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.84,
   "end": 371.72,
   "text": "مولا می‌فرماید بعد می‌فرماید آشامیدنی، آب بهترین آشامیدنی که از قعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 371.72,
   "end": 377.54,
   "text": "خاک و دل زمینه. از تو دل زمین خاک میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.54,
   "end": 381.52,
   "text": "فرمود بوییدنی مشکه که خون ناف ناف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.52,
   "end": 385.42,
   "text": "آهوه. از پست‌ترین جای آهوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.42,
   "end": 387.54,
   "text": "پوشیدنی فرمود ابریشمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.54,
   "end": 390.38,
   "text": "لعاب دهان کرم ابریشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.38,
   "end": 392.52,
   "text": "کرم. لعاب دهان کرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.52,
   "end": 394.22,
   "text": "انقدر بهش پز میدیم می‌پوشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 394.22,
   "end": 397.62,
   "text": "الله اکبر! امیربیان چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.62,
   "end": 400.42,
   "text": "فرمود همبستری عجب سؤالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 400.42,
   "end": 404.46,
   "text": "زوجین همبستری که فرمود کثیف‌ترین و پست‌ترین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 404.46,
   "end": 408.38,
   "text": "عورت دیگه زشتی، زشت‌ترین جاهاشون به هم نزدیک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 408.38,
   "end": 411.54,
   "text": "آخه چیه؟ دل می‌بندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.54,
   "end": 413.54,
   "text": "وسایل سواری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 413.54,
   "end": 417.62,
   "text": "فرمود اسبه که بالاخره سوارش رو می‌زنه زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.62,
   "end": 422.08,
   "text": "عجب. و هفتمیش فرمود شنیدنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 422.08,
   "end": 423.88,
   "text": "حالا موسیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.88,
   "end": 426.74,
   "text": "فرمود پ-- مولا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.74,
   "end": 431.36,
   "text": "بدترین مس-معصیت روی زمین همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.36,
   "end": 433.6,
   "text": "چطور دل می‌بندیم به این‌ها؟ بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.6,
   "end": 438.88,
   "text": "جابر میگه اینو که از مولا شنیدم این حرف، سخن حکیمانه رو آرامش گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 438.88,
   "end": 442.56,
   "text": "و دیگه تا آخر عمرم برای دنیا ارزش قائل نشدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.56,
   "end": 445.3,
   "text": "این خیلی مهمه که ما بدانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 445.3,
   "end": 451.78,
   "text": "در چه-- ببینید اون آیه‌ای که همیشه قرائت می‌کردیم آیه فکر کنم شش surah انشقاق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.78,
   "end": 455.5,
   "text": "با هم بخونیم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.5,
   "end": 457.86,
   "text": "خیلی آیه عجیبیه. فکر کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.86,
   "end": 460.58,
   "text": "بیست سی جلسه ما در مورد این آیه حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.58,
   "end": 463.58,
   "text": "\"یا ایها الانسان\" من و شما هم انسان هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.58,
   "end": 466.36,
   "text": "مطلقا. \"انك كادح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.36,
   "end": 469.32,
   "text": "کاده یعنی رونده همراه با سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 469.32,
   "end": 473.6,
   "text": "دائما تو در حال سختی رونده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 473.6,
   "end": 475.7,
   "text": "دوباره میگه \"كدح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.7,
   "end": 479.8,
   "text": "تأکید می‌کنه حواست باشه سختیه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 479.8,
   "end": 482.08,
   "text": "که چی بشه؟ \"فملاقیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 482.08,
   "end": 484.48,
   "text": "چون قراره خدا پاکو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 484.48,
   "end": 490.5,
   "text": "زیارت کنی ملاقات کنی سختی میاد که اون آلودگی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 490.5,
   "end": 493.72,
   "text": "ببره. تو یه کلام، موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 493.72,
   "end": 496.4,
   "text": "یکی از متهراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 496.4,
   "end": 498.46,
   "text": "موت یکی از متهراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 498.46,
   "end": 500.96,
   "text": "از چیز متهر ما باید بدمون بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 500.96,
   "end": 503.3,
   "text": "متهره، پاک کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 503.3,
   "end": 507.96,
   "text": "انشاالله هممون پاک از دنیا بریم به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 507.96,
   "end": 510.52,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 510.52,
   "end": 513.72,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}