   "start": 625.78,
   "end": 700.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 5.2,
   "text": "وبہین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 9.84,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.84,
   "end": 15.88,
   "text": "بریم به فضل الهی سراغ روایت هفتم از باب دوم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.88,
   "end": 18.82,
   "text": "ابا بصیر از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 23.72,
   "text": "صلوات الله علیه نقل می‌کنه که حضرت فرمودند اذا بلغ العبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.72,
   "end": 27.96,
   "text": "ثلاث وثلاثین سنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.96,
   "end": 31.62,
   "text": "یعنی وقتی که بنده به سی‌وسه سالگی رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.62,
   "end": 33.9,
   "text": "فقط بلغ أشدّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.9,
   "end": 36.2,
   "text": "به حد رشد خودش رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.2,
   "end": 41.2,
   "text": "یعنی دیگه ظاهراً کمال رشدی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.2,
   "end": 44.1,
   "text": "در سن سی‌وسه سالگی واقع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.1,
   "end": 47.54,
   "text": "و اذا بلغ أربعین سنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.54,
   "end": 50.8,
   "text": "فقط انتهى منتهاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.8,
   "end": 57.94,
   "text": "و وقتی هم که به چهل سال برسه دیگه به نهایت این رشد و کمال رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.94,
   "end": 62.58,
   "text": "اینطور که مشخصه از سی‌وسه سال تا چهل سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.58,
   "end": 66.36,
   "text": "یک سیر ثابتی رو داره یعنی خیلی تغییری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.36,
   "end": 71.08,
   "text": "دیگه اوج شدت و بلوغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.08,
   "end": 75.16,
   "text": "خودش رو داره تو این سن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.16,
   "end": 79.88,
   "text": "و حضرت ادامه دادند و اذا بلغ احدى و أربعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.88,
   "end": 82.64,
   "text": "فهو في النقصان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.64,
   "end": 87.66,
   "text": "وقتی که به سن چهل و یک سالگی رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.66,
   "end": 94.74,
   "text": "از اینجا به بعد دیگه رو به نقصان می‌گذاره، رو به کاستی می‌گذاره از چهل و یک سالگی به بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.74,
   "end": 97.74,
   "text": "یعنی میفته دیگه به ضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.74,
   "end": 103.0,
   "text": "فهو في النقصان. و ینبغي لصاحب الخمسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.0,
   "end": 106.08,
   "text": "فرمود وقتی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.08,
   "end": 109.44,
   "text": "به پنجاه سال رسید چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.44,
   "end": 112.56,
   "text": "أن يكون كمن هو في النزع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.56,
   "end": 116.36,
   "text": "فرمود همین که-- همچین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.36,
   "end": 121.94,
   "text": "شایسته است که در حال نزع یعنی جان کندن باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.94,
   "end": 124.78,
   "text": "کسی که به سن پنجاه سالگی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.78,
   "end": 128.46,
   "text": "این یه روایت. این نشون می‌ده که-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.46,
   "end": 131.68,
   "text": "شما برید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.68,
   "end": 135.4,
   "text": "همه داریم جان می‌کنیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.4,
   "end": 138.86,
   "text": ". بله همه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.86,
   "end": 141.54,
   "text": "بله حقیقتم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.54,
   "end": 148.42,
   "text": "حالا خیلی جالب اینجاست که نمی‌فرماید به سن پنجاه سالگی رسیدی یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.42,
   "end": 152.2,
   "text": "موت کن. می‌گه شایسته است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.2,
   "end": 155.74,
   "text": "اصلاً خودت رو در حال جان کندن ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.74,
   "end": 158.36,
   "text": "چرا؟ خب ما که زنده‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.36,
   "end": 161.54,
   "text": "یعنی چی در حال نزع خودت رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.54,
   "end": 166.3,
   "text": "نشون می‌ده که از سن پنجاه سالگی به بعد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.3,
   "end": 168.94,
   "text": "رفته رفته شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.94,
   "end": 170.84,
   "text": "موت. موت شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.84,
   "end": 175.36,
   "text": "ما متاسفانه گمان می‌کنیم که موت یک آنه تموم می‌شه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.36,
   "end": 179.5,
   "text": "در صورتی که نه، اینطور که این روایت داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.5,
   "end": 187.34,
   "text": "همونطوری که رشد ما، کمال ما، شدت ما، بلوغ ما رفته رفته بوده، موت ما هم همینجوری رفته رفته اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.34,
   "end": 192.4,
   "text": "اتفاقاً تو رساله سیر و سلوک سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.4,
   "end": 197.68,
   "text": "خیلی با یک نهیب بیشتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.68,
   "end": 205.88,
   "text": "بیان شده. می‌فرماید چرا قوای انسان بعد از چهل سالگی، اونجا سید میگه بعد از چهل سالگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.88,
   "end": 212.6,
   "text": "خورد خورد میره. اینجا هم خب اینطور که روایت میگه از چهل و یک سالگی دیگه نقصان شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.6,
   "end": 217.0,
   "text": "یعنی در حقیقت از چهل و یک سالگی موت شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.0,
   "end": 220.58,
   "text": "یعنی چی؟ اونجا می‌فرماید، سید می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.58,
   "end": 223.52,
   "text": "چرا رفته رفته قوا تحلیل میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.52,
   "end": 226.66,
   "text": "یعنی چشمت ضعیف می‌شه، کمرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.66,
   "end": 231.42,
   "text": "درد می‌گیره، استخون‌هات درد می‌گیره، قوای بدن ضعف این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.42,
   "end": 236.7,
   "text": "در حقیقت این‌ها دارن سفر آخرتشون رو شروع کردن دارن میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.7,
   "end": 239.92,
   "text": "یعنی موت شروع شده. موت تدریجیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.92,
   "end": 242.68,
   "text": "موت تدریجیه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.68,
   "end": 245.36,
   "text": "قوای باصره سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.36,
   "end": 247.48,
   "text": "آخرتش رو شروع کرده خورد خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.48,
   "end": 249.92,
   "text": "ولی این لطف خداست که یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.92,
   "end": 252.12,
   "text": "به صورت مرگ احترامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.12,
   "end": 255.3,
   "text": "نگیره که حالا بحثش بعداً می‌گذره یا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.3,
   "end": 258.34,
   "text": "مفاجات. ایشالله بعداً درباره‌ش حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.34,
   "end": 260.52,
   "text": "لطف خداست خورد خورد شروع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.52,
   "end": 263.04,
   "text": "هی آلارم می‌زنه، هی آلارم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.04,
   "end": 265.5,
   "text": "یواش یواش دیگه آماده مرگ می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.5,
   "end": 267.68,
   "text": "این البته بحث چیه؟ بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.68,
   "end": 272.46,
   "text": "جسمه. و الا اتفاقاً روح، نفس، عقل این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.46,
   "end": 276.56,
   "text": "بالعکسه. هرچی انسان سنش میره بالاتر اون قوی‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.56,
   "end": 280.34,
   "text": "یعنی اتفاقاً از سن چهل سالگی به بعد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.34,
   "end": 283.3,
   "text": "کمال، اوج کمال عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.3,
   "end": 289.74,
   "text": "خودش رو نشون میده. لذا غالباً دیگه انبیا می‌بینید که از چهل سالگی مبعوث به پیامبری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.74,
   "end": 291.82,
   "text": "و من خیلی هم دیدم که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.82,
   "end": 294.06,
   "text": "علامه حسن زاده امتداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.06,
   "end": 297.8,
   "text": "تأکید می‌کردن که چه خبرتونه مثلاً شما هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.8,
   "end": 302.42,
   "text": "چهل سالتون تموم نشده راه می‌افتید از این شهر به اون شهر تبلیغ می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.42,
   "end": 304.36,
   "text": "بعد چهل سالتون تموم شه بعد برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.36,
   "end": 306.92,
   "text": "من خودم بنده حقیر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.92,
   "end": 310.06,
   "text": "تقریباً چهل و فکر کنم دو سالگی بودم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.06,
   "end": 313.7,
   "text": "تبلیغمو یعنی از این شهر به اون شهر برم و تبلیغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.7,
   "end": 316.72,
   "text": "و این‌ها رو شروع کردم. و الا خب تو هیئت خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.72,
   "end": 319.74,
   "text": "سی سال برای بچه‌های خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.74,
   "end": 324.96,
   "text": "می‌شه گفت رفیقای خودمون صحبت کردیم اما تبلیغ به اون معنا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.96,
   "end": 327.84,
   "text": "پس عقل قصه‌ش فرق می‌کنه‌ها اشتباه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.84,
   "end": 330.14,
   "text": "اما جسم نه. جسم دیگه از شر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.14,
   "end": 340.04,
   "text": "حالا می‌شه با یه سری کارها این رفته رفته به ضعف افتادن و موت تدریجی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.04,
   "end": 346.5,
   "text": "طولش داد. یعنی زود آدم از، از پا نیفته یا اون ارز الال امر رو به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.5,
   "end": 352.24,
   "text": "طولش داد. یعنی زود انسان به اونجا نرسه مخصوصاً با تغذیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.24,
   "end": 355.78,
   "text": "ما قبلاً عرض کردیم. من خواهش می‌کنم این‌ها رو جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.78,
   "end": 358.22,
   "text": "این‌ها از جهت علمی ثابت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.22,
   "end": 361.04,
   "text": "مرحوم شیخ انصاری وقتی اخلاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.04,
   "end": 363.42,
   "text": "أربع رو بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.42,
   "end": 367.42,
   "text": "از شود دم و بلغم و سودا و صفرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.42,
   "end": 371.14,
   "text": "که ایشون می‌فرماید بدن انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.14,
   "end": 373.26,
   "text": "ماحصل این چهار تا عنصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.26,
   "end": 375.9,
   "text": "یعنی این چهار تا خلت اسمشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.9,
   "end": 379.7,
   "text": "شیخ الرئیس میذاشته. اِاِاِ خلت و عرب-- میشه ار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.7,
   "end": 385.0,
   "text": "اخلاط اربعة. این چهار تا خلتن که بدن انسان رو تشکیل می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.0,
   "end": 389.94,
   "text": "که البته اونجا هم توضیح می‌ده که مثلا دم، ماهیچه‌ها، قلب، عضلات و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.94,
   "end": 395.08,
   "text": "می‌سازه. بلغم، مغز و شبکه اعصاب و نخاعی و لیفه عضلانی و چه وچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.08,
   "end": 397.54,
   "text": "صفرا عامل مثلاً گذر خون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.54,
   "end": 402.82,
   "text": "به بافت‌های دوردست از طریق مویرگ‌ها مثلا از طریق سودا استخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.82,
   "end": 405.38,
   "text": "یک یک می‌گه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.38,
   "end": 414.0,
   "text": "اگر این چنینه، اگر از طریق این اخلاط اربعة بافت‌ها و اعضای بدن ساخته می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.0,
   "end": 416.84,
   "text": "خود اخلاط از چی ساخته می‌شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.84,
   "end": 420.16,
   "text": "از غذا. آب و غذایی که ما می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.16,
   "end": 423.96,
   "text": "پس اینجا شیخ الرئیس میاد یه نتیجه مهمی رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.96,
   "end": 426.88,
   "text": "می‌فرماید از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.88,
   "end": 432.94,
   "text": "غذا، یعنی سبک زندگی اسلامی که رهبر عزیزمون می‌گه تغذیه سالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.94,
   "end": 436.74,
   "text": "می‌شه انسان کاری بکنه که اعضای بدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 436.74,
   "end": 439.12,
   "text": "قوی، محکم، لطیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.12,
   "end": 445.0,
   "text": "حتی تو اخلاقی، اخلاقیاتش، روحیاتش تاثیر مستقیم بگذاره که حالا این بحث‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.0,
   "end": 446.72,
   "text": "تقریباً بین ما گذشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.72,
   "end": 449.14,
   "text": "همون ارتباط مزاج با بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.14,
   "end": 451.94,
   "text": "مثلا شیخ الرئیس می‌فرماید که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.94,
   "end": 454.86,
   "text": "هرچی غذایی که می‌خوری لطیف‌تر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.86,
   "end": 456.9,
   "text": "یعنی زود هضم‌تر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.9,
   "end": 459.38,
   "text": "به یک معنا گرم باشه این غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.38,
   "end": 462.84,
   "text": "گرم دمایی نه ها، مزاجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.84,
   "end": 468.34,
   "text": "خب این باعث می‌شه که انسان اخلاقش لطیف باشه، گرم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.34,
   "end": 474.2,
   "text": "اگر غذایی که می‌خوره کثیف باشه یعنی دیر هضم باشه، سفت باشه، سخت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.2,
   "end": 476.9,
   "text": "این‌ها یا سرد باشه مخصوصاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.9,
   "end": 482.48,
   "text": "اخلاق انسان به سمت پستی و خشونت و بداخلاقی و این‌ها می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.48,
   "end": 487.76,
   "text": "و وقتی خشن شد، بداخلاق شد، سرد مزاج شد، می‌بینی اصلاً حوصله نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 487.76,
   "end": 490.62,
   "text": "اصلاً نمی‌خواد-- خیلی موقع‌ها اینطوری می‌شه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.62,
   "end": 494.19,
   "text": "حالا یه تجربه شخصی خودمو همین فاطمیه امسال بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.19,
   "end": 498.2,
   "text": "که سه شب اول فاطمیه هیئت خودمون یا زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.2,
   "end": 500.74,
   "text": "خیلی شبای عالی، خوب. خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.74,
   "end": 505.12,
   "text": "نمره خوبی به خودم دادم از حیث منبر و روضه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.12,
   "end": 509.92,
   "text": "شب چهارم حالا غذایی که می‌خوردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.92,
   "end": 513.24,
   "text": "قبل از منبر که من سعی می‌کنم سبک باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 513.24,
   "end": 517.1,
   "text": "ناهار که می‌خوردیم همراهش ترشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.1,
   "end": 521.74,
   "text": "حاج خانم‌ها گذاشته بود. ترشی رو که حالا گفتم بخورم، نخورم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.74,
   "end": 523.8,
   "text": "سرده اینا بالاخره علمشو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.8,
   "end": 525.8,
   "text": "ولی گفتم بذار تجربه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.8,
   "end": 528.12,
   "text": "بذار ببینم چی می‌شه. و چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.12,
   "end": 530.42,
   "text": "چه تجربه اشتباهی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.42,
   "end": 533.42,
   "text": "این سردی رو، سرکه رو و اینا رو که خوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 533.42,
   "end": 535.74,
   "text": "گفتم بذار ببینم امشب منبرم چجوری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.74,
   "end": 539.72,
   "text": "اصلاً اون شب نتونستم ب-براهین اخ-عقلی رو بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.72,
   "end": 543.1,
   "text": "اصلاً نشد. یعنی نتونستم بحث اخلاقی، چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.1,
   "end": 549.2,
   "text": "عقلی کنم. مباحثم روایی شد و نقلی و خیلی سطح پایین و اصلاً از خودم راضی نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.2,
   "end": 551.7,
   "text": "حتی تو روضه‌ام سیمم وصل نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.7,
   "end": 555.32,
   "text": "عجیب بود برام. یا شیخ الرئیس حالا خودم اینو تجربه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.32,
   "end": 559.12,
   "text": "بعد دیدم شیخ الرئیس هم می‌فرماید اگر جایی خواستی بحث کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.12,
   "end": 561.68,
   "text": "غالب بشی خودت عسل بخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.68,
   "end": 565.38,
   "text": "و اونایی که مباحثه می‌خوای باهاشون بحث کنی سرکه بده بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 565.38,
   "end": 568.0,
   "text": "تو قطعاً غالب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 568.0,
   "end": 571.98,
   "text": "بحث شیخ الرئیسه. حالا این کارو بکنید ببینید نتیجه‌ش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.98,
   "end": 574.52,
   "text": "اینا خیلی مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 574.52,
   "end": 580.44,
   "text": "مخصوصاً در اسلام تاکید شده به گرمی‌جات، گرمی زیاد خوردن بیشتر از سردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.44,
   "end": 583.92,
   "text": "حالا مثلاً الان گوشت گوسفند گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.92,
   "end": 587.34,
   "text": "گوشت گوساله و گاو و اینا سرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.34,
   "end": 590.5,
   "text": "خب بله گرون‌تر هم هست ولی خب دیگه چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.5,
   "end": 595.6,
   "text": "مثلاً گوشت مرغ طبیعی، مرغ طبیعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 595.6,
   "end": 598.22,
   "text": "مرغ مزرعه اینا گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.22,
   "end": 601.24,
   "text": "اما این مرغ‌های ماشینی نه، اینا سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.24,
   "end": 605.46,
   "text": "حالا مثلاً عطرها، اکثر عطرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 605.46,
   "end": 608.8,
   "text": "متأسفانه عطرهای امروز اکثرشون سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 608.8,
   "end": 611.64,
   "text": "عطر محمدی، عطر یاس، عطر، عطر مشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.64,
   "end": 614.58,
   "text": "اگه نابشو پیدا کنی اینا گرمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.58,
   "end": 617.14,
   "text": "لباس‌ها گرمی سردی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.14,
   "end": 619.92,
   "text": "اینا همه در اخلاق تاثیرگذارن ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.92,
   "end": 622.72,
   "text": "یعنی بوییدن‌ها، دیدن‌ها، شنیدن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.72,
   "end": 624.92,
   "text": "موسیقی حتی موسیقی شرق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 624.92,
   "end": 627.12,
   "text": "شرق غالباً گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.12,
   "end": 630.34,
   "text": "موسیقی غرب، این پاپ و این چیا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 630.34,
   "end": 632.86,
   "text": "غالباً چین؟ سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.86,
   "end": 635.16,
   "text": "آدم‌هایی که باهات همراهن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 635.16,
   "end": 640.06,
   "text": "اینایی که اخلاق پست و لعیمانه دارن، اینا سرد مزاجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.06,
   "end": 641.62,
   "text": "ایناها تو رو هم سرد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 641.62,
   "end": 645.1,
   "text": "یعنی اَلْمُجَالَسَةُ مُؤَثِّرَةٌ اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.1,
   "end": 647.74,
   "text": "تو رو هم به سمت پستی و سرد مزاجی می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 647.74,
   "end": 650.04,
   "text": "بداخلاقی و بی‌حوصلگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 650.04,
   "end": 653.08,
   "text": "آدم‌هایی که کریم، کریمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 653.08,
   "end": 655.92,
   "text": "لعی نیستن، بزرگوارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 655.92,
   "end": 657.8,
   "text": "صبورن، خوش اخلاقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 657.8,
   "end": 661.36,
   "text": "اینا می‌بینی بر سر همنشینی با اینا تو گرم میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 661.36,
   "end": 664.44,
   "text": "خلاصه در بوییدن، چشیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 664.44,
   "end": 667.3,
   "text": "لمس کردن، خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 667.3,
   "end": 672.88,
   "text": "شنیدن حتی. همه این‌ها این علم وارد شده که بحث مزاج شناسی و مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 672.88,
   "end": 676.04,
   "text": "که باید انسان پیش بگیره و ارتباط این‌ها با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 676.04,
   "end": 678.38,
   "text": "با بدن و ارتباط بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 678.38,
   "end": 681.64,
   "text": "با اخلاط اربعة و ارتباط اون با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 681.64,
   "end": 683.96,
   "text": "این که انسان دیرتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 683.96,
   "end": 686.98,
   "text": "از پا بیفته و موت رو بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.98,
   "end": 688.9,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 688.9,
   "end": 692.18,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 692.18,
   "end": 700.0,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}