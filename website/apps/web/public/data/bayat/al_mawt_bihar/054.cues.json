  },
  {
   "index": 1,
   "title": "## فرار اهل ایمان از واجب به بهانهٔ بلا",
   "start": 100.86,
   "end": 203.62
  },
  {
   "index": 2,
   "title": "## جمع دو دسته روایت؛ مسجد و واجب در برابر غیرواجب",
   "start": 203.62,
   "end": 224.3
  },
  {
   "index": 3,
   "title": "## آیهٔ بیست و پنج توبه؛ روز حنین",
   "start": 224.3,
   "end": 342.22
  },
  {
   "index": 4,
   "title": "## تذکر اعتقادی؛ لا مؤثر فی الوجود إلا الله",
   "start": 342.22,
   "end": 410.86
  },
  {
   "index": 5,
   "title": "## خاطرهٔ جبهه؛ دیوار زرهی هشتصد و شصت تانک",
   "start": 410.86,
   "end": 478.64
  },
  {
   "index": 6,
   "title": "## جنگ سی‌وسه‌روزهٔ لبنان؛ غار و پیرزن",
   "start": 478.64,
   "end": 597.98
  },
  {
   "index": 7,
