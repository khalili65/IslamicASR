   "start": 597.98,
   "end": 670.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.18,
   "end": 3.24,
   "text": "صلی الله محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.24,
   "end": 5.2,
   "text": "و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.2,
   "end": 10.08,
   "text": "عجل فرجک. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.08,
   "end": 13.18,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.18,
   "end": 15.36,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.36,
   "end": 18.28,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.28,
   "end": 22.22,
   "text": "از روایت دوم تا نهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.22,
   "end": 25.6,
   "text": "باب سوم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.6,
   "end": 28.34,
   "text": "تقریبا مضامینش یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.34,
   "end": 31.76,
   "text": "لذا من دیگه یکی یکی به احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 31.76,
   "end": 37.6,
   "text": "ورود نمی‌کنم. یه بحث کلی و پیرامون این چند تا روایت می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.6,
   "end": 41.7,
   "text": "مضمون کلیش اولا اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.7,
   "end": 46.84,
   "text": "مثلا در حدیث دوم امیرالمؤمنین علیه الصلاة والسلام بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.84,
   "end": 51.84,
   "text": "مثلا طاعون کلا حالا طاعون رو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.84,
   "end": 53.46,
   "text": "بهانه‌ای فرض کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.46,
   "end": 55.22,
   "text": "الان مثلا می‌تونیم بگیم اومیکرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.22,
   "end": 57.54,
   "text": "اصلا موت، مرگ. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.54,
   "end": 60.98,
   "text": "هم وجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 60.98,
   "end": 64.04,
   "text": "حیات گر دارد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 64.04,
   "end": 66.36,
   "text": "در حقیقت کشنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 66.36,
   "end": 68.68,
   "text": "یعنی هم وجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 68.68,
   "end": 72.08,
   "text": "میراندن دارد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 72.08,
   "end": 75.5,
   "text": "زنده کننده. به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 75.5,
   "end": 78.22,
   "text": "حالا این به چه صورت هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 78.22,
   "end": 80.98,
   "text": "اون عنایت‌هایی که در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 80.98,
   "end": 84.48,
   "text": "مرگ یا مریضی، طاعون این‌ها هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 84.48,
   "end": 88.72,
   "text": "بحث احیاگری‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 88.72,
   "end": 93.66,
   "text": "و اون که کار رو قطع می‌کنه، تمام می‌کنه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 93.66,
   "end": 99.64,
   "text": "حالا مرگ و موت و سختی و عذاب و عقابشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 99.64,
   "end": 104.74,
   "text": "و این تنه بحث از روایت سوم میخوره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 104.74,
   "end": 107.92,
   "text": "فرار کردن اهل ایمان از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 107.92,
   "end": 110.34,
   "text": "مرگ یا به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 110.34,
   "end": 114.06,
   "text": "فرار کردن اهل ایمان به بهانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 114.06,
   "end": 117.3,
   "text": "مرگ یا به بهانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 117.3,
   "end": 120.08,
   "text": "بلا و مریضی از واجب الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 120.08,
   "end": 125.64,
   "text": "حالا این نکاتیه که حالا چند تای که من عرض کردم تو این روایت مجموعه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 125.64,
   "end": 132.16,
   "text": "که اصل اون چکیده، زبده و خلاصه اون مهمش اینه که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 132.16,
   "end": 135.04,
   "text": "عده‌ای هستند که به بهانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 135.04,
   "end": 140.06,
   "text": "اینکه میخوان جانشون رو حفظ کنن از مثلا طاعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.06,
   "end": 142.52,
   "text": "از بعضی از بلاها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 142.52,
   "end": 145.84,
   "text": "از واجب الهی فاصله می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 145.84,
   "end": 148.42,
   "text": "لذا مثلا دو تا روایت توی همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 148.42,
   "end": 151.58,
   "text": "فاصله آورده اینا ظاهرشون با هم همخوانی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 151.58,
   "end": 155.02,
   "text": "یه جا از پیغمبر سؤال می‌کنند که آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 155.02,
   "end": 162.26,
   "text": "ما اگر در مسجدی طاعون وارد شد و داشت در مسجد کشت و کشتار می‌کرد، ما از مسجد خارج بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 162.26,
   "end": 164.74,
   "text": "پیغمبر فرمود نخیر حق خروج ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 164.74,
   "end": 169.24,
   "text": "ای بابا! روایتی دیگه از امام رضا آورده برعکس این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 169.24,
   "end": 174.06,
   "text": "می‌گه آقا اگر ما یک در یک شهری بودیم طاعون اومد، مرگ و میر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 174.06,
   "end": 179.16,
   "text": "خارج بشیم؟ فرمود آری. سؤال کرد اگه در یه دهاتی بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 179.16,
   "end": 185.54,
   "text": "خارج بشیم؟ فرمود آری. سؤال کرد اگه توی خونه‌ای بودیم طاعون وارد شد، مرگ و میر وا شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.54,
   "end": 189.24,
   "text": "فرار کنیم خارج بشیم؟ فرمود آری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.24,
   "end": 193.46,
   "text": "بعد چقدر جالبه که تو این‌ها بعضیاشون مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.46,
   "end": 198.38,
   "text": "یه سوالی از امام کردن که پس رسول الله چی می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.38,
   "end": 200.18,
   "text": "که مثلا از مسجد خارج نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 200.18,
   "end": 203.62,
   "text": "شما می‌گی از شهر هم خارج-- از خونه هم خارج شید، مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 203.62,
   "end": 206.52,
   "text": "جمع کردن این روایات مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 206.52,
   "end": 211.56,
   "text": "که این‌ها-- اونی که پیغمبر فرموده حتی اگر در مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.56,
   "end": 214.2,
   "text": "مسجده، خونه خودت که نیست که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.2,
   "end": 216.3,
   "text": "حق نداری خارج بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 216.3,
   "end": 219.02,
   "text": "مال فرار از واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 219.02,
   "end": 227.2,
   "text": "یعنی شما به بهانه طاعون، به بهانه اومیکرون، به بهانه کرونا واجبت رو تعطیل کنی که شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.2,
   "end": 229.88,
   "text": "متاسفانه چه خیانتی هم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.88,
   "end": 234.02,
   "text": "به مجامع فرهنگی ما. شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.02,
   "end": 237.04,
   "text": "یا اونجایی که می‌فرماد نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.04,
   "end": 241.4,
   "text": "شما می‌تونی خارج بشی حتی از خانه خودت فرار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 241.4,
   "end": 244.2,
   "text": "وقتی که دیگه بحث واجب الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.2,
   "end": 246.54,
   "text": "چون در زمان اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 246.54,
   "end": 253.44,
   "text": "جنگ که پیش می‌آمد مخصوصا در زمان پیغمبر جنگ که پیش می‌آمد ترسوها، منافقین، ضعیف الإيمان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.44,
   "end": 257.28,
   "text": "به بهانه‌های مختلف می‌خواستن از جنگ فرار کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.28,
   "end": 260.4,
   "text": "این مال اون موقع‌ست. پیغمبر فرمود این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.4,
   "end": 263.88,
   "text": "چرا شما بهانه قرار می‌-- چرا اصلا از مرگ می‌ترسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 263.88,
   "end": 268.76,
   "text": "چرا؟ خیلی جالبه که در آیه بیست و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 268.76,
   "end": 272.82,
   "text": "سوره توبه حالا زیاده تو قرآن آیات این چنینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 272.82,
   "end": 275.16,
   "text": "خیلی شیرین خدا می‌فرماید لَقَد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.16,
   "end": 284.22,
   "text": "این روای-- این آیه رو فرمودن پیرامون جنگ حنین اما چون صریحا جنگ حنین رو اسم میاره اما پیرامون همه جنگ‌ها میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.22,
   "end": 288.8,
   "text": "اطلاق کرد. \"لَقَدْ نَصَرَكُمُ اللَّهُ فِي مَوَاطِنَ كَثِيرَةً\" تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 288.8,
   "end": 291.52,
   "text": "مواطن بسیاری خدا شما رو یاری داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.52,
   "end": 294.48,
   "text": "\"وَيَوْمَ حُنَيْنٍ\" مخصوصا يوم حنين رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.48,
   "end": 298.02,
   "text": "حالا چه خبر بوده باید تاریخ جنگ حنین رو بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.02,
   "end": 300.52,
   "text": "چرا اونجا این رو مخصوصا اسم میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.52,
   "end": 307.58,
   "text": "خود خدا فرموده \"إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنْكُمْ شَيْئًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.58,
   "end": 314.1,
   "text": "عجب! شما تعجب کردید از كثرتكم از زیادی تعداد خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.1,
   "end": 316.76,
   "text": "و از اون موقع آدم مغرور می‌شه به خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.76,
   "end": 321.68,
   "text": "پررو می‌شه، غره می‌شه. خدا می‌فرماید \"وَضَاقَتْ عَلَيْكُمُ الْأَرْضُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.68,
   "end": 326.66,
   "text": "بِمَا رَحُبَتْ ثُمَّ وَلَّيْتُمْ مُدْبِرِينَ\" فرار کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.66,
   "end": 331.34,
   "text": "زمین به شما تنگ شد با اینکه تعدادتون خیلی زیاد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.34,
   "end": 335.3,
   "text": "خدا می‌فرماید که این برای شما فایده‌ای نداشت تعداد زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.3,
   "end": 339.52,
   "text": "ظاهر اینه که آقا اسباب زیاده پس خیلی به درد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.52,
   "end": 342.22,
   "text": "درسته؟ اما هیچ به دردتون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.22,
   "end": 345.86,
   "text": "اینجا داره یک نکته اخلا-- اعتقادی رو تذکر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.86,
   "end": 350.94,
   "text": "می‌گه چرا توجه ندارید که لا مؤثر في الوجود إلا الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.94,
   "end": 355.1,
   "text": "چرا توجه ندارید که لا حول ولا قوة إلا بالله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.1,
   "end": 358.8,
   "text": "چرا توجه ندارید که صریحا تو قرآن می‌فرماید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.8,
   "end": 361.7,
   "text": "يتوفى الأنفُس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.7,
   "end": 365.26,
   "text": "خداست که موت رو یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.26,
   "end": 368.44,
   "text": "موت رو نازل می‌کنه یا می‌شه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.44,
   "end": 370.98,
   "text": "توفی می‌کنه روح میت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.98,
   "end": 373.8,
   "text": "جان رو به تمامه می‌گیره خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 373.8,
   "end": 376.56,
   "text": "تو می‌گی حضرت قابض الأرواح تشریف میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 376.56,
   "end": 378.12,
   "text": "قابض الأرواح یه وسیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.12,
   "end": 380.94,
   "text": "اینجا خدا می‌فرماید الله یتوفی الأنفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 380.94,
   "end": 387.28,
   "text": "همچی به دست به ید قدرت و به قبضه‌ی قدرت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.28,
   "end": 391.42,
   "text": "چرا شما توجه-- این داره یک تذکر اخ-- اعتقادی می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.42,
   "end": 400.56,
   "text": "که در حقیقت این توجه اعتقادی انسان رو در اخلاقیاتش، در خلق خو و عملیات بندگی‌ش موفق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.56,
   "end": 407.26,
   "text": "کسی که توجه صرفاً به خدا داره و قدرت لایذال و مطلق رو الهی می‌داند و بس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.26,
   "end": 410.86,
   "text": "از عهدی نمی‌ترسه و وظایفش رو به نحو احسن انجام می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.86,
   "end": 413.18,
   "text": "چقدر ما عنایات داشتیم در جنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.18,
   "end": 416.32,
   "text": "در همین جنگ خودمون. من هیچ‌وقت یادم نمیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.32,
   "end": 419.0,
   "text": "که هشتصد و شصت تا تانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 419.0,
   "end": 421.02,
   "text": "رخنمایی کردن. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.02,
   "end": 423.42,
   "text": "تک زده بودیم حالا اونا می‌خواستن پاتک در جبهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.42,
   "end": 425.54,
   "text": "ما شب‌ها حمله می‌کردیم اونا روزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.54,
   "end": 428.64,
   "text": "روز با هشتصد و شصت تا تانک حمله کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 428.64,
   "end": 431.06,
   "text": "که دیوار زرهی درست کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 431.06,
   "end": 435.54,
   "text": "شوخی نیست هشتصد و شصت تا تانک بغل هم بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 435.54,
   "end": 437.5,
   "text": "به صورت حالا مثلاً آرایش دشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 437.5,
   "end": 439.68,
   "text": "عزیزان اکثرتون بودید جبهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 439.68,
   "end": 444.54,
   "text": "چهره‌ها نمایانه. همه مونده بودن چه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.54,
   "end": 448.78,
   "text": "اصلاً چون شب که عملیات شد بچه‌ها زدن به خط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.78,
   "end": 452.34,
   "text": "همه نگران فرداش بودیم که اینو می‌دونستیم اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 452.34,
   "end": 457.18,
   "text": "بعد خبر داشتیم که چقدر گردان‌های زرهی بهشون ملحق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.18,
   "end": 458.9,
   "text": "می‌دونستیم فردا چه غوغایی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 458.9,
   "end": 461.9,
   "text": "همش منتظر، مترصد عنایت الهی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.9,
   "end": 463.94,
   "text": "باورتون نمی‌شه. می‌شه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.94,
   "end": 468.64,
   "text": "چرا نشه؟ فردا اصلاً هوا به هیچ عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 468.64,
   "end": 470.4,
   "text": "ابری و بارونی و این‌ها نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 470.4,
   "end": 472.36,
   "text": "پیش‌بینی هواشناسی هم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 472.36,
   "end": 477.6,
   "text": "اصلاً این حرفا نبود. دقیقاً فرداش که این هشتاد و هشتصد و شصت تا تانک اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.6,
   "end": 481.6,
   "text": "که بزنن به خط ما، بارون شدید گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 481.6,
   "end": 483.4,
   "text": "همه‌ی اینا تو گل موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.4,
   "end": 487.96,
   "text": "اونجام رمل بود وقتی بارون می‌زد دیگه اینا می‌رفتن تو گل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 487.96,
   "end": 491.26,
   "text": "مگه می‌شده که اینا رو بیرون بیاری؟ اصلاً موندن تو گل همین‌طوری موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 491.26,
   "end": 494.54,
   "text": "نمی‌تونستن متحرک-- تحرکی داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 494.54,
   "end": 498.06,
   "text": "آره این جز عنایت الهیه که بچه‌ها-- چقدر ما تو جنگ اینو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 498.06,
   "end": 501.56,
   "text": "تو جنگ سی‌ و سه روزه‌ی لبنان یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 501.56,
   "end": 510.5,
   "text": "عرض شود مبارزین مقاومت با صهیونیست‌ها چقدر عنایت الان ثبت شده و می‌گن متأسفانه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.5,
   "end": 515.86,
   "text": "حالا بعضی موقع‌ها داستان‌هامون برای بچه‌هامون می‌خوایم بچه‌مون رو بخوابونیم اینا رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 515.86,
   "end": 518.28,
   "text": "یکی از بچه‌های مقاومت می‌گفت ما رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 518.28,
   "end": 522.06,
   "text": "تو-- حالا تو همون جنگ سی‌ و سه روزه‌ی لبنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 522.06,
   "end": 524.78,
   "text": "خیلی جنگ سخت شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 524.78,
   "end": 528.28,
   "text": "بعد صهیونیست‌ها می‌اومدن بمبارون می‌کردن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 528.28,
   "end": 531.24,
   "text": "منطقه کوهستانی بود. ما به شدت تشنه بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.24,
   "end": 534.8,
   "text": "ما پنج نفر بودیم. شدیداً عطش داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.8,
   "end": 539.02,
   "text": "دیدیم که هیچ چاره‌ای نداریم تا خودمون برسونیم به مقرمون فاصله زیاد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 539.02,
   "end": 541.6,
   "text": "می‌دونستیم که اگر بدون آب بریم نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 541.6,
   "end": 545.86,
   "text": "تو راه تلف می‌شیم. همونطور که می‌رفتیم دیدیم یه غاری توی کوهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 545.86,
   "end": 550.92,
   "text": "رفتیم تو اون غار دیدیم یه پیرزنی با خونواده کوچیکش اونجا پناه بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 550.92,
   "end": 555.22,
   "text": "حالا بنت جبیل بود چی بود که بمبارون کرده بودن و فرار کرده بودن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 555.22,
   "end": 557.58,
   "text": "ما گفتیم تشنه‌مونیم. اینا هم پیرزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 557.58,
   "end": 560.36,
   "text": "یه نگاه به ما کرد. دیدیم هی پشت سر ما رو نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.36,
   "end": 564.26,
   "text": "ما برگشتیم دیدیم پشت سرمون چیزی نیست که خودمونیم پنج نفریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 564.26,
   "end": 567.36,
   "text": "رفت دیدیم کلی ظرف آب آورد گذاشت جلومون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 567.36,
   "end": 570.74,
   "text": "بعد عذرخواهی کرد گفت ببخشید همین مقدارو داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.74,
   "end": 573.22,
   "text": "به بقیه‌تون شاید نرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 573.22,
   "end": 575.88,
   "text": "ما هم تعجب کردیم گفتیم یه دونه از اینا برای ما بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 575.88,
   "end": 578.32,
   "text": "ما پنج نفریم. چی می‌گه این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 578.32,
   "end": 579.9,
   "text": "خوردیم و گفتیم تشکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 579.9,
   "end": 582.24,
   "text": "اینا گفت منو ببخشید که به بقیه‌تون نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 582.24,
   "end": 586.14,
   "text": "گفتم چی می‌گی به بقیه‌تون؟ گفت این سربازهایی که پشت سر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 586.14,
   "end": 589.64,
   "text": "هستن. اونجا یه دفعه ما تعجب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 589.64,
   "end": 595.72,
   "text": "گفتم ما به گریه افتادیم. فهمیدیم که این پیرزن پشت سر ما چقدر سرباز دیده هم شکل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 595.72,
   "end": 597.78,
   "text": "این عنایت الهی جز این نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 597.78,
   "end": 600.6,
   "text": "حالا در جنگ احد، بدر اینا چقدر-- اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 600.6,
   "end": 605.98,
   "text": "صریح آیات الهیه که تنزل ملائکه رخ داده و یاری‌تون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 605.98,
   "end": 610.26,
   "text": "اون سیصد و سیزده سرها، سیصد و سیزده یارای امام حسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 610.26,
   "end": 617.52,
   "text": "سیصد و سیزده ملکی‌اند که در جنگ بدر اولین جنگ اسلام نازل شدن و کمک کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 617.52,
   "end": 621.68,
   "text": "اصلاً انقلاب ما جز به معجزه الهی چیز دیگه‌ای بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.68,
   "end": 624.82,
   "text": "آیا حضرت امام علیه الرحمه نفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 624.82,
   "end": 627.56,
   "text": "این انقلاب انفجار نور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 627.56,
   "end": 629.22,
   "text": "معجزه الهی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 629.22,
   "end": 632.24,
   "text": "کار ما نبود. خرمشهر رو خدا آزا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 632.24,
   "end": 637.82,
   "text": "آزاد کرد و و و. هر وقت که پررو بشیم ببخشید مغرور بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 637.82,
   "end": 640.66,
   "text": "غره بشیم اینا سریع راه بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 640.66,
   "end": 645.72,
   "text": "این روایت داره این رو تذکر می‌ده که حواستون باشه قدرت دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 645.72,
   "end": 652.1,
   "text": "همه چی دست خداست. حالا این بحث رو دو سه جلسه چون خیلی به درد بخوره بحث اعتقادی‌ایه رو همین چند تا روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 652.1,
   "end": 654.88,
   "text": "توقف می‌کنیم که بهره بیشتری ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 654.88,
   "end": 657.82,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 657.82,
   "end": 659.96,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 659.96,
   "end": 670.72,
   "text": "الله- اللهumma صلي علي محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}