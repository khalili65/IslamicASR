 "chapters": [
  {
   "index": 0,
   "title": "## آگاه‌سازی دربارهٔ انتخابات و ملاک حال فعلی",
   "start": 28.64,
   "end": 112.36
  },
  {
   "index": 1,
   "title": "## مرحلهٔ پنجم موت و مرگ مفاجات",
   "start": 112.36,
   "end": 144.22
  },
  {
   "index": 2,
   "title": "## نزع روح سخت و آیهٔ محمد",
   "start": 144.22,
   "end": 415.39
  },
  {
   "index": 3,
   "title": "برای نیکان آیهٔ سی و دوم نحل است:",
   "start": 415.39,
   "end": 662.51
  },
  {
   "index": 4,
   "title": "## نظر شهید مطهری دربارهٔ قدرت عبودیت",
   "start": 662.51,
   "end": 779.42
  },
  {
   "index": 5,
   "title": "## تحمل حقیقت موت",
   "start": 779.42,
   "end": 929.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 13.48,
   "end": 15.66,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.66,
   "end": 20.88,
   "text": "و بهین استعین. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 20.88,
   "end": 23.8,
   "text": "یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 23.8,
   "end": 28.64,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.64,
   "end": 34.48,
   "text": "در خصوص آگاه‌سازی مردم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.48,
   "end": 38.78,
   "text": "انتخابات، هر کسی که اطلاعات دقیقی دارد نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.78,
   "end": 41.42,
   "text": "از روی حب و بغض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.42,
   "end": 43.6,
   "text": "اطلاعات دقیقی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.6,
   "end": 48.42,
   "text": "حال فعلی افراد دارد، مخصوصاً این رو دقت بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.42,
   "end": 52.34,
   "text": "وظیفشه که انتقال بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.34,
   "end": 55.02,
   "text": "مخصوصاً اگر کسی بیاد سؤال کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.02,
   "end": 57.98,
   "text": "الان به بنده خیلیا میان سؤال می‌کنن حاج آقا نظر شما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.98,
   "end": 65.32,
   "text": "وظیفه بنده است بگم. حالا اگر اینجا یه نفر خطا و ربطی داشته که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.32,
   "end": 69.24,
   "text": "موازین رو رد کرده، خطایی ازش سر زده فعلاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.24,
   "end": 74.94,
   "text": "فعلاً اینجا یعنی حال فعلیش قبلاً هرچی بود تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.94,
   "end": 77.26,
   "text": "به قول حضرت امام فرمایششون چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.26,
   "end": 80.7,
   "text": "ملاک حال فعلی افراده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.7,
   "end": 87.46,
   "text": "اگر کسی اومد از من سؤال کرد وظیفمه بگم این دیگه غیبت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.46,
   "end": 91.24,
   "text": "و باز دارم تأکید می‌کنم حال فعلی افراد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.24,
   "end": 92.92,
   "text": "که الان این آقا چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.92,
   "end": 97.48,
   "text": "حالا قبلاً هر سابقه ای چه بد داشته چه خوب داشته کاری به قبلش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.48,
   "end": 100.42,
   "text": "الان چی کار است؟ وضعیتش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.42,
   "end": 107.78,
   "text": "اگر کسی اطلاعات دقیقی دارد وظیفشه که به جهت تثبیت نظام اسلامی این رو انتقال بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.78,
   "end": 118.26,
   "text": "وظیفه همه ماست. بحث موت بود و رسیدیم به مرحله پنجم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.26,
   "end": 120.54,
   "text": "همه ما قراره این مراحل رو درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.54,
   "end": 124.1,
   "text": "ان شا الله که خدا به همتون طول عمر با برکت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.1,
   "end": 127.58,
   "text": "و ان شا الله در بهترین حالات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.58,
   "end": 131.96,
   "text": "بهترین وضعیت‌ها و در شهادت این حالات رو ما درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.96,
   "end": 138.36,
   "text": "ولی همه حتی یکی سؤال کرد کسی که مرگ مفاجات داره یه دفعه یه ناگهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.36,
   "end": 142.5,
   "text": "مرگ براش پیش میاد. اینا عزیزمون بودند جلسه پیش سؤال کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.5,
   "end": 145.56,
   "text": "این حالات این مراحل هست؟ بله برای همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.56,
   "end": 150.74,
   "text": "حتی مرگ مفاجات. برای من و شما اون یک آن طی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.74,
   "end": 157.82,
   "text": "اما پشت پرده روایت داریم بعضیا هفتصد سال جون کندن‌شون طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.82,
   "end": 161.22,
   "text": "من و شما می‌گیم تموم شد. هفتصد سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.22,
   "end": 167.16,
   "text": "برای اینکه من و شما بگیم عجب این همه یعنی یک عددی‌ست که یعنی انقدر طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.16,
   "end": 170.66,
   "text": "منظور طوله. مثل مثالی که من خدمت عزیزانمون زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.66,
   "end": 174.72,
   "text": "یه وقت خواب می‌بینی چون ان نوم اخ ال موت خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.72,
   "end": 177.16,
   "text": "خیلی وحشتناکی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.16,
   "end": 182.06,
   "text": "خیلی داری اذیت می‌شی در صورتی که می‌بینی یه آنی خوابیدی، پنج دقیقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.06,
   "end": 186.62,
   "text": "یک ساعت. بعد یه دفعه از خواب می‌پری میگی خدا خیرت بده بیدارم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.62,
   "end": 190.7,
   "text": "یک ساعته. من فکر کردم ده ساعته دارم جون می‌کَنم تو خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 190.7,
   "end": 192.66,
   "text": "یا بالعکسش یه دفعه می‌بینی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.66,
   "end": 201.54,
   "text": "مثلا یک سال عمرت انقدر برات خوشی بوده میگی این اصلاً مثل برق گذشت، انقدر که خوب گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 201.54,
   "end": 207.72,
   "text": "این چنینه. مرحله پنجم که دیگه یه مرحله مونده تا مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 207.72,
   "end": 212.12,
   "text": "نهایی، مرحله‌ای است که روح به دهان رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.12,
   "end": 215.78,
   "text": "و می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.78,
   "end": 217.72,
   "text": "البته قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.72,
   "end": 225.06,
   "text": "ورود کرده. در این مرحله قابض الارواح کاملاً متمثل می‌شه و فرود میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.06,
   "end": 228.06,
   "text": "نازل می‌شه بر میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.06,
   "end": 235.22,
   "text": "که لحظات احتضارشه و به اتفاق صده و خدمه‌اش که صدنه و خدمه که اونایی که کمک حالشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 235.22,
   "end": 237.84,
   "text": "بعد هنوز نوچه هاش دست به کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.84,
   "end": 241.18,
   "text": "خود قابض الارواح دست به کار نشده حتی تو این قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 241.18,
   "end": 244.8,
   "text": "اون قسمت شیشم قابض الارواح خودش دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.8,
   "end": 248.12,
   "text": "دست به کار می‌شه. اینجا نوچه هاش هستن اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.12,
   "end": 250.06,
   "text": "که روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.06,
   "end": 254.9,
   "text": "می‌خواد از دهان کشیده بشه بیرون برسه به بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.9,
   "end": 258.52,
   "text": "این مرحله خیلی فوق‌العاده سختیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.52,
   "end": 261.62,
   "text": "که دیگه تو این مرحله زبان هم لال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.62,
   "end": 264.04,
   "text": "دیگه زبان از کار می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.04,
   "end": 266.68,
   "text": "و اونجا میگن مرحله‌ای است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.68,
   "end": 270.78,
   "text": "عینا جلسه پیش هم گفتیم تو مرحله چهارم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.78,
   "end": 276.84,
   "text": "تجسم اعمال رخ می‌ده اما اینجا دیگه اصلاً طرف می‌فهمه چی کار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.84,
   "end": 279.32,
   "text": "قشنگ متوجه می‌شه از نوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.32,
   "end": 282.12,
   "text": "ملائکه‌ای که براش نازل می‌شن می‌تونه تشخیص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.12,
   "end": 285.6,
   "text": "یا ملائکه غلاظن و شدادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.6,
   "end": 290.46,
   "text": "یا ملائکه رحمت و روح و ریحان الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.46,
   "end": 294.58,
   "text": "یا بشارت آوردن به den یا انذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.58,
   "end": 298.76,
   "text": "که برای اونهایی که سخت جون میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.76,
   "end": 302.82,
   "text": "پیغمبر از عالم این لحظه رو گفتن نزوع ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.82,
   "end": 307.14,
   "text": "نزع الروح، نزع الروح، کندن روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.14,
   "end": 310.18,
   "text": "جان کندن. بغلزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.18,
   "end": 313.22,
   "text": "الله اکبر. خیلی غلیظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.22,
   "end": 315.58,
   "text": "سخت می‌گیرن بر او و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.58,
   "end": 322.08,
   "text": "در روایت نبوی اینجا که پیغمبر اینجا فر-- اینطوری اسم گذاشتن فرمودن که کفنی، عجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.08,
   "end": 325.4,
   "text": "کفنی از آتش میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.4,
   "end": 327.5,
   "text": "و می‌پوشونن بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.5,
   "end": 329.9,
   "text": "تمام بدن این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.9,
   "end": 333.1,
   "text": "یعنی در حال که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.1,
   "end": 337.48,
   "text": "بند بند وجودش داره می‌سوزه و آتش گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.48,
   "end": 341.0,
   "text": "نزع روح صورت می‌گیره. خیلی لحظه سختیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.0,
   "end": 347.34,
   "text": "که در سوره حضرت محمد صلى الله عليه و آله وسلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.34,
   "end": 356.54,
   "text": "آیه بیست و هفت اشاره به همین وضعیت داره که \"فكيف اذا توفتهم الملائکه\" چگونه است حال این شخص وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.54,
   "end": 362.76,
   "text": "این‌ها رو ملائکه توفی می‌کنند جانشون رو چگونه \"يَغْرِبُونَ وُجُوهَهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.76,
   "end": 366.77,
   "text": "وَأَدْبَارَهُمْ\" سبحان الله پناه بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.77,
   "end": 369.05,
   "text": "می‌زنن ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.05,
   "end": 372.81,
   "text": "وجوههم تو صورتشون و به پشتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.81,
   "end": 376.21,
   "text": "یعنی نهایت خواری و ذلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.21,
   "end": 381.63,
   "text": "چطور اینجا به زیردستش می‌زد پس کلش \"برو حرف نزن، برو فلان، برو حقوقتو قطع کردم، برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.63,
   "end": 385.23,
   "text": "اخراجت کردم، برو معرفیت کردم به امور اداری.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.23,
   "end": 387.03,
   "text": "حالیشم نبود داره چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.03,
   "end": 390.51,
   "text": "اونجا هم آره هرچی کردی چنان سرت بیارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.51,
   "end": 393.39,
   "text": "خفت و خواری که بین اون دادیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.39,
   "end": 397.93,
   "text": "حالا ما یه مصداقشو گفتیم. خیلی جاها دیگه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.93,
   "end": 400.01,
   "text": "اما برای خوبا انشاالله برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.01,
   "end": 402.23,
   "text": "این باشه این، این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.23,
   "end": 407.97,
   "text": "آیه سی و دو نحل. \"الذین تتوفاهم الملائکه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.97,
   "end": 410.95,
   "text": "یه عده دیگه‌ای هم هستن که ملائکه اینا رو جونشونو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.95,
   "end": 413.41,
   "text": "\"طيبین\". به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.41,
   "end": 415.39,
   "text": "اینا پاک، پاکیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.39,
   "end": 417.37,
   "text": "الطیبات للطيبين دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.37,
   "end": 420.29,
   "text": "الطيبين للطيبات. الخبيثات للخبيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.29,
   "end": 426.21,
   "text": "الخبيثين للخبيثات. کبوتر با کبوتر، باز با باز، کند هم جنس با هم جنس پرواز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.21,
   "end": 431.25,
   "text": "هر جنسی از خودت ساختی قربونت برم همون جنس ملک میاد سراغت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.25,
   "end": 433.33,
   "text": "جهنمی، ملک جهنمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.33,
   "end": 435.81,
   "text": "بهشتی انشاالله ملک بهشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.81,
   "end": 440.63,
   "text": "اینا میان در حالی که هم اونا پاکن هم این شخص پاک پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.63,
   "end": 444.95,
   "text": "سردار سلیمانی روحش شاد نوشته بود دیگه آخرین دست نوشتش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.95,
   "end": 448.31,
   "text": "فرودگاه می‌خواست سوار هواپیما شه چی نوشته بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.31,
   "end": 451.13,
   "text": "نوشته بود خدایا مرا پاکیزه بپذیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.13,
   "end": 453.93,
   "text": "خیلی سر قشنگی رو برملا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.93,
   "end": 457.03,
   "text": "اصلا اینو باید بخونیم. طيبين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.03,
   "end": 459.07,
   "text": "اینو که چون پاکن اینا اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.07,
   "end": 462.51,
   "text": "بعد چی میگن؟ \"يقولون سلام عليكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.51,
   "end": 469.03,
   "text": "به به به. ملائکه بیان سلام خدا بدن به آدمی که داره جون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.03,
   "end": 471.17,
   "text": "ببرنش به دارالسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.17,
   "end": 478.01,
   "text": "چه لحظه قشنگیه. ولی خب اون لحظه، حالا چه خوبش چه بدش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.01,
   "end": 484.79,
   "text": "آنی که می‌خواد، آنی که می‌خواد از دهان روحو بکشونه به بینی خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.79,
   "end": 488.51,
   "text": "ما می‌گیم رد می‌شه حتی برای خوبان ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.51,
   "end": 491.43,
   "text": "سخته. حالا سختی‌هاشو زیاد گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.43,
   "end": 495.79,
   "text": "روایات زیاد داریم چون ما بنا بر اجمال گویی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.79,
   "end": 498.85,
   "text": "رد می‌شن فقط اشاره می‌کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.85,
   "end": 503.07,
   "text": "دو سه تا فرمایش از بزرگان در خصوص این خلع روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.07,
   "end": 507.51,
   "text": "که این خلع روح ببینید برای کسی که حالا ما گفتیم سختی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.51,
   "end": 511.13,
   "text": "آسانی اینا. برای کسی که عادت داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.13,
   "end": 514.59,
   "text": "عادت کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.59,
   "end": 517.39,
   "text": "خلع روح کنه از بدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 517.39,
   "end": 519.27,
   "text": "خیلی راحت این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 519.27,
   "end": 523.09,
   "text": "اصلا میگه ملائکه با خودتون زحمت ندید من خودم این کارو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.09,
   "end": 526.63,
   "text": "فقط اون لحظه آخر که از بینی می‌خواد مرحله ششم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.63,
   "end": 528.79,
   "text": "دیگه روح قفل شه، اونجا دیگه کار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.79,
   "end": 530.37,
   "text": "کار دست کسی دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.37,
   "end": 532.99,
   "text": "قابض الارواح میاد به اذن الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.99,
   "end": 535.87,
   "text": "کسی که دیگه خلع روح می‌کنه از خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.87,
   "end": 538.49,
   "text": "\"موتو قبلا انت موت\" رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.49,
   "end": 540.29,
   "text": "به اصطلاح هم بهش میگن حکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 540.29,
   "end": 544.65,
   "text": "اصلاً میگه آقا ملائکه با خودتون زحمت ندید خودم با شوق و ذوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.65,
   "end": 547.53,
   "text": "روح رو از بدنش خارج می‌کنه می‌کشونه تا بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.53,
   "end": 550.75,
   "text": "این‌ها هست. من الآن حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 550.75,
   "end": 557.35,
   "text": "نظر سخت‌ترین آدم‌ها رو نسبت به این بحث معارفی که شهید مطهری باشه رو براتون میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.35,
   "end": 560.37,
   "text": "که معمولا یه سری چیزا رو ایشون رد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.37,
   "end": 564.95,
   "text": "ببینید. حالا البته در خصوص خلع روح از بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.95,
   "end": 569.75,
   "text": "به عنوان نمونه شیخ اشراق شهاب‌الدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.75,
   "end": 573.01,
   "text": "سهروردی می‌فرمود ما حکیم را حکیم نمی‌شماریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 573.01,
   "end": 576.43,
   "text": "حکیم کی بود؟ \"يعلمههم الكتاب والحکمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 576.43,
   "end": 578.89,
   "text": "کسی که به باطن اشیا پی برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.89,
   "end": 587.55,
   "text": "میگه ما حکیم را حکیم نمی‌شماریم مگر آن وقتی که قدرت داشته باشد بر اینکه روح خودش را از بدنش خلع کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.55,
   "end": 591.11,
   "text": "یعنی حکیم اصلاً ملائکه تماشاچیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.11,
   "end": 595.07,
   "text": "خوش آمدگوشن. خودش خلع روح می‌کنه از بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.07,
   "end": 597.59,
   "text": "مثل آقای بروجردی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.59,
   "end": 602.79,
   "text": "کی بود از این بزرگان الان از خاطرم اسمشون رفت که می‌خواستن عمل جراحی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.79,
   "end": 605.89,
   "text": "گفت شما کار خودتونو بکنین خواستید فقط بگید به من اشاره کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.89,
   "end": 608.71,
   "text": "اشاره کردن ایشون شروع کرد سوره یاسین رو خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.71,
   "end": 611.69,
   "text": "قلب و سینه رو شکافتن باز کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.69,
   "end": 614.57,
   "text": "بستن. یه آه نگفت. اصلا متوجه نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.57,
   "end": 618.93,
   "text": "فکر کرد آقا تموم شد. \"بيده ملكوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.93,
   "end": 622.69,
   "text": "کل شيء واليه ترجعون\" آیه آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.69,
   "end": 628.55,
   "text": "سوره یاسین رو خوند. \"سبحان الذي بيده ملكوت کل شيء واليه ترجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.55,
   "end": 631.17,
   "text": "خب این چه اتفاقی میفته اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 631.17,
   "end": 634.55,
   "text": "این روح رو از بدن می‌کشونه میاره تا زیر گلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.55,
   "end": 637.41,
   "text": "راحت سینه رو بشکافن. هیچ حسی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.41,
   "end": 641.33,
   "text": "این یکی از rumuzشه. هستن می‌کنن این کارا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.33,
   "end": 647.61,
   "text": "یا مثلا از میرداماد نظر هست که فرمود ما حکیم را حکیم نمی‌شماریم مگر در آن مرحله‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 647.61,
   "end": 651.31,
   "text": "خلع بدن برایش ملکه شده باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 651.31,
   "end": 656.05,
   "text": "یعنی هر وقت که اراده کند بتواند روح خودش را از بدنش منتقل و جدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 656.05,
   "end": 658.57,
   "text": "اصلا منتقل می‌کنه نه اینکه فقط جدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 658.57,
   "end": 661.99,
   "text": "می‌ره جاهای دیگه که حالا قبلا مثال‌هایی براتون زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.99,
   "end": 666.23,
   "text": "بریم سراغ مجموعه آثار جلد بیست و سه، صفحه چهارصد و نود و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 666.23,
   "end": 671.33,
   "text": "ببینیم نظر شهید مطهری، یکی از علمایی که خیلی سخت می‌گیره تو این مسائل عرفانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.33,
   "end": 675.25,
   "text": "ایشون نظرشون چیه؟ رد می‌کنن، تایید می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 675.25,
   "end": 677.69,
   "text": "عین مطلب ایشون رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.69,
   "end": 680.81,
   "text": "\"این مرکب عبودیت از این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 680.81,
   "end": 684.43,
   "text": "از این هم بیشتر انسان را به خدا نزدیک می‌کند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.43,
   "end": 687.57,
   "text": "یعنی میگه عبودیت مرکب معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 687.57,
   "end": 689.59,
   "text": "از این هم بیشتر آدمو رشد می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 689.59,
   "end": 694.31,
   "text": "\"و از این بیشتر هم به انسان قدرت و توانایی می‌دهد.\" چند نقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 694.31,
   "end": 699.39,
   "text": "از اینجاشو منظورمه. \"نه تنها رابطه‌ی انسان با بدن خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 699.39,
   "end": 701.45,
   "text": "به اینجا منتهی می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 701.45,
   "end": 704.17,
   "text": "که روح از بدن منتقل شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 704.17,
   "end": 709.83,
   "text": "و نیاز خودش را از بدن سلب کند، می‌رسد به مرحله‌ای که\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 709.83,
   "end": 712.13,
   "text": "یعنی نه فقط روحو خلع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 712.13,
   "end": 717.19,
   "text": "\"می‌رسد به مرحله‌ای که هر تصرفی که بخواهد در بدن خودش می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 717.19,
   "end": 725.89,
   "text": "حتی این قدرت را پیدا می‌کند که جلوی حرکت قلب خودش را یک ساعت بگیرد و نمیرد.\" این نظر شهید مطهریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 725.89,
   "end": 731.09,
   "text": "ما این حرفو می‌زنیم یه مو، یه مشت آدما که یه مقدار فیلسوف مذهبند و مکتب‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.09,
   "end": 733.39,
   "text": "مثلا شهید مطهری فیلسوف بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 733.39,
   "end": 736.63,
   "text": "می‌گن نه آقا اینا آقا عرفا گفتن فلاسفه رد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 736.63,
   "end": 740.62,
   "text": "بفرمایید. قدرت پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 740.62,
   "end": 747.42,
   "text": "ادامه فرمایش شهیده. دو ساعت نفس نکشد و نمیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 747.42,
   "end": 751.7,
   "text": "قدرت پیدا می‌کند که با همین بدن طی الارض کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 751.7,
   "end": 756.38,
   "text": "همینطوری مثال میاره و می‌فرماید این اثر عبادت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 756.38,
   "end": 760.54,
   "text": "بالاتر از این هم داریم بالاتر از این وضعیت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 760.54,
   "end": 763.24,
   "text": "شهید مطهری باز ادامه می‌ده الحمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 763.24,
   "end": 766.84,
   "text": "همین بحث رو ادامه میده و می‌فرماید مرحله بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.84,
   "end": 771.9,
   "text": "آن قدرتی است که بنده‌ای در اثر بندگی و عبودیت، این خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 771.9,
   "end": 774.8,
   "text": "که العبودیه جوهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 774.8,
   "end": 777.1,
   "text": "کن ههر ربوبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 777.1,
   "end": 780.02,
   "text": "می‌خواد اینو توضیح بده. روایت شریف چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 780.02,
   "end": 782.42,
   "text": "درون مایه داره این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 782.42,
   "end": 787.62,
   "text": "که عبودیت یه جوهره‌ای است که کنهش باطنش ربوبیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 787.62,
   "end": 790.34,
   "text": "یعنی کسی بتونه به باطن عبودیت برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 790.34,
   "end": 792.74,
   "text": "کار ربانی می‌کنه. کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 792.74,
   "end": 794.8,
   "text": "رب انجام میده. خودش هم می‌شه رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 794.8,
   "end": 798.08,
   "text": "مربی می‌شه دیگران مرباش می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 798.08,
   "end": 802.16,
   "text": "پرورش میده نفوس رو من جمله نفس خودش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 802.16,
   "end": 804.34,
   "text": "از طریق عبودیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 804.34,
   "end": 806.7,
   "text": "این جمله شهید مطهری هم براتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 806.7,
   "end": 808.6,
   "text": "ادامش مر-- تا کجا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 808.6,
   "end": 816.68,
   "text": "مرحله بالاتر آن قدرتی‌ست که بنده‌ای در اثر بندگی و عبودیت خداوند و در اثر قرب به ذات اقدس الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 816.68,
   "end": 821.14,
   "text": "و در اثر نزدیک شدن به کانون لایتناهی هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 821.14,
   "end": 827.06,
   "text": "می‌تواند در دنیای بیرون از خودش هم تصرف کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 827.06,
   "end": 829.9,
   "text": "نه تصرف در بدن خودش، قلبش رو واسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 829.9,
   "end": 831.44,
   "text": "مثلا نفسش رو نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.44,
   "end": 833.68,
   "text": "اینا نه، بیرون از بدنش تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.68,
   "end": 835.8,
   "text": "همون بحثی که قبلا در ماده کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 835.8,
   "end": 838.24,
   "text": "علامه حسن زاده داشت در یکی از کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 838.24,
   "end": 841.6,
   "text": "صد کلم در معرفت نفس. بعد مثال میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 841.6,
   "end": 844.6,
   "text": "می‌تواند چوبی را تبدیل به اژدها کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 844.6,
   "end": 847.26,
   "text": "می‌تواند قرص ماه را دو نیم کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 847.26,
   "end": 853.06,
   "text": "می‌تواند تخت بلقیس را در یک چشم به هم زدن از یمن به فلسطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 853.06,
   "end": 856.62,
   "text": "احضار کند. بله می‌تواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 856.62,
   "end": 859.4,
   "text": "تاکید می‌کنه شهید مطهری بعد مثال‌های دیگری هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 859.4,
   "end": 865.4,
   "text": "بعد می‌گه بله می‌تواند. بعد اشاره به این روایت می‌کنه که العبودیه جوهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 865.4,
   "end": 868.26,
   "text": "کن ههر ربوبیه. به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 868.26,
   "end": 872.24,
   "text": "چقدر شیرینه این روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 872.24,
   "end": 875.58,
   "text": "واقعا آدم دوست داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 875.58,
   "end": 880.24,
   "text": "ساعت‌ها بشینه این‌ها رو باز کنه، گفت‌وگو کنه، صحبت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 880.24,
   "end": 885.02,
   "text": "و چقدر بده، چقدر سخته تحمل این وضع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 885.02,
   "end": 888.96,
   "text": "که وقتی این حرف‌های حقیقی رو عینی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 888.96,
   "end": 893.0,
   "text": "که در جهان خارج، خارج از ما داره پیاده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 893.0,
   "end": 897.94,
   "text": "بزنیم، یه سری آدم‌های نمازخون خوب مذهبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 897.94,
   "end": 901.76,
   "text": "حتی شاید انقلابی بیان اعتراض کنن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 901.76,
   "end": 907.42,
   "text": "به اندازه کافی مشکلات داریم دیگه شما دیگه بحث موت رو باز نکن ولمون کن تو رو قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 907.42,
   "end": 911.02,
   "text": "دیگه خیلی این دردو کجا باید بذاریم نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 911.02,
   "end": 915.1,
   "text": "حقیقتی که پیش روی ماست و قراره این مرحا- مراحل رو طی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 915.1,
   "end": 917.94,
   "text": "حالا انشاالله جلسه بعد مرحله ششم را هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 917.94,
   "end": 923.28,
   "text": "عرض کنیم. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 923.28,
   "end": 929.28,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}