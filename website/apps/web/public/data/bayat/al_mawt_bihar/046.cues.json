 "chapters": [
  {
   "index": 0,
   "title": "## روایت هشتم؛ حسنهٔ ناتوانی پیری",
   "start": 20.3,
   "end": 106.72
  },
  {
   "index": 1,
   "title": "## همّ به حسنه و سیئه",
   "start": 106.72,
   "end": 130.6
  },
  {
   "index": 2,
   "title": "## مهلت هفت‌ساعته پس از عمل سیئه",
   "start": 130.6,
   "end": 243.78
  },
  {
   "index": 3,
   "title": "## حقیقت نظام هستی نه اعتبار محض",
   "start": 243.78,
   "end": 383.24
  },
  {
   "index": 4,
   "title": "## فطرت الهیت؛ اساس طهارت",
   "start": 383.24,
   "end": 526.2
  },
  {
   "index": 5,
   "title": "## فطرت اولیه و فطرت ثانویه؛ جبلی",
   "start": 526.2,
   "end": 740.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.74,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 7.36,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.36,
   "end": 11.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.06,
   "end": 14.4,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.4,
   "end": 20.3,
   "text": "و ربانی ایات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.3,
   "end": 22.52,
   "text": "در روایت هشتم بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.52,
   "end": 26.84,
   "text": "و سوالی رو مطرح کردیم در این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.84,
   "end": 30.04,
   "text": "از کتاب الموت همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.04,
   "end": 35.72,
   "text": "یادتون هست می‌فرمود که وقتی انسان پیر می‌شه اونچه که در جوانیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.72,
   "end": 43.3,
   "text": "با انبساط خاطر و شوق و رغبت انجام می‌داده و حالا به جهت ضعف و پیریش نمی‌تونه انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.3,
   "end": 47.4,
   "text": "براش نوشته می‌شه. خدا مرحمت می‌کنه، لطف می‌کنه براش می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.4,
   "end": 51.12,
   "text": "سؤال کردیم که آیا در بدی‌ها هم اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.12,
   "end": 54.06,
   "text": "یعنی کسی که سنش به پیری رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.06,
   "end": 58.82,
   "text": "از پا افتاده، دیگه جون نداره بره گناه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.82,
   "end": 65.26,
   "text": "آیا اون گناهانی که جوانیش می‌کردو خدا براش می‌نویسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.26,
   "end": 68.3,
   "text": "جواب به صورت کلی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.3,
   "end": 72.58,
   "text": "اینطوریه که خدا چون \"یا من سبقت رحمته غضبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.58,
   "end": 76.64,
   "text": "خدای منان رحمتش سبقت گرفته بر غضبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.64,
   "end": 81.28,
   "text": "این از لطف و امتناع الهیه که این کارو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.28,
   "end": 86.06,
   "text": "یعنی تا می‌تونه آسون گرفته به بندگانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.06,
   "end": 88.4,
   "text": "اما یه چیزی رو باید دقت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.4,
   "end": 93.12,
   "text": "اونم اجازه بدید یه روایتی براتون بخونم که این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.12,
   "end": 95.56,
   "text": "دیگه فصل الخطابه در همین باب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.56,
   "end": 100.24,
   "text": "از توحید شیخ صدوق بارها این کتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.24,
   "end": 104.74,
   "text": "تعظیم کردیم. گفتیم این کتاب رو بخونیم، کتاب بالینی‌مون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.74,
   "end": 106.72,
   "text": "جلد یک صفحه چهارصد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.72,
   "end": 111.12,
   "text": "امام صادق صلوات الله علیه فرمود \"من هم بحسنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.12,
   "end": 115.2,
   "text": "فلم يعملها كتبت له حسنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.2,
   "end": 120.26,
   "text": "اگر کسی همت کنه، نیت کنه یه کار خیری انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.26,
   "end": 122.86,
   "text": "اما انجامش نده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.86,
   "end": 125.22,
   "text": "خدا یه حسنه براش می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.22,
   "end": 127.18,
   "text": "عجب! با اینکه عمل نکرده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.18,
   "end": 134.64,
   "text": "\"فإن عملها\" اگر عمل کرد به نیتش \"كتبت له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.64,
   "end": 141.56,
   "text": "عشر أمثالها\". خدا ده برابر مثل اون رو براش می‌نویسه اگر عمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.56,
   "end": 143.1,
   "text": "تموم شد؟ نخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.1,
   "end": 146.42,
   "text": "\"ويضاعف الله لمن شاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.42,
   "end": 150.86,
   "text": "بلکه خدا به هرکی که عشقش بکشه و بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.86,
   "end": 153.26,
   "text": "\"يضاعفه\" زیادش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.26,
   "end": 158.36,
   "text": "تا کجا؟ \"إلى سبعمئة\" تا هفتصد برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.36,
   "end": 162.82,
   "text": "مثل خوشه گندم که هی از یه گندم هی می‌رویه، می‌رویه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.82,
   "end": 166.88,
   "text": "اون همه از یه دانه گندم اون همه میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.88,
   "end": 172.26,
   "text": "برای یک کار حسنه ای که یه کسی انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.26,
   "end": 175.14,
   "text": "\"ومن هم بسيئة\" حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.14,
   "end": 179.08,
   "text": "سیئه ای رو همت کرد، نیت کرد انجام بده اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.08,
   "end": 181.02,
   "text": "انجام نداد. چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.02,
   "end": 183.92,
   "text": "\"لم تكتب عليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.92,
   "end": 187.86,
   "text": "براش نوشته نمی‌شه \"حتى يعملها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.86,
   "end": 193.36,
   "text": "تا عملش نکنه. بخشید \"هم\" به نیت عمل کرد اما انجام نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.36,
   "end": 196.42,
   "text": "\"فلم يعملها لم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.42,
   "end": 199.52,
   "text": "تكتب عليه حتى يعملها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.52,
   "end": 205.04,
   "text": "فإن لم يعملها كتبت له حسنة بتركه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.04,
   "end": 207.06,
   "text": "لفعلها\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.06,
   "end": 210.82,
   "text": "می‌گه اگه، خیلی جالبه، نوشته نمی‌شه که هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.82,
   "end": 213.3,
   "text": "یعنی نیت کرد کار شر بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.3,
   "end": 215.36,
   "text": "نوشته نمی‌شه که هیچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.36,
   "end": 221.24,
   "text": "به جهت اینکه این کار شر رو انجام نداد براش حسنه می‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.24,
   "end": 223.64,
   "text": "الله اکبر. متوجه شدی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.64,
   "end": 226.8,
   "text": "می‌گه آقا نیت کار شر کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.8,
   "end": 229.88,
   "text": "نکردی، فقط نیت کردی، هم کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.88,
   "end": 231.9,
   "text": "همت کردی، انجامش ندادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.9,
   "end": 235.2,
   "text": "خدا برات حسن-- اِاِاِ سیئه رو نمی‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 235.2,
   "end": 239.8,
   "text": "تازه به جهت اینکه اون کار زشت رو نکردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.8,
   "end": 243.28,
   "text": "نیتش رو داشتی اما نکردی، یه حسنه خدا برات می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.28,
   "end": 246.3,
   "text": "عجب! این روایتو دیگه ما ندیده بودیم به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.3,
   "end": 248.96,
   "text": "به این شکل کم دیدیم. که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 248.96,
   "end": 253.16,
   "text": "تو اون کاری که هم کردی نیت کردی رو انجام ندادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.16,
   "end": 258.34,
   "text": "خدا حسنه می‌نویسه. خب حالا \"وإن عملها\" اگر عمل کرد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.34,
   "end": 263.62,
   "text": "سریع می‌نویسه؟ قابل توجه مدیرای قلم به دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.62,
   "end": 269.04,
   "text": "سریع تا کوچک‌ترین زیردستش یه خطایی ازش سر بزنه، دیر بیاد، زود بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.04,
   "end": 272.22,
   "text": "کم کاری‌ای بکنه به جای اینکه بره پا در دلش بشینه بگه مثلا چته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.22,
   "end": 274.2,
   "text": "چند وقته دل به کار نمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.2,
   "end": 276.2,
   "text": "دیر میای، زود میری. مشکلت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.2,
   "end": 281.5,
   "text": "اینا نه. سریع مثل قابض الارواح میاد بیچاره قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.5,
   "end": 284.4,
   "text": "میاد بالا سرش و خلاصه. نه خدا اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.4,
   "end": 287.92,
   "text": "می‌گه \"أجلت ساعة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.92,
   "end": 291.8,
   "text": "هفت ساعت خدا بهش مجال می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.8,
   "end": 294.32,
   "text": "که چی بشه؟ \"فإن تاب و ندِم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.32,
   "end": 296.12,
   "text": "عليها\" که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.12,
   "end": 298.18,
   "text": "توبه کنه. ندامت به خرج بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.18,
   "end": 304.96,
   "text": "اگر این اتفاق افتاد، برگشت، توبه کرد و اون کارو نکرد \"لم تكتب عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.96,
   "end": 309.82,
   "text": "با اینکه اون کارو کرده‌ها هفت ساعت خدا مهلت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 309.82,
   "end": 313.24,
   "text": "اگه پشیمون شد باز اجازه نمیده بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.24,
   "end": 317.68,
   "text": "عجب! حالا اگر انجام داد و پشیمون نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.68,
   "end": 321.98,
   "text": "\"وإن لم يتب ولم يندم عليها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.98,
   "end": 327.0,
   "text": "هفت ساعتم گذشت، پشیمون هم نشد، \"كتبت عليه سيئة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.0,
   "end": 329.54,
   "text": "همون یه بار براش گناه نوشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.54,
   "end": 335.64,
   "text": "عجب! نکته‌ای که اینجا عارضم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.64,
   "end": 338.36,
   "text": "خیلی رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.36,
   "end": 344.02,
   "text": "ما معمولا اینجوری موقعا فکر می‌کنیم این قصه قصه اعتباریه در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.02,
   "end": 347.14,
   "text": "مثلا خدا اینجوری اعتبار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.14,
   "end": 350.34,
   "text": "مثل اسکناس که اعتبار می‌شه انقدر ارزش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.34,
   "end": 353.5,
   "text": "پس فردا از اعتبار می‌افته می‌گه اصلا دیگه باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.5,
   "end": 356.16,
   "text": "یه اسکناس جدید میاد. اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.16,
   "end": 360.98,
   "text": "این اعتبار خدا نیست، این حقیقت نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.98,
   "end": 365.52,
   "text": "چرا؟ بحث ما بر مبنای حکمت و فلسفه و عرفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.52,
   "end": 370.56,
   "text": "چرا؟ چرا خدا وقتی کار خیر می‌کنی نیتشو می‌کنی می‌نویسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.56,
   "end": 373.72,
   "text": "و کار بد می‌کنی تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.72,
   "end": 381.28,
   "text": "هفت ساعت مهلت میده و اگر انجام ندادی که یه تازه یه حسنه هم میده که با اینکه نیت بد کردی ولی انجام ندادی حسنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.28,
   "end": 384.3,
   "text": "چرا اینطوریه؟ به جهت اون فطرت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.3,
   "end": 392.74,
   "text": "عزیزان اینو خوب دقت کنید. ما یه فطرت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.74,
   "end": 394.92,
   "text": "این فطرت خداجوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.92,
   "end": 398.58,
   "text": "چون اصلا اساسش باید این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.58,
   "end": 402.38,
   "text": "مثل اینکه الان انقدر دوز و کلک زیاد شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.38,
   "end": 407.04,
   "text": "یه کسی که راست میگه میگن عجب آدم راستگویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.04,
   "end": 413.84,
   "text": "چه برعکس شده. یا انقدر مریضی زیاد شده، یکی که سالمه میگن عجب فلانی چقدر سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.84,
   "end": 418.28,
   "text": "در صورتی که اساس عالم بر اساس طهارته، بر اساس صداقته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.28,
   "end": 420.52,
   "text": "بر اساس سلامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.52,
   "end": 424.98,
   "text": "سلامٌ هي حتى متى آخر نماز السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.98,
   "end": 428.1,
   "text": "همش همه چی اسم سلام خداست که داره پیاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.1,
   "end": 430.66,
   "text": "باید تعجب کرد که چرا این آقا مریض میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.66,
   "end": 433.26,
   "text": "چرا اون آقا دروغ میگه؟ چرا این آقا کم کاری می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.26,
   "end": 435.64,
   "text": "چرا این آقا زیر آب میزنه؟ چرا اون آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.64,
   "end": 439.8,
   "text": "کم نمیدونم آبرو می‌بره تهمت اینا رو باید تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.8,
   "end": 443.46,
   "text": "اساس عالم بخوام اینو بگم فطرت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.46,
   "end": 447.16,
   "text": "بر اساس الهیت نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.16,
   "end": 450.22,
   "text": "سرشته شده است. پس این اعتباری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.22,
   "end": 455.02,
   "text": "یعنی اگر کسی کار خیر کرد بر اساس فطرتش رفته جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.02,
   "end": 459.16,
   "text": "و چون فطرتش آقا مثل یه دانه که بکاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.16,
   "end": 462.42,
   "text": "زمین مهیا، آب، هوا، گرما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.42,
   "end": 465.84,
   "text": "آفت هم سم‌زدایی می‌کنی. این دانه رو کاشتی جبلیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.84,
   "end": 467.6,
   "text": "فطرت این دانه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.6,
   "end": 473.42,
   "text": "اینکه سرسبز بشه از یه دانه گندم هزاران خوشه بروید دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.42,
   "end": 477.88,
   "text": "فطرتشه. یعنی دنیا اصلا اساس عالم بر اساس اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.88,
   "end": 480.66,
   "text": "سرشت، آفرینش، فطرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.66,
   "end": 488.9,
   "text": "شاکله . شاکله‌ی همه‌ی عالم بر اساس اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.9,
   "end": 491.44,
   "text": "اما اگر کسی خطا کرد، نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.44,
   "end": 493.48,
   "text": "این دیگه شاکله‌ی عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.48,
   "end": 496.92,
   "text": "این فطرتش نیست. یه چیز اضافه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 496.92,
   "end": 499.72,
   "text": "عارض شده. ذاتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.72,
   "end": 503.2,
   "text": "این علت حکمی‌شه. این علت فلسفی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.2,
   "end": 506.28,
   "text": "عارض شده. لذا میگم حالا صبر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.28,
   "end": 508.78,
   "text": "او-امید هم هست انشاالله برگرده چون فطرتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.78,
   "end": 515.1,
   "text": "مثل بچه‌ای که خطا می‌کنه هرچی به پدر مادر میگن بابا بچت فلان خلاف رو کرد میگه انشاالله درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.1,
   "end": 517.44,
   "text": "خون من تو رگشه. من میدونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.44,
   "end": 519.06,
   "text": "من نون و نمک حلال بهش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.06,
   "end": 521.22,
   "text": "فلان حالا گول خورده بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.22,
   "end": 523.58,
   "text": "خدا می‌دونه کیو خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.58,
   "end": 525.94,
   "text": "این نکته آخر رو خوب د-- توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.94,
   "end": 529.82,
   "text": "ما دو تا فطرت داریم. فطرت اولیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.82,
   "end": 535.66,
   "text": "که عرض کردیم همه بر اساس الهیت نظام هستی و پاک پاک بر اساس طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.66,
   "end": 540.9,
   "text": "یه فطرت ثانویه داریم که اصطلاحا قرآن به اون میگه جبلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.9,
   "end": 543.4,
   "text": "اونو خودمون می‌س-می‌سازیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.4,
   "end": 546.62,
   "text": "اگر اصرار به کاری بکنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.62,
   "end": 549.8,
   "text": "چه خوب، چه بد، فطرت ثانویه درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 549.8,
   "end": 555.1,
   "text": "اگر کار خوب انجام بدیم، اصرار، اصرار، اصرار میشه ملکه وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.1,
   "end": 558.46,
   "text": "اصلا خودت میشی اون. خودت میشی س-- حسنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.46,
   "end": 560.58,
   "text": "خودت نه که صاحب عمل باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 560.58,
   "end": 564.16,
   "text": "اصلا خودت حسنه میشی. خودت میشکافی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.16,
   "end": 568.92,
   "text": "رویش می‌کنی. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 568.92,
   "end": 571.4,
   "text": "شما رو زیاد می‌کنم نه نعمت‌تون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.4,
   "end": 574.92,
   "text": "هی شکوفا میشی. نسل طیبه ازت میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 574.92,
   "end": 580.12,
   "text": "چرا؟ به جهت اینکه فطرت ثانویه در ادامه و طول فطرت اولیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.12,
   "end": 583.64,
   "text": "اما اگر فطرت ثانویه، یعنی اون اصرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.64,
   "end": 592.98,
   "text": "اعمال، اون ملکاتی که برای نفس پیش میاد و تو همون میشی در مسیر سیئات باشه، زشتی‌ها و پش-پستی‌ها باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 592.98,
   "end": 595.58,
   "text": "اینجا جبلی رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.58,
   "end": 604.24,
   "text": "اسمشو میگه جبل-- قرآن کجا میگه جبلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.24,
   "end": 608.86,
   "text": "بسیاری از شما رو شیطان اول منکم گمراه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.86,
   "end": 611.1,
   "text": "به چه جهت؟ جبلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.1,
   "end": 615.42,
   "text": "به جهت جبلی‌تون. یعنی خودتون کارو خراب کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 615.42,
   "end": 618.78,
   "text": "هی اون فطرت اولیه رو بدل کردید به جبلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.78,
   "end": 624.4,
   "text": "فطرت رو کردید جبلی ناشایست کارهای زشت انجام دادید، عادتتون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.4,
   "end": 626.54,
   "text": "دیگه این عادت باهات میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 626.54,
   "end": 630.62,
   "text": "پس ختم کلام. اگر خدایی نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.62,
   "end": 637.68,
   "text": "این کارهای زشت بشه عادت انسان به مرتبه این سنجاق شد به بحث جلسه پیشمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.68,
   "end": 640.58,
   "text": "اگه عادت کسی بشه یعنی بشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 640.58,
   "end": 644.38,
   "text": "ملکه وجودیش رسوخ کنه تو نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.38,
   "end": 646.7,
   "text": "اصلا نامحرم از جلوش رد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.7,
   "end": 651.0,
   "text": "دستش تسبیحه داره میگه استغفرالله همینطوری چشم داره با نامحرم میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.0,
   "end": 652.68,
   "text": "خب تو سرت این تسبیح گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.68,
   "end": 661.64,
   "text": "تعطیلش کن. یه من ریش تو صورتش و تسبیح و دلق و سجاده و مثل من لباس پیغمبر تنش و جای سجاده رو پیشونیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.64,
   "end": 664.74,
   "text": "ولی چنان ظلم میکنه به زیردستش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.74,
   "end": 667.72,
   "text": "به همکارش، به نمیدونم کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.72,
   "end": 672.74,
   "text": "ظاهرا روزیش این شده آقا وسیله‌ش مثلا آبروشو می‌بره فلان آقا تعطیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.74,
   "end": 676.4,
   "text": "یا اون لباس خرقه مسجد رو از تنت درآر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 676.4,
   "end": 679.18,
   "text": "یا عملت رو عوض کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.18,
   "end": 682.46,
   "text": "تو دیگه میشی جبلی. این جبلی بیچاره می‌کنه آدمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 682.46,
   "end": 687.64,
   "text": "دیگه اون موقع عزیز دلم همونیه که هستی و ساختی از خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.64,
   "end": 689.66,
   "text": "جبلی دیگه با ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 689.66,
   "end": 693.24,
   "text": "یعنی اگر ببخشید این جمله آخر و نتیجه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.24,
   "end": 695.42,
   "text": "اگر از پا افتادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.42,
   "end": 699.0,
   "text": "تو خونه نه چشمم به نامحرم افتاد نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.0,
   "end": 703.1,
   "text": "اما تو دلم میگم آخ آخ جوونی چی بودش به خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.1,
   "end": 706.74,
   "text": "این فلان استغفرالله این حوری‌های تهران و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 706.74,
   "end": 711.08,
   "text": "فلان. حالا به اینا رو بشین نقدن حالا تا حوری‌های بهشتی که نسیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 711.08,
   "end": 716.28,
   "text": "این اگرچه الان دستش نمی‌رسه دندوناش ریخته اصن دیگه کسی نگاش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.28,
   "end": 718.76,
   "text": "پیرزن از ت-- تاکسی خالی می‌ترسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 718.76,
   "end": 723.52,
   "text": "درسته؟ اما چون جبلی‌شه چرا دیگه جبلی‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.52,
   "end": 725.58,
   "text": "دیوانه دارن براش می‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 725.58,
   "end": 728.76,
   "text": "مثل اینکه بعضیا خیلی تجربشون تو این قصه زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 728.76,
   "end": 731.08,
   "text": "ایشالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.08,
   "end": 735.44,
   "text": "الهی، الهی، الهی به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.44,
   "end": 740.5,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}