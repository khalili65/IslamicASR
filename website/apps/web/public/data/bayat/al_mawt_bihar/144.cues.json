 },
 "chapters": [
  {
   "index": 0,
   "title": "## غدیریه و خطبهٔ صد و چهل‌ونه نهج",
   "start": 0.92,
   "end": 116.38
  },
  {
   "index": 1,
   "title": "## أبحثها عن مکنون؛ موت در پرده",
   "start": 116.38,
   "end": 136.46
  },
  {
   "index": 2,
   "title": "## فأبى الله إلا إخفاءه؛ علم مخزون",
   "start": 136.46,
   "end": 200.76
  },
  {
   "index": 3,
   "title": "## العلیم و لوح محفوظ و محو اثبات",
   "start": 200.76,
   "end": 840.44
  },
  {
   "index": 4,
   "title": "## یعقوب و یوسف؛ عروسی و صدقه و افعی",
   "start": 840.44,
   "end": 1011.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 5.26,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 8.42,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.42,
   "end": 11.22,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.22,
   "end": 15.24,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.24,
   "end": 23.02,
   "text": "اجازه بفرمایید به جهت اینکه ایام غدیریه هم هست فرمایش مولامون علی علیه الصلاة والسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.02,
   "end": 26.52,
   "text": "بهش توجهی بکنیم. همون فرمایشی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.52,
   "end": 28.4,
   "text": "بحث کتاب الموت داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.4,
   "end": 31.28,
   "text": "هفته پیش خب غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.28,
   "end": 34.76,
   "text": "روزها رو پیرامون قلب مشروب صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.76,
   "end": 37.82,
   "text": "بحث موت هفته پیش نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.82,
   "end": 40.68,
   "text": "توفیق میخواد، لیاقت میخواد شنیدن این مباحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.68,
   "end": 45.18,
   "text": "اگرچه بعضیا تخت سینه ما میزنن که آقا موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.18,
   "end": 50.88,
   "text": "بحث موت به چه درد ما میخوره اینا به نظرم کشف فهمیه بعضیامونه که اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.88,
   "end": 57.68,
   "text": "راه برون رفت ما از همه مصیبات و مشکلات و آلودگی‌ها و قضارات و چه و چه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.68,
   "end": 61.06,
   "text": "از رقیقت به حقیقت پل زدن همون موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.06,
   "end": 64.0,
   "text": "حالا در فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.0,
   "end": 67.32,
   "text": "امیرالمؤمنین در خطبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.32,
   "end": 68.96,
   "text": "صد و چهل و نه نهج بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.96,
   "end": 74.68,
   "text": "ذیل روایت دوازدهم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.68,
   "end": 82.66,
   "text": "ابتدای این کلام رو عرض کردیم که مولا فرمودند \"ایها الناس کل امر ان لاق ما یفر منه فی فراره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.66,
   "end": 86.82,
   "text": "هرچیزی که ازش فرار کنی ملاقاتش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.82,
   "end": 91.68,
   "text": "علی اجل مساق النفس گفتیم اون دامنه زندگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.68,
   "end": 100.22,
   "text": "سرنوشت چه می‌دونم اون مهلتی که من و شو داریم، من و شما داریم مساق، مصدر مینی اسم مکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.22,
   "end": 103.1,
   "text": "سوق نفسه به سمت کمالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.1,
   "end": 107.6,
   "text": "\"والهرب منه موافاته\" وقتی ازش فرار می‌کنی اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.6,
   "end": 110.44,
   "text": "می‌بینیش، باهاش برخورد می‌کنی تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.44,
   "end": 112.86,
   "text": "اینجا رو دیگه نشد بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.86,
   "end": 116.38,
   "text": "در مسجد بلال طرحش کردیم باز نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.38,
   "end": 120.92,
   "text": "خیلی فرمایش گران سنگه خصوصاً این تیکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.92,
   "end": 125.48,
   "text": "مولا حضرت وسی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.48,
   "end": 128.18,
   "text": "\"کم اطردت الايام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.18,
   "end": 135.22,
   "text": "ابحثها\". اونایی که وقتی میگیم مولا علی، حضرت وسی، امیرالمؤمنین، عید غدیر چه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.22,
   "end": 141.68,
   "text": "فقط میخوایم از مولا حرفایی رو بشنویم جهت آباد، آباد کردن دنیامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.68,
   "end": 144.22,
   "text": "وقتی از مولامون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.22,
   "end": 147.52,
   "text": "موت و چگونگیش مطرح بشه فرار کنیم این خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.52,
   "end": 149.8,
   "text": "حرف مولاس، حرف من که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.8,
   "end": 153.8,
   "text": "ببینید اونکه جلودار ماست، پیشوای ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.8,
   "end": 156.16,
   "text": "صاحب اختیار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.16,
   "end": 159.76,
   "text": "می‌فرماید که چه روزگارانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.76,
   "end": 164.16,
   "text": "\"کم اطردت الايام\" با تای دسته دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.16,
   "end": 166.94,
   "text": "ابحث، ابحثها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.94,
   "end": 170.96,
   "text": "چه روزگارانی که من رفتم دنبال این مبحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.96,
   "end": 175.06,
   "text": "برای دونستن این موضوع \"عن مکنون هذا الامر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.06,
   "end": 178.64,
   "text": "آقا کلمه، کلمه‌ش باید باز بشه باور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.64,
   "end": 180.68,
   "text": "هی به من نگید آقا بگو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.68,
   "end": 183.46,
   "text": "هی واکاوی نکن، ریشه‌آوی نکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.46,
   "end": 185.66,
   "text": "شخم نزن روایات آخه چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.66,
   "end": 188.52,
   "text": "هر کلمه‌ش خدا شاهده غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.52,
   "end": 193.0,
   "text": "اینجا پیرامون موضوع و مبحث موت و مرگ حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.0,
   "end": 194.82,
   "text": "کلمه مکنون رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.82,
   "end": 197.06,
   "text": "تو قرآن میگیم \"فی کتاب مکنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.06,
   "end": 200.04,
   "text": "\"انه لقرآن کریم فی کتاب مکنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.04,
   "end": 202.38,
   "text": "قرآن در یک کن نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.38,
   "end": 204.84,
   "text": "در یک پرده‌ایست ناشناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.84,
   "end": 208.14,
   "text": "لذا قرآن قیامت وقتی میاد صحنه محشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 208.14,
   "end": 210.28,
   "text": "همه میبینن بکر و دست نخورده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.28,
   "end": 212.38,
   "text": "این همه شخم زده شده آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.38,
   "end": 216.06,
   "text": "چه خبره درونش؟ تو سینه اولیای خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.06,
   "end": 222.36,
   "text": "خدا لعنت کنه بنی امیه و بن العباس علیهم اللعنة والعذاب الألیم رو که دست ما رو از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 222.36,
   "end": 228.66,
   "text": "باطن قرآن و اهل بیت علیهم الصلاة والسلام کوتاه کردن که الان باید آقامون بیابانگرد باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.66,
   "end": 233.18,
   "text": "اینجا هم امیرالمؤمنین موضوع و اصلاً مبحث موت رو میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.18,
   "end": 235.4,
   "text": "یک کلمه مکنونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.4,
   "end": 239.24,
   "text": "مثل قرآن در یک پرده‌ایه ناشناخته‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.24,
   "end": 242.24,
   "text": "و می‌فرماید مولامون آقا دنبال چی‌ایم من و شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.24,
   "end": 245.12,
   "text": "چقدر این روزها ما دنبال مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.12,
   "end": 252.04,
   "text": "بحث و جدل پیرامون مباحث اعتقادی هستیم، عه، عذرخواهی انتخاباتی هستیم که همش هم به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.04,
   "end": 255.86,
   "text": "ها چون حکومت، حکومت اسلامی وظیفه‌مونه بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.86,
   "end": 259.1,
   "text": "خب بحث می‌کنیم، جدل می‌کنیم البته جدل احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 259.1,
   "end": 263.82,
   "text": "اما کی نشستیم بحث کنیم، تفحص کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.82,
   "end": 267.38,
   "text": "پیرامون موضوع موت. چه، کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.38,
   "end": 271.94,
   "text": "امیر بیان داره می‌فرماید چه روزگارانی که چه ایامی که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.94,
   "end": 274.4,
   "text": "رفتم سوار سراغ مبحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 274.4,
   "end": 278.52,
   "text": "ابحثها عن مکنون هذا الامر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.52,
   "end": 281.08,
   "text": "بحث کردم در خصوص این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.08,
   "end": 286.06,
   "text": "امری‌ست، امری که مکنونه، در پرده ابهامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.06,
   "end": 288.88,
   "text": "خب باید رمزگشایی بشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 288.88,
   "end": 291.68,
   "text": "باید پرده از روش برداشته بشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.68,
   "end": 297.9,
   "text": "یا با شلاق موت اجباری باید ببرن این پرده رو بردارن از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.9,
   "end": 300.58,
   "text": "فابالله الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.58,
   "end": 304.1,
   "text": "فابالله الا اخفاءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.1,
   "end": 308.84,
   "text": "ولی مشیت خدا فابالله الا اخفاءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.84,
   "end": 311.68,
   "text": "مشیت خدا بر این تعلق گرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 311.68,
   "end": 314.86,
   "text": "هر بار پوشیده‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 314.86,
   "end": 318.48,
   "text": "الا اخفاءه. یعنی اون موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.48,
   "end": 320.68,
   "text": "موضوع مرگ حقیقتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.68,
   "end": 323.58,
   "text": "پوشیده‌تر بشه. کی داره اینو میگه عزیزم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.58,
   "end": 328.06,
   "text": "امیرالمؤمنین. میگه هر بار رفتم بحث کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.06,
   "end": 331.58,
   "text": "بحث کنم، میبینم پوشیده‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.58,
   "end": 336.0,
   "text": "چرا؟ چرا پوشیده‌تر میشه از نگاه امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.0,
   "end": 338.52,
   "text": "حضرت وسی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.52,
   "end": 342.64,
   "text": "خدا حضرت می‌فرماید، می‌فرماید هیهات الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 342.64,
   "end": 346.0,
   "text": "خدا شاهده عالم باور کنید من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 346.0,
   "end": 351.12,
   "text": "تنم رهش می‌گیره از شنیدن این عبارات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 351.12,
   "end": 354.76,
   "text": "هیهات علم مخزون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 354.76,
   "end": 359.32,
   "text": "می‌دونید چرا؟ چرا هر بار مخفی‌تر میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.32,
   "end": 364.78,
   "text": "علیرغم اینکه امیرالمؤمنین میره به دنبال بحثش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.78,
   "end": 369.66,
   "text": "حتی از چشم مولا کم نه پوشیده تر میشه هر بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.66,
   "end": 374.78,
   "text": "اون کنش حالا در ارتباط با این صحبت می‌کنیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.78,
   "end": 378.78,
   "text": "ها؟ چون فرمود لو کشف القطع مزدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.78,
   "end": 380.7,
   "text": "یقینا دیگه یا لمز دتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.7,
   "end": 385.42,
   "text": "اگه پرده بیفته هیچ یقینی به من اضافه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 385.42,
   "end": 389.04,
   "text": "این چیه قصه بشه با این بحث جمع بشه حالا عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.04,
   "end": 390.94,
   "text": "فرمود علم مخزون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 390.94,
   "end": 396.44,
   "text": "این علم، علمیست که در خزانه اسرار الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 396.44,
   "end": 399.14,
   "text": "اصلاً تو لوح محفوظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.14,
   "end": 405.72,
   "text": "بحث موت. امیرالمؤمنین رفته رمزگشایی کنه میگه هر بار پوشیده تر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.72,
   "end": 408.5,
   "text": "علت اینم که تو مسجد بلال عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.5,
   "end": 412.52,
   "text": "یه روایت از امام جواد صلوات الله عليه خوندیم برای دوستانی که حاضر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.52,
   "end": 419.4,
   "text": "گفتیم علت این که ما اصلاً از موت می‌ترسیم، می‌هراسیم حضرت جواد علیه معلی صلوة الله علیه و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 419.4,
   "end": 421.8,
   "text": "فرمودن به جهت بی اطلاعی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.8,
   "end": 423.82,
   "text": "جهل ما نسبت به موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.82,
   "end": 426.3,
   "text": "مثال زدن خود حضرت مثل این که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.3,
   "end": 431.14,
   "text": "بچه یک دیوانه اگه بخوای شربتی بهش بدن برای مداواش تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.14,
   "end": 435.48,
   "text": "چون نمیدونه آگاهی نداره که اون چه شفا بخشیه براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.48,
   "end": 437.88,
   "text": "میزنه پرت میکنه دست طرف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.88,
   "end": 440.3,
   "text": "فرار میکنه. ها؟ ما هم دقیقا اینطوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.3,
   "end": 445.12,
   "text": "نمیدونیم قصه موت چیه. حالا این سؤال، سؤال، سؤال جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 445.12,
   "end": 449.84,
   "text": "البته تو بحث مکنون و علم مخزون باید کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.84,
   "end": 457.22,
   "text": "باید کار کنیم بالاخره. مگر امیرالمؤمنین فقط تو مسائل سیاسی و اجتماعی جلو دار ماست، امام ماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.22,
   "end": 459.58,
   "text": "یا تو همه مسائل امام ماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.58,
   "end": 462.52,
   "text": "وقتی امیر بیان دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.52,
   "end": 466.12,
   "text": "چیزهای بیهوده که نمیره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.12,
   "end": 470.5,
   "text": "ما ینتقم عن الهوی ان هو الا وحی یوحى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.5,
   "end": 474.46,
   "text": "خواستشم وحیه، درخواستشم وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.46,
   "end": 477.68,
   "text": "میخواد اون پرده ای از موت برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.68,
   "end": 481.48,
   "text": "خب آیا این با علم امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.48,
   "end": 485.78,
   "text": "که مثلا حضرت وسی از لحظه شهادتش خبر میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.78,
   "end": 489.46,
   "text": "منافات نداره؟ اینجا بحث‌هایی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.46,
   "end": 492.48,
   "text": "اجازه بدید تو ضیق فرصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.48,
   "end": 495.66,
   "text": "بعضیاشو من دو سه تاشو تا فرصت که داریم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 495.66,
   "end": 498.5,
   "text": "یکیش اینه که این برداشت خود منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.5,
   "end": 500.88,
   "text": "وقتی بررسی می‌کنم روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.88,
   "end": 503.02,
   "text": "می‌بینم که خود اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 503.02,
   "end": 508.36,
   "text": "مثلاً پیغمبر عزیز عالم خودشو که معرفی می‌کنه، یکی از حالات خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 508.36,
   "end": 510.14,
   "text": "پیغمبر اصلاً حال الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 510.14,
   "end": 512.42,
   "text": "اللهم غیر سوء حالنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 512.42,
   "end": 516.52,
   "text": "بحسن حالک. مرحوم، مرحوم عارف عربی عرض کردیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 516.52,
   "end": 523.34,
   "text": "اممم فتوحاتش می‌فرماید این حال خدا حال پیغمبر عزیز عالمه، حال امیرالمؤمنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.34,
   "end": 525.58,
   "text": "که به مقام صادر اول رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.58,
   "end": 527.78,
   "text": "می‌فرماید لی مع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 527.78,
   "end": 530.6,
   "text": "برای ما به اتفاق حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 530.6,
   "end": 535.54,
   "text": "ها وقتن. یه وقت‌هایی است پیغمبر می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.54,
   "end": 538.08,
   "text": "یه موقع‌هایی یعنی همیشه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 538.08,
   "end": 542.48,
   "text": "که لا یسعانی فیه ملک مقرب ولا نبي مرسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.48,
   "end": 545.8,
   "text": "نکره در سیاق نفس میشه مطلقاً همش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.8,
   "end": 548.92,
   "text": "یعنی هیچ پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 548.92,
   "end": 555.38,
   "text": "مرسلی و هیچ ملک مقربی تو اون مقام نیست با ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.38,
   "end": 559.88,
   "text": "مایییم و خدا. یه وقت بخصوصی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.88,
   "end": 562.4,
   "text": "ببینید این یعنی همیشه این حالات نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 562.4,
   "end": 565.6,
   "text": "از امام صادق صلوات الله علیه برای تأیید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 565.6,
   "end": 568.54,
   "text": "موضوع عرض کنم. حضرت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.54,
   "end": 571.42,
   "text": "یه تیکشو فقط عرض می‌کنم. لنا حالاتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 571.42,
   "end": 576.26,
   "text": "برای ما آل الله یه حالاتیه، حالت‌هایی است یا همون وقت‌هایی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 576.26,
   "end": 579.98,
   "text": "یه حالاتی‌ست که حالا می‌فرماید نحن هو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.98,
   "end": 582.96,
   "text": "هو نحن الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.96,
   "end": 586.2,
   "text": "البته به الفاظ متعدد اما با یک مضمون اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.2,
   "end": 589.08,
   "text": "این روایت که ما او می‌شویم و او ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.08,
   "end": 592.16,
   "text": "در عین حال او اوست و ما، ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 592.16,
   "end": 600.1,
   "text": "خب اینا یعنی چی؟ یعنی یه حالاتی برای ما اتفاق میفته که دیگه لا فرق بینهم و بین حبیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 600.1,
   "end": 604.6,
   "text": "اصلاً اون می‌شه مثل الله. ليس كمثله شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 604.6,
   "end": 608.7,
   "text": "اون کاف و حضرت علامه در شرح فصوص و حتی در مصباح العنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.7,
   "end": 611.76,
   "text": "می‌فرماید که اون کاف رو چرا زائد می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.76,
   "end": 615.36,
   "text": "یعنی چی به خدا نسبت زائد میدی کاف زائد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 615.36,
   "end": 618.14,
   "text": "ک مثله. ليس ک مثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.14,
   "end": 620.42,
   "text": "کف، ک یعنی خودش مثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.42,
   "end": 623.68,
   "text": "ليس کمثله یعنی نیست مثل، مثل خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 623.68,
   "end": 628.22,
   "text": "مثل الله پس داریم که مثل، مثل الله نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.22,
   "end": 632.54,
   "text": "مرحوم عارف عربی می‌فرماید به زر صدقاتو میگه مثل الله امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 632.54,
   "end": 635.04,
   "text": "انسان کامله. امام عصر من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.04,
   "end": 640.78,
   "text": "امیرالمؤمنینه. او هم اون حال، اون لحظات، اون وقت‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.78,
   "end": 642.62,
   "text": "غرق در-- چجوری؟ لفظ نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.62,
   "end": 645.58,
   "text": "لفظ خاکیه، نمی‌تونه تدای کنه از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.58,
   "end": 647.92,
   "text": "حقایق عرشی. وقتی حالا بگیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 647.92,
   "end": 652.02,
   "text": "بگیم غرق در ذات حضرت حق می‌شه دیگه او، اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 652.02,
   "end": 654.24,
   "text": "و او، اوست. چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 654.24,
   "end": 657.9,
   "text": "او، این است و این، او. در عین حال او، اوست و این، این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 657.9,
   "end": 660.08,
   "text": "چه بگیم؟ لفظ نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 660.08,
   "end": 663.48,
   "text": "اینجا بله، اینجا از همه چی خبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 663.48,
   "end": 666.62,
   "text": "دقت بفرمایید چی شد؟ برگشتیم به بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 666.62,
   "end": 668.56,
   "text": "از همه چی خبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 668.56,
   "end": 672.96,
   "text": "همه علم در اختیارشه. اما در غیر این حالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 672.96,
   "end": 677.02,
   "text": "نه. لذا خیلی مواقع شده اومدن اصحاب از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 677.02,
   "end": 679.54,
   "text": "امیرالمؤمنین، از پیغمبر سؤال کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 679.54,
   "end": 682.78,
   "text": "حضرت اعلام بی اطلاعی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.78,
   "end": 686.94,
   "text": "یا امام صادق. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 686.94,
   "end": 688.86,
   "text": "یه فرمایش دیگه دارن بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 688.86,
   "end": 692.02,
   "text": "می‌فرمایند که لوح محفوظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 692.02,
   "end": 695.34,
   "text": "فقط دست خداست. فوت کوزه، کوزه‌گریه اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 695.34,
   "end": 698.82,
   "text": "مال خداست، دست خداست. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 698.82,
   "end": 702.06,
   "text": "خداست و دیگه همه علمشو که خدا نازل نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 702.06,
   "end": 704.6,
   "text": "العلیم فقط خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 704.6,
   "end": 707.84,
   "text": "علیم امیرالمؤمنین هست اما العلیم فقط خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 707.84,
   "end": 711.04,
   "text": "اون اسم مستعفره است. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 711.04,
   "end": 715.34,
   "text": "پس اینطور نیست بگیم خدا همه چیش رو به علی بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 715.34,
   "end": 722.04,
   "text": "نه به ظرف امکانی، به اون مقداری که امکان داشت در این حیات بشری نازل بشه علم بله تو سینه مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 722.04,
   "end": 725.9,
   "text": "دیگه اهلی اون اندازه رو نداره. نه همه علم حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 725.9,
   "end": 728.76,
   "text": "لذا اینجا می‌فرمایند که این لوح محفوظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 728.76,
   "end": 733.06,
   "text": "پیش خداست، مخصوص خداست. هر مقدار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.06,
   "end": 737.58,
   "text": "لازم دونسته خداست و خدایی می‌کنه، تو سینه این آل الله ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 737.58,
   "end": 741.48,
   "text": "یه سری چیزا هم می‌تونه مثلا خودشون فرمودن ما از دو چیز خبر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 741.48,
   "end": 745.74,
   "text": "می‌دونستید این روایتو؟ خودشون فرمودن ما بی‌خبریم از دو چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 745.74,
   "end": 747.74,
   "text": "عجب! امام بگه من بی‌خبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 747.74,
   "end": 750.22,
   "text": "بله یکیش ساعت قیامته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 750.22,
   "end": 753.74,
   "text": "یکیش هم وقت ظهوره. خودشون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 753.74,
   "end": 759.46,
   "text": "توجه کردید چی شد؟ حالا بعضیا اینجا دوباره میان میگن آقا ما یک لوح محفوظ داریم پیش خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 759.46,
   "end": 761.02,
   "text": "یه لوح محو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 761.02,
   "end": 765.42,
   "text": "محو اثبات. لوح محو اثبات هم بگم دیگه برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 765.42,
   "end": 767.94,
   "text": "قبلاً هم البته اج-- عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 767.94,
   "end": 770.54,
   "text": "ببینید الان آب، آبه، اثباته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 770.54,
   "end": 774.9,
   "text": "اثبات اینه که این ثبوتش بر آب بودنه، آبیتشه، مائیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 774.9,
   "end": 777.4,
   "text": "حالا جوشوندیش بخار شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 777.4,
   "end": 780.66,
   "text": "محو شد، بخار اثبات شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 780.66,
   "end": 782.82,
   "text": "به این میگن محو اثبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 782.82,
   "end": 791.3,
   "text": "خب. میگن امام اشراف به لوح محو اثبات داره نه لوح محفوظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 791.3,
   "end": 794.34,
   "text": "یعنی چی؟ اون فرمایش امیرالمؤمنین الان جاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 794.34,
   "end": 798.04,
   "text": "فرمود من می‌تونم به شما اگر بدا نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 798.04,
   "end": 800.2,
   "text": "اینکه یه دفعه قضا تغییر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 800.2,
   "end": 803.04,
   "text": "حکم الهیه اما برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 803.04,
   "end": 805.76,
   "text": "در سه امام بدا اتفاق افتاده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 805.76,
   "end": 812.78,
   "text": "می‌دونید. این بدا نبود یعنی حکم قطعی خدا نبود که چیزی تغییر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 812.78,
   "end": 815.86,
   "text": "الان مصداقشو عرض می‌کنم اتمام بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 815.86,
   "end": 823.0,
   "text": "من علی آنچه که تا قیام قیامت در خصوص تک تک شما می‌خواد اتفاق بیفته رو می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 823.0,
   "end": 825.26,
   "text": "اما بدا اتفاق می‌افته. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 825.26,
   "end": 827.84,
   "text": "خداست آقا. خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 827.84,
   "end": 833.84,
   "text": "درسته این مثل الله اما عین خدا که دیگه نمی‌شه گفت عینیتش عین، عین خداست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 833.84,
   "end": 836.76,
   "text": "اون خداست این عبده. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 836.76,
   "end": 839.44,
   "text": "مثالش. دو تا مصداق ارائه بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 839.44,
   "end": 842.46,
   "text": "نوش جونتون. برای سهولت فهم بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 842.46,
   "end": 850.74,
   "text": "مثلاً سؤال چگونه است که حضرت یعقوب علی نبينا و آله و عليه الصلاة والسلام بوی پیراهن یوسف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 850.74,
   "end": 854.56,
   "text": "از مصر متوجه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 854.56,
   "end": 857.94,
   "text": "اما حضرت یوسف رو تو چاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 857.94,
   "end": 860.76,
   "text": "تو شهر و ده خودش ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 860.76,
   "end": 864.36,
   "text": "دنبالش می‌گشت. این ما-- برمی‌گرده به همون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 864.36,
   "end": 867.1,
   "text": "هر علمی رو خدا در اختیارشون نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 867.1,
   "end": 872.42,
   "text": "هر علمی که خدا بخواد. بعد همیشه هم این حالات رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 872.42,
   "end": 874.98,
   "text": "یه مثال دیگه، مصداق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 874.98,
   "end": 879.5,
   "text": "در خصوص حضرت عیسی. البته اهل بیت هم اینو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 879.5,
   "end": 882.62,
   "text": "حضرت عیسی علی نبينا و آله و عليه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 882.62,
   "end": 884.58,
   "text": "این آخرین مصداق ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 884.58,
   "end": 887.04,
   "text": "اینکه گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 887.04,
   "end": 892.52,
   "text": "یه عروسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 892.52,
   "end": 896.94,
   "text": "می‌خوان ازدواج کنن. امام حضرت عیسی گفت که این‌ها شب آخر عمرشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 896.94,
   "end": 899.48,
   "text": "امشب متأسفانه بشارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 899.48,
   "end": 903.52,
   "text": "عروسی این عروس و داماد رو که دادن حضرت روح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 903.52,
   "end": 908.66,
   "text": "گفتن که نه این‌ها به یک معنا باز بشارته اما بشارت ملاقات الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 908.66,
   "end": 912.5,
   "text": "آقا اینا اون شب از دنیا رفتن یا نرفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 912.5,
   "end": 914.8,
   "text": "نرفتن. عکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 914.8,
   "end": 916.5,
   "text": "فرمایش حضرت عیسی اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 916.5,
   "end": 919.98,
   "text": "اومدن گفتن یا روح الله شما فرمودین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 919.98,
   "end": 921.68,
   "text": "فرمودن برید ازشون سؤال کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 921.68,
   "end": 925.06,
   "text": "اینا دیشب این عروس خانم یه صدقه‌ای به اتفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 925.06,
   "end": 928.48,
   "text": "داماد رد کردن، خدا بدا، بدا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 928.48,
   "end": 932.06,
   "text": "قضاى الهی بر این حاکم شد که عمر مجدد بهشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 932.06,
   "end": 935.42,
   "text": "مگه حدیث نداریم؟ یه صدقه سی سال به عمرت اضافه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 935.42,
   "end": 938.76,
   "text": "یه صدقه درست درمونو آبرو بخری از یکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 938.76,
   "end": 943.66,
   "text": "گره حساسی از یکی باز-- نه یه مثلا پنجاه هزار تومن بذاری کف دست یکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 943.66,
   "end": 945.9,
   "text": "نه. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 945.9,
   "end": 949.84,
   "text": "یا اون دوباره اونکه امام صادق صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 949.84,
   "end": 954.42,
   "text": "آقا این عروس داماد امشب شب آخرشون-- مصادیق زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 954.42,
   "end": 959.68,
   "text": "بعد فردا دیدن نه اینا از خونه اومدن بیرون سر و موی گنده، عروس و داماد سالم و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 959.68,
   "end": 966.18,
   "text": "و حضرت گفتن حضرت فرمود برید اون تختی که شب زفاف اینو روش ب-- درون بستر آرامیدن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 966.18,
   "end": 968.08,
   "text": "مثلاً به اصطلاح تشکش رو بردارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 968.08,
   "end": 972.6,
   "text": "برداشتن دیدن یه مار سیاه افعی اون زیر مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 972.6,
   "end": 977.2,
   "text": "حضرت فرمود اینا قرار بود این مار، مار شب زفاف نششون بزنه و بکششون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 977.2,
   "end": 982.7,
   "text": "اما صدقه، یه کسی در خونه‌شونو زد از قضای شب زفافشون بخشیدن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 982.7,
   "end": 985.7,
   "text": "سائل. خدا قضاش برگشت، حکمش برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 985.7,
   "end": 987.92,
   "text": "این اینطوریه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 987.92,
   "end": 993.46,
   "text": "ه-- اینطوری نیست که بگیم اون‌ها همیشه آن و آن به همه علم الهی دسترسی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 993.46,
   "end": 996.24,
   "text": "نه. اینم بر این جهت. حالا این بحثو انشاالله ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 996.24,
   "end": 998.84,
   "text": "عاقبت اون ان شاء الله ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 998.84,
   "end": 1001.76,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1001.76,
   "end": 1004.78,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1004.78,
   "end": 1006.68,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1006.68,
   "end": 1011.64,
   "text": "آل محمد و عجل فرجهم صفه سیصد و هفتاد و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}