 "chapters": [
  {
   "index": 0,
   "title": "## حکم تکرار نماز جماعت",
   "start": 17.88,
   "end": 77.04
  },
  {
   "index": 1,
   "title": "## یقینِ مرگ که به شک می‌ماند",
   "start": 77.04,
   "end": 280.32
  },
  {
   "index": 2,
   "title": "## شش مرحله و نزول ملائکه",
   "start": 280.32,
   "end": 487.53
  },
  {
   "index": 3,
   "title": "## آیهٔ اتقوا یوماً",
   "start": 487.53,
   "end": 804.85
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.52,
   "end": 5.7,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.7,
   "end": 11.1,
   "text": "السلام علیک ای داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.1,
   "end": 15.3,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.3,
   "end": 17.6,
   "text": "اگر امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.6,
   "end": 22.28,
   "text": "مثلا تصور کنید اینجا امام جماعت نماز ظهر و عصرش رو خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.28,
   "end": 28.24,
   "text": "یه سری مأموم دیگه اومدن گفتن آقا میشه یه بار دیگه نماز ظهر و عصرتون رو بخونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.24,
   "end": 31.38,
   "text": "خونده. حالا میگن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.38,
   "end": 35.82,
   "text": "ما نبودیم، یه بار دیگه شما بخونید ما به فیض جماعت برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.82,
   "end": 41.38,
   "text": "میشه این کارو کرد یا نه؟ رهبر عزیز می‌فرما تو دو تا مسجد میشه، دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.38,
   "end": 44.1,
   "text": "تا جا. یعنی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.1,
   "end": 47.34,
   "text": "اولا مأموم‌ها عوض شده باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.34,
   "end": 50.32,
   "text": "ثانیا جا هم عوض شده باشه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.32,
   "end": 55.54,
   "text": "امام جماعت بار دوم دوباره نمازشو بخونه، نماز واجبشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.54,
   "end": 58.38,
   "text": "به نیت ادا ها. ولی همین یه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.38,
   "end": 61.12,
   "text": "اتفاقا مستحب هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.12,
   "end": 65.66,
   "text": "جایز هست که هیچی مستحب هم هست این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.66,
   "end": 68.96,
   "text": "که این اتفاق بیفته ولی خب یه بار بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.96,
   "end": 72.7,
   "text": "یعنی بار اول خوند بار دومم دیگه بیشتر از اون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.7,
   "end": 76.62,
   "text": "یعنی تکرار بار دیگه دیگه جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.62,
   "end": 79.26,
   "text": "خب چهارشنبه‌ها نوبت به بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.26,
   "end": 82.18,
   "text": "شیرین موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.18,
   "end": 86.16,
   "text": "که اگر واقعا جانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.16,
   "end": 90.8,
   "text": "جابه جایا نیست. یه مسجد، مسجد دیگه- نه مکان کلا جابه جا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.8,
   "end": 92.62,
   "text": "آره. نه توی مسجد نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.62,
   "end": 95.74,
   "text": "این فتوای رهبره البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.74,
   "end": 102.3,
   "text": "و بله اگر واقعا معنای موت درست استیضاح بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.3,
   "end": 108.08,
   "text": "واقعا شیرینه. اما متاسفانه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.08,
   "end": 111.66,
   "text": "تا بخوایم اون شیرینی رو درک کنیم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.66,
   "end": 114.9,
   "text": "پس کله‌مون زدن و گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.9,
   "end": 117.64,
   "text": "\"دیگه بلند بگو لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.64,
   "end": 123.34,
   "text": "دیر میشه.\" در روایت دهم باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.34,
   "end": 129.62,
   "text": "کتاب الموت بودیم. روایت عجیبی‌ست که امام صادق صلی الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.62,
   "end": 132.04,
   "text": "که \"لم يخلق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.04,
   "end": 135.82,
   "text": "عز وجل يقينا لا شك فيه اشبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.82,
   "end": 139.42,
   "text": "بشك لا يقين فيه من الموت.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.42,
   "end": 142.8,
   "text": "یعنی اینکه خداوند عز وجل هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.8,
   "end": 148.08,
   "text": "یقینی رو خالی از شک و تردید نیافرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.08,
   "end": 150.92,
   "text": "چون مرگ مثل مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.92,
   "end": 156.64,
   "text": "که شبیه‌تر باشد به شکی که در آن یقینی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.64,
   "end": 159.32,
   "text": "یعنی مردم باهاش یه طوری رفتار می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.32,
   "end": 165.8,
   "text": "به یه شکی، به نگاه شکی نگاه می‌کنند موت رو که انگار اصلا یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.8,
   "end": 169.32,
   "text": "در صورتی که یقینی‌ترین‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.32,
   "end": 171.42,
   "text": "خدا خلق نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.42,
   "end": 175.72,
   "text": "چیزی رو که یعنی انقدر دیگه یقینی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.72,
   "end": 179.96,
   "text": "همه هم جالبه می-- قبول دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.96,
   "end": 182.88,
   "text": "یعنی از علمشون بپرسی آیا تو می‌میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.88,
   "end": 188.0,
   "text": "میگه بله. اما یقین، موضوع اینجا ب-بحث یقین رو داره مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.0,
   "end": 190.54,
   "text": "جلسه پیش بعضیا اشکال کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.54,
   "end": 193.84,
   "text": "بعد چطور همه قبول دارن می‌میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.84,
   "end": 198.18,
   "text": "که شک، طوری رفتار می‌کنن انگار شکیه که یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.18,
   "end": 200.52,
   "text": "همه میگن بله می‌میریم، همه هم می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.52,
   "end": 205.78,
   "text": "این گفتن رو ول کن. یقین، موضوع اینجا داره بحث یقین مطرح میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.78,
   "end": 209.82,
   "text": "یقین نداریم ما. باور نداریم که قراره بمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.82,
   "end": 212.62,
   "text": "مثل اون قصه که حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.62,
   "end": 218.64,
   "text": "در در اثر کتاب شریف آداب الصلاه‌شون این‌ها فکر می‌کنم در مقدمشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.64,
   "end": 221.48,
   "text": "اونجا میاره مثال می‌زنه که چرا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.48,
   "end": 224.74,
   "text": "مثلا مثال می‌زنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.74,
   "end": 229.74,
   "text": "جایگاه علم دو جاست، یکی مغزه، یکی قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.74,
   "end": 237.16,
   "text": "بعد می‌فرماید که چگونه‌ست که از من و شما سؤال می‌کنند که آقا از علم من و شما، اونچه که تو مغز ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.16,
   "end": 241.84,
   "text": "آقا میت می‌تونه پاشه ما رو یقه کنه، آسیب به ما برسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.84,
   "end": 247.68,
   "text": "علمت میگه نه. سؤال دوم آیا شب فرقی با روز می‌کنه الا اینکه تاریک شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.68,
   "end": 249.98,
   "text": "جواب نه فرقی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.98,
   "end": 253.66,
   "text": "حالا سؤال سوم حاضری با یه میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.66,
   "end": 255.38,
   "text": "در دل شب یه جا تنها باشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.38,
   "end": 260.22,
   "text": "نه، نه، نه اصلا. خب تو که علمت جواب داد مشکلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.22,
   "end": 262.36,
   "text": "چگونه‌ست که در عمل حاضر نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.36,
   "end": 266.06,
   "text": "امام می‌فرماید اینجا معلوم میشه که علم دو تا جایگاه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.06,
   "end": 268.76,
   "text": "یکی همین فکر ماست، علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.76,
   "end": 271.84,
   "text": "یعنی علمه، مفهوم، یه مفهومی رو میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.84,
   "end": 274.64,
   "text": "یه چهار تا اصطلاح حفظ کرده مثل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.64,
   "end": 280.32,
   "text": "اما اینکه باور کنه باید اون علم وارد یقین بشه که با تمرین و ممارست این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.32,
   "end": 285.06,
   "text": "وقتی یقین حاصل شد دیگه حاضره کنار میت بلکه هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.06,
   "end": 289.24,
   "text": "دل شب اصلا پاشه بره قبرستون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.24,
   "end": 292.32,
   "text": "اینه که مشکل اصلی رو يقينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.32,
   "end": 297.8,
   "text": "و ما طوری رفتار می‌کنیم که متاسفانه مشکوک‌ترین چیزهاست این موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.8,
   "end": 300.56,
   "text": "حالا وقتی ما بریم نگاه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.56,
   "end": 304.84,
   "text": "به قصه مراحل مختلف هنگام موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.84,
   "end": 307.98,
   "text": "که خودش فکر می‌کنم شش تا جلسه می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.98,
   "end": 312.94,
   "text": "این شش مرحله رو گفتن ما وقت موت درک می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.94,
   "end": 315.34,
   "text": "حالا اجازه بدید به وقتش عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.34,
   "end": 318.0,
   "text": "اگه دوست داشتید. شش مرحله، این مرحله‌هاش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.0,
   "end": 321.92,
   "text": "حالا اولیشو امروز بگیم. می‌خوام اینو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.92,
   "end": 323.86,
   "text": "ربطشو البته به موضوع داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.86,
   "end": 329.72,
   "text": "اینکه اینطور نیست که فقط در زمان حیات ما مشکوک باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.72,
   "end": 337.12,
   "text": "وقتی شما روایات و آیات رو بررسی می‌کنیم، می‌بینی در همه مراحل موت باز این شک همراهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.12,
   "end": 339.48,
   "text": "و اگر هم نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.48,
   "end": 344.18,
   "text": "شیطان با تمام قوا مخصوصا در مرحله پنجم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.18,
   "end": 347.4,
   "text": "چهارم و پنجم که حالا بعدا میگیم، میاد که چکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.4,
   "end": 356.72,
   "text": "تو رو به شک بندازه. نسبت به باورت‌هات، به خدا و اهل بیت، قیامت و و که حالا بعدها انشاالله باید بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.72,
   "end": 360.48,
   "text": "تو مرحله اول که مرگ می‌خواد حادث بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.48,
   "end": 364.01,
   "text": "ملائکه نازل میشن تنزل الملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.01,
   "end": 368.91,
   "text": "ملائکه نازل میشن چون واسطه‌ی فیض‌اند و می‌خواد فیض به من و شما برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.91,
   "end": 372.77,
   "text": "می‌خواید از ظاهر عالم به باطن عالم سفر کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.77,
   "end": 376.41,
   "text": "حقیقت عالم رو ببینی، حقیقت خودت رو درک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.41,
   "end": 380.91,
   "text": "\"یوم تبلی السرائر\" باطن خودت آشکار بشه برای خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.91,
   "end": 385.67,
   "text": "قشنگه آدم بره به رتبه‌های مافوق نظام هستی، بره به عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.67,
   "end": 388.29,
   "text": "چرا همش تو دنیا؟ بره اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.29,
   "end": 390.55,
   "text": "که اونجا رابطه‌ش با اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.55,
   "end": 393.83,
   "text": "گفتن بچه تو رحم مادر چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.83,
   "end": 400.51,
   "text": "اگه بهش بگن یه همچین دنیایی با این وسعت و عظمت کهکشان‌ها، اصلا نمی‌فهمه، تصور نمی‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.51,
   "end": 403.63,
   "text": "رابطه‌ی این دنیا با عالم مثال تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.63,
   "end": 407.17,
   "text": "این شکلیه. الان ما مثل بچه در رحمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.17,
   "end": 409.57,
   "text": "اونور انگار آزاد میشی. چه خبره اونور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.57,
   "end": 411.63,
   "text": "خب چه خوبه. چه بد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.63,
   "end": 415.41,
   "text": "چرا بد باشه؟ حالا این رو وقتی می‌خواد اتفاق بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.41,
   "end": 420.17,
   "text": "ملائکه چون واسطه‌ی فیض‌اند می‌خوان این سفر رو شروع کنن ملائک میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.17,
   "end": 422.33,
   "text": "هنوز قابض الارواح تشریف نیاورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.33,
   "end": 424.57,
   "text": "ملائکه‌ای میان که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.57,
   "end": 428.21,
   "text": "صدنه‌ی، خدمه‌ی قابض الارواح هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.21,
   "end": 431.95,
   "text": "رشه ها و در حقیقت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.95,
   "end": 435.41,
   "text": "میگن پا قدمی حضرت عزرائیل خودش رو نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.41,
   "end": 438.45,
   "text": "لذا شیاطین شاخک‌شون تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.45,
   "end": 440.31,
   "text": "روایت داریم که اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.31,
   "end": 443.99,
   "text": "شیاطین و اجنه می‌فهمن که این شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.99,
   "end": 447.71,
   "text": "داره نزدیکه، یعنی می‌خواد بمیره ولی خودش نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.71,
   "end": 452.15,
   "text": "اتفاقاتی حالا من الان دوست داشتید اگه دوست دارید یکی دو تا نشونه بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.15,
   "end": 454.69,
   "text": "که از خودم نمیگما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.69,
   "end": 458.15,
   "text": "طبق روایات و آیات که آدم بفهمه واقعا کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.15,
   "end": 464.71,
   "text": "حداقل لحظاتی قبل بفهمه قبل از این که حالت معاینه پیش بیاد و اونور رو ببینه که دیگه هیچ کاری نمیشه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.71,
   "end": 467.15,
   "text": "بگم؟ یه صلوات بفرستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.15,
   "end": 469.29,
   "text": "اللهم صل على محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.29,
   "end": 471.91,
   "text": "نمیگم. این صلوات شما یعنی نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.91,
   "end": 474.69,
   "text": "چون خیلی شل و ول صلوات می‌فرستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.69,
   "end": 479.83,
   "text": "یعنی نگو. اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.83,
   "end": 483.21,
   "text": "شما چرا شهرستانی صلوات می‌فرستین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.21,
   "end": 487.53,
   "text": "آره. وقتی که ملائکه نازل این مرحله اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.53,
   "end": 494.11,
   "text": "اگر دوست داشتید آیه اش رو ببینید هر مرحله رو بنده حداقل یه آیه، یه روایت تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.11,
   "end": 497.87,
   "text": "آیه دویست و هشتاد و یک بقره می‌فرماید \"واتقوا یوما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.87,
   "end": 501.37,
   "text": "بترسید، بپرهیزید از روزی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.37,
   "end": 504.41,
   "text": "یوم هم که قبلا گفتیم ظرف ظهور اشیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.41,
   "end": 506.67,
   "text": "ظرف در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.67,
   "end": 508.91,
   "text": "ظهور هر چیزی اونجا ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.91,
   "end": 513.01,
   "text": "یعنی شما اون روز محل ظهور شما برای خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.01,
   "end": 515.15,
   "text": "ظاهر شدن خودت برای خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.15,
   "end": 519.41,
   "text": "یا به یک معنا مرگ برای شما ظهور پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.41,
   "end": 525.85,
   "text": "\"ياتقوا یوما\". حالا این یوم رو خدا حفظ کنه آقای قرائتی تو تفسیر نورش می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.85,
   "end": 528.85,
   "text": "این تنوین یوماً که اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.85,
   "end": 531.03,
   "text": "یعنی خیلی روز بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.03,
   "end": 533.23,
   "text": "عجب روزیه. لذا نکره اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 533.23,
   "end": 535.51,
   "text": "یعنی نمی‌تونی بشناسی اون روز رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.51,
   "end": 539.41,
   "text": "چه روزی؟ \"ترجعون فیه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.41,
   "end": 542.83,
   "text": "شما رو بعد فعل مجهول اومده، ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.83,
   "end": 545.67,
   "text": "یعنی شما رو برمی‌گردانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.67,
   "end": 547.57,
   "text": "کیا برمی‌گردونن؟ چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 547.57,
   "end": 551.67,
   "text": "\"فیه\" در اون روز \"الى الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.67,
   "end": 553.81,
   "text": "یعنی انا لله اومدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 553.81,
   "end": 556.71,
   "text": "حوض نزول حالا و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.71,
   "end": 561.59,
   "text": "\"الى الله ثم توفى\" دوباره شما رو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.59,
   "end": 564.05,
   "text": "هر کاری کردی، همه‌ی کسبو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.05,
   "end": 566.51,
   "text": "حالا چه کسب، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.51,
   "end": 569.93,
   "text": "حالا یا به نحو کسب یا اکتسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 569.93,
   "end": 572.81,
   "text": "چه له تو باشه چه علیه تو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 572.81,
   "end": 574.51,
   "text": "همه رو \"توفی\" می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 574.51,
   "end": 578.91,
   "text": "\"کل نفس ما كسبت\" هرچه، هرچی کسب کردی رو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 578.91,
   "end": 582.09,
   "text": "سر سوزنی فروگذار نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.09,
   "end": 584.11,
   "text": "همه رو می‌گیرن با خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 584.11,
   "end": 587.35,
   "text": "جانت همه رو خود-- کانه خود این آیه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 587.35,
   "end": 591.37,
   "text": "اصرار به این موضوع می‌کنه که تو خودت کسبتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.37,
   "end": 594.05,
   "text": "تو خودت چون مرگ یعنی روح تو رو می‌گیرن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 594.05,
   "end": 599.87,
   "text": "بعد چی میگه که \"ثم توفى كل نفس ما كسبت\" هرچی کسب کرده رو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.87,
   "end": 603.17,
   "text": "تو رو دارن می‌گیرن که. یعنی چه هرچی کسب کردن رو می‌گیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 603.17,
   "end": 606.09,
   "text": "یعنی تو خودت همون چیزی هستی که کسب کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.09,
   "end": 609.59,
   "text": "لذا فرمودن که \"جزاء وفاقا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 609.59,
   "end": 613.75,
   "text": "جزای عمل، خب اصلا جزا نفس عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 613.75,
   "end": 616.15,
   "text": "همون عملی که کردی عینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 616.15,
   "end": 618.69,
   "text": "نفس عمل جزای توست. تو چه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.69,
   "end": 622.49,
   "text": "همینی که الان هستی. هی منتظر بهشت و جهنم نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 622.49,
   "end": 625.13,
   "text": "آقا شما الان بهشتی یا جهنمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 625.13,
   "end": 628.17,
   "text": "تمام شد. الان خودتم می‌تونی تشخیص بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 628.17,
   "end": 631.09,
   "text": "منبثتی یا منقبضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 631.09,
   "end": 633.91,
   "text": "زیغ داری یا انبساط و ابتهاج داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 633.91,
   "end": 638.33,
   "text": "حالا اون نشونه‌ای که می‌خواستم عرض کنم تو این لحظه اتفاق میفته و خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 638.33,
   "end": 645.11,
   "text": "طرف هم نمی‌دونه خبر نداره لحظاتی مونده تا از دنیا فارغ بشه ملائکه دارن میان شیاطین می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.11,
   "end": 649.25,
   "text": "شیاطین که می‌بینن شاخک‌شون تیز می‌شه حمله ور می‌شن که چه کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 649.25,
   "end": 653.87,
   "text": "این شخصو تا می‌تونه دوباره هی به شک و شبهه بندازن و باورهاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 653.87,
   "end": 657.15,
   "text": "ازش بگیرن. تو این لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 657.15,
   "end": 661.71,
   "text": "چه اتفاقی میفته؟ فرمودن کسی که اهل ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 661.71,
   "end": 665.65,
   "text": "امیر المؤمنین علیه الصلاة والسلام باشه، اهل ایمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 665.65,
   "end": 668.13,
   "text": "یه فرح، یه نشاط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 668.13,
   "end": 671.81,
   "text": "یه انبساط، یه ابتهاج، یه سرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 671.81,
   "end": 675.93,
   "text": "\"رب اشرح لی صدری\" گشادگی سینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 675.93,
   "end": 678.63,
   "text": "براشون پیش میاد. خدا رحمت کنه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 678.63,
   "end": 680.35,
   "text": "استاد کل علامه حسن زاده را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 680.35,
   "end": 682.53,
   "text": "این دعا رو همیشه می‌کرد در حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.53,
   "end": 684.45,
   "text": "دیگران و شاگرداش و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 684.45,
   "end": 686.83,
   "text": "هرکی یه خیری بهش می‌رسوند این دعاش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 686.83,
   "end": 689.19,
   "text": "خدا به شما شرح صدر عطا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 689.19,
   "end": 692.79,
   "text": "خدا به شما شرح-- چقدر خوبه این دعا رو در حق هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 692.79,
   "end": 697.45,
   "text": "اصلا این که خدا به شما شرح صدر عطا کنه یعنی خدا شما رو عاقبت بخیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 697.45,
   "end": 700.71,
   "text": "الان دارین می‌فهمین یعنی چی. اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 700.71,
   "end": 703.15,
   "text": "وقتی نزدیک می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 703.15,
   "end": 707.33,
   "text": "موتشون می‌شه، یه فرح عجیبی تو دلشون ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 707.33,
   "end": 710.33,
   "text": "می‌گه نمی‌دونم چه مایه انبساط عجیبی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 710.33,
   "end": 714.09,
   "text": "نمی‌دونم اون فیلم حاج قاسم عزیز رو دیدید روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 714.09,
   "end": 717.47,
   "text": "آخرین باری که وارد ستاد می‌شه قبل شهادتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 717.47,
   "end": 720.85,
   "text": "وارد ستاد می‌شه، دوربین مخفی گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 720.85,
   "end": 723.21,
   "text": "اصلا وارد ستاد که می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 723.21,
   "end": 726.09,
   "text": "مبتهجه، تسبیح دستش داره ذکر می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 726.09,
   "end": 729.19,
   "text": "هی میره دست می‌کشه رو عکس شهدا رو دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 729.19,
   "end": 731.75,
   "text": "نمی‌دونم آیت الکرسی و اینا می‌کشه به سر و سینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 731.75,
   "end": 733.73,
   "text": "اصلا یه حال عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 733.73,
   "end": 736.61,
   "text": "مشخصه قشنگ رو زمین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 736.61,
   "end": 739.85,
   "text": "یعنی دارن بهش می‌فهمونن که آماده باش داری میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 739.85,
   "end": 741.97,
   "text": "و این ابتهاج نشانه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 741.97,
   "end": 745.73,
   "text": "برعکس کافر و مشرک و منافق و اینا یه حالت زیغ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 745.73,
   "end": 748.49,
   "text": "سینه ش، این جگرش می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 748.49,
   "end": 752.35,
   "text": "داغ می‌شه وجودش. یه حالت بدی براش پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 752.35,
   "end": 754.35,
   "text": "اصلا می‌گه نمی‌دونم چمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 754.35,
   "end": 756.35,
   "text": "برید کنار حوصله هیچکسو ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 756.35,
   "end": 759.65,
   "text": "برید. اصلا دورش جمع می‌شن می‌خوای یقه شو باز کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 759.65,
   "end": 762.53,
   "text": "اونایی که می‌فهمن این حال مثلا حالش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 762.53,
   "end": 767.23,
   "text": "پرت می‌کنه، داد می‌زنه، عصبی می‌شه، جیغ می‌زنه، فحش می‌ده، فحشای ناجور می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 767.23,
   "end": 768.93,
   "text": "یعنی کارت تمومه، آماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 768.93,
   "end": 771.87,
   "text": "خودشم نمی‌دونه چشه. این یه نشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 771.87,
   "end": 774.89,
   "text": "حالا نشونه‌های دیگه اگه دوست داشتید بچه‌های خوبی بودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 774.89,
   "end": 776.79,
   "text": "انشاالله بعدا نشونه‌های دیگم بهتون میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 776.79,
   "end": 779.05,
   "text": "اما یکی از مهم‌ترین نشونه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 779.05,
   "end": 781.51,
   "text": "هر وقت دیدید خیلی یه فرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 781.51,
   "end": 783.85,
   "text": "جدیدی بهت رخ داد، دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 783.85,
   "end": 788.91,
   "text": "مثل وقتی که زیارت امام حسین می‌کنی یا اشک عجیب برای امام حسین می‌ریزی، یه فرحی برات میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 788.91,
   "end": 791.53,
   "text": "یه فرح جدیدیه اینجوری به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 791.53,
   "end": 794.29,
   "text": "باید بچشیش. نمی‌شه من به شما بچشونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 794.29,
   "end": 797.13,
   "text": "باید اون لحظه رو بچشی. این دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 797.13,
   "end": 799.41,
   "text": "بدونیم که دیگه انشاالله لقاء نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 799.41,
   "end": 801.27,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 801.27,
   "end": 804.85,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}