 "chapters": [
  {
   "index": 0,
   "title": "## روایت هفدهم و لحظهٔ معاینه",
   "start": 12.7,
   "end": 151.32
  },
  {
   "index": 1,
   "title": "همین لحظهٔ معاینه است؛ هیچ بشارتی برای مجرمین نیست و حرف خوشایندی نمی‌شنوند. آیهٔ نود و هفت سورهٔ نساء نیز چنین است:",
   "start": 151.32,
   "end": 214.04
  },
  {
   "index": 2,
   "title": "آیهٔ پنجاه انفال نیز پیش‌تر آمد:",
   "start": 214.04,
   "end": 234.2
  },
  {
   "index": 3,
   "title": "## علم‌الیقین بدون عین‌الیقین و حق‌الیقین",
   "start": 234.2,
   "end": 303.32
  },
  {
   "index": 4,
   "title": "## فطرت الهی برداشتنی نیست",
   "start": 303.32,
   "end": 444.7
  },
  {
   "index": 5,
   "title": "## روایت معاینه؛ مؤمن و کافر",
   "start": 444.7,
   "end": 490.88
  },
  {
   "index": 6,
   "title": "## جبلّی؛ فطرت ثانویه",
   "start": 490.88,
   "end": 979.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 4.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.64,
   "end": 8.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.7,
   "end": 12.56,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.56,
   "end": 18.9,
   "text": "ما در روایت هفدهم باب چهارم کتاب الموت بودیم که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.9,
   "end": 22.38,
   "text": "معاینه حضرت فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.38,
   "end": 25.3,
   "text": "مهم لحظه معاینه است که چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.3,
   "end": 27.54,
   "text": "محتضر باز میشه به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.54,
   "end": 31.7,
   "text": "هم ملک رو میبینه هم ملکوت اما زبانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.7,
   "end": 35.32,
   "text": "قطع اینجا زبانش کار نمیکنه دیگه از کار افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.32,
   "end": 38.0,
   "text": "روح اومده از پنجه شروع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.0,
   "end": 40.54,
   "text": "قابض الارواح روح رو گرفته. این لحظه معاینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.54,
   "end": 45.18,
   "text": "روح رو گرفته آورده تا همه اعضا رو رد کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.18,
   "end": 49.82,
   "text": "اومده تا زبان رو هم رد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.82,
   "end": 53.0,
   "text": "فقط مونده چشمش و ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.0,
   "end": 61.08,
   "text": "مغزش و اینا که مغزش کار میکنه هنوز چشمش هم میبینه اما زبان روح دیگه نداره کار نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.08,
   "end": 64.54,
   "text": "که دیگه اونجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.54,
   "end": 66.42,
   "text": "ملکوت رو میبینه هم ملک رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.42,
   "end": 69.9,
   "text": "اینجا حضرت اینجا داره میفرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.9,
   "end": 72.36,
   "text": "مهم اونجاست که شما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.36,
   "end": 77.16,
   "text": "آنچه که بهت نشون میدن لحظه معاینه هنگام موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.16,
   "end": 80.1,
   "text": "تا نکردی اکراه داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.1,
   "end": 82.12,
   "text": "یا نه؟ لذت میبری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.12,
   "end": 83.92,
   "text": "خوشایند یا ناخوشایند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.92,
   "end": 86.22,
   "text": "اونجا رتبت معلوم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.22,
   "end": 89.26,
   "text": "حالا این ما اینجا بودیم. اینو مقدمه عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.26,
   "end": 95.16,
   "text": "حالا نکته ای که اینجا به ذهنم رسید از دل روایت اخذ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.16,
   "end": 100.04,
   "text": "اونم اینکه خب ما دیروز بر اساس اون آیه ای که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.04,
   "end": 104.12,
   "text": "ملائکه میان به صورت و به پشت مجرمین میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.12,
   "end": 108.34,
   "text": "اینا رو میبرن. لحظه موت با خودشون اینا رو میبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.34,
   "end": 110.84,
   "text": "اینا حاضر نیستن جون بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.84,
   "end": 113.76,
   "text": "یا این آیه یوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.76,
   "end": 119.04,
   "text": "یری عن الملائکه اون روزی که اینا میبینن ملائکه رو همین لحظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.04,
   "end": 123.8,
   "text": "لحظه معاینه است که لا بشری یومئذ للمجرمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.8,
   "end": 127.58,
   "text": "اونجا هیچ بشارتی برای مجرمین ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.58,
   "end": 130.02,
   "text": "یعنی حرف خوشایندی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.02,
   "end": 132.92,
   "text": "و یقولون هجراً محجورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.92,
   "end": 136.42,
   "text": "یا عرض شود ان الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.42,
   "end": 139.62,
   "text": "آیه نود و هفت سوره نساء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.62,
   "end": 142.02,
   "text": "اون قبلیه بیست و دو فرقان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 142.02,
   "end": 146.54,
   "text": "ان الذین تتوفاهم الملائکه ظالمی انفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 146.54,
   "end": 150.72,
   "text": "ملائکه وقتی میخوان اونایی که به نفسشون ظلم کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 150.72,
   "end": 155.24,
   "text": "و جانشون رو بگیرن. قالو فیم کنتم قالو کنا مستضعفین في الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.24,
   "end": 157.32,
   "text": "بهشون میگن کجا بودید؟ چه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 157.32,
   "end": 164.42,
   "text": "در چه حالی بودید؟ اونا میگن اونا که ظلم به نفس کردن میگن که کنا مستضعفین في الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.42,
   "end": 167.74,
   "text": "ما مستضعف بودیم تو زمین تحت ظلم و ستم واقع شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.74,
   "end": 171.62,
   "text": "دست خودمون نبود که. قالو یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 171.62,
   "end": 175.28,
   "text": "ملائکه میگن اعلم کن ارض الله واسعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.28,
   "end": 178.06,
   "text": "مگه ارض خدا زمین خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.06,
   "end": 181.84,
   "text": "وسعت نداشت؟ چرا فتا هاجروا فیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.84,
   "end": 184.44,
   "text": "چرا نرفتید هجرت کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 184.44,
   "end": 187.04,
   "text": "می رفتید جاهای دیگه از تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 187.04,
   "end": 189.34,
   "text": "یوغ ستم اینها خارج میشدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 189.34,
   "end": 191.94,
   "text": "که مجبور نشید به عصیان بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 191.94,
   "end": 195.62,
   "text": "فاعلیکم مأواهم جهنم وساءت مسيرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 195.62,
   "end": 199.36,
   "text": "مأوای اینا جهنمه به چه بد مسیری رو انتخاب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 199.36,
   "end": 208.02,
   "text": "اون آیه صد و پنج-- آیه پنجاه انفال هم که گفتیم و لو ترى اذ يتوفى الذين كفروا الملائكة یضربون وجوههم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.02,
   "end": 211.86,
   "text": "صورتشون میزنن و ادبارهم و ذوق عذاب الحریق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.86,
   "end": 214.04,
   "text": "از پشتم میزنن پشتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.04,
   "end": 218.32,
   "text": "با اهانت و بی احترامی اینا رو میبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.32,
   "end": 227.66,
   "text": "نکته ای که هست اینه که اگر این چنینه اینها اونچه که میبینن کراهت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.66,
   "end": 229.5,
   "text": "چون مؤمن خوشاینده براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.5,
   "end": 232.3,
   "text": "میبینه خوشاینده و جان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 232.3,
   "end": 237.7,
   "text": "اما کافر و مشرک و منافق، آدمای بی ایمان کراهت دارن از اون چیزی که میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.7,
   "end": 241.98,
   "text": "چی میبینن مگه؟ هرچی میبینن حق میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.98,
   "end": 245.14,
   "text": "ملکوت رو میبینن. ملائکه رو میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.14,
   "end": 246.92,
   "text": "حتی امیرالمؤمنین رو میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.92,
   "end": 251.08,
   "text": "مولا فرمود یا حارث همدان من یمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.08,
   "end": 253.52,
   "text": "يرنی. هرکس بمیره منو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.52,
   "end": 259.58,
   "text": "چه کافر باشه چه مؤمن. پس اونا مولا رو هم میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.58,
   "end": 265.0,
   "text": "درست شد؟ خب مگه مولا دیدنی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.0,
   "end": 274.26,
   "text": "چرا اینو بدشون میاد؟ و اگر بدشون میاد نکته دیگه چرا میگن رب ارجعنا خدا ما رو برگردون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.26,
   "end": 280.82,
   "text": "لعل اعمل صالحاً فيما تركنا تا عمل صالحی که ترک کردیم رو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.82,
   "end": 287.3,
   "text": "اصلاً عمل صالح رو اونجا میفهمن عمل صالح که معناش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.3,
   "end": 290.72,
   "text": "عملیست که تحت ولایت اهل بیت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.72,
   "end": 293.8,
   "text": "عمل صالح هر عملی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.8,
   "end": 299.14,
   "text": "اگر بدشون میاد چرا میگن برگردیم عمل صالح کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.14,
   "end": 304.86,
   "text": "اگر میگن برگردیم عمل صالح انجام بدیم یعنی فهمیدن که این راه به حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.86,
   "end": 309.54,
   "text": "پس چرا بدشون میاد؟ اینا چجوری با هم جمع میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.54,
   "end": 318.0,
   "text": "نکته اینجاست که اونجایی که اینها میگن رب ارجعنا ما رو برگردون تا عمل صالح انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.0,
   "end": 323.26,
   "text": "اولاً این علم اليقينه که به اونا میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.26,
   "end": 325.22,
   "text": "علم اليقين با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.22,
   "end": 328.76,
   "text": "عين اليقين و حق اليقين متفاوته قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.76,
   "end": 332.92,
   "text": "به اینا تا علم اليقين رو میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.92,
   "end": 335.5,
   "text": "یعنی علم پیدا میکنن به حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.5,
   "end": 338.88,
   "text": "به يقينيات، به عالم غیب و شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.88,
   "end": 344.22,
   "text": "علم پیدا میکنن. اما عين اليقين که ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.22,
   "end": 347.48,
   "text": "و بعد حق اليقين بچشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.48,
   "end": 350.66,
   "text": "بچشه. اون چشیدن رو ندارن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.66,
   "end": 352.92,
   "text": "یعنی ادراک عقلی و قلبی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.92,
   "end": 355.72,
   "text": "ادراک مثالی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.72,
   "end": 358.1,
   "text": "فقط فوقش. یعنی وهمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.1,
   "end": 362.3,
   "text": "عقلشون که اینا زایل شده. علم اليقينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.3,
   "end": 364.1,
   "text": "بر اساس علم اليقينشون میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.1,
   "end": 366.3,
   "text": "برای همینم میگن بر-- که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.3,
   "end": 370.5,
   "text": "قران میفرماید اگه برگردن باز همون آش و همون کاسه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.5,
   "end": 373.16,
   "text": "بر اساس علم، علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.16,
   "end": 376.8,
   "text": "علم چشیده شده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.8,
   "end": 381.92,
   "text": "این یک. دو، این نشون میده که بله فطرت الله، فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.92,
   "end": 384.34,
   "text": "چی؟ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.34,
   "end": 389.56,
   "text": "فطرت الله التي فطر الناس عليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.56,
   "end": 392.26,
   "text": "فطرت همه الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.26,
   "end": 395.46,
   "text": "همه مردم. حتی نمیگه آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.46,
   "end": 400.34,
   "text": "یعنی یه موجود خاص. نمیگه انسان که ارتقا یافته ناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.34,
   "end": 403.2,
   "text": "نه، همه جنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.2,
   "end": 406.46,
   "text": "ناس، جنس بشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.46,
   "end": 414.26,
   "text": "فطرت الهی داره. اینکه میگه رب الجعون یعنی اون فطرت الهیش دقت کنید خیلی نکته مهم و ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.26,
   "end": 417.62,
   "text": "فطرت الهیش هنوز نمرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.62,
   "end": 424.6,
   "text": "فطرت الهیش قبول میکنه که بله عمل صالحی هست یعنی به این علم میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.6,
   "end": 426.92,
   "text": "این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.92,
   "end": 431.98,
   "text": "فطرت الهی که کل مولود یولد على الفطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.98,
   "end": 441.08,
   "text": "تو مجمع البيان تفسیر مرحوم طبرسی یا طبری علیه رحمة و رضوان اومده همه موالید بر اساس فطرت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.08,
   "end": 444.54,
   "text": "این نمیشه بمیره کلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.54,
   "end": 449.08,
   "text": "این در حقیقت همون کانال وجودیه شخصه که حالا میخوای هر اسم روش بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.08,
   "end": 453.44,
   "text": "میخوای بذار رب وجودیش، اسم اعظم وجودیش، کانال وجودیش، سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.44,
   "end": 456.4,
   "text": "سر، سرش، حسه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.4,
   "end": 461.16,
   "text": "هر اسم بخوای که مرتبط با رب مطلق عالم نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.16,
   "end": 462.9,
   "text": "و وجود رو از اونجا میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.9,
   "end": 469.28,
   "text": "کانال و جدول وجودی خودشه که به دریای لایتناهی وجود حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.28,
   "end": 471.7,
   "text": "مرتبطه. اون برداشته شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.7,
   "end": 474.64,
   "text": "اون اگه برداری که باید معدوم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.64,
   "end": 479.82,
   "text": "اصلاً نمیشه همچین چیزی. یعنی نمیشه هیچ جزئی رو از کل جدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.82,
   "end": 483.1,
   "text": "هیچ چیزی به کل پیاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.1,
   "end": 486.28,
   "text": "گسیخته از ملکوت و حقیقت خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.28,
   "end": 488.86,
   "text": "بیدهی ملکوت کل شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.86,
   "end": 492.5,
   "text": "والیه terugون. پس بفرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.5,
   "end": 495.62,
   "text": "بله بفرما. اگر هیچ چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.62,
   "end": 500.72,
   "text": "گسیخته از حقیقت نیست و به تمامه پیاده نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.72,
   "end": 502.3,
   "text": "یه ربطی با حقیقت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.3,
   "end": 510.3,
   "text": "هر شیعی، هر که این‌ها ظهور اسماء الله‌اند، یکیش هم حضرت عالی، یه ربطی با حقیقت عالم داری که هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.3,
   "end": 513.46,
   "text": "یه ربطی با اسم الحي داری که حیات داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.46,
   "end": 516.96,
   "text": "یه ربطی با اسم المرید داری که اراده داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.96,
   "end": 522.24,
   "text": "یه ربطی با اسم القدیر حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.24,
   "end": 525.4,
   "text": "داری که قدرت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.4,
   "end": 531.2,
   "text": "یه ربطی با اسم السميع البصير داری که شنوایی و بینایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.2,
   "end": 534.1,
   "text": "ربطی با اسم المتكلم داری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.1,
   "end": 538.6,
   "text": "تکلم می‌کنی باطنتو می‌تونی آشکار کنی و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.6,
   "end": 542.12,
   "text": "درست شد؟ اون‌ها هم درسته کافرند، مشرک‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.12,
   "end": 548.36,
   "text": "و منظره‌هایی که می‌بینن امیرالمؤمنین علیه الصلاة والسلام رو می‌بینن ناخوشاینده براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.36,
   "end": 551.6,
   "text": "درست شد؟ که حالا الان میگم چرا ناخوشاینده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.6,
   "end": 555.14,
   "text": "اما چون فطرت الهی رو نمیشه برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.14,
   "end": 558.54,
   "text": "میشه روش غبار و حجاب گناه و معصیت گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.54,
   "end": 561.46,
   "text": "مثل یه سکه‌ای که روش رو لجن گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.46,
   "end": 564.98,
   "text": "میشه این کارو کرد. ولی اون سکه هر کارش کنی سکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.98,
   "end": 568.14,
   "text": "طلاست. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.14,
   "end": 571.16,
   "text": "بر اثر اون ذات فطری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.16,
   "end": 574.42,
   "text": "که خداجویه اون میگه رب الجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.42,
   "end": 578.56,
   "text": "آدمارو برگردون. اما چرا مولا رو می‌بینه بدش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.56,
   "end": 582.76,
   "text": "چرا منظره‌هایی که می‌بینه براش ناخوشاینده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 582.76,
   "end": 586.3,
   "text": "چون توی این روایت ببینید این قسمتشو یه بار دیگه بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.3,
   "end": 590.06,
   "text": "میفرماید عند المعاینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.06,
   "end": 593.18,
   "text": "بحث حاج احمد آقا، آقا مصطفی بحث معاینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.18,
   "end": 597.48,
   "text": "اون لحظه‌ای که چشم هم ملک رو می‌بینه هم ملکوت رو محتضر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.48,
   "end": 600.16,
   "text": "همون حدیث قبلی رو داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.16,
   "end": 605.44,
   "text": "میفرماید اذا رأى ما يحبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.44,
   "end": 608.76,
   "text": "فليس شیء احب الیه من ان يتقدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.76,
   "end": 611.84,
   "text": "میگه وقتی می‌بینه اون چیزی که دوست داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.84,
   "end": 615.38,
   "text": "دیگه هیچ چیزی براش به خوشایندی این نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.38,
   "end": 618.86,
   "text": "و عاشق لقاء الله میشه. این برای موئمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.86,
   "end": 624.3,
   "text": "اما کافر چی؟ کافر می‌بینه اکراه داره، کراهت داره، بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 624.3,
   "end": 627.54,
   "text": "اهل بیت-- امیرالمؤمنین رو به اون‌ها نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 627.54,
   "end": 630.54,
   "text": "به مؤمن چهارده معصوم، به کفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 630.54,
   "end": 633.22,
   "text": "فقط مولا رو. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 633.22,
   "end": 637.14,
   "text": "ولی بدش میاد. خب اگر بدش میاد چرا رب الجعون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.14,
   "end": 640.24,
   "text": "جوابشو دادیم دیگه. چون فطرت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.24,
   "end": 641.96,
   "text": "فطرت الله التي فطر الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.96,
   "end": 646.8,
   "text": "اون کانال ارتباطیش با حقیقت عالم برداشته نشده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.8,
   "end": 650.02,
   "text": "که معدوم بشه کلاً. نه نمیشه محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 650.02,
   "end": 653.5,
   "text": "لذا از همون طریق علم به یقین پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.5,
   "end": 655.64,
   "text": "میگه خب بنو برگردون که کار خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.64,
   "end": 661.6,
   "text": "اما چون نچشیده به حق بالیقین نرسیده برش گردونن باز همون آش و همون کاسه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.6,
   "end": 670.08,
   "text": "اما چرا اگر میگه رب الجعون اگر علم به حقیقت یعنی علم اليقين رو رسیده که این آقا به حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 670.08,
   "end": 673.68,
   "text": "عالم خدایی داشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 673.68,
   "end": 676.2,
   "text": "این‌ها چرا از مولا بدش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 676.2,
   "end": 678.38,
   "text": "چرا از ملائکه بدش میاد؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 678.38,
   "end": 682.1,
   "text": "حاضر نیست به لقاء خدا برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.1,
   "end": 684.74,
   "text": "این جواب اینجا رو چی بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.74,
   "end": 687.94,
   "text": "یه آیه ای در سوره یاسین این جواب رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.94,
   "end": 694.06,
   "text": "میفرماید که ولقد اضل منکم جبلا کثیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.06,
   "end": 698.66,
   "text": "شیطان به تحقیق جبلا کثیرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.66,
   "end": 703.96,
   "text": "از طریق جبلی شما کثیرا بسیاری از شما رو اضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.96,
   "end": 709.2,
   "text": "گمراه کرد. جبلی فرقش با فطرت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.2,
   "end": 713.1,
   "text": "که شیطان از طریق جبلی میاد انسان‌ها رو گمراه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 713.1,
   "end": 719.02,
   "text": "این جواب اون سؤاله. چرا این آقا اگه میگه رب الجعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 719.02,
   "end": 724.52,
   "text": "چرا منظره‌ای که از ملکوت براش باز شده به حالت معاینه بدش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 724.52,
   "end": 730.14,
   "text": "اینو داریم جواب میدیم به جهت اینکه اون فطرت اولیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 730.14,
   "end": 734.78,
   "text": "بر اثر اصرار بر معاصی و گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.78,
   "end": 738.1,
   "text": "بدلش کرده به فطرت ثانویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 738.1,
   "end": 740.48,
   "text": "فطرت ثانویه رو بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.48,
   "end": 747.04,
   "text": "جبلی. لذا اونجا قرآن می‌فرماید \"و لَقَدْ أَضَلَّ مِنكُمْ جَبَلًّا كَثِيرًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 747.04,
   "end": 750.12,
   "text": "شیطان از طریق جبلی میاد گمراه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 750.12,
   "end": 754.42,
   "text": "یعنی کسی که فطرتش رو، فطرت اولیش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 754.42,
   "end": 757.56,
   "text": "بدل کرده به فطرت ثانویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 757.56,
   "end": 761.64,
   "text": "یعنی انقدر زشتی روی زشتی ملکات نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 761.64,
   "end": 764.68,
   "text": "که ملاط صور و اشکال برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 764.68,
   "end": 769.4,
   "text": "اون ملکات نفسش که از اصرار بر اعمال در وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 769.4,
   "end": 775.98,
   "text": "ایجاد می‌شه رو این ملکات نفس رو انقدر خبیثه و قبیحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.98,
   "end": 779.8,
   "text": "ایجاد کرده و ایجاد کرده در وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.8,
   "end": 782.26,
   "text": "بدل شده فطرتش به فطرت ثانویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 782.26,
   "end": 784.8,
   "text": "دیگه از حقایق بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.8,
   "end": 789.18,
   "text": "اما این دیگه مطلق نیست که بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.18,
   "end": 792.0,
   "text": "مطلقاً بدش بیاد، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 792.0,
   "end": 794.66,
   "text": "علمشو پیدا می‌کنه. مطلق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 794.66,
   "end": 796.4,
   "text": "علم اليقين رو بهش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 796.4,
   "end": 801.24,
   "text": "می‌فهمه این راه به حقه. اما به جهت اصرارش بر گناهان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.24,
   "end": 806.46,
   "text": "در حقیقت اینطوری بگیم میل دلش عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 806.46,
   "end": 809.14,
   "text": "مبدأ میلش احسن. ذائقه‌ش عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 809.14,
   "end": 810.86,
   "text": "مبدأ میلش عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 810.86,
   "end": 813.52,
   "text": "میلش به چه چیزیست؟ تشخیص میده، می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 813.52,
   "end": 816.52,
   "text": "لذا میگه رب رجعونی. می‌فهمه این راه به حق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 816.52,
   "end": 819.58,
   "text": "این آقا به حق بوده. منو برگردون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 819.58,
   "end": 823.22,
   "text": "تا منم جزو محبین آقا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 823.22,
   "end": 829.3,
   "text": "اما چون مبدأ میلش عوض شده، ذائقه‌ش عوض شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 829.3,
   "end": 832.4,
   "text": "بدش میاد آقا. بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 832.4,
   "end": 835.6,
   "text": "برای همین نکته، نکته آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 835.6,
   "end": 839.28,
   "text": "ما باید به شدت مراقب ذائقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 839.28,
   "end": 843.66,
   "text": "دلمون و مبدأ میل وجودیمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 843.66,
   "end": 847.1,
   "text": "به چه چیزی میل می‌کنیم؟ رغبت‌مون به چه چیزهایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 847.1,
   "end": 849.02,
   "text": "اینو خیلی باید مراقبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 849.02,
   "end": 852.28,
   "text": "اون لحظه معاینه این حرف اول رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 852.28,
   "end": 856.38,
   "text": "در حقیقت اونجا نمیشه فیلم بازی کرد، لغلغه زبان، أشهد أن لا إله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 856.38,
   "end": 859.64,
   "text": "این حرفا نیست. حقایق وجودیت می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 859.64,
   "end": 862.16,
   "text": "از چی لذت می‌بردی؟ به چی رغبت داشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 862.16,
   "end": 865.34,
   "text": "به چی میل داشت دلت؟ همونا آشکار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 865.34,
   "end": 871.7,
   "text": "اگه به این آقایی که می‌فرمود مَّ یَمُوتِ یَرَنِی، به آقا امیرالمؤمنین حضرت ولی عصر علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 871.7,
   "end": 875.36,
   "text": "میل داشتی، رغبت داشتی، محبت داشتی، عشق داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 875.36,
   "end": 879.0,
   "text": "اونجا با رضا و رغبت حاضری جون بدی لحظه معاینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.0,
   "end": 882.92,
   "text": "اما اگر نداشتی با اکراه جون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 882.92,
   "end": 886.7,
   "text": "ولو علم اليقين رو بهت بدن بفهمی این آقا به حق بوده اما با اکراه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 886.7,
   "end": 891.2,
   "text": "حاضر نیستی جون بدی. ملائکه می‌زنن پشت سرت، می‌زنن تو صورتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 891.2,
   "end": 896.68,
   "text": "آیه‌شم که خوندیم. پس این دو تا سؤال رو ما الان جواب دادیم که حیف بود ازش بگذریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 896.68,
   "end": 899.38,
   "text": "بریم سراغ روایت بعدی. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 899.38,
   "end": 901.34,
   "text": "سؤالو دوباره بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 901.34,
   "end": 903.5,
   "text": "که چرا اگر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 903.5,
   "end": 910.34,
   "text": "بدشون میاد از مولا بدشون میاد اکراه دارن چرا میگن رب رجعونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 910.34,
   "end": 913.78,
   "text": "حالا ما رو برگردون تا عمل صالح انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 913.78,
   "end": 917.36,
   "text": "اگه بدشون میاد از این راه. مولا صراط مستقیمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 917.36,
   "end": 922.0,
   "text": "حقیقت صراط مستقیم. وقتی میگه اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 922.0,
   "end": 926.44,
   "text": "یعنی خدایا ما رو هدایت کن به راه امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 926.44,
   "end": 931.32,
   "text": "اینو جواب دادیم. به جهت علم اليقينه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 931.32,
   "end": 938.78,
   "text": "و فطرت الهی که برداشته شدنی ذاتاً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 938.78,
   "end": 942.7,
   "text": "و سؤال بعدی چی؟ اینکه اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 942.7,
   "end": 946.44,
   "text": "تشخیص میدن که این راه به حقه چرا از مولا بدشون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 946.44,
   "end": 949.56,
   "text": "گفتیم جبلیه. فطرت ثانویه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 949.56,
   "end": 952.84,
   "text": "بر اثر اصرار بر گناه و معصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 952.84,
   "end": 955.48,
   "text": "دچار فطرت ثانویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 955.48,
   "end": 958.44,
   "text": "و جبلی شدن. البته از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 958.44,
   "end": 961.38,
   "text": "سوءاستفاده نشه، تختی-- سوئیچ نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 961.38,
   "end": 964.28,
   "text": "بعدا این قطعه رو بردارن بگن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 964.28,
   "end": 966.36,
   "text": "بگن که لحظه معاینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 966.36,
   "end": 974.16,
   "text": "هرکس که بدش میاد از حضرت مولا به خاطر جبلیه رئیس سازمان صداوسیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 974.16,
   "end": 979.96,
   "text": "والحمد لله رب العالمين صلوات بفرستین. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}