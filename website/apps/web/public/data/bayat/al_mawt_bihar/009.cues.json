 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت سوم؛ باز و بسته شدن دهان هنگام جان‌دادن",
   "start": 10.9,
   "end": 30.92
  },
  {
   "index": 1,
   "title": "## شباهت با خواب؛ دهشت مؤمن و وحشت منافق",
   "start": 30.92,
   "end": 166.3
  },
  {
   "index": 2,
   "title": "## معانی‌الأخبار؛ الموت هو النوم",
   "start": 166.3,
   "end": 186.38
  },
  {
   "index": 3,
   "title": "## قابض‌الأرواح آینه است؛ یا حارث همگان مرا می‌بینند",
   "start": 186.38,
   "end": 396.56
  },
  {
   "index": 4,
   "title": "## ترس از مرگ پیش از معاینه نفاق نیست؛ بحار ج۶ ص۱۲۶",
   "start": 396.56,
   "end": 539.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.82,
   "end": 3.8,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.8,
   "end": 8.24,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.24,
   "end": 10.9,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.9,
   "end": 18.02,
   "text": "در ادامه روایت سوم از کتاب الموت نکته‌ی دیگری را هم عرض کنیم انشاالله ردش نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 23.08,
   "text": "عرض کردیم اگر چنانچه یادتون باشه خاطرتون باشه که در اون روایت شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.08,
   "end": 29.06,
   "text": "حضرت امام صادق سلام الله علیه فرمودند که می‌بینی که میت هنگامی که داره جون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.06,
   "end": 30.92,
   "text": "دهانش رو باز و بسته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.92,
   "end": 35.38,
   "text": "این باز و بسته کردن دهان دو یا سه بار که حضرت فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.38,
   "end": 39.02,
   "text": "نشانه‌ی اینه که به حالت معاینه رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.02,
   "end": 42.8,
   "text": "یعنی لحظه‌ایست که هم داره این دنیا رو می‌بینه هم اون دنیا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.8,
   "end": 46.34,
   "text": "به یک معنا ملک و ملکوت رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.34,
   "end": 50.9,
   "text": "هم چشمش به ظاهر بازه هم به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.9,
   "end": 58.96,
   "text": "و البته اونچه که می‌بینه خیلی حرف خواهرش زده شده که حالا به مرور انشاالله خواهیم دید چی به نشونش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.96,
   "end": 63.86,
   "text": "در هر حال مهم اینه که بدونیم اونجا چیزهایی رو می‌بینه لذا دهانش باز و بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.86,
   "end": 68.04,
   "text": "گاهی اوقات خرخر می‌کنه صداش یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.04,
   "end": 70.66,
   "text": "یه صداهای عجیب و غریبی از گلو بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.66,
   "end": 72.94,
   "text": "اینا همش حساب کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.94,
   "end": 75.72,
   "text": "مثل وقتی که ما خوابیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.72,
   "end": 79.0,
   "text": "حتی گاهی اوقات می‌شه که انسان خواب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.0,
   "end": 82.18,
   "text": "خوب داره می‌بینه. مناظر خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.18,
   "end": 84.22,
   "text": "داره می‌بینه. از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.22,
   "end": 88.42,
   "text": "عظمت مثلاً امام که در خواب دیده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.42,
   "end": 92.26,
   "text": "حرم امام که دیده از اون عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.26,
   "end": 95.76,
   "text": "چنان گرفتار دهشتی می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.76,
   "end": 100.4,
   "text": "یه دفعه خود امام می‌فرمود اینجا امام صادق، امام باقر می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.4,
   "end": 102.36,
   "text": "خرخر می‌کنه دفعه می‌پره از خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.36,
   "end": 105.24,
   "text": "برای ما زیاد شاید اینطور پیش اومده باشه هممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.24,
   "end": 110.22,
   "text": "توجه نداریم که اهل بیت به این‌ها هم توجه داشتن و در رابطه با این‌ها هم حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.22,
   "end": 112.78,
   "text": "حالا فرق وحشت با دهشت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.78,
   "end": 114.96,
   "text": "مؤمن دهشت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.96,
   "end": 120.52,
   "text": "چون حق رو می‌بینه و از عظمت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.52,
   "end": 122.48,
   "text": "حالت خشیت بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.48,
   "end": 128.46,
   "text": "اما اونوری نه. منافق و مشرک و کافر و این‌ها وحشت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.46,
   "end": 132.1,
   "text": "اینا با هم فرق می‌کنند. یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.1,
   "end": 135.48,
   "text": "وقتی که می‌بینه از یک چیز بیخود وحشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.48,
   "end": 138.74,
   "text": "نباید وحشت کنه. مثلاً اگه کسی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.74,
   "end": 142.42,
   "text": "ما از یک از تاریکی بترسیم به این میگن وحشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.42,
   "end": 145.78,
   "text": "این که دهشت نیست که. اما در روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 145.78,
   "end": 149.06,
   "text": "خورشید رو نگاه کنیم از عظمت خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.06,
   "end": 151.4,
   "text": "لرزه بیفتیم. این می‌شه دهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.4,
   "end": 154.32,
   "text": "دهشت خوبه، درسته و باید هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.32,
   "end": 157.92,
   "text": "اون حالتی که برای مؤمن رخ میده هنگام مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.92,
   "end": 159.52,
   "text": "دهشته نه وحشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.52,
   "end": 163.14,
   "text": "برای کافر و منافق و این‌ها وحشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.14,
   "end": 165.56,
   "text": "و البته این رو عرض کنم که حالا چـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 165.56,
   "end": 168.74,
   "text": "این که ما شباهت می‌گیریم با خواب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.74,
   "end": 175.86,
   "text": "بر اساس روایته. مثلاً در کتاب معانی الاخبار صفحه دویست و هشتاد و نه، امام باقر سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.86,
   "end": 178.68,
   "text": "پیرامون موت ازشون سؤال شد آقا موت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.68,
   "end": 182.32,
   "text": "چقدر شیرین حضرت تعبیر کردن \"هو النوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.32,
   "end": 185.3,
   "text": "موت \"هو النوم\" همون خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.3,
   "end": 188.7,
   "text": "البته \"الذي يأتيکم کل لیلة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.7,
   "end": 191.54,
   "text": "اون خواب هر شب میاد به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.54,
   "end": 193.94,
   "text": "اما \"الا انه\" اما اون، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 193.94,
   "end": 199.38,
   "text": "موت که ما داریم درباره‌ش حرف می‌زنیم خوابیه که \"انه طويل مدته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.38,
   "end": 203.44,
   "text": "لا ينتبه منه الا يوم القيامة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 203.44,
   "end": 206.86,
   "text": "طولانیه. یه خواب طولانیه و بیدار نمی‌شی ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 206.86,
   "end": 212.4,
   "text": "مگر روز قیامت. اون خواب طولانی، اون حالت‌هایی که در خواب ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.4,
   "end": 215.8,
   "text": "حالا ما در خواب چه می‌بینیم که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 215.8,
   "end": 218.62,
   "text": "اونچه که به قول علامه بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.62,
   "end": 222.12,
   "text": "که مطلقاً انشای نفس ناطقمونه در خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.12,
   "end": 226.8,
   "text": "هرچی می‌بینیم در درون خودمون داریم انشا می‌کنیم، می‌نویسیم این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.8,
   "end": 230.2,
   "text": "لذا انشای خودمونه. انشا، می‌نویسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.2,
   "end": 233.44,
   "text": "اگر آدم خوبی هستیم خوبی می‌نویسیم و فوقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 233.44,
   "end": 235.58,
   "text": "دهشت می‌کنیم. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 235.58,
   "end": 242.12,
   "text": "خرخری کنیم دهنمون باز و بسته بشه اون لحظه چیزهای خوب می‌بینیمو اما اونوری‌ها نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.12,
   "end": 246.32,
   "text": "اونا وحشت می‌کنند. انشا \"اقرأ کتابک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.32,
   "end": 249.52,
   "text": "ها؟ \"اقرأ کتابک\". قرآن میگه کتاب خودت رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.52,
   "end": 253.24,
   "text": "امروز یه حدیث شیرین دیدم که ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.24,
   "end": 257.54,
   "text": "و اوراق دفتر زندگی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.54,
   "end": 259.6,
   "text": "ایام، امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 259.6,
   "end": 262.0,
   "text": "یه ورق کتاب زندگی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 262.0,
   "end": 264.96,
   "text": "می‌فرماید با اعمال شایسته اینا رو ابدی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 264.96,
   "end": 269.24,
   "text": "بعد قراره اینا رو بخونی. لحظه مرگ خودت خودت رو می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 269.24,
   "end": 274.68,
   "text": "اصلاً همونطور که قبلاً پیرامون حقیقت قابض الارواح سخن گفتیم عزیز دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 274.68,
   "end": 281.28,
   "text": "اگر چنانچه یادتون باشه گفتیم چگونه‌ست که یک وجود واحده یکی ازش می‌ترسه یکی خوشش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.28,
   "end": 284.1,
   "text": "مگر یک وجود واحد نیست؟ چرا حدیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 284.1,
   "end": 287.66,
   "text": "برای بعضیا خیلی زیبا روه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 287.66,
   "end": 290.34,
   "text": "عزرائیل قابض الارواح علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 290.34,
   "end": 293.22,
   "text": "برای بعضیا خیلی وحشتناکه این چهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 293.22,
   "end": 295.48,
   "text": "مگر یک وجود واحد نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 295.48,
   "end": 300.92,
   "text": "اون آینه‌ایست که من و شما خودمون رو در او می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 300.92,
   "end": 308.98,
   "text": "او حقیقتی‌ست که من و شما لحظه مرگ کتاب وجود خودمون رو سطر سطر \"نون والقلم وما یسترون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.98,
   "end": 311.54,
   "text": "در اون نوشته می‌بینیم. یک آینه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.54,
   "end": 315.98,
   "text": "اگر نوشته‌ها زیباست، خوشه، خرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 315.98,
   "end": 318.8,
   "text": "عرض شود نورانیه، سرسبزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 318.8,
   "end": 323.76,
   "text": "زیباست خب اون هرچی می‌بینی زیبایی می‌بینی کیف می‌کنی لذا حاضری جون بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.76,
   "end": 330.18,
   "text": "اما اگر خدای نکرده سیاهه، تاریکه، بوی بد میده، وحشتناکه، بوی عذاب میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.18,
   "end": 334.02,
   "text": "نشان عذاب داره از همونجا ترس و وحشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.02,
   "end": 337.64,
   "text": "شروع می‌شه. همش بستگی به خودت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 337.64,
   "end": 341.28,
   "text": "به خودم داره که من چی‌ام که حالا چی می‌خوام ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.28,
   "end": 347.7,
   "text": "این که فرمود \"یا حارث اندی میموت یرنی\" هرکی باشه منو می‌بینه ما-- امیرالمؤمنین فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.7,
   "end": 351.12,
   "text": "چه مؤمن و چه مؤمن و باشه منافق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.12,
   "end": 353.82,
   "text": "یعنی چی پس هر دو، هر دو امیرالمؤمنین رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.82,
   "end": 358.4,
   "text": "چه شکلی می‌بینن؟ نسبت به اعمال خودشون امیرالمؤمنین رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.4,
   "end": 360.44,
   "text": "لذا اون می‌ترسه این خوشش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.44,
   "end": 362.96,
   "text": "این با شوق میره به سمت م-موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 362.96,
   "end": 365.28,
   "text": "این نه، با اکراه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 365.28,
   "end": 368.22,
   "text": "و به زور می‌برنش منافق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 368.22,
   "end": 371.42,
   "text": "اما همونطور که قبلاً عرض شد مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 371.42,
   "end": 375.76,
   "text": "بهش-- بالاخره خدا چیزهایی رو نشونش میده که راضیش کنه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 375.76,
   "end": 384.36,
   "text": "خوشش میاد لذت می‌بره. آقا فرمودین دهنشو که باز و بسته می‌کنه دهنش باز مونده از این الطاف الهی، از درجات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.36,
   "end": 392.54,
   "text": "و دیگه منتهی الیه اش از دیدار وجه خدا امام عصرش رو دیده به قول ماها خودمونی عرض کنیم آب دهنش راه افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.54,
   "end": 396.28,
   "text": "بگه زودتر منو ببرید. اینطوری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.28,
   "end": 401.42,
   "text": "لذا از امام باقر صلوات الله علیه و از امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 401.42,
   "end": 403.72,
   "text": "همین سؤال پرسیده شده که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 403.72,
   "end": 407.7,
   "text": "ما بالاخره این ترس از مرگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.7,
   "end": 409.3,
   "text": "الان خیلیامون از مرگ می‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.3,
   "end": 412.04,
   "text": "این ترس از مرگ آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.04,
   "end": 415.36,
   "text": "نفاقه یا نه؟ آیا نفاقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.36,
   "end": 419.78,
   "text": "حالا جوابش رو بذارید از رو خود حدیث براتون بخونم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.78,
   "end": 424.28,
   "text": "خیلی شیرین که. از کتاب بهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.28,
   "end": 427.14,
   "text": "جلد شش، صفحه صد و بیست و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.14,
   "end": 429.66,
   "text": "اما-امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.66,
   "end": 435.96,
   "text": "فرمودن که از امام صادق نقل شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.96,
   "end": 442.22,
   "text": "یکی میگه من گفتم به حضرت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.22,
   "end": 445.14,
   "text": "ما شنیدیم از شما که هرکس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.14,
   "end": 449.72,
   "text": "اه خدا رو-- لقاء خدا رو دوست داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.72,
   "end": 454.08,
   "text": "خدا هم لقاء اون رو ملاقات اون رو دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.08,
   "end": 462.38,
   "text": "و هرکسی که بدش میاد از دیدار خدا چون مرگ ملاقات خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.38,
   "end": 465.94,
   "text": "خدا هم بدش میاد از دیدار او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.94,
   "end": 469.66,
   "text": "لحظه مرگ رخ میده. گفت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.66,
   "end": 472.18,
   "text": "حضرت فرمود بله همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.18,
   "end": 477.48,
   "text": "من گفتم به خدا قسم که ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.48,
   "end": 480.5,
   "text": "ااا دوست نداریم موت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.5,
   "end": 484.52,
   "text": "یعنی حالا که ما موت رو دوست نداریم یه حالت اکراه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.52,
   "end": 486.32,
   "text": "یعنی پس خدا بدش میاد از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.32,
   "end": 488.6,
   "text": "یعنی ما از موت بدمون میاد خدا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.6,
   "end": 498.84,
   "text": "حضرت فرمودن این مال قبل از مرگ نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.84,
   "end": 504.84,
   "text": "اگر الان می‌بینیم مؤمنی خیلی اکراه داره از مرگ به خاطر نفاقش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 504.84,
   "end": 508.26,
   "text": "اون لحظه اینجا رو خوب دقت کنید نکته آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.26,
   "end": 512.26,
   "text": "اون لحظه‌ای که حال-- حضرت اینجا می‌فرماید لحظه معاینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.26,
   "end": 514.5,
   "text": "یعنی همین ور رو می‌بینه همون ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.5,
   "end": 517.6,
   "text": "چشم باز شد. اون لحظه اگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.6,
   "end": 522.64,
   "text": "اون لحظه اگر می‌ترسه بدش میاد دوست نداره این نشانه نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.64,
   "end": 526.24,
   "text": "لذا لحظه مرگ خیلی لحظه حساسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.24,
   "end": 529.94,
   "text": "لذا بزرگ‌ترین دعا برای هممون عاقبت به خیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.94,
   "end": 533.78,
   "text": "انشاالله به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.78,
   "end": 539.94,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}