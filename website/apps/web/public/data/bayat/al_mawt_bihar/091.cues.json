 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ روایت پنجم؛ ولایت شیطان و آیهٔ نساء",
   "start": 0.38,
   "end": 85.74
  },
  {
   "index": 1,
   "title": "## سه لام تأکید؛ اضلال، امنیه، امر",
   "start": 85.74,
   "end": 146.44
  },
  {
   "index": 2,
   "title": "## تغییر خلق الله و خسران مبین",
   "start": 146.44,
   "end": 405.56
  },
  {
   "index": 3,
   "title": "## قاعدهٔ اضلال و فطرت",
   "start": 405.56,
   "end": 573.3
  },
  {
   "index": 4,
   "title": "برخی گفته‌اند شکل فطرت عوض می‌شود؛ قرآن شاکله می‌گوید:",
   "start": 573.3,
   "end": 593.42
  },
  {
   "index": 5,
   "title": "## لأمنینهم و محک آرزو",
   "start": 593.42,
   "end": 694.36
  },
  {
   "index": 6,
   "title": "## محک خانوادگی آرزو",
   "start": 694.36,
   "end": 864.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.1,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.1,
   "end": 7.0,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.0,
   "end": 13.2,
   "text": "فرجهم. بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.2,
   "end": 16.08,
   "text": "السلام علیک يا داعي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.08,
   "end": 18.9,
   "text": "و رباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.9,
   "end": 22.86,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.86,
   "end": 25.96,
   "text": "خیلی خیلی تبریک میگم این ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.96,
   "end": 28.52,
   "text": "فرخنده پر پر نور رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.52,
   "end": 30.46,
   "text": "بسیار ایام خاصی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.46,
   "end": 34.9,
   "text": "اون‌هایی که چله موسوی گرفتن این ده روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.9,
   "end": 37.78,
   "text": "تکمیل می‌شه کارشون خوشا به سعادتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.78,
   "end": 41.7,
   "text": "در بین احراج میرن به اوج می‌رسن نتیجه می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.7,
   "end": 46.3,
   "text": "خصوصاً امروز روز اول این دهه آخر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.3,
   "end": 49.12,
   "text": "ایام معدودات هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.12,
   "end": 53.4,
   "text": "ان‌شاءالله سخن می‌گیم دربارش که چه ایام خاصی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.4,
   "end": 58.54,
   "text": "که امروز هم که میلاد و تزویج حضرت زهرا ام المؤمنین علیهم الصلاة والسلام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.54,
   "end": 65.08,
   "text": "ان‌شاءالله بر همتون پر از خیر و برکت و مبارک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.08,
   "end": 67.7,
   "text": "در روایت پنجم بودیم از باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.7,
   "end": 71.24,
   "text": "چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.24,
   "end": 79.36,
   "text": "دلم نمیاد که راحت از این روایت رد شیم چون متأسفانه درگیریم هممون، گرفتاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.36,
   "end": 85.74,
   "text": "در ولایت شیطان مثل تار عنکبوتی گرفتاریم و خبر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.74,
   "end": 88.62,
   "text": "یکی از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.62,
   "end": 92.64,
   "text": "به موضوع ولایت شیطان پرداخته آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.64,
   "end": 96.44,
   "text": "صد و نوزده سوره نساست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.44,
   "end": 100.56,
   "text": "همونطور که گفتیم نتیجه تصرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.56,
   "end": 104.84,
   "text": "ولایت شیطان می‌شه فراموشی موت و مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.84,
   "end": 111.28,
   "text": "و از نشانه‌هاش که آدم شقی و بدبخت می‌شه آرزوهای طولانیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.28,
   "end": 117.92,
   "text": "فراموشی مرگ. مخصوصاً جالبه که تو همین آیه هم به آرزوهای طولانی باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.92,
   "end": 122.22,
   "text": "تصریح شده. آیه از لسان شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.22,
   "end": 129.68,
   "text": "یادتون عرض کردم صحبت‌های این خبیث رو بریم ببینیم تو قرآن با خدا صحبت‌هایی که کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.68,
   "end": 133.94,
   "text": "وعده‌هایی که داده. میگه ولا ode-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.94,
   "end": 141.02,
   "text": "لام‌هایی که اول این سه تا فعلی که الان می‌خونم اومده یعنی قطعاً یعنی قصه خیلی جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.02,
   "end": 143.84,
   "text": "خیلی جدیه. ما جدی نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.84,
   "end": 146.44,
   "text": "ولا اضلنهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.44,
   "end": 149.5,
   "text": "شیطان میگه من اینا رو گمراه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.5,
   "end": 153.44,
   "text": "گمراهشون می‌کنم صد در صد قطعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.44,
   "end": 156.26,
   "text": "ولا امنینهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.26,
   "end": 159.68,
   "text": "این‌ها رو در آرزو می‌افکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.68,
   "end": 163.0,
   "text": "می‌ندازمشون به آرزو. هی آرزو، آرزو، آرزو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.0,
   "end": 164.68,
   "text": "ای کاش اینو داشتم، اونو داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.68,
   "end": 166.48,
   "text": "هرچی می‌بینه آرزو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.48,
   "end": 169.88,
   "text": "تو روایت پنجم هم همین اومده بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.88,
   "end": 173.04,
   "text": "که آرزو تو چشماش می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.04,
   "end": 175.36,
   "text": "و این باعث می‌شه که از موت غافل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.36,
   "end": 180.68,
   "text": "خودشم خبر نداره رفته، رفته داره میره تحت تصرف ولایت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.68,
   "end": 184.7,
   "text": "ولا آمرا نه. ببینید پله‌هایی رو عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.7,
   "end": 188.74,
   "text": "بر اساس قرآن خطبه خطبه قدم به قدم شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.74,
   "end": 191.5,
   "text": "میاد جلو و ما رو می‌بره، اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.5,
   "end": 199.62,
   "text": "اول که به یکبار آمرا نهوم نیست که من به اونا امر می‌کنم تحت امر شیطان که قرار نمی‌گیری اول چون فطرت داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.62,
   "end": 202.58,
   "text": "فطرت الهی داری. اول لاضل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.58,
   "end": 205.04,
   "text": "لاضلنهم میاد گمراه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.04,
   "end": 208.1,
   "text": "اضلال قاعده اضلال که حالا دربارش حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.1,
   "end": 210.86,
   "text": "بعد ولا امنینهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.86,
   "end": 213.5,
   "text": "می‌ندازه انسان رو به آرزو و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.5,
   "end": 216.28,
   "text": "بعد که کسی گرفتار شد تو تور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.28,
   "end": 220.08,
   "text": "عنکبوتی شیطان افتاد دیگه ولا آمرا نهون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.08,
   "end": 225.04,
   "text": "دیگه می‌افته به امر کردن دیگه تحت امر شیطان قرار می‌گیره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.04,
   "end": 230.26,
   "text": "که چی بشه؟ فلیبث کن آذان الأنعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.26,
   "end": 232.96,
   "text": "آذان جمع أذن. گوش‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.96,
   "end": 238.04,
   "text": "چهارپایان که اینا رو میگه امر می‌کنم بهشون این گوشا رو ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.04,
   "end": 241.38,
   "text": "چیه قصه؟ بر می‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.38,
   "end": 243.86,
   "text": "کارهایی که در زمان جاهلیت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.86,
   "end": 247.16,
   "text": "نذر بت‌هاشون می‌کردن چهارپایان و مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.16,
   "end": 251.18,
   "text": "گاو و گوسفند و شتر و اینا نذر بت‌هاشون می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.18,
   "end": 253.14,
   "text": "این چنین بود که گوش اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.14,
   "end": 255.92,
   "text": "سوراخ می‌کردن. گوش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.92,
   "end": 257.56,
   "text": "چهارپا رو سوراخ می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.56,
   "end": 259.7,
   "text": "یعنی این دیگه وقف این بته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 259.7,
   "end": 267.02,
   "text": "دیگه ازش کسی نمی‌تونه نه سواری بگیره نه از گوشتش استفاده کنه تا بمیره و مردار بشه، بگنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.02,
   "end": 272.08,
   "text": "اسلام اینو نهی می‌... همچین ما همچین چیزی نداریم آخه این چه کاریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.08,
   "end": 275.7,
   "text": "و این خودش یه تصریحه به قول آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.7,
   "end": 278.78,
   "text": "براعتی در تفسیر نورش می‌فرماید وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.78,
   "end": 282.84,
   "text": "اسلام اجازه نمیده حیوان رو تلف کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.84,
   "end": 288.74,
   "text": "حیوان رو تلف کنی بگه حالا این ما نذر این بود ولش کنید دیگه گوشتشو نخورید ازش استفاده نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.74,
   "end": 292.7,
   "text": "دیگه چه برسه به اینکه انسان تلف بشه، انسان عمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.7,
   "end": 296.0,
   "text": "تلف بشه. گوشت زدیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.0,
   "end": 299.28,
   "text": "خب حالا اینا افتادن به این کار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.28,
   "end": 301.7,
   "text": "ااا حرام رو حلال کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.7,
   "end": 304.7,
   "text": "حلال رو حرام کردن. از خودشون حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.7,
   "end": 307.36,
   "text": "دین درست کردن. سبک ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.36,
   "end": 311.1,
   "text": "ولا دو مرتبه ولا آمرا نهون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.1,
   "end": 312.94,
   "text": "دو مرتبه به اینا چیکار می‌کنه شیطان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.94,
   "end": 318.42,
   "text": "میگه من بهشون امر می‌کنم فلیغیرن خلق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.42,
   "end": 321.48,
   "text": "که در خلق الهی تغییر ایجاد بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.48,
   "end": 327.1,
   "text": "عجب! یعنی تو قراره انسان باشی شیطان کارو می‌کنه حیوان بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.1,
   "end": 331.42,
   "text": "نبات بشی، جماد بشی، تنزل پیدا کنی در حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.42,
   "end": 335.74,
   "text": "جماد، سنگ بشی که قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.74,
   "end": 338.02,
   "text": "اینا اصلاً ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.02,
   "end": 341.92,
   "text": "وقود هنار. اینا قلب‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.92,
   "end": 345.96,
   "text": "مثل سنگ، مثل سنگ می‌شه، سنگ آتشین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.96,
   "end": 349.12,
   "text": "سنگ جهنم می‌شه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.12,
   "end": 352.7,
   "text": "و من يتخذ الشيطان وليا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.7,
   "end": 357.04,
   "text": "اگر کسی شیطان رو ولی خودش گرفت، این دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.04,
   "end": 360.36,
   "text": "صراحتا داره میگه ولایت شیطان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.36,
   "end": 363.6,
   "text": "دوست گرفت شیطان رو من دون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.6,
   "end": 369.84,
   "text": "به جز خدا. اینجا نشون میده من دون الله یعنی آقا اصلاً ولایت فقط ولایت اللهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.84,
   "end": 373.96,
   "text": "که استحقاق گرفتن و دوستی او هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.96,
   "end": 378.08,
   "text": "من دون الله ولی حالا تو به انحراف رفتی و شیطان رو ولی گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.08,
   "end": 382.12,
   "text": "چه، چه اتفاقی می‌افته؟ فقط خسران خسرانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.12,
   "end": 384.94,
   "text": "مبینا. این دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.94,
   "end": 387.48,
   "text": "یه خسره، خسارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.48,
   "end": 392.56,
   "text": "آشکاریه. چه خسارتی خسر و خسرانا مبینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.56,
   "end": 395.24,
   "text": "کی می‌فهمیم اینو؟ متاسفانه وقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.24,
   "end": 398.26,
   "text": "وقتی که سرمون به سنگ لحد خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.26,
   "end": 404.32,
   "text": "اون موقع می‌فهمیم. حالا اینجا نکاتی که توی این آیه هست من خیلی سریع عرض کنم و رد شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.32,
   "end": 410.16,
   "text": "اولیش که می‌فرماید و لأضلنهم اینو بدونید قاعده اضلال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.16,
   "end": 412.38,
   "text": "رها کردن، گمراه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.38,
   "end": 417.32,
   "text": "ما رو وقتیه یعنی وقتی به کار می‌ره که قبلش هدایت بوده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.32,
   "end": 422.24,
   "text": "یعنی باید تو راه هدایت باشه که حالا بیای گمراهش کنی دیگه و الا معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.24,
   "end": 429.78,
   "text": "این نشون میده که همه انسان‌ها در درون خودشون ندای الهی و هدایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.78,
   "end": 433.76,
   "text": "دارن. ان الله يهدي من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.76,
   "end": 436.56,
   "text": "بر می‌گرده به فطرت. تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.56,
   "end": 442.86,
   "text": "آیه سی سوره روم می‌فرماید فطرت الله التي فطر الناس عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.86,
   "end": 447.58,
   "text": "که بارها اینو قرائت کردیم، اون فطرت که ما مفتوریم به او، فطرت الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.58,
   "end": 453.14,
   "text": "خداجوئیم ذاتاً. این بوده ما ذاتاً در مسیر هدایت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.14,
   "end": 458.68,
   "text": "خب. بعد اینجا ادامه آله، آیه لا تبدیل لخلق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.68,
   "end": 461.68,
   "text": "اصلا نمیشه خلق الله رو تبدیل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.68,
   "end": 464.62,
   "text": "اینجا توش این آیه شیطان میگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.62,
   "end": 472.64,
   "text": "من اینا رو امر می‌کنم که فلا يغيرن خلق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.64,
   "end": 477.1,
   "text": "من یه کاری می‌کنم امر می‌کنم اینا خلق خدا رو تغییر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.1,
   "end": 480.54,
   "text": "اون آیه میگه لا تبدیل لخلق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.54,
   "end": 486.9,
   "text": "اصلا تبدیلی نیست. یعنی از اینجا می‌فهمیم که اولا ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.9,
   "end": 493.02,
   "text": "درون خودمون فطرت الهی داریم، در مسیر هدایت از بچگی بودیم، خودمون به انحراف رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.02,
   "end": 495.8,
   "text": "دو، شیطان نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.8,
   "end": 504.32,
   "text": "ذات ما رو تغییر بده. شیطان نمی‌تونه اصطلاحاً کاری بکنه فطرت ما بمیره چون تغییر بردار نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.32,
   "end": 510.88,
   "text": "تبدیل بردار نیست. شیطان ادعا کرده اما نمی‌تونه فطرت ما رو بکشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.88,
   "end": 512.96,
   "text": "روح ما رو کلاً بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.96,
   "end": 516.96,
   "text": "اینکه میگن قلبش مرد یه اصطلاحه برای سهولت فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.96,
   "end": 522.32,
   "text": "و الا دفن می‌شه یعنی روح هست، نفس هست، قلب وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 522.32,
   "end": 531.62,
   "text": "اون ذات ما که جدول وجودی ماست، رب وجودی ماست و متصل است به رب مطلق و دریای لایتناهی وجود و هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.62,
   "end": 534.36,
   "text": "فیضی به ما می‌رسه از فیض عمر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.36,
   "end": 537.84,
   "text": "رزق، علم، فهم، معرفت، هرچی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.84,
   "end": 540.56,
   "text": "از اون دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.56,
   "end": 545.84,
   "text": "یه رب مطلق می‌رسه از کانال وجودی جدول وجودی ما که رب وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.84,
   "end": 548.86,
   "text": "ربی الاعلی ربی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.86,
   "end": 554.12,
   "text": "این از اینجا به ما می‌رسه. اون هست، اون باقی و برقرار خواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.12,
   "end": 560.14,
   "text": "ولی چی می‌شه؟ دفن می‌شه تو وجود یعنی غباری آلودگی میاد روشو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.14,
   "end": 562.5,
   "text": "این و لأضل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.5,
   "end": 567.8,
   "text": "و لأضلنهم که شیطان اینجا گفته کاملاً داره همین رو بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.8,
   "end": 569.8,
   "text": "اینا تو مسیر هدایت بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.8,
   "end": 574.76,
   "text": "حالا من می‌کشونم ایشون اینور. می‌کشم اینور نه یعنی می‌میره فطرت، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.76,
   "end": 577.24,
   "text": "به این که من رو بعضی‌ها گفتن م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.24,
   "end": 581.2,
   "text": "فطرت شکلش عوض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.2,
   "end": 583.94,
   "text": "شکلش یه طور دیگه می‌شه که اس-- بهش می‌گن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.94,
   "end": 586.44,
   "text": "شاکله. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.44,
   "end": 588.94,
   "text": "آیه هشتاد و چهار سوره اسرا باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.94,
   "end": 594.96,
   "text": "می‌فرماید که قل پیغمبر بگو کلن، کلن همه، همه، همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.96,
   "end": 600.74,
   "text": "يعمل على شاكلته همه بر اساس شاکله خودشون عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.74,
   "end": 602.84,
   "text": "شاکله رو یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.84,
   "end": 606.82,
   "text": "رو بنا، فطرت زیربنای وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.82,
   "end": 609.96,
   "text": "شاکله بر اساس اعمال ما درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.96,
   "end": 612.82,
   "text": "همه بر اساس شاکله‌شون عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.82,
   "end": 615.78,
   "text": "اول الهین، فطرت اصلاً بچه دروغ نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 615.78,
   "end": 621.94,
   "text": "نشنیدین از قدیم‌ها میگن حرف راستو از بچه بشنو چون فطرتش الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 621.94,
   "end": 625.28,
   "text": "رفته رفته به دروغ می‌افته. این فطرت ثانویه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 625.28,
   "end": 630.54,
   "text": "شاکله درست می‌شه. اعمال ما اول که انجام میدیم حاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.54,
   "end": 633.68,
   "text": "حاله میاد میره. چه خوب باشه چه بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.68,
   "end": 638.48,
   "text": "اگر تکرار شد، اصرار شد تبدیل به ملکه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.48,
   "end": 644.36,
   "text": "خدا نکنه ملکه دیگه کلاً رسوخ پیدا کنه در-- بمونه دیگه ریشه بدوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.36,
   "end": 647.02,
   "text": "اون دیگه می‌شه فصل مقوم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.02,
   "end": 649.62,
   "text": "مثلاً دیگه طرف واقعاً دیگه سگ شد جسارتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.62,
   "end": 653.62,
   "text": "دیگه واقعاً خوک شد، گاو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.62,
   "end": 656.36,
   "text": "اصلاً نمی-- دیگه از انسانیت فارغ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.36,
   "end": 658.6,
   "text": "کلاً فطرتش در درونش چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.6,
   "end": 663.48,
   "text": "دفن شد. مثل اون ملعون که رو سینه ارباب نشسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.48,
   "end": 670.96,
   "text": "آقا داره، داره نصیحتش می‌کنه تو این کارو نکن من تو با این وضع ضامنم که خدا تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.96,
   "end": 674.28,
   "text": "ببخشه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.28,
   "end": 677.4,
   "text": "به هوس ملکة کارشو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.4,
   "end": 683.3,
   "text": "اینه دیگه فطرت چنان دفن شده نفس امام معصوم هم درش تأثیر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 683.3,
   "end": 687.8,
   "text": "اینطوری می‌شه. پس اینو حواسمون باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 687.8,
   "end": 692.56,
   "text": "ش-- اون شاکله ما چیزیست که خودمون داریم می‌سازیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.56,
   "end": 699.5,
   "text": "اگر به در مسیر خیر و خوب و نیکی و دین و اینا حرکت کنیم، اون فطرت اولیه تقویت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.5,
   "end": 701.7,
   "text": "شاکله‌ای که خودمون ساختیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 701.7,
   "end": 704.02,
   "text": "تقویت شده اونه، قوت اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.02,
   "end": 708.58,
   "text": "اما اگر به سمت ضعف و خدایی نکرده گناه و معصیت و این‌ها بریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 708.58,
   "end": 711.8,
   "text": "اون موقع چی می‌شه؟ شما بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 711.8,
   "end": 717.72,
   "text": "تبدیل می‌شه به یک درنده‌ای که حالا دیگه اسمشو انسان نمیشه گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 717.72,
   "end": 720.82,
   "text": "حالا بهش میگیم شاکله. نکته بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 720.82,
   "end": 724.78,
   "text": "در خصوص و لأمنینهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 724.78,
   "end": 727.56,
   "text": "اینم که قبلاً درباره‌ش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 727.56,
   "end": 735.66,
   "text": "اگر کسی آرزوهای طولانی تو چشمشه و این آرزوها منهای آخرته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 735.66,
   "end": 740.18,
   "text": "دوست داره آقا، دوست داره خونه، خونه، ماشین، ملک، آبرو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 740.18,
   "end": 743.22,
   "text": "نمممدرک تحصیلی، پول. ذاتا اینا رو دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.22,
   "end": 748.4,
   "text": "نه برای اینکه بتواند آخرت را کسب کند با این وسایل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 748.4,
   "end": 752.06,
   "text": "نه، منهای آخرت شده میشه دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 752.06,
   "end": 754.48,
   "text": "این میشه دنیا و الا دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 754.48,
   "end": 757.46,
   "text": "اگر بوی آخرت بده دیگه دنیا نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 757.46,
   "end": 762.68,
   "text": "متجر اولیاء الله میشه به قول امام حسن میشه محل تجارت اولیای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 762.68,
   "end": 765.54,
   "text": "این آرزوهای طو-طولانی اومد قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 765.54,
   "end": 772.24,
   "text": "آن انسان باور به موت نداره و تحت تصرف ولایت شیطان اومده و نکته آخر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 772.24,
   "end": 777.44,
   "text": "اگر کسی کارش به اینجا کشید، آقا خودمون رو محک بزنیم دیگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 777.44,
   "end": 781.72,
   "text": "دیگه همچین فضاهای مقدسی با هم نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 781.72,
   "end": 788.74,
   "text": "به هر حال سر سفره نماز جماعت اینو هممون الان تو این چند لحظه آخر خودمون خودمون رو محک بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 788.74,
   "end": 792.56,
   "text": "اگر کسی دچار آرزوهای طولانی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 792.56,
   "end": 798.78,
   "text": "آرزوهای منهای آخرت. مثلا دوست داره مثلا بچه‌هاشو عروس و دوماد بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 798.78,
   "end": 802.56,
   "text": "خب شما م- به این‌ها مهربان‌تری یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 802.56,
   "end": 806.4,
   "text": "جواب بده ببینم. شما به بچه‌هات مهربان‌تری یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 806.4,
   "end": 809.04,
   "text": "با خدا دعوا داره که چرا میخوای جون منو بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.04,
   "end": 813.04,
   "text": "هنوز دختر و پسرم رو عروس و دوماد نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 813.04,
   "end": 816.28,
   "text": "خب این قطعا آرزو طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 816.28,
   "end": 818.22,
   "text": "چون رضای خدا درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 818.22,
   "end": 821.72,
   "text": "تو خودت رو جای خدا گذاشتی، خدا مهربان‌تره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 821.72,
   "end": 824.82,
   "text": "اگر کسی دچار این شده به نتیجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 824.82,
   "end": 829.16,
   "text": "نتیجه‌ش چی شد؟ فراموشی موت و مرگ بهش رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 829.16,
   "end": 831.6,
   "text": "دست داده. اصلا یاد موت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 831.6,
   "end": 834.26,
   "text": "کسی هم حرف از مرگ می‌زنه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 834.26,
   "end": 836.7,
   "text": "ده نمم-- زبونتو گاز بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 836.7,
   "end": 842.12,
   "text": "العیاذ بالله این قطعا تحت تصرف ولایت شیطان قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 842.12,
   "end": 844.58,
   "text": "ولو ظاهر ولایی و مذهبی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 844.58,
   "end": 849.66,
   "text": "خطر خیلی جدیه. دیدی چند تا لام تاکید تو افعال این آیه اومده بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 849.66,
   "end": 851.9,
   "text": "آیه قرآن هم بود، مال خودم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 851.9,
   "end": 858.68,
   "text": "باید دشمن رو جدی بگیریم. ان‌شاءالله عاقبتmu ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 858.68,
   "end": 861.34,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 861.34,
   "end": 864.1,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}