 },
 "chapters": [
  {
   "index": 0,
   "title": "## ولایت شیطان و فراموشی مرگ",
   "start": 0.54,
   "end": 89.48
  },
  {
   "index": 1,
   "title": "## قسم شیطان به عزّت خدا و استثنای مخلصین",
   "start": 89.48,
   "end": 219.3
  },
  {
   "index": 2,
   "title": "## عبادی؛ توحید ذاتی و ثلاثۀ وحده‌ها",
   "start": 219.3,
   "end": 631.15
  },
  {
   "index": 3,
   "title": "## توبهٔ شیطان و سلطنت بر متولّیان او",
   "start": 631.15,
   "end": 850.15
  },
  {
   "index": 4,
   "title": "## قیامت کبری هنگام موت و عینک آلودهٔ برزخ",
   "start": 850.15,
   "end": 991.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 9.72,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.72,
   "end": 13.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.6,
   "end": 18.98,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.98,
   "end": 21.6,
   "text": "در روایت پنجم از باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.6,
   "end": 24.68,
   "text": "چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.68,
   "end": 28.56,
   "text": "در موضوع ولایت شیطان و ربطش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.56,
   "end": 31.8,
   "text": "فراموشی مرگ. رسیده بودیم به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.8,
   "end": 36.66,
   "text": "قسمت که قطعاً کسی که تحت ولایت شیطان قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.66,
   "end": 39.6,
   "text": "مرگ و موت رو فراموش می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.6,
   "end": 41.9,
   "text": "و باور نداره که قراره بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.9,
   "end": 45.92,
   "text": "و اگر کسی بلعکسشم گفتیم هست، اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.92,
   "end": 48.96,
   "text": "فراموشی مرگ بهش دست داد قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.96,
   "end": 54.46,
   "text": "سر خورده سمت شیطان و تحت ولایت شیطان قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.46,
   "end": 58.68,
   "text": "و نکته‌ای رو پیرامون ولایت شیطان عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.68,
   "end": 67.18,
   "text": "و اجازه بدید که این رو از تو دل چند تا آیه در بیاریم که بالاخره ولایت شیطان به چه کسایی کارساز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.18,
   "end": 69.96,
   "text": "چه کسایی گاردشون رو محکم بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.96,
   "end": 75.28,
   "text": "مصون‌اند از ولایت شیطان که اگر کسی از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.28,
   "end": 80.14,
   "text": "به اون مقام نرسیده باشه قطعاً چه بداند چه نداند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.14,
   "end": 84.14,
   "text": "تحت ولایت شیطان رفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.14,
   "end": 89.48,
   "text": "حتی اگر خبر نداشته باشه و وقتی سرش به سنگ لحد خورد تازه می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.48,
   "end": 93.86,
   "text": "مثلا در آیه سی و نه و چهل سوره حجر می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.86,
   "end": 96.86,
   "text": "گفتم این صحبت‌ها و مهاجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.86,
   "end": 101.46,
   "text": "این دشمن پلید و خبیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.46,
   "end": 107.08,
   "text": "جهان بشری رو که شیطانه، اون شیطان رجیم، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.08,
   "end": 111.84,
   "text": "سردمدارشون. اونو با خدا رو بخونید تو قرآن ببینید خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.84,
   "end": 115.46,
   "text": "نکات عجیبی ازش در میاد. یکیش اینه که به خدا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.46,
   "end": 117.78,
   "text": "فبعزتک، فبعزتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.78,
   "end": 120.6,
   "text": "قسم به عزت خدا می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.6,
   "end": 123.8,
   "text": "و پیداست که خیلی کار جدیه، قصه جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.8,
   "end": 125.52,
   "text": "لاغینهم أجمعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.52,
   "end": 129.14,
   "text": "اون لام هم که تأکیده. قطعاً من همشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.14,
   "end": 134.34,
   "text": "اغوا می‌کنم. یه همچین دشمنی داریم که کاملاً مترصد ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.34,
   "end": 137.56,
   "text": "ما بی‌خبر و غافل از او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.56,
   "end": 141.26,
   "text": "و او مترصد ماست با تمام قوای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.26,
   "end": 143.32,
   "text": "اما خودش اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.32,
   "end": 146.12,
   "text": "چون گفتیم بعد از امام هر زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.12,
   "end": 149.38,
   "text": "عالم‌ترین شخص اون زمان شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.38,
   "end": 152.48,
   "text": "یه همچین شخصی که انقدر علم داره میگه الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.48,
   "end": 155.22,
   "text": "عبادک منهم المخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.22,
   "end": 158.12,
   "text": "عجب! اونم نه مخلصین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.12,
   "end": 162.9,
   "text": "مخلص. حالا فرق مخلص و مخلص رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.9,
   "end": 166.36,
   "text": "قبلاً گفتیم رهبر عزیزمون یه بار تو صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.36,
   "end": 168.6,
   "text": "قشنگشون تصریح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.6,
   "end": 173.64,
   "text": "حالا مفصله یه نکته‌ش رو فقط عرض کنم فرقش رو بدونیم تا چیزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.64,
   "end": 178.0,
   "text": "اونم اینکه مخلص فرقش اینه که هیچی از خدا نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.0,
   "end": 181.52,
   "text": "خدا رو، خود خدا رو می‌خواد. اما مخلص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.52,
   "end": 185.6,
   "text": "خالص شده یعنی به مقام اخلاص رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.6,
   "end": 188.62,
   "text": "اما خلوص شاید نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.62,
   "end": 193.44,
   "text": "یعنی خلوصم اگر هم داشته باشه عیارش خیلی بالاست، بالا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.44,
   "end": 196.86,
   "text": "خلوص شدت اخلاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.86,
   "end": 201.08,
   "text": "طوریه که یعنی مخلص طوریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.08,
   "end": 205.64,
   "text": "خودش رو خالص کرده. هیچی ها نه بهشت می‌خواد، نه فرار از جهنم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.64,
   "end": 207.28,
   "text": "همون عبادت، عبادت أبراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.28,
   "end": 211.34,
   "text": "حالا اینا کم‌اند، خیلی کم‌اند. اکثر ماها به شوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.34,
   "end": 215.46,
   "text": "سیب و گلابی و حور بهشتی و قصور و انهار و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.46,
   "end": 219.3,
   "text": "هستیم. اما اون‌ها اصلاً اینطوری نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.3,
   "end": 223.46,
   "text": "در آیه چهل و دو حجر می‌فرماید إن عبادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.46,
   "end": 227.02,
   "text": "بندگان من، ليس لك عليهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.02,
   "end": 231.68,
   "text": "سلطان إلا من اتبعك من الغاوین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.68,
   "end": 235.44,
   "text": "و اون‌هایی که بندگان من هستند یعنی در بند خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.44,
   "end": 238.88,
   "text": "هرچی خدا گفت چشم. اصلاً دیگه چون و چرا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.88,
   "end": 241.72,
   "text": "خدایا این کارو انجام بدم ثوابش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.72,
   "end": 244.2,
   "text": "خدایا این کارو انجام بدم منو از جهنم بیرون میاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.2,
   "end": 246.6,
   "text": "نجات میدی؟ اصلاً این حرفا تو کت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.6,
   "end": 250.96,
   "text": "کته اینا نمیره. میگه اینا عبادی تمام بنده منن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.96,
   "end": 258.02,
   "text": "من، من. مثل فادخلی عبادی و ادخلی جنتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.02,
   "end": 262.16,
   "text": "که حکما و عرفا اینا همه تصریح فرمودند که این جنت ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.16,
   "end": 266.0,
   "text": "یعنی پی حضرت حق رفته. یعنی در، به توحید ذاتی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.0,
   "end": 271.94,
   "text": "فناء في الله و بقاء بالله و اینا که قبلاً بحث‌هاش بین ما گذشته تقریباً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.94,
   "end": 276.42,
   "text": "که یعنی عرض کردیم دیگه وحده، وحده، وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.42,
   "end": 281.98,
   "text": "دیگه افعال خودش رو، اون وحده سوم به توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.98,
   "end": 285.56,
   "text": "افعال خودش رو فانی در افعال حضرت حق دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.56,
   "end": 287.86,
   "text": "میگه لا حول و لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.86,
   "end": 294.56,
   "text": "وحده وسط. اون صفات خودش رو هرچی ما أصابك من حسنة فمن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.56,
   "end": 297.78,
   "text": "هرچی خیر و خوبی درشه میگه از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.78,
   "end": 300.1,
   "text": "صفات خودش رو فانی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.1,
   "end": 303.96,
   "text": "صفات الله می‌بینه. لذا میگه لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.96,
   "end": 307.16,
   "text": "وحده اول که دیگه نقطه پرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.16,
   "end": 311.42,
   "text": "مخلصینه. دیگه اوج میشه گفت معراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.42,
   "end": 313.84,
   "text": "یا عرشه که عرش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.84,
   "end": 317.78,
   "text": "رتبش مافوق صادر اول و اولین تعینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.78,
   "end": 319.52,
   "text": "دیگه خیلی خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.52,
   "end": 323.54,
   "text": "اونجا دیگه قلب المؤمن عرش الرحمن، قلب، مقام قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.54,
   "end": 326.4,
   "text": "میگه فلان چیز در قله قافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.4,
   "end": 329.36,
   "text": "یعنی انقدر دوره. قاف، قاف قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.36,
   "end": 332.36,
   "text": "انقدر دست یافتن به اون سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.36,
   "end": 337.46,
   "text": "عزیز دلم، اونجا میگه ذات خدا، اصلاً بود خودت رو، وجود خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.46,
   "end": 339.68,
   "text": "فانی و مستهلك در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.68,
   "end": 343.26,
   "text": "وجود خدا می‌بینی. یعنی خودت رو هم خودت نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.26,
   "end": 346.48,
   "text": "جلوه حق، ظهور حق، آیت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.48,
   "end": 350.1,
   "text": "مجلی حق، کلمه الهی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.1,
   "end": 353.32,
   "text": "این می‌شه این چیزی که ما داریم درباره‌ش همین‌طوری سخن می‌گیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.32,
   "end": 357.2,
   "text": "راحت رد می‌شیم، می‌ریم در حالی که کنّ مِلین ما بزرگان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.2,
   "end": 360.51,
   "text": "خودشونو بیچاره کردن تا به این مقام برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.51,
   "end": 363.27,
   "text": "یک عمر تلاش کردن زحمت کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.27,
   "end": 365.71,
   "text": "فقط اینان که لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.71,
   "end": 370.35,
   "text": "می‌فرماید \"لیس لک علیهم سلطان\" تو نمی‌تونی به اینا سلطنت پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.35,
   "end": 376.91,
   "text": "اینا غرق در منن. یعنی اینطوری بخوایم بریم جلو عزیزان دلم خیلی قصه خطرناک می‌شه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.91,
   "end": 379.35,
   "text": "یعنی اونایی که شوق به بهشت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 379.35,
   "end": 383.73,
   "text": "روایات میگه بد نیست. اما حسنات الأبرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.73,
   "end": 388.77,
   "text": "سیئات المقربین. برای کسی که می‌خواد مقر– مقرب بشه اینم گناه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.77,
   "end": 392.93,
   "text": "اینم بوی شیطان می‌ده. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.93,
   "end": 396.65,
   "text": "قرآن سوره واقعه که همه انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.65,
   "end": 399.05,
   "text": "سرود شبانگاهی همه‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.05,
   "end": 402.21,
   "text": "سوره واقعه وقتی اون سه تا رو می‌شمره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.21,
   "end": 405.11,
   "text": "وقتی می‌رسه به اصحاب یمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.11,
   "end": 407.43,
   "text": "می‌فرماید \"ثلة من الأولین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.43,
   "end": 409.89,
   "text": "ثلة من الآخرین\". ثله‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 409.89,
   "end": 412.87,
   "text": "بسیاری از قدیمن، بسیاری از جدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.87,
   "end": 416.61,
   "text": "اما مقربین رو چی میگه؟ مقربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.61,
   "end": 420.97,
   "text": "اصحاب سابقون. \"ثلة من الأولین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 420.97,
   "end": 424.55,
   "text": "و آفرین \"قلیل من الآخرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.55,
   "end": 427.15,
   "text": "به هر کسی نمی‌دن اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 427.15,
   "end": 434.01,
   "text": "چرا \"قلیل من الآخرین\"؟ حالا اینجا خیلی حرف‌ها داریم و علامه چقدر تو هم مصباح العقولش هم شرح فصوصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.01,
   "end": 437.61,
   "text": "میگه این توجه به همین \"قلیل من الآخرین\" داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.61,
   "end": 439.87,
   "text": "چقدر اینجا حرف پیاده کرده استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.87,
   "end": 443.55,
   "text": "خدا روحش رو شاد کنه. این \"قلیل من الأولین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.55,
   "end": 446.01,
   "text": "پر طاووس رو به کرکس نمی‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 446.01,
   "end": 448.09,
   "text": "هرچی میری-- شهید حججی روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.09,
   "end": 450.97,
   "text": "به علی اون پسرش علیه وصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 450.97,
   "end": 452.37,
   "text": "چند دقیقه‌ای می‌کنه اینجا وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 452.37,
   "end": 457.35,
   "text": "شهید شدن اون روز ما اومدیم یه تحلیلی ازش ارائه دادیم با سیزده تا نکته حایرتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.35,
   "end": 461.41,
   "text": "اونجا به پسرش علی میگه که هرچی میریم جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.41,
   "end": 466.27,
   "text": "زمانه سخت‌تر می‌شه، گناه بیشتر می‌شه، پاک بودن سخت‌تره اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 466.27,
   "end": 468.61,
   "text": "واقعاً هم اینطوریه. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 468.61,
   "end": 471.93,
   "text": "ما اعتقاد داریم به سمت نور در حرکتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 471.93,
   "end": 476.81,
   "text": "\"الله ولي الذين آمنوا يخرجهم من الظلمات إلى النور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 476.81,
   "end": 479.67,
   "text": "داره شدت می‌گیره، شدت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 479.67,
   "end": 481.61,
   "text": "الان رهبر واقعاً درست میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 481.61,
   "end": 485.67,
   "text": "جوونایی که الان هستن واقعاً یه سر و گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 485.67,
   "end": 487.73,
   "text": "بالاتر از جوونای زمان جنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 487.73,
   "end": 494.33,
   "text": "اونایی که الان تو وادی نورن و شدت-- اصلاً باید اینطور باشه چون به شدت دارن به سمت نور حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 494.33,
   "end": 496.19,
   "text": "هی نور على نور، نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 496.19,
   "end": 499.27,
   "text": "هی تجلی حضرت حق آن فآن بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 499.27,
   "end": 505.99,
   "text": "اما از اون طرفش هم هست. اونایی که ولایت طاغوت رو اختیار کردن یعنی تحت ولایت شیطان قرار گرفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 505.99,
   "end": 509.55,
   "text": "اونا هم یعنی شدت هی ظلمت روی ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 509.55,
   "end": 512.55,
   "text": "کی یه همچین تصرفی در گناه بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 512.55,
   "end": 516.89,
   "text": "کی یه همچین راحتی‌ای برای انجام گناه در عالم بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 516.89,
   "end": 520.09,
   "text": "تو شد تو خلوت یه گوشه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 520.09,
   "end": 524.51,
   "text": "عذرتی تمام گناه‌ها در دسترست باشه با رسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 524.51,
   "end": 529.31,
   "text": "اصلا امپراتوری دروغ، دروغ، دروغ‌ها که میگن دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 529.31,
   "end": 531.95,
   "text": "از قدیم به ما می‌گفتن دروغگو دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.95,
   "end": 535.09,
   "text": "از بچگی خدا رحمت کنه مادر ما همیشه به ما می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 535.09,
   "end": 537.95,
   "text": "اکبر دروغ نگیا. دروغگو دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 537.95,
   "end": 540.83,
   "text": "اینو هی به ما نهیب می‌زدن. ما می‌گفتیم یعنی چی دروغگو دشمن خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 540.83,
   "end": 543.05,
   "text": "مگه من کیم که با خدا دشمنی کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 543.05,
   "end": 546.17,
   "text": "الان داریم می‌فهمیم امپراتوری دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.17,
   "end": 552.07,
   "text": "یعنی اون کسی که اون دجالی که در برابر نظام ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 552.07,
   "end": 557.29,
   "text": "آل الله، محیط ولایت آل الله و امام عصر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 557.29,
   "end": 563.35,
   "text": "که قراره انشاالله تمام زحمات اولیا، انبیا رو به ثمر برسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 563.35,
   "end": 566.45,
   "text": "قد علم کرده همین امپراتوری دروغه، همین رسانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 566.45,
   "end": 569.53,
   "text": "الان اغتشاشات اینا می‌بینی همش ری-- زیر سر چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 569.53,
   "end": 572.81,
   "text": "همین رسانه‌ها. دروغ، دروغ، دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 572.81,
   "end": 576.53,
   "text": "و اون دجال اصلاً همینه. اینکه تک‌چشمه روایت میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 576.53,
   "end": 579.09,
   "text": "تک‌چشمه یک چشم در پیشانی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 579.09,
   "end": 585.43,
   "text": "اینو روایت میگه و میاد مردم رو بسیاری از مردم رو به بالا سر خودش می‌کشونه می‌ره و در دریا غرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.43,
   "end": 587.27,
   "text": "اینکه چرا دریا؟ چرا غرق می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 587.27,
   "end": 591.09,
   "text": "چرا تک‌چشم؟ اینا بزرگان حرف‌ها پیاده کردن برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.09,
   "end": 594.77,
   "text": "حالا خیلیشون تفسیر کردن که بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 594.77,
   "end": 599.07,
   "text": "حالا قطعاً صد درصد نگفتن اما تأویلش فرمودن شاید همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.07,
   "end": 604.09,
   "text": "ماهواره و موبایل و این تک‌چشم تلویزیون و ببین یک چشم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 604.09,
   "end": 607.43,
   "text": "اینچنینه. که شما همینجا نشستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 607.43,
   "end": 611.35,
   "text": "می‌تونی مخابره کنی به تمام دنیا تصویرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 611.35,
   "end": 614.63,
   "text": "تمام دنیا تو رو می‌بینه. یعنی از اینجا داری گناه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 614.63,
   "end": 619.75,
   "text": "نقطه به نقطه حتی تو کعبه کسی باشه موبایل دستش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 619.75,
   "end": 622.95,
   "text": "اونجا در معرض گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 622.95,
   "end": 626.41,
   "text": "یعنی کثرت، شدت. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.41,
   "end": 631.15,
   "text": "برای همین سخت‌تره و ولایت شیطان گستره‌ش، گستره‌ش خیلی بیشتر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.15,
   "end": 634.71,
   "text": "بیخود نیست وقتی موسی بهش گفتش که بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 634.71,
   "end": 638.15,
   "text": "برگرد من وساطت می‌کنم تو آدم شو، درست شو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.15,
   "end": 641.35,
   "text": "توبه کن. گفت باشه برو به خدا بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 641.35,
   "end": 644.33,
   "text": "بعد به خدا گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 644.33,
   "end": 648.05,
   "text": "خدا هم گفت راهش اینه که بیاد بگه غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 648.05,
   "end": 649.91,
   "text": "کی؟ شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 649.91,
   "end": 655.21,
   "text": "بیاد بگه غلط کردم. بیاد جلوی شما به من بگه من غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.21,
   "end": 658.73,
   "text": "نه خودشو هرکسی هم که اغوا کرده می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 658.73,
   "end": 665.63,
   "text": "عجب خدایی داریم. بعد اومد حضرت موسی خوشحال بهش گفت آره مژده بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 665.63,
   "end": 668.23,
   "text": "خدا گفته بیا بگو غلط کردم تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 668.23,
   "end": 671.51,
   "text": "گفت همین یه دونه رو من نمی‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 671.51,
   "end": 674.13,
   "text": "بعد گفتش که این حرف و جمله رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 674.13,
   "end": 680.77,
   "text": "گفت اگر من هم بخوام بیام خدا باید بیاد چون سر خدا خلوت‌تر از منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 680.77,
   "end": 685.17,
   "text": "من سرم شلوغ‌تره الان. الان که دیگه خیلی به شدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 685.17,
   "end": 687.99,
   "text": "اکثر عملاء العقول الان خیلی بهت-- بیشتر دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 687.99,
   "end": 691.19,
   "text": "قلیل. همون که گفتم حالا تو اونجا بودیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 691.19,
   "end": 693.45,
   "text": "\"قلیل من الآخرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 693.45,
   "end": 696.19,
   "text": "جا نمونیم از این قافله. بریم جلوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 696.19,
   "end": 702.45,
   "text": "آیه صد و نه. \"إنما سلطانه على الذين يتولونه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 702.45,
   "end": 705.47,
   "text": "سلطنت شیطان برای کساییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 705.47,
   "end": 708.45,
   "text": "\"يتولونه\" دوستش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 708.45,
   "end": 711.67,
   "text": "حالا یعنی چی؟ یعنی ما آدم خبیث رو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 711.67,
   "end": 713.69,
   "text": "یه شخص خبیث رو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 713.69,
   "end": 718.03,
   "text": "کارهاشو دوست داریم. کارهاشو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 718.03,
   "end": 721.83,
   "text": "کف نفس می‌کنیم. جسارت به شما نشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 721.83,
   "end": 726.89,
   "text": "حالا ما کلی داریم صحبت می‌کنیم. اصلاً فکر کنین کتاب وجودی خودمو دارم بر عقل می‌زنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 726.89,
   "end": 729.59,
   "text": "کف نفس می‌کنیم چشمامون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 729.59,
   "end": 732.55,
   "text": "نامحرم می‌بندیم. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 732.55,
   "end": 736.67,
   "text": "اما میگم دندون رو جیگر گذاشتم و بستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 736.67,
   "end": 741.99,
   "text": "یعنی اسلام دست ما رو بست که ما چشمامون رو بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 741.99,
   "end": 748.51,
   "text": "این می‌شه که بعد که ترمز پاره کردیم یهو اونوری شدیم بدتر از اونوری‌ها می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 748.51,
   "end": 753.89,
   "text": "یه آدم خدایی نکرده تو این وادی مونده باشه، کف نفس کرده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 753.89,
   "end": 757.31,
   "text": "چون دوست داره گناه رو انجام نمی‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 757.31,
   "end": 760.31,
   "text": "چون اصلاً یه سری گناه رو انجام بده آبروش می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 760.31,
   "end": 765.15,
   "text": "چون اینطوریه وقتی ترمز پاره کنه یعنی رها کنه اعتقاداتو دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 765.15,
   "end": 766.73,
   "text": "کسی به گردش نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 766.73,
   "end": 773.51,
   "text": "اینه که خیلی انقلابیون همین مذهبی‌ها می‌بینی یه دفعه که چپه می‌کنن بد چپ می‌کنن علتش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 773.51,
   "end": 778.17,
   "text": "دوست داشته گناه رو رو انجام ولی انجام نداده‌ها ولی دوست داشته تو دل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 778.17,
   "end": 780.75,
   "text": "تو دلش، تو این گوشه‌ی دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 780.75,
   "end": 784.15,
   "text": "اینه که خیلی واقعاً میل دل به چه سمتی می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 784.15,
   "end": 787.65,
   "text": "لیلة الرغائب، رغبت، رغبت‌ها کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 787.65,
   "end": 790.41,
   "text": "میل دل کجاست؟ الان میل دلت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 790.41,
   "end": 793.13,
   "text": "تو نمازی، تو سجده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 793.13,
   "end": 795.79,
   "text": "بهترین حالت بنده با خدا سجده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 795.79,
   "end": 797.93,
   "text": "اونجا میل دلت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 797.93,
   "end": 803.51,
   "text": "یکی بیاد حاجی که اونطوری الهی ال-- تو سجده اینا بشکاف قلبتو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 803.51,
   "end": 806.69,
   "text": "قاف قلبتو بشکاف ببینیم چی اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 806.69,
   "end": 812.33,
   "text": "تو تور قلبت، قاف قلبت، مقام تور قلبت که قلبته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 812.33,
   "end": 815.45,
   "text": "اون بطن و مکمن غیب قلبته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 815.45,
   "end": 817.41,
   "text": "باز کنی ببینی شیطان اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 817.41,
   "end": 819.99,
   "text": "میگی آقا مگه عرش و رحمان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 819.99,
   "end": 822.27,
   "text": "مگه شیطان به عرش راه پیدا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 822.27,
   "end": 824.65,
   "text": "اگر این قافه، اگر این توره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 824.65,
   "end": 830.17,
   "text": "بله حضرت موسی که در کوه طور مناجات می‌کرد شیطان اونجام رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 830.17,
   "end": 834.17,
   "text": "و گفت نا، نانجیب خبیث تو اینجا چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 834.17,
   "end": 837.33,
   "text": "گفت برو عمو جون. حالا من لطیفانشو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 837.33,
   "end": 841.31,
   "text": "ما در مقام غرق جد آدم رو اغوا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 841.31,
   "end": 846.85,
   "text": "شما دیگه فلان. ما دشمن رو درسته کیش قرآن می‌گه ضعیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 846.85,
   "end": 848.69,
   "text": "اما ما هم گاردمون رو نبستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 848.69,
   "end": 852.95,
   "text": "غافل بودیم ازش. لذا این باعث شد ما به کجا برسه وضعیتمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 852.95,
   "end": 857.45,
   "text": "شما بفرمایین. برسه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 857.45,
   "end": 859.71,
   "text": "العیاذ بالله یه دفعه می‌بینی س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 859.71,
   "end": 863.85,
   "text": "قیامتمون که قیامت کرد لحظه‌ی موتم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 863.85,
   "end": 867.27,
   "text": "فکر نکنین قیامت باید منتظر باشیم یه زمانی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 867.27,
   "end": 870.61,
   "text": "نه. اصلاً قیامت کبری که همین جا اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 870.61,
   "end": 873.93,
   "text": "ما حالیمون نیست. بدنمون گرمه، هنوز سرد نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 873.93,
   "end": 877.47,
   "text": "و الا قیامت کبری برای من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 877.47,
   "end": 880.99,
   "text": "افتادن پرده‌هاست. الان پرده‌ها افتاده، ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 880.99,
   "end": 884.31,
   "text": "مغبر فضا، ما غبار، غبار جلومون رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 884.31,
   "end": 889.33,
   "text": "حالا میگیم موت. وقت موت قیامت کبری که تازه می‌فهمیم عجب چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 889.33,
   "end": 892.85,
   "text": "تحت تصرفش بودیم، چقدر دل بهش بسته بودیم به کا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 892.85,
   "end": 896.29,
   "text": "به چیزهایی که اون آلارم می‌داد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 896.29,
   "end": 900.45,
   "text": "توجه می‌کردیم و فلان. حالا توبه می‌کنیم حالا تصفیف، تصفیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 900.45,
   "end": 902.33,
   "text": "خدا به داد هممون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 902.33,
   "end": 906.03,
   "text": "یعنی کار، کار دشواریه. اینطوری نیست به ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 906.03,
   "end": 910.21,
   "text": "خیلی عذرخواهی می‌کنم هر بی‌سر و پایی رو تو این وادی راه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 910.21,
   "end": 914.15,
   "text": "درسته خدا گفته همه بیان همه رو می‌بخشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 914.15,
   "end": 916.33,
   "text": "اما اینطوری نیست که هر بی‌سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 916.33,
   "end": 919.87,
   "text": "لا یمسهُ إلا المتحرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 919.87,
   "end": 923.39,
   "text": "جز با طهارت نمی‌شه مس کرد ملکوت عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 923.39,
   "end": 928.45,
   "text": "نمی‌شه. حتی کسی هم که می‌میره اگر آلوده باشه درسته میره به لی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 928.45,
   "end": 931.75,
   "text": "ملاقات پروردگارش اما غبار آلوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 931.75,
   "end": 935.37,
   "text": "اونطور که باید خدا رو ملاقات نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 935.37,
   "end": 939.49,
   "text": "این خودش یه زجر، شما فکر کن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 939.49,
   "end": 944.29,
   "text": "عینکه. الان رو عینک من خش افتاده یه چند روزه، یه خش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 944.29,
   "end": 947.63,
   "text": "زیاد خش افتاده. می‌ذارم چشمم هی عینکم رو ورمیدارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 947.63,
   "end": 949.65,
   "text": "هی چشمم رو اذیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 949.65,
   "end": 956.67,
   "text": "گمان کنید یه عینک پر از خش و آلودگی بزنی رو چشت دائم جلوتو نمی‌تونی درست ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 956.67,
   "end": 959.29,
   "text": "زجر خودش، یکی از زجر‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 959.29,
   "end": 961.93,
   "text": "برزخ اینه. حقایق رو نمی‌تونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 961.93,
   "end": 966.63,
   "text": "حضرت زهرا رو نمی‌تونی ببینی. خداتو نمی‌تونی درست مق-- ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 966.63,
   "end": 970.43,
   "text": "ملاقات کنی. لذا در اعرافی بین جهنم و بهشتی تو برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 970.43,
   "end": 974.59,
   "text": "اصلاً برزخ یعنی این. تا یه شفیعی بیاد شفاعتت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 974.59,
   "end": 978.17,
   "text": "آیا استعدادت مضمحل شده، نشده و خیلی راه طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 978.17,
   "end": 984.83,
   "text": "خدا به هممون رحم کنه. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 984.83,
   "end": 991.51,
   "text": "الله اکبر، الله اکبر، لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}