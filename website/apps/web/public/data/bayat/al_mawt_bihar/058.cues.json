   "start": 685.32,
   "end": 710.52
  },
  {
   "index": 5,
   "title": "## چهار فرشتهٔ بزرگ و نحوهٔ تنزل فهم",
   "start": 710.52,
   "end": 1065.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 8.2,
   "end": 12.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.0,
   "end": 14.8,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.8,
   "end": 17.16,
   "text": "و ربانی آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.16,
   "end": 20.56,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.56,
   "end": 25.96,
   "text": "خیلی تلاش کردیم که امروز ما صحبت نکنیم و از عزیزان دعوت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.96,
   "end": 28.56,
   "text": "ذاکرین اهل بیت در مجموعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.56,
   "end": 32.06,
   "text": "که بعد از نماز مختصری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.06,
   "end": 34.78,
   "text": "بالاخره مدحی بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.78,
   "end": 37.18,
   "text": "متأسفانه همه جای قول داده بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.18,
   "end": 43.8,
   "text": "حتی تو بدنه سازمان. مجبوری لحظات بنده رو دو مرتبه تحمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.8,
   "end": 45.96,
   "text": "تبریک عرض می‌کنم روز میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.96,
   "end": 53.62,
   "text": "بسیار با عظمت و پربرکت امام جواد، عزیزاردو امام رضا رو علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.62,
   "end": 57.52,
   "text": "در عظمت این بزرگوار همین قدر بس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.52,
   "end": 60.96,
   "text": "پدر عزیزشون بفرمایند:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.96,
   "end": 64.14,
   "text": "خب ایشون میلاد امام جواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.14,
   "end": 67.66,
   "text": "پربرکت‌ترین مولود اهل بیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.66,
   "end": 72.68,
   "text": "شوخی نیست. حالا چه خصوصیاتی داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.68,
   "end": 76.3,
   "text": "مولود ایشان در میان اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.3,
   "end": 80.3,
   "text": "از همه با برکت‌تر باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.3,
   "end": 83.84,
   "text": "حالا باید هم مسائل تاریخی اون روز رو دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.84,
   "end": 87.26,
   "text": "وضعیت امام رضا علیه الصلاة والسلام رو دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.26,
   "end": 90.26,
   "text": "شخص خود و شخصیت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.26,
   "end": 95.38,
   "text": "جواد الائمه رو بررسی کرد و چه و چه که یک شباهتی هم البته بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.38,
   "end": 100.42,
   "text": "میلاد ایشان و عذر شود حضرت زهرا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.42,
   "end": 106.36,
   "text": "که می‌دانید که پیغمبر رو مقطوع النسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.36,
   "end": 109.46,
   "text": "یاد کردن. نشانک هو الأبتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.46,
   "end": 112.9,
   "text": "تو سوره کوثر تأکید می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.9,
   "end": 114.6,
   "text": "دشمن تو خودش ابتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.6,
   "end": 120.04,
   "text": "چون می‌گفتن پیغمبر مقطوع النسله، فرزندانش همه از دنیا می‌روند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.04,
   "end": 126.82,
   "text": "لذا إنا أتیناک الْكَوْثَرَ ما به تو کوثر خیر کثیر حضرت زهرا سلام الله علیها رو دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.82,
   "end": 134.88,
   "text": "که دیگه برکتش همه آل الله در دامن ایشون، در ظرف نوریه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.88,
   "end": 139.0,
   "text": "با اون مدارج و معارج رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.0,
   "end": 140.94,
   "text": "حضرت جواد الائمه همچنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.94,
   "end": 145.18,
   "text": "به امام رضا به هر حال این تهمت رو می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.18,
   "end": 149.54,
   "text": "دوست و دشمن کنایه می‌زدن چون حضرت خیلی دیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.54,
   "end": 152.8,
   "text": "بچه دار شدن. به حکمت الهی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.8,
   "end": 159.64,
   "text": "بچه دار نمی‌شدن و مثل پیغمبر به ایشونم حتی دوستان می‌گفتن ایشون مقطوع النسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.64,
   "end": 163.52,
   "text": "نمی‌فهمیدن بالاخره امان از نفهمیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.52,
   "end": 167.52,
   "text": "که بعد شاید یک وجهش البته این باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.52,
   "end": 169.6,
   "text": "میلاد امام جواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.6,
   "end": 176.02,
   "text": "نسل آل الله رو، نسل ذریه حضرت زهرا سلام الله علیها رو ادامه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.02,
   "end": 181.5,
   "text": "و به یک و-- به یک وجه می‌شه اینطوری هم دید که کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.5,
   "end": 188.76,
   "text": "دیگه امام رضا رو رسید به امامت امام رضا دیگه از طریق امامت امام جواد تا امام عصر رو دیگه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.76,
   "end": 193.34,
   "text": "یعنی اثنی عشری می‌شه و امامتش ولایتش کامل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.34,
   "end": 200.5,
   "text": "در هر حال این یک نکته‌ست. نکته دیگه که من این رو خیلی دوست دارم خیلی زیاد درباره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.5,
   "end": 202.76,
   "text": "صحبت کنیم و فرصت کوتاهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.76,
   "end": 208.92,
   "text": "پیرامون اون موضوعی که ما هم گفتیم خیلیا میگن که در مطلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.92,
   "end": 214.8,
   "text": "حاجات دنیوی و اخرویتون به امام جواد صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.8,
   "end": 221.64,
   "text": "توسل کنید. دقت بفرمایید این رو من یه مقدار کمکی بازش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.64,
   "end": 230.98,
   "text": "اونم اینکه ما قبلاً عرض کردیم بزرگان اهل بیت علیهم الصلاة و السلام، بزرگان اهل معرفت به ما تأکید کردن که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.98,
   "end": 233.5,
   "text": "اهل بیت نخود کشمیش نخواهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.5,
   "end": 235.82,
   "text": "این‌ها مقامشون انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.82,
   "end": 239.28,
   "text": "مقامشون به صادر نخستین رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.28,
   "end": 241.32,
   "text": "این‌ها از این‌ها باید چی خواست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.32,
   "end": 244.74,
   "text": "خدا رو خواست، خودشون رو خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.74,
   "end": 249.2,
   "text": "اینا همین که در محضر حضور اون‌ها قرار گرفتی کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.2,
   "end": 255.2,
   "text": "دیگه چی می‌خوای؟ زشت نیست به نظر شما انسان بره مثلاً محضر امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.2,
   "end": 257.86,
   "text": "سلطان اول و آخر عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.86,
   "end": 260.56,
   "text": "زانو بزنه بعد بگه آقا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.56,
   "end": 265.78,
   "text": "اا ازت خونه می‌خوام، ماشین می‌خوام، مشکلات مالی دارم، مشکلات جسمی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.78,
   "end": 268.16,
   "text": "چون اینو از مولامون علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.16,
   "end": 271.96,
   "text": "آیا از مولا علی جز حکمت خواستن زشت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.96,
   "end": 274.08,
   "text": "وقتی شما اون شخصیت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.08,
   "end": 278.68,
   "text": "بارها مثال زدیم واسه اینکه البته این مثال خیلی ضعیفه ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.68,
   "end": 283.98,
   "text": "دستمون کوتاهه که شما مثلاً بری پیش پروفسور سمعیi ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.98,
   "end": 285.74,
   "text": "التماس‌گونه گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.74,
   "end": 292.78,
   "text": "حالا چته؟ چی شده؟ بری با چه سختی برسی به ایشون مثلاً بعد بگی به من می‌شه یه آمپول بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.78,
   "end": 295.38,
   "text": "خب بابا آمپوله که یه پرستار هم می‌تونه بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.38,
   "end": 297.58,
   "text": "چرا جسارت به مقام ایشون می‌کنی شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.58,
   "end": 302.28,
   "text": "اینطوریه. خواسته‌های ما عموماً متعارفش این شکلیه برای اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.28,
   "end": 308.36,
   "text": "اون‌ها انسان کامل‌اند. لذا حضرت علامه شهرانی، استاد علامه حسن زاده می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.36,
   "end": 314.82,
   "text": "اینو در شرح مصباح الانس حضرت علامه فرمودند که استاد ما علامه شهرانی می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.82,
   "end": 318.2,
   "text": "ما مطلق اونچه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.2,
   "end": 321.54,
   "text": "حضرت عبدالعظیم حسنی خواستیم گرفتیم از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.54,
   "end": 324.88,
   "text": "هرچی از ایشون خواهیم سو واسطه فیض ما بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.88,
   "end": 328.46,
   "text": "واسطه خیر بود. اما از امام رضا هیچی نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.46,
   "end": 333.54,
   "text": "عجب! این عالم بزرگ، عالم ربانی یعنی چی از امام بزرگ что نگرفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.54,
   "end": 341.1,
   "text": "یعنی حاجت‌های مایی خرد و دنیوی و همین انوات اهل ایمان، همین شيعه‌ امام می‌تونند واسطه خیر باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.1,
   "end": 345.88,
   "text": "پس این مطلق حاجات دنیوی و اخرویتون رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.88,
   "end": 349.54,
   "text": "مثلاً جواد الائمه بخواید یعنی چی بزرگان سفارش کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.54,
   "end": 351.2,
   "text": "ببینید اسم اصلاً تو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.2,
   "end": 354.54,
   "text": "جواب تو خودشه. میگه مطلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.54,
   "end": 359.18,
   "text": "یعنی کلاً سعادت دنیا و آخرتت رو بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.18,
   "end": 364.36,
   "text": "یعنی باز خودشون رو بخواه چون سعادت دنیا و آخرت ما در گرو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.36,
   "end": 367.68,
   "text": "معیت با اون‌هاست. \"کونو مع الصادقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.68,
   "end": 370.56,
   "text": "\"کونو مع الصادقین\" باشید به اتفاق صادقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.56,
   "end": 373.24,
   "text": "این راه نجاته. این صراط مستقیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.24,
   "end": 375.64,
   "text": "حالا صادقین رو برید در تفاسیر ببینید کی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.64,
   "end": 379.7,
   "text": "همین آل الله‌اند. اینکه بر-- با اون‌ها باشی، همراه اونا باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.7,
   "end": 382.0,
   "text": "عندالله باشی، به محضر حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.0,
   "end": 385.56,
   "text": "ببینید الان ما در به یک معنا در محضر حضور هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.56,
   "end": 388.08,
   "text": "درسته؟ الان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.08,
   "end": 390.66,
   "text": "حضور جماعتی که اینجا هستن هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.66,
   "end": 393.14,
   "text": "یک محضری‌ست، محل حضوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.14,
   "end": 396.5,
   "text": "خدا وکیلی در همین جمع چند نفری‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.5,
   "end": 398.3,
   "text": "چقدر آداب رو رعایت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.3,
   "end": 401.4,
   "text": "چرا؟ چون رفیقا هستن، برادران خوبمون هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.4,
   "end": 404.98,
   "text": "این‌ها اصلاً ج-- ج-- جرات نمی‌کنیم خیلی کارا رو بکنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.98,
   "end": 410.42,
   "text": "خیلی حرفا رو بزنیم حتی پامونو دراز کنیم یا با بیرجامه اینجا مثلا راه بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.42,
   "end": 413.02,
   "text": "با لباس زیر و اصلاً جرات نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.02,
   "end": 416.34,
   "text": "به یک معنا چیه؟ محضر حضوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.34,
   "end": 421.06,
   "text": "همین رو برو بالا، تعالى ببر بالا، ببر بالا، ببر بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.06,
   "end": 426.04,
   "text": "انسان متقی به جایی می‌رسه که محضر حضور خدا رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.04,
   "end": 431.96,
   "text": "چنان مراقبش قوی می‌شه که آنفاً خودش رو در معرض نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.96,
   "end": 436.12,
   "text": "حجت و ولی کامل خدا و انسان کامل می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.12,
   "end": 439.6,
   "text": "\"فسیر الله ملکه و رسوله و المؤمنون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.6,
   "end": 441.68,
   "text": "این مو-- خدا که معلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.68,
   "end": 447.66,
   "text": "رسول هم معلوم. اون اهل ایمان کی‌ان که \"فسیر الله و رسوله و المؤمنون\" اون‌ها هم می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.66,
   "end": 450.86,
   "text": "اون‌ها هم می‌بینن اعمال شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.86,
   "end": 457.72,
   "text": "یعنی امام عصر است. نه اینکه فقط دوشنبه و جمعه یا پنجشنبه نامه بره امضا بزنه بخونه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.72,
   "end": 460.9,
   "text": "اصلاً در محضر حضور هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.9,
   "end": 468.52,
   "text": "آنی اگر ایشون نگاه و توجهش رو از تک‌تک موجودات عالم هستی برداره، اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.52,
   "end": 471.9,
   "text": "فانی می‌شن، از بین میرن. مثالش رو از جهت فلسفی زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.9,
   "end": 476.6,
   "text": "مثل اینکه شما در غبغه خیالت هر چیزی رو الان تصور می‌کنی حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.6,
   "end": 480.16,
   "text": "توجهت رو از اون برمی‌داری محو می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.16,
   "end": 487.88,
   "text": "انسان کامل به جایی می‌رسه که تمام کلمات وجودی نظام هستی رو چنان صاع وجودی داره که متوجهه به همشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.88,
   "end": 491.16,
   "text": "رضا همه حاضرند. بهشون توجه داره، نگاه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.16,
   "end": 494.06,
   "text": "نگاهش رو برداره همه فانی می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.06,
   "end": 496.4,
   "text": "ما آنفاً در محضر حضرتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.4,
   "end": 501.28,
   "text": "او واسطه فیض ماست. او رب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.28,
   "end": 504.38,
   "text": "این جایگاه انسان. پس از امام جواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.38,
   "end": 507.1,
   "text": "هم نباید رفت نخود کیش میش خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.1,
   "end": 510.18,
   "text": "نباید رفت حاجات جزئی خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.18,
   "end": 514.74,
   "text": "باید سعادت کلی، سعادت دنیا و آخرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.74,
   "end": 518.84,
   "text": "محضر حضرت حق رو خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.84,
   "end": 522.52,
   "text": "این چنین. اینم یه نکته که حالا تا حالا خیلی اینجا حرف زیاد داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.52,
   "end": 526.68,
   "text": "بماند. تبریک هم عرض می‌کنم ورود حضرت امام علیه الرحمه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.68,
   "end": 533.6,
   "text": "روز اول دهه فجر و ورود امام و من توصیه می‌کنم به خودم و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.6,
   "end": 537.74,
   "text": "که دستاوردهای انقلاب رو خصوصاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.74,
   "end": 540.76,
   "text": "مخصوصاً با توجه به گفته‌های دشمنانمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 540.76,
   "end": 546.22,
   "text": "خیلی جالبه که بعضی جاها خود دشمنانمون هم به زبان آمدند و دستاوردها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 546.22,
   "end": 548.26,
   "text": "و افتخارات ما رو به زبان آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 548.26,
   "end": 550.78,
   "text": "اون‌ها رو بگیم. تو کانال‌هامون بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.78,
   "end": 554.78,
   "text": "من امروز بررسی می‌کردم دیدم الحمدالله بعضیا کارای قشنگی کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.78,
   "end": 557.8,
   "text": "بیست تا، چهل تا، بیش از صد تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.8,
   "end": 563.16,
   "text": "مثلا بعضیا تن دو تن توی کلیپ کوچولو مثلا دستاوردهای انقلاب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 563.16,
   "end": 566.34,
   "text": "یادتون که این برنژیسکی وقتی سال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 566.34,
   "end": 569.7,
   "text": "حالا خودش نود و خورده‌ای بود که به درک واصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 569.7,
   "end": 576.42,
   "text": "تو امنیت آمریکا بود و تو جلسه اتمسف-- تیک شمالی تو ناتو وقتی همه جمع بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 576.42,
   "end": 579.32,
   "text": "خیلی جالب بود که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 579.32,
   "end": 588.06,
   "text": "اِمم... بعد سال نود اگه یادتون باشه حضرت رهبر عزیزمون پیچ تاریخی رو بیان کردند برای اولین بار سال نود که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 588.06,
   "end": 591.46,
   "text": "پیچ تاریخی قطعی‌ست و ما در حال عبور از او هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 591.46,
   "end": 600.72,
   "text": "سال نود و چهار این ملعون که به درک هم واصل شد توی اون جلسه مثلا فرمانده‌های ارشد نظامی و امنیتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 600.72,
   "end": 605.54,
   "text": "ناتو گفتش که سال نود و چهار، چهار سال بعد از فرمان حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 605.54,
   "end": 607.92,
   "text": "گفتش که آره ما اِمم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 607.92,
   "end": 611.38,
   "text": "مجبوریم که از پیچ تاریخی عبور کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.38,
   "end": 613.74,
   "text": "همه دنیا در حال د... اِمم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.74,
   "end": 616.5,
   "text": "عبور کردن از این پیچ تاریخی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.5,
   "end": 619.08,
   "text": "و اون تابلوها رو خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 619.08,
   "end": 623.22,
   "text": "اون تابلوها که شما بخواید بپیچی تابلو می‌زنن، تو خیابونا تابلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 623.22,
   "end": 627.12,
   "text": "تابلوهای این پیچ تاریخی و رهبران ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 627.12,
   "end": 630.8,
   "text": "حالا اون جسارت کرد اسم کوچیک-- اس-- مثلا گفت خمینی و خامنه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 630.8,
   "end": 633.42,
   "text": "من میگم رهبران ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.42,
   "end": 637.56,
   "text": "نصب کردند که در این پیچ تاریخی به چه سمتی برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 637.56,
   "end": 639.32,
   "text": "تو جلسات خودشون این رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.32,
   "end": 642.04,
   "text": "یا اون خاخام‌های یهودی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.04,
   "end": 645.28,
   "text": "تقریباً انقلاب ما سی و هفت هشت سالش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.28,
   "end": 649.4,
   "text": "صراحتا اعلام کردند اسناد محرمانه‌اش بعد درز کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 649.4,
   "end": 655.2,
   "text": "تو رسانه‌ها که اعلام کرد که آه یک قدرتی در شرق ظهور کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 655.2,
   "end": 661.96,
   "text": "منظورش ایران بود که اگر این‌ها چون عدد چهل برای این‌ها خیلی مقدسه، اگر این‌ها به چهل سالگی برسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.96,
   "end": 668.98,
   "text": "یعنی انقلاب ایران به چهل سالگی برسن دیگه نمیشه جلوشون رو گرفت و قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 668.98,
   "end": 673.04,
   "text": "یکتا خواهند بود و همین‌ها اسرائیل را نابود خواهند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 673.04,
   "end": 676.96,
   "text": "و الان چهل و چهار سالست. ببینید این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 676.96,
   "end": 680.74,
   "text": "مثلا یک از زبان خودشون آدم بتونه استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.74,
   "end": 684.22,
   "text": "افتخارآفرینی‌های انقلاب که انفجار نور بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.22,
   "end": 687.06,
   "text": "نور بود رو بگه. نکته آخر را هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 687.06,
   "end": 690.18,
   "text": "به جهت اینکه بحث ما از دستمون در نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 690.18,
   "end": 694.56,
   "text": "خیلی کوتاه دو دقیقه‌ای اگر اجازه بدید دو سه دقیقه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.56,
   "end": 700.84,
   "text": "تحمل کنید. دیگه بالاخره روز میلاد آقا، روز ورود امام همه جا برنامه دارن، سخنرانی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.84,
   "end": 703.9,
   "text": "اینجا متأسفانه نمی‌دونم چرا اینقدر بی‌حالیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.9,
   "end": 707.32,
   "text": "خیلی باید امروز می‌ترکوندیم هممون اینجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.32,
   "end": 710.4,
   "text": "با خیلی کارها و خیلی چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 710.4,
   "end": 712.88,
   "text": "به هر حال چه عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 712.88,
   "end": 715.32,
   "text": "اگر اون آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 715.32,
   "end": 717.7,
   "text": "حالا سلبریتی بگیم چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 717.7,
   "end": 722.86,
   "text": "یه نفهمی که برمی‌گرده یا اون حالا سلبریتی فقط تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 722.86,
   "end": 724.68,
   "text": "هنرمندا و هنرپیشه‌ها نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 724.68,
   "end": 728.61,
   "text": "گاهی اوقات می‌بینی یه مداح اهل بیت هم نمی‌فهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.61,
   "end": 736.65,
   "text": "یه فوتبالیست هم نمی‌فهمه. یه برگشت گفتش که هزاران هزار حکومت و انقلاب فدای جان امام زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 736.65,
   "end": 742.65,
   "text": "در صورتی که رهب-- حضرت امام چقدر زیبا تببین کردن که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 742.65,
   "end": 748.39,
   "text": "حتی هزاران هزار جان فدای حکومت اسلامی حتی جان امام زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 748.39,
   "end": 753.15,
   "text": "اینو هر کسی نمی‌فهمه. کسی می‌فهمه که قدرت تحلیل عاشورا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 753.15,
   "end": 758.55,
   "text": "می‌فهمه که آقا امام حسین عزیزترین شخص ردیفانه ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 758.55,
   "end": 760.73,
   "text": "رو سینش نشستن. خدا صبر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 760.73,
   "end": 764.49,
   "text": "خدا چرا صبر کردی؟ ملائکه چرا آرومی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 764.49,
   "end": 769.71,
   "text": "چرا؟ به جهت اینکه امام حسین فدای حکومت اسلامی و فدای دین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 769.71,
   "end": 772.49,
   "text": "دین، ناموس خدا دین خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 772.49,
   "end": 774.41,
   "text": "اونا اومدن دین رو پیاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 774.41,
   "end": 778.21,
   "text": "حکومت، حکومت اسلامی هم میاد دین رو پیاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 778.21,
   "end": 782.21,
   "text": "که اولین حکومت اسلامی بعد از اهل بیت به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 782.21,
   "end": 787.27,
   "text": "هر کسی حکومت رو کمک نکنه یه روزی پشیمون خواهد شد و چوب خواهد خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 787.27,
   "end": 793.81,
   "text": "اینجا باید گفت بله امام زمان هم خودش رو فدای حکومت اسلامی می‌کنه که عدالت برقرار بشه، دین پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 793.81,
   "end": 797.39,
   "text": "چیز عجیبی نیست. برای همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 797.39,
   "end": 804.65,
   "text": "امروز واقعا باید تو ادارجات قیامت میشد و نمی‌دونم چرا چه خبره چه دل‌مردگی گرفته ادارجات و سازمان‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 804.65,
   "end": 806.33,
   "text": "ماها رو از جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 806.33,
   "end": 808.67,
   "text": "همین چهار کلام هم نگیم دیگه چیکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 808.67,
   "end": 813.47,
   "text": "نکته آخرش و سیر بحث ما بحث ملائکه بود و قول داده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 813.47,
   "end": 820.43,
   "text": "در سیر بحث کتاب الموت مرحوم مجلسی بحث ملائکه رو بکشیم وسط که واسطه‌ی فیض و امداد الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 820.43,
   "end": 827.09,
   "text": "و امروز می‌خواستیم دسته دسته ملائکه رو بشینیم و فرصت نمی‌کنیم فقط یه نکته‌ای عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 827.09,
   "end": 830.31,
   "text": "عرض کردیم که هر چیزی در این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 830.31,
   "end": 835.97,
   "text": "یه صورت طبیعی دارد، یه صورت مثالی دارد، یه صورت عقلی دارد، یه صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 835.97,
   "end": 842.69,
   "text": "الهی دارد. این نکته رو هم لای پرانتز بگم اگر بعضیا گفتن سه صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 842.69,
   "end": 850.29,
   "text": "گفتن طبیعی، مثالی، عقلی و به الهی اشاره نکردن، منظورشون اینه که چون همه قبول دارن که هر چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 850.29,
   "end": 857.51,
   "text": "صورت الهی دارد. سبحان الذي بیده ملكوت کل شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 857.51,
   "end": 860.71,
   "text": "و الیه ترجعون. آیه آخر سوره یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 860.71,
   "end": 862.99,
   "text": "پس صورت الهی رو همه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 862.99,
   "end": 869.15,
   "text": "اون ذیلش اونایی که اربعه میگن بعد یا مثلا ثلاثه میگن اینا تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 869.15,
   "end": 873.11,
   "text": "اونا الهی رو اشاره نمی‌کنن. اینا میگن ولی الهیت نظام رو همه قبول دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 873.11,
   "end": 876.93,
   "text": "روح ما از اون جنسه. حالا این صورت در ملائکه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 876.93,
   "end": 883.33,
   "text": "گفتیم ملائکه هم چهار تا همینطوری صورت‌های مختلف در عوالم اربعه‌ دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 883.33,
   "end": 886.29,
   "text": "اینجا به صورت ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 886.29,
   "end": 888.45,
   "text": "ظهور می‌کنند ملائکه به امداد غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 888.45,
   "end": 892.53,
   "text": "بارون صورت طبیعی ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 892.53,
   "end": 895.37,
   "text": "حالا من اینو، اینو که قبلاً گفته بودیم اینو می‌خواستم بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 895.37,
   "end": 899.37,
   "text": "در حالا هر کدوم از این ملائکه طبقه‌بندی هم یه وظایفی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 899.37,
   "end": 902.73,
   "text": "یه روح اعظمه ذیلش چهار دسته ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 902.73,
   "end": 906.99,
   "text": "هر کجا حرف از علم است، پای حضرت جبرائیل میانه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 906.99,
   "end": 909.51,
   "text": "هر کجا حرف از روزی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 909.51,
   "end": 911.77,
   "text": "پای حضرت میکائیل، کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 911.77,
   "end": 914.35,
   "text": "فاعو فیها الکی میکائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 914.35,
   "end": 916.05,
   "text": "یه روزی رسان است در میانس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 916.05,
   "end": 918.11,
   "text": "این بارون‌ها، برف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 918.11,
   "end": 920.67,
   "text": "که داره میاد همه بادها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 920.67,
   "end": 924.77,
   "text": "و ارسلنا الرياح لواء همه زیر سر حضرت میکائیل‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 924.77,
   "end": 928.23,
   "text": "و کارگزارانش. هر کجا که حرف از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 928.23,
   "end": 930.77,
   "text": "اماته-- احیا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 930.77,
   "end": 935.95,
   "text": "در دمیدن و نفخ فیه من روح حیات است، پای حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 935.95,
   "end": 939.73,
   "text": "اسرافیل است و هر کجا حرف از اماته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 939.73,
   "end": 941.87,
   "text": "حرف از حضرت عزرائیل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 941.87,
   "end": 945.25,
   "text": "حالا هر چه هست وقتی جهلتو می‌میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 945.25,
   "end": 952.15,
   "text": "و حیات برات رخ می‌ده باز عزرائیل اینجاست چون اماته‌ی جهل توسط عزرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 952.15,
   "end": 961.29,
   "text": "الان شما می‌خوام یه نز-- یه مثال بزنم که الان متوجه بشی تو همین جلسه في المجلس ملائکه چگونه نزول کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 961.29,
   "end": 968.11,
   "text": "اگر شما این چیزی که ورزش فکریه در ظاهر من دارم با الفاظ بازی می‌کنم شما هم صوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 968.11,
   "end": 971.35,
   "text": "یه کمه یا کیف مسموعه می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 971.35,
   "end": 973.57,
   "text": "یه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 973.57,
   "end": 976.23,
   "text": "صوت ماده‌ست داری می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 976.23,
   "end": 980.29,
   "text": "ولی یه چیزی رو، یه حقیقتی رو می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 980.29,
   "end": 983.85,
   "text": "از ملکوت عالم یه چیزی رو متوجه میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 983.85,
   "end": 986.37,
   "text": "یه حقیقتی رو درک می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 986.37,
   "end": 987.99,
   "text": "این ربطی به ماده نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 987.99,
   "end": 990.63,
   "text": "من دارم ماده صحبت من مادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 990.63,
   "end": 992.89,
   "text": "صوته مربوط به عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 992.89,
   "end": 995.35,
   "text": "اما فهم مربوط به ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 995.35,
   "end": 999.91,
   "text": "اگر از این حرف‌ها الفاظ شما در صغر نفس خودت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 999.91,
   "end": 1003.05,
   "text": "مکمن غیبت چیزی رو فهمیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1003.05,
   "end": 1006.51,
   "text": "چشیدی و بهش رسیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1006.51,
   "end": 1009.37,
   "text": "اون رو حضرت علامه می‌فرماید نزول ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1009.37,
   "end": 1013.87,
   "text": "اون فهمت، اون فهمت در صغر نفس ناطقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1013.87,
   "end": 1018.89,
   "text": "اگر صورتی براش بری در قوه خیالت اون صورت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1018.89,
   "end": 1023.23,
   "text": "صورت ملکیه که نازل شده در قوه خیالت می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1023.23,
   "end": 1027.77,
   "text": "اگر در عـ-- عالم عقلت در عقلش، اونا ملائکه هم جنسشون از عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1027.77,
   "end": 1029.89,
   "text": "اون کلی رو گرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1029.89,
   "end": 1034.53,
   "text": "باز اون صورت کلی عقلی ملکیه که براتون نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1034.53,
   "end": 1036.71,
   "text": "الهی هم که مربوط به روحه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1036.71,
   "end": 1045.17,
   "text": "ارتباط با حضرت حق. این یه چیزی بود که به صورت کلی خواستم از نحوه تنزل ملائکه بگم صورت‌های مختلفشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1045.17,
   "end": 1047.19,
   "text": "که از بحث هم در نرفته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1047.19,
   "end": 1049.75,
   "text": "ان شا الله که عاقبت بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1049.75,
   "end": 1052.71,
   "text": "نصار همه شهدا، امام عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1052.71,
   "end": 1059.13,
   "text": "و نصار ذریه حضرت زهرا مخصوصا حضرت جواد الائمه صلوات بلند خط کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1059.13,
   "end": 1062.41,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1062.41,
   "end": 1065.37,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}