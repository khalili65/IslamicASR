 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت دوم کتاب الموت؛ الحیات والموت خلقان",
   "start": 5.48,
   "end": 69.16
  },
  {
   "index": 1,
   "title": "## مؤمنون/۱۴؛ خلق آخر و شدت انتقال",
   "start": 69.16,
   "end": 190.36
  },
  {
   "index": 2,
   "title": "## ملائکۀ دنیا و برزخ؛ پس‌زدن و نپذیرفتن",
   "start": 190.36,
   "end": 389.7
  },
  {
   "index": 3,
   "title": "## حیات برزخی و آخرتی؛ نفخ صور در زمر",
   "start": 389.7,
   "end": 479.04
  },
  {
   "index": 4,
   "title": "## تناسخ باطل و تناسخ مقبول اسلام",
   "start": 479.04,
   "end": 552.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.58,
   "end": 4.42,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.42,
   "end": 9.0,
   "text": "خب عزیزان در حال رفتن به این زیارت اربعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.0,
   "end": 15.02,
   "text": "حسینی هستم. بدرقه راه همه زوار امام حسین یه صلوات خط کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 20.0,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.0,
   "end": 22.06,
   "text": "خیلی سریع ادامه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.06,
   "end": 24.54,
   "text": "روایت دوم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.54,
   "end": 28.52,
   "text": "مرحوم مجلسی در بهار رو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.52,
   "end": 30.96,
   "text": "عرض کردیم که در باب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.96,
   "end": 36.94,
   "text": "روایت دوم با باب صلوات الله علیه فرمودند الحیات و الموت خلقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.94,
   "end": 40.1,
   "text": "این خلق که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.1,
   "end": 46.26,
   "text": "تصریح میکنه که هم حیات هم موت خلقند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.26,
   "end": 48.18,
   "text": "خلقت‌ها با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.18,
   "end": 51.86,
   "text": "بعضی خلقت‌ها هستند که شدت دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.86,
   "end": 54.04,
   "text": "و این شدت خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.04,
   "end": 60.98,
   "text": "مثلاً به معنای در بعضی از جاهای قرآن به معنای یک خلق جدید یا خلق دیگری بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.98,
   "end": 68.7,
   "text": "مثلاً در آیه چهارده سوره مؤمنون اگر دقت کرده باشید میفرماید \"ثم خلقنا نطفة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.7,
   "end": 73.4,
   "text": "وقتی این تطور خلقت رو در این پنج مرحله بیان میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.4,
   "end": 79.64,
   "text": "اون مرحله انتهایی یعنی جنین درست شدن رو میگه خلق آخر یعنی یک خلق دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.64,
   "end": 82.78,
   "text": "چون شدت خلقت اینجا وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.78,
   "end": 86.16,
   "text": "\"ثم خلقنا نطفة علقة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.16,
   "end": 91.38,
   "text": "نطفه میشه علقه. \"فخلقنا العلقة مضغة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.38,
   "end": 97.64,
   "text": "علقه میشه مضغه. اون خونه بسته شده میشه مثل یک مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.64,
   "end": 99.6,
   "text": "تکه گوشت جویده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.6,
   "end": 107.04,
   "text": "\"فخلقنا المضغة عظاما\" بعد استخون میاد \"فكسا آن العظام لحما\" گوشت میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.04,
   "end": 109.58,
   "text": "\"ثم أنشأناه خلقا آخر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.58,
   "end": 113.62,
   "text": "اینجا ببینید میفرماید بعد خدا ان شاء میکنه او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.62,
   "end": 115.94,
   "text": "ایجاد میکنه به یک صورت دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.94,
   "end": 117.54,
   "text": "یعنی یک خلق جدیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.54,
   "end": 120.46,
   "text": "این خلق جدید به یک معنا یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.46,
   "end": 124.0,
   "text": "شدت خلقت یا انتقال شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.0,
   "end": 131.14,
   "text": "همه این‌ها از یک مرحله دارن میرن تو این مراحل پنج گانه که در این آیه بیان شده میرن به مرحله جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.14,
   "end": 134.18,
   "text": "اما اون مرحله آخر که میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.18,
   "end": 137.0,
   "text": "\"أنشأناه خلقا آخر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.0,
   "end": 139.54,
   "text": "یک انتقال شدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.54,
   "end": 143.04,
   "text": "انتقالش خیلی متفاوت از اون‌های دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.04,
   "end": 145.7,
   "text": "مثل دقیقاً موت. موت که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.7,
   "end": 148.58,
   "text": "حاصل میشه انتقال ما خیلی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.58,
   "end": 152.3,
   "text": "اما اون موت انتقال یک خلق دیگریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.3,
   "end": 157.6,
   "text": "یک حالت دیگری دارد لذا انتقال به شدت رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.6,
   "end": 161.82,
   "text": "قابل قیاس با مراحل دیگر خلقت نیست برای همین خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.82,
   "end": 165.54,
   "text": "خطرناکه، خیلی شدیده، خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.54,
   "end": 169.64,
   "text": "لذا اون کسی هم می‌تونه این انتقال رو انجام بده که شدید القوی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.64,
   "end": 175.42,
   "text": "اون ملکی که حضرت قابض الأرواح خیلی شدید القوی است، خیلی قدرت داره؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.42,
   "end": 178.08,
   "text": "چون انتقال، انتقال شدیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.08,
   "end": 184.78,
   "text": "که البته یکی از معانی سكرات مرگ یا اون سختی و این‌هایی که در برزخ پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.78,
   "end": 189.36,
   "text": "اصلاً همین شدت انتقاله، شدت انتقال این حالت عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.36,
   "end": 193.44,
   "text": "یا حالا به یک معنا ملائکه‌ای که در دنیا هستند پس می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.44,
   "end": 196.76,
   "text": "میت رو میگن آقا پیمانت تموم شد به سلامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.76,
   "end": 198.68,
   "text": "رزقی دیگه اینجا نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.68,
   "end": 204.7,
   "text": "ملائکه عالم برزخ نگاه می‌کنند می‌بینند که حالا متاسفانه اکثریت مردم هم اینطورین لحظه مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.7,
   "end": 208.34,
   "text": "نگاه می‌کنند می‌بینند که پیمانش پر شده از اون ور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.34,
   "end": 212.14,
   "text": "اما آمادگی ورود به برزخ هم نداشته و نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.14,
   "end": 214.22,
   "text": "یعنی این سیر استکمالی رو طی نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.22,
   "end": 217.34,
   "text": "انقدر دلبستگی و تعلق به دنیا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.34,
   "end": 221.06,
   "text": "هنوز نکنده از دنیا. برای همین ملائکه برزخ هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.06,
   "end": 223.98,
   "text": "تحویلش نمی‌گیرن. اصلاً معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.98,
   "end": 227.24,
   "text": "اون درد، اون ترس، اون ظلمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.24,
   "end": 231.72,
   "text": "اون غربت، اینا همینن. این ور پسش زده، اون ور تحویلش نمی‌گیره؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.72,
   "end": 233.8,
   "text": "چون به تکامل نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.8,
   "end": 236.68,
   "text": "لذا قطعاً باید تکامل برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.68,
   "end": 246.28,
   "text": "طی بشه. حالا در این مسیر ما بعضی از آیات قرآن رو داریم و حتی روایاتی که نشون میدن ما دو بار می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.28,
   "end": 248.68,
   "text": "دو بار موت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.68,
   "end": 252.68,
   "text": "اینم یه نکته خودشه. یه توجه بهش بکنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.68,
   "end": 254.86,
   "text": "برای امروز کفایت می‌کنه. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.86,
   "end": 257.38,
   "text": "یازده سوره غافر رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.38,
   "end": 260.06,
   "text": "\"ربنا أمَتنا صنتین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.06,
   "end": 263.92,
   "text": "یعنی پروردگار ما تو دو بار ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.92,
   "end": 265.88,
   "text": "مو-- اِاِاِ میراندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.88,
   "end": 268.4,
   "text": "\"أمتنا صنتین\" دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.4,
   "end": 271.22,
   "text": "و البته و \"وأحييتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.22,
   "end": 274.58,
   "text": "صنتین\" دو بارم ما رو زنده کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.58,
   "end": 279.02,
   "text": "خب این دو بار مردن و دو بار زنده شدن مال کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.02,
   "end": 283.32,
   "text": "یا مثلاً در شرح اصول کافی روایتم اگه بخوایم کنارش بگذاریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.32,
   "end": 288.2,
   "text": "داریم از حضرت عیسی در اون شرح اصول کافی ملاصدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.2,
   "end": 294.06,
   "text": "از حضرت عیسی علی نبينا و آله و عليه صلاة السلام یه روایت خیلی زیبایی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.06,
   "end": 298.2,
   "text": "حضرت عیسی فرمودند \"لم يلق الملكوت السماوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.2,
   "end": 301.02,
   "text": "من لم يولد مرتين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.02,
   "end": 304.86,
   "text": "هیچکس نمی‌تونه به ملکوت یعنی به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.86,
   "end": 307.4,
   "text": "آسمان‌ها دسترسی پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.4,
   "end": 309.88,
   "text": "مگر اینکه دو بار بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.88,
   "end": 312.62,
   "text": "ببین اینجا باز تو این روایت دو بار مردن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.62,
   "end": 317.98,
   "text": "تو آیه قرآن هم آیه یازده سوره غافر دو بار مردن رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.98,
   "end": 320.24,
   "text": "آیا به راستی ما دو بار می‌میریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.24,
   "end": 324.42,
   "text": "اینجا مثلاً حضرت علامه طباطبایی اومدن فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.42,
   "end": 328.08,
   "text": "تعبیر علامه اینه. عليه الرحمة میفرمایند یک بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.08,
   "end": 331.04,
   "text": "مرگ در دنیا اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.04,
   "end": 334.4,
   "text": "اینجا این موتی که اینجا اتفاق میفته موت اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.4,
   "end": 336.58,
   "text": "موت دوم که در برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.58,
   "end": 338.36,
   "text": "یعنی ما در برزخ هم می‌میریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.36,
   "end": 343.24,
   "text": "بله. در سی-- اون سیر تکاملی که داریم به سمت نشئه آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.24,
   "end": 346.34,
   "text": "که دیگه شدیدترین خلق جدید خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.34,
   "end": 348.84,
   "text": "لذا میگن خلق آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 348.84,
   "end": 352.78,
   "text": "مثل اینجا که \"أنشأناه خلقا آخر\" میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 352.78,
   "end": 355.8,
   "text": "اونجا دو مرتبه در برزخ موت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.8,
   "end": 362.02,
   "text": "یک انتقال به شدت که اصلاً قابل قیاس به انتقال از دنیا به برزخ نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.02,
   "end": 366.24,
   "text": "مثل انتقال جنین از رحم مادر به این دنیا چقدر سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.24,
   "end": 368.36,
   "text": "که مادر چه دردی رو تحمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.36,
   "end": 371.06,
   "text": "خود بچه هم درد رو تحمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.06,
   "end": 375.78,
   "text": "ن-نافشو که بندشو که می‌خوان ببرن خیلی بچه درد می‌کشه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.78,
   "end": 377.5,
   "text": "ولی اینجا دیگه مادری در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.5,
   "end": 384.56,
   "text": "خودe انتقال که میدن تو رو وقتی موت ما رو منتقل می‌کنند، درد شدیدی وجود رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.56,
   "end": 387.1,
   "text": "اونجا هم در برزخ هم دو مرتبه ما می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.1,
   "end": 391.04,
   "text": "این بار دومه. آخه حیات چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.04,
   "end": 393.66,
   "text": "یک بار حیات برزخی پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.66,
   "end": 396.34,
   "text": "در برزخ ورود می‌کنیم، حیات برزخی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 396.34,
   "end": 398.66,
   "text": "یه بار هم حیات آخرتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.66,
   "end": 402.42,
   "text": "چون در برزخ هم موت اتفاق می‌افته بعدش دوباره حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.42,
   "end": 404.56,
   "text": "حالا اون کجا گفته اون رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 404.56,
   "end": 407.4,
   "text": "در آیه شصت و هشت سوره زمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.4,
   "end": 410.26,
   "text": "\"و نفخ في الصور فصعق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.26,
   "end": 413.78,
   "text": "من في السماوات ومن في الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.78,
   "end": 418.18,
   "text": "میگه هرچی در آسمان‌ها و زمینه هرکه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.18,
   "end": 420.6,
   "text": "صعق، صعقه می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 420.6,
   "end": 422.88,
   "text": "یعنی یک فریاد بلند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.88,
   "end": 425.06,
   "text": "صعق. همه می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 425.06,
   "end": 427.34,
   "text": "این مال کیه؟ مال اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 427.34,
   "end": 429.8,
   "text": "لحظه‌ی ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 429.8,
   "end": 432.56,
   "text": "مرگ دومه. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 432.56,
   "end": 436.42,
   "text": "برزخ وقتی صعقه می‌زنن همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 436.42,
   "end": 439.26,
   "text": "در صور دمیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 439.26,
   "end": 441.28,
   "text": "دو مرتبه همه می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 441.28,
   "end": 445.16,
   "text": "بعد حیات آخرت دیگه خلق جدید شدیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 445.16,
   "end": 453.66,
   "text": "که دیگه اون دیگه مرحله نهایی دیگه خیلی بالای بالای خلقت و این تطورات خلقت ماست که همه قراره بریم اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 453.66,
   "end": 457.82,
   "text": "حالا انسان کامل همه این مراحل رو اینجا رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 457.82,
   "end": 462.42,
   "text": "انسان کامل. همه این مراحل رو رفته و اینجا براش رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 462.42,
   "end": 464.18,
   "text": "اون موت قبل ان تموتوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 464.18,
   "end": 472.7,
   "text": "هم اگر امکانش نبود ما تو این دنیا بمیریم نمی‌گفتن بمیرید قبل از اینکه شما رو بمیرانند که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 472.7,
   "end": 481.12,
   "text": "پس این مراقب اون لحظه انتقال شدیدمون از این عالم به اون عالم باشیم که حالا اینجا اختلافاتی رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 481.12,
   "end": 484.76,
   "text": "بعضیا اومدن مثلا بحث تناسخ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 484.76,
   "end": 490.52,
   "text": "تماسخ و تراسخ و تفاسخ رو گفتن که یه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 490.52,
   "end": 494.32,
   "text": "بسیار باطلیه. ما تناسخ رو قبول داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 494.32,
   "end": 500.62,
   "text": "اونا چی میگن؟ میگن تنا-- اینم خوب گوش بدید و رو بحث‌هاتون پیش میاد امروزه تو شبهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.62,
   "end": 503.48,
   "text": "تناسخ مثلا اونا میگن انسان میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 503.48,
   "end": 506.5,
   "text": "روحش میره تو بدن یک انسان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 506.5,
   "end": 513.26,
   "text": "این تناسخ بهش میگن. در تر-تماسخ میگن روح انسان میره تو بدن یه حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.26,
   "end": 516.14,
   "text": "در تراسخ میگن میره تو بدن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 516.14,
   "end": 517.92,
   "text": "نبات، یه درخت مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.92,
   "end": 520.32,
   "text": "در تفاسخ میگن میره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 520.32,
   "end": 522.88,
   "text": "هیکل یه سنگ مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 522.88,
   "end": 525.6,
   "text": "اینطور میگن. ولی در صورتی که اسلام اینو قبول نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 525.6,
   "end": 528.44,
   "text": "اسلام میگه ما تناسخ رو به این شکل قبول داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 528.44,
   "end": 531.64,
   "text": "مثل اینکه ما می‌خوابیم میریم تو بدن برزخیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.64,
   "end": 534.58,
   "text": "الان وقتی می‌خوابیم میریم تو قالب مثالی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.58,
   "end": 540.8,
   "text": "همینطورم وقتی موت حاصل می‌شه ما می‌ریم در بدنی که خودمون با اعمالمون اینجا ساختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 540.8,
   "end": 544.14,
   "text": "این تناسخ رو قبول داریم نه اون به این شکلی که اونا میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.14,
   "end": 545.86,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 545.86,
   "end": 548.94,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 548.94,
   "end": 552.34,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}