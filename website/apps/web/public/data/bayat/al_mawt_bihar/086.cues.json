 "chapters": [
  {
   "index": 0,
   "title": "## ولایت شیطان و فراموشی مرگ",
   "start": 6.1,
   "end": 89.48
  },
  {
   "index": 1,
   "title": "## قسم شیطان به عزّت خدا و استثنای مخلصین",
   "start": 89.48,
   "end": 219.3
  },
  {
   "index": 2,
   "title": "## عبادی؛ توحید ذاتی و ثلاثۀ وحده‌ها",
   "start": 219.3,
   "end": 632.51
  },
  {
   "index": 3,
   "title": "## توبهٔ شیطان و سلطنت بر متولّیان او",
   "start": 632.51,
   "end": 851.5
  },
  {
   "index": 4,
   "title": "## قیامت کبری هنگام موت و عینک آلودهٔ برزخ",
   "start": 851.5,
   "end": 992.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.1,
   "end": 9.72,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.72,
   "end": 13.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.64,
   "end": 18.98,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.98,
   "end": 21.6,
   "text": "در روایت پنجم از باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.6,
   "end": 24.68,
   "text": "چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.68,
   "end": 28.56,
   "text": "در موضوع ولایت شیطان و ربطش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.56,
   "end": 31.8,
   "text": "فراموشی مرگ. رسیده بودیم به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.8,
   "end": 36.66,
   "text": "قسمت که قطعاً کسی که تحت ولایت شیطان قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.66,
   "end": 39.6,
   "text": "مرگ و موت رو فراموش می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.6,
   "end": 41.9,
   "text": "و باور نداره که قراره بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.9,
   "end": 45.92,
   "text": "و اگر کسی بلعکسشم گفتیم هست، اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.92,
   "end": 48.96,
   "text": "فراموشی مرگ بهش دست داد قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.96,
   "end": 54.46,
   "text": "سر خورده سمت شیطان و تحت ولایت شیطان قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.46,
   "end": 58.68,
   "text": "و نکته‌ای رو پیرامون ولایت شیطان عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.68,
   "end": 67.18,
   "text": "و اجازه بدید که این رو از تو دل چند تا آیه در بیاریم که بالاخره ولایت شیطان به چه کسایی کارساز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.18,
   "end": 69.96,
   "text": "چه کسایی گاردشون رو محکم بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.96,
   "end": 75.28,
   "text": "مصون‌اند از ولایت شیطان که اگر کسی از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.28,
   "end": 80.14,
   "text": "به اون مقام نرسیده باشه قطعاً چه بداند چه نداند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.14,
   "end": 84.14,
   "text": "تحت ولایت شیطان رفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.14,
   "end": 89.48,
   "text": "حتی اگر خبر نداشته باشه و وقتی سرش به سنگ لحد خورد تازه می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.48,
   "end": 93.86,
   "text": "مثلا در آیه سی و نه و چهل سوره حجر می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.86,
   "end": 96.86,
   "text": "گفتم این صحبت‌ها و مهاجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.86,
   "end": 101.46,
   "text": "این دشمن پلید و خبیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.46,
   "end": 107.08,
   "text": "جهان بشری رو که شیطانه، اون شیطان رجم، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.08,
   "end": 111.84,
   "text": "سردمدارشون. اونو با خدا رو بخونید تو قرآن ببینید خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.84,
   "end": 115.4,
   "text": "نکات عجیبی ازش در میاد. یکیش اینه که به خدا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.4,
   "end": 117.78,
   "text": "\"فبعزتک\" فبعزتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.78,
   "end": 120.6,
   "text": "قسم به عزت خدا می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.6,
   "end": 123.2,
   "text": "و پیداست که خیلی کار جدیه، قصه جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.2,
   "end": 126.84,
   "text": "\"لأغوينّهم أجمعين\" اون لام هم که تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.84,
   "end": 129.14,
   "text": "قطعاً من همشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.14,
   "end": 134.34,
   "text": "اغوا می‌کنم. یه همچین دشمنی داریم که کاملاً مترصد ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.34,
   "end": 137.56,
   "text": "ما بی‌خبر و غافل از او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.56,
   "end": 141.26,
   "text": "و او مترصد ماست با تمام قوای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.26,
   "end": 143.32,
   "text": "اما خودش اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.32,
   "end": 146.12,
   "text": "چون گفتیم بعد از امام هر زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.12,
   "end": 149.4,
   "text": "عالم‌ترین شخص اون زمان شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.4,
   "end": 152.48,
   "text": "یه همچین شخصی که انقدر علم داره میگه \"إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.48,
   "end": 155.2,
   "text": "عبادك منهم المخلصين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.2,
   "end": 158.12,
   "text": "عجب! اونم نه مخلصین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.12,
   "end": 162.9,
   "text": "مخلص. حالا فرق مخلص و مخلص رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.9,
   "end": 166.36,
   "text": "قبلاً گفتیم رهبر عزیزمون یه بار تو صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.36,
   "end": 168.6,
   "text": "قشنگشون تصریح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.6,
   "end": 173.64,
   "text": "حالا مفصله یه نکته‌ش رو فقط عرض کنم فرقش رو بدونیم تا چیزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.64,
   "end": 178.0,
   "text": "اونم اینکه مخلص فرقش اینه که هیچی از خدا نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.0,
   "end": 181.52,
   "text": "خدا رو، خود خدا رو می‌خواد. اما مخلص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.52,
   "end": 185.6,
   "text": "خالص شده یعنی به مقام اخلاص رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.6,
   "end": 188.62,
   "text": "اما خلوص شاید نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.62,
   "end": 193.44,
   "text": "یعنی خلوصم اگر هم داشته باشه عیارش خیلی بالاست، بالا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.44,
   "end": 196.86,
   "text": "خلوص شدت اخلاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.86,
   "end": 201.08,
   "text": "طوریه که یعنی مخلص طوریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.08,
   "end": 205.64,
   "text": "خودش رو خالص کرده. هیچی نه بهشت می‌خواد، نه فرار از جهنم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.64,
   "end": 207.28,
   "text": "همون عبادت، عبادت أبراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.28,
   "end": 211.34,
   "text": "حالا اینا کم‌اند، خیلی کم‌اند. اکثر ماها به شوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.34,
   "end": 215.46,
   "text": "سیب و گلابی و حور بهشتی و قصور و انهار و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.46,
   "end": 219.3,
   "text": "هستیم. اما اون‌ها اصلاً اینطوری نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.3,
   "end": 223.46,
   "text": "در آیه چهل و دو حجر می‌فرماید \"إن عبادي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.46,
   "end": 227.02,
   "text": "بندگان من \"ليس لك عليهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.02,
   "end": 231.68,
   "text": "سلطان إلا من اتبعك من الغاوين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.68,
   "end": 235.44,
   "text": "بر اون‌هایی که بندگان من هستند یعنی در بند خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.44,
   "end": 238.88,
   "text": "هرچی خدا گفت چشم. اصلاً دیگه چون و چرا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.88,
   "end": 241.72,
   "text": "خدایا این کارو انجام بدم ثوابش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.72,
   "end": 244.9,
   "text": "خدایا این کارو انجام بدم منو از جهنم بیرون میاری، نجات میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.9,
   "end": 248.02,
   "text": "اصلاً این حرفا تو کت، کته اینا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.02,
   "end": 251.56,
   "text": "میگه اینا \"عبادي\" تمام بنده منن، من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.56,
   "end": 255.9,
   "text": "من. مثل \"فادخلی عبادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.9,
   "end": 258.02,
   "text": "وادخلی جنتی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.02,
   "end": 262.16,
   "text": "که حکما و عرفا اینا همه تصریح فرمودند که این جنت ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.16,
   "end": 266.0,
   "text": "یعنی پی حضرت حق رفته. یعنی در، به توحید ذاتی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.0,
   "end": 271.94,
   "text": "فناء في الله و بقاء بالله و اینا که قبلاً بحث‌هاش بین ما گذشته تقریباً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.94,
   "end": 274.08,
   "text": "که یعنی عرض کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.08,
   "end": 276.42,
   "text": "وحده، وحده، وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.42,
   "end": 281.98,
   "text": "دیگه افعال خودش رو، اون وحده سوم به توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.98,
   "end": 287.14,
   "text": "افعال خودشو فانی در افعال حضرت حق دیده میگه لا حول و لا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.14,
   "end": 289.54,
   "text": "إلا بالله. وحده وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.54,
   "end": 292.0,
   "text": "اون صفات خودش رو هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.0,
   "end": 297.78,
   "text": "\"ما أصابك من حسنة فمن الله\" هرچی خیر و خوبی درشه میگه از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.78,
   "end": 300.1,
   "text": "صفات خودشو فانی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.1,
   "end": 303.96,
   "text": "صفات الله می‌بینه. لذا میگه لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.96,
   "end": 307.16,
   "text": "وحده اول که دیگه نقطه پرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.16,
   "end": 309.5,
   "text": "مخلصینه. دیگه اوجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 309.5,
   "end": 313.84,
   "text": "می‌شه گفت معراجه یا عرشه که عرش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.84,
   "end": 317.78,
   "text": "رتبش مافوق صادر اول و اولین تعyینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.78,
   "end": 319.52,
   "text": "دیگه خیلی خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.52,
   "end": 322.36,
   "text": "اونجا دیگه \"قلب المؤمن عرش الرحمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.36,
   "end": 325.9,
   "text": "قلب، مقام قلب. میگه فلان چیز در قله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.9,
   "end": 329.36,
   "text": "قافه. یعنی انقدر دوره. قاف، قاف قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.36,
   "end": 332.36,
   "text": "انقدر دست یافتن به اون سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.36,
   "end": 337.46,
   "text": "عزیز دلم، اونجا میگه ذات خدا، اصلاً بود خودت رو، وجود خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 337.46,
   "end": 339.68,
   "text": "فانی و مستهلک در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 339.68,
   "end": 343.26,
   "text": "وجود خدا می‌بینی. یعنی خودت رو هم خودت نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 343.26,
   "end": 346.48,
   "text": "جلوه حق، ظهور حق، آیت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 346.48,
   "end": 350.1,
   "text": "مجلای حق، کلمه الهی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.1,
   "end": 353.32,
   "text": "این می‌شه این چیزی که ما داریم درباره‌ش همین‌طوری سخن می‌گیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.32,
   "end": 357.2,
   "text": "راحت رد می‌شیم، می‌ریم در حالی که کنّ مریم ما بزرگان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 357.2,
   "end": 360.51,
   "text": "خودشونو بیچاره کردن تا به این مقام برسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 360.51,
   "end": 363.29,
   "text": "یک عمر تلاش کردن زحمت کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.29,
   "end": 365.71,
   "text": "فقط اینان که س-- لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 365.71,
   "end": 368.39,
   "text": "می‌فرماید \"لیس لک علیهم سلطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 368.39,
   "end": 370.35,
   "text": "تو نمی‌تونی به اینا سلطنت پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 370.35,
   "end": 375.35,
   "text": "اینا غرق در منن. یعنی اینطوری بخوایم بریم جلو عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 375.35,
   "end": 376.93,
   "text": "خیلی قصه خطرناک می‌شه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 376.93,
   "end": 379.35,
   "text": "یعنی اونایی که شوق به بهشت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 379.35,
   "end": 383.73,
   "text": "روایات میگه بد نیست. اما س-- حسنات الأبرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.73,
   "end": 388.77,
   "text": "سیئات المقربین. برای کسی که می‌خواد مقر– مقرب بشه اینم گناه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 388.77,
   "end": 392.93,
   "text": "اینم بوی شیطان می‌ده. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 392.93,
   "end": 396.65,
   "text": "قرآن سوره واقعه که همه انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.65,
   "end": 399.05,
   "text": "سرود شبانگاهی همه‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.05,
   "end": 402.21,
   "text": "سوره واقعه وقتی اون سه تا رو می‌شمره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.21,
   "end": 405.11,
   "text": "وقتی می‌رسه به اصحاب یمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.11,
   "end": 407.43,
   "text": "می‌فرماید \"ثلة من الأولین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 407.43,
   "end": 409.89,
   "text": "ثلة من الآخرین\". ثله‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 409.89,
   "end": 412.87,
   "text": "بسیاری از قدیمن، بسیاری از جدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 412.87,
   "end": 416.65,
   "text": "اما مقربین رو چی میگه مقربون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 416.65,
   "end": 421.83,
   "text": "اصحاب سابقون. \"ثلة من الأولین\" و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 421.83,
   "end": 424.55,
   "text": "آفرین \"قلیل من الآخرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 424.55,
   "end": 427.15,
   "text": "به هر کسی نمی‌دن اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 427.15,
   "end": 434.01,
   "text": "چرا \"قلیل من الآخرین\"؟ حالا اینجا خیلی حرفا داریم و علامه چقدر تو هم مصباح العقولش هم شرح فصوصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 434.01,
   "end": 437.61,
   "text": "میگه این توجه به همین \"قلیل من الآخرین\" داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 437.61,
   "end": 439.87,
   "text": "چقدر اینجا حرف پیاده کرده استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 439.87,
   "end": 443.55,
   "text": "خدا روحش رو شاد کنه. این \"قلیل من الأولین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 443.55,
   "end": 446.01,
   "text": "پر طاووس رو به کرکس نمی‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 446.01,
   "end": 448.09,
   "text": "هرچی میری-- شهید حججی روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 448.09,
   "end": 450.97,
   "text": "به علی اون پسرش علیه وصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 450.97,
   "end": 452.37,
   "text": "چند دقیقه‌ای می‌کنه اینجا وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 452.37,
   "end": 457.35,
   "text": "شهید شدن اون روز ما اومدیم یه تحلیلی ازش ارائه دادیم با سیزده تا نکته حاییشون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 457.35,
   "end": 461.41,
   "text": "اونجا به پسرش علی میگه که هرچی میریم جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 461.41,
   "end": 466.27,
   "text": "زمانه سخت‌تر می‌شه، گناه بیشتر می‌شه، پاک بودن سخت‌تره اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 466.27,
   "end": 468.61,
   "text": "واقعاً هم اینطوریه. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 468.61,
   "end": 471.93,
   "text": "ما اعتقاد داریم به سمت نور در حرکتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 471.93,
   "end": 476.81,
   "text": "\"الله ولي الذين آمنوا يخرجهم من الظلمات إلى النور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 476.81,
   "end": 479.67,
   "text": "داره شدت می‌گیره، شدت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 479.67,
   "end": 481.61,
   "text": "الان رهبر واقعاً درست میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 481.61,
   "end": 485.67,
   "text": "جوونایی که الان هستن واقعاً یه سر و گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 485.67,
   "end": 487.73,
   "text": "بالاتر از جوونای زمان جنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.73,
   "end": 494.29,
   "text": "اونایی که الان تو وادی نورن و شدت-- اصلاً باید اینطور باشه چون به شدت دارن به سمت نور حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 494.29,
   "end": 496.19,
   "text": "\"نور على نور، نور على نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 496.19,
   "end": 499.27,
   "text": "هی تجلی حضرت حق آن fortnight بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 499.27,
   "end": 505.99,
   "text": "اما از اون طرفش هم هست. اونایی که ولایت طاغوت رو اختیار کردن یعنی تحت ولایت شیطان قرار گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 505.99,
   "end": 508.55,
   "text": "اونا \"من الظلمات إلى النور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 508.55,
   "end": 510.91,
   "text": "به شدت هی ظلمت روی ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 510.91,
   "end": 513.91,
   "text": "کی یه همچین تصرفی در گناه بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 513.91,
   "end": 518.25,
   "text": "کی یه همچین راحتی‌ای برای انجام گناه در عالم بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 518.25,
   "end": 521.41,
   "text": "تو چقدر خلوتت یه گوشه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 521.41,
   "end": 525.87,
   "text": "عذرتی تمام گناه‌ها در دسترست باشه با رسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 525.87,
   "end": 530.67,
   "text": "مثلا امپراتوری دروغ، دروغ، دروغ‌ها که میگن دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 530.67,
   "end": 533.31,
   "text": "از قدیم به ما می‌گفتن دروغگو دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 533.31,
   "end": 536.45,
   "text": "از بچگی خدا رحمت کنه مادرمون همیشه به ما می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 536.45,
   "end": 539.31,
   "text": "اکبر دروغ نگیا. دروغگو دشمن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 539.31,
   "end": 542.19,
   "text": "اینو هی به ما نهیب می‌زدن. یعنی چی دروغگو دشمن خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 542.19,
   "end": 544.41,
   "text": "مگه من کیم که با خدا دشمنی کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 544.41,
   "end": 547.53,
   "text": "الان داریم می‌فهمیم امپراتوری دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 547.53,
   "end": 551.75,
   "text": "یعنی اون کسی که اون دجالی که در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 551.75,
   "end": 554.85,
   "text": "نظام ولایت آل الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 554.85,
   "end": 558.65,
   "text": "محیط ولایت آل الله و امام عصر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 558.65,
   "end": 564.71,
   "text": "که قراره انشاالله تمام زحمات اولیا، انبیا رو به ثمر برسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 564.71,
   "end": 567.81,
   "text": "قد علم کرده همین امپراتوری دروغه، همین رسانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 567.81,
   "end": 570.89,
   "text": "الان اغتشاشات اینا می‌بینی همش ری-- زیر سر چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 570.89,
   "end": 574.17,
   "text": "همین رسانه‌ها. دروغ، دروغ، دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 574.17,
   "end": 577.89,
   "text": "و اون دجال اصلاً همینه. اینکه تک‌چشمه روایت میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 577.89,
   "end": 580.45,
   "text": "تک‌چشمه یک چشم در پیشانی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 580.45,
   "end": 586.79,
   "text": "اینو روایت میگه و میاد مردم رو بسیاری از مردم رو به بالا سر خودش می‌کشونه میره و در دریا غرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 586.79,
   "end": 589.69,
   "text": "اینکه چرا دریا، چرا غرق می‌شن، چرا تک‌چشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 589.69,
   "end": 592.45,
   "text": "اینا بزرگان حرف‌ها پیاده کردن برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 592.45,
   "end": 596.13,
   "text": "حالا خیلیشون تفسیر کردن که بسیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 596.13,
   "end": 600.43,
   "text": "حالا قطعاً صد درصد نگفتن اما تعبیرش فرمودن شاید همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 600.43,
   "end": 605.45,
   "text": "ماهواره و موبایل و این تک‌چشم تلویزیون و ببین یک چشم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 605.45,
   "end": 608.79,
   "text": "این چنینه که شما همینجا نشستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 608.79,
   "end": 612.71,
   "text": "می‌تونی مخابره کنی به تمام دنیا تصویرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 612.71,
   "end": 615.99,
   "text": "تمام دنیا تو رو می‌بینه. یعنی از اینجا داری گناه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 615.99,
   "end": 621.11,
   "text": "نقطه به نقطه حتی تو کعبه کسی باشه موبایل دستش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 621.11,
   "end": 624.17,
   "text": "اونجا در معرض گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 624.17,
   "end": 626.71,
   "text": "این یعنی کثرت، شدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 626.71,
   "end": 632.51,
   "text": "توجه کردی چی شد؟ برای همین سخت‌تره و ولایت شیطان گسترش، گسترش خیلی بیشتر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 632.51,
   "end": 639.51,
   "text": "بیخود نیست وقتی موسی بهش گفتش که بابا برگرد من وساطت می‌کنم تو آدم شو، درست شو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 639.51,
   "end": 642.71,
   "text": "توبه کن. گفت باشه برو به خدا بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 642.71,
   "end": 645.69,
   "text": "بعد به خدا گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 645.69,
   "end": 649.41,
   "text": "خدا هم گفت راهش اینه که بیاد بگه غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 649.41,
   "end": 651.27,
   "text": "کی؟ شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 651.27,
   "end": 656.57,
   "text": "بیاد بگه غلط کردم. بیاد جلوی شما به من بگه من غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 656.57,
   "end": 659.79,
   "text": "نه خودشو هر کسی هم که اغوا کرده می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 659.79,
   "end": 666.99,
   "text": "این عجب خدایی داریم. بعد اومد حضرت موسی خوشحال بهش گفت آره مژده بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 666.99,
   "end": 669.59,
   "text": "خدا گفته بیا بگو غلط کردم تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 669.59,
   "end": 672.87,
   "text": "گفت همین یه دونه رو من نمی‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 672.87,
   "end": 675.49,
   "text": "بعد گفتش که این حرف و جمله رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 675.49,
   "end": 682.13,
   "text": "گفت اگر من هم بخوام بیام خدا باید بیاد چون سر خدا خلوت‌تر از منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 682.13,
   "end": 686.53,
   "text": "من سرم شلوغ‌تره الان. الان که دیگه خیلی به شدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.53,
   "end": 689.31,
   "text": "اکثر املاء عقلون الان خیلی بهت-- بیشتر دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.31,
   "end": 692.55,
   "text": "\"قلیل\" همون که گفتم حالا تو اونجا بودیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 692.55,
   "end": 694.81,
   "text": "\"قلیل من الآخرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 694.81,
   "end": 697.55,
   "text": "جا نمونیم از این قافله. بریم جلوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 697.55,
   "end": 700.63,
   "text": "آیه صد نحل. \"انما سلطانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 700.63,
   "end": 703.81,
   "text": "على الذين يتولونه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 703.81,
   "end": 706.85,
   "text": "سلطنت شیطان برای کساییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 706.85,
   "end": 709.81,
   "text": "\"يتولونه\" دوستش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 709.81,
   "end": 715.03,
   "text": "حالا یعنی چی؟ یعنی ما آدم خبیث رو دوست داریم، یه شخص خبیث رو دوست داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 715.03,
   "end": 720.93,
   "text": "کارهاشو دوست داریم. کارهاشو دوست داریم، کف نفس می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 720.93,
   "end": 724.39,
   "text": "جسارت به شما نشه ها. حالا ما کلی داریم صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 724.39,
   "end": 728.24,
   "text": "اصلاً فکر کنید کتاب وجودی خودمو دارم بر عقل می‌زنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 728.24,
   "end": 730.94,
   "text": "کف نفس می‌کنیم چشمامون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 730.94,
   "end": 733.86,
   "text": "نامحرم می‌بندیم. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 733.86,
   "end": 738.02,
   "text": "اما می‌گم دندون رو جیگر گذاشتم و بستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 738.02,
   "end": 743.34,
   "text": "یعنی اسلام دست ما رو بست که ما چشمامونو بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 743.34,
   "end": 749.86,
   "text": "این می‌شه که بعد که ترمز پاره کردیم یهو اونوری شدیم بدتر از اونوریا می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 749.86,
   "end": 755.24,
   "text": "یه آدم خدایی نکرده تو این وادی مونده باشه، کف نفس کرده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 755.24,
   "end": 758.68,
   "text": "چون دوست داره گناه رو انجام نمی‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 758.68,
   "end": 761.66,
   "text": "چون اصلاً یه سری گناه رو انجام بده آبروش می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 761.66,
   "end": 766.52,
   "text": "چون اینطوریه وقتی ترمز پاره کنه یعنی رها کنه اعتقاداتو دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 766.52,
   "end": 773.42,
   "text": "کسی به گردش نمی‌رسه. اینه که خیلی انقلابیون همین مذهبی‌ها می‌بینی یه دفعه که چپه می‌کنن بد چپ می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 773.42,
   "end": 779.52,
   "text": "علتش اینه. دوست داشته گناه رو رو انجام ولی انجام نداده‌ها ولی دوست داشته تو دل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 779.52,
   "end": 782.12,
   "text": "تو دلش، تو این گوشه‌ی دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 782.12,
   "end": 785.5,
   "text": "اینه که خیلی واقعاً میل دل به چه سمتی می‌ره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 785.5,
   "end": 789.02,
   "text": "لیلة الرغائب، رغبت، رغبت‌ها کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 789.02,
   "end": 791.76,
   "text": "میل دل کجاست؟ الان میل دلت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 791.76,
   "end": 794.48,
   "text": "تو نمازی، تو سجده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 794.48,
   "end": 797.14,
   "text": "بهترین حالت بنده با خدا سجده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 797.14,
   "end": 799.28,
   "text": "اونجا میل دلت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 799.28,
   "end": 804.86,
   "text": "یکی بیاد حاجی که اونطوری الهی ال-- تو سجده اینو بشکاف قلبتو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 804.86,
   "end": 808.06,
   "text": "قاف قلبتو بشکاف ببینیم چی اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 808.06,
   "end": 816.8,
   "text": "تو تور قلبت، قاف قلبت، مقام تور قلبت که قلبته، اون بطنان و مکمن غیب قلبته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 816.8,
   "end": 818.78,
   "text": "باز کنی ببینی شیطان اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 818.78,
   "end": 821.36,
   "text": "میگی آقا مگه عرش الرحمن نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 821.36,
   "end": 823.64,
   "text": "مگه شیطان به عرش راه پیدا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 823.64,
   "end": 826.0,
   "text": "اگر این قافه، اگر این توره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 826.0,
   "end": 831.52,
   "text": "بله حضرت موسی که در کوه تور مناجات می‌کرد شیطان اونجام رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 831.52,
   "end": 835.52,
   "text": "و گفت نا، نانجیب خبیث تو اینجا چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 835.52,
   "end": 838.7,
   "text": "گفت برو عمو جون. حالا من لطیفه‌ش رو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 838.7,
   "end": 842.66,
   "text": "ما در مقام غد جد آدم رو اغوا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 842.66,
   "end": 848.22,
   "text": "شما دیگه فلان. ما دشمن رو درسته کیدش قرآن میگه ضعیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 848.22,
   "end": 850.06,
   "text": "اما ما هم گاردمون رو نبستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 850.06,
   "end": 854.3,
   "text": "غافل بودیم ازش. لذا این باعث شد ما به کجا برسه وضعیتمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 854.3,
   "end": 858.82,
   "text": "شما بفرمایید. برسه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 858.82,
   "end": 861.06,
   "text": "العیاذ بالله یه دفعه می‌بینی س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 861.06,
   "end": 865.22,
   "text": "قیامتمون که قیامت کرد لحظه‌ی موتم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 865.22,
   "end": 868.62,
   "text": "فکر نکنین قیامت باید منتظر باشیم یه زمانی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 868.62,
   "end": 871.96,
   "text": "نه. اصلاً قیامت کبری که همین جا اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 871.96,
   "end": 875.28,
   "text": "ما حالیمون نیست. بدنمون گرمه، هنوز سرد نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 875.28,
   "end": 878.84,
   "text": "و الا قیامت کبری برای من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 878.84,
   "end": 882.34,
   "text": "افتادن پرده‌هاست. الان پرده‌ها افتاده ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 882.34,
   "end": 885.66,
   "text": "مغبر فضا، ما غبار، غبار جلومون رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 885.66,
   "end": 890.68,
   "text": "حالا می‌گیم موت. وقت موت قیامت کبریه که تازه می‌فهمیم عجب چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 890.68,
   "end": 894.22,
   "text": "تحت تصرفش بودیم، چقدر دل بهش بسته بودیم، به کا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 894.22,
   "end": 897.66,
   "text": "به چیزهایی که اون آلارم می‌داد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 897.66,
   "end": 901.82,
   "text": "توجه می‌کردیم و فلان. حالا توبه می‌کنیم، حالا تصفیف، تصفیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 901.82,
   "end": 903.68,
   "text": "خدا به داد هممون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 903.68,
   "end": 907.38,
   "text": "یعنی کار، کار دشواریه. اینطوری نیست به ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 907.38,
   "end": 911.56,
   "text": "خیلی عذرخواهی می‌کنم هر بی‌سر و پایی رو تو این وادی راه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 911.56,
   "end": 915.5,
   "text": "درسته خدا گفته همه بیان همه رو می‌بخشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 915.5,
   "end": 919.96,
   "text": "اما اینطوری نیست که هر بی‌سر \"لا یمسهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 919.96,
   "end": 925.54,
   "text": "إلا المتحرون\". جز با طهارت نمی‌شه مس کرد ملکوت عالم رو، نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 925.54,
   "end": 929.8,
   "text": "حتی کسی هم که می‌میره اگر آلوده باشه درسته میره به لی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 929.8,
   "end": 933.12,
   "text": "ملاقات پروردگارش اما غبار آلوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 933.12,
   "end": 936.74,
   "text": "اونطور که باید خدا رو ملاقات نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 936.74,
   "end": 940.82,
   "text": "این خودش یه زجر، شما فکر کن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 940.82,
   "end": 945.64,
   "text": "عینک، الان رو عینک من خش افتاده یه چند روزه، یه خش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 945.64,
   "end": 949.0,
   "text": "زیاد خش افتاده. می‌ذارم چشمم هی عینکم رو ورمیدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 949.0,
   "end": 951.0,
   "text": "هی چشمم رو اذیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 951.0,
   "end": 958.02,
   "text": "گمان کنی یه عینک پر از خش و آلودگی بزنی رو چشت دائم جلوتو نمی‌تونی درست ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 958.02,
   "end": 960.66,
   "text": "زجر خودش، یکی از زجر‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 960.66,
   "end": 963.3,
   "text": "برزخ اینه. حقایق رو نمی‌تونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 963.3,
   "end": 967.98,
   "text": "حضرت زهرا رو نمی‌تونی ببینی. خداتو نمی‌تونی درست مق-- ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 967.98,
   "end": 971.78,
   "text": "ملاقات کنی. بذار در اعرافی بین جهنم و بهشتی تو برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 971.78,
   "end": 979.54,
   "text": "اصلاً برزخ یعنی این. تا یه شفیعی بیاد شفاعتت کنه آیا استعدادت مضمحل شده، نشده و خیلی راه طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 979.54,
   "end": 983.12,
   "text": "خدا به هممون رحم کنه. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 983.12,
   "end": 986.18,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 986.18,
   "end": 989.12,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 989.12,
   "end": 992.98,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}