 },
 "chapters": [
  {
   "index": 0,
   "title": "## فرار از موت؛ غفلت از توفّی الهی",
   "start": 8.68,
   "end": 74.08
  },
  {
   "index": 1,
   "title": "## پریشانی از کف روی آب",
   "start": 74.08,
   "end": 385.99
  },
  {
   "index": 2,
   "title": "## روز حنین؛ غرور کثرت",
   "start": 385.99,
   "end": 792.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 3.12,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.12,
   "end": 5.34,
   "text": "و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.34,
   "end": 8.12,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.12,
   "end": 10.12,
   "text": "عرض کردیم در این سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.12,
   "end": 15.08,
   "text": "روایاتی که بهشون برخوردیم در باب سوم تا پیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.08,
   "end": 18.96,
   "text": "روایت دهم همه غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.96,
   "end": 21.7,
   "text": "یک موضوع رو دنبال می‌کنند اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 21.7,
   "end": 26.86,
   "text": "اینکه انسان توجه به قدرت الهی نداشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.86,
   "end": 30.32,
   "text": "و از مرگ، موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.32,
   "end": 38.14,
   "text": "فرار کنه. حواسش نباشه که الله یتوفی الأنفس حين موتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.14,
   "end": 40.36,
   "text": "و همه چی به دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.36,
   "end": 50.18,
   "text": "حالا به بهانه طاعون، به بهانه مریضی، به بهانه مرگ، موت اینا یا حتی بخواد مثلاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.18,
   "end": 54.72,
   "text": "واجبش فرار کنه، واجب الهی رو ترک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.72,
   "end": 58.8,
   "text": "به خاطر ترس از موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.8,
   "end": 64.28,
   "text": "حالا ترس از طاعون و ترس از امیکرون و ترس از کرونا و این‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.28,
   "end": 68.62,
   "text": "برای چی می‌ترسه طرف؟ برای اینکه انتهاش به موت ختم می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.62,
   "end": 70.74,
   "text": "باز می‌شه به یک معنا همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.74,
   "end": 77.38,
   "text": "ترس از موت. یا چرا خیلی‌ها در خود انقلاب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.38,
   "end": 81.22,
   "text": "متاسفانه کوتاه اومدن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.22,
   "end": 84.34,
   "text": "ارزش‌های انقلاب، از اون حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.34,
   "end": 90.08,
   "text": "اون کلمه وحدت آفرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.08,
   "end": 92.08,
   "text": "کلمة الله هي العليا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.08,
   "end": 94.94,
   "text": "ابتداي انقلاب اون حرفی که زدن بعد کوتاه اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.94,
   "end": 98.34,
   "text": "خیلی از متاسفانه متولیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.34,
   "end": 101.48,
   "text": "و مسئولین و مدیران سطح بالای کشور ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.48,
   "end": 106.62,
   "text": "چرا؟ علتش اینه که ترسیدن، ایمانشون ضعیف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.62,
   "end": 110.6,
   "text": "حتی من دیدم بعضیا که متاسفانه تو خود سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.6,
   "end": 112.26,
   "text": "کار می‌کردن برام عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.26,
   "end": 118.46,
   "text": "تو دیگه چرا که لباس سپاه تنتی که بچه‌ها زمان جنگ بدون وضو اینو نمی‌پوشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.46,
   "end": 123.08,
   "text": "مردمی که مریض داشتن دست می‌کشیدن به این لباس شفا می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.08,
   "end": 129.62,
   "text": "می‌گفت من نمی‌دونم ره-- این آقا که تو سپاه بود می‌گفت من نمی‌دونم رهبر به چه امیدی جلو آمریکا وایساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.62,
   "end": 133.32,
   "text": "به چه امیدی؟ به پشتوانه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.32,
   "end": 137.96,
   "text": "مثلا جنگ‌افزارهای اونا رو نگاه می‌کنی اصلاً قابل مقایسه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.96,
   "end": 141.4,
   "text": "اون چیزی که ما داریم نیست. اینا و این می‌فهمید حرف‌های عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.4,
   "end": 144.14,
   "text": "چرا؟ این نشونده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.14,
   "end": 148.22,
   "text": "این کرنیزی که در برابر دشمن می‌کنه علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.22,
   "end": 150.52,
   "text": "اینکه توجه به قدرت خدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.52,
   "end": 153.82,
   "text": "ان الله خدا، خدای منّان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.82,
   "end": 156.14,
   "text": "وعده داده که یدافع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.14,
   "end": 159.92,
   "text": "عن الذين آمنوا دفاع می‌کنه از اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.92,
   "end": 163.84,
   "text": "مدافع خداست. شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.84,
   "end": 167.56,
   "text": "این توجه نکردن به خدا و امدادهای الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.56,
   "end": 169.3,
   "text": "چرا ما انقدر پریشون می‌شیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.3,
   "end": 171.44,
   "text": "یه مشکل اجتماعی پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.44,
   "end": 178.84,
   "text": "مثل همین اخیرا. یه مشت کف روآبی مثلاً تلاطم ایجاد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.84,
   "end": 181.28,
   "text": "توی دریای لایت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.28,
   "end": 186.44,
   "text": "بیکران انقلاب. یه خار و خسی ریختن اذیت‌هایی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.44,
   "end": 189.1,
   "text": "بعد خیلی از ما پریشون شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.1,
   "end": 191.06,
   "text": "بعضیا ناامید شدن. گفتن کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.06,
   "end": 196.8,
   "text": "تموم شد دیگه. من شنیدم از بعضیا که گفتن کار تموم شد بچه خوبامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.8,
   "end": 200.46,
   "text": "ولی پیش آقا که رفتن چقدر آقا محکم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.46,
   "end": 204.7,
   "text": "که اون مادر شهید به صدا دراومد گفت ما وقتی میایم محضر شما اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.7,
   "end": 206.78,
   "text": "تزریق امید به ما می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.78,
   "end": 212.56,
   "text": "شما کی هستی؟ چی هستی؟ علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.56,
   "end": 214.3,
   "text": "علتش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.3,
   "end": 216.86,
   "text": "توجه به وعده‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.86,
   "end": 220.8,
   "text": "امدادهای غیبیه. اینا چیز کمی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.8,
   "end": 226.74,
   "text": ". اینا رو مرور کنیم. بعضیاش تو وصیت‌نامه‌های شهدا اومده، بعضیاش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.74,
   "end": 233.9,
   "text": "زندگی‌نامه‌هاشون اومده حتی خارج از کشور الان در جنگ مثلا مقاومت این‌ها زیاد اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.9,
   "end": 237.9,
   "text": "یکی از بچه‌های لبنان می‌گفت تو همون جنگ سی و سه روزه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.9,
   "end": 240.98,
   "text": "رفتیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.98,
   "end": 244.5,
   "text": "خیلی-- یه جایی قرار گرفتیم که به شدت بمبارون شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.5,
   "end": 246.2,
   "text": "دیگه فرار کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.2,
   "end": 248.94,
   "text": "دیگه هیچ راه پیش و پسی نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.94,
   "end": 251.4,
   "text": "فرار کردیم هر جا می‌رفتیم بمبارون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.4,
   "end": 253.96,
   "text": "تا رسیدیم به یه دهکده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.96,
   "end": 256.82,
   "text": "متروکه خالی بود. همه فرار کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 256.82,
   "end": 258.66,
   "text": "یه خونه دیدیم که درش قفله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 258.66,
   "end": 262.0,
   "text": "دیگه رفتیم در اون قفل رو شکستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 262.0,
   "end": 265.12,
   "text": "رفتیم داخل این خونه پناه بردیم به این خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.12,
   "end": 268.92,
   "text": "برا-- ایشون صریحاً می‌گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.92,
   "end": 275.36,
   "text": "ما وارد-- چون ما یه زمان ارتباط داشتیم با بچه‌های مقاومت جلساتی داشتیم، فرمانده‌هاشون می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.36,
   "end": 281.46,
   "text": "مخصوصاً اون موقع که ما کارهای محرمانه می‌کردیم تو همین سازمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.46,
   "end": 283.58,
   "text": "پیرامون حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.58,
   "end": 289.36,
   "text": "نیروهای خودمون، نیرو قدس و چه و اینا بعداً منجر به درگیری‌ها با داعش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.36,
   "end": 296.3,
   "text": "می‌گفت ما وارد اون خونه که شدیم، همین‌طور وارد شدیم، اون جماعتی که وارد شدیم و همه هم به شدت گرسنه بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.3,
   "end": 299.16,
   "text": "تشنه بودیم، دیدیم یه سفره پهنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.16,
   "end": 301.3,
   "text": "توش پر غذاست. هیچکس هم تو خونه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.3,
   "end": 306.0,
   "text": "در خونه هم قفل بود. نگاه کردیم دیدیم غذا گرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.0,
   "end": 309.02,
   "text": "غذا داغه، آماده خوردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.02,
   "end": 312.04,
   "text": "انواع و اقسام غذاها، میوه‌ها، آب و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.04,
   "end": 314.28,
   "text": "و ما با تعجب همدیگه رو نگاه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.28,
   "end": 317.42,
   "text": "خوردیم دیدیم عبا-- اصلاً غذا انگار همین الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.42,
   "end": 320.58,
   "text": "پخته شده و ایشون می‌گفت ما تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.58,
   "end": 324.06,
   "text": "تا-- اصلاً نه-- تو کل عمرمون همچین غذایی نخورده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.06,
   "end": 326.56,
   "text": "انقدر خوش طعم، خوش عطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.56,
   "end": 332.2,
   "text": "با این‌ها کسی که ایمانش ضعیفه الان این حرفا رو شاید بشنوه بگه بابا چی می‌گید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.2,
   "end": 334.44,
   "text": "شوخیتون گرفته. ولی واقعاً و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.44,
   "end": 336.7,
   "text": "تو همین انقلاب خودمون شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.7,
   "end": 340.78,
   "text": "وقتی میری در درون لایه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 340.78,
   "end": 343.92,
   "text": "وجودی انقلاب، ادارجات، سازمان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 343.92,
   "end": 353.74,
   "text": "این‌ها می‌چرخی حتی تو بعضی از مردم یقین می‌کنی که واقعاً امام عصر و خدا داره این انقلاب رو مدیریت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.74,
   "end": 357.86,
   "text": "واسطه‌های پاکانی مثل رهبر عزیزمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.86,
   "end": 361.33,
   "text": "یکه تازانی مثل سردار سلیمانی و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.33,
   "end": 362.97,
   "text": "و صریح آیه قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.97,
   "end": 364.93,
   "text": "آیه بیست و پنج توبه رو با هم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.93,
   "end": 367.87,
   "text": "حالا آیه بعدش رو می‌خواستم بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 367.87,
   "end": 373.41,
   "text": "چون دیگه نصف وقتمون رفت همین آیه رو روش توقف کردیم همین رو دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 373.41,
   "end": 377.17,
   "text": "مرور کنیم. \"لقد نصرکم الله في مواطن كثيرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.17,
   "end": 384.49,
   "text": "قطعاً به تحقیق ما شما رو در مواطن بسیاری \"نصرکم الله\" خدا شما رو یاری کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.49,
   "end": 389.43,
   "text": "\"ويوم حنين\" حالا باید دید تو جنگ حنین چه خبر بوده که مخصوصاً آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.43,
   "end": 391.81,
   "text": "\"اذ اعجبتكم كثرتكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.81,
   "end": 396.07,
   "text": "شما از کثرت تعداد خودتون تعجب کرده بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.07,
   "end": 398.77,
   "text": "غره شدید. خیلی عجیبه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.77,
   "end": 402.55,
   "text": "به کثرت-- اصلاً آقا گیرم که ما خیلی زیادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.55,
   "end": 405.89,
   "text": "اگرچه \"قلة عددنا كثرة عدونا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.89,
   "end": 408.67,
   "text": "اما گیرم ما خیلی زیادیم تجهیزاتمون هم خیلی زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.67,
   "end": 410.83,
   "text": "اگه بخواهیم به این غره بشینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.83,
   "end": 413.43,
   "text": "جواب اون آقایی که این سؤال رو کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.43,
   "end": 417.13,
   "text": "صریحاً اینجا قرآن داره میگه \"فلن تقنعكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.13,
   "end": 421.57,
   "text": "اصلاً اینو شما رو-- شما رو غنی نکرد این تعداد زیاد شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.57,
   "end": 427.51,
   "text": "به چه دلیل؟ فرار کردید. امداد الهی بود که شما رو حفظ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.51,
   "end": 429.85,
   "text": "همه چی به دست خداست. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.85,
   "end": 436.21,
   "text": "خیلی جالبه که من داشتم تفسیر روایی زیل این آیه رو می‌نو-- می‌دیدم خیلی روایات متعددی اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.21,
   "end": 438.59,
   "text": "خیلی شیرینه که دو تاشو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.59,
   "end": 444.05,
   "text": "در تفسیر روایة اهل بیت علیهم السلام جلد شش، صفحه هشتاد و چهار چند تا روایت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.05,
   "end": 447.17,
   "text": "البته اینی که الان میگم براتون تو مستدرک هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.17,
   "end": 450.45,
   "text": "مستدرک الوسائل، جلد شونزده، صفحه هشتاد و پنج هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 450.45,
   "end": 452.95,
   "text": "زیل آیه چی؟ بیست و پنج توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.95,
   "end": 455.33,
   "text": "امام کاظم سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.33,
   "end": 461.09,
   "text": "فرمودن-- اینو البته ابو علی بن راشد و یه جمعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 461.09,
   "end": 465.87,
   "text": "با همدیگه رفته بودن منزل امام کاظم سلام الله علیه با حضرت گفت و گو کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 465.87,
   "end": 468.85,
   "text": "روایت طولانیه فقط همین قسمتش رو میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.85,
   "end": 474.27,
   "text": "که این ابو راشد میگه من یه نوشته‌ای اونجا خونه امام کاظم دیدم که از حضرت سؤال شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.27,
   "end": 480.65,
   "text": "در شما می‌خوره این سؤال. آقا کسی قسم خورده یه انفاق سنگینی بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.65,
   "end": 484.47,
   "text": "بعضی گره‌ها خیلی کور میشه تو زندگی‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.47,
   "end": 487.01,
   "text": "ما از اساتیدمون یاد گرفتیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.01,
   "end": 490.21,
   "text": "دوستانمون میگیم یه صدقه سنگین بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.21,
   "end": 492.23,
   "text": "سنگین، نه یه ده هزار تومن بده به فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.23,
   "end": 496.21,
   "text": "گره‌ای باز کنی، آبرویی بخری خیلی تاثیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.21,
   "end": 501.43,
   "text": "اصلاً صدقه حتی برای اموات. لیلة الرغائب یکی از بهترین شب‌های سال بود برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.43,
   "end": 504.35,
   "text": "اینکه طبق، طبق نور بفرستی برای امواتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.35,
   "end": 507.95,
   "text": "روایت داریم مخصوصاً با اطعمه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.95,
   "end": 511.15,
   "text": "و مثلاً بسته‌های غذایی. گره باز کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.15,
   "end": 514.61,
   "text": "اینا. بعد طرف میگه خب چقدر باید بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.61,
   "end": 518.15,
   "text": "این مثلاً زیادی صدقه سنگین یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.15,
   "end": 523.25,
   "text": "اتفاقاً تو همین روایت این ابو راشد میگه دیدم اونجا نوشته بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.25,
   "end": 526.69,
   "text": "کسی که قسم یاد کرده یه صدقه سنگین بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 526.69,
   "end": 532.27,
   "text": "که باز تاکید می‌کنم ببینید ما هم از این دنیا خواهیم رفت و اصلاً رفتیم خبر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.27,
   "end": 534.01,
   "text": "ما از این دنیا رفتیم. تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.01,
   "end": 539.41,
   "text": "اکثرمون چهل پنجاه سالو گذروندیم و طبق روایاتی که بررسی کردیم کارمون تمومه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.41,
   "end": 541.41,
   "text": "الان موتمون آغاز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.41,
   "end": 546.43,
   "text": "موت ما شروع شده لذا قوای وجودیمون خُد خُد داره سفر آخرتشو میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.43,
   "end": 548.57,
   "text": "هی ضعف و اینا به جهت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.57,
   "end": 552.35,
   "text": "موت ما شروع شده. حالا شما با تعجب ما رو نگاه کنید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.35,
   "end": 557.23,
   "text": "قبول نکنید. ولی شروع شده. این جوونام که به ریش ما پیرمردها می‌خندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 557.23,
   "end": 559.25,
   "text": "شما هم گرفتار می‌شین غصه نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.25,
   "end": 564.47,
   "text": "موتت که شروع بشه. بعد اونجا اتفاقاً خیلی جالبه شما بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.47,
   "end": 570.45,
   "text": "وقتی که پیغمبر نماز لیلة الدفن رو یا وحشت رو بیان کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.45,
   "end": 575.63,
   "text": "اول فرمود صدقه. میت به محض اینکه می‌میره، نه شبی که دفن میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.63,
   "end": 579.59,
   "text": "اون لحظه‌ای که مُرد وارد عالم برزخ و قبرش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.59,
   "end": 584.87,
   "text": "قبر اصلی هم اونه. این قبر اینجا بارها گفتیم قبر فقهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 584.87,
   "end": 586.49,
   "text": "یه سری احکام داره پودر بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.49,
   "end": 589.99,
   "text": "اصلاً قبر فقهی ندارن. قبرشون اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 589.99,
   "end": 593.09,
   "text": "بدن مثالیشونه که میرن در قالب اون قرار می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.09,
   "end": 598.63,
   "text": "این معنای درست تناسخ در اسلامه که قبلاً بحثش گذشته بین ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.63,
   "end": 602.91,
   "text": "خب اونجا پیغمبر اول فرمود یه صدقه به نیت میتتون بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.91,
   "end": 604.59,
   "text": "اون لحظه که وارد عالم برزخ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 604.59,
   "end": 610.99,
   "text": "عجیبه صدقه که یه روایت داریم که استادای ما با گریه می‌گفت یه روزی بعد دیدم شیخ عباس آوردش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.99,
   "end": 614.61,
   "text": "محدث عظیم. فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.61,
   "end": 620.67,
   "text": "اگر چشماتون باز بشه می‌بینید امواتتون التماس بهتون می‌کنن با گریه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 620.67,
   "end": 625.21,
   "text": "جسارتا استخونی که جلو سگ میندازی به نیت ما بنداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.21,
   "end": 628.53,
   "text": "انقدر اونجا احتیاج هست، محتاجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 628.53,
   "end": 632.09,
   "text": "حالا نوبت ما هم میشه غصه نخورید که شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 632.09,
   "end": 635.55,
   "text": "صدقه، صدقه. بعد فرمود اگر کسی نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.55,
   "end": 637.29,
   "text": "نماز لیلة الدفن بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.29,
   "end": 642.09,
   "text": "انقدر صدقه مهمه. حالا الان تا زنده ای انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 642.09,
   "end": 644.11,
   "text": "اون داستانی که روایت مشهوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 644.11,
   "end": 646.29,
   "text": "یکی از دوستای آقا حتما شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 646.29,
   "end": 651.19,
   "text": "یه انبار خرما داشت. وصیت کرد وقتی مُرد پیغمبر اینو بین فقرا تقسیم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 651.19,
   "end": 655.19,
   "text": "پیغمبر انبار خرماي اون موقع رو تقسیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 655.19,
   "end": 656.91,
   "text": "همه رو بین فقرا تقسیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 656.91,
   "end": 662.83,
   "text": "آخر یه خرماي گندیده لای درز دیوار انبار این بابایی که مرده بود گیر کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 662.83,
   "end": 669.17,
   "text": "کشیدش بیرون اینو پیغمبر فرمود اگر همین خرماي گندیده رو در زمان حیات خودش انفاق کرده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.17,
   "end": 673.47,
   "text": "ثوابش بیش از این انبار خرمايي بود که بعد از مرگش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 673.47,
   "end": 676.87,
   "text": "وصیت کرده بود. چرا منتظری بمیری تا وصیت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 676.87,
   "end": 679.07,
   "text": "همین الان بسم الله بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 679.07,
   "end": 682.23,
   "text": "دارایی‌تو خرج اسلام کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 682.23,
   "end": 685.27,
   "text": "خرج قرآن کن. خرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 685.27,
   "end": 688.47,
   "text": "گرفتاران کن. حالا خستتون نکنیم بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 688.47,
   "end": 691.37,
   "text": "حالا این تو این روایت بودیم به حاشیه رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 691.37,
   "end": 696.33,
   "text": "که آقا از امام کاظم سؤال شده آقا کسی قسم خورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.33,
   "end": 698.47,
   "text": "از جهت یه صدقه سنگین چقدر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 698.47,
   "end": 707.19,
   "text": "چه میزانه؟ حضرت فرمودن که اگر گوسفند داره حالا طبق اون موقع اگر گوسفند داره هشتاد و چهار گوسفند باید ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 707.19,
   "end": 709.21,
   "text": "حالا اینایی که ماشین دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 709.21,
   "end": 713.55,
   "text": "مثلاً شتر داره شتر اون موقع مثل ماشین الان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.55,
   "end": 718.99,
   "text": "اگه شتر داره یعنی شتر داره نه یه شتر ها، نه یه ماشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 718.99,
   "end": 721.95,
   "text": "مثل کسی که مثلاً ماشین‌ها داره نمایشگاه ماشین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 721.95,
   "end": 724.75,
   "text": "هشتاد و چهار تا شتر باید بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.75,
   "end": 731.91,
   "text": "اگر نقره داره یعنی پول نقره‌ای درهم و دینار و اینا داره فرمود هشتاد و چهار نقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.91,
   "end": 734.53,
   "text": "بده. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 734.53,
   "end": 740.71,
   "text": "جوابشو امام کاظم خیلی شیرین کنار همون پایین این ابو راشد داره میگه روایتشم سندشو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 740.71,
   "end": 743.95,
   "text": "اونجا دیدم امام کاظم چون هرچی اونا میگن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 743.95,
   "end": 747.85,
   "text": "قرآنه دیگه. قید کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 747.85,
   "end": 752.53,
   "text": "سند یعنی امام معصوم هم سند از قرآن میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 752.53,
   "end": 754.53,
   "text": "که چرا هشتاد و چهار تا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 754.53,
   "end": 758.11,
   "text": "به جهت این آیه بیست و پنج سوره توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 758.11,
   "end": 761.35,
   "text": "امام کاظم نوشته. بعد این شخص میگه شمردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 761.35,
   "end": 763.71,
   "text": "ما اون روایات که دیده بودیم و شنیده بودیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 763.71,
   "end": 771.71,
   "text": "اهل بیت دیدیم دقیقاً هشتاد و چهار بار خدا در جنگ‌های مختلف پیغمبر رو کمک کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 771.71,
   "end": 777.39,
   "text": "کمک خدا به پیغمبر. تقریباً بیش از پنج-- بیش از هشتاد تا جنگ داشته پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 777.39,
   "end": 780.35,
   "text": "چرا ما غافلیم از قدرت خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.35,
   "end": 782.17,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 782.17,
   "end": 784.83,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 784.83,
   "end": 792.45,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}