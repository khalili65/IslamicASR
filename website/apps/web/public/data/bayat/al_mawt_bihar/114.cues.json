 "chapters": [
  {
   "index": 0,
   "title": "## روایت کراهت از مرگ و خرج باطن",
   "start": 20.84,
   "end": 40.94
  },
  {
   "index": 1,
   "title": "## نذر فرهنگی در برابر بنای ظاهر",
   "start": 40.94,
   "end": 420.84
  },
  {
   "index": 2,
   "title": "## حدیث قدسی ابن عربی: قلب آنجا که مال است",
   "start": 420.84,
   "end": 562.38
  },
  {
   "index": 3,
   "title": "## رمز ماندگاری عاشورا",
   "start": 562.38,
   "end": 704.4
  },
  {
   "index": 4,
   "title": "## ملات سور برزخی: ملکات نفس",
   "start": 704.4,
   "end": 808.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.64,
   "end": 5.42,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.42,
   "end": 8.38,
   "text": "و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.38,
   "end": 11.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.42,
   "end": 15.12,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.12,
   "end": 17.88,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.88,
   "end": 20.84,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.84,
   "end": 23.2,
   "text": "در روایت نهم بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.2,
   "end": 27.78,
   "text": "از باب چهارم کتاب الموت مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.78,
   "end": 31.6,
   "text": "نکته مهمی از این روایت موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.6,
   "end": 35.08,
   "text": "که یه بار دیگه صورت روایت رو بخونم از رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.08,
   "end": 40.02,
   "text": "نورانیتش بهره بگیریم. عن الصادق عن ابیه علیهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.02,
   "end": 45.5,
   "text": "امام صادق از پدرشون فرمودن، نقل کردن که أتی النبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.5,
   "end": 51.02,
   "text": "رجل. یه مردی اومد محضر پیامبر عزیز اسلام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.02,
   "end": 55.28,
   "text": "فقال مالي لا أحب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.28,
   "end": 58.98,
   "text": "يا رسول الله چرا من دوست ندارم موت رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.98,
   "end": 60.98,
   "text": "فقال له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.98,
   "end": 64.0,
   "text": "پیغمبر ازش سؤال کرد که ألك مال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.0,
   "end": 66.56,
   "text": "آیا مال داری؟ ثروتی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.56,
   "end": 68.76,
   "text": "قال نعم. بله، ثروت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.76,
   "end": 71.94,
   "text": "مال دارم. قال فقدمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.94,
   "end": 74.42,
   "text": "آیا اون رو تقدیم می‌کنی؟ پیشکش می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 74.42,
   "end": 79.1,
   "text": "فرش قرمز آخرتت می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.1,
   "end": 81.22,
   "text": "قال لا. نه، من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 81.22,
   "end": 84.06,
   "text": "برای اون ور خرجی خیلی نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 84.06,
   "end": 87.54,
   "text": "قال فبمن ثم لا تحب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 87.54,
   "end": 93.48,
   "text": "علت اصلی اینکه تو از موت کراهت داری و بدت میاد و دوست نداری همینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.48,
   "end": 96.18,
   "text": "که پولتو خرج موت نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.18,
   "end": 100.04,
   "text": "کی تا حالا شنیده کسی پولشو خرج موت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 100.04,
   "end": 105.1,
   "text": "خرج مرگ کنه؟ یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.1,
   "end": 109.26,
   "text": "ملموس نیست انگار. انسان پولشو خرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.26,
   "end": 113.8,
   "text": "مرگ کنه. مرگ قبلاً موتی که از معانی‌ش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.8,
   "end": 120.56,
   "text": "سفر ظاهر به باطن. یعنی مقدار انسان پولشو خرج باطن کنه به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.56,
   "end": 127.18,
   "text": "انقدر به ظواهر... طرف مثلاً ده شب محرم، اونم عشق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.18,
   "end": 131.46,
   "text": "هر شبی ده هزار غذا می‌پزه، دیگ بار می‌ذاره فقط غذا می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.46,
   "end": 135.22,
   "text": "هیچ کار دیگه، نه روضه‌ای. خب تو که این همه خرج کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.22,
   "end": 138.84,
   "text": "یه ذره باطن هم-- اگرچه غذای سید الشهدا قبلاً عرض کردیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.84,
   "end": 142.28,
   "text": "خود اون دستگاه، خود اون غذا هم که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.28,
   "end": 146.14,
   "text": "از عمر شب که بیاد تو دستگاه سید الشهدا خودش نور دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.14,
   "end": 150.3,
   "text": "من لم يجعل الله له نورا فما له من نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.3,
   "end": 154.38,
   "text": "خدا وقتی نوری برای کسی قرار نداد، نوری هم درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.38,
   "end": 157.62,
   "text": "نور داشته که اومده تو دستگاه امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.62,
   "end": 159.84,
   "text": "لیاقت داشته هر پول خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.84,
   "end": 162.42,
   "text": "لیاقت نداره خرج امام حسین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 162.42,
   "end": 164.74,
   "text": "اما خب حالا تو که این زحمتو کشیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.74,
   "end": 167.56,
   "text": "خرج ظواهر کردی با یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.56,
   "end": 169.32,
   "text": "منبری هم بیار دو تا حدیث بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.32,
   "end": 173.84,
   "text": "یه روضه خون هم لاقل صلي الله علیک آبا عبدالله یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 173.84,
   "end": 179.18,
   "text": "دو قطره اشک هم مردم بگه بعد غذا بده نفر بعد غذا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.18,
   "end": 182.12,
   "text": "وارد نیتش نمی‌شیم. میگم اینم قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.12,
   "end": 184.7,
   "text": "اما چقدر خوبه آدم خرج باطن هم بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 184.7,
   "end": 186.92,
   "text": "الان ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 186.92,
   "end": 189.12,
   "text": "بانی البته میگیم چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 189.12,
   "end": 192.26,
   "text": "اونا-- اونقدرم نیست. به نسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 192.26,
   "end": 196.6,
   "text": "خرج کردن بر ظاهر و باطن دارم قیاس می‌کنم و الا نه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 196.6,
   "end": 200.04,
   "text": "اتفاقا خیلی هم کم تو این متأسفانه زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 200.04,
   "end": 207.56,
   "text": "بانی داریم. ولی چقدر در صورت ظاهر بانی حسینیه، مسجد، کتابخانه، حمام اینا چقدر داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.56,
   "end": 209.6,
   "text": "آدم‌هایی که خرج اینا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 209.6,
   "end": 213.74,
   "text": "اما پیدا کنید آدمی که بیاد خرج باطن کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 213.74,
   "end": 215.92,
   "text": "یعنی چی خرج باطن کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 215.92,
   "end": 221.2,
   "text": "یعنی اصطلاحاً ما بهش میگیم نذر فرهنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.2,
   "end": 225.96,
   "text": "نذر فکر مردم کنه. چند تامون هزینه کردیم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 225.96,
   "end": 230.2,
   "text": "تقویت بنیه فکری و اعتقادی و اخلاقی مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.2,
   "end": 233.9,
   "text": "مسجد می‌سازیم برو بالا الا ماشاءالله میلیاردی هم خرج می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 233.9,
   "end": 236.46,
   "text": "ولی توش می‌بینیم چهار تا پیرمرد جسارت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 236.46,
   "end": 238.18,
   "text": "اونام نور چشمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 238.18,
   "end": 242.08,
   "text": "ها نور هم که توفیق دارن تو مسجدن تا اون سنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 242.08,
   "end": 245.72,
   "text": "چون آدم سنش که میره بالا شهوتش کم می‌شه، پول پرستی‌ش زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 245.72,
   "end": 248.54,
   "text": "اینا اگه پول پرست بودن مسجد نبودن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 248.54,
   "end": 250.38,
   "text": "اما خب حالا همون چهار تا پیرمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 250.38,
   "end": 252.86,
   "text": "جوونا کوشن؟ نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 252.86,
   "end": 256.5,
   "text": "برنامه‌ای براشون. خرج کردی برای جوونا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 256.5,
   "end": 258.88,
   "text": "فر-- خرج کردی برای فکر مردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 258.88,
   "end": 263.94,
   "text": "چرا یه کسی مثل حضرت آقای جوادی آملی من انقدر افسوس خوردم چند وقت پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 263.94,
   "end": 265.78,
   "text": "فراخوان عمومی از بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 265.78,
   "end": 270.84,
   "text": "طلاب اینا که بیاید آثارشون نشون میده و اکثر آثارشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 270.84,
   "end": 275.16,
   "text": "صوتیه مثل شهید مطهری. صوتیه نیاز به پیاده‌سازی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 275.16,
   "end": 277.56,
   "text": "فرصت نکردن بشینن بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 277.56,
   "end": 280.76,
   "text": "آقا بیاید مثلاً جمشید فراخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 280.76,
   "end": 283.28,
   "text": "که آثارشونو پیاده کنیم. حیفه داره خاک می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 283.28,
   "end": 285.98,
   "text": "این باعث تأسف ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 285.98,
   "end": 289.84,
   "text": "یکی حاضر نیست عمرشو خرج کنه، یکی پولشو خرج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 289.84,
   "end": 292.98,
   "text": "بالاخره پول می‌خواد. یه ده تا طلبه، پنجاه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 292.98,
   "end": 296.62,
   "text": "طلبه رو به خط کنه. علمایی که این اصطلاحات رو هم بشناسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 296.62,
   "end": 299.16,
   "text": "پولی بهشون بده ماهیانه یه بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 299.16,
   "end": 302.3,
   "text": "میریم اجیر می‌کنیم خونه‌مونو تمیز کنن پول میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 302.3,
   "end": 305.52,
   "text": "حاضر نیستیم برای پاک‌سازی ذهنمون پول بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 305.52,
   "end": 312.94,
   "text": "آقا شما بیا اینا رو پیاده‌سازی کن امتمن ما هدی-- نذر فرهنگیمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 312.94,
   "end": 318.22,
   "text": "نشر آثار، در دسترس قرار دادن، دادن این حقایق به جوون‌ها و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 318.22,
   "end": 320.52,
   "text": "نذر باطن خیلی کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 320.52,
   "end": 324.38,
   "text": "وقتی می‌خوایم پول خرج کنیم میریم جاهایی که رفیقامون هم بشناسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 324.38,
   "end": 327.76,
   "text": "اینها. ولی جاهایی که نه ببینید، ببینید واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 327.76,
   "end": 333.5,
   "text": "داره تزریق معنوی صورت می‌گیره، داره تولید علم صورت می‌گیره و، و این‌ها رو بره آدم تقویت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 333.5,
   "end": 336.94,
   "text": "اونم گمنام بره اونها رو حمایت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 336.94,
   "end": 343.34,
   "text": "تا حالا شده یه آدم مثلاً برجسته علمی که می‌بینید آدم مثلاً ظاهراً آدم با اخلاسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 343.34,
   "end": 345.68,
   "text": "معصوم که نیستیم هیچ کدوممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 345.68,
   "end": 348.78,
   "text": "حالا حداقل گناه علنی ازش نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 348.78,
   "end": 354.18,
   "text": "دعوه دین داره. خب مشکلات اقتصادی، مالی داره ولی حرف داره برای گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 354.18,
   "end": 357.34,
   "text": "می‌تونه بیان خوبی داره، دین رو خوب فهمیده بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 357.34,
   "end": 361.22,
   "text": "حمایتش کنیم بگیم آقا خرج زندگی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 361.22,
   "end": 364.72,
   "text": "با من. من پدرم با من همین کارو کرد که الان تو این کسبه‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 364.72,
   "end": 370.42,
   "text": "پدر ما کارخونه‌دار بود تمام پوشاک جنگ تو کارخونه پدر ما انجام می شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 370.42,
   "end": 374.26,
   "text": "اون موقع که وضعش خیلی خوب بود به من گفت تو حق نداری بری سر کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 374.26,
   "end": 375.88,
   "text": "اگه بری سر کار عاقت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 375.88,
   "end": 378.6,
   "text": "یعنی بالعکس. من تو رو نذر دین کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 378.6,
   "end": 381.36,
   "text": "تو فقط وقتتو می‌ذاری برای دین، مطالعه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 381.36,
   "end": 384.68,
   "text": "دو هزار تا کتاب هم خریده بود گذاشته بود تو خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 384.68,
   "end": 389.86,
   "text": "گفت تو باید بری سمت دین. یه آدم پیدا بشه بگه آقا من خرج شما رو میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 389.86,
   "end": 394.16,
   "text": "شما معلومه که یه چیزی داری برای گفتن، حرف متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 394.16,
   "end": 397.48,
   "text": "یعنی دین رو خوب فهمیدی و خوبم بیان می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 397.48,
   "end": 401.36,
   "text": "بفرمایید شما نمی‌خواد بری سر کار، بری انگشت بزنی صبح تا شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 401.36,
   "end": 404.22,
   "text": "هیچ آیده‌ای هم نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 404.22,
   "end": 406.92,
   "text": "من خرج شما رو میدم. شما وقتتو بذار برای اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 406.92,
   "end": 411.52,
   "text": "چند تامون هم این کارو کردیم. به خدا قیامت باید جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 411.52,
   "end": 415.42,
   "text": "این خرج کردن و علت اینکه ما عاشق معارف نیستیم می‌دونید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 415.42,
   "end": 417.72,
   "text": "چون خرج معارف نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 417.72,
   "end": 420.84,
   "text": "این حرف منو قبول دارید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 420.84,
   "end": 424.08,
   "text": "اجازه بدید یه سند رو کنم. دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 424.08,
   "end": 430.3,
   "text": "بزرگ بزرگان و عرفا که امثال علامه حسن زاده‌ها بهشون افتتاح می‌کردن حضرت ابن عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 430.3,
   "end": 438.66,
   "text": "که امام علیه الرحمه عقلا و اندیشمندان شرق و غرب عالم رو به درون مایه آثار ایشون دعوت کرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 438.66,
   "end": 441.14,
   "text": "در کتاب فصوص الحکمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 441.14,
   "end": 443.74,
   "text": "خواستید ببینید جلد یک صفحه صد و نود و دوئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 443.74,
   "end": 446.28,
   "text": "اون فصوص‌های قدیم البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 446.28,
   "end": 449.04,
   "text": "یه حدیث قدسی رو ایشون میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 449.04,
   "end": 456.4,
   "text": "که می‌فرماید حضرت عیسی علی نبينا و آله و عليه الصلاة والسلام یک دنیا حرف تو این حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 456.4,
   "end": 459.4,
   "text": "به یارانش فرمود که \"يا بني إسرائيل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 459.4,
   "end": 462.38,
   "text": "قلب كل إنسان حيث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 462.38,
   "end": 468.48,
   "text": "ماله فاجعلوا أموالكم في سماتكم قلوبكم في السماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 468.48,
   "end": 475.32,
   "text": "می‌فرماید ای مردم بدانید قلب انسان‌ها همون جاییه که مالشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.32,
   "end": 479.76,
   "text": "جایی که پول خرج می‌کنند، این حضرت عیسی روح الله داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 479.76,
   "end": 482.62,
   "text": "ابن عربی داره سند میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 482.62,
   "end": 487.5,
   "text": "که هر کجا پول خرج می‌کنند دلشون هم همون سمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 487.5,
   "end": 490.5,
   "text": "اگر می‌خواید دلتون آسمونی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 490.5,
   "end": 495.16,
   "text": "آسمونی بشه خرج آسمون کن پولتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 495.16,
   "end": 497.9,
   "text": "نه فقط زمین، نه فقط این زمین و خرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 497.9,
   "end": 500.0,
   "text": "اینم یه مصداقشه. این زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 500.0,
   "end": 501.64,
   "text": "وقف مسجد، وقف حسینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 501.64,
   "end": 503.96,
   "text": "درست. خب درون مایه ش چیه؟ محتواش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 503.96,
   "end": 508.36,
   "text": "آدم‌هاش کو؟ چند تا حسینیه الان بیکارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 508.36,
   "end": 512.88,
   "text": "تموم شد درو دهه‌ش، دهه محرم تموم شد درشون قفل شد رفت تا سال بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 512.88,
   "end": 519.32,
   "text": "اینا جفاست. بعد چقدر ما جوون‌ها داریم که همینطور هیئت‌های خوبی هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 519.32,
   "end": 521.44,
   "text": "دارن کار می‌کنن جا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 521.44,
   "end": 525.14,
   "text": "چهار تا پیرمرد شدن متولی حسینیه و مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 525.14,
   "end": 529.86,
   "text": "جوون‌ها رو راه نمیدن. پنجاه تا مسجد خوبه برای شما من اسم ببرم که ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 529.86,
   "end": 534.86,
   "text": "ما، ما با همه ادعامون رفتیم فعالیت کردیم بیرونمون کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 534.86,
   "end": 539.26,
   "text": "حتی یه مسجد با ما دعواشون شد گفت مسجد جای کلاس قرآن نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.26,
   "end": 541.4,
   "text": "قرآن‌تون رو بچه‌ها برن خونه‌شون بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.4,
   "end": 546.64,
   "text": "تا این حد. بعد کلاه پدرسوختگی هم سرش گذاشته جسارتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.64,
   "end": 549.18,
   "text": "بهش می‌گن آ-- چی؟ عرق چین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.18,
   "end": 551.96,
   "text": "ما زمان جنگ می‌گفتیم پدرسوختگی جسارت به شما نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 551.96,
   "end": 554.42,
   "text": "اینایی که اینطوری با اسم دین بازی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 554.42,
   "end": 556.72,
   "text": "بچه‌ها رو از دین و دیانت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 556.72,
   "end": 559.8,
   "text": "مسجد و هیئت زده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 559.8,
   "end": 564.82,
   "text": "چرا مسجدها از ما خالیه؟ اصلا می‌دونید رمز و راز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 564.82,
   "end": 569.08,
   "text": "ماندگاری نهضت امام حسین یه وجهش البته‌ها من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 569.08,
   "end": 573.78,
   "text": "عرض کنم چیه؟ همین الان شما باید نسبت به سیر بحث بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 573.78,
   "end": 577.54,
   "text": "چرا نهضت امام حسین ماندگار مونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 577.54,
   "end": 580.88,
   "text": "اما غدیر متاسفانه نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 580.88,
   "end": 584.38,
   "text": "نهضت این عاشورا، این دهه چرا ماندگاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 584.38,
   "end": 588.7,
   "text": "آفرین چون مردم خرجش می‌کنند نه حکومت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 588.7,
   "end": 590.3,
   "text": "مردم خرجش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 590.3,
   "end": 594.44,
   "text": "چون مردمیه. مردم خرج امام حسین می‌کنند مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 594.44,
   "end": 596.56,
   "text": "چون دلشون میره به چه سمتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 596.56,
   "end": 601.62,
   "text": "اون جایی که خرج می‌کنند. یه سریه، این رمزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 601.62,
   "end": 604.88,
   "text": "هرچی رو دوست داری باید پول خرجش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 604.88,
   "end": 612.0,
   "text": "چرا بعضیا پوستشونو می‌کنی نمی‌تونن از عرق و ورق و نمی‌دونم کاباره و رقص و آواز و چی و اینا دل بکنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 612.0,
   "end": 615.02,
   "text": "چون پول دارن خرج اون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 615.02,
   "end": 620.42,
   "text": "چرا بکشیش نمی‌تونه شب جمعه، یه شب جمعه‌شو بذاره بیاد سر کو-- کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 620.42,
   "end": 624.88,
   "text": "مثلا امیرالمؤمنین بشینه تا تعطیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 624.88,
   "end": 627.64,
   "text": "بسم الله. یه ویلا هم خریده و نوش جونت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 627.64,
   "end": 630.92,
   "text": "ما که بخیل نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 630.92,
   "end": 633.14,
   "text": "سفره رحمانیت خداست نوش جونت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 633.14,
   "end": 635.04,
   "text": "والا خدا گذاشته بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 635.04,
   "end": 639.48,
   "text": "ولی از سفره رحیمییت خدا چی برخورداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 639.48,
   "end": 641.3,
   "text": "چون پولشو خرج اونجا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 641.3,
   "end": 643.9,
   "text": "باربیکیو و چیو استخر و سونا و جکوزی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 643.9,
   "end": 647.32,
   "text": "اصلا عشقش شده اون. تا تعطیلات ذ-- تو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 647.32,
   "end": 650.98,
   "text": "تو قوه خیالش صورت و شکل جکوزی و سونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 650.98,
   "end": 655.46,
   "text": "داره موج می‌زنه. بخارا بلند شدن داره خودش رو اون تو غرق می‌بینه کیف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 655.46,
   "end": 658.72,
   "text": "جوجه زده و این، این صورت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 658.72,
   "end": 661.04,
   "text": "تمثلات برزخی وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 661.04,
   "end": 663.4,
   "text": "علی القوه رتبه مثالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 663.4,
   "end": 666.08,
   "text": "متصل وجودش اینه، ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 666.08,
   "end": 670.06,
   "text": "الا اینه. حالا خنده داره ولی حقیقته دارید می‌خندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 670.06,
   "end": 673.98,
   "text": "دارید به حقیقت می‌خندید. حقیقت وجودی خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 673.98,
   "end": 677.42,
   "text": "اما حالا اینایی که کمال خوندن شب جمعه یا چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 677.42,
   "end": 682.1,
   "text": "تا شب جمعه می‌شه اون صورتی که تو ذهنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 682.1,
   "end": 685.34,
   "text": "خودش رو نشون میده، اون صورت و شکل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 685.34,
   "end": 688.42,
   "text": "یه جماعتی از اهل ایمان جمع شدن دارن کمال می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 688.42,
   "end": 690.96,
   "text": "اینم قاطیشون داره صفا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 690.96,
   "end": 693.54,
   "text": "صورت حرم می‌بینه. صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 693.54,
   "end": 698.04,
   "text": "مسجد می‌بینه. صورت سجاده و تسبیح می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 698.04,
   "end": 702.38,
   "text": "اینا اصلا برزخ ما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 702.38,
   "end": 705.98,
   "text": "اون ملاتی که دقت بفرمایید جمله آخر فرود بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 705.98,
   "end": 710.82,
   "text": "اگرچه بحث نیمه کاره موند حالا فردا رو که عمو نگرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 710.82,
   "end": 715.78,
   "text": "اون قبلا بارها عرض کردیم اون اصل مهم و رسین و رکین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 715.78,
   "end": 720.84,
   "text": "از چهل و هفت اصل انسان‌ساز معرفت نفس کتاب انسان در عرفان از تعالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 720.84,
   "end": 724.88,
   "text": "چقدر ما عرض کردیم. آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 724.88,
   "end": 728.24,
   "text": "ملات، دقت بفرمایید، ملات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 728.24,
   "end": 731.06,
   "text": "سور و اشکال برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 731.06,
   "end": 732.92,
   "text": "یعنی تمثلات برزخی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 732.92,
   "end": 736.62,
   "text": "یعنی ما از اینجا دنیا که بریم، بریم در عالم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 736.62,
   "end": 739.76,
   "text": "که رتبه وجودیش و درونیش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 739.76,
   "end": 742.94,
   "text": "متصلش الان در عالم خواب رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 742.94,
   "end": 747.48,
   "text": "وقتی می‌میریم، می‌ریم در عالم مثال مت-- منفصل و بیرون از خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 747.48,
   "end": 750.64,
   "text": "اونجا این سور و اشكال رو می‌بینیم بر اساس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 750.64,
   "end": 754.52,
   "text": "ملاتش چیه؟ ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 754.52,
   "end": 756.74,
   "text": "ملکات بعد از چی تشکیل می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 756.74,
   "end": 762.8,
   "text": "اصرار بر عمل. کسی که اصرار داره بر اقامه صلات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 762.8,
   "end": 766.7,
   "text": "اقامه جلسات سید الشهدا، خرج کردن در این راه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 766.7,
   "end": 769.32,
   "text": "اون ور هم سور و اشکالی که می‌بینه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 769.32,
   "end": 771.86,
   "text": "ملذه‌ست. لذت می-- کیف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 771.86,
   "end": 776.08,
   "text": "اما اون وریه نه. اونجا موهشه، مدهشه، وحشت برش می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 776.08,
   "end": 780.64,
   "text": "اینا چیه؟ سر سفره خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 780.64,
   "end": 786.3,
   "text": "چیزی غیر از این نیست. چقدر رمز و راز تو همین یه روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 786.3,
   "end": 789.48,
   "text": "چقدر باید اینا موشکافانه باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 789.48,
   "end": 794.96,
   "text": "تولید علم باید بگیره جوون‌های ما درون مایه دین رو متوجه بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 794.96,
   "end": 797.64,
   "text": "حالا آقا محسن ساعتشو نگاه کرد دیگه بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 797.64,
   "end": 800.36,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 800.36,
   "end": 803.08,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 803.08,
   "end": 808.34,
   "text": "الله- اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}