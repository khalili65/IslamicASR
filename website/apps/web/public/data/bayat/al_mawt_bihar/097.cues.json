   "start": 19.46,
   "end": 363.48
  },
  {
   "index": 1,
   "title": "## الأجل مساق النفس الیه",
   "start": 363.48,
   "end": 403.02
  },
  {
   "index": 2,
   "title": "## هارب منک الیک",
   "start": 403.02,
   "end": 566.44
  },
  {
   "index": 3,
   "title": "## والهرب منه موافاته",
   "start": 566.44,
   "end": 614.4
  },
  {
   "index": 4,
   "title": "## رزق مجرد از امیرالمؤمنین",
   "start": 614.4,
   "end": 724.38
  },
  {
   "index": 5,
   "title": "## شیخ حر عاملی و حکمت علوی",
   "start": 724.38,
   "end": 868.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 8.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.78,
   "end": 11.54,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.54,
   "end": 14.26,
   "text": "و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.26,
   "end": 18.74,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.74,
   "end": 21.9,
   "text": "می‌ریم سراغ روایت هفتم از باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.9,
   "end": 27.82,
   "text": "چهارم کتاب الموت. می‌دونید که معمولا انسان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.82,
   "end": 30.44,
   "text": "مهم‌ترین حرف‌هاشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.44,
   "end": 33.2,
   "text": "لحظات وداعشون از دنیا می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.2,
   "end": 38.86,
   "text": "مثل پدری، مادری که می‌خواد از دنیا بره بر بچه‌هاش وصیت که می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.86,
   "end": 46.42,
   "text": "دیگه اون لب مطلب رو خلاصه و چکیده رو می‌ذاره اون لحظه‌ای که داره از دنیا فارغ می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.42,
   "end": 50.54,
   "text": "رو مفارقت می‌کنه از اون، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.54,
   "end": 56.32,
   "text": "اصل و زبده و چکیده خلاصه حرفش رو اونجا می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.32,
   "end": 61.28,
   "text": "دیگه آخرین لحظات و فرصت‌های آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.28,
   "end": 67.24,
   "text": "امیرالمؤمنین علیه‌الصلاة والسلام هم که هفته، هفته قدیریه است به هر حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.24,
   "end": 72.4,
   "text": "چه جالب که این روایتی که الان تقدیم می‌کنیم روایت هفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.4,
   "end": 77.3,
   "text": "روایتی‌ست که لحظات آخر عمرشون حضرت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.3,
   "end": 80.92,
   "text": "در بستر، ضربت خورده آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.92,
   "end": 86.68,
   "text": "دوستانشون دورشونو گرفتن و از حضرت تقاضای نصیحت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.68,
   "end": 90.66,
   "text": "البته حضرت به اقتضای اون وضعیت و اون م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.66,
   "end": 93.52,
   "text": "حالا محل و زمان و مکان و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.52,
   "end": 98.08,
   "text": "این چنین می‌فرمایند و چه جانانه سخن می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.08,
   "end": 102.76,
   "text": "قال امیرالمؤمنین علیه‌الصلاة والسلام: أیه الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.76,
   "end": 108.32,
   "text": "این خطاب تا إلى الأبد با همه‌ی مردمه من جمله من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.32,
   "end": 113.08,
   "text": "الان امیرالمؤمنین داره با شما، با من سخن می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.08,
   "end": 116.56,
   "text": "کل امرئ همه‌ی مردم این چنین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.56,
   "end": 120.1,
   "text": "چی؟ لاقٍ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.1,
   "end": 123.54,
   "text": "لاقٍ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.54,
   "end": 125.94,
   "text": "م-ملحق می‌شن، ملاقات می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.94,
   "end": 130.24,
   "text": "می‌رسن. رسنده‌اند، ملاقات کننده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.24,
   "end": 136.34,
   "text": "لاقٍ فی فراره ما منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.34,
   "end": 139.04,
   "text": "یعنی ملاقات می‌کنند، ملحق می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.04,
   "end": 144.76,
   "text": "می‌بینن اون چیزی رو که فراره ما منه ازش فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.76,
   "end": 148.42,
   "text": "هر چیزی که ازش فرار می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.42,
   "end": 153.22,
   "text": "می‌بینیش. حالا این که آیا این یک قضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.22,
   "end": 156.6,
   "text": "حقیقیه کلیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.6,
   "end": 165.6,
   "text": "یا اینکه یک قضیه قالبیه یا شخصی‌ست رو الان بحث نداریم که حالا بعضیا معتقدند این قضیه قالبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.6,
   "end": 169.94,
   "text": "و شخصی‌ست. بعضیا میگن نه ق-قضیه کلیه حقیقی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.94,
   "end": 173.94,
   "text": "یعنی چی؟ یعنی اینکه آیا این م-- اطلاق داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.94,
   "end": 176.82,
   "text": "یعنی هر چیزی رو ازش فرار کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.82,
   "end": 181.94,
   "text": "بهش نزدیک می‌شی؟ اگه این بعضیا میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.94,
   "end": 184.62,
   "text": "بله این چنینه، کلیه حقیقی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.62,
   "end": 187.86,
   "text": "بعضیا اکثرا میگن نه. مثلا خود مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.86,
   "end": 191.94,
   "text": "حاشیه‌ای خودش ذیل این روایت که در کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.94,
   "end": 197.78,
   "text": "آورده، یه حاشیه زده که این قضیه کلیه حقیقیه، حقیقیه نیست، شخصی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.78,
   "end": 205.0,
   "text": "یعنی اطلاق نداره. چون اونجا در نسبت به اون زمان و اون مکان و اون وضعیت امیرالمؤمنین که در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.0,
   "end": 207.86,
   "text": "احتضار هست این رو فرموده و بعدش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.86,
   "end": 210.32,
   "text": "تصریح کرده بحث مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.32,
   "end": 213.12,
   "text": "پس این کلیه نیست. حالا مثال‌هایی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.12,
   "end": 217.46,
   "text": "مثلا حضرت فاضل محترم استاد عابدینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.46,
   "end": 221.48,
   "text": "در کتاب همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.48,
   "end": 224.26,
   "text": "عرض شود موت‌شون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.26,
   "end": 226.94,
   "text": "ذیل همین کتاب الموت مرحوم مجلسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.94,
   "end": 230.98,
   "text": "من برای دوستانی که خیلی حوصله ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.98,
   "end": 235.92,
   "text": "مثل ما ذره‌بین بذارن بطون روایات رو بر اساس حکمت و عرفان ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.92,
   "end": 238.34,
   "text": "حوصله این چیزا رو ندارن اما دوست دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.34,
   "end": 241.74,
   "text": "کتاب الموت مرحوم مجلسی رو ببینن برن سراغ کتاب ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.74,
   "end": 249.5,
   "text": "استاد عابدینی، همون عزیزی که تو سمت خدا هم بعضا میان صحبت می‌کنند انسان فاضل و توانمندی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.5,
   "end": 253.34,
   "text": "ایشون کتاب سه جلدی دارن، همین کتاب الموت رو شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.34,
   "end": 257.38,
   "text": "منتها خیلی همه‌فهم و دیگه مثل ما به قول معروف مط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.38,
   "end": 264.92,
   "text": "خشخاش نگذاشتن و خیلی د-- مثلا دقت آنچنانی فلسفی-حکمی نه مثلا نگاه، نگاه روایی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.92,
   "end": 270.54,
   "text": "خواستید اونجا حالا کسی شاید دوست داشته باشه آقا کتاب الموت رو داشته باشه چون در دسترس نیست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.54,
   "end": 276.02,
   "text": "الان خیلی نداریم که کتاب الموت مرحوم مجلسی رو، بحارالانوار رو که نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.02,
   "end": 278.68,
   "text": "اونجا هست. همه روایت که ما داریم می‌گیم اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.68,
   "end": 281.64,
   "text": "یه خلاصه توضیح هم ایشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.64,
   "end": 284.42,
   "text": "مثلا ایشون استاد عابدینی اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.42,
   "end": 288.78,
   "text": "همین رو می‌فرمایند که مثلا شما از نقص فرار کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.78,
   "end": 296.5,
   "text": "بری به سمت کمال. اگر این قضیه کلیه حقیقیه باشه و اطلاق داشته باشه، برای هر چیزی مصداق داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.5,
   "end": 300.04,
   "text": "شما از نقص فرار می‌کنی، میری به سمت کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.04,
   "end": 302.74,
   "text": "اگر این کلی باشه باید بگیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.74,
   "end": 306.8,
   "text": "یعنی به نقص می‌رسی؟ از نقص فرار می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.8,
   "end": 309.16,
   "text": "از جهل فرار می‌کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.16,
   "end": 312.58,
   "text": "به علم دست پیدا کنی. مثلا حرکت نفس یعنی تفکر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.58,
   "end": 316.7,
   "text": "تفکر حرکت نفسه. که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.7,
   "end": 318.68,
   "text": "معلومات به مجهولات برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.68,
   "end": 323.14,
   "text": "یعنی از اونچه که معلومه برات برسی مجهولات رو کشف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.14,
   "end": 332.72,
   "text": "خب اگر این چنینه، اگر کلیه حقیقی است، یعنی این یه بحث کلی امیرالمؤمنین داره می‌فرماید یک قضیه ازش در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.72,
   "end": 335.08,
   "text": "ااا الان جواب نمیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 335.08,
   "end": 340.72,
   "text": "از نقص فرار کردی، از جهل فرار کردی به سمت علم دوباره به جهل بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.72,
   "end": 344.9,
   "text": "ببینید حالا بعضیا که اینو رد می‌کنند میگن نقص قضیه کلیه‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.9,
   "end": 349.04,
   "text": "میگن شما به هر مرتبه‌ای از علم که برسی بازم جهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.04,
   "end": 350.86,
   "text": "توجه کردین؟ اینها هم جواب‌هایی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.86,
   "end": 352.68,
   "text": "ما نمی‌خوایم این بحث رو الان بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.68,
   "end": 356.6,
   "text": "ولید گوشه ذهنتون باشه که این موضوع هم مطرح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.6,
   "end": 361.96,
   "text": "اما در هر حال امیرالمؤمنین علیه‌الصلاة والسلام می‌زنه اش به اجل و مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.96,
   "end": 365.12,
   "text": "این چنین که می‌فرماید توضیح مولا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.12,
   "end": 373.06,
   "text": "\"یفر\" رو می‌فرماد \"أيها الناس کل امر إلا قن فی فراره ما منه یفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 373.06,
   "end": 375.08,
   "text": "والاجل\". اون مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.08,
   "end": 377.14,
   "text": "منظور مولا اینجا مرگه. اجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.14,
   "end": 380.18,
   "text": "\"مساق النفس الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.18,
   "end": 383.46,
   "text": "اصلا ترجمه‌ی مولا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.46,
   "end": 385.58,
   "text": "مرگ و اجل چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.58,
   "end": 388.66,
   "text": "\"مساق النفس الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.66,
   "end": 392.04,
   "text": "میگه اون سوق نفسه به سوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.04,
   "end": 396.94,
   "text": "اجل و مرگ. یعنی نفس تو با هر نفسی که می‌کشه داره سوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.94,
   "end": 399.76,
   "text": "خودش رو سوق می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.76,
   "end": 402.38,
   "text": "به سمت چی؟ اجل و مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.38,
   "end": 406.36,
   "text": "شما خودت رو در مرکز یه دایره تصور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.36,
   "end": 410.74,
   "text": "عالمن که حرکتش کاملاً دوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.74,
   "end": 417.26,
   "text": "شما از مرکز دایره به هر طرف فرار کنی باز داری به دایره نزدیک میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.26,
   "end": 419.86,
   "text": "درسته؟ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.86,
   "end": 423.18,
   "text": "فرار ظاهراً مثل این که میری حرم امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.18,
   "end": 425.32,
   "text": "در اون زیارت نامه‌ی دعا بعدش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 425.32,
   "end": 430.24,
   "text": "ان‌شاءالله قسمت شه بریم حرم علی ابن موسی الرضا علیهم الصلاة والسلام با معرفت به زودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 430.24,
   "end": 433.5,
   "text": "اونجا میگیم \"هارب منک الک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.5,
   "end": 436.04,
   "text": "من از تو هاربم، فرار کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.04,
   "end": 439.72,
   "text": "\"منک\" از تو اما \"الیک\" به سوی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.72,
   "end": 443.44,
   "text": "از تو فرار کردم اما فرار من از تو باز به سمت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 443.44,
   "end": 447.36,
   "text": "ختم می‌شه. چون وجه خدا تا حالا بحثشم می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.36,
   "end": 449.96,
   "text": "پس \"مساق النفس الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.96,
   "end": 453.18,
   "text": "سوق نفس است به سوی-- یعنی هرچی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.18,
   "end": 455.26,
   "text": "هر نفسی که می‌کشی، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.26,
   "end": 458.94,
   "text": "آنی از آنات زندگی‌ت که داره می‌گذره تو داری به نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.94,
   "end": 461.46,
   "text": "به مرگت نزدیک میشی. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.46,
   "end": 464.08,
   "text": "یعنی هی بخوای فرار هم بکنی باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.08,
   "end": 466.62,
   "text": "فـ اصلاً \"لا يمكن الفرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.62,
   "end": 469.52,
   "text": "من حکومتک\". \"و لا يمكن الفرار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.52,
   "end": 471.86,
   "text": "اصلاً نمی‌شه از حکومت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.86,
   "end": 475.46,
   "text": "فرار کرد. حالا یه وجهش این ترسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.46,
   "end": 477.98,
   "text": "که من می‌خوام فرار کنم و نمی‌تونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.98,
   "end": 480.06,
   "text": "\"و لا يمكن الفرار من حکومت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.06,
   "end": 482.42,
   "text": "یه وجهش میگه اصلاً برای چی فرار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.42,
   "end": 485.92,
   "text": "همه جا حکومت تو از حک، از حکم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.92,
   "end": 488.78,
   "text": "حکم، حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.78,
   "end": 491.68,
   "text": "یس، والقرآن الحکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.68,
   "end": 495.3,
   "text": "همه چی بر اساس حکمته، حکمه، محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.3,
   "end": 497.64,
   "text": "همه‌ی عالم بر اساس یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.64,
   "end": 502.92,
   "text": "قاعده‌ی خاصیه رو نظمه چینش و بافت و نظم عالم همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.92,
   "end": 507.1,
   "text": "بر اساس عدالته. \"هو الذي خلق السماوات والأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.1,
   "end": 508.94,
   "text": "حق، همش بر اساس حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.94,
   "end": 511.78,
   "text": "\"بالعدل قامت السماوات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.78,
   "end": 515.08,
   "text": "چرا انسان از حق و عدل بترسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.08,
   "end": 517.26,
   "text": "وقتی اینطوری نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.26,
   "end": 521.9,
   "text": "می‌بینی که اصلاً نشدنیه فرار کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.9,
   "end": 525.82,
   "text": "از حق. لذا از مرگ، موت و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.82,
   "end": 529.22,
   "text": "اجل قطعیه. \"والاجل مساق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.22,
   "end": 530.96,
   "text": "مساق النفس الیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.96,
   "end": 532.58,
   "text": "چقدر شیرین، چقدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.58,
   "end": 538.12,
   "text": "یعنی که هیچکس مثل امیرالمؤمنین چنین مرگ رو توصیف نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.12,
   "end": 541.08,
   "text": "سوق نفس توئه. تو سائقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 541.08,
   "end": 544.7,
   "text": "سائق. سوق داری پیدا می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.7,
   "end": 548.5,
   "text": "به سمت چی؟ نفس تو به سمت الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 548.5,
   "end": 551.62,
   "text": "الیه می‌خوره به الأجل ضمیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.62,
   "end": 556.14,
   "text": "یعنی تو الان چه بدانی، چه ندانی، چه بخواهی، چه نخواهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.14,
   "end": 558.98,
   "text": "چه با طوع باشه، چه با اکراه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 558.98,
   "end": 560.8,
   "text": "داری به سمت اجلت میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 560.8,
   "end": 563.6,
   "text": "حرکت به سمت اجله. حالا کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 563.6,
   "end": 566.14,
   "text": "کی ملاقات کنی؟ الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 566.14,
   "end": 572.0,
   "text": "بعد اتمام روایت که \"والهرب منه موافقته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.0,
   "end": 576.34,
   "text": "اون چیزی که \"هارب منک الیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 576.34,
   "end": 580.04,
   "text": "ه- وقتی که فرا-- هر چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 580.04,
   "end": 583.46,
   "text": "ازش داری فرار می‌کنی \"والهرب منه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 583.46,
   "end": 588.34,
   "text": "اون چیزی که ازش فرار می‌کنی \"موافاته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 588.34,
   "end": 591.34,
   "text": "به، به همون برخورد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 591.34,
   "end": 594.62,
   "text": "در قضیه چی؟ موت و مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 594.62,
   "end": 598.3,
   "text": "یعنی اصلاً کاری نداره تو اکراه داری یا نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 598.3,
   "end": 600.82,
   "text": "خوشت میاد یا بدت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.82,
   "end": 603.52,
   "text": "فرار می‌کنی یا به سمتش. بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.52,
   "end": 607.04,
   "text": "که انّ، او داره به سمت تو میاد با سرعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.04,
   "end": 608.98,
   "text": "و این باورش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 608.98,
   "end": 612.2,
   "text": "بیایید التماس کنیم به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.2,
   "end": 614.4,
   "text": "که ما این رو باور کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 614.4,
   "end": 617.66,
   "text": "امیرالمؤمنین مولای کوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 617.66,
   "end": 621.86,
   "text": "روزی رسان همه‌ی ما که امیر یه معناش روزی رسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.86,
   "end": 625.2,
   "text": "امیرالمؤمنین. روزی ما، رزق ما دست مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 625.2,
   "end": 628.98,
   "text": "ایشون آخرین رزقی که دست من و شما داده تو نفس آخرش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 628.98,
   "end": 632.22,
   "text": "یه حواست باشه که داری به مرگت نزدیک میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 632.22,
   "end": 636.94,
   "text": "قربونت برم. و چقدر خوبه که انسان اینو باور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 636.94,
   "end": 639.74,
   "text": "که حالا این رزق چقدر خوبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 639.74,
   "end": 647.38,
   "text": "انسان فقط رزقشو از این آقا که هفته‌ی قدریه هم هست فقط صرفاً مسائل مادی قرار نده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 647.38,
   "end": 650.54,
   "text": "یه وقتای، یه ذره هم ما رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 650.54,
   "end": 653.62,
   "text": "مجرد ت- از حضرت تقاضا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 653.62,
   "end": 656.82,
   "text": "مجرد علمه. علم جنسش مجرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 656.82,
   "end": 659.34,
   "text": "ماده نیست. علم مربوط به ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 659.34,
   "end": 662.26,
   "text": "فهمه. در درون خودت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 662.26,
   "end": 664.58,
   "text": "مثلاً یکی اینجا نشسته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.58,
   "end": 667.68,
   "text": "خواب باشه اصلاً، خواب‌های خوش داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 667.68,
   "end": 669.5,
   "text": "رفته کربلا رو داره زیارت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 669.5,
   "end": 674.92,
   "text": "یا اصلاً نه، بیداره به قول حضرت علامه حسن زاده علیه الرحمه در درس دهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 674.92,
   "end": 679.64,
   "text": "در شرح مصباح العنس مرحوم ابن فناری می‌فرمود اصلاً یکی اینجا نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 679.64,
   "end": 682.36,
   "text": "ملکی براش نازل شده. داره یک چیزی رو می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.36,
   "end": 684.72,
   "text": "\"تنزل الملائكة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 684.72,
   "end": 687.58,
   "text": "ملک، ملائکه براش نازل شدن که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 687.58,
   "end": 690.46,
   "text": "در سوق نفسش، در باطن نفسش یه چیزی رو می‌فهمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.46,
   "end": 693.92,
   "text": "این بحث‌ها بین ما گذشته. این یعنی تنزل ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 693.92,
   "end": 697.08,
   "text": "ولی بغلیش اصلاً نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 697.08,
   "end": 700.48,
   "text": "یعنی چی؟ این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.48,
   "end": 702.66,
   "text": "اصلاً مادی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 702.66,
   "end": 705.6,
   "text": "اگه مادی بود هر دو می‌دیدنش ملک رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 705.6,
   "end": 707.76,
   "text": "فهم بر هر دو اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 707.76,
   "end": 712.96,
   "text": "اما چرا این متوجه حضور ملک یا کشف حقیقت از درونش شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 712.96,
   "end": 719.32,
   "text": "چون بحث مجرده و اصلاً در درون خودش این فهم اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 719.32,
   "end": 721.48,
   "text": "قربونتون برم. اینطوری نیست که بیرون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 721.48,
   "end": 724.38,
   "text": "حالا ما بیاییم مجردات از حضرت تقاضا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 724.38,
   "end": 729.2,
   "text": "چه مجردی، چه فارغ از ماده‌ای بهتر از حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 729.2,
   "end": 734.2,
   "text": "اون روایت شیرینم عرض کنم و بسه چون حال یاسین هم داریم خیلی طول ندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 734.2,
   "end": 738.32,
   "text": "که در خدا رحمت کنه مرحوم شیخ حر عاملی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 738.32,
   "end": 740.96,
   "text": "عرض کردم بارها. ده سالش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 740.96,
   "end": 745.28,
   "text": "از دنیا رفت. الان یه بچه ده ساله چی میخواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 745.28,
   "end": 747.74,
   "text": "چیپس و پفک. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 747.74,
   "end": 751.1,
   "text": "باباش حالا یه موبایلی بخواد این چیزا بازیای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 751.1,
   "end": 755.64,
   "text": "ده سالش بود مرد. امام زمانش رو زیارت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 755.64,
   "end": 762.56,
   "text": "گریه کرد اون لحظه که به امام زمان عرض کرد آقا من مردم کاری برای شما نکردم که امام زمانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 762.56,
   "end": 768.9,
   "text": "ببین نگاه رو ببین. بعد حضرت یه جوری آب بهش داد خورد، زنده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 768.9,
   "end": 773.12,
   "text": "بعضیا تا صد و هفتاد جلد کتاب بر ایشون گفتن نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 773.12,
   "end": 775.86,
   "text": "عنوان‌ها. یکیش وسائل شیعه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.86,
   "end": 780.5,
   "text": "تو حرم علی ابن موسی الرضا. انشاالله باز قسمت شه حرف ایشون همش می‌شه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 780.5,
   "end": 785.0,
   "text": "تو صحن انقلاب رو به حرم وایسی پشت سرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 785.0,
   "end": 787.68,
   "text": "یه ذره محاذی قبر مرحوم خودکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 787.68,
   "end": 791.54,
   "text": "پله میخوره میره پایین. مرحوم شیخ حر عاملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 791.54,
   "end": 797.88,
   "text": "خیلی بزرگوار بود ایشون. تو کتابش آورده که خدایا-- روایتی آورده که خدای منان همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 797.88,
   "end": 803.48,
   "text": "زیبایی‌ها و جمال عالم رو به حضرت زهرا سلام الله علیها بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 803.48,
   "end": 806.3,
   "text": "همه عقل رو به امام حسن بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 806.3,
   "end": 809.62,
   "text": "اونایی که دنبال عقلن توسل به امام حسن کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 809.62,
   "end": 816.06,
   "text": "همه نیکی‌ها، خوبی‌ها و مهربانی‌ها رو به امام حسین بخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 816.06,
   "end": 819.94,
   "text": "و همه حکمت رو به امیرالمؤمنین بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 819.94,
   "end": 827.42,
   "text": "خب چقدر خوبه که آدم میره نجف یا همین جا دست گدایی دراز میکنه تو این هفته قدریه از مولا حکمت تقاضا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 827.42,
   "end": 832.24,
   "text": "یه ذره حکمت هم که یعنی علمه به احوال اعیان موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 832.24,
   "end": 834.88,
   "text": "یعنی زبان حال موجودات رو بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 834.88,
   "end": 837.7,
   "text": "یعنی باطن موجودات رو بش-- بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 837.7,
   "end": 840.72,
   "text": "باطن خودت رو، باطن اشیا و آسمان و زمین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 840.72,
   "end": 845.18,
   "text": "باطن‌بین بشی. به این میگن حکمت، باطن علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 845.18,
   "end": 848.0,
   "text": "از امیرالمؤمنین تقاضا کنیم یه ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 848.0,
   "end": 850.36,
   "text": "زور ما هم هی ذره‌بین گذاشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 850.36,
   "end": 853.88,
   "text": "هی این روایات رو می‌خوایم بریم به لایه‌های پنهانش به خاطر اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 853.88,
   "end": 855.6,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 855.6,
   "end": 859.32,
   "text": "آقای دهقان هم ساعتشو نگاه کرد، تذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 859.32,
   "end": 864.2,
   "text": "عاقبتمون انشاالله ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 864.2,
   "end": 868.22,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}