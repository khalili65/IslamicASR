   "start": 444.46,
   "end": 485.32
  },
  {
   "index": 6,
   "title": "## روایت یزدی؛ بی‌هوشی از ابتهاج نور",
   "start": 485.32,
   "end": 688.06
  },
  {
   "index": 7,
   "title": "## پرسش آیت‌الله مصباح",
   "start": 688.06,
   "end": 742.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 3.06,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.06,
   "end": 5.16,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.16,
   "end": 10.44,
   "text": "محمد. بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.44,
   "end": 14.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.22,
   "end": 18.58,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.58,
   "end": 22.16,
   "text": "در روایت هشتم بودیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.16,
   "end": 25.36,
   "text": "باب چهارم کتاب الموت بهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.36,
   "end": 29.44,
   "text": "بحث ما رسید در این روایت به اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.44,
   "end": 34.68,
   "text": "وجوه کراهت گونه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.68,
   "end": 39.52,
   "text": "تسلیم مرگ شدن حضرت ابراهیم رو در این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.52,
   "end": 43.08,
   "text": "بررسی می‌کردیم و رسیدیم به اینجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.08,
   "end": 46.46,
   "text": "به جهت نقص نفوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.46,
   "end": 50.04,
   "text": "و جبران مافات برای ماها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.04,
   "end": 52.82,
   "text": "ضعفا و به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.82,
   "end": 62.24,
   "text": "طی مراتب برای اولیای خدا به جز مقام ختمی و اهل بیت عصمت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.24,
   "end": 68.5,
   "text": "این حالت در هنگام مرگ پیش میاد که دوست دارن فرصت بیشتری بگیرن برای جبران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.5,
   "end": 77.02,
   "text": "و برای طی مراتب. این سؤال ایجاد شد که خب اگر برای ما این حالت پیش خواهد آمد که هنگام موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.02,
   "end": 79.42,
   "text": "ما دوست داریم بیشتر بمانیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.42,
   "end": 81.6,
   "text": "گفتید که آقا روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.6,
   "end": 85.26,
   "text": "خدای منان وعده کرده است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.26,
   "end": 89.14,
   "text": "محب امیرالمؤمنین علیه الصلاة والسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.14,
   "end": 92.56,
   "text": "قبض روح نکنه مگر راضیش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.56,
   "end": 94.44,
   "text": "خب این رضایت به چه صورته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.44,
   "end": 97.24,
   "text": "این اکراه بر موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.24,
   "end": 100.28,
   "text": "محبین اهل بیت هنگام موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.28,
   "end": 103.24,
   "text": "چگونه برطرف می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.24,
   "end": 107.96,
   "text": "اولاً یه روایت خیلی شیرینی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.96,
   "end": 109.88,
   "text": "که هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.88,
   "end": 113.38,
   "text": "کـ-- مجامع روایه‌مون اومده اما چون من الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.38,
   "end": 118.28,
   "text": "هرچی گشتم در اون منبعی که دیده بودم پیداش نکردم، منبع رو نقل نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.28,
   "end": 123.5,
   "text": "اما یادمه که در مجامع روایة مستند احتمالا در کتب اربعه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.5,
   "end": 126.26,
   "text": "اما از اساتیدمون هم زیاد شنیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.26,
   "end": 129.92,
   "text": "هنگام-- امام صادق صلوات الله علیه فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.92,
   "end": 134.34,
   "text": "سؤال شد از آقا چگونه محب رو آقا، خدا راضی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.34,
   "end": 137.02,
   "text": "وقتی م-موت چگونه محب رو راضی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.02,
   "end": 139.64,
   "text": "چون روایتی هم داریم حدیث قدسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.64,
   "end": 147.88,
   "text": "جامع احادیث قدسیه هم می‌دونید، جواهر الثنی، جواو، جواهر الثنیة فی احادیث القدسیه، مرحوم شیخ راملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.88,
   "end": 151.34,
   "text": "کتاب قطوریه. اونجا خدای منان فرمود \"ما من شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.34,
   "end": 157.58,
   "text": "تردد فیه مثل ترددی عند قبض روح المؤمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.58,
   "end": 160.56,
   "text": "خدا فرموده که من هیچ کجا مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.56,
   "end": 165.72,
   "text": "قبض روح مؤمن، مؤمن یعنی مطلقاً محب علی علیه الصلاة والسلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.72,
   "end": 168.88,
   "text": "مردد نمی‌شوم. این مردد نه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.88,
   "end": 171.2,
   "text": "استیصال یا چه کنم، چه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.2,
   "end": 175.44,
   "text": "اینکه به خدا در ساعت قدس حضرت حق راه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.44,
   "end": 180.7,
   "text": "این ترددی مثل اون ترددیه که حضرت ابا عبدالله در دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.7,
   "end": 185.56,
   "text": "عرفه عرض می‌کنه به خدا که \"الهی ترددی في الآثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.56,
   "end": 187.36,
   "text": "یوجب بعد المزار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.36,
   "end": 191.48,
   "text": "قبلاً درباره‌ش حرف زدیم در توحید صمدی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.48,
   "end": 196.26,
   "text": "که حضرت فرمودن که این تردید من یعنی رفت و آمد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.26,
   "end": 201.68,
   "text": "بین آثار تو، ترددی في الآثار یعنی آیات تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.68,
   "end": 207.22,
   "text": "یوجب بعد المزار، منو از اون محل ز-- از، از زیارت تو دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.22,
   "end": 216.74,
   "text": "یعنی این‌ها رو به عنوان اینکه نش آثار تواند، نشانه‌ی تواند من نگاه نکنم بلکه عین ظهور تواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.74,
   "end": 221.66,
   "text": "که بحثش قبلاً گذشت. حالا این تردد یعنی رفت و آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.66,
   "end": 224.9,
   "text": "نه یعنی استیصال و حیرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.9,
   "end": 227.8,
   "text": "نه. خدا میفر-- که نه که هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.8,
   "end": 234.2,
   "text": "مثل اینکه واسطه‌ی فیض که قابض الارواح است مثل الان جریان حضرت ابراهیم که تو روایت وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.2,
   "end": 236.62,
   "text": "تردد می‌کنه. یعنی با حضرت ابراهیم صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.62,
   "end": 238.76,
   "text": "حضرت می‌فرماید که عرض می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.76,
   "end": 243.3,
   "text": "چگونه است که دوستی، اِممم مرگ دوستشو طلب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.3,
   "end": 246.34,
   "text": "ایشون تردد یعنی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.34,
   "end": 248.92,
   "text": "اصلاً یک اصل در ذکر هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.92,
   "end": 254.82,
   "text": "اصل تردد. هی ورد رو تکرار که می‌کنی بهش میگن تردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.82,
   "end": 257.52,
   "text": "هی ورود می‌کنی به ذکر خروج می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.52,
   "end": 260.48,
   "text": "ایشون میره به مقام باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.48,
   "end": 264.5,
   "text": "عالم و پیام‌ها رو که بحث شد درباره‌ش میگیره به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.5,
   "end": 266.54,
   "text": "این هم و به حضرت ابراهیم می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.54,
   "end": 270.84,
   "text": "این تردد منظور اینه که خدا می‌فرماید که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.84,
   "end": 276.6,
   "text": "هیچ کجا مثل اینجا تردد نمی‌کنم یعنی اینکه هی واسطه‌های فیض رو به کار می‌ندازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.6,
   "end": 279.72,
   "text": "اینه معناشه که جان و قبض کنن روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.72,
   "end": 281.72,
   "text": "محب امیرالمؤمنین. اونجا جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.72,
   "end": 284.38,
   "text": "شیعه اونجا معلوم میشه. شیعه اسمه اشعری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.38,
   "end": 287.18,
   "text": "که حالا بعد از امام صادق صلوات الله علیه کیفیتشو پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.18,
   "end": 289.62,
   "text": "یه چیزکی نسبت به ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.62,
   "end": 295.1,
   "text": "سائل حضرت فرمودن که خدای منان اون لحظه وقتی می‌بینه اکراه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.1,
   "end": 298.9,
   "text": "محب برای تسلیم کردن جان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.9,
   "end": 301.52,
   "text": "مواهب بهشتی‌ش رو بهش نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.52,
   "end": 306.6,
   "text": "درجاتشو در بهشت. حور و قصور و حالا نسبت به ظرف وجودیش نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.6,
   "end": 310.3,
   "text": "باز ایشون راضی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.3,
   "end": 314.44,
   "text": "محب امیرالمؤمنین راضی نمیشه. چه خوب هم و چه خوش هم که راضی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.44,
   "end": 319.48,
   "text": "خب اون که عاشق حور و قصور و انهار و این‌ها نبوده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.48,
   "end": 325.68,
   "text": "توجه کردید راضی نمیشه. بعد دو مرتبه خدا چگونه راضیش می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.68,
   "end": 330.1,
   "text": "روایت داریم که البته چند مرحله‌ست روایت من سریع ازش رد شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.1,
   "end": 334.34,
   "text": "می‌فرماید که چهره مقدس رسول خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.34,
   "end": 341.58,
   "text": "امیرالمؤمنین و حضرت زهرا صلوات الله علیهم أجمعین رو توی روایت داره نشونش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.58,
   "end": 345.4,
   "text": "و یه روایت میگه تا امام زمانش رو از پیغمبر تا امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.4,
   "end": 347.78,
   "text": "حالا در هر حال چهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.78,
   "end": 350.76,
   "text": "انسان کامل رو نشونش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.76,
   "end": 354.98,
   "text": "اینکه امیرالمؤمنین علیه الصلاة والسلام به وارث همدان فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.98,
   "end": 361.52,
   "text": "چه کا-کافر باشه چه مؤمن باشه \"مَیَمُتِ یَرَنِی\" هرکس بمیره منو می‌بینه یه وجهشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.52,
   "end": 364.64,
   "text": "یه وضعی شه که باید ولایت تحت ولایت باید جان بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.64,
   "end": 367.46,
   "text": "حالا محب آقا هست راضیش می‌کنند می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.46,
   "end": 372.08,
   "text": "غیر محب راضی نیستی که به درک که نیستی به سلامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.08,
   "end": 375.36,
   "text": "شرشو از عالم می‌کنن. ولی محب به هر حال راضی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.36,
   "end": 379.7,
   "text": "حالا این چهره‌های زیبا رو روایت داریم وقتی نشونش میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.7,
   "end": 383.8,
   "text": "راضی می‌شه. یعنی چهره دلربای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.8,
   "end": 386.14,
   "text": "ابا عبدالله الحسین رو نشونت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.14,
   "end": 389.28,
   "text": "چه چی شیرین‌تر از این؟ راضی می‌شه به موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.28,
   "end": 391.76,
   "text": "اون کراهت دیگه برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.76,
   "end": 396.24,
   "text": "مثل این‌که اونجا حضرت قابض الارواح در خصوص حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.24,
   "end": 398.96,
   "text": "فقط سؤال و جواب نیست، فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.96,
   "end": 403.28,
   "text": "خبر نیست، بحث اخبار نیست که بیاد خبر برسونه از ابراهیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.28,
   "end": 405.98,
   "text": "خدا فرموده که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.98,
   "end": 411.48,
   "text": "کیو کدوم دوست رو دیدی از ملاقات دوستش کراهت داشته باشه که حضرت ابراهیم راضی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.48,
   "end": 415.32,
   "text": "نه اون، اون عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.32,
   "end": 419.92,
   "text": "تجلیات بی‌مثال حضرت حق رو حضرت ابراهیم مشاهده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.92,
   "end": 422.48,
   "text": "یعنی می‌بینه، می‌چشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.48,
   "end": 425.9,
   "text": "می‌رسه به اون تجلیات بی‌مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.9,
   "end": 427.96,
   "text": "و بی‌واسطه. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.96,
   "end": 432.14,
   "text": "حاضر به قبض روح می‌شه. حالا برای سهولت فهم من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.14,
   "end": 437.54,
   "text": "این قصه رو نسبت به سنت الهی که همیشه واسطه‌های خیر وجود دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.54,
   "end": 442.76,
   "text": "تردد ملائکه الله مثل قابض الارواح وجود داره، این چنین روایت فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.76,
   "end": 447.22,
   "text": "اتفاقا خدا رحمت کنه حضرات آقای سیبوی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.22,
   "end": 453.02,
   "text": "محضر ایشون که بودیم یه رفته بودیم منزلشون حالا یادم به چه مناسبتی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.02,
   "end": 460.06,
   "text": "ایشون با حالت بغض و گریه این روایت شیرین رو به ما گفتن که البته شبیه این روایت رو هم مرحوم شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.06,
   "end": 464.36,
   "text": "غلامرضا فقیه خراسانی از علمای به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.36,
   "end": 467.84,
   "text": "شیعه توی یزد بود. ایشونم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.84,
   "end": 470.46,
   "text": "ایشونم آوردن شبیه به این رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.46,
   "end": 473.8,
   "text": "حالا آقای سیبوی فرمودن که بهشتیا تو بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.8,
   "end": 476.72,
   "text": "خب یک یک که وارد می‌شن حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.72,
   "end": 478.52,
   "text": "سلام الله علیها به روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.52,
   "end": 486.08,
   "text": "مبسوطی که مرحوم آقا میرزا جواد آقای ملکی تبریزی آورده که تنها کسی که جرئt می‌کنه، جرات می‌کنه بره دم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.08,
   "end": 488.24,
   "text": "جهنم بهیسته یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.24,
   "end": 492.58,
   "text": "ببینه کسایی که وارد آتش جهنم می‌شن یه وقت بوی حسین نداشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.58,
   "end": 495.16,
   "text": "اینا مفصله خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.16,
   "end": 501.26,
   "text": "بعد حضرت زهرا سلام الله علیها وقتی که یک یک محبین بچه‌هاش که واردش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.26,
   "end": 504.52,
   "text": "بهشت شدن و خیالش راحت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.52,
   "end": 508.02,
   "text": "قدم به بهشت می‌گذاره. اونجا روایات اینو از آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.02,
   "end": 510.9,
   "text": "سیبوی من شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.9,
   "end": 515.8,
   "text": "وقتی خانم دید همه محبین حسینش تو بهشت جمع‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.8,
   "end": 518.86,
   "text": "یه لبخند رضایتی می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.86,
   "end": 522.5,
   "text": "از اثر لبخند اونجا ایشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.5,
   "end": 527.52,
   "text": "از اثر لبخند تو روایت من دیدم میگه از دندون‌های مبارکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.52,
   "end": 533.9,
   "text": "چون قابل جمع هم هست. حضرت زهرا سلام الله علیها نوری ساطع می‌شه که بهشت رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.9,
   "end": 538.38,
   "text": "همه میگن این چه نوریه که پیش از این ما همچین نوری ندیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.38,
   "end": 543.98,
   "text": "این چه تجلی‌ایه؟ این چه جلوه جدیدی از حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.98,
   "end": 548.68,
   "text": "قبلاً عرض کردیم با اون روایت که در وسائل الشیعه شیخ حر عاملی میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.68,
   "end": 555.04,
   "text": "تمام زیبایی‌ها و جمال رو خدا بخشیده به حضرت زهرا سلام الله و بله باید نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.04,
   "end": 559.66,
   "text": "لبخند ایشون هم چنان تجلی جمالیه داشته باشه که همه رو مدهوش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.66,
   "end": 565.34,
   "text": "این چیه؟ این چه نوریه که ما نه در دنیا دیده بودیم، نه در برزخ و نه در الان تو بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.34,
   "end": 567.98,
   "text": "ندیده بودیم. میگن این اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.98,
   "end": 574.4,
   "text": "نور لبخند حضرت زهرا سلام الله علیها از دندون‌های مبارکش بلند شده، ساطع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.4,
   "end": 580.08,
   "text": "چه ایشون خوشحال شده محبین حسینش رو تو بهشت جمع دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.08,
   "end": 586.96,
   "text": "به به، به به چه مادری. ایام فصل نوکری ابا عبدالله‌م که داره از فردا شب می‌رسه آماده باشیم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.96,
   "end": 590.44,
   "text": "خود خانم نفس بزنه همه‌مونو آماده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.44,
   "end": 594.48,
   "text": "با آلودگی نریم تو خیمه امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.48,
   "end": 597.72,
   "text": ". بله. تو اون روایت مرحوم آقای یز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.72,
   "end": 601.22,
   "text": "خراسانی که عرض کردم از علمای به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.22,
   "end": 605.24,
   "text": "یزد بود، ایشون می‌فرما-- این روایتو به این شکل میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.24,
   "end": 608.52,
   "text": "می‌فرماید که مؤمنین تو بهشت هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 608.52,
   "end": 610.72,
   "text": "نه اینکه وارد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 610.72,
   "end": 613.84,
   "text": "تو بهشت هستن. اینم کامتون با این روایت شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.84,
   "end": 618.08,
   "text": "برای امروز بسه اگرچه بحث نیمه کارمونه انشاالله روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.08,
   "end": 620.02,
   "text": "بعد مشغول نعمتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.02,
   "end": 623.48,
   "text": "نعمت‌های مختلف الهی رو اینا غرق در نعمتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.48,
   "end": 625.84,
   "text": "ناگاه نوری می‌تابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 625.84,
   "end": 629.26,
   "text": "یه فضای جدیدی در بهشت ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.26,
   "end": 633.16,
   "text": "مؤمنین از ابتهاج این نور بی‌هوش می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.16,
   "end": 637.88,
   "text": "اینجا می‌گه بی‌هوش می‌شن. تو روایت قبلی نمی‌گه بی‌هوش می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.88,
   "end": 642.5,
   "text": "بعد وقتی به هوش میان می‌پرسن این چه نوری بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.5,
   "end": 645.72,
   "text": "همچین تجلی و نوری ما تا حالا ندیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.72,
   "end": 649.1,
   "text": "اونجا ملائکه بهشون میگن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.1,
   "end": 652.16,
   "text": "اثر این نور از اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.16,
   "end": 657.22,
   "text": "لبخند حضرت زهرا همین الان به امیرالمؤمنین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.22,
   "end": 664.4,
   "text": "به به، به به. یعنی الان در مقام قرب حضرت زهرا سلام الله علیها به امیرالمؤمنین لبخند زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.4,
   "end": 666.38,
   "text": "این اثر نوری اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.38,
   "end": 670.0,
   "text": "چون جمال حقه دیگه یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.0,
   "end": 676.48,
   "text": "م-محل یعنی فیض هرچه جماله در او جمع شده وقتی لبخند بزنه باید در عالم یه همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.48,
   "end": 679.2,
   "text": "رشحه ایجاد بشود از جمال او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.2,
   "end": 681.74,
   "text": "منتها بهشتیا درکش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.74,
   "end": 685.76,
   "text": "بعد اونا میگن ما همچین چیزی تا حالا ندیده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.76,
   "end": 688.98,
   "text": "که بعد اینجا که می‌رسه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.98,
   "end": 692.46,
   "text": "شرح این روایت دیدم خدا رحمت کنه حضرات آقای مصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.46,
   "end": 700.14,
   "text": "این عبارت رو می‌فرمودن. می‌فرمودن آیا این تجلیات و این جلوه‌ها دیدنی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.14,
   "end": 706.86,
   "text": "چه سؤال قشنگی. اینایی که دنبال حوری و سیب و گلابی بهشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.86,
   "end": 710.82,
   "text": "میگه شاخک‌هاشونو تیز کنید آقای مصباح می‌فرمود با این روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 710.82,
   "end": 716.42,
   "text": "آیا دیدن تجلی لبخند حضرت زهرا برای تو محب امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 716.42,
   "end": 722.48,
   "text": "یا در دیدن چهره امیرالمؤمنین اون لبخند، این دیدنی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 722.48,
   "end": 728.64,
   "text": "آدم ح-حق نیست جون بده برای دیدن این تجلیات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.64,
   "end": 732.76,
   "text": "حالا نقطه سرخط بحث تجلیات و دیدن و جلوه‌ها این‌ها بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 732.76,
   "end": 734.56,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 734.56,
   "end": 737.64,
   "text": "به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 737.64,
   "end": 740.4,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 740.4,
   "end": 742.96,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}