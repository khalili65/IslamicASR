   "start": 18.58,
   "end": 70.64
  },
  {
   "index": 1,
   "title": "## پرسش از رضایت محب هنگام موت",
   "start": 70.64,
   "end": 218.82
  },
  {
   "index": 2,
   "title": "## تردد در دعای عرفه و در ذکر",
   "start": 218.82,
   "end": 287.78
  },
  {
   "index": 3,
   "title": "## مراحل راضی کردن محب",
   "start": 287.78,
   "end": 394.26
  },
  {
   "index": 4,
   "title": "## ابراهیم و چشیدن تجلیات",
   "start": 394.26,
   "end": 444.46
  },
  {
   "index": 5,
