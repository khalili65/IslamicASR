   "title": "## آیهٔ انفاق و وعدهٔ جایگزینی",
   "start": 11.98,
   "end": 93.92
  },
  {
   "index": 1,
   "title": "## نفق؛ سوراخ گلدان و حداقل انفاق",
   "start": 93.92,
   "end": 260.56
  },
  {
   "index": 2,
   "title": "## یقین به خلف؛ حکمت نهج‌البلاغه",
   "start": 260.56,
   "end": 365.48
  },
  {
   "index": 3,
   "title": "## داستان سقط و اسرار خلقت",
   "start": 365.48,
   "end": 476.02
  },
  {
   "index": 4,
   "title": "## انّا لله؛ حال بیداری از خواب",
   "start": 476.02,
   "end": 582.84
  },
  {
   "index": 5,
   "title": "چون انسان هر چه سنش بالا می‌رود از آن عهد فاصله می‌گیرد:",
   "start": 582.84,
   "end": 889.87
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.62,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.62,
   "end": 6.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.68,
   "end": 11.98,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.98,
   "end": 15.12,
   "text": "در بحث بخشش آیه سی و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.12,
   "end": 17.94,
   "text": "سوره سبأ رو قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.94,
   "end": 24.84,
   "text": "دقت فرمودید که می‌فرماید \"ما أنفقتم من شيءٍ فهو يخلفه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.84,
   "end": 29.78,
   "text": "اعتقاد به همین آیه کفایت می‌کنه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.78,
   "end": 36.4,
   "text": "می‌فرماید که آنچه که انفاق کنید هر چیزی رو من شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.4,
   "end": 38.94,
   "text": "ما أنفقتم من شيءٍ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.94,
   "end": 41.76,
   "text": "هر چیزی رو که انفاق کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.76,
   "end": 44.08,
   "text": "حالا این انفاق می‌تونه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.08,
   "end": 46.18,
   "text": "بحث روایت نهم از باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.18,
   "end": 51.74,
   "text": "چهارم کتاب الموت که ما درش قرار گرفتیم بحث بخشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.74,
   "end": 56.02,
   "text": "مالی صرفاً بود که اون شخص گفت من چرا از موت بدم میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.02,
   "end": 60.14,
   "text": "پیغمبر فرمود خرج نمی‌کنی، مالت رو در راه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.14,
   "end": 63.52,
   "text": "خرج نمی‌کنی. اما این همه چی می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.52,
   "end": 66.56,
   "text": "حالا ما که مالک مالمون نیستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.56,
   "end": 68.82,
   "text": "مالک اصلی خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.82,
   "end": 71.92,
   "text": "و این‌ها امانته. نه فقط مال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.92,
   "end": 75.12,
   "text": "عمرمون، آبرومون، علممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.12,
   "end": 77.88,
   "text": "و آنچه که ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.88,
   "end": 80.36,
   "text": "منتسب به ماست همه و همه چی‌ند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.36,
   "end": 84.16,
   "text": "مال خداست. امانتی‌ست چند صباحی دست ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 84.16,
   "end": 88.78,
   "text": "این می‌فرماید ما أنفقتم من شيءٍ هر چیزی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.78,
   "end": 91.06,
   "text": "بدی چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.06,
   "end": 93.92,
   "text": "حالا نفق، أنفقتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.92,
   "end": 96.34,
   "text": "نفق می‌تونید در عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.34,
   "end": 99.9,
   "text": "مستحضر هستید اون، ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.9,
   "end": 105.62,
   "text": "زیر گلدون یه سوراخی هست که اضافه آب گلدون رو می‌ریزه بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.62,
   "end": 109.26,
   "text": "که اگر اون نباشه یعنی گلدون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.26,
   "end": 113.44,
   "text": "اون سوراخ نداشته باشه یا به هر دلیلی اون کیپ می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.44,
   "end": 117.38,
   "text": "می‌پوسه، خراب می‌شه، فاسد می‌شه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.38,
   "end": 120.08,
   "text": "گلدون زرد می‌شه از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.08,
   "end": 123.72,
   "text": "به جهت که آب اضافه بیرون نمی‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.72,
   "end": 126.42,
   "text": "سر بودن اون سوراخ رو امتحان کنید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 126.42,
   "end": 132.68,
   "text": "اصلاً سوراخ یه گلدون بدون سوراخ بردارید توش گل بکارید ببینید چه اتفاقی می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.68,
   "end": 140.38,
   "text": "این که حالا بعضی از خاک‌ها هستن که سفت می‌شن به مرور و آب نمی‌تونه از اون زیر بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.38,
   "end": 144.9,
   "text": "بعد از یه مدتی این اتفاق می‌افته با اینکه سوراخ اون زیر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.9,
   "end": 147.88,
   "text": "اما نمی‌ذاره خارج بشه. حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.88,
   "end": 151.78,
   "text": "کلاس گیاه شناسی نداریم اما ایناشون تجربیات خود بنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.78,
   "end": 155.6,
   "text": "مثلاً سبوس گندم رو می‌ریزن اون زیر یا پوکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.6,
   "end": 159.84,
   "text": "پوکه‌های خیلی ریز جمع می‌کنن برای اینکه گرفتگی آب اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.84,
   "end": 163.46,
   "text": "اتفاق نیفته. به اون می‌گه نفق عرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.46,
   "end": 166.42,
   "text": "یعنی شما اضافه اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 166.42,
   "end": 170.14,
   "text": "دیگه بیرون از حیطه خرج کردت هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.14,
   "end": 174.4,
   "text": "اون رو می‌ریزی از زندگیت بیرون در راه خدا میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.4,
   "end": 177.46,
   "text": "این دیگه حداقل انفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.46,
   "end": 183.86,
   "text": "یعنی دیگه اگر کسی اینو نداشت اصلاً گند می‌خوره به زندگیش، زندگیش می‌پوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.86,
   "end": 189.62,
   "text": "این یه حداقلشه. برای بعضیا اون‌هایی که دیگه می‌خوان به مقامات عالیه برسن معامله می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.62,
   "end": 192.18,
   "text": "اون‌ها دیگه به ایثار می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.18,
   "end": 195.5,
   "text": "ایثار جاییه که خودت احتیاج داری و می‌بخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.5,
   "end": 200.82,
   "text": "اون دیگه کار هر کسی نیست. خودت احتیاج داشته باشی بدی کار هر کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.82,
   "end": 204.28,
   "text": "حالا در این آیه می‌فرماید ما أنفقتم من شيءٍ چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.28,
   "end": 206.62,
   "text": "وعده الهی فهو يخلفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 206.62,
   "end": 209.62,
   "text": "هو کیه اینجا؟ قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.62,
   "end": 212.96,
   "text": "هو الله احد. همون هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 212.96,
   "end": 217.64,
   "text": "همون هو، فهو يخلفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.64,
   "end": 221.06,
   "text": "براش جانشین قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.06,
   "end": 226.44,
   "text": "این وعده قطعی خداست. اگر کسی این رو بداند و یقین حاصل کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.44,
   "end": 230.6,
   "text": "مشکل حله. این آیه ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 230.6,
   "end": 234.0,
   "text": "حالا که در هر چیزی هست کسی که عمرش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.0,
   "end": 238.18,
   "text": "انفاق می‌کنه، آبروش رو انفاق می‌کنه، علمش رو انفاق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.18,
   "end": 240.6,
   "text": "همه این‌ها هر کدوم مالش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 240.6,
   "end": 244.38,
   "text": "خدا جایگزین می‌ذاره. شما ببینید کسایی که معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.38,
   "end": 249.16,
   "text": "در خدمت مردم‌اند دقت بفرمایید دور و برتون اینایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.16,
   "end": 251.54,
   "text": "خدمت مردم می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 251.54,
   "end": 256.82,
   "text": "مخصوصاً تو حوزه علم و دانش اینا بیشتر عمر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 256.82,
   "end": 260.08,
   "text": "این همین آیه داره تصریح می‌کنه عملاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.08,
   "end": 267.68,
   "text": "یا مثلاً امیرالمؤمنین علیه الصلاة والسلام در آیه، در حکمت صد و سی و هشت نهج فرمودن من أيقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.68,
   "end": 272.84,
   "text": "بحث یقین رو میاره. پیداست که اون يقينه خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.84,
   "end": 275.88,
   "text": "کسی که یقین داشته باشه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.88,
   "end": 282.0,
   "text": "بالخلف، به جایگزینی به همین جایگزینی که در اون آیه فرموده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.0,
   "end": 287.72,
   "text": "جاء بالعطية. در، در جود و بخشش عطا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.72,
   "end": 293.02,
   "text": "جاء بالعطية. یعنی کارش می‌شه عطا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.02,
   "end": 298.04,
   "text": "چرا؟ چون یقین داره من أيقن بالخلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.04,
   "end": 301.2,
   "text": "می‌دونه که مثل کسی که پدری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.2,
   "end": 305.96,
   "text": "می‌دونه ادامه نسل داره خیالش راحته که مقتول نسل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.96,
   "end": 308.38,
   "text": "که اصلاً سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.38,
   "end": 313.84,
   "text": "این ازدواج به قول حضرت تلامه عليه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.84,
   "end": 318.26,
   "text": "سرش فرمودن که در ایجاد صورت انسانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.26,
   "end": 320.98,
   "text": "نه اطفاء شهوت حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.98,
   "end": 326.34,
   "text": "که پیغمبر فرمود و حتی اون کسایی، بچه‌هایی که در رحم‌ها سقط شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.34,
   "end": 328.4,
   "text": "نه اینکه خود طرف سقط کرد، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.4,
   "end": 332.5,
   "text": "سقط شدن به صورت طبیعی به اون‌ها هم افتخار خواهم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.5,
   "end": 335.98,
   "text": "در میان پیامبران و امم پیشین حالا چه سری درآره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.98,
   "end": 341.26,
   "text": "سر خلقت دیگه. لذا پیغمبر فرمود تا می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.26,
   "end": 343.76,
   "text": "ایجاد صورت انسانی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.76,
   "end": 347.16,
   "text": "یعنی به قول امروزی می‌گیم بچه بیارید تا می‌تونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.16,
   "end": 351.02,
   "text": "بعد رزق اینا هم که دست من و شما نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.02,
   "end": 354.32,
   "text": "قدیم‌ها می‌گفتن فلان بچه که اومد با خودش ماشین آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.32,
   "end": 358.34,
   "text": "نمی‌دونم اون اومد خونه آورد، اون اومد کار آورد، اون اومد برکت آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.34,
   "end": 363.14,
   "text": "هر کدومشون با خودشون یه پا قدمی دارن، یه برکتی میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.14,
   "end": 368.14,
   "text": "یه گره‌ای باعث می‌کنند. محضر یکی از اولیا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.14,
   "end": 370.7,
   "text": "حالا مخصوصا اسم نمیارم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.7,
   "end": 373.6,
   "text": "بنا به دلایلی که ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.6,
   "end": 378.1,
   "text": "وارد می‌شد به قرآن و می‌گفت بعضی چیزها رو نه البته به هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.1,
   "end": 381.36,
   "text": "یه زن و شوهری اومدن پیش ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.36,
   "end": 387.58,
   "text": "هنوز لب باز نکرده قرآن رو باز کرد بست این بزرگوار و فرمود: \"نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.58,
   "end": 391.84,
   "text": "این کارو نکنید. اگه این کارو بکنید به مرگ بدی می‌میرید.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.84,
   "end": 399.14,
   "text": "اینام پا شدن رفتن. وقتی رفت ایشون گفتش که اینا حرف منو گوش نمیدن و خواستن بچه‌ای در رحم زنش بود این مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.14,
   "end": 402.8,
   "text": "قصد سقط جنین داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.8,
   "end": 410.28,
   "text": "اینا حرف منو گوش نمیدن، میرن سقط می‌کنن دو هفته بعد تصادف شدیدی هر دو می‌میرن و همین اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.28,
   "end": 416.34,
   "text": "این بچه رو سقط کردن دو هفته بعد تو راه شمال هر زن و شوهرش هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.34,
   "end": 419.96,
   "text": "له شدن تو ماشین. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.96,
   "end": 423.88,
   "text": "اسرار خلقته. کسی در بیفته با این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.88,
   "end": 426.9,
   "text": "عالم به، به باهاش در می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.9,
   "end": 432.4,
   "text": "مثل این که قبلا عرض کردیم اساس عالم بر طهارته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.4,
   "end": 435.4,
   "text": "و اساس عالم بر عدالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.4,
   "end": 438.58,
   "text": "اگر کسی طهارت رو بذاره کنار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.58,
   "end": 443.7,
   "text": "عدالت رو بذاره کنار، عالم باهاش در می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.7,
   "end": 446.68,
   "text": "یعنی می‌بینی زندگیش زیر و رو می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.68,
   "end": 450.24,
   "text": "آبروش کن فیکون می‌شه. اینا اسرار الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.24,
   "end": 458.18,
   "text": "این‌ها نشون می‌ده که چقدر بذل و بخشش پیش خدا عزیزه و البته پیش دشمن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.18,
   "end": 460.68,
   "text": "ابغوضه بذل و بخشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.68,
   "end": 464.32,
   "text": "هر چیزی که خدا انقدر داره روش اصرار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.32,
   "end": 467.7,
   "text": "پیداست که این‌ها جزو مهمات درگاه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.7,
   "end": 471.62,
   "text": "یعنی وقتی ما می‌رسیم محضر حق ان لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.62,
   "end": 479.24,
   "text": "وقتی میومدیم که تو برم و خالی بود خودمونم مال خودمون نبودیم ان لله در قوس نزول تشریف فرما شدی به این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.24,
   "end": 482.34,
   "text": "خودتم از آن خودت نبودی اون لحظه قبول می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.34,
   "end": 485.66,
   "text": "دیدی وقتی که از خواب بیدار می‌شی چون تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.66,
   "end": 493.71,
   "text": "از یک لایه پنهان‌تر از عالم یعنی عالم برزخ وجودی خودت، اون رتبه مثالی خودت برگشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.71,
   "end": 497.62,
   "text": "حالت بهتره. روضه‌های دم صبح بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.62,
   "end": 499.96,
   "text": "توسلات، دعاها، نمازها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.96,
   "end": 504.7,
   "text": "اصلا حال انسان وقت بیدار شدن از خواب بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.7,
   "end": 507.7,
   "text": "اینه که دق-- امتحان کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.7,
   "end": 510.64,
   "text": "یکی از بهترین لحظاتی که آدم دل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.64,
   "end": 513.96,
   "text": "دنیا می‌کَنه و بدش میاد از گناه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.96,
   "end": 518.84,
   "text": "دوست داره توبه کنه یا حالش بهتره، دگرگونه وقتیه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.84,
   "end": 520.92,
   "text": "رتبه مثالی خودش برگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.92,
   "end": 524.5,
   "text": "یعنی از خواب. یعنی عالم مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.5,
   "end": 532.46,
   "text": "برگشته. ما وقتی بر-- اومدیم به نشأت طبیعت در قوس نزول قبلش در رتبه مثالی بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.46,
   "end": 537.48,
   "text": "عالم مثالی منفصل از خودمون بیرون که بهش می‌گن عالم زهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.48,
   "end": 540.4,
   "text": "لذا وقتی وارد این دنیا شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.4,
   "end": 543.18,
   "text": "اینو فهمیدیم که انتم الفقراء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.18,
   "end": 547.62,
   "text": "الى الله. چرا؟ می‌بینی بچه راحت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 547.62,
   "end": 550.32,
   "text": "بچه خیلی راحت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.32,
   "end": 554.46,
   "text": "ما یه روز از به، بذل و بخشش حرف زدیم بالا منبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.46,
   "end": 557.34,
   "text": "کلی آدم پای منبر ما نشسته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.34,
   "end": 560.28,
   "text": "تو هیئت. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.28,
   "end": 566.78,
   "text": "دو نفر وقتی ما از منبر اومدیم پایین از اون همه آدم گفتیم آقا خیریه داریم آقا نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.78,
   "end": 572.96,
   "text": "نوجوونا رو داریم پوشش می‌دیم چی چی ما توقع داریم از جهت مالی ما رو حمایت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.96,
   "end": 575.52,
   "text": "در اهدافمون نه به خودمون که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.52,
   "end": 577.08,
   "text": "دو نفر لبیک گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.08,
   "end": 580.66,
   "text": "دوتاشون هم نوجوون بودن. یکیش پسر خود من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.66,
   "end": 586.48,
   "text": "هرچی عیدی جمع کرده بود همون موقع از جيبش درآورد گفت بابا همه‌ی اینا مال شماست تو راه خیر خرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.48,
   "end": 588.24,
   "text": "گفتم پسر این زیاده رویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.24,
   "end": 590.42,
   "text": "قرآن هم نهی کرده این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.42,
   "end": 594.12,
   "text": "یه بخشیشو بده، یک دهمش رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 594.12,
   "end": 596.06,
   "text": "توجه کردید چرا این بچه راحت می‌بخشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.06,
   "end": 598.44,
   "text": "بعد ریش سفیدا بر رو بر منو نگاه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.44,
   "end": 601.54,
   "text": "حتی کسایی که می‌دونستم دست و بالشون پره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.54,
   "end": 604.52,
   "text": "دارن، اراده کنن کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.52,
   "end": 608.02,
   "text": "چرا وقتی انسان هی سنش میره بالا از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.02,
   "end": 614.02,
   "text": "عهدش \"ألم أعهد إليكم يا بني آدم ألا تعبدوا الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.02,
   "end": 618.24,
   "text": "إنه لكم عدو مبين وأن اعبدوني هذا صراط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.24,
   "end": 623.52,
   "text": "مستقيم\" از اون صراط فاصله می‌گیره، از عهدش فاصله می‌گیره، پا به سن می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 623.52,
   "end": 631.62,
   "text": "اتفاقا هرچی سن میره بالا شهوت کم می‌شه، حب به مال و علقه به دنیا زیاد می‌شه از جه-جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.62,
   "end": 636.96,
   "text": "پول، ثروت. یه آدمی که ریش سفیده اگه بخشیش این معلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.96,
   "end": 640.44,
   "text": "ص-صفت بخشش درش جا انداخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.44,
   "end": 643.94,
   "text": "جا افتاده، در وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.94,
   "end": 645.7,
   "text": "نهادینه شده، ثابت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.7,
   "end": 649.22,
   "text": "تا یه بچه، بچه راحت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 649.22,
   "end": 655.56,
   "text": "اینو باید توجه داشته باشیم. همین مقدار که پیش خدا عزیزه پیش دشمن خدا هم عزیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.56,
   "end": 659.32,
   "text": "لعن‌های پیغمبر رو برید نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.32,
   "end": 663.44,
   "text": "اینی که به شما عرض می‌کنم من دقت کردم که به شما می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.44,
   "end": 666.92,
   "text": "کجا بیشتر پیغمبر لعن کرده دشمنان رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.92,
   "end": 669.76,
   "text": "یکی در خصوص ذریه‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.76,
   "end": 672.62,
   "text": "به شدت لعن کرده و توصیه به لعن کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 672.62,
   "end": 675.94,
   "text": "مثل اون شخص که پیش امام صادق صلوات الله عليه رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 675.94,
   "end": 679.48,
   "text": "دو تا لباس آورده بود گفت آقا با یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 679.48,
   "end": 684.78,
   "text": "هر سوزنی که زدم یه سلام به اجداد شما دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 684.78,
   "end": 689.9,
   "text": "اون یکی با هر سوزنی که زدم لعن به دشمنان و قاتلین اجدادتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.9,
   "end": 693.9,
   "text": "امام صادق اونی که لعن کرده بودو پذیرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 693.9,
   "end": 697.66,
   "text": "گفت اون لباسی که باهاش با هر سوزنش لعن کردی رو بده به من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 697.66,
   "end": 700.16,
   "text": "اون یکی مال خودت. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 700.16,
   "end": 704.14,
   "text": "حالا بعضیا میان می‌گن خب چون رحمة للعالمین بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 704.14,
   "end": 708.1,
   "text": "گفت اون که به رحمت خدا نزدیک‌تره مال خودت، این مال منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 708.1,
   "end": 712.16,
   "text": "از این تعبیرات هم داریم. اما اصل کلام فعلا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.16,
   "end": 714.3,
   "text": "توجه کردید؟ لعن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 714.3,
   "end": 718.06,
   "text": "یکی هم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 718.06,
   "end": 720.68,
   "text": "جلوگیری شیطان از انفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 720.68,
   "end": 723.62,
   "text": "خیلی پیغمبر لعن کرده شیطان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.62,
   "end": 728.0,
   "text": "یه روایت براتون بگم که وقتم نیست اینو سریع بگم روایت مبسوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.0,
   "end": 733.01,
   "text": "حالا تا اونجاش که فرصت کنیم که پیغمبر انتهای این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 733.01,
   "end": 739.07,
   "text": "بدجوری شیطان رو لعن میکنه و میفرماید خدا عذابت رو زیاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.07,
   "end": 741.95,
   "text": "خدا عذابتو زیاد کنه به این شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 741.95,
   "end": 744.97,
   "text": "چرا؟ وقتی که شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 744.97,
   "end": 750.93,
   "text": "گذر میکرد، گذرش میخوره به پیغمبر با هم صحبت میکنن، گفتگو میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 750.93,
   "end": 753.17,
   "text": "بعد شیخ-- پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 753.17,
   "end": 755.73,
   "text": "یه چند تا سؤال جوندار میپرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.73,
   "end": 759.91,
   "text": "میفرماید که تو چرا، چرا انقدر بدت میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.91,
   "end": 763.79,
   "text": "چرا منع میکنی؟ اول فرمود چرا منع میکنی از صدقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 763.79,
   "end": 767.59,
   "text": "چرا مانع خیریه؟ چرا مانع صدقه دیگران میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 767.59,
   "end": 770.53,
   "text": "گفت یا رسول الله ببینید زعم شیطان رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.53,
   "end": 776.53,
   "text": "دعوش رو. گفت یا رسول الله اگر اره بذارن رو سر من زنده زنده مثل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 776.53,
   "end": 779.79,
   "text": "مثل درخت چجوری دو نیمش میکنن با اره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.79,
   "end": 783.39,
   "text": "دو نیمم کنن آسون‌تره تا یه مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 783.39,
   "end": 786.61,
   "text": "در راه خدا صدقه بده، انفاق کنه، ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 786.61,
   "end": 788.89,
   "text": "انقدر برا من سخته. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 788.89,
   "end": 792.29,
   "text": "از اینجا معلوم میشه کار، کار چقدر، چقدر کار قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 792.29,
   "end": 798.95,
   "text": "بعد پیغمبر سؤالشو ادامه داد. فرمود خب تو چرا انقدر بدت میاد که مانع میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 798.95,
   "end": 804.01,
   "text": "شیطان گفت به جهت چند تا خصلت و خصوصیتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 804.01,
   "end": 808.69,
   "text": "در صدقه دادن هست. اینا رو دیگه من توضیح نمیدم سریع ازش رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 808.69,
   "end": 812.97,
   "text": "گفت پ-- شیطان گفت پنج تا خصوصیت در بخشش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 812.97,
   "end": 817.01,
   "text": "یک مال رو زیاد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 817.01,
   "end": 821.31,
   "text": "یعنی تاثیر عکس داره. ظاهراً داره از جبت میره اما مالت بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 821.31,
   "end": 822.91,
   "text": "دو مریض رو شفا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 822.91,
   "end": 825.77,
   "text": "اونایی که دنبال درمان مریضی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 825.77,
   "end": 829.41,
   "text": "صدقه. سه بلاها رو دفع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 829.41,
   "end": 831.95,
   "text": "کسایی که گرفتار بلا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 831.95,
   "end": 837.47,
   "text": "چهار به سرعت کسی که صدقه میده از پل صراط رد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 837.47,
   "end": 843.51,
   "text": "خب خیلی چیز خوبی دیگه. دیگه سوار بنز آخرین سیستم میشی با سرعت نور به سلامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 843.51,
   "end": 850.85,
   "text": "و پنجم فرمود بدون حساب الله اکبر، بدون حساب وارد بهشت میشه در حالی که عذاب نمیبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 850.85,
   "end": 855.97,
   "text": "اینجا رو که گفت این پنج تا رو که گفت پیغمبر فرمود خدا عذابتو زیاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 855.97,
   "end": 861.17,
   "text": "یعنی تو جلوی چه خیراتی رو بستی و داری میبندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 861.17,
   "end": 866.93,
   "text": "ببین توجه به این‌ها لعنی که پیغمبر کرده نشون میده چقدر این قصه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 866.93,
   "end": 875.03,
   "text": "عجیب روایتیه. این که میگن مؤمن دست میبره یه صدقه بده، یه درهم بخواد صدقه بده هفتاد تا شیطان دستش رو میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 875.03,
   "end": 878.79,
   "text": "هی اصرار میکنن نده، نده، نده، نده، نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 878.79,
   "end": 883.49,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 883.49,
   "end": 889.87,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}