   "title": "حدیث هفتم از باب چهارم کتاب الموت ادامه می‌یابد. مولای متقیان علیه‌السلام فرمودند:",
   "start": 43.06,
   "end": 78.4
  },
  {
   "index": 1,
   "title": "## مساق؛ مصدر میمی از سوق",
   "start": 78.4,
   "end": 98.62
  },
  {
   "index": 2,
   "title": "## کراهت اهل ایمان؛ متجر و مزرعه",
   "start": 98.62,
   "end": 128.24
  },
  {
   "index": 3,
   "title": "## جان دادن موسی و گریستن امام حسن",
   "start": 128.24,
   "end": 334.46
  },
  {
   "index": 4,
   "title": "## اهل عصیان و سخن ابن‌سینا",
   "start": 334.46,
   "end": 381.03
  },
  {
   "index": 5,
   "title": "اتفاقاً در آیات قرآن نیز همین آمده؛ در سورهٔ قیامت آیهٔ سی:",
   "start": 381.03,
   "end": 402.13
  },
  {
   "index": 6,
   "title": "و در آیهٔ هشت سورهٔ علق:",
   "start": 402.13,
   "end": 547.77
  },
  {
   "index": 7,
   "title": "## کراهت و توجه به بهشت",
   "start": 547.77,
   "end": 572.43
  },
  {
   "index": 8,
   "title": "## روایت ضعاف؛ چرا عزرائیل قابض الارواح شد",
   "start": 572.43,
   "end": 784.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 12.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.78,
   "end": 16.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.86,
   "end": 22.82,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 22.82,
   "end": 26.28,
   "text": "حدیث هفتم، باب چهارم، کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.28,
   "end": 32.42,
   "text": "عرض شد که مولامون فرمودند \"أيها الناس کل امرئ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.42,
   "end": 36.36,
   "text": "لاقٍ في فراره ما منه يفر.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.36,
   "end": 44.24,
   "text": "همه می‌رسن به اون چیزی که ازش فرار می‌کنند که اینجا منظور از این منطوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.24,
   "end": 47.58,
   "text": "مرگ و اجل است. \"والأجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.58,
   "end": 50.48,
   "text": "مساق النفس إليه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.48,
   "end": 60.52,
   "text": "چه تعبیر عجیبی که اجل و مرگ تعبیری که امیرالمؤمنین علیه‌السلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 60.52,
   "end": 64.68,
   "text": "امیر بیان اینجا فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 64.68,
   "end": 67.42,
   "text": "رانده شدن نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 67.42,
   "end": 72.44,
   "text": "به سوی مرگ. \"والهرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.44,
   "end": 78.4,
   "text": "منه موافقته.\" هرچی که ازش فرار می‌کنی بهش برخورد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 78.4,
   "end": 82.92,
   "text": "مساق که اینجا امیرالمؤمنین علیه‌السلام آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 82.92,
   "end": 86.2,
   "text": "مذكر میمی از سوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.2,
   "end": 90.9,
   "text": "به فتح سین. البته آقای قرائتی در تفسیر نورشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 90.9,
   "end": 94.52,
   "text": "می‌فرمایند يحتمل مفعولی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.52,
   "end": 97.3,
   "text": "یعنی معنای مفعولی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.3,
   "end": 100.34,
   "text": "اما در هر حال مذكر میمی رو همه گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.34,
   "end": 106.16,
   "text": "یعنی من کتاب‌هایی که لغت‌شناسی کردم و اینا دقت کردم همه می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.16,
   "end": 109.72,
   "text": "مذكر میمیه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.72,
   "end": 114.66,
   "text": "در اصطلاح راندن چهارپا و حیوان از مساق استفاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.66,
   "end": 117.06,
   "text": "راندن حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.06,
   "end": 120.72,
   "text": "یعنی خودش نمی‌خواد بره، او را می‌رانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.72,
   "end": 124.68,
   "text": "اینکه یکی هول بدن سوقش بدن به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.68,
   "end": 136.48,
   "text": "چه عجیب که مولامون اینجا فرمودند که معنایی که از اجل و مرگ کردن \"مساق النفس الیه، الیه\" این بر می‌گرده به اجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 136.48,
   "end": 139.42,
   "text": "یعنی راندن نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.42,
   "end": 144.34,
   "text": "به سمت مرگ. این نشون می‌ده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.34,
   "end": 146.68,
   "text": "غالباً این چنینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.68,
   "end": 149.04,
   "text": "کراهت دارند از موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.04,
   "end": 151.28,
   "text": "یعنی خیلی خوششون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.28,
   "end": 162.6,
   "text": "حالا اهل ایمان اگر بگیم اینو مطلق بگیریم، اهل ایمان این خوش نیامدن‌شون به جهت اینکه اینجا متهجر اولیاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 162.6,
   "end": 164.9,
   "text": "سوق المؤمن، سوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.9,
   "end": 167.22,
   "text": "یعنی بازار. بازارچه‌ی مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.22,
   "end": 171.6,
   "text": "اینجا داره تجارت می‌کنه. متهجر اولیاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 171.6,
   "end": 175.94,
   "text": "و اینجا از دنیا مزرعه until الآخره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.94,
   "end": 179.92,
   "text": "مزرعه مثل کس که مزرعه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 179.92,
   "end": 182.46,
   "text": "مثلاً یه حدیث پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.46,
   "end": 185.2,
   "text": "کسی که زمین داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.2,
   "end": 188.4,
   "text": "و فقیر باشه خودش رو شما تضامن کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.4,
   "end": 191.56,
   "text": "چه عجیب این زمین چون می‌تونه زراعت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.56,
   "end": 194.52,
   "text": "و روزیشو دربیاره. خب حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.52,
   "end": 197.74,
   "text": "این همه عمر به منزله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.74,
   "end": 203.3,
   "text": "زمین به من و شما بخشیده شد که درش بذر اعمال‌مون رو بکاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.3,
   "end": 205.86,
   "text": "خب این یک فرصتی‌ست عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.86,
   "end": 209.96,
   "text": "اگر برای اهل ایمان هم بگیریم این کراهت هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.96,
   "end": 214.82,
   "text": "یعنی مطلق بگیریم، می‌شه این چنین برداشت کرد که حالا اینا دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.82,
   "end": 219.98,
   "text": "حالا یه معنایی از نحوه‌ی جان دادن حضرت موسی یه روز براتون گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.98,
   "end": 224.98,
   "text": "گفتم به وقتش براتون میگم یه وجهش یعنی چی که چرا ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.98,
   "end": 230.98,
   "text": "به ملائکه فرمودند مثل پوست گوسفندی که زنده زنده پوستش رو بکنن من جان دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.98,
   "end": 235.2,
   "text": "خب نمی‌شه که عقلاً پیغمبر انقدر سخت جون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.2,
   "end": 240.9,
   "text": "وجهی که بزرگان گفتن، یه وجهش البته فرمودند می‌تونه این باشه که شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.9,
   "end": 243.64,
   "text": "علاقه‌ی انبیا به هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 243.64,
   "end": 247.52,
   "text": "خلائق باشه. چون دستشون به یک معنا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.52,
   "end": 250.36,
   "text": "هدایت خلق کوتاه می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.36,
   "end": 254.12,
   "text": "از رو شفقت و دلسوزی‌شون کار اون‌ها هدایت بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.12,
   "end": 258.28,
   "text": "اون‌ها مظهر اسم الهادی حضرت حق بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.28,
   "end": 261.2,
   "text": "از این جهت دلسوزانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.2,
   "end": 266.48,
   "text": "که دستشون از هدایت خلق کوتاه شده مثل یه پدری که دستشو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.48,
   "end": 269.28,
   "text": "مثلاً دستگیری از بچه ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.28,
   "end": 277.82,
   "text": "خب سختشه دیگه. مثلاً امام حسن مجتبی صلی الله علیه وقت شهادتشون گفتن چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.82,
   "end": 279.76,
   "text": "گریه می‌کنید؟ فرمود به دو جهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.76,
   "end": 284.16,
   "text": "یکی هول مطلع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.16,
   "end": 291.26,
   "text": "که در بعضی از روایات، روایات متلع به وزن مجلس متلع اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.26,
   "end": 293.34,
   "text": "اون اوج، اوج، اوج هول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.34,
   "end": 297.0,
   "text": "اون نوک مثل قله. نوک، نوک قله رو می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.0,
   "end": 300.8,
   "text": "مطلع یا متلع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.8,
   "end": 304.82,
   "text": "یکی هم فرمود فراق از اهدە،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.82,
   "end": 307.18,
   "text": "از نزدیکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.18,
   "end": 310.48,
   "text": "خب عاطفه داره انسان بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.48,
   "end": 316.82,
   "text": "اون‌ها هم حضرت موسی هم به جهت عاطفه‌ای که داشت برای هدایت خلق این چنین جون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.82,
   "end": 321.06,
   "text": "حالا به هر حال هر کسی باز این هم یه نوع کراهته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.06,
   "end": 324.16,
   "text": "می‌گه مثل گوسفند زنده زنده پوستشو بکنن من جون دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.16,
   "end": 327.46,
   "text": "یعنی یه نوع کراهته دیگه. از چه جهت کراهته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.46,
   "end": 329.2,
   "text": "از جهت هدایت خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.2,
   "end": 334.46,
   "text": "دوست داره بیشتر هدایت کنه. یا من و شما دوست داریم بیشتر زراعت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 334.46,
   "end": 338.7,
   "text": "اما خب برای اهل عصیان که دیگه مشخصه دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.7,
   "end": 340.7,
   "text": "هول دادن، راندن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 340.7,
   "end": 345.18,
   "text": "\"مساق النفس الیه\" به سمت مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.18,
   "end": 347.98,
   "text": "می‌تونه به جهت این باشه که اونا می‌دونن چی کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.98,
   "end": 353.22,
   "text": "به قول شیخ، شیخ الرئیس هر کسی از مرگ می‌ترسه از نفس خودش می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.22,
   "end": 357.5,
   "text": "می‌دونه چه غلطی کرده. از خودش می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.5,
   "end": 359.34,
   "text": "این حالا بحث اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.34,
   "end": 362.9,
   "text": "مساق. خیلی شیرین مولا فرموده رانده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.9,
   "end": 365.88,
   "text": "حالا این اتفاقاً دیدم توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.88,
   "end": 369.15,
   "text": "چه شیرین که در آیات قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.15,
   "end": 372.77,
   "text": "مثلاً در سوره قیامت آیه سی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.77,
   "end": 375.21,
   "text": "همین اومده مصاق اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.21,
   "end": 380.49,
   "text": "اونجا که می‌فرماید \"الا ربک يومئذ المصاق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.49,
   "end": 383.79,
   "text": "اون روز چه روزیه؟ يومئذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.79,
   "end": 386.33,
   "text": "اون روز چه روزیه؟ الا ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 386.33,
   "end": 390.61,
   "text": "به به به. يومئذ المصاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.61,
   "end": 395.59,
   "text": "یعنی مردم رو مطلقاً می‌رانن، هل می‌دن، می‌کشوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.59,
   "end": 398.03,
   "text": "به چه سمتی؟ الا ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.03,
   "end": 400.01,
   "text": "خطاب اینجا کیه؟ مخاطب کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.01,
   "end": 403.05,
   "text": "پیغمبره. ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.05,
   "end": 407.05,
   "text": "مثل، مثل که میگه ب-بس قل بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.05,
   "end": 411.23,
   "text": "یا مثلاً میگه بسم ربک الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 411.23,
   "end": 414.85,
   "text": "بسم ربک، پروردگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.85,
   "end": 418.67,
   "text": "یا مثلاً اگر عددها رو اشتباه نگفتم رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.67,
   "end": 423.15,
   "text": "آیه چهل و دو سوره نجم تو خاطرم مونده و ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.15,
   "end": 425.37,
   "text": "الى ربک المنتهى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.37,
   "end": 428.55,
   "text": "پیغمبر رب تو اون انتهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.55,
   "end": 432.37,
   "text": "چون رب پیغمبر الله بود دیگه عرض کردیم قبلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.37,
   "end": 436.97,
   "text": "رب دیگران مطلق نیست چون وجودشون ناقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.97,
   "end": 440.25,
   "text": "یه کانالی، یه جدولی از اون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.25,
   "end": 445.65,
   "text": "رب من و شما یکی از اسماء الهیه که در ما بیشتر از همه پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.65,
   "end": 449.91,
   "text": "اون می‌شه رب ما. سبحان ربی الاّ اعلی، سبحان ربی الاّ عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.91,
   "end": 453.61,
   "text": "رب خودمون رو می‌خونیم. جدولی‌ست که وصل به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.61,
   "end": 457.81,
   "text": "اما اینجا می‌فرماید همه رو دارن می‌کشونن، سوق می‌دن به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.81,
   "end": 461.27,
   "text": "اصلاً قیامت یه هولش به جهت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.27,
   "end": 465.03,
   "text": "اون هول مطلق. و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.03,
   "end": 468.73,
   "text": "باز آیه هشت سوره علق باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.73,
   "end": 474.65,
   "text": "ببینید رجوع کنید که اونجا و ان الى ربک المنتهى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.65,
   "end": 478.79,
   "text": "اینجا و ان الى ربک الرجع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.79,
   "end": 485.51,
   "text": "و ان الیه راجع. اون که میگی الرجع، رجعت همه، برگشت همه به سمت پروردگاره توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.51,
   "end": 489.05,
   "text": "یعنی این رب‌ها، ارباب در طول اون الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.05,
   "end": 491.47,
   "text": "چون الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.47,
   "end": 494.77,
   "text": "الله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.77,
   "end": 498.75,
   "text": "اون الله ربه و همه‌ی این جداول از او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.75,
   "end": 502.25,
   "text": "منتشر شدن. از، که از توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.25,
   "end": 510.89,
   "text": "روح من و شما وصلیم به اون روح کلی و اهدیّت نظام هستی، اون دریای لایتناهی وجود سمدی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.89,
   "end": 514.97,
   "text": "خب پس این عظمت حتی خوبان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.97,
   "end": 520.13,
   "text": "دقت بفرمایید جلالت و عظمت حضرت حق می‌گیرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.13,
   "end": 523.13,
   "text": "این هول خوبان به این جهته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.13,
   "end": 525.79,
   "text": "بالاخره عظمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.79,
   "end": 528.65,
   "text": "یعنی همینطوری نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.65,
   "end": 534.73,
   "text": "جبروت عالم مثلاً سلطنت امیرالمؤمنین عالم جبروت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.73,
   "end": 536.79,
   "text": "عالم عقول ملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.79,
   "end": 540.85,
   "text": "عقل اونجان. پس این تا اینجا که بدانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.85,
   "end": 544.69,
   "text": "با یک کراهتی مولا فرموده سوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.69,
   "end": 547.77,
   "text": "نفس هل می‌دن، سوق می‌دن، می‌کشونن سمت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.77,
   "end": 549.97,
   "text": "چرا؟ این کراهت دلیلش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.97,
   "end": 557.49,
   "text": "البته این کراهت رو معمولاً خب کسی اگر توجه به بهشت نداشته باشه معمولاً دچار این کراهت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.49,
   "end": 560.09,
   "text": "اینایی که فقط جهنم رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.09,
   "end": 563.33,
   "text": "خیلی‌ها از بهشت مثلاً خوفی‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.33,
   "end": 570.17,
   "text": "رجایی نیستند. و چه عجیب که البته این روایت که الان براتون عرض می‌کنم در خاتمه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.17,
   "end": 572.31,
   "text": "روایت خیلی قوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.31,
   "end": 577.95,
   "text": "یعنی در کتاب روایت رو رد نمی‌کنیم اما در کتاب‌های مرجع و جوامع روایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.95,
   "end": 585.83,
   "text": "خیلی قوی ما نیست. اما هست این روایت و خیلی هم وجوه متعددی می‌شه ازش برداشت کرد بازم باشه طلبتون یه وقتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 585.83,
   "end": 588.27,
   "text": "روایت خیلی عجیبه، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 588.27,
   "end": 590.27,
   "text": "روایت عجیبیه که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.27,
   "end": 593.01,
   "text": "حضرت عزرائیل اصلاً قابض الارواح شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 593.01,
   "end": 597.49,
   "text": "چرا عزرائیل، چرا جبرائیل و اسرافیل و میکائیل و اینا نشدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.49,
   "end": 600.39,
   "text": "برمی‌گرده به کراهت زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.39,
   "end": 605.65,
   "text": "از همین بحث معذب بودن چون نگاهش به جهنم افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.65,
   "end": 608.51,
   "text": "چگونه؟ خلاصه‌ش اینه بگم و تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.51,
   "end": 614.45,
   "text": "که خداوند به حضرت جبرائیل فرمود برو از زمین از این خاک زمین از چند ناحیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.45,
   "end": 617.61,
   "text": "خاک زمین بردار بیار. می‌خوام انسان رو خلق کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.61,
   "end": 619.25,
   "text": "رفت خاک رو برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.25,
   "end": 624.23,
   "text": "حضرت زمین الاَرض از حضرت جبرائیل پرسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.23,
   "end": 626.91,
   "text": "چرا خدا هدفش از خلقت آدم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.91,
   "end": 629.73,
   "text": "گفت برای اینکه تکلیفی براش مقرر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.73,
   "end": 633.07,
   "text": "و اگر تا-- اطاعت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 633.07,
   "end": 637.01,
   "text": "تا ابد در جوار رحمت خودش قرار بده انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.01,
   "end": 640.09,
   "text": "و اگر عصیان کرد تا ابد معذبش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 640.09,
   "end": 643.19,
   "text": "این معذبش کنه جهنم نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 643.19,
   "end": 647.63,
   "text": "جلوه کرد. یعنی برای حضرت زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.63,
   "end": 649.91,
   "text": "که محل حضور حقه دیگه اون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 649.91,
   "end": 652.45,
   "text": "می‌گیم حضرت. چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.45,
   "end": 657.39,
   "text": "ترسید. گفت نه، نه، نه من از، من از چون قراره ما از گل باشیم و خاک باشیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 657.39,
   "end": 659.61,
   "text": "جنس ما از خاک. این گفت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.61,
   "end": 663.03,
   "text": "کی؟ زمین، خاک. گفت من از آتش جهنم می‌ترسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.03,
   "end": 667.43,
   "text": "رها کن منو. قسمت میدم به عزت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.43,
   "end": 672.21,
   "text": "به قول ماها بی‌خیال ما شو. حضرت جبرائیل چون قسمش داد زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.21,
   "end": 674.05,
   "text": "اونایی که می‌گن چرا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.05,
   "end": 682.91,
   "text": "امتثال نکرد امر خدا رو چون قسم خیلی مهم-- حضرت آدم هم اگر اقوی شد به یک معنا چون قسمش، قسم خورد به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.91,
   "end": 684.61,
   "text": "و بعزتك لاَ اَقْوِي عَلَيْهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 684.61,
   "end": 686.31,
   "text": "به عزت خدا قسم خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 686.31,
   "end": 691.75,
   "text": "حضرت آدم باورش نمی‌شد کسی به عزت خدا قسم بخوره و دروغ بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 691.75,
   "end": 693.97,
   "text": "انقدر که پاک بود وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 693.97,
   "end": 697.55,
   "text": "خلاصه زمین قسم داد به حضرت جبرائیل، به عزت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 697.55,
   "end": 700.39,
   "text": "اونم رها کرد رفت. اسرافیل رو فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 700.39,
   "end": 703.15,
   "text": "همین اتفاق افتاد. عذر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.15,
   "end": 705.65,
   "text": "میکائیل رو فرستاد. همین اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 705.65,
   "end": 708.25,
   "text": "حضرت عزرائیل تشریف آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 708.25,
   "end": 712.23,
   "text": "چند مشت خاک از گوشه گوشه زمین برداشتن ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.23,
   "end": 714.89,
   "text": "زمین همین مهاجره رو باهاش انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 714.89,
   "end": 717.19,
   "text": "تو چی-- چیکار می‌کنی تو؟ قصه چیه اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 717.19,
   "end": 720.59,
   "text": "گفت اینطوریه و گفت اینو ایشون رو هم قسم داد زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 720.59,
   "end": 724.09,
   "text": "گفت به عزت خدا قسمet میدم من طاقت عذاب ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 724.09,
   "end": 728.49,
   "text": "منو نبر. و ایشون گفت امر امر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.49,
   "end": 730.73,
   "text": "حرکت کرد، خاک رو برد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 730.73,
   "end": 733.53,
   "text": "تحویل خدا داد. خدا فرمود چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.53,
   "end": 737.03,
   "text": "تو دلت نسوخت، یعنی به قول ما جیگرداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.03,
   "end": 744.05,
   "text": "دلت نسوخت و خاک رو آوردی به ناله زمین التماس زمین توجه نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 744.05,
   "end": 747.27,
   "text": "تو باید مامور قبض روح باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 747.27,
   "end": 753.35,
   "text": "بعد جالبه خدا میگه چون تویی که می‌تونی بچه رو از تو آغوش مادر بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 753.35,
   "end": 756.53,
   "text": "تویی که می‌تونی توجه نکنی به عاطفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 756.53,
   "end": 758.71,
   "text": "شوهر و زن و همسر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 758.71,
   "end": 761.57,
   "text": "برادر خواهر و می‌گیری، جون می‌گیری کاری نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 761.57,
   "end": 763.55,
   "text": "به قول حالا به یک معنا دل سنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 763.55,
   "end": 768.03,
   "text": "اینطوری شد که این بنده خدا به نامش افتاد قرعه‌ی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 768.03,
   "end": 771.99,
   "text": "قبض روح. یعنی می‌گیره اصلاً کاری نداره کی باشی، چی باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 771.99,
   "end": 774.55,
   "text": "انشاالله عاقبت همه ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 774.55,
   "end": 777.59,
   "text": "لحظه دیدار حضرت قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.59,
   "end": 779.73,
   "text": "انشاالله همه شیرین جون بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 779.73,
   "end": 784.49,
   "text": "صلوات ختم کنید. اللهuma Salli ala Muhammad",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}