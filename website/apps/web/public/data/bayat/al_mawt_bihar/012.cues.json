 "chapters": [
  {
   "index": 0,
   "title": "## میلاد نبی و پیوند با بحث موت",
   "start": 0.08,
   "end": 74.18
  },
  {
   "index": 1,
   "title": "## اشهد در تشهد؛ شهود توحید و رسالت",
   "start": 74.18,
   "end": 94.56
  },
  {
   "index": 2,
   "title": "## معنای عبد؛ راه کوبیده از کثرت تردد",
   "start": 94.56,
   "end": 238.88
  },
  {
   "index": 3,
   "title": "## نور دنیا و نور رب؛ أشرقت الأرض",
   "start": 238.88,
   "end": 329.18
  },
  {
   "index": 4,
   "title": "## دو شأن در یک حیات",
   "start": 329.18,
   "end": 573.56
  },
  {
   "index": 5,
   "title": "## خاموشی نسبی در برابر نور برتر",
   "start": 573.56,
   "end": 682.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 2.92,
   "text": "الصلاة على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.92,
   "end": 9.04,
   "text": "آله محمد. بسم الله الرحمن الرحيم وبه نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.04,
   "end": 13.76,
   "text": "السلام عليك يا داعي الله ورباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.76,
   "end": 16.32,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.32,
   "end": 20.4,
   "text": "تبریک عرض می‌کنم این ایام بسیار فرخنده و مبارک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.4,
   "end": 25.68,
   "text": "با عظمت رو. میلاد نبی اکرم اسلام و امام صادق رئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.68,
   "end": 27.26,
   "text": "مذهب رو به همه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.26,
   "end": 30.52,
   "text": "انشاالله عیدی‌های خوب و بزرگ بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.52,
   "end": 32.48,
   "text": "و صدر همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.48,
   "end": 36.8,
   "text": "عیدی‌ها انشاالله باز شدن گره فرج باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.8,
   "end": 43.26,
   "text": "خب در خصوص پیامبر عظیم الشأن اسلام برای اینکه مرتبط با بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.26,
   "end": 48.88,
   "text": "موت هم باشد یه مقدمه‌ای بشینم که ما هر روز در نماز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.88,
   "end": 53.16,
   "text": "مقام شهود، مقام شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.16,
   "end": 60.36,
   "text": "قبلاً پیرامونش سخ– صحبت کردیم، سخن گفتیم مقام علم فکری نیست، علم شهودی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.36,
   "end": 64.86,
   "text": "علم حصولی نیست. علمی نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.86,
   "end": 68.42,
   "text": "بری تحصیل کنی. چشیدن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.42,
   "end": 71.14,
   "text": "رسیدن است. دانا شدن نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.14,
   "end": 75.0,
   "text": "دارا شدن است. که ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.0,
   "end": 77.78,
   "text": "تشهد نمازمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.78,
   "end": 83.12,
   "text": "اقرار می‌کنیم که ما به مقام شهود رسیدیم که اشهد و این مقام شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.12,
   "end": 85.86,
   "text": "اشهد ان لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.86,
   "end": 90.88,
   "text": "یعنی یافتیم که هیچ الهی جز الله نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.88,
   "end": 93.88,
   "text": "و هرچی نگاه می‌کنیم اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.88,
   "end": 96.92,
   "text": "پیاده شده در نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.92,
   "end": 100.96,
   "text": "جلوات الله هست که اسم جامع است و همه اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.96,
   "end": 102.94,
   "text": "بعد می‌گیم که و اشهد ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.94,
   "end": 106.1,
   "text": "محمدا عبده و رسوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.1,
   "end": 109.3,
   "text": "صلى الله عليه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.3,
   "end": 111.72,
   "text": "الصلاة على محمد. این باز مقام شهود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.72,
   "end": 114.0,
   "text": "من شهادت می‌دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.0,
   "end": 116.38,
   "text": "این عبده همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.38,
   "end": 118.78,
   "text": "دقت بفرمایید می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 118.78,
   "end": 121.84,
   "text": "لا اله الا الله وحده لا شريك له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.84,
   "end": 127.14,
   "text": "همونطور که قبلاً عرض کردیم هیچ شرک– شرکت، شراکت برداری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.14,
   "end": 131.08,
   "text": "شریکی نداره. الهیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.08,
   "end": 133.32,
   "text": "همونطور چون بعد می‌گیم عبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.32,
   "end": 136.12,
   "text": "هو. این ضمیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.12,
   "end": 138.34,
   "text": "هو برمی‌گرده به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.34,
   "end": 140.44,
   "text": "عبد کیه؟ الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.44,
   "end": 147.22,
   "text": "الله لا شريك له. لذا بزرگان فرمودن که پس پیغمبر عظیم الشأن اسلام هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.22,
   "end": 151.38,
   "text": "ابا، اون عبودیت و رسالتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.38,
   "end": 153.34,
   "text": "بی‌شریک، لا شریک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 153.34,
   "end": 156.34,
   "text": "اهدی شراکت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 156.34,
   "end": 158.54,
   "text": "یعنی یکتاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 158.54,
   "end": 163.16,
   "text": "پیغمبر هم در عبودیت و رسالتش یکتاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 163.16,
   "end": 167.76,
   "text": "یعنی اونچه که پیغمبر داشت بالعصاله بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 167.76,
   "end": 173.28,
   "text": "و همه رو از خدای منان بی‌واسطه اخذ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 173.28,
   "end": 181.16,
   "text": "بقیه بدون استثناء از انبیا بگیر تا حتی ائمه‌ی ما امیرالمؤمنین تا امام عصر همه و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.16,
   "end": 183.06,
   "text": "بالعصاله نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.06,
   "end": 185.42,
   "text": "بطبع پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.42,
   "end": 188.74,
   "text": "یعنی اون‌ها دنبال رو پیغمبرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.74,
   "end": 193.64,
   "text": "همه و همه از پیغمبر به وساطت پیغمبر اخذ کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.64,
   "end": 195.88,
   "text": "این مقام ختمی‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.88,
   "end": 199.58,
   "text": "یک معنای ختمی نه یعنی تمام شدن ختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.58,
   "end": 201.8,
   "text": "لذا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 201.8,
   "end": 206.3,
   "text": "فرمودن که پیغمبر همه چی تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 206.3,
   "end": 211.44,
   "text": "لذا اینجا که می‌رسیم می‌بینیم امیرالمؤمنین چرا می‌فرمود منم عبدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.44,
   "end": 218.68,
   "text": "از بندگان کوچیک او یا بندگان به شدت بنده‌ی اون هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.68,
   "end": 220.48,
   "text": "عبد من عبیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.48,
   "end": 223.52,
   "text": "این عبید به شدت بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 223.52,
   "end": 225.52,
   "text": "حالا این در عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 225.52,
   "end": 228.38,
   "text": "پیغمبر بی‌شریکه این رو عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 228.38,
   "end": 231.3,
   "text": "که اصلاً عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 231.3,
   "end": 234.3,
   "text": "یا بهتره بگیم عبدیت از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.3,
   "end": 236.18,
   "text": "مقام عبد رو باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 236.18,
   "end": 241.44,
   "text": "عبد قبلاً هم عرض کردیم وقتی که تو عرب میگن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 241.44,
   "end": 246.6,
   "text": "راهی که میفته مثلاً یه کسی تردد زیاد می‌کنه از یک جا به یک جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 246.6,
   "end": 250.12,
   "text": "اون راهی که میفته نمی‌دونم جاهایی دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.12,
   "end": 254.02,
   "text": "در اثر کثرت تردد یه جاده‌ای درست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 254.02,
   "end": 256.68,
   "text": "یه راهی مشخص شده بین مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 256.68,
   "end": 259.88,
   "text": "علف‌ها، گل‌ها این‌ها یا تو جاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 259.88,
   "end": 264.66,
   "text": "اون راهی که نمایان شده بر اثر کثرت تردد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 264.66,
   "end": 266.64,
   "text": "در عرب بهش میگن عبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 266.64,
   "end": 270.78,
   "text": "اون، اون جا رو. یعنی به قدری پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 270.78,
   "end": 279.34,
   "text": "تردد داشت یعنی پیغمبر از عالم انقدر رفت و آمد داشت با ملکوت و انقدر ارتباط با خدا داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 279.34,
   "end": 282.16,
   "text": "که عبد محض بل– بلکه عبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 282.16,
   "end": 286.14,
   "text": "هو. چون می‌گیم عبد هو دیگه و رسول هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 286.14,
   "end": 289.96,
   "text": "عبد الهو گفتن فقط پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 289.96,
   "end": 295.14,
   "text": "اوست که البته همه اهل بیت ما علیهم الصلاة و السلام مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 295.14,
   "end": 298.98,
   "text": "جامع و اتم اسم الله که اسم جامع است هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 298.98,
   "end": 301.18,
   "text": "یعنی همه اسم‌ها در اون‌ها پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.18,
   "end": 303.58,
   "text": "اما عبد الهو که قبل از الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 303.58,
   "end": 306.38,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 306.38,
   "end": 310.22,
   "text": "هو قبل از الله. عبد الهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 310.22,
   "end": 312.86,
   "text": "مقام پیغمبره. یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 312.86,
   "end": 317.34,
   "text": "هر نش-- اینطوری بگیم هر نشانه‌ای از خدا می‌خوای در اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 317.34,
   "end": 321.0,
   "text": "و این نشانه‌ها رم در امیرالمؤمنین به توسط او پیاده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 321.0,
   "end": 323.92,
   "text": "یعنی ما بالاتر از پیغمبر در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 323.92,
   "end": 326.96,
   "text": "نداریم که این نشانه‌ها همه به اهل بی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 326.96,
   "end": 330.74,
   "text": "به ارث رسید من جمله امام صادق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 330.74,
   "end": 333.68,
   "text": "والآثار الجعفریة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 333.68,
   "end": 338.38,
   "text": "در صلوات خواجه نصیر هست که اینا همینطوری یک یک رسید تا امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 338.38,
   "end": 340.26,
   "text": "یعنی اون آثار میگن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 340.26,
   "end": 344.38,
   "text": "اثر هر کسی پی به مب-- مؤثر ببر ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 344.38,
   "end": 347.76,
   "text": "از اثر هر کسی پی به دارایی مس-- مو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 347.76,
   "end": 351.64,
   "text": "مؤثر ببر. والآثار الجعفریة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 351.64,
   "end": 354.58,
   "text": "آثار پیغمبر جمع شده تو حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 354.58,
   "end": 360.72,
   "text": "امام صادق. ببینید پیغمبر کیه که اثر وجودیش می‌شه امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 360.72,
   "end": 364.02,
   "text": "رئیس مذهب که هرچی ما داریم از اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 364.02,
   "end": 368.86,
   "text": "حالا بحث ما اینو الصاقش کنیم سنجاقش کنیم با این حدیث و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 368.86,
   "end": 372.9,
   "text": "وقتی رسیدیم به اینجایی که ما دیروز عرض کردیم که آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 372.9,
   "end": 377.44,
   "text": "اینجا حدیث میفرماید سار الانسان يأكل ويشرب بالنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.44,
   "end": 380.84,
   "text": "می‌خوره و می‌آشامه با آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 380.84,
   "end": 383.38,
   "text": "و يبصر ويعمل بالنور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.38,
   "end": 385.94,
   "text": "میبینه و عمل میکنه به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 385.94,
   "end": 390.92,
   "text": "يسمع ويشم بالريح با باد میشنوه و میبویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.92,
   "end": 393.54,
   "text": "يجد الطعام والشراب بالماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 393.54,
   "end": 396.82,
   "text": "اینها وقتی گفتیم با آب، با آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 396.82,
   "end": 402.94,
   "text": "می‌آشامد و می‌خورد وجه باطنی و ظاهریش رو که گفتیم برای بعضیا سنگین اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.94,
   "end": 405.8,
   "text": "یعنی چی این حرفا؟ مثلا ما بحث حرارت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.8,
   "end": 409.26,
   "text": "گفتیم حرارت عشق امام حسین یک وجه باطنی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 409.26,
   "end": 411.84,
   "text": "اینجا گفتیم چی؟ غذا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 411.84,
   "end": 413.82,
   "text": "آب و غذا با حرارت پخته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 413.82,
   "end": 417.46,
   "text": "این ظاهره‌شه. بحث مثلا پزشکیشه، علمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 417.46,
   "end": 420.06,
   "text": "اما باطن‌شو یه وجهشو گفتیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 420.06,
   "end": 422.1,
   "text": "حرارت عشق امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 422.1,
   "end": 426.06,
   "text": "می‌پزه آدما رو پخته می‌کنه، اعمالشون رو پخته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 426.06,
   "end": 429.5,
   "text": "بعضیا براشون این سنگین اومد. از کجا این حاجی اینو آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 429.5,
   "end": 432.32,
   "text": "سوالم شد. اتفاقا جواب تو خود حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 432.32,
   "end": 435.86,
   "text": "جوابو بهتون، دقت به جواب بدم این تو خود حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 435.86,
   "end": 443.62,
   "text": "بعد بسه برای امروز. که میفرماید همینجوری که ادامه میده از طبیعات می‌گذره به بحث موت میرسه امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 443.62,
   "end": 446.28,
   "text": "میفرماید فهاکذا الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 446.28,
   "end": 450.22,
   "text": "خلق من شأن الدنيا وشأن الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 450.22,
   "end": 455.94,
   "text": "انسان که خلق شده شأنی از آخرت دارد و شأنی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 455.94,
   "end": 461.6,
   "text": "دنیا که بعد فرمود فإذا جمع الله بينما صارت حياته في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 461.6,
   "end": 469.7,
   "text": "وقتی این دو تا با هم جمع شد یعنی شأن آخرتی و شأن دنیایی با هم جمع شد، حیاتش تو دنیا آغاز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 469.7,
   "end": 474.14,
   "text": "یعنی ما فارغ از باطن و حیات اخروی مطلقا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 474.14,
   "end": 477.96,
   "text": "جدا نیستیم. یکپارچه ایم کشیده شده از ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.96,
   "end": 480.48,
   "text": "یا به عبارتی از ملکوت به ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.48,
   "end": 483.8,
   "text": "وقتی بحث می‌کنی از هر چیزی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.8,
   "end": 488.6,
   "text": "مسائل حتی علمی و تجربی می‌بینیم که یه شاخه‌ش به ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 488.6,
   "end": 496.74,
   "text": "یعنی اینجا اگر امام صادق صلی الله علیه فرمود جمع‌بندی وقتی فرموده انسان می‌خورد با حرارت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 496.74,
   "end": 502.42,
   "text": "می‌آشامد با حرارت یعنی خوردن و آشامیدنش با حرارت پخته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 502.42,
   "end": 504.76,
   "text": "خب این یه وجه چی شه؟ شأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.76,
   "end": 507.32,
   "text": "دنیاییشه. شأن آخرتیش کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 507.32,
   "end": 509.62,
   "text": "یا امام صادق شأن آخرتیش کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 509.62,
   "end": 512.5,
   "text": "خب به شاگردان اخسش فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 512.5,
   "end": 515.58,
   "text": "اومده تو وجود القا، تلقین کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 515.58,
   "end": 520.94,
   "text": "اولیاء الله و کما و عرفاء امثال Allameh Hassan Zadeh ها و اونها هم این شأنو برای ما باز کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 520.94,
   "end": 525.02,
   "text": "فرمودن یک شأنش اون حرارت، حرارت عشقه، حرارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 525.02,
   "end": 527.3,
   "text": "ولایته، حرارت محبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 527.3,
   "end": 531.4,
   "text": "می‌خوام بگم تو خود حدیث هست که یک شأن از دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.4,
   "end": 533.42,
   "text": "یک شأن از آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 533.42,
   "end": 535.16,
   "text": "چرا ما شأن آخرتیشو میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 535.16,
   "end": 541.06,
   "text": "میگیم اینجا اگر پیغمبر فرموده می‌بینیم امام صادق فرموده می‌بینیم و می‌شنویم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 541.06,
   "end": 544.02,
   "text": "نور، این نورو فقط دنیایی فرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 544.02,
   "end": 546.38,
   "text": "نور آخرتی فرض نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.38,
   "end": 549.8,
   "text": "چرا توجه به اون آیه نمی‌کنیم که و أشرقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.8,
   "end": 552.54,
   "text": "الأرض بنور ربها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.54,
   "end": 555.82,
   "text": "یه روزی که اون روزی که یئمت بدل الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 555.82,
   "end": 557.74,
   "text": "بغير الأرض زمین اب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 557.74,
   "end": 560.14,
   "text": "بدل میشه به یه زمین جدیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 560.14,
   "end": 566.54,
   "text": "أشرقت الأرض بنور ربها به نور پروردگارش این أرض، زمین روشن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 566.54,
   "end": 569.28,
   "text": "یعنی یه خورشید جدیدی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 569.28,
   "end": 571.32,
   "text": "یعنی این خورشید خاموش میشه؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 571.32,
   "end": 573.56,
   "text": "این خورشید ابدیه، خاموش نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 573.56,
   "end": 577.74,
   "text": "تأویل إذا الشمس كورت هم قبلاً گفتیم یعنی چی خاموش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 577.74,
   "end": 582.62,
   "text": "مثل اینکه خورشید ولایت بیاد تو دیگه اصلاً توجه به این خورشید نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 582.62,
   "end": 585.2,
   "text": "آقا چرا از حضرت ام کلثوم اونقدر حرف کم هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 585.2,
   "end": 591.26,
   "text": "چون خورشید حضرت زینب کاری کرد که دیگه ماه بودن حضرت ام کلثوم دیگه خیلی دیده نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 591.26,
   "end": 599.0,
   "text": "اینطوریه. تو وقتی میری کنار حضرت سلطان علی ابن موسی الرضا خیلی توجهت به اون بزرگانی که کنارش دفنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 599.0,
   "end": 606.92,
   "text": "نیست. اما اگر همون آین‌الخدکی اصفهانی یک جای دیگه‌ای جز حرم دفن شده بود، یه گنبد و بارگاه براش می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.92,
   "end": 615.04,
   "text": "این یعنی خاموش شدن. اون أشرقت الأرض بنور ربها بارها عرض کردیم منhu حاجی سبزواری علیه الرحمه در اسرارالحکمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 615.04,
   "end": 617.7,
   "text": "می‌فرمود ای به نور امام‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 617.7,
   "end": 620.62,
   "text": "یعنی به نور امام، به نور امام روشن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.62,
   "end": 623.68,
   "text": "این نور چیه؟ باطنیه. وجه باطنی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 623.68,
   "end": 626.42,
   "text": "پس اصلاً این دو از هم جدا نیست، نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.42,
   "end": 628.88,
   "text": "شما می‌تو-- چرا پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.88,
   "end": 632.86,
   "text": "تو این سؤال بحثم رو جمع کنم دقت کنید به انگشتای منو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.86,
   "end": 635.66,
   "text": "این دو تا انگشت اشاره رو پیغمبر به هم چسبوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 635.66,
   "end": 638.04,
   "text": "فرمود أنا والقيامة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 638.04,
   "end": 640.72,
   "text": "أنا والقيامة كهاتين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 640.72,
   "end": 644.02,
   "text": "مثل این دو تا این. چسبوند این دو تا، این دو تا رو به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 644.02,
   "end": 646.34,
   "text": "یعنی اصلاً یک حقیقтим. اصلاً من قیامتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 646.34,
   "end": 648.94,
   "text": "کسی به من رسید قیامتش به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 648.94,
   "end": 652.84,
   "text": "کسی رسید محضر علی ابن موسی الرضا رفت حرم قیامتش به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 652.84,
   "end": 654.54,
   "text": "یعنی می‌شناسه خودش رو می‌تونه بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 654.54,
   "end": 658.96,
   "text": "البته ارتباط تو، بُعد و قرب تو با امام معصوم چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 658.96,
   "end": 660.96,
   "text": "این قیامت تو رو داره نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 660.96,
   "end": 666.04,
   "text": "اصلاً حقیقت شأن آخرت و دنیا همگام با ما در ما جمعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 666.04,
   "end": 671.18,
   "text": "توجه داشته باشیم که غافل از اون حقیقت ملکوتی خودمون مطلقا نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 671.18,
   "end": 673.44,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 673.44,
   "end": 676.52,
   "text": "و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 676.52,
   "end": 682.58,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}