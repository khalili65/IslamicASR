   "start": 19.26,
   "end": 109.38
  },
  {
   "index": 1,
   "title": "## هبوط ملک‌الموت و خبر خوش",
   "start": 109.38,
   "end": 310.76
  },
  {
   "index": 2,
   "title": "## سؤال ابراهیم؛ فهل رأیت خلیلاً یمیت خلیله",
   "start": 310.76,
   "end": 372.53
  },
  {
   "index": 3,
   "title": "## فرجع ملک‌الموت حتی وقف بین یدی الله",
   "start": 372.53,
   "end": 499.51
  },
  {
   "index": 4,
   "title": "## تجرد؛ حرکت از ظاهر به باطن نه مسافت",
   "start": 499.51,
   "end": 587.99
  },
  {
   "index": 5,
   "title": "## عزرائیل خود مرگ را می‌چشد",
   "start": 587.99,
   "end": 717.53
  },
  {
   "index": 6,
   "title": "## فبصر الیوم حدید؛ باطن همین‌جاست",
   "start": 717.53,
   "end": 817.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.9,
   "end": 17.34,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 17.34,
   "end": 20.66,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 20.66,
   "end": 24.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 24.54,
   "end": 30.22,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 30.22,
   "end": 32.46,
   "text": "بریم سراغ روایت هشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.46,
   "end": 35.94,
   "text": "از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.94,
   "end": 44.58,
   "text": "امام صادق صلوات الله علیه از پدرانشون همینطور سلسله‌وار تا از امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.58,
   "end": 47.4,
   "text": "علیه الصلاة والسلام این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.4,
   "end": 49.98,
   "text": "روایت رو فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.98,
   "end": 54.6,
   "text": "لما اراد الله تبارک و تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.6,
   "end": 56.66,
   "text": "قبل روح ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.66,
   "end": 59.76,
   "text": "سلام الله علیه. وقتی که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.76,
   "end": 65.26,
   "text": "اراده کرد قبض روح حضرت ابراهیم رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.26,
   "end": 73.62,
   "text": "خلیل الرحمن رو که از میان انبیا به مقام امامت هم رسیده بود دیگه ایشون مقام خیلی بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.62,
   "end": 82.2,
   "text": "که پیغمبر عظیم الشأن اسلام فرمودن هر کدوم از انبیا رو اسم بردید اول به من و آلم سلام بدید بعد به اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 82.2,
   "end": 86.82,
   "text": "مثلا بگید علی نبینا و آله و علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.82,
   "end": 91.8,
   "text": "تنها حضرت ابراهیم رو که اسم بردید اول به او سلام بدید بعد به من و آلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 91.8,
   "end": 97.56,
   "text": "نشان‌دهنده مرتبت و مقام و شان والای حضرت ابراهیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 97.56,
   "end": 101.04,
   "text": "که پدر پیغمبر حساب می‌شه به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 101.04,
   "end": 104.62,
   "text": "در حقیقت. پس مثلا میگه حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 104.62,
   "end": 109.38,
   "text": "علیه السلام و علی نبینا و آله برعکس انبیا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.38,
   "end": 113.62,
   "text": "اینجا وقتی خدای منان، امیرالمؤمنین می‌فرماید وقتی خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 113.62,
   "end": 119.62,
   "text": "خدای تبارک و تعالی اراده‌ی قبض روح ایشون رو کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 119.62,
   "end": 124.66,
   "text": "اهبط الله ملک المل ملک الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 124.66,
   "end": 129.3,
   "text": "ملک الموت قابض الارواح هبوط کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 129.3,
   "end": 134.06,
   "text": "خدا اون رو نازل کرد به اصل اهبط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 134.06,
   "end": 140.18,
   "text": "اهبط الله ملک الموت فقال السلام علیک یا ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.18,
   "end": 145.64,
   "text": "سلام کرد به حضرت ابراهیم و قال علیک السلام یا ملک الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 145.64,
   "end": 153.06,
   "text": "جالبه که همون فرشته‌ای که حضرت ابراهیم رو قبض روح کرده همون میاد سراغ ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 153.06,
   "end": 159.02,
   "text": "یعنی ببین چه کسایی رو، چه بزرگوارانی رو دیده و قبض کرده و حالا می‌خواد سراغ ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 159.02,
   "end": 167.22,
   "text": "بن بیچاره بیاد. حالا حضرت ابراهیم بعد از اینکه جواب سلام ایشون رو میده می‌پرسه که اداع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 167.22,
   "end": 170.9,
   "text": "ام ناع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 170.9,
   "end": 173.62,
   "text": "اداع ام ناع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 173.62,
   "end": 177.0,
   "text": "یعنی خبر خوش داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 177.0,
   "end": 178.96,
   "text": "اداع ام ناع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 178.96,
   "end": 183.68,
   "text": "ناع به خبر بد ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 183.68,
   "end": 185.98,
   "text": "اهل لغت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 185.98,
   "end": 189.58,
   "text": "نام بردن. گفتن که معنای خبر بد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 189.58,
   "end": 196.94,
   "text": "یعنی خبر ناخوش. خبر خوش داری یا خبر بد داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 196.94,
   "end": 200.94,
   "text": "حضرت عزرائیل فرمودند که قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 200.94,
   "end": 204.12,
   "text": "بلى داع یا ابراهیم فاجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 204.12,
   "end": 208.18,
   "text": "خبر خوش دارم پس اجابت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 208.18,
   "end": 212.4,
   "text": "قال ابراهیم. حالا این خبر خوش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.4,
   "end": 214.28,
   "text": "حضرت ابراهیم درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 214.28,
   "end": 218.92,
   "text": "منظور از خبر خوشی که قابض الارواح بیاره چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.92,
   "end": 222.56,
   "text": "چون اون در دایره کار خودش خبر میاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.56,
   "end": 224.8,
   "text": "اون مسئول و متوکل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 224.8,
   "end": 226.98,
   "text": "قبض، قبض، قابض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 226.98,
   "end": 230.0,
   "text": "اسم قابض حضرت حق رو او مجری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.0,
   "end": 234.36,
   "text": "قبض می‌کنه. ق-قبلاً هم ما عرض کردیم هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.36,
   "end": 237.72,
   "text": "سیری از مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.72,
   "end": 240.96,
   "text": "مادون به مافوق توسط این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.96,
   "end": 243.66,
   "text": "مثلا ما از مرتبه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.66,
   "end": 247.68,
   "text": "که مثلا رحم مادر بود، رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.68,
   "end": 254.16,
   "text": "پربرکت و پاک مادر بوده اومدیم به نشئه مافوق که دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.16,
   "end": 258.48,
   "text": "اونجا على الارض بود اینجا من السماء برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.48,
   "end": 260.64,
   "text": "و في السماء رزقكم وما توعدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.64,
   "end": 268.64,
   "text": "بچه هم رزقش رو از مافوق که سماءش بود یعنی این نشئه طبیعت که غذایی که مادر می‌خورد می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 268.64,
   "end": 270.66,
   "text": "اینجا می‌شه مافوق اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.66,
   "end": 272.8,
   "text": "دونه. رحم دون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.8,
   "end": 277.06,
   "text": "اونجا وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 277.06,
   "end": 281.8,
   "text": "بچه می‌خواد از رحم وارد دنیا بشه باز کار، کار قابض الارواحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.8,
   "end": 285.02,
   "text": "اون رتبه وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.02,
   "end": 288.44,
   "text": "همه ما رو اونجا ایشون قبض کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.44,
   "end": 292.0,
   "text": "و اثبات کرد ما رو در این نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.0,
   "end": 295.78,
   "text": "همچنین در هر عالمی ما سیر کنیم کار، کار اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.78,
   "end": 298.12,
   "text": "یعنی ما تا ابد با ایشون کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.12,
   "end": 300.92,
   "text": "هر ارتقاء وجودی رخ بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.92,
   "end": 303.76,
   "text": "کار ایشونه. قدرت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.76,
   "end": 306.62,
   "text": "در بال و پر ایشون جلوه کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.62,
   "end": 312.74,
   "text": "دیگه دیروز عرض کردیم. خب حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.74,
   "end": 318.44,
   "text": "قابض الارواح وقتی گفت من خبر خوش دارم اجابت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.44,
   "end": 320.4,
   "text": "حضرت ابراهیم همچنین ادامه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.4,
   "end": 324.32,
   "text": "قال ابراهیم فهل رأیت خلیلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.32,
   "end": 330.16,
   "text": "یمیت خلیله. عزرائیل سوالی ازت دارم آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.16,
   "end": 335.0,
   "text": "دیدی که دوستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.0,
   "end": 337.22,
   "text": "مرگ دوستش رو بخواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.22,
   "end": 340.62,
   "text": "یعنی راضی باشه به مرگ دوستش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.62,
   "end": 345.08,
   "text": "یعنی کنه یک سوالی داره از خدا می‌پرسه که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.08,
   "end": 347.68,
   "text": "به خدا مثلا تو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.68,
   "end": 351.78,
   "text": "وکیل خدایی، تو که از طرف خدا اومدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.78,
   "end": 353.78,
   "text": "این سؤال وجودی منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.78,
   "end": 358.02,
   "text": "طلب وجودی من از حضرت حقه که چگونه می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.02,
   "end": 361.94,
   "text": "دوستی به م-مرگ دوستش راضی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.94,
   "end": 365.85,
   "text": "سؤال خیلی زیباست و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.85,
   "end": 371.31,
   "text": "حرف‌های خیلی کلانی هم میشه اینجا پیاده کرد از حوصله بحث خارجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.31,
   "end": 374.35,
   "text": "فعلاً طلبتون. \"قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.35,
   "end": 378.01,
   "text": "فرجع ملك الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.01,
   "end": 380.55,
   "text": "حتى وقف بین یدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.55,
   "end": 384.43,
   "text": "الله جل جلاله.\" حضرت قابض الارواح برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.43,
   "end": 387.29,
   "text": "این فرجع نشان دهنده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.29,
   "end": 390.39,
   "text": "وقتی ایشون حرف نزد، سکوت کرد، برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.39,
   "end": 393.21,
   "text": "اینجا نشان دهنده تهیور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.21,
   "end": 400.99,
   "text": "قابض الارواحه. یعنی در جواب سؤال حضرت ابراهیم ایشون موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.99,
   "end": 406.39,
   "text": "نتونست جواب بده. نشون میده که سؤال، سؤال دقیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.39,
   "end": 408.77,
   "text": "که یه همچین شخصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.77,
   "end": 411.65,
   "text": "که ظهور اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.65,
   "end": 414.35,
   "text": "القدیر و قدرت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 414.35,
   "end": 418.83,
   "text": "حق در جوابش مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.83,
   "end": 421.85,
   "text": "به قول ما من و من کرده برگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.85,
   "end": 426.93,
   "text": "حالا مخصوصاً اینجا تصریح بر این موضوعه که تا کجا رفت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.93,
   "end": 429.59,
   "text": "جبرائیل-- عزرائیل تا کجا برگشت رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.59,
   "end": 432.11,
   "text": "حتی تا کجا؟ وقف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.11,
   "end": 436.11,
   "text": "ایستاد بین یدی الله جل جلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.11,
   "end": 442.99,
   "text": "یدی یا باسط الیدین بالعطیه که میگن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.99,
   "end": 448.73,
   "text": "یدی بین دو دست یعنی بین جمال و جلال حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.73,
   "end": 451.59,
   "text": "اینجا خیلی حرف‌ها میشه زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.59,
   "end": 457.57,
   "text": "که سؤال انقدر سؤال حساسیه اونم توسط شخص بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.57,
   "end": 463.95,
   "text": "باکرامتیه. این ملک با اون عظمت چنان به مقام حیرت افتاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.95,
   "end": 468.57,
   "text": "میره دیگه انقدر به خدا نزدیک میشه بین یدی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.57,
   "end": 475.83,
   "text": "اینجا رو میشه به یک معنا به جهت سهولت فهم آغوش حق هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.83,
   "end": 479.15,
   "text": "تفسیر کرد، یدی الله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 479.15,
   "end": 485.65,
   "text": "آغوش حق. یعنی دیگه میره در مرتبه‌ای قرار می‌گیره که هم جمال حق است هم جلال حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.65,
   "end": 489.21,
   "text": "دیگه مقام قرب خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.21,
   "end": 499.51,
   "text": "بالایی‌ست اینجا. مثل اینکه دیگه انقدر تهیور این ملک زیاد شده میره تا اونجایی که بتونه حالا تا این حد شما تصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 499.51,
   "end": 502.19,
   "text": "البته این رو هم توجه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.19,
   "end": 505.71,
   "text": "بحثی که در خصوص تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.71,
   "end": 511.51,
   "text": "عالم مافوق به خصوص ملائکه و قابض الارواح کردیم ذهنتون باشه دیگه تجرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 511.51,
   "end": 515.23,
   "text": "دیگه بحث مادی نیست که شما بگید حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 515.23,
   "end": 518.81,
   "text": "عزرائیل از اینجا مثلاً از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 518.81,
   "end": 520.63,
   "text": "محل رفت به اون محل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 520.63,
   "end": 524.61,
   "text": "این بحث مادی نیست. این حرکت ارجاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.61,
   "end": 528.45,
   "text": "رفت و برگشت میشه به یک معنا گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 528.45,
   "end": 530.55,
   "text": "حرکت از ظاهر به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 530.55,
   "end": 534.93,
   "text": "اصلاً درستشم همینه. از حرکت از ظاهر عالم به باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 534.93,
   "end": 538.27,
   "text": "از ملک به ملکوت. یعنی مثل اینکه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.27,
   "end": 540.59,
   "text": "عزرائیل همین جاست الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 540.59,
   "end": 543.25,
   "text": "اما توجهش میفته به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 543.25,
   "end": 547.07,
   "text": "این رو توجه کنید که خیلی نکته مهمیه فهمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.07,
   "end": 553.71,
   "text": "این رفت و آمد چون اونجا مجرده دیگه ماده نیست که بگیم از اینجا تا اونجا مسافتی متری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.71,
   "end": 556.71,
   "text": "کیلومتری رو طی کرد. زمانی برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.71,
   "end": 560.49,
   "text": "مکانی رو. نفس همچیز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.49,
   "end": 563.81,
   "text": "حضرت حق از صمد است و هر جا برود او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.81,
   "end": 567.03,
   "text": "تجلی ظهور قدرت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 567.03,
   "end": 569.61,
   "text": "قدرتشم تجلی کرده در خود این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 569.61,
   "end": 573.25,
   "text": "قابض الارواح. از ظاهر عالم به باطن رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.25,
   "end": 577.35,
   "text": "یکی از معانی موت اصلاً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.35,
   "end": 581.21,
   "text": "ببینید حالا می‌ترسم بحثایی رو باز کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.21,
   "end": 583.71,
   "text": "الانم فرصت نیست نتونیم جمعش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.71,
   "end": 587.41,
   "text": "خیلی تذکرن، خیلی تذکران عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.41,
   "end": 592.37,
   "text": "که مثل اینکه شما یه چیزی رو از کسی تقاضا کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 592.37,
   "end": 595.37,
   "text": "بعد اون شخص برای اینکه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.37,
   "end": 599.47,
   "text": "تقاضای شما رو امتحان کنه ببینه چجوریه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.47,
   "end": 603.55,
   "text": "آیا واقعاً اینطوریه یا نه، بره یه بار اون کارو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.55,
   "end": 605.77,
   "text": "حضرت ابراهیم چی سؤال کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.77,
   "end": 610.49,
   "text": "چگونه خلی-- دوستی مرگ دوستش رو طلب میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 610.49,
   "end": 613.33,
   "text": "حضرت عزرائیل چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.33,
   "end": 616.45,
   "text": "رفته تا مقام جمال و جلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.45,
   "end": 618.99,
   "text": "بین یدی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 618.99,
   "end": 624.73,
   "text": "تا اون مقام بالای بالا. که ما گفتیم این توجه به اونجاست نه حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.73,
   "end": 629.65,
   "text": "خب؟ این توجه به اونجا معنیش یعنی موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 629.65,
   "end": 631.45,
   "text": "موت اصلاً قبلاً گفتیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 631.45,
   "end": 633.37,
   "text": "حرکته. نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.37,
   "end": 636.39,
   "text": "از ظاهر به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.39,
   "end": 638.53,
   "text": "اتفاق عجیبی نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.53,
   "end": 644.57,
   "text": "چشم ما به باطن همین ملک و ملک باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.57,
   "end": 647.99,
   "text": "وقت موت. یکی از معانی موت چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 647.99,
   "end": 656.19,
   "text": "معانی دقیق موت. همینجام دیگه ما فرود بیایم بقیه روایت باشه طلبتون فردا اگر زنده بودیم به شرط حیات و توفیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 656.19,
   "end": 662.65,
   "text": "یکی از معانی دقیق موت سفر از ملک یا ملک به ملکوت بود، به باطن عالم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 662.65,
   "end": 666.75,
   "text": "حالا حضرت عزرائیل همین کارو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 666.75,
   "end": 669.27,
   "text": "وقتی حضرت ابراهیم ازش سؤال میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.27,
   "end": 675.67,
   "text": "آیا میشه که دوستی تقاضای موت و مرگ دوستش رو بکنه، حضرت عزرائیل همین کارو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 675.67,
   "end": 680.03,
   "text": "یعنی موت و قبلاً تموتو خودش اصلاً همین کار رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.03,
   "end": 683.29,
   "text": "این سفر رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.29,
   "end": 687.89,
   "text": "یه سفر موتی انجام میده از ظاهر عالم میره به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 687.89,
   "end": 691.21,
   "text": "و متوجه حضرت حق میشه که ببینه این چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 691.21,
   "end": 694.47,
   "text": "یعنی یه بار دیگه خودش بچشه، مزه مزه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 694.47,
   "end": 698.23,
   "text": "مگه این چیز بدیه که دوستش ازش طلب کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 698.23,
   "end": 703.11,
   "text": "توجه کردی چی شد؟ خودش رو کأنَّ در این معرکه آزمون قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 703.11,
   "end": 706.09,
   "text": "دو مرتبه با اینکه همه رو داره میمیرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 706.09,
   "end": 710.59,
   "text": "اما باز خودش یه سفر از ظاهر به باطن میره که یعنی موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 710.59,
   "end": 715.27,
   "text": "به موت رسید. حالا متوجه حضرت حق شده که همه ما هم همینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 715.27,
   "end": 717.53,
   "text": "برای همه ما همین اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 717.53,
   "end": 720.93,
   "text": "فبصر کل یوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 720.93,
   "end": 723.55,
   "text": "اون علی یوم ظرف ظهور اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 723.55,
   "end": 727.59,
   "text": "وقتی ظهور کرد باطنت و کاعمالت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 727.59,
   "end": 730.03,
   "text": "ظهور کرد بصر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.03,
   "end": 732.95,
   "text": "الیوم چی؟ حدید تیز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.95,
   "end": 738.23,
   "text": "حضرت عزرائیل اینجا چشماش تیز میشه که بین یدی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 738.23,
   "end": 740.75,
   "text": "چی؟ تیز میشه به ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 740.75,
   "end": 745.07,
   "text": "حالا منتظر و مترصد پیام حضرت حقی که بماند برای فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 745.07,
   "end": 748.03,
   "text": "همه ما قراره این حالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.03,
   "end": 750.07,
   "text": "بچشیم. این یعنی موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 750.07,
   "end": 752.01,
   "text": "همینجاست. یعنی همینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 752.01,
   "end": 757.91,
   "text": "الان اموات ما همینجان. فکر نکنین باید بگردیم مثلاً بالای سقف و آسمونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 757.91,
   "end": 759.79,
   "text": "تموم کنیم بریم یه جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 759.79,
   "end": 762.43,
   "text": "نه. همین عالم باطنی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 762.43,
   "end": 765.07,
   "text": "مثل اینکه شما الان همینجا تشریف دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 765.07,
   "end": 768.43,
   "text": "باطن دارید یا نه؟ یه ظاهر دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 768.43,
   "end": 771.17,
   "text": "انزل مراتب نفست، شعون نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 771.17,
   "end": 773.53,
   "text": "جدایی از نفس نیست این بدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 773.53,
   "end": 780.35,
   "text": "یه باطن هم داری که البته بتون و بواتن داری، باطن‌ها داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 780.35,
   "end": 783.33,
   "text": "اونم الان همراه حضرت عالی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 783.33,
   "end": 784.71,
   "text": "الان که دارید تأمل میکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 784.71,
   "end": 792.09,
   "text": "تفکر میکنی، تعقل میکنی که این حرف‌ها رو بفهمی یعنی از ملکوت خودت داری استدعای میکنی تو باطنت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 792.09,
   "end": 795.15,
   "text": "سقع نفست ملک نازل بشه تا بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 795.15,
   "end": 797.29,
   "text": "یعنی ظاهر به باطن ارتباط گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 797.29,
   "end": 801.63,
   "text": "این یکی از معانی نرم مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 801.63,
   "end": 804.37,
   "text": "موته. یعنی شما همتون دارید میمیرید زنده میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 804.37,
   "end": 806.89,
   "text": "میمیرید زنده میشید. آن فآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 806.89,
   "end": 811.45,
   "text": "ان‌شاءالله عاقبت ما ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 811.45,
   "end": 814.79,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.79,
   "end": 817.51,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}