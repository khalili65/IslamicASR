 "chapters": [
  {
   "index": 0,
   "title": "## روایت پنجم؛ موت و مرض و فقر",
   "start": 0.08,
   "end": 182.02
  },
  {
   "index": 1,
   "title": "## چشم‌خوردن اهل ایمان و آیات زخرف",
   "start": 182.02,
   "end": 394.52
  },
  {
   "index": 2,
   "title": "## برکت رزق؛ آنچه دیگران از آن بهره می‌برند",
   "start": 394.52,
   "end": 471.1
  },
  {
   "index": 3,
   "title": "## درخواست سخن از دروغ؛ سورهٔ مرسلات",
   "start": 471.1,
   "end": 636.3
  },
  {
   "index": 4,
   "title": "## سیلی موت و امتحان حال نزد خدا",
   "start": 636.3,
   "end": 813.83
  },
  {
   "index": 5,
   "title": "## حکایت شیخ بهایی و چهلۀ موت ابیض",
   "start": 813.83,
   "end": 951.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 5.66,
   "text": "عجل فرج. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 9.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.14,
   "end": 13.18,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.18,
   "end": 19.6,
   "text": "رسیدیم به روایت پنجم از باب اول کتاب الموت مرحوم مجلسی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.6,
   "end": 24.18,
   "text": "در این روایت همونطور که عرض شد سه تا چیز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.18,
   "end": 27.22,
   "text": "پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.22,
   "end": 29.32,
   "text": "برشمردن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.32,
   "end": 32.12,
   "text": "این‌ها نبود هیچ کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.12,
   "end": 35.34,
   "text": "در برابر چیزی سر تعظیم فرود نمی‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.34,
   "end": 38.64,
   "text": "در حقیقت بندگی صورت نمی‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.64,
   "end": 45.88,
   "text": "یکیش موت بود. موت در این روایت بین دو چیز قرار گرفته: مریضی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.88,
   "end": 51.06,
   "text": "فقر. که ظاهراً سخت‌ترینش هم فقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.06,
   "end": 57.58,
   "text": "شاید از این حیث بعد از موت آورده پیغمبر فقر رو که مرحوم شیخ بهائی کتابم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.58,
   "end": 59.32,
   "text": "به نام موت ابیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.32,
   "end": 64.04,
   "text": "بعضیا از اون موت اختیاری رو که بعضیا سؤال می‌کردن چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.04,
   "end": 68.9,
   "text": "یه راهش همینه که موت ابیض، مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.9,
   "end": 71.8,
   "text": "سفید، یه نوع موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.8,
   "end": 74.2,
   "text": "فقر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.2,
   "end": 78.04,
   "text": "گرسنگی این‌ها یه نوع به یک معنا موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.04,
   "end": 80.88,
   "text": "حالا موت سفید بهش گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.88,
   "end": 84.5,
   "text": "علت اینکه این‌ها رو خدای منان ایجاد کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.5,
   "end": 90.74,
   "text": "نوشته برای دنیای ما اینه که از اون حالت اینطور که پیغمبر می‌فرماید علو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.74,
   "end": 95.74,
   "text": "و علو درونی و ذاتی که در ما هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.74,
   "end": 99.14,
   "text": "به سمت حضرت حق و کرنش و تواضع بیفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.14,
   "end": 102.36,
   "text": "البته اون علو، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.36,
   "end": 105.2,
   "text": "حالت علو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.2,
   "end": 108.9,
   "text": "خواهی که در درون انسان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.9,
   "end": 111.32,
   "text": "یک چیز خدادادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.32,
   "end": 113.74,
   "text": "منشأش الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.74,
   "end": 121.04,
   "text": "چون در فطرت و نهاد ماست و \"کل مولود یولد على الفطره\" کسی از این مستثنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.04,
   "end": 126.06,
   "text": "منتها اینکه جهتش چی باشه، به چه سمتی بره این مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.06,
   "end": 130.18,
   "text": "یه کسی وقتی پشت میز می‌شینه مدیر می‌شه علو می‌گیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.18,
   "end": 132.88,
   "text": "خودش رو برتر از دیگران می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.88,
   "end": 135.78,
   "text": "یکی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.78,
   "end": 139.36,
   "text": "با عبادت، یکی پولش زیاد می‌شه اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.36,
   "end": 142.4,
   "text": "یعنی ظرفیت‌ها مهمه، ظرفیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.4,
   "end": 147.52,
   "text": "چـ-چگونه‌ست که بین دو تا مدیر مثلاً یکی پشت میز می‌شینه متواضع‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.52,
   "end": 150.82,
   "text": "داریم نمونه‌هاشو. یکی هم بالعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.82,
   "end": 152.56,
   "text": "فکر می‌کنه دیگه همه زیردستشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.56,
   "end": 155.08,
   "text": "نه با-- این چه، به چی برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.08,
   "end": 157.98,
   "text": "ها؟ به اون ظرفیت وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.98,
   "end": 163.64,
   "text": "حالا این سه پیغمبر فرموده اومده که این علو رو به س-- جهت ببخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.64,
   "end": 168.12,
   "text": "که انسان بره به سمت ارتقاء وجودیش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.12,
   "end": 171.12,
   "text": "در حقیقت حرص بزنه در بندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.12,
   "end": 173.76,
   "text": "حتی حرص هم چیز بدی نیست ذاتاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.76,
   "end": 176.68,
   "text": "حرص در وجود انسان چیز بدی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.68,
   "end": 179.44,
   "text": "خوبه اما جهتش کجا مصرف بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.44,
   "end": 182.02,
   "text": "این علو کجا مصرف بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.02,
   "end": 187.1,
   "text": "انقدر خدا بدش میاد از برتری طلبی بندگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.1,
   "end": 190.54,
   "text": "و این نگاه بالا به پایین که عرض کردیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 190.54,
   "end": 194.68,
   "text": "یعنی مخصوصاً میره اول سراغ اونایی که پیشش محبوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.68,
   "end": 197.44,
   "text": "خدا هرکیو خیلی دوست داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.44,
   "end": 201.3,
   "text": "گرفتارش می‌کنه. یکی از علت‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.3,
   "end": 209.54,
   "text": "گرفتاری بین اهل ایمان زیاده است هم اینه که خدا اینا رو خواسته به قول مرحوم دولابی چشم خوردن، خدا چششون زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.54,
   "end": 213.4,
   "text": "تو چشم خدا افتادن. خدا اینا رو چشم زده لذا گرفتاری زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.4,
   "end": 215.56,
   "text": "براشون پیش میاد برای اینکه به خشوع بیفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.56,
   "end": 218.78,
   "text": "اصل اینه. اصل اصلاً اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.78,
   "end": 222.22,
   "text": "لذا یه روای-- یه آیه من امروز داشتم با یکی از همکارامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.22,
   "end": 227.12,
   "text": "می‌گفتم ببینین آیه اصلاً چقدر آیه عجیبیه اما ما توجه بهش شاید نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.12,
   "end": 231.42,
   "text": "آیه سی و سه تا سی و پنج سوره ذخرف رو برید تو خلوتتون ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.42,
   "end": 234.08,
   "text": "دیگه صریح‌تر از این خدا بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.08,
   "end": 239.28,
   "text": "برای کسایی که میگن چرا مثلاً اون وریا همه وضعشون از این وریا بهتره مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.28,
   "end": 242.88,
   "text": "ها؟ دقت بفرمایید. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.88,
   "end": 248.56,
   "text": "سی و سه سوره ذخرف \"ولولا ان يكون الناس امه واحده\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.56,
   "end": 250.98,
   "text": "اگه این نمی‌شد که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.98,
   "end": 257.72,
   "text": "یک امت واحده‌ای بشن بر علیه خدا یعنی رو در رو خدا بایستن، متکبر بشن، دست از وحدانیت بکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.72,
   "end": 262.78,
   "text": "اگه اینطور نبود \"لجعلنا لمن یکفر بالرحمن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.78,
   "end": 266.32,
   "text": "برای اون کسایی که کفر ورزیدن به خدای رحمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.32,
   "end": 270.64,
   "text": "چی کار می‌کردیم براشون؟ \"لبیوتهم سقفاً من فضة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.64,
   "end": 272.9,
   "text": "ومعارج عليها یت Haroon\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.9,
   "end": 276.44,
   "text": "یه کاری می‌کردیم سقف خونه‌هاشون و پله‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.44,
   "end": 281.96,
   "text": "از نقره باشه. الان کیو ما داریم سقف خونه‌ش از نقره باشه، پله‌هاش از نقره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.96,
   "end": 284.38,
   "text": "خدا میگه اگر این اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.38,
   "end": 289.86,
   "text": "مثلاً متزلزل در ایمان‌شون و وحدانیت‌شون نمی‌شدن این کارو من می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.86,
   "end": 295.26,
   "text": "یعنی این نشون میده که دنیا چقدر در نظر حضرت حق دنیه، پسته، دنیاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.26,
   "end": 298.88,
   "text": "لذا ارزشی نداره. میده به اونایی که بی ارزشن پیش خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.88,
   "end": 300.92,
   "text": "چون اهلش رو برای خودش می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.92,
   "end": 305.08,
   "text": "بعد انتهای آیه هم آیه بعدش، آیه دو، دو تا آیه بعد تأکید می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.08,
   "end": 308.52,
   "text": "آیه سی و چهار ادامه میده \"ولبیوتهم ابوابا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.52,
   "end": 311.76,
   "text": "چند تا در، ابوابا. به خونه‌هاشون چند تا در می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.76,
   "end": 313.64,
   "text": "یعنی انقدر بزرگشون می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.64,
   "end": 317.76,
   "text": "\"وسرراً عليها يتکئون\" تخت‌هایی بهشون می‌دادم، تخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.76,
   "end": 321.28,
   "text": "اونجا تکیه بکنن، کیف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.28,
   "end": 325.48,
   "text": "و آیه سی و پنج دو مرتبه ادامه‌ش \"و زخرفاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.48,
   "end": 330.36,
   "text": "یه زر و زیورهایی بهشون می‌دادم \"وان کل ذلک لما متاع الحياة الدنيا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.36,
   "end": 334.3,
   "text": "حواستون باشه اهل ایمان که این متاع دنیاست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.3,
   "end": 337.24,
   "text": "مال اینجاست. دنیا خودش دنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.24,
   "end": 339.8,
   "text": "انزل مراتب. پست فلسفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.8,
   "end": 343.88,
   "text": "اینم پسته. چه به-- دلتو به چی خوش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.88,
   "end": 346.04,
   "text": "و البته برای اهل تقوا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.04,
   "end": 349.26,
   "text": "\"والآخرة عند ربک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.26,
   "end": 352.5,
   "text": "به به، به به. مقام اندیسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.5,
   "end": 357.02,
   "text": "برای کی؟ \"للمتقین\". حواست باشه من اونورو برای تو اختیار کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.02,
   "end": 360.38,
   "text": "اینجا لذا در حد معمولاً مگر استثنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.38,
   "end": 365.22,
   "text": "که یکی می‌خواد واقعا دستگیری کنه، خیریه زده فلان، نه اونجا خدا کمکش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.22,
   "end": 367.96,
   "text": "اما وقتی کسی این کارم نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.96,
   "end": 371.06,
   "text": "خدا برای اهل ایمان معمولا در حد کفاف می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 371.06,
   "end": 377.74,
   "text": "مگر اینکه خودش، خودش رو به زیغ بندازه \"و من أعرض عن ذکری فإن له معیشة ضنکا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.74,
   "end": 380.34,
   "text": "وقتی از ذکر خدا دوری کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.34,
   "end": 383.46,
   "text": "زن که معیشتی براش پیش میاد ربطی به خدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.46,
   "end": 391.8,
   "text": "خودت خودتو زدی و الا در غیر این صورت اگر اهل تقوا باشی \"و من یتق الله يجعل له مخرجا و يرزق من حيث لا يحتسب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.8,
   "end": 394.34,
   "text": "می‌رسونه خدا براش. در غی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.34,
   "end": 400.26,
   "text": "و اگر کسی ااا هی می‌خواد انباشته کنه، پول پارو کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.26,
   "end": 403.68,
   "text": "اگر خدا دوستش داش-داشته باشه معمولا نمی‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.68,
   "end": 405.92,
   "text": "مگر در حیث برکتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.92,
   "end": 412.96,
   "text": "یعنی چی برکت؟ ببین اموال ما قبلا هم گفتیم هرچی که ما داریم اگر ازش استفاده می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.96,
   "end": 416.96,
   "text": "رزقمونه. استفاده نمی‌کنیم رزق ما نبوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.96,
   "end": 420.34,
   "text": "مال کس دیگه‌ست. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.34,
   "end": 428.5,
   "text": "برکت اینجا چی می‌شه؟ اون مقدار دارایی ما که دیگران ازش بهره می‌برن برکته، برکت رزقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.5,
   "end": 432.76,
   "text": "حالا شما اونچه که داری اگه فقط خودت داری استفاده می‌کنی رزقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.76,
   "end": 435.36,
   "text": "استفاده نمی‌کنی که رزقت نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.36,
   "end": 442.78,
   "text": "اگر دیگران هم دارن ازش استفاده می‌کنن مثلا یه خونه وسیع داری توش جلسات قرآن و هیئت و این‌ها می‌گیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.78,
   "end": 446.42,
   "text": "بله این برکته برزک-- معلومه زندگیت پربرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.42,
   "end": 448.1,
   "text": "در غیر این صورت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.1,
   "end": 455.82,
   "text": "اگر یه کسی پشت میز ریاست و مدیریت می‌شینه، دیگران بهره‌مند می‌شن از قلمش، از حکمی که صادر می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.82,
   "end": 460.28,
   "text": "از جهت‌گیری‌هاش، از رسیدگی‌هاش، از پدرانه رفتار کردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.28,
   "end": 467.06,
   "text": "این برکتشه. اما اگر برعکس باشه به زیغ بندازه کارمنداشو این برکت نیستش که این بیچاره‌گیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.06,
   "end": 475.02,
   "text": "و اون ور هم می‌افته تو زیغ. حالا این بحث رو ما دیروز یکی از دوستامون که ما خیلی هم دوسش داریم و چهره، چهره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.02,
   "end": 477.88,
   "text": "ملکوتی اینها به ما گفتن حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.88,
   "end": 480.96,
   "text": "ما یه درخواستی داریم در بین این صحبت‌های مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.96,
   "end": 487.3,
   "text": "به قول خودشون عرفانی و فلسفی و چه و این‌ها پیرامون دروغ هم یه مقدار صحبت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.3,
   "end": 489.8,
   "text": "ببینید ااا من ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.8,
   "end": 494.04,
   "text": "برای خودم احساس تأسف می‌کنم که بیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.04,
   "end": 497.24,
   "text": "در جمع شما از دروغ حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.24,
   "end": 501.24,
   "text": "اما چون درخواست کردن به حرمت دوستانی که گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.24,
   "end": 503.98,
   "text": "عرض می‌کنم به نظر بنده‌ی حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.98,
   "end": 515.04,
   "text": "این بسیاری از این آدم‌هایی که رفتن افتادن به تله‌های دنیایی رفتن و دیگه برنگشتن از دروغ شروع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.04,
   "end": 518.42,
   "text": "دروغ. چرا؟ حاج آقا به چه استنادی اینو میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.42,
   "end": 525.42,
   "text": "باور کنید خیلی از اینایی که حتی علیه السلام بودن مقدس هم بودن با دروغ شروع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.42,
   "end": 529.4,
   "text": "دیشب یه سوره‌ای رو می‌خوندم به نام مرسلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.4,
   "end": 531.68,
   "text": "چند سالمه من؟ پنجاه و یک سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.68,
   "end": 535.74,
   "text": "انگار اولین بار بود این همه قرآن خوندی من این سوره رو دارم یا آیات رو دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.74,
   "end": 540.28,
   "text": "تنم لرزید. دیدم عجب اولین باره بعد پنجاه سال دارم می‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.28,
   "end": 542.18,
   "text": "تو سوره مرسلات ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.18,
   "end": 548.12,
   "text": "بار خدا نهیب زده وای بر، وای بر، وای بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.12,
   "end": 551.18,
   "text": "اونایی که دروغ میگن. کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.18,
   "end": 554.84,
   "text": "\"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.84,
   "end": 558.62,
   "text": "خدا بگه وای اون روز وای بر اونایی که اهل دروغ‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.62,
   "end": 560.44,
   "text": "ده بار واقعا تنم لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.44,
   "end": 563.48,
   "text": "دیشب این سوره رو می‌خوندم بعد یاد اون حدیث افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.48,
   "end": 567.16,
   "text": "این مأخذ حرفم و استنباط خودمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.16,
   "end": 572.66,
   "text": "که امام صادق سلام الله علیه فرمود، مرحوم کلینی در کتاب اصولش آورد، اصول کافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.66,
   "end": 582.86,
   "text": "می‌فرما تمام بدی‌ها، زشتی‌ها و گناهان و شرارت‌های عالم رو جمع کردن تو داخل یک خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.86,
   "end": 588.76,
   "text": "و کلید این در و قفل این خونه دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.76,
   "end": 593.08,
   "text": "یعنی چی؟ اگر کسی دروغ گفت دیگه منتظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.08,
   "end": 596.36,
   "text": "سر خوردنش به سمت گناهان دیگه هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.36,
   "end": 603.74,
   "text": "البته یه سؤال، آیا خدا برای کسی که از محبین اهل بیته عواسش نیست یا به دروغ می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 603.74,
   "end": 610.22,
   "text": "آیا شما چون گفتید که خدا دوست داره این‌ها رو مثلا میندازشون به فرق که به خشوع بکشونشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 610.22,
   "end": 614.92,
   "text": "یا موث رو هی جلوی چشمشون میاره، عزیزانش می‌میرن، خودش مریض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.92,
   "end": 617.24,
   "text": "این‌ها برای اینکه به خشوع بیفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.24,
   "end": 623.02,
   "text": "آیا خدا کاری می‌کنه برای کسی که به دروغ می‌افته که اونم نجات بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.02,
   "end": 625.86,
   "text": "بله. الان چیکار داره می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.86,
   "end": 631.14,
   "text": "با ماها؟ خودم برای خودم و من برای شما، شما برای دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 631.14,
   "end": 634.94,
   "text": "آیه \"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ\" الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 634.94,
   "end": 638.4,
   "text": "گفته شد. این یکی از نهیب‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.4,
   "end": 647.32,
   "text": "یعنی اگر کسی واقعا گوش شنوا داره و این آیه به گوشش می‌خوره باز دروغ بگه با لجاجت بر خدا بلند شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 647.32,
   "end": 651.02,
   "text": "یعنی سرپرستی و ولایت خدا رو تو زندگیش قبول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 651.02,
   "end": 653.48,
   "text": "نکرده. خدا نهیبشو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 653.48,
   "end": 656.8,
   "text": "اما اگر این هی اصرار کنه، اصرار کنه ضمانتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 656.8,
   "end": 661.5,
   "text": "یهو می‌بینیش چپ کرد و رفت اونوری دیگه تا آخرشم میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.5,
   "end": 666.04,
   "text": "لذا نهیب‌ها رو دقت بفرمایید چی عرض می‌کنم نهیب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.04,
   "end": 668.46,
   "text": "حواسمون جمع باشه از همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.46,
   "end": 675.48,
   "text": "نمازی که می‌خونیم \"ایاک نعبد و ایاک نستعین\" چه دروغ بزرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 675.48,
   "end": 677.42,
   "text": "به خودما خودم به خودم نهیب بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 677.42,
   "end": 680.18,
   "text": "ببین از اینجا شروع می‌کنیم از جهت عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 680.18,
   "end": 683.28,
   "text": "دروغ نگو اینو با خودم. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 683.28,
   "end": 687.06,
   "text": "اکبر. خدا بزرگتر از آنچه که بتوانم وصفش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 687.06,
   "end": 692.86,
   "text": "حدیث داریم ملائکه می‌زنن تو صورت کسی که اینطور نیست بهش میگن دروغ گو، دروغ نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 692.86,
   "end": 697.82,
   "text": "حدیثه. اصلا پایه همه شرارت‌ها دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.82,
   "end": 700.6,
   "text": "توجه کردید این دروغ‌های رسانه‌ای ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 700.6,
   "end": 706.26,
   "text": "چندین هزار، سی و شش هزار اگه حالا عددش رو اشتباه نکنم دروغ رسانه‌ای تو این چند روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 706.26,
   "end": 710.38,
   "text": "کشف شد. خیلیه. گفت اینا از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 710.38,
   "end": 713.98,
   "text": "از کجا شروع شده؟ بعد نتیجه‌ش می‌شه این شرارت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 713.98,
   "end": 717.24,
   "text": "بله خدا می‌زنه. از اون طرفم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 717.24,
   "end": 723.83,
   "text": "هی خدا کسایی که حالا از جهت عبودیت بندگی‌شون می‌افتن به عجب و علو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 723.83,
   "end": 726.65,
   "text": "به خودشیفتگی. اونا رو هم یه جور می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 726.65,
   "end": 729.45,
   "text": "با نماز شبش می‌افته، اونا رو هم یه جور می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 729.45,
   "end": 734.01,
   "text": "اون کسی که مسئولیت یه دستش می‌افته فکر می‌کنه خبریه، اونام یه جور می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 734.01,
   "end": 738.99,
   "text": "خدا همه رو یه جوری می‌زنه تو صورتشون اگه دوسشون داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 738.99,
   "end": 742.81,
   "text": "که نخو-- نگرفت، نگرفت، نگرفت در نهایت با چی می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 742.81,
   "end": 744.77,
   "text": "سیلی محکم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 744.77,
   "end": 749.15,
   "text": "که دیگه گنده، گنده، گنده هاشو می‌زنه زمین موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 749.15,
   "end": 756.99,
   "text": "میاد میزنش زمین. حالا کسی زرنگ بود قبل از اون موت اجباری با موت اختیاری خودش خودشو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 756.99,
   "end": 758.61,
   "text": "قتل فعل مجهوله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 758.61,
   "end": 761.99,
   "text": "کی کشت؟ شاید خودش خودشو کشت، نفس خودشو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 761.99,
   "end": 763.93,
   "text": "حتی کسایی که حتی بزرگان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 763.93,
   "end": 770.39,
   "text": "یه نکته‌ای اینجا بگم لاپارانتز اینو خوب گوش بدین انتهای بحث حالا که بحث مقدار داغ شد این به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 770.39,
   "end": 772.21,
   "text": "می‌خواید بدانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 772.21,
   "end": 775.61,
   "text": "حال شما نزد خدا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 775.61,
   "end": 777.87,
   "text": "درجه شما نزد خدا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 777.87,
   "end": 780.17,
   "text": "اعتبار من و شما پیش خدا چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 780.17,
   "end": 783.51,
   "text": "با یه امتحان ساده. خدا چجوری ما رو می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 783.51,
   "end": 791.11,
   "text": "از اونجا می‌فهمید. یکی رو نماز صبحش قضا میشه، یکی نه نماز شبش قضا میشه، یکی نه حال نماز شبشو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 791.11,
   "end": 795.05,
   "text": "توجه بفرمایید چی دارم میگم. یعنی اینا با هم متفاوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 795.05,
   "end": 797.17,
   "text": "آیا بزرگان رو هم خدا می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 797.17,
   "end": 801.45,
   "text": "بله اگه گرفتار هوس بشن می‌زنه اما زدن اون‌ها با زدن ما فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 801.45,
   "end": 805.09,
   "text": "همه رو با موت می‌زنه همه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 805.09,
   "end": 809.35,
   "text": "اما در نشئ‌ طبیعت همه رو یه جور نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.35,
   "end": 812.53,
   "text": "مثلا یه جا چیز جالبی براتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 812.53,
   "end": 816.47,
   "text": "از شیخ بها. ببینید مثلا شیخ بهائی دیگه از بزرگ‌ترین علمای ماست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 816.47,
   "end": 818.85,
   "text": "ایشون رو خدا چجوری زده به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 818.85,
   "end": 821.89,
   "text": "ایشون هم زده خدا. خود شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 821.89,
   "end": 826.61,
   "text": "بها میگه بر اساس اون کتاب موت ابی ازش اول خودشون عمل می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 826.61,
   "end": 829.79,
   "text": "مثل من نبودن فقط حرف بزنن. چهله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 829.79,
   "end": 831.83,
   "text": "موت ابی از گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 831.83,
   "end": 835.61,
   "text": "می‌گیره چهل روزه می‌گیره فقط گیاهی می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 835.61,
   "end": 838.27,
   "text": "حیوانی اونجا دستورالعملش تو اون کتاب اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 838.27,
   "end": 842.63,
   "text": "حیوانی نمی‌خوره. سی‌وشش روز روزه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 842.63,
   "end": 844.49,
   "text": "میره از آه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 844.49,
   "end": 846.51,
   "text": "بازار آهنگرهای اصفهان عبور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 846.51,
   "end": 852.23,
   "text": "یه کبابی اونجا بوده. این کبابی‌هام دیدی دنبه رو میندازن بوش میزنه یه وضعیتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 852.23,
   "end": 858.55,
   "text": "بالاخره بوی کباب میزنه آدمم روزه باشه سی‌وشش روز روزه چله گرفته بوی کباب زد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 858.55,
   "end": 861.51,
   "text": "خلاصه مشام شیخ بها هوس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 861.51,
   "end": 864.21,
   "text": "خودش می‌نویسه میگه من هوس کباب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 864.21,
   "end": 868.81,
   "text": "دیدم نمی‌تونم باهاش مبارزه کنم. گفتم حالا یه پرس بخورم فعلا دوباره چله‌ام رو از رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 868.81,
   "end": 872.25,
   "text": "از نو شروع می‌کنم. دو مرتبه به خودم تازه نهیب زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 872.25,
   "end": 876.49,
   "text": "شیخ بها سی‌وشش روز زحمت کشیدی می‌خوای با یه کباب بدی بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 876.49,
   "end": 880.15,
   "text": "گفتم نه نمی‌کنم این کارو. باز به خودم نهیب ز-- تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 880.15,
   "end": 882.85,
   "text": "سی‌وشش روز روزه گرفتن رو به رخ خدا می‌کشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 882.85,
   "end": 885.23,
   "text": "مگه چیکار کردی که میگی سی‌وشش روز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 885.23,
   "end": 888.87,
   "text": "ببین چجوری در درون خودشون درگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 888.87,
   "end": 890.95,
   "text": "بعد میگه خب حالا باید خودمو عقاب کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 890.95,
   "end": 894.47,
   "text": "الله اکبر. بعد خدا چجوری میزنش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 894.47,
   "end": 897.79,
   "text": "میره یه از این پیرمردای چال vidar می‌گفتن خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 897.79,
   "end": 904.83,
   "text": "بار می‌کشیدن، قوی بودن. میگه میرم یه تنه به این میزنم اینم یه پس گردنی می‌خوابونه پس، پس کله‌ی من عقاب میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 904.83,
   "end": 907.37,
   "text": "این رفت یه دونه تنه زد به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 907.37,
   "end": 915.61,
   "text": "چال vidare بارکشه اومد برس-- خودشو آماده کرده بود برای پس گردنی دید صدای این کارگره بلند شد شیخ بها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 915.61,
   "end": 919.25,
   "text": "دلت کباب می‌خواد چرا تنشو به ما می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 919.25,
   "end": 922.41,
   "text": "الله اکبر. این تنش به لرزه افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 922.41,
   "end": 924.71,
   "text": "اینطوری خدا اینو زده. چجوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 924.71,
   "end": 930.01,
   "text": "گوششو می‌گیره میگه حواست باشه‌ها یه کارگر از تو جلو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 930.01,
   "end": 933.17,
   "text": "خب اون مقام شیخ بهاست. اما من نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 933.17,
   "end": 935.37,
   "text": "من اصلا محیط گناه یهو میوفتم تو گل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 935.37,
   "end": 940.49,
   "text": "با گناه گوشمو می‌پیچونه که حواست باشه پ رو نشو تو اینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 940.49,
   "end": 942.11,
   "text": "این نکته مهمی بود عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 942.11,
   "end": 943.81,
   "text": "انشاالله عاقبت همه‌مون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 943.81,
   "end": 946.87,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 946.87,
   "end": 951.23,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}