   "start": 63.2,
   "end": 185.08
  },
  {
   "index": 2,
   "title": "## دار بلغة و طریق إلی الآخرة",
   "start": 185.08,
   "end": 237.9
  },
  {
   "index": 3,
   "title": "## رفع تناقض؛ دنیا فانی و آخرت باقی",
   "start": 237.9,
   "end": 385.78
  },
  {
   "index": 4,
