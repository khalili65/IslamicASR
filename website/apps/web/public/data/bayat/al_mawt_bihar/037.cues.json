   "start": 11.92,
   "end": 33.06
  },
  {
   "index": 1,
   "title": "## روایت صباح و شکاف کوه احد",
   "start": 33.06,
   "end": 53.08
  },
  {
   "index": 2,
   "title": "## سه علامت کبر سن",
   "start": 53.08,
   "end": 165.0
  },
  {
   "index": 3,
   "title": "## نهی از کنار گذاشتن آسان روایت",
   "start": 165.0,
   "end": 278.94
  },
  {
   "index": 4,
   "title": "## امر امیرالمؤمنین به درایت",
   "start": 278.94,
   "end": 367.62
  },
  {
   "index": 5,
   "title": "## حروف مقطعه بودن عالم و روایت",
   "start": 367.62,
   "end": 387.84
  },
  {
   "index": 6,
   "title": "## مخاطب‌شناسی؛ سخن به قدر عقول",
   "start": 387.84,
   "end": 546.5
  },
  {
   "index": 7,
   "title": "## امانت محفوظه و احتیاط فقها",
   "start": 546.5,
   "end": 700.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.14,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.14,
   "end": 8.18,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.18,
   "end": 11.92,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.92,
   "end": 14.52,
   "text": "بحث ما رسیده بود به ارذل العمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.52,
   "end": 21.5,
   "text": "در موضوع موت در باب دوم مقدمه باب دوم کتاب الموت بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.5,
   "end": 27.5,
   "text": "عرض کردیم که کارکرد ارذل العمر اینه که انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.5,
   "end": 29.44,
   "text": "آماده‌ی موت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.44,
   "end": 33.06,
   "text": "یعنی اون پس‌ترین حالت عمر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.06,
   "end": 36.94,
   "text": "که عده‌ای به اون حالت می‌رسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.94,
   "end": 41.98,
   "text": "و گرفتاری‌های جسمی براشون پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.98,
   "end": 44.62,
   "text": "به یک معنا آلارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.62,
   "end": 46.7,
   "text": "آمادگیشونه برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.7,
   "end": 50.48,
   "text": "یعنی آقا آماده باش، خانم آماده باش چیزی دیگه نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.48,
   "end": 56.82,
   "text": "هم‌غریبی بانگ بلند بشه که بلند بگو لا اله الا الله تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.82,
   "end": 64.64,
   "text": "این اول العمر حالا بخوایم روایاتی که مرحوم مجلسی آورده رو بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.64,
   "end": 67.2,
   "text": "ببینیم که آیا نشانه‌هایی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.2,
   "end": 70.92,
   "text": "آیا سن خاصیه این حالت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.92,
   "end": 74.94,
   "text": "آیا ما در اون مقطع قرار گرفتیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.94,
   "end": 82.38,
   "text": "اولین روایتی که مرحوم مجلسی اتفاقاً از کتاب خصال شیخ صدوق آورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.38,
   "end": 85.38,
   "text": "جلد یک صفحه هشتاد و هشت از خصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.38,
   "end": 88.5,
   "text": "آورده این روایته. شخصی بوده به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.5,
   "end": 92.98,
   "text": "صباح یا صبّاح هم تلفظ شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.98,
   "end": 96.32,
   "text": "غلام آزاد شده امام صادق علیه السلام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.32,
   "end": 99.14,
   "text": "میگه با آقا داشتیم می‌رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.14,
   "end": 104.0,
   "text": "و عبور کردیم فلما مررنا به احد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.0,
   "end": 107.3,
   "text": "از کوه احد می‌گذشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.3,
   "end": 111.42,
   "text": "قال ترى الثقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.42,
   "end": 115.52,
   "text": "الذی فیه مولا فرمود که امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.52,
   "end": 118.78,
   "text": "فرمود که صباح اون شکاف رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.78,
   "end": 120.78,
   "text": "ثقب شکاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.78,
   "end": 124.7,
   "text": "اون شکاف داخل کوه احد رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.7,
   "end": 128.1,
   "text": "قلت نعم. گفتم بله می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.1,
   "end": 130.46,
   "text": "قال حالا حضرت فرمود قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.46,
   "end": 133.5,
   "text": "اما انا فلست اراه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.5,
   "end": 138.0,
   "text": "اما من نمی‌بینم. قطعاً برای شما این تعجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.0,
   "end": 141.8,
   "text": "این روایت ظاهرش تعجب‌برانگیزه که و باید هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.8,
   "end": 147.2,
   "text": "حالا بحث می‌کنیم. و اینکه آیا واقعاً امام معصوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.2,
   "end": 150.26,
   "text": "امام معصوم می‌شه چیزی رو نبینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.26,
   "end": 153.22,
   "text": "چشمش تار بشه؟ که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.22,
   "end": 155.42,
   "text": "امروز فرصت نمی‌شه احتمال زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.42,
   "end": 158.54,
   "text": "این کتاب شیخ الرئیس رو آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.54,
   "end": 160.84,
   "text": "این کتابی که بغل منه اشارات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.84,
   "end": 166.94,
   "text": "اشارات شیخ الرئیس. تو نمت دوم این بحث رو ایشون خیلی قشنگ در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.94,
   "end": 171.28,
   "text": "اعتدال امزجه بیان کرده که حالا ما معتقدیم نه چنین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.28,
   "end": 175.38,
   "text": "باید بریم دنبال اینکه منظور از این روایت چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.38,
   "end": 181.42,
   "text": "بعد حالا حضرت فرمودن که علامة الكبره علامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.42,
   "end": 186.42,
   "text": "کبر سن زیاد شدن سن به یک معنا ارذل العمر این سه تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.42,
   "end": 189.46,
   "text": "فلاف چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.46,
   "end": 193.96,
   "text": "اول فرمود کلال البصر چشم آدم سنگین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.96,
   "end": 197.68,
   "text": "میگه کله بر کسی نشو یعنی بارت رو روی دوش کسی ننداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.68,
   "end": 201.14,
   "text": "سنگینی بر دوش کسی نکن. کلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.14,
   "end": 205.62,
   "text": "یعنی چشم سنگین می‌شه، نورش کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.62,
   "end": 207.98,
   "text": "وانحناء الظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.98,
   "end": 210.82,
   "text": "پشت انسان منحنی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.82,
   "end": 213.5,
   "text": "انحنای پشت که بعضیامون الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.5,
   "end": 215.6,
   "text": "به این داریم می‌افتیم دیگه یواش یواش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.6,
   "end": 219.26,
   "text": "سه فرمود رقة القدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.26,
   "end": 221.48,
   "text": "پاهاش رقیق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.48,
   "end": 224.02,
   "text": "به یک معنا سست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.02,
   "end": 226.76,
   "text": "با احتیاط قدم برمیداره. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 226.76,
   "end": 229.84,
   "text": "نشانه‌هایه. حالا عزیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.84,
   "end": 233.42,
   "text": "جالب که داشتیم بحث می‌کردیم سر این روایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 233.42,
   "end": 238.56,
   "text": "یه عزیزی گفت حاج آقا این به نظرم این روایت درست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.56,
   "end": 240.82,
   "text": "من می‌خوام عرض کنم که اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 240.82,
   "end": 243.86,
   "text": "ما نباید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.86,
   "end": 246.34,
   "text": "راحتی یک روایت رو بگذاریم کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.34,
   "end": 252.34,
   "text": "ما اولاً اهلش نیستیم. درایت حدیث می‌خواد، علم رجال می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.34,
   "end": 257.24,
   "text": "ما کار ما نیست. ما باید به همین راحتی، خب حالا یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.24,
   "end": 263.14,
   "text": "اشکالات اساسی که حضرت استاد علامه حسن زاده به بسیاری از راویان احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.14,
   "end": 268.96,
   "text": "نقل می‌کنه، اشکال وارد می‌کنه همینه که به راحتی تا یه چیزی رو متوجه نمی‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.96,
   "end": 272.76,
   "text": "میذارن کنار. می‌گن این جعله، این درست نیست، این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 272.76,
   "end": 277.36,
   "text": "نه عزیزم باید رفت سراغ درایه حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.36,
   "end": 284.3,
   "text": "اتفاقاً در همین خصوص یه حدیث تقدیم می‌کنم از مولامون علی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.3,
   "end": 288.42,
   "text": "کنز الفوائد جلد دو صفحه سی و یک این روایت رو می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.42,
   "end": 290.64,
   "text": "امیرالمؤمنین فرمود آقا امیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.64,
   "end": 293.84,
   "text": "ما، مولای ما، جلودار پیشوای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.84,
   "end": 297.5,
   "text": "داره به ما تذکر میده که علیکم بالدرایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.5,
   "end": 300.68,
   "text": "بر شما باد که به فهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.68,
   "end": 304.34,
   "text": "به فهم روایات. علیکم بالدرایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.34,
   "end": 307.34,
   "text": "درایت، درایه فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.34,
   "end": 311.8,
   "text": "عمیق باطنیه. لا بالروايات نه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.8,
   "end": 315.18,
   "text": "یه روایتو فقط حفظ کنی، بیان کنی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.18,
   "end": 318.54,
   "text": "قابل توجه بعضیا که میگن آقا روایتو بخون برو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.54,
   "end": 323.36,
   "text": "انقدر دیگه هی چرا توضیح میدی؟ مولامون فرموده نه، نه، نه، نه این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.36,
   "end": 326.86,
   "text": "فقط روایت. نه درایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.86,
   "end": 334.7,
   "text": "فهم عمیق حدیث. بعد حضرت ادامه میدن همة السفهاء الرواية روایت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.7,
   "end": 337.06,
   "text": "اینکه حالا منطوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.06,
   "end": 341.4,
   "text": "یک روایت یا حدیثی رو همینجوری بخونی و رد شی بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.4,
   "end": 344.24,
   "text": "همتت این باشه این میگه مال سفهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.24,
   "end": 347.94,
   "text": "مولا می‌فرمود و همة العلماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.94,
   "end": 352.26,
   "text": "همت علما چیه؟ الدرایة فهم حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.26,
   "end": 354.92,
   "text": "پس ما باید حدیث رو بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.92,
   "end": 360.14,
   "text": "اگر نمی‌فهمیم بریم زانو بزنیم جلوی بزرگانمون حلاجی کنن برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.14,
   "end": 364.16,
   "text": "پنبه حدیثو بزنن قشنگ بازش کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.16,
   "end": 366.24,
   "text": "ببینیم درون مایه ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.24,
   "end": 369.22,
   "text": "مگر عرض نکردیم که حضرت استاد فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.22,
   "end": 372.1,
   "text": "همه عالم حروف مقطعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.1,
   "end": 376.06,
   "text": "نه فقط حروف مقطعه قرآن، همه آیات، همه روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.06,
   "end": 378.86,
   "text": "همه حروف مقطعه‌اند. یعنی رمز‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.86,
   "end": 382.56,
   "text": "باید از این رمز پی برد به درون مایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 382.56,
   "end": 385.52,
   "text": "پس این روایات هم عزیزان دلم رمزی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 385.52,
   "end": 392.34,
   "text": "نکته‌ی بعد این که چرا ما این که مثلاً میگیم آقا این روایت ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.34,
   "end": 398.4,
   "text": "ظاهرش مثلاً به دو جهت یکی اینکه میگه امام معصوم صراحتا گفته من نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.4,
   "end": 403.38,
   "text": "دو اینکه خیلیا پیر میشن این سه تا نشونه هم توشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.38,
   "end": 409.28,
   "text": "ها؟ میگیم که آقا جان چرا شما نمیذارید به حساب اینکه اون مخاطب کی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.28,
   "end": 418.46,
   "text": "مگر اهل بیت نفرمودن نهش-- \"نحن معاشر الأنبياء نکلم الناس على قدر عقولهم\" ما \"انا امرنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.46,
   "end": 421.52,
   "text": "اصلا امر شده به ما که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.52,
   "end": 424.7,
   "text": "به قدر عقل مردم باهاشون حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.7,
   "end": 428.64,
   "text": "حالا اون غلام آزاد شده حضرت داره باهاش میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.64,
   "end": 431.84,
   "text": "حضرت در حد اون داره بیان میکنه موضوع رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.84,
   "end": 433.72,
   "text": "که این ش-- سه تا نشونه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.72,
   "end": 437.4,
   "text": "این هم یه نکته‌ست. توجه داشته باشید که مخاطب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.4,
   "end": 439.36,
   "text": "فرمایش مولا کی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.36,
   "end": 445.08,
   "text": "درسته حتی کوچک‌ترین چیز رو هم اهل بیت بگن از نظر ما مثل وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.08,
   "end": 451.92,
   "text": "حتی اولیا گفتن شما هر سوالی از امام معصوم ب-- آقا شما اسمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.92,
   "end": 455.38,
   "text": "ها؟ بگه انا جعفر بن محمد بن صادق مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.38,
   "end": 459.14,
   "text": "این هم وحیه. یعنی \"انه هو الا وحی یوحى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.14,
   "end": 461.34,
   "text": "در حق، در حد همشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.34,
   "end": 467.08,
   "text": "اون هم حتی به امر الهی و اراده‌ی رب به زبانش جز به اراده‌ی رب نمی‌چرخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.08,
   "end": 470.46,
   "text": "این‌ها رو توجه داشته باشید. نکته‌ی بعد اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.46,
   "end": 475.1,
   "text": "حالا ما همه رو امروز نمی‌تونیم بگیم وقت می‌گذره اما این‌ها رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.1,
   "end": 482.4,
   "text": "اگر امروز که قطعا نمی‌رسیم ق-- حتما دنبال کنید این بحثی که روی این روایت داریم می‌کنیم خوب به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.4,
   "end": 490.18,
   "text": "نکته‌ی بعد اینکه ما می‌تونیم منظور حضرت رو از اینجا این چنین برداشت کنیم که حضرت فرموده من نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.18,
   "end": 495.6,
   "text": "اینکه مثلاً داریم رميله تب کرد مریض شد حالش خیلی بد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.6,
   "end": 498.48,
   "text": "امیرالمؤمنین علیه الصلاة والسلام بهش فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.48,
   "end": 501.92,
   "text": "شما مریض نمی‌شید مگر اینکه ما مریض می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.92,
   "end": 507.3,
   "text": "این نه یعنی اینکه واقعاً این همه شیعه الان همه مریض بشن مثلا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.3,
   "end": 509.8,
   "text": "یکیشون هم مریض شه امام هست واقعا مریض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.8,
   "end": 512.6,
   "text": "منظور اینه که ما کاملا درک می‌کنیم شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.6,
   "end": 515.36,
   "text": "نه اینکه ما هم پا به پای شما مریض شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.36,
   "end": 520.5,
   "text": "یعنی ما، ما می‌چشیم مثل پدریم، مثل نه، پدر شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.5,
   "end": 524.08,
   "text": "ما درک می‌کنیم دقیقا شما الان چی داری می‌کشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.08,
   "end": 526.5,
   "text": "این می‌تونه منظور از چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.5,
   "end": 530.22,
   "text": "اینکه حضرت داره در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.22,
   "end": 533.22,
   "text": "ندیدن این شخص رو بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.22,
   "end": 536.86,
   "text": "که آقا من که پدر توام. من که می‌دونم تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.86,
   "end": 540.8,
   "text": "حضرت میگه من نمی‌بینم، او کلمة الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.8,
   "end": 542.58,
   "text": "او مقام جمعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.58,
   "end": 545.42,
   "text": "همه‌ی حقایق مندمجن درش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.42,
   "end": 548.2,
   "text": "همه‌ی حقایق عالم، همه‌ی انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.2,
   "end": 550.98,
   "text": "این‌ها شعون وجودی امام معصومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.98,
   "end": 555.84,
   "text": "اصلا او در حقیقت انسان العین، مردمک چشمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.84,
   "end": 560.24,
   "text": "هرچی، هرچی ما می‌بینیم از چشم امام عصر می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.24,
   "end": 562.28,
   "text": "او می‌بینه که ما می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.28,
   "end": 564.52,
   "text": "خدا هم از چشم امام عصر می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.52,
   "end": 567.06,
   "text": "این بحث‌ها قبلا گذشته بین ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.06,
   "end": 571.22,
   "text": "این می‌شه این باشه که آقا این آقا، این غلامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 571.22,
   "end": 574.62,
   "text": "داره یه لافی می‌زنه. می‌خواد ادعای جوونی مثلا بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 574.62,
   "end": 580.46,
   "text": "بگه آره آقا ما می‌بینیم حضرت بفرما که آقا ما که می‌بینیم تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.46,
   "end": 584.98,
   "text": "توجه کردید چی شد؟ ما که می‌دونیم تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.98,
   "end": 588.92,
   "text": "این یک معنا. که می‌تونه اینطوری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.92,
   "end": 591.62,
   "text": "چون حضرت می‌فرماید که \"قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.62,
   "end": 595.54,
   "text": "اما انا فلست اراه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.54,
   "end": 600.06,
   "text": "من نمی‌بینم. یعنی من نمی‌بینم یعنی می‌تونه این باشه که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.06,
   "end": 602.22,
   "text": "دیدن تو رو در تو نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.22,
   "end": 604.6,
   "text": "مثل اینکه یکی ادعایی بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.6,
   "end": 606.4,
   "text": "خب بگه من هرکول زمین می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 606.4,
   "end": 608.4,
   "text": "تو میگی آقا من نمی‌بینم همچین چیزی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.4,
   "end": 611.66,
   "text": "من نمی‌بینم یعنی چی؟ یعنی در تو نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 611.66,
   "end": 616.58,
   "text": "می‌تونه معنیش این باشه که امام صادق داره تصریح می‌کنه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 616.58,
   "end": 619.62,
   "text": "راستگو باش. چرا ادعای جوون‌ها رو در میاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.62,
   "end": 623.64,
   "text": "این هم سه تا نشونه که برای شما بگم علامتی که بر سنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.64,
   "end": 627.04,
   "text": "در تو هم حتما هست. چرا الکی میگی من می‌بینم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 627.04,
   "end": 629.2,
   "text": "این می‌تونه یه معنیش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.2,
   "end": 635.78,
   "text": "توجه کردید چی شد این‌ها؟ نحوه‌ی نگرش ما به روایت خیلی مهمه که ما چگونه روایت رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.78,
   "end": 641.38,
   "text": "منظور از، یعنی منظور از این منطوق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 641.38,
   "end": 647.94,
   "text": "اینکه یه عالم میره نود سال، هشتاد سال، هفتاد سال عمر میذاره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.94,
   "end": 652.42,
   "text": "حوزه‌های علمیه، توی حجره‌ی namun، پدر خودش رو در میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.42,
   "end": 655.62,
   "text": "آخر هم میگه احتیاط کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.62,
   "end": 657.3,
   "text": "حکم صریح نمیده برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 657.3,
   "end": 660.2,
   "text": "چون امانت داره. امانت المحفوظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.2,
   "end": 663.0,
   "text": "امانت محفوظه الهیه این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 663.0,
   "end": 666.3,
   "text": "جرات نمی‌کنه حکم بده. میگه احتیاط کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 666.3,
   "end": 668.74,
   "text": "این تقوای شدیدش رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 668.74,
   "end": 673.12,
   "text": "بعد ما بیاییم به راحتی یه روایتی که نمی‌فهمیم میذاریم کنار، این‌ها غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 673.12,
   "end": 679.16,
   "text": "حالا تا همین مقدار امروز بسنده می‌کنیم تا انشاالله وجوه دیگر این روایت رو بیان کنیم و اینکه آیا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 679.16,
   "end": 680.74,
   "text": "سه تا نشونه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 680.74,
   "end": 683.4,
   "text": "صرفا همین نشانه‌های ظاهری‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.4,
   "end": 686.14,
   "text": "یا منظور حضرت نشانه‌های باطنی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 686.14,
   "end": 689.24,
   "text": "انشاالله دنبال کنید این روایت رو به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 689.24,
   "end": 693.94,
   "text": "عاقبتهم ختم به خیر بشه انشاالله به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.94,
   "end": 700.28,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}