  {
   "index": 10,
   "title": "## ختم روایت",
   "start": 963.54,
   "end": 991.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.34,
   "end": 5.0,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.0,
   "end": 8.2,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.2,
   "end": 11.24,
   "text": "و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.24,
   "end": 14.82,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 17.1,
   "text": "بحث آخر ما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.1,
   "end": 20.02,
   "text": "خاطر شریفتون باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.02,
   "end": 25.68,
   "text": "کتاب الموت بود. روایت پونزدهم فرود اومده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.68,
   "end": 28.26,
   "text": "و اجازه بدید که روایت پونزدهم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.26,
   "end": 32.8,
   "text": "سفره‌ش رو جمع کنیم که چون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.8,
   "end": 37.54,
   "text": "نمی‌خوایم چون اوایل کتابم هستیم خیلی طول کشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.54,
   "end": 40.46,
   "text": "بریم روایت شونزدهم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.46,
   "end": 44.92,
   "text": "به فضل الهی بخونیم ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.92,
   "end": 49.96,
   "text": "چی می‌فرمود. از قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.96,
   "end": 56.0,
   "text": "کتاب امالی شیخ طوسی علیه الرحمة این روایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.0,
   "end": 58.38,
   "text": "مرحوم مجلسی آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.38,
   "end": 60.96,
   "text": "که خلاصه‌ش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.96,
   "end": 63.58,
   "text": "پیغمبر عزیز عالم به عیادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.58,
   "end": 67.18,
   "text": "شخصی رفت که بیمار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.18,
   "end": 70.32,
   "text": "و تو بستر بیماری افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.32,
   "end": 73.2,
   "text": "تا این عادت پیغمبر بود وقتی کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.2,
   "end": 75.48,
   "text": "به مدتی مسجد نمی‌اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.48,
   "end": 77.74,
   "text": "اون موقع‌ها تمرکز تو مسجد بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.74,
   "end": 83.04,
   "text": "یعنی کسی مسجد نمی‌اومد پیدا بود که اتفاق خاصی افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.04,
   "end": 89.4,
   "text": "نه که الان برعکس باشه یکی پیداش بشه تو مسجد بگیم حتما یه اتفاق خاصی افتاده اومده یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.4,
   "end": 93.22,
   "text": "کسش مرده یا اومده یه ماهیه بریم اون جماعت بگیره بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.22,
   "end": 96.7,
   "text": "چه می‌دونم متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.7,
   "end": 99.58,
   "text": "این مصیبت بزرگیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.58,
   "end": 104.82,
   "text": "اسلام رو گرفته، دامنه مسلمون‌ها رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.82,
   "end": 112.64,
   "text": "به هر حال عادت پیغمبر بود همه هم اینو شنیدیم وقتی مدتیه کسی از دوستانش رو نمی‌دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.64,
   "end": 116.06,
   "text": "پیگیری می‌کرد و اگر مریض بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.06,
   "end": 124.14,
   "text": "سراغش می‌رفت و اگر چنانچه مسافر بود دعا می‌کرد برای سلامتی‌ش که به سلامتی برگرده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.14,
   "end": 126.76,
   "text": "مثلا آدم وقتی سنن النبي،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.76,
   "end": 131.42,
   "text": "سیرة ابن هشام، سیرة ابن هشام رو می‌خونه یا سنن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.42,
   "end": 134.72,
   "text": "سنن النبي علامه طباطبایی رو می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.72,
   "end": 138.46,
   "text": "واقعا به اینجا می‌رسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.46,
   "end": 143.04,
   "text": "اصلا شاید بشه گفت یه نمی از اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.04,
   "end": 146.36,
   "text": "در معاشرت‌های اجتماعی ما باقی مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.36,
   "end": 148.78,
   "text": "یه نمی واقعا اینجوریه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.78,
   "end": 154.98,
   "text": "سنت‌های پیغمبر رو انسان مطالعه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.98,
   "end": 157.28,
   "text": ". امانت به درد دل نیوفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.28,
   "end": 163.2,
   "text": "اینجا وقتی پیغمبر به عیادت ایشون میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.2,
   "end": 168.0,
   "text": "که قال دخل رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.0,
   "end": 171.78,
   "text": "علی رجلا یعوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.78,
   "end": 175.48,
   "text": "و هو شاکن. هو شاکن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.48,
   "end": 178.2,
   "text": "یعنی اون شخص ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.2,
   "end": 182.14,
   "text": "همه شکایت می‌کرد. شاکی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.14,
   "end": 185.16,
   "text": "اصطلاحا. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.16,
   "end": 189.4,
   "text": "به قول بعضیا میگن دیگه کم آورده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.4,
   "end": 193.3,
   "text": "شاکی بود شکایت می‌کرد. چرا شاکی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.3,
   "end": 197.58,
   "text": "اون روایت پونزدهم چنانچه خاطر شریفتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.58,
   "end": 199.88,
   "text": "می‌فرمود که سئمت دنیا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.88,
   "end": 201.66,
   "text": "یعنی خسته شدم از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.66,
   "end": 204.52,
   "text": "از اینجا شکایت می‌کرد. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.52,
   "end": 209.88,
   "text": "علت شکایتش چیه؟ که فَتَمَنَّى الْمَوْتِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.88,
   "end": 213.98,
   "text": "که تمنای موت می‌کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.98,
   "end": 218.34,
   "text": "به خاطر شکایتی که داشته تمنای موت می‌کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.34,
   "end": 223.58,
   "text": "به خاطر مریضی‌ش. و معلومه که مریضی‌ش هم سخت بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.58,
   "end": 226.62,
   "text": "مدتی نبوده که پیغمبر رفته به دیدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.62,
   "end": 231.22,
   "text": "حالا اگه مریضه جزئی بود سریع تموم میشد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.22,
   "end": 235.72,
   "text": "می‌رفت مسجد دیگه چند روزی نبوده که پیغمبر تشریف آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.72,
   "end": 242.98,
   "text": "این حالا، این دسته روایت که حالا البته هم روایت قبلیه هم این روایت تقریبا شبیه به همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.98,
   "end": 248.82,
   "text": "اون میگه خسته شدم، این شکایت می‌کنه از مریضی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.82,
   "end": 251.8,
   "text": "هم به ما به قول بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.8,
   "end": 258.94,
   "text": "این رو یاد میده که اگر ما در چنین موقعیتی قرار گرفتیم چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.94,
   "end": 260.98,
   "text": "مثلا تمنای موت بکنیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.98,
   "end": 268.62,
   "text": "اصن درست هست یا نه؟ چون خیلیا الان هستن خدا مرگم رو برسونه دیگه خسته شدم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.62,
   "end": 275.78,
   "text": "هم به ما روش برخورد رو یاد میده با کسی که این وضعیت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.78,
   "end": 283.44,
   "text": "اگر رفتیم جایی دیدیم کسی از شدت درد و مریضی اینا به خودش می‌پیچه و تمنای موت داره ما چی بهش بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.44,
   "end": 287.34,
   "text": "یعنی دو وجهی به ما این آموزش رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.34,
   "end": 292.0,
   "text": "پیغمبر بهشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.0,
   "end": 294.96,
   "text": "لا تتمنى الْمَوْتَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.96,
   "end": 298.02,
   "text": "اول فرمودن نکن این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.02,
   "end": 300.52,
   "text": "تمنای موت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.52,
   "end": 305.44,
   "text": "حالا علت چیه؟ به چه خاطر تمنای موت نکن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.44,
   "end": 307.48,
   "text": "فإنك إن تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.48,
   "end": 311.56,
   "text": "محسنا اگر تو از دو حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.56,
   "end": 314.9,
   "text": "بیرون نیست که یا محسن یا مسيءی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.9,
   "end": 319.14,
   "text": "یا نیکوکاری یا گناهکاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.14,
   "end": 324.56,
   "text": "إن تک محسنا اگر چنانچه تو نیکوکار باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.56,
   "end": 329.04,
   "text": "تزدد احسانا إلى احسانک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.04,
   "end": 332.98,
   "text": "تو تمنای موت نکن که احسان بیاد رو احسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.98,
   "end": 338.48,
   "text": "نور على نور. حتی از یه وضو ساده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.48,
   "end": 340.74,
   "text": "که ما به راحتی از کنارش رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.74,
   "end": 343.24,
   "text": "مگه حدیث نداریم؟ الوضو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.24,
   "end": 347.26,
   "text": "الوضو نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.26,
   "end": 355.62,
   "text": "یکی از ااا بزرگان اهل معرفت که بعضا ما ازشون استفاده می‌کردیم خیلی تاکید داشتن اد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.62,
   "end": 360.5,
   "text": "بر وضو، بر وضو. حتی می‌فرمودن که هر وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.5,
   "end": 369.61,
   "text": "شما خواستید نماز بخونید یا عبادتی رو شروع کنید، ایشون تاکید می‌کردن که حتی اگر وضو هم دارید دوباره وضو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.61,
   "end": 372.67,
   "text": "و حتی می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.67,
   "end": 376.01,
   "text": "اصلاً خدا دوست داره وضو روی وضو رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.01,
   "end": 382.01,
   "text": "نور on النور دیگه. حالا چه آثاری از وضو هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.01,
   "end": 386.05,
   "text": "ااا استاد بروجردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 386.05,
   "end": 393.75,
   "text": "ایشون میگم استاد بروجردی هر وقت من تو صحبت‌هام حالا قدیم بیشتر می‌گفتیم بیشتر اشرافیت داشتیم با کتاباشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.75,
   "end": 396.25,
   "text": "گفتم استاد بروجردی منظورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.25,
   "end": 398.75,
   "text": "یه کسیه شبیه بانو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.75,
   "end": 402.59,
   "text": "مجتهد امین. ایشونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.59,
   "end": 407.45,
   "text": "بانو مجتهد بروجردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.45,
   "end": 411.59,
   "text": "ایشون هم کتاب‌های بسیار خوبی نوشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.59,
   "end": 415.19,
   "text": "و فاضله و عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.19,
   "end": 420.11,
   "text": "ایشون توی یکی از این کتاباشون یادمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.11,
   "end": 424.87,
   "text": "بر مبنای یکی از روایات اهل بیت فرموده بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.87,
   "end": 428.91,
   "text": "تو بهشت هر مقدار که ما اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.91,
   "end": 432.73,
   "text": "وضو داریم، وضو می‌گیریم، یعنی چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.73,
   "end": 435.33,
   "text": "چه مقدار از عمرمون وضو داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.33,
   "end": 442.27,
   "text": "همون مقدار حالا اینجا پنجاه سال و صد سال و اونجا دیگه ابده دیگه زریب می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.27,
   "end": 448.91,
   "text": "همون مقدار همون زمان به یک معنا از حیث اخرویش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.91,
   "end": 453.03,
   "text": "بارون می‌باره. مثلاً شما تو خونه خودتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.03,
   "end": 458.87,
   "text": "تو قصر خودتی، تو باغ خودتی، تو محوطه مختص خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.87,
   "end": 461.31,
   "text": "خونه بغلیت بارون نمی‌باره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.31,
   "end": 464.87,
   "text": "اون لحظه ولی خونه شما بارون می‌باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.87,
   "end": 468.91,
   "text": "خیلی شیرین بود برای من اون موقع‌ها خیلی سال‌های پیش شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.91,
   "end": 472.63,
   "text": "حالا بعد باید رفت تأویل کرد که این باران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 472.63,
   "end": 475.75,
   "text": "یعنی چی؟ لحظاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.75,
   "end": 480.37,
   "text": "مؤمن در دنیا وضو داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.37,
   "end": 485.47,
   "text": "نشئه آخرت در حقیقت اون تجسم و تجسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.47,
   "end": 487.69,
   "text": "برزخی یا اخرویش می‌شه باران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.69,
   "end": 490.93,
   "text": "چرا؟ باران چی هست در اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.93,
   "end": 493.11,
   "text": "حالا دیگه باید بحث کرد چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.11,
   "end": 495.05,
   "text": "مورد موضوع بحث ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.05,
   "end": 500.91,
   "text": "الان ورود نمی‌کنیم ولی اگه خواستین یه ذره ش-- ذهنتونو بشورونین روش فکر کنید ببینید چه چیزهایی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.91,
   "end": 503.29,
   "text": "خودتون ذهنتون اجتهاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.29,
   "end": 509.93,
   "text": "باران سبب طراوت رشد و نمو رحمته به قول شما طراوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.93,
   "end": 512.23,
   "text": "حیاته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.23,
   "end": 514.37,
   "text": "خیلی، خیلی بخواهیم عمیق بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.37,
   "end": 519.55,
   "text": "چون از آبه دیگه. آب و جعلنا من الماء كل شيءٍ حي حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.55,
   "end": 524.15,
   "text": "این حیات، حیات واقعی جاییست که ولایت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 524.15,
   "end": 526.59,
   "text": "ولایت رو شما برداری همه مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.59,
   "end": 529.43,
   "text": "اصلاً معنای آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.43,
   "end": 532.51,
   "text": "ولایته. وقتی شما میری بالا، میری بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.51,
   "end": 537.51,
   "text": "حالا اینکه قبلاً هم گفتم تو خواب بسته به اینکه شما تو خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.51,
   "end": 540.23,
   "text": "آب رو ببینی یا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.23,
   "end": 547.45,
   "text": "تجرد عقلانی آب رو ببینی یا فوق تجرد عقلانی آب رو ببینی در کشف و شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.45,
   "end": 551.23,
   "text": "اینا هر کدوم یه ترجمه‌ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.23,
   "end": 554.05,
   "text": "به هر حال ااا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.05,
   "end": 556.31,
   "text": "حالا خیلی از بحث فاصله نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.31,
   "end": 559.91,
   "text": "پیغمبر اعظمی العالم فرمودن که اگه تو آدم خوبی باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.91,
   "end": 562.65,
   "text": "به خودمونی بگیم، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.65,
   "end": 565.79,
   "text": "این اضافه عمرت، ازدیاد عمرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.79,
   "end": 569.73,
   "text": "خوبی میاره رو خوبی. نور میاد رو نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.73,
   "end": 572.73,
   "text": "در حقیقت اضافه می‌شه بر احسان خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.73,
   "end": 574.81,
   "text": "پرونده اعمالت پر می‌شه از حسنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.81,
   "end": 579.71,
   "text": "\"وإن كنت مسيئاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 579.71,
   "end": 584.65,
   "text": "اما اگر چنانچه تو بدکار باشی خدایی نکرده \"فتأخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 584.65,
   "end": 590.89,
   "text": "لتستعتب\". \"لتستعتب\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.89,
   "end": 594.15,
   "text": "یه تاخیری می‌افته به مرگت تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.15,
   "end": 597.41,
   "text": "خودت خودتو عتاب کنی و توبه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.41,
   "end": 601.91,
   "text": "برگردی. برای اینکه عذرخواهی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.91,
   "end": 605.39,
   "text": "عذر تقصیر به طلبی از درگاه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.39,
   "end": 609.19,
   "text": "اینجا هم باز اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 609.19,
   "end": 612.75,
   "text": "یک فرصت عمر برای عذرخواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.75,
   "end": 615.83,
   "text": "دو جایگاه خود عذرخواهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.83,
   "end": 619.51,
   "text": "مشخص می‌شه. الان مثلاً غزه الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.51,
   "end": 624.07,
   "text": "از حیث سیاسی، دیپلماسی، اجتماعی همه جوره پیروز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.07,
   "end": 627.75,
   "text": "حتی از حیث نظامی. پیروز شد واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.75,
   "end": 630.71,
   "text": "همه دارن دوست و دشمن دارن میگن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 630.71,
   "end": 636.03,
   "text": "خود اسرائیلی‌ها هم الان دو سه نفرشون استعفا دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 636.03,
   "end": 641.11,
   "text": "به علامت اعتراض. دیگه الان خودتون شاهدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.11,
   "end": 645.71,
   "text": "درسته پنجاه هزار انسان بی‌گناه به خاک و خون کشیده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.71,
   "end": 649.65,
   "text": "اما این جریان و این حزب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.65,
   "end": 652.57,
   "text": "که وصل به مقاومته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.57,
   "end": 654.69,
   "text": "یعنی انشعابی از مقاومت پیروز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.69,
   "end": 659.57,
   "text": "این چیز کمی نیست. این پیروزی رو که البته رهبر عزیز هم قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 659.57,
   "end": 662.77,
   "text": "مژده‌ش هم داده بودند. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 662.77,
   "end": 666.47,
   "text": "این الان خیلیامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.47,
   "end": 673.43,
   "text": "خیلی، خیلی هنر کنیم بگیم الحمد لله خیلی کارمون درست بشه دو رکعت نماز شکر بخونیم و سجده شکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 673.43,
   "end": 676.99,
   "text": "اما اینه؟ الان وظیفه، وظیفه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 676.99,
   "end": 681.53,
   "text": "در قبال این نصرت و این فتح و گشایش و پیروزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 681.53,
   "end": 688.37,
   "text": "صرفاً حمد قرآنیشو بخواهیم پیش بریم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 688.37,
   "end": 690.37,
   "text": "سوره نصر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.37,
   "end": 694.39,
   "text": "اسمش رو خوشه. \"إذا جاء نصر الله والفتح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.39,
   "end": 699.99,
   "text": "وقتی نصر الهی و فتح بر تو آمد و بر ما اومده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 699.99,
   "end": 702.83,
   "text": "اومده دیگه. الان جبهه مقاومت پیروز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 702.83,
   "end": 705.77,
   "text": "خب بریم جلوتر. چه کار باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 705.77,
   "end": 709.63,
   "text": "\"فسبح بحمدك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 709.63,
   "end": 713.11,
   "text": "پس تسبیح كن تسبیح به حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 713.11,
   "end": 717.35,
   "text": "\"فسبح بحمد ربك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 717.35,
   "end": 722.45,
   "text": "تسبیح، تسبیح به حمد پروردگار خودت را انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 722.45,
   "end": 725.71,
   "text": "حالا اینجا دنیایی حرف مفسرین پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 725.71,
   "end": 727.37,
   "text": "خلاصشو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 727.37,
   "end": 731.98,
   "text": "اولاً \"فسبح بحمد ربك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 731.98,
   "end": 734.12,
   "text": "تسبیح به حمد حالا اینجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 734.12,
   "end": 736.42,
   "text": "تسبیح به حمد مفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.42,
   "end": 742.12,
   "text": "الان فرصت نمیشه. تسبیح به حمد رو انسان کامل انجام میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 742.12,
   "end": 745.18,
   "text": "و ما رو میکشونه با خودش میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 745.18,
   "end": 749.4,
   "text": "بار ما رو برمی‌داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 749.4,
   "end": 752.06,
   "text": "در حقیقت مثل برگ ریزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 752.06,
   "end": 756.28,
   "text": "پاییز درخت آلودگی‌های ما رو میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 756.28,
   "end": 760.68,
   "text": "اون ولایت کلی است. ما رو با خودش میبره، سیر میده، میبره به وادی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 760.68,
   "end": 765.04,
   "text": "اون تسبیح به حمده که اول توسط انسان کامل شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 765.04,
   "end": 770.26,
   "text": "خب بعد بربک. چرا رب مطلق نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 770.26,
   "end": 773.92,
   "text": "فسبح بحمدالله چرا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 773.92,
   "end": 778.08,
   "text": "بحمد ربک چرا؟ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 778.08,
   "end": 784.92,
   "text": "از دل و جانت به پروردگار خودت تسبیح به حمد پروردگار خودت یعنی از دل و جانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 784.92,
   "end": 787.4,
   "text": "فیلم بازی نکن. از دل و جانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 787.4,
   "end": 790.96,
   "text": "دیگه معنیش اینه. یعنی از رب خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 790.96,
   "end": 795.16,
   "text": "با خدای خودت سخن بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 795.16,
   "end": 797.28,
   "text": "حالا برای اینکه زودتر هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 797.28,
   "end": 800.36,
   "text": "زودتر از بیست دقیقه هم جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 800.36,
   "end": 802.6,
   "text": "دیگه خیلی بیشتر از این توضیح ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 802.6,
   "end": 805.7,
   "text": "فسبح بحمد ربک. دیگه چی بگید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 805.7,
   "end": 810.08,
   "text": "واستغفره انه کان تَوَّابًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 810.08,
   "end": 814.78,
   "text": "واستغفره. واستغفره واقعا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.78,
   "end": 821.2,
   "text": "بله واستغفره. یعنی بعد از اینکه جاء نصر الله والفتح واستغفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 821.2,
   "end": 823.8,
   "text": "یعنی وظیفه ما استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 823.8,
   "end": 827.58,
   "text": "مثلا کسی به این فکر می‌کرد یا فکر می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 827.58,
   "end": 834.26,
   "text": "تا یه عالمی ذره‌بین تهارت نفس بگذاره اینا رو ظرائف و دقایق رو پیدا کنه به ما بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 834.26,
   "end": 839.68,
   "text": "که بعد از هر پیروزی وظیفه ما استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 839.68,
   "end": 843.7,
   "text": "تسبیح به حمد انسان کامل انجام میده البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 843.7,
   "end": 854.46,
   "text": "وظیفه ما هم هست. سبحان ربي الأعلى وبحمده سبحان ربي العظيم وبحمده اینا وبحمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 854.46,
   "end": 861.32,
   "text": "تسبیح به حمده اینا دیگه. که در نما-- در معنای نماز گنجانده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 861.32,
   "end": 863.48,
   "text": "استغفار چیه؟ استغفار همه باید--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 863.48,
   "end": 865.22,
   "text": "یعنی الان ما باید استغفار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 865.22,
   "end": 870.84,
   "text": "بله. چند تامون بعد از این فتح و گشایشی که برای غزه رخ داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 870.84,
   "end": 874.16,
   "text": "استغفار کردیم. الان آمار بگیریم از مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 874.16,
   "end": 876.76,
   "text": "در صورتی که صریح آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 876.76,
   "end": 880.4,
   "text": "چرا ما اصلا توجه به آیات قرآن نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 880.4,
   "end": 885.4,
   "text": "چرا؟ پس یکی از وظایف مهم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 885.4,
   "end": 888.06,
   "text": "بعد از هر فتح و نصرتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 888.06,
   "end": 890.34,
   "text": "اصلاً از هر حیثا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 890.34,
   "end": 892.12,
   "text": "شما مثلا عزتت بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 892.12,
   "end": 894.56,
   "text": "توی دادگاه میری موفق میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 894.56,
   "end": 898.1,
   "text": "مثلا مشکل قانونی داشتی برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 898.1,
   "end": 900.24,
   "text": "حتی حقوقت اضافه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 900.24,
   "end": 901.96,
   "text": "اینم یک نوع فتحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 901.96,
   "end": 903.76,
   "text": "یک نوع نصرت الهیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 903.76,
   "end": 906.5,
   "text": "رزق مالیه. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 906.5,
   "end": 910.04,
   "text": "یک وجه ایاری الهیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 910.04,
   "end": 913.62,
   "text": "نصر الهیه دیگه. نصر الهی شاخ و دم که نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 913.62,
   "end": 922.8,
   "text": "تو همه عرصه‌ها هست. یک بار شد که وقتی اضافه حقوق پیدا می‌کنیم بگیم استغفرالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 922.8,
   "end": 927.24,
   "text": "واسألوا التوبة. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 927.24,
   "end": 930.18,
   "text": "چشامون چهار تا میشه و فوقش خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 930.18,
   "end": 932.3,
   "text": "جان؟ نمی‌کنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 932.3,
   "end": 936.3,
   "text": "ما شا-- ما اصلاً اون قسمت رو به صورت تشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 936.3,
   "end": 938.72,
   "text": "شروع می‌کنیم. یعنی استغفار متوجه نمیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 938.72,
   "end": 943.02,
   "text": "آفرین. آفرین. اصلاً برای چی باید استغفار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 943.02,
   "end": 946.58,
   "text": "جا نیفتاد. چون ما معنای استغفار رو درست درک نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 946.58,
   "end": 951.44,
   "text": "معنای استغفار یعنی چی؟ طلب مغفرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 951.44,
   "end": 955.42,
   "text": "حالا اینو اجازه بدید جلسه بعد درباره‌ش صحبت کنیم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 955.42,
   "end": 959.7,
   "text": "شما فرمودید که کم صحبت کنیم امروز منم که عجله دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 959.7,
   "end": 961.28,
   "text": "و الا خب الان جان مطلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 961.28,
   "end": 963.38,
   "text": "خوبه که درباره‌ش حرف زده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 963.38,
   "end": 965.58,
   "text": "خب رسیدیم به انتهای روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 965.58,
   "end": 970.32,
   "text": "فلا تن-- فلا تمنوا الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 970.32,
   "end": 972.82,
   "text": "که بعد میگه اینطوره پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 972.82,
   "end": 979.22,
   "text": "تمنای موت نکن دیگه. بشین استغفار کن برای گناهات و کارهای خوبتو زیاد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 979.22,
   "end": 982.4,
   "text": "چرا داری تمنای موت می‌کنی؟ یه درسه برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 982.4,
   "end": 986.66,
   "text": "حالا اون نکته استغفار چرا بعد از فتح و گشایش انشالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
