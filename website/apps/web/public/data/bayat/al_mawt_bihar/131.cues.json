 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.86,
   "end": 7.9,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.9,
   "end": 10.98,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.98,
   "end": 14.56,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.56,
   "end": 19.94,
   "text": "محضر پنج شهید گمنام و بزرگوار هستیم ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.94,
   "end": 23.48,
   "text": "در این روز قدر که فضیلتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.48,
   "end": 26.74,
   "text": "به مثل شب قدر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.74,
   "end": 40.36,
   "text": "این شاهدها بار ما رو سبک کنن نثارشون صلواتی ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.36,
   "end": 47.6,
   "text": "نکته‌ای رو عارض بشم. البته ما قرار بود که برای چهارشنبه‌هایی که در محضر شما هستیم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.6,
   "end": 52.74,
   "text": "موضوعی رو انتخاب کنیم. منتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.74,
   "end": 55.36,
   "text": "به جهت اینکه قرار بود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.36,
   "end": 58.32,
   "text": "محضر اصحاب رسانه امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.32,
   "end": 63.28,
   "text": "موضوع موت رو در روایت دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.28,
   "end": 67.46,
   "text": "از باب چهارم کتاب الموت مرحوم مجلسی بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.46,
   "end": 71.94,
   "text": "تمامش کنیم. همون نکته رو اینجا تقدیم می‌کنم تبرکاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.94,
   "end": 77.32,
   "text": "ان شاء الله تا جلسات بعدی ببینیم خدا چی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.32,
   "end": 83.72,
   "text": "در روایت دهم از باب چهارم کتاب الموت مرحوم مجلسی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.72,
   "end": 92.32,
   "text": "روایتی رو میاره که خدای منان چیزی رو خلق نکرده که یقینی‌تر از موت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.32,
   "end": 94.6,
   "text": "در حالی که مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.6,
   "end": 97.0,
   "text": "رفتارشون با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.0,
   "end": 103.76,
   "text": "به گونه‌ای است که هیچ یقینی درش نیست، بلکه چنان شکی به اون دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.76,
   "end": 107.06,
   "text": "که انّə هیچ یقینی در اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.06,
   "end": 108.88,
   "text": "یعنی اصلاً باور ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.88,
   "end": 111.62,
   "text": "رفتار مردم با موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.62,
   "end": 116.4,
   "text": "کاملاً مغایر با فلسفه و نفس خلقت موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.4,
   "end": 118.82,
   "text": "موت هم مگر خلقه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.82,
   "end": 123.16,
   "text": "الذي خلق، خلق الموت، خلق الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.16,
   "end": 127.82,
   "text": "و الحياة البته لیبلوکم ایکم احسن عملا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.82,
   "end": 132.16,
   "text": "به جهت اینکه ببینه کدومتون احسن عمل رو دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.16,
   "end": 135.36,
   "text": "اصلاً موت و حیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.36,
   "end": 138.38,
   "text": "خلق کرده. علت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.38,
   "end": 141.6,
   "text": "معمولاً انسان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.6,
   "end": 146.32,
   "text": "مشکوکند نسبت به موت اگرچه از حیث علم فکری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.32,
   "end": 149.08,
   "text": "علم فکری ها بحث یقین نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.08,
   "end": 154.94,
   "text": "قلب رو نمیگم. از حیث علم فکری بپرسی همه میگن بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.94,
   "end": 159.1,
   "text": "حتمیه، قطعیه. منم قراره بمیرم و می‌میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.1,
   "end": 164.32,
   "text": "هیچ‌کس زنده نمی‌مونه. اما می‌بینی رفتار کاملاً مغایره با این علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.32,
   "end": 166.38,
   "text": "یعنی به یقین بدل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.38,
   "end": 168.88,
   "text": "یقین نداره، باور نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.88,
   "end": 174.52,
   "text": "این یعنی همون شک. ولی در عمل کاملاً مشخصه که این اعتقاد به با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.52,
   "end": 177.1,
   "text": "به عالم غیب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.1,
   "end": 179.82,
   "text": "صرفاً شهود عالم رو دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.82,
   "end": 183.44,
   "text": "و خدا هم که عالم الغیب و شهاده هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.44,
   "end": 187.3,
   "text": "دم از خدا می‌زنه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.3,
   "end": 194.92,
   "text": "از زندگیش مشخصه که یقین همچین نداره که قیامتی هست، موتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.92,
   "end": 196.88,
   "text": "از زندگیش مشخصه باور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.88,
   "end": 201.5,
   "text": "این هم که خدای منان عالم الغیب و شهاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.5,
   "end": 205.44,
   "text": "برای خدا که غیب و شهادت یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.44,
   "end": 209.38,
   "text": "این عالم الغیب و شهاده به نسبت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.38,
   "end": 212.48,
   "text": "برای ما غیب و شهود متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.48,
   "end": 216.28,
   "text": "برای ماست که عالمی شده عالم غیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.28,
   "end": 219.58,
   "text": "مغیبات. عالمی شده عالم شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.58,
   "end": 221.4,
   "text": "که همین نشئه طبیعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.4,
   "end": 229.8,
   "text": "برای خدا که این چنین نیست. حالا خدا می‌خواد بفرماید که من به اون غیبی که از نظر تو غیبه هم عالمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.8,
   "end": 232.7,
   "text": "همونطور که به شهادت و شهود تو عالمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.7,
   "end": 235.12,
   "text": "این علت این شک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.12,
   "end": 238.38,
   "text": "علت-- یکی از علل این شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.38,
   "end": 242.64,
   "text": "این هستش که ما توجه به عالم غیب نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.64,
   "end": 249.2,
   "text": "یعنی غالباً با همین نشئه شهادت و شهود به نشئه طبیعت و ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.2,
   "end": 252.36,
   "text": "مرتبطیم و با این مشغول این هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.36,
   "end": 255.62,
   "text": "مثل اینکه از خودمون کاملاً غافلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.62,
   "end": 258.54,
   "text": "که پرتوه روح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.54,
   "end": 261.34,
   "text": "نطق و چشم و گوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.34,
   "end": 264.76,
   "text": "پرتوه روح است، روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.76,
   "end": 268.32,
   "text": "اصلاً گاهی اوقات ما اصلاً توجه نداریم که روح ما کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.32,
   "end": 270.68,
   "text": "پرتوه روح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.68,
   "end": 273.58,
   "text": "نطق و چشم و گوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.58,
   "end": 276.86,
   "text": "پرتوه آتش بود در آب جوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.86,
   "end": 281.18,
   "text": "اصلاً توجه نداریم که چشم من نیست که می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.18,
   "end": 285.08,
   "text": "تمام به قول حضرت استاد علامه حائری یزدی علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.08,
   "end": 289.54,
   "text": "جلسه‌ی بسیار شریف صد و بیست و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.54,
   "end": 292.76,
   "text": "شرح مثباث الانس مرحوم ابن فناری که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.76,
   "end": 298.44,
   "text": "سه شب قدری که اینجا ما توفیق داشتیم در خدمت دوستان و عزیزان یزید و زهرا بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.44,
   "end": 302.28,
   "text": "اونجا تقریباً تفصیلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.28,
   "end": 306.22,
   "text": "مطلب رو که اونجا می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.22,
   "end": 308.86,
   "text": "تو گمان می‌کنی که خودت داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.86,
   "end": 310.98,
   "text": "اینو باز می‌کنه خیلی شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.98,
   "end": 315.44,
   "text": "که مثال می‌زنه اگر قرار بود چشمتو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.44,
   "end": 318.48,
   "text": "وقتی که می‌خوابیدی چشم بسته است چرا باز می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.48,
   "end": 320.42,
   "text": "وقتی می‌میری چرا باز می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.42,
   "end": 323.48,
   "text": "چشمتو نیست، نفست است که می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.48,
   "end": 325.34,
   "text": "این پرتوه روح توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.34,
   "end": 327.54,
   "text": "چون ما بی‌خبریم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.54,
   "end": 335.16,
   "text": "روح که پرورش‌دهنده‌ی بدن ماست و غالباً توجه ما به نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.16,
   "end": 339.08,
   "text": "ماده‌ست و به ماده‌ی وجود خودمون که بدن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.08,
   "end": 341.82,
   "text": "این تف-- تازه بدن هم نیست این تفاله‌ی بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.82,
   "end": 345.92,
   "text": "چون میذاریش میری. با بدن برزخی میری به عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.92,
   "end": 348.46,
   "text": "به عالم مثالی به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.46,
   "end": 354.12,
   "text": "مافوق این رتبه با اون بدن مثالی حرکت می‌کنی که قبلاً اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.12,
   "end": 359.12,
   "text": "در محضر شما بر اساس یکی از اصولی که حضرت استاد در انس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.12,
   "end": 361.8,
   "text": "کتاب شریف انسان در عرفانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.8,
   "end": 367.06,
   "text": "فرمودند ثابت کردیم که اون بدن رو خودمون داریم شکل بهش میدیم با اعمالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.06,
   "end": 369.42,
   "text": "عمل ما شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.42,
   "end": 372.64,
   "text": "بدن برزخی ما رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.64,
   "end": 375.22,
   "text": "خمیرمایه شو می‌سازه. همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.22,
   "end": 377.36,
   "text": "علم و باور ما داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.36,
   "end": 379.46,
   "text": "باطن ما و نفس ما رو شکل می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.46,
   "end": 382.06,
   "text": "در هر حال بحث و گذشت رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.06,
   "end": 387.02,
   "text": "حالا معمولاً چون غافلیم از غیب عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.02,
   "end": 392.64,
   "text": "خبر نداریم از باطن عالم این مشکل برای ما پیش اومده، باورامون چنین ضعیف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.64,
   "end": 395.54,
   "text": "در صورتی که اتفاقاً از جهت فلسفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.54,
   "end": 400.36,
   "text": "شما می‌دونید که اصلاً هر چیزی به آخر خودش معنا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.36,
   "end": 406.74,
   "text": "معنای هر چیزی حقیقت هر شیئی برمی‌گرده به اون غایتش، به اون انتهاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.74,
   "end": 410.16,
   "text": "انتهای من و شما چیه؟ سفر، سفر به آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.16,
   "end": 415.64,
   "text": "انا لله در قوس النزول تشریف فرما شدید به نشئه مادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.64,
   "end": 417.96,
   "text": "حالا از همین جا و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.96,
   "end": 425.2,
   "text": "در قوس صعود الان همه ما در حال رجعتیم و انا الیه راجعون همه داریم سمت حضرت حق حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.2,
   "end": 427.8,
   "text": "این عالم غیبه. این حرکت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.8,
   "end": 431.04,
   "text": "عالم غیبه. منتها ما توجه بهش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.04,
   "end": 437.24,
   "text": "این چون توجه نداریم از خودمون بگیر تا بیرون از خودمون چه در نظام انفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.24,
   "end": 442.22,
   "text": "که \"و فی الارض آیات للموقنین و فی انفسکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.22,
   "end": 444.4,
   "text": "انفسکم افلا تبصرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.4,
   "end": 450.3,
   "text": "چه در نف-- نظام انفسی در جان خودمون، چه در آفاقی که بیرون از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.3,
   "end": 454.52,
   "text": "چون توجه به این غیب نداریم لذا مشکوکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.52,
   "end": 462.7,
   "text": "باور نداریم که مرگ هست، حقیقته و ما قراره به اونجا سفر کنیم و عزیزانی که تا دیروز پیش ما بودند الان اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.7,
   "end": 467.38,
   "text": "و جالبه که بدونید این یک جایی نیست فارغ از این نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.38,
   "end": 471.56,
   "text": "مادون و طبیعت. همونطور که روح شما الان کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.56,
   "end": 476.38,
   "text": "می‌تونی براش جایی رو متصور بشی بگی مثلاً به سقف کله من که خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.38,
   "end": 479.1,
   "text": "مثلاً شما بیا به سقف بگین سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.1,
   "end": 481.36,
   "text": "سر، سر من که خوردی دیگه بعدش روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.36,
   "end": 484.84,
   "text": "این حرفا چیه؟ روح در درون توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.84,
   "end": 488.42,
   "text": "درست شد؟ یعنی باطن وجود من و شما می‌شه نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.42,
   "end": 491.38,
   "text": "که مرتبه تعلق روح به بدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.38,
   "end": 494.68,
   "text": "که روح احکامش رو از طریق نفس در بدن پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.68,
   "end": 497.62,
   "text": "همین‌طور در نشئه طبیعت هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.62,
   "end": 501.76,
   "text": "در باطن همین عالم، همین زمین و آسمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.76,
   "end": 503.72,
   "text": "عالم برزخ تعبیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.72,
   "end": 508.74,
   "text": "چطور که تو می‌خوابی میری عالم برزخ، میری به عالم مثال به رتبه‌ی مثالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.74,
   "end": 511.26,
   "text": "در قوه خیالت سیر می‌کنی، اون شک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.26,
   "end": 515.78,
   "text": "اون اشکال و صوری که برات ایجاد می‌شه با قوت نفس خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.78,
   "end": 519.66,
   "text": "با ضعف قوت نفس اینا شکل می‌گیرن یا مغبر فضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.66,
   "end": 524.08,
   "text": "دقیق مشخص نیست، مشوشه یا نه کاملاً واضح و مبرهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.08,
   "end": 527.3,
   "text": "می‌شه رؤیای صادقه. هرچی که هست کجا اینا رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.3,
   "end": 529.94,
   "text": "در درون خودت. در درون خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.94,
   "end": 532.46,
   "text": "یعنی اصلاً سفر یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.46,
   "end": 534.8,
   "text": "م-- ببخشید، موت یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.8,
   "end": 537.22,
   "text": "اون ترجمه‌هایی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.22,
   "end": 539.88,
   "text": "سیر تقریباً صد و چهل، پنجاه جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.88,
   "end": 543.04,
   "text": "حدود پونزده، شونزده تعبیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.04,
   "end": 551.1,
   "text": "تعبیر عالمانه از حکما و عرفا پیرامون مرگ ارائه دادیم در سیر بحث عزیزانی که دنبال بحث رو گرفتن می‌دونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.1,
   "end": 554.74,
   "text": "یکیش سفر از خود به خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.74,
   "end": 558.8,
   "text": "اصلاً حضرت استاد علامه حسن زاده می‌فرمود موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.8,
   "end": 562.1,
   "text": "یعنی کندن تو از غیر خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.1,
   "end": 568.44,
   "text": "از تمام تعلقات که اگر نکنی به میزانی که به تعلقات وابسته‌ای در برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.44,
   "end": 572.74,
   "text": "نگهت می‌دارن. ما اصلاً همین الان همراه قیامتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.74,
   "end": 574.66,
   "text": "همین الان با غیبیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.66,
   "end": 578.52,
   "text": "بی‌خبریم. الان غیب من داره سخن می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.52,
   "end": 585.02,
   "text": "وگر-- اگر غیب من سخن نگه این زبان چگونه یاران اینو داره که بخوره به مخارج حروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.02,
   "end": 591.86,
   "text": "اصلاً چگونه تشخیص می‌ده که چگونه این حروف با هم مزدوج بشن که کلمات و بعد موضوعات و جملات و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.86,
   "end": 598.3,
   "text": "از کجا بفهمن؟ غیب داره سخن می‌گه و تو چگونه این کلمات رو درک می‌کنی، می‌فهمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.3,
   "end": 601.16,
   "text": "چگونه می‌چشی و چگونه است که هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.16,
   "end": 604.08,
   "text": "به نسبت سعه وجودی خودش این‌ها رو می‌چشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.08,
   "end": 607.38,
   "text": "چون غیب داری به غیب خودت این‌ها رو دریافت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.38,
   "end": 614.72,
   "text": "اصلاً نفس ناطقه است، غیب وجود ما که داره می‌بینه، می‌شنوه، راه می‌ره و اون قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.72,
   "end": 620.08,
   "text": "معراج ما و سفر ما به نشء-- نشئات بالاتر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 620.08,
   "end": 622.56,
   "text": "ترتیب بده. ما غافلیم کاملاً ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.56,
   "end": 625.65,
   "text": "اتفاقاً حضرت استاد اینجا که می‌رسه مثال قشنگی می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.65,
   "end": 629.26,
   "text": "می‌فرمود کلاً خیلی این کلاً حرف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 629.26,
   "end": 632.7,
   "text": "کلاً تمام مردم صبح تا شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 632.7,
   "end": 636.28,
   "text": "با غیب مرتبط‌اند و به غیب رو می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.28,
   "end": 639.76,
   "text": "اما خبر ندارن. مثال پزشک و طبیب رو می‌زنه ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.76,
   "end": 643.6,
   "text": "حضرت علامه. می‌فرما که وقتی شما میری به سمت طبیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 643.6,
   "end": 645.26,
   "text": "به سمت چی طبیب میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 645.26,
   "end": 651.56,
   "text": "بفرما ببینم. اینکه وقتی میری سمتش به تعبیر ایشون، ایشون هم که مثل خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.56,
   "end": 654.12,
   "text": "یکسر دو گوشه. لحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 654.12,
   "end": 658.28,
   "text": "و دم و عظم که امثالکم اینا که مثل خودتونه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 658.28,
   "end": 661.92,
   "text": "برای چی؟ به چه خاطر رفتی سمت این آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.92,
   "end": 664.66,
   "text": "به خاطر اون حقیقت باطنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.66,
   "end": 668.4,
   "text": "اون تحصیلاتش، اون واقعیت وجودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 668.4,
   "end": 672.04,
   "text": "اون صور علمیه‌ای که در ثغور نفسشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 672.04,
   "end": 675.34,
   "text": "اون یعنی چی؟ مگه می‌بینیش؟ مگه دیدنیه مثل جسمش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 675.34,
   "end": 677.36,
   "text": "نخیر. پس این غیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.36,
   "end": 679.12,
   "text": "پس داری به سمت غیب میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 679.12,
   "end": 681.44,
   "text": "به سمت قیامت اون داری میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 681.44,
   "end": 684.02,
   "text": "خودت هم به سمت قیامت خودت میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.02,
   "end": 686.72,
   "text": "اصلاً به قول عارف رومی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.72,
   "end": 690.88,
   "text": "اون روایت شریف رو که شعر کرده، حالا فرصت نیست شعرش رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.88,
   "end": 696.48,
   "text": "مضمونش اینه که شخصی به پیغمبر اعظم شرع اسلام رجوع کرد، ازش از قیامت پرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 696.48,
   "end": 699.06,
   "text": "از پیغمبر در خصوص قیامت پرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 699.06,
   "end": 701.56,
   "text": "ایشون نظم-- به نظم آورده این فرمایشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.56,
   "end": 706.66,
   "text": "می‌فرمود رفته پیش قیامت از قیامت پیرامون قیامت سؤال می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 706.66,
   "end": 709.78,
   "text": "این چه سؤالیه؟ مثل اینکه پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 709.78,
   "end": 712.34,
   "text": "کسی رو سا-- صدا زد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 712.34,
   "end": 716.02,
   "text": "اصحابش رو در مسجد شخص مشغول نماز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 716.02,
   "end": 718.52,
   "text": "پیغمبر صداش زد، دید جواب نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 718.52,
   "end": 721.12,
   "text": "نمازش که تموم شد اومد محضر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.12,
   "end": 724.12,
   "text": "افتاد به پای آقا عذرخواهی کرد. یا رسول الله ببخشید در نماز بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.12,
   "end": 726.4,
   "text": "پیغمبر چه نهیبی زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 726.4,
   "end": 728.36,
   "text": "فرمودن نماز تو رو صدا زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 728.36,
   "end": 731.8,
   "text": "سر نماز بودی؟ اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.8,
   "end": 735.86,
   "text": "آقامون علی ابن موسی الرضا پیرامون پیغمبر می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.86,
   "end": 738.3,
   "text": "سلام بر تو به پیغمبر عزیز عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 738.3,
   "end": 742.22,
   "text": "ای کسی که یا من شرفت الصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 742.22,
   "end": 744.38,
   "text": "بصلوات الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 744.38,
   "end": 749.44,
   "text": "ای کسی که نماز اصلاً شرافت پیدا کرده به جهت صلوات بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 749.44,
   "end": 754.34,
   "text": "کسی که در نمازش صلوات نمی‌فرسته نمازش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 754.34,
   "end": 756.72,
   "text": "اصلاً حقیقت نماز اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 756.72,
   "end": 758.92,
   "text": "حقیقت قیامت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 758.92,
   "end": 761.54,
   "text": "همه غیب اوست. همه شهود اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 761.54,
   "end": 764.5,
   "text": "انسان کامل همه اسما درش پیاده شده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.5,
   "end": 771.1,
   "text": "ما وقتی به خودمون هم دقت می‌کنیم می‌بینیم یکپارچه غیب و شهود در هم تنیده‌ایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 771.1,
   "end": 774.48,
   "text": "پیچیده‌ایم. از خودمون هم باید شروع کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 774.48,
   "end": 780.74,
   "text": "و اتفاقاً اونچه حالا این من فرود بیام بحث داشتیم می‌رفتیم بالا اوج بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 780.74,
   "end": 787.78,
   "text": "یه لحظه فکر کردم شب قدر رو چون ما دیشب اینجا صحبت می‌کردیم یک ساعت صحبت کردیم بندگان خدا رو خسته کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 787.78,
   "end": 791.68,
   "text": "یه لحظه داشتم اوج می‌گرفتم دیدم نه وقتم تموم شده فرود بیام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 791.68,
   "end": 799.04,
   "text": "اینجا فرود بیام. عزیز دلم اونچه که ما بعد از این صحنه مشاهده می‌کنیم و بهش مشکوکیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 799.04,
   "end": 806.56,
   "text": "تماماً اون صور و اشکالی که در نشئه در عالم برزخ خواهیم دید و با او محشوریم در خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 806.56,
   "end": 812.24,
   "text": "این در خود ماست یعنی چی؟ بفرمایید ببینم وقتی شما خوابیدی این هیکل چند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 812.24,
   "end": 816.6,
   "text": "کیلویی که اینجا افتاده این همه کثرات دیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 816.6,
   "end": 822.94,
   "text": "کوه و دشت و صحرا و دریا و آسمان‌ها و زمین مگه جا می‌شه تو شما تو این بدن چند کیلویی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 822.94,
   "end": 825.04,
   "text": "چقدر وسعت داره این کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.04,
   "end": 829.18,
   "text": "در غیب وجودته. همه این اشكال و سوری که دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 829.18,
   "end": 836.04,
   "text": "چرا این اشكال و صور رجه رفتند که به قول علامه مطلقاً این صور و اشكال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 836.04,
   "end": 838.76,
   "text": "همه و همه انشائات نفس ناطقه توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 838.76,
   "end": 841.02,
   "text": "تو ایجاد کردی اینا رو تو خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 841.02,
   "end": 844.26,
   "text": "بیرون از تو که این‌ها نیست. تو اینجا بود بدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 844.26,
   "end": 846.98,
   "text": "در خودته. چرا این صور و اشكال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 846.98,
   "end": 851.32,
   "text": "چون بیرون از خودت با این‌ها محشوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 851.32,
   "end": 856.38,
   "text": "کسی که با نور محشوره، خوابش هم نوره، با ظلمت، ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 856.38,
   "end": 858.3,
   "text": "همین، همین جز این هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 858.3,
   "end": 863.08,
   "text": "اتفاقاً حضرت ملاصدرا علیه الرحمة بحث که به اینجا می‌کشه در اسفارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 863.08,
   "end": 866.74,
   "text": "مثال زیبایی در مغبر بودن فضایا و وضوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 866.74,
   "end": 869.62,
   "text": "تصاویر و این‌ها می‌زنه مفصل بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 869.62,
   "end": 876.3,
   "text": "می‌رسه به جایی که می‌فرماید که اون مثلاً درختی که شما بیرون از خودت می‌بینی، این مثال خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 876.3,
   "end": 879.42,
   "text": "درختی که شما از خود بیرون از خودت می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 879.42,
   "end": 881.84,
   "text": "این درخت رو چگونه می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 881.84,
   "end": 884.6,
   "text": "این درخت که بیرون از شماست چند متر با شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 884.6,
   "end": 888.02,
   "text": "فاصله داره. در درون خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 888.02,
   "end": 891.76,
   "text": "خب بله یک صورتی این درخت بیرون از شما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 891.76,
   "end": 896.22,
   "text": "اما اون چیزی که شما داری می‌بینی در ثغء نفست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 896.22,
   "end": 902.0,
   "text": "یعنی در اون کمون غیبت، در اون باطنی‌ترین حالات خودت اون رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 902.0,
   "end": 906.06,
   "text": "اون درخت رو می‌بینی که اون معلوم به ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 906.06,
   "end": 909.44,
   "text": "مخصوصاً میگم این کلمات رو استفاده می‌کنم باهاش کار دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 909.44,
   "end": 913.88,
   "text": "حیف که وقت نیست و اون درخت بیرون معلوم بر عرضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 913.88,
   "end": 919.12,
   "text": "اصلاً کاری با اون نداریم ما. اونچی که تو دارایی تو شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 919.12,
   "end": 922.28,
   "text": "اون صورتی‌ست که در نفست افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 922.28,
   "end": 925.14,
   "text": "در خودت افتاد تو. الان امام عصر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 925.14,
   "end": 928.08,
   "text": "\"متى ترانا ونراك\" من شما رو کجا ببینم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 928.08,
   "end": 930.14,
   "text": "کجا قراره آقا تو ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 930.14,
   "end": 934.74,
   "text": "در درون خودت. در درون خودت قراره آقا رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 934.74,
   "end": 937.8,
   "text": "حالا هر کجا بود مهم نیست هر کجا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 937.8,
   "end": 942.06,
   "text": "آقا رو در درون خ-- اون صورت علمیه تو وجود خودته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 942.06,
   "end": 947.26,
   "text": "و این صور و اشكالی که در وجود ما هست، هست و هست و هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 947.26,
   "end": 953.5,
   "text": "و از بین رفتنی نیست. اون درختی که بیرونه رو می‌شه بسوزونیش، خاکسترش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 953.5,
   "end": 956.04,
   "text": "می‌شه بشکونیش شکل بهش بدی بکنیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 956.04,
   "end": 958.46,
   "text": "در مثلاً میز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 958.46,
   "end": 965.06,
   "text": "نمی‌دونم صندلی و... اما این درختی که در نفست بود دیگه هست و الی الابد خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 965.06,
   "end": 966.74,
   "text": "این قضای نفس تو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 966.74,
   "end": 968.94,
   "text": "اصلاً این شد عین نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 968.94,
   "end": 971.36,
   "text": "لذا اتحاد عالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 971.36,
   "end": 974.38,
   "text": "علم و عالم و معلوم اینجا خودش رو نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 974.38,
   "end": 980.4,
   "text": "مثل اتحاد عقل و عاقل و معقول که شب‌های قدر اینجا عزیزانی که بعضیا چهره‌ها رو می‌بینم بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 980.4,
   "end": 986.08,
   "text": "اونجا بحث کردیم که شما چیزی رو می‌خوری به قول شیخ الرئیس همه میت‌خواریم، مرده‌خواریم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 986.08,
   "end": 990.48,
   "text": "هرچی می‌خوریم حتی گیاه رو هم تو می‌کنی دیگه مرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 990.48,
   "end": 993.38,
   "text": "حیوان رو هم زنده زنده نمی‌خوری که، ذبحش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 993.38,
   "end": 1000.28,
   "text": "داری می‌خوری مرده‌خواری. این مرده میره به قول شیخ الرئیس کیمیایی که خدا در وجود ما قرار داده حیات پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1000.28,
   "end": 1003.96,
   "text": "این مرده میره خودت می‌شه همون، می‌شه وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1003.96,
   "end": 1007.72,
   "text": "تو همونی هستی که می‌خوری. لذا می‌گه طيب بخور، حلال بخور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1007.72,
   "end": 1009.58,
   "text": "با طهارت و با وضوء بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1009.58,
   "end": 1012.14,
   "text": "می‌خوری با ذکر بخور که اینا نور بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1012.14,
   "end": 1016.7,
   "text": "می‌خواد بشه تو. حالا اینچه که صور و اشكال من و شما می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1016.7,
   "end": 1020.74,
   "text": "اینا در نفس ما خواهد ماند الی الابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1020.74,
   "end": 1024.86,
   "text": "الله اکبر. ما همونی هستیم که خودمون داریم خودمون رو می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1024.86,
   "end": 1033.24,
   "text": "ما خلاصه‌ای هستیم از دیدن‌ها، شنیدن‌ها، چشیدن‌ها، گفتن‌ها، بوییدن‌ها، لمس کردن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1033.24,
   "end": 1036.62,
   "text": "توهم‌ها، تفکرها، تعقل‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1036.62,
   "end": 1042.86,
   "text": "تخیل‌ها و، و، و، و، و همه این قوای و محال قوا که دارن در کارن همه که ملائکه الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1042.86,
   "end": 1045.22,
   "text": "ما همینییم. چرا مشکوکیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1045.22,
   "end": 1048.4,
   "text": "جمله‌ی آخر. چرا مشکوکیم به غیب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1048.4,
   "end": 1050.84,
   "text": "به موت؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1050.84,
   "end": 1053.92,
   "text": "بفرمایید. چون اصلاً هشت و نهشتی با غیب نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1053.92,
   "end": 1059.66,
   "text": "از خودمون بگیر تا بیرون از خودمون اصلاً خبر از غیب نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1059.66,
   "end": 1061.76,
   "text": "موت قبل ان تموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1061.76,
   "end": 1063.68,
   "text": "یعنی همین الان بمیر. یعنی چی همین الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1063.68,
   "end": 1067.2,
   "text": "با چاقو بیان بخواهند بکشند. نه، همین الان سفر کن به غیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1067.2,
   "end": 1071.68,
   "text": "این می‌شه موت. همین الان سفر کن از ظاهر خودت به باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1071.68,
   "end": 1077.6,
   "text": "همون ادرارش هِی که نسبت به موت در خواب ایجاد می‌شه که ان النوم اخو الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1077.6,
   "end": 1080.12,
   "text": "ان‌شاءالله عاقبت هممون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1080.12,
   "end": 1083.1,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1083.1,
   "end": 1088.08,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1088.08,
   "end": 1091.84,
   "text": "على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}