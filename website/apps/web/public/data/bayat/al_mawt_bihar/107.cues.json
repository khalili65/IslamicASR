 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ روایت هشتم؛ کراهت ابراهیم و رضای مؤمنان",
   "start": 0.48,
   "end": 71.24
  },
  {
   "index": 1,
   "title": "## موت؛ سفر از ظاهر به باطن",
   "start": 71.24,
   "end": 208.38
  },
  {
   "index": 2,
   "title": "## تجلی سیدالشهدا و سبقت شهدای کربلا بر مرگ",
   "start": 208.38,
   "end": 378.17
  },
  {
   "index": 3,
   "title": "## اقرأ و ارتق؛ دینِ دفترچه",
   "start": 378.17,
   "end": 588.49
  },
  {
   "index": 4,
   "title": "## آیت‌الله بهجت؛ اندازهٔ ارتباط با امام عصر",
   "start": 588.49,
   "end": 657.13
  },
  {
   "index": 5,
   "title": "## علامه حسن‌زاده و سفره؛ سخن با برنج و هلو",
   "start": 657.13,
   "end": 820.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 8.68,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.68,
   "end": 12.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.62,
   "end": 17.36,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.36,
   "end": 22.0,
   "text": "صحبت ما پیرامون روایت هشتم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.0,
   "end": 25.46,
   "text": "کتاب الموت مرحوم مجلسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.46,
   "end": 30.6,
   "text": "رسیدیم به، در کشف دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.6,
   "end": 36.0,
   "text": "اینکه چرا حضرت ابراهیم کراهت گونه‌ای براش رخ داد بر قبض روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.0,
   "end": 38.1,
   "text": "لذا اون سؤال رو از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.1,
   "end": 46.42,
   "text": "قابض الارواح کرد. رسیدیم به اینکه خب تکلیف مؤمنین چی می‌شه وقتی خلیل الرحمن اون چنینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.42,
   "end": 54.24,
   "text": "هنگام موت چگونه راضی می‌شن اهل ایمان که عرض کردیم و چند تا روایت شیرین و قشنگ بیان کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.24,
   "end": 58.88,
   "text": "چه رفتارهایی می‌شه با اهل ایمان، با محب اهل بیت خاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.88,
   "end": 61.52,
   "text": "چه جلوه نمایی رخ می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.52,
   "end": 67.56,
   "text": "که این جلوه‌ای که رخ می‌ده، تجلی‌ای که حضرت حق برای اهل ایمان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.56,
   "end": 71.24,
   "text": "هنگام موت‌شون به یک معنا همون حقیقت موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.24,
   "end": 73.9,
   "text": "مگر ما نگفتیم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.9,
   "end": 79.98,
   "text": "ترجمه‌های شیرین عرفا از موت یعنی سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.98,
   "end": 82.08,
   "text": "سفر از ظاهر به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.08,
   "end": 84.02,
   "text": "سفر از ظاهر به باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.02,
   "end": 87.46,
   "text": "سفر از ظاهر به باطن انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.46,
   "end": 89.76,
   "text": "سفر از ظاهر به باطن کتاب خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.76,
   "end": 94.88,
   "text": "همه این‌ها هست نسبت به صعه وجودی که عرض کردیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.88,
   "end": 99.86,
   "text": "زحمت همه بزرگان اهل معرفت، خاصه در حکمت متعالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.86,
   "end": 105.12,
   "text": "و عرض تعلم از سنزده الله رحمة همونطور که قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.12,
   "end": 109.54,
   "text": "انسان کامل اگر کتاب بشود می‌شود قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.54,
   "end": 114.78,
   "text": "و اگر قرآن منشرح بشود باز بشود می‌شود نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.78,
   "end": 117.72,
   "text": "این کتاب جهان هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.72,
   "end": 122.34,
   "text": "یعنی کتاب آفاقی و کتاب کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.34,
   "end": 128.26,
   "text": "این دو شرح وجودی انسان کامل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.26,
   "end": 134.2,
   "text": "خب وقتی که انسان سفر می‌کنه به باطن عالم سفر می‌کنه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.2,
   "end": 135.96,
   "text": "یعنی میره به باطن قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.96,
   "end": 139.3,
   "text": "یعنی میره به باطن جهان نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.3,
   "end": 143.3,
   "text": "یعنی حقیقت این کوه و زمین و آسمان رو می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.3,
   "end": 147.86,
   "text": "می‌چشه بهش می‌رسه. می‌فهمه که این‌ها تجلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.86,
   "end": 151.98,
   "text": "حضرت حق‌اند. می‌فهمه این‌ها ظهور حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.98,
   "end": 155.92,
   "text": "می‌فهمه أنتم الفقراء إلى الله یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.92,
   "end": 159.7,
   "text": "که این‌ها نیستن. هرچه هستند ظهور حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.7,
   "end": 164.32,
   "text": "اینو می‌فهمه. به باطن قرآن سفر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.32,
   "end": 168.2,
   "text": "به باطن انسان کامل سفر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.2,
   "end": 174.12,
   "text": "اینکه ما عرض می‌کنیم که یکی از تجلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.12,
   "end": 178.54,
   "text": "یعنی اون نعمت‌های بسیار بالای بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.54,
   "end": 181.74,
   "text": "ظهور و کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.74,
   "end": 185.66,
   "text": "این بتون حقایق نظام هستی از هر جهت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.66,
   "end": 189.82,
   "text": "یعنی چه کتاب، چه انسان کامل، چه نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.82,
   "end": 193.18,
   "text": "این لحظه موت نسبت به صعه وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.18,
   "end": 196.18,
   "text": "مؤمن البته براش رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.18,
   "end": 200.26,
   "text": "برای کافر و مشرک و منافق هم رخ می‌ده اما اون‌ها نسبت به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.26,
   "end": 202.48,
   "text": "اسماء جلال حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.48,
   "end": 205.04,
   "text": "که جهنم تجلی جلال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.04,
   "end": 207.78,
   "text": "جلال سید الشهدا تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.78,
   "end": 210.08,
   "text": "اصلاً در روایات داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.08,
   "end": 213.78,
   "text": "مثلاً امام سجاد علیه الصلاة والسلام داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.78,
   "end": 217.54,
   "text": "خیلی شیرین. الان نمیدونم تا حالا رفتید کشف کنید علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.54,
   "end": 220.1,
   "text": "سبقت گرفتن بر موت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.1,
   "end": 224.98,
   "text": "در شهدای کربلا. دلایلی بزرگان براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.98,
   "end": 229.56,
   "text": "مطرح کردن. یکیش یکی از بهترین و قشنگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.56,
   "end": 232.3,
   "text": "و برهانی‌ترین و شیرین‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.3,
   "end": 236.02,
   "text": "دلایلش تجلی خود سید الشهداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.02,
   "end": 239.46,
   "text": "قبل از شهادت .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.46,
   "end": 242.86,
   "text": "ما گفتیم که مؤمن رو وقت موت‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.86,
   "end": 248.5,
   "text": "چهره انسان کامل و یا همون قرآن رو یا همون باطن نظام آفاقی رو نشونش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.5,
   "end": 255.68,
   "text": "انقدر غرق این لذت می‌شه که انّ اهل بیت او رو با محبت خودشون می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.68,
   "end": 262.62,
   "text": "اصلاً اهل بیت اراده من و شما رو ان شاء الله وقت موت از ما سلب می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.62,
   "end": 267.06,
   "text": "و با اراده محبت خودشون قبض روح ما می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.06,
   "end": 269.9,
   "text": "یعنی ما اصلاً از همه علاقه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.9,
   "end": 271.96,
   "text": "کنده می‌شویم ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.96,
   "end": 276.34,
   "text": "به اراده، به ارادت الرب که حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.34,
   "end": 279.46,
   "text": "امام حسین تجلی می‌کنه یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.46,
   "end": 283.58,
   "text": "یعنی این. یعنی اراده من و شما رو می‌کشه وقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.58,
   "end": 288.92,
   "text": "من و شما بی‌اراده می‌شیم. کالمیت بین یدي القصال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.92,
   "end": 291.16,
   "text": "مثل یک میتی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.16,
   "end": 295.04,
   "text": "دو دست قصاب هر طرف بخواد این ور اون ورش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.04,
   "end": 298.78,
   "text": "میت هم چی؟ اصلاً هیچ اراده‌ای از خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.78,
   "end": 303.9,
   "text": "لذا انسان کامل نسبت به درکی که تو از او داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.9,
   "end": 306.9,
   "text": "و ارتباطی که با او داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.9,
   "end": 312.4,
   "text": "و اون ر-- تجلی که او در وجود تو و در باطن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.4,
   "end": 317.76,
   "text": "در این نشئه طبیعت کرده، همونطور خودش رو به تو نشون میده و تو رو قبض می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.76,
   "end": 319.5,
   "text": "اراده او تحقق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.5,
   "end": 322.6,
   "text": "ولی اگر به اراده من باشه نمی‌تونم بمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.6,
   "end": 330.9,
   "text": "تعلقات اجازه نمیده. اون تجلی سید الشهدا حالا برای اهل ایمان فرمودن لب مرگ این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.9,
   "end": 334.6,
   "text": "اما برای شهدای اختصاص داره، استثناء داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.6,
   "end": 339.32,
   "text": "قبل از شهادتشون. حالا یه روایت میگه شب عاشورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.32,
   "end": 342.16,
   "text": "بعضیا میگن نه همون روز دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.16,
   "end": 345.58,
   "text": "که حالا امشب شب اوله، پس فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.58,
   "end": 350.18,
   "text": "روز دوم که حضرت خیمه‌ها رو بپا کرد همونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.18,
   "end": 353.44,
   "text": "همه رو تو دارالحرب جمع کرد و اونجا بیان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.44,
   "end": 356.7,
   "text": "دو-- فرمودن دو انگشت مبارکش رو باز کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.7,
   "end": 360.34,
   "text": "از لای بین دو انگشت حضرت دیدن همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.34,
   "end": 364.01,
   "text": "تجلیات رو دیدن یعنی حسین بن علی رو دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.01,
   "end": 367.73,
   "text": "یعنی باطن انسان کامل بلکه باطن خودشون رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.73,
   "end": 370.31,
   "text": "چون ما یک شأنی از شؤون امامی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.31,
   "end": 373.35,
   "text": "یک شأنی از شؤون انسان کاملیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.35,
   "end": 377.81,
   "text": "ما جدایی از او که نیستیم. در حقیقت میشه گفت باطن خودمون رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.81,
   "end": 381.23,
   "text": "بله در نشئه طبیعت میگیم آقا قرآن بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.23,
   "end": 382.97,
   "text": "اقرأ و ارقب. بخون بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.97,
   "end": 387.01,
   "text": "خب این قد بخوان بالا برو که امیرالمؤمنین به پسرش ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.01,
   "end": 388.99,
   "text": "محمد حنفیه گفته یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.99,
   "end": 391.77,
   "text": "یعنی بخون پول بگیر از خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.77,
   "end": 396.45,
   "text": "بخون بالا برو یعنی چی؟ یعنی قرآن بخون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.45,
   "end": 399.35,
   "text": "مثلاً جیبت خالی نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.35,
   "end": 402.35,
   "text": "سحر و جادوت پا-- باطل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.35,
   "end": 404.19,
   "text": "بلا ازت دفع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.19,
   "end": 406.93,
   "text": "اینا که خیلی لولش پایینه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.93,
   "end": 409.07,
   "text": "بخوان بالا برو اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.07,
   "end": 412.63,
   "text": "تعالى، بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.63,
   "end": 416.93,
   "text": "یه مثالی حضرت علامه حسن زاده دارن اینو خوب توجه کنید تورو خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.93,
   "end": 420.07,
   "text": "من خودمم به خودم میگم. حدیث نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.07,
   "end": 429.35,
   "text": "در شرح مصباح الانس مرحوم ابن فناری علامه حسن زاده در درس پونزدهم، ببینید درس پونزدهم اینو قشنگ توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.35,
   "end": 434.99,
   "text": "مثال علامه اینه. میگه اگر یه چرخ خیاطی رو بری بخری، حالا ما الان مثلاً میگیم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.99,
   "end": 439.09,
   "text": "گوشی همراه بخری. یه دفترچه همراهش بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.09,
   "end": 444.01,
   "text": "این دفترچه نوشته اگر گیر و گوری تو این وسیله اتفاق افتاد چه کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.01,
   "end": 446.65,
   "text": "چگونه باهاش تا کنی؟ روغن کاریش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.65,
   "end": 451.91,
   "text": "به قول علامه مثلاً چرم ندی زیر این چرخ خیاطی که برای دوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.91,
   "end": 454.49,
   "text": "البسه لطیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.49,
   "end": 456.71,
   "text": "ها؟ خرازی. نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.71,
   "end": 461.33,
   "text": "مثلاً یه پارچه برزنت نده زیر این سوزنش می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.33,
   "end": 466.01,
   "text": "و، و، و، و، اینطوری باهاش رفتار کن، اونطوری رفتار نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.01,
   "end": 467.87,
   "text": "این دفترچه بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.87,
   "end": 470.45,
   "text": "میگن دین این چرخ خیاطی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.45,
   "end": 472.67,
   "text": "دین این گوشی همراه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.67,
   "end": 474.79,
   "text": "دین اینه. آیین اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.79,
   "end": 478.57,
   "text": "بر اساس اون اگه بره جلو هیچ آسیبی نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.57,
   "end": 481.47,
   "text": "حالا اون دفتر حالا هر، هر وقتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.47,
   "end": 485.55,
   "text": "به هم بریزه، تنظیمش به هم بریزه میگن به روزش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.55,
   "end": 489.87,
   "text": "درسته؟ ریست که میگن، به روزش کن یعنی به دفترچه‌ش مراجعه کن، به روزش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.87,
   "end": 492.35,
   "text": "ببین چیکار باید بکنی، چه دکمه‌ای رو بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.35,
   "end": 495.75,
   "text": "اون دفترچه‌ای که ما رو به روز می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.75,
   "end": 500.73,
   "text": "اون دفترچه‌ای که دین و آیین ماست قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.73,
   "end": 504.27,
   "text": "ما باید خودمون رو با قرآن تطبیق بدیم، همه چیمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.27,
   "end": 511.09,
   "text": "حالا به میزانی که با قرآن تطبیق میدیم وجودمون رو، ظاهر و باطن‌مون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.09,
   "end": 519.97,
   "text": "مناسک‌مون رو، سیر و سلوک‌مون، سبک زندگیمون و چینش وسایل منزلمون و اسم‌گذاری فرزندان‌مون و انتخاب محل کارمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.97,
   "end": 525.95,
   "text": "و پوشش‌مون و خوراک‌مون و رفیق‌مون و همسایه‌مون و همه رو، همه رو، همه رو، همه رو بر اساس قرآن تطبیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.95,
   "end": 531.97,
   "text": "به میزان اینکه ما تطبیق دادیم وجودمون رو با قرآن، همون میزان وقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.97,
   "end": 535.07,
   "text": "اون برای ما تجلی می‌کنه، همون میزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.07,
   "end": 537.59,
   "text": "یعنی باطن این تجلیات رو ما می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 537.59,
   "end": 539.83,
   "text": "لذا اون‌ها که امام حسین خودشون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.83,
   "end": 545.37,
   "text": "خودش رو به ایشان نشون داد، تجلی کرد، یعنی باطن خودش رو نسبت به صعه وجودی اون‌ها نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.37,
   "end": 548.25,
   "text": "یه طهارتی داشتن \"لا یمسّه إلا المتهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.25,
   "end": 552.29,
   "text": "و به همون میزان شوق پیدا کردن برای شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.29,
   "end": 556.13,
   "text": "عابس لباس‌هاشو کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.13,
   "end": 559.15,
   "text": "میگه عریان شد. گفت بیاد یکی بیاد منو بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.15,
   "end": 561.99,
   "text": "کسی جرات نمی‌کرد بیاد. این، این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.99,
   "end": 566.11,
   "text": "این جز شوق و جز دیدن این تجلیات سید و شهدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.11,
   "end": 568.59,
   "text": "این باعث می‌شه که انسان چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.59,
   "end": 570.55,
   "text": "حتی حریص بشه برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.55,
   "end": 574.01,
   "text": "\"فتمنوا الموت إن كنتم صادقین\" اگه راست می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.01,
   "end": 578.97,
   "text": "تمنى اینجا معنای تهیه رو داره یعنی آمادگی برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.97,
   "end": 582.43,
   "text": "پس قرآن عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.43,
   "end": 587.85,
   "text": "دین ماست، آیین ماست و ما با اون به روز می‌شیم برای درک موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.85,
   "end": 592.83,
   "text": "به هر میزان اینجاست که آقای بهجت می‌فرمود می‌خواد به شما-- چقدر شیرین این جمله آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.83,
   "end": 598.25,
   "text": "اصلاً مال الانه. تو دل بحث ما انگار این جمله رو برای الان گفته ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.25,
   "end": 601.25,
   "text": "می‌خواید به شما آقای بهجت، می‌خواید به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.25,
   "end": 607.45,
   "text": "امام عصر عجل الله تعالی تشریف بیارن چقدر اجازه دارید با ایشون ارتباط بگیرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.45,
   "end": 610.71,
   "text": "آقا، آقا بیاد من همش بیست و چهار ساعت تو خیمه آقام فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.71,
   "end": 613.25,
   "text": "نه خیر. حساب کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.25,
   "end": 618.59,
   "text": "آقای بهجت فرمودن همون مقداری که الان با قرآن ارتباط دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.59,
   "end": 620.93,
   "text": "همون مقدار اجازه دارید با امام-- اصلاً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.93,
   "end": 627.07,
   "text": "جز این نیست. می‌خواید به شما من الان بگم با آموزه‌هایی که از اساتید گرفتیم، از علامه حسن زاده و دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.07,
   "end": 630.73,
   "text": "به شما جسارتا عرض کنم چه میزان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 630.73,
   "end": 634.91,
   "text": "اجازه داریم با قرآن ارتباط بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.91,
   "end": 638.45,
   "text": "یه پله بیایم عقب‌تر. به میزانی که کشف کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.45,
   "end": 640.83,
   "text": "باطن آسمان و زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.83,
   "end": 645.43,
   "text": "و همین اشیا و همین نظام افقی رو چون اون منشرح شده کتاب کتبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.43,
   "end": 651.71,
   "text": "اون کتاب افقیه. یعنی تو کوه رو می‌بینی \"أفلا ینظرون إلى الجبل كيف خلق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 651.71,
   "end": 654.83,
   "text": "یه شتر رو میگی، می‌بینی ازش رد نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 654.83,
   "end": 657.13,
   "text": "نگاش کن. نگاش کن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.13,
   "end": 660.09,
   "text": "چرا علامه حسن زاده با هیچکس هم‌غذا نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 660.09,
   "end": 663.89,
   "text": "یکی از شاگرداشون اینم بگم بس برای امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 663.89,
   "end": 667.11,
   "text": "این پرچَم مشکی‌ها، پیرهن مشکی‌های شما، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 667.11,
   "end": 672.17,
   "text": "پارچه‌ها، امام حسین، این ابا عبدالله، اینایی که زدید بیرقا یه ذره حال ما رو متفاوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.17,
   "end": 675.09,
   "text": "یه حرف‌های نگفته‌ای یا نگو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.09,
   "end": 680.09,
   "text": "چی میگیم از این چیزایی که نباید بگیم زدیم امروز یه ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 680.09,
   "end": 682.47,
   "text": "اون یکی از شاگردان ایشون می‌گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.47,
   "end": 686.77,
   "text": "خیلی تقلا می‌کردم دعوت کنم علامه رو یه روز ناهاری، شامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 686.77,
   "end": 690.13,
   "text": "ایشون قبول نمی‌کرد. می‌گفت شما نمی‌تونید، تحمل نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 690.13,
   "end": 693.51,
   "text": "گفت یعنی چی تحمل نمی‌کنیم؟ بشینید سر سفره با هم غذا بخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 693.51,
   "end": 695.87,
   "text": "بالاخره با اصرار ما ایشون پذیرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 695.87,
   "end": 698.35,
   "text": "خودش تعریف می‌کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.35,
   "end": 702.11,
   "text": "علامه رو که ما دعوت کردیم اومد سر سفره نشست فقط یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 702.11,
   "end": 709.51,
   "text": "ساعت داشت با این حبوبات و برنج و نون و آبی که تو سفره بود حرف می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 709.51,
   "end": 713.87,
   "text": "حالا ما باشیم میگیم العیاذ بالله مشکلی پیدا شده ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 713.87,
   "end": 717.43,
   "text": "ها؟ نمی‌فهمیم دیگه. ایشون باطن اینا رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 717.43,
   "end": 720.69,
   "text": "مثلاً حضرت آقای برنج، خب اونم از، اونم مظهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 720.69,
   "end": 722.97,
   "text": "به یک معنا ظهور خداست شده برنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.97,
   "end": 725.63,
   "text": "منتها شأنی از یکی از اسماء الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 725.63,
   "end": 727.23,
   "text": "این بحث‌ها قبلاً بین ما گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 727.23,
   "end": 729.47,
   "text": "دیگه چیزی وجود نداره جز ظهور حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 729.47,
   "end": 735.41,
   "text": "هرچه هست حقه. آقای برنج شما کجا بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.41,
   "end": 738.25,
   "text": "چقدر زیبا خدا تو رو تراشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.25,
   "end": 743.43,
   "text": "تا حالا کجا بودی؟ چقدر زحمت برای تو کشیدم تا تشریف بیاری سر این خانه نعمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 743.43,
   "end": 746.17,
   "text": "حالا من تو رو بخورم چگونه ادب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 746.17,
   "end": 748.87,
   "text": "تو رو نگه دارم؟ چگونه حرمت تو رو حفظ کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 748.87,
   "end": 751.73,
   "text": "آقا با برنج، با آب، با نون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 751.73,
   "end": 757.29,
   "text": "من خودم از حضرت علامه شنیدم که یه هلو خورده بود یک ساعت با هسته هلو حرف زده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.29,
   "end": 759.63,
   "text": "چقدر تو رو خدا زیبا آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 759.63,
   "end": 764.83,
   "text": "اون چیه تو در، در رحم تو خدا قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.83,
   "end": 767.33,
   "text": "اون هسته‌ای که در درون توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 767.33,
   "end": 769.57,
   "text": "اون بعداً می‌خواد نسل تو رو ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 769.57,
   "end": 773.35,
   "text": "اوه، اوه، اوه. حالا شما ببینید چقدر شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 773.35,
   "end": 776.35,
   "text": "ب-برگردیم به بحث. بریم به بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 776.35,
   "end": 778.25,
   "text": "یا قبل از مرگ که خیلی بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 778.25,
   "end": 784.09,
   "text": "موت قبل أن تموت. از لحظه موت به بعد این تجلیات برای انسان رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.09,
   "end": 787.09,
   "text": "که مر-- استاد حضرت علامه حسن زاده می‌فرمود البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 787.09,
   "end": 791.81,
   "text": "حضرت علامه در شرح فصوصش به نقل از استادش، استاد ایشون می‌گفت ای کاش بمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.81,
   "end": 793.65,
   "text": "ببینید ای کاش‌های علما چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 793.65,
   "end": 798.23,
   "text": "بمیریم. من میگم سیب و گلابی و حور و غصور و انهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 798.23,
   "end": 802.25,
   "text": "ایشون می‌گفت ای کاش بمیریم، بریم محضر امیرالمؤمنین مولا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 802.25,
   "end": 806.03,
   "text": "لسان مبارک خودش نهج‌البلاغه‌شو برای ما باز کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 806.03,
   "end": 811.61,
   "text": "که توش چیه. خب اینطوری باشه آدم چه شوقی برای رفتن پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.61,
   "end": 813.67,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 813.67,
   "end": 816.47,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 816.47,
   "end": 818.81,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 818.81,
   "end": 820.91,
   "text": "على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}