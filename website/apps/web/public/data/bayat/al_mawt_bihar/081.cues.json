 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 3.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.32,
   "end": 7.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.22,
   "end": 13.32,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.32,
   "end": 19.32,
   "text": "دیروز عرض کردیم که همه چی برگشته به نفس می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.32,
   "end": 25.0,
   "text": "نفس اگر تطهیر شده باشه، قوای نفس تطهیر شده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.0,
   "end": 27.14,
   "text": "نفس مطهر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.14,
   "end": 32.92,
   "text": "هرچی که در این وجود در این کاسه و ظرف وجودی می‌ریزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.92,
   "end": 38.88,
   "text": "خروجی خوبی داره. اما اگر خدایی نکرده نفس خبیث بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.88,
   "end": 41.38,
   "text": "نفس خبیث حتی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.38,
   "end": 46.74,
   "text": "نور هم در کاسه‌اش بریزی نور رو تبدیل به نار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.74,
   "end": 50.22,
   "text": "نور براش می‌شه جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.22,
   "end": 56.18,
   "text": "مثل مثالی که حضرت استاد علامه حسن زاده همیشه می‌زدن مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.18,
   "end": 58.2,
   "text": "نی-نوش و نیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.2,
   "end": 60.86,
   "text": "زنبور. زنبور عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.86,
   "end": 64.5,
   "text": "از یک شهد استفاده می‌کنه، زنبور وحشی هم از شهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.5,
   "end": 67.58,
   "text": "هر دو هم آب می‌خورن از یک چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.58,
   "end": 70.5,
   "text": "از یک آبشخور. هر دو یک چیز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.5,
   "end": 73.24,
   "text": "وارد می‌کنن در وجودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.24,
   "end": 78.74,
   "text": "اما از زنبور عسل نوش بیرون میاد، عسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.74,
   "end": 82.14,
   "text": "از زنبور وحشی نیش بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.14,
   "end": 83.76,
   "text": "موجبات آزار دیگرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.76,
   "end": 85.38,
   "text": "همش بر می‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.38,
   "end": 90.36,
   "text": "اون نفس. لذا بهترین کار دیگه بارها و بارها به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.36,
   "end": 95.92,
   "text": "حدیث نفس عرض کردم که یعنی ما اصلاً مهم‌تر از تهذیب نفس نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.92,
   "end": 103.04,
   "text": "کاری مهم‌تر از این نداریم که البته اون هم به قول استاد مبتنی‌ست بر معرفت نفس، شناخت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.04,
   "end": 105.96,
   "text": "خیلی مهمه که ما نفس رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.96,
   "end": 109.5,
   "text": "حالا در این مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.5,
   "end": 116.22,
   "text": "تهذیب نفس و نفس‌شناسی و کار کردن روی نفس انقدر انسان باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.22,
   "end": 122.12,
   "text": "رشد کنه بالا بره، بالا بره که ح-حتی دیگه بهشت هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.12,
   "end": 127.42,
   "text": "بهشت هم جواب زبان حالش رو نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.42,
   "end": 130.36,
   "text": "یعنی این مسیریه که اولیاء خدا برامون باز کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.36,
   "end": 137.76,
   "text": "اگر این تمنا، این استعداد، این خواهش، این زبان حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.76,
   "end": 140.88,
   "text": "این عین ثابت بگیم، این سر القدر بگیم چی میگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.88,
   "end": 143.54,
   "text": "در وجود ما نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.54,
   "end": 148.62,
   "text": "امام ما امیرالمؤمنین به ما توصیه نمی‌کرد که عبادت احرار بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.62,
   "end": 151.04,
   "text": "یعنی باید به اون سمت رفت که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.04,
   "end": 153.48,
   "text": "اصلاً توجهمون به بهشت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.48,
   "end": 156.7,
   "text": "حالا اینکه ما نفسمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.7,
   "end": 165.08,
   "text": "انشاالله که خبیث نیست. حالا چگونه‌ست از حیث پاک بودن و تطهیر قوای وجودی در چه سطح و رتبه‌ای داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.08,
   "end": 169.42,
   "text": "قرار گرفته که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.42,
   "end": 172.04,
   "text": "انبیا هم با هم متفاوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.04,
   "end": 174.46,
   "text": "این نشون میده که ما اهل چی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.46,
   "end": 176.86,
   "text": "ما این سلسله بحثمون رو چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.86,
   "end": 179.22,
   "text": "موت. گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.22,
   "end": 184.86,
   "text": "اون بما فیه چیزی که در موت وجود داره بستگی به نفس هر کسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.86,
   "end": 191.6,
   "text": "و عرض کردیم یکی از معانی مهم و دقیق موت یعنی دیدار خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.6,
   "end": 196.36,
   "text": "خودت برای خودت آشکار میشی. چگونه آشکار میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.36,
   "end": 201.38,
   "text": "به اینکه نفست خبیثه یا پاکه، تطهیر شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.38,
   "end": 207.88,
   "text": "اون موقع مشخص می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.88,
   "end": 212.78,
   "text": "یا . حالا شما وقتی همین جا رو که دقت می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.78,
   "end": 216.38,
   "text": "می‌بینی که حالا اون کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.38,
   "end": 218.88,
   "text": "هست کس-کسایی‌ان که بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.88,
   "end": 221.1,
   "text": "آیاتی که قبلاً خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.1,
   "end": 226.94,
   "text": "فرمود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.94,
   "end": 230.4,
   "text": ". اینا لقای ما رو امیدوارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.4,
   "end": 234.56,
   "text": "در پی‌ش هستن. اینا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.56,
   "end": 239.0,
   "text": "لقای ما رو دقت بفرمایید، نه بهشت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.0,
   "end": 243.18,
   "text": "اگر لقای خدا در بهشت حاصل می‌شه، بله اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.18,
   "end": 247.42,
   "text": "ما بلا عرض می‌ریم بهشت. اما به ذات فی Godایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.42,
   "end": 249.58,
   "text": "یعنی ذاتمون دنبال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.58,
   "end": 254.18,
   "text": "اون عارضه، ذات ما دنبال اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.18,
   "end": 259.54,
   "text": "و اگر هست، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.54,
   "end": 262.96,
   "text": "‌هاست. اطمینان کردن به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.96,
   "end": 266.56,
   "text": "اطمینانشون به دنیا بود. امیدشون به دنیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.56,
   "end": 270.42,
   "text": "اتفاقاً حالا اینا همه رو مقدمه گفتم برای نکته مهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.42,
   "end": 276.1,
   "text": "اتفاقاً شما وقتی که متن این روایت رو دقت می‌کنی، متن روایت چهارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.1,
   "end": 278.12,
   "text": "باب چهارم کتاب .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.12,
   "end": 281.68,
   "text": "می‌بینید وقتی که می‌خواد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.68,
   "end": 286.34,
   "text": "که موتشون موت مبارکی‌ست، برگشت به خودشون مبارکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.34,
   "end": 291.9,
   "text": "می‌خواد معرفی کنه می‌فرماید می‌رن به اون بالاترین درجات بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.9,
   "end": 296.3,
   "text": "اما می‌فرماید حالا اینا چه خصوصیتی داشتن که میرن به بهشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.3,
   "end": 301.44,
   "text": "اصلاً این بهشت عالیه برای کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.44,
   "end": 303.84,
   "text": "اهل دار الخلود. نمی‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.84,
   "end": 309.1,
   "text": "مثلاً در دار خ-- نه ها .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.1,
   "end": 312.32,
   "text": "یعنی اینا اهل آخرت بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.32,
   "end": 314.74,
   "text": "اهل معامله با خدا بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.74,
   "end": 317.42,
   "text": "اهل الله بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.42,
   "end": 320.44,
   "text": "نه اهل بهشت. حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.44,
   "end": 324.46,
   "text": "این خیلی با هم متفاوته. اتفاقاً باز ادامه حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.46,
   "end": 331.18,
   "text": "وقتی می‌فرماید اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.18,
   "end": 334.58,
   "text": "اونایی که با بدبختی و پشیمونی می‌میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.58,
   "end": 340.24,
   "text": "که برگشتشون خسران زده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.24,
   "end": 344.56,
   "text": "به سمت آتش میرن، باز می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.56,
   "end": 351.24,
   "text": "اینا این آتش برای کی تعبیه شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.24,
   "end": 356.02,
   "text": ". ما اهل کجاییم؟ کجا آباد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.02,
   "end": 358.52,
   "text": "جهنم آباد یا بهشت آباد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.52,
   "end": 361.02,
   "text": "حالا اصطلاحاً میگم کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.02,
   "end": 365.16,
   "text": "البته این آباد رو شاید بعضیا اشکال بگیرن که آقا دیگه جهنم که آباد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.16,
   "end": 367.64,
   "text": "چرا؟ اونجا، اونجا هم برای اهلش آباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.64,
   "end": 370.68,
   "text": "چون اون-اون‌ها هم به سمت کمالشون میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.68,
   "end": 375.3,
   "text": "کسی که شد مظهر اسم مذل خدا مثل شیطان کمالش هم میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.3,
   "end": 377.34,
   "text": "اینکه کامل بشه در این مظهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.34,
   "end": 381.38,
   "text": "در مظهریت مذل خدا بودن کامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.38,
   "end": 384.16,
   "text": "در اسماء جلال کامل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.16,
   "end": 386.52,
   "text": "که اوجش تو جهنم حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.52,
   "end": 389.06,
   "text": "حالا که بعد مباحث عقلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.06,
   "end": 398.18,
   "text": "یه عبارتی هست که خیلی از ف-فقها در شاید عرفای ما بهش خیلی توجه کردن، خیلی شیرین، همین حرفو داره تصویر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.18,
   "end": 401.68,
   "text": "ان العارفین اونایی که عارف‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.68,
   "end": 405.78,
   "text": "با بصیرت میرن جلو، اهل معنا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.78,
   "end": 409.24,
   "text": "اینا مع الله بذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.24,
   "end": 412.58,
   "text": "و مع الجنة بالعرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.58,
   "end": 416.56,
   "text": "اینا حالا یه جای دیگه تبدیل شده اهل الله اینچنینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.56,
   "end": 421.08,
   "text": "اهل الله‌اند. نه اینکه حالا بریم سمت الله ببینیم چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.08,
   "end": 426.84,
   "text": "بریم هیئت، بریم مسجد، یه ذره تیپ هیئتی و مذهبی و بسیجی و انقلابی و اینا به خودمون بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.84,
   "end": 430.26,
   "text": "پر-پرستیژ مثلا مدیران انقلابی رو به خودمون بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.26,
   "end": 432.42,
   "text": "ما اومدیم خدمت کنیم بریم ببینیم چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.42,
   "end": 435.58,
   "text": "نه. اهل الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.58,
   "end": 441.02,
   "text": "اونم اه-- الله که اسم جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.02,
   "end": 447.74,
   "text": "که اون مصداق بیرونیش به صورت اتم الله اسم جامعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.74,
   "end": 453.16,
   "text": "مصداق اتمش میشه پیغمبر، میشه انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.16,
   "end": 463.08,
   "text": "وقتی به این توجه می‌کنی مثلا شما بری به سمت یکی از وجوه اخلاقی پیغمبر بهتره یا همه وجوه اخلاقیشو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.08,
   "end": 466.02,
   "text": "بعضیا خیلی حلیم‌اند، بردبارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.02,
   "end": 471.02,
   "text": "خب خیلی خوب، عالی. توی این قصه خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.02,
   "end": 474.26,
   "text": "اما یه دفعه مثلا سوء زن دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.26,
   "end": 477.06,
   "text": "زنش رو نتونسته کن-کنترل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.06,
   "end": 479.62,
   "text": "خب به سمت همه اخلاق باید رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.62,
   "end": 484.68,
   "text": "همه یه بسته است. نمیشه یکیشو بگیری مثلا روزه بگیری بعضیا اینطورین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.68,
   "end": 487.76,
   "text": "من دیدم روزه می‌گیرن نماز نمی‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.76,
   "end": 491.16,
   "text": "خب این چی-- چه فا-فایده‌ای داره؟ باید رفت به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.16,
   "end": 493.56,
   "text": "اهل الله شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.56,
   "end": 501.72,
   "text": "اونم نه به تمای بهشت. اینجا می‌فرماید عارفین که حالا همین چیزی که ما داریم می‌گیم مع الله بذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.72,
   "end": 504.72,
   "text": "اصلاً ذاتا مع الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.72,
   "end": 507.96,
   "text": "عاشق الله‌اند نه بهشت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.96,
   "end": 511.8,
   "text": "و مع ال-- بله مع الجنة هم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.8,
   "end": 516.14,
   "text": "با جه-- با بهشت هم هستن اما مع الجنة بالعرض یعنی بهشتو بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.14,
   "end": 520.3,
   "text": "دادن. اینا دنبالش نرفتن حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.3,
   "end": 523.24,
   "text": "ما الان میریم کربلا. آقا برای چی رفتی کربلا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.24,
   "end": 525.94,
   "text": "دو تا-- مریض-- آقا کربلا برای چی رفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.94,
   "end": 528.14,
   "text": "رفتیم ما از قافله جوانمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.14,
   "end": 532.44,
   "text": "از این اصطلاحی حرفای پیش پا افتاده زشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.44,
   "end": 534.98,
   "text": "دیروز عرض کردم برای چی گ-رفتی کربلا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.98,
   "end": 536.96,
   "text": "نه دلم خواست، دلم منو آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.96,
   "end": 538.92,
   "text": "نمی‌دونم. اصلا قاعده ند--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.92,
   "end": 541.58,
   "text": "یعنی نمیشینه براش به دو تا چهار تا بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.58,
   "end": 543.64,
   "text": "این اهل کربلائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.64,
   "end": 546.88,
   "text": "اهل امام حسین. توجه کردید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.88,
   "end": 552.84,
   "text": "حالا بقیه‌ش هم می‌فرماید و ان اهل الجنة حالا اونایی که عاشق بهشتن، اهل بهشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.84,
   "end": 555.6,
   "text": "مع الجنة بذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.6,
   "end": 557.96,
   "text": "اصلاً ذاتا دنبال بهشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.96,
   "end": 561.62,
   "text": "دنبال حور ال این و قصر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.62,
   "end": 563.94,
   "text": "انهار اینج-- خوششون میاد از این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.94,
   "end": 567.78,
   "text": "می‌گه خب بهشت این چیزا پره دیگه بسم الله ما خوب بشیم که بریم بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.78,
   "end": 571.34,
   "text": "و حالا اینا با خدا هم هستن که بهشت میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 571.34,
   "end": 574.78,
   "text": "اما چگونه با خدااند؟ و مع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.78,
   "end": 577.5,
   "text": "بال، بذات یا بالعرض؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.5,
   "end": 582.02,
   "text": "بالعرض. این خدا هم بالاخره خدا بهشتو بهشون داده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.02,
   "end": 585.64,
   "text": "اما بالعرض با خدا، ذاتا با خدا نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.64,
   "end": 592.82,
   "text": "اینا خیلی با هم متفاوته. یه کسی بره دنبال پیغمبر به خاطر خ-- به عشق خود پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.82,
   "end": 595.96,
   "text": "یا نه کسی بره دنبال پیغمبر بگه الان نون تو اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.96,
   "end": 599.66,
   "text": "حالا یا نون دنیایی یا نون اخروی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.66,
   "end": 602.6,
   "text": "اتفاقا بلایی که سر انقلاب ما اومده اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.6,
   "end": 607.94,
   "text": "کسایی اومدن پست گرفتن تو کشور ما، مدیریت‌های مختلفو گرفتن، اینا که خیلیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.94,
   "end": 612.94,
   "text": "اینا یعنی بذات انقلابی نیستن بالعرض انقلابی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.94,
   "end": 617.06,
   "text": "از همینجا در میاد. یعنی بالاخره یه نوندونه‌ای باشه، یه پولی در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 617.06,
   "end": 620.22,
   "text": "ما حالا در کنارش یه خدمتی هم می‌کنیم حرف has--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 620.22,
   "end": 626.58,
   "text": "تا ماشین زیر پایم نباشه، مأموریت امضا نشه، پول مأمور-- حق مأموریت اینا من برای چی برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 626.58,
   "end": 629.98,
   "text": "اگه فلان و به-- یعنی اینها بوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.98,
   "end": 633.06,
   "text": "ذاتی نمیده. دیگه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.06,
   "end": 636.88,
   "text": "به این سمت بریم بعد از اینکه سیره امام‌شون بره تو هم و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 636.88,
   "end": 641.06,
   "text": "بذارید سیر بحثو بریم. باید اهل الله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 641.06,
   "end": 643.52,
   "text": "یه بار دیگه متن رو بخونم براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 643.52,
   "end": 645.46,
   "text": "ببینید می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.46,
   "end": 649.48,
   "text": "اون جنت عالیه لاهل دار الخلوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 649.48,
   "end": 651.56,
   "text": "اهل خدا‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.56,
   "end": 656.18,
   "text": "و دار همیشگی‌اند. بعد دو مرتبه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 656.18,
   "end": 659.18,
   "text": "ناره hamyه برای کیه؟ لاهل دار القرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 659.18,
   "end": 666.02,
   "text": "اینا اهل دنیا بودن یا حتی تو لباس دین هم اومدن، نماز هم خوندن، جهاد هم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 666.02,
   "end": 672.12,
   "text": "آقا ب-ب لباس پیغمبر تنش کرد حتی مجتهد شد، مرجع تقلید شد اما چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 672.12,
   "end": 678.62,
   "text": "اهل دار القروره می‌بینی موته بدی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.62,
   "end": 681.64,
   "text": "تبعات زیادی-- یعنی خیلی‌ها رو هم به انحراف می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.64,
   "end": 689.34,
   "text": "اینو از حضرت امام ما شنیدیم بارها گفتم تو رادیو معارف یا قرآن بود پخش میشد از خود امام داشت توصیف می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 689.34,
   "end": 694.98,
   "text": "با یه حال عجیبی با تعجب که رفته بود لحظه احتضار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.98,
   "end": 702.3,
   "text": "یه-- ایشون می‌گفت یه مرجع، مجتهدی که چقدر شاگرد، کتاب، درس، بحث، مدرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.3,
   "end": 705.3,
   "text": "بعد وقتی که بهش گفته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 705.3,
   "end": 708.16,
   "text": "قل هو الله الا الله مثلا شهادتین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 708.16,
   "end": 714.48,
   "text": "شروع کرد به غضب کردن به خدا و فحش و دری وری علیه عذ-- به الله که خدایا آخه الان وقت بردن من بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 714.48,
   "end": 717.78,
   "text": "الان که بچه‌هام بزرگ شدن می‌خوام عروس و دامادشون کنم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 717.78,
   "end": 723.08,
   "text": "ببینید بحث یه عالم ظاهری با خدا وقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.08,
   "end": 725.52,
   "text": "این اهل دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 725.52,
   "end": 728.66,
   "text": "ظاهرا تو لباس دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 728.66,
   "end": 731.43,
   "text": "اهل الله باید شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 731.43,
   "end": 733.87,
   "text": "اهل الله باید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 733.87,
   "end": 736.83,
   "text": "اهل تقوا و مغفرت باید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 736.83,
   "end": 742.21,
   "text": "این همه پیغمبر اومد دستشو درست کرده دستتو بدید به من بیاید اهل الله بشید، نه اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 742.21,
   "end": 746.13,
   "text": "حوری و بهشتی و نهر و قصور و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 746.13,
   "end": 748.65,
   "text": "اتفاقا این حکایت شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 748.65,
   "end": 755.61,
   "text": "الان جاشه بشنوید حکایت شیرینی که حالا ما جایی ندیدیم حضرت علامه حسن زاده هم تو درس و شرح فصوصشون می‌فر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 755.61,
   "end": 757.45,
   "text": "فرمودن الان صداهاشون هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 757.45,
   "end": 763.85,
   "text": "فرمودن منم اینجا جایی اینو ندیدم ولی به نقل از استادشون حضرت علامه رفیع قزوینی فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 763.85,
   "end": 769.75,
   "text": "ایشون می‌فرمودن که ملاصدرا در اصفهان رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 769.75,
   "end": 772.13,
   "text": "حمام. خب عالمان بزرگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 772.13,
   "end": 775.15,
   "text": "ملاصدرا رو تو حموم گیر آوردن ریختن دورش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 775.15,
   "end": 777.15,
   "text": "سؤال و جواب و سؤال و جواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 777.15,
   "end": 780.05,
   "text": "بعد هی ازش پرسیدن فلانی بالاتره یا میر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 780.05,
   "end": 783.93,
   "text": "میر حالا دیگه استاد نفرمود میر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 783.93,
   "end": 789.89,
   "text": "اممم میر داماد منظوره یا میر فندرسکی چون هر دو تا استاد ملاصدرا بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 789.89,
   "end": 793.03,
   "text": "ایشون سؤال شده بود که میر بالاتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 793.03,
   "end": 797.81,
   "text": "یا هی ازش می‌پرسیدن. تو همون اثنا حضرت آقای میر تشریف میارن داخل حمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 797.81,
   "end": 800.75,
   "text": "میرن تو یه خزینه‌ای اینور بحثاشونو گوش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 800.75,
   "end": 803.55,
   "text": "می‌بینن که هرچی از ملاصدرا می‌پرسن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 803.55,
   "end": 807.63,
   "text": "فلانی بالاتره یا میر؟ میگه میر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 807.63,
   "end": 811.95,
   "text": "فلانی بالاتره یا میر؟ ملاصدرا که استادش میر بوده میگه میر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 811.95,
   "end": 816.51,
   "text": "تا می‌رسن به این سؤال که ارسطو بالاتره یا میر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 816.51,
   "end": 819.13,
   "text": "ملاصدرا متأمل میشه جواب نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 819.13,
   "end": 821.93,
   "text": "سرشو میزاره پایین فکر می‌کنه. س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 821.93,
   "end": 828.33,
   "text": "حضرت میر سرشو از خزانه میاد بیرون میگه به آقایون بفرمایید میر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 828.33,
   "end": 830.89,
   "text": ". میر بالاتر از ارسطوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.89,
   "end": 832.97,
   "text": "بعد جوابش دلیلش خودش میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 832.97,
   "end": 835.33,
   "text": "می‌فرماید که ما پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 835.33,
   "end": 837.47,
   "text": "م-مقام ختمی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 837.47,
   "end": 842.37,
   "text": "ما شاگردان مقام ختمی پیغمبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 842.37,
   "end": 844.79,
   "text": "یه سر و گردن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 844.79,
   "end": 847.01,
   "text": "تابع و انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 847.01,
   "end": 853.49,
   "text": "پیشین بالاترین. این نگاه رو ببین چه عزت نفسی به انسان میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 853.49,
   "end": 859.13,
   "text": "که شما با امیرالمؤمنین باشی، با پیغمبر و حضرت زهرا باشی شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 859.13,
   "end": 865.19,
   "text": "با امام حسینی باشی که توبه حضرت آدم به واسطه گریه بر او پذیرفته شده تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 865.19,
   "end": 870.01,
   "text": "معالحسین باشی. این خیلی بالاتر تو مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 870.01,
   "end": 873.61,
   "text": "به طمع چیزی بری سمت امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 873.61,
   "end": 878.03,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 878.03,
   "end": 886.87,
   "text": "اللهم صل على محمد و آل محمد عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}