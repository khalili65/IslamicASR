 "chapters": [
  {
   "index": 0,
   "title": "## حقیقت موت؛ انتقال از سرایی به سرای دیگر",
   "start": 14.48,
   "end": 77.58
  },
  {
   "index": 1,
   "title": "## روایت کثیرالفروع؛ فساد جسد در دنیا",
   "start": 77.58,
   "end": 145.1
  },
  {
   "index": 2,
   "title": "## یرجع کلٌّ إلی جوهره الأول",
   "start": 145.1,
   "end": 233.68
  },
  {
   "index": 3,
   "title": "## اگر بدن‌ها و نباتات تجزیه نمی‌شدند",
   "start": 233.68,
   "end": 332.46
  },
  {
   "index": 4,
   "title": "## نفوس قوی و بقای بدن؛ ابن‌بابویه و حر",
   "start": 332.46,
   "end": 467.72
  },
  {
   "index": 5,
   "title": "## بدن معطر و بدن محروم؛ طیب و خبیث",
   "start": 467.72,
   "end": 697.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.14,
   "end": 3.96,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 11.58,
   "text": "مال God الصالحین. السلام علیکم یا اهل بیت نبوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.58,
   "end": 14.48,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.48,
   "end": 17.44,
   "text": "بحث موت بحث بسیار مهم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.44,
   "end": 21.4,
   "text": "پیچیده‌ای‌ست البته. اطلاعات ما نسبت به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.4,
   "end": 25.22,
   "text": "متاسفانه خیلی ناقصه و بعضا اشتباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.22,
   "end": 30.12,
   "text": "پیغمبر عزیز عالم فرمودند که إنما تنتقلون من دار إلى دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.12,
   "end": 35.08,
   "text": "اصلا حقیقت موت این هست که شما را از داری به دار دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.08,
   "end": 37.88,
   "text": "می‌بره. منتقل شدن، انتقاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.88,
   "end": 41.9,
   "text": "مرگ، موت به معنای فنا و از بین رفتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.9,
   "end": 49.08,
   "text": "لذا بسیار پیچیده‌ست. اگر ما به احادیث موت رو یه مقدار توش تأمل بیشتری می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.08,
   "end": 52.5,
   "text": "شما هم الحمد لله صبورید خدا خیرتون بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.5,
   "end": 54.24,
   "text": "این رو به نفع هممونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.24,
   "end": 58.58,
   "text": "حالا دیروز ما برنامه ما اون ده دقیقه بسته شد صحبت‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.58,
   "end": 61.28,
   "text": "دیروز به جهت اون مهم بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.28,
   "end": 66.78,
   "text": "نکته‌ی دیروز شد حدود پونزده دقیقه شما اون نجابت رو خرج دادید هیچی نگفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.78,
   "end": 73.04,
   "text": "ممنونم ازتون. تا امروز که دیگه بچه‌ها منبر هم گذاشتن میگه پایین آوردن ما از منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.04,
   "end": 76.44,
   "text": "کار دشواریه. انشاالله خدا برکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.44,
   "end": 79.38,
   "text": "این مخصوصا این روایت چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.38,
   "end": 84.26,
   "text": "کتاب ولایت مردم مجلس خیلی کثیر الفروعه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.26,
   "end": 91.98,
   "text": "یعنی عرض کردم اهلش هم الان بیست سال باید یک سال با این منبر با این روایت، واقعا چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.98,
   "end": 94.98,
   "text": "یکی از موهبت‌های حضرت حق به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.98,
   "end": 99.18,
   "text": "نظام هستی و خاصه در مشرق طریقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.18,
   "end": 102.96,
   "text": "اصلا همین نکته‌ایه است که در این روایت اومده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.96,
   "end": 106.7,
   "text": "فرمود و انما فسد الجسد في الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.7,
   "end": 109.78,
   "text": "جسد تو دنیا فاسد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.78,
   "end": 114.92,
   "text": "حالا بعد ادامه‌ی روایت تو همین روایت می‌فرماید و یرجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.92,
   "end": 117.4,
   "text": "کل کلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.4,
   "end": 120.52,
   "text": "چه روح و نور برگردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.52,
   "end": 125.46,
   "text": "چه جسم از روح خارج بشه که درستش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.46,
   "end": 128.48,
   "text": "بگیم جسم از روح خارج میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.48,
   "end": 131.18,
   "text": "نه روح از جسم. چون جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.18,
   "end": 134.62,
   "text": "در دل روحه. ما برعکس فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.62,
   "end": 139.08,
   "text": "چه این اتفاق بیو-- اینجا می‌فرماید حالا چه جسم باشه، چه روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.08,
   "end": 142.78,
   "text": "ارجاع به کجاست؟ رجوع جسم به کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.78,
   "end": 145.1,
   "text": "رجوع روح به کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.1,
   "end": 147.9,
   "text": "اینجا می‌فرماید و یرجع کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.9,
   "end": 150.46,
   "text": "کلا الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.46,
   "end": 152.8,
   "text": "جوهره الاول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.8,
   "end": 159.36,
   "text": "به به. حالا این جوهره الاول رو اومد که عزیزانی که دیروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.36,
   "end": 169.62,
   "text": "پیرامون جوهره ما، اون ابتدا، اون ماده اولیه ما، اون جوهر اول، اون صادر اول، صادر مخصوصین، اون نفس الرحمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.62,
   "end": 173.3,
   "text": "اون برزخ بین حق و خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.3,
   "end": 175.3,
   "text": "که نه خلق نه حق نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.3,
   "end": 181.86,
   "text": "خالق اینها ما عرض کردیم الان متوجه میشین جوهره روح چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.86,
   "end": 184.34,
   "text": "اینجا میگه کلا برگشت ما به اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.34,
   "end": 186.7,
   "text": "که ما دیروز گفتیم این میشه نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.7,
   "end": 189.1,
   "text": "مقدس، فیض مقدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.1,
   "end": 193.1,
   "text": "نه ابتر که علم الهی. حالا نکته کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.1,
   "end": 195.4,
   "text": "جسم به کجا برگرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.4,
   "end": 198.64,
   "text": "اونم به جوهرش، به اون سه اولیه‌ش که چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.64,
   "end": 200.64,
   "text": "ماده‌ست. همین مشرق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.64,
   "end": 204.74,
   "text": "باید برگرده. این جسم نمیشه منتقل بشه به اونور چون اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.74,
   "end": 209.48,
   "text": "عالم مجرداته، اینجا ماده‌ست، اینجا ذی داره، اینجا صعه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.48,
   "end": 216.5,
   "text": "اصلا نمیشه این ها. لذا اینجا باید بدونید از موهبات الهی این فاسد شدنه، اینو می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.5,
   "end": 221.78,
   "text": "این تجزیه شدن و برگشتن به عناصر اولیه از موهبات الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.78,
   "end": 228.92,
   "text": "که تعبیر دیگه‌ای می‌گفتن اگر این نبود، همین یه دونه، همین یه دونه موهبت الهی که اینجا امام صادق سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.92,
   "end": 233.68,
   "text": "انوشیرین فرموده و رفت رد شده برای اهلش واگذار کرده، نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.68,
   "end": 239.76,
   "text": "یعنی قرار بود بدن‌ها نپوسه اصطلاحا، تجزیه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.76,
   "end": 243.92,
   "text": "یا حتی درخت‌ها، نباتات، حیوانات اینا فکر کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.92,
   "end": 247.36,
   "text": "تجزیه نمی‌شدن. خب؟ وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.36,
   "end": 250.58,
   "text": "بدن به اون استعدادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.58,
   "end": 255.3,
   "text": "به تمامه به فعلیت رسید، حالا سنش هر جا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.3,
   "end": 257.48,
   "text": "تمام میشه. کار تمام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.48,
   "end": 260.6,
   "text": "وقتی این استعداد‌هاش، اون قوا وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.6,
   "end": 266.7,
   "text": "بالفعل شد. هرچی تو بدن هست فعلیت پیدا کرد، اون قوا ریخت بیرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.7,
   "end": 269.54,
   "text": "تمام میشه رابطه. روح از بدن جدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.54,
   "end": 271.28,
   "text": "این می‌خواد اون رو به کمال برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.28,
   "end": 273.92,
   "text": "تمام میشه و روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.92,
   "end": 276.54,
   "text": "بدن رو رها می‌کنه اصطلاحا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.54,
   "end": 278.96,
   "text": "روح جسم رو رها می‌کنه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.96,
   "end": 280.92,
   "text": "جسم از بدن خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.92,
   "end": 287.6,
   "text": "بد-- جسم باید برگرده. جسم از روح خارج میشه، روح باید برگرده به سمت جوهر اولش که صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.6,
   "end": 293.56,
   "text": "جسم باید برگرده به طبیعت. و اگر این اتفاق نمی‌افتاد حتی در نباتات، یعنی درخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.56,
   "end": 297.98,
   "text": "درختم وقتی به اون حد کمال خودش رسید می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.98,
   "end": 301.38,
   "text": "درختم می‌میره، حیوون هم می‌میره، انسان هم می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.38,
   "end": 306.42,
   "text": "اگر این‌ها تجزیه نمی‌شدن یک عالم متعفنی داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.42,
   "end": 309.88,
   "text": "که اصلا حیات ادامه پیدا نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.88,
   "end": 315.16,
   "text": "شما تصور کنید که بدن انسان‌ها الان چقدر ما آدم توی کره زمین مردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.16,
   "end": 318.78,
   "text": "دفن شدن. دوره‌های پیشین هم تازه در نظر بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.78,
   "end": 321.48,
   "text": "هر دوره چند میلیارد آدم ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.48,
   "end": 323.98,
   "text": "ألف، ألف دوره امام صادق فرمود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.98,
   "end": 326.9,
   "text": "ألف، ألف دوره داشتیم و خواهیم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.9,
   "end": 329.6,
   "text": "هزاران دوره. لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.6,
   "end": 338.98,
   "text": "چقدر آدما اومدن، چقدر-- حتی اگر بگیم که به جهت بزرگ شدن روح عده‌ای عظمت روحیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.98,
   "end": 341.88,
   "text": "و اینو بعدا انشاالله توضیح میدیم در قسمت‌های بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.88,
   "end": 345.64,
   "text": "و تعلق روح به بدن که نه اسمش نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.64,
   "end": 347.62,
   "text": "تعلق روح به بدن که اسمش نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.62,
   "end": 351.58,
   "text": "یعنی می‌خواد بدن رو مدیریت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.58,
   "end": 356.48,
   "text": "از این جهت کسایی که روحشون قویه یا نفسشون قویه ببین بدنشون رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.48,
   "end": 358.34,
   "text": "هنوز مدیریت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.34,
   "end": 361.16,
   "text": "یعنی چی؟ مثل ابن بابویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.16,
   "end": 365.44,
   "text": "که قصرش که تخریب شد اومدن بسازن دیدن قصر همین صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.44,
   "end": 367.9,
   "text": "مثل حر، حر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.9,
   "end": 371.88,
   "text": "تو عراق و خیارانا رفتید قبرشونو که جدیده قبرش اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.88,
   "end": 375.2,
   "text": "قبلاً خیلی بدی بود ما می‌رفتیم بد-- خیلی داغون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.2,
   "end": 377.94,
   "text": "قدیمی بود، خیلی خشتی و اینا الان تمیز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.94,
   "end": 381.1,
   "text": "چرا؟ خب تخریب شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.1,
   "end": 383.2,
   "text": "قسمتی از قبر داخلش معلوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.2,
   "end": 385.84,
   "text": "باز کردن دیدن بدن سالم حر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.84,
   "end": 391.12,
   "text": "شهید کربلا تن شهیدیه که سر از تنش جدا نشده بود سر از، سر تو بدن بود راحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.12,
   "end": 395.72,
   "text": "اونجا بود. و حتی دستمال زردی که ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.72,
   "end": 398.46,
   "text": "به فیشانش بسته بود هنوز اون halte.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.46,
   "end": 401.32,
   "text": "اینو تو تاریخ عراق نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.32,
   "end": 403.3,
   "text": "و عجیبه که این دستمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.3,
   "end": 407.92,
   "text": "برکی می‌دونستن تو روایت اومده دستمال آقا بسته کم به از فیشان خون پاشیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.92,
   "end": 412.22,
   "text": "خونی تازه از فیشان حر زد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.22,
   "end": 418.86,
   "text": "نه، هرچی دستمال بستن نمیشد تا مجبور شدن دوباره همین دستمال امام حسین رو بستن، خون بند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.86,
   "end": 422.06,
   "text": "خب این چی میشه؟ این بزرگ شدن روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.06,
   "end": 426.14,
   "text": "خب؟ اگر بگیم اخ، اخ دوره اومده رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.14,
   "end": 429.24,
   "text": "آدم اومده رفته بدن‌های این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.24,
   "end": 434.42,
   "text": "اگر همینجور باقی بمونن در زمین، چقدر انبیا داشتیم، اولیا داشتیم برای ا...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.42,
   "end": 436.8,
   "text": "ائمه‌ی پیشین. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.8,
   "end": 441.32,
   "text": "دوره‌های پیشین بر اثر، بر اثر رد و فتح تموم شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.32,
   "end": 449.32,
   "text": "این بدن‌ها حتی اینایی هم که روحشون بزرگ شده حتی انبیا اگر روحشون می‌مونده بدنشون در همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.32,
   "end": 452.24,
   "text": "دنیا می‌مونده باشه چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.24,
   "end": 454.62,
   "text": "پس اونا هم بالاخره تجزیه میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.62,
   "end": 459.86,
   "text": "اینطوری نیست که حالا بگیم که یه بدنی به جهت عظمت روحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.86,
   "end": 464.08,
   "text": "می مونه ولی فوقش تا انتهای دوره خودش می مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.08,
   "end": 467.72,
   "text": "یعنی دوره ما تموم شد بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.72,
   "end": 470.2,
   "text": "این بدن‌ها تجزیه میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.2,
   "end": 474.02,
   "text": "اینه که بعضیا رو میبینی بدنشون بو-- حالا اینا رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.02,
   "end": 482.06,
   "text": "خواهشا با یه احتیاطی میگم چون میره بالاخره تو کانال و رسانه‌ای میشه ولی خوشنامه‌های قوی براش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.06,
   "end": 485.82,
   "text": "قبلاً هم اینا رو گفتیم زیر برنامه که من راحت میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.82,
   "end": 488.84,
   "text": "اگر بعضیا خوش عطر بدنشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.84,
   "end": 491.3,
   "text": "پس یه عطر خاصی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.3,
   "end": 494.06,
   "text": "یا مثلا بدنشون برکت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.06,
   "end": 497.1,
   "text": "همین جسمشونا، جسم بدنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.1,
   "end": 501.04,
   "text": "زیاد تردد می‌کنند در محیط‌های معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.04,
   "end": 503.3,
   "text": "این بدن هم رز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.3,
   "end": 508.46,
   "text": "هر بدنی لیاقت نداره بره حرم سید الشهدا، بره تو هیئت، بره تو مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.46,
   "end": 513.0,
   "text": "این بدن‌ها همین جسمت، روحت که میگه هیچ همین بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.0,
   "end": 515.04,
   "text": "این بدن بالاخره از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.04,
   "end": 518.06,
   "text": "از عناصر اولیه. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.06,
   "end": 520.34,
   "text": "از اون جوهر اول. اون از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.34,
   "end": 523.42,
   "text": "از آب و نان مادره. یعنی جماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.42,
   "end": 529.7,
   "text": "یعنی همین خاک. \"وخلقکم من الارض ثم امراکم فیها\" یعنی آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.7,
   "end": 531.94,
   "text": "ما شما رو انشا کردیم از همین خاک که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.94,
   "end": 536.52,
   "text": "این خاک چیه؟ چقدر بدن‌ها تو این خاک تجزیه شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.52,
   "end": 542.02,
   "text": "اگر اون آب حلال که پدر مادر خوردن شد نطفه من و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.02,
   "end": 544.88,
   "text": "از اضافه از اون خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.88,
   "end": 550.32,
   "text": "گل بدن اولیا، انبیا، مؤمنین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.32,
   "end": 554.18,
   "text": "الطیبات للطيّبين والطّيّبين للطيّبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.18,
   "end": 558.7,
   "text": "اینا چقدر قابل بررسیه، باز شدن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.7,
   "end": 562.14,
   "text": "اینه که میبینی بدن یکی خاص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.14,
   "end": 564.66,
   "text": "بدن یکی معطره، بدن یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.66,
   "end": 567.22,
   "text": "اصلاً روزی معنوی‌ش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.22,
   "end": 569.9,
   "text": "برعکس یکی بدنش اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.9,
   "end": 574.06,
   "text": "حق نداره بیاد تو حرم اهلبیت، حق نداره بیاد تو مسجد، هیئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 574.06,
   "end": 576.92,
   "text": "چرا؟ الخبيثات للخبيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 576.92,
   "end": 578.72,
   "text": "یه بار اینجا گفتم یکی خندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 578.72,
   "end": 582.04,
   "text": "گفتم ما عاقبت خاک گل کوزه‌گران خواهیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 582.04,
   "end": 585.54,
   "text": "درسته؟ این بدن، این جسم ما، روح که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 585.54,
   "end": 589.32,
   "text": "فرار کرد که روح و نور اون برمی‌گرده به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 589.32,
   "end": 591.9,
   "text": "همون جوهر اولیش که صادر اول ما کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.9,
   "end": 594.94,
   "text": "جسم رو میگم. این هم حساب کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.94,
   "end": 598.7,
   "text": "یعنی ما این بدن تجزیه میشه میره تو خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.7,
   "end": 603.02,
   "text": "یه درختی همین خاک من و تو رو از ریشه میگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.02,
   "end": 606.18,
   "text": "عناصری که تو بدن من هست میبره تو خودش میشه میوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 606.18,
   "end": 609.06,
   "text": "اون میوه رو یه آدم ب... بدن میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 609.06,
   "end": 611.14,
   "text": "میشه نطفه یک آدمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.14,
   "end": 616.56,
   "text": "یعنی این عناصری که الان تو وجود من از جهت مادی میره میشه تو بدن یکی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.56,
   "end": 619.32,
   "text": "نه اصلاً از اون گل یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 619.32,
   "end": 622.18,
   "text": "معذرت میخوام اینجا بود که یکی خندید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.18,
   "end": 624.12,
   "text": "کاسه توالت درست میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.12,
   "end": 627.56,
   "text": "یعنی این جسم ما نسبت به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 627.56,
   "end": 631.52,
   "text": "چه میانه تغذیه‌ش بده، آیا میونه حلال خورده یا حرام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 631.52,
   "end": 634.06,
   "text": "این عناصر برمی‌گردن میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.06,
   "end": 636.7,
   "text": "اگر طیب ان شاء الله اون حلاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 636.7,
   "end": 641.76,
   "text": "با طیبات جمع میشن میره خشت حرم یکی از اولیا خدا بدن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.76,
   "end": 645.06,
   "text": "اما اگر خبيث خبيثش کردی با اون حرام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 645.06,
   "end": 647.44,
   "text": "همه عالم حساب کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 647.44,
   "end": 650.12,
   "text": "می‌شه چی؟ میشه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 650.12,
   "end": 654.96,
   "text": "اگر خبيث بوده میره مثلا کاسه توالت یه سلطان مثلاً فلان جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 654.96,
   "end": 657.22,
   "text": "چه می‌دونم. میشه لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 657.22,
   "end": 661.06,
   "text": "تن یه آدم کافری. اینا همش حساب و کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 661.06,
   "end": 663.08,
   "text": "این‌هایی که اهل بیت علیهم السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.08,
   "end": 669.22,
   "text": "در روایت آوردن به همین سادگی و رد شدن همش رمز، همش گنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 669.22,
   "end": 672.2,
   "text": "لذا حالا ادامه بحث انشاالله فردا وقت ما گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 672.2,
   "end": 674.96,
   "text": "حضرت استاد علامه حسن زاده روحش شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 674.96,
   "end": 678.3,
   "text": "میفرما تمام-- اینو خوب گوش بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 678.3,
   "end": 685.24,
   "text": "تمام روایات اهل بیت حرف به حرفشون رمز و گنوزن، رمزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 685.24,
   "end": 688.54,
   "text": "باید عبور کنی از ظاهر به باطن‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 688.54,
   "end": 690.72,
   "text": "که ما متاسفانه دستمون کوتاه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.72,
   "end": 692.9,
   "text": "شاید عاقبتمون خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 692.9,
   "end": 697.5,
   "text": "به برکت صلوات بر محمد و آل محمد. الله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}