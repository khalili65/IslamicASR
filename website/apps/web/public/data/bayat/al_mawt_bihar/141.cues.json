  {
   "index": 1,
   "title": "## تبریک میلاد صدیقهٔ طاهره",
   "start": 89.28,
   "end": 112.9
  },
  {
   "index": 2,
   "title": "هر روز در اقامه، یاد مرحوم فاطمی‌نیا زنده می‌شود؛ به دو دلیل.",
   "start": 112.9,
   "end": 244.7
  },
  {
   "index": 3,
   "title": "## حب فاطمه در صد موطن",
   "start": 244.7,
   "end": 388.9
  },
  {
   "index": 4,
   "title": "## اعتراض به موعظهٔ موت و پاسخ سنت",
   "start": 388.9,
   "end": 441.28
  },
  {
   "index": 5,
   "title": "## ساختار روایت دوازدهم باب چهارم",
   "start": 441.28,
   "end": 477.74
  },
  {
   "index": 6,
   "title": "## فرار از موت همان ملاقات است",
   "start": 477.74,
   "end": 528.76
  },
  {
   "index": 7,
