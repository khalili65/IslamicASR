   "start": 528.76,
   "end": 711.3
  },
  {
   "index": 8,
   "title": "## خواب برادر موت و ذائقه",
   "start": 711.3,
   "end": 758.56
  },
  {
   "index": 9,
   "title": "## سفر از ظاهر به باطن",
   "start": 758.56,
   "end": 792.32
  },
  {
   "index": 10,
   "title": "## ضریب سرعت برزخ",
   "start": 792.32,
   "end": 892.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 3.76,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.76,
   "end": 7.86,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.86,
   "end": 12.08,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.08,
   "end": 17.36,
   "text": "السلام علیک یا داعی الله و ربانیة آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.36,
   "end": 20.22,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.22,
   "end": 23.62,
   "text": "کسی نباید در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.62,
   "end": 26.28,
   "text": "سطح پایین‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.28,
   "end": 30.98,
   "text": "امام باشه. امام باید سطح اونجایی که نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.98,
   "end": 33.74,
   "text": "سطحش پایین‌تر از همه باشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.74,
   "end": 36.7,
   "text": "دیگه حداقلش دیگه هم تراز باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.7,
   "end": 40.28,
   "text": "اگه دقت کنید در مساجد قدیمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.28,
   "end": 42.72,
   "text": "اونجایی که امام جماعت نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.72,
   "end": 45.7,
   "text": "چاله میره پایین‌تر یه مقدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 45.7,
   "end": 49.76,
   "text": "بعد جالبه که بدونید این نحوه‌ی اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.76,
   "end": 54.38,
   "text": "مأموم به امام هم اینطوری نیست که الان ماها وایمیستیم مثلا امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.38,
   "end": 57.58,
   "text": "کلا جلوتر از مأمومه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.58,
   "end": 60.16,
   "text": "یعنی یه، یه هوا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.16,
   "end": 65.2,
   "text": "یه، یه وجب مثلا جلوتر باید همراه مأموم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.2,
   "end": 71.06,
   "text": "این شکل. امام یه ذره جلوتر، یه کم جلوتر باشه به این شکل که الان اینا تو مساجد و اینا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.06,
   "end": 76.34,
   "text": "اینجا رعایت نمی‌شه. این‌ها خیلی خوبه که قدیم‌ها اینا رو خیلی رعایت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.34,
   "end": 83.92,
   "text": "متاسفانه الان دیگه خب تبریک عرض می‌کنم به ن-- به نوبه خودم محضر همه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.92,
   "end": 86.4,
   "text": "خصوصا مادرها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.4,
   "end": 88.52,
   "text": "همسران مکرمه‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.52,
   "end": 97.04,
   "text": "انشاالله که این روز پرسرور و پرنور میلاد حضرت صدوقه طاهره صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.04,
   "end": 99.7,
   "text": "برای هممون موجبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.7,
   "end": 102.72,
   "text": "نزول فیوضات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.72,
   "end": 112.9,
   "text": "الهیه باشه انشاالله. برای همه‌تون مبارک باشه، برای امام عصر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.9,
   "end": 117.18,
   "text": ". داشتم فکر می‌کردم که ه-- وقتی شروع کردم نماز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.18,
   "end": 119.16,
   "text": "یاد، یعنی ببخشید هر روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.16,
   "end": 123.7,
   "text": "مشغول اقامه بودم، یاد آقای فاطمی نیا افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.7,
   "end": 127.92,
   "text": "به دو دلیل. یکی اینکه این ذکری که ما قبل از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.92,
   "end": 130.46,
   "text": "می‌گم همیشه به یادگار از ایشون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.46,
   "end": 134.22,
   "text": "ایشون فرمودن یا مقیل العثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.22,
   "end": 138.32,
   "text": "ایشون فرمودن یه یادگاری، یه هدیه می‌خوام به شما بدم قبل از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.32,
   "end": 141.74,
   "text": "این ذکر رو بگید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.74,
   "end": 144.14,
   "text": "یا مقیل العثرات با قاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.14,
   "end": 147.44,
   "text": "عثرات با عین و ث سه نقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.44,
   "end": 154.18,
   "text": "یعنی ای کسی که ندید می‌گیری، می‌بخشی لغزش‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.18,
   "end": 156.96,
   "text": "برای شروع به نماز خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.96,
   "end": 162.04,
   "text": "مزه مزه می‌کنی. و دیگه اینکه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.04,
   "end": 164.72,
   "text": "مخصوصا تو این ایام پسر ایشونم اخیرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.72,
   "end": 173.68,
   "text": "فرمودن این نکته رو که محضر ایشون اومده بودن یه عده که حالا یه ذکر خاصی بگیرن برای مشکلات زندگیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.68,
   "end": 176.62,
   "text": "ایشون خیلی جالب که فرموده بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.62,
   "end": 180.66,
   "text": "هروقت مشکلی تو زندگیتون برخورد و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.66,
   "end": 183.44,
   "text": "نذر کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.44,
   "end": 186.48,
   "text": "خونوادتون رو خوشحال کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.48,
   "end": 189.98,
   "text": "مخصوصا خانومتون رو همسرتون رو خوشحال کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.98,
   "end": 192.48,
   "text": "حالا خانما آقاشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.48,
   "end": 194.06,
   "text": "چه جالب، چه نذر شیرینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.06,
   "end": 199.04,
   "text": "حالا ما همش منتظریم یه ذکر عجیب و غریب و این‌ها بگیریم از استاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.04,
   "end": 201.86,
   "text": "که چه روزی بهتر از امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.86,
   "end": 207.5,
   "text": "یه آدم اخلاقش و اخلاق خوش و خوبش و خیلی هم ایشون خدا رحمتشون کنه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.5,
   "end": 212.12,
   "text": "محضرشون رسیدیم. اصلا محال بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.12,
   "end": 215.42,
   "text": "ایشون تاکید به مباحث اخلاقی نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.42,
   "end": 218.7,
   "text": "اخلاق، اخلاق، اخلاق، همش اخلاق، اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.7,
   "end": 221.56,
   "text": "خیلی عجیب، خیلی هم خودشون خوش اخلاق بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.56,
   "end": 224.64,
   "text": "ما اون مدت که از وجودشون بهره می‌بردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.64,
   "end": 231.86,
   "text": "رسیدیم محضرشون یک بارم ازشون تندخویی ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.86,
   "end": 236.76,
   "text": "روحشون شاد. به هر حال روز، روز بسیار با عظمتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.76,
   "end": 239.3,
   "text": "و این نذر هم امروز این نذر رو بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.3,
   "end": 243.44,
   "text": "بریم منزلمون اخلاقمون رو هدیه ببریم برای خانوم‌هامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.44,
   "end": 248.4,
   "text": "اتفاقا در بحار جلد هفت صفحه پونصد و سی و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.4,
   "end": 252.0,
   "text": "از رسول عزیز عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.0,
   "end": 255.38,
   "text": "پیغمبر عزیز عالم درود و صلوات و سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.38,
   "end": 261.52,
   "text": "خاص خدا و ملائکه مقربین و انبیا و اولیاش بر او و خاندانش باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.52,
   "end": 264.82,
   "text": "یه روایت هست که خیلی جالب فرمودن یا سلمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.82,
   "end": 269.96,
   "text": "حب فاطمة ينفع في مئة مواطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.96,
   "end": 274.16,
   "text": "حب فاطمه من صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.16,
   "end": 276.94,
   "text": "در صد جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.94,
   "end": 281.26,
   "text": "به درد می‌خوره. یعنی حب در صد جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.26,
   "end": 287.8,
   "text": "نفع می‌رسونه. أيسر تلك المواطن تازه آسون‌ترین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.8,
   "end": 291.32,
   "text": "موطن‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.32,
   "end": 295.8,
   "text": "حب دختر من فاطمه اونجا به دردش می‌خوره ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.8,
   "end": 300.08,
   "text": "الموت. تازه اینا آسون‌ترینهاشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.08,
   "end": 302.56,
   "text": "چه خبره؟ الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.56,
   "end": 305.94,
   "text": "و القبر و المیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.94,
   "end": 309.16,
   "text": "و الحشر و الصراط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.16,
   "end": 311.82,
   "text": "و المحاسبة .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.82,
   "end": 313.72,
   "text": "چقدر جالب. چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.72,
   "end": 318.46,
   "text": "چیه این؟ یعنی خدا چه قیمتی داده به حب این خانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.46,
   "end": 321.28,
   "text": "حب این خانم چه قیمتی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.28,
   "end": 325.48,
   "text": "واقعا اتفاقا باز جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.48,
   "end": 331.42,
   "text": "در قنوت نماز که داشتم ربنا آتنا مونده بودم کدوم دعا رو بخونم یهو یاد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.42,
   "end": 337.0,
   "text": "تفسیر افتادم که حسنه در قرآن حب فاطمه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.0,
   "end": 340.24,
   "text": "اصلا دیگه ناخودآگاه این دعا رو تو قنوت نماز خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.24,
   "end": 343.04,
   "text": "ربنا آتنا. قدیما می‌گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.04,
   "end": 345.76,
   "text": "چرا همه علما اینو تو قنوتاشون می‌خوندن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.76,
   "end": 348.76,
   "text": "زمان جهی من دقت می‌کردم هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.76,
   "end": 351.72,
   "text": "عالم اینو دقت کردم اینو تو قنوت نمازش می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.72,
   "end": 357.34,
   "text": "برای من سؤال بود. الان می‌فهمم که با مفسرین چقدر روایت داریم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.34,
   "end": 361.64,
   "text": "آ-- حسنه حب فاطمه زهرا صلوات الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.64,
   "end": 367.14,
   "text": "ربنا آتنا في الدنيا حسنة و في الآخرة حسنة و قنا عذاب النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.14,
   "end": 369.84,
   "text": "هر جا که حب فاطمه‌ست عذاب نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.84,
   "end": 373.82,
   "text": "آتش نیست. هر کجا که فاطمه نیست آتش است، عذاب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.82,
   "end": 376.8,
   "text": "لذا و قنا عذاب النار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.8,
   "end": 380.74,
   "text": "همش تأکیده. سه بار تأکیده در این دعا بر حب فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.74,
   "end": 383.48,
   "text": "صلوات الله علیها. از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.48,
   "end": 388.9,
   "text": "حیث استفاده می‌کنم و تو این تقریبا نصف وقتمون هم رفتم و تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.9,
   "end": 393.4,
   "text": "چند دقیقه که وقت هست بریم سراغ موضوع گم شدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.4,
   "end": 395.42,
   "text": "موضوع گم شدمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.42,
   "end": 402.48,
   "text": "متاسفانه جوون‌ها بر نتافتند و گفتن آقا به اندازه کافی ما گرفتار هستیم، مشکلات داریم، غم و غصه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.48,
   "end": 405.84,
   "text": "حاج آقا هم هر روز هی موت، موت، موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.84,
   "end": 408.18,
   "text": "تن و بدن ما رو می‌لرزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.18,
   "end": 410.88,
   "text": "در صورتی که فرمودند که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.88,
   "end": 418.02,
   "text": "именно بر عزالام فرمودند که ما موعظه‌ای بهتر و کفایت کننده‌تر از یاد موت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.02,
   "end": 421.62,
   "text": "ما این بدبختی‌هایی که سر ما داره میاد چون اینو فراموش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.62,
   "end": 424.28,
   "text": "اگه اینو یادمون باشه همیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.28,
   "end": 428.38,
   "text": "آویزه‌ی گوشمون باشه، نصب العينمون باشه دیگه بقیه‌ی مشکلات حل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.38,
   "end": 431.56,
   "text": "چون فکر می‌کنیم اینجا هستیم و جا خوش کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.56,
   "end": 433.96,
   "text": "دیگه رو فل داریم خونه می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.96,
   "end": 437.42,
   "text": "ما تو مسافرخونه داریم اساس جمع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.42,
   "end": 441.54,
   "text": "اساسی که باید بریم. برای همین برگردیم به اصل موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.54,
   "end": 445.88,
   "text": "رسیده بودیم به باب چهارم کتاب الموت مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.88,
   "end": 448.38,
   "text": "مجلسی، روایت دوازدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.38,
   "end": 453.74,
   "text": "و من بعضی از شرح‌ها رو که دقت کردم مثلا این کتاب الموت مـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.74,
   "end": 457.02,
   "text": "مرحوم مجلسی رو که شرح دادن این روایتو نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.02,
   "end": 463.12,
   "text": "حالا چرا نمی‌دونم. فکر می‌کنم چون من روایت رو رفتم از متن بهار درآوردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.12,
   "end": 466.26,
   "text": "دیدم از متن عربیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.26,
   "end": 468.62,
   "text": "خودم استنباطم این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.62,
   "end": 472.62,
   "text": "چون شاید ظاهرا شاید به این دلیل باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.62,
   "end": 479.56,
   "text": "اینجا یک بخشی از یک روایتی رو مرحوم مجلسی میاره از امام باقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.56,
   "end": 485.76,
   "text": "بعد یه دفعه اینو می‌خواد شرحش بده می‌زنش به خطبه‌ی امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.76,
   "end": 487.92,
   "text": "که در خصوص همین موته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.92,
   "end": 490.84,
   "text": "فرار از موته. بعد از اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.84,
   "end": 493.52,
   "text": "همون خطبه مولا رو شروع می‌کنه تشریح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.52,
   "end": 497.66,
   "text": "یعنی اصلا یه طوریه این روایت دوازدهم یه ملغمه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.66,
   "end": 499.5,
   "text": "اصلا یه بخشی از سخن امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.5,
   "end": 503.86,
   "text": "بعد شرح توضیح مرحوم مجلسی به این شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.86,
   "end": 506.2,
   "text": "شاید یه مقدار گیج کننده باشه بالاخره چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.2,
   "end": 510.54,
   "text": "بعد یه بخشی از صحبت امام باقر، یه بخشی از صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.54,
   "end": 513.7,
   "text": "امیرالمؤمنین. این‌ها شاید به این خاطر باشه نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.7,
   "end": 517.6,
   "text": "حالا منو عرض می‌کنم از امام باقر صلوات الله علیهشون فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.6,
   "end": 520.5,
   "text": "\"کل امر ان لاقٍ فی فراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.5,
   "end": 525.26,
   "text": "ای من الامور المقدورة الحتمیه کالموت.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.26,
   "end": 528.76,
   "text": "هیچ امر حتمی ما نداریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.76,
   "end": 533.34,
   "text": "مثل موضوع موت از اموری که هست مثل موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.34,
   "end": 537.66,
   "text": "دیگه طوری باشه که وقتی ازش فرار می‌کنی، فرار می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.66,
   "end": 539.78,
   "text": "اتفاقا ملاقاتش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.78,
   "end": 542.6,
   "text": "داری فرار می‌کنی ولی ملاقاتش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.6,
   "end": 545.92,
   "text": "هرچی شما فرار می‌کنی اتفاقا داری میری به ملاقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.92,
   "end": 548.24,
   "text": "مرگ. چون آنفعآن داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 548.24,
   "end": 551.4,
   "text": "عمرت تموم می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.4,
   "end": 555.74,
   "text": "قل بعد قال الله تعالی این ادامه‌ی روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 555.74,
   "end": 557.92,
   "text": "اشاره می‌کنه به این آیه که قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 557.92,
   "end": 563.14,
   "text": "ان الموت الذي تفرون منه فإنه ملاقیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.14,
   "end": 568.28,
   "text": "اون موتی که ازش فرار می‌کنید قطعاً اون رو ملاقات خواهید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.28,
   "end": 572.48,
   "text": "موت رو ملاقات خواهید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.48,
   "end": 575.16,
   "text": "فإنه ملاقیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.16,
   "end": 579.58,
   "text": "شما ملاقات خواهید، یعنی پیداست که موت یه حقیقتیه که ما ملاقاتش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.58,
   "end": 583.3,
   "text": "یه چیزیه. یه شیئیه انگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.3,
   "end": 586.98,
   "text": "خلق الحیاة والموت دیگه خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.98,
   "end": 590.5,
   "text": "خلق یعنی اندازه. صادر نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.5,
   "end": 593.68,
   "text": "اندازه نداشته باشه. اندازه داره، مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.68,
   "end": 600.84,
   "text": "عجب! چه جالب! یعنی پس هر کسی یه اندازه‌ای از موت، یه سهمی از موت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.84,
   "end": 603.64,
   "text": "میگه بیا قسطتو بگیر، قسطتو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.64,
   "end": 608.9,
   "text": "یه قسطیه. هر کسی یک قسطی داره از موت در این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.9,
   "end": 611.74,
   "text": "که اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.74,
   "end": 614.6,
   "text": "بهش برگ-برگردانده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.6,
   "end": 617.28,
   "text": "چه میزانی از موت به تو داده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.28,
   "end": 619.6,
   "text": "به میزان سع وجودی‌ت. حاج آقا چی داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.6,
   "end": 622.64,
   "text": "شما ما رو گیج می‌کنی. یعنی چی قسط و موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 622.64,
   "end": 628.92,
   "text": "هرکی یه اندازه‌ای یک، یک چیزیه که به قدر هر کسی به سع وجودی هر کسی بهش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.92,
   "end": 631.12,
   "text": "بله، رتبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 631.12,
   "end": 634.32,
   "text": "رتبه‌ست اصلا. چگونه‌ست که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.32,
   "end": 637.46,
   "text": "خواب درجه‌ای از درجات انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.46,
   "end": 640.06,
   "text": "خواب، همین خوابی که ما هر شب می‌خوابیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.06,
   "end": 643.16,
   "text": "درجه‌ای از درجات و مدارج انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.16,
   "end": 645.24,
   "text": "یک رتبه‌ست، یک مقامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.24,
   "end": 652.32,
   "text": "شوخی نیست. خیلی‌ها از اونجا که به کشف و کرامات می‌رسن از خواب چون رفتن یک لایه پنهان‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.32,
   "end": 654.42,
   "text": "این عالم رو درک کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.42,
   "end": 657.82,
   "text": "و برمی‌گردن. لذا وقتی تو بیدار می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 657.82,
   "end": 660.48,
   "text": "قربونت برم حالت اصلا یه طوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 660.48,
   "end": 662.9,
   "text": "خیلی راحت‌تر می‌تونی درک کنی موت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 662.9,
   "end": 665.5,
   "text": "چشی-چشیدنش آسون‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 665.5,
   "end": 668.04,
   "text": "معمولا یه حالت حزنی بهت دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 668.04,
   "end": 670.54,
   "text": "صبح اول وقت که پایی-- پا می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 670.54,
   "end": 673.04,
   "text": "اصلا دلکنده از دنیایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 673.04,
   "end": 675.2,
   "text": "اونطوری نیست که بعد میای تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 675.2,
   "end": 678.64,
   "text": "زندگی روزمره‌ی و دوباره آلگی‌ها و غفلت ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.64,
   "end": 682.38,
   "text": "نه، اون صبح وقت بیداری از خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.38,
   "end": 684.12,
   "text": "چرا می‌گه سریع سجده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 684.12,
   "end": 686.38,
   "text": "همون تا بیدار شدی سجده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 686.38,
   "end": 689.22,
   "text": "در المراقبات مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 689.22,
   "end": 692.42,
   "text": "آمیز جود آقا یا کتاب‌های دیگه این رو آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 692.42,
   "end": 695.74,
   "text": "که اون لحظه بهترین لحظه برای یادآوری کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 695.74,
   "end": 699.86,
   "text": "چون از یک لایه پنهان‌تر اومدی، از اونجایی که قراره بری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 699.86,
   "end": 705.14,
   "text": "رفتی برگشتی. حالا یاد-- بهتر الان می‌تونی یادآور کنی بر خودت اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 705.14,
   "end": 708.14,
   "text": "خیلی قصه‌ها شیرینین. حالا اونجا می‌گه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 708.14,
   "end": 710.96,
   "text": "حالا که یک رتبه‌ست. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 710.96,
   "end": 715.48,
   "text": "پس موت هم مگر نگفت که ان نام اخو الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 715.48,
   "end": 717.52,
   "text": "خواب برادر موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 717.52,
   "end": 722.3,
   "text": "پس موت هم یک رتبه‌ست، یک درجه‌ای از درجات انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 722.3,
   "end": 726.1,
   "text": "چشیدنیه. کل نفس ذائقه الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 726.1,
   "end": 728.9,
   "text": "و این چشیدن هر کسی چقدر می‌چشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 728.9,
   "end": 731.84,
   "text": "آقا الان می‌خوام شربت پخش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 731.84,
   "end": 736.02,
   "text": "اون یکی می‌گه آقا شما این بچه‌ست اصلاً یه نصف استکان بهش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 736.02,
   "end": 740.76,
   "text": "اون بزرگه، این ماشاالله فلانه، این ورزشکاره دو تا، سه تا استکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 740.76,
   "end": 743.62,
   "text": "ذائقة الموت می‌چشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 743.62,
   "end": 751.82,
   "text": "هر کس به میزان اندازه‌ش، قدرش، اسر القدرش حجت خدا درک می‌کنه، متوجه می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 751.82,
   "end": 757.88,
   "text": "که به علم الهی، به علم انایی حق که این چق-- اندازه‌ش چقدره همون مقدار موت رو می‌چشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 757.88,
   "end": 761.98,
   "text": "که موت سفر است از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.98,
   "end": 767.9,
   "text": "یعنی هر مقدار شما وا-- تو همین دنیا موت قبلًا تموت رو چشیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 767.9,
   "end": 770.12,
   "text": "یعنی از ظاهر به باطن سفر کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 770.12,
   "end": 773.24,
   "text": "یعنی نمازت الان سفر از ظاهر به باطن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 773.24,
   "end": 776.86,
   "text": "وقتی داری ورد میگی رو لب، لبانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 776.86,
   "end": 780.12,
   "text": "این خودش سفر از ظاهر به باطنه تبدیل به ذکر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 780.12,
   "end": 783.16,
   "text": "فقط اسم نمیگی چون يا من اسمهُ دواء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 783.16,
   "end": 785.18,
   "text": "دواست. اما کی شفا می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 785.18,
   "end": 787.44,
   "text": "وقتی که سفر از ظاهر به باطن صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 787.44,
   "end": 791.68,
   "text": "یعنی بشه ذکر. اسم دواست اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 791.68,
   "end": 794.48,
   "text": "شفا در ذکره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 794.48,
   "end": 798.14,
   "text": "ذکرهُ شفا. یعنی سفر از باط-- ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 798.14,
   "end": 801.14,
   "text": "هر وقت که هر مقدار که ما تونستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 801.14,
   "end": 806.92,
   "text": "از ظاهر به باطن سفر کنیم، همون مقدار وقت موت اندازه‌ی ما مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 806.92,
   "end": 809.16,
   "text": "به میزان سفرهای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 809.16,
   "end": 813.34,
   "text": "اسفار، اسفار جمع سفره، اسفار معروف ملاهصدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 813.34,
   "end": 820.92,
   "text": "سفرهای چهارگانه است دیگه. این به میزانی که ما سفر کردیم در نماز‌هامون، روزه‌هامون، خمس و زکات و آنات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 820.92,
   "end": 826.84,
   "text": "ساعات زندگیمون، شب و روزمون به همون مقدار اندازه‌مون مشخص می‌شه، همون مقدار ما لب، لب موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 826.84,
   "end": 830.42,
   "text": "سفر می‌کنیم. همونه. چشیدن همون اندازه خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 830.42,
   "end": 835.38,
   "text": "بعد دیگه در سیر استکمالی برزخ، در برزخ که سیر استکمالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 835.38,
   "end": 837.76,
   "text": "داریم که باید بریم تکمیل بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 837.76,
   "end": 841.78,
   "text": "ملائکه هم تکمیلمون می‌کنن، ارواح و مفارقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 841.78,
   "end": 847.38,
   "text": "کمکمون می‌کنن از اونجا حرکت ایجادیه دارن که ما حرکت شدت وجودیه پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 847.38,
   "end": 852.18,
   "text": "اون دیگه بر بستر میزانی‌ست که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 852.18,
   "end": 857.46,
   "text": "ظاهر به باطن اینجا سفر کرده بودیم یا اندازه‌ای که چشیدیم موت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 857.46,
   "end": 859.48,
   "text": "همون مقدار ضریب می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 859.48,
   "end": 862.82,
   "text": "سرعت سیرمون در برزخ مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 862.82,
   "end": 867.14,
   "text": "همه باز در برزخ دارن به سرعت میرن از ظاهر به باطن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 867.14,
   "end": 869.42,
   "text": "اما یکی به سرعت لاک‌پشت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 869.42,
   "end": 873.26,
   "text": "سیر استکمالی برزخ. لذا برزخش خیلی طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 873.26,
   "end": 880.12,
   "text": "یکی نه به سرعت نور میره یا آنی برزخو طی می‌کنه میره به عالم عقول، میره به عالم اله، میره به عالم اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 880.12,
   "end": 882.54,
   "text": "این چنینه. حالا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 882.54,
   "end": 884.72,
   "text": "ادامه‌داره یه بخشیش رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 884.72,
   "end": 889.78,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 889.78,
   "end": 892.64,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}