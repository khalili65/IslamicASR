   "start": 14.22,
   "end": 39.4
  },
  {
   "index": 1,
   "title": "## نوشتن؛ ملکات و کتاب نفس",
   "start": 39.4,
   "end": 378.3
  },
  {
   "index": 2,
   "title": "## قدر جوانی و محشور شدن با خود",
   "start": 378.3,
   "end": 467.34
  },
  {
   "index": 3,
   "title": "## کینونت زمان و مکان؛ قداست حضور",
   "start": 467.34,
   "end": 579.42
  },
  {
   "index": 4,
   "title": "## روایت مصافحهٔ ملائکه",
   "start": 579.42,
   "end": 605.4
  },
  {
   "index": 5,
   "title": "## کینونت محضر و اتمام آیه؛ حکم ارتداد",
   "start": 605.4,
   "end": 673.5
  },
  {
   "index": 6,
   "title": "## حسینی شدن؛ ملکهٔ وجود",
   "start": 673.5,
   "end": 882.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 5.56,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.56,
   "end": 11.28,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.28,
   "end": 14.22,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.22,
   "end": 18.74,
   "text": "کتاب الموت، باب دوم، روایت هشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.74,
   "end": 22.02,
   "text": "این روایت رو مرحوم مجلسی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.02,
   "end": 24.98,
   "text": "دعوات راوندی آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.98,
   "end": 29.86,
   "text": "که قال النبي پیغمبر عزیز عالم فرمودند المسلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.86,
   "end": 34.32,
   "text": "اذا ضعف من الكبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.32,
   "end": 38.42,
   "text": "وقتی که مسلمان به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.42,
   "end": 42.66,
   "text": "ضعف و پیری رسید، ضعف بر او غلبه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.66,
   "end": 45.44,
   "text": "يأمر الله الملك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.44,
   "end": 50.4,
   "text": "خداى منان به یه فرشته‌ای امر می‌کنه أن يكتب له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.4,
   "end": 52.46,
   "text": "که براش بنویسه له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.46,
   "end": 56.96,
   "text": "براش بنویسه في حاله تو اون حالتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.96,
   "end": 61.84,
   "text": "که ضعف بهش غالب شده این‌ها دیگه توان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.84,
   "end": 64.1,
   "text": "تو اون حالت ملک براش چی می‌نویسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.1,
   "end": 67.02,
   "text": "تلك ما كان يعمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.02,
   "end": 71.62,
   "text": "اونچه که انجام می‌داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.62,
   "end": 75.56,
   "text": "وهو شاب کن وقتی که جوون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.56,
   "end": 79.18,
   "text": "نشيط مجتمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.18,
   "end": 83.78,
   "text": "با نشاط بوده و جمع کرده بوده همه این عباداتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.78,
   "end": 86.92,
   "text": "این عجیبه روایت خیلی عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.92,
   "end": 89.96,
   "text": "خیلی البته از کرم خدا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.96,
   "end": 92.94,
   "text": "پرده‌برداری می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.94,
   "end": 95.86,
   "text": "وقتی مسلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.86,
   "end": 102.48,
   "text": "وقتی که به سن پیری و ضعف رسید اون کارهایی که در جوونیش می‌کرده رو ملکه براش می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.48,
   "end": 106.24,
   "text": "که حالا البته این با توجه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.24,
   "end": 110.34,
   "text": "می‌فرماید با حالت نشاط این کارو می‌کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.34,
   "end": 117.72,
   "text": "این نشون می‌ده که نه هر کاری رو این جوون در احوال جوونیش حالا یهو دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.72,
   "end": 123.18,
   "text": "عادت به کاری نکرده، یه اهب و داری یه کاری انجام می‌داده اینا اصرار بر اون کار نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.18,
   "end": 126.4,
   "text": "یه بار شل کن سفت کن نوسان داشته اونا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.4,
   "end": 129.32,
   "text": "چون میگه با نشاط نشان‌دهنده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.32,
   "end": 134.28,
   "text": "اینه که اون کارهایی که دائم انجام می‌داده حالا مریض شده، ضعف داره، نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.28,
   "end": 138.4,
   "text": "روزه مستحبی بگیره. نمی‌دونم ذکر آنچنانی بگه، نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.4,
   "end": 144.26,
   "text": "جعفر طیار بخونه چه چه یا فقیر شده استطاعت مالی نداره دیگه اونطوری کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.26,
   "end": 148.9,
   "text": "اینا چی می‌شه؟ خدا به م-منتش به کرمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.9,
   "end": 150.76,
   "text": "همونا رو دائم براش می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.76,
   "end": 154.12,
   "text": "حالا یک بحث نوشتن اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.12,
   "end": 158.3,
   "text": "داره می‌گه. حالا یه سؤال هم ایجاد می‌شه که آیا اعمال بد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.3,
   "end": 161.96,
   "text": "اونا رم خدا می‌گه بنویس. اونی که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.96,
   "end": 166.58,
   "text": "حالا تو جوونیشه خلاف‌هایی مرتکب می‌شده الان دیگه جونشو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.58,
   "end": 168.82,
   "text": "جون نداره دیگه اون خلاف‌ها رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.82,
   "end": 170.84,
   "text": "قیافش از ریخت افتاده. دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.84,
   "end": 175.76,
   "text": "کسی نگاهش نمی‌کنه. این چی؟ این سؤال اجازه بدید جلسه بعد انشاالله جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.76,
   "end": 178.82,
   "text": "فعلاً همین رو بریم که وقتتون نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.82,
   "end": 185.38,
   "text": "پس این نشون می‌ده که اون اعمالی که براش اصرار داشته، اصرار بر عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.38,
   "end": 188.28,
   "text": "قبلاً هم بحث کردیم در حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.28,
   "end": 193.18,
   "text": "ببینید میاد برای اینکه تلك الأمثال نداره بحال الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.18,
   "end": 196.42,
   "text": "برای اینکه مثل بزنه مردم بفهمند می‌گه می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.42,
   "end": 200.0,
   "text": "خدا می‌گه ملکی می‌نویسه. اما شما وقتی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.0,
   "end": 202.56,
   "text": "براهین عقلی رو ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.56,
   "end": 209.74,
   "text": "آیات و روایات پیش می‌گیری، یعنی در حکمت و عرفان سیر می‌کنی، از دید فلسفی و عرفانی نگاه می‌کنی، این نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.74,
   "end": 212.44,
   "text": "ثبت شدن در وجود خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.44,
   "end": 217.7,
   "text": "چون قراره خودش بخونه. اقرأ كتابك كفى بنفسك اليوم عليك حسيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.7,
   "end": 220.18,
   "text": "خودش قراره کتاب خودشو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.18,
   "end": 222.7,
   "text": "لذا اینم دائما در حال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.7,
   "end": 227.16,
   "text": "س-سیرورتش در حال شدنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.16,
   "end": 232.6,
   "text": "با اعمالش. قبلاً عرض کردیم اونچه که صور و اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.6,
   "end": 239.68,
   "text": "یعنی ملکات صور و اشکال برزخی ما رو تشکیل می‌ده حتی در برزخ متصلمون که خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.68,
   "end": 246.0,
   "text": "اونچه که شکل می‌بینیم، رؤیت می‌کنیم، می‌شنویم، می‌چشیم همه همش در خودمونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.0,
   "end": 248.44,
   "text": "انشا نفس ناطقه مونه مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.44,
   "end": 251.5,
   "text": "این‌ها در خود ماست. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.5,
   "end": 254.28,
   "text": "این از کجا بلند می‌شه این صور و اشکال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.28,
   "end": 256.52,
   "text": "علامه بر اساس هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.52,
   "end": 260.16,
   "text": "اون کتاب شریف صد کلمه در معرفت نفسش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.16,
   "end": 265.38,
   "text": "تا فکر می‌کنم تل-چلم-کلمه چهل و سوم، چهارم گفتیم بعد فعلاً منقطع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.38,
   "end": 267.74,
   "text": "و در کتاب انسان در عرفانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.74,
   "end": 272.3,
   "text": "اون اصل رو میاره که اون بر اساس ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.3,
   "end": 276.7,
   "text": "یعنی چی؟ یعنی هرچی که ملکه شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.7,
   "end": 281.02,
   "text": "در وجودت راسخ شده، رسوخ کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.02,
   "end": 283.9,
   "text": "اون برات موندنیه. چون تو شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.9,
   "end": 286.52,
   "text": "شدن تو بر اساس اون ملکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.52,
   "end": 291.52,
   "text": "ملکات چی‌ند؟ اونی که راسخ شدن اصطلاحاً در علم اخلاق می‌گن راسخ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.52,
   "end": 294.52,
   "text": "چیه؟ اون اصراره بر عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.52,
   "end": 297.06,
   "text": "یعنی کاری که مداومت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.06,
   "end": 301.6,
   "text": "برای همین کار خیر رو می‌گن اگه تا یک سال مداومت کردی اثر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.6,
   "end": 307.52,
   "text": "نکردی اثری نداره. مثلاً داریم حدیث داریم که یه کار خیر رو یا دست نگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.52,
   "end": 309.7,
   "text": "یا یک سال مداومت کن. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.7,
   "end": 312.92,
   "text": "به جهت اون تأثیری‌ست که در نفس می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.92,
   "end": 315.84,
   "text": "منظور از این نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.84,
   "end": 321.16,
   "text": "ثبتی‌ست که در وجود و در نفس خود جوون اتفاق افتاده، ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.16,
   "end": 324.4,
   "text": "یعنی روزگارش داره با اون‌ها می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.4,
   "end": 329.2,
   "text": "دائم به زیارت بوده حالا یهو توان نداره، پولشو نداره یا راه بسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.2,
   "end": 332.3,
   "text": "هر روز و شب آه می‌کشه یاد حرم امام حسین می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.3,
   "end": 334.0,
   "text": "این آه برای چیه؟ از کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.0,
   "end": 338.42,
   "text": "از نهان‌خانه دلش آه زیارت امام حسین برای چی بلند شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.42,
   "end": 345.22,
   "text": "به جهت اینکه یک عمر خو کرده حالا یا زیارت از راه دور یا از نزدیک شده ملکه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.22,
   "end": 348.36,
   "text": "پس اینو توجه داشته باشید اینکه می‌گه در پیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.36,
   "end": 352.06,
   "text": "خدا به ملک می‌شه می‌گه بنویس این از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.06,
   "end": 356.4,
   "text": "توسط قوای وجودیش که اون قوای وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.4,
   "end": 360.54,
   "text": "بنا به فرمایش افلاطون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.54,
   "end": 364.06,
   "text": "می‌شن همون ملائکه الله قوای وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.06,
   "end": 365.9,
   "text": "توسط اون‌ها داره می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.9,
   "end": 368.14,
   "text": "یعنی اون ملک قوه وجودیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.14,
   "end": 371.12,
   "text": "یعنی از قبل نوشته حالا هم تو وجودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.12,
   "end": 373.36,
   "text": "حالا هم با این حقایق داره سیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.36,
   "end": 375.92,
   "text": "اصلاً شب و روزش با اوناست. اصلاً همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.92,
   "end": 378.06,
   "text": "چیزی جون-جز اون نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.06,
   "end": 383.36,
   "text": "لذا اینجا قدر و قیمت عزیزان دلم جوانی خیلی خودش رو نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.36,
   "end": 389.06,
   "text": "که چرا انقدر بزرگان رو جوانی مخصوصاً همین حدیث دلالت بر این داره دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.06,
   "end": 394.5,
   "text": "که اون با در باطن یه حقیقتی از اون عمل در وجود شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.5,
   "end": 398.5,
   "text": "جا میندازه، ملکه میشه که دیگه همیشه باهاشه، با همونم محشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.5,
   "end": 403.46,
   "text": "لذا علامه فرمود ما با خودمون و اعمال خودمون محشور میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.46,
   "end": 406.6,
   "text": "خودمون با خودمون محشور میشیم. همونی که هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.6,
   "end": 409.02,
   "text": "الان هستیم. چی هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.02,
   "end": 410.6,
   "text": "همونم باطنمون آشکار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.6,
   "end": 413.18,
   "text": "یومئذ تبلی السرائر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.18,
   "end": 417.2,
   "text": "از اینجا یه نکته‌ای رو تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.2,
   "end": 424.12,
   "text": "و عرض شود انقدر شما رو دوست دارم عرض می‌کنم چون خودش واقعاً در خام منبر متلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.12,
   "end": 427.5,
   "text": "عرض می‌کنم میرم. اگه کسی مبسوطش بخواست درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.5,
   "end": 431.34,
   "text": "صد و هشتاد و پنج شرح فصوص علامه حسن زاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.34,
   "end": 433.78,
   "text": "شرح قشنگی بر این موضوع. بحث چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.78,
   "end": 436.62,
   "text": "کینونت از منه و امکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.62,
   "end": 440.98,
   "text": "یعنی مکان‌ها و زمان‌ها یه کینونت، یک قداستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.98,
   "end": 442.7,
   "text": "یک درون مایه ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.7,
   "end": 445.1,
   "text": "یکی از اون‌ها جوانی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.1,
   "end": 447.18,
   "text": "اصلا زمان جوانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.18,
   "end": 449.62,
   "text": "زمان یا خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.62,
   "end": 453.48,
   "text": "وضعیت جسمی، روحی و نفسی انسان به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 453.48,
   "end": 457.5,
   "text": "خودش هم یه مکانیه دیگه. محله، محل تنزله، نزول حقایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 457.5,
   "end": 460.0,
   "text": "این، این هم یک کینونتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 460.0,
   "end": 464.14,
   "text": "یعنی در درون خودش، در تکوین خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.14,
   "end": 468.84,
   "text": "در آفرینش خودش، در جبلیش، در شاکله‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.84,
   "end": 476.82,
   "text": "در فطرش، چی بگم؟ یک چیزی، یک درون مایه ای داره که اون خیلی گران م-- گران‌مایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.82,
   "end": 482.3,
   "text": "ما این کینونت رو در یعنی در نفس کینونت در زمان و مکان می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.3,
   "end": 485.34,
   "text": "مثلاً شب قدر. این کینونت چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.34,
   "end": 488.78,
   "text": "زمانی داره. حرم سید الشهدا، کینونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.78,
   "end": 493.2,
   "text": "مکانی داره. مسجد. چرا сейчас شما اینجا جمع شدید نماز می‌خوندید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.2,
   "end": 495.62,
   "text": "چرا تو دفتر کارتون یا جاهای دیگه نخوندید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.62,
   "end": 498.7,
   "text": "این کینونت، اون نفس کینونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.7,
   "end": 503.86,
   "text": "یعنی در تکوین و نظام آفرینش خدا قداست داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.86,
   "end": 506.72,
   "text": "ایجاد کرده، جعل کرده برای مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.72,
   "end": 508.88,
   "text": "در جوانی هم یه همچین کینونتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.88,
   "end": 511.8,
   "text": "در محل حضور، محل حضور حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.8,
   "end": 515.34,
   "text": "مثلاً چرا انقدر تأکید شده انسان بره محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.34,
   "end": 519.3,
   "text": "حضور؟ یعنی سلام از راه دور هم ثواب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.3,
   "end": 521.7,
   "text": "ها؟ زیارت از راه دور هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.7,
   "end": 524.08,
   "text": "اما چرا انقدر تأکید شده برو حرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.08,
   "end": 527.54,
   "text": "اون کینونت حضور، فیض حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.54,
   "end": 536.24,
   "text": "یا چرا انقدر می‌گن آقا به ویس و الانم که از یه جهت خوشبختانه از یه ج-- یه جهت متأسفانه کتاب صوتی رایج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 536.24,
   "end": 539.42,
   "text": "خیلیا دیگه سر کلاس درس نمیرن، صوت رو گوش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.42,
   "end": 546.14,
   "text": "حتی صوت معارفی. آقا بارها و بارها از اساتیدمون بدون استثناء کوچیک و بزرگشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.14,
   "end": 553.48,
   "text": "که من خاک پای همشونم شنیدیم و می‌شنویم و خواهیم شنید که هیچ چیزی فیض حضور در مح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 553.48,
   "end": 556.78,
   "text": "در محضر استاد و معلم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.78,
   "end": 558.82,
   "text": "آقای بهجت یادتونه یه سری تو م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.82,
   "end": 562.94,
   "text": "وقتی می‌رفت حرم حتی مردم عامه که می‌دونستن اینو کینونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.94,
   "end": 568.34,
   "text": "از منه و امکنه و محل حضور و می‌رفتن نزدیک ایشون می‌شستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 568.34,
   "end": 570.48,
   "text": "هیچ، فقط می‌شستن که چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 570.48,
   "end": 573.28,
   "text": "اونجا نفس حضور در اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 573.28,
   "end": 576.6,
   "text": "از جهت الهی قداست داشت و داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.6,
   "end": 579.26,
   "text": "انقدر این قصه تأثیرگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.26,
   "end": 583.42,
   "text": "که شخصی اومد پیش پیغمبر گفت آقا وقتی، حالا مضمونشو من به شما بگم فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.42,
   "end": 587.4,
   "text": "در کافی کلینی علل و مقام مقامی شریف این روایت رو مبسوط می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.4,
   "end": 590.16,
   "text": "گفت آقا ما پیش شماییم حالمون خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 590.16,
   "end": 596.18,
   "text": "از اینجا که میریم زن و بچمونو بو می‌کنیم، میریم سر کار، اینا درگیر کارهای اجتماعی میشیم، حالمون بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 596.18,
   "end": 602.14,
   "text": "اون حالی که پیش شما مثل ما وقتی تو هیئت هستیم چه نشاطی داریم، مسجد اینا وقتی میریم حاله میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 602.14,
   "end": 606.12,
   "text": "پیغمبر فرمود اگر بتوانید اون حال رو برای خودتون که در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 606.12,
   "end": 610.18,
   "text": "ما هستید حفظ کنید، ملائکه میان با شما مصافحه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 610.18,
   "end": 613.36,
   "text": "بر شما ناظر می‌شن. خیلی حرف بالاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 613.36,
   "end": 620.26,
   "text": "و اتفاقاً در مجمع البيان مرحوم طبری یا طبرسی علیه الرحمه هم یه روایت جالبی آورده زیر یه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.26,
   "end": 624.42,
   "text": "اینم قبلاً چون آیه شو برای شما گفتم روایتشو مبسوط میگم فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.42,
   "end": 627.18,
   "text": "یه رفرنس میدم یادتون بیاد چی رو دارم میزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.18,
   "end": 630.56,
   "text": "از اینجا اون موشک نقطه زن کجا رو میخواد بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.56,
   "end": 634.1,
   "text": "که یه شخصی بود برادر رضاعی عثمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.1,
   "end": 636.92,
   "text": "خلیفه سوم بود. این برادر رضاعیش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.92,
   "end": 640.14,
   "text": "شیر خورده بودن و همین از جزو کتاب وحی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.14,
   "end": 646.48,
   "text": "خلاصه‌ش اینه که می‌شستن پیغمبر وحی که نازل میشد همون موقع قرائت می‌فرمودن اینا می‌نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.48,
   "end": 649.16,
   "text": "این شخص نشسته بود پیغمبر یه آیه‌ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 649.16,
   "end": 653.5,
   "text": "که الان تو خاطرم نیست قبلاً گفتم آدرسش هم دادم نوشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.5,
   "end": 655.72,
   "text": "پیغمبر اول آیه رو شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.72,
   "end": 661.24,
   "text": "تازه وحی شده‌ها. شروع کرد بگه این شخص بقیه آیه رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.24,
   "end": 666.2,
   "text": "عجب! بعد پیغمبر فرمود همونی که گفتی درسته بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 666.2,
   "end": 674.72,
   "text": "خیلی عجیبه این روایت. کسی که درک و شعورش رو نداشته باشه، اینجا کم-- اینجا حکمت و عرفان میاد به کمک آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 674.72,
   "end": 677.1,
   "text": "براهین عقلی میاد کمک می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.1,
   "end": 682.0,
   "text": "که اینجا کینونت محل حضور پیغمبر این کارو کرده نه شخص که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.0,
   "end": 684.52,
   "text": "ایشون ادعا کرد که به منم وحی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.52,
   "end": 688.22,
   "text": "خب وحی هم فقط مختص انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.22,
   "end": 692.54,
   "text": "اون وحی خاص که شریعت رو تنزل میده فقط مختص انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 692.54,
   "end": 695.74,
   "text": "خدا هم غیور ش-- سرش بر وزن فعول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.74,
   "end": 698.42,
   "text": "میزنه. هر کسی که با این در بیفته میزنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 698.42,
   "end": 700.7,
   "text": "دنیا و آخرت. پیغمبر حکم قتلشو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.7,
   "end": 704.32,
   "text": "ارتداد. فرمود هرکی دیدش بکشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.32,
   "end": 706.24,
   "text": "اصلاً مجال ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 706.24,
   "end": 709.2,
   "text": "اینایی که میگن اینا پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.2,
   "end": 711.62,
   "text": "رحمت فقط رحمت، رحمت، رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 711.62,
   "end": 715.02,
   "text": "کی پیغمبر کسی رو کشته؟ کی؟ بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 715.02,
   "end": 719.02,
   "text": "حکم اعدام صادر کرد بدون هیچ دادگاهی خودشم حکم صادر کرد بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 719.02,
   "end": 722.1,
   "text": "با این مقدسات رو به تمسخر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 722.1,
   "end": 724.32,
   "text": "آقا این راه متأسفانه مسلمونا هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.32,
   "end": 726.38,
   "text": "مثل الان ما حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 726.38,
   "end": 733.66,
   "text": "خیلی از ما که دم از رهبر می‌زنیم، از ولایت و امام و چی و اینا بارها و بارها فرمایشات رهبر رو زمین می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 733.66,
   "end": 736.12,
   "text": "که ماها نمی‌تونیم جمعش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 736.12,
   "end": 739.72,
   "text": "منتظریم تا خود آقا بیاد پای گود اجرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 739.72,
   "end": 743.28,
   "text": "در حالی که او باید خطوط خ-- خط انقلاب رو مشخص کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 743.28,
   "end": 747.5,
   "text": "موازین اصلی حالا بماند و وارد مسائل اجرایی نباید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 747.5,
   "end": 752.44,
   "text": "پیغمبر اینو فرمود کسی کاری نکرد. یه روزی این نه کسی کاری باهاش نداره، پررو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 752.44,
   "end": 754.66,
   "text": "گفت بریم مثل اینکه پیغمبر ما رو بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.66,
   "end": 757.98,
   "text": "با وساطت عثمان اونم گفت حالا من میانجی‌گری می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 757.98,
   "end": 761.6,
   "text": "اومدن تو مسجد. پیغمبر وسط منبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 761.6,
   "end": 764.8,
   "text": "این نشست. بعد همه دیدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.8,
   "end": 768.48,
   "text": "هی نگاه می‌کردم به چشم پیغمبر ببینم پیغمبر چه عکس‌العملی نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 768.48,
   "end": 772.18,
   "text": "بله اینجا رحمت‌لل‌عالمین خودشم می‌گه چه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 772.18,
   "end": 776.14,
   "text": "هیچی فرمو-- نفرمودن. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 776.14,
   "end": 779.4,
   "text": "وقتی که جلسه تموم شد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 779.4,
   "end": 783.6,
   "text": "از نگاه اینا مردم و خود پیغمبر ترسید دفرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 783.6,
   "end": 790.38,
   "text": "گذاشت فرار کرد و اونجا یه نفر به پیغمبر گفت یا رسول الله مگه شما نفرمودید که هرجا دیدید بکشیدش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 790.38,
   "end": 793.22,
   "text": "فرمود بله گفتم. خب چرا الان نکردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.22,
   "end": 796.1,
   "text": "چرا ما، ما منتظر یه اشاره‌ی شما بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 796.1,
   "end": 799.28,
   "text": "پیغمبر اینو فرمود. بله بحث رحمت اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 799.28,
   "end": 804.14,
   "text": "می‌فرماید که ان، ان الأنبياء لا يقتلون بالإشارة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 804.14,
   "end": 807.06,
   "text": "با اشاره و اعماض و چشم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 807.06,
   "end": 811.26,
   "text": "نمی‌دونم چشمک و گوشه لب و اینا ما کسی رو نمی‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 811.26,
   "end": 815.02,
   "text": "ما حکم صادر می‌کنیم. شما تخطی کردید از این حکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 815.02,
   "end": 817.36,
   "text": "حالا این که بحث اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 817.36,
   "end": 820.24,
   "text": "چی باعث شد اون بقیه‌ی وحی رو بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 820.24,
   "end": 822.86,
   "text": "اون کینونت محضر پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 822.86,
   "end": 828.38,
   "text": "اون قداست در کن و در اون تکوین محضر پیغمبر نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 828.38,
   "end": 831.1,
   "text": "لذا محضر حضور رو هیچ‌وقت از دست ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 831.1,
   "end": 833.48,
   "text": "حالا بحث یه مقدار به حاشیه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 833.48,
   "end": 837.32,
   "text": "عین متن بود خودش حاشیه. اینکه پیغمبر فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 837.32,
   "end": 841.9,
   "text": "آخر عمر پیری که از پا می‌افته اعمال جوونیشو براش می‌نویسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 841.9,
   "end": 844.32,
   "text": "اعمالیه که همراهشه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 844.32,
   "end": 848.16,
   "text": "آه دلشه، سوز دلشه، ملکه وجودیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 848.16,
   "end": 854.86,
   "text": "اونه که در از کینونت از من و ام 如 ام 如 ام کنه استفاده کرده، سیرورت براش ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 854.86,
   "end": 857.08,
   "text": "شده، حسینی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 857.08,
   "end": 860.46,
   "text": "مهدوی شده، جمع‌کرانی شده، مسجدی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 860.46,
   "end": 864.14,
   "text": "هیئتی شده. تموم شده کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 864.14,
   "end": 867.68,
   "text": "یعنی نماز اصلاً خودش شده نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 867.68,
   "end": 870.78,
   "text": "خودش شده یه پا کربلا. می‌بیننش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 870.78,
   "end": 876.38,
   "text": "یاد کربلا می‌افتاد. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 876.38,
   "end": 879.54,
   "text": "صلى الله علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 879.54,
   "end": 882.36,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}