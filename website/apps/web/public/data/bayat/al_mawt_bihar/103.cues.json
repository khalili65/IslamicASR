 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ روایت هشتم؛ باب چهارم کتاب الموت",
   "start": 7.66,
   "end": 224.56
  },
  {
   "index": 1,
   "title": "## وجوه سؤال ابراهیم؛ اطمینان قلب و تردد اولیا",
   "start": 224.56,
   "end": 382.73
  },
  {
   "index": 2,
   "title": "## هزاران وجه کلام انبیا؛ مراتب قرآن",
   "start": 382.73,
   "end": 544.47
  },
  {
   "index": 3,
   "title": "## بیان فضائل اهل‌بیت و تطهیر قوا",
   "start": 544.47,
   "end": 597.37
  },
  {
   "index": 4,
   "title": "## وجه دیگر سؤال؛ باقی‌ماندن برای تجارت ایمان",
   "start": 597.37,
   "end": 700.05
  },
  {
   "index": 5,
   "title": "## برزخ‌های متعدد",
   "start": 700.05,
   "end": 808.42
  },
  {
   "index": 6,
   "title": "## روایت آدم و یوسف؛ اهمیت عمر",
   "start": 808.42,
   "end": 932.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.66,
   "end": 11.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.58,
   "end": 15.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.9,
   "end": 19.96,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.96,
   "end": 24.18,
   "text": "در روایت هشتم بودیم، باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.18,
   "end": 26.78,
   "text": "بین روایت بود که بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.78,
   "end": 29.92,
   "text": "نیمه کاره موند تا اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.92,
   "end": 35.12,
   "text": "وقتی حضرت قابض الارواح تشریف آوردن جان حضرت ابراهیم رو بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.12,
   "end": 38.48,
   "text": "سلام الله عليه و على نبيه و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.48,
   "end": 43.62,
   "text": "ایشون فرمودن که چگونه است که دوستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.62,
   "end": 46.0,
   "text": "مرگ دوستش رو بخواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.0,
   "end": 48.74,
   "text": "و حضرت عزرائیل برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.74,
   "end": 52.96,
   "text": "این پاسخ نزد حضرت حق رفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.96,
   "end": 61.42,
   "text": "و در مقام قرب بین ید الله جل جلاله قرار گرفتند که توضیح دادیم اجمالاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.42,
   "end": 64.64,
   "text": "فقال الهی قد سمعت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.64,
   "end": 67.26,
   "text": "قال خلیلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.26,
   "end": 69.86,
   "text": "ابراهیم علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.86,
   "end": 79.9,
   "text": "اینجا حضرت قابض الارواح به خدا عرض کرد خدایا خودت شنیدی که خلیل تو ابراهیم چی گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.9,
   "end": 82.18,
   "text": "این حالا اینجا خیلی حرف‌ها میشه زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.18,
   "end": 88.56,
   "text": "اولا حرمت نگه داشت حضرت قابض الارواح از حضرت ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.56,
   "end": 92.3,
   "text": "دو، ظاهراً به قدر این سؤال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.3,
   "end": 95.68,
   "text": "سؤال عجیب و سنگین بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.68,
   "end": 100.86,
   "text": "که گفتیم حضرت قابض الارواح به مقام حیرت افتاد و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.86,
   "end": 105.84,
   "text": "عین صحبت قاب-- حضرت ابراهیم رو ایشون بیان نکرده برای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.84,
   "end": 113.34,
   "text": "خودت شنیدی چی گفت. مثل اینکه شما یه حرف عجیبی از کسی میشنوی میخوای بری به کسی دیگه بگی، میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.34,
   "end": 117.24,
   "text": "دیگه من و من میکنی دیگه خودت میدونی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.24,
   "end": 119.76,
   "text": "شما شنیدی دیگه میدونی خبر داری دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.76,
   "end": 122.36,
   "text": "هی نمیخواد بگه چیه. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.36,
   "end": 127.04,
   "text": "اسراری است که در باطن این روایت هست که حالا ما هم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.04,
   "end": 129.42,
   "text": "نظرمون نیست که موشکافانه بریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.42,
   "end": 132.94,
   "text": "بعضاً نکاتی میگیم برای اهل پژوهش و تحقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.94,
   "end": 136.22,
   "text": "دقتشون بیشتر بشه. بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.22,
   "end": 139.6,
   "text": "خدایا تو خودت شنیدی که خلیلت چی گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.6,
   "end": 141.42,
   "text": "فقال الله جل جلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.42,
   "end": 144.16,
   "text": "حالا جواب خدا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.16,
   "end": 148.36,
   "text": "يا ملك الموت اذهب إليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.36,
   "end": 155.54,
   "text": "برگرد. این برگرد باز عرض کردیم چون ایشون مجرده دیگه بحث اونجا مجرداته این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.54,
   "end": 159.0,
   "text": "یعنی که توجهت رو به عالم ظاهر بنداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.0,
   "end": 164.08,
   "text": "الان که متوجه باطن عالم شدی حالا متوجه ظاهر عالم شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.08,
   "end": 167.84,
   "text": "نشئه طبیعت. اذهب إليه یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.84,
   "end": 171.62,
   "text": "و قل له بگو بهش، به خلیلم ابراهیم بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.62,
   "end": 175.28,
   "text": "هل رأيت عجب جوابی داده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.28,
   "end": 178.4,
   "text": "خداست و خدایی میکنه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.4,
   "end": 185.9,
   "text": "هل رأيت حبيبًا يكره لقاء حبيبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.9,
   "end": 194.54,
   "text": "آیا دیده‌ای که دوستی کراهت داشته باشه لقاء و دیدار و ملاقات دوستش رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.54,
   "end": 197.02,
   "text": "چقدر قشنگ خدا جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.02,
   "end": 200.92,
   "text": "إن الحبيب يحب لقاء حبيبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.92,
   "end": 204.76,
   "text": "قطعاً یه دوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.76,
   "end": 210.72,
   "text": "دوست دارد، می‌پسندد، خوش می‌دارد دیدار دوستش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.72,
   "end": 216.46,
   "text": "حالا اینجا یه وجهش رو که قبلاً ما عرض کردیم فکر می‌کنم در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.46,
   "end": 218.6,
   "text": "اگر اشتباه نکنم لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.6,
   "end": 223.26,
   "text": "شب‌های جمعه یا زهرا شرقی تهران اونایی که کانال رو پیگیرن اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.26,
   "end": 225.56,
   "text": "یه وجهش رو گفتیم. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.56,
   "end": 229.7,
   "text": "حضرت ابراهیم با اون مقام رفیعش اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.7,
   "end": 232.94,
   "text": "ااا، این سؤال رو مطرح کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.94,
   "end": 238.74,
   "text": "خب اگه واقعاً خلیل و رحمانه باید با شوق و اشتیاق سینه چاک کنه برای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.74,
   "end": 241.02,
   "text": "چون لقاء الله حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.02,
   "end": 243.82,
   "text": "اونجا یه وجهش رو گفتیم که یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.82,
   "end": 246.16,
   "text": "حالا یه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.16,
   "end": 248.0,
   "text": "ولأک ليطمئن قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.0,
   "end": 255.36,
   "text": "یه وجهش اینجاست که خواست مطمئن بشه که آیا واقعاً خدا او رو به محبت خودش، به خلیلیه خودش، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.36,
   "end": 260.72,
   "text": "حبیبیه خودش برگزیده است و این هنوز تو اون مقام هست یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.72,
   "end": 263.5,
   "text": "این تردد اولیاء الله است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.5,
   "end": 268.9,
   "text": "دائم در ترددن چون بین کثرت و وحدت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.9,
   "end": 273.92,
   "text": "و به صورت تام فارغ نشدن از مقام کثرت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.92,
   "end": 277.38,
   "text": "کثفت کثرت و توجهشون به خلق هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.38,
   "end": 281.14,
   "text": "بالاخره به یک وجهی میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.14,
   "end": 283.06,
   "text": "اون توجه تام، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.06,
   "end": 286.96,
   "text": "انقطاع تام این‌ها حاصل نمیشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.96,
   "end": 289.28,
   "text": "تو اینجا حالا ما حرف‌هایی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.28,
   "end": 293.24,
   "text": "اگر کسی حرف‌های بهتر از اونی که الان من گفتم خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.24,
   "end": 296.34,
   "text": "در رساله سیر و سلوکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.34,
   "end": 301.66,
   "text": "سید بحر العلوم که غروبای جمعه ما یا زهراى غرب میگیم تو کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.66,
   "end": 303.58,
   "text": "آخرین جلسه اون رو گوش بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.58,
   "end": 309.54,
   "text": "ما اینجا یه چیزکی گفتیم در این خصوص، در همین مقامی که الان داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.54,
   "end": 315.36,
   "text": "که، اه، چه موقع انسان به اون انقطاع کامل میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.36,
   "end": 317.74,
   "text": "که خدا رحمت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.74,
   "end": 324.46,
   "text": "علامه آستاد محمد حسین حسینی تهرانی در شرحش بر رساله سیر و سلوک سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.46,
   "end": 327.64,
   "text": "اونجا از مرحوم دهلوی میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.64,
   "end": 331.84,
   "text": "ایشون می فرمودن به من آگاهانیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.84,
   "end": 336.72,
   "text": "یعنی القاءات غیبیه بوده به قلب مقدس پاک ایشون که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.72,
   "end": 340.16,
   "text": "اه، اون علقه انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.16,
   "end": 347.28,
   "text": "علقه و توجهش تا پونصد سال بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.28,
   "end": 349.9,
   "text": "مرگش هست باهاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.9,
   "end": 353.66,
   "text": "تا پونصد سال برا-برای تازه آدمای کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.66,
   "end": 358.22,
   "text": "هست به عین ثابت خودش، اون علاقه و علقه و توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.22,
   "end": 361.8,
   "text": "حالا اینا مباحثی که اونجا پیاده کردیم کسی دوست داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.8,
   "end": 364.28,
   "text": "بره اونجا سیر کنه، دقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.28,
   "end": 368.53,
   "text": "یه جلسه هم هست، اون جلسه آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.53,
   "end": 373.33,
   "text": "بعد اینجا یه سؤال پیش میاد که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.33,
   "end": 378.03,
   "text": "حضرت ابراهیم حالا \"لیطمئن قلبی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.03,
   "end": 381.67,
   "text": "خواست به اطمینان برسه همین تمام یعنی این یک وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.67,
   "end": 385.67,
   "text": "نخیر. کلام انبیا، اولیا اینا هزاران وجه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.67,
   "end": 391.63,
   "text": "اگر آیات قرآن هر حرفش هفتاد هزار بسط داره، هفتاد هزار معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.63,
   "end": 393.87,
   "text": "اگر قرآن رو بزرگان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.87,
   "end": 397.93,
   "text": "مرحوم ابن فناری که شرح مصباح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.93,
   "end": 403.81,
   "text": "مصباح العنس رو شرح دادند در کتاب صدر‌الدین قونوی برجسته‌ترین شاگرد ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.81,
   "end": 406.51,
   "text": "عربی، اونجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.51,
   "end": 413.09,
   "text": "قرآن رو به چهار قص-- تس- تقسیم می‌کنند بنا به فرمایشات آل الله علیهم الصلاة والسلام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.09,
   "end": 417.15,
   "text": "زهر است و بسط است و حد است و مطلع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.15,
   "end": 419.75,
   "text": "مطلع یعنی ب-- اسم مکانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.75,
   "end": 422.77,
   "text": "یعنی اون صدر، اون بالا، اون قله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.77,
   "end": 427.71,
   "text": "اینا رو یک یک می‌شماره. حد و حدودی داره هر کدومش در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.71,
   "end": 431.41,
   "text": "رتبه‌ای از رتبه‌های وجودی انسان باید پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.41,
   "end": 434.31,
   "text": "ظاهر من، زبان من با ظاهر قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.31,
   "end": 436.87,
   "text": "معنوس می‌شه. بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.87,
   "end": 440.33,
   "text": "الحمد لله. این ظاهر من با ظاهر قرآن انس گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.33,
   "end": 444.99,
   "text": "اما حالا بواتن، اون باطن‌های قرآن چگونه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.99,
   "end": 451.81,
   "text": "قوه خیال من، مرتبه مثالی من، در عقل من، در قلب من، در سر من، در سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.81,
   "end": 458.55,
   "text": "سر من، در روح من. \"یا متبل Serair\" سریرت‌ها یه دونه دو تا که نیست که باطن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.55,
   "end": 464.17,
   "text": "ما هم بواتن داریم. قرآن با اون همه عمقش در-- چگونه در یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.17,
   "end": 466.83,
   "text": "رتبه‌های وجودی ما پیاده باید بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.83,
   "end": 469.27,
   "text": "که ما تو همین ظاهرش موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.27,
   "end": 475.79,
   "text": "همین با لسانمون اکراه داریم که گاهی یک سوره از قرآن بخونیم تند تند می‌خونیم بریم که جیبمون خالی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.79,
   "end": 478.19,
   "text": "سوره واقعه هر شب بخونیم فقیر نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.19,
   "end": 480.39,
   "text": "حالا بواتنش بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.39,
   "end": 483.41,
   "text": "این‌ها اسراری‌ست که آل الله فرمودند در کافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 483.41,
   "end": 487.25,
   "text": "کلینی اعلا مقام الشریف امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.25,
   "end": 490.17,
   "text": "فرمودند که آیات قرآن اسراری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.17,
   "end": 493.47,
   "text": "این‌ها خزانه‌ها، نه خزینه، جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.47,
   "end": 496.45,
   "text": "خزانه‌های الهی‌اند آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.45,
   "end": 499.99,
   "text": "برید و این خزانه‌ها رو کشف کنید امام صادق فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.99,
   "end": 503.71,
   "text": "کی دیگه؟ ریشامون سفید شد، موهامون سفید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.71,
   "end": 508.05,
   "text": "دیگه ان قريب است که بگن بلند بگو لا اله الا الله و ما بی‌خبر از قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.05,
   "end": 514.27,
   "text": "خیلی بده. قرآن، قرآن، القرآن که \"نا انزلناه في ليلة القدر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.27,
   "end": 519.53,
   "text": "در ظرف وجودی لیله که حضرت زهرای است، زهرای خدا، قدر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.53,
   "end": 523.11,
   "text": "ليلة القدر یعنی زهرای خدا در ظرف وجودی ایشون ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.11,
   "end": 525.47,
   "text": "\"لا یمسّه إلا المتطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.47,
   "end": 528.61,
   "text": "باید خیلی پاک باشه تا برسه به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.61,
   "end": 531.05,
   "text": "ما به ظاهر قرآن هم با اکراه مرتبطیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.05,
   "end": 534.25,
   "text": "امروز من احساس آلودگی عجیبی داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.25,
   "end": 538.25,
   "text": "احساس می‌کردم از جهنم دارم میام تو بهشت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.25,
   "end": 544.47,
   "text": "حالا دلیلی داشت. گفتم صحبت نکنم فقط نماز بخونیم و بالاخره قرآنی و بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.47,
   "end": 547.09,
   "text": "یاد اون روایت افتادم که بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.09,
   "end": 551.93,
   "text": "فضائل امیرالمؤمنین و آل الله ذریه پیغمبر عترت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.93,
   "end": 554.81,
   "text": "بیانش گناهان زبانی رو می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.81,
   "end": 556.79,
   "text": "دیدنش گناهان با چشم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.79,
   "end": 562.59,
   "text": "اصلاً مخصوصاً یکی از فضایل مولا رو کاغذ که دستمه نوشتم نگاهش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.59,
   "end": 565.25,
   "text": "گناهی اگر با چشم سر زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.25,
   "end": 569.11,
   "text": "شنیدنش، گناهانی که با شن-- با گوش شنیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.11,
   "end": 573.37,
   "text": "خدا می‌بخشه. این کرم خداست و مقام و رتبه بالای اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.37,
   "end": 576.57,
   "text": "مسش، قرآن، گناهی که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.57,
   "end": 583.03,
   "text": "قوه لامسه است. خیال، همین فکر کنی به امیرالمؤمنین فکر کنی گناهان خیالی‌ت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 583.03,
   "end": 588.77,
   "text": "پاک می‌شه. تعقل کنی یعنی اگه عقلت مشوب به وهم شده پاک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.77,
   "end": 591.33,
   "text": "این‌ها اسرار اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.33,
   "end": 593.51,
   "text": "باید این‌ها رو توجه داشت. حالا بحث ما چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.51,
   "end": 596.51,
   "text": "یه دفعه اینطوری شد. این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.51,
   "end": 600.59,
   "text": "وجه دی-- وجوه دیگری هم قطعاً دارد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.59,
   "end": 610.67,
   "text": "سؤال حضرت ابراهیم. یکیش این می‌تونه باشه که تمام مقامات رو حضرت ابراهیم به تمامه نرفته بود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 610.67,
   "end": 618.29,
   "text": "یعنی هنوز شما فکر می‌کنید مثلا حضرت ابراهیم یا انبیا تمام مراتب و مقامات رو رفتند تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 618.29,
   "end": 622.53,
   "text": "نه، اون فقط پیغمبر عزیز عالم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 622.53,
   "end": 628.81,
   "text": "به تبعش امیرالمؤمنین و این چهارده معصوم بودند به تمام همه مراتب و مقامات رو رفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 628.81,
   "end": 632.07,
   "text": "رضا شدن، چی؟ قرآن ناطق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 632.07,
   "end": 635.75,
   "text": "همه قرآن شدند. همه وجودشون شد همه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.75,
   "end": 640.27,
   "text": "بقیه انبیا کسری داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 640.27,
   "end": 643.61,
   "text": "نمی‌تونیم بگیم نقصی، جسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 643.61,
   "end": 646.43,
   "text": "یعنی به تمامه نرسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 646.43,
   "end": 651.31,
   "text": "به حالا مرتبه تام رسیدند اما اتم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 651.31,
   "end": 653.21,
   "text": "حضرت ابراهیم هم همین‌شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 653.21,
   "end": 659.47,
   "text": "اگر اینجا یه حالت ظاهراً اکراه گونه داره برای قبض روح خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 659.47,
   "end": 669.51,
   "text": "یه جهتش می‌تونه این باشه که دوست دارد بماند از این فرصت عمر و دنیا که متجر اولیاء الله است سوق المؤمن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.51,
   "end": 676.27,
   "text": "محل تجارت اهل ایمان و بازار اهل ایمان استفاده کنه به اون درجات که هنوز نرسیده برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 676.27,
   "end": 677.91,
   "text": "و این عمر خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 677.91,
   "end": 681.05,
   "text": "اینجا انقدر حرف‌ها بذل بگم پیاده کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 681.05,
   "end": 687.31,
   "text": "جلسه پانزدهم شرح مصباح العنس ابن فناری حضرت علامه حسن زاده رو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 687.31,
   "end": 692.09,
   "text": "دیگه نمی‌دونم باید سر به بیابون بگذارید وقتی این موضوع رو بیان می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 692.09,
   "end": 696.25,
   "text": "حالا دوست داشتید جلسه بعد نکاتی از همون جلسه عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 696.25,
   "end": 701.73,
   "text": "که مثلا حضرت آدم در عالم برزخ، خب می‌دونید ما برزخ متعدد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 701.73,
   "end": 704.83,
   "text": "اینم بحث آخرمون باشه و فرود بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 704.83,
   "end": 706.81,
   "text": "ما مثلا برزخ متعدد دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 706.81,
   "end": 714.95,
   "text": "الان عالم رتبه خیال ما یا مثال متصل ما که در درون ماست وقتی می‌خوابیم می‌ریم اونجا برزخ بین عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 714.95,
   "end": 718.33,
   "text": "ظاهر ماست. بدن، مرتبه ظاهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 718.33,
   "end": 720.65,
   "text": "عقل یا روح، مرتبه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 720.65,
   "end": 723.55,
   "text": "قوه خیال برزخه. ما برزخ متعدد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 723.55,
   "end": 726.43,
   "text": "مثلا امام عصر برزخ بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 726.43,
   "end": 728.57,
   "text": "حق و خلقه. م-یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 728.57,
   "end": 731.72,
   "text": "ریزش فیض الهی از کانال وجودی ایشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 731.72,
   "end": 734.94,
   "text": "صادر اول برزخ بین حق و خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 734.94,
   "end": 739.08,
   "text": "برز-- در قوس نزول ما برزخی داشتیم در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 739.08,
   "end": 742.58,
   "text": "حالا کیانی، سلسله‌ی کیانی جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 742.58,
   "end": 745.22,
   "text": "خلق و مخلوقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 745.22,
   "end": 748.66,
   "text": "ما اومدیم از من شیء عندنا خزائنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 748.66,
   "end": 754.6,
   "text": "و ما نزل و نازل که شدیم از ذات اعلا came اومدیم عالم عقول رو طی کردیم به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 754.6,
   "end": 759.9,
   "text": "برزخ اونجا در قوس نزول یعنی مثال، مثال منفصل بیرون از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 759.9,
   "end": 763.18,
   "text": "از اونجا اومدیم بعد به نشأت طبیعت وارد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 763.18,
   "end": 765.76,
   "text": "اونجا رو بهش میگن عالم زر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 765.76,
   "end": 773.0,
   "text": "به جهت قوس نزولش. حضرت-- بعد حالا در قوس صعود که داریم میریم دوباره ما برزخ داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 773.0,
   "end": 778.14,
   "text": "داریم میریم در قوس صعود چون تفرع محاله نمیشه یه دفعه بری عالم عقول و ارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 778.14,
   "end": 783.62,
   "text": "باید از نشأت طبیعت میری از عالم برزخ یا مثال عبور کنی بعد بری به عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 783.62,
   "end": 785.64,
   "text": "اونجا هم برزخ داریم که برزخ اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 785.64,
   "end": 792.06,
   "text": "اسمش برزخ اعماله. صور و اشکال و اونچه که ملکات وجودی ماست اونجا صورت‌گری میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 792.06,
   "end": 795.24,
   "text": "مثل تخم‌هایی که کاشتی رشد کرده، بارور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 795.24,
   "end": 798.48,
   "text": "اگه درخت خاره، خار اونجا تحویلت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 798.48,
   "end": 804.58,
   "text": "یعنی خودت خار شدی. اگر درخت گل و گیاه از روح و ریحانش خودت بهره میگیری در سایه‌ی وجودی خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 804.58,
   "end": 808.12,
   "text": "استفاده می‌کنی. یا بهشت شدی یا جهنم و برزخ اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 808.12,
   "end": 811.42,
   "text": "اونجا در عالم زر در قوس نزول ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 811.42,
   "end": 817.5,
   "text": "که بهش میگن عالم زر یا برزخ نزولی حضرت آدم اونجا توجه کرد به همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 817.5,
   "end": 820.78,
   "text": "ااا فرزندانش که من و شمام بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 820.78,
   "end": 824.16,
   "text": "یعنی اونجا متوجه شده به من و شما حضرت آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 824.16,
   "end": 825.92,
   "text": "بعد غصه خورد حضرت آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 825.92,
   "end": 827.62,
   "text": "این روایت رو داریم. مبسوط هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 827.62,
   "end": 831.26,
   "text": "من چون فرصت نیست سریع عرض کردم رد شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 831.26,
   "end": 835.56,
   "text": "یکی یکی نگاه کرد دید آخه یه سریا خیلی زود از دنیا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 835.56,
   "end": 841.08,
   "text": "آقا مشتم هم که ساعتش رو نگاه کرد آلارم کرد بسه دیگه وقت تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 841.08,
   "end": 845.7,
   "text": "مخصوصاً حضرت یوسف رو تو روایت میگه دید حضرت آدم گفت این بچه‌ی خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 845.7,
   "end": 850.1,
   "text": "من حضرت یوسف، این بچه‌ی خوب منه چرا باید انقدر عمرش کم باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 850.1,
   "end": 852.52,
   "text": "حضرت یوسف عمرش خیلی طولانی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 852.52,
   "end": 855.82,
   "text": "گفت خدایا بیست سال از عمر من رو بردار بذار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 855.82,
   "end": 860.56,
   "text": "عمر حضرت یوسف. این که ما زمان انقلاب یه سری اشکال می‌کردن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 860.56,
   "end": 863.78,
   "text": "مگه خدا بخیله میگه از عمر ما بکاه و به عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 863.78,
   "end": 867.1,
   "text": "رهبر بیفزا فلان. ما از این روایت اخذ کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 867.1,
   "end": 871.28,
   "text": "از خودمون که نگفتیم. بالاخره بخشید، خدا هم قبول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 871.28,
   "end": 874.84,
   "text": "بیست سال از عمر آدم برداشتن گذاشتن رو عمر حضرت یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 874.84,
   "end": 881.44,
   "text": "که وقتی حضرت آدم رو قابض الارواح داشت قبض روح می‌کرد، حضرت آدم گفت الان وقتش نیست ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 881.44,
   "end": 885.58,
   "text": "بیست سال مونده. فراموشش شده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 885.58,
   "end": 888.54,
   "text": "و نسیه. فراموشش شده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 888.54,
   "end": 892.32,
   "text": "بیست سال رو بخشیده. جد ما آدم سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 892.32,
   "end": 897.0,
   "text": "بعد حضرت قابض الارواح رو یادش آورد که نه شما بیست سال عمرتو بخشیدی به بچت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 897.0,
   "end": 901.5,
   "text": "حضرت یوسف. آها خب باشه راضی هستیم بفرمایید قبض روح کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 901.5,
   "end": 904.76,
   "text": "میخوام عرض کنم که این عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 904.76,
   "end": 909.74,
   "text": "انقدر مهمه که اگر اولیای خداییه مقدار همچین نیمچه کراهت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 909.74,
   "end": 912.06,
   "text": "یعنی دوست داشتن بیشتر بمونن علتش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 912.06,
   "end": 917.72,
   "text": "نه مثل من به جهت حب دنیا و علقه به دنیا بخوان بیشتر بمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 917.72,
   "end": 920.8,
   "text": "نه این نیست. اشتباه نشه. حالا این بحثو انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 920.8,
   "end": 926.52,
   "text": "ادامه میدیم. عاقبتش هم انشاالله ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 926.52,
   "end": 932.08,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}