 "chapters": [
  {
   "index": 0,
   "title": "## روایت پنجم باب چهارم؛ ولایت شیطان و شقاوت",
   "start": 0.38,
   "end": 147.78
  },
  {
   "index": 1,
   "title": "## چهار مقولهٔ هم‌بسته",
   "start": 147.78,
   "end": 218.7
  },
  {
   "index": 2,
   "title": "## تفاخر میانسالی و تکاثر کهنسالی",
   "start": 218.7,
   "end": 745.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.5,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.5,
   "end": 4.54,
   "text": "محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 4.54,
   "end": 10.72,
   "text": "محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.72,
   "end": 15.18,
   "text": "وآل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.18,
   "end": 18.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.22,
   "end": 23.48,
   "text": "السلام الیک یا داعی الله و ربانی ایاتہ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.48,
   "end": 27.26,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.26,
   "end": 29.66,
   "text": "بریم به روایت بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.66,
   "end": 34.36,
   "text": "از باب چهارم کتاب الموت روایت پنجم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.36,
   "end": 43.22,
   "text": "و قال اذ استحققت ولایة الشيطان و الشقاوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.22,
   "end": 46.98,
   "text": "جاء العمل بین العينین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.98,
   "end": 51.46,
   "text": "و ذهب الأجل وراء الظهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.46,
   "end": 55.16,
   "text": "پیغمبر عظیم الشأن اسلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.16,
   "end": 58.54,
   "text": "که هر وقت کسی مستحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.54,
   "end": 64.08,
   "text": "دوستی شیطان و بدبختی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.08,
   "end": 68.92,
   "text": "استحققت ولایة الشيطان و الشقاوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.92,
   "end": 74.5,
   "text": "هر وقت کسی مستحق بشه دو چیز رو، استحقاق ولایت شیطان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.5,
   "end": 78.08,
   "text": "و بدبختی و بیچارگی رو پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.08,
   "end": 83.04,
   "text": "نشونه‌ش چیه؟ جاء العمل با الف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.04,
   "end": 89.24,
   "text": "بین العينین. آرزوهای طولانی هی جلو چشمش رژه میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.24,
   "end": 94.12,
   "text": "هی آرزو داره. حالا امروز اینو بخرم، فردا اونو بخرم، اینطوری بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.12,
   "end": 98.96,
   "text": "همینطوری آرزوهای دني-- همش آرزوهای دنیویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.96,
   "end": 103.02,
   "text": "و دیگه چی؟ و ذهب الأجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.02,
   "end": 106.44,
   "text": "با الف باز. مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.44,
   "end": 110.78,
   "text": "وراء الظهر. پشت گوش میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.78,
   "end": 113.2,
   "text": "مرگ رو پشت سرش قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.2,
   "end": 115.52,
   "text": "اصلاً توجه به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.52,
   "end": 119.16,
   "text": "و مرگ و اجل قطعی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.16,
   "end": 122.22,
   "text": "یعنی شما ظاهرا ازش بپرسی آقا شما بالاخره میمیری یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.22,
   "end": 125.86,
   "text": "میگه بله، من رو قرآن دست میذارم قسم میخورم که میمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.86,
   "end": 131.4,
   "text": "اما در عمل معلومه که باوری به موت و اجل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.4,
   "end": 134.78,
   "text": "این عین روایت و متن روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.78,
   "end": 139.68,
   "text": "حالا اِممم کنایه ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.68,
   "end": 143.04,
   "text": "نکات بسیار زیادی تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.04,
   "end": 144.68,
   "text": "ظاهر قلیل وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.68,
   "end": 152.72,
   "text": "چند تاشو من عرض میکنم. حالا بحث ولایت شیطان رو باید یه جلسه مفصل و مبسط حرف بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.72,
   "end": 160.12,
   "text": "که مگر ما ولایتی به جز ولایت اهل بیت هم داریم که اینجا فرموده ولایة الشيطان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.12,
   "end": 162.12,
   "text": "و چگونه است؟ به چه صورت اینها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.12,
   "end": 165.76,
   "text": "ببینید چهار تا، اینجا چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.76,
   "end": 170.86,
   "text": "مطلب رو بیان کرده که این چهار تا مرتبه است به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.86,
   "end": 175.6,
   "text": "چهار تا مرتبه در هم تاثیرگذارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.6,
   "end": 184.18,
   "text": "چهار تا مرتبه است. حالا اگر از عقب شروع کنیم از انتها فرموده فراموشی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.18,
   "end": 189.24,
   "text": "فراموشی مرگ نتیجه‌ش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.24,
   "end": 194.22,
   "text": "فرمودن که جاء العمل بین العينين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.22,
   "end": 196.26,
   "text": "آرزوها میفته تو چشم آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.26,
   "end": 200.24,
   "text": "همش به فکر آرزوهای دنیوی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.24,
   "end": 205.94,
   "text": "اگر کسی دائما مشغول به آرزوهای دنیوی شد، این نتیجه‌ش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.94,
   "end": 209.18,
   "text": "شقاوة و الشقاوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.18,
   "end": 215.06,
   "text": "و کسی که شقاوة و بدبختی نصیبش شد، این کجا قرار می‌گیره جایگاهش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.06,
   "end": 222.16,
   "text": "فرمود ولایة الشيطان. این سه تا، چهار تا مرحله است که در این روایت وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.16,
   "end": 225.64,
   "text": "که اینا همه در هم تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.64,
   "end": 229.04,
   "text": "هر کدومش بیاد دیگری رو تقویت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.04,
   "end": 233.72,
   "text": "یعنی اگر کسی دچار ولایت شیطان بشه قطعاً بدبخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.72,
   "end": 240.74,
   "text": "بیچاره‌ست، شقاوة. قطعاً آرزوها میاد تو چشمش و قطعاً هم مرگ رو فراموش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.74,
   "end": 244.6,
   "text": "از اون طرف بگیر. اگر کسی مرگ و موت رو فراموش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.6,
   "end": 251.48,
   "text": "قطعاً آرزومند میشه، قطعاً بدبخت میشه و قطعاً تحت ولایت شیطان قرار میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.48,
   "end": 254.64,
   "text": "این به این صورته. یعنی در هم تاثیرگذارن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.64,
   "end": 257.02,
   "text": "چهار مقوله. نکته بعد این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.02,
   "end": 260.12,
   "text": "ولایت شیطان به یکباره تحت س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.12,
   "end": 262.34,
   "text": "ما تحت سیطرش قرار نمی‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.34,
   "end": 265.28,
   "text": "قدم به قدم، خطوه خطوه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.28,
   "end": 267.16,
   "text": "گام به گام پیش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.16,
   "end": 273.02,
   "text": "این نکته خیلی مهمه. اینو اجازه بدید که قرآنی درباره‌ش حرف بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.02,
   "end": 276.28,
   "text": "چون بحث‌های ما شاخه‌نباتی از قرآن حرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.28,
   "end": 279.12,
   "text": "این نکته آخر رو خوب توجه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.12,
   "end": 287.14,
   "text": "که آقا قدم به قدم، مرحله به مرحله، همونطور که ما عمرمون مرحله به مرحله پشت سر همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.14,
   "end": 291.34,
   "text": "من از همه دوستانم که وجاهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.34,
   "end": 294.14,
   "text": "به هر حال چی عرض کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.14,
   "end": 298.86,
   "text": "اولا اینجا خط مقدم جبهه فرهنگی نظامه، یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.86,
   "end": 301.84,
   "text": "بعضیا اینجا رو فدک حضرت زهرا میدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.84,
   "end": 304.64,
   "text": "ببخشید یه پرانتز باز کنم بین بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.64,
   "end": 310.74,
   "text": "من صبرم تو بحث خیلی زیاده بعضی موقع‌ها اما دیگه سر میره صبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.74,
   "end": 318.08,
   "text": "دو، این که همه الحمدالله تو وجاهت بچه انقلابی، بسیجی، سپاهی بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.08,
   "end": 322.22,
   "text": "سه، اینجا نمازخونه است. چهار، بیان آیات و روایات داره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.22,
   "end": 327.0,
   "text": "حرف، حرف من نیست. چهار، اصلاً و اونایی که میگن چرا بین دو نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.0,
   "end": 331.56,
   "text": "وظیفه سازمان اینه. حالا سازمان بی‌خیال شده ما که نباید بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.56,
   "end": 338.72,
   "text": "نیروهاشو تربیت کنن. یعنی ما الان داریم، خود منم قاطی شما تحت تربیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.72,
   "end": 342.76,
   "text": "اِاِاِ قال الله و قال رسول الله و اهل بیت قرار می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 342.76,
   "end": 348.14,
   "text": "باید این صحبت‌ها بشه. در نهایت توقع نمیره و یه همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.14,
   "end": 352.68,
   "text": "جایگاهی آدم بشینه بعد هی با ورعلسیش حرف بزنه، بخنده، صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.68,
   "end": 355.66,
   "text": "این خوب نیست. این جسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.66,
   "end": 357.52,
   "text": "ما بی‌خیال، ما جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.52,
   "end": 360.5,
   "text": "اما جسارت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.5,
   "end": 365.23,
   "text": "آیات و روایت نشه. کسی نمی‌خواد گوش بده به سلامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.23,
   "end": 370.11,
   "text": "نماز عصرتو برو تو اتاقت بخون یا بعدا بعدازظهر بیا بخون یا همین الان من ناراحت نمیشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.11,
   "end": 371.93,
   "text": "پاشو فردا عصرتو بخون برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.93,
   "end": 378.73,
   "text": "ولی وقتی میشینی بارها من اینو دیدم تحمل کردم و چند ساله بعضیا اصلا عادتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.73,
   "end": 384.21,
   "text": "میشینن با بغل دستی‌شون حرف، حرف، بگو، بخند خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.21,
   "end": 387.19,
   "text": "من از همتون دیدید مزاح هستم ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.19,
   "end": 390.05,
   "text": "حرف کار یه جایی داره دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.05,
   "end": 394.71,
   "text": "خوب نیست. جسارت نکنین به همدیگه، به حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.71,
   "end": 398.21,
   "text": "اینم بگم و بس سلام. فوقش حالا ما کمتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.21,
   "end": 404.47,
   "text": "وارد بحث میشیم دیگه. در خانه اگر کس است یک حرف بسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.47,
   "end": 409.91,
   "text": "آقا همونطور که ما زندگیمون مرحله به مرحله است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 409.91,
   "end": 411.97,
   "text": "بچگی داریم، کودک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.97,
   "end": 416.35,
   "text": "بعد نوجوون میشه، بعد جوون میشه، بعد میانسال میشه، بعد کهنسال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 416.35,
   "end": 421.71,
   "text": "شیطان هم متناسب با مراحل زندگی ما حمله ور میشه که ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.71,
   "end": 426.25,
   "text": "ما رو به دست بگیره. از کجا، از کدوم آیه اینو میگی آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.25,
   "end": 428.41,
   "text": "استناد می‌کنیم به آیه بیست حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 428.41,
   "end": 431.41,
   "text": "همین. درس امروز ما این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.41,
   "end": 435.53,
   "text": "الانم خودتونو محک بزنید جلو آینه‌ی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 435.53,
   "end": 438.29,
   "text": "آیه وایسید خودتونو نگاه کنید تو کدوم مرحله هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.29,
   "end": 441.79,
   "text": "شیطان الان به چه، به، با چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.79,
   "end": 445.41,
   "text": "وسیله‌ای، حربه‌ای شما رو میخواد تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.41,
   "end": 448.27,
   "text": "اعمل اعلموا. بدانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.27,
   "end": 452.59,
   "text": "انما الحیاة الدنيا خدا داره تشریح میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.59,
   "end": 456.45,
   "text": "حیات دنیوی پنج قسمته، پنج مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.45,
   "end": 459.45,
   "text": "اول لعب بازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 459.45,
   "end": 464.85,
   "text": "مال بچه‌هاست. شیطان هم بچه‌ها رو میاد با بازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.85,
   "end": 469.41,
   "text": "از همون اولش که نمیاد میگه کافر شو، نماز نخون، مشرک شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 469.41,
   "end": 473.25,
   "text": "نمی‌دونم برو دنبال زنا و شهوت و عرق و ورق و این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.25,
   "end": 476.51,
   "text": "از اول به بچه که اینا رو نمیگه مشغولش می‌کنه به بازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.51,
   "end": 480.19,
   "text": "ما هم رهاش می‌کنیم میگیم ولش کن بذار بازی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.19,
   "end": 484.61,
   "text": "تربیتشو متاسفانه رها می‌کنیم و انجام نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.61,
   "end": 488.19,
   "text": "که حضرت عیسی علیه النبی و آله و علیه الصلاة والسلام خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 488.19,
   "end": 495.81,
   "text": "شیرین در روایات داریم که در قصص الأنبیا که ایشون وقتی بچه‌ها تو محل بازی می‌کردن، ایشونم بچه‌سال بود، بچه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.81,
   "end": 500.97,
   "text": "طبیعت بچه بازیه دیگه. وایمیستاد نگاه می‌کرد با تعجب اینا رو نگاه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.97,
   "end": 504.67,
   "text": "بهش گفتن آخه شما چرا نمیاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.67,
   "end": 508.51,
   "text": "بازی کنی با ما؟ گفت دار، دار بازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.51,
   "end": 513.61,
   "text": "دار، دار حقیقته. در جوانی پاک بودن هم شیوه‌ی پیامبریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.61,
   "end": 517.89,
   "text": "اینه که خدا اختیارش می‌کنه از اول حواسش جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.89,
   "end": 520.09,
   "text": "پس لعب بازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.09,
   "end": 523.87,
   "text": "بچه‌ها رو به این شکل. این مال بچه‌هاست، کودکانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.87,
   "end": 525.81,
   "text": "وقتی نوجوون میشی و لع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.81,
   "end": 528.91,
   "text": "و لهو، لهو، سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.91,
   "end": 532.27,
   "text": "میگن سرگرم بشیم. حالا اوقات اصطلاحا میگیم فراغت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.27,
   "end": 535.83,
   "text": "سرگرم بشیم با هر چیزی سرگرمش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.83,
   "end": 538.23,
   "text": "و لو بازی هم نباشه سرگرمش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.23,
   "end": 542.05,
   "text": "بشینه حالا کارتون ببینه جلو تلویزیون و چه چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 542.05,
   "end": 548.97,
   "text": "برای کسی که جوون شد این دو تا مرحله رو پشت سر گذاشت دیگه خیلی با بازی و سرگرمی نمیاد شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 548.97,
   "end": 552.07,
   "text": "با چی میاد؟ و زینه تن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 552.07,
   "end": 564.39,
   "text": "دنبال زینت و جمال و اینکه خودش رو آرایش کنه و بی آرایه و به چشم دیگران بیاره، دیگران بهش توجه کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 564.39,
   "end": 566.77,
   "text": "عقده‌های درونیش رو بروز بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 566.77,
   "end": 572.81,
   "text": "یکی از درد‌هایی که من دلم درد می‌گرفت هر وقت این عصر جدید رو می‌دیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 572.81,
   "end": 578.75,
   "text": "اون لحظاتی بود که اکثراً این جوونا تو برنامه میومدن چی می‌گفتن یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 578.75,
   "end": 584.07,
   "text": "می‌گفتن خداروشکر که این برنامه بود که ما دیده بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 584.07,
   "end": 586.33,
   "text": "اومدن ما رو مطرح، ما دیده بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 586.33,
   "end": 589.11,
   "text": "این یه درد بزرگیه. جوون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 589.11,
   "end": 591.51,
   "text": "اصلاً برای چی دنبال دیده شدنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 591.51,
   "end": 597.83,
   "text": "واسه خدا ببیند، ولی خدا ببیند، مردم ببیننت چشت می‌زنن، بدبختت می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 597.83,
   "end": 602.53,
   "text": "چشم ندارن تو رو ببینن، چشم تنگن، نظر تنگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 602.53,
   "end": 606.13,
   "text": "زینت. جوون می‌خواد هی زینتش رو آشکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 606.13,
   "end": 608.97,
   "text": "حالا خستتون نکنیم رد شیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 608.97,
   "end": 611.35,
   "text": "میره مرحله‌ی چی؟ میانسالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 611.35,
   "end": 617.23,
   "text": "الان اکثر شمایی که اینجا نشستید ما اکثرمون میانسالیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 617.23,
   "end": 619.89,
   "text": "میانسالی رو طبق این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 619.89,
   "end": 622.65,
   "text": "شیطان چگونه تصرف می‌کنه درش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 622.65,
   "end": 626.51,
   "text": "آیا گفتید؟ جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 626.51,
   "end": 629.45,
   "text": "تفاخر. آفرین و تفاخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 629.45,
   "end": 631.81,
   "text": "اینجا با حب ریاست، ریاست طلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 631.81,
   "end": 633.55,
   "text": "جوون خیلی ریاست طلب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 633.55,
   "end": 637.13,
   "text": "پیر هم خیلی ریاست طلب-- میانسالان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.13,
   "end": 642.45,
   "text": "خیلی دنبال ریاست طلبی و حب جاه و مقام و پست و میز و س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 642.45,
   "end": 645.15,
   "text": "این چیزا. برتری جویی بر دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.15,
   "end": 650.15,
   "text": "تفاخر. بعد جالبه تو آیه فرمود تفاخر و بع این کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 650.15,
   "end": 651.77,
   "text": "نسبت می‌گیره با دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.77,
   "end": 653.89,
   "text": "من از فلانی به بهترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 653.89,
   "end": 657.49,
   "text": "تحصیلاتم بالاتره. اصل و نسبم بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 657.49,
   "end": 660.21,
   "text": "مدیریتم قوی‌تره. همش خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.21,
   "end": 663.35,
   "text": "می‌سنجه بین، تفاخر یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.35,
   "end": 667.97,
   "text": "فخر فروشی می‌کنه با داشته‌هاش نسبت به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 667.97,
   "end": 671.37,
   "text": "حالا کسی که کهنسال شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.37,
   "end": 675.13,
   "text": "شیطان اینو چجوری میاد تصرف کنه ولایت رو دست بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 675.13,
   "end": 679.39,
   "text": "هرکی گفت. نترسید بلند بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 679.39,
   "end": 682.23,
   "text": "اگه می‌دونید. حالا آیه رو که اگه حفظ نیستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 682.23,
   "end": 686.25,
   "text": "ادامه‌ی آیه رو بخونید. چقدر شما باهوشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 686.25,
   "end": 690.63,
   "text": "و تكاثر و تكاثر في الأموال والأولاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 690.63,
   "end": 696.75,
   "text": "دیگه آیه ادامه داره بسه. کسی که سنش رفت بالا تکاثر می‌گیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 696.75,
   "end": 700.35,
   "text": "می‌خواد با مالش، با اولادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.35,
   "end": 702.97,
   "text": "و لو به هیچکس چیزی نمیگه ها. تفاخر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 702.97,
   "end": 705.11,
   "text": "فخر بفروشه. بگه ببین چند تا بچه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 705.11,
   "end": 708.83,
   "text": "ببین چقدر مال و-- نه اصلاً تو خودش تکاثر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 708.83,
   "end": 711.15,
   "text": "یعنی کیف می‌کنه، عشق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 711.15,
   "end": 713.83,
   "text": "شب که می‌خوابه به به دلار رفت بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 713.83,
   "end": 716.27,
   "text": "ملک کشید بالا، املاکم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 716.27,
   "end": 720.61,
   "text": "این ملاک‌هایی که اینجا نشستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 720.61,
   "end": 723.27,
   "text": "کیف می‌کنن. به به دیگه وضعم توپ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.27,
   "end": 726.41,
   "text": "آقا بچه‌هام اینطوری شدن. این، این میشه تکاثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 726.41,
   "end": 731.45,
   "text": "این میشه دام شیطان. خط به خط به یکی از همون بچگی ما رو می‌کشونه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 731.45,
   "end": 734.19,
   "text": "ولایت خودش، تا پیری. پناه بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 734.19,
   "end": 736.59,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.59,
   "end": 739.41,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 739.41,
   "end": 745.17,
   "text": "الله- الله صلي علي محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}