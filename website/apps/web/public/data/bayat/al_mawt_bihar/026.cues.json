 "chapters": [
  {
   "index": 0,
   "title": "## سه چیز که سر را فرود می‌آورد",
   "start": 14.02,
   "end": 349.1
  },
  {
   "index": 1,
   "title": "## گسترش مطلب 026/5",
   "start": 349.1,
   "end": 659.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 6.28,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.28,
   "end": 9.88,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.88,
   "end": 12.36,
   "text": "بالاخره از روایت چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.36,
   "end": 15.12,
   "text": "بیرون اومدیم و میریم سراغ روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.12,
   "end": 19.36,
   "text": "پنجم از باب اول کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.36,
   "end": 22.92,
   "text": "علیه الرحمة. ببینیم درون مایه این روایت چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.92,
   "end": 27.54,
   "text": "البته ایشان از دعوات راوندی آورده این روایت رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.54,
   "end": 31.64,
   "text": "پیغمبر عزیز عالم فرمودند \"لولا ثلاثة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.64,
   "end": 35.86,
   "text": "في ابن آدم\" اگر سه تا چیز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.86,
   "end": 38.08,
   "text": "فرزند آدم نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.08,
   "end": 40.22,
   "text": "\"ما تعتع رأسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.22,
   "end": 44.94,
   "text": "شیئاً\" سر فرود نمی‌آورد به هیچ وجه جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.94,
   "end": 48.06,
   "text": "هیچ چیزی. حالا تو زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.06,
   "end": 51.68,
   "text": "جامعه کبیره میگیم تعتع با طای دسته دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.68,
   "end": 54.52,
   "text": "\"کل شریف لشرفه کن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.52,
   "end": 58.62,
   "text": "یعنی همه خاضع‌اند، سرها پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.62,
   "end": 62.12,
   "text": "هر با شرافت در برابر شرف شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.12,
   "end": 64.94,
   "text": "سرش پایینه. این تعتع یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 64.94,
   "end": 66.96,
   "text": "ریشه‌اش از سر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.96,
   "end": 69.74,
   "text": "فرودی و سر به پایین بودن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 69.74,
   "end": 73.54,
   "text": "میفرماید حالا اگر این سه تا چیز در فرزند آدم نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.54,
   "end": 77.06,
   "text": "در برابر هیچ چیزی سر فرود نمی‌آورد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.06,
   "end": 80.3,
   "text": "یعنی خضوع نداشت. اون سه تا چیز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 80.3,
   "end": 82.6,
   "text": "\"المرض والموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 82.6,
   "end": 87.3,
   "text": "والفقر وكله نفيه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 87.3,
   "end": 93.12,
   "text": "خیلی جالبه باز تاکید میکنه که این سه تا درش هستا \"كله نفيها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.12,
   "end": 96.02,
   "text": "و انه لمعاهن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.02,
   "end": 99.42,
   "text": "همراهشه \"وثاب وثاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.42,
   "end": 103.08,
   "text": "با اینکه همراهشه باز طغیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 103.08,
   "end": 105.8,
   "text": "خیلی جالبه این سه چیز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 105.8,
   "end": 110.9,
   "text": "مرض مریضیه، موت هم که مشخصه درباره‌ش داریم صحبت می‌کنیم و فقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 110.9,
   "end": 115.0,
   "text": "فقرش هم که ذاتیه دیگه اصلاً یه نیاز درونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.0,
   "end": 118.24,
   "text": "سرمنشاء همه این‌ها هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 118.24,
   "end": 122.7,
   "text": "نیازه که این نیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 122.7,
   "end": 128.06,
   "text": "یکی از محبت‌های الهی به بندشه برای اینکه رو به او کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.06,
   "end": 132.08,
   "text": "که اگر این نیاز نبود ما کی رو به خدا می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.08,
   "end": 136.58,
   "text": "اتفاقاً صریح آیه پونزده سوره فاتحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.58,
   "end": 143.74,
   "text": "که این خیلی من این آیه رو دوست دارم که \"یا ایها الناس الناس\" همه مردم همه بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.74,
   "end": 146.38,
   "text": "که \"انتم الفقراء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.38,
   "end": 149.52,
   "text": "الى الله والله هو الغني الحمید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.52,
   "end": 153.78,
   "text": "همون هوی که تو نماز میگی \"قل هو الله احد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.78,
   "end": 157.4,
   "text": "همون تو نیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.4,
   "end": 159.5,
   "text": "ذاتی به او داری. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.5,
   "end": 163.34,
   "text": "خیلی شیرین که به چی من نیاز دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.34,
   "end": 166.58,
   "text": "فقرا به چی؟ الى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.58,
   "end": 169.34,
   "text": "یعنی ما فقر ذاتی به الله داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.34,
   "end": 171.9,
   "text": "نیاز داریم که چون اسم جامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.9,
   "end": 175.0,
   "text": "اسماء الهی رو در خودمون پیاده کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.0,
   "end": 178.42,
   "text": "که اصلاً چیزی که در زندگی ما متاسفانه تعطیله همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 178.42,
   "end": 180.26,
   "text": "اصلاً اسماء الهی کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 180.26,
   "end": 182.66,
   "text": "کی من رئوفم؟ کی رحیمم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 182.66,
   "end": 184.74,
   "text": "کی ره-رحمانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 184.74,
   "end": 188.9,
   "text": "کی رحمان یعنی به همه خیر برسونم حتی به بدام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 188.9,
   "end": 191.02,
   "text": "بخوام دست اونا هم بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 191.02,
   "end": 194.14,
   "text": "کی من کریمم؟ کی جوادم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 194.14,
   "end": 196.64,
   "text": "اوه، اوه، اوه. این سمت که بریم که دیگه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 196.64,
   "end": 198.62,
   "text": "کی ستارم؟ عیب میپوشونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 198.62,
   "end": 201.96,
   "text": "بالعکس. حالا بماند بحث ما چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 201.96,
   "end": 204.14,
   "text": "آیه چهل و دو سوره انعام رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 204.14,
   "end": 209.38,
   "text": "اصلاً زیربنای این مشکلات و سختی‌ها در دنیا من جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 209.38,
   "end": 213.78,
   "text": "این سه تا چیزی که ظاهراً انسان رو در زيق قرار میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 213.78,
   "end": 215.74,
   "text": "چیه؟ به چه خاطره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 215.74,
   "end": 217.58,
   "text": "چرا خدا این کارو داره با ما میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 217.58,
   "end": 220.32,
   "text": "چرا مرگی گذاشته؟ چرا مریضی گذاشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 220.32,
   "end": 222.58,
   "text": "آقا خدا چرا ما رو فقیر محض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 222.58,
   "end": 225.64,
   "text": "فقیر محض به سمت خودت خلق کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 225.64,
   "end": 228.08,
   "text": "\"ولقد ارسلنا الى امم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 228.08,
   "end": 238.6,
   "text": "من قبلکم\". میگه، می فرمود به تحقیق ما رسولانی رو فرستادیم به امت‌های پیشین \"فأخذناهم بالبعثى والراء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 238.6,
   "end": 242.58,
   "text": "اصلاً این سنت الهیه که ما این‌ها رو گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 242.58,
   "end": 246.88,
   "text": "بلا و سختی و پریشانی و مصیبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 246.88,
   "end": 249.02,
   "text": "که چی بشه خدایا؟ چرا بلا میاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 249.02,
   "end": 251.54,
   "text": "چرا مصیبت میریزی سر بندگانت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 251.54,
   "end": 255.46,
   "text": "آقا جون خیرخواه ماست \"لعلهم يتبرعون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 255.46,
   "end": 262.68,
   "text": "برای اینکه بیان زاری کنن \"تبرع لعلهم\" بلکه آنها \"يتبرعون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 262.68,
   "end": 266.8,
   "text": "به تضرع بیفتن. خدا دوست داره این حالت بنده‌ش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 266.8,
   "end": 270.68,
   "text": "دوست داره بنده سر به زیر باشه از اون علو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 270.68,
   "end": 273.52,
   "text": "خودبرتربینی، خودشیفتگی بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 273.52,
   "end": 277.02,
   "text": "اتفاقاً انقدر چون کبریاi مخصوص خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 277.02,
   "end": 283.36,
   "text": "سر سوزنی وقتی خدا در بنده‌ای که دوسش داره روایات داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 283.36,
   "end": 286.4,
   "text": "خودشیفتگی حالا به یک معنا عُجبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 286.4,
   "end": 289.3,
   "text": "ببینه، اینجا چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 289.3,
   "end": 292.72,
   "text": "سریع اون چیزی که باعث خودشیفتگیش شده رو ازش میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 292.72,
   "end": 296.22,
   "text": "هرچی میخواد باشه حتی نماز شبش باشه، حتی نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 296.22,
   "end": 298.72,
   "text": "اول وقتش باشه اینا میگیره ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 298.72,
   "end": 300.88,
   "text": "روایت صریح داریم. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 300.88,
   "end": 304.18,
   "text": "انقدر که بدش میاد خدا از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 304.18,
   "end": 310.5,
   "text": "کبریاi، تبختر، این حالت نگاه بالا به پایین، نگاه بالا پایین فقط مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 310.5,
   "end": 313.1,
   "text": "کبریاi مخصوص خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 313.1,
   "end": 316.42,
   "text": "لباس خاص خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 316.42,
   "end": 320.62,
   "text": "که متاسفانه بعضی از بندگان خدا این رو به تن می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 320.62,
   "end": 322.8,
   "text": "حالا وقتی می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 322.8,
   "end": 324.72,
   "text": "امیرالمومنان اونم کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 324.72,
   "end": 326.76,
   "text": "قربونتون برم. کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 326.76,
   "end": 332.06,
   "text": "بالاخره هر کدوم از ما توی برهه‌ای از زندگیمون یا مدیر بودیم یا هستیم یا خواهیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 332.06,
   "end": 334.32,
   "text": "بالاخره مدیر زندگی خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 334.32,
   "end": 337.66,
   "text": "پدر که هستیم، عقل زندگیمون که هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 337.66,
   "end": 339.42,
   "text": "فکر می‌کنیم دیگه اینا مال منن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 339.42,
   "end": 344.14,
   "text": "من سوار بر اونام. هر کاری بخوام بکنم دیگه بدتر از اون که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 344.14,
   "end": 346.5,
   "text": "بعضی از مسئولین و مدیران ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 346.5,
   "end": 350.82,
   "text": "نگاه‌های بالا به پایین بیچاره کرده مردم رو از بعضیاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 350.82,
   "end": 357.16,
   "text": "که امیرالمومنان وقتی نگاه می‌کنی این روایت رو کی اتفاق افتاده تعجب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 357.16,
   "end": 360.47,
   "text": "وقتیه که نفر اول مملکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 360.47,
   "end": 362.99,
   "text": "تو دوران حکومتش این اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 362.99,
   "end": 369.37,
   "text": "تو بازار، می‌بینی یه کارگری داره بار می‌بره یهو کفشش، یه لنگه کفشش از پاش در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 369.37,
   "end": 373.57,
   "text": "این داره میره، یه لنگه کفش، انقدر بارش سنگینه نمی‌تونه برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 373.57,
   "end": 380.07,
   "text": "مولا بدو بدو به قول ما میره همین‌طوری که عباش به زمین کشیده داره میشه میسم-- میدوه به سمت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 380.07,
   "end": 384.79,
   "text": "باربر کفششو برمی‌داره و خم می‌شه به پای این کارگر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 384.79,
   "end": 390.67,
   "text": "یکی اون که گلگی می‌کنه آقا در شان شما نیست، شما شخص اول رئیس مملکت فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 390.67,
   "end": 392.85,
   "text": "فرمود ما اصن برای همین اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 392.85,
   "end": 396.43,
   "text": "ما اومدیم برای همین که بار از رو دوش دیگران برداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 396.43,
   "end": 399.71,
   "text": "و نمی‌دونم بعضیا چگونه‌ست که خدای نکرده اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 399.71,
   "end": 401.89,
   "text": "کسی که ظرفیت نداره بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 401.89,
   "end": 408.53,
   "text": "یه وقت خدای نکرده مسئولیتی بگیره، مدیریتی بگیره، در اتاقش بسته‌ست احس-- اهدی نمی‌تونن ببیننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 408.53,
   "end": 413.11,
   "text": "حتی یه عده‌ای اصن جماعت‌ها رو هم ترک می‌کنه، نماز جماعتشم دیگه نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 413.11,
   "end": 415.43,
   "text": "آقا تو چه جور مسلمانی؟ تو چه جور--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 415.43,
   "end": 419.75,
   "text": "مگر قرآن نمی‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 419.75,
   "end": 422.37,
   "text": "وقتی تمکن در زمین پیدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 422.37,
   "end": 428.79,
   "text": "یه معناش حالا به یک معنا به یک وجه می‌تونه این باشه که به شما توکن دادن که مدیر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 428.79,
   "end": 431.63,
   "text": "اولین نشونه‌ش اقامه صلاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 431.63,
   "end": 436.89,
   "text": "یعنی می‌خوای ببینی حال یه ارا-- اداره خوبه یا نه، حال یک شرکت خوبه یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 436.89,
   "end": 439.13,
   "text": "خب جایی بری موس-- استخدام شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 439.13,
   "end": 442.03,
   "text": "حال اون شرکت خوبه یا نه؟ حال اون سازمان خوبه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 442.03,
   "end": 444.65,
   "text": "حال اون مدرسه، اون دانشگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 444.65,
   "end": 448.59,
   "text": "اون هیئت، یهو اذان داده خادما دارن دیگ می‌شورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 448.59,
   "end": 453.03,
   "text": "ببین اقا-- اقامه صلاة رخ می‌ده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 453.03,
   "end": 455.11,
   "text": "اگر رخ نمی‌ده اینا حالشون خرابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 455.11,
   "end": 457.27,
   "text": "اینا احساس نیاز نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 457.27,
   "end": 464.89,
   "text": "این برای اصن این موت برای اینه میگم از موهبت‌های الهیه که ما رو بکشونه به سمت حضرت حق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 464.89,
   "end": 467.05,
   "text": "اگر این نباشه که وای بر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 467.05,
   "end": 469.69,
   "text": "و چه عجیب که متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 469.69,
   "end": 473.41,
   "text": "ما وقتی می‌افتیم به تضرع که دیگه کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 473.41,
   "end": 477.17,
   "text": "دیگه می‌بینیم قابض الارواح تشریف آوردن اون موقع دیگه فایده نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.17,
   "end": 481.99,
   "text": "در آیه شصت و نه سوره عنکبوت می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 481.99,
   "end": 491.79,
   "text": "این آیه رو زیاد توجه کنیم. وقتی سوار کشتی شدن چون موج بالاخره موج دریا می‌زنه، کشتی خطرناک رو آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 491.79,
   "end": 494.35,
   "text": "به شدت با خلوص خدا رو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 494.35,
   "end": 497.33,
   "text": "آی خدا فلان کمک کن اینطور نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 497.33,
   "end": 499.37,
   "text": "تو مشکلات و مصائب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 499.37,
   "end": 504.31,
   "text": "اما قرآن داره میگه من نمیگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 504.31,
   "end": 507.77,
   "text": "به محض اینکه نجاتشون دادیم بردیمشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 507.77,
   "end": 511.19,
   "text": "بردیمشون کجا؟ توی خشکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 511.19,
   "end": 516.41,
   "text": "اونجا چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 516.41,
   "end": 519.49,
   "text": "دوباره برمی‌گردن به اون حالت قبل و شرک می‌ورزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 519.49,
   "end": 523.19,
   "text": "اینه که می‌بینی انبیا قربونت برن مثلا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 523.19,
   "end": 526.55,
   "text": "موسی گشنشه، تشنه شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 526.55,
   "end": 528.89,
   "text": "میره نمیگه خدایا نون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 528.89,
   "end": 530.57,
   "text": "خدایا مثلا آب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 530.57,
   "end": 534.57,
   "text": "چیکار می‌کنه؟ چی، چیکار-- همین دعایی که ما تو قنوت هر روز می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 534.57,
   "end": 545.97,
   "text": "خیلی شیرینه. میره زیر سایه درخت تکیه می‌ده به درخت رو به آسمون میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 545.97,
   "end": 549.41,
   "text": "علامه می‌گفت اینو بکشید. فقیرررر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 549.41,
   "end": 552.79,
   "text": "خیلی من فقیرم. این سره دیگه داره اعلام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 552.79,
   "end": 556.95,
   "text": "بعدم خدا بهترین، بهترین مقدرات رو براش ناظر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 556.95,
   "end": 562.37,
   "text": "یا حضرت یونس این ذکر یونسیه که خیلی شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 562.37,
   "end": 567.91,
   "text": ". چقدر ما کم اینا رو می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 567.91,
   "end": 569.85,
   "text": "یا حتی ذکر حضرت ایوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 569.85,
   "end": 577.65,
   "text": "اینا چقدر از تلمذه علیه الرحمه تاکید می‌کردن به این ادعیه قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 577.65,
   "end": 579.25,
   "text": "حضرت ایوب به خدا گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 579.25,
   "end": 583.49,
   "text": "خدا من به من پریشونی رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 583.49,
   "end": 588.57,
   "text": ". یعنی اون پیغمبر خدا اینطوری سر به زیر سرشو انداخته پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 588.57,
   "end": 591.51,
   "text": "اصن فلسفه موت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 591.51,
   "end": 595.13,
   "text": "موت اومده برای اینکه من و شما رو سرمونو بندازه پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 595.13,
   "end": 597.71,
   "text": "جالبه که در یک حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 597.71,
   "end": 601.83,
   "text": "اِاِاِ مقاله ای می‌خوندم که جهانی بود، خیلی سال‌های پیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 601.83,
   "end": 605.23,
   "text": "که تنها چیزی که تو کل دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 605.23,
   "end": 611.99,
   "text": "بیشترین معتقد رو به خودش اختصاص داده حتی از توحید و یگانگی حق هم جلو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 611.99,
   "end": 615.33,
   "text": "یعنی کیا بیشتر از همه مثلا معتقد به چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.33,
   "end": 619.23,
   "text": "کثرت اعتقاد روی یه نقطه متمرکز و تجمع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 619.23,
   "end": 621.59,
   "text": "متمرکز شده. اون چیه؟ مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.59,
   "end": 625.03,
   "text": "یعنی همه نمی‌گم باور دارن، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 625.03,
   "end": 628.61,
   "text": "قبول دارن که می‌میرن حداقل علم فکریشو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 628.61,
   "end": 635.85,
   "text": "باز این وضع ماست. باز این وضع ماست که متاسفانه تکبرها، خودبرتربینی‌ها، خودشیفتگی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 635.85,
   "end": 640.57,
   "text": "که اگر این نبود که ما مثل مولامون علی افتاده حال بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.57,
   "end": 645.03,
   "text": "واقعا بار از رو دوش دیگران برمی‌داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.03,
   "end": 650.63,
   "text": "یه پدر خوب می‌شدیم برای بچه‌هامون که اینا امانت‌های الهی دست ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 650.63,
   "end": 653.29,
   "text": "خدا به ما و همه‌مون ایشالا رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.29,
   "end": 655.07,
   "text": "ایشالا عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.07,
   "end": 659.67,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهumma صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}