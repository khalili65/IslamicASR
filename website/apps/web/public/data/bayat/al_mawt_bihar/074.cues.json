 "chapters": [
  {
   "index": 0,
   "title": "## روایت سوم باب چهارم؛ کثرت ذکر موت",
   "start": 1.08,
   "end": 110.0
  },
  {
   "index": 1,
   "title": "## فرق فوت و وفات و موت",
   "start": 110.0,
   "end": 256.88
  },
  {
   "index": 2,
   "title": "## قید انسان؛ بشر و آدم و انسان",
   "start": 256.88,
   "end": 612.9
  },
  {
   "index": 3,
   "title": "## حکایت سعدی در دمشق",
   "start": 612.9,
   "end": 767.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.08,
   "end": 4.48,
   "text": "در روایت سوم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.48,
   "end": 7.36,
   "text": "کتاب الموت مرحوم مجلسی دو سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.36,
   "end": 10.7,
   "text": "از روایت رو ما تقدیم کردیم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.7,
   "end": 14.8,
   "text": "دو سه تا نکته عرض کنم در این روایت که اینا مهم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.8,
   "end": 23.12,
   "text": "یه مرتبه دیگه صورت روایت رو بخونیم بهره بگیرید از نورانیتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.12,
   "end": 26.88,
   "text": "حضرت فرمودن که یعنی کسی از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.88,
   "end": 29.98,
   "text": "باقر صلوات الله علیه سؤال کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.98,
   "end": 33.04,
   "text": "که یه چیزی بگید که به ما نفع برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.04,
   "end": 37.6,
   "text": "حضرت فرمودن \"ما اکثر ذکر الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.6,
   "end": 43.94,
   "text": "کسی بسیار یاد موت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.94,
   "end": 48.96,
   "text": "اونم \"انسان\" یعنی انسان باشه این قیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.96,
   "end": 56.64,
   "text": "انسان اگر زیاد یاد موت کنه این اتفاق نمیفته مگر اینکه \"الا زهد في الدنيا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.64,
   "end": 59.38,
   "text": "زاهد می‌شه در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.38,
   "end": 63.98,
   "text": "یعنی راه رسیدن به زهد در دنیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.98,
   "end": 66.2,
   "text": "بفرمایید. اکثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.2,
   "end": 70.06,
   "text": "اونم ذکر موت، نه خود موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.06,
   "end": 74.34,
   "text": "عرض کردیم که خیلی اینجا تأکید در تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.34,
   "end": 78.06,
   "text": "اولاً که ذکره، ذکر یعنی دائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.06,
   "end": 82.08,
   "text": "یعنی هر روز. دائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.08,
   "end": 84.64,
   "text": "ایشون توجه داره به بحث موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.64,
   "end": 89.98,
   "text": "بعد دوباره یه اکثر هم آورده یعنی تأکید در تأکید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.98,
   "end": 95.58,
   "text": "یعنی دیگه دائم اصلاً نمی‌شه لحظه‌ای رو ازش گرفت که این یاد موت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.58,
   "end": 98.04,
   "text": "این یه نکته که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.04,
   "end": 101.52,
   "text": "نکته بعدی پیرامون خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.52,
   "end": 106.8,
   "text": "کلمه موته. کلمه موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.8,
   "end": 110.0,
   "text": "خب ااا می‌دونید که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.0,
   "end": 114.5,
   "text": "قرآن ما هم از موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.5,
   "end": 118.58,
   "text": "می‌بینیم که بسیار یاد شده هم از وفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.58,
   "end": 123.08,
   "text": "و هم از اه موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.08,
   "end": 127.08,
   "text": "از این سه تا یاد شده. فرق اینا در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.08,
   "end": 133.56,
   "text": "حالا من یه تحقیق و بررسی اینجا کرده بودم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.56,
   "end": 139.42,
   "text": "اه منابع تفسیریمون که فرق بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.42,
   "end": 145.66,
   "text": "موت و وفات و موت در قرآن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.66,
   "end": 150.58,
   "text": "این تحقیق رو خب الان نه شما حوصلشو دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.58,
   "end": 153.12,
   "text": "اه نه جلسه اقتضا می‌کنه از ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.12,
   "end": 155.16,
   "text": "حیث زمانی که من اینو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.16,
   "end": 158.02,
   "text": "فقط اه آدرس میدم برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.02,
   "end": 160.64,
   "text": "اگر کسی خواست کار تحقیقی بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.64,
   "end": 165.1,
   "text": "حداقل آیات رو بگم براتون شماره‌هاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.1,
   "end": 167.84,
   "text": "موت در قرآن به دو تا معنا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.84,
   "end": 170.5,
   "text": "یا از دست دادن چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.5,
   "end": 172.94,
   "text": "مثل آیه بیست و سه حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.94,
   "end": 175.36,
   "text": "من این آیات رو هم نوشته بودم که براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.36,
   "end": 178.88,
   "text": "حالا برید خودتون ببینید. آیه بیست و سه سوره حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.88,
   "end": 182.62,
   "text": "یا به معنای اختلاف و اضطرابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.62,
   "end": 188.54,
   "text": "چی؟ موت که مثل آیه سه سوره ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.54,
   "end": 190.96,
   "text": "اما وفات. وفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.96,
   "end": 195.08,
   "text": "به معنی گرفتن به تمام یک چیزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.08,
   "end": 200.24,
   "text": "اونجا که قرآن فرمود \"الله یتوفی الانفس حين موتها\" یعنی به تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.24,
   "end": 202.9,
   "text": "خدا می‌گیره نفس هر کسی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.9,
   "end": 206.02,
   "text": "وقت موت و وقت خواب البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.02,
   "end": 208.9,
   "text": "اینجا وفات رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.9,
   "end": 212.28,
   "text": "که یک ترجمه بیشتر ازش مفسرین نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.28,
   "end": 219.26,
   "text": "مثل همین آیه که عرض کردیم یا آیه یازده سوره سجده \"قل يتوفاک ملک الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.26,
   "end": 221.6,
   "text": "میاد به تمام نفست رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.6,
   "end": 224.4,
   "text": "تماماً دیگه برزخ بین روح و نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.4,
   "end": 227.82,
   "text": "ببخشید برزخ بین روح و جسم که نفس باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.82,
   "end": 231.6,
   "text": "گرفته می‌شه. دیگه روح نمی‌تونه احکامش رو در بدن پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.6,
   "end": 234.16,
   "text": "لذا اصطلاحاً می‌گیم بدن مُرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.16,
   "end": 240.96,
   "text": "می‌شه البته بدن دنیوی می‌میره می‌شه جسم، جسد می‌شه یعنی می‌شه تفاله اون بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.96,
   "end": 245.4,
   "text": "اخروی. و الا انسان همیشه همراه بدنش هست، بدن اخروی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.4,
   "end": 247.36,
   "text": "بدن برزخی داره. البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.36,
   "end": 251.62,
   "text": "بدن‌ها در طول هم‌ند، تفاوتشون در نقص و کمالشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.62,
   "end": 256.58,
   "text": "که این بحث‌ها بین ما گذشته. اما موت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.58,
   "end": 262.86,
   "text": "موت خیلی کثرت استعمال داره در قرآن که اینجا هم دقت بفرمایید تو حدیث می‌فرماید که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.86,
   "end": 265.7,
   "text": "\"ما اکثر ذکر الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.7,
   "end": 267.52,
   "text": "نمی‌گه وفات. نمی‌گه موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.52,
   "end": 272.88,
   "text": "می‌گه موت. خب موت در قرآن به چه معانی اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.88,
   "end": 276.26,
   "text": "اولاً در مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.26,
   "end": 282.62,
   "text": "اه قوه‌ی نامیه موجود در انسان، حیوانات و جمادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.62,
   "end": 288.28,
   "text": "در-- و نباتات در قرآن اومده مثل آیه چهل و نه سوره فرقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.28,
   "end": 292.3,
   "text": "می‌تونید برید ببینید و متوجه بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.3,
   "end": 300.0,
   "text": "در یک جای دیگه در آیه شصت و شش سوره مریم به عنوان از بین رفتن قوه‌ی احساس اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.0,
   "end": 309.18,
   "text": "موت. در آیه صد و بیست و دو سوره انعام به عنوان از بین رفتن قوه‌ی عاقله اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.18,
   "end": 312.68,
   "text": "یعنی جهل. این رو موت شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.68,
   "end": 318.74,
   "text": "یعنی کسی عقلشو تعطیل کرد از نظر قرآن میته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.74,
   "end": 323.44,
   "text": "عقلشو تعطیل کرد میت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.44,
   "end": 326.44,
   "text": "در آیه صد و نوزده آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.44,
   "end": 330.54,
   "text": "برای هر امری که زندگی رو تیره می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.54,
   "end": 332.44,
   "text": "اصطلاحاً بهش میگن موت مجازي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.44,
   "end": 335.68,
   "text": "هر چیزی که زندگی رو تیره کنه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.68,
   "end": 337.62,
   "text": "اطلاق کرده قرآن بهش موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.62,
   "end": 340.02,
   "text": "در آیه چهل و دو زمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.02,
   "end": 345.22,
   "text": "همین آیه زیبایی که چند بار هم با هم خوندیم امروز هم قرائت کرد \"الله یتوفی الانفس حين موتها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.22,
   "end": 349.04,
   "text": "اینجا به معنای خواب اومده که یه جلسه هم درباره‌ش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.04,
   "end": 352.74,
   "text": "یعنی موت در قرآن یه معناش تعبیر به خواب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.74,
   "end": 359.94,
   "text": "در آیه سی زمر در مقابل حیات و از بین رفتن قوه‌ی حیوانی و جدایی روح از بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.94,
   "end": 362.4,
   "text": "وقتی روح از بدن جدا می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.4,
   "end": 365.6,
   "text": "و اون قوه حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.6,
   "end": 371.56,
   "text": "از بین میره دیگه اینو اصطلاحاً در این آیه همچنین آیه صد و هشتاد و پنج سوره آل عمران بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.56,
   "end": 376.52,
   "text": "از موت یاد شده. حالا زیاده تا همین مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.52,
   "end": 379.26,
   "text": "تبرک هم بسنده می‌کنیم. پس چرا اینا رو گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.26,
   "end": 383.76,
   "text": "برای اینکه فرق بین موت، وفات و فوت رو بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.76,
   "end": 386.02,
   "text": "که این حدیث رو وقتی می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.02,
   "end": 387.78,
   "text": "یه مقدار بیشتر متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.78,
   "end": 392.5,
   "text": "یعنی چی که ما \"أكثر ذكر الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.5,
   "end": 396.98,
   "text": "اگه کسی خیلی، خیلی زیاد یاد موت کنه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.98,
   "end": 403.54,
   "text": "یعنی این چیزایی که ما گفتیمو یادشون کنه که گفتم یکی از بهترین جاهایی که ما یاد موت می‌کنیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.54,
   "end": 405.52,
   "text": "خواب هست که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.52,
   "end": 411.38,
   "text": "نکته‌ی دیگه. چه کسی زیاد یاد موت کنه خروجی‌ش می‌شه زهد در دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.38,
   "end": 413.64,
   "text": "فرمود انسان ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.64,
   "end": 419.06,
   "text": "اینم یه قید. انسان، نه هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.06,
   "end": 421.54,
   "text": "ناس نگفته، گفته انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.54,
   "end": 426.58,
   "text": "چه فرقی هست مگر بین انسان مثلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.58,
   "end": 429.48,
   "text": "عرض شود آدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.48,
   "end": 432.16,
   "text": "ناس. فرق بین اینا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.16,
   "end": 438.68,
   "text": "اینم یه نکته‌ای عرض کنم. اولا در قرآن گاهی اوقات از ماها به بشر یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.68,
   "end": 442.56,
   "text": "چند بار اومده؟ حالا اینا رو من آیاتشم هستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.56,
   "end": 446.54,
   "text": "فرصت اقتضا اینا خودش واقعا یه ده تا منبر می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.54,
   "end": 450.8,
   "text": "سی و پنج بار تو قرآن به عنوان بشر از ما یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.8,
   "end": 456.24,
   "text": "کی؟ وقتی که منظور جسم ظاهری و پوست و بدن انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.24,
   "end": 459.64,
   "text": "میگه بشر، پوست، بشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.64,
   "end": 465.82,
   "text": "وقتی که حالت ظاهری انسان رو خدا می‌خواد حرف در بارش بزنه میگه بشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.82,
   "end": 471.44,
   "text": "وقتی که آدم، اسم آدم اومده اینجا رو گفتن علم برای شخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.44,
   "end": 474.76,
   "text": "اسم علم برای شخصه. بیست و پنج بار در آرا-آد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.76,
   "end": 476.86,
   "text": "در قرآن اومده. \"علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.86,
   "end": 481.38,
   "text": "آدم الاسماء كلها.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.38,
   "end": 484.6,
   "text": "بیست و پنج بار اومده. حالا باید رفت اونجا تفاسیر رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.6,
   "end": 488.96,
   "text": "یه کار تحقیقی خیلی شیرین و زیبایی می‌شه که الحمدالله ما هم انجام دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.96,
   "end": 491.24,
   "text": "خیلی هم عسلش رو چشیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.24,
   "end": 496.24,
   "text": "چقدر شیرین بود. دوست داشتید می‌تونید رجوع کنید به کانال بحث‌هاش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.24,
   "end": 501.12,
   "text": "انسان. گاهی اوقات هم قرآن از ما به انسان یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.12,
   "end": 504.66,
   "text": "منظور از انسان چیه که اینجا تو حدیث میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.66,
   "end": 509.48,
   "text": "اگر انسان خیلی یاد موت کنه خروجی‌ش می‌شه زهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.48,
   "end": 514.72,
   "text": "اولا شصت و پنج بار در قرآن اومده یعنی بیشتر از بشر و آدم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.72,
   "end": 522.5,
   "text": "یعنی بشر و آدم رو روی هم بذاری می‌شه دقیقا شصت بار اما شصت و پنج بار از انسان یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.5,
   "end": 526.76,
   "text": "مراد باطن، کمالات و استعدادهای درونی اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.76,
   "end": 531.66,
   "text": "یعنی چی؟ خلاصه اگر کسی باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.66,
   "end": 539.64,
   "text": "ارتباط گرفت، استعدادهای درونی‌ش شکوفا شد در مسیر موت که سفر آخرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 539.64,
   "end": 544.94,
   "text": "چنین کسی اگر زیاد یاد موت کرد \"زهد عن الدنيا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 544.94,
   "end": 549.66,
   "text": "ببینید چقدر باید کلمات رو یک، یک بررسی کرد، زیر و رو کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 549.66,
   "end": 554.58,
   "text": "تا به یک فحوایی از یک حدیث اونم نسبت به صعه وجودیمون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 554.58,
   "end": 559.58,
   "text": "پس نه اینکه همینطوری من بشینم علم فکری راه بندازم و موت رو زیر و رو کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 559.58,
   "end": 561.72,
   "text": "از همین کاری که الان دارم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 561.72,
   "end": 564.0,
   "text": "تحقیق و پژوهش و بررسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 564.0,
   "end": 567.08,
   "text": "علم در-- علمیست پیرامون موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.08,
   "end": 569.56,
   "text": "این علت مؤدّه است تامه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.56,
   "end": 571.24,
   "text": "کمک هم می‌کنه تا اونو بفهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 571.24,
   "end": 574.0,
   "text": "اما اون چشیدن مربوط به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.0,
   "end": 579.64,
   "text": "الان این صوته، ماده‌ست، ظاهره من دارم حرف می‌زنم و شما می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 579.64,
   "end": 581.9,
   "text": "کی می‌شه باطن؟ که انسان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.9,
   "end": 585.1,
   "text": "انسان وقتی به کمالاتش، استعداداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.1,
   "end": 587.92,
   "text": "رسید و این شکوفا شد تازه انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.92,
   "end": 589.86,
   "text": "اون موقع اگر چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.86,
   "end": 597.72,
   "text": "بسیار یاد موت کرد، اون هم موت با اون معنی که گفتیم، اون موقع زهد در-- برای همین زاهدها خیلی کم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.72,
   "end": 600.3,
   "text": "بی‌رغبتهایی به دنیا خیلی کم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.3,
   "end": 605.26,
   "text": "کم اتفاق می‌افته کسی از دنیا دل بکنه عزیزان دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.26,
   "end": 607.56,
   "text": "از بین حتی ما مذهبی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.56,
   "end": 612.14,
   "text": "همین الان که اینو می‌گفتم تو ذهنم جرقه زد یاد یه حکایتی افتادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.14,
   "end": 617.58,
   "text": "از حضرت سعدی. اینم خوبه بشنوید در انتهای بحث شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.58,
   "end": 622.42,
   "text": "که سعدی نشسته بود در مسجد جامع درستش دمشقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.42,
   "end": 628.08,
   "text": "حالا میگن دمشق. نشسته بود با دانشمندان بحث علمی به زبان عربی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 628.08,
   "end": 630.74,
   "text": "می‌دونید فول بود زبان عربیشو به قولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.74,
   "end": 636.46,
   "text": "بعد ، یه جوونی وارد شد تو مسجد گفت کی اینجا فارسی بلده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.46,
   "end": 640.38,
   "text": "دید همه دارن عربی صحبت می‌کنن گفت کی فارسی بلده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.38,
   "end": 642.94,
   "text": "به زبان عربی به اینا گفت کی فارسی بلده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.94,
   "end": 645.7,
   "text": "همه سعدی رو نشون دادن. گفتن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.7,
   "end": 648.98,
   "text": "گفت چیه؟ گفت یه پیرمرد صد-- دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 648.98,
   "end": 654.36,
   "text": "یه پیرمرد صد و پنجاه ساله داره جون میده به زبان فارسی وصیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 654.36,
   "end": 657.8,
   "text": "ما نمی‌فهمیم چی میگه. شما پاشو بیا ببینیم چی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 657.8,
   "end": 660.46,
   "text": "سعدی میگه پاشدیم رفتیم. البته این روایت مبسوطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 660.46,
   "end": 665.02,
   "text": "من بخش اولشو دارم میگم. رفتیم با زبان فارسی با ایشون تکلم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 665.02,
   "end": 666.98,
   "text": "گفتیم حالت چطوره پیرمرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 666.98,
   "end": 670.22,
   "text": "صد و پنجاه سال عمر کردی. نوش جونت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 670.22,
   "end": 675.34,
   "text": "دو سه جمله‌ی عجیب گفت. این دو سه جمله‌ی عجیب چاشنی بحث امروز ما می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 675.34,
   "end": 678.32,
   "text": "گفت چی بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 678.32,
   "end": 683.16,
   "text": "لحظه‌ای بیش، لحظه‌ای بیش در این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 683.16,
   "end": 688.06,
   "text": "بهره نبردی و لقمه‌ای بیش نخوردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 688.06,
   "end": 691.3,
   "text": "که بلافاصله به ما گفتن بس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 691.3,
   "end": 696.14,
   "text": "یعنی آماده شو برای رفتن. یعنی صد و پنجاه سال عمر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 696.14,
   "end": 700.2,
   "text": "میگه یه لحظه بود. یه لقمه ما ازش بیشتر بهره نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 700.2,
   "end": 703.16,
   "text": "حالا میگن پاشو بریم. یعنی یه نوع اعتراض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 703.16,
   "end": 710.08,
   "text": "بعد سعدی میگه باهاش صحبت کردم و اینا میگه که بحث مزاج رو پیش گرفت که آیا راهی هست ما خوب بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.08,
   "end": 712.3,
   "text": "، دوباره بمونیم تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 712.3,
   "end": 717.7,
   "text": "شما اینو بذارید کنار \"اللهم عجل وفاتی سریعة صديقة كبرى سلام الله علیها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 717.7,
   "end": 726.32,
   "text": "صد و پنجاه سالشو باز میگه یه راهی هست آقای سعدی طبیبی بیارید مزاج شناس باشه ما بمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 726.32,
   "end": 730.18,
   "text": "البته بحث ادامه داره، جالبه، شیرینه برید ببینید حکایتشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.18,
   "end": 733.56,
   "text": "هرکسی نمی‌تونه دل از دنیا بکنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 733.56,
   "end": 735.86,
   "text": "کار می‌بره. انسان باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 735.86,
   "end": 739.98,
   "text": "با همین رموزی که ما در این حدیث کشف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 739.98,
   "end": 742.98,
   "text": "اون موقع زاهد می‌شه، دل از دنیا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 742.98,
   "end": 746.64,
   "text": "چنین کسی برزخش مثل برق طی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 746.64,
   "end": 750.68,
   "text": "یه آنه. یعنی اصلاً برزخ نداره چون دلبستگی به دنیا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 750.68,
   "end": 755.44,
   "text": "همه‌ی برزخ ما به خاطر علقه‌ها و دلبستگی‌های ماست که بحث‌هاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 755.44,
   "end": 758.88,
   "text": "خدا به هممون رحم کنه. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 758.88,
   "end": 762.36,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 762.36,
   "end": 767.1,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}