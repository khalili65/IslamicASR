 "chapters": [
  {
   "index": 0,
   "title": "## ابوهن نور و امهن رحمة",
   "start": 12.06,
   "end": 37.52
  },
  {
   "index": 1,
   "title": "## رحمانیتِ جهنم و رحیمیتِ بهشت",
   "start": 37.52,
   "end": 211.18
  },
  {
   "index": 2,
   "title": "## روح ردت؛ نفس توفی و اخراج",
   "start": 211.18,
   "end": 467.8
  },
  {
   "index": 3,
   "title": "## خروجِ نفس؛ ورود به بدنِ برزخی",
   "start": 467.8,
   "end": 669.18
  },
  {
   "index": 4,
   "title": "## ساختنِ بدن و جان با عمل و معرفت",
   "start": 669.18,
   "end": 755.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 2.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.54,
   "end": 5.8,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.8,
   "end": 7.72,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.72,
   "end": 10.6,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.6,
   "end": 14.74,
   "text": "نکته‌ی دیگری که در ادامه بحث موت باید عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.74,
   "end": 17.84,
   "text": "و جالب توجه هست البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 17.84,
   "end": 21.32,
   "text": "به متن حدیث چهارم از باب اول هم به نوعی برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 21.32,
   "end": 25.14,
   "text": "ما داریم که خب در برگشت‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.14,
   "end": 28.68,
   "text": "به سمت اون جایگاه اصلی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.68,
   "end": 30.74,
   "text": "فرمودن \"ابوهن نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 30.74,
   "end": 36.86,
   "text": "و امهن رحمه\". به یک معنا ما برمی‌گردیم به سمت پدر و مادرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 36.86,
   "end": 40.16,
   "text": "\"ابوهن نور\" یعنی پدر این‌ها نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.16,
   "end": 43.22,
   "text": "پدر کی؟ ماها. نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.22,
   "end": 46.04,
   "text": "مادر کیه؟ \"وامههن رحمه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 46.04,
   "end": 53.74,
   "text": "مادرشون رحمته. حالا که این که چرا خب پدر نوره که اون ماده اولیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.74,
   "end": 57.76,
   "text": "پدر مقام دهش داره، مادر مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.76,
   "end": 61.88,
   "text": "گیرنده داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 61.88,
   "end": 64.78,
   "text": "الولد سر ابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 64.78,
   "end": 67.52,
   "text": "فرزند سر پدرشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.52,
   "end": 70.4,
   "text": "و الله نور السماوات والارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.4,
   "end": 77.48,
   "text": "الله هم نور آسمان‌ها و زمینه و اون الله که اسم جامعه در بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.48,
   "end": 84.18,
   "text": "مصداقش، مصداق اتمش می‌شه پیغمبر عزیز عالم، انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.18,
   "end": 87.08,
   "text": "که ما قبلاً عرض کردیم ما به همون سمت میریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.08,
   "end": 90.2,
   "text": "حالا چرا \"امههن رحمه\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.2,
   "end": 92.78,
   "text": "خب این رحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.78,
   "end": 97.22,
   "text": "بالاخره مادرشون از رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.22,
   "end": 103.86,
   "text": "یعنی کسی هم که میره به سمت جهنم میره به اسم اسماء جلالی، به سمت اسماء جلالی میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.86,
   "end": 107.28,
   "text": "نه جمالی، جلال. ذو انتقام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.28,
   "end": 110.0,
   "text": "شدید العقاب، ها؟ قههار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.0,
   "end": 116.64,
   "text": "حالا این‌ها هم مادرشون رحمته یعنی این‌هام به سمت رحمت میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.64,
   "end": 118.9,
   "text": "بله. چگونه می‌گیریم این حرفو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.9,
   "end": 121.54,
   "text": "اولاً زعیم ما، بزرگ ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.54,
   "end": 123.54,
   "text": "حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.54,
   "end": 126.88,
   "text": "فرمودن که جهنم هم از رحمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.88,
   "end": 129.86,
   "text": "\"یا من سبقت رحمته غضبه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.86,
   "end": 132.56,
   "text": "اصلاً مبنای جهنم هم بر بستر رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.56,
   "end": 137.68,
   "text": "یه تبعیدگاهیه برای آماده‌سازی که تصفیه شن برن بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.68,
   "end": 143.18,
   "text": "لذا غالب و اکثر غریب به اتفاق انسان‌ها در نهایت میرن بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.18,
   "end": 146.34,
   "text": "خالدین اونایی که مخلدن یه عده‌ قلیلی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.34,
   "end": 149.9,
   "text": "که حالا بحثش بماند. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.9,
   "end": 154.2,
   "text": "حالا رحمت اینجا این رحمت رحمانیه‌ست یا رحیمی‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.2,
   "end": 161.08,
   "text": "اینجا که قرآن می‌فرماید \"منهم الا واردها\" هیچ کس نیست مگر اینکه وارد جهنم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.08,
   "end": 164.34,
   "text": "یعنی از جهنم می‌گذریم می‌ریم به بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.34,
   "end": 167.74,
   "text": "پس چون همه‌گانیه می‌شه رحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.74,
   "end": 169.58,
   "text": "رحمانیه. همه‌گانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.58,
   "end": 172.82,
   "text": "جهنم رحمت رحمانیت. رحمته اما رحمانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.82,
   "end": 176.38,
   "text": "بهشت رحمت رحیمی‌ست. پس این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 176.38,
   "end": 184.28,
   "text": "برگشت می‌کنند به مادرهاشون و مادرهاشون هم رحمته، چ-- حتی اگر به سمت جهنم هم کسی بره داره باز به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 184.28,
   "end": 186.56,
   "text": "مادرش میره. اینو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 186.56,
   "end": 189.4,
   "text": "لذا فرمودن بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.4,
   "end": 194.72,
   "text": "حضرت علامه فرمودن که جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.72,
   "end": 198.46,
   "text": "تجلی جلال سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 198.46,
   "end": 201.26,
   "text": "بهشت تجلی جمال سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.26,
   "end": 204.96,
   "text": "باز برگشت می‌کنه به انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.96,
   "end": 207.02,
   "text": "اما نکته‌ای که اینجا می‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.02,
   "end": 213.64,
   "text": "عرض کنیم با توجه به متن ما عرض کردیم یه نفس داریم‌ها در این برگشت داریم برگشت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.64,
   "end": 217.48,
   "text": "یه نفس داریم، یک روح. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.48,
   "end": 222.28,
   "text": "این روح برگشت می‌کنه تکلیف نفس چی می‌شه بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.28,
   "end": 224.66,
   "text": "چون در خصوص روح داشتیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.66,
   "end": 227.08,
   "text": "\"فردت الروح والنور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.08,
   "end": 230.26,
   "text": "الى القدرة القدس الاولى\". روح خب تکلیفش مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.26,
   "end": 238.16,
   "text": "اون ماهیت، اون هویت بهتره بگیم، هویت ذاتی ماست که کانال وجودی و ارتباطی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.16,
   "end": 241.06,
   "text": "از رب به وجودمون به اون رب مطلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.06,
   "end": 243.4,
   "text": "اصلاً باید با اون روح بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.4,
   "end": 245.8,
   "text": "لذا ردت، برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.8,
   "end": 249.04,
   "text": "اما نفس چی؟ قصه نفس چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.04,
   "end": 252.46,
   "text": "آیا نفس باقی می‌مونه یا نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.46,
   "end": 254.96,
   "text": "از بین میره؟ چیه؟ تکلیف نفس چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.96,
   "end": 259.86,
   "text": "اون در حقیقت برزخ بین روح و بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.86,
   "end": 263.9,
   "text": "که از اون شأن، از اون طریق روح بدن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.9,
   "end": 267.34,
   "text": "مدیریت می‌کرد دیگه. تعلق روح به بدن رو می‌گن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.34,
   "end": 273.24,
   "text": "این چی می‌شه؟ اتفاقاً در یه دعای خیلی شیرینه در کتاب فلاح السائل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.24,
   "end": 275.42,
   "text": "خیلی حضرت استاد توک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.42,
   "end": 277.02,
   "text": "توصیه به همین کتاب می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 277.02,
   "end": 279.1,
   "text": "فلاح السائل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 279.1,
   "end": 282.84,
   "text": "نجاح المسائل مرحوم سید ابن طاووسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 282.84,
   "end": 286.78,
   "text": "من کتاب رو دارم. خیلی کتاب شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 286.78,
   "end": 291.7,
   "text": "صفحه صد و هفتاد و سه‌ش یه دعایی حضرت-- از حضرت زهرا سلام الله علیها میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 291.7,
   "end": 296.86,
   "text": "کی؟ سید ابن طاووس بزرگ که دیگه رو حرفش بزرگان حرف نمی‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.86,
   "end": 301.0,
   "text": "حضرت صدیقه طاهره سلام الله علیها در متن دعا یک بخشیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.0,
   "end": 305.22,
   "text": "اینچنین عرض می‌کنن که \"وبشرا من کرامتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.22,
   "end": 309.0,
   "text": "قبل ان تتوفی نفسي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 309.0,
   "end": 311.88,
   "text": "تکلیف نفس مشخص شد. تتوفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.88,
   "end": 315.38,
   "text": "قرآن هم می‌فرماید الله-- ان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 315.38,
   "end": 319.34,
   "text": "اون کسی که هو-- اون کسی که توفی نفس می‌کنه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 319.34,
   "end": 323.16,
   "text": "الله. \"يتوفی الانفس حين موتها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.16,
   "end": 328.56,
   "text": "هر کسی می‌میره \"يتوفی الانفس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.56,
   "end": 330.58,
   "text": "نفسش توفی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.58,
   "end": 333.32,
   "text": "توفی هم یعنی بس-بس-به طور کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.32,
   "end": 338.66,
   "text": "گرفته می‌شه. حالا در خصوص نفس حضرت زهرا داره می‌گه-- بحث چی رو مطرح می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.66,
   "end": 341.24,
   "text": "توفی رو. بریم جلوتر دو مرتبه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 341.24,
   "end": 343.6,
   "text": "بحث نفس رو می‌گه حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 343.6,
   "end": 345.5,
   "text": "\"وتقبض روحی\". عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 345.5,
   "end": 349.9,
   "text": "بحث روح که می‌شه چه اصطلاحی رو استفاده می‌کنه بی بی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 349.9,
   "end": 352.84,
   "text": "تقبض، قبض. اصلاً قابض الارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 352.84,
   "end": 356.72,
   "text": "حضرت عزرائیل سلام الله علیه از این جهت اسمش قابضه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 356.72,
   "end": 359.3,
   "text": "مجری اسم قابض حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.3,
   "end": 362.66,
   "text": "می‌گیرد روح را. عه، چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.66,
   "end": 364.94,
   "text": "و تقبض روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 364.94,
   "end": 367.0,
   "text": "روح را قبض می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 367.0,
   "end": 376.54,
   "text": "روح را به یک معنا می‌گیره در پنجه خودش \"وتسلط ملك الموت على اخراج نفسي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.54,
   "end": 381.02,
   "text": "و اینجا ملك الموت هم قابض الأرواح مسلط می‌شه بر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 381.02,
   "end": 385.8,
   "text": "اخراج نفس. حضرت زهرا داره عرض می‌فرماید به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.8,
   "end": 388.0,
   "text": "اخراج نفسي. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.0,
   "end": 392.06,
   "text": "در خصوص نفس توفی و خروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 392.06,
   "end": 395.1,
   "text": "استفاده شده. در خصوص روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.1,
   "end": 398.68,
   "text": "قبض و ردت، ارجاع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 398.68,
   "end": 400.84,
   "text": "گرفتن. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 400.84,
   "end": 408.08,
   "text": "پیداست که روح دست نمی‌خوره مستقیماً هر بلایی سرش آوردی همون رد می‌شه می‌ره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 408.08,
   "end": 410.44,
   "text": "قبض می‌شه، تمام می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.44,
   "end": 413.38,
   "text": "دیگه هر کاری باهاش کردی همین جا کردی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.38,
   "end": 415.7,
   "text": "لذا \"الدنيا مزرعة الآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 415.7,
   "end": 419.8,
   "text": "البته ما تکامل برزخی داریم اما اون تکامل برزخی بر بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.8,
   "end": 423.08,
   "text": "دنیا اتفاق می‌افته. در دنیا چه کردی همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 423.08,
   "end": 429.42,
   "text": "و بارها عرض کردیم در برزخ اون صور و اشکالی که ما می‌بینیم مثل این‌که در خواب صور و اشکالی که می‌بینیم همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 429.42,
   "end": 432.56,
   "text": "اون خمیرمایه و ملاتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 432.56,
   "end": 437.58,
   "text": "اون ملکات نفسه، ملکاتی که تو ملکه پی-- عادت، عادات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.58,
   "end": 441.1,
   "text": "عادت به چی کردیم؟ اونا صور و اشکال برزخی می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 441.1,
   "end": 444.48,
   "text": "حالا تکلیف نفس چی می‌شه؟ اینجا می‌گه خروج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.48,
   "end": 447.58,
   "text": "توفی. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 447.58,
   "end": 451.32,
   "text": "یعنی این‌که نمیگه از بین می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.32,
   "end": 454.3,
   "text": "نفس از بین نمی‌ره، خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.3,
   "end": 458.44,
   "text": "ببینید حضرت زهرا عرض می‌کنه به خدا که على اخراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.44,
   "end": 461.42,
   "text": "نفسي. نفس خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.42,
   "end": 464.12,
   "text": "خارج می‌شه پیداست که وارد هم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 464.12,
   "end": 467.08,
   "text": "وقتی خارج شد از اینجا به یه جای دیگه وارد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.08,
   "end": 469.98,
   "text": "به کجا وارد می‌شه؟ از اینجا خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 469.98,
   "end": 472.72,
   "text": "چرا؟ چون دیگه این روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 472.72,
   "end": 475.36,
   "text": "تعلق به این بدن، به این جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 475.36,
   "end": 478.32,
   "text": "خاکی نداره. لذا این خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 478.32,
   "end": 480.18,
   "text": "فاسد می‌شه که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 480.18,
   "end": 484.96,
   "text": "جسد این بدن دنیایی فاسد می‌شه برمی‌گرده چرخه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 484.96,
   "end": 487.82,
   "text": "اما آیا اون‌ور ما بدن داریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 487.82,
   "end": 490.16,
   "text": "اون‌ور فقط روحیم؟ نخیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 490.16,
   "end": 492.38,
   "text": "اون‌ورم بدن داریم. اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 492.38,
   "end": 495.4,
   "text": "همین الان هم بدن برزخی ما موجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 495.4,
   "end": 497.62,
   "text": "گوش، اهلش می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 497.62,
   "end": 501.72,
   "text": "همراه شماست. توجه نفس شما به اون به حداقل رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 501.72,
   "end": 504.3,
   "text": "به این بدن دنیایی داره متوجه می‌شه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 504.3,
   "end": 506.32,
   "text": "لذا این رو به کار انداختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 506.32,
   "end": 511.44,
   "text": "وقت خواب توجه نفس Nataga از این بدن کم می‌شه به اون بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 511.44,
   "end": 514.04,
   "text": "همراهته. اون لذا تو خواب با اون بدن میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 514.04,
   "end": 517.94,
   "text": "ما بدن برزخی داریم، بدن اخروی داریم، بدن قیامتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 517.94,
   "end": 522.84,
   "text": "الی ما شاء الله بدن داریم. در طول همه این بدن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 522.84,
   "end": 525.9,
   "text": "اگر روح ما بدن دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 525.9,
   "end": 535.9,
   "text": "و قرار است روح برزخی ما، قیامتی ما، اخروی ما، اون بدن رو هم تدبیر کند و مدیریت کند پس لاجرم نفس هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 535.9,
   "end": 538.58,
   "text": "دارد چون محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 538.58,
   "end": 541.4,
   "text": "یا اون برزخ بین روح و بدن می‌شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 541.4,
   "end": 544.38,
   "text": "نفس. یعنی از طریق نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 544.38,
   "end": 547.68,
   "text": "روح بدن رو مدیریت می‌کنه عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 547.68,
   "end": 552.96,
   "text": "حالا با مهر بازی می‌کنی نمی‌دونم این حرفا به دردت نمی‌خوره بازی می‌کنی نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 552.96,
   "end": 556.24,
   "text": "این حرفا حرف‌های امام صادده. بالاخره هم قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 556.24,
   "end": 558.26,
   "text": "معذرت می‌خوام یقمون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 558.26,
   "end": 560.42,
   "text": "انشاالله شما رو دیرتر ما رو زودتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 560.42,
   "end": 567.28,
   "text": "ولی قراره یقمون کنن. امروز محضر برادر شهیدان طوقانی بودیم تشرف 中 心 مرکز برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 567.28,
   "end": 569.02,
   "text": "درد و دل می‌کردن از شهیدشون می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 569.02,
   "end": 574.66,
   "text": "گفتم سلام ما رو به شهیداتون دو تا برادر شهیدش برسونید و خواهش کنین ما رو تنها حاجتمون برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 574.66,
   "end": 576.96,
   "text": "گفت چی؟ گفتم دوست داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 576.96,
   "end": 580.24,
   "text": "دوست داریم اداشو که داریم درمیاریم. دوست داریم با لیاقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 580.24,
   "end": 582.52,
   "text": "با شهادت ملحق بشیم به شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 582.52,
   "end": 584.54,
   "text": "بعد یه جمله خیلی جالبی عجی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 584.54,
   "end": 591.04,
   "text": "خیلی پرمعنا ایشون گفت و رفت که مثلا علما و بزرگان با-- بالا منبر ما می‌گن این حرفا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 591.04,
   "end": 594.38,
   "text": "یه حرف حکیمانه فرمود این اوضاع داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 594.38,
   "end": 601.98,
   "text": "قصه‌های امروز جامعه کف خیابون داره ثابت می‌کنه که شهادت دور از دسترس نیست به شرط این‌که پای ولایت بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 601.98,
   "end": 604.02,
   "text": "خیلی جمله شیرینی گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 604.02,
   "end": 607.8,
   "text": "حالا ما می‌گم از این جهت می‌گم زودتر ما دیرتر شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 607.8,
   "end": 613.28,
   "text": "یه مقدار خود، خودپسندیم، خودخواهیم، تکخوری که بده اما هستیم چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 613.28,
   "end": 619.02,
   "text": "دوست داریم زودتر بریم. و این حرفا رو بالاخره اونجا می‌چشیم که دیگه دیر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 619.02,
   "end": 623.46,
   "text": "نفس هست. بعد تعلق این بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 623.46,
   "end": 625.6,
   "text": "روح تعلقش از این بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 625.6,
   "end": 628.77,
   "text": "کنده می‌شه لذا این بدن فاسد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 628.77,
   "end": 633.04,
   "text": "حالا اون روح ارواحی که قبلا عرض کردم خیلی بزرگ می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 633.04,
   "end": 638.06,
   "text": "یه تعلقکی، یه چیزکی بین اون روح و این بدن انقدررر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 638.06,
   "end": 640.9,
   "text": "بزرگ شده این بدن مونده هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 640.9,
   "end": 643.76,
   "text": "لذا این بدن هم سالم نگه می‌دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 643.76,
   "end": 647.8,
   "text": "توجه کردی اون تعلقش دیگه خیلی خیلی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 647.8,
   "end": 649.52,
   "text": "دیر از بین می‌ره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 649.52,
   "end": 657.44,
   "text": "جلسات پیش عرض کردیم حداقل حداکثرش دیگه در انتهای هر دوره از رد و فسد این تعلق هم برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 657.44,
   "end": 660.98,
   "text": "در هر حال اینو حواسمون باشه. بعد این نفس خارج می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 660.98,
   "end": 663.74,
   "text": "خارج می‌شه دیگه حضرت زهرا داره می‌فرمایه دیگه شوخی که نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 663.74,
   "end": 667.14,
   "text": "من بچه طلبه که نمیگم. می‌فرماید که و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 667.14,
   "end": 669.18,
   "text": "ااا على اخراج نفسي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 669.18,
   "end": 672.08,
   "text": "نفس خارج می‌شه می‌ره چی کار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 672.08,
   "end": 675.14,
   "text": "برزخ بین چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 675.14,
   "end": 680.58,
   "text": "اون روح ما که تموم شد کارش و رفت با بدن برزخیمون بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 680.58,
   "end": 684.76,
   "text": "که اون شکل بدن برزخی رو الان داریم می‌سازیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 684.76,
   "end": 691.88,
   "text": "بازم دارم عرض می‌کنم از کتاب انسان در عرف عرفان هزارم بار اینا رو ما بگیم کمه حضرت استاد علامه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 691.88,
   "end": 696.5,
   "text": "ما شکل بدن برزخیمون رو با اعمالمون داریم می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 696.5,
   "end": 698.36,
   "text": "داریم میش-- شکل بهش می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 698.36,
   "end": 702.42,
   "text": "مجسمه سازی هست اینطوری. نفسمون رو اونور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 702.42,
   "end": 707.3,
   "text": "اون جانمون رو با اعتقادات و معارف‌مون داریم می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 707.3,
   "end": 710.28,
   "text": "خیلی حساسه این دوره از زندگی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 710.28,
   "end": 712.26,
   "text": "چه شکلی داره خود خودتو می‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 712.26,
   "end": 715.54,
   "text": "خودتم خودتو می‌سازی. با اهدی ما دعوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 715.54,
   "end": 718.7,
   "text": "نداریم. خودت سرتو می‌ندازی پایین میری سمت بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 718.7,
   "end": 722.32,
   "text": "خودتم سرتو می‌ندازی پایین میری سمت خدایی نکرده جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 722.32,
   "end": 724.8,
   "text": "\"اقرأ كتابك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 724.8,
   "end": 728.2,
   "text": "کتاب خودتو خودت بخوان. \"کفى بنفسك اليوم عليك حسيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 728.2,
   "end": 731.3,
   "text": "خودت کفایت می‌کنی. اصلا ملائکه نیاز نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 731.3,
   "end": 734.8,
   "text": "به یک معنا حالا بعدا می‌گیم ملائکه که همون قوای وجودی خودتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 734.8,
   "end": 737.18,
   "text": "این چشمت ملکه، گوشت مل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 737.18,
   "end": 738.86,
   "text": "اون قوای سامعه، باصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 738.86,
   "end": 740.96,
   "text": "اینا ملائکه وجودیتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 740.96,
   "end": 742.8,
   "text": "اونا که بابا نوعشه‌های تو هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 742.8,
   "end": 744.86,
   "text": "خودت هرچی هست خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 744.86,
   "end": 749.5,
   "text": "انشاالله عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 749.5,
   "end": 755.78,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}