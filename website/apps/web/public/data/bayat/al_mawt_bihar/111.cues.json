 "chapters": [
  {
   "index": 0,
   "title": "## تلاش انبیا و کشتی نوح",
   "start": 0.56,
   "end": 21.68
  },
  {
   "index": 1,
   "title": "## سفینهٔ الحسین أسرع و أوسع",
   "start": 21.68,
   "end": 288.96
  },
  {
   "index": 2,
   "title": "## ابراهیم در لب مرگ و رضای حسین در گودی",
   "start": 288.96,
   "end": 454.28
  },
  {
   "index": 3,
   "title": "## یا غیاث المستغیثین؛ فریاد برای امّت",
   "start": 454.28,
   "end": 897.88
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 6.48,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.48,
   "end": 12.02,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.02,
   "end": 14.58,
   "text": "در روایت هشتم باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.58,
   "end": 18.82,
   "text": "چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 23.6,
   "text": "به اینجا رسیدیم که بالاخره هر چقدر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.6,
   "end": 26.82,
   "text": "اولیاء الهی دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.82,
   "end": 30.96,
   "text": "ارتباط با خلق و به یک معنا کثرات رو دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.96,
   "end": 33.6,
   "text": "کثرت خلائق رو باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.6,
   "end": 38.56,
   "text": "اگرچه مأمورند به امر الهی اما هرچه باشد باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.56,
   "end": 42.68,
   "text": "کثرت است و توجه به کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.68,
   "end": 47.44,
   "text": "، از اون وحدت و شدت وحدت بخواهی نخواهی انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.44,
   "end": 51.9,
   "text": "دور می‌کنه و لذا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.9,
   "end": 54.28,
   "text": "توجه تام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.28,
   "end": 58.9,
   "text": "اگرچه اولیاء الله معصومین علیهم الصلاة والسلام دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.9,
   "end": 67.38,
   "text": "اما ظاهراً یک وجهش به قول بزرگان مثل امیر جواد آقا می‌مونه بعد از مت-- موت که حالا توجهشون از کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.38,
   "end": 70.7,
   "text": "یعنی جمله بدن خودشون برداشته بشه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.7,
   "end": 73.92,
   "text": "اتم می‌شه. یعنی هرچه به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.92,
   "end": 76.92,
   "text": "وحدت بری، به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.92,
   "end": 81.58,
   "text": "توحید بری، به سمت احدیت حضرت حق حرکت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.58,
   "end": 85.58,
   "text": "و إنا إلیه راجعون این رجعت باید انسان رو قوی‌تر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.58,
   "end": 88.24,
   "text": "اصلاً اینکه سر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.24,
   "end": 92.18,
   "text": "توجه داشته باشید یه سؤال رو داریم الان تو دل بحث جواب میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.18,
   "end": 96.96,
   "text": "چگونه است که می‌گن انسان وقتی از دنیا میره دستش بازتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.96,
   "end": 102.78,
   "text": "به نظر شما علتش چیه؟ چرا انسان از دنیا میره دستش تازه باز می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.78,
   "end": 105.1,
   "text": "مثلاً مرحوم آقای بهائ‌الدینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.1,
   "end": 110.7,
   "text": "بنده در قم که بودم چند وقت پیش از شاگرد ایشون شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.7,
   "end": 116.2,
   "text": "که از ایشون به نقل از خود آقای بهائ‌الدینی فرمودند که اواخر عمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.2,
   "end": 120.32,
   "text": "حضرات آقای بهائ‌الدینی به من فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.32,
   "end": 127.68,
   "text": "، به اون کسانی که میان مشکلاتشون رو الان به من می‌گن که من در نشئه حیات و طبیعت هستم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.68,
   "end": 133.04,
   "text": "اه می‌خوام کاری براشون بکنم و دست و بال‌م بسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.04,
   "end": 137.3,
   "text": "تو اینجا. بهشون بگید که من که از دنیا رفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.3,
   "end": 140.62,
   "text": "از دنیا که رفتم بیان سر قبرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.62,
   "end": 145.6,
   "text": "اونجا دست من تازه باز می‌شه و براشون اونجا تلاش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.6,
   "end": 148.68,
   "text": "این یادتون باشه سر مزار آقای بهائ‌الدینی برید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.68,
   "end": 152.26,
   "text": "اونجا براشون تلاش می‌کنم و حاجاتشون رو از خدا طلب می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.26,
   "end": 155.38,
   "text": "این یعنی چی به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.38,
   "end": 157.6,
   "text": "علتش چیه؟ حرکت به سمت وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.6,
   "end": 164.06,
   "text": "یعنی برداشته شدن توجه از کثرات و این خلائق و این نشئه ضیغی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.06,
   "end": 165.94,
   "text": "ضیغ س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.94,
   "end": 168.52,
   "text": "نشئه طبیعت، ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.52,
   "end": 171.22,
   "text": "همه چی به سمت خرابی میره این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.22,
   "end": 177.1,
   "text": "ولی اونور نه، اونجا دیگه مجرده باز می‌شه دست، اصلاً اینجا ظله، اینجا سایه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.1,
   "end": 184.6,
   "text": "اون یه حقیقتی‌ست که حالا فاصله‌ی بین نشئه طبیعت تا برزخ هم فرمودند مثل یک ریگی‌ست در کف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.6,
   "end": 187.54,
   "text": "بیابون بی‌انتها. این فاصله‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.54,
   "end": 190.4,
   "text": "چقدر دنیا کوچیکه ما انقدر بهش دل بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.4,
   "end": 194.54,
   "text": "دو مرتبه برزخ به قیامت همچین حالتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.54,
   "end": 196.18,
   "text": "اونم مثل یه ریگ در بیابان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.18,
   "end": 199.72,
   "text": "همین‌طوری مراتب فوق مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.72,
   "end": 204.32,
   "text": "، به این شکله که هرچی که انسان به اون سمت حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.32,
   "end": 209.44,
   "text": "هرچه غرق در وحدت بشه و توحید می‌تونه غریق‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.44,
   "end": 212.3,
   "text": "اونایی که دارن غرق می‌شن رو بیشتر نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.3,
   "end": 217.42,
   "text": "من دلم می‌سوزه گاهی اوقات که در تاریخ می‌بینم انبیا چقدر تلاش کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.42,
   "end": 219.68,
   "text": "پوستشون کنده شد، بیچاره شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.68,
   "end": 225.48,
   "text": "طفلیات چقدر عده قلیل و کمی رو تونستن این‌ها نجات-- مثلا حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.48,
   "end": 231.3,
   "text": "دیگه شیخ الانبیا که تا چهار هزار سال هم بر ایشون در بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.3,
   "end": 233.46,
   "text": "کتب اومده بر عمر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.46,
   "end": 238.86,
   "text": "خیلیه‌ها که نهصد و پنجاه سال قرآن فقط نبوتش رو تصریح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.86,
   "end": 242.54,
   "text": "چند نفر رو به نظر شما تونسته هدایت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.54,
   "end": 246.54,
   "text": "حضرت نوح با این همه عمر شیخ الانبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.54,
   "end": 250.52,
   "text": "چند نفر رو تونسته بکشونه و اصلاً سوار کشتی هدایت کنه و؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.52,
   "end": 257.82,
   "text": "هشتاد نفر، هشتاد نفر دیگه نه و بیشتر از هشتاد نفر ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.82,
   "end": 262.56,
   "text": "حالا شما اینو بیایید قیاس، حالا ما که اهل-- نبایدم قیاس کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.56,
   "end": 266.08,
   "text": "قیاس نمی‌خوایم بکنیم. اما می‌خوایم بگیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.08,
   "end": 270.74,
   "text": "ولایت حضرت نوح هم تحت ولایت اباعبدالله تعریف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.74,
   "end": 273.24,
   "text": "ببینید حضرت حسین ابن علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.24,
   "end": 277.3,
   "text": "چگونه غرق در کثر-- وحدت شده، چگونه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.3,
   "end": 282.78,
   "text": "کثرت بود اما توجهش به وحدت چگونه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.78,
   "end": 288.96,
   "text": "که هنوز که ایشون در-- ظاهراً از دنیا رفته، بدن عنصری‌ش از دنیا خارج شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.96,
   "end": 292.2,
   "text": "در کامل الزيارات ابن قولویه روایت داریم از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.2,
   "end": 298.34,
   "text": "صادق صلوات الله علیه کسی پرسید الان ما میریم کربلا بدن حسین ابن علی اونجا هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.34,
   "end": 301.12,
   "text": "اون بعد حضرت فرمود سؤال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.12,
   "end": 308.74,
   "text": "، سنگینی کردی. چگونه است که بدن حسین ابن علی اونجا بخواد بماند در حالی که این زمین گنجایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.74,
   "end": 311.98,
   "text": "ظرفیت گرفتن یه همچین گوهر و جوهری رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 311.98,
   "end": 314.24,
   "text": "بعد از سه روز بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.24,
   "end": 317.82,
   "text": "به بالا رفته. بدن اون‌ها هم بدن خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.82,
   "end": 321.98,
   "text": "از نوره یکپارچه. خب ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.98,
   "end": 324.82,
   "text": "این آقا چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.82,
   "end": 328.52,
   "text": "چگونه است که با اینکه بدن عنصری‌ش از این بد-- از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.52,
   "end": 335.1,
   "text": "نشئه طبیعت رفته، ظاهراً دیگه الان فقط امام عصره که با بدن عنصری‌ش رو این زمین مثل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.1,
   "end": 339.06,
   "text": "زندگی می‌کنه. اما هنوز که هنوزه داره دستگیری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.06,
   "end": 341.8,
   "text": "شما ببینید چن-چند میلیارد بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.8,
   "end": 347.84,
   "text": "بعد از شهادت آقا تا حالا چند میلیارد نفر آقا حسین ابن علی واسطه‌ی هدایت‌شون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.84,
   "end": 351.52,
   "text": "هرکی داره به سمت خدا میره به وساطت این آقا داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.52,
   "end": 356.36,
   "text": "کشتی نجات. خیلی و لکن سفینه الحسینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 356.36,
   "end": 359.78,
   "text": "أسرع و أوسع سریع‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.78,
   "end": 364.54,
   "text": "وسیع‌تر. ببین غرق در وحدت شده چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.54,
   "end": 367.7,
   "text": "که قدرت وحدت رو دست گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.7,
   "end": 372.24,
   "text": "انگار که شده باشه مثلاً چه عرض کنیم جانشین که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.24,
   "end": 375.08,
   "text": "هست دیگه ولی جانشین اتمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.08,
   "end": 380.46,
   "text": "انگار، انگار چیه؟ جا پای خاتم الانبیا گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.46,
   "end": 383.58,
   "text": "چه کرده حالا شما ببینید حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.58,
   "end": 385.88,
   "text": "بحث کجا بود تو روایت هشتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.88,
   "end": 390.48,
   "text": "حضرت ابراهیم علیه و علی نبیین و آله السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.48,
   "end": 394.72,
   "text": "لب موت‌شون سؤال کردن که چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.72,
   "end": 399.02,
   "text": "دوستی مرگ دوستش رو می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.02,
   "end": 404.9,
   "text": "بعد خدا فرمود چگونه دوستی اکراه داره از لی، از ملاقات دوستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.9,
   "end": 412.92,
   "text": "این سؤال رو شما ببینید مناجات ابا عبدالله رو در گودی قتلگاه لحظه‌ای که می‌خواد تشریف بر از دنیا ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 412.92,
   "end": 417.44,
   "text": "این لحظه‌ی تشریف بردن حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.44,
   "end": 420.96,
   "text": "اون لحظه‌ی تشریف بردن امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.96,
   "end": 424.06,
   "text": "که وقتی که سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.06,
   "end": 429.64,
   "text": "سر مبارک چه بخواد چه نخواد در حالت سجده افتاده در گودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.64,
   "end": 435.06,
   "text": "حضرت فرمودن الهی رضا، رضان به رضائک هم تازه نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.06,
   "end": 437.68,
   "text": "رضان به قوائک قضا حکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.68,
   "end": 442.7,
   "text": "من راضیم به هرچی تو حکم کنی و تسلیم الأمرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.7,
   "end": 445.42,
   "text": "من تسلیم مطلق امر تو هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.42,
   "end": 450.44,
   "text": "اصلاً چون و چرا نداره حسین ابن علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.44,
   "end": 454.28,
   "text": "و لا معبود سواک اصلاً معبودی جز تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.28,
   "end": 456.42,
   "text": "یا غیاث المستغيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.42,
   "end": 458.58,
   "text": "ببینید فریاد رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.58,
   "end": 466.56,
   "text": "بعضی از بزرگان یه روزی محضر یکی از بزرگان بودم حضورا از خود ایشون شنیدم اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.56,
   "end": 469.34,
   "text": "که فرمودن نظر ما این است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 469.34,
   "end": 473.22,
   "text": "که آقا ابا عبدالله این یا غیاث المستغيثين رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.22,
   "end": 476.88,
   "text": "برای خودش نگفته برای امت گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 476.88,
   "end": 480.5,
   "text": "چون خواست دستگیر امت باشه به جهت اینکه هفت بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.5,
   "end": 483.12,
   "text": "آخرین بارش در گودی قتلگاه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.12,
   "end": 486.18,
   "text": "پیک حق تشریف آوردن محضر ارباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 486.18,
   "end": 488.7,
   "text": "گفتن حسین جان می‌خوای از طرف خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.7,
   "end": 490.94,
   "text": "می‌خواید ورق برگرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.94,
   "end": 494.82,
   "text": "شما شهید نشی اهل بیتت اسیر نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.82,
   "end": 501.04,
   "text": "اما من خدا هرچه وعده به مقامات و مراتب داشتم به تو همه رو بهت میدم نه که ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.04,
   "end": 504.9,
   "text": "رتبه تو سر جاش اما شهید نشی اهل بیتت اسیر نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.9,
   "end": 509.84,
   "text": "ابا عبدالله تو گودی قتلگاه یا غیاث المستغيثين می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.84,
   "end": 515.06,
   "text": "و داشت جون می‌داد که خدا یعنی ورق برنگرده و من شهید نشما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.06,
   "end": 517.3,
   "text": "چرا؟ مگه مقامات رو به آقا نمی‌دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.3,
   "end": 520.02,
   "text": "دلواپس من و شما بوده آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.02,
   "end": 523.72,
   "text": "چون اگر حسین ابن علی شهید نمی‌شد همه‌ی ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.72,
   "end": 525.36,
   "text": "دیگه به راه باطل بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.36,
   "end": 531.04,
   "text": "همه‌ی ما به واسطه‌ی امام حسین به سمت حضرت حق در حرکت بودیم و هستیم و خواهیم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.04,
   "end": 534.68,
   "text": "کیه که ادعا کنه بدون حسین موحد شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.68,
   "end": 540.64,
   "text": "پس اونجا اون فریاد یا غیاث المستغيثين حضرت به خاطر من و شما و این ملت و این امته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 540.64,
   "end": 543.7,
   "text": "ما ملت امام حسینییم یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.7,
   "end": 549.26,
   "text": "حضرت شهید سلیمانی سر دادن این ندا رو چه ندای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 549.26,
   "end": 552.86,
   "text": "زیبا و پرمعنایی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.86,
   "end": 556.54,
   "text": "یا اون دعا رو شما ببینید لحظات آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 556.54,
   "end": 559.64,
   "text": "حالا به هر حال اشک‌هاتونم جاریه خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.64,
   "end": 561.88,
   "text": "الحمدلله به هر حال ایامیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.88,
   "end": 566.1,
   "text": "اگر غیر از این باشه باید تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 566.1,
   "end": 569.5,
   "text": "قبل از اینکه این دعا رو تقدیم کنم خیلی دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 569.5,
   "end": 574.38,
   "text": "شریفی‌ست و شما ببینید اون لحظات آخر آقا چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.38,
   "end": 577.34,
   "text": "واقعاً چه کرده؟ نه زبان قاصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.34,
   "end": 580.22,
   "text": "از حضرت آیه الله محسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.22,
   "end": 589.9,
   "text": "یه فرمایشی رو دیدیم که ایشون فرمودن ابن عربی من از در آثار ابن عربی ندیدم این فرمایش رو ولی حضرت استاد فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 589.9,
   "end": 593.08,
   "text": "ابن عربی این رو فرموده که اگر مثل قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.08,
   "end": 596.08,
   "text": "کتابی در شهادت نازل شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.08,
   "end": 605.74,
   "text": "مثل قرآن کتابی در موضوع شهادت نازل شود یعنی بشود کتاب‌القرآن بشود کتاب شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.74,
   "end": 609.7,
   "text": "فرمودن فاتحة الكتاب یعنی سوره‌ی حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 609.7,
   "end": 615.76,
   "text": "که همه‌ی قرآن توش جمعه. فاتحه‌ی اون کتاب شهادت حسین ابن علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 615.76,
   "end": 620.0,
   "text": "یعنی تمامه دیگه تمام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 620.0,
   "end": 623.22,
   "text": "حالا این آقا اومده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.22,
   "end": 625.58,
   "text": "لحظاتی که میخواد بره وداع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 625.58,
   "end": 630.3,
   "text": "اومد در خیمه‌ی آقا امام سجاد صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.3,
   "end": 635.82,
   "text": "این رو می‌تونید در کتاب ادعوات صفحه پنجاه و چهار مرحوم قطب راوندی ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 635.82,
   "end": 640.18,
   "text": "تو صحن اصلی حرم حضرت معصومه سلام، صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 640.18,
   "end": 645.04,
   "text": "رو به ایوان طلا که وایسید دست چپتون یه مقدار اونورتر از حوض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.04,
   "end": 647.48,
   "text": "یه سنگ بلنده تقریباً شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.48,
   "end": 650.38,
   "text": "نیم متر بیشتر از نیم متر سنگ بلند و بزرگی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 650.38,
   "end": 652.74,
   "text": "اون مرحوم قطب راوندیه. مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 652.74,
   "end": 656.3,
   "text": "سده‌ی شیا بله شش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 656.3,
   "end": 661.14,
   "text": "ششم بله. مال سده‌ی ششمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 661.14,
   "end": 668.68,
   "text": "و نزدیک غیبت امام عصر و این کتاب ادعوات، دعواتشو همه‌ی بزرگان تأیید کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 668.68,
   "end": 674.0,
   "text": "ایشون در اونجا نقل می‌کنه که امام حسین لحظات آخر از امام سجاد نقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 674.0,
   "end": 676.08,
   "text": "اومدن خیمه‌ی امام سجاد برای وداع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.08,
   "end": 680.9,
   "text": "امام سجاد صلوات الله علیه می‌فرمایند که دیدم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.9,
   "end": 686.46,
   "text": "تمام بدن پدرم حسین خون جاریه از رگ‌های بدن خون جاریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 686.46,
   "end": 692.08,
   "text": "و داره میره برای وداع. توی اون لحظه پدرم من رو بغل کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 692.08,
   "end": 695.56,
   "text": "و یه یادگاری به من داد. فرمود پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 695.56,
   "end": 697.9,
   "text": "این یادگاری رو قدر بدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.9,
   "end": 700.32,
   "text": "که از مادرم فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 700.32,
   "end": 703.2,
   "text": "یاد گرفتم و او از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 703.2,
   "end": 707.04,
   "text": "پیغمبر، پیغمبر از جبرائیل و از حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 707.04,
   "end": 712.76,
   "text": "این دعا رو امام حسین تو اون لحظه‌ای که خون از بدنش داره میره و داره میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 712.76,
   "end": 717.58,
   "text": "به سمت گودی به امام سجاد هدیه کرده برای من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 717.58,
   "end": 721.68,
   "text": "و فرمود برای حاجت و برای هم و غم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 721.68,
   "end": 725.76,
   "text": "و برای بلاهای سنگین روزگار مفیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 725.76,
   "end": 727.96,
   "text": "حالا این متن دعا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 727.96,
   "end": 730.3,
   "text": "شما ببینید لحظات آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 730.3,
   "end": 735.52,
   "text": "ابا عبدالله زبانش چگونه باز بوده به توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 735.52,
   "end": 739.32,
   "text": "فرمود به حق یاسین والقرآن الحکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 739.32,
   "end": 742.7,
   "text": "به به به. و به حق طه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 742.7,
   "end": 744.36,
   "text": "والقرآن العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 744.36,
   "end": 749.98,
   "text": "به به به. یا من يقدر علی حوائج السائلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 749.98,
   "end": 752.08,
   "text": "به فکر گداها و سائلینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 752.08,
   "end": 754.66,
   "text": "ای کسی که قادر هستی بر حوائج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 754.66,
   "end": 757.82,
   "text": "سؤال کننده‌ها. یا من يعلم ما فی الضمیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 757.82,
   "end": 761.38,
   "text": "ای کسی که باخبری از درون هرکسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 761.38,
   "end": 763.76,
   "text": "یا منفسا عن المکروبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 763.76,
   "end": 766.04,
   "text": "ای کسی که برطرف می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 766.04,
   "end": 768.3,
   "text": "پریشانی پریشان حال‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 768.3,
   "end": 770.4,
   "text": "یا مفرج عن المغمومین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 770.4,
   "end": 773.06,
   "text": "ای کسی که غم‌ها رو بر می‌داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.06,
   "end": 775.24,
   "text": "یا راحم الشيخ الكبير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 775.24,
   "end": 779.12,
   "text": "به فکر پیرها بوده. یا رازق الطفل الصغیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 779.12,
   "end": 783.9,
   "text": "به فکر شیرخواران و خردسالان و کوچک‌ها و کودک‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 783.9,
   "end": 786.54,
   "text": "یا من لايحتاج الی تفسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 786.54,
   "end": 789.86,
   "text": "ای کسی که اصلاً احتیاج به تفسیر نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.86,
   "end": 795.72,
   "text": "بر هر چیزی آگاهی. صل علی محمد و آل محمد و افعل بی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 795.72,
   "end": 797.62,
   "text": "با من این کار رو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 797.62,
   "end": 800.22,
   "text": "حالا کذا و کذا یعنی حاجتتو میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 800.22,
   "end": 802.1,
   "text": "اینو امام حسین فرموده و رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 802.1,
   "end": 805.0,
   "text": "ببین همش داره با حق مناجات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 805.0,
   "end": 808.18,
   "text": "این رو یاد میده به پسرش که به همه بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 808.18,
   "end": 811.9,
   "text": "و خودش هم که میره غرق در توحید و وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 811.9,
   "end": 814.12,
   "text": "یه همچین کسی می‌تونه چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 814.12,
   "end": 816.3,
   "text": "دست عالم رو بگیره و با خودش ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 816.3,
   "end": 819.9,
   "text": "لذا آقای قاضی فرمود تمام مراتب توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 819.9,
   "end": 823.04,
   "text": "با حسین بن علی طی می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 823.04,
   "end": 826.52,
   "text": "از صفر تا صدش. حالا باید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 826.52,
   "end": 830.26,
   "text": "حضرت ابراهیم جد بزرگوار ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 830.26,
   "end": 835.6,
   "text": "وقت موت‌شون سؤال‌شون از خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 835.6,
   "end": 839.58,
   "text": "که چگونه دوستی مرگ دوستش رو طلب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 839.58,
   "end": 844.7,
   "text": "البته وجوهش رو گفتیم چیز بدی نیست به نگاه خدای نکرده بد به این سؤال نگاه نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 844.7,
   "end": 847.12,
   "text": "اما وقتی امام حسین رو ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 847.12,
   "end": 851.62,
   "text": "نه خودش رو بلکه همه محبینش رو داره غرق در خدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 851.62,
   "end": 858.94,
   "text": "در یک دستش یک دست ما رو گرفته با اون دستش هم دست حضرت حق داره همه ما رو بالا می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 858.94,
   "end": 861.52,
   "text": "خدایا ما رو از اربابمون جدا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 861.52,
   "end": 864.08,
   "text": "خدایا ما رو با اربابمون محشور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 864.08,
   "end": 866.8,
   "text": "صحبت‌های امروز رو هدیه می‌کنم به امام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 866.8,
   "end": 870.14,
   "text": "شهدا و شهدای کربلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 870.14,
   "end": 873.74,
   "text": "اموات و رفتگان خودتون، مادر و برادر خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.74,
   "end": 881.56,
   "text": "آقای لطفی که اینجا خدمت می‌کرد از دنیا رفت و همچنین پدر آقای ناطقی که روز اول محرم دفن شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 881.56,
   "end": 884.94,
   "text": "روح همشون شاد باشه نثار همشون صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 884.94,
   "end": 889.6,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 889.6,
   "end": 897.88,
   "text": "محمد و آل محمد. اللهم اغفر له وارحمه وعافیه واغفر له وارحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}