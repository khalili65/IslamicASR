 "chapters": [
  {
   "index": 0,
   "title": "## زیرک‌ترین مؤمن؛ کثرت ذکر موت و آمادگی",
   "start": 1.02,
   "end": 59.96
  },
  {
   "index": 1,
   "title": "## حکایت شهری که گناه نمی‌کرد",
   "start": 59.96,
   "end": 219.06
  },
  {
   "index": 2,
   "title": "## فراموشی حساب؛ آیهٔ داود",
   "start": 219.06,
   "end": 381.62
  },
  {
   "index": 3,
   "title": "## بیست بار ذکر موت؛ هم‌رتبهٔ شهدا",
   "start": 381.62,
   "end": 403.78
  },
  {
   "index": 4,
   "title": "## محبت بی‌عمل و عمل بی‌محبت",
   "start": 403.78,
   "end": 694.08
  },
  {
   "index": 5,
   "title": "## دو بیم امام برای امت",
   "start": 694.08,
   "end": 715.28
  },
  {
   "index": 6,
   "title": "## آرزوی دراز؛ رژه در برابر چشم",
   "start": 715.28,
   "end": 922.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.02,
   "end": 13.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.38,
   "end": 19.58,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 19.58,
   "end": 24.92,
   "text": "در روایت ششم از باب چهارم کتاب الموت هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 24.92,
   "end": 31.22,
   "text": "که از پیغمبر پرسیدند کدام یکی از اهل ایمان زیرک‌تر و باریش‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 31.22,
   "end": 35.78,
   "text": "پیغمبر فرمودند که اكثرهم ذكر الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 35.78,
   "end": 38.4,
   "text": "اون کسی که بیشتر از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.4,
   "end": 44.26,
   "text": "بسیار یاد موت می‌کنه و البته و أشدّهم استعداداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.26,
   "end": 49.54,
   "text": "شدیدتر از همه آمادگی پیدا می‌کنه برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 49.54,
   "end": 55.78,
   "text": "خودش را آماده می‌کنه. چنین کسی زیرکه از نظر پیغمبر بلکه زیرک‌ترینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 55.78,
   "end": 62.68,
   "text": "که می‌طلبه انسان در حین اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 62.68,
   "end": 66.34,
   "text": "بسیار یاد موت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 66.34,
   "end": 68.44,
   "text": "آمادگی برای اون راه رو هم پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.44,
   "end": 74.4,
   "text": "البته همین خود نفس یاد کردن از موت آمادگی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 74.4,
   "end": 80.22,
   "text": "در یه حکایتی می‌دیدم که شخصی وارد یه شهری شد دید هیچکس گناه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.22,
   "end": 83.12,
   "text": "هرچی با مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 83.12,
   "end": 87.92,
   "text": "حش و نش پیدا کرد دید گناهی نیست تو این شهر عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.92,
   "end": 91.54,
   "text": "که سر کسیو کلاه نمی‌ذاره، فحش نمیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 91.54,
   "end": 93.94,
   "text": "دروغ نمیگه این‌ها کم‌فروشی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.94,
   "end": 100.82,
   "text": "متعجب شد. بعد از بازار این شهر وارد محل سکونتشون که شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 100.82,
   "end": 106.72,
   "text": "متوجه شد که هر کسی عزیزش که از دنیا میره جلوی در خونه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.72,
   "end": 109.04,
   "text": "عزیزش رو دفن می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.04,
   "end": 117.06,
   "text": "استثناً تو اون شهر. بودن قدیما شهرها، دیار، این دهکده‌ها، دهات‌ها اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 117.06,
   "end": 122.06,
   "text": "روستاها اصطلاحاً نظام خاص خودشونو داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.06,
   "end": 128.8,
   "text": "مثل الان نبوده که تو مجبور بشی میتت رو بسپاری به شهرداری و هرچی اون تصمیم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 128.8,
   "end": 135.74,
   "text": "نه. خودشون حتی بعضی تو حیاط خونه‌شون تو خود خونه‌شون دفن می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 135.74,
   "end": 141.8,
   "text": "بسیاری از امامزادگان اون جایی که دفنن محل زندگیشون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 141.8,
   "end": 144.68,
   "text": "مثل حضرت عبدالعظیم سیدالکریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 144.68,
   "end": 151.96,
   "text": "سلام الله عليه. این بزرگوار اونجایی که الان دفنن درسته همونجا زنده به گور شدن ایشون شهید شدن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 151.96,
   "end": 155.46,
   "text": "محل زندگیشون بود. همونجا آوار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 155.46,
   "end": 162.46,
   "text": "یعنی سقف رو خراب کردن رو سر این بزرگوار و اونجا زنده به گور شدن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 162.46,
   "end": 166.64,
   "text": "اما محل زندگیشون بود و اینچنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 166.64,
   "end": 171.92,
   "text": "یه نظام خاصی داشت. بعد اینا وقتی که از خونه می‌خواستن برن بیرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 171.92,
   "end": 178.1,
   "text": "عزیز خودشون که تا دیروز باهاش حش و نش داشتن، می‌گفتن، می‌خندیدن، باهاش می‌خوردن، می‌خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 178.1,
   "end": 180.1,
   "text": "اینا می‌دیدن جلوی چشمشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 180.1,
   "end": 185.34,
   "text": "از در اتاق که خونه که می‌اومدن بیرون می‌دیدن بغل خونه‌شون دفنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 185.34,
   "end": 189.04,
   "text": "خب می‌رفتن تو بازار و اینا دیگه جرات نمی‌کرد کسی گناه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 189.04,
   "end": 193.94,
   "text": "دو مرتبه برمی‌گشتن مواجه می‌شدن با قبر عزیزشون وارد خونه می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 193.94,
   "end": 196.88,
   "text": "دوباره تو خونه و خلوتشون هم جرات گناه نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 196.88,
   "end": 200.08,
   "text": "این واقعاً یه واقعیتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 200.08,
   "end": 205.12,
   "text": "اگر کسی زیاد یاد موت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 205.12,
   "end": 208.54,
   "text": "داشتم آیه بیست و شش سوره صاد رو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 208.54,
   "end": 211.56,
   "text": "چه شیرین که در این سوره هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 211.56,
   "end": 216.16,
   "text": "فراموشی روز حساب و قیامت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 216.16,
   "end": 226.32,
   "text": "در طول موت هست که حالا عرفا میگن که اتفاقاً همون لحظه‌ی موت قیامت کبری انسان قیامت می‌کنه-- قیام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 226.32,
   "end": 229.04,
   "text": "همون لحظه است. بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 229.04,
   "end": 233.74,
   "text": "برای عارف به الله همین جا، همین جا قیامت قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 233.74,
   "end": 237.08,
   "text": "يوم تبلس الوجوه همینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 237.08,
   "end": 240.84,
   "text": "چشمش که باز می‌شه همین جا چشمش با-باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 240.84,
   "end": 243.08,
   "text": "فبصرك يومئذ حديد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 243.08,
   "end": 245.38,
   "text": "چشمش همین جا تیزه عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.38,
   "end": 250.34,
   "text": "منتظر موتش نیست. دیدم اینجا اشاره به همین داره که شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 250.34,
   "end": 254.86,
   "text": "یا داوود خدا به پیغمبرش دقت بفرمایید حضرت داوود یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 254.86,
   "end": 259.08,
   "text": "پیامبران بسیار با عظمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 259.08,
   "end": 262.12,
   "text": "یا داوود انا جعلناک خليفة في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 262.12,
   "end": 265.96,
   "text": "ما تو رو خلیفه و جانشین قرار دادیم در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 265.96,
   "end": 270.86,
   "text": "فاحكم بين الناس بالحق به حق بین مردم حکم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 270.86,
   "end": 274.18,
   "text": "ولا تتبع الهوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 274.18,
   "end": 277.7,
   "text": "دقت بفرمایید انقدر خطر جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 277.7,
   "end": 282.44,
   "text": "ما معمولاً به اینجور فرامین که می‌رسیم فکر می‌کنیم خدا داره به ما میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 282.44,
   "end": 284.78,
   "text": "نه خیر، مستقیم داره به پیغمبرش میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.78,
   "end": 287.24,
   "text": "انقدر خطر جدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 287.24,
   "end": 291.78,
   "text": "که به پیغمبر عزیزی مثل حضرت داوود هم داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 291.78,
   "end": 297.46,
   "text": "خدا تذکر میده که ولا تتبع الهوى حواست باشه که هوای نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 297.46,
   "end": 300.66,
   "text": "تبعیت نکنی ها. بسیاری از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 300.66,
   "end": 305.34,
   "text": "چه بدانیم، چه ند-ندانیم، خواهش‌های دلمون رو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 305.34,
   "end": 309.08,
   "text": "پی می‌گیریم. دنبال سر خواهش‌های دلمونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 309.08,
   "end": 316.06,
   "text": "عزیز دلم. و ولا تتبع الهوى فيضلک عن سبيل الله که اگر تو تبعیت کنی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 316.06,
   "end": 318.94,
   "text": "هوای نفس گمراه میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 318.94,
   "end": 322.06,
   "text": "از کجا؟ سبيل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 322.06,
   "end": 324.56,
   "text": "سبيل هم چیزیست که منتهی به صراط می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 324.56,
   "end": 329.1,
   "text": "صراط مستقیم. و تو نمی‌رسی به صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 329.1,
   "end": 337.24,
   "text": "ان الذين يضلون عن سبيل الله کسی که گمراه شد از سبيل خدا لهم عذاب شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 337.24,
   "end": 341.48,
   "text": "براش یه عذاب شدیدی، خدا بگه عذاب شدیده خیلیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 341.48,
   "end": 344.26,
   "text": "ماحصل چیه؟ الان می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 344.26,
   "end": 346.18,
   "text": "به ما به خاطر اینکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 346.18,
   "end": 349.2,
   "text": "چی شد که اینا دچار عذاب شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 349.2,
   "end": 354.74,
   "text": "که نتیجه‌ش چی بود؟ گمراه شدن از راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 354.74,
   "end": 358.34,
   "text": "و ت-تبعیت هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.34,
   "end": 362.86,
   "text": "میگه به ما نسوا يوم الحساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 362.86,
   "end": 365.2,
   "text": "تو همین آیه بیست و شش تا سور صد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 365.2,
   "end": 368.58,
   "text": "آدم با دقت و تأمل این آیات رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 368.58,
   "end": 373.92,
   "text": "چون فراموش کردی اون لحظه رو گرفتار این چیزا شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.92,
   "end": 377.78,
   "text": "ماها واقعاً گرفتاری‌مون از همین فراموشیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 377.78,
   "end": 381.62,
   "text": "لذا ببین چند تا ما روایت و حدیث هی داریم تکرار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 381.62,
   "end": 386.38,
   "text": "eksar ذکر موت، eksar ذکر موت، eksar ذکر موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 386.38,
   "end": 390.24,
   "text": "یه سری درشه یا اینکه پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 390.24,
   "end": 393.5,
   "text": "ازش سؤال کردن خیلی عجیبه این فرمایش رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 393.5,
   "end": 397.2,
   "text": "شهید چه مقامی داره؟ به گردش نمی‌رسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 397.2,
   "end": 403.78,
   "text": "دیگران. اینو همه قبول داریم دیگه بالاترین مقامات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.78,
   "end": 407.58,
   "text": "می‌شه گفت یه پله پایین‌تر از مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 407.58,
   "end": 414.86,
   "text": "علمه که مداد العلماء افضل من دماء الشهدا چون عالم شهید پروره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 414.86,
   "end": 417.62,
   "text": "دیگه به گرد این دو تا کسی نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 417.62,
   "end": 421.84,
   "text": "از پیغمبر سؤال کردن آیا کسی اونجا محشور به شهدا می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 421.84,
   "end": 424.64,
   "text": "هم‌نشین با شه-- شهید نیست اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 424.64,
   "end": 429.14,
   "text": "می‌شه به اصل الحاق و مثلاً شفاعت هرچی که اسمشو بذاریم بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 429.14,
   "end": 431.64,
   "text": "هم‌درجه شهدا بشینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 431.64,
   "end": 434.9,
   "text": "پیغمبر فرمودن بله. خب کیه یا رسول الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.9,
   "end": 439.22,
   "text": "فرمودن کسی که روزی بیست بار، ده، بیست و ش-- بیست و چهار ساعت داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.22,
   "end": 441.32,
   "text": "شبانه روز بیست بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 441.32,
   "end": 444.72,
   "text": "یاد موت کنه. حالا چهار ساعتشو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 444.72,
   "end": 447.72,
   "text": "قدیم‌ها مثل الان نبود که بخوابن تا لنگ ظهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 447.72,
   "end": 451.78,
   "text": "چهار ساعت می‌خوابیدن. همه چی حساب داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 451.78,
   "end": 457.08,
   "text": "من یادمه دیگه پدربزرگ‌ها، مادربزرگ‌هام خدا رحمتشون کنه واقعاً کم می‌خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 457.08,
   "end": 461.16,
   "text": "چهار ساعتشو که می‌خوابیدی هیچی که اون عین موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.16,
   "end": 463.64,
   "text": "النوم اخو الموت برادر موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 463.64,
   "end": 465.94,
   "text": "اون که خودش موته، عین موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.94,
   "end": 468.76,
   "text": "منتها برت می‌گردونن که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.76,
   "end": 474.92,
   "text": "بیست ساعت داریم که بیداریم میگه بیست بار در شبانه روز یاد موت کنی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 474.92,
   "end": 478.44,
   "text": "شما بفرمایید. یعنی هر ساعت یاد موت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 478.44,
   "end": 480.56,
   "text": "ساعت، کدوم یکی از ما اینطوریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 480.56,
   "end": 483.44,
   "text": "ساعت به ساعت یاد موتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 483.44,
   "end": 488.92,
   "text": "اینکه قدیم‌ها تو حیاط خونه‌شون قبر می‌کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 488.92,
   "end": 493.44,
   "text": "نه فقط علماها. فعلاً دیر دور نیستیم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 493.44,
   "end": 496.38,
   "text": "تو همین اوایل انقلاب من شاهد بودم کسیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 496.38,
   "end": 500.12,
   "text": "تو-- کسانی که تو حیاط خونه‌شون قبر داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 500.12,
   "end": 503.36,
   "text": "تک و توک بود اما بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.36,
   "end": 507.6,
   "text": "سرش در اینه که حالا چنین کسی ببین چه مقامی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.6,
   "end": 514.0,
   "text": "eksar ذکر موت چگونه است که اگر کسی هر ساعت یادش باشه به مقام شهادت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 514.0,
   "end": 518.12,
   "text": "شاهد می‌شه بر عالم. اشهد ان لا اله الا الله راست می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 518.12,
   "end": 521.12,
   "text": "به شهود رسیده که لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 521.12,
   "end": 525.5,
   "text": "لغلغه زبانش نیست. لذا احکام الهی رو در زندگیش پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 525.5,
   "end": 529.0,
   "text": "هرچی پیغمبر بگه میگه چشم، کوه چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 529.0,
   "end": 531.36,
   "text": "یه فرمایش ترسناک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 531.36,
   "end": 537.14,
   "text": "خیلی خطرناک از امام، امام رؤوف، امام رؤوفه، امام رؤوفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.14,
   "end": 539.2,
   "text": "اما فرمایش خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.2,
   "end": 542.12,
   "text": "از ایشون به شما بگم به خودم حدیث نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 542.12,
   "end": 545.64,
   "text": "همیشه من اینو خودم بهش حواسم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 545.64,
   "end": 551.98,
   "text": "که امام رضا فرمود هیچ نفعی در محبت ما بدون عمل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 551.98,
   "end": 559.9,
   "text": "الله اکبر و هیچ نفعی در عمل بدون محبت ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 559.9,
   "end": 562.08,
   "text": "خیلی فرمایش عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 562.08,
   "end": 566.88,
   "text": "اینه که مثلا من ادعا می‌کنم بابا امام رضا رو داریم بسه، امام حسین رو داریم بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 566.88,
   "end": 571.34,
   "text": "میگه هیچ نفعی در محبت ما بدون عمل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 571.34,
   "end": 575.22,
   "text": "اصلاً عمل نباشه، یکیش همین یاد موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 575.22,
   "end": 578.18,
   "text": "می‌بره محبت رو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 578.18,
   "end": 583.74,
   "text": "رفته رفته می‌بینی اکراه پیدا می‌کنی از رفتن به جلسات اهل بیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.74,
   "end": 586.0,
   "text": "شنیدن استغفرالله نام اونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 586.0,
   "end": 588.92,
   "text": "دیدی بعضیا از اینجا زنگ خطره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 588.92,
   "end": 592.76,
   "text": "من و شما باید بترسیم. بعضیا بدشون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 592.76,
   "end": 596.96,
   "text": "و-و-وعظ و خطابه و منبر و اینا بشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 596.96,
   "end": 601.9,
   "text": "بدشون میاد. فرقی نمی‌کنه چه طرف کت شلواری باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 601.9,
   "end": 605.62,
   "text": "چه لباس پیغمبر تنش باشه. اصلاً بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 605.62,
   "end": 608.98,
   "text": "دوست نداره بشه. حوصله شنیدن حرف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 608.98,
   "end": 611.84,
   "text": "خیلی خطرناکه کسی که به این حالت افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 611.84,
   "end": 614.86,
   "text": "این قطعاً قلبش مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 614.86,
   "end": 619.12,
   "text": "افلا یتدبرون القرآن آیا تدبر در قرآن نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 619.12,
   "end": 623.76,
   "text": "من بگم به شما قرآن می‌فرماید سرش در چیه که تدبر نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.76,
   "end": 629.02,
   "text": "فرمود ام على قلوب اقفال قفل، قفل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 629.02,
   "end": 634.38,
   "text": "که قبلاً تو بحث قبل قلب مقفول با قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.38,
   "end": 636.64,
   "text": "یعنی قفل شده این بحث رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 636.64,
   "end": 638.96,
   "text": "قلبت قفل شده به روی حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 638.96,
   "end": 647.48,
   "text": "اصلاً پس می‌زنه اینا رو. یه فرمایش هم از امام رضا علیه السلام تسری به همین داره اینو هم عرض کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 647.48,
   "end": 654.16,
   "text": "مولا فرمود مهم‌ترین چیزی که من می‌ترسم الان مثلاً شما می‌خوای به بچه‌ت نصیحت کنی، رفیق، عزیزم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 654.16,
   "end": 656.02,
   "text": "خواهر، برادر، چی بهش میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.02,
   "end": 662.1,
   "text": "اصلاً میگی بدترین چیزی که پسرم، دخترم من نگران توام برای آینده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 662.1,
   "end": 666.58,
   "text": "چی بهش میگی؟ میگی جیبت خالی باشه، مستاجر باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 666.58,
   "end": 668.82,
   "text": "مثلاً ماشین نداشته باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 668.82,
   "end": 671.58,
   "text": "توی اداره‌ای استخدام نشده باشی، مغازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 671.58,
   "end": 675.16,
   "text": "غالباً اینطوریه. مغازه نداشته باشی، بیچاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.16,
   "end": 678.84,
   "text": "غالباً فرمول‌هایی که می‌چینیم بحث مالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 678.84,
   "end": 684.04,
   "text": "دغدغه اخروی خیلی قبول کنیم تو بحث تربیت‌مون خیلی کم گذاشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 684.04,
   "end": 686.88,
   "text": "اصلاً رهان بچه‌های ما از جهت تربیتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 686.88,
   "end": 693.32,
   "text": "جسارتا. می‌فرماید حالا ببین پای درس مولا بشینیم جمله آخر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 693.32,
   "end": 697.68,
   "text": "مه-- الان پدر امت داره من و شما که بچه‌ها هستیم نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 697.68,
   "end": 703.9,
   "text": "مهم‌ترین چیزی که من می‌ترسم دامن‌گیرتان شود بر شم-- و بر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 703.9,
   "end": 706.98,
   "text": "چیره گردد دو چیز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 706.98,
   "end": 711.12,
   "text": "آقا بابا داره به بچه‌هاش میگه من از دو چیز نگران حالشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 711.12,
   "end": 715.28,
   "text": "مهم‌ترین چیزا این دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 715.28,
   "end": 719.5,
   "text": "یک فرمود اما پیروی از هوای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 719.5,
   "end": 726.06,
   "text": "که مانع حق می‌شه. کسی خواهش دلشو دلم می‌خواد، دلم عشقشه این و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 726.06,
   "end": 733.06,
   "text": "اینا هوای نفس غالبا-- بسیاری از وقت دقت کنیم و ذره‌بین بذاریم بسیاری از کارهای ما از رو هوای نفسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 733.06,
   "end": 737.4,
   "text": "حتی شاید این منبری که الان من برداشتم اینجا میام با این همه ادعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 737.4,
   "end": 741.62,
   "text": "مثلاً فرمایش عرشی اهل بیت رو دارم برای شما میگم من رو هوای نفس باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 741.62,
   "end": 745.32,
   "text": "شهوت صحبت کرد اگه عمل نداشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 745.32,
   "end": 747.8,
   "text": "خدا شاهده یه فرمایشی من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 747.8,
   "end": 750.42,
   "text": "تنم می‌لرزید وقتی از طه المهسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 750.42,
   "end": 752.24,
   "text": "علیه الرحمن گفت دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 752.24,
   "end": 753.96,
   "text": "بدتر رعشه گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 753.96,
   "end": 756.86,
   "text": "خیلی حیا می‌کنم خدا شاهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 756.86,
   "end": 762.72,
   "text": "که خدا به پیغمبر اول العظمش حضرت عیسی فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 762.72,
   "end": 765.7,
   "text": "که عیسی مبادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 765.7,
   "end": 772.48,
   "text": "که آنچه که خودت اهل عمل به اون نیستی به دیگران سفارش کنی از من حیا کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 772.48,
   "end": 777.5,
   "text": "که این کارو بکنی. خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 777.5,
   "end": 779.16,
   "text": "خب یعنی واقعاً ترسناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 779.16,
   "end": 782.78,
   "text": "یه موضوع خیلی خیلی خیلی مهمی رو امشب می‌خواستم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 782.78,
   "end": 789.72,
   "text": "چون احساس کردم وجودم یه مقدار این دو سه روزه از اون حقیقت دور شده ترسیدم امروز بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 789.72,
   "end": 793.68,
   "text": "گذاشتمش برای روزهای بعد یه ذره تقرر پیدا کنیم به اون موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 793.68,
   "end": 799.7,
   "text": "واقعاً چوب می‌زنن این‌طوری نیست که طرف بالا منبر می‌گفت مرحوم مجلسی اینو از خودش دروغ می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 799.7,
   "end": 803.42,
   "text": "مرحوم سید بهائ‌الدین اینو می‌گفت فلان مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 803.42,
   "end": 805.2,
   "text": "مداح بود، سخنران بود هرچی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 805.2,
   "end": 808.82,
   "text": "بعد خواب پیغمبر رو دید. پیغمبر گفت این حدیثی که گفتی کدوم کتابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 808.82,
   "end": 811.34,
   "text": "گفت یه ذره فکر کرد گفت کتاب مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 811.34,
   "end": 815.32,
   "text": "پیغمبر فرمود بگید مرحوم مجلسی با کتابش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 815.32,
   "end": 817.58,
   "text": "آقای مجلسی کجای کتابت این روایته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 817.58,
   "end": 819.54,
   "text": "گفت من همچین چیزی ندارم. گفت نه، نه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 819.54,
   "end": 821.14,
   "text": "سید ابن طاووس تو فلان کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 821.14,
   "end": 823.3,
   "text": "فرمود سید ابن طاووس رو بگید بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 823.3,
   "end": 828.56,
   "text": "آقا این عالم، اون عالم دست و پا زد یه چیزی فراهم کنه دید همه رو حاضر که این یعنی قیامت کبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 828.56,
   "end": 830.98,
   "text": "تازه تو خوابشه، هنوز نمرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 830.98,
   "end": 836.48,
   "text": "پیغمبر یک سیلی جانانه زد تو صورت این سخنران و روضه خونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 836.48,
   "end": 840.88,
   "text": "ما فکر می‌کردیم که هرچی هرچی هرکی هرچی بگه ولش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 840.88,
   "end": 842.9,
   "text": "حرف‌ها چیه؟ حساب کتاب کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 842.9,
   "end": 846.24,
   "text": "یه برگ از درخت نمیفته غیر به اذن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 846.24,
   "end": 850.48,
   "text": "یک قطره بارون نمیاد به زمین بخوره مگر حساب کتاب روشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 850.48,
   "end": 852.98,
   "text": "اینجا رو نگاه نکن. ما از بالا نگاه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 852.98,
   "end": 857.62,
   "text": "همه چی رو حسابه. که بیدار شد تا مدت‌ها جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 857.62,
   "end": 860.2,
   "text": "سیلی پیغمبر رو صورتش بود این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 860.2,
   "end": 864.2,
   "text": "تو کتاب‌های قدیمی داستان‌های اینو نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 864.2,
   "end": 867.28,
   "text": "چی بگم من؟ حالا این یکیش هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 867.28,
   "end": 869.7,
   "text": "دومیش چیه؟ پدر امت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 869.7,
   "end": 872.88,
   "text": "دومیش فرمود آرزوی طولانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 872.88,
   "end": 876.76,
   "text": "که چی می‌شه نتیجه‌ش؟ آرزوهایی تو جلو چشمت رژه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 876.76,
   "end": 879.94,
   "text": "آخرت را به فراموشی می‌سپارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 879.94,
   "end": 882.1,
   "text": "امان از این آرزوهای طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 882.1,
   "end": 884.8,
   "text": "طرف میاد با ما میگه حاج آقا گرفتار شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 884.8,
   "end": 887.06,
   "text": "هرچی داشتیم دار و ندارمونو بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 887.06,
   "end": 891.46,
   "text": "چی شده مثلاً؟ صد تا سکه تو خونه گذاشته بودیم دزد زد برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 891.46,
   "end": 893.86,
   "text": "خب آخه صد تا سکه تو خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 893.86,
   "end": 896.14,
   "text": "من نمی‌دونم اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 896.14,
   "end": 898.86,
   "text": "فلسفه این صد تا سکه تو خونه چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 898.86,
   "end": 901.14,
   "text": "باید هم دزد اونو می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 901.14,
   "end": 903.72,
   "text": "اون اصلاً باید دزد می‌بردش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 903.72,
   "end": 909.32,
   "text": "برای چی تو خونه صد تا سکه اصلاً هیچ حساب کتابی نیست انگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 909.32,
   "end": 914.02,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 914.02,
   "end": 920.58,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 920.58,
   "end": 922.54,
   "text": "و آل محمد و عجل فرجهم. الله اکبر، الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}