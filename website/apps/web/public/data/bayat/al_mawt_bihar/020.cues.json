 },
 "chapters": [
  {
   "index": 0,
   "title": "## کثرت‌طلبی در برابر عمق عقلی",
   "start": 18.9,
   "end": 38.96
  },
  {
   "index": 1,
   "title": "## تجربهٔ جوان فنی و جرقهٔ عقل",
   "start": 38.96,
   "end": 134.44
  },
  {
   "index": 2,
   "title": "## خواب خواجه نصیر و رمز معرفت نفس",
   "start": 134.44,
   "end": 480.51
  },
  {
   "index": 3,
   "title": "## حدیث چهارم؛ رجوع کل به جوهر اول",
   "start": 480.51,
   "end": 531.89
  },
  {
   "index": 4,
   "title": "و حضرت ادامهٔ مبحث می‌فرماید:",
   "start": 531.89,
   "end": 795.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 4.2,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 9.76,
   "text": "بسم الله الرحمن الرحیم و بینا الصدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.76,
   "end": 13.32,
   "text": "السلام علیکم یا اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.32,
   "end": 18.9,
   "text": "و رحمت الله. سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.9,
   "end": 20.88,
   "text": "نکته‌ای پیش اومد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.88,
   "end": 24.46,
   "text": "حتی در نمازمون تاثیر گذاشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.46,
   "end": 27.36,
   "text": "این رو خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.36,
   "end": 31.04,
   "text": "من و من می‌کنم بگم یا نه فقط به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.04,
   "end": 35.16,
   "text": "اینکه انشاالله تاثیرگذار باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.16,
   "end": 38.96,
   "text": "و متوجه بعضی از حقایت بشیم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.96,
   "end": 41.98,
   "text": "و الا از این مسائل خب زیاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.98,
   "end": 48.74,
   "text": "به جهت اینکه بعضی از دوستان ما که ما هم خیلی ارادت داریم بهشون و دوسشون داریم از رو دلسوزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.74,
   "end": 53.42,
   "text": "گفتن آقا مثلا این مباحث قبلا یه مقدار سنگین بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.42,
   "end": 55.12,
   "text": "کمتر شرکت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.12,
   "end": 58.46,
   "text": "از وقتی بحث موت یه مقدار رقیق‌تر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.46,
   "end": 64.06,
   "text": "همه فهم‌تر شده مثلا بیشتر میان دوست-- بیشتر رغبت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.06,
   "end": 66.54,
   "text": "و حتی مثلا به کانال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.54,
   "end": 69.64,
   "text": "حدود دو هزار نفر مثلا اضافه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.64,
   "end": 74.94,
   "text": "وقتی م بحث کتاب الموت مرحوم مجلسی شروع شد اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.94,
   "end": 82.66,
   "text": "بله حرف درسته اما اجازه بفرمایید با ذکر یک مثال عرض کنم که اگر ما صرفا دنبال کثرت باشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.66,
   "end": 85.88,
   "text": "مطالب همه فهم و که همه با اون مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.88,
   "end": 88.78,
   "text": "حالت متعارف جامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.78,
   "end": 93.48,
   "text": "عامه فهم و اینا بخوان پیش برن یه نوع خیانت کردنه به نظرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.48,
   "end": 95.76,
   "text": "اولا اینجا رسانه‌ست باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.76,
   "end": 100.04,
   "text": "خیلی سطح رسانه حفظ باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.04,
   "end": 108.32,
   "text": "بعد جمع شما جمع خاصین از نظر من شاید شما قبول نکنین اما از نظر من جمع خاصیه اینجا هر جایی نیست اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.32,
   "end": 111.92,
   "text": "زبده‌ها، چکیده‌ها، گلچین‌ها، خلاصه‌ها اینجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.92,
   "end": 116.54,
   "text": "باید اینطوری باشه. قاعده اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.54,
   "end": 119.54,
   "text": "و اگر فکر می‌کنید نیست یه فکری به حال خودتون بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.54,
   "end": 123.04,
   "text": "ما قاعده رو بر این قرار دادیم که اینچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.04,
   "end": 125.78,
   "text": "ثالثا اینکه خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.78,
   "end": 133.38,
   "text": "بارها ما تاثیر مباحث عقلی رو گفتیم که هیچ چاره‌ای از اون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.38,
   "end": 136.8,
   "text": "اونچه که می‌خوام به عنوان یک تجربه عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.8,
   "end": 139.26,
   "text": "در کنار خود شما پیش اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.26,
   "end": 140.92,
   "text": "این مثال رو خوب گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.92,
   "end": 146.12,
   "text": "همین اخیرا یکی از بچه‌های فنی سازمان اومد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.12,
   "end": 149.42,
   "text": "چهره جدیدی بود. ندیده بودیمش خیلی نورانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.42,
   "end": 152.86,
   "text": "چهره جوون و خیلی با دقت گوش میداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.86,
   "end": 156.62,
   "text": "ما یه نکته‌ای رو پیرامون عقل عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.62,
   "end": 159.28,
   "text": "که ارتباط عقل با خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.28,
   "end": 162.42,
   "text": "ایشون شاخک‌هاش به قول ماها تیز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.42,
   "end": 165.04,
   "text": "خیلی براش جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.04,
   "end": 171.76,
   "text": "اومد ما رو ول نکرد. بعد از جلسه اومد یه فکر می‌کنم یک ساعتی نشستیم با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.76,
   "end": 174.74,
   "text": "صحبت کردیم و ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.74,
   "end": 179.46,
   "text": "جرقه خورد تو وجودش. حالا قصه‌ای بود من خیلی خلاصه بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.46,
   "end": 184.64,
   "text": "که گفت آقا من چند ساله توسل سنگینی به سیر و شهدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.64,
   "end": 190.14,
   "text": "هر روز زیارت جام-- زیارت عاشورا رو با صد سلام و lehنش می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.14,
   "end": 192.96,
   "text": "کدوم که ما هم چه عرضه‌ای داریم ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.96,
   "end": 199.64,
   "text": "حالا آقا چی می‌خوای شما؟ امام صادق وعده کرده هرکس این کارو بکنه قطعا حاجتشو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.64,
   "end": 204.62,
   "text": "شما چی می‌خوای؟ گفته بود که آقا من از شما هیچی نمی‌خوام جز علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.62,
   "end": 210.04,
   "text": "یه کلمه‌ای، یه جمله‌ای، یه بابی از علم و معرفت به روی ما باز کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.04,
   "end": 211.88,
   "text": "جواب ظاهرا نگرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.88,
   "end": 216.72,
   "text": "امسال که اربعین میره خیلی دیگه توسل سنگین و گریه و اینا که آقا چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.72,
   "end": 221.18,
   "text": "خبری نمیشه؟ یه دست نوشت می‌ندازه تو ضریح که حالا چون ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.18,
   "end": 226.2,
   "text": "امروز نیست استثناً، مخصاً امروز دارم میگم نگاه کردم جمعتون نیست ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.2,
   "end": 229.2,
   "text": "می‌ندازه، می‌ندازه تو ضریح که آقا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.2,
   "end": 235.6,
   "text": "ندی حاجتمو میرم به همه اعلام می‌کنم من هر روز صد سلام و لهن عاشورا اینا خوندم جواب نگرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.6,
   "end": 237.62,
   "text": "به همه میگم. بی ادبی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.62,
   "end": 243.5,
   "text": "ظرفیتو اعلام می‌کنم. میرن کاظمین با مادرشون چون می‌دونین خواجه نصیر طوسی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.5,
   "end": 248.84,
   "text": "محقق عظیم الشأن و برجسته جهان اسلام یه ریاضیدان عجیبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.84,
   "end": 252.42,
   "text": "قهار، یک عالم، یک فیلسوف و عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.42,
   "end": 256.64,
   "text": "متأله یعنی ااا فیلسوف و عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.64,
   "end": 260.22,
   "text": "دو تاشو با هم جمع کرده. یعنی هم علوم عقلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.22,
   "end": 264.16,
   "text": "شهودی و کشفی. محضر به مادرش میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.16,
   "end": 270.28,
   "text": "تو خانماست ایشون برو از حریف از طرف من به ایشون سلام برسون بگو که آقا سفارش ما رو به ارباب بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.28,
   "end": 273.44,
   "text": "ما نامه دادیم فلان. خلاصه تموم میشه میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.44,
   "end": 278.04,
   "text": "ایشون خواب می‌بینه اخیرا که بعدا میاد تو جلسه با ما صحبت ما رو می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.04,
   "end": 280.84,
   "text": "اینا همش با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.84,
   "end": 284.26,
   "text": "یعنی رزق از جایی دیگه. \"فسما رزق کن و ما توکل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.26,
   "end": 286.16,
   "text": "خلاصه اومد ما یک ساعت صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.16,
   "end": 289.4,
   "text": "ایشون تو خواب محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.4,
   "end": 293.0,
   "text": "اه یه آقاهه خیلی نورانی شکل و شمایلش هم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.0,
   "end": 295.58,
   "text": "حالا من شناختم ولی بهش نگفتم کی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.58,
   "end": 298.7,
   "text": "ما رو بردن پیش یه جوون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.7,
   "end": 305.42,
   "text": "تحریش چه-- میز طلبگی گذاشته خیلی نورانی و درس ریاضیات می‌گفت که اون خواجه نصیر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.42,
   "end": 308.18,
   "text": "رسیدیم محضر ایشون و ایشونم شروع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.18,
   "end": 310.78,
   "text": "خب بفرمایید شما مگه نمی‌خواستی بفهمی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.78,
   "end": 313.26,
   "text": "ما نشستیم و خلاصه با ما کار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.26,
   "end": 315.32,
   "text": "یه مقدار ریاضیات کار کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.32,
   "end": 321.18,
   "text": "عدد پی رو بهش گفته بود این شکلی به دست میاد و اشتباه می‌کنن میگن نهایت نداره انتها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.18,
   "end": 325.42,
   "text": "یه سری صحبت‌ها بعد یه عددی رو و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.42,
   "end": 330.08,
   "text": "کلمه انگلیسی رو به صورت کد و رمز به ایشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.08,
   "end": 333.38,
   "text": "ایشون دنبال اون می‌گشت. هاج و واج که این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.38,
   "end": 337.02,
   "text": "هرچی هم خیلی جالبه چقدر کتاب بخونه اینور بره تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.02,
   "end": 342.84,
   "text": "فرصت کوتاه با این با اون مشورت بگیره به نتیجه نرسیده بود تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.84,
   "end": 345.84,
   "text": "الحمد لله خدا لطف کرد گره اینجا باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.84,
   "end": 348.28,
   "text": "به چه صورت؟ وقتی اینو برای ما گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.28,
   "end": 350.92,
   "text": "ب-- حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.92,
   "end": 357.76,
   "text": "علم اجمالی، آگاهی اجمالی که به علم حروف و عدد و این‌ها داشتیم در حروف حالا علم جبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.76,
   "end": 361.16,
   "text": "که هیچ وقتم ازش استفاده نکردیم قابل توجه شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.16,
   "end": 366.53,
   "text": "ما به ایشون نشستیم قشنگ کارگاهی گفتیم این عدد این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.53,
   "end": 368.69,
   "text": "داره به شما معرفی میکنه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.69,
   "end": 371.81,
   "text": "حرف میزنه به این. همینطوری خلاصه از دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.81,
   "end": 373.81,
   "text": "با ارتباطات یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.81,
   "end": 377.49,
   "text": "جمله انگلیسی رو درآوردیم که اینها داره حکا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.49,
   "end": 379.23,
   "text": "محاکات از این جمله میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.23,
   "end": 383.01,
   "text": "حالا اینو میدونی یعنی چی؟ حالا معلوم بود که انگلیسیش خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.01,
   "end": 387.43,
   "text": "گفت نگاه کرد گفت این جمله انگلیسی یعنی شناخت خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.43,
   "end": 389.95,
   "text": "گفتم این یعنی معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.95,
   "end": 393.43,
   "text": "همه این زحمات رو کشیدی جوابش به تو اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.43,
   "end": 396.03,
   "text": "جوابش اینه که برو دنبال معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.03,
   "end": 399.97,
   "text": "اشکی چشای ایشون جمع شد خیلی به هم ریخت و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.97,
   "end": 402.47,
   "text": "گفتم دیگه دنبال نگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.47,
   "end": 405.29,
   "text": "برو بسم الله راه رو بهت نشون دادم حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.29,
   "end": 408.91,
   "text": "گفت آقا چیکار کنم؟ گفتم بسم الله این سه تا جلد کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.91,
   "end": 412.71,
   "text": "معرفت نفس حضرت علامه به مباحث عقلیه شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.71,
   "end": 414.85,
   "text": "شروع کن. نگو به به چه حرف قشنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.85,
   "end": 423.07,
   "text": "بسم الله بگو و اگر میخوای بالاخره یه مقدمه‌ای داشته باشی برای فهم این حقایق عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.07,
   "end": 428.09,
   "text": "که ورزش فکریه تا تو رو به اون استیاد حقایق از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.09,
   "end": 430.89,
   "text": "باطن و ملکوت برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.89,
   "end": 433.95,
   "text": "حالا آدرس کانال رو که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.95,
   "end": 438.25,
   "text": "چند سال پیش تاسیس شد چهار ساله شاید سه چهار ساله راه افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.25,
   "end": 442.67,
   "text": "از سی چهل نفر شروع شد الان ماشاالله به سیزده هزار نفر چهارده هزار نفر رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.67,
   "end": 448.35,
   "text": "دادیم گفتیم شروع کنیم مباحث رو ما از مقدمه قلب در قرآن اینجا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.35,
   "end": 450.87,
   "text": "همینطوری قطره چکانی گفتیم اومدیم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.87,
   "end": 454.61,
   "text": "خلاصه وصل شد و اینطوری. میخوام بگم که این مصداق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.61,
   "end": 459.03,
   "text": "آیا به نظر شما یه نفر، دو نفر، سه نفر که من میتونم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.03,
   "end": 465.09,
   "text": "حداقل یه نفر هر روز ما این شکلی داریم که یه دفعه جرقه میخوره و راه رو پیدا میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.09,
   "end": 471.53,
   "text": "این باشه قشنگ‌تره یا نه ما حرفای متعارف و قصه و داستانه باید بگیم که همه جا هم هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.53,
   "end": 475.69,
   "text": "شما هم بگید به به چه عجب چه خوب بود چه آقا قشنگ حرف زد و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.69,
   "end": 478.19,
   "text": "این، این به نظرم ارزشش بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.19,
   "end": 482.17,
   "text": "جا نمونیم. بریم سراغ مب-- حالا وقت ما گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.17,
   "end": 484.59,
   "text": "اشاره‌ای کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.59,
   "end": 487.47,
   "text": "روایت چهارمی که در دست داشتیم که راه نموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.47,
   "end": 489.57,
   "text": "یه اشاره چون فرصت نیست دیگه فقط اشاره کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.57,
   "end": 493.29,
   "text": "توضیح مقصودش انشاالله جلسه بعد وقت شما رو هم نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.29,
   "end": 497.53,
   "text": "دقت بفرمایید در ادامه متن حدیث چهارم از باب اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.53,
   "end": 504.27,
   "text": "کتاب الموت مرحوم مجلسی، امام صادق علیه السلام ادامه دادند که \"و یرجع کل الی جوهره الاول\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.27,
   "end": 506.99,
   "text": "بحث موته که حضرت بیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.99,
   "end": 513.67,
   "text": "این رو ارجاع کل به عنصر اولیه ش میگه که ما حالا روح رو گفتیم یعنی برمیگرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.67,
   "end": 516.31,
   "text": "سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.31,
   "end": 524.91,
   "text": "به چه شکل؟ و جسم هم که گفتیم اینجا میمونه برمیگرده به تجزیه‌‌ش رو میده به اون جوهر اولش و عنصر اولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.91,
   "end": 531.89,
   "text": "و ادامه حضرت اینجا ادامه مبحث \"و تحرکت الروح بن نفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.89,
   "end": 535.83,
   "text": "الله اکبر. تحرکت الروح بن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.83,
   "end": 538.01,
   "text": "روح با چی حرکت میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.01,
   "end": 540.51,
   "text": "با نفس. خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.51,
   "end": 544.75,
   "text": "خیلی شی-- آقا اینو امام صادق فرموده رد شده رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.75,
   "end": 547.41,
   "text": "ولی غوغاست تو این کلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.41,
   "end": 551.35,
   "text": "من یه وجهش رو عرض کنم و توضیح مقصودش باشه بعدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.35,
   "end": 554.41,
   "text": "که اینجا نشون میده که روح با نفس یه فرقی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.41,
   "end": 559.09,
   "text": "درسته؟ اینایی که میگن آقا روح همون نفسه، نفس همون روحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.09,
   "end": 565.11,
   "text": "چطوری اینجا حضرت میفرماید و تحرکت الروح بن نفس با نفس، روح حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.11,
   "end": 566.79,
   "text": "پس پیداست دو شأنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.79,
   "end": 573.01,
   "text": "دو، دو چیزن. حالا خلاصه‌ش رو به شما بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.01,
   "end": 580.35,
   "text": "ببینید ما اون روح که کانال اصلی ارتباط ما با فیاض علی الاطلاقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 580.35,
   "end": 589.31,
   "text": "و اون فیض اولین فیضی که از فیض مقد-- اقدس نازل شد به فیض مقدس تبدیل شد که توضیحش رو دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.31,
   "end": 593.25,
   "text": "اولین عبارتی، اولین رزق ما به رزق وجود ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.25,
   "end": 595.61,
   "text": "وجود پیدا کردیم. موجود شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.61,
   "end": 600.11,
   "text": "خب این موجودیت ما از طریق کانال روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.11,
   "end": 602.73,
   "text": "اون ذات ماست. اون سرشت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.73,
   "end": 607.61,
   "text": "اون دست نمیخوره. یعنی اون باقیه برقراره که بر اساس اسم الباقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.61,
   "end": 613.81,
   "text": "حضرت حق که اگر اون دست خشک بشه یعنی اون بخواد نشه، اصلاً دیگه ما اصلاً نابود باید بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 613.81,
   "end": 617.61,
   "text": "نابودیه چون اون را-- کانال ارتباطی ما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.61,
   "end": 620.89,
   "text": "اون دریای لایتناهی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 620.89,
   "end": 622.49,
   "text": "ما یه قطره‌ایم از اون دریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.49,
   "end": 625.67,
   "text": "خب این از این. پس نفس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.67,
   "end": 628.19,
   "text": "اگر روح اون کانال اصلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.19,
   "end": 632.65,
   "text": "مجرای ارتباطی ما با خالقمون نفس اینجا چی کار-- چی کار هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 632.65,
   "end": 634.89,
   "text": "که جالبه که خدا هم نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.89,
   "end": 637.35,
   "text": "داره یا نداره؟ داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.35,
   "end": 640.03,
   "text": "کجاست؟ کجا میگیم تو دعاها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.03,
   "end": 642.91,
   "text": "الله معرفی نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 642.91,
   "end": 646.49,
   "text": "پس خدا نفس داره. نفس چیه اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.49,
   "end": 650.73,
   "text": "نفس اینو خوب دقت کنید جای جر و تعدیل و بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.73,
   "end": 659.27,
   "text": "نفس اون شأنی از روحه که روح میخواد بدن رو این جسم رو تدبیر کنه بکشه بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 659.27,
   "end": 661.71,
   "text": "مدیریتش کنه این بدن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.71,
   "end": 665.23,
   "text": "به عبارتی نفس میخواد احکامش رو پیاده کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 665.23,
   "end": 669.11,
   "text": "روح میخواد احکامش رو پیاده کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 669.11,
   "end": 671.21,
   "text": "ببخشید بله در بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 671.21,
   "end": 674.03,
   "text": "روح میخواد احکامش رو پیاده کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 674.03,
   "end": 679.41,
   "text": "بدن. از چه طریقی روح احکام خودش رو در بدن پیاده میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.41,
   "end": 683.13,
   "text": "از طریق نفس. یعنی تعلق خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 683.13,
   "end": 685.67,
   "text": "روح به بدن میشه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 685.67,
   "end": 689.67,
   "text": "این شأنشه. مثل این که الان شما بدن داری یا نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 689.67,
   "end": 699.29,
   "text": "چرا بدن داری؟ چون نفس ناطقه یعنی همون روحت میخواد احکام خودش رو پیاده کنه در از عالم باطن به عالم ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.29,
   "end": 701.25,
   "text": "از روح به بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 701.25,
   "end": 705.81,
   "text": "یه کانال ارتباطی میخواد، یک برزخ میخواد، یه رابط میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 705.81,
   "end": 708.49,
   "text": "نفس کانال ارتباطی روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 708.49,
   "end": 710.69,
   "text": "و بدنه. لذا خدا نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 710.69,
   "end": 714.79,
   "text": "ارتباط داره خدا با اشیا، با خلائق یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 714.79,
   "end": 716.73,
   "text": "خدا ارتباط داره با ما یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.73,
   "end": 718.79,
   "text": "از چه طریقی؟ از طریق نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.79,
   "end": 722.97,
   "text": "منتها تعلق خاطر خدا به ما دون از رو احتیاج نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.97,
   "end": 725.73,
   "text": "از رو عشقه، شه، حب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 725.73,
   "end": 728.43,
   "text": "اما تعلق خاطر روح ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.43,
   "end": 731.47,
   "text": "به بدن از رو احتیاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 731.47,
   "end": 738.81,
   "text": "یعنی بدن نیاز داره که نفس ناطقه در داخل این بدن ارتقاء وجودی پیدا کنه، رشد کنه، ما از او نیازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 738.81,
   "end": 742.41,
   "text": "اما خدا از او عشقشه. حالا اینو بعدا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 742.41,
   "end": 746.77,
   "text": "این جمله آخر رو خیلی خوب توجه بکنید خیلی به دردمون میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 746.77,
   "end": 756.35,
   "text": "که اگر روح جمله آخر خوب گوش بدید، اگر روح احکامش رو از طریق نفس اماره پیاده کنه در بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 756.35,
   "end": 764.23,
   "text": "آدم میشه نار. \"فهو من نار\" که حالا در حدیث اومده تو همین حدیث اومده توضیحش میدیم انشاالله الان وقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 764.23,
   "end": 771.45,
   "text": "اما اگر روح احکامش رو از طریق نفس مطمئنه پیاده کنه در بدن میشه نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.45,
   "end": 774.23,
   "text": "میشه بهشتی. این فرقشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 774.23,
   "end": 779.27,
   "text": "پس این نفس است. حالا چرا قرآن میگه نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 779.27,
   "end": 783.73,
   "text": "ما میگیریم به تمامه اما روح رو ارجاع میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 783.73,
   "end": 787.79,
   "text": "این نفس چراش باشه انشاالله جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 787.79,
   "end": 795.09,
   "text": "انشاالله که عقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}