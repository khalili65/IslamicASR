 "chapters": [
  {
   "index": 0,
   "title": "## اکیسه‌ترین؛ ذکر موت و آمادگی",
   "start": 23.44,
   "end": 489.46
  },
  {
   "index": 1,
   "title": "## سه بار در رکعت؛ معراج تا عرش",
   "start": 489.46,
   "end": 552.24
  },
  {
   "index": 2,
   "title": "## هفت طواف در شبانه‌روز نماز",
   "start": 552.24,
   "end": 675.12
  },
  {
   "index": 3,
   "title": "## عرفه؛ سوختن فراق و قابلیت وصال",
   "start": 675.12,
   "end": 759.06
  },
  {
   "index": 4,
   "title": "## دوازده و ذکر یونس؛ سه ظلمت",
   "start": 759.06,
   "end": 834.4
  },
  {
   "index": 5,
   "title": "## دوازده مرحله در دعای عرفهٔ امام حسین",
   "start": 834.4,
   "end": 998.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 9.74,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.74,
   "end": 13.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.48,
   "end": 17.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.5,
   "end": 23.44,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.44,
   "end": 28.12,
   "text": "طبق روایت ششم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.12,
   "end": 35.14,
   "text": "کتاب الموت، پیامبر عظیم الشأن اسلام فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.14,
   "end": 39.38,
   "text": "اون کسی که اكثرهم ذكر الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.38,
   "end": 41.74,
   "text": "و اشدهم استعداد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.74,
   "end": 48.08,
   "text": "هم بیشتر از همه یاد موت می‌کنه و شدیداً خودش رو آماده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.08,
   "end": 50.92,
   "text": "برای اون روز. چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.92,
   "end": 53.52,
   "text": "اکیسه، زیرک‌ترینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.52,
   "end": 58.3,
   "text": "خب چرا اینطور نباشه که نقشه راه رو در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.3,
   "end": 65.94,
   "text": "کسی که زیرکه، باهوشه، آینده و دوراندیشه، آینده نگرе",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.94,
   "end": 70.36,
   "text": "نقشه راه رو دستش می‌گیره و دائماً مترصده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.36,
   "end": 78.42,
   "text": "و افق نگاهش رو هی اون حتی در جنگ هم امیرالمؤمنین می‌فرماید \"اعیر الله جمجمتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.42,
   "end": 84.62,
   "text": "جمجمت رو به خدا بسپر تا آخرین صف دشمن رو نگاه کن، رصد کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.62,
   "end": 87.84,
   "text": "و این‌ها همش حساب و کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.84,
   "end": 93.28,
   "text": "حتی در جزئی‌ترین دستورات اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.28,
   "end": 95.86,
   "text": "ماها خبر نداریم، ماها بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.86,
   "end": 98.62,
   "text": "همش حکمت‌هایی نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.62,
   "end": 102.94,
   "text": "همش هم مطابق با مصالح و مفاسده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.94,
   "end": 107.12,
   "text": "مفاهیم. آنچه که واجبه صد درصد به نفع انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.12,
   "end": 111.66,
   "text": "آنچه که حرامه صد درصد به ضرر انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.66,
   "end": 119.48,
   "text": "حالا اون سه دسته دیگه مباحات و مکروحات و مستحبات هم درش مصالح و مفاسدی هست، مترتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 119.48,
   "end": 124.8,
   "text": "ماها خبر نداریم. الان با دوستمون که قبل نماز صحبت می‌کردیم گفتیم که به واقع هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.8,
   "end": 130.0,
   "text": "سوالی از ما می‌پرسن درستش اینه که اول بگیم من نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.0,
   "end": 134.54,
   "text": "چون حکمت مطلقه رو اون‌ها می‌دونن ما چه می‌دونیم و چه خبر داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.54,
   "end": 137.28,
   "text": "یه زاویه‌ای، یه زوایایی فوقش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.28,
   "end": 145.6,
   "text": "مثلاً اون هم بزرگان به ما یه اشاراتی کرده باشن، یه تنبیهاتی داده باشن، متنبه کرده باشن و بیدار کرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.6,
   "end": 148.46,
   "text": "همش تو سینه اونه و خدا رهنت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 148.46,
   "end": 154.32,
   "text": "بنی امیه رو که دست ما رو از اسرار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.32,
   "end": 162.52,
   "text": "اسرار اهل بیت عصمت علیهم الصلاة والسلام کوتاه کردن با دشمنی‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 162.52,
   "end": 165.82,
   "text": "نگذاشتن پیاده بشه که اگر شیوخ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.82,
   "end": 171.36,
   "text": "شیوخ امامیه و سادات معظم امامیه نبودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 171.36,
   "end": 174.32,
   "text": "مجامع روایی داشته باشن و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.32,
   "end": 179.34,
   "text": "روایات ما رو جمع‌بندی می‌کنند، دسته‌بندی می‌کنند دیگه چی به ما می‌رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.34,
   "end": 183.3,
   "text": "همش تابع مصالح و-- این که میگه زیرک‌ترینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 183.3,
   "end": 184.84,
   "text": "یعنی آقا نقشه راهته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.84,
   "end": 187.08,
   "text": "انا لله و انا الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.08,
   "end": 189.18,
   "text": "راجعون. الیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.18,
   "end": 191.56,
   "text": "به سمت الله در حرکتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.56,
   "end": 194.34,
   "text": "خب باید نگاه کنی کجا داری میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.34,
   "end": 196.62,
   "text": ". دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.62,
   "end": 198.22,
   "text": "اونجا هم باز مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.22,
   "end": 201.84,
   "text": "می‌خواد بره به سمت لقاء الله رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.84,
   "end": 210.54,
   "text": "اما تو همون مرتبه اولش چون کار نکرده، چون دوراندیش نبوده البته همش هم باعثش گناهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.54,
   "end": 218.38,
   "text": "باعث می‌شه که اون الله رو که پیشکش، لقاء الله نه، دیگه با همون رب خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.38,
   "end": 222.2,
   "text": "یا ایها الانسان انک كادحن الى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.2,
   "end": 226.24,
   "text": "كدحن فملاقه. رب خودت رو دیگه حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.24,
   "end": 228.5,
   "text": "زیارت می‌کنی تو اونش هم می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.5,
   "end": 230.28,
   "text": "مغبر می‌شه فضا براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.28,
   "end": 234.6,
   "text": "درک نمی‌کنن این رب خودشون رو که می‌بینن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.6,
   "end": 236.42,
   "text": "قصه خیلی جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.42,
   "end": 241.14,
   "text": "یعنی نقشه راه رو یه آدم زیرک دائماً نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.14,
   "end": 245.98,
   "text": "به فرمایش پیغمبر ساعتی یک بار، روزی بیست بار، شبانه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.98,
   "end": 248.34,
   "text": "که به مقام شهادت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.34,
   "end": 250.76,
   "text": "اتفاقاً در ذیل آیه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.76,
   "end": 255.22,
   "text": "که براتون قرائت کردم، آیه شریفه بیست و شش سوره صاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.22,
   "end": 258.14,
   "text": "نگاه می‌کردم فرمایش علامه طباطبایی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.14,
   "end": 260.76,
   "text": "اونجا که می‌فرماید به حضرت داوود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.76,
   "end": 264.56,
   "text": "فيضلك عن سبيل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.56,
   "end": 267.46,
   "text": "اگر تو بخوای تبعیت هوا کنی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.46,
   "end": 271.14,
   "text": "راه خدا، راه و سبيل حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.14,
   "end": 276.12,
   "text": "گمراه شدی. بعد آخر آیه این گمراهی‌ها رو همه رو می‌زنه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.12,
   "end": 280.6,
   "text": "به ما نسي يوم الحساب که صحبت کردیم دربارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.6,
   "end": 285.02,
   "text": "همش از فراموشی موت و قیامت و روز حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.02,
   "end": 292.34,
   "text": "و بعد علامه حضرت علامه طباطبایی علیه الرحمة می‌فرماید \"هیچ معصیتی از معاصی، هیچ معصیتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.34,
   "end": 297.92,
   "text": "از معاصی منفک از نسیان روز حساب نیست.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.92,
   "end": 303.24,
   "text": "یعنی هر معصیتی از هر کس سر می‌زنه به جهت فراموشی موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.24,
   "end": 308.48,
   "text": "قیامت و اون يوم تبلی السرائر مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.48,
   "end": 314.16,
   "text": "فراموش می‌کنه، نقشه راه رو نگاه نمی‌کنه، حواسش نیست به کجا داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.16,
   "end": 318.14,
   "text": "به کجا داره میره و اونچه که دستور هست آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.14,
   "end": 323.4,
   "text": "دائم یاد موت باش، مرگ باش، یه مصالحی برای خودته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.4,
   "end": 326.46,
   "text": "که اگر یادت نباشه مفاسدی مترتبه برش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.46,
   "end": 330.62,
   "text": "اونم برای خودته، نه به دیگری که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.62,
   "end": 332.22,
   "text": "الان ببینید ایام حجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.22,
   "end": 336.22,
   "text": "من یه مثال بزنم. ایام حجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.22,
   "end": 338.6,
   "text": "روز، روز عرفه است. عجب روزی امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.6,
   "end": 342.64,
   "text": "چی بگه آدم زمانش قاصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.64,
   "end": 346.16,
   "text": "که یه حدیث خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.16,
   "end": 347.82,
   "text": "دیدید حتما این حدیث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.82,
   "end": 352.12,
   "text": "شریفی در علل و شرایع امام صادق صلوات الله علیه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.12,
   "end": 360.66,
   "text": "از حضرت سؤال کردن یه شمه‌ای، یه رشه‌ای از این اسرار رو نسبت به اون شنونده تازه بیان کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.66,
   "end": 364.2,
   "text": "که آقا چرا کعبه شش گوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.2,
   "end": 367.7,
   "text": "حضرت فرمودن چون محاذی بیت‌المعموره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.7,
   "end": 372.92,
   "text": "اونم شش گوشه در آسمان چهارم که ملائکه میان اونجا طواف می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.92,
   "end": 376.92,
   "text": "و اونم چهار گوشه ببخشید. این چهار گوشه چون اون چهار گوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.92,
   "end": 379.82,
   "text": "ملائکه میرن اونجا طواف می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.82,
   "end": 382.36,
   "text": "در بیت‌المعمور آسمان چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.36,
   "end": 385.92,
   "text": "بعد گفتن خب اون چرا چهار گوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.92,
   "end": 391.94,
   "text": "فرمودن در عرش این هم محاذی عرشه، اونم چهار گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.94,
   "end": 395.64,
   "text": "چقدر راوی زرنگ بوده. خب اون چرا چهار گوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.64,
   "end": 399.88,
   "text": "عرش چرا؟ البته اول که گفتن چرا اصلاً بهش میگن کعبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.88,
   "end": 401.88,
   "text": "فرمود چون مکعبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.88,
   "end": 404.44,
   "text": "چهار گوشه. خب چرا چهار گوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.44,
   "end": 407.92,
   "text": "چون محاذی چهارگوشه بیت‌المعمور آسمان چهارمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.92,
   "end": 411.4,
   "text": "اون چرا؟ چون محاذی عرشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.4,
   "end": 413.52,
   "text": "اونم چهارگوشه. خب اون چرا چهار گوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.52,
   "end": 417.3,
   "text": "فرمود بر اساس و بر بنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.3,
   "end": 422.86,
   "text": "این چهار ذکر شریف حقیقت این چهار ذکر شریف که معروفه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.86,
   "end": 424.8,
   "text": "تسبیحات اربعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.8,
   "end": 429.74,
   "text": "سبحان الله والحمد لله ولا اله الا الله والله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.74,
   "end": 432.56,
   "text": "چه کرده حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.56,
   "end": 437.88,
   "text": "اون لب مطلب رو داده دست من و شما بهترین تعقیبات نماز و ازش غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.88,
   "end": 442.06,
   "text": "این سبکی که به فضل الهی ما گذاشتیم هدیه کردیم به شهید حججی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.06,
   "end": 443.72,
   "text": "غالباً قدرشو ندونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.72,
   "end": 447.6,
   "text": "گفتیم با طمأنينه با تع-توجه بگیم سرش در این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.6,
   "end": 449.72,
   "text": "دیدیم ما نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.72,
   "end": 454.04,
   "text": "هیچ دعایی، ذکری، هیچی بالاتر از این تسبیحات نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.04,
   "end": 457.68,
   "text": "سرش در اینه. حالا اونجا حضرت فرمودن چون اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.68,
   "end": 460.9,
   "text": "بر بنای اون چهار گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.9,
   "end": 463.86,
   "text": "حالا شما دقت بفرمایید حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.86,
   "end": 470.84,
   "text": "ان‌شاءالله امام زمان منو ببخشه چون روز عرفه است جرأت می‌کنم یه ذره پامو تو کفش بزرگان و ارفا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.84,
   "end": 473.28,
   "text": "یه چیزک دیگه‌ای برای شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.28,
   "end": 475.38,
   "text": "تا اینجا امام صادق فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.38,
   "end": 482.14,
   "text": "از فرمایشات دیگه بزرگان اهل معرفت که ذره‌بین طهارت نفس گذاشتن، زوایا رو کشف کردن، استیضاح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.14,
   "end": 485.28,
   "text": "یه چیزکی هم باز عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.28,
   "end": 493.62,
   "text": "شما ببینید که در حقیقت شما سه بار این تسبیحات رو تو هر نماز میگی به جز نماز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.62,
   "end": 497.6,
   "text": "تو هر رکعتی رکعت سوم یا چهارم سه بار میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.6,
   "end": 501.06,
   "text": "چرا سه بار؟ یکیش مربوطه به کعبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.06,
   "end": 503.7,
   "text": "یکیش بیت‌المعموره، یکیش عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.7,
   "end": 508.68,
   "text": "صلات هم که معراجه. به معراج میری تا به عرش برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.68,
   "end": 512.84,
   "text": "درست شد؟ حالا اونجا که به عرش رسیدی عرش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.84,
   "end": 517.52,
   "text": "عالم لاهوته. مقام پیغمبر عظیم اسلامه-- اعظم اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.52,
   "end": 522.06,
   "text": "اونجا همه انبیا، اولیا در محضر پیغمبرن و اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 522.06,
   "end": 528.48,
   "text": "لذا میگی وقتی تموم شد نمازت میگی السَّلامُ عَلَیکَ مخاطب قرار ایهاالنبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.48,
   "end": 530.62,
   "text": "رفتی به اون مرحله. معراجه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 530.62,
   "end": 533.2,
   "text": "باید این باشه. این نقشه راه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.2,
   "end": 535.44,
   "text": "اصلاً إنَّ إِلَهِی رَاجِعُون یه معناش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.44,
   "end": 537.68,
   "text": "دائم در نماز داره تکرار می‌شه برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.68,
   "end": 541.68,
   "text": "این یک معنا موتو قبل ان تموتو همین نمازهای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.68,
   "end": 545.1,
   "text": "نبا نکنید نماز من انقدر فشله و اصلاً این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.1,
   "end": 548.46,
   "text": "روحی تو درش نیست. این توجهات درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.46,
   "end": 552.24,
   "text": "بالاخره حالا شما چند بار اینو میگید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.24,
   "end": 555.76,
   "text": "چند مرتبه تسبیحات اربعه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.76,
   "end": 558.44,
   "text": "چند دور میگید در نماز‌هاتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.44,
   "end": 562.82,
   "text": "دقت کنید دو تا نماز ظهره دو مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.82,
   "end": 565.66,
   "text": "دو بار از کعبه زمین میری تا عرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.66,
   "end": 567.82,
   "text": "دو مرحله تو نماز ظهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.82,
   "end": 570.14,
   "text": "دو مرحله نماز عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.14,
   "end": 573.04,
   "text": "یک بار مغرب عصر، دو بارم تو عشاء‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.04,
   "end": 576.2,
   "text": "مجموعاً می‌شه چقدر؟ چند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.2,
   "end": 579.48,
   "text": "هفت بار. کعبه هفت-- چند تا طواف داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.48,
   "end": 590.24,
   "text": "هفت بار. یعنی از کعبه زمین شروع می‌کنی به کعبه ع-عالم اعلی میری تسبیحات رو هفت مرتبه ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.24,
   "end": 595.46,
   "text": "این طواف رو انجام میدی حاجی میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.46,
   "end": 598.6,
   "text": "صلاة اصلاً یعنی این. معراج یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 598.6,
   "end": 601.12,
   "text": "میری انجام میدی بعد برمی‌گردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.12,
   "end": 604.96,
   "text": "حالا یکی سؤال کنه آقا نماز صبح که نداره اون تکلیفش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 604.96,
   "end": 608.12,
   "text": "چقدر در قضا شدن نماز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 608.12,
   "end": 611.54,
   "text": "تأکید شده مراقب باشید، مراقب باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 611.54,
   "end": 614.78,
   "text": "که بزرگان فرمودن اصلش اون نماز صبحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.78,
   "end": 620.96,
   "text": "شما وقتی طواف رو انجام دادی دو رکعت نماز داره پشت مقام حضرت ابراهیم که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 620.96,
   "end": 622.62,
   "text": "تکمیل‌کننده حجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 622.62,
   "end": 628.26,
   "text": "درسته؟ این دو رکعت نماز صبح تکمیل‌کننده حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.26,
   "end": 634.06,
   "text": "احرام که شما احرام بستی و وارد نماز شدی و این سیر بیست و چهار ساعته رو شروع کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 634.06,
   "end": 638.36,
   "text": "دو رکعت نماز صبحت به منزله اون دو رکعت پشت مقام ابراهیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 638.36,
   "end": 641.6,
   "text": "هفت بارم رفتی ش-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.6,
   "end": 644.42,
   "text": "طواف رو انجام دادی حالا برگشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 644.42,
   "end": 647.94,
   "text": "سلامم به اولیا در اون مقام دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.94,
   "end": 652.04,
   "text": "لذا اون سلام آخرو که میدی انگار از آسمون هفتم پرت میشی پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.04,
   "end": 655.48,
   "text": "ناله اولیای خدا بلند می‌شه چون دو مرتبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 655.48,
   "end": 658.18,
   "text": "دو مرتبه برمی‌گردن به کعبه زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.18,
   "end": 660.14,
   "text": "حالا این دو رکعت نماز صبح می‌شه اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.14,
   "end": 662.46,
   "text": "شما اون رو انجام ندی حجت ناقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.46,
   "end": 668.22,
   "text": "اصلاً به معراج نرفتی. یه مثالی من عرض کردم که می‌خوام عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.22,
   "end": 675.12,
   "text": "هرچه که اهل بیت میگن اسراری دارد مطابق با مصالح و مفاسد ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.12,
   "end": 678.18,
   "text": "امروز یکی از بهترین کارها دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 678.18,
   "end": 682.06,
   "text": "دعای البته همراه سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.06,
   "end": 687.64,
   "text": "من یکی دو دقیقه از شما بیشتر امروز وقت می‌خوام چون روز خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 687.64,
   "end": 689.86,
   "text": "سوختن موضوعیت داره امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 689.86,
   "end": 694.08,
   "text": "دعا همراه سوختن. اون فرمایش امام صادق روی یادتون نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.08,
   "end": 697.28,
   "text": "سال‌های گذشته همیشه گفتم که از حضرت سؤال کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 697.28,
   "end": 700.24,
   "text": "چرا فرمودید الحج عرفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.24,
   "end": 702.92,
   "text": "حج، همه حج عرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.92,
   "end": 706.44,
   "text": "اونم عرفه، نه صحرای عرفات بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.44,
   "end": 710.38,
   "text": "امروز ما صحرای عرفات نیستیم که روز عرفه رو باید درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.38,
   "end": 716.74,
   "text": "حضرت خیلی قشنگ جواب دادن چون سؤال کردن آقا عرفات بیرون حرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 716.74,
   "end": 719.02,
   "text": "بیرون، یعنی از حرم بیرون کردن حاجی‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 719.02,
   "end": 721.26,
   "text": "دو مرتبه برمی‌گردن به حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 721.26,
   "end": 722.98,
   "text": "چرا همه حج شده عرفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.98,
   "end": 726.38,
   "text": "فرمود به جهت اینکه فرا-فراق حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.38,
   "end": 729.28,
   "text": "از حرم اینا رو بیرون می‌کنن. می‌سوزن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 729.28,
   "end": 737.0,
   "text": "فراق و دوری حرم. این سوختن اونا رو قابلیت پیدا می‌کنن که دو مرتبه برگردن به حرم وصال اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 737.0,
   "end": 743.3,
   "text": "چقدر من و شما رو خدا دوست داشته در سوختن فراق امام عصرمون قرار داده تا وصال شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 743.3,
   "end": 746.12,
   "text": "و الا اونایی که بغل دست امام حسن بودن نفهمیدن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 746.12,
   "end": 749.46,
   "text": "ما هم تازه نمی‌فهمیم ولی باز خداروشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 749.46,
   "end": 753.62,
   "text": "ببینید اینا همه اسرار. دعای همراه با سوختن قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 753.62,
   "end": 758.7,
   "text": "اونم همه‌ی مراحل رو انسان بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 758.7,
   "end": 760.98,
   "text": "اینکه قرآن فرموده \"إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 760.98,
   "end": 763.94,
   "text": "عدد الشهور عند الله اثنا عشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 763.94,
   "end": 767.82,
   "text": "شهرا\" شهر ماه ها دوازده تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 767.82,
   "end": 770.62,
   "text": "اتفاقا ائمه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 770.62,
   "end": 773.74,
   "text": "می‌شه گفت امامان ما دوازده‌تان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 773.74,
   "end": 778.48,
   "text": "اینا همش رو سره. دوازده تا ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 778.48,
   "end": 781.36,
   "text": "شبانه روز که تو مفاتیح قبلاً بحثش رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 781.36,
   "end": 785.02,
   "text": "اینا همش سر داره. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 785.02,
   "end": 788.1,
   "text": "حضرت یونس سه تا عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 788.1,
   "end": 790.58,
   "text": "زا-- تاریک رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 790.58,
   "end": 794.26,
   "text": "اون تسبیحات معروفش ذکر یونسیه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.26,
   "end": 796.66,
   "text": "لا اله الا انت سبحانک إني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.66,
   "end": 800.54,
   "text": "كنت من الظالمین. سه تا ظلمت رو برطرف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 800.54,
   "end": 802.3,
   "text": "ظاهراً چه ظلمت‌هایی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.3,
   "end": 805.1,
   "text": "دل شب بود، دل ماهی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.1,
   "end": 809.9,
   "text": "و دل دریا بود. فرمودن اگر آ-- کسی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 809.9,
   "end": 814.62,
   "text": "س-- ذکر شریف رو-- کثر این ذکر رو داشته باشه از سه تا ظلمت خلاص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 814.62,
   "end": 818.14,
   "text": "ظلمت دنیا، ظلمت نفس، ظلمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 818.14,
   "end": 822.72,
   "text": "بدن. اینا ببینید حالا یه وجهش رو من دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 822.72,
   "end": 824.52,
   "text": "حالا شما حضرت یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.52,
   "end": 833.8,
   "text": "یه مرحله از دوازده درجه و مرحله توحید رو رفته چقدر عظمت داشته این بزرگوار و چقدر ذکرش شریف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 833.8,
   "end": 837.64,
   "text": "حالا شما برید دعای عرفه امروز امام حسین رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 837.64,
   "end": 845.2,
   "text": "حضرت همین رو که شروع می‌کنه لا اله الا انت سبحانک إنی كنت من الظالمین مرحله اول رد می‌شه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 845.2,
   "end": 848.16,
   "text": "حضرت یونس شما تو همین مرحله اول موندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.16,
   "end": 852.56,
   "text": "ارباب ما ابو عبدالله دوازده مرحله‌ش رو رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 852.56,
   "end": 854.76,
   "text": "که من خلاصه عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 854.76,
   "end": 862.02,
   "text": "که مرحله دوم بعد از إنی كنت من الظالمین ابو عبدالله می‌فرماید إنی كنت من المستغفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 862.02,
   "end": 864.1,
   "text": "بعد إنی كنت من الموحدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 864.1,
   "end": 867.22,
   "text": "اینا مراحل توحیده. دوازده مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.22,
   "end": 869.58,
   "text": "بعد إنی كنت من الخائفین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 869.58,
   "end": 873.58,
   "text": "بعد إنی كنت من الوجلین یعنی هراسناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.58,
   "end": 875.46,
   "text": "إنی كنت من الراجین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 875.46,
   "end": 877.16,
   "text": "إنی كنت من الراغبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 877.16,
   "end": 880.08,
   "text": "إنی كنت من المحللين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.08,
   "end": 882.0,
   "text": "تحلیل. لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 882.0,
   "end": 887.04,
   "text": "اهل الهیت و تحلیل و إنی كنت من السائلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 887.04,
   "end": 889.54,
   "text": "إنی كنت من المسبحین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 889.54,
   "end": 891.5,
   "text": "إنی كنت من المكبرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 891.5,
   "end": 893.36,
   "text": "تکبیرگویه-گویان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 893.36,
   "end": 897.46,
   "text": "مكبر. إنی بعد مرحله دوازدهم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 897.46,
   "end": 899.88,
   "text": "فصله، تمامه. همه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 899.88,
   "end": 904.0,
   "text": "همه رو تیکه تیکه کرده یه جا جمع می‌کنه همه رو تو یه جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 904.0,
   "end": 907.76,
   "text": "إنی سبحان-- لا اله الا انت سبحانک إنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 907.76,
   "end": 910.32,
   "text": "كنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 910.32,
   "end": 915.36,
   "text": "حالا اونجا که گفت ظالمین تا مكبرین اینجا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 915.36,
   "end": 918.3,
   "text": "ربی ورا-- این دوازدهمین مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 918.3,
   "end": 921.08,
   "text": "ربی ورب آبایی الاولین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 921.08,
   "end": 927.24,
   "text": "تمام شد. همه‌ی ارباب‌ها که جمعش کنی می‌شه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 927.24,
   "end": 930.64,
   "text": "قوس نزول، قوس نزول إنا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 930.64,
   "end": 932.62,
   "text": "صعود و إنّا إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 932.62,
   "end": 935.42,
   "text": "یعنی إلا الله راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 935.42,
   "end": 938.92,
   "text": "شما دقت کنید اینا رو. ببین همش به هم مرتبطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 938.92,
   "end": 941.44,
   "text": "و إنّا إله راجعون که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 941.44,
   "end": 945.44,
   "text": "داره می‌گه مراقب موعد باش، اون مرحله اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 945.44,
   "end": 951.8,
   "text": "توحید برای همه اتفاق میفته که زیارت ربشون رو می‌کنند، ملاقات رب خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 951.8,
   "end": 954.84,
   "text": "اونجا دیگه گیر نکنی حالا تا دوازده مرحله‌ش پیشکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 954.84,
   "end": 957.36,
   "text": "اون امام حسین باید دست ما رو بگیره و ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 957.36,
   "end": 960.16,
   "text": "تا به لقاء الله برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 960.16,
   "end": 962.1,
   "text": "چون رب پیغمبر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 962.1,
   "end": 965.64,
   "text": "و إنّا إله ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 965.64,
   "end": 968.84,
   "text": "المنتهی. رب تو اون انتها قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 968.84,
   "end": 973.2,
   "text": "الله. ببینید چقدر اسرار داره این عبادات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 973.2,
   "end": 978.88,
   "text": "حالا این دعای شریف امروز چه عظمتی داره، امروز چه ظرفیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 978.88,
   "end": 983.82,
   "text": "یادمون باشه سوخت-- دعای همراه با سوختن امروز از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 983.82,
   "end": 987.34,
   "text": "از نه بهترین و بالاترین عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 987.34,
   "end": 989.9,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 989.9,
   "end": 992.26,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 992.26,
   "end": 997.3,
   "text": "اللهم صل على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 997.3,
   "end": 998.9,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}