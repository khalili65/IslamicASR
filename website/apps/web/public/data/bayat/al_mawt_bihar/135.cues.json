 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 3.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.32,
   "end": 7.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.68,
   "end": 12.66,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.66,
   "end": 16.46,
   "text": "در روایت یازدهم از باب چهارم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.46,
   "end": 18.5,
   "text": "چنانچه خاطرتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.5,
   "end": 22.04,
   "text": "که امام صادق صلوات الله علیه از قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.04,
   "end": 25.48,
   "text": "جدشون امیرالمؤمنین سلام الله علیه علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.48,
   "end": 30.56,
   "text": "عشقشون به لقاء الله رو بیان کردن و به موت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.56,
   "end": 35.82,
   "text": "فرمودن \"قد اختار علی دین ملائکته و رسله و انبیائه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.82,
   "end": 41.54,
   "text": "علمت ان الذي اکرمنی بهذا ليس انساني فاحببت لقائه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.54,
   "end": 47.7,
   "text": "وقتی دیدم خدا اختیار کرده برای من دین ملائکش، رسولانش و انبیایش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.7,
   "end": 54.46,
   "text": "وقتی اینجا خدا منو این چنین تکریم کرده پس منو اون ور هم فراموش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.46,
   "end": 56.34,
   "text": "لذا عاشق لقاء او شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.34,
   "end": 63.2,
   "text": "این خیلی نکته مهمیه که ما نگاهمون به جهان این، به این شکل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.2,
   "end": 67.5,
   "text": "حالا ببینید یکی از راه های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.5,
   "end": 70.12,
   "text": "اینکه ما بتونیم به اطوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.12,
   "end": 73.46,
   "text": "مختلف یک روایت، یک حدیث این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.46,
   "end": 77.18,
   "text": "دسترسی پیدا کنیم اینه که به گزاره‌های مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.18,
   "end": 79.72,
   "text": "اون حدیث رو تقسیم کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.72,
   "end": 83.06,
   "text": "و جملات و کلماتش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.06,
   "end": 86.12,
   "text": "تقسیم کنیم، دقت کنیم، ذره‌بین بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.12,
   "end": 92.72,
   "text": "بررسی کنیم بعد این‌ها رو دوباره به هم سنجاق کنیم یک نتیجه بهتری حاصل بشه برامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.72,
   "end": 95.36,
   "text": "تا با یک دید کلی فقط روایت رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.36,
   "end": 98.34,
   "text": "الان اینجا خب باید سؤال بشه برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.34,
   "end": 105.04,
   "text": "اینکه \"قد اختار علی دین ملائکته\" که قبلاً عرض کردیم فکر کنم در مسجد بلال بود هفته گذشته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.04,
   "end": 108.76,
   "text": "چرا \"قد اختار علی دین ملائکته\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.76,
   "end": 113.2,
   "text": "چرا اینجا امیرالمؤمنین فرمود خدا اختیار کرد برای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.2,
   "end": 116.74,
   "text": "که گفتیم همه خیرات رو امیرالمؤمنین میزنه به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.74,
   "end": 119.22,
   "text": "منتسب می‌کنه به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.22,
   "end": 122.1,
   "text": "اینو صحبت کردیم. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.1,
   "end": 125.96,
   "text": "نباید سؤال کنیم چرا اینجا دین ملائکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.96,
   "end": 130.2,
   "text": "اولاً چرا ملائکه بر رسولان و انبیا در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.2,
   "end": 138.2,
   "text": "مقدم شده؟ ببینید آدم معمولی که این حرف‌ها رو نزده که ما بخوایم رد شیم بگیم حالا مضمون کلی رو بگیریم رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.2,
   "end": 143.36,
   "text": "امیر بیانه. او هم هرچه می‌گوید عین وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.36,
   "end": 147.62,
   "text": "لذا باید به این ظرافت‌ها دقت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.62,
   "end": 153.28,
   "text": "حالا ما مرحوم حاجی ملا علی سبزواری می‌دونید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.28,
   "end": 159.16,
   "text": "منظومه‌شون اونجا حدود نه قسم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.16,
   "end": 161.5,
   "text": "احکام و از اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.5,
   "end": 166.3,
   "text": "سبقه رو سبقت گرفتن، سبقه رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.3,
   "end": 169.24,
   "text": "یکیش سبقه به شرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.24,
   "end": 173.3,
   "text": "تشریفه. یعنی چیزی مثلاً مسبوقه، سابقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.3,
   "end": 177.8,
   "text": "یعنی میاد جلوتر مقدم قرار می‌گیره، تقدم می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.8,
   "end": 181.46,
   "text": "اینجا قطعاً اینجا سبقه به شرف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.46,
   "end": 184.96,
   "text": "چون ملائکه شرافت ندارن بر رسولان و انبیا که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.96,
   "end": 187.72,
   "text": "بالعکس انبیا و رسولان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.72,
   "end": 189.36,
   "text": "شرافت دارن بر ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.36,
   "end": 191.58,
   "text": "این می‌تونه سبقه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.58,
   "end": 193.62,
   "text": "ترتب طولی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.62,
   "end": 196.34,
   "text": "رتبه طولی اونم در قوس النزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.34,
   "end": 202.58,
   "text": "یعنی خب اون‌ها واسطه فیض بودن اول در قوس النزول که بیای پایین بعد میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.58,
   "end": 206.3,
   "text": "رسولان و ملائکه. یعنی م-- خدا حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.3,
   "end": 209.76,
   "text": "همینجوری بیا ارباب انواع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.76,
   "end": 214.78,
   "text": "همون مرسلات، مفارقات، ارواح یا ملائکه‌اند که رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.78,
   "end": 217.98,
   "text": "پرورش دهنده انواع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.98,
   "end": 225.78,
   "text": "موجودات هستند. همینطوری در سلسله طولی اول اون‌هان که واسطه فیض‌اند بعد رسولان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.78,
   "end": 229.66,
   "text": "این یه دلیله. حالا خب چرا دین ملائکتهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.66,
   "end": 231.58,
   "text": "اصلاً چرا اینجا ملائکه اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.58,
   "end": 233.96,
   "text": "ما اینطوری بخوایم دقت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.96,
   "end": 238.04,
   "text": "یه حدیث می‌بینی، یه کتاب از توش مطلب در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.04,
   "end": 241.74,
   "text": "می‌خوام ذهن شما خلاق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.74,
   "end": 244.36,
   "text": "ذهنتون اجتهاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.36,
   "end": 246.72,
   "text": "ملائکه یعنی عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.72,
   "end": 249.34,
   "text": "عقلاً. درسته؟ اینو همه قبول داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.34,
   "end": 254.0,
   "text": "فرشتگان از عالم عقول و جبروت هم که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.0,
   "end": 261.48,
   "text": "دین ملائکته. یه معناش می‌تونه این باشه که امیرالمؤمنین علیه الصلاة والسلام داره تصریح می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.48,
   "end": 268.68,
   "text": "خدا دینی رو بر من اختیار کرد که سرتاسر این دین عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.68,
   "end": 274.34,
   "text": "حالا دین به نظر شما ف-فقه، شریعته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.34,
   "end": 277.08,
   "text": "شریعت، قانون دین، اون دینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.08,
   "end": 281.64,
   "text": "یا اعتقادات و اخلاقیات دینن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.64,
   "end": 285.72,
   "text": "خیلیا گفتن اعتقادات و اخلاقیات و این‌ها دینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.72,
   "end": 290.06,
   "text": "دین یعنی این. که حالا بعداً درباره‌ش صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.06,
   "end": 292.7,
   "text": "الان بحثمون چیز دیگه‌ای می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.7,
   "end": 297.54,
   "text": "که چون انبیایی بودن که شریعت نداشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.54,
   "end": 302.64,
   "text": "اما دین که داشتن . یعنی اعتقاد که داشتن، اعتقادات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.64,
   "end": 304.96,
   "text": "حالا می‌خوام اینو عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.96,
   "end": 311.48,
   "text": "هرچه که هست این دین چون زدش به ملائکه یعنی دین، دین عقلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.48,
   "end": 315.24,
   "text": "یعنی یدع الرجس عن اللذین لا يعقلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.24,
   "end": 317.26,
   "text": "اگه عقل تعطیل بشه آلودگی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.26,
   "end": 320.1,
   "text": "آیه صد و سیزده یونس بارها عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.1,
   "end": 324.28,
   "text": "یعنی اصلاً دین هرچه هست پایه‌اش عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.28,
   "end": 331.8,
   "text": "اصلاً هرچی که پیاده شده در این عالم که الان ما در نشئه شهادت مطلقه و دنیا و ناسوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.8,
   "end": 338.5,
   "text": "که انزل مراتب عالم هستیم، هرچه می‌بینیم پیرامونمون این پیاده شده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.5,
   "end": 343.28,
   "text": "این ادامه چیه؟ ادامه و پیاده شده عالم عقوله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.28,
   "end": 345.64,
   "text": "مرسلات، ارواح اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.64,
   "end": 349.1,
   "text": "اون، اون پیاده شده شده این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.1,
   "end": 354.36,
   "text": "این دنیا مثل اینکه بارها گفتیم پرنده‌ای که تو آسمون داره پر میزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.36,
   "end": 361.08,
   "text": "شما از سایه این پرنده رو زمین تشخیص میدی این پرنده چه هیئتی داره، چه کسوتی داره، چه شکلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.08,
   "end": 362.72,
   "text": "داره پر میزنه تو آسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.72,
   "end": 367.14,
   "text": "داری سایه‌شو می‌بینی. این دنیا سایه ملکوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.14,
   "end": 369.98,
   "text": "این دنیای ملکی سایه‌ی ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.98,
   "end": 375.2,
   "text": "اصل اونجاست. دوباره اون هم ملکوت هم سایه‌ی جبروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.2,
   "end": 381.34,
   "text": "یعنی اصل اونجاست. هرچی که اینجا هست اصلش و خزانه ش اونجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.34,
   "end": 384.7,
   "text": "و اینجا پیاده شده اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.7,
   "end": 392.76,
   "text": "اینو ما توجه نداریم که \"ام من شيء إلا عندنا خزائنه هو ماننزل له إلا بقدر معلوم\" یعنی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.76,
   "end": 395.82,
   "text": "معنیش اینه دیگه. خزانه ها همه اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.82,
   "end": 399.02,
   "text": "عندنا مقام اندیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.02,
   "end": 402.3,
   "text": "از عالم عقول اینا پا-- پیاده شدن، شدن این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.3,
   "end": 408.06,
   "text": "اصلا همه چی عقله. شما مگه میشه همه چی عقل نباشه بعد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.06,
   "end": 415.2,
   "text": "چینش و بافت نظام هستی انقدر دقت باشه که یه میکرون اعوجاج بپاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.2,
   "end": 416.88,
   "text": "کلن فی فلاک یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.88,
   "end": 422.58,
   "text": "این مدارات مثلا کرات، اینا سیارات، ستارگان، اینا افلاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.58,
   "end": 427.36,
   "text": "یک ذره یک میکرون مدارشون جابجا بشه، میپاچه دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.36,
   "end": 431.64,
   "text": "آیا این عقل نیست؟ عین عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.64,
   "end": 435.64,
   "text": "امیرالمؤمنین داره میفرماید خدا بر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.64,
   "end": 441.16,
   "text": "اختیار کرد دینی که سرتاسر عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.16,
   "end": 448.9,
   "text": "توجه کردید که اصلا عالم جبروت، عالم سلطنت ولایت کلیه الهی است که امیرالمؤمنین اونو برداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.9,
   "end": 451.54,
   "text": "اصلا عالم امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.54,
   "end": 454.92,
   "text": "لذا من عاشق ملاقات خدا و موت شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.92,
   "end": 456.6,
   "text": "سفر از این عالم به عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.6,
   "end": 459.18,
   "text": "به یک معنا. چرا نباشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.18,
   "end": 461.88,
   "text": "سرتاسر میبینید جهان عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.88,
   "end": 466.28,
   "text": "اینکه حالا به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.28,
   "end": 470.06,
   "text": "امام صادق صلی الله علیه توحید مفضل رو حتما خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.06,
   "end": 472.48,
   "text": "کتاب بسیار عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.48,
   "end": 476.12,
   "text": "از هرچی بگی، از زمین و زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 476.12,
   "end": 484.24,
   "text": "ظاهر و باطن. همه و همه اسراری رو امام صادق صلی الله علیه پیرامون کائنات اونجا به مفضل بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.24,
   "end": 493.58,
   "text": "یه بخشش در خصوص پرندگانیه که حلال گوشت‌اند و حرام گوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.58,
   "end": 499.7,
   "text": "درسته؟ اینجا چقدر آدم باید بره تفحص-- اصلا چگونه می‌تونه تشخیص بده اینو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 499.7,
   "end": 503.48,
   "text": "این همه پرنده. چقدر عمر باید داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 503.48,
   "end": 507.58,
   "text": "عمر نوح هم کفایت نمی‌کنه. اما وقتی عقل پیاده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 507.58,
   "end": 510.38,
   "text": "امام صادق صلی الله علیه به مفضل چگونه می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 510.38,
   "end": 513.16,
   "text": "یه ملاک می‌ده. ضابطه کلی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.16,
   "end": 518.92,
   "text": "می‌فرماید اون پرنده‌ای که تخمش مخروطی شکله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 518.92,
   "end": 521.32,
   "text": "مثل مرغ، مثل کبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.32,
   "end": 523.56,
   "text": "اینا چین؟ مثل اردک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 523.56,
   "end": 526.86,
   "text": "مخروطی شکل‌اند. اینا حلال گوشت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.86,
   "end": 533.56,
   "text": "اونی که مخروطی شکل نیست، طوری کشیده است و دو طرفش یکسانه تقریبا، اون حرام گوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 533.56,
   "end": 536.28,
   "text": "خب این ضابطه از کجا پیاده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 536.28,
   "end": 538.94,
   "text": "کی اومد اینو به امام صادق فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 538.94,
   "end": 543.92,
   "text": "کجا تعلیم دید؟ کدوم مدرسه و مکتب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.92,
   "end": 548.46,
   "text": "عقل. عقل آدم، آدم پی-- عالم پیاده میشه، میشه این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.46,
   "end": 552.74,
   "text": "که بعد تازه از تعلم حسن زاده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 552.74,
   "end": 558.62,
   "text": "توضیح دادن اینجا که وقتی اینو می‌فرمودن، فرمودن که اتفاقا وقتی دقت می‌کنی میبینی هرچی پرنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.62,
   "end": 562.62,
   "text": "پاک خورتره تخمش مخروطی شکل‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 562.62,
   "end": 565.66,
   "text": "مثلا کبک که خیلی پاک می‌خوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 565.66,
   "end": 569.68,
   "text": "قدیما گوشت کبک زیاد می‌خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.68,
   "end": 574.42,
   "text": "الان نمی‌خورن. میبینید کاملا تخمش مخروطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 574.42,
   "end": 579.0,
   "text": "مثلا مرغ یه ذره از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 579.0,
   "end": 583.24,
   "text": "درجه‌ش پایین‌تره در پاک خوری مخروطیش کمتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.24,
   "end": 585.52,
   "text": "اردک که دیگه لجن خواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 585.52,
   "end": 587.9,
   "text": "دیگه خیلی کمتره مخروطی بودنیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 587.9,
   "end": 592.68,
   "text": "ببینید اینا اسرار نظامه. یا وقتی ابی لیلا که در زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 592.68,
   "end": 598.26,
   "text": "ابوحنیفه بود دیگه اینا ادعا داشتن، ادعای علمیت داشتن متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.26,
   "end": 602.26,
   "text": "وقتی شخصی اومد بهش گفت آقا من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.26,
   "end": 605.06,
   "text": "کنیزی رو خریداری کردم. خب مرسوم بود اون موقع‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.06,
   "end": 606.74,
   "text": "بعد دیدم بدنش مو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 606.74,
   "end": 608.6,
   "text": "این مویی که ما میگیم زائده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.6,
   "end": 611.84,
   "text": "زائد چیه؟ زائد چیزی در بدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.84,
   "end": 614.38,
   "text": "مو نداره. میخوام فسخ معامله کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.38,
   "end": 616.56,
   "text": "میشه یا نه شرعا؟ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.56,
   "end": 618.14,
   "text": "نمی‌دونست جوابو چی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.14,
   "end": 621.92,
   "text": "گفت برو پیش جعفر بن محمد ب-- بگو از طرف منی سؤال کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.92,
   "end": 625.53,
   "text": "ایشون رفت و سؤال کردن میخوام فسخ کنم آیا میشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.53,
   "end": 629.26,
   "text": "حضرت فرمود بله می‌تونی فسخ کنی چون این یک عیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.26,
   "end": 631.74,
   "text": "کسی که بدنش مو در نمیاره عیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 631.74,
   "end": 633.88,
   "text": "چون این نشانه عقمه. یعنی عقیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.88,
   "end": 635.54,
   "text": "بچه دار نمیشه. اینو کی میفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.54,
   "end": 638.68,
   "text": "کدوم علم تجربی اینو میتونه ثابت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.68,
   "end": 641.9,
   "text": "این از عقل پیاده شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.9,
   "end": 644.16,
   "text": "غیر از اینه؟ یا مثلا مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.16,
   "end": 649.34,
   "text": "جابر. مادر جابر هم بالاخره بچه به مادرش میره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.34,
   "end": 651.8,
   "text": "خیلی اهل تفکر و تأمل و اینها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.8,
   "end": 656.46,
   "text": "تجسس در عالم. عالم علم انباشته شده روی همه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.46,
   "end": 660.38,
   "text": "اومد پیش امام صادق صلی الله علیه حال و احوال حضرت فرمود در چه حالی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.38,
   "end": 667.36,
   "text": "گفت در حالی‌ام که دارم تفحص می‌کنم ببینم کدوم حیوان تخم گذاره، کدوم حیوان بچه زاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.36,
   "end": 670.16,
   "text": "حضرت فرمود بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.16,
   "end": 675.68,
   "text": "این ضابطه رو بنویس. مگه تو عمر نوح داری-- داشته باشی هم نمی‌تونی تشخیص بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 675.68,
   "end": 679.9,
   "text": "مثلا به قول علامه می‌گفت تو لاک‌پشت رو می‌بینی ظاهرش میبینی باط--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.9,
   "end": 681.9,
   "text": "هم زیرش لاک داره هم روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.9,
   "end": 683.7,
   "text": "خب باید بگی این بچه می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.7,
   "end": 686.52,
   "text": "چون تخم داشته باشه چجوری بشینه رو تخمش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.52,
   "end": 688.96,
   "text": "لاکه. چجوری بشینه؟ ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 688.96,
   "end": 692.92,
   "text": "اینطوریه گول می‌زنه. از این جهت که لاک‌پشت تخم گذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.92,
   "end": 695.6,
   "text": "و با چشمش گرما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.6,
   "end": 699.72,
   "text": "عجیبه. انرژی رو با چشمش به تخمش منتقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.72,
   "end": 704.3,
   "text": "خب این از کجا پیاده شده؟ امام صادق صلی الله علیه ضابطه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 704.3,
   "end": 712.2,
   "text": "به مادر جابر. فرمود هر حیوانی که گوشش برآمدگی داره مثل ما آدما که لاله گوش و این گوش برآمده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.2,
   "end": 716.46,
   "text": "اینکه دار-- اینطوری داره، این بچه زائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.46,
   "end": 719.16,
   "text": "مثل خفاش. مثل شب پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.16,
   "end": 721.74,
   "text": "شب پره هم بچه زائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.74,
   "end": 724.58,
   "text": "می‌دونستید؟ چون لاله گوش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.58,
   "end": 727.84,
   "text": "اما هر حیوانی که گوشش برآمدگی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 727.84,
   "end": 730.12,
   "text": "تخم گذاره. مثل لاک‌پشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 730.12,
   "end": 733.11,
   "text": "این ضابطه از کجا اومده؟ بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 733.11,
   "end": 740.73,
   "text": "الا از عقل. اصلا شما وقتی نگاه می‌کنی اون بحثی که حکما و عرفا اینا در بحث جواسیس دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 740.73,
   "end": 743.51,
   "text": "که حالا دیگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 743.51,
   "end": 748.11,
   "text": "شیب بحث رو بدیم و تمومش کنیم جمعش کنیم اینطوری بخوایم حرف بزنیم خیلی حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 748.11,
   "end": 752.31,
   "text": "همین مقدار کفایت می‌کنه. در یک سری دین ملائکه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.31,
   "end": 755.43,
   "text": "در یک روایت. ببین چقدر حرف توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 755.43,
   "end": 759.09,
   "text": "قربون این امیر بیان بریم. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 759.09,
   "end": 763.61,
   "text": "این ببینید تمام حواس ما حتی حواس ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 763.61,
   "end": 766.19,
   "text": "ما این‌ها عقلی‌اند در ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.19,
   "end": 768.79,
   "text": "چون سلطان وجود انسان عقلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 768.79,
   "end": 772.97,
   "text": "بصرمون هم عقلیه، سمعمون هم عقلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 772.97,
   "end": 774.69,
   "text": "شامه مون هم عقلیه. همیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 774.69,
   "end": 778.61,
   "text": "حیوان نه، حیوان همه حواسش وهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.61,
   "end": 780.75,
   "text": "اینو حواسمون باشه. یه نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 780.75,
   "end": 783.91,
   "text": "حالا این چیزی که در-- این حواسی که در واقع قوای چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.91,
   "end": 789.17,
   "text": "ظاهر چه باطن که در ما هست بهش میگن جواسیس یعنی جاسوس‌های عقلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 789.17,
   "end": 795.17,
   "text": "چگونه عمل می‌کنند؟ به قول علمای مثال می‌زد شما میری یه می-میوه رو از رو درخت بچینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 795.17,
   "end": 797.65,
   "text": "نگاهت بهت میگه نه مثل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 797.65,
   "end": 802.89,
   "text": "رسیده است بکَن. وقتی دستتو می‌بری دستت که بهش می‌زنی میبینی سفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.89,
   "end": 805.03,
   "text": "نگاهت جاسوس عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.03,
   "end": 808.43,
   "text": "نگاه تشخیص داد که نه این مشکلی نیست بکَن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 808.43,
   "end": 811.19,
   "text": "دستت ، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 811.19,
   "end": 815.29,
   "text": "جاسوس بعدی. لمس می‌کنه میگه نه سفته نکَن نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 815.29,
   "end": 817.57,
   "text": "نه نرمه باشه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.57,
   "end": 820.19,
   "text": "جاسوس بعدی مثلاً شامه‌ته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 820.19,
   "end": 826.19,
   "text": "اون بو می‌کنه ببینه بوی خوبی میده این یا نه گندیده نباشه، بوی بد تعفن نداده مونده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 826.19,
   "end": 828.77,
   "text": "خب حالا نه بوی خوبی داره. این جاسوسم رد کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 828.77,
   "end": 831.55,
   "text": "عقل از این رد شد. می‌ذاری توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.55,
   "end": 833.25,
   "text": "دهانت شروع می‌کنی خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.25,
   "end": 835.59,
   "text": "ذائقت اینجا مشغول میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 835.59,
   "end": 837.67,
   "text": "ذائقت شروع می‌کنه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 837.67,
   "end": 839.37,
   "text": "جاسوسی کردن برای عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 839.37,
   "end": 845.03,
   "text": "آقا این مزش ترش نباشه، مزش تلخ نباشه، سمی نباشه چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.03,
   "end": 851.55,
   "text": "همه اینا رد شد. یه جاس-- اون اصل کاری که اینا همه سدن و خدمه اونن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 851.55,
   "end": 854.43,
   "text": "عقل توئه. عقلت میگه آقا نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 854.43,
   "end": 856.79,
   "text": "چرا؟ هیچ مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 856.79,
   "end": 859.63,
   "text": "برای چی نخورم؟ میگه حلال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 859.63,
   "end": 863.37,
   "text": "این حلال بودن و یا نبودن و پاک بودن رو کی تشخیص میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 863.37,
   "end": 865.81,
   "text": "دست. ببین این که دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 865.81,
   "end": 869.65,
   "text": "اینا جواسیس عقلند. یا شما ماه مبارک رمضان روزه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 869.65,
   "end": 873.67,
   "text": "بدن تشنه شه. بدن میخواد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 873.67,
   "end": 875.87,
   "text": "اما عقلت میگه حق نداری بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 875.87,
   "end": 879.91,
   "text": "شما روزه‌ای. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.91,
   "end": 882.57,
   "text": "اون حاکم بدنه. اون حرف اول و آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 882.57,
   "end": 887.65,
   "text": "همه چ-- اگر شما بخوای عقل رو برداری اصلا دین تعطیل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 887.65,
   "end": 891.45,
   "text": "حالا شما ببینید چقدر حرف هست توی این یه جمله امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 891.45,
   "end": 896.15,
   "text": "دین ملائک‌تهی عقد اختار علی دین ملائک‌تهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 896.15,
   "end": 899.67,
   "text": "توجه دا-توجه داشتید خداوکیلی به این ماها دا-داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 899.67,
   "end": 902.77,
   "text": "که خدا دین ملائکه ش رو برای ما اختیار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 902.77,
   "end": 904.51,
   "text": "باید بگیم دین پیغمبر و اولیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 904.51,
   "end": 907.69,
   "text": "ملائکه چرا؟ امیربیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 907.69,
   "end": 911.27,
   "text": "می‌خواد بگه همه چی عقلیه. شما عقل رو برداری همه چی تعطیل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 911.27,
   "end": 915.85,
   "text": "اصلاً نمیشه برش داری. این چقدر حرف تو همین یه کلمه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 915.85,
   "end": 917.63,
   "text": "ان‌شاءالله عاقبت از محضر به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 917.63,
   "end": 920.77,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
