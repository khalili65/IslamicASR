   "start": 325.02,
   "end": 502.56
  },
  {
   "index": 6,
   "title": "## ارث امام و وکالت جلالی خمینی",
   "start": 502.56,
   "end": 754.38
  },
  {
   "index": 7,
   "title": "## خوابها آینهٔ محشور بودن",
   "start": 754.38,
   "end": 800.24
  },
  {
   "index": 8,
   "title": "## دو پرهیز حاج‌قاسم",
   "start": 800.24,
   "end": 897.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.94,
   "end": 8.38,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.38,
   "end": 12.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.08,
   "end": 17.02,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.02,
   "end": 20.04,
   "text": "در روایت سوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.04,
   "end": 23.08,
   "text": "در باب چهارم ورود کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.08,
   "end": 26.92,
   "text": "یه روایت هم برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.92,
   "end": 33.96,
   "text": "عالمی داره. یه روایت بسیار به درد بخوره برای امروز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.96,
   "end": 37.16,
   "text": "عن ابی عبیده قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.16,
   "end": 39.96,
   "text": "شخصی به نام ابی عبیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.96,
   "end": 45.64,
   "text": "میگه که قلت لابی جعفر پرسیدم از امام باقر صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.64,
   "end": 50.2,
   "text": "جوعت فداک جانم به فدات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.2,
   "end": 54.44,
   "text": "حدثنی یعنی حدیثی به من بیاموز بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.44,
   "end": 57.24,
   "text": "به ما انتفع به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.24,
   "end": 60.26,
   "text": "که من ازش نفع ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.26,
   "end": 65.02,
   "text": "اولاً اینجا یه تأمل کنیم. آیا به نظر شما درسته که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.02,
   "end": 69.86,
   "text": "به محضر انسان کامل و امام معصوم برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.86,
   "end": 72.7,
   "text": "و چنین درخواستی بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.7,
   "end": 76.06,
   "text": "بگه آقا یه چیزی به من بده، یاد بده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.06,
   "end": 80.76,
   "text": "به نفعم باشه. مگر امام معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.76,
   "end": 87.32,
   "text": "چیزی که به نفع ما نباشه بر زبانش جاری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.32,
   "end": 89.84,
   "text": "این نشون میده که این شخص آدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.84,
   "end": 92.46,
   "text": "حالا بهتره بگیم کم معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.46,
   "end": 96.1,
   "text": "اگر بد قضاوت نکنیم بگیم معرفتش خیلی کم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.1,
   "end": 98.42,
   "text": "امام رو نمیشناخته درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.42,
   "end": 101.66,
   "text": "البته هیچ کدوم از ما نمیشناسیم به واقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.66,
   "end": 107.02,
   "text": "اما دیگه ایشون خیلی. البته بعضیا اومدن من دیدم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.02,
   "end": 110.06,
   "text": "شرح این روایت بعضیا اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.06,
   "end": 113.5,
   "text": "توجیه کردن گفتن منظور ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.5,
   "end": 117.42,
   "text": "این بوده که شما یه چیزی بگو در حد فهم من باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.42,
   "end": 120.84,
   "text": "من مثلاً در حد عقل و فهم من باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.84,
   "end": 124.44,
   "text": "من ظرفم کوچیکه به خودش جسارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.44,
   "end": 127.3,
   "text": "ولی باز هم ما اینو نمی‌تونیم بپذیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.3,
   "end": 130.34,
   "text": "در اون روایت شریف کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.34,
   "end": 133.42,
   "text": "جلد یازده میزان الحکمه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.42,
   "end": 135.38,
   "text": "جلد نوزده بحار هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.38,
   "end": 138.86,
   "text": "که انا معاشر الانبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.86,
   "end": 142.48,
   "text": "امرنا ما از جمله انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.48,
   "end": 146.64,
   "text": "که اهل بیتم که وارث انبیا هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.64,
   "end": 150.38,
   "text": "و اهل بیت نبوت هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.38,
   "end": 153.6,
   "text": "این‌ها فرمودند امرنا به ما امر شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.6,
   "end": 158.3,
   "text": "ان نکلم الناس علی قدر عقولهم ما نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.3,
   "end": 161.76,
   "text": "اندازه‌ی عقل مردم باهاشون صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.76,
   "end": 168.06,
   "text": "یعنی امام معصوم چه شما قید بزنی چه نزنی، اون نسبت به عقل تو با تو صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.06,
   "end": 172.74,
   "text": "اتفاقاً یه بحثی در روایات هست که قبلاً هم خدمتتون اجبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.74,
   "end": 176.3,
   "text": "روایات غالباً نسبت به مخاطب بیان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.3,
   "end": 179.12,
   "text": "نسبت به ظرف و اندازه و عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.12,
   "end": 184.08,
   "text": "مخاطب، مستمع، سائل، کسی که اومده سؤال کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.08,
   "end": 186.9,
   "text": "اما ادعیه اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.9,
   "end": 191.92,
   "text": "به قول حضرت علامه حسن زاده علیه رحمة این استاد کل می‌فرمودند ادعیه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.92,
   "end": 194.72,
   "text": "مقامات انشایی اهل بیت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.72,
   "end": 201.46,
   "text": "یعنی اونا دیگه چون مستقیم با خدا دارن صحبت می‌کنند لذا ناب‌ترین معارف الهی رو شما می‌تونید در ادعیه بیابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.46,
   "end": 203.72,
   "text": "چقدر علامه تأکید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.72,
   "end": 206.16,
   "text": "صحیفه سجادیه داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.16,
   "end": 209.26,
   "text": "و همین دیروز داشتم جلسه دو صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.26,
   "end": 214.5,
   "text": "و هجده فسوس رو که گوش می‌دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.5,
   "end": 216.52,
   "text": "درس شرح فسوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.52,
   "end": 220.1,
   "text": "حضرت علامه می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.1,
   "end": 222.8,
   "text": "تمام این فرمایشاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.8,
   "end": 226.94,
   "text": "بزرگان، عقلا، عقلاي قوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.94,
   "end": 231.24,
   "text": "مثل ابن سیناها، ملا صدراها، شیخ طوسی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.24,
   "end": 233.9,
   "text": "همه رو بریزی روی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.9,
   "end": 237.06,
   "text": "باز اونی نمی‌شه که تو ادعیه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.06,
   "end": 242.2,
   "text": "یعنی لسان ادعیه لسان آل الله هست با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.2,
   "end": 246.52,
   "text": "لذا اگر کسی می‌خواد معرفت افزایی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.52,
   "end": 249.48,
   "text": "صرفاً نباید به روایات بسنده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.48,
   "end": 253.0,
   "text": "اگه-- روایات خیلی عالیه ما هم به گردشون نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.0,
   "end": 257.6,
   "text": "اما خب اونچه که در ادعیه هست یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.6,
   "end": 260.86,
   "text": "یعنی باز شده‌ی اون حقایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.86,
   "end": 264.24,
   "text": "بالاخره این ادعیه است که حاج قاسم‌ها می‌سازه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.24,
   "end": 268.34,
   "text": "شهید حججی‌ها می‌پرورانه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.34,
   "end": 272.72,
   "text": "پس این غلطه. اینو بدونیم که اگر در روایتی دیدیم نشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 272.72,
   "end": 274.96,
   "text": "کم فهمی، کم معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 274.96,
   "end": 279.82,
   "text": "سائله. صریح آیه قرآن هم هست دیگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.82,
   "end": 283.82,
   "text": "ما ینطق عن الهوی پیغمبر از روی هوی حرف نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.82,
   "end": 288.58,
   "text": "اهل بیت هم همچنین‌اند. إن هو إلا وحی یوحى هرچی میگن وحیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.58,
   "end": 291.88,
   "text": "یعنی علم الهی بر زبانشون جاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.88,
   "end": 295.54,
   "text": "یا آیه دو سوره نجم می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.54,
   "end": 299.42,
   "text": "ما غوی صاحبکم و ما غوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.42,
   "end": 301.08,
   "text": "گمراه نشده صاحب شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.08,
   "end": 306.22,
   "text": "منظور پیغمبره که ما صاحب الزمان رو از اینجا اقتباس می‌کنیم از همین آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.22,
   "end": 313.38,
   "text": "صاحب شما که پیغمبر باشه، انسان کامل باشه، امام زمانتون باشه گمراه نشده که و ما غوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.38,
   "end": 315.74,
   "text": "همینطوری رو هوای نفسش که حرف نمی‌زنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.74,
   "end": 317.66,
   "text": "هرچی میگه وحیه. پس این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.66,
   "end": 321.28,
   "text": "این یه نکته. بریم بقیه روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.28,
   "end": 325.02,
   "text": "فقال وقتی که این سؤال رو کرد از امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.02,
   "end": 327.42,
   "text": "حضرت جواب دادن یا أبا عبیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.42,
   "end": 332.04,
   "text": "ما أكثر ذكر الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.04,
   "end": 336.54,
   "text": "إنسان. رو این انسان باید خیلی توجه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.54,
   "end": 345.14,
   "text": "می‌فرمود که هیچ انسانی بسیار ذکر و یاد موت نکرد إلا زهد في الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.14,
   "end": 349.78,
   "text": "مگر اینکه زاهد شد در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.78,
   "end": 351.7,
   "text": "اینو خوب توجه بهش بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.7,
   "end": 355.84,
   "text": "آقا راه برون رفت از حب دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.84,
   "end": 358.96,
   "text": "که حب الدنيا رأس كل خطيئة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.96,
   "end": 367.22,
   "text": "خدا رحمت کنه از امام رضا چقدر تأکید به این روایت داشتند و در کتابشون چقدر این رو بیان کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.22,
   "end": 372.82,
   "text": "چیه به نظر شما راه برون رفت و نجات از حب دنیا به عنوان راس همه خطاها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.82,
   "end": 377.14,
   "text": "این روایت داره میگه. eksar ذکر موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.14,
   "end": 379.82,
   "text": "اونم ذکر موت. ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.82,
   "end": 388.44,
   "text": "گفتیم چیه؟ اینکه بالاتر از ورده اینکه دائم دیگه بهش توجه می‌کنی و با حضور قلب بیان می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.44,
   "end": 395.6,
   "text": "که الان اینطوری نیست. الان وقتی از حرف، حرف از مرگ می‌زنی میگن آقا زبونتو گاز بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.6,
   "end": 400.54,
   "text": "اعوذبالله. نمی‌دونم دور از جون شما این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.54,
   "end": 405.36,
   "text": "اینا همش یه نشانه نفهمیدن قصه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.36,
   "end": 408.84,
   "text": "راهی که مثل اینکه الان یکی بیاد به شما بگه آقا می‌خوای بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.84,
   "end": 412.72,
   "text": "مثلا فلان جا بیا من به شما بگم از چه طریقی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.72,
   "end": 414.6,
   "text": "قطعا می‌خوای بری دیگه برا صد در صد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.6,
   "end": 417.78,
   "text": "اصلا باید برم هیچ راه دیگه‌ای ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.78,
   "end": 420.22,
   "text": "حالا بیا این راه رو بهت نشون بدم چیکار کنی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.22,
   "end": 424.42,
   "text": "بعد برگرده آقا زبونتو گاز بگیر می‌خوای به من راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.42,
   "end": 428.26,
   "text": "مثلا اینجا رو نشون بدی که آقا من می‌خوام راه تو آسون کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.26,
   "end": 431.46,
   "text": "تو تو چاه نیفتی. تو که بالاخره باید بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.46,
   "end": 438.04,
   "text": "اینطوری شده. میگه eksar ذکر موت، ذکر موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.04,
   "end": 440.94,
   "text": "که حالا قدیم‌ها اصلا سنت اینطوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.94,
   "end": 443.74,
   "text": "بارها گفتیم قبرستان تو شهرها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.74,
   "end": 448.0,
   "text": "الان چقدر فاصله دادن که نزدیک‌تر از اون حتی تو خونه‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.0,
   "end": 451.98,
   "text": "پس راه برون رفت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.98,
   "end": 458.92,
   "text": "عزیزان دلم، دل بستگی به دنیا که نقطه مقابلش می‌شه زهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.92,
   "end": 462.92,
   "text": "در دنیا eksar ذکر موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.92,
   "end": 467.12,
   "text": "هرچی ما بیشتر به این توجه کنیم عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.12,
   "end": 471.62,
   "text": "ما زاهدتر می‌شیم. این روایت داره تشریح در این می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.62,
   "end": 478.9,
   "text": "می‌خوای زاهد باشی یا نه؟ یه سری نعمت‌ها در آخرت هست مخصوص زاهدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.9,
   "end": 482.76,
   "text": "زهد هم می‌دونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.76,
   "end": 485.88,
   "text": "سبب تع-- یعنی زهد بستر تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.88,
   "end": 489.52,
   "text": "اگر کسی بی‌تقواست چون زهد نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.52,
   "end": 492.26,
   "text": "زهد بستر تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.26,
   "end": 493.94,
   "text": "تقوا توشه آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.94,
   "end": 496.66,
   "text": "اما اونچه که باعث تقوا می‌شه زهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.66,
   "end": 500.66,
   "text": "یعنی زهد هم یعنی بی‌رقبتیه به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.66,
   "end": 502.56,
   "text": "فرار می‌کنند بزرگان از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.56,
   "end": 507.38,
   "text": "حضرت امام علیه الرحمه هم می‌دونید از جهت موروثی و ارث و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.38,
   "end": 510.22,
   "text": "چقدر زمین از پدرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.22,
   "end": 513.52,
   "text": "بهشون رسیده بود. حالا الان به ما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.52,
   "end": 519.62,
   "text": "مثلا یه قطعه زمین، دو قطعه، سه هر چند تا از پدرمون چیزی رسیده باشه نسبت بهش چه ولعی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.62,
   "end": 524.06,
   "text": "چه حرصی داریم. خدا نکنه کسی انگشت بذاره روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.06,
   "end": 526.64,
   "text": "یه کسی بیاد بگه یه متر از این زمینتو به من میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.64,
   "end": 531.2,
   "text": "یه متر. چنان به گوشه قبامون بر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.2,
   "end": 533.82,
   "text": "من محضر حضرت آیت الله جلالی خمینی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.82,
   "end": 537.14,
   "text": "روح شادشون هم به رحمت حق رفت دو سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.14,
   "end": 539.62,
   "text": "خیلی از کلاس‌های اخلاقیشون بهره می‌بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.62,
   "end": 543.48,
   "text": "از یاران مستقیم امام بود در مسیر انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.48,
   "end": 546.42,
   "text": "نماینده امام در شرق تهران بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.42,
   "end": 548.84,
   "text": "بیش از پونزده مسجد ساخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.84,
   "end": 551.6,
   "text": "تو شرق تهران. آدم عجیبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.6,
   "end": 555.7,
   "text": "ایشون فرمود بنده وکیل شدم از طرف امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.7,
   "end": 562.34,
   "text": "تمام ملک و املاکی که از پدرش بهش برس- رسید، رسیده بود رو بدم به فقیرها و یتیم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.34,
   "end": 565.06,
   "text": "و در زمان حیاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.06,
   "end": 573.54,
   "text": "یعنی اینکه حالا ما معمولا خیلی، خیلی، خیلی زهدمون گل کنه وصیت کنیم حالا ثلث مالمون رو لطف کنید بعد از مرگ ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.54,
   "end": 577.82,
   "text": "بعد از اینکه خرج و مخارج تشییع و تدفین و اینا رو انجام دادید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.82,
   "end": 581.64,
   "text": "حالا یه بخشیش هم بدید به خیریه بدید به یتیم خونه بدو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.64,
   "end": 584.8,
   "text": "ولی در زمان حیاتمون چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.8,
   "end": 586.36,
   "text": "چقدر با خدا معامله کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.36,
   "end": 589.5,
   "text": "همون روایتو یادمون نره خیلی کلیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.5,
   "end": 592.56,
   "text": "این بار سومه میگم که به پیغمبر گفت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.56,
   "end": 595.04,
   "text": "در خصوص مال چرا مرگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.04,
   "end": 597.66,
   "text": "چرا موت برای ما انقدر سخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 597.66,
   "end": 601.88,
   "text": "پیغمبر چی فرمود؟ سریع فرمود \"مال داری یا نه؟\" گفت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.88,
   "end": 604.2,
   "text": "فرمود \"در راه خدا می‌بخشی یا نه؟\" گفت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 604.2,
   "end": 606.92,
   "text": "گفت برا، فرمود برا همین سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.92,
   "end": 609.62,
   "text": "اصلا گیر و گور ما اینه. این دلبستگی‌ها، اون فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 609.62,
   "end": 612.64,
   "text": "واقعا فکر کردیم اینجا موندنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.64,
   "end": 617.86,
   "text": "در حد کفاف. اصلا کسی رو هم که خدا خیلی دوسش داره همینطوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.86,
   "end": 624.98,
   "text": "دیروز یکی از دوستان ما خیلی خوب بچه جبهه و جنگ باصفا ما پشت سرش نماز می‌خونیم، رو اسمش قسم می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.98,
   "end": 627.58,
   "text": "به ما گفتش که فلان شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 627.58,
   "end": 631.58,
   "text": "به من گفته که تو گنجشک روزی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.58,
   "end": 633.38,
   "text": "به هر دری می‌زنم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.38,
   "end": 636.74,
   "text": "بیشتر نمی‌شه. گفتم خدا خیلی دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 636.74,
   "end": 641.16,
   "text": "اصلا پرتگاهه. اکثر آدمایی که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.16,
   "end": 643.72,
   "text": "با نگاه خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.72,
   "end": 646.72,
   "text": "رفتن سمت دنیا چپه کرده، چپه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.72,
   "end": 648.8,
   "text": "اکثرا یعنی من به شخصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.8,
   "end": 651.74,
   "text": "حالا میگم اکثر به خاطر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.74,
   "end": 657.64,
   "text": "قضاوت نکرده باشم. و الا من ندیدم کسی حتی به نیت خیر رفته باشه به سمت دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 657.64,
   "end": 659.56,
   "text": "بعد آسیب جدی ندیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 659.56,
   "end": 664.72,
   "text": "من ندیدم. اینکه بره به سمت دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.72,
   "end": 667.62,
   "text": "آغوش باز کنه و بره بگه آقا من می‌خوام کار خیر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.62,
   "end": 670.56,
   "text": "آقا خیلی خطرناکه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 670.56,
   "end": 673.82,
   "text": "بعد از اون طرف تو مسائل معنوی، معرفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 673.82,
   "end": 677.58,
   "text": "عبادی می‌بینی به شدت ضعیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 677.58,
   "end": 682.2,
   "text": "جز از اف الناس می‌خواد بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 682.2,
   "end": 684.72,
   "text": "به سمت دنیا. آقا تو از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 684.72,
   "end": 689.4,
   "text": "معنوی خودت رو قوی کن بعد برو به سمت دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.4,
   "end": 695.96,
   "text": "انقدر دلت رو بزرگ کن که اگه خدا چیزی داد راحت ببخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.96,
   "end": 700.9,
   "text": "مثل امام حسن باشی که وقتی می‌بخشید مثل پیغمبر مثلا دست خودشو می‌بوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.9,
   "end": 702.98,
   "text": "می‌گفتن آقا چرا دست خودتو می‌بوسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.98,
   "end": 705.6,
   "text": "می‌فرمود چون دادم به خدا نه به این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.6,
   "end": 708.14,
   "text": "دست من متبرک به یدالله شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 708.14,
   "end": 712.46,
   "text": "اگه این نگاه رو داری اگه واقعا به اینجا رسیدی بفرمایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 712.46,
   "end": 716.7,
   "text": "برید جمع کنید که ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 716.7,
   "end": 719.42,
   "text": "و این کار هرکسی نیست. منم دارم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 719.42,
   "end": 722.36,
   "text": "حد زبان و زبان و چه می‌دونم این‌ها میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 722.36,
   "end": 724.78,
   "text": "اما واقعا کار هرکسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.78,
   "end": 731.48,
   "text": "دنیا هممون رو به نحوی آلوده کرده و گرفته و برده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.48,
   "end": 734.56,
   "text": "و درد اصلی ما همین است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 734.56,
   "end": 737.76,
   "text": "جز این نیست. ما زاهد نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 737.76,
   "end": 747.44,
   "text": "ما حب دنیا ولو به صورت رشه‌هایی، رگه‌هایی در وجودمون باقیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 747.44,
   "end": 749.62,
   "text": "الان اجازه بدین در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.62,
   "end": 754.38,
   "text": "ختم موضوع یه دو مرتبه اصرار کنم رو یه موضوعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 754.38,
   "end": 759.46,
   "text": "خواب‌های ما چه شکلیه؟ قشنگ داره میگه ما چه کاره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 759.46,
   "end": 763.66,
   "text": "یه ذاکر اهل بیت معمولا تو خواب می‌بینه داره روضه می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 763.66,
   "end": 766.8,
   "text": "یه مدیر معمولا می‌بینه که یه نگاه بالا به پایین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 766.8,
   "end": 772.98,
   "text": "داره امر، امر می‌کنه بشین پاشو نگو فلان اینو اخراج کنید، اونو پوهاشو کم کنید فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 772.98,
   "end": 775.14,
   "text": "یه نسبت به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 775.14,
   "end": 777.66,
   "text": "چیزی که باهاش محشوره همون رو تو خواب می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 777.66,
   "end": 780.14,
   "text": "تو خوابامون چگونه‌ایم؟ واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.14,
   "end": 782.12,
   "text": "این خودش یه راهه دیگه. بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 782.12,
   "end": 784.16,
   "text": "بررسی کنیم. دیروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 784.16,
   "end": 785.84,
   "text": "یه حکایت جالبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 785.84,
   "end": 788.22,
   "text": "یکی از بچه‌های خود شما ریش سفید خوب اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 788.22,
   "end": 793.1,
   "text": "بچه‌های جوجه‌ای از بچه‌های خیلی باصفای مجموعه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.1,
   "end": 795.2,
   "text": "به من یه خوابی دیده بود از حاج قاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 795.2,
   "end": 798.56,
   "text": "خیلی برام شیرین بود شنیدن این خواب حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 798.56,
   "end": 800.9,
   "text": "که گفت من حاج قاسم رو در خواب دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 800.9,
   "end": 803.1,
   "text": "بهش گفتم که دیدم داره اون بالاتر از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 803.1,
   "end": 806.54,
   "text": "اینا خیلی جالبه که بالاتر از ایشون ایستاده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 806.54,
   "end": 808.24,
   "text": "چفیه رو دوش داشت وضو می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 808.24,
   "end": 812.38,
   "text": "بهش گفتم من خیلی آرزو داشتم برسم به شما به شهادت اینا نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 812.38,
   "end": 816.1,
   "text": "چی شد؟ چیکار کنم؟ حاج قاسم فرمود غصه نخور انشاالله می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 816.1,
   "end": 818.96,
   "text": "ولی راه داره بهت بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 818.96,
   "end": 823.02,
   "text": "حواستو جمع می‌کنی حالا به تعبیر بنده انجام میدی اینا گفته بود باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 823.02,
   "end": 826.08,
   "text": "فرموده بود یکی مراقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 826.08,
   "end": 829.24,
   "text": "محافلی که درش غیبت می‌شه باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 829.24,
   "end": 832.66,
   "text": "یکی هم محافلی که درش دروغ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 832.66,
   "end": 835.8,
   "text": "دروغ، دروغ گفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 835.8,
   "end": 841.54,
   "text": "ببین اینا ما چقدر غافلیم. راحت غیبت می‌کنیم، آبرو می‌بریم زیر پای کسی رو خالی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 841.54,
   "end": 844.88,
   "text": "راحت دروغ می‌گیم، راحت می‌بندیم بین اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 844.88,
   "end": 849.86,
   "text": "تحلیل‌های سیاسیمون بدون هیچ پایه و اساسی راحت تحلیل می‌کنیم راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 849.86,
   "end": 851.96,
   "text": "اینا همش ما رو به پرتگاه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 851.96,
   "end": 856.42,
   "text": "به حب دنیا نزدیک می‌کنه. خب یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 856.42,
   "end": 859.2,
   "text": "یک دو سه تا از بچه‌های خودتون هم می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 859.2,
   "end": 862.04,
   "text": "یکی زنگ زد، یکی هم حضوراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 862.04,
   "end": 865.3,
   "text": "یکی هم تو فامیل‌های ما سرطانی داشتن مریض داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 865.3,
   "end": 870.4,
   "text": "گفتن که به بچه‌های باصفای نماز خونه بگید که دعاشون کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 870.4,
   "end": 874.2,
   "text": "مخصوصا با این حال خوب و خوشتون بین دو نماز لطف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 874.2,
   "end": 879.42,
   "text": "مخصوصا یکیشون فاطمه خانم سه سال و نیمه‌ست سرطان خون گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 879.42,
   "end": 883.34,
   "text": "به هر حال با این دل خوب و پاکتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 883.34,
   "end": 886.68,
   "text": "لطف کنید یه حمد شفا همراه صلوات قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 886.68,
   "end": 895.62,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 895.62,
   "end": 897.6,
   "text": "محمد و آل محمد. لا اله الا الله. لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}