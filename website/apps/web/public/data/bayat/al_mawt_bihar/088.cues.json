 "chapters": [
  {
   "index": 0,
   "title": "## فراموشی موت و ولایت شیطان",
   "start": 1.78,
   "end": 71.88
  },
  {
   "index": 1,
   "title": "## ریسمان ولایت طاغوت؛ حکایت خرس در آب",
   "start": 71.88,
   "end": 237.48
  },
  {
   "index": 2,
   "title": "این‌قدر این قصه مهم است که آن آیه‌ای که قرائت شد از آیهٔ نود و هشت نحل شروع می‌شد:",
   "start": 237.48,
   "end": 279.06
  },
  {
   "index": 3,
   "title": "## سه نیاز قاری؛ قلب خاشع و بدن فارغ و موضع خالی",
   "start": 279.06,
   "end": 411.8
  },
  {
   "index": 4,
   "title": "## فإذا خشع لله قلبه فر منه الشیطان",
   "start": 411.8,
   "end": 515.38
  },
  {
   "index": 5,
   "title": "## تعوذ در افتتاح هر سوره؛ معنای رجیم",
   "start": 515.38,
   "end": 765.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 7.04,
   "text": "در روایت پنجم از باب چهارم کتاب الموت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.04,
   "end": 9.68,
   "text": "رسیده بودیم به بحث ارتباط بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.68,
   "end": 13.68,
   "text": "فراموشی موت با ولایت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.68,
   "end": 17.48,
   "text": "عرض کردیم که هر چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.48,
   "end": 25.18,
   "text": "موت فراموش بشه به همون میزان ما تحت تصرف ولایت شیطان قرار گرفتیم به تصریح این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.18,
   "end": 29.2,
   "text": "و انقدر موضوع ولایت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.2,
   "end": 40.1,
   "text": "جدیه که بسیاری از بزرگان وقت خودشون رو گرفتن برای اینکه ما رو متوجه کنن در این خصوص قلم زدن، صحبت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.1,
   "end": 45.0,
   "text": "مثلا رهبر عزیزمون می‌فرماید «آن کسی که در تحت فرمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.0,
   "end": 50.2,
   "text": "ولی حقیقی زندگی نمی‌کند» یعنی تحت فرمان گوش به فرمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.2,
   "end": 54.26,
   "text": "ولی الله الاعظم نیست. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.26,
   "end": 60.16,
   "text": "«باید بداند که تحت فرمان طاغوت و شیطان زندگی می‌کند.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.16,
   "end": 63.0,
   "text": "کسی که حرف ولی اعظم الهی رو گوش نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.0,
   "end": 66.06,
   "text": "این قطعاً یعنی ما چیزی به جز این دو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.06,
   "end": 68.92,
   "text": "یا ولایت الله یا در تقابلش ولایت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.92,
   "end": 74.98,
   "text": "وسط ما نداریم. باز ایشون می‌فرماید که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.98,
   "end": 78.0,
   "text": "خیلی قابل تأمل فرمایش‌های ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.0,
   "end": 84.52,
   "text": "می‌فرماید «اگر چنانچه گردنت را بردی طرف شیطان و طاغوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.52,
   "end": 91.66,
   "text": "که ریسمان ولایتش را بر گردنت بی اندازد، دیگر از دست او خلاصی پیدا نخواهی کرد.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.66,
   "end": 95.82,
   "text": "مثل اون بابایی که تو دریا نگاه کرد از راه دور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.82,
   "end": 98.7,
   "text": "تو حکایتی میگن که دید فکر کرد یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.7,
   "end": 103.18,
   "text": "مثلاً صندوقچه‌ای از طلایی چیزی تو آبه داره بالا پایین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.18,
   "end": 105.58,
   "text": "از دور نگاه کرد، سراب دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.58,
   "end": 108.16,
   "text": "زد به آب و رفت خودشو رسوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.16,
   "end": 111.46,
   "text": "حالا رفیقاش تو ساحله می‌گفتن بابا ولش کن برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.46,
   "end": 114.78,
   "text": "داد می‌زد می‌گفت می‌خوام بیام این ولم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.78,
   "end": 121.1,
   "text": "نگو چی بوده، یه خرسی بوده شکمشو انداخته بوده رو آب، به پشت خوابیده بوده رو آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.1,
   "end": 122.86,
   "text": "این میره حالا خرس می‌گیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.86,
   "end": 125.48,
   "text": "حالا این می‌خواد بیاد، اون ول نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.48,
   "end": 128.92,
   "text": "یعنی دیگه ح-- حضرت-- اینجا رهبر می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.92,
   "end": 133.14,
   "text": "«خلاصی پیدا نخواهی کرد از ولایت او.» یعنی بگیره دیگه تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.14,
   "end": 142.42,
   "text": "«هرچه در وجود تو از نیرو و از ابتکار و از فعالیت‌های سازنده و از جلوه‌های درخشنده وجود دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.42,
   "end": 146.3,
   "text": "تحت قبضه‌ی طاغوت و شیطان در خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.3,
   "end": 149.28,
   "text": "ظاهراً در کسبت اسلامی اما می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.28,
   "end": 152.48,
   "text": "تدبیراتت، تذکراتت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.48,
   "end": 157.26,
   "text": "اعمال و رفتارت، جهت‌گیری‌ها همه بو شیطان می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.26,
   "end": 161.0,
   "text": "وقتی که تو تمام وجودت در قبضه‌ی او درآمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.0,
   "end": 167.54,
   "text": "آنوقت او به آسانی می‌تواند تو را در همان راهی که خودش می‌خواهد به همان جایی که خودش می‌خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.54,
   "end": 170.62,
   "text": "با همان وسیله‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.62,
   "end": 174.24,
   "text": "خودش می‌خواهد بکشاند.\" با وسایل خودش میاد تو کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.24,
   "end": 180.28,
   "text": "\"و ببرد و پیداست که شیطان و طاغوت انسان را به نور و معرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.28,
   "end": 182.6,
   "text": "آسایش و رفاه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.6,
   "end": 187.12,
   "text": "معنویت رهنمون نمی‌شوند.\" خیلی جالبه که رهبر می‌فرماید حتی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.12,
   "end": 190.1,
   "text": "آسایش و رفاه هم شیطان تو رو نمی‌تونه برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.1,
   "end": 193.34,
   "text": "\"او برایش این چیزا هدف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.34,
   "end": 197.86,
   "text": "برای شیطان و طاغوت مصالح شخصی خودش هدف اولی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.86,
   "end": 200.82,
   "text": "ولی و می‌خواهد آنها را تأمین کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.82,
   "end": 203.84,
   "text": "پس تو را در راه مصالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.84,
   "end": 207.4,
   "text": "شخصی خود به کار می‌اندازد.\" تو میشی عامل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.4,
   "end": 210.5,
   "text": "شیطان. خودتم متوجه نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.5,
   "end": 214.06,
   "text": "می‌بینی که داری میری به جاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.06,
   "end": 219.3,
   "text": "دیگه دیگران شاید متوجه بشن هرچی هم به تو بگن تو قبول نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.3,
   "end": 221.94,
   "text": "انقدر این قصه مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.94,
   "end": 224.08,
   "text": "اون آیه‌ای که قرائت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.08,
   "end": 228.04,
   "text": "براتون از آیه نود و هشت نحل شروع می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.04,
   "end": 230.82,
   "text": "\"فَإِذَا قَرَأْتَ الْقُرْآنَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.82,
   "end": 234.5,
   "text": "فَإِذَا قَرَأْتَ الْقُرْآنَ\" وقتی که قرآن می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.5,
   "end": 237.48,
   "text": "\"فَاسْتَعِذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.48,
   "end": 240.62,
   "text": "گفتیم دیگه ما بالاتر از قرآن که نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.62,
   "end": 243.24,
   "text": "میگه قرآن هم می‌خونی استعاذه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.24,
   "end": 247.16,
   "text": "پناه ببر به شیطان. قرآن داری می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.16,
   "end": 251.68,
   "text": "انقدر قصه مهمه. حالا آقا چه کنیم که قرآن خوندن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.68,
   "end": 255.5,
   "text": "تحت تصرف شیطان نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.5,
   "end": 261.22,
   "text": "بسیاری از آدم‌هایی که قرآن می‌خونن و بد می‌فهمن، ولایت شیطان سرشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.22,
   "end": 264.72,
   "text": "چون این که جوهره چشمت داره می‌بینه، می‌تونه بد برداشت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.72,
   "end": 267.28,
   "text": "یا حتی صوت قرآن رو می‌شنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.28,
   "end": 270.34,
   "text": "ماده‌ست. اون صوت رو شیطان می‌تونه عوضش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.34,
   "end": 275.96,
   "text": "یه طور دیگه مفاهیمشو به گوش سمع مبارک شما برسونه و تو یه چیز دیگه برداشت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.96,
   "end": 279.06,
   "text": "خیلی راحت می‌تونه تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.06,
   "end": 281.56,
   "text": "ذیل این آیه جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.56,
   "end": 285.9,
   "text": "اینکه ما خیلی دیگه توجه‌مون رو بیشتر کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.9,
   "end": 289.5,
   "text": "یکی دو تا روایت تقدیمتون کنم از تفسیر اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.5,
   "end": 292.9,
   "text": "این روایت که الان میگم ذیل همون آیه اومده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.9,
   "end": 298.5,
   "text": "ذیل آیه نود و هشت نحل. جلد هفت، صفحه هفتصد و بیست و دو تفسیر اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.5,
   "end": 301.92,
   "text": "البته در مصباح الشریعه صفحه بیست و هشت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.92,
   "end": 309.44,
   "text": "هستن. الان کسانی که اینجا نشستن بچه بودن ما این مصباح الشریعه رو براشون تد-تدریس کردیم حدود سی سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.44,
   "end": 313.88,
   "text": "مستدرک الوسائل، جلد چهار، صفحه دویست و چهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.88,
   "end": 317.94,
   "text": "امام صادق صلی الله علیه یه فرمایش خیلی شیرینی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.94,
   "end": 321.36,
   "text": "راه برون رفت از ولایت شیطان رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.36,
   "end": 325.84,
   "text": "خیلی شیرین. می‌فرماید \"فقارئ القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.84,
   "end": 328.02,
   "text": "يحتاج إلى ثلاثة أشياء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.02,
   "end": 332.14,
   "text": "یه کسی که داره قرآن می‌خونه به سه چیز نیاز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.14,
   "end": 334.68,
   "text": "\"قلب خاشع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.68,
   "end": 338.18,
   "text": "یه قلب خاشع. خاضع نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.18,
   "end": 341.44,
   "text": "خاضع یعنی تو سرت پایینه، دستات قشنگ افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.44,
   "end": 344.64,
   "text": "هرکی نگاه می‌کنه میگه به به چه حالی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.64,
   "end": 348.02,
   "text": "این خضوعه. خشوع باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.02,
   "end": 354.38,
   "text": "امکان داره من اینطوری یک طوری نمازمو صدامم الهی الله همه بگن به به حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.38,
   "end": 356.28,
   "text": "جای آقای بهجت رو پر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.28,
   "end": 362.84,
   "text": "ولی تو در درون خودم، تو بازار و محل کسب و کار و پول و سرمایه و تجارت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.84,
   "end": 366.24,
   "text": "ارز و بورس و سکه و دلار و ایناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.24,
   "end": 370.16,
   "text": "اون، اون اگه اون درون درست شد به این میگن خشوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.16,
   "end": 374.02,
   "text": "حالا پس اولیش چیه؟ قلب خاشع و بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.02,
   "end": 376.62,
   "text": "فارغ. بدنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.62,
   "end": 379.32,
   "text": "فارغ باشه و یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.32,
   "end": 386.5,
   "text": "سالم باشه و آدم با سردرد سنگین که نمی‌تونه بشینه قرآن بخونه و بفهمه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.5,
   "end": 390.98,
   "text": "و موضع خال یعنی یه جایی بره خلوتی، خلوتی بگزینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.98,
   "end": 393.9,
   "text": "خودش پاشو حالا داره تندتند قرآن می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.9,
   "end": 396.04,
   "text": "بعدم یکی میگه ساعت چنده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.04,
   "end": 398.1,
   "text": "وسط قرآن خوندن میگه ساعت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.1,
   "end": 400.9,
   "text": "میگه پیش تلویزیون بزن کانال فلان داره وسط قرآن خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.9,
   "end": 403.78,
   "text": "این چه قر-- تعطیلش کن آقا با کمر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.78,
   "end": 408.74,
   "text": "این چه قرآن خوندنیه. امیرالمؤمنین فرمود خیری در این ق-- نوع قرآن خوندن‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.74,
   "end": 411.8,
   "text": "سر خودمون رو کلاه می‌ذاریم. حالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.8,
   "end": 416.46,
   "text": "حالا چه کنیم؟ این سه تا رو که می‌خوایم انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.46,
   "end": 419.58,
   "text": "خیلی شیرین. می‌فرمود \"فَاِذَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.58,
   "end": 429.22,
   "text": "خَشَعَ لِلّهِ قَلْبُهُ\" به محض اینکه خشوع در قلب اومد \"فَرَّ مِنْهُ الشَّيْطَانُ الرَّجِيمُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.22,
   "end": 431.24,
   "text": "او از شیطان رجیم فرار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.24,
   "end": 436.98,
   "text": "با چی؟ با قلب خاشع. یعنی شیطان نمی‌تونه بیاد در قلب خاشع تاثیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.98,
   "end": 440.3,
   "text": "پس علت اینکه ما حتی قرآن می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.3,
   "end": 442.48,
   "text": "ق-- میگه پناه ببر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.48,
   "end": 450.26,
   "text": "به خدا از شر شیطان چون قلبمون خاشع نیست راحت میاد حتی مفاهیم قرآن رو برای ما اشتباه جا می‌اندازه تو ذهن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.26,
   "end": 453.36,
   "text": "قلب که خاشع شد تازه از شر شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.36,
   "end": 457.42,
   "text": "رها می‌شه. قال الله از-- اجا-- ادامه فرمایش امام صادق‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.42,
   "end": 462.94,
   "text": "قال الله عز وجل \"فَاِذَا قَرَأْتَ الْقُرْآنَ فَاسْتَعِذْ بِاللّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.94,
   "end": 466.28,
   "text": "حضرت داره می‌فرماید این استعاذه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.28,
   "end": 471.56,
   "text": "از شر شیطان به خدا یعنی قلب خاشع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.56,
   "end": 477.46,
   "text": "یعنی در درون خودت خشوع داشته باشی، در درونت سرت پایین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.46,
   "end": 480.24,
   "text": "از اون غوغای بیرون فارغ باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.24,
   "end": 483.06,
   "text": "این یه روایت که خیلی جالب و خیلی-- یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.06,
   "end": 490.96,
   "text": "شاه کلید فرار از شیطان و نجات و خلاصی از شر ولایت او رو اینجا بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.96,
   "end": 496.62,
   "text": "نه فقط قرآن ها هر کجا شما خواستی از شر شیطان در امان باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.62,
   "end": 500.86,
   "text": "قلب خاشع. تأمل، توجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.86,
   "end": 505.94,
   "text": "توجه عرفانی از اینجا شروع می‌شه که انسان رو می‌رسونه به اون حدیث برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.94,
   "end": 509.74,
   "text": "احادیث برزخی که از عالم برزخ صدا می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.74,
   "end": 512.0,
   "text": "خاطف باهات حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.0,
   "end": 515.94,
   "text": "چه تو خواب، چه در بیداری. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.94,
   "end": 518.46,
   "text": "روایت دوم اینم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.46,
   "end": 520.42,
   "text": "خیلی نورانی، پربرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.42,
   "end": 524.26,
   "text": "حیفه اینو نگم. اینم از همون سندی که عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.26,
   "end": 526.86,
   "text": "\"من الحلبی عن عبد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.86,
   "end": 530.8,
   "text": "أبي عبد الله\" یعنی حلبی از امام صادق سلام الله علیه نقل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.8,
   "end": 536.7,
   "text": "\"قال سألته عن التعوذ من الشيطان عند كل سورة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.7,
   "end": 538.74,
   "text": "نفتحها فـ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.74,
   "end": 542.78,
   "text": "گفتم آقا از ام-- از حضرت سؤال کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.78,
   "end": 545.94,
   "text": "این تعو-- تعوزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.94,
   "end": 548.72,
   "text": "این \"أعوذ بالله من الشيطان\" که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.72,
   "end": 551.2,
   "text": "\"عند كل سورة\" هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.2,
   "end": 554.5,
   "text": "\"نفتح-- نفتحها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.5,
   "end": 559.26,
   "text": "که ما افتتاح کنیم همه‌ی سوره ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.26,
   "end": 561.84,
   "text": "همه سوره ها رو اینطوری شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.84,
   "end": 564.16,
   "text": "\"فقال نعم\" بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.16,
   "end": 568.1,
   "text": "\"فتعوذ بالله من الشيطان الرجيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.1,
   "end": 572.4,
   "text": "باید از شیطان رجیم تعویذ بگیری، بری به سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.4,
   "end": 575.92,
   "text": "\"وذكر أن الرجيم أخبس الشياطين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.92,
   "end": 579.98,
   "text": "بعد حضرت ادامه داد که این شیطانی که داری ازش فرار می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.98,
   "end": 583.98,
   "text": "خبیث‌ترین شیاطینه. پیداست ما شیطان زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 583.98,
   "end": 586.84,
   "text": "این خبیث‌ترینشه که این کمین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 586.84,
   "end": 589.7,
   "text": "حالا \"فقلت لم سمي الرجيم؟\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.7,
   "end": 593.86,
   "text": "به به! چقدر قشنگ سؤال و چقدر قشنگ‌تر جوابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 593.86,
   "end": 598.6,
   "text": "چرا بهش میگن رجیم؟ حلبی از امام صادق پرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.6,
   "end": 603.24,
   "text": "فکر کنید الان یه آدمی از امام زمان ما سؤال کنه چرا به شیطان میگن رجیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.24,
   "end": 608.52,
   "text": "الان همه چی که به ذهن ما متب-- متبادر می‌شه میگیم خب چون از شیط-- از بهشت رانده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.52,
   "end": 611.78,
   "text": "درسته؟ اما حضرت جواب قشنگ‌تری می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.78,
   "end": 614.28,
   "text": "می‌فرماید قال فرمودن \"لأنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.28,
   "end": 618.78,
   "text": "يرجم\". به خاطر اینکه اون رجم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.78,
   "end": 622.8,
   "text": "رجم. رجم یعنی با سنگ می‌زننش، سنگسارش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.8,
   "end": 624.76,
   "text": "به خاطر این میگن رجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.76,
   "end": 629.3,
   "text": "\"فقلنا هل ينقلب شيئا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 629.3,
   "end": 635.8,
   "text": "إذا رجم؟\". میگه ما پرسیدیم که ما گفتیم که آقا پیداست که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 635.8,
   "end": 637.84,
   "text": "جماعتی شدن یه دفعه تو این سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.84,
   "end": 641.84,
   "text": "\"فقلنا\" ماها گفتیم که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.84,
   "end": 644.98,
   "text": "از بین می‌ره وقتی رجمش می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.98,
   "end": 648.18,
   "text": "شیطان رو رجم کردن، سنگسار کردن از بین می‌ره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.18,
   "end": 650.7,
   "text": "حضرت فرمود \"قال لا\" نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.7,
   "end": 653.24,
   "text": "از بین نمی‌ره. مثلاً یعنی مجروح می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.24,
   "end": 655.3,
   "text": "دست پاش مثلاً زخمی می‌شه، ضعیف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.3,
   "end": 657.5,
   "text": "خب؟ از بین نمی‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 657.5,
   "end": 662.16,
   "text": "\"ولكن يكون في العلم انه رجم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 662.16,
   "end": 664.8,
   "text": "تو علم خداست که رجم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 664.8,
   "end": 669.72,
   "text": "یعنی چی علم خداست؟ یعنی هنوز در نشئ طبیعت پیاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.72,
   "end": 672.96,
   "text": "تو علم الهیه یعنی در آینده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 672.96,
   "end": 678.32,
   "text": "اون کیه؟ بر اساس-- دیگه وقت نیست روایات دیگر براتون بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 678.32,
   "end": 681.6,
   "text": "که این رو میان باز می‌کنن اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.6,
   "end": 684.1,
   "text": "می‌فرمایند ظهور امام عصر انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 684.1,
   "end": 688.56,
   "text": "در فرج امام عصر این ملعون رجم می‌شه، سنگسار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 688.56,
   "end": 691.96,
   "text": "خیلی جالب اونایی که میگن امام عصر میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 691.96,
   "end": 693.58,
   "text": "سر شیطان رو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 693.58,
   "end": 696.66,
   "text": "بعضی روایات داریم این بعد می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 696.66,
   "end": 700.16,
   "text": "تبعیض که ما اینهمه باهاش بجنگیم پدرمون در بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 700.16,
   "end": 703.02,
   "text": "بعد که آقا تشریف بیاره اینو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.02,
   "end": 705.8,
   "text": "این خبیث رو بکشن، آقا اینو بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.8,
   "end": 707.44,
   "text": "سرشو بزنه بعد اونا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.44,
   "end": 710.74,
   "text": "مثلاً هنر نکردن اگه برن بهشت که اگه شیطان نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.74,
   "end": 715.58,
   "text": "درسته؟ پس رجم می‌شه بزرگان اهل معرفت مثل حضرت علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 715.58,
   "end": 719.66,
   "text": "حسن زاده علیه الرحمه در شرح فصوص خلاصه‌ش کنم تو یه جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 719.66,
   "end": 726.44,
   "text": "فرمودن یعنی انقدر آقا علوم و معارف رو می‌ریزه بیرون تو سینه مردم، عاقل می‌کنه مردمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 726.44,
   "end": 728.96,
   "text": "دیگه عاقل گول شیطان رو نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 728.96,
   "end": 733.0,
   "text": "یعنی رجم می‌شه سنگسار می‌شه یعنی با علم و معرفت رجم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 733.0,
   "end": 737.76,
   "text": "یعنی انقدر آگاهی‌ها زیاد می‌شه دیگه کسی میگه برو عمو واسه دیگه کاری با تو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 737.76,
   "end": 742.36,
   "text": "این می‌شه رجمش. یعنی دیگه کیدش کارساز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.36,
   "end": 746.66,
   "text": "انشاالله که ما باشیم و اون روز رو ببینیم در محضر حضرت باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 746.66,
   "end": 749.3,
   "text": "اون روز موفور السرور رو درک کنیم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 749.3,
   "end": 753.82,
   "text": "عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 753.82,
   "end": 757.8,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 757.8,
   "end": 765.68,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}