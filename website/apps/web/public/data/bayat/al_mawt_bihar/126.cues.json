 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتای شرکت در انتخابات بدون تشخیص اصلح",
   "start": 16.64,
   "end": 89.16
  },
  {
   "index": 1,
   "title": "## سه دشواری زندگی در سخن امام رضا",
   "start": 89.16,
   "end": 259.48
  },
  {
   "index": 2,
   "title": "## مراتب موت و مرحلهٔ سوم: تراقی",
   "start": 259.48,
   "end": 454.87
  },
  {
   "index": 3,
   "title": "## تلقین در مرحلهٔ سوم",
   "start": 454.87,
   "end": 488.89
  },
  {
   "index": 4,
   "title": "## خاطرهٔ خلع روح و قلعهٔ قزوین",
   "start": 488.89,
   "end": 647.45
  },
  {
   "index": 5,
   "title": "## ختم جلسه موت و انتخابات",
   "start": 647.45,
   "end": 892.11
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 4.06,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.06,
   "end": 8.88,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.88,
   "end": 13.84,
   "text": "بسم الله الرحمن الرحيم وبه نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.84,
   "end": 17.78,
   "text": "السلام علیک يا داعی الله و رباني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.78,
   "end": 23.16,
   "text": "آياته، السلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.16,
   "end": 26.66,
   "text": "استفتاء کردن از رهبر عزیزمون که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.66,
   "end": 32.6,
   "text": "در بحث انتخابات اصلح رو نشناسیم وظیفه‌مون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.6,
   "end": 39.08,
   "text": "و از طرفی هم تحقیق بکنیم و به شخص اصلح نرسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.08,
   "end": 42.0,
   "text": "یه بحثی که میگه اصلح رو تشخیص ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.0,
   "end": 47.64,
   "text": "دو تش-- بریم تحقیق بکنیم بالاخره تشخیص ندیم اصلح کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.64,
   "end": 52.46,
   "text": "آیا در این صورت می‌تونیم تو انتخابات شرکت نکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.46,
   "end": 57.26,
   "text": "رهبر عزیزمون فرمودن که \"در تشخیص فرد اصلح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.26,
   "end": 62.24,
   "text": "می‌توانید از کسانی که به لحاظ تعهد دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.24,
   "end": 67.3,
   "text": "و بصیرت انقلابی مورد اعتمادند کمک بگیرید.\" راهکار نشون دادن آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.3,
   "end": 75.1,
   "text": "\"و در هر صورت شرکت در انتخابات نظام جمهوری اسلامی برای افراد واجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.1,
   "end": 80.34,
   "text": "واجب شرایط یک وظیفه شرعی است.\" این‌طور نیست که به این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.34,
   "end": 84.08,
   "text": "که به این دلیل که شما نتونستی تشخیص بدی شرکت نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.08,
   "end": 88.94,
   "text": "نخیر این همه آدم ازش می‌پرسه سؤال کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.94,
   "end": 94.68,
   "text": "اما در خصوص بحث چهارشنبه‌هامون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.68,
   "end": 96.44,
   "text": "بحث شیرین موت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.44,
   "end": 101.76,
   "text": "البته تبریک عرض می‌کنم این شب بسیار با عظمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.76,
   "end": 108.92,
   "text": "دیگه شاید مثل امشب به فرمایش حضرت امام علیه الرحمه ما مثل امشب نداریم در طی سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.92,
   "end": 112.66,
   "text": "اصلاً هدایت منوط به امشبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.66,
   "end": 118.34,
   "text": "خیلی شب بزرگیه و عجیبه ارتباط امشب با امام رئوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.34,
   "end": 121.9,
   "text": "که فضیلت خیلی بالایی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.9,
   "end": 125.84,
   "text": "زیارت ایشون امشب، فردا که خوشا به حال اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.84,
   "end": 129.24,
   "text": "مشهد رضا هستن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.24,
   "end": 138.76,
   "text": "البته در رابطه با بحث موتمون هم اون حدیث معروفی که سه دسته کرد دشواری‌ها، سه مرحله کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.76,
   "end": 143.68,
   "text": "دشواری‌ها رو در کل زندگی ما امام رئوف فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.68,
   "end": 150.22,
   "text": "امام رضا اگر اشتباه نکنم در اصول کافی دیدم این روایت رو که حضرت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 150.22,
   "end": 155.3,
   "text": "دشوارترین مراحل زندگی انسان سه مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.3,
   "end": 158.9,
   "text": "اولیشو فرمودن وقت تولده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.9,
   "end": 161.36,
   "text": "دیدی چقدر بچه گریه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 161.36,
   "end": 164.4,
   "text": "از رحم مادر خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.4,
   "end": 167.9,
   "text": "برای اون اتفاقی که رخ داده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.9,
   "end": 171.72,
   "text": "موته. ما میگیم تولد ولی برای او موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 171.72,
   "end": 175.0,
   "text": "از اون عالم مادون مو-- مرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.0,
   "end": 182.14,
   "text": "حرکت کرده و اون اگر اون رو باطن بگیریم از ظاهر بگیریم برای اون، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.14,
   "end": 184.48,
   "text": "اون عالم رحم برای اون عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.48,
   "end": 191.9,
   "text": "ظاهر بود. سفر کرده به باطن اون عالم که می‌شه این دنیا چون مرتبه مافوق رحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.9,
   "end": 194.68,
   "text": "توجه کردید؟ لذا گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.68,
   "end": 197.5,
   "text": "براش موت اتفاق افتاده. داد می‌زنه ناراحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.5,
   "end": 200.38,
   "text": "خیلی براش سخته، دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.38,
   "end": 203.7,
   "text": "خبر نداره از اینجا. بی‌خبری باعث شده گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.7,
   "end": 205.92,
   "text": "مرحله دوم رو فرمود موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.92,
   "end": 208.38,
   "text": "موتی که تو این دنیاست. امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.38,
   "end": 211.02,
   "text": "علیه السلام که مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.02,
   "end": 214.46,
   "text": "مرحله سوم هم اون برانگیخته شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.46,
   "end": 217.98,
   "text": "حشر و نشر و این‌ها. مبعوث شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.98,
   "end": 222.8,
   "text": "که بعد حضرت وقتی به اینجا می‌رسه اشاره می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.8,
   "end": 224.96,
   "text": "چون هرچی اون‌ها می‌فرماین از قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.96,
   "end": 230.64,
   "text": "اشاره می‌کنه به آیه پانزده سوره مریم که در خصوص حضرت یحیی سلام الله علیهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.64,
   "end": 233.38,
   "text": "که سلامٌ عليه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.38,
   "end": 235.72,
   "text": "سلام بر او. بر کی؟ بر حضرت یحیی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.72,
   "end": 238.12,
   "text": "کی؟ يوم ولد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.12,
   "end": 241.28,
   "text": "روزی که متولد شد و يوم يموت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.28,
   "end": 243.14,
   "text": "روزی که می‌میرد و يوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.14,
   "end": 248.02,
   "text": "يبعث حيا، روزی که زنده می‌شه، مبعوث می‌شه دو مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.02,
   "end": 254.74,
   "text": "این سه مرحله‌ست که تو آیه اومده و همه ما این سه مرحله همه، همه درک خواهیم کرد و می‌کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.74,
   "end": 259.48,
   "text": "پیش روی ماست. ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.48,
   "end": 262.42,
   "text": "موت عرض کردیم که همین‌طور که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.42,
   "end": 264.88,
   "text": "آنچه که در عالم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.88,
   "end": 268.56,
   "text": "مدارج داره، معارج داره و مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.56,
   "end": 270.54,
   "text": "ذو مراتب خود ما هم این‌چنینی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.54,
   "end": 273.18,
   "text": "موت همین‌جوریه. مرتبه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.18,
   "end": 276.3,
   "text": "چه قبل از این که موت قطعی حاصل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.3,
   "end": 278.82,
   "text": "لحظات موت نزدیک می‌شه، چه بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.82,
   "end": 284.82,
   "text": "این‌ها همه مراتب داره. حالا ما قبل از اون موت قطعی رو داریم میگیم که شش مرحله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.82,
   "end": 287.68,
   "text": "مرحله اول رو که گفتیم بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.68,
   "end": 291.56,
   "text": "ملائکه نازل می‌شن، آماده می‌شن برای توفی روحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.56,
   "end": 294.08,
   "text": "اما هیچ خبری نداره. هیچ اتفاقی نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.08,
   "end": 296.22,
   "text": "مرحله اول که توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.22,
   "end": 300.46,
   "text": "مرحله دوم که مز-- مرحله شروع نزع جانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.46,
   "end": 303.58,
   "text": "نزع روحه. کندن، کندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.58,
   "end": 308.06,
   "text": "کندن روح از کف پا از نوک انگشت پا شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.06,
   "end": 312.82,
   "text": "این مرحله دوم بود که عرض کردیم هنوزم خبر نداره، ملائکه رو هم نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.82,
   "end": 316.08,
   "text": "ام-- امروز انشاالله مرحله سوم رو می‌خوایم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.08,
   "end": 320.3,
   "text": "که حالا مخصوصا این توضیحات رو دادم کسانی که جلسه پیش نبودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.3,
   "end": 323.2,
   "text": "متوجه بشن ما کجاییم. مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.2,
   "end": 328.86,
   "text": "سوم رو با توجه به آیاتی هم که جلسه پیش عرض کردیم گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.86,
   "end": 331.9,
   "text": "مرحله دوم قبل از طراقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.9,
   "end": 335.42,
   "text": "نزع روح، شروع نزع روح، نزع جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.42,
   "end": 340.76,
   "text": "قبل از طراقیه که گفتیم این استخوان‌هایی که از گودی گلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.76,
   "end": 344.52,
   "text": "یه گودی تو گلومون هست بهش می‌گن عربا می‌گن نحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.52,
   "end": 348.16,
   "text": "از اینجا دو تا استخون کشیده شده اومده به کتف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.16,
   "end": 353.58,
   "text": "اینو بهش می‌گن طراقی. اون مرحله دوم تا قبل از رسیدن به اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.58,
   "end": 358.8,
   "text": "روح. مرحله سوم که امروز می‌گیم خود طراقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.8,
   "end": 364.26,
   "text": "که یعنی دیگه روح می‌خواد از این دو تا استخون کشیده بشه بیاد تا زیر گلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.26,
   "end": 366.56,
   "text": "یعنی هنوز باز به حلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.56,
   "end": 370.75,
   "text": "نمی‌رسه. این مرحله یه حالت مثل گردن، این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.75,
   "end": 372.53,
   "text": "حالا چرا این مراحل هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.53,
   "end": 374.41,
   "text": "چرا این یه تیکه چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.41,
   "end": 378.37,
   "text": "یه تیکه، یه تیکه بین این گودی گلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.37,
   "end": 380.77,
   "text": "گودی زیر گلو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.77,
   "end": 384.61,
   "text": "حلق. چه خبره اینجا که خودش یه مرحله‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.61,
   "end": 387.31,
   "text": "که جالبه که بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.31,
   "end": 391.25,
   "text": "وقتی به اینجا می‌رسه دیگه شهود رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.25,
   "end": 393.87,
   "text": "برای اولین بار ملائکه رو شخص می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.87,
   "end": 397.37,
   "text": "ملائکه‌ای که نازل شدن برای ترفیع جانش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.37,
   "end": 399.05,
   "text": "می‌بینه. نه قابض الارواح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.05,
   "end": 402.97,
   "text": "اون صدنه و خدمه حضرت قابض الارواح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.97,
   "end": 405.23,
   "text": "می‌بینه و لو نشناسه. برای اولین بار می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.23,
   "end": 407.35,
   "text": "لذا شما تو این مرحله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.35,
   "end": 410.77,
   "text": "میت می‌رسه می‌بینید خیره شده یه گوشه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.77,
   "end": 413.27,
   "text": "هی با یه تعجبی نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.27,
   "end": 416.13,
   "text": "این داره می‌بینه ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.13,
   "end": 419.43,
   "text": "نمیگه، نمی‌تونه چیزی بگه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.43,
   "end": 424.11,
   "text": "چشمش تیز شده چیزهایی رو داره می‌بینه که تا پیش از این نمی‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.11,
   "end": 427.61,
   "text": "این مرحله سوم که حالا اون لحظه مردم شلوغش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.61,
   "end": 430.31,
   "text": "آی بدو مثلا دکتر بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.31,
   "end": 433.13,
   "text": "می‌فهمن چه خبره دیگه کارش تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.13,
   "end": 436.57,
   "text": "دیگه خیره شده هرچی صداش می‌زنن تو گوشش می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.57,
   "end": 438.99,
   "text": "تلقینش میخوان بدن اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.99,
   "end": 442.81,
   "text": "هیچ انگار رفته. اینا میگن این رفت دیگه کارش تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.81,
   "end": 445.93,
   "text": "هنوز نبضش می‌زنه ها. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.93,
   "end": 453.19,
   "text": "ولی چی؟ خارج نشده روح به صورت کامل میگن این کارش تموم شده که اصلاً حالیش نمیشه ما چی میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.19,
   "end": 454.87,
   "text": "اتفاقاً اینو یادمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.87,
   "end": 456.67,
   "text": "وصیت کنیم به نزدیکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.67,
   "end": 461.11,
   "text": "من برای چند نفر از نزدیکامون این کارو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.11,
   "end": 464.11,
   "text": "اولین تلقینی که وارد شده تو این مرحله‌ست اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.11,
   "end": 467.79,
   "text": "اون تلقین دوم که میتو تو خاک می‌کار می‌زنن، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.79,
   "end": 470.63,
   "text": "اونم خوبه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.63,
   "end": 473.47,
   "text": "این اولیش اینه که سه تا تلقین داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.47,
   "end": 477.43,
   "text": "سومیشم مال وقتیه که دف شد همه رفتن تو دوباره برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.43,
   "end": 482.93,
   "text": "آدابی داره. من برای هر کسی که نزدیکان و فامیل و هرکی شرکت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.93,
   "end": 486.09,
   "text": "سعی کردیم اینا رو انجام بدیم به فضل الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.09,
   "end": 490.69,
   "text": "که متاسفانه دوستان و نزدیکان ما، ما، ما رو فقط برای این لحظه می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.69,
   "end": 493.31,
   "text": "همه وصیت کردن حاجی این لحظه ما می‌خوایمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.31,
   "end": 495.27,
   "text": "فقط وقت مرگ ما رو می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.27,
   "end": 498.25,
   "text": "دیگه وقتای دیگه ما به دردشون نمی‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.25,
   "end": 505.89,
   "text": "که اونجا این لحظه سه مرحله سوم که می‌رسه دیگه زل می‌زنه یه گوشه می‌بینه ملائکه رو می‌فهمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.89,
   "end": 508.73,
   "text": "متوجه میشی که این دیگه رفتنیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.73,
   "end": 512.21,
   "text": "اونجا شروع کنی تلقین، همون تلقین‌ها همونی که توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.21,
   "end": 514.59,
   "text": "قبر میذارن می‌خونی همون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.59,
   "end": 517.15,
   "text": "براش اون ریخ، شروع می‌کنی خوندن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 517.15,
   "end": 521.13,
   "text": "حالا اینجا مش، مشخص میشه که طرف چیکاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.13,
   "end": 524.15,
   "text": "همین جا. از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.15,
   "end": 531.25,
   "text": "یعنی خودش متوجه میشه. اگرچه عجیبه طبق آیه قرآن چون مرحله طلا، طراقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.25,
   "end": 535.19,
   "text": "یادتون باشه جلسه پیش آیات سوره قیامت رو خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.19,
   "end": 538.15,
   "text": "\"کلا اذا بلغت التراقی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.15,
   "end": 541.73,
   "text": "وقتی روح میاد تا این طراقی بعد می‌خواد بکشه بالا تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 541.73,
   "end": 546.27,
   "text": "حلق، اون مرحله چهارم \"اذا بلغت الحلقوم\" مال مرحله چهارمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.27,
   "end": 549.87,
   "text": "هنوز به حلق نرسیده. این یه تیکه که رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.87,
   "end": 553.33,
   "text": "\"وقیل\" گفته می‌شه که \"مراق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.33,
   "end": 557.77,
   "text": "کیه که اینو نجات بده. حالا این گفته می‌شه، می‌شه هم به مردم زدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.77,
   "end": 559.97,
   "text": "مردم میگن یه دکتر بیارید فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.97,
   "end": 561.95,
   "text": "می‌شه به خودش زد چون هنوز مشکوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.95,
   "end": 566.17,
   "text": "هنوز جالبه که من بررسی و مطالعه کردم در این زمینه مرحله مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.17,
   "end": 569.43,
   "text": "دیدم باز داریم که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.43,
   "end": 574.97,
   "text": "تو این مرحله هم باز مشکوکه دیده ملائکه رو ولی باز نمی‌خواد قبول کنه که می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.97,
   "end": 577.87,
   "text": "عجیبه چون بحث ما تو روایت دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.87,
   "end": 579.93,
   "text": "باب چهارم کتاب الموت‌ه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.93,
   "end": 585.99,
   "text": "تو اون روایت چی می‌گفت؟ می‌فرمود که یقینی‌ترین چیزی که شکی درش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 585.99,
   "end": 588.99,
   "text": "اما مردم باهاش طوری رفتار کردن موت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 588.99,
   "end": 592.63,
   "text": "مثل مشکوک‌ترین چیزی که یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.63,
   "end": 595.73,
   "text": "این حتی تو این مرحله‌ام که ملائکه رو دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 595.73,
   "end": 598.49,
   "text": "نمی‌خواد قبول کنه که آقا رفتنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.49,
   "end": 601.79,
   "text": "هنوز مشکوکه. چی باعث می‌شه شک کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.79,
   "end": 605.61,
   "text": "ضعف باورهاش. دو مهم‌تر از این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 605.61,
   "end": 610.73,
   "text": "اون شیاطینی که میان در کنار ملائکه شیا، شیاطین هم \"یحومون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 610.73,
   "end": 613.13,
   "text": "میان حولش حمله بر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 613.13,
   "end": 615.71,
   "text": "همین تازه اون شیطان اصلی نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 615.71,
   "end": 618.53,
   "text": "اون آخر کار، مرحله آخر اون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 618.53,
   "end": 621.95,
   "text": "که دیگه کار رو تموم کنه که می‌رسیم مرحله آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.95,
   "end": 625.35,
   "text": "اینجا نه اونم بالاخره خدمه داره، صدنه داره میان کن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 625.35,
   "end": 627.27,
   "text": "که بعد می‌فرماید \"و ظن\". دوباره اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 627.27,
   "end": 631.77,
   "text": "اینجا دو تا تعبیر من دیدم. مثلا، مثلا آقای قرائتی تو تفسیرش می‌گه \"و ظن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 631.77,
   "end": 634.71,
   "text": "آیه بعدش \"و ظن\" ظنه، گمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 634.71,
   "end": 639.75,
   "text": "\"ان نه الفراق\". گمان می‌کنه آقای قرائتی اینو به یقین گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 639.75,
   "end": 645.69,
   "text": "چون مرحله‌ای که ملائکه رو میده، می‌بینه می‌گه نه دیگه متوجه می‌شه واقعاً یقین می‌کنه که داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 645.69,
   "end": 649.59,
   "text": "اما بر اساس تحقیقی که بنده از عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 649.59,
   "end": 651.89,
   "text": "این مردوده این نظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 651.89,
   "end": 657.27,
   "text": "بسیاری از مفسرین میگن نه تو این مرحله هم اصلاً \"و ظن\" خودش صریحاً داره میگه \"و ظن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 657.27,
   "end": 660.03,
   "text": "ظن می‌کنه یقین نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 660.03,
   "end": 665.39,
   "text": "ظن گمان می‌کنه که \"ان نه الفراق\" مثل اینکه دارم میرم اما هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 665.39,
   "end": 670.45,
   "text": "باورش نشده که بعد می‌فرماید \"والتفت الساق بالساق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 670.45,
   "end": 675.41,
   "text": "این می‌چسبه ساق، التفات می‌کنن به هم، پاهاش به هم می‌چسبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 675.41,
   "end": 677.13,
   "text": "دیگه تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.13,
   "end": 679.99,
   "text": "چشمش زل می‌زنه یه گوشه تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 679.99,
   "end": 682.99,
   "text": "دیگه تموم شد این لحظه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.99,
   "end": 687.11,
   "text": "چون هنوز روح از حلقش نکشیده بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 687.11,
   "end": 689.65,
   "text": "هنوز می‌بینه، می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 689.65,
   "end": 693.07,
   "text": "و اگر خدا بهش اذن بده حتی می‌تونه تکلم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.07,
   "end": 699.19,
   "text": "چون روح به گلو رسیده، به زیر گلو رسیده، از گلو رد نشده لذا می‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 699.19,
   "end": 704.37,
   "text": "یعنی می‌تونه به دیگران بگه. بعضیا میگن \"تکوتک از اوهدی اولیاء الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 704.37,
   "end": 709.43,
   "text": "ولی دیگه از ترس دو قبضه گرفته‌ش لال شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 709.43,
   "end": 714.01,
   "text": "این یکی از جاهایی که میگن زبون لال نشه اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 714.01,
   "end": 715.97,
   "text": "این نشون میده که هنوز روح به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 715.97,
   "end": 718.19,
   "text": "از زبانش خارج نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 718.19,
   "end": 721.35,
   "text": "یا حالا روح رفته ولی هنوز قطعی نشده که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 721.35,
   "end": 726.73,
   "text": "خدا رحمت کنه حضرت آیت الله خزعلی رو این خاطره ما هم از ایشون بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 726.73,
   "end": 728.63,
   "text": "بحثو جمع کنیم. روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 728.63,
   "end": 730.63,
   "text": "ما اصفهان که درس می‌خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 730.63,
   "end": 733.91,
   "text": "ایشون خب حافظ کل قرآن بود، نهج البلاغه بود اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 733.91,
   "end": 739.61,
   "text": "جلسات خصوصی داشت ایشون یه جایی یه چند تا ما طلبه‌ها و دانشجوها اینا می‌رفتیم پیشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 739.61,
   "end": 744.01,
   "text": "حرفای عجیبی می‌زد. یکی از اون حرفای اون روز ایشون یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 744.01,
   "end": 746.83,
   "text": "ایشون یه خاطره‌ای نقل می‌کرد از شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 746.83,
   "end": 749.85,
   "text": "هاشم قلعه‌ای قزوینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 749.85,
   "end": 753.29,
   "text": "که در عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 753.29,
   "end": 756.63,
   "text": "مشهد از علمای مشهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 756.63,
   "end": 761.33,
   "text": "ایشون شیخ هاشم می‌گفت از یکی از اولیاء خدا نقل می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.33,
   "end": 768.49,
   "text": "یعنی دو تا واسطه خورد که ایشون به جایی رسیده بود که می‌تونست خلع الروح بکنه از بدنش روح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 768.49,
   "end": 771.31,
   "text": "خلع کنه. یعنی روح مثل الان میت که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 771.31,
   "end": 775.57,
   "text": "روح از بخشی از بدنش خارج شده ولی هنوز می‌بینه حرف می‌زنه می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.57,
   "end": 778.65,
   "text": "به این شکل. اونم اینجوریه یعنی کامل موت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 778.65,
   "end": 781.55,
   "text": "یکی از وجه‌ها و رشحه های همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 781.55,
   "end": 786.23,
   "text": "همین مرحله‌ست. روح از بدنش خارج می‌کنه ولی بدن هنوز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 786.23,
   "end": 788.61,
   "text": "ایشون میره و حالا مفصله میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 788.61,
   "end": 792.45,
   "text": "سمت قلعه روحش به سرعت متوجه قلعه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 792.45,
   "end": 795.51,
   "text": "قزوین میشه. می‌بینه اونجا که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 795.51,
   "end": 802.23,
   "text": "چیز می‌زدن کشاورزی آب و اینا و هنوزم هست آب‌ها مخصوص یه ساعاتی ما رو کرت بندی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 802.23,
   "end": 807.17,
   "text": "اون کسی که یکی میاد آب دزدی می‌کنه راه آب رو می‌بره به سمت زمین خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 807.17,
   "end": 813.31,
   "text": "صاحب آب میاد میگه آقا نوبت من بوده تو چرا دعواشون میشه با بیل می‌زنه تو کله اون یارو می‌کشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 813.31,
   "end": 816.23,
   "text": "اون کسی که داشت آب دزدی می‌کرد رو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 816.23,
   "end": 818.81,
   "text": "بعد فرار می‌کنه. ایشون اینو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 818.81,
   "end": 821.43,
   "text": "بعد دو ماه از قزوین که میان پیشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 821.43,
   "end": 823.61,
   "text": "بهشون میگه مردم از فلانی چه خبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 823.61,
   "end": 828.99,
   "text": "اون که مرده بوده. میگن آقا مرد دو ماه پیش مرد یقین می‌کنه که درست دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 828.99,
   "end": 831.31,
   "text": "بعد هفت سال بعد برمی‌گرده میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 831.31,
   "end": 835.05,
   "text": "قزوین از مشهد مردم میان دیدن این ولی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 835.05,
   "end": 837.49,
   "text": "بعد اون هم میان دیدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 837.49,
   "end": 841.99,
   "text": "اون کسی که صاحب آب که زده بود با بیل اینو کشته بود هم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 841.99,
   "end": 845.97,
   "text": "میاد پیش ایشون و احوالپرسی فلان بهش میگه فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 845.97,
   "end": 848.05,
   "text": "اون آقاهه چه خبر؟ میگه مرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 848.05,
   "end": 851.23,
   "text": "آها مرد. حالا میخوای بهت بگم چجوری کشتیش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 851.23,
   "end": 854.69,
   "text": "اون شب تو دل شب تو با بیل زدی تو کله‌ش مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 854.69,
   "end": 857.95,
   "text": "این یهو رنگش می‌پره که این از کجا می‌فهمه، می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 857.95,
   "end": 859.85,
   "text": "بعد بهش میگه برو از وارثاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 859.85,
   "end": 862.19,
   "text": "حلالیت بطلب. این یک مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 862.19,
   "end": 867.03,
   "text": "یعنی همین موتو عن قبلا تا موتو حتی تا این مرحله هم من و شما می‌تونیم پیش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 867.03,
   "end": 870.51,
   "text": "اما چون پیش نرفته این جمله آخر رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 870.51,
   "end": 875.13,
   "text": "چون پیش نرفته، ندیده، تجربه نکرده الان یهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 875.13,
   "end": 877.83,
   "text": "چشمش تیز میشه لال میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 877.83,
   "end": 879.47,
   "text": "اگرچه هنوز می‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 879.47,
   "end": 884.67,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 884.67,
   "end": 888.33,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 888.33,
   "end": 892.11,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}