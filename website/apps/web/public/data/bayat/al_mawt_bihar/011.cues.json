 "chapters": [
  {
   "index": 0,
   "title": "## روایت چهارم کتاب الموت؛ طبیعیات خوردن با آتش",
   "start": 4.2,
   "end": 139.1
  },
  {
   "index": 1,
   "title": "## درون‌مایهٔ روایات؛ حرارت شهادت و حرارت مدیریت",
   "start": 139.1,
   "end": 232.54
  },
  {
   "index": 2,
   "title": "## یبصر ویعمل بالنور؛ دیدن و سپس عمل",
   "start": 232.54,
   "end": 277.36
  },
  {
   "index": 3,
   "title": "## ویسمع ویشم بالریح؛ باد قهر و شنیدن",
   "start": 277.36,
   "end": 347.26
  },
  {
   "index": 4,
   "title": "## خروج از یک رکن؛ محبت در جمع و اداره",
   "start": 347.26,
   "end": 669.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 4.2,
   "text": "مبانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 6.9,
   "text": "اجازه بفرمایید که بخش اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.9,
   "end": 11.04,
   "text": "روایت چهارم رو از کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.04,
   "end": 13.76,
   "text": "دو سه نکته پیرامون طبیعیاتش عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.76,
   "end": 15.64,
   "text": "حیفه همینطوری ازش رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.64,
   "end": 21.14,
   "text": "بعد قسمت تبیین مرگش رو ان‌شاءالله موت‌ش رو برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.14,
   "end": 27.04,
   "text": "این قسمت اولش که می‌فرماید \"یأکل ويشرب بالنار ويشرب بالنار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.04,
   "end": 30.38,
   "text": "چه جالب که می‌فرماید می‌خورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.38,
   "end": 33.46,
   "text": "می‌آشامد با آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.46,
   "end": 35.44,
   "text": "انسان با حرارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.44,
   "end": 39.48,
   "text": "زنده است و اون غذایی که ما می‌خوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.48,
   "end": 44.68,
   "text": "در حقیقت معده رو اگر به منزله یک دیگی فرض کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.68,
   "end": 52.16,
   "text": "غذا و آب در دیگ معده همونطور که ما غذا رو در دیگ می‌پزیم با حرارت و آتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.16,
   "end": 55.1,
   "text": "غذا و آب هم در دیگ معده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.1,
   "end": 57.32,
   "text": "پخته میشه با آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.32,
   "end": 62.98,
   "text": "که اگر این گرما نبود در معده و در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.98,
   "end": 67.94,
   "text": "سیستم گوارشی، غذا ناپخته می‌موند و انسان می‌مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.94,
   "end": 70.5,
   "text": "غذا هیچ‌وقت هضم نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.5,
   "end": 77.42,
   "text": "هیچ‌وقت در سیستم بدن چرخه، اون چرخشی که در عروق حتی وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.42,
   "end": 79.22,
   "text": "در نتیجه این حرارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.22,
   "end": 81.5,
   "text": "یعنی حرارت باعث میشه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.5,
   "end": 83.22,
   "text": "معده چقدر پرکاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.22,
   "end": 87.16,
   "text": "یکی از جاهای بسیار پرکار بدن هم معده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.16,
   "end": 88.88,
   "text": "و این مقداری هم باید بهش استراحت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.88,
   "end": 90.8,
   "text": "بیچاره دائم مشغول کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.8,
   "end": 93.9,
   "text": "حالا قلب به یک معنا، این یک طور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.9,
   "end": 99.02,
   "text": "چقدر عجیبه که روایت هم داریم که همه دردها از معده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.02,
   "end": 103.56,
   "text": "از معده پر. معده که پر میشه دردها شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.56,
   "end": 105.4,
   "text": "بخار غذا می‌زنه به مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.4,
   "end": 109.86,
   "text": "مغز از کار می‌افته. مغز که از کار افتاد آدم کارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.86,
   "end": 111.98,
   "text": "کم عقلی می‌کنه. کارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.98,
   "end": 114.58,
   "text": "بد و این‌ها انجام میده بدون پایه و اساس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 114.58,
   "end": 116.28,
   "text": "خیلی معده جای حساسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 116.28,
   "end": 120.06,
   "text": "دائماً مثل سنگ آسیاب در حال کوبشه، می‌کوبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 120.06,
   "end": 125.36,
   "text": "انقباض داره، انبساط داره، گرمای زیاد، اسیدهای مختلف تولید می‌کنه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 125.36,
   "end": 128.68,
   "text": "یه غذایی دادیم بهش بیچاره دائم اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 128.68,
   "end": 133.74,
   "text": "هی مثل سنگ آسیاب بکوبه و بسوزانه و بپزه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 133.74,
   "end": 139.1,
   "text": "بده به سیستم حالا عروق و این‌ها برسونه به عنوان غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.1,
   "end": 148.48,
   "text": "این حرارت حالا عرض شود که همونطور که روایات در آیات ما، آیات قرآن هر حرفش هفتاد هزار معنا داره، اهل بیت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.48,
   "end": 151.14,
   "text": "روایاتشون اینطوری هست دیگه قبلاً این‌ها رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.14,
   "end": 158.98,
   "text": "مثلاً ببینید به عنوان نمونه اگر در سیست- در طبیعت بدن ما حرارت و آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.98,
   "end": 164.34,
   "text": "اینجا امام صادق علیه السلام می‌فرماید موجب پختگی غذاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.34,
   "end": 172.46,
   "text": "در مثلاً ما ه- حدیث داریم که از شهادت امام حسین علیه السلام یک حرارتی در قلوب مؤمنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.46,
   "end": 174.62,
   "text": "که تا قیامت این خاموش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.62,
   "end": 178.32,
   "text": "این حرارتی که اینجا باز یاد شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.32,
   "end": 180.24,
   "text": "ارتباط دارن این‌ها قطعاً با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.24,
   "end": 185.22,
   "text": "حرارتی که از عشق امام حسین در وجود ماست باعث پختگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.22,
   "end": 192.18,
   "text": "اعمال انسانه یا باعث پختگی خود انسانه که اون حرارت رو بگیری انسان کاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.18,
   "end": 196.9,
   "text": "یا حتی در سیستم مدیریتی، معلم و شاگردی، پدر فرزندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.9,
   "end": 200.38,
   "text": "شما این حرارت محبت و عشق رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.38,
   "end": 204.88,
   "text": "هر کجا بین مدیر، بین مسئول و زیردستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.88,
   "end": 207.24,
   "text": "این حرارت و محبت رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.24,
   "end": 210.16,
   "text": "یک سیستم اداری خشک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.16,
   "end": 216.52,
   "text": "نگاه بالا به پایین، مطلقا این سیستم اعمال پخته‌ای ازش سر نزده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.52,
   "end": 218.98,
   "text": "چه از بالا چه از پایین درگیر میشن با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.98,
   "end": 223.82,
   "text": "ببینید حالا من چند تا مثال زدم ذهنتون باز بشه اجتهاد کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.82,
   "end": 228.02,
   "text": "بر اساس مبانی ببینید چقدر یک گفته اهل بیت درون مایه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.02,
   "end": 232.26,
   "text": "بگذریم حالا اینطوری بخوایم صبر کنیم تو همین جاش موندیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.26,
   "end": 236.4,
   "text": "حالا بعد فرمود \"يبصر ويبصر ويعمل بالنور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.4,
   "end": 240.78,
   "text": "چه جالب بنور عمل می‌کنه، می‌بینه و عمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.78,
   "end": 244.76,
   "text": "خب ما اگر نور نباشه که هیچی نمی‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.76,
   "end": 248.0,
   "text": "و اگر چیزی نبینیم حرکت نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.0,
   "end": 251.28,
   "text": "اینکه لذا اول می‌فرماید \"يبصر\" بعد \"يعمل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.28,
   "end": 253.98,
   "text": "عمل در پس دیدنه. حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.98,
   "end": 259.1,
   "text": "\"يبصر\" می‌تونه بحث مال- مادیش باشه \"يعمل\" بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.1,
   "end": 266.32,
   "text": "معنویش. یعنی تو بالاخره داری کار می‌کنی بر اساس یک دیدنی‌ست، یک بینشی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.32,
   "end": 271.9,
   "text": "یک چیزی رو فهمیدی، دیدی، چشیدی، بهش رسیدی داری عمل می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.9,
   "end": 275.38,
   "text": "یعنی در حقیقت اون نور رو که سبب دیدنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.38,
   "end": 279.32,
   "text": "اونو اگر بگیری انسان از حرکت وامیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.32,
   "end": 282.94,
   "text": "اصلاً حرکتی-- اصلاً جایی رو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.94,
   "end": 287.9,
   "text": "لذا خیلی جالبه که میگه، می‌فرماید حالا ظاهرش برمی‌گرده به چشم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.9,
   "end": 291.4,
   "text": "میگه \"ويبصر ويعمل بالنور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.4,
   "end": 293.44,
   "text": "می‌بیند و عمل می‌کند با نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.44,
   "end": 295.12,
   "text": "اما باواطنش غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.12,
   "end": 299.14,
   "text": "حالا قرآن که می‌فرماید \"الله نور السماوات والأرض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.14,
   "end": 302.74,
   "text": "اون نوری که شما منظور نظرتونه اصلاً الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.74,
   "end": 307.76,
   "text": "که اسم جامعه اینطوری بخواهیم بگیم که دیگه خیلی غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.76,
   "end": 311.3,
   "text": "یعنی اصلاً اون چیزی که شما دارید باهاش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.3,
   "end": 314.62,
   "text": "چجوری بگیم؟ اون حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.62,
   "end": 319.5,
   "text": "مردمک چشم که داری باهاش می‌بینی که انسان کامل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.5,
   "end": 323.46,
   "text": "اون مردمک چشم انسان العين عالم هستی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.46,
   "end": 326.22,
   "text": "اون خود اسم، اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.22,
   "end": 331.66,
   "text": "جامع الله که با نورش داری همه جا رو می‌بینی و حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.66,
   "end": 334.68,
   "text": "ولا حول ولا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.68,
   "end": 337.68,
   "text": "از اینم بگذریم \"ويسمع ويشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.68,
   "end": 342.12,
   "text": "بالريح\". چه عجیب که اینجا فرموده \"بالريح\" نه \"بالرياح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.12,
   "end": 347.98,
   "text": "اینا حالا درش نکته‌ای هست. می‌فرماید می- می‌شنود و می‌بوید با باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.98,
   "end": 351.22,
   "text": "اگر این باد رو نسیم رو شما بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.22,
   "end": 357.32,
   "text": "در خصوص بوییدن خب اگر نسیمی نباشه هر کجا بو باشه اون بو همونجا می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.32,
   "end": 360.12,
   "text": "اصلاً منتقل نمی‌شه که کسی ببویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.12,
   "end": 362.28,
   "text": "در خصوص شنیدن هم این‌چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.28,
   "end": 365.63,
   "text": "اگر خلا ایجاد بشه و نسیم و بادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.63,
   "end": 370.69,
   "text": "حرکت نده این صدا رو یعنی طول موج صدا حرکت نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.69,
   "end": 373.25,
   "text": "دیگه شنیدنی بین من و شما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.25,
   "end": 379.97,
   "text": "این هوا حرکت تردد نکنه و خلع باشه نه شما صدای منو میشنوین و نه من شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.97,
   "end": 382.47,
   "text": "ببین چقدر بحث زیبا و علمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.47,
   "end": 385.03,
   "text": "حالا این می‌فرمود که به چی؟ به ریح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.03,
   "end": 390.31,
   "text": "شما اگر قرآن رو بررسی کنید مخصوصاً در تفسیر نور آقای قرائتی به این نکته توجه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.31,
   "end": 392.69,
   "text": "که هر کجا که قرآن بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.69,
   "end": 396.47,
   "text": "قهر و عقاب رو میاره از ریح استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.47,
   "end": 401.93,
   "text": "جاهایی که بحث لطف و رحمت و این‌هاست مثل باران، باران که لطیف و رحمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.93,
   "end": 405.49,
   "text": "میگه ریاح. اینجا از ریح استفاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.49,
   "end": 408.43,
   "text": "چرا؟ میشه اینطوری برداشت کرد که شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.43,
   "end": 412.55,
   "text": "غالب شنیده‌ها و بوییدن‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.55,
   "end": 414.19,
   "text": "سبب قهر الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.19,
   "end": 416.43,
   "text": "شنیدن‌ها، شنیدن‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.43,
   "end": 419.57,
   "text": "ما دل-- گوشمون رو به هر چیزی نباید بسپاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.57,
   "end": 424.45,
   "text": "هر چیزی رو نباید ببوییم. لذا اینجا می‌فرماید \"و یسمع و یشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.45,
   "end": 426.77,
   "text": "برریح\" یعنی با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.77,
   "end": 429.33,
   "text": "خب روایات با آیات تطبیق دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.33,
   "end": 431.85,
   "text": "اگر آیات همیشه از ریح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.85,
   "end": 434.35,
   "text": "به باد سرسر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.35,
   "end": 436.85,
   "text": "قهر الهی یاد می‌کنه، اینجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.85,
   "end": 438.69,
   "text": "یه نشانه از قهر حتما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.69,
   "end": 443.05,
   "text": "میگه حواست باشه که حالا از وجه ظاهریش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.05,
   "end": 445.87,
   "text": "این باد هست که تو می‌شنوی و می‌بویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.87,
   "end": 448.37,
   "text": "اما حواست باشه که این قهر الهی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.37,
   "end": 451.25,
   "text": "هر چیزی رو نشنوی، هر چیزی رو نبویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 451.25,
   "end": 456.35,
   "text": "\"و یجد الطعام و شراب و شراب بالماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 456.35,
   "end": 462.27,
   "text": "چه خوش و شیرین که اون وجدان و یافتن طعام و شراب با آبه با، به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.27,
   "end": 468.09,
   "text": "آب. حالا اگر این آب رو بگیری، شما اگر بزاق دهانت ترشح نشه این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.09,
   "end": 471.65,
   "text": "چجوری میخوای غذا بخوری؟ غذای خشک خفت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.65,
   "end": 474.53,
   "text": "اصلاً تو خود دهان یه مقدار هضم ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.53,
   "end": 481.33,
   "text": "بعد حالا وقتی میره تو معده، اون ترشحات معده، اون آبی که در معده است، اسیدها اینها چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.33,
   "end": 483.25,
   "text": "هضم غذا رو بسیار تسریع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.25,
   "end": 487.73,
   "text": "حالا شما این آبو بگیر از چشمت آبو بگیر کور میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.73,
   "end": 491.45,
   "text": "از دهانت از معدت آبو بگیر خفه میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.45,
   "end": 493.77,
   "text": "از عروقت آبو بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.77,
   "end": 496.05,
   "text": "خشک میشی. اصلاً چیزی دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.05,
   "end": 499.49,
   "text": "حالا این وجه ظاهری‌ش. می‌تونی اینو بزنی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 499.49,
   "end": 505.01,
   "text": "وجه باطنی‌ش که ما گاهی اوقات به ولایت اومده، گاهی اوقات به علم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.01,
   "end": 507.27,
   "text": "تعبیری که شده اهل بیت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.27,
   "end": 513.89,
   "text": "یعنی اونچه که اون طعامی که ما می‌خوریم و اون شرابی که می‌نوشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.89,
   "end": 519.65,
   "text": "این به ولایته. یعنی اگر به ولا-- اگر ولایت رو بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 519.65,
   "end": 522.27,
   "text": "خفه میشی، خشک میشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 522.27,
   "end": 524.35,
   "text": "کور میشی. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.35,
   "end": 529.99,
   "text": "اگه آب ولایت رو یا علم رو شما هرچی می‌خوری بر اساس بینش و آگاهی باید بخوری دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 529.99,
   "end": 533.05,
   "text": "\"فلينظر الإنسان إلى طعامه\" قرآن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.05,
   "end": 534.79,
   "text": "نگاه کن این نگاه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.79,
   "end": 537.17,
   "text": "همون بینشه، علمه که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.17,
   "end": 539.63,
   "text": "که ما میشه. حالا من گفتم وجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.63,
   "end": 543.37,
   "text": "حتی مزه غذا رو اگر آب نباشه چجوری میخوای بچشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.37,
   "end": 546.77,
   "text": "مزه دین رو اگر ولایت نباشه چجوری میخوای بچشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.77,
   "end": 549.35,
   "text": "اصلاً طعم دین به ولایتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 549.35,
   "end": 554.03,
   "text": "حالا من هی نکته نکته میگم روش خیلی پافشاری نمی‌کنم خودتون اجتهاد کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.03,
   "end": 557.51,
   "text": "و قسمت آخرش می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 557.51,
   "end": 562.25,
   "text": "و عرض شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 562.25,
   "end": 563.89,
   "text": "حرارت رو هم که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.89,
   "end": 566.35,
   "text": "حالا اینجا خروج از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.35,
   "end": 569.17,
   "text": "خروج از این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 569.17,
   "end": 574.33,
   "text": "اگر کسی یه دونه از این‌ها هم خارج بشه این نکته رو بگم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 574.33,
   "end": 577.99,
   "text": "یه دونه از این‌ها رو هم خارج بشه کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 577.99,
   "end": 583.71,
   "text": "یعنی این نیست که اگه همشو بگیری یه کسی نه آب، نه مثلا نور بصر، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.71,
   "end": 586.95,
   "text": "عرض شود حرارت، اینها، نه باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 586.95,
   "end": 589.61,
   "text": "یکیشو بگیری، یکیشو بگیری کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.61,
   "end": 595.27,
   "text": "یعنی زندگی مختل میشه. توی این حوزه حالا برو تو بحث‌های معنوی‌ش هم دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 595.27,
   "end": 598.91,
   "text": "یعنی یک ویروس می‌تونه انسان رو از کار دربیاره، از کار بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.91,
   "end": 605.89,
   "text": "درسته؟ تو بحث معنوی‌ش هم شما یه دونه‌شو بگیر یعنی یه لطف خدا رو بگیر که در قالب نسیم رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.89,
   "end": 608.01,
   "text": "تمامه. یه ولایتو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 608.01,
   "end": 612.15,
   "text": "تمامه. یه حالا آب رو بگیر به علم، علم رو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.15,
   "end": 615.65,
   "text": "تمامه. حرارت عشق و محبت رو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 615.65,
   "end": 620.35,
   "text": "تمامه. الان اینجا شما گرد هم نشستید اگر محبت نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 620.35,
   "end": 627.63,
   "text": "اگر حرارت عشق نبود، به هم محبت نداشتید، همدیگه رو تو همین چند دقیقه که اینجا نشستید تحمل نمی‌کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 627.63,
   "end": 629.65,
   "text": "اصلاً این تجمع رخ نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.65,
   "end": 637.49,
   "text": "اگر همکار با همکار محبت نداشته باشه، مخصوصاً مدیر به زیردست، دستش محبت نداشته باشه، اون اداره فشله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.49,
   "end": 642.49,
   "text": "یکی از دلایل متاسفانه خشکی نظام بوروکراسی و اداری ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.49,
   "end": 647.81,
   "text": "این متاسفانه غلط بودن چرخه ارتباط مدیران با زیردستانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.81,
   "end": 650.17,
   "text": "خیلی اداری و دیسیپلین خشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.17,
   "end": 652.31,
   "text": "حالا اصلاً درک نمی‌کنه زیردستشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.31,
   "end": 656.07,
   "text": "\"آقا شما چرا چند وقته مشکل داری دیر میای سر کار فلان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.07,
   "end": 658.41,
   "text": "مشکلت چیه؟\" نه سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 658.41,
   "end": 662.15,
   "text": "حقوقش رو کم کنه، اخراجش کنه اینها بوی خوبی نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.15,
   "end": 665.37,
   "text": "اینا از ناحیه ما که ولایتی هستیم خیلی زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 665.37,
   "end": 669.09,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.09,
   "end": 669.67,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}