 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایت ششم باب دوم؛ أکل البطیخة و جذام",
   "start": 9.9,
   "end": 115.38
  },
  {
   "index": 1,
   "title": "## مؤمن و امان از بیماری‌های خباثت‌آلود",
   "start": 115.38,
   "end": 143.32
  },
  {
   "index": 2,
   "title": "## خوردنی‌ها، مزاج و جمع روایات",
   "start": 143.32,
   "end": 304.3
  },
  {
   "index": 3,
   "title": "## خواص خربزه در روایات نبوی",
   "start": 304.3,
   "end": 324.4
  },
  {
   "index": 4,
   "title": "## خروج مزاج از اعتدال و أرذل العمر",
   "start": 324.4,
   "end": 407.61
  },
  {
   "index": 5,
   "title": "## دست پر؛ کراهت طلب موت",
   "start": 407.61,
   "end": 720.99
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 6.84,
   "text": "به نستعین. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.84,
   "end": 9.9,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.9,
   "end": 12.74,
   "text": "نکته‌ای رو پیرامون روایت ششم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.74,
   "end": 15.68,
   "text": "از باب دوم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.68,
   "end": 27.4,
   "text": "عرض کنیم. روایت اینه که البته مرحوم مجلسی این روایت رو از تهفل الغوغل آورده و فرموده عن ابالحسن الثالث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.4,
   "end": 33.18,
   "text": "ابالحسن سوم اگر مطلقاً بگن ابالحسن منظور امیرالمؤمنین سلام الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.18,
   "end": 37.06,
   "text": "اگر بگن ابالحسن اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.06,
   "end": 41.04,
   "text": "امام کاظم، ابالحسن دوم امام رضا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.04,
   "end": 42.68,
   "text": "سوم امام هادیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.68,
   "end": 45.84,
   "text": "اینو بدونیم. حالا اینجا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.84,
   "end": 50.1,
   "text": "ابالحسن الثالث یعنی امام هادی فرموده این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.1,
   "end": 57.22,
   "text": "که انه قال يوما إن أكل البطيخة يورث الجذام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.22,
   "end": 60.48,
   "text": "که بطيخ یعنی خربزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.48,
   "end": 64.56,
   "text": "ایشون می‌فرماید که اگر کسی خربزه بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.56,
   "end": 67.3,
   "text": "جذام می‌گیره. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.3,
   "end": 70.84,
   "text": "ظاهر روایت اینا داره عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.84,
   "end": 75.34,
   "text": "ادامه‌ش. فقيل یکی گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.34,
   "end": 78.98,
   "text": "فقيل له أليس قد أمن المؤمن إذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.98,
   "end": 82.42,
   "text": "أتى عليه أربعون سنةً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.42,
   "end": 86.5,
   "text": "مگر اینطور نیست که وقتی یه مؤمن چهل سالش شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.5,
   "end": 90.82,
   "text": "من الجنون، من الجنون والجذام والبرص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.82,
   "end": 93.68,
   "text": "از این سه تا مریضی در امانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.68,
   "end": 96.02,
   "text": "جنون و جذام و برص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.02,
   "end": 98.22,
   "text": "حالا نکاتی درش هست عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.22,
   "end": 100.8,
   "text": "قال حضرت فرمود نه بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.8,
   "end": 105.2,
   "text": "ولكن إذا خالف المؤمن عقوبه الخلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.2,
   "end": 113.0,
   "text": "اگر مؤمن خلافی رو مرتکب بشه همون جاهایی که گمان می‌کنه که مثلاً در امانه اتفاقاً همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.0,
   "end": 116.44,
   "text": "بر علیهش می‌شه. چند تا نکته عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.44,
   "end": 119.36,
   "text": "اولاً این روایت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.36,
   "end": 123.54,
   "text": "می‌فرماید که مؤمن، اصلاً مؤمن از بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.54,
   "end": 130.44,
   "text": "مریضی‌ها که به یک معنا خباثتهای روح حساب می‌شن این‌ها در امانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.44,
   "end": 135.06,
   "text": "مؤمن. از خیلی از مریضی‌ها در امانه مگر اینکه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.06,
   "end": 138.6,
   "text": "بره به اون سمت و خودش این بلا رو سر خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.6,
   "end": 141.16,
   "text": "بیاره. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.16,
   "end": 143.32,
   "text": "خداوند متعال این چنین قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.32,
   "end": 146.44,
   "text": "نکته دوم اینکه شاید معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.44,
   "end": 149.36,
   "text": "این چهل واقعاً چهل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.36,
   "end": 153.02,
   "text": "یعنی اِ-- عدد کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.02,
   "end": 157.04,
   "text": "از این حیث باشه که یعنی مؤمن وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.04,
   "end": 161.78,
   "text": "به یک سن مثلاً زیادی رسید دیگه یه سری بلاها ازش دفع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.78,
   "end": 165.66,
   "text": "حالا خدا رحم می‌کنه به-- یه سری مریضی‌ها دیگه سرش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.66,
   "end": 171.46,
   "text": "مریضی‌های دیگه میاد. مثلاً ارزال العمر میاد به ش-- به یک شکل دیگه که بحثش رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.46,
   "end": 179.58,
   "text": "می‌تونه یک معنای دیگه‌ای بده اونم عدد چهل رو اینجا اگر بحث کامل بودن بگیریم یعنی مؤمن کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.58,
   "end": 183.9,
   "text": "یعنی کسی که واقعاً مؤمن واقعیه از این حیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.9,
   "end": 188.52,
   "text": "چون به چهل سال که می‌رسه دیگه مؤمن عقلش کامل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.52,
   "end": 194.1,
   "text": "شاید منظور مؤمنیه که دیگه عقلش کامل شده یعنی گناهی ازش سر نمی‌زنه این‌ها بله این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.1,
   "end": 196.94,
   "text": "قبیل بلاها و مریضی‌ها ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.94,
   "end": 200.82,
   "text": "دفع می‌شه. نکته‌ی دیگری که در این روایت وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.82,
   "end": 204.72,
   "text": "ارتباط خوردنی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.72,
   "end": 209.64,
   "text": "با مریضی‌ها یا ارتباط به یک معنا با خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.64,
   "end": 216.72,
   "text": "در سیر بحث بخواهیم صحبت کنیم مرتبط با سیر بحث، ارتباط خوردنی‌ها با مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.72,
   "end": 223.44,
   "text": "می‌تونه خربزه خوردنش مزاج رو به هم بریزه و بر اثر به هم ریختن مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.44,
   "end": 228.98,
   "text": "این اتفاق حالا مثلاً جذام اینجا حضرت فرموده رخ بده یا یه جای دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.98,
   "end": 234.04,
   "text": "پیغمبر عزیز عالم در خصوص خربزه فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.04,
   "end": 236.34,
   "text": "اگر کسی خربزه بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.34,
   "end": 239.5,
   "text": "ولی ناشتا باشه فلج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.5,
   "end": 244.38,
   "text": "حالا این کلاً من یه نکته کلی بگم بعد جمع‌بندی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.38,
   "end": 250.88,
   "text": "روایات رو همونطور که علامه طباطبایی فرمودن آیات قرآن رو باید کنار هم دید همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.88,
   "end": 254.3,
   "text": "و الا انسان به اشتباه می‌افته. روایات هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.3,
   "end": 260.66,
   "text": "مثلاً توی این روایت امام هادی فرموده کلاً خربزه خوردن جذام میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.66,
   "end": 266.04,
   "text": "یه جای دیگه پیغمبر فرمودند که خربزه رو ناشتا بخوری جذام می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.04,
   "end": 268.78,
   "text": "یه جای دیگه فرمودند فلج می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.78,
   "end": 275.36,
   "text": "یه جای دیگه فرمودند که گرسنه باشی خربزه بخوری با همراه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.36,
   "end": 278.7,
   "text": "شکر باشه. یعنی اینا همه نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.7,
   "end": 284.5,
   "text": "خب گرسنه بودن خربزه خوردن اشکال نداره اما ناشتا بودن قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.5,
   "end": 286.92,
   "text": "یعنی اول صبح که از خواب پا شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.92,
   "end": 290.16,
   "text": "خربزه نخوری. یعنی این‌ها مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.16,
   "end": 292.6,
   "text": "یه وقت کسی متوجه این‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.6,
   "end": 298.06,
   "text": "یعنی یک کار تحلیلی، یه تحقیقی نکرده تو روایات صرفاً می‌گه خربزه اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.06,
   "end": 304.02,
   "text": "بعد می‌ره می‌گه آقا ما اصلاً روایت داریم که در خصوص خربزه که این میوه از بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.02,
   "end": 311.76,
   "text": "مثلاً یکی دو تا روایت من براتون بخونم ببینید چقدر خود پیغمبر فرمودن ده تا خاصیت و فایده در خربزه شمردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.76,
   "end": 315.5,
   "text": "غذاست. پیغمبر فرمود می‌تونید به عنوان غذا ازش استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.5,
   "end": 318.76,
   "text": "نوشیدنی‌ست یعنی به عنوان آب هم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.76,
   "end": 321.64,
   "text": "فرمودن مثانه رو شستشو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.64,
   "end": 323.5,
   "text": "سردی رو قطع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.5,
   "end": 328.14,
   "text": "گل خوشبو و معطره یعنی وجودت رو خوشبو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.14,
   "end": 331.28,
   "text": "از بهشت ملائکه تو رو خوشبو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.28,
   "end": 333.96,
   "text": "شوینده‌ست، بدن رو شستشو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.96,
   "end": 338.88,
   "text": "شکم رو شستشو میده و غریزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.88,
   "end": 343.24,
   "text": "زیاد می‌کنه. پوست رو لطیف می‌کنه، بدن رو پاک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.24,
   "end": 345.8,
   "text": "این‌ها خصوصاتیه که پیغمبر فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.8,
   "end": 349.18,
   "text": "یه روایت دیگه‌ای هم دیدم. حالا اینا روایات تحقیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.18,
   "end": 355.4,
   "text": "یعنی شما باید کتاب‌ها رو زیاد بخونید تا این‌ها رو دسته‌بندی کنید به این برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.4,
   "end": 360.0,
   "text": "فرمودند که-- پیغمبر فرمودند خربزه از بهشته لذا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.0,
   "end": 363.77,
   "text": "چاقو نبریدش. اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.77,
   "end": 365.81,
   "text": "پاره کنید، بشکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.81,
   "end": 368.51,
   "text": "و با دندان بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.51,
   "end": 371.49,
   "text": "نه اینکه هب هب مثلاً باید چنگال و قاشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.49,
   "end": 373.31,
   "text": "مثلاً چاقو ببرید بذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.31,
   "end": 376.59,
   "text": "همونطور که نون هم نهی شده اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.59,
   "end": 379.83,
   "text": "نون هم نهی شده با چاقو ببریم که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.83,
   "end": 384.77,
   "text": "و مثلاً نونوایی‌ها متاسفانه چاقو گذاشتن هر کی میبره نهی شده شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 384.77,
   "end": 391.97,
   "text": "حالا دلایلی هم وجود داره که هم دلایل علمی پزشکیه و چه جالب که علم امروز هم بهش رسیده به بعضیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.97,
   "end": 396.37,
   "text": "بعضیاشم دلایل اخروی داره که ما نمی‌فهمیم حکمت قصه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.37,
   "end": 403.81,
   "text": "بعد حضرت فرمودن که با چاقو نبرید زیرا میوه‌ای مبارک و خوشمزه و پاک است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.81,
   "end": 406.33,
   "text": "که دهان و قلب را پاک می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.33,
   "end": 408.67,
   "text": "کسانی که مشکلات قلبی دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.67,
   "end": 411.73,
   "text": "یا دن-- دهانشون بد میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.73,
   "end": 415.49,
   "text": "دندان‌ها را سفید می‌کند، خداوند را راضی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.49,
   "end": 418.03,
   "text": "عطر آن نیز عطر عنبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.03,
   "end": 421.13,
   "text": "یعنی مثل پیش ملائکه مثل عنبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.13,
   "end": 423.35,
   "text": "یه همچین بویی از تو بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.35,
   "end": 427.15,
   "text": "اونا ملائکه عاشق بو عنبر و مشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.15,
   "end": 429.19,
   "text": "آب آن هم از آب کوثر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.19,
   "end": 432.41,
   "text": "عجب! گوشت آن از بهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.41,
   "end": 435.91,
   "text": "اینا همه باید تأویل بشه ها. یعنی تک تک همه‌شون بحث ما این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.91,
   "end": 438.99,
   "text": "ولی می‌شه یک یک این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.99,
   "end": 443.93,
   "text": "اجتهاد کرد و تأویل کرد که منظور چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.93,
   "end": 448.49,
   "text": "مزه آن مزه بهشتی‌ست و خوردن آن عبادت محسوب می‌شود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.49,
   "end": 454.33,
   "text": "الی ماشاءالله. وقتی این روایت رو می‌ذاری کنار اون روایت که می‌گه کسی که خربزه بخوره امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.33,
   "end": 457.27,
   "text": "هادی فرمودن جزام می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.27,
   "end": 464.17,
   "text": "این نشون می‌ده که بله همونطور که پیغمبر فرمود ناشتا بخوری جزام می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.17,
   "end": 469.07,
   "text": "و اگر کسی این دستور العمل‌ها رو رعایت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.07,
   "end": 473.49,
   "text": "باعث خروج مزاجش از اعتدال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.49,
   "end": 477.35,
   "text": "خروج مزاج از اعتدال همانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.35,
   "end": 482.85,
   "text": "و به ارزلال العمر رسیدن زودتر همانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.85,
   "end": 487.91,
   "text": "که ما گفتیم که دیگه کمترین سال ارزلال العمر رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.91,
   "end": 490.39,
   "text": "شصت سال شمرده بودن تا صد سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.39,
   "end": 492.69,
   "text": "یعنی کسی که می‌شه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.69,
   "end": 494.87,
   "text": "حالا جمع‌بندی، کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.87,
   "end": 497.63,
   "text": "خورد و خوراکش رو درست رعایت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.63,
   "end": 503.39,
   "text": "به جهت خروج مزاجش از اعتدال زودتر پیر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.39,
   "end": 509.43,
   "text": "و زودتر اون حالت رذل‌ترین حالت عمر از پا افتادگی اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.43,
   "end": 512.19,
   "text": "آلزایمر چه، چه، چه اینا بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.19,
   "end": 515.03,
   "text": "رخ می‌ده. هرچی هست خودت می‌کنی، خودمون می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.03,
   "end": 521.25,
   "text": "لذا اینجا چقدر دستورات بهداشتی و خورد و خوراک در دین مش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.25,
   "end": 523.79,
   "text": "مهم می‌شن. خودش رو نشون می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.79,
   "end": 529.35,
   "text": "که قرآن صراحتاً می‌فرماید فلينظر الإنسان إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.35,
   "end": 534.13,
   "text": "طعامه. آدم به اون طعامی که می‌خوره نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.13,
   "end": 536.67,
   "text": "اگرچه بارها عرض کردیم تأویلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.67,
   "end": 542.65,
   "text": "امام باقر سلام الله علیه و امام صادق سلام الله علیه فرمودن اینجا تأویل اصلیش علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.65,
   "end": 544.37,
   "text": "خوراک جانت علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.37,
   "end": 547.27,
   "text": "نگاه کن علم رو از کجا اخذ می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.27,
   "end": 549.53,
   "text": "ولی از وجه ظاهرش این چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.53,
   "end": 555.13,
   "text": "یعنی چی می‌خوری؟ اون که-- اون چیزی که می‌خوری اتفاقاً به قول شیخ الرئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.13,
   "end": 557.37,
   "text": "خیلی شیرین، خیلی عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.37,
   "end": 560.17,
   "text": "اصلاً غوغا کرده اینجا تو اشاراتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.17,
   "end": 565.29,
   "text": "می‌فرماید یکی از معجزات الهی آنف آن در وجود من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.29,
   "end": 567.59,
   "text": "در تجلی و جلوه است. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.59,
   "end": 570.39,
   "text": "اونچه که می‌خوری جانت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.39,
   "end": 573.15,
   "text": "عجب! یعنی این چیزی که می‌خوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.15,
   "end": 576.37,
   "text": "ظاهراً از نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.37,
   "end": 578.31,
   "text": "درست شد؟ اما یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.31,
   "end": 580.51,
   "text": "ماده‌ست، جان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.51,
   "end": 585.87,
   "text": "ولی اینو تو می‌خوری. در بدن ما این نفس ناطقه ما چه می‌کنه با اون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.87,
   "end": 589.27,
   "text": "چه بلایی سرش میاره که اون می‌شه بدل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.27,
   "end": 594.81,
   "text": "جان انسان می‌شه. یعنی یک کیمیاگری خداوند در وجود ما قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.81,
   "end": 597.25,
   "text": "حالا اگر خدای نکرده حرام بخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.25,
   "end": 599.57,
   "text": "یا نه حلال بخوری اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.57,
   "end": 601.53,
   "text": "مثلاً بسیط بخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.53,
   "end": 607.33,
   "text": "مرکب بخوری، ندونی چیو با چی بخوری، چی رو با چی نخوری، کی بخوری، کی نخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.33,
   "end": 610.23,
   "text": "اینا همه باعث می‌شه که چه اتفاقی بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.23,
   "end": 612.21,
   "text": "یه بلایی سر بدن خودت بیاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.21,
   "end": 615.51,
   "text": "بدن هم که انزل مراتب نفس ناطقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.51,
   "end": 622.47,
   "text": "یعنی باعث می‌شه که نفس ناطقه حضرت عالی به جهت عدم رعایت این بهداشتی جا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.47,
   "end": 630.75,
   "text": "علم بهداشت در دین و در سیر و سلوک و سبک زندگیت زودتر از این عالم فارغ بشه و تشریف ببره به عالم بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.75,
   "end": 633.87,
   "text": "بعد می‌گه خب خیلی خوبه که لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.87,
   "end": 636.07,
   "text": "می‌گیم که عزیزم خب دستت خالی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.07,
   "end": 639.25,
   "text": "مؤمن تا می‌تونه باید اینجا چی‌کار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.25,
   "end": 642.39,
   "text": "پر کنه نامه اولش رو با دست پر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 642.39,
   "end": 644.55,
   "text": "و الا اگر این بود که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 644.55,
   "end": 646.49,
   "text": "کراهت نداشت طلب موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.49,
   "end": 648.73,
   "text": "می‌دونید طلب موت که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.73,
   "end": 651.27,
   "text": "منو بکش، منو راحت کن اینا کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.27,
   "end": 658.19,
   "text": "مگر در شهادت و بعضی اینا که مثلاً حضرت زهرا سلام الله علیها خواستن از خدا اونا قصه‌ش فرق می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 658.19,
   "end": 661.79,
   "text": "اون بحث دیگه‌ای بود. اما در هر حال کراهت نشون می‌ده که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.79,
   "end": 666.29,
   "text": "انسان بمونه کار کنه. این دیداری که رهبر عزیزمون داشتن با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 666.29,
   "end": 669.93,
   "text": "خانواده‌های شهدای شاه چراغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 669.93,
   "end": 673.37,
   "text": "اون برادر شهید که به امام با حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.37,
   "end": 677.33,
   "text": "رهبر گریه کرد، گفتش که درد و دل کرد، دلگوئیه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.33,
   "end": 679.45,
   "text": "گفت آقا برادرم شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.45,
   "end": 682.15,
   "text": "آرزو-- دعا کنید ما هم به آرزومون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.15,
   "end": 685.63,
   "text": "ما هم شهید شیم مثل داداشمون. رهبر چی فرمود بهش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 685.63,
   "end": 690.13,
   "text": "فرمودن که چرا نه؟ بمونید انشاالله بمونید کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 690.13,
   "end": 692.95,
   "text": "یعنی این نباشه که آدم فقط آرزوی رفتن و این داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.95,
   "end": 696.79,
   "text": "بمونه کار کنه. بعد انشاالله با دست پر هم شهید شه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 696.79,
   "end": 700.05,
   "text": "خب خیلی خوبه که آدم رعایت بهداشت، رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 700.05,
   "end": 707.83,
   "text": "خوراک و پوشاک و ایناشو بکنه که تا بتونه بهتر از این دنیا که متجر اولیاء الله هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 707.83,
   "end": 711.83,
   "text": "تجارت‌خونه اولیاء الهیه بهره‌برداری بیشتری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.83,
   "end": 713.63,
   "text": "انشاالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 713.63,
   "end": 716.67,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.67,
   "end": 720.99,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}