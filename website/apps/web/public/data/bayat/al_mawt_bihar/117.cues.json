 "chapters": [
  {
   "index": 0,
   "title": "## چرا مرگ را دوست نداریم؛ تقدیم پیشکش سفر",
   "start": 24.62,
   "end": 44.9
  },
  {
   "index": 1,
   "title": "## ولتنظر نفس؛ آنچه برای فردا مقدم کرده‌ای",
   "start": 44.9,
   "end": 265.72
  },
  {
   "index": 2,
   "title": "## نگهداشتن نور؛ نقل از مرحوم بهجت",
   "start": 265.72,
   "end": 285.72
  },
  {
   "index": 3,
   "title": "## منظور اصلی آیه در تفاسیر روایی",
   "start": 285.72,
   "end": 386.07
  },
  {
   "index": 4,
   "title": "## خرج مال در ولایت؛ اربعین و نشر معارف",
   "start": 386.07,
   "end": 467.63
  },
  {
   "index": 5,
   "title": "## ملاک دوراهی‌ها در مسیر خیر",
   "start": 467.63,
   "end": 663.15
  },
  {
   "index": 6,
   "title": "## ده برابر در دنیا؛ دستور امام خمینی",
   "start": 663.15,
   "end": 726.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 15.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.64,
   "end": 19.72,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 19.72,
   "end": 24.62,
   "text": "آیا سه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 24.62,
   "end": 30.0,
   "text": "در روایت نهم از باب چهارم کتاب الموت بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 30.0,
   "end": 36.7,
   "text": "در خصوص علت اینکه ما موت رو دوست نداریم بود که پیغمبر فرمود چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 36.7,
   "end": 40.58,
   "text": "پولتون رو تقدیم نمی‌کنید، پیشکش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 40.58,
   "end": 44.9,
   "text": "سفر نمی‌کنید. که یکی از وجوهش رو عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.9,
   "end": 48.04,
   "text": "یعنی خرج باطن عالم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.04,
   "end": 52.48,
   "text": "چون موت سفر از ظاهر به باطن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 52.48,
   "end": 55.64,
   "text": "هر چیزی که باطنه، حقایق آ-عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.64,
   "end": 65.16,
   "text": "باطنه. اصلاً آنچه که ما در درون خودمون می‌فهمیم، استیض می‌کنیم از بیرون، ارتباطی که ما اصلاً از بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 65.16,
   "end": 68.38,
   "text": "داریم، ارتباطی که با بیرون از خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.38,
   "end": 71.38,
   "text": "چه از طریق حواس ظاهری، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 71.38,
   "end": 73.82,
   "text": "مکمن غیبمون می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.82,
   "end": 78.46,
   "text": "و اونچه که می‌فهمیم اصلاً ارتباط ما بیرون از خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.46,
   "end": 82.04,
   "text": "در مرحله احدیت وجود ما صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.04,
   "end": 84.38,
   "text": "یعنی اون مرتبه جمعی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.38,
   "end": 87.92,
   "text": "واحدیت مرتبه کثرت-- کثرات بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.92,
   "end": 92.26,
   "text": "اون مرتبه جمعی، اون غیبی‌ترین حالت ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.26,
   "end": 96.44,
   "text": "اون دیگه باطن‌ترین حالت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.44,
   "end": 98.7,
   "text": "یعنی ماها اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.7,
   "end": 102.34,
   "text": "اون رو تعطیل کنیم یک پوستی، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.34,
   "end": 105.06,
   "text": "ب-بشری، بشری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.06,
   "end": 110.0,
   "text": "بشری چی بگیم؟ بشر از بشر میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.0,
   "end": 112.2,
   "text": "بشره میگن. پوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.2,
   "end": 115.82,
   "text": "یه پوسته‌ای بیش نیستیم. مثل یه گردویی که مغز نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.82,
   "end": 120.98,
   "text": "پوستش به چه درد می‌خوره؟ باید با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.98,
   "end": 123.5,
   "text": "باطن عالم ارتباط بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.5,
   "end": 126.34,
   "text": "قرآن حقیقت باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.34,
   "end": 129.42,
   "text": "ولایت حقیقت باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.42,
   "end": 132.2,
   "text": "اینایی که میگن ولایت غصب شد نفهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.2,
   "end": 134.04,
   "text": "نخیر، ولایت غصب نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.04,
   "end": 137.78,
   "text": "ولایت غصب پذیر نیست. خلافت غصب پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.78,
   "end": 141.12,
   "text": "ریاست ظاهری بر مردم غصب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.12,
   "end": 145.26,
   "text": "ولایت که ساری و جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.26,
   "end": 152.24,
   "text": "اتفاقاً خیلی شیرین بود برام که در آیه هجده سوره حشر اونجایی که می‌فرماید \"ولتنظر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.24,
   "end": 160.96,
   "text": "خدا رحمت کنه چقدر امام به فرزندانش توصیه می‌کردن سوره حشر رو بخوانید خصوصاً توجه کنید به آیات پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.96,
   "end": 164.46,
   "text": "انتهایی این سوره. این جزو آیات انتهاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.46,
   "end": 167.0,
   "text": "\"ولتنظر\" نگاه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.0,
   "end": 170.7,
   "text": "و بنگر نگاه کن. نظر نگاه عمیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.7,
   "end": 172.54,
   "text": "یه نگاه گذرا و سطحی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.54,
   "end": 176.66,
   "text": "\"ولتنظر\" مثل \"وانظر إلينا نظرة رحیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.66,
   "end": 179.04,
   "text": "نگاه عمیقه. یه نگاه عمیق بنداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.04,
   "end": 182.32,
   "text": "\"ولتنظر نفس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.32,
   "end": 184.72,
   "text": "قدمت لقاء\". به نفست. نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.72,
   "end": 187.04,
   "text": "جنبه باطن وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.04,
   "end": 190.56,
   "text": "نگاه کن به نفست، به باطن خودت که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.56,
   "end": 193.5,
   "text": "\"ما قدمت لقاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.5,
   "end": 196.16,
   "text": "چی رو آماده کردی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.16,
   "end": 200.5,
   "text": "لقاء آینده؟ برای فردا چی آماده کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.5,
   "end": 204.96,
   "text": "اتفاقاً تو این آیه اولش که می‌فرماید \"یا ایها الذين آمنوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.96,
   "end": 208.5,
   "text": "سریع می‌فرماید \"اتقوا الله\" تقوا پیشه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.5,
   "end": 215.88,
   "text": "بعد می‌فرماید \"ولتنظر نفس ما قدمت لقاء\" دوباره تأکید \"واتقوا الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.88,
   "end": 220.4,
   "text": "یعنی نشون میده که کسی که شدت تقوا-- چون تأکید رو تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.4,
   "end": 223.48,
   "text": "دو بار تو آیه. یک بار پیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.48,
   "end": 228.2,
   "text": "دستور به توجه به اینکه چی مقدم می‌کنی برای آخرتت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.2,
   "end": 234.66,
   "text": "یک بار بعدش. می‌شه یک وجهش این باشه که اول میگه تقوا پیشه کن یعنی این کارو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.66,
   "end": 238.4,
   "text": "یعنی از معانی تقوا اینه که تو توجه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.4,
   "end": 240.5,
   "text": "که چی داری پیش می‌فرستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.5,
   "end": 243.76,
   "text": "تقدیم می‌کنی برای فردات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.76,
   "end": 246.72,
   "text": "بعد اون \"واتقوا الله\" دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.72,
   "end": 253.04,
   "text": "تأکید بر اینه که حالا در این پیش فرستادن و در این حفظ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.04,
   "end": 256.12,
   "text": "ارسال هم باز \"واتقوا الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.12,
   "end": 260.18,
   "text": "یعنی حواست باشه که بخشش‌هات رو از بین نبری، خرجش نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.18,
   "end": 263.38,
   "text": "خیلی از ما جمع می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.38,
   "end": 265.56,
   "text": "بلد نیستیم نگهش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.56,
   "end": 269.5,
   "text": "که از آقای بهجت پرسیدن شما چه کردی اینطور به اینجا رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.5,
   "end": 273.98,
   "text": "از قول استادش، از قول استادش سه تا واسطه زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.98,
   "end": 278.64,
   "text": "که ایشون فرمود از اس-استادش آقای کمپانی، ایشون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.64,
   "end": 283.1,
   "text": "استادش همینطوری تا استاد کلشون که فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.1,
   "end": 289.08,
   "text": "ایشون فرمودن یعنی نظر خودشونم بود که من هرچی که از بچگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.08,
   "end": 294.54,
   "text": "نور و لو با یک استغفار، یک صلوات، یه صدقه، اینا همه نوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.54,
   "end": 297.18,
   "text": "وضو نوره. \"الوضوء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.18,
   "end": 300.02,
   "text": "الوضوء نور على نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.02,
   "end": 302.74,
   "text": "پس وضو نوره. اینا همه نورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.74,
   "end": 305.62,
   "text": "هرچه جمع کردم نگهش داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.62,
   "end": 309.82,
   "text": "ولی شما خرج کردید با گناه، با معصیت، با غفلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.82,
   "end": 313.44,
   "text": "خرج کردید. ما اینو بلد نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.44,
   "end": 315.54,
   "text": "اگه این بشه، می‌شه \"نور على نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.54,
   "end": 321.16,
   "text": "حالا بحثم اینجا بود که در تفاسیر روایی دقت کردم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.16,
   "end": 326.16,
   "text": "منظور اصلی از این منطوق که خدا فرموده ببین برای فردات چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.16,
   "end": 331.14,
   "text": "فرش قرمز فردات رو چی قرار میدی پیشکش کنی، پهن کنی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.14,
   "end": 333.46,
   "text": "سفر آخرتت، این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.46,
   "end": 335.7,
   "text": "بالاخره همه خیرات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.7,
   "end": 338.02,
   "text": "اما اون منظور اصلی خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.02,
   "end": 340.72,
   "text": "یعنی تأویل یه لایه پنهان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.72,
   "end": 344.8,
   "text": "پنهان‌تر از این لایه روینه که همه می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.8,
   "end": 348.04,
   "text": "یعنی کار خیر بکن. نه حالا اون منظور اصلی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.04,
   "end": 349.98,
   "text": "اونو اهل بیت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.98,
   "end": 356.62,
   "text": "در تفاسیر روایی اهل بیت علیهم السلام فرمودن این ولایت علی بن ابی طالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.62,
   "end": 361.33,
   "text": "منظور اصلی خدا از این فرش قرمزی که بنداز برای خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.33,
   "end": 363.23,
   "text": "ببین برای فردا چی آماده کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.23,
   "end": 366.33,
   "text": "بعد دو بار تاکید بر اتقى الله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.33,
   "end": 371.73,
   "text": "ولایت امیرالمؤمنین. بردن ولایت مولا از این نشر خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.73,
   "end": 374.71,
   "text": "همه داریم الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.71,
   "end": 379.95,
   "text": "اما بردنش من جاء دقت به این کلمه جاء بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.95,
   "end": 383.97,
   "text": "بزرگان ما خیلی اساتید ما به این سفارش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.97,
   "end": 391.51,
   "text": "من جاء اگر کسی بیاد بالحسنه بله فله عشر امثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.51,
   "end": 397.11,
   "text": "ای کسی بیاد با حسنه که این حسنه رو حب فاطمة زهرا گرفتن تفاسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.11,
   "end": 398.97,
   "text": "حب امیرالمؤمنین همون ولایت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.97,
   "end": 404.27,
   "text": "من جاء اگر کسی بیاد بالحسنه بله فله عشر امثاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.27,
   "end": 407.33,
   "text": "ده برابر پاداش. اما که بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.33,
   "end": 410.09,
   "text": "اینکه پیغمبر فرمود به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.09,
   "end": 415.23,
   "text": "سلمان نوک سوزن رو جلوی سلمان زد تو آب گفت چقدر اینجا آب جمع میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.23,
   "end": 418.63,
   "text": "گفت چیز خیلی جزئی. پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.63,
   "end": 427.69,
   "text": "به خدا قسم که اگر کسی به اندازه سر این سوزن حب علی ابن ابی طالب رو همراه خودش ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.69,
   "end": 431.19,
   "text": "خدا اون رو با آتش معذب نمیکنه و اهل نجاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.19,
   "end": 436.59,
   "text": "و اگر کسی سر سوزن به اندازه همین بغض این آقا رو ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.59,
   "end": 438.79,
   "text": "روی به بهشت نمیبینه. این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.79,
   "end": 444.73,
   "text": "این فرمایش قطعیه و همه ما کلاهمون رو بندازیم بالا آسمون هفتم که به به داریم الحمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.73,
   "end": 446.33,
   "text": "ولی بردنش مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.33,
   "end": 452.13,
   "text": "قربونت برم. که ما تو راه اینو خرج می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.13,
   "end": 456.31,
   "text": "اگر میتونی پولت رو خرج ولایت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.31,
   "end": 461.75,
   "text": "حالا یکی هم سؤال کرده بود که ما خرج ما گفته بودیم که سعی کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.75,
   "end": 464.71,
   "text": "خرج باطن عالم کنیم. خرج معارف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.71,
   "end": 471.49,
   "text": "بخشی از پولمون رو هدیه کنیم به امام زمان در نشر حقایق عالم اینها علم و معرفت شه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.49,
   "end": 478.13,
   "text": "یکی گفته بود من مثلاً یه مقدار پول میذارم کنار همه ساله اربعین که می‌شه مهمون می‌فرستم برای ابو عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.13,
   "end": 481.45,
   "text": "اونا که سال اولن تا نرفتن تا حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.45,
   "end": 484.05,
   "text": "زائر اولین. این بهتره یا اون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.05,
   "end": 486.31,
   "text": "من عرض می‌کنم دوتاش چرا یکی یکی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.31,
   "end": 490.19,
   "text": "چرا اینو حذف کنی اونو. دو تاشو یه دونه زائر کربلا بفرست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.19,
   "end": 492.27,
   "text": "اینم در راه ولایته. اینم خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.27,
   "end": 500.71,
   "text": "اینم در راه تعظیم شعائره و هرچه اربعین پررونق‌تر بشه عزیزان دلم ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.71,
   "end": 503.21,
   "text": "هی شکلش بیشتر قوی‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.21,
   "end": 507.47,
   "text": "چارچوبش محکم‌تر می‌شه. چون ان جدی ال ان جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.47,
   "end": 510.49,
   "text": "الحسین ان جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.49,
   "end": 514.45,
   "text": "جد قطعاً جد منه الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.45,
   "end": 522.61,
   "text": "وقتی خودش رو معرفی می‌کنه پیداست که امام حسین جهانی شده که الا يا اهل العالم ان جدی الحسین قتلوه و اجانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 522.61,
   "end": 526.07,
   "text": "هرکی میره مخصوصاً اربعین داره کمک به ظهور می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.07,
   "end": 530.61,
   "text": "اینا دیگه ثابت شده است. این رو کار رو انجام بده، اون کارم انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.61,
   "end": 533.11,
   "text": "در مسیر نشر حقایق و معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.11,
   "end": 535.33,
   "text": "اون کارم دست بگیر و انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.33,
   "end": 540.43,
   "text": "اونم چیز کمی نیست. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.43,
   "end": 546.59,
   "text": "هر چیزی که من به شما این رو نکته‌ای عرض کنم حالا بحث رو بقیش فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.59,
   "end": 550.15,
   "text": "اینجا اجازه بدید فرود بیام چون خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.15,
   "end": 555.49,
   "text": "تو دوراهی‌ها، اگر پیغمبر فرمود تو دوراهی‌ها ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.49,
   "end": 559.57,
   "text": "کدوم به نفست نزدیک‌تره اونو بذار کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.57,
   "end": 563.27,
   "text": "یعنی نفست بیشتر از این خوشش میاد و حال می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.27,
   "end": 566.17,
   "text": "اصطلاحاً. اونو بذار کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.17,
   "end": 570.35,
   "text": "خواهش نه، به خواهش نفست نزدیک‌تره اونو ترک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.35,
   "end": 574.03,
   "text": "در این مسیر خیر دوراهی‌ها رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.03,
   "end": 577.87,
   "text": "نگاه کنیم ببینیم اینم یه ملاک درستیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.87,
   "end": 580.47,
   "text": "که کدوم از نفست دورتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 580.47,
   "end": 582.47,
   "text": "گمنام‌تر می مونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.47,
   "end": 588.05,
   "text": "به به چه چه نداره. قربونت برم التماس دعا حاج آقا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.05,
   "end": 590.39,
   "text": "اینا رو میذاری کنار کسی متوجه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.39,
   "end": 592.75,
   "text": "گمنام‌تره تا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.75,
   "end": 595.67,
   "text": "یک. دو، به باطن عالم نزدیک‌تر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.67,
   "end": 598.21,
   "text": "اینم ملاک بعدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.21,
   "end": 601.35,
   "text": "در کمک به خیرات هر چیزی که به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.35,
   "end": 604.11,
   "text": "حالا مثلا الان به نظر شما مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 604.11,
   "end": 610.33,
   "text": "بسازین ظاهر مسجد رو بسازین احیا کنیم تعمیر کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.33,
   "end": 613.93,
   "text": "بهتره یا باطن مسجد رو بسازیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.93,
   "end": 617.67,
   "text": "پول خرج ساخت باطن مسجد کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 617.67,
   "end": 622.07,
   "text": "یا ظاهر مسجد؟ قطعاً باید بگید باطن مسجد ارجحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.07,
   "end": 625.59,
   "text": "این همه مسجد ماشالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.59,
   "end": 628.91,
   "text": "البته کم داریم. نگیم که مسجد زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.91,
   "end": 633.83,
   "text": "حالا خونه خود ما یه جایی واقع شده که نمی‌شه پیاده تا مسجد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.83,
   "end": 638.03,
   "text": "باید حتما با ماشین بریم. انقدر که مسجد دوره تو همین تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.03,
   "end": 640.35,
   "text": "اما خب بله اون هم باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 640.35,
   "end": 642.99,
   "text": "اما ارجح بر اون باطن مسجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.99,
   "end": 646.83,
   "text": "ببینیم چرا این مساجد از نوجوون‌ها و جوون‌ها خالین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.83,
   "end": 648.81,
   "text": "چرا هیئت‌ها خالین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.81,
   "end": 652.43,
   "text": "بریم خرج کنیم برای اینکه پرشون کنیم از جوون و نوجوون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 652.43,
   "end": 660.43,
   "text": "با چه راهی؟ بسم الله. مشورت بگیریم با عقلا، با خردمندان، با آدم‌های مجرب و پیشکسوت این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.43,
   "end": 663.15,
   "text": "و هزینه کنیم. بعد اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.15,
   "end": 667.07,
   "text": "اگر کسی این کار کرد همینجا، همینجا ده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.07,
   "end": 670.01,
   "text": "اون ما را آخرت رو، اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.01,
   "end": 672.57,
   "text": "چرا ده برابر؟ قرآن می‌گه هفتصد برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.57,
   "end": 674.61,
   "text": "و الله یضاعف لمن یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 674.61,
   "end": 677.19,
   "text": "خدا تازه اضافه‌شم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 677.19,
   "end": 680.43,
   "text": "ولدئین أمیض. اون ور اصلاً بی‌حساب کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 680.43,
   "end": 683.51,
   "text": "اما اینجا دیگه حداقلش ده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 683.51,
   "end": 686.13,
   "text": "اینکه سر اینکه هست امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 686.13,
   "end": 690.19,
   "text": "اون دستور بیست‌گانه‌شون به بچه بسیجی‌ها یاد داشت به خیر زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.19,
   "end": 694.03,
   "text": "جنگ همیشه به بچه‌های نوجوون‌های هیئتمون اون موقع هم می‌گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.03,
   "end": 704.93,
   "text": "که امام فرمود یک دهم حقوقت رو هرچی در میاری در ماه چه کاسبی، چه کارمندی، یک دهمشو همون اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 704.93,
   "end": 708.25,
   "text": "صدقه رد کن. سرش می‌تونه تو همین باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 708.25,
   "end": 711.05,
   "text": "که ده برابر خدا وعده داده برگردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.05,
   "end": 714.21,
   "text": "تو همین دنیا محاله که نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 714.21,
   "end": 716.61,
   "text": "حالا چند تا مصداق داریم ان شاالله فردا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.61,
   "end": 718.31,
   "text": "ان شاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.31,
   "end": 721.27,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 721.27,
   "end": 726.83,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}