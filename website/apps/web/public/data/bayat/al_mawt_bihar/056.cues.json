   "title": "## ادامهٔ تفاسیر روایی ذیل توبه/۲۵؛ امداد الهی",
   "start": 20.38,
   "end": 66.56
  },
  {
   "index": 1,
   "title": "## روایت شیخ مفید؛ ملائکه در خدمت امام حسین",
   "start": 66.56,
   "end": 131.54
  },
  {
   "index": 2,
   "title": "## روایت امام باقر؛ سفیدپوشان در جنگ",
   "start": 131.54,
   "end": 215.34
  },
  {
   "index": 3,
   "title": "## امداد در زندگی و اقتصاد؛ سورهٔ واقعه",
   "start": 215.34,
   "end": 293.26
  },
  {
   "index": 4,
   "title": "## نحن خلقناکم؛ نطفه و موت و نشئه",
   "start": 293.26,
   "end": 313.36
  },
  {
   "index": 5,
   "title": "## زارع حقیقی؛ آب و آتش؛ قرب الهی",
   "start": 313.36,
   "end": 777.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 3.24,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.24,
   "end": 6.44,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.44,
   "end": 12.2,
   "text": "فرجهم بسم الله الرحمن الرحیم و بهه نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.2,
   "end": 15.0,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.0,
   "end": 17.44,
   "text": "و ربانی آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.44,
   "end": 20.38,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.38,
   "end": 25.58,
   "text": "در ادامه‌ی آنچه که در تفاسیر روایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.58,
   "end": 27.96,
   "text": "اهل بیت علیهم الصالحات السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.96,
   "end": 32.78,
   "text": "ذیل آیه بیست و پنج سوره توبه اومده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.78,
   "end": 38.94,
   "text": "در امدادهای الهی دو تا روایت دیگه تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.94,
   "end": 45.86,
   "text": "که طول بحث و اون سیر مبحث رو دنبال کردید و گم نکنید دیگه ان‌شاءالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.86,
   "end": 49.88,
   "text": "از الان روایت دوم تا نهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.88,
   "end": 58.42,
   "text": "کتاب الموت مرحوم مجلسی هستیم که بعضی از ترس از موت یا مریضی و پریشونی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.42,
   "end": 61.14,
   "text": "از واجب خودشون ادول می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.14,
   "end": 65.72,
   "text": "که حالا غافل از امدادهای الهی بودن که رسیدیم به اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.72,
   "end": 71.06,
   "text": "به قول عالمونه در تفسیر اهل بیت جلد شش صفحه هشتاد و چهار می‌تونید این روایت رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.06,
   "end": 73.76,
   "text": "شیخ مفید این روایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.76,
   "end": 77.3,
   "text": "از امام صادق سلام الله علیه نقل کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.3,
   "end": 83.2,
   "text": "وقتی امام حسین سلام الله علیه از مدینه حرکت می‌کرد که بره به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.2,
   "end": 86.9,
   "text": "مکه و سپس کربلا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.9,
   "end": 92.82,
   "text": "اونجا حضرت فرمودن که گروه‌هایی از ملائکه با اون حضرت ملاقات کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.82,
   "end": 99.36,
   "text": "این گروه‌های ملائکه حربه‌هایی تو دستشون داشتن و بر اسب‌های بهشتی سوار بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.36,
   "end": 103.38,
   "text": "و با حضرت صحبت کردن، سلام کردن، گفت‌وگو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.38,
   "end": 106.8,
   "text": "عرض کردن که ای حجت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.8,
   "end": 110.3,
   "text": "به امام حسین ملائکه، گروه‌هایی از ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.3,
   "end": 114.0,
   "text": "خدای توانا جد بزرگا، بزرگوار تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.0,
   "end": 116.74,
   "text": "بارها توسط ما یاری داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.74,
   "end": 119.56,
   "text": "جد شما رو. تو آیه چی می‌فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.56,
   "end": 124.56,
   "text": "ولقد نصرکم الله فی مواطن كثيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.56,
   "end": 126.7,
   "text": "حالا ما مأموریم که هموناییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.7,
   "end": 128.88,
   "text": "ما هموناییم که جد شما رو یاری دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.88,
   "end": 131.44,
   "text": "مأموریم که در خدمت شما باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.44,
   "end": 134.98,
   "text": "این روایت که تایید می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.98,
   "end": 137.46,
   "text": "حالا بعضیا شاید خیلی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.46,
   "end": 140.76,
   "text": "نپذیرن، عقلشون قطع نده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.76,
   "end": 144.92,
   "text": "که تو یه یورشش مثلا دویست نفر رو کشته باشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.92,
   "end": 147.54,
   "text": "آقا علی اکبر تشنه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.54,
   "end": 150.6,
   "text": "حداقل روایات میگه دویست نفر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.6,
   "end": 155.1,
   "text": "در زمان اون حمله‌ای که داشته کشته این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.1,
   "end": 157.84,
   "text": "خب ملائکه کمک می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.84,
   "end": 164.22,
   "text": "روایت دیگه‌ای از ذیل همین آیه دو مرتبه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.22,
   "end": 166.66,
   "text": "منبعی که عرض کردیم تو همون صفحه هشتاد و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.66,
   "end": 170.6,
   "text": "امام باقر سلام الله علیه می‌فرمود مردی از بنی نضیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.6,
   "end": 175.04,
   "text": "ابن معاویه که به او شجره ابن ربیعه می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.04,
   "end": 179.18,
   "text": "ایشون خب تو جنگ اسیر شد، به دست مسلمونا افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.18,
   "end": 185.8,
   "text": "بعد به مسلمونا گفتش که نگاهی به مسلمون بعد اسارتش کرد و گفت کجان اونایی که ما رو می‌کشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.8,
   "end": 189.26,
   "text": "اینا گفتن همون ما بودیم دیگه. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.26,
   "end": 191.02,
   "text": "شخص گفت نخیر شماها نبودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.02,
   "end": 194.52,
   "text": "شما اصلاً مثل یک خالی مثل یک نقطه‌ای بودید بین این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.52,
   "end": 198.54,
   "text": "سراپا سفیدپوش بودند. جمعیت کثیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.54,
   "end": 201.48,
   "text": "با ما درگیر بودند و شما بین این‌ها بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.48,
   "end": 204.56,
   "text": "کشان اون‌ها؟ اسب سواران و سفید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.56,
   "end": 211.42,
   "text": "پوشان و فلان. یعنی حضرت داره تصریح می‌کنه اینجا امام باقر سلام الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.42,
   "end": 214.66,
   "text": "امدادهای غیبی همیشه همراه اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.66,
   "end": 222.78,
   "text": "بوده است. این خیلی مهمه که حالا ما فقط بحث جنگ رو نداریم در همه‌ی مسائل زندگیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.78,
   "end": 227.46,
   "text": "الان تو اوضاع اقتصادی کشور و خود ماها خود شماها و ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.46,
   "end": 233.9,
   "text": "که بارها خیلی‌تون به ما درد دل کردید که همون اوایل ماه جیب ما خالی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.9,
   "end": 237.44,
   "text": "با یه حقوق‌هایی که می‌گیریم و با یه اوضاع اقتصادی واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.44,
   "end": 242.38,
   "text": "خب کیه که هر ماه ما رو تا آخر ماه می‌کشونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.38,
   "end": 243.98,
   "text": "واقعاً امداد الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.98,
   "end": 247.24,
   "text": "به قول قدیمی‌ها به مو می‌رسه پاره نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.24,
   "end": 255.14,
   "text": "همه چی دست خداست. شما-- یه توصیه به خودم بکنم و شما عزیران آیات انتهایی سوره واقعه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.14,
   "end": 257.02,
   "text": "یه نگاهی با دقت بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.02,
   "end": 263.76,
   "text": "حالا شاید هر شبم داریم می‌خونیم از زمان جنگ این یادگار بوده دیگه هر شب قبل غا-خواب می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.76,
   "end": 267.62,
   "text": "حالا الان شاید بعضیا بیان به خاطر اینکه فقیر نشن بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.62,
   "end": 271.42,
   "text": "آقا الانم همه چی معامله اقتصادی شده، پایه‌پایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.42,
   "end": 276.32,
   "text": "که آقا حدیثه، حدیث هم داریم بر منکرش لعنت که هر شب بخونه فقیر نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.32,
   "end": 278.9,
   "text": "اما خب تو جبهه به عشق دیگه‌ای می‌خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.9,
   "end": 283.58,
   "text": "چون در صف محبین امیرالمؤمنین محشور می‌شه کسی که اینو بخونه هر شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.58,
   "end": 288.94,
   "text": "حالا از اونجای مخصوصاً دقتتون رو بیشتر کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.94,
   "end": 293.26,
   "text": "می‌فرماید که نحن خلقناکم فلعله لا تصدقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.26,
   "end": 296.0,
   "text": "چرا تصدیق نمی‌کنید که ما شما رو خلق کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.0,
   "end": 301.14,
   "text": "أفرأيتم ما تمنون آیا نگاه نمی‌کنید که شما یه نطفه بودید، منی بودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.14,
   "end": 305.4,
   "text": "أأنتم تخلقونه شما اون نطفه رو خلق کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.4,
   "end": 307.88,
   "text": "أم نحن، نحن یعنی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.88,
   "end": 310.98,
   "text": "نحن الخالقون یا ما خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.98,
   "end": 316.06,
   "text": "چرا توجهتون به ربوبیت عالم نیست، به الهیت نظام هستی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.06,
   "end": 321.82,
   "text": "خیلی شیرینه. همش خدا اینجا داره أنا أنا میگه به یک منو، من من میگه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.82,
   "end": 323.92,
   "text": "کبرایی مخصوص اوست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.92,
   "end": 328.46,
   "text": "ردای اوست. نحن قدرنا بینکم الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.46,
   "end": 337.26,
   "text": "حالا بحث ما موت بود دیگه. داره می‌فرماید ما هستیم که مقدر کردیم بین شما موت رو و ما نحن الموصوبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.26,
   "end": 343.72,
   "text": "و ما نحن الموصوبین. خیلی شیرینه یعنی همه چیو خدا به خودش نسبت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.72,
   "end": 349.68,
   "text": "ألا أنبدل أمثالكم وننشئكم فيما لا تعلمون عجب آیه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.68,
   "end": 353.04,
   "text": "ما نبدل امثالکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.04,
   "end": 355.9,
   "text": "ما می‌تونیم شما رو بدل کنیم به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.9,
   "end": 358.62,
   "text": "کسایی شبیه شما. خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.62,
   "end": 363.44,
   "text": "اینا باید تعویل بشه. رفت به باطن آیه ببینی چه خبره تو این عالم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.44,
   "end": 368.04,
   "text": "خبر نداریم. وننشئکم دوباره شما رو انشا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.04,
   "end": 370.22,
   "text": "چجوری؟ کجا؟ ای خدا کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.22,
   "end": 371.96,
   "text": "چطوری میخوای ایجاد کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.96,
   "end": 376.12,
   "text": "یه بار که ایجاد کردی این شدم. دو باره قراره ایجاد کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.12,
   "end": 378.84,
   "text": "به مقام کن فیکونت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.84,
   "end": 381.08,
   "text": "فی ما لا تعلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.08,
   "end": 384.96,
   "text": "جایی که شما علمشو ندارید، نمی‌دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.96,
   "end": 389.18,
   "text": "عجب خبرهاست. بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.18,
   "end": 393.68,
   "text": "حالا نشئه طبیعت و واقع شدن اون موتی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.68,
   "end": 399.62,
   "text": "امروز فکر می‌کنم پنجم و ششمین جلسه باشه سر سفره‌ش نشستیم چه خبرها قراره اتفاق بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.62,
   "end": 403.68,
   "text": "که شما خبر ندارید. نمی‌دونید چه اتفاقی قراره بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.68,
   "end": 406.76,
   "text": "ولقد علمتم نشأت الأولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.76,
   "end": 410.52,
   "text": "این الان که میگن آقا چرا میگی نشئه طبیعت، نشئه برزخ اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.52,
   "end": 412.7,
   "text": "قرآن فرموده ولقد علمتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.7,
   "end": 416.12,
   "text": "نشأت الأولى یه جایی که پدیدار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.12,
   "end": 418.98,
   "text": "اینجا ظهور حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.98,
   "end": 420.54,
   "text": "پدیداری ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.54,
   "end": 423.1,
   "text": "همونطور که ملکوت باطنه اینجا ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.1,
   "end": 425.14,
   "text": "زا-- اسم ظاهر حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.14,
   "end": 429.94,
   "text": "نمایان شده. فرمود به تحقیق ما شما رو آگاه کردیم از این نشئه اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.94,
   "end": 433.82,
   "text": "همینجا که الان هستید اگر اینو نشئه اول بگیرید شما رو آگاه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.82,
   "end": 437.46,
   "text": "فلو تذكرون چرا متذكر اون نشئه های بعدی نمی‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.46,
   "end": 439.78,
   "text": "شما در سیرید، در حرکتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.78,
   "end": 442.72,
   "text": "آنفآن حضرت حق داره در وجود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.72,
   "end": 445.2,
   "text": "که يوم كل يوم هو فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.2,
   "end": 449.68,
   "text": "تجلی می‌کنه. آنفآن شما شخص جدیدی هستی، داری ایجاد میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.68,
   "end": 455.12,
   "text": "آنفآن. حالا بعد دیگه به سر-- بعضی جاهاشم دیگه خیلی کلی و سریعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.12,
   "end": 458.54,
   "text": "مثل موت. موت اجباری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.54,
   "end": 461.66,
   "text": "که قبلاً عرض کردیم ما چند تا موت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.66,
   "end": 465.58,
   "text": "خب بازم بریم جلوتر ببینید. همش داره نحن نحن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.58,
   "end": 467.82,
   "text": "بعد فرمود أفرأيتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.82,
   "end": 472.86,
   "text": "ما تحرثون آیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.86,
   "end": 475.88,
   "text": "نگاه نمی‌کنید که کیه که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.88,
   "end": 479.14,
   "text": "کشتزار شما رو این رویاندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.14,
   "end": 483.04,
   "text": "تخم در خاک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.04,
   "end": 485.82,
   "text": "آنفآن داره صورت‌گیری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.82,
   "end": 489.6,
   "text": "هی داره طورش، وضعش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.6,
   "end": 494.16,
   "text": "تخمه این تخمی که در دان-- در خاک کاشتی هی عوض می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.16,
   "end": 496.76,
   "text": "هی شکوفا می‌شه. کی داره این کارو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.76,
   "end": 501.62,
   "text": "نگاه نمی‌کنید أأنتم تزرعونه شما دارید زراعتشو می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.62,
   "end": 505.56,
   "text": "شما زارعونید أم نحن زارعون یعنی که ما زارعیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.56,
   "end": 508.78,
   "text": "عجب خدا زارعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.78,
   "end": 512.02,
   "text": "اینجا تکلیف کشاورزا چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.02,
   "end": 518.66,
   "text": "خدا الله يتوفى الأنفاس حين موتها تکلیف قابض الأرواح چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.66,
   "end": 522.6,
   "text": "ونحن أقرب إليه منكم انتهای همین سوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.6,
   "end": 524.72,
   "text": "من از شما به اون از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.72,
   "end": 528.38,
   "text": "از شماهایی که نشستید کنار محتضر به اون نزدیکترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.38,
   "end": 532.26,
   "text": "پس تکلیف ما اینجا چیه؟ اصلاً جز حق چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.26,
   "end": 535.7,
   "text": "همه ظهور حقند که بحث‌هاش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.7,
   "end": 538.42,
   "text": "لو نشاء ما اگر بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.42,
   "end": 540.52,
   "text": "لجعلناه حطاماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.52,
   "end": 543.58,
   "text": "فذلتم تفکّهون اگه ما بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.58,
   "end": 549.36,
   "text": "می‌زنیم داغون می‌کنیم کشتزارتون رو به هیچ نتیجه‌ای هم نمی‌رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.36,
   "end": 554.36,
   "text": "إنالمغرمون بعد می‌گید که آخ، آخ ما غرامت بزرگی پس دادیم بیچاره شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.36,
   "end": 556.6,
   "text": "بل نحن محرومون ما محروم شدیم اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.6,
   "end": 559.94,
   "text": "أفرأيتم الماء الذي تشربون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.94,
   "end": 563.08,
   "text": "نگاه کن ببین آبی که می‌خورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.08,
   "end": 567.28,
   "text": "به، به مثل همین امروز که الحمد لله نعمت بارش باران داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.28,
   "end": 570.82,
   "text": "أأنتم أنزلتموه من المزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.82,
   "end": 574.44,
   "text": "مزم. ابر. شمایید که نازل می‌کنید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.44,
   "end": 579.88,
   "text": "باران رو از ابر؟ أم نحن المنزلون یا ما داریم نازل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.88,
   "end": 587.18,
   "text": "حدیث داریم هر دانه باران رو یک ملک ماموره میاد اصابت کرد به جایی که باید اصابت کنه رها می‌کنه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.18,
   "end": 592.92,
   "text": "پس اینجا خدا داره میگه نحن المنزلون که منم که ما هستیم که نازل می‌کنیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.92,
   "end": 598.24,
   "text": "و همه چی خداست. همه چی به دست حضرت-- و چگونه‌ست که دست خدا رو تو زندگی نمی‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.24,
   "end": 602.28,
   "text": "چقدر کورم من. چقدر بیچاره و غفلت زده‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.28,
   "end": 606.1,
   "text": "که اصلاً خدا رو نمی‌بینم. دستش رو نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.1,
   "end": 611.14,
   "text": "لو نشاء جعلناه أجاجاً اگر ما بخوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.14,
   "end": 613.12,
   "text": "جعلناه اونو قرار میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.12,
   "end": 616.58,
   "text": "چی رو؟ همون باران رو. أجاجاً یعنی شور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.58,
   "end": 620.5,
   "text": "شورش می‌کنیم. اگه خدا آبو شور قرار می‌داد چیکار می‌کردیم من و تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.5,
   "end": 624.46,
   "text": "فلو لتشكرون یعنی بخواهید شکرگذار باشید دوباره آتشو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.46,
   "end": 626.48,
   "text": "حالا اینم بگم طول کشید ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.48,
   "end": 630.38,
   "text": "أفرأيتم النار التي تورون نگاه کنید به یه آتشی که بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.38,
   "end": 634.52,
   "text": "شماها ظاهراً شماها دارید روشنش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.52,
   "end": 637.6,
   "text": "أأنتم أنشأتم شجرتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.6,
   "end": 641.04,
   "text": "آیا اون درختی که ازش آتیش زد بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.04,
   "end": 646.12,
   "text": "شما اون رو ایجاد کردید؟ أم نحن المنشؤون یا اون درختو ما بزرگش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 646.12,
   "end": 648.96,
   "text": "عجب حرفی زده خدا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 648.96,
   "end": 653.2,
   "text": "نحن جعلناها تذكرة ما اونو تذکره قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.2,
   "end": 657.06,
   "text": "یعنی اون آتشی که تو دل درخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 657.06,
   "end": 661.32,
   "text": "تو دلت می‌بینیش؟ می‌بینیش اونو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.32,
   "end": 665.4,
   "text": "مثل آتشی که الان تو وجود کافره، مشرکه، منافقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 665.4,
   "end": 669.12,
   "text": "قبلاً مثالشو زدیم. شما گفتی آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.12,
   "end": 672.6,
   "text": "موت یعنی سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 672.6,
   "end": 678.74,
   "text": "کسی که میره جهنم نه اینکه یه جایی جهنم تعبیه شده، خودش جهنم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 678.74,
   "end": 683.84,
   "text": "کسی که میره بهشت نه اینکه یه مثلاً باغی هست میگن بفرمایید خودش بهشت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 683.84,
   "end": 686.46,
   "text": "این دست چیه؟ فرمایشات علمائه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 686.46,
   "end": 692.36,
   "text": "بعد روایت اینا میان فرمایشات اهل بیت علیهم الصلاة والسلام رو اینجوری برای ما باز می‌کنن ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.36,
   "end": 695.38,
   "text": "خص-- فصل الخطاب در خصوص این مسائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 695.38,
   "end": 701.68,
   "text": "دیگه که اون شخص اومد مثلاً مچگیری کنه از مولا ظاهراً یهودی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 701.68,
   "end": 706.18,
   "text": "یه بهتون گفتم یه استخوان جمجمه کافر رو پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 706.18,
   "end": 708.72,
   "text": "سرد بود. زمستان هم ظاهراً بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 708.72,
   "end": 711.14,
   "text": "سرد، یخ. آورد پیش مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 711.14,
   "end": 715.18,
   "text": "آقا شما فرمودید که جهنمی‌ها تو آتیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 715.18,
   "end": 716.88,
   "text": "ایشون من می‌دونم کافر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.88,
   "end": 720.26,
   "text": "چرا الان استخوان جمجمه‌ش یخه، یخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 720.26,
   "end": 722.94,
   "text": "حضرت فرمود برو یه سنگ چخماق بیار ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 722.94,
   "end": 724.64,
   "text": "آورد سخ-- سنگ چخماق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 724.64,
   "end": 728.06,
   "text": "گفت دست بکش. یخه. درسته گفت آخ، آخ اینم سرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 728.06,
   "end": 730.56,
   "text": "زد به هم آتیش از توش زد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 730.56,
   "end": 735.08,
   "text": "فرمود دیدی؟ اینجا خدا داره میگه اون آتشی که توی دل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 735.08,
   "end": 738.92,
   "text": "درخته شما اون آتیشو ایجاد می‌کنی یا ما میاریمش بیرون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 738.92,
   "end": 741.14,
   "text": "ظاهراً آتشی تو درخت نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 741.14,
   "end": 744.52,
   "text": "توجه کنید به این نکته. آتشی ظاهراً تو درخت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 744.52,
   "end": 746.66,
   "text": "ما اینو که از ملکوت این درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 746.66,
   "end": 749.36,
   "text": "آتش رو جلوه میدیم به ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 749.36,
   "end": 751.82,
   "text": "همه تجلیات عالم ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 751.82,
   "end": 756.2,
   "text": "همون ظهور حضرت حق از ملکوت به ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 756.2,
   "end": 758.16,
   "text": "توجه کنیم اینا خیلی مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.16,
   "end": 761.24,
   "text": "اگر توجه ما به این‌ها نباشه ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 761.24,
   "end": 766.52,
   "text": "ظاهراً دینداریم. ولی باطناً مشرک و منافق و خدای نکرده کافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 766.52,
   "end": 769.4,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 769.4,
   "end": 771.54,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 771.54,
   "end": 774.86,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 774.86,
   "end": 777.6,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}