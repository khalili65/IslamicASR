 "chapters": [
  {
   "index": 0,
   "title": "## باب چهارم بحار؛ حب لقاء الله و ذم الفرار من الموت",
   "start": 10.88,
   "end": 122.8
  },
  {
   "index": 1,
   "title": "## نهی تمنای موت از روی جزع",
   "start": 122.8,
   "end": 477.02
  },
  {
   "index": 2,
   "title": "اینجا کسی که کافر است، مشرک است، منافق است، معصیت‌کار است، آدم بدی بوده، قرآن صراحتاً می‌فرماید:",
   "start": 477.02,
   "end": 626.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 2.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.4,
   "end": 5.66,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.66,
   "end": 7.74,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.74,
   "end": 10.88,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.88,
   "end": 14.36,
   "text": "در کتاب موت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.36,
   "end": 18.12,
   "text": "می‌رسیم به باب چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.12,
   "end": 20.76,
   "text": "باب چهارم عنوانش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 20.76,
   "end": 23.74,
   "text": "\"حب لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 23.74,
   "end": 27.44,
   "text": "و ذم الفرار من الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 27.44,
   "end": 30.5,
   "text": "دوستی ملاقات با خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 30.5,
   "end": 33.14,
   "text": "دوستی لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 33.14,
   "end": 37.82,
   "text": "و مذمت در فرار کردن از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 37.82,
   "end": 42.44,
   "text": "این عنوان این بنده، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 42.44,
   "end": 44.28,
   "text": "بابه که باب چهارم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 44.28,
   "end": 49.48,
   "text": "روایت اولش رو مرحوم مجلسی از تفسیر قمی آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 49.48,
   "end": 57.48,
   "text": "که تفسیر قمی این چنین می‌فرماید که \"فتمنوا الموت ان کنتم صادقین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.48,
   "end": 60.28,
   "text": "این آیه نود و چهار سوره بقره‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.28,
   "end": 62.54,
   "text": "این تیکه. \"فتمنوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.54,
   "end": 67.38,
   "text": "یعنی پس تمنای موت کنید اگر صادقید، اگه راست می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.38,
   "end": 72.92,
   "text": "\"قال ان في التوراة مكتوبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.92,
   "end": 75.04,
   "text": "ایشون می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.04,
   "end": 78.92,
   "text": "گفتش که در تورات نوشته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 78.92,
   "end": 82.66,
   "text": "چی نوشته شده؟ \"اولياء الله يتمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.66,
   "end": 88.3,
   "text": "الموت\". اولیای خدا تمنای موت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.3,
   "end": 93.42,
   "text": "ذیل اون آیه \"فتمنوا الموت ان کنتم صادقین\" اگر راست می‌گید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.42,
   "end": 99.76,
   "text": "تمنای موت کنید. می‌فرماید که توی تورات اومده که اولیای خدا تمنای موت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.76,
   "end": 105.04,
   "text": "\"ثم قال\" بعد گفت \"ان الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.04,
   "end": 107.44,
   "text": "الذي تفرون منه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.44,
   "end": 110.6,
   "text": "اینم دوباره اشاره به آیه قرآن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.6,
   "end": 112.76,
   "text": "اون موتی که ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.76,
   "end": 122.48,
   "text": "فرار می‌کنید \"فإنه ملاقيکم ان الموت الذي تفرون منه فإنه ملا\" قطعاً شما اون رو ملاقات خواهید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.48,
   "end": 125.0,
   "text": "خب حالا اینجا سؤال پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.0,
   "end": 128.78,
   "text": "چگونه است که در روایات تمنای موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.78,
   "end": 131.28,
   "text": "منع شده، نهی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.28,
   "end": 137.42,
   "text": "خوب نیست. مثلاً در یه روایتی امیرالمؤمنین علیه الصلاة والسلام داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.42,
   "end": 140.28,
   "text": "در تفسیر اهل بیت دیدم خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.28,
   "end": 141.54,
   "text": "صفحه-- جلد یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.54,
   "end": 147.2,
   "text": "صفحه پونصد و پنجاه و هشت می‌تونید ببینید روایت که مولامون امیرالمؤمنین علیه الصلاة والسلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.2,
   "end": 149.32,
   "text": "\"لا يتمنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.32,
   "end": 153.52,
   "text": "احدکم الموت\" هیچ‌کدومتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.52,
   "end": 156.3,
   "text": "تمنای موت نکنید \"لضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.3,
   "end": 160.24,
   "text": "نزل به\" برای اون ضرری که بهتون می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.24,
   "end": 165.34,
   "text": "مثلاً طرف گرفتاره، ضرر و زیان داده تحت فشاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.34,
   "end": 167.52,
   "text": "میگه خدایا مرگ منو برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.52,
   "end": 171.22,
   "text": "اینجا مولا می‌فرماید به این خاطر نباید تمنای موت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.22,
   "end": 178.3,
   "text": "\"ولکن ليقل\" بلکه اینطوری بگید \"اللهم احيني ما دامت الحياة خيرا لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.3,
   "end": 182.0,
   "text": "اگر تا وقتی که زندگی خیر منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.0,
   "end": 187.76,
   "text": "منو زنده بدار \"وتوفني اذا كانت الوفاة خيرا لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.76,
   "end": 190.1,
   "text": "اگر هر وقت که موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.1,
   "end": 193.3,
   "text": "به خیر من بود، خدایا اون موقع من رو بمیران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.3,
   "end": 197.36,
   "text": "این فرمایش امیرالمؤمنینه. \"فانها نهى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.36,
   "end": 202.08,
   "text": "تمني الموت لانه يدل على الجزع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.08,
   "end": 204.68,
   "text": "حضرت اشاره می‌کنند به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.68,
   "end": 206.86,
   "text": "این فر-- هنوز فرمایش مولا‌ست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 206.86,
   "end": 213.08,
   "text": "می‌فرماید که نهی شده که تمنای موت بکنید چون این نوع جزع حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.08,
   "end": 215.76,
   "text": "از رو نا، ناتوانی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.76,
   "end": 218.68,
   "text": "انسان جزع کنه. خب پس چگونه است که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.68,
   "end": 222.96,
   "text": "داره می‌فرماد \"فتمنوا الموت\" یا تو تورات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.96,
   "end": 225.8,
   "text": "به قول تفسیر قمی نوشته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.8,
   "end": 227.68,
   "text": "اولیای خدا تمنای موت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.68,
   "end": 234.7,
   "text": "حالا انشاالله روایت بعدی که برسیم تصریح می‌شه درش که منظور از این تمنای موت نه یعنی خدایا منو بکش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.7,
   "end": 238.58,
   "text": "منو ببر، این نیست. یعنی تهییؤ برای موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.58,
   "end": 241.68,
   "text": "آمادگی برای موت. منظور اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.68,
   "end": 244.26,
   "text": "منظور این منطوق اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.26,
   "end": 247.28,
   "text": "که کسی که صادقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.28,
   "end": 250.5,
   "text": "ترسی از موت نداره و کاملاً آماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 250.5,
   "end": 258.16,
   "text": "یعنی بعد از وجودش هم که خبر می‌گی، می‌گیری می‌بینی سر تا پا شوق دیدار خدا رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.16,
   "end": 261.06,
   "text": "اینجوری نیست که کراهت داشته باشه از موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.06,
   "end": 264.86,
   "text": "حالا یکی هم احتمال داره که اصلاً به زبانش نیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.86,
   "end": 267.46,
   "text": "نیاره به زبانش که خدایا منو ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.46,
   "end": 271.6,
   "text": "ها؟ اما اه اصلاً و ابداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.6,
   "end": 275.54,
   "text": "آمادگی هم نداره. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.54,
   "end": 278.96,
   "text": "می‌دونه که چه کرده. به قول شیخ الرئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.96,
   "end": 281.9,
   "text": "هر کسی که از مرگ می‌ترسه از خودش می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.9,
   "end": 284.04,
   "text": "می‌دونه چه غلطی کرده، می‌دونه چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.04,
   "end": 286.64,
   "text": "کارهایی کرده، از اعمال خودش می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.64,
   "end": 293.58,
   "text": "در هر حال این نشون می‌ده که تهییؤ و آمادگی برای موت تصریح شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.58,
   "end": 297.36,
   "text": "نه اینکه از خدا بخواد ما رو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.36,
   "end": 300.98,
   "text": "که در تفسیر قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.98,
   "end": 303.92,
   "text": "که حالا براتون عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.92,
   "end": 306.36,
   "text": "البته روایات دیگه‌ای هم پیرامون همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 306.36,
   "end": 311.36,
   "text": "قضیه آورده. اه اما در خصوص \"تفرون منه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 311.36,
   "end": 315.0,
   "text": "اینکه فرار می‌کنند از او-- از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.0,
   "end": 319.08,
   "text": "موت، این کیا فرار می‌کنند از موت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.08,
   "end": 322.04,
   "text": "دقت بفرمایید جوابش تو خودشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.04,
   "end": 325.62,
   "text": "توی اون روایت که تو تفسیر قمی آورده می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.62,
   "end": 330.58,
   "text": "توی تورات هست که اولیای خدا تمنای موت دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.58,
   "end": 333.14,
   "text": "بعد توی این آیه از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 333.14,
   "end": 339.12,
   "text": "می‌فرماید \"تفرون، تفرون منه فإنه ملاقيکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.12,
   "end": 342.5,
   "text": "فکر می‌کنم سوره جمعه آیه هشت این تو حدودا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.5,
   "end": 344.98,
   "text": "که این‌ها فرار می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.98,
   "end": 347.86,
   "text": "از موتی که بالاخره ملاقاتش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.86,
   "end": 351.62,
   "text": "اگر فرار می‌کنند پس اولیای خدا نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 351.62,
   "end": 357.32,
   "text": "چرا؟ چون تو تورات هست اولیای خدا از حداقلش اینه که فرار از موت ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.32,
   "end": 361.22,
   "text": "اتفاقاً تهییؤ و آمادگی برای موت دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.22,
   "end": 363.26,
   "text": "شوق لقاء الله رو دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.26,
   "end": 370.62,
   "text": "پس کسی که از موت بدش میاد دقت بفرمایید تا اسم مرگ میاد رنگش می‌پره، بدش میاد، دوست نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.62,
   "end": 374.2,
   "text": "زبونتو گاز بگیر العیاذ بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.2,
   "end": 377.48,
   "text": "این معلومه که از اولیای خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.48,
   "end": 380.88,
   "text": "کسی که ولی خدا شد دوست خدا شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.88,
   "end": 386.96,
   "text": "اتفاقاً بهترین، شیرین‌ترین لحظه براش اون لحظه‌ایه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.96,
   "end": 391.38,
   "text": "این قطعا این پرده برداشته می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.38,
   "end": 396.28,
   "text": "\"فکشفنا عنک\" آیه بیست و دو سوره قافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.28,
   "end": 399.92,
   "text": "\"فکشفنا عنک قطاعک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.92,
   "end": 404.62,
   "text": "این قطاع، این پرده وقتی از جلو چشت برداشته شد چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.62,
   "end": 407.82,
   "text": "آیه رو کی حفظه؟ \"فبصرک اليوم حدید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.82,
   "end": 415.86,
   "text": "\"فبصرک اليوم\" امروز این بصرت بینایت \"الحدید\" تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.86,
   "end": 419.92,
   "text": "دیدی یهو زل می‌زنه یکی تیز نگاه می‌کنه یه جا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.92,
   "end": 427.54,
   "text": "میگه \"فکشفنا عنک\" وقتی که این قطاعک وقتی پرده لحظه‌ی مرگ بره کنار، آیه بیست و دو سوره قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.54,
   "end": 431.08,
   "text": "همه تیزبین می‌شن. همه چه-- اصلاً یه معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.08,
   "end": 435.68,
   "text": "سکره یا سکرات مرگ که میگن همون بی‌هوشی همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.68,
   "end": 437.92,
   "text": "چشمشون به باطن عالم باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.92,
   "end": 441.82,
   "text": "هممون یعنی می‌شود همه‌ی ما از من بگیر تا همه‌ی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.82,
   "end": 443.76,
   "text": "بالاخره روزی خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.76,
   "end": 450.22,
   "text": "دور و نزدیک بالاخره چشم باز می‌شه و باطن عالم که می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.22,
   "end": 452.66,
   "text": "اوه، اوه، اوه چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.66,
   "end": 455.5,
   "text": "حالا گذشته از اعمال خودمون اون که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.5,
   "end": 458.62,
   "text": "باطن این عالم که می‌بینی چشم تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.62,
   "end": 461.8,
   "text": "این آیه قرآنه ها. \"فبصرک اليوم حدید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.8,
   "end": 464.88,
   "text": "حالا اینجا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.88,
   "end": 471.42,
   "text": "کافره، مشرکه، منافقه، معصیت کاره، آدم بدی بوده تمام اینجا خود قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.42,
   "end": 477.02,
   "text": "صراحتاً آیه صد و شش-- صد و شش بقره می‌فرماید \"وتقطعت بهم الاسباب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.02,
   "end": 478.98,
   "text": "اسباب قطع می‌شه بر این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.98,
   "end": 484.92,
   "text": "یعنی اونایی که محافظش بودند، مراقبش بودند فکر می‌کرد مالش حفظش می‌کنه، جاهش، مقامش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 484.92,
   "end": 489.72,
   "text": "منسبش، جایگاه اجتماعیش، چه، چه، این‌ها مدرک تحصیلیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.72,
   "end": 492.7,
   "text": "این‌ها مدیریتش. آقا من مدیر کل فلان جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.7,
   "end": 496.02,
   "text": "فکر می‌کرد این‌ها نگرش می‌داشته. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.02,
   "end": 499.1,
   "text": "\"وتقطعت بهم الاسباب\" همه‌چی قطع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.1,
   "end": 501.24,
   "text": "همه‌ی اسباب تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.24,
   "end": 505.18,
   "text": "لذا چشش تیز می‌شه. می‌بینه هیچ کسی نمی‌تونه کمکش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.18,
   "end": 507.52,
   "text": "توجه کردید؟ اصلاً فرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.52,
   "end": 509.52,
   "text": "بین کافر و مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 509.52,
   "end": 511.62,
   "text": "اینجا مشخص می‌شه. مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 511.62,
   "end": 515.38,
   "text": "این تیزی چشمش به ادع-- به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.38,
   "end": 517.92,
   "text": "شوقشه. شوق لقاالله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 517.92,
   "end": 520.28,
   "text": "هی می‌پاد که اولیای خدا بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.28,
   "end": 524.02,
   "text": "یا حارث همدان \"من یمت یرنی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.02,
   "end": 528.26,
   "text": "من علی به تو بگم هرکس که بمیرد من علی را خواهد دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.26,
   "end": 529.94,
   "text": "چه کافر باشه چه مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.94,
   "end": 537.92,
   "text": "مؤمن شوق دیدار امیرالمؤمنین علیه الصلاة والسلام لحظه‌ی مرگ رو داره لذا چشم می‌اندازه چشمش تیزه که آقاشو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.92,
   "end": 540.7,
   "text": "شوق موت داره. \"فتمنى الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.7,
   "end": 543.64,
   "text": "یعنی در درونش تمنای موت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.64,
   "end": 547.66,
   "text": "چون صادقه. تو قرآن می‌فرماید حالا یادم نیست کدوم آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 547.66,
   "end": 550.66,
   "text": "\"کنوا مع الصادقین\" همراه صادقین باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 550.66,
   "end": 555.82,
   "text": "در تفاسیر فرمودن الصادقین علی و اولاد علی‌ان، اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.82,
   "end": 560.54,
   "text": "اینجا میگه اگه تو صادقی یعنی همراه با علی هستی بسم الله الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.54,
   "end": 563.44,
   "text": "آقات می‌خواد بیاد شوق زیارت آقا نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.44,
   "end": 566.62,
   "text": "الان بهت بگن بفرمایید مفت و مفت برو نجف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.62,
   "end": 569.0,
   "text": "برو رو برو این طلا بشین کیف کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.0,
   "end": 572.48,
   "text": "خب نباید چشمت تیز بشه و کی کجا چیکار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.48,
   "end": 576.32,
   "text": "کیف کنی؟ مؤمن این شوق رو داره اما کافر نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.32,
   "end": 582.8,
   "text": "کافر دیگه همه‌ی اسباب براش قطع می‌شه و دیگه اول عذاب و بیچارگی و بدبختیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 582.8,
   "end": 588.64,
   "text": "اونم تا ابد. انشاالله این رو حالا تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.64,
   "end": 591.12,
   "text": "روایت اول بود از باب چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.12,
   "end": 595.28,
   "text": "دو سه تا نکته دیگه هست که انشاالله الان فرصت نیست روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.28,
   "end": 598.6,
   "text": "پیشاپیش عید فطر هم به همتون تبریک میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.6,
   "end": 603.54,
   "text": "انشاالله که خدا لطف کنه از ته وجودمون این دعا رو بکنیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.54,
   "end": 608.2,
   "text": "خدا لطف کنه این آخرین ماه رمضان عمر ما نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.2,
   "end": 614.1,
   "text": "انشاالله عید فطر های دیگه ای رو هم ببینیم با عافیت، با تندرستی و در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.1,
   "end": 620.3,
   "text": "اولیای خدا باشیم. انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.3,
   "end": 623.18,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.18,
   "end": 626.08,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}