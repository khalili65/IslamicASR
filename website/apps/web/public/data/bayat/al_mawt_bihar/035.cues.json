 },
 "chapters": [
  {
   "index": 0,
   "title": "## باب دوم کتاب الموت؛ عنوانِ متنبّه",
   "start": 9.52,
   "end": 95.26
  },
  {
   "index": 1,
   "title": "اول آیهٔ هفتاد سورهٔ نحل:",
   "start": 95.26,
   "end": 295.72
  },
  {
   "index": 2,
   "title": "## آیهٔ پنج حج؛ اگر در ریب بعث‌اید",
   "start": 295.72,
   "end": 756.8
  },
  {
   "index": 3,
   "title": "## دائماً در معرض اماته و احیا",
   "start": 756.8,
   "end": 828.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 6.9,
   "text": "و بهیم نستعین. السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.9,
   "end": 9.52,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.52,
   "end": 13.42,
   "text": "به فضل الهی میریم سراغ باب دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.42,
   "end": 16.14,
   "text": "باب دوم از کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.14,
   "end": 18.56,
   "text": "بهار مرحوم مجلسی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.56,
   "end": 26.14,
   "text": "ابتدا عنوان باب رو عرض کنم که البته این باب خیلی متنبّه کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.14,
   "end": 28.46,
   "text": "خوبه که پیگیر مباحث این باب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.46,
   "end": 32.04,
   "text": "خیلی تنبّه میاره، بیداری میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.04,
   "end": 35.96,
   "text": "از که گوشمونو بپیچونن حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.96,
   "end": 41.24,
   "text": "عنوانش اینه علامات الكبر و انما بین الستين الى السبعين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.24,
   "end": 44.12,
   "text": "معترك المنايا و تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.12,
   "end": 48.08,
   "text": "ارذل العمر. بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.08,
   "end": 50.94,
   "text": "ارذل العمر رو اون پست‌ترین حالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.94,
   "end": 57.34,
   "text": "زندگی انسان رو که اصطلاحاً بهش میگن خرف شدن، پیر شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.34,
   "end": 62.18,
   "text": "مطرح می‌کنه که علامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.18,
   "end": 66.14,
   "text": "زیاد شدن عمره، کبر سنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.14,
   "end": 68.8,
   "text": "و البته چند تا روایت رو ایشون میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.8,
   "end": 71.78,
   "text": "حالا متأسفانه من بعضی از کتاب‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.78,
   "end": 75.7,
   "text": "شرح دادن مثلا این کتاب الموت رو دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.7,
   "end": 78.22,
   "text": "عجیب بود برام که چرا این روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.22,
   "end": 80.16,
   "text": "اول باب دوم رو نیاورده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.16,
   "end": 83.8,
   "text": "ما صحبت می‌کنیم درباره‌ش. فعلاً در مقدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.8,
   "end": 87.38,
   "text": "مرحوم مجلسی خودش وقتی این عنوان رو میاره دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.38,
   "end": 91.36,
   "text": "آیه رو میاره اول بعد میره سراغ روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.36,
   "end": 97.58,
   "text": "اول آیه‌ی هفتاد سوره نحل رو بیان می‌کنه که والله خلقكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.58,
   "end": 102.82,
   "text": "خدا شما رو خلق کرده ثم يتوفاکم سپس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.82,
   "end": 105.4,
   "text": "می‌میراند شما رو، توفی می‌‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.4,
   "end": 109.06,
   "text": "همه اون هستی شما که روح شماست رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.06,
   "end": 113.2,
   "text": "و منكم خب این مال کساییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.2,
   "end": 117.08,
   "text": "يتوفاکم عمرشون به سر می‌رسه و تموم می‌شه کارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.08,
   "end": 121.32,
   "text": "اما یه عده‌ای هستند و منكم از شما کسایی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.32,
   "end": 123.16,
   "text": "به این زودی نمی‌میرن. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.16,
   "end": 126.02,
   "text": "يرد الى ارذل العمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.02,
   "end": 131.38,
   "text": "اینا رو خدا می‌کشونه تا اون حالت پست‌ترین حالت عمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.38,
   "end": 136.72,
   "text": "چگونه است خدایا نشونه اون حالت خرف شدن، پیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.72,
   "end": 139.48,
   "text": "اون ارذل العمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.48,
   "end": 145.62,
   "text": "که یه زمانی اینجا یادمه بر اساس آیه پنج سوره حج که الان بهش می‌رسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.62,
   "end": 147.58,
   "text": "ما این رو گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.58,
   "end": 153.36,
   "text": "عزیزان این آلزایمر که امروز میگن چهارصد سال پیش پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.36,
   "end": 156.76,
   "text": "تو قرآنش فرموده حالا فکر می‌کنن هنر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.76,
   "end": 160.0,
   "text": "همینجا داره می‌فرماید لكي لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.0,
   "end": 162.78,
   "text": "چگونه می‌شه که شما به ارذل العمر می‌رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.78,
   "end": 166.16,
   "text": "لا يعلم بعد علم شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.16,
   "end": 170.0,
   "text": "هیچ چیزی یادتون نمیاد. همه چی فراموش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.0,
   "end": 173.1,
   "text": "لا يعلم بعد علم شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.1,
   "end": 177.96,
   "text": "اونم بعد از این که علومی پیدا کردید، آگاهی‌هایی داشتید همه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.96,
   "end": 181.94,
   "text": "این قدرت نمایی پروردگار عظیم الشئنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.94,
   "end": 186.16,
   "text": "که ما اصلاً بهش توجه نمی‌کنیم. فکر می‌کنیم دیگه نه همینی که هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.16,
   "end": 188.62,
   "text": "به قدرت خودمون می‌نازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.62,
   "end": 191.6,
   "text": "همه رو خدا می‌گیره که بکشونت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.6,
   "end": 197.16,
   "text": "عرض کردیم دیگه از کرسی تکبر ما رو بکشونه به زیر، به خشوع بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.16,
   "end": 200.28,
   "text": "بله ان الله عليم قدير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.28,
   "end": 204.38,
   "text": "به به به. همه‌ی اون علیم، اونم شدت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.38,
   "end": 207.9,
   "text": "شدت علمه. همه‌ی علم پیش خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.9,
   "end": 210.76,
   "text": "می‌دونید در نظام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.76,
   "end": 216.4,
   "text": "در نظام وجود یعنی در عینیت وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.4,
   "end": 221.54,
   "text": "یعنی وجود عینی که الان ما درش هستیم خدا علیم یاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.54,
   "end": 224.14,
   "text": "در اعیان ثابته یا ثغء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.14,
   "end": 229.5,
   "text": "ذات حضرت حق یا اون علم خدا، اونجا خدا أعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.5,
   "end": 232.22,
   "text": "در ذات غیب الغیوبش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.22,
   "end": 236.5,
   "text": "در ذات غیب الغیوبش دیگه خدا علمه، عین علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.5,
   "end": 239.38,
   "text": "اینجا علیمه و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.38,
   "end": 242.7,
   "text": "اسمایی که آیات باهاش تموم می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.7,
   "end": 245.24,
   "text": "مطابق با موضوع آیه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.24,
   "end": 251.94,
   "text": "موضوع آیه چی بود؟ این که شما رو می‌کشونه عده‌تون رو زود نمی‌کشه، می‌بره به حالت ارذل العمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.94,
   "end": 254.92,
   "text": "چرا؟ چرا اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.92,
   "end": 257.7,
   "text": "چون عليم قدير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.7,
   "end": 260.38,
   "text": "اولاً همه علم پیش خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.38,
   "end": 264.58,
   "text": "ثانیا قدیر و قدرت نمایی می‌خواد بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.58,
   "end": 268.22,
   "text": "اصلا نگاه کنی این که هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.22,
   "end": 270.78,
   "text": "یه جوری داره می‌میره قدرت نمایی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.78,
   "end": 273.44,
   "text": "همه یه شکل نمی‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.44,
   "end": 279.42,
   "text": "حالا شاید تو حیوانات اینطوری خیلی نباشه ما متوجه نباشیم البته تو اونا هم هست اما خیلی مشهود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.42,
   "end": 283.14,
   "text": "مثل این که حیوانات همه اصلا شبیه به همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.14,
   "end": 286.86,
   "text": "یه گله گوسفند رو بریز همه شبیه همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.86,
   "end": 289.88,
   "text": "مگر از رنگش بشه تشخیص داد اونم به سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.88,
   "end": 292.9,
   "text": "اما انسان نه، هیچکس عین اون یکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.9,
   "end": 299.46,
   "text": "همه با هم متفاوته. آیه بعدی که خیلی پر رمز و رازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.46,
   "end": 303.0,
   "text": "یعنی به واقع جدی دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.0,
   "end": 307.68,
   "text": "مثل همون روایت باب پنجم، باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.68,
   "end": 311.08,
   "text": "اول روایت چهارم که گفتیم یه، یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.08,
   "end": 313.9,
   "text": "می‌طلب واقعا در برابر هفتصد، این آیه همونطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.9,
   "end": 317.66,
   "text": "آیه پنج سوره حج. يا ايها الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.66,
   "end": 321.16,
   "text": "حواستون باشه خدا به همه الناس به همه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.16,
   "end": 325.82,
   "text": "رو می‌کنه و حرف می‌زنه. ان كنتم في ريب من البعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.82,
   "end": 327.38,
   "text": "اگر شما تو شکید از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.38,
   "end": 333.54,
   "text": "که یه روزی مبعوث می‌شید و برانگیخته می‌شید یعنی فکر می‌کنید که همین دنیاست و تموم شد و رفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.54,
   "end": 336.84,
   "text": "زندگی پس از مرگ نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.84,
   "end": 342.0,
   "text": "ظاهراً به اونایی که ظاهراً کافرند اما باطناً هم می‌تونه به ما هم باشه که معتقده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.0,
   "end": 345.9,
   "text": "یعنی خیلی قوی نیست اعتقاداتمون متزلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.9,
   "end": 351.9,
   "text": "که اگر باور داشتیم بعد از این مرگی که زندگی‌ای هست شاید اینطوری زندگی نمی‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.9,
   "end": 354.54,
   "text": "بدونید که فانا خلقناکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.54,
   "end": 357.88,
   "text": "ما شما رو خلق کردیم از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.88,
   "end": 361.06,
   "text": "من تراب. این اولین مرحله‌ی خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.06,
   "end": 363.34,
   "text": "این یه دونه. ما شما رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.34,
   "end": 368.34,
   "text": "خاک، \"من تراب\". \"أبو تراب\" به امیرالمؤمنین میگن پدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.34,
   "end": 372.8,
   "text": "خاک. کأنه او پدر خلق، خ-خلایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.8,
   "end": 376.84,
   "text": "اگر \"إنا فأنا خلقناکم من تراب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.84,
   "end": 382.9,
   "text": "ما را از خاک آفریده و او \"أبو تراب\" است پس پدر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.9,
   "end": 386.12,
   "text": "یادتونه گفتیم \"أبوهم نور وأمهم رحمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.12,
   "end": 389.78,
   "text": "همه به سمت اون پدر و مادر حرکت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.78,
   "end": 392.54,
   "text": "هنگام موت. خب این اولیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.54,
   "end": 394.54,
   "text": "\"ثم من نطفة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.54,
   "end": 396.6,
   "text": "حالا اینا رو بعداً الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 396.6,
   "end": 401.88,
   "text": "تو این جلسه نمیشه جلسه بعد میگیم چه اسراری تو این آیات بعضیش رو عرض می‌کنیم از تفاسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 401.88,
   "end": 403.98,
   "text": "\"ثم من نطفة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.98,
   "end": 409.88,
   "text": "بعد از اینکه شما رو از خاک ایجاد کردیم به مرحله نطفه می‌رسید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.88,
   "end": 412.98,
   "text": "یک حالا بعضیا گفتن مثلاً مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.98,
   "end": 420.82,
   "text": "اصفهانی در مفرداتش میگه آب، آب کم، آب قلیل، خیلی آب یه قطره مثلاً کمتر از قطره به این میگن نطفة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.82,
   "end": 424.38,
   "text": "\"ثم من علقة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.38,
   "end": 427.64,
   "text": "علقه، حالا اینجا خیلی حرف‌ها پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.64,
   "end": 431.14,
   "text": "علقه، حالا خون بسته شده بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.14,
   "end": 436.44,
   "text": "چرا؟ چرا علقه؟ یکی از خوشگل‌ترین حرف‌هایی که اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.44,
   "end": 438.78,
   "text": "معرفت زدن رو بهتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.78,
   "end": 444.02,
   "text": "ببینید ما همه بدون استثناء چه خوب چه بد علائقی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.02,
   "end": 448.4,
   "text": "علقه‌هایی داریم. تعلقاتی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.4,
   "end": 452.88,
   "text": "اصلاً موت یکی از مهم‌ترین فلسفه هاش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.88,
   "end": 455.16,
   "text": "بیاد ما رو از تعلقاتمون بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.16,
   "end": 458.04,
   "text": "قبلاً بحث کردیم کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.04,
   "end": 462.12,
   "text": "تو برزخ زیاد معطل میشه کسیه که تعلقات زیاد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.12,
   "end": 465.0,
   "text": "کسی که کم معطل میشه تعلقاتش کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.0,
   "end": 468.04,
   "text": "کسی که اصلاً تعلق نداره به سرعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.04,
   "end": 473.08,
   "text": "برق برزخ رو طی میکنه چون بالاخره باید عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.08,
   "end": 475.86,
   "text": "مثال رو طی کنه که به عالم عقول برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 475.86,
   "end": 477.66,
   "text": "ولی مثل برق به سرعت برق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.66,
   "end": 485.4,
   "text": "چرا؟ تعلق نداره. پس هر میزان که ما علقه داریم تعلق و وابستگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.4,
   "end": 490.72,
   "text": "در دنیا داریم، همون مقدار توی برزخ گرفتاریم و منتظریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.72,
   "end": 493.38,
   "text": "اینجا می‌فرماید خیلی جالبه \"ثم من علقة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.38,
   "end": 495.62,
   "text": "اصلاً شما یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.62,
   "end": 498.68,
   "text": "علقه‌اید، علاقه‌اید، دلبستگیید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.68,
   "end": 502.04,
   "text": "منتها اینکه به چی دلبستیم مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 502.04,
   "end": 504.0,
   "text": "خیلی یه حدیث شریفی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.0,
   "end": 506.54,
   "text": "حالا این خودش بعداً باید باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 506.54,
   "end": 509.64,
   "text": "دیدم خیلی شریف، خیلی شیرین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.64,
   "end": 514.5,
   "text": "دو نفر یهودی اومدن پیش امیرالمؤمنین علیه الصلاة والسلام مفصله داستانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.5,
   "end": 516.9,
   "text": "و گفتن آقا جون بهشت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 516.9,
   "end": 519.34,
   "text": "جهنم کجاست؟ بهشت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 519.34,
   "end": 524.36,
   "text": "آتش کجاست؟ امیرالمؤمنین فرمودند که \"الجنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.36,
   "end": 527.86,
   "text": "ففي السماء\"، تو آسمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.86,
   "end": 531.04,
   "text": "\"والنار وفي الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.04,
   "end": 534.92,
   "text": "آتش یا جهنم تو زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.92,
   "end": 542.52,
   "text": "بهشت تو آسمونه. حالا حضرت استاد علامه طباطبایی علیه الرحمة خیلی شیرین فرمودن این آسمون رو شما بشکاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.52,
   "end": 545.04,
   "text": "یعنی معرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.04,
   "end": 548.28,
   "text": "نور، رحمت، انبساط خاطر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.28,
   "end": 551.76,
   "text": "حسنات، ها علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.76,
   "end": 555.24,
   "text": "شهادت، شجاعت هرچی که خوبه جنسش از آسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.24,
   "end": 558.34,
   "text": "این بهشتیه. عرض تنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.34,
   "end": 561.5,
   "text": "سجین، شدت سجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.5,
   "end": 564.24,
   "text": "یعنی مبالغهٔ زندانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.24,
   "end": 567.76,
   "text": "به شدت تنگه. اصلاً جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 567.76,
   "end": 571.82,
   "text": "از، آ، از، از شود آتش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.82,
   "end": 573.92,
   "text": "ارضه یعنی چی از زمینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.92,
   "end": 579.06,
   "text": "یعنی هرچی دل ببندی به این زمین و به ما فیها اونچه که در اینجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 579.06,
   "end": 585.14,
   "text": "میشه جهنمت. لذا خیلی عجیب اینجا خدا می‌فرماید که \"ثم من علقة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.14,
   "end": 589.24,
   "text": "اصلاً شما چون قلب دارید و قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.24,
   "end": 592.36,
   "text": "دایره تعلقات شماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 592.36,
   "end": 595.7,
   "text": "باید حواستون جمع باشه که به چی دلبستگی پیدا می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.7,
   "end": 599.58,
   "text": "حرف اول و آخر بعد از موتون اون دلبستگی‌ها میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.58,
   "end": 604.54,
   "text": "که حواستون باشه \"القلب حرم الله لا تسكن حرم الله غيره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.54,
   "end": 607.46,
   "text": "این در حرم الهی چیزی یاد ندی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 607.46,
   "end": 609.48,
   "text": "جا ندید جز الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 609.48,
   "end": 612.58,
   "text": "که متأسفانه ما همه چی جا دادیم جز الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 612.58,
   "end": 615.82,
   "text": "حالا بریم جلوتر. \"ثم من مضغة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 615.82,
   "end": 617.96,
   "text": "چند تا شد؟ خاک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 617.96,
   "end": 620.84,
   "text": "نطفه، علقه، مضغه چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.84,
   "end": 624.3,
   "text": "این چهار جلوه خلقت، مرحله خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 624.3,
   "end": 627.2,
   "text": "که حالا مضغه میگن یه گوشته مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.2,
   "end": 630.02,
   "text": "گوشتی که جویده شده تیکه تیکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 630.02,
   "end": 631.62,
   "text": "بعد چه مضغه‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 631.62,
   "end": 634.84,
   "text": "\"مضغة مخلقة و غير مخلقة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 634.84,
   "end": 638.92,
   "text": "یعنی بعضیاشون ناقص‌اند بعضیاشون کامل‌اند تو این مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 638.92,
   "end": 641.66,
   "text": "\"لنبين لكم\". اینا همش برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 641.66,
   "end": 644.58,
   "text": "که شما رو آگاه کنیم که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 644.58,
   "end": 648.02,
   "text": "\"ونقر في أرحام ما نشاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 648.02,
   "end": 652.18,
   "text": "اون چیزی که یعنی مایییم که در ارحام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 652.18,
   "end": 654.9,
   "text": "استقرار میدیم نطفه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 654.9,
   "end": 657.98,
   "text": "و طفل رو اون حالا از شود جنین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 657.98,
   "end": 661.82,
   "text": "مایییم که استقرار میدیم. همه رو جالبه که با خودش نسبت بده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 661.82,
   "end": 664.08,
   "text": "حالا اینو بعداً بحث می‌کنیم. \"الى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 664.08,
   "end": 666.12,
   "text": "أجل مسمّی\". تا یه وقت مشخصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 666.12,
   "end": 668.42,
   "text": "دست خداست، دست شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 668.42,
   "end": 670.06,
   "text": "\"ثم نخرجکم طفلاً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 670.06,
   "end": 673.74,
   "text": "اینم یه مرحله دیگه. اینجا چند تا شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 673.74,
   "end": 678.04,
   "text": "بشماریم خاک، نطفه، علقه، مضغه چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 678.04,
   "end": 680.28,
   "text": "حالا شد طفله. مرحله بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 680.28,
   "end": 682.7,
   "text": "شد چند تا؟ پنج تا. پنجمی مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 682.7,
   "end": 686.62,
   "text": "\"ثم لتبلغوا أشدكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.62,
   "end": 689.08,
   "text": "بعد شدت می‌گیرید یعنی بالغ میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.08,
   "end": 692.62,
   "text": "اینم مرحله بعد بلوغ. \"ومنكم من يتوفى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 692.62,
   "end": 697.64,
   "text": "اینجا یه، یه عده‌تون کارشون تموم میشه و در همون حالت بلوغ یا جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 697.64,
   "end": 699.4,
   "text": "یا میانسالی از دنیا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 699.4,
   "end": 702.38,
   "text": "اما \"ومنكم من يرد إلى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 702.38,
   "end": 704.5,
   "text": "اینم یه مرحله‌ست. آخرین مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 704.5,
   "end": 706.56,
   "text": "\"إلى أرقل العمر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 706.56,
   "end": 710.32,
   "text": "یه عده‌ای از شما هستن که ما اینا رو نگهشون کارشون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 710.32,
   "end": 713.2,
   "text": "به حالت \"أرقل العمر\" پیری، خرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 713.2,
   "end": 715.24,
   "text": "بودن، می-نگ-می‌کشونیمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 715.24,
   "end": 717.96,
   "text": "\"لكي لا يعلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 717.96,
   "end": 721.84,
   "text": "من بعد علم شيء\". باز همون چیزی که تو سوره نحل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 721.84,
   "end": 724.08,
   "text": "پس همه چی رو فراموش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 724.08,
   "end": 729.4,
   "text": "\"وتلq أرض خامدة فإذا أنزلنا عليها الماء اهتزت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 729.4,
   "end": 733.04,
   "text": "ندیدید وقتی ما آبرو نازل می‌کنیم زمین خشک یه دفعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 733.04,
   "end": 735.44,
   "text": "اِمم، سرسبز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 735.44,
   "end": 737.4,
   "text": "\"وربت وأنبتت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 737.4,
   "end": 739.54,
   "text": "این نباتات رشد می‌کنند، نمو می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 739.54,
   "end": 741.2,
   "text": "\"من كل زوج بهيج\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 741.2,
   "end": 744.74,
   "text": "چه شیرین زوج. زوجیت در نباتات هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 744.74,
   "end": 750.24,
   "text": "نر و مادگی به یک معنا. این‌ها رو شما نگاه کنید مطمئن شید که بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 750.24,
   "end": 753.56,
   "text": "حالا نو-- یه یکی دو تا نکته بگم وقت گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 753.56,
   "end": 756.8,
   "text": "سریع بگم یا یه دونه بگم والا فردا دیگه وقت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 756.8,
   "end": 759.66,
   "text": "یکی از مهم‌ترین چیزهایی که اینجا داره میگه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 759.66,
   "end": 762.76,
   "text": "آخرین بحثی که پیرامون موت داشتیم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 762.76,
   "end": 765.7,
   "text": "آنفاً ما در حال اماته و احیا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 765.7,
   "end": 767.52,
   "text": "در معرض اماته و احیا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 767.52,
   "end": 770.72,
   "text": "به توسط مجاری اون یعنی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 770.72,
   "end": 775.7,
   "text": "عزرائیل احیا، حضرت عزرائیل اماته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 775.7,
   "end": 779.98,
   "text": "اینجا ببینید هر مرحله اماته رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 779.98,
   "end": 782.48,
   "text": "میری به مرحله بعد احیا رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 782.48,
   "end": 786.2,
   "text": "یعنی فقط موت یه دونه نیست در انتهای دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 786.2,
   "end": 788.72,
   "text": "همه این هفت مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 788.72,
   "end": 792.3,
   "text": "اولش احیا داره انتهاش اماته داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 792.3,
   "end": 794.62,
   "text": "یعنی باز نزدیک میشیم به این چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 794.62,
   "end": 797.38,
   "text": "به این حقیقت که دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 797.38,
   "end": 803.68,
   "text": "ما در معرض اماته و احیا ایم و اینم قدرت نمایی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 803.68,
   "end": 805.98,
   "text": "لذا آخر اون آیه فرمود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 805.98,
   "end": 808.68,
   "text": "\"إن الله عليم قدير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 808.68,
   "end": 812.8,
   "text": "قدرت نمایی خداست. چشمامونو باز کنیم به روی قدرت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 812.8,
   "end": 815.58,
   "text": "از تکبر بیاییم به زیر، به خشوع بیفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 815.58,
   "end": 820.08,
   "text": "ان‌شاءالله لقاء 好 的 ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 820.08,
   "end": 828.46,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}