 "chapters": [
  {
   "index": 0,
   "title": "## روایت چهارم کتاب الموت؛ دقت در هر کلمه",
   "start": 13.18,
   "end": 44.08
  },
  {
   "index": 1,
   "title": "## ترک الجسد؛ فساد بدن پس از انصراف روح",
   "start": 44.08,
   "end": 64.18
  },
  {
   "index": 2,
   "title": "## پر کردن شکم و خالی کردن؛ گرفتاری جسمیت",
   "start": 64.18,
   "end": 87.28
  },
  {
   "index": 3,
   "title": "## رَدّت روح و نور؛ قوس نزول و صعود",
   "start": 87.28,
   "end": 156.44
  },
  {
   "index": 4,
   "title": "## مثل دوقلو در رحم؛ دنیا رحم دوم",
   "start": 156.44,
   "end": 340.08
  },
  {
   "index": 5,
   "title": "## چرا اموات کمتر به خواب می‌آیند؛ فاصلهٔ عوالم",
   "start": 340.08,
   "end": 532.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 4.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.98,
   "end": 8.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.5,
   "end": 12.96,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.96,
   "end": 19.08,
   "text": "در ادامه روایت چهارم از باب اول کتاب الموت مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.08,
   "end": 25.86,
   "text": "خب چون انقدر این عبارات دقیقه و درون مایه عجیبی داره دلم نمیاد رد شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.86,
   "end": 29.04,
   "text": "هر کلمه به کلمه جملاتشو دقت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.04,
   "end": 31.04,
   "text": "من بی‌سواد باید یه ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.04,
   "end": 34.06,
   "text": "شب با این یه، یه روایت منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.06,
   "end": 37.22,
   "text": "چله‌ای استخون‌دار برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.22,
   "end": 41.08,
   "text": "اهلش باید یک سال با این روایت منبر برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.08,
   "end": 43.72,
   "text": "واقعاً درون مایه عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.72,
   "end": 49.64,
   "text": "حالا یکی دیگه از کلمات که باید ما بهش توجه کنیم در این روایت که معنای موت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.64,
   "end": 54.84,
   "text": "جدا شدن شأن اخروی از شأن دنیوی بیان کرده، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.84,
   "end": 61.14,
   "text": "ترك الجسد که انما و انما فسد الجسد في الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.14,
   "end": 63.66,
   "text": "وقتی که ترک کرد روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.66,
   "end": 67.54,
   "text": "جسد رو، چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.54,
   "end": 71.34,
   "text": "فاسد میشه جسد در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.34,
   "end": 73.06,
   "text": "و برمی‌گرده به چرخه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.06,
   "end": 79.66,
   "text": "چون جسد ما از نون و آبی‌ست که پدر مادر خوردن و اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.66,
   "end": 83.08,
   "text": "مرتبه جمادیه. انزل مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.08,
   "end": 85.12,
   "text": "دنیه، دنیویه، پسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.12,
   "end": 87.28,
   "text": "باید بمونه همین جا جسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.28,
   "end": 89.74,
   "text": "نکته اینجاست که وقتی روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.74,
   "end": 94.72,
   "text": "نفس ناطقه اصطلاحاً اعلام انصراف از بدن و جسم کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.72,
   "end": 96.8,
   "text": "بدن دیگه چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.8,
   "end": 100.78,
   "text": "قبل از غسل حتی دست بهش بزنی غسل بهت واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.78,
   "end": 104.68,
   "text": "قبل از اینکه غسلش بدن میت رو دست بهش بزنی به تو غسل واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.68,
   "end": 106.82,
   "text": "ببین چقدر شأنش میاد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.82,
   "end": 113.92,
   "text": "بعدم که می‌پوسه و یکی از دلایلی که سوم، هفتم، چهلهم سال اینا می‌گیرن اینه که روح میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.92,
   "end": 118.46,
   "text": "توجه به عالم قبرش، حالا اون قبر فقهیش البته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.46,
   "end": 126.12,
   "text": "می‌بینه بدنش داره می‌پوسه. حتی امام صادق در توحید مفضل میگه اول چه قسمتی می‌پوسه بعد کجا میپاچه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.12,
   "end": 129.46,
   "text": "چ-چشم یا اون می‌ترکه میریزه حدقه چشم میریزه رو گونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.46,
   "end": 133.14,
   "text": "یه وضعی. میت می‌بینه حالش به هم می‌خوره از این وضعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.14,
   "end": 136.68,
   "text": "د-چون دلبسته بوده به این بدن یک عمر باهاش بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.68,
   "end": 139.98,
   "text": "حالش گرفته میشه به قول ما. اونجا میگن یادش کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.98,
   "end": 144.6,
   "text": "مثلاً آرامش پیدا کنه. به هر حال این نکته اساسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.6,
   "end": 147.74,
   "text": "اِاِاِ شعنیت جسم از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.74,
   "end": 150.04,
   "text": "در صورتی که متاسفانه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.04,
   "end": 152.96,
   "text": "غالباً داریم همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.96,
   "end": 155.44,
   "text": "زحماتمونو برای این جسم می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.44,
   "end": 160.26,
   "text": "به قول حضرت استاد علامه حسن زاده علیه الرحمه معمولاً توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.26,
   "end": 162.14,
   "text": "دروسشون اینو می‌فرمودن جسارتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.14,
   "end": 165.7,
   "text": "می‌فرمود کارمون شده پر کردن شکمو خالی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.7,
   "end": 168.22,
   "text": "یه شکمی پر کنیم خالی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.22,
   "end": 171.42,
   "text": "این جسمیت ما که متاسفانه ما رو گرفتار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.42,
   "end": 174.04,
   "text": "حالا برداشت‌های اخلاقی که خودتون از این می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.04,
   "end": 178.78,
   "text": "نکته خیلی مهم‌تر از این فردته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.78,
   "end": 181.46,
   "text": "فردت روح و نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.46,
   "end": 184.38,
   "text": "این رد شدن روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.38,
   "end": 187.24,
   "text": "و که جالبه چرا روح و نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.24,
   "end": 189.64,
   "text": "حالا عرض می‌کنیم اگه فرصت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.64,
   "end": 191.6,
   "text": "اینا رد میشن میرن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.6,
   "end": 194.2,
   "text": "برگشت داده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.2,
   "end": 196.58,
   "text": "روح ما و اون ارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 196.58,
   "end": 199.4,
   "text": "چرا برگشت داده؟ چرا ر-ردت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 199.4,
   "end": 202.5,
   "text": "به جهت اینکه معلومه ما از اونجا اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 202.5,
   "end": 204.32,
   "text": "یعنی این برگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 204.32,
   "end": 209.8,
   "text": "انا لله قوس نزول اومدیم از الله حالا و انا الیه راجعون قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 209.8,
   "end": 212.34,
   "text": "یعنی نشون میده که ما اونجایی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 212.34,
   "end": 215.36,
   "text": "اصلاً مال اونجاییم دو مرتبه برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 215.36,
   "end": 217.5,
   "text": "دور برگردونه. موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 217.5,
   "end": 220.06,
   "text": "برمی‌گردیم به اصلیتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 220.06,
   "end": 222.64,
   "text": "بعد نمی‌خوایم، دوست نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 222.64,
   "end": 225.58,
   "text": "هی خط-- ترس داریم از رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 225.58,
   "end": 232.42,
   "text": "حالا به قول حضرت استاد در فکر می‌کنم اگه اشتباه نکنم صد-- جلسه صد و هفتاد شرح فصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 232.42,
   "end": 234.68,
   "text": "حضرت استاد می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 234.68,
   "end": 237.38,
   "text": "خیلی جالب. می‌فرمودن شما توجه کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 237.38,
   "end": 239.08,
   "text": "حتی کلیپ تصویریش هم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 239.08,
   "end": 242.46,
   "text": "ایشون از قبرستان داشت برمی‌گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 242.46,
   "end": 245.3,
   "text": "فامیل‌ها و همسر اینا دورشو گرفته بودن تو ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 245.3,
   "end": 248.5,
   "text": "ایشون اونجا می‌فرمود این نکته جالبو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 248.5,
   "end": 253.42,
   "text": "می‌فرمود که شما گمان کنید یه دوقلویی در رحم مادرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 253.42,
   "end": 257.02,
   "text": "چون این دنیا در احادیث به منزله رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 257.02,
   "end": 260.02,
   "text": "برای آخرت. خب بهش میگن رحم دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 260.02,
   "end": 262.22,
   "text": "الان ما در رحم دوم قرار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 262.22,
   "end": 272.84,
   "text": "رحم اول رحم مادر بود که از اسم الرحمن حق منشعب شده و اگر کسی بی‌حرمتی به اون رحم اول بکنه از رحمت خدا به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 272.84,
   "end": 276.44,
   "text": "رحم مادر از اسم الرحمن روایت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 276.44,
   "end": 281.64,
   "text": "خیلی مقدسه. حالا اونجا باز مباحث اخلاقی پیش مد بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 281.64,
   "end": 287.96,
   "text": "که اونجا حضرت علامه فرمودن گمان کنید یه دوقلویی توی رحم اول مادرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 287.96,
   "end": 290.02,
   "text": "بعد یکیشون زودتر به دنیا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 290.02,
   "end": 295.74,
   "text": "پیش میاد دیگه. اون اولیه که اون تو مونده میگه وای خاک بر سرم چه مصیبت بزرگی!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 295.74,
   "end": 299.3,
   "text": "برادرم از دستم رفتی خواهرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 299.3,
   "end": 301.3,
   "text": "از بین رفتی، مردی فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 301.3,
   "end": 305.28,
   "text": "ها اینطوریه حضرت علامه می‌فرمایند خیلی مثال شیرین و خوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 305.28,
   "end": 311.14,
   "text": "بعد اینکه از رحم اول اومده بیرون تو رحم دوم یعنی دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 311.14,
   "end": 313.78,
   "text": "فریاد می‌زنه میگه برادرم کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 313.78,
   "end": 316.58,
   "text": "خواهرم کجایی؟ ببینی اینجا چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 316.58,
   "end": 320.46,
   "text": "ما اونجا تو یه جای زیگ چنبات مزده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 320.46,
   "end": 322.64,
   "text": "خون مادر می‌خوردیم. چه می‌فهمیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 322.64,
   "end": 325.14,
   "text": "چلو کباب چیه؟ جوجه کباب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 325.14,
   "end": 331.28,
   "text": "استخر اینا چیه؟ بعد اونجا جای به اون تنگی، نموری، تاریکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 331.28,
   "end": 333.3,
   "text": "کیف می‌کنه بچه اون تو ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 333.3,
   "end": 337.34,
   "text": "وقتی میاد اینجا کره مریخ هم بهش بدن باز میگه کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 337.34,
   "end": 340.08,
   "text": "اینطور نیست خدابه‌وکلی؟ هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 340.08,
   "end": 346.2,
   "text": "یکی از-- میگه آخه بعضیا اشکال می‌کنن آقا چطور یک باغی که به بهشت میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 346.2,
   "end": 348.76,
   "text": "وسعتش به اندازه آسمان‌ها و زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 348.76,
   "end": 350.6,
   "text": "هم تو آیات قرآن داریم هم روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 350.6,
   "end": 353.18,
   "text": "می‌خوای چه کنی؟ یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 353.18,
   "end": 356.84,
   "text": "چند حس به ما تو بهشت بدن بس مثلاً بعضیا اینطوری میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 356.84,
   "end": 359.82,
   "text": "بگو چطور تو همین دنیا که هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 359.82,
   "end": 367.28,
   "text": "مثلاً اون خانمی که اخبار گفت اسمشو نگفت ولی گفت جنوب تهران سه هزار واحد مسکونی خالی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 367.28,
   "end": 369.1,
   "text": "اینا؟ چهار هزار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 369.1,
   "end": 371.9,
   "text": "حالا چهار هزار. دیگه بدتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 371.9,
   "end": 373.72,
   "text": "حالا اینا البته معلوم نیست مال کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 373.72,
   "end": 378.22,
   "text": "اومدن به نام ایشون بدبخت زدن مثلاً ده تا واحدو به نام ایشون زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 378.22,
   "end": 381.72,
   "text": "همه رو به نام ایشون زدن. ده تا به خودش بخشیدن که صداش درنیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 381.72,
   "end": 385.28,
   "text": "این چیزا هم پیش میاد بماند. سیاسی حرف نزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 385.28,
   "end": 388.26,
   "text": "اما در هر حال میگه آقا کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 388.26,
   "end": 389.88,
   "text": "پاشو بیا ببین اینجا چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 389.88,
   "end": 393.54,
   "text": "وفور نعمته. اینا سبزه زار و این همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 393.54,
   "end": 398.86,
   "text": "اینطور نیست؟ دقیقاً یه همچین اتفاقی وقت موت میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 398.86,
   "end": 402.04,
   "text": "خروج ما از این رحم دوم برای آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 402.04,
   "end": 405.12,
   "text": "وقتی میری میگی چه خبره، چه غوغایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 405.12,
   "end": 411.52,
   "text": "اصلا یه دلیلی که معمولاً اموات ما به خواب ما نمیان یک دلیلش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 411.52,
   "end": 414.44,
   "text": "خیلی کم میان. یه دلیلش اینه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 414.44,
   "end": 416.06,
   "text": "دلایل دیگه ای داره که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 416.06,
   "end": 419.2,
   "text": "اینه که میگن غرق در اون وسعت رحمت میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 419.2,
   "end": 427.68,
   "text": "اصلاً قابل قیاس نیست. فاصله این دنیا با اون دنیا که اون عالمه تازه مثال رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 427.68,
   "end": 433.68,
   "text": "حالا میگیم بهشت و برزخ مثالی و برزخی تازه اون اصل عالم مفارقات و ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 433.68,
   "end": 436.4,
   "text": "و ملائکه و بعدش تازه قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 436.4,
   "end": 438.6,
   "text": "اونا رو تازه نمیگیم. همین م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 438.6,
   "end": 443.56,
   "text": "یه، یه پله برو رتبه بالاتر از یا پنهانی‌تر بهتره بگیم از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 443.56,
   "end": 447.2,
   "text": "امام، امام صادق قربونش بریم فرموده مثل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 447.2,
   "end": 450.16,
   "text": "مثل فاصله بین یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 450.16,
   "end": 453.06,
   "text": "ریگ در دل بیابان لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 453.06,
   "end": 457.54,
   "text": "ببینید چه فاصله‌ای داره این رحم با اون جایی که قراره بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 457.54,
   "end": 459.54,
   "text": "موت یه همچین کاری میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 459.54,
   "end": 462.36,
   "text": "بعد می فرماید فردت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 462.36,
   "end": 465.26,
   "text": "این برمی‌گرده به جای اصلیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 465.26,
   "end": 467.94,
   "text": "اونجا آه میکشه و چه جالب توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 467.94,
   "end": 473.14,
   "text": "قرآن می فرماد اهل ایمان اونایی که اونجا غرق نعمتن میگن ای کاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 473.14,
   "end": 476.02,
   "text": "حالا عبارت عربیش الان تو ذهنم نیست و اشتباه بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 476.02,
   "end": 482.92,
   "text": "تو صریح آیه قرآنه. فرمود ای کاش فامیلای من قوم و خویشم بودن میدیدن چگونه خدا منو غرق در نعمت‌هاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 482.92,
   "end": 485.52,
   "text": "چه خبره اینجا. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 485.52,
   "end": 487.72,
   "text": "دقیقاً همچین اتفاقی میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.72,
   "end": 490.14,
   "text": "ما نگاهمون باید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 490.14,
   "end": 494.12,
   "text": "موت کاملاً یه گردش صد و هشتاد درجه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 494.12,
   "end": 498.06,
   "text": "متأسفانه اصلاً و ابداً اطلاعاتمون نسبت به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 498.06,
   "end": 500.92,
   "text": "درست نیست. نمی‌دون-- نمیگم مکفی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 500.92,
   "end": 503.2,
   "text": "بلکه اصلاً غلطه، درست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 503.2,
   "end": 506.54,
   "text": "اگر اینطور بود درست بود میشد \"فَتَمَنَّوَا الْمَوْتَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 506.54,
   "end": 510.96,
   "text": "إِنْ كُنْتُمْ صَادِقِينَ\". اگه صادقید بسم الله عاشق مرگ بشید مثل شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 510.96,
   "end": 515.2,
   "text": "حالا بعد دیگه بحث اینکه چرا روح با نور اینجا با هم اومده، روح و نور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 515.2,
   "end": 517.16,
   "text": "این خودش یه جلسه می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 517.16,
   "end": 519.38,
   "text": "بعد \"إِلَى الْقُدْرَةِ الْقُدْسِ الْعُلَى\" چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 519.38,
   "end": 522.5,
   "text": "اینا هر کدوم یه جلسه انشاالله اجازه بدید بعدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 522.5,
   "end": 527.14,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 527.14,
   "end": 530.44,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 530.44,
   "end": 532.98,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}