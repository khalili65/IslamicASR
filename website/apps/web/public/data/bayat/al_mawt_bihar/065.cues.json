 },
 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ یونس؛ رجاء لقا و اطمینان دنیا",
   "start": 15.9,
   "end": 68.38
  },
  {
   "index": 1,
   "title": "## غفلت از آیات تا آیت کبرا",
   "start": 68.38,
   "end": 188.42
  },
  {
   "index": 2,
   "title": "## سند روایی؛ ما لله آیة أکبر منی",
   "start": 188.42,
   "end": 693.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.58,
   "end": 6.92,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.92,
   "end": 9.74,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.74,
   "end": 11.88,
   "text": "و ربانیة آ یا سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.88,
   "end": 15.1,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.1,
   "end": 18.06,
   "text": "عرض کردیم که در ابتدای باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.06,
   "end": 21.22,
   "text": "کتاب الموت مرحوم مجلسی علیه الرحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.22,
   "end": 23.64,
   "text": "یه چند تا آیه رو ایشون آورده تفسیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.64,
   "end": 27.02,
   "text": "ما در آیه هفت و هشت سوره یونس بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.02,
   "end": 32.16,
   "text": "اینجا توقف کردیم که ان الذین لا یرجون لقاءنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.16,
   "end": 36.02,
   "text": "ورضوا بالحیاة الدنيا وطمأنهم بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.02,
   "end": 42.3,
   "text": "قطعاً اونایی که حالا ظاهر عبارت میگه اونی که امید به لقای ما ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.3,
   "end": 44.84,
   "text": "اما من در تفسیر اهل بیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.84,
   "end": 48.18,
   "text": "نگاه کردم حدیثی پیدا کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.18,
   "end": 51.54,
   "text": "فرمودن تأویل کردن این منظور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.54,
   "end": 53.56,
   "text": "لا یرجون لقاء الله یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.56,
   "end": 55.88,
   "text": "اصلا ایمان ندارن به دیدار ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.88,
   "end": 57.82,
   "text": "اصلا قبول ندارن، باور ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.82,
   "end": 63.1,
   "text": "اگرچه شاکله ظاهری‌شون، هیأت و کصفت‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.1,
   "end": 66.6,
   "text": "ظاهراً دیندار باشه. اما چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.6,
   "end": 68.38,
   "text": "چرا قبول ندارن؟ ایمان ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 68.38,
   "end": 75.22,
   "text": "چون ورضوا بالحیاة الدنيا وطمأنهم بها اطمینان‌شون، آرامش‌شون با دنیاست که بحثش گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.22,
   "end": 79.42,
   "text": "و این‌ها به دنیا اکتفا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.42,
   "end": 81.74,
   "text": "می خوام امروز به فضل الله این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 81.74,
   "end": 86.98,
   "text": "خطر رو گوشزد کنم به خودم، حدیث نفس بخونم و دوستان خوبم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.98,
   "end": 89.22,
   "text": "که حرف من که نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.22,
   "end": 93.18,
   "text": "آیه قرآن می‌خونم. والذین وقتی که اینطوری شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.18,
   "end": 96.62,
   "text": "کار به کجا می‌کشه؟ با توجه به دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.62,
   "end": 99.52,
   "text": "دلبستگی به دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.52,
   "end": 105.14,
   "text": "کار به جایی می‌رسه که والذین هم عن آیاتنا غافلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.14,
   "end": 109.74,
   "text": "به بحث غفلت از آیات الهی کار کشیده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.74,
   "end": 116.78,
   "text": "و این غفلت آیات رو-- آیاتی رو که میگه آیاتنا همه آیات ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.78,
   "end": 121.22,
   "text": "رفته رفته از همین آیه های کوچیک الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.22,
   "end": 124.32,
   "text": "شروع می‌شه غفلت کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.32,
   "end": 130.9,
   "text": "آسمان و زمین همین زمینی که الان روشیم آیات الله دیگه با بارها اینو بحث کردیم تا برو به خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.9,
   "end": 132.88,
   "text": "نفس ناطقه خودت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.88,
   "end": 135.08,
   "text": "آیات بزرگ الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.08,
   "end": 139.36,
   "text": "تا انسان کامل یا حضرت ولی عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.36,
   "end": 142.42,
   "text": "حالا خدا خیر بده به یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.42,
   "end": 148.76,
   "text": "کارشناسای خیلی خوب و دوست داشتنی ما تو یکی از برنامه‌های سحر حرفای خیلی عالی خوبی زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.76,
   "end": 151.08,
   "text": "من توجه می‌کردم، گوش می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.08,
   "end": 154.02,
   "text": "یکی از شبکه‌های اسلامی ایران خیلی خوب بود استفاده می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.02,
   "end": 157.52,
   "text": "یه روز متاسفانه یه حرف بدی زد ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.52,
   "end": 164.56,
   "text": "من احساس تکلیف می‌کنم اینو حداقل برای دور و بری‌هام تبیین کنم که ایشون فرمودن ما نباید بگیم انسان کامل چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.56,
   "end": 168.44,
   "text": "ما احساس می‌کنیم ناقصیم. خب بله ناقصیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.44,
   "end": 171.9,
   "text": "نگیم انسان کامل که ما احساس نا-- نقص نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.9,
   "end": 174.34,
   "text": "اتفاقا باید بگیم انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.34,
   "end": 179.9,
   "text": "که بدونیم ما ناقصیم. ما اصلا سیر استکمالی‌مون از نقص به کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.9,
   "end": 184.58,
   "text": "تمام کمال. از سن-- از نقص داریم به سمت کمال حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 184.58,
   "end": 188.42,
   "text": "حالا این خودش یه بحث مبسوطی می‌طلبه به وقتش انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.42,
   "end": 193.76,
   "text": "در تفاسیر اهل بیت، در تفسیر اهل بیت که خودش یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.76,
   "end": 197.4,
   "text": "توصیه کردم بارها این تفاسیر روایی رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.4,
   "end": 200.86,
   "text": "جلد شش، صفحه چهارصد و بیست و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.86,
   "end": 202.78,
   "text": "البته این روایت رو قبلاً من رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.78,
   "end": 205.26,
   "text": "زبانم بارها جاری کردم. حالا دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.26,
   "end": 207.8,
   "text": "س-سندش، مدرکش رو به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.8,
   "end": 211.84,
   "text": "اتفاقاً ذیل همین آیه هفت سوره یونس این روایت وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.84,
   "end": 220.66,
   "text": "علی ابن ابراهیم نقل می‌کنه که در خصوص این والذین هم عن آیاتنا غافلون این به کجا کشیده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.66,
   "end": 229.04,
   "text": "این غفلت از آیات الهی، از همین آیات جزئی که همشون عظیم‌اند می‌رسه تا اون آیت اعظم الهی، آیت کبرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.04,
   "end": 233.7,
   "text": "بزرگ‌ترین آیه که حضر-- که فرمودن امیر المؤمنین والایمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.7,
   "end": 237.72,
   "text": "این متنشه. امیر المؤمنین والایمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.72,
   "end": 248.04,
   "text": "اینا دلالت بر یعنی ذیل همون آیه دارن که فرمایش امیرالمؤمنین رو میاره اینجا علی ابن ابراهیم که و ما لله آیتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.04,
   "end": 254.64,
   "text": "آیه ای برای الله که اسم جامع خداست نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.64,
   "end": 260.06,
   "text": "که فرمود حالا توی روایت میگه هیه اکبر مني یه جا هیه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.06,
   "end": 263.06,
   "text": "تو اینجا هیه نداره. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.06,
   "end": 267.54,
   "text": "اکبر مني. هیچ آیه ای خدا نداره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.54,
   "end": 272.54,
   "text": "بزرگ‌تر از من باشه. یعنی بزرگ‌ترین آیت الهی کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.54,
   "end": 275.56,
   "text": "انسان کامله. امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.56,
   "end": 279.58,
   "text": "نتیجه، قربونتون برم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.58,
   "end": 285.16,
   "text": "چسبیدن به دنیا و غفلت و غفلت از یاد آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.16,
   "end": 288.6,
   "text": "و هم و غم انسان بشه به دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.6,
   "end": 292.88,
   "text": "اطمینان حاصل کنه. یعنی آرامش خاطرش با اینه که جیبش پول باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.88,
   "end": 295.78,
   "text": "آرامش خاطرش اینه که دنیاش کوک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.78,
   "end": 298.12,
   "text": "اینا خطر زنگ‌های خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.12,
   "end": 302.96,
   "text": "آرامشش در مناجات با خدا و ارتباط به اهل بیت و توجه به قرآن این‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.96,
   "end": 305.52,
   "text": "اینوری شده از این ور بوم افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.52,
   "end": 309.44,
   "text": "خب این آ-- انسان رو قطعاً می‌کشونه به جایی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.44,
   "end": 311.7,
   "text": "امام زمانش غافل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.7,
   "end": 315.7,
   "text": "شما فکر می‌کنید آدمایی که جلوی امیرالمؤمنین وایسادن مسلمان، آدمای چی بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.7,
   "end": 321.06,
   "text": "یهو-- مثلاً چی بگم؟ غیر مسلمون بودن، نماز نخون بودن، مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.06,
   "end": 326.0,
   "text": "اینطوری شما اینطوری فکر می‌کنید در صورتی که می‌رید می‌بینید همه اهل نماز شب بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.0,
   "end": 331.08,
   "text": "امام حسین و نماز شب خونا و قرآن-- قاریان قرآن خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.08,
   "end": 334.88,
   "text": "ربما تال القرآن والقرآن یلعنا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.88,
   "end": 342.48,
   "text": "چه بسا آیه-- حدیث قرآن-- حدیث صریح اهل بیت که چه بسا کسی که قرآن می‌خونه قرآن لعنش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.48,
   "end": 345.18,
   "text": "یعنی حب به دنیا داره. آخه توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.18,
   "end": 351.18,
   "text": "چقدر من این روایات دیدم و دل-- از جوونی الحمد لله تن و بدنم لرزیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.18,
   "end": 355.66,
   "text": ". در جواهر الثنیه خیلی حدود بیست سی سال پیش می‌خوندم که مرحوم شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.66,
   "end": 360.54,
   "text": "راملی میاره میگه که یک جوونی خیلی تو سجده خیلی حال و حوشی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.54,
   "end": 364.64,
   "text": "مثل خیلی از ماها به دفعه فکر سیممون می‌چسبه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.64,
   "end": 367.98,
   "text": "میگیم دیگه رفتیم آسمون هفتم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.98,
   "end": 369.64,
   "text": "دیگه تو آغوش امام زمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.64,
   "end": 375.08,
   "text": "یه حالاتی دست میده ها. امر مشتبه میشه فکر می‌کنه خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.08,
   "end": 377.48,
   "text": "این حضرت موسی خیلی خوشش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.48,
   "end": 379.22,
   "text": "گفت عجب چه حال خوشی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.22,
   "end": 382.9,
   "text": "خوش به حالش اینا. خدا بهش فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.9,
   "end": 387.16,
   "text": "توجه به این حالش نکن، به این سجده طولانیش نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.16,
   "end": 390.58,
   "text": "اگه همین الان قبض روح بشه در بدترین جاهای جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.58,
   "end": 392.3,
   "text": "خیلی برای حضرت موسی تعجب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.3,
   "end": 395.5,
   "text": "بابا این با این حالش. خیلی نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.5,
   "end": 398.64,
   "text": "بترسونه ما‌ها رو ها عزیزان دلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.64,
   "end": 401.86,
   "text": "بعد خب از خدا دلیلش رو خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.86,
   "end": 409.1,
   "text": "خدا فرمود موسی اگه همین الان دوراهی پیش بیاد، حالا من لطیفانه بیان خدا رو بر ای بیان می‌کنم، عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.1,
   "end": 411.88,
   "text": "دوراهی پیش بیاد دنیا و آخرت این میره سمت دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.88,
   "end": 413.66,
   "text": "این دلبسته به دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.66,
   "end": 416.66,
   "text": "خوشش میاد از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.66,
   "end": 419.46,
   "text": "این دنبال دنیاش. اصلا دینشو برای دنیاش می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.46,
   "end": 424.5,
   "text": "این، این تعبیر بنده‌ست. اون سجده‌ای که می‌بینی داره زار می‌زنه برای دنیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.5,
   "end": 426.58,
   "text": "از من خدا دنیاشو داره طلب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.58,
   "end": 431.62,
   "text": "اینا خیلی خطرناکه ها. لیلة القدر که امضا شد، امضا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.62,
   "end": 434.58,
   "text": "امضای حجت بن الحسن پای نامه اول ما خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.58,
   "end": 437.24,
   "text": "آیا به نظر شما از زبیر من اهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.24,
   "end": 440.9,
   "text": "اهل البيت امضای امیرالمؤمنین بود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.9,
   "end": 443.82,
   "text": "زبیر از ما اهل بیته امضای مولا علی بود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.82,
   "end": 445.94,
   "text": "چرا این امضا خطش دار شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.94,
   "end": 450.28,
   "text": "چرا حذف شد؟ یمحو الله ما یشاء و یثبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.28,
   "end": 452.36,
   "text": "لوح محو و اثبات داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.36,
   "end": 455.2,
   "text": "امام عصر اثبات می‌کنه برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.2,
   "end": 458.94,
   "text": "ثبت می‌کنه اما ما محوش می‌کنیم با گناهانمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.94,
   "end": 461.6,
   "text": "خیلی باید فرق باشه بین مایی که توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.6,
   "end": 465.22,
   "text": "ترس، خطر، امر خطیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.22,
   "end": 469.38,
   "text": "مایی که تو این لباسیم. مایی که نماد دینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.38,
   "end": 474.48,
   "text": "چهارشنبه‌ای عرض کردم مخصوصا تو این جماعت که بنده الان نشستم تنم و دلم می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.48,
   "end": 478.3,
   "text": "قیافه‌های شما رو می‌بینم هر کدومتون یه نمادی از دینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.3,
   "end": 481.74,
   "text": "هرکی شما رو ببینه میگه اوه، اوه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.74,
   "end": 484.0,
   "text": "بریم بهش التماس دعا بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 484.0,
   "end": 488.28,
   "text": "درسته؟ غیر از اینه؟ خیلی فرق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.28,
   "end": 491.22,
   "text": "که بعد خطرات ما خیلی بدتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.22,
   "end": 494.74,
   "text": "به قول بچه‌های جنگ یادش بخیر می‌گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.74,
   "end": 498.3,
   "text": "یه آدم غیر مسلمون غیبت ما رو بکنه خیلی راحت‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.3,
   "end": 500.4,
   "text": "بگه فلانی این کارو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.4,
   "end": 504.34,
   "text": "ولی مسلمون متاسفانه این دین دارا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.34,
   "end": 507.7,
   "text": "این ریش و تسبیح به دستا خدا نکنه غیبت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.7,
   "end": 511.48,
   "text": "اول اثبات می‌کنن که ما فاسدیم، ما فاسقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.48,
   "end": 513.26,
   "text": "بعد بگن خب دیگه غیبت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.26,
   "end": 516.34,
   "text": "فاسق و فاسد غیبت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.34,
   "end": 523.46,
   "text": "من یک بار ندیدم حضرت امام علیه الرحمه به یه کسی که دیگه گنده ما، زعیم ما، بزرگ ما، یه رهبرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.46,
   "end": 526.66,
   "text": "شما شنیدید یک بار برگرده بگه آقا شما نمی‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.66,
   "end": 530.2,
   "text": "مثلا بهش اشکالی بشه بگه آقا شما این راه درست نیست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.2,
   "end": 532.78,
   "text": "بگه مثلا این مدیریت شما تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 532.78,
   "end": 537.62,
   "text": "نظام درست نیست فلان یا هرچی بگه آقا من کارایی دارم می‌کنم شما نمی‌فهمید در آینده می‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.62,
   "end": 540.56,
   "text": "شما نمی‌فهمید من می‌فهمم. تا حالا دیدین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.56,
   "end": 546.92,
   "text": "الان مدیرای حزب اللهی ما بهش رو‌جو می‌کنی اشکال صد درصدی‌شو بهش میدی میگه آقا شما نمی‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.92,
   "end": 549.08,
   "text": "این اشکال از کجاست به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 549.08,
   "end": 551.16,
   "text": "به نظر شما اینا از کجا داره آب می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.16,
   "end": 553.84,
   "text": "از حب به دنیا، حب به ریاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.84,
   "end": 556.52,
   "text": "حب به میز. کی می‌خوایم به خودمون بیاییم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 556.52,
   "end": 561.26,
   "text": "یه حکایت برای شما بگم حالا که انقدر به نبض قضیه رسیدیم این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.26,
   "end": 563.42,
   "text": "قابل تأمله از علامه طباطبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.42,
   "end": 567.44,
   "text": "استاد حضرت علامه حسن زاده علیهم الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.44,
   "end": 572.64,
   "text": "ایشون یه خیلی خدا کنه که ما از این آدما پیدا کنیم باهاش یه مقدار حشر و نشر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.64,
   "end": 576.78,
   "text": "اینو خوب توجه کنیم که تمثیل قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.78,
   "end": 580.12,
   "text": "اومد پیش علامه طباطبایی گفت آقا دنیا چگونه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 580.12,
   "end": 586.34,
   "text": "من می‌خوام بدونم این همه ر-- حب الدنيا رأس کل خطیئة یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 586.34,
   "end": 587.98,
   "text": "علامه طباطبایی تأمل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.98,
   "end": 595.14,
   "text": "اینا هم زرنگ بودن. متأمل می‌شدن تا از عالم ملکوت به سقع نفس ناطقه‌شون چیزی پیاده بشه بعد می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 595.14,
   "end": 603.62,
   "text": "از خودشون چیزی نمی‌گفتن. بعد ایشون تأمل کردن علامه طباطبایی فرمودن امشب می‌بینی، دنیا رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.62,
   "end": 608.04,
   "text": "این چه تا-- جوابیه؟ من از شما سؤال کردم جوابم داد، گفت امشب می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.04,
   "end": 615.42,
   "text": "رفت خواب دید تو عالم خواب دید توی، تو قم تو یه رود خن-- رودخونه‌ایه که پر آبه، آبش کدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.42,
   "end": 623.14,
   "text": "و ریسمان‌های ضخیم و نازک انواع و اقسام ریـ-- ریسمان به تمام بدنش پیچیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.14,
   "end": 628.26,
   "text": "هرچی می‌خواد از این آب کدر و بدبو بیاد بیرون این ریسمان‌ها نمی‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.26,
   "end": 633.18,
   "text": "ترسید. در حال جدا کردن این ریسمان‌ها بود دید نمی‌شه و از خواب پرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 633.18,
   "end": 635.8,
   "text": "فردا اومد سر درس. علامه فرمود دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.8,
   "end": 638.94,
   "text": "اون رودخونه تمثیل دنیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.94,
   "end": 641.46,
   "text": "آبش کدر بود، بدبو بود، چی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.46,
   "end": 647.5,
   "text": "و اون ز-- ریسمان‌ها علائق تو، دلبستگی‌های تو، علقه‌های تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.5,
   "end": 652.06,
   "text": "به این دنیا بود. تا اینا رو جدا نکنی نمی‌تونی جدا شی از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.06,
   "end": 654.98,
   "text": "اصلا آدمایی که برزخ اصلا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.98,
   "end": 657.0,
   "text": "برزخ. آخرین جمله‌م باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 657.0,
   "end": 660.3,
   "text": "برزخ یعنی چی؟ میگی آقا من برزخم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 660.3,
   "end": 662.74,
   "text": "اصلا یه حال بدی دارم. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 662.74,
   "end": 664.88,
   "text": "نمی‌دونم اون وریم یا این وریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 664.88,
   "end": 667.5,
   "text": "یه حد فاصل، یه پرده‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 667.5,
   "end": 670.38,
   "text": "برزخ یعنی همین دلبستگی‌هایی که ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.38,
   "end": 672.92,
   "text": "تا این دلبستگی‌ها هست ما تو برزخیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.92,
   "end": 681.2,
   "text": "اگرچه از این دنیا بریم نسبت به علاقه و دلبستگی‌هایی که داریم به دنیا برزخ ما طول خواهد کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 681.2,
   "end": 686.14,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.14,
   "end": 693.34,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}