   "start": 1.44,
   "end": 133.7
  },
  {
   "index": 1,
   "title": "## شاگردی اشراقی، نه رسمی",
   "start": 133.7,
   "end": 178.26
  },
  {
   "index": 2,
   "title": "## نامهٔ تهدید مجاهدین و هشدار نفوذ",
   "start": 178.26,
   "end": 199.32
  },
  {
   "index": 3,
   "title": "## خاطرهٔ طلایی علامه دربارهٔ رهبر",
   "start": 199.32,
   "end": 383.31
  },
  {
   "index": 4,
   "title": "## بلای پیش‌رو و بشارت بارش‌ها و قیام زینبی",
   "start": 383.31,
   "end": 456.43
  },
  {
   "index": 5,
   "title": "## رزق من حیث لا یحتسب؛ نوبت جوانان",
   "start": 456.43,
   "end": 614.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.44,
   "end": 7.92,
   "text": "یا رب اعوذبک من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.92,
   "end": 9.62,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.62,
   "end": 13.58,
   "text": "لا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.58,
   "end": 16.48,
   "text": "اللهم ایاک نعبد و ایاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.48,
   "end": 22.14,
   "text": "نستعين. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.14,
   "end": 29.64,
   "text": "یا داعی الله و ربانی ایاته السلام علیک حين تقرأ و تبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.64,
   "end": 31.76,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.76,
   "end": 36.2,
   "text": "یکی دو تا عزیز می‌بینم که تشریف آوردند که قبلا ندیده بودمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.2,
   "end": 38.66,
   "text": "حالا بعد از جلسه به من بگن از کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.66,
   "end": 44.98,
   "text": "اداره سازمانن. ما اگرچه امروز نمی‌خواستیم صحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.98,
   "end": 51.94,
   "text": "بعد از جلسه نفسگیر و بسیار سنگین معرفت نفس امروز مسجد بلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.94,
   "end": 54.52,
   "text": "واقعا من دیگه توان نداشتم به صحبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.52,
   "end": 59.38,
   "text": "عزیزانی که تشریف داشتن شاهدن و می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.38,
   "end": 65.16,
   "text": "اما حالا چون دوستان توصیه کردن باز هم اصرار و سؤالاتی داشتن پیرامون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.16,
   "end": 71.34,
   "text": "جنگ و صحبت‌هایی که ما روزهای گذشته داشتیم به خصوص دیروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.34,
   "end": 73.56,
   "text": "به هر حال تبرکاً چند نکته بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.56,
   "end": 76.76,
   "text": "عزیزانی هم که جدید هستن حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.76,
   "end": 80.38,
   "text": "حالا چون من الان حرفایی بزنم شاید گیج و گنگ بشن اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.38,
   "end": 87.08,
   "text": "خیلی راغب نیستم این حرفا بیرون بره و درس کنه خودتون می‌دونید میسپارم به خودتون اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.08,
   "end": 89.76,
   "text": "برای اینکه قشنگ متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.76,
   "end": 95.98,
   "text": "بحث بشید رجوع کنید به کانال مرام گمنامی در ایتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.98,
   "end": 100.68,
   "text": "نشانی‌شم هست @marame به انگلیسی @marame",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.68,
   "end": 104.92,
   "text": "که بزنید مرام گمنامی اسم کانال هست در ایتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.92,
   "end": 107.98,
   "text": "اینجا صحبت‌های دیروز ما رو هم بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.98,
   "end": 110.64,
   "text": "بعد حالا کامل‌تر میشه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.64,
   "end": 112.92,
   "text": "اگرچه من خیلی امروز نمی‌خوام وقتونو بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.92,
   "end": 117.66,
   "text": "خسته هم هستم خیلی. در تطمیع اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.66,
   "end": 122.56,
   "text": "چند تا نکته بگم و شما رو به خدای بزرگ بسپارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.56,
   "end": 126.64,
   "text": "انشاالله از شنبه هم دیگه مسجد بلال ظهرها هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.64,
   "end": 132.3,
   "text": "اینجا دیگه تعطیله. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.3,
   "end": 136.58,
   "text": "وقتی اینطوری با یه مقدمه شروع کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.58,
   "end": 143.48,
   "text": "وقتی ما بنده حقیر یک طلبه ناچیز و واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.48,
   "end": 146.54,
   "text": "بی‌سواد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.54,
   "end": 154.76,
   "text": "ما همه جماعت یا زهرا خودمون رو تحت اشراقات هدایتی حضرت استاد علامه حسن زاده علیه رحمة می‌دونیم اما خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.76,
   "end": 157.22,
   "text": "شاگرد ایشون که نمی‌دونیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.22,
   "end": 160.52,
   "text": "حالا میگن شاگرد علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.52,
   "end": 165.08,
   "text": "ولی اینطوری نیست. ما که تحت برنامه ایشون نبودیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.08,
   "end": 171.54,
   "text": "به هر حال امیدوارم شاگردان اشراقی باشیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.54,
   "end": 176.66,
   "text": "و عرض شود خدمتتون که اینو می‌خواستم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.66,
   "end": 180.56,
   "text": "یه بیچاره‌ای مثل ما وقتی بارها هم عرض کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.56,
   "end": 185.64,
   "text": "چندین وقته که بر در خانه ما با مهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.64,
   "end": 189.48,
   "text": "سازمان مجاهدین نامه تهدید نصب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.48,
   "end": 192.9,
   "text": "چقدر من و خانواده‌ام اذیت شدیم تو این محل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.9,
   "end": 195.94,
   "text": "در حالی که کسی نیستیم، چیزی نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.94,
   "end": 199.32,
   "text": "اصلا در حد و اندازه این حرفا نبودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.32,
   "end": 202.36,
   "text": "این نشون میده که نفوذ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.36,
   "end": 205.04,
   "text": "یادتونه یه بار، یه بار عرض کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.04,
   "end": 214.28,
   "text": "اینا آدرس و مشخصات تک تک نیروهای انقلابی و ایناها رو می‌دونن از جزئی‌ترینشون که ما باشن تا اون کلان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.28,
   "end": 217.36,
   "text": "الان داریم می‌بینیم دیگه. وقتی این رو می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.36,
   "end": 223.18,
   "text": "یه آدم بیچاره‌ای مثل بنده رو این چنین تهدید می‌کنند و خانواده‌مون چقدر اذیت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.18,
   "end": 225.78,
   "text": "پس دیگه ببینید برای بزرگان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.78,
   "end": 233.26,
   "text": "چه ها در سر دارن. متأسفم برای مسئولینی که بارها و بارها و بارها رهبر عزیزتر از جانمون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.26,
   "end": 237.92,
   "text": "نفوذ، نفوذ، نفوذ. اونا باور نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.92,
   "end": 240.8,
   "text": "متأسفانه ما قدر رهبرمون رو نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.8,
   "end": 244.6,
   "text": "می‌ترسم چوبش رو هم بخوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.6,
   "end": 248.52,
   "text": "که هر نعمت رو ما قدر ندونیم قطعا چوبش رو می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.52,
   "end": 253.56,
   "text": "مخصوصا بعضی نعمت‌ها که بوی ولایت، رایحه ولایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.56,
   "end": 256.54,
   "text": "خدا سرش غیرت هم داره البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.54,
   "end": 262.8,
   "text": "اگر چوب بزنه بد-- البته این رو هم بگم چوب خدا برای مؤمنین به نفع خودشون تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.8,
   "end": 265.58,
   "text": "عرض کردم کوره آدم‌سازی میشه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.58,
   "end": 271.28,
   "text": "اما خب سوختن داره دیگه، سوزوندن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.28,
   "end": 274.06,
   "text": "یاد خاطره‌ای افتادم خدمتتون حالا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.06,
   "end": 276.76,
   "text": "روز آخر پیش هم هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.76,
   "end": 284.68,
   "text": "عرض کنم که محضر حضرت علامه حسن زاده علیه الرحمة و رضوان بودم در اتاق شخصی خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.68,
   "end": 287.04,
   "text": "و حرف از رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.04,
   "end": 289.22,
   "text": "به میان اومد و بنده از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.22,
   "end": 291.9,
   "text": "سؤال کردم نظرتون در خصوص آقا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.9,
   "end": 294.58,
   "text": "ایشون خیلی برام شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.58,
   "end": 297.78,
   "text": "اینکه تکیه داده بودن عصای مبارک به سینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.78,
   "end": 304.32,
   "text": "چسبونده بودن تا من اسم آقا رو آوردم رهبر عزیزمون رو، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.32,
   "end": 308.48,
   "text": "سه مرتبه مثل رکوع خم شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.48,
   "end": 311.76,
   "text": "در صورتی که نشسته بودن. خم شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.76,
   "end": 317.82,
   "text": "سه مرتبه فرمودن جانم به فدایش، جانم به فدایش، جانم به فدایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.82,
   "end": 323.98,
   "text": "بعد رو کردن به بنده فرمودن یه جمله طلایی و کلیدی که همیشه تو گوشم زنگ می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.98,
   "end": 329.24,
   "text": "بارها خدمت شما عرض کردم باز هم تبرکاً عرض می‌کنم جایی داره که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.24,
   "end": 334.48,
   "text": "باب طلا نوشته بشه. فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.48,
   "end": 337.66,
   "text": "در خصوص آقا که فرمودن به جانم سوگند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.66,
   "end": 343.02,
   "text": "ایشون تنها عالمی‌ست که گرد و غبار دنیا روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.02,
   "end": 344.94,
   "text": "عبای مبارکش نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.94,
   "end": 349.98,
   "text": "بالای منبر در یادمان شهید حججی دهه محرمی بود این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.98,
   "end": 354.02,
   "text": "عرض کردم به هر حال باعث تعجبشون شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.02,
   "end": 356.98,
   "text": "و سبک و سیاق کلمات و جمله رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.98,
   "end": 358.96,
   "text": "اینا ذو فنونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.96,
   "end": 362.68,
   "text": "همینطوری مثل ما دهان باز نمی‌کنن حرف بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.68,
   "end": 369.13,
   "text": "حساب شده سخن میگن گرد و غبار دنیا روی عبا، نه اونم قبا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.13,
   "end": 375.95,
   "text": "لایه زیرینه، رو اون لایه روین که عبا هم هست نشسته و خیلی حرفا اینجا دارین بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.95,
   "end": 379.93,
   "text": "ما قدر آقا رو نمی‌دونستیم و نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 379.93,
   "end": 382.85,
   "text": "در هر حال، اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.85,
   "end": 390.05,
   "text": "من نکته‌ای رو پیرامون شهادت آقا گفتم خیلیا دل‌ها به هم ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 390.05,
   "end": 394.01,
   "text": "بنده از گفتنش دلم به درد آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.01,
   "end": 396.95,
   "text": "و برای اینکه تسکین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.95,
   "end": 401.21,
   "text": "دل‌های شما و عزیزانی هم که روزهای پیش بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.21,
   "end": 405.55,
   "text": "عرض کنم یه چند تا بشارت بدم به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.55,
   "end": 407.73,
   "text": "در پس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.73,
   "end": 415.09,
   "text": "مشکلاتی که و عرض شود بلای بزرگی که در پیش ماست و پیش روی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.09,
   "end": 418.71,
   "text": "که عرض کردم به جهت قرآن سوزی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.71,
   "end": 423.41,
   "text": "اتفاقات دیگه‌ای که اِاِ صلاح نمی‌دونم بیان کنم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 423.41,
   "end": 426.05,
   "text": "بلای بزرگ که انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.05,
   "end": 434.93,
   "text": "بلا برای اهل ولا باشه دیگه که خیر از توش درآ-- اونم خیری که خدا بخواد، خیری که خدا بخواد بلای بزرگ می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.93,
   "end": 437.77,
   "text": "اعوذ بالله من الكرب والبلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.77,
   "end": 441.07,
   "text": "ببینید کربلا چقدر بزرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 441.07,
   "end": 443.79,
   "text": "این حادثه چقدر عظیمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 443.79,
   "end": 448.31,
   "text": "ثمرش چقدر گسترده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 448.31,
   "end": 451.01,
   "text": "حالا بماند وقتتون رو نمی‌خوام بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 451.01,
   "end": 454.49,
   "text": "من چند تا سؤال-- دیگه توضیح هم ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.49,
   "end": 457.59,
   "text": "در پس این بلای بزرگ به شما بشارت میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 457.59,
   "end": 460.37,
   "text": "اولا به صورت کلی همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.37,
   "end": 463.69,
   "text": "جمع می‌کنم تو یه جمله که بشارت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 463.69,
   "end": 467.21,
   "text": "بارش‌های پی در پی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.21,
   "end": 471.09,
   "text": "بارش‌های باران پی در پی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.09,
   "end": 474.49,
   "text": "البته این حداقل دو وجهش رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 474.49,
   "end": 476.97,
   "text": "وجه ظاهریش همین بارانه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.97,
   "end": 479.27,
   "text": "مدتیه خشکسالی ایران رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.27,
   "end": 482.69,
   "text": "مطمئن باشید که بارش‌های پی‌در‌پی باران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.69,
   "end": 485.73,
   "text": "اون هم دلایلی داره. بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.73,
   "end": 489.67,
   "text": "و بارش‌های باران رحمت هم همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 489.67,
   "end": 493.29,
   "text": "دیگر که منتظر قیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.29,
   "end": 495.75,
   "text": "زینبی زنانمون باشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.75,
   "end": 498.09,
   "text": "یکی بشارت بزرگی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.09,
   "end": 500.01,
   "text": "زنانمون چنان قیام کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.01,
   "end": 507.07,
   "text": "صبر کنید. اِاِاِ عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 507.07,
   "end": 511.95,
   "text": "که باز اینم خیلی دوست دارم که همه بدونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.95,
   "end": 514.51,
   "text": "که البته محاسبات نجومی پشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.51,
   "end": 517.53,
   "text": "قصه هست که عرض می‌کنم با این اطمینان اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.53,
   "end": 525.05,
   "text": "نگران خرابی‌ها و خسارت‌های سنگینی که از جهت اقتصادی کشور می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 525.05,
   "end": 530.25,
   "text": "نباشیم از حیث \"و یرزقهم من حيث لا يحتسب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.25,
   "end": 536.55,
   "text": "چرا؟ مطمئن باشین که از جایی که گمان نمی‌کنیم از محلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 536.55,
   "end": 539.75,
   "text": "از جایی که گمان نمی‌کنیم از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.75,
   "end": 543.11,
   "text": "چه عرض کنم از معبری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.11,
   "end": 546.17,
   "text": "گمان نمی‌کنیم خدا رزق عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.17,
   "end": 551.69,
   "text": "مالی و اقتصادی نصیب ملت عزیز ایران می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.69,
   "end": 554.73,
   "text": "که همه، همه دنیا حیرت کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 554.73,
   "end": 557.89,
   "text": "اینو یه زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 557.89,
   "end": 560.37,
   "text": "اگر کسی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.37,
   "end": 562.93,
   "text": "انقلابی می‌خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 562.93,
   "end": 565.75,
   "text": "اذیتش می‌کردن. یادش بخیر-- یادتون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 565.75,
   "end": 569.63,
   "text": "بین شما البته نیستن بچه‌های زهرا شرق تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.63,
   "end": 573.89,
   "text": "ما اون موقع که کسی از این کارا رو نمی‌کرد، یادش بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 573.89,
   "end": 578.21,
   "text": "در اوج فتنه هشت و هشت هر ده شب محرم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 578.21,
   "end": 580.85,
   "text": "تمام نوحه‌های هیئتمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 580.85,
   "end": 587.23,
   "text": "انقلابی خوندیم با ارزش‌های انقلاب، نام امام و شهدا و رهبر و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 587.23,
   "end": 590.91,
   "text": "جریان‌سازی شد خودش. اصلا می‌خواستن هیئتمون رو آتیش بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 590.91,
   "end": 592.97,
   "text": "حالا الان که برند شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.97,
   "end": 597.09,
   "text": "الان اونها هم بالاخره دستی به آتیش میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 597.09,
   "end": 600.43,
   "text": "و شعرا شروع کنند از الان صف‌کشی ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 600.43,
   "end": 604.59,
   "text": "شعراشون رو بسازن. شما بسازین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.59,
   "end": 607.89,
   "text": "ما که دیگه پیر شدیم و دیگه از پا افتادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 607.89,
   "end": 614.67,
   "text": "نوبت جوون‌هاست. نکته آخر ببخشید خیلی-- اصلا و ابدا نمی‌خواستم این حرف رو بزنم. یه ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}