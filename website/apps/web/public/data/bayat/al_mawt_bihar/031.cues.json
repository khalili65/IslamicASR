 },
 "chapters": [
  {
   "index": 0,
   "title": "## موت و فقر برای شکستن تکبر",
   "start": 8.32,
   "end": 37.38
  },
  {
   "index": 1,
   "title": "## تکبر عین حماقت",
   "start": 37.38,
   "end": 525.63
  },
  {
   "index": 2,
   "title": "## نشانه‌های احمق در کلام مولا و صادقین",
   "start": 525.63,
   "end": 818.74
  },
  {
   "index": 3,
   "title": "## شتاب و درنگ نابجا؛ سه علامت؛ درخت آتش",
   "start": 818.74,
   "end": 963.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 5.9,
   "text": "[سخنگوی 1] [سخنگوی 1] السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.9,
   "end": 8.32,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 12.24,
   "text": "در بحث روایت پنجم از کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.24,
   "end": 17.16,
   "text": "مرحوم مجلسی علیه الرحمة صحبت به اینجا کشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.16,
   "end": 25.9,
   "text": "طبق صریح این روایت اصلا خدای منّان مریضی، موت و فقر رو قرار داده تا ما رو از تکبر به زیر بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.9,
   "end": 28.64,
   "text": "خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.64,
   "end": 36.36,
   "text": "اون ور پرده بحث تکبر تا جایی که حدیث داریم اگر کسی سر سوزن-- اینا رو جدی بگیریم عزیزانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.36,
   "end": 40.74,
   "text": "معذرت میخوام از حماقت ماست اگر اینا رو جدی نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.74,
   "end": 45.34,
   "text": "راهکاری که اهل بیت برای اونورو راحتی اونورو ما تا ابد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.34,
   "end": 47.54,
   "text": "تا ابد به قول حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.54,
   "end": 53.82,
   "text": "ابد در پیش داریم و نمودهایی که اونا دادن بعد ما توجه نکنیم حماقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.82,
   "end": 59.2,
   "text": "که فرمود سر سوزن تکبر تو وجود هر کسی باشه وارد بهشت نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.2,
   "end": 62.54,
   "text": "[سخنگوی 1] اصلاً جهنمو خدا ساخته برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.54,
   "end": 65.6,
   "text": "برای اینکه این تکبرشو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.6,
   "end": 67.92,
   "text": "توجه کردید؟ البته اون برای کسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.92,
   "end": 70.22,
   "text": "موت تکبرش رو نگرفته هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.22,
   "end": 72.36,
   "text": "یعنی اون هنوز گردن فرازی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.36,
   "end": 76.6,
   "text": "خیلی عجیبه، خیلی بحث تکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.6,
   "end": 81.58,
   "text": "و حماقت‌هایی که ما تو این زمینه داریم متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.58,
   "end": 86.38,
   "text": "و بحث حالا حماقت، بی خردی، بی عقلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.38,
   "end": 89.7,
   "text": "احمق یعنی کسی که عقلشو تعطیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.7,
   "end": 92.46,
   "text": "شوخی که نداریم. بی خرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.46,
   "end": 96.16,
   "text": "خیلی عجیب حدیثی دیدم از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.16,
   "end": 98.8,
   "text": "عیسی علیه النبي و آله و علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.8,
   "end": 101.62,
   "text": "ایشون فرمودن من مردگان رو زنده کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.62,
   "end": 105.28,
   "text": "آقا چه کاری الان سخت‌تر از زنده کردن مرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.28,
   "end": 109.22,
   "text": "معجزه‌ست دیگه. مریض‌ها رو شفا دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.22,
   "end": 112.82,
   "text": "اما برای احمق کاری از دستم بر نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.82,
   "end": 116.86,
   "text": "کسی که عقلش رو تعطیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.86,
   "end": 121.16,
   "text": "توجه کردید اینا؟ حالا این حدیث رو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.16,
   "end": 124.98,
   "text": "که حالا ربط حماقت با تکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.98,
   "end": 128.16,
   "text": "که موت اومده ما رو از این نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.16,
   "end": 133.56,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمود این احادیث که الان می‌خونم همه در غرر الحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.56,
   "end": 137.06,
   "text": "فرمود المتکبر عين الحماقة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.06,
   "end": 141.46,
   "text": "اصلاً عین حماقت تکبره، گردن فرازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.46,
   "end": 148.42,
   "text": "یعنی اگر من دچار تکبر شدم یا دیدیم کسی گردن فرازی میکنه این عین حماقتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.42,
   "end": 151.38,
   "text": "یا فرمود الأحمق مولا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.38,
   "end": 156.62,
   "text": "اعظم من الفخر. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.62,
   "end": 163.62,
   "text": "الحمق ببخشید. الحمق یعنی حماقت اعظم من الفخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.62,
   "end": 166.24,
   "text": "این بالاتر از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.24,
   "end": 169.84,
   "text": "یعنی حماقتی بالاتر از فخر فروشی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.84,
   "end": 172.64,
   "text": "می‌خوایم بدونیم کی از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.64,
   "end": 175.32,
   "text": "بی‌خردتره، عقل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.32,
   "end": 178.14,
   "text": "بی‌عقل‌تر عقلشو تعطیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.14,
   "end": 182.76,
   "text": "کسی که فخر فروشی میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.76,
   "end": 186.08,
   "text": "و خیلی عجیب من تو یه روایتی دیدم واقعا تنم لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.08,
   "end": 188.34,
   "text": "خیلی اینو حتی به خونواده خودمم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.34,
   "end": 191.48,
   "text": "به بچه های هیئتمون توصیه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.48,
   "end": 194.16,
   "text": "گوش بدید عجیبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.16,
   "end": 198.62,
   "text": "سَهْسَحَة بن سوهان از یاران باوفای مولا اومد یه شب خونه مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.62,
   "end": 202.06,
   "text": "حالا کدومه که ما محضر امام زمان درک کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.06,
   "end": 205.8,
   "text": "اومده خونه امام عصرش. مولا فرمود امشب پیش ما بمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.8,
   "end": 208.0,
   "text": "میخواست بره فرمود امشب پیش ما بمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.0,
   "end": 211.26,
   "text": "به دست خودش مولا علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.26,
   "end": 215.4,
   "text": "مولى الكونین با دست خودش بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.4,
   "end": 217.74,
   "text": "استراحت ایشون رو پهن کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.74,
   "end": 220.46,
   "text": "بعد دید یه حالتی توی سَهْسَحَة پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.46,
   "end": 224.78,
   "text": "انگار به به مثلا امام زمانم داره برام رختخواب پهن میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.78,
   "end": 229.8,
   "text": "گفته شب پیش من بمون. حالت، حالت تبختر به انسان دست میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.8,
   "end": 234.08,
   "text": "مولا سریع فرمودن چقدر حواسشون به رفیقاشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.08,
   "end": 241.62,
   "text": "فرمود مبادا بری به واسطه لطفی که ما به شما داریم فخر فروشی کنی تو رفیقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.62,
   "end": 247.1,
   "text": "بعضی از ما با کربلا رفتنمون با مثلا توفیقاتی که از بالا نازل شده از ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.1,
   "end": 252.04,
   "text": "حضرت زهرا سلام الله علیها فرمود توفیق هندسه‌ش بالا به پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.04,
   "end": 255.36,
   "text": "همونطور که هندسه اخلاص پایین به بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.36,
   "end": 257.66,
   "text": "توفیق از بالا اومده. هی فخر فروشی میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.66,
   "end": 260.94,
   "text": "من این کارو کردم. من اون کار. من اینقدر کربلا رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.94,
   "end": 264.88,
   "text": "تو کربلایی شدی؟ کربلا در خصوص حماقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.88,
   "end": 269.26,
   "text": "اجازه بدید چند تا حدیث بخونم. کامتون با فرمایش مولا علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.26,
   "end": 274.74,
   "text": "شیرین بشه. اکثر این روایت که الان من براتون نوشتم اینجا می‌خونم از غرر الحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.74,
   "end": 278.96,
   "text": "از جاهای دیگه هم البته هست. الحمقى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.96,
   "end": 282.56,
   "text": "ادوى الداء یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.56,
   "end": 286.84,
   "text": "بی‌خردی بدترین درده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.84,
   "end": 289.9,
   "text": "حالا ما تا دردمون میگیره سریع میریم دکتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.9,
   "end": 293.76,
   "text": "بدترین درد چیه؟ بی‌خردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.76,
   "end": 296.08,
   "text": "الحمقى شقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.08,
   "end": 299.22,
   "text": "بی‌خردی شقاوته، بدبختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.22,
   "end": 302.62,
   "text": "الدنيا غنيمة الحمقى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.62,
   "end": 305.12,
   "text": "دنیا غنیمت ابله‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.12,
   "end": 310.14,
   "text": "فکر می‌کنن حالا خیلی مثلا عزیز شدن دیگه، دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.14,
   "end": 316.1,
   "text": "این غنیمت ابله‌هاست. الأعمال غرور الحمقى آرزوها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.1,
   "end": 318.7,
   "text": "نابخردان رو میف-- میفریبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.7,
   "end": 320.98,
   "text": "الفرح بالدنیا حمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.98,
   "end": 323.22,
   "text": "اینایی که شاد میشن به دنیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.22,
   "end": 327.28,
   "text": "به چیزی که زود گذره و تموم میشه میگه از حماقته مولا میفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.28,
   "end": 330.24,
   "text": "اللهو قوت الحماقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.24,
   "end": 332.94,
   "text": "هوسرانی لهو، لعب اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.94,
   "end": 335.22,
   "text": "فرمود خوراک حماقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.22,
   "end": 338.98,
   "text": "احمق الحمقى الاغترار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.98,
   "end": 341.36,
   "text": "بدترین حماقت‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.36,
   "end": 346.62,
   "text": "اغترار یعنی غفلت. کسی غافل بشه که در محضر حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.62,
   "end": 349.7,
   "text": "از موت غافل بشه. غفلت از موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.7,
   "end": 354.94,
   "text": "چرا حدیث داریم حداقل هفته‌ای یه بار برو زیارت اموات که از این غفلت نجات پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.94,
   "end": 359.48,
   "text": "کنی. അവർ الشیء الحمق زیانبارترین چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.48,
   "end": 363.51,
   "text": "بی‌خردیه الحمق في الوطن قر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.51,
   "end": 367.53,
   "text": "عجیبه میگه بی خردی غریب بودن تو وطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.53,
   "end": 369.29,
   "text": "حالا این باید باز بشه تبیین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.29,
   "end": 376.03,
   "text": "حدیث جالبیه این. ال بعد فرمود فقر الحمق لا یغنی المال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.03,
   "end": 380.17,
   "text": "فقر بی خردی رو ثروت برطرف نمیکنه داداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.17,
   "end": 384.45,
   "text": "الحمق یوجب الفضول حماقت موجب کارهای بیهوده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.45,
   "end": 387.39,
   "text": "فضول کارهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.39,
   "end": 394.71,
   "text": "اضافیه، بیهوده است. آدمی که کارهای اضافی و بیهوده میکنه یا بیهوده گویی میکنه این از حماقتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.71,
   "end": 398.59,
   "text": "من الحمق الاتكال علی العمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.59,
   "end": 402.57,
   "text": "از حماقت اینه که تکیه کنی به آرزوهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.57,
   "end": 405.09,
   "text": "النظر الی الأحمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.09,
   "end": 407.45,
   "text": "یصفن العين. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.45,
   "end": 411.61,
   "text": "نگاه کردن به آدم احمق نور چشمو میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.61,
   "end": 415.23,
   "text": "عجب! چقدر بده با اونا آدم بشینه تازه رفاقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.23,
   "end": 417.45,
   "text": "مقاساة الأحمق عذاب الروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.45,
   "end": 420.71,
   "text": "میخوای بهتون بگم عذاب روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.71,
   "end": 424.75,
   "text": "اینکه تحمل کنی یه احمق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.75,
   "end": 426.37,
   "text": "بعد این اینو پیغمبر فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.37,
   "end": 428.87,
   "text": "احمق الح-- تا اونجا مولا علی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.87,
   "end": 433.29,
   "text": "احمق الحمق الفجور بدترین حماقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 433.29,
   "end": 438.27,
   "text": "نابکاری و هرزگیه. کسی که هرزگی میکنه مثل الان این رئیس جمهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.27,
   "end": 444.53,
   "text": "فرانسه این مکرون ملعون رفته به دیدار این مسیح فلان فلان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.53,
   "end": 446.73,
   "text": "علی نژاد که نیست. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.73,
   "end": 450.29,
   "text": "چی بگیم فلان نجاده. این رفت دیدن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.29,
   "end": 456.53,
   "text": "خب این از عمق حما-- یعنی واقعا عمق حماقت یه رئیس جمهوری مملکت رو میرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.53,
   "end": 459.83,
   "text": "و چقدر پست شدن، چقدر خوار و خفیف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.83,
   "end": 464.73,
   "text": "دستشون به هیچ جا نمیرسه. مثل کسی که داره غرق میشه دست میگیره به این تر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.73,
   "end": 466.85,
   "text": "مثلا علف هرزها بعد خفه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.85,
   "end": 469.51,
   "text": "آخه اون چیه که چی داره تو رفتی به دیدنش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 469.51,
   "end": 472.73,
   "text": "به چی داری افتخار می‌کنی؟ در حالی که خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.73,
   "end": 477.63,
   "text": "من دیدم این رو از این ملعونه که خودش اقرار کرد من سه تا افتخار دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.63,
   "end": 483.89,
   "text": "افتخار این ملعونه رو ببینید. یکی اینکه تو دهاتمون اولین دختری بودم تو ایران که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.89,
   "end": 488.43,
   "text": "روسری از-- حجاب کشف حجاب کردم و خون-- مادرم دق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.43,
   "end": 492.25,
   "text": "انقدر غصه خورد. دوم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.25,
   "end": 493.79,
   "text": "ارتباط با نامحرم گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.79,
   "end": 497.43,
   "text": "حالا اون که نمیگه نامحرم. من حرمت شما رو نگه میدارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 497.43,
   "end": 500.75,
   "text": "و کیفم کردم و این‌ها بدون هیچ محرمیتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.75,
   "end": 503.49,
   "text": "سوم اینکه قبل از اینکه ازدواج کنم باردار شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.49,
   "end": 507.17,
   "text": "آخه این چه، چه فخریه احمق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.17,
   "end": 510.95,
   "text": "بعد اون چقدر احمق‌تره که میره به دیدن ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.95,
   "end": 513.29,
   "text": "که بخواد دهن کجی مثلا به ما بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.29,
   "end": 518.29,
   "text": "و چقدر احمق‌تر از اینا این داخلی‌هان که دم اونا رو می‌زنن به سینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.29,
   "end": 523.63,
   "text": "سنگ اونا رو به سینه میزنن. حالا اذیتتون نکنم بریم تو شیرینی احادیث کیف کنیم یه ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.63,
   "end": 528.69,
   "text": "من امارات باز مولا فرمود من امارات الأحمق كثرة التلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.69,
   "end": 530.97,
   "text": "میدونی از نشانه‌های احمق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.97,
   "end": 534.17,
   "text": "هر دم به یه رنگیه. میره پیش این آقا شما درست میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.17,
   "end": 535.95,
   "text": "میره پیش اون نه مثل اینکه شما درست میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.95,
   "end": 539.51,
   "text": "اصلا رنگارنگ. العجالة--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.51,
   "end": 541.67,
   "text": "العاجلة غرور الحمقى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.67,
   "end": 547.13,
   "text": "دنیای زوره-- زودگذر فریب دهنده احمق‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 547.13,
   "end": 550.71,
   "text": "عدو عاقل خير من صديق احمق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 550.71,
   "end": 554.87,
   "text": "اینو قدیم‌ها می‌گفتن که دشمن دانا به از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.87,
   "end": 560.05,
   "text": "دوست احمق. للأحمق مع كل قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.05,
   "end": 564.51,
   "text": "یمین از نشانه‌های احمق همین که به هر حرفش یه قسم می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.51,
   "end": 567.49,
   "text": "دیدی تو بازار بعضی‌ها می‌رسین تعجب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.49,
   "end": 572.39,
   "text": "یه پوفیلا می‌خواد به یه آدامس و چیپس می‌خواد بفروشه به حضرت عباس قسم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.39,
   "end": 576.53,
   "text": "این از حماقته دیگه. بابا امام باقر سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.53,
   "end": 584.05,
   "text": "یکی از همسرانش که ادعا کرده بود که حضرت مثلا مهر منو نداده این حرفو رفتن دادگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.05,
   "end": 585.75,
   "text": "و چقدر مظلومن اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 585.75,
   "end": 589.51,
   "text": "قاضی گفت يا ابن رسول الله شاهد بیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 589.51,
   "end": 591.95,
   "text": "که شما مهر ایشون رو دادی. گفت نه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.95,
   "end": 593.63,
   "text": "شاهدی ندارم ولی دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.63,
   "end": 596.09,
   "text": "فرمود اون گفت پس قسم بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.09,
   "end": 599.81,
   "text": "حضرت فرمود دوباره مهرشو میدم اما قسم نمیخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 599.81,
   "end": 603.35,
   "text": "الله اکبر. امام باقر سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 603.35,
   "end": 608.81,
   "text": "فرمود لا يستخف بالعلم وأهله إلا أحمق جاهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 608.81,
   "end": 612.89,
   "text": "علم رو کوچک نمیشمره مگر احمق نادان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.89,
   "end": 619.83,
   "text": "اینایی که مواجهه با علم می‌کنند، علم رو تضعیف می‌کنند، عالم رو تضعیف می‌کنند، علم فرونی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.83,
   "end": 622.59,
   "text": "الأكبر الحمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.59,
   "end": 624.75,
   "text": "یعنی بزرگترین حماقت چیه آقا جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 624.75,
   "end": 628.83,
   "text": "مولا علی فرمود الاقترا في المدح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 628.83,
   "end": 635.07,
   "text": "والذم. الإقرار اقرار میکنه، گنده‌گویی میکنه در مدح و ذم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 635.07,
   "end": 637.05,
   "text": "بیخود تعریف میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.05,
   "end": 639.07,
   "text": "بیخود نکوهش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 639.07,
   "end": 643.19,
   "text": "مثل بعضیا که میرن پیش مدیرها فکر میکنن روزی رسونشون ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 643.19,
   "end": 645.91,
   "text": "این آقاست که پشت میز نشسته شروع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.91,
   "end": 650.91,
   "text": "این احمقیتته. السكوت على الأحمق أفضل جواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 650.91,
   "end": 654.19,
   "text": "آقا بهترین س-- جواب به احمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.19,
   "end": 657.39,
   "text": "سکوته. الأحمق داء لا یداوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 657.39,
   "end": 660.07,
   "text": "و مرض لا یبرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 660.07,
   "end": 662.23,
   "text": "بی خردی درد بی درمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 662.23,
   "end": 666.73,
   "text": "مرض لا علاج. ما العدو إلى عدوه أسرع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 666.73,
   "end": 669.77,
   "text": "تضییعا من الأحمق إلى نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 669.77,
   "end": 674.47,
   "text": "می‌فرماید زیانی که بی خرد به خودش میزنه دشمن به دشمن نمیزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.47,
   "end": 677.03,
   "text": "یعنی خودزنی میکنه احمق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.03,
   "end": 680.99,
   "text": "الأحمق الاستهتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.99,
   "end": 683.47,
   "text": "بالفضول ومصاحبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 683.47,
   "end": 690.11,
   "text": "الجهول. می‌فرماید شیفتگی به کارهای بیهوده و همنشینی با نادانان حماقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 690.11,
   "end": 693.59,
   "text": "اینا رو نشون میده که اون رئیس جمهور فرانسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 693.59,
   "end": 696.85,
   "text": "عین حماقتشه که رفته با یه همچین نادانی بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 696.85,
   "end": 702.11,
   "text": "ركوب المعاتبة عنوان الحماقة دست زدن به کارهای مهلک تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 702.11,
   "end": 704.97,
   "text": "هلاک میکنه، نشانه بی خردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 704.97,
   "end": 707.79,
   "text": "الأحمق لا يحسن بالهوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 707.79,
   "end": 710.29,
   "text": "احمق با تحقیر هم اصلاح نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 710.29,
   "end": 712.91,
   "text": "یعنی hvis تحقیرش هم می‌کنی باز درست نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 712.91,
   "end": 714.95,
   "text": "مقاساة الأحمق عذاب الروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 714.95,
   "end": 716.99,
   "text": "تحمل کردن احمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 716.99,
   "end": 724.45,
   "text": "مایه عذاب روحه. فرمود بعد الأحمق خير من قربه و سكوته خير من نطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 724.45,
   "end": 730.64,
   "text": "دوری کردن از، از احمق بهتر از نزدیک شدنش و سکوتش بهتر از سخنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 730.64,
   "end": 734.52,
   "text": "امام صادق فرمود اینو \"ومن لم یحت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 734.52,
   "end": 739.68,
   "text": "یحتنب مصادقة الأحمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 739.68,
   "end": 744.56,
   "text": "من لم یجتنب مصادقة الأحمق أو شکا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 744.56,
   "end": 748.84,
   "text": "يتخلق بأخلاقه\". هرکی به دوستی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 748.84,
   "end": 754.9,
   "text": "یه آدم احمق بشینه و با-- ازش دوری نکنه قطعاً اخلاق اون احمق رو به خودش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.9,
   "end": 757.86,
   "text": "اونم نادون می‌شه. مراقب دور و بری‌هامون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 757.86,
   "end": 760.92,
   "text": "\"أحمق الناس من ظن أنه أعلم الناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.92,
   "end": 767.68,
   "text": "اوه، اوه، اوه. اینایی که فکر می‌کنن خیلی عاقلن و احمق‌ترین‌ها اونایی‌ان که فکر می‌کنن عاقل‌ترین‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 767.68,
   "end": 770.76,
   "text": "چقدر شیرین مولا فرموده چرا این احادیث باید خاک بخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 770.76,
   "end": 774.14,
   "text": "\"لا عُقب للأحمق بمثل سكوته\" که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 774.14,
   "end": 776.42,
   "text": "حالا به این یک روایت دیگه‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 776.42,
   "end": 779.34,
   "text": "\"الأحمق الناس من یمنع البر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 779.34,
   "end": 783.42,
   "text": "ویطلب الشکر ويفعل الشر ويتوقع ثواب الخير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 783.42,
   "end": 788.24,
   "text": "عجب! احمق‌ترین آدما اونیه که خوبی نمی‌کنه انتظار تشکر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 788.24,
   "end": 790.38,
   "text": "بعد بدی می‌کنه توقع پاداش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 790.38,
   "end": 795.8,
   "text": "\"أحمق الناس من أنكر على غيره رذیلته وهو مقیم عليها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 795.8,
   "end": 801.24,
   "text": "احمق‌ترین مردم کسیه که عیب دیگران رو بد می‌دونه در حالی که خودش به اون عیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 801.24,
   "end": 805.1,
   "text": "گرفتاره. \"من رأى في عیوب الناس فأنكرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 805.1,
   "end": 808.78,
   "text": "ثم رضيها لنفسه فلذلك الأحمق بعینه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 808.78,
   "end": 814.76,
   "text": "کسی که عیب‌های دیگران رو می‌بینه و اون‌ها رو زشت می‌شماره اما همون عیب رو در خودش می‌پسنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.76,
   "end": 817.18,
   "text": "این احمق واقعیه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 817.18,
   "end": 821.4,
   "text": "مولا می‌فرماید \"من الخرق المعاجلة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 821.4,
   "end": 826.04,
   "text": "قبل الإمكان والأنات بعد الفرصة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 826.04,
   "end": 831.6,
   "text": "می‌فرماید شتاب کردن تو کارایی که هنوز تواناییشو نداری ادعاشو می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 831.6,
   "end": 836.38,
   "text": "و درنگ کردن بعد از اینکه موقعیت پیدا می‌کنی صبر می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 836.38,
   "end": 839.2,
   "text": "درنگ می‌کنی وقتی موقعیت داره از دستت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 839.2,
   "end": 841.38,
   "text": "اینا نشونه‌های چیه؟ حماقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 841.38,
   "end": 843.92,
   "text": "باز \"أفقر الفقر الحنق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 843.92,
   "end": 850.04,
   "text": "الله اکبر. می‌فرماید بدترین فقر بی‌خردیه، بی‌عقلیه، حماقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 850.04,
   "end": 853.6,
   "text": "\"تعرف حماقة الرجل في ثلاث\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 853.6,
   "end": 855.8,
   "text": "آقا تو سه تا چیز می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 855.8,
   "end": 859.28,
   "text": "حماقت مرد رو شناخت. \"في كلامه فيما لا يعني\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 859.28,
   "end": 862.52,
   "text": "حرفای بی‌معنی می‌زنه. چرت و پرت میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 862.52,
   "end": 864.42,
   "text": "\"وجوابه عما لا يس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 864.42,
   "end": 869.3,
   "text": "لا يسأله عن\". ازش سؤال نشده جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 869.3,
   "end": 871.88,
   "text": "حالا تو سؤال نکردی چی می‌افتی به صحبت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 871.88,
   "end": 875.26,
   "text": "\"و تهوره في الأمور\". خیلی بی‌باکه در امور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 875.26,
   "end": 877.96,
   "text": "هی کارای خطرناک بیخودی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 877.96,
   "end": 882.32,
   "text": "آخرشم بگم \"مودة الأحمق كشجرة ناس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 882.32,
   "end": 887.12,
   "text": "كشجرة نار يأكل بعضها بعضا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 887.12,
   "end": 891.5,
   "text": "میگه دوستی با احمق مثل درخت آتیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 891.5,
   "end": 894.54,
   "text": "چجوری؟ شاخ و برگ‌هاش همدیگه رو می‌خورن اون آتیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 894.54,
   "end": 897.8,
   "text": "همین‌طور تو رو می‌خوره از بینت می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 897.8,
   "end": 901.18,
   "text": "حالا چی شده حاج آقا گیر دادی به حماقت و فلان و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 901.18,
   "end": 903.5,
   "text": "بالاخره باید دشمنامونو بشناسیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 903.5,
   "end": 905.94,
   "text": "حدیث داریم دشمنان ما از حُمقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 905.94,
   "end": 912.78,
   "text": "جانم. اون، اون احمقی که اون احمقو برگردوند اینا حالا هر دو احمق هستن ولی احمق‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 912.78,
   "end": 916.22,
   "text": "بدتر از اونا تو ایرانن که این همه کار کردن، اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 916.22,
   "end": 918.86,
   "text": "افتخار می‌کنن به اون کارا. میگن این کارا رو من کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 918.86,
   "end": 921.38,
   "text": "احمق‌تر اونه. خیلی‌ها متوجه اون نظر نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 921.38,
   "end": 927.04,
   "text": "آفرین. بله ما هم بین صحبت‌هامون گفتیم واقعاً احمق‌تر از ما همین داخلی‌هان که به وجود اینا...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 927.04,
   "end": 928.9,
   "text": "یه ذره دشمن‌شناسی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 928.9,
   "end": 932.04,
   "text": "به شما جسارت نشه ما از طرف مخاطب‌هامون شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 932.04,
   "end": 934.34,
   "text": "دشمنامون رو بشناسین. عزیزان دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 934.34,
   "end": 936.8,
   "text": "می‌دونید چند تا حدیث الان گوش دادین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 936.8,
   "end": 940.6,
   "text": "جانت، گوش جانت چقدر غذا خورد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 940.6,
   "end": 943.64,
   "text": "چون حضرت علامه حسن زاده علیه الرحمه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 943.64,
   "end": 945.4,
   "text": "دهان روح چیه؟ گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 945.4,
   "end": 947.58,
   "text": "الان چند لقمه خوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 947.58,
   "end": 950.64,
   "text": "فکر می‌کنی چند لقمه خوردی؟ چهل و یک لقمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 950.64,
   "end": 953.12,
   "text": "یعنی چهل و یک حدیث الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 953.12,
   "end": 955.58,
   "text": "جانت کیف کرد. نوش جونت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 955.58,
   "end": 963.02,
   "text": "صلوات بفرستید. اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}