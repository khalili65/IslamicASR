 },
 "chapters": [
  {
   "index": 0,
   "title": "## حقیقت موت: جدا شدن شأن اخروی از دنیوی",
   "start": 0.06,
   "end": 159.34
  },
  {
   "index": 1,
   "title": "جنینی بودید؛ مشاعرتان کار نمی‌کرد؛ ابتدای کار بود. و فرموده:",
   "start": 159.34,
   "end": 427.43
  },
  {
   "index": 2,
   "title": "## اعتبارات جسم در محشر نمی‌آید",
   "start": 427.43,
   "end": 658.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 4.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 8.6,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.6,
   "end": 11.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.16,
   "end": 15.34,
   "text": "نکته‌ی دیگری که در روایت چهارم بهش دقت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.34,
   "end": 19.02,
   "text": "در روایت چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.02,
   "end": 21.26,
   "text": "مرحوم مجلسی در بحار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.26,
   "end": 25.98,
   "text": "اونم تعریف موته. فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.98,
   "end": 33.5,
   "text": "اونطور که در روایت چهارم دیدیم جدا شدن شأن آخرتی از شأن دنیوی رو اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.5,
   "end": 38.12,
   "text": "در این روایت امام صادق صلی الله علیه حقیقت موت بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.12,
   "end": 43.32,
   "text": "یعنی حقیقت موت فنا و نابودی نیست بلکه جدا شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.32,
   "end": 47.44,
   "text": "شأن اخروی از شأن دنیوی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.44,
   "end": 54.58,
   "text": "و نکته‌ی دیگری که در این روایت هست در پس این تعریفی که از موت هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.58,
   "end": 57.82,
   "text": "اون هم حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.82,
   "end": 64.6,
   "text": "قشنگ و شیرینی‌ست که حکما فرمودن و ما خیلی بهش توجه نکردیم در همین حدیث مشهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.6,
   "end": 70.04,
   "text": "اونم بحث جسمانیة الحدوث بودن ما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.04,
   "end": 73.92,
   "text": "اون بقای بر روحمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.92,
   "end": 76.84,
   "text": "روحانیة البقاء بودن‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.84,
   "end": 85.86,
   "text": "یعنی چی؟ دقت بفرمایید در متن حدیث می‌فرماید \"طُرد شأن الأخره إلى السماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.86,
   "end": 87.82,
   "text": "وقت مرگ چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.82,
   "end": 91.5,
   "text": "شأن اخروی رد می‌شه میره به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.5,
   "end": 94.86,
   "text": "آسمان. البته این آسمان، آسمان مادی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.86,
   "end": 98.14,
   "text": "چون روح انسان، روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.14,
   "end": 100.3,
   "text": "نفس ناطقه انسان از جنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.3,
   "end": 102.66,
   "text": "مجرداته دیگه، ماده نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.66,
   "end": 107.04,
   "text": "اینکه میگه آسمان نه یعنی این آسمان دنیوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.04,
   "end": 108.92,
   "text": "یعنی مراتب عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.92,
   "end": 114.14,
   "text": "قبلاً هم عرض کردیم مراتب مافوق نسبت به مراتب مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.14,
   "end": 116.32,
   "text": "حکم سماء رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.32,
   "end": 119.86,
   "text": "مثل وف smae رزق کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.86,
   "end": 123.68,
   "text": "رزق شما دست مراتب مافوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.68,
   "end": 126.22,
   "text": "از بالاست. دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.22,
   "end": 129.3,
   "text": "مدیرتو دست نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.3,
   "end": 132.72,
   "text": "کارفرما تو این‌ها نیست، اون ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.72,
   "end": 135.14,
   "text": "اصل تو آسمونه، اونم ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.14,
   "end": 138.14,
   "text": "نه این آسمون دنیا؛ در ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.14,
   "end": 143.54,
   "text": "پس اصلاً و ابداً نترسید از اینکه کسی رزق شما رو قطع کنه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.54,
   "end": 146.66,
   "text": "چنین فکری اصلاً شرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.66,
   "end": 153.14,
   "text": "اون آ-- حالا مثلاً عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.14,
   "end": 156.9,
   "text": "مثلاً بدن ما نسبت به روح ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.9,
   "end": 164.82,
   "text": "می‌شه چون مرتبه انزل وجود خود ماست، می‌شه عرض وجود ما، عرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.82,
   "end": 167.84,
   "text": "نفس ما می‌شه سماء وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.84,
   "end": 169.4,
   "text": "چرا؟ چون مرتبه مافوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.4,
   "end": 174.46,
   "text": "این‌ها رو قبلاً گفتیم. حتی عرش، عرش می‌شه مرتبه مافوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.46,
   "end": 178.02,
   "text": "شما به روحت می‌تونی بگی مرتبه‌ی عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.02,
   "end": 183.16,
   "text": "و به بدنت می‌تونی بگی تحت عرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.16,
   "end": 188.4,
   "text": "پس اینجا که می‌گه، می‌فرماد امام صادق صلی الله علیه که شأن اخروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.4,
   "end": 193.38,
   "text": "بر می‌گرده، رد می‌شه میره به آسمان یعنی میره به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.38,
   "end": 199.02,
   "text": "که اگر کسی دقت بفرمایید ملکوتی زندگی کرده، اونجا جاش خوبه، خیلی راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.02,
   "end": 204.48,
   "text": "به همین راحتی استفاده‌های اخلاقی از این حدیث می‌شه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.48,
   "end": 208.26,
   "text": "ملکوتی زندگی کرده یعنی توجه به ملک نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.26,
   "end": 211.6,
   "text": "و اینکه فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.6,
   "end": 213.36,
   "text": "ح-حیات در زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.36,
   "end": 218.02,
   "text": "حیات چی بود؟ تجمع بین شأن اخروی و شأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.02,
   "end": 222.04,
   "text": "دنیوی. حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.04,
   "end": 224.94,
   "text": "حیات در ارضه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.94,
   "end": 227.24,
   "text": "یعنی ما جسمانیة الحدوثیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.24,
   "end": 229.34,
   "text": "شروع زندگیمون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.34,
   "end": 232.78,
   "text": "الارض یعنی در زمین و در دنیا رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.78,
   "end": 235.46,
   "text": "یعنی حدوث انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.46,
   "end": 239.08,
   "text": "انسانیت ما، انسان بودن ما در زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.08,
   "end": 247.56,
   "text": "حالا وقتی که جسمانیة الحدوثیم یعنی از شروع نطفه ما شروع شدیم و قوص صعودیمون شروع شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.56,
   "end": 250.32,
   "text": "قبلش قوص نزول بود انا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.32,
   "end": 254.74,
   "text": "و ان-- و حالا قوص صعودمون شروع شد و ان الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.74,
   "end": 257.08,
   "text": "اینجا دیگه قوص صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.08,
   "end": 261.92,
   "text": "از-- دقت بفرمایید نکته مهمیه، از دل همین جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.92,
   "end": 271.7,
   "text": "نفس و روح بیرون میاد و هی تعالی پیدا می‌کنه تا به سمت ملکوت پرواز کنه و بره از دل همین جسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.7,
   "end": 275.06,
   "text": "لذا ما روحانیة البقاءیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.06,
   "end": 277.56,
   "text": "اما جسمانیة الحدوث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.56,
   "end": 279.26,
   "text": "حالا این از کجا در میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.26,
   "end": 282.5,
   "text": "اینجا که فرمود فالحياة في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.5,
   "end": 285.44,
   "text": "این نشون میده که ما جسمانیة الحدوثیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.44,
   "end": 289.32,
   "text": "اینجا که می‌فرماید والموت في السماء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.32,
   "end": 293.56,
   "text": "موت در آسمانه. جدا شدن شأن اخروی از بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.56,
   "end": 296.98,
   "text": "از شأن دنیوی. في السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.98,
   "end": 299.92,
   "text": "این چی می‌شه؟ روحانیة البقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.92,
   "end": 302.84,
   "text": "و علیکم السلام. یا حالا قرآن می‌فرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.84,
   "end": 307.18,
   "text": "\"أخرجكم من بطون أمهاتكم لا تعلمون شيئاً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.18,
   "end": 309.82,
   "text": "ما شما رو اخراج کردیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.82,
   "end": 312.9,
   "text": "رحم مادرهاتون در حالی که هیچی نمی‌دونستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.9,
   "end": 315.48,
   "text": "چرا؟ یه جنینی بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.48,
   "end": 317.68,
   "text": "هیچ‌کدوم از مشاعرتون کار نمی‌کردین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.68,
   "end": 320.94,
   "text": "تازه ابتدای کار بود، شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.94,
   "end": 322.8,
   "text": "از اونجا آغاز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.8,
   "end": 328.62,
   "text": "البته فرمود که خود قرآن فرمود \"لقد خلقنا الإنسان في أحسن تقويم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.62,
   "end": 330.66,
   "text": "همون هم به أحسن تقويمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.66,
   "end": 336.34,
   "text": "اهری نمی‌تونه هیکله بدن ما رو، همون جسم ما رو ایجاد کنه چه برسه به روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.34,
   "end": 339.94,
   "text": "یا حالا علوم تجربی ثابت کرده اگر فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.94,
   "end": 347.58,
   "text": "مغز انسان رو بخوان بساز-- بتونن تازه که نمی‌تونن بسازن که کاربرد همین مغز ما رو داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.58,
   "end": 352.16,
   "text": "یک برابر و نیم کره زمین حجمش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.16,
   "end": 354.6,
   "text": "و نمی‌تونن هم. حالا ببینید چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.6,
   "end": 356.76,
   "text": "ایجادی کرده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.76,
   "end": 359.84,
   "text": "با این حال فرمود \"ثم رددناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.84,
   "end": 365.12,
   "text": "أسفل سافلين\". ما آوردیمش تو أسفل سافلين یعنی همین دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.12,
   "end": 367.6,
   "text": "حواسمون جمع باشه اینجا دنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.6,
   "end": 370.58,
   "text": "دنیا دنی، پست، پست فلسفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.58,
   "end": 374.22,
   "text": "یعنی انزل مراتبه که ما دل بهش بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.22,
   "end": 376.61,
   "text": "سفر ما ب-با موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.61,
   "end": 380.85,
   "text": "آغاز میشه خوشا به حال کسی که موت قبل از اون موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.85,
   "end": 382.95,
   "text": "اجباری رو بچشه. یعنی موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.95,
   "end": 386.61,
   "text": "اختیاری. یعنی همینجا به حقیقت موت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.61,
   "end": 388.63,
   "text": "یعنی به ملکوتش دست پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.63,
   "end": 391.51,
   "text": "حالا اینجا برداشت‌های اخلاقی زیادی میشه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.51,
   "end": 395.67,
   "text": "قربونتون برم که دیگه خودتون الحمد لله اهل فضلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.67,
   "end": 400.17,
   "text": "دیگه گفتم الف گفت اگر گفتم هیچ در خانه اگر کس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.17,
   "end": 402.57,
   "text": "یک حرف بس است. به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.57,
   "end": 407.43,
   "text": "جسم، سؤال آخر، جسم اصله یا روح؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.43,
   "end": 409.85,
   "text": "خب مشخصه اینجا دیگه روح داره میره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.85,
   "end": 413.33,
   "text": "جسم که تموم شد برمی‌گرده به چرخه طبیعت تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.33,
   "end": 416.81,
   "text": "چرا ما همه اصل و اساس‌مون و شأنیت‌مون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.81,
   "end": 420.67,
   "text": "افتخارات‌مون و اعتبارات‌مون همه رو روی این جسم گذاشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.67,
   "end": 423.61,
   "text": "یه مدیری که پشت میز می‌شینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.61,
   "end": 426.61,
   "text": "الان چند تا جسم مدیر شما اینجا دیدید عوض شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.61,
   "end": 431.73,
   "text": "تو همین مجموعه از وقتی که من اومدم شاید پنج شش، پنج ساله اومدم فکر کنم پنج تا مدیر عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.73,
   "end": 435.25,
   "text": "پنج تا مدیر کل. جسم‌ها داره عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.25,
   "end": 437.55,
   "text": "خب از اینا چی باقی موند؟ از خود من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.55,
   "end": 441.99,
   "text": "از خود من مثلا بعضی از شما رو دارم می‌بینم بازنشست دارید میشید، دارید میرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.99,
   "end": 444.87,
   "text": "آقا جسم در اینجا تموم شد، متفك شد میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 444.87,
   "end": 448.53,
   "text": "از روح حضرت علی چی اینجا باقی موند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.53,
   "end": 451.31,
   "text": "در اذهان چه جایگاهی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 451.31,
   "end": 453.95,
   "text": "آیا وقتی رفتی گریه می‌کنند برات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.95,
   "end": 460.63,
   "text": "یا می‌خندن؟ یه فرمایش امیرالمؤمنین آقا نگین حاجی حرف از این حرف‌هاش یه مقدار تخریب‌کننده‌ست چون به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 460.63,
   "end": 462.93,
   "text": "میگن آقا سمپاشی می‌کنی، حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.93,
   "end": 466.91,
   "text": "فرمایش امیرالمؤمنین سمپاشیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.91,
   "end": 469.47,
   "text": "واقعاً که. الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.47,
   "end": 475.87,
   "text": "مثلا ما رفتیم به قول فرمایش امیرالمؤمنین فرمود تویی زندگی کن رفتی برات گریه کنن، نه بخندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.87,
   "end": 479.31,
   "text": "الان ما رفتیم جسم‌ها که میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 479.31,
   "end": 488.51,
   "text": "از اون نفس ما، اون روحانیت ما دقت بفرمایید از آثار باقیه ما اینجا تو اذهان چی مونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.51,
   "end": 492.57,
   "text": "از ارتباط روحی شما با همکارات چی مونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.57,
   "end": 499.09,
   "text": "همین الان یکی از دوستان همین بچه‌های زحمتکش خدمات داشت می‌گفت فلان، اسمم برد از مدیرکل‌های همین شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.09,
   "end": 504.13,
   "text": "گفت رفته چقدر آدم خوبی بود، چقدر فلان بود، کلی تعریفشو کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.13,
   "end": 507.35,
   "text": "و جالب بود که ما از اینا یه تعریفی از این مدیر شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.35,
   "end": 510.41,
   "text": "جالب بود برای ما. حالا امتا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.41,
   "end": 513.69,
   "text": "امکان داره که نه یکی هم بره فحش و دری وری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.69,
   "end": 518.75,
   "text": "آخی راحت شدیم. واقعاً اصل به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 518.75,
   "end": 521.59,
   "text": "به روحه دیگه. به روحانیته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 521.59,
   "end": 523.59,
   "text": "م-موت هم یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.59,
   "end": 526.69,
   "text": "اون جنبه روحانیت جدا میشه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.69,
   "end": 528.61,
   "text": "جسم که برمی‌گرده به چرخه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.61,
   "end": 531.35,
   "text": "چرا؟ چون از نون و آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.35,
   "end": 533.53,
   "text": "از همین نشأت، نون و آب از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 533.53,
   "end": 537.17,
   "text": "از جماده. جماد کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 537.17,
   "end": 542.95,
   "text": "اسفل السافلین. مرتبه انزل مراتب هستیه دیگه جماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.95,
   "end": 546.07,
   "text": "بعد میشه حالا نبات. بعد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.07,
   "end": 548.95,
   "text": "حیوان. بعد میشه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.95,
   "end": 551.89,
   "text": "بعد میشه انسان کامل. اسفل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.89,
   "end": 554.67,
   "text": "اسفل السافلین میشه جماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.67,
   "end": 559.07,
   "text": "نطفه از اونجاست. ما اومدیم در پست‌ترین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.07,
   "end": 562.67,
   "text": "بعد عجیبه که دلخوش شدیم به همین پست‌ترین جامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 562.67,
   "end": 566.47,
   "text": "یعنی به جسممون. فکر می‌کنیم همه چی به این جسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.47,
   "end": 572.31,
   "text": "سؤال آ-- البته اون سؤال آخر بود اما ببخشید به نظر شما، چیکار کنم دیگه میجوشه تو بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.31,
   "end": 579.53,
   "text": "به نظر شما وقتی ما موت حاصل شد، شأن اخروی از بدنمون و دنیوی‌مون جدا شد، کلاً مردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.53,
   "end": 583.05,
   "text": "اون اعتباراتمون، آقا مدرک تحصیلی‌تون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.05,
   "end": 588.65,
   "text": "آقا عنوان شغلی‌تون، آقا اون مشهوریت و معروفیت و هرچی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.65,
   "end": 591.49,
   "text": "آیا به روحمون هم میدن اونا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.49,
   "end": 594.65,
   "text": "اینا همه مال جسم بوده. حواسمون نیست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.65,
   "end": 599.89,
   "text": "یعنی آقا جسم منو برد گذاشتن تو خاک، ملائکه میگن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 599.89,
   "end": 602.81,
   "text": "صاحب مدارک کلیه نمی‌دونم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.81,
   "end": 606.71,
   "text": "چی حوزه و دانشگاه، دکتر، مهندسه فلان اینطوری میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 606.71,
   "end": 610.37,
   "text": "بر اساس اون حساب که نه آقا مدیر کل بوده، نه این مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.37,
   "end": 614.55,
   "text": "میانی بوده، نه این اصلاً مدیر نبوده، زیردست بوده بدبخت ولش کنید بشه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.55,
   "end": 618.01,
   "text": "اشد عقا- عذاب باهاش رفتار، اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 618.01,
   "end": 625.31,
   "text": "اتفاقاً بالعکس فرمود اونایی که مسئولیت دارن هرچه مسئولیتشون بالاتر با شدت باهاشون رفتار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.31,
   "end": 628.13,
   "text": "دستشون بسته وارد محشر میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 628.13,
   "end": 630.17,
   "text": "ما برعکس گرفتیم این چیزا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.17,
   "end": 634.41,
   "text": "بعد یکی هم مثل ما این حرفو بزنه یه وقت خدایی نکرده تو سرش نزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 634.41,
   "end": 637.57,
   "text": "آقا این حرفا خط-- اینا مثلا آشوب ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.57,
   "end": 639.95,
   "text": "واقعا عجیبه. تخریب می‌کنه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 639.95,
   "end": 642.65,
   "text": "سمپاشی میشه. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 642.65,
   "end": 645.09,
   "text": "فرمایش امیرالمؤمنین سمپاشی کنه جامعه رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.09,
   "end": 648.03,
   "text": "انقدر این حرفا رو نزدیم خراب شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 648.03,
   "end": 652.97,
   "text": "انشاالله عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 652.97,
   "end": 655.71,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 655.71,
   "end": 658.01,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}