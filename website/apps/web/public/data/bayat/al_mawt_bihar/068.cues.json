   "start": 190.84,
   "end": 244.48
  },
  {
   "index": 1,
   "title": "## ادامهٔ کتاب الموت؛ تمنای مرگ",
   "start": 244.48,
   "end": 294.24
  },
  {
   "index": 2,
   "title": "## عمل؛ راز بیم و ایمنی از مرگ",
   "start": 294.24,
   "end": 482.92
  },
  {
   "index": 3,
   "title": "## رحمت صدپاره؛ یک پاره در دنیا",
   "start": 482.92,
   "end": 591.6
  },
  {
   "index": 4,
   "title": "## حسن بصری و پاسخ امیرالمؤمنین",
   "start": 591.6,
   "end": 661.04
  },
  {
   "index": 5,
   "title": "## محاورهٔ بلال با همسر در لحظهٔ مرگ",
   "start": 661.04,
   "end": 879.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.98,
   "end": 4.3,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.3,
   "end": 8.74,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.74,
   "end": 12.68,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.68,
   "end": 15.56,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 18.4,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.4,
   "end": 21.66,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.66,
   "end": 24.56,
   "text": "پیش از ورود به بحث هر روزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.56,
   "end": 28.74,
   "text": "تبریک عرض می‌کنم روز معلم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.74,
   "end": 31.62,
   "text": "یکی از بهانه‌هایی‌ست که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.62,
   "end": 35.66,
   "text": "شکرانه انجام بدیم هر طور بلدیم برای عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.66,
   "end": 43.74,
   "text": "به هر نحوی در تعلیم و تربیت و خصوصاً تربیت ما و تزکیه ما به یک معنا سهیم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.74,
   "end": 49.04,
   "text": "هم در ادب‌آموزی ما و هم تزکیه و طهارت نفس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.04,
   "end": 53.76,
   "text": "یزکیهم و يعلمهم الكتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.76,
   "end": 57.32,
   "text": "اول یزکیهم و بعد يعلمهم الكتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.32,
   "end": 61.56,
   "text": "لذا حضرت امام فرمودن تزکیه بر تعلیم مقدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.56,
   "end": 65.22,
   "text": "کسی که در حقیقت علمش رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.22,
   "end": 69.92,
   "text": "عمل پیاده می‌کنه با نگاه به او ما ادب‌آموزی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.92,
   "end": 72.88,
   "text": "طهارت نفس رو استیعد می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.88,
   "end": 80.3,
   "text": "به هر حال امیدوارم که هر کجا هستند اون‌هایی که گردن ما حق معلمی دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.3,
   "end": 85.3,
   "text": "چه در دنیا هستند، چه از دنیا رفتند، خدای منان از صائع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.3,
   "end": 89.66,
   "text": "نظر لطف و عنایت خاص و ویژه‌ی خودش رو نصیب حال اون‌ها کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.66,
   "end": 97.26,
   "text": "شما هم لطف کنید بین دو نماز هست، مکان مقدس هست، حالتون هم ان‌شاءالله خوشه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.26,
   "end": 101.98,
   "text": "حضور قلب. این کمترین کاری که می‌تونیم بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.98,
   "end": 110.26,
   "text": "شکرانه برای معلم‌هامون دعا کنیم که این نشانه کرامت نفسه، قوت نفسه، نفس ضعیف، نفس بدحال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.26,
   "end": 112.98,
   "text": "توجه به این چیزها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.98,
   "end": 117.06,
   "text": "توجه به صاحبان حق و حقوق نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.06,
   "end": 120.96,
   "text": "لطف کنید با حال خوش ان‌شاءالله نثار همشون صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.96,
   "end": 123.04,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.04,
   "end": 125.52,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.52,
   "end": 127.68,
   "text": "و عجل فرجهم. بنده اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.68,
   "end": 130.4,
   "text": "متولی می‌شدم در امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.4,
   "end": 138.5,
   "text": "آموزش و پرورش این مملکت به جای قطع نام あ وران و چه و چه و این‌ها، قطع معلمان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.5,
   "end": 145.48,
   "text": "احداث می‌کردم و بیشترین توجه رو به اون‌ها معطوف می‌کردم در کل نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.48,
   "end": 148.4,
   "text": "که ما هرچه از بچه‌هایمون داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.4,
   "end": 153.52,
   "text": "از آب و شر و وجود بچه‌هایمون می‌خوریم از سرچشمه معلماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.52,
   "end": 155.3,
   "text": "حالا چه شرش، چه خیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.3,
   "end": 158.92,
   "text": "حتی در این اغتشاشات اخیر چند ماهه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.92,
   "end": 162.82,
   "text": "یکی از تجربیات تلخ ما این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.82,
   "end": 167.28,
   "text": "متأسفانه بعد این همه سال تازه فهمیدن آقایون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.28,
   "end": 170.68,
   "text": "یکی از علل اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.68,
   "end": 175.5,
   "text": "لجام‌گسیختگی نسل جدید انقلاب معلم‌هاشون تو مدارسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.5,
   "end": 178.52,
   "text": "یعنی از هر دو جهتش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.52,
   "end": 182.5,
   "text": "لذا اگر ما بخوایم اصلاح بشیم باید معلم‌ها رو فکر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.5,
   "end": 188.14,
   "text": "معلم خودمون حداقل اصلاح خودمون معلم رو بگردیم پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.14,
   "end": 194.24,
   "text": "که دیگه حالا خدا رحمت کنه شهید مطهری رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.24,
   "end": 198.94,
   "text": "اگر شما دیدید به من بگید من ندیدم حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.94,
   "end": 203.54,
   "text": "آثار کسی رو بفرماید بدون استثنا خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.54,
   "end": 208.92,
   "text": "حتی خود حضرت امام تصریح می‌کنند من ندیدم آثار کسی که بدون استثنا خوب باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.92,
   "end": 211.74,
   "text": "خود امام اینو می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.74,
   "end": 218.84,
   "text": "ولی ایشون رو شهید مطهری فرمود بدون استثنا آثارشون خوب بود و تو اون جو خفقان امام می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.84,
   "end": 221.9,
   "text": "تو اون زمان چه خدماتی به کشور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.9,
   "end": 227.08,
   "text": "مردم کرده. مخصوصاً در اوایل انقلاب که عقاید التقاطی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.08,
   "end": 233.2,
   "text": "زیاد شده بود، کمونیسمی چه هم حوزه‌های ما هم دانشگاه‌های ما در خطر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.2,
   "end": 239.1,
   "text": "واقعاً منجی بود به یک معنا شهید مطهری اوایل انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.1,
   "end": 241.1,
   "text": "روحش شاد و روح همشون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.1,
   "end": 244.48,
   "text": "خدا حقشون رو بر ما حلال کنه ان‌شاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.48,
   "end": 247.74,
   "text": "بحث موت رو به فضل الهی ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.74,
   "end": 252.22,
   "text": "ما در روایت اول بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.22,
   "end": 258.66,
   "text": "در باب چهارم کتاب الموت که \"فتمن نو الموت ان کنتم صادقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.66,
   "end": 264.88,
   "text": "این اگه راست می‌گید ادعا می‌کنید که صادق هستید تمنای موت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.88,
   "end": 268.14,
   "text": "در خصوص این تمنا حرف عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.14,
   "end": 272.08,
   "text": "که همون تهیه و آمادگیه برای مو-موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.08,
   "end": 279.18,
   "text": "اصلاً هرچه انسان آمادگیش برای لقای خدا بیشتر باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.18,
   "end": 285.48,
   "text": "ها دو دو تا چهار تا، شوقش به موت و دیدار خدا هم قطعاً بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.48,
   "end": 292.82,
   "text": "کسی شوق موت نداره، تمنای موت یعنی تهیه و آمادگی برای موت نداره که آمادگی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.82,
   "end": 299.52,
   "text": "همونطور که عرض کردم مرحوم آیت‌الله کوهستانی تو قبرستون به اون شخص گفته بود عمل شما عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.52,
   "end": 302.38,
   "text": "لذا سؤال کردند چرا ما انقدر می‌ترسیم از مرگ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.38,
   "end": 307.44,
   "text": "فرمود عمل. اگر عملت خوبه دیگه ترس نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.44,
   "end": 312.32,
   "text": "ایشون می‌فرمودند شما اینجا رو آباد کردید، آخرت رو ویران رها کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.32,
   "end": 314.58,
   "text": "لذا می‌ترسید که دارید. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.58,
   "end": 322.06,
   "text": "خیلی عجیبه این روایت که از پیغمبر عزیز عالم سؤال کرد یه شخصی که چرا آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.06,
   "end": 325.22,
   "text": "مرگ انقدر سخت و ترسناکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.22,
   "end": 328.18,
   "text": "رسول الله فرمودند مال داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.18,
   "end": 331.62,
   "text": "دیگه چگونه پیغمبر به چه سادگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.62,
   "end": 335.9,
   "text": "بگه صحبتش رو. یه طوری گفته همه بفهمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.9,
   "end": 338.08,
   "text": "مال داری؟ عرض کرد بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.08,
   "end": 341.16,
   "text": "فرمود در راه خدا می‌بخشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.16,
   "end": 343.42,
   "text": "انفاق می‌کنی در راه خدا؟ گفت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.42,
   "end": 347.16,
   "text": "فرمود برای همین می‌ترسی. خیلی راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.16,
   "end": 350.36,
   "text": "چرا حاضر نیستی ببخشی؟ چون به وعده‌های الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.36,
   "end": 358.18,
   "text": "اطمینان نداری. مگر امیرالمؤمنین در حکمت‌های نهج‌البلاغه نفرمود هر وقت فقیر شدید--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.18,
   "end": 362.3,
   "text": "اینو من خودم برای خودم ذخیره کردم توی یه جایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.3,
   "end": 365.74,
   "text": "توی گوشی همراه خودم نگهش می‌دارم هر از چند گاهی نگاهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 365.74,
   "end": 370.82,
   "text": "امیرالمؤمنین فرمودند هر وقت فقیر شدید با خدا معامله کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.82,
   "end": 375.14,
   "text": "بالاخره یه چیزی دارید که اون چیز رو بخشیشو در راه خدا ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 375.14,
   "end": 377.48,
   "text": "ببینید خدا چجوری وسعت و گشایش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.48,
   "end": 380.82,
   "text": "وعده‌ی الهیه \"من جاء بالحسنة فله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.82,
   "end": 383.0,
   "text": "عشر أمثالها\" ده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.0,
   "end": 385.64,
   "text": "قرض الحسنه باشه هجده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.64,
   "end": 392.38,
   "text": "ما اطمینان به وعده‌های الهی نداریم، آمادگی نداریم لذا می‌ترسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.38,
   "end": 397.12,
   "text": ". و چه شیرین که از امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.12,
   "end": 400.66,
   "text": "سؤال کردند که چرا شما انقدر مرگ رو دوست دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 400.66,
   "end": 402.8,
   "text": "چون شنیدید امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.8,
   "end": 407.8,
   "text": "فرمودند که من از اون ولع و شوقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.8,
   "end": 413.38,
   "text": "بچه‌ی شیرخوار به سینه مادرش داره بیشتر از اون شوق موت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.38,
   "end": 415.98,
   "text": "عجب. حالا چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.98,
   "end": 419.86,
   "text": "سؤال زیرکانه است. امیرالمؤمنین بفرمایید چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 419.86,
   "end": 424.04,
   "text": "شما مرگ رو دوست دارید؟ و جواب مولا چقدر جالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.04,
   "end": 430.94,
   "text": "است. حضرت فرمودند که چون نمونه‌ی الطاف خدا را در دنیا دیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.94,
   "end": 434.64,
   "text": "به به به. تو دنیا دیدم خدا چقدر به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 434.64,
   "end": 442.7,
   "text": "لطف داره. لذا یقین کردم که آن خدایی که در دنیا آنقدر به من لطف کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.7,
   "end": 447.1,
   "text": "و مرا در راه فرشتگان و پیامبرانش سوق داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.1,
   "end": 451.2,
   "text": "انقدر منو دوست داشت، این همه اولیایش رو فدا داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 451.2,
   "end": 453.4,
   "text": "که ما به راه بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 453.4,
   "end": 462.32,
   "text": "این همه کارگزاران، کارگزاران عالمش رو که کثرتشون دیگه لا تعد و لا تحصى است ملائک God رو به خط کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 462.32,
   "end": 464.76,
   "text": "که ما به راه راست بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 464.76,
   "end": 468.76,
   "text": "توجه کردید این تیکه‌رو تو پرانتز بگیرید حرف من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.76,
   "end": 473.5,
   "text": "فرمود خب خدایی که اینطوریه در قیامت هم مرا فراموش نخواهد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 473.5,
   "end": 477.68,
   "text": "امیرالمؤمنین فرمود. واقعاً به این نگاه تا حالا ما دیدیم قصه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 477.68,
   "end": 481.46,
   "text": "آخ خدایی که تو این دنیا، تو این دنیای کوچک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.46,
   "end": 483.82,
   "text": "انقدر به ما لطف داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 483.82,
   "end": 486.26,
   "text": "میشه قیامت ما رو فراموش کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.26,
   "end": 488.52,
   "text": "بعد ادامه دادند حضرت فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 488.52,
   "end": 495.92,
   "text": "آری، من از مقصد و نوع برخورد و پذیرایی‌های آن خدای بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.92,
   "end": 499.82,
   "text": "در آن روز حساس دلهره‌ای ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 499.82,
   "end": 504.54,
   "text": "چه از نوع مقصد که کجا دارم میرم و چه پذیرایی خدا، رفتارش با منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 504.54,
   "end": 507.78,
   "text": "چرا؟ چون اینجا ما را غرق در نعمت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.78,
   "end": 509.72,
   "text": "و اون روایت خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 509.72,
   "end": 512.18,
   "text": "واقعاً خیلی عجیبه که خدا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.18,
   "end": 515.92,
   "text": "من رحمتم رو صد قسمت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 515.92,
   "end": 520.88,
   "text": "و یک قسمتش رو وارد این دنیا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 520.88,
   "end": 526.82,
   "text": "حالا شما ببینید این یک قسمت نه برای یک جزء ها، همه‌ی اجزایی که محبت درش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 526.82,
   "end": 531.58,
   "text": "حتی قطب مثبت و منفی که به هم جذب میشن یه هبی بینشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 531.58,
   "end": 537.12,
   "text": "سنگ رو هم وایساده اصلاً قوه‌ی جاذبه اینا رو بگیرید بحث محبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.12,
   "end": 539.3,
   "text": "وادی محبت بگیرید اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.3,
   "end": 542.42,
   "text": "یه حب نباشه اینا از هم متشتت میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 542.42,
   "end": 545.94,
   "text": "و حتی کلن فی فلك یسبحون آیه‌ی قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 545.94,
   "end": 549.6,
   "text": "همه‌ی افلاک توی مدار خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.6,
   "end": 553.34,
   "text": "روان‌اند، شناگرند، اینم هبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.34,
   "end": 556.84,
   "text": "هبه، هبه ذاتیشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 556.84,
   "end": 561.82,
   "text": ". الان شما اینجا نشستید اگر حب نبود اینجا جمع نبودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 561.82,
   "end": 564.58,
   "text": "قبول دارید اینو؟ نبودید اینجا برای چی اومدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 564.58,
   "end": 571.32,
   "text": "حب شما رو اینجا کشونده. همه‌ی این جهات حب رو همه رو هبی که پدر و مادر به بچه‌اش دارن، بالعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 571.32,
   "end": 578.92,
   "text": "مردم به هم دارن، زن و شوهر به هم دارن، حیوانات به هم دارن، جمادات، نباتات همه به همه به همه رو هم بریزی تو کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 578.92,
   "end": 585.04,
   "text": "این کهکشان‌های لایتناهی و نشئه طبیعت یک جزء از صد جزء رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 585.04,
   "end": 586.64,
   "text": "نود و نه تاشو گذاشته اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 586.64,
   "end": 589.94,
   "text": "الله اعلم چه کار میخواد بکنه با ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 589.94,
   "end": 593.78,
   "text": "لذا اون حسن بصری که جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 593.78,
   "end": 597.68,
   "text": "زاهد ظاهرية ثمانیه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 597.68,
   "end": 601.12,
   "text": "گفتش که من تعجبم کسی بره به بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 601.12,
   "end": 605.62,
   "text": "با این جلالتی که خدا داره و این سختی که خدا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 605.62,
   "end": 612.06,
   "text": "امیرالمؤمنین تا شنید فرمود اتفاقاً بالعکس من تعجبم که چگونه کسی جهنم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 612.06,
   "end": 614.38,
   "text": "انقدر که خدا مهربونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 614.38,
   "end": 617.78,
   "text": "ببینید وقتی با این نگاه شما بری جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 617.78,
   "end": 619.88,
   "text": "برای چی از موت بترسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 619.88,
   "end": 623.28,
   "text": "واقعاً حتی اگر خطاکار باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.28,
   "end": 624.84,
   "text": "اون خدایی نیست که بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 624.84,
   "end": 632.8,
   "text": "ضرب و شتم کنه مثل بعضیا همینطوری ندیده و شنیده و چی و همینطوری بزنه قلع و قمع کنه بره جلو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 632.8,
   "end": 636.0,
   "text": "بگه آقا چون به من جسارت کردی میزنم داغونت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 636.0,
   "end": 638.04,
   "text": "حرمت من، سلام منو جواب ندادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 638.04,
   "end": 647.7,
   "text": "نه اصلاً همه رو می... مگر خدایی نکرده زبونم لال، زبونم لال، زبونم لال بحث غیر خدا مطرح باشه یعنی حق الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 647.7,
   "end": 653.16,
   "text": "اون بله، اون دیگه چون طرف حساب خود مردمن دیگه نه اونجا دیگه خیلی سخت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 653.16,
   "end": 656.08,
   "text": "خدا میگه برو از خودشون طلب کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.08,
   "end": 658.76,
   "text": "ولی خدا انقدر مهربونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 658.76,
   "end": 663.02,
   "text": "حالا یه روایت شیرینی هم هست در این انتهای بحث بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 663.02,
   "end": 666.02,
   "text": "محاوره‌ی حضرت بلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 666.02,
   "end": 668.3,
   "text": "با همسرش لحظه‌ی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 668.3,
   "end": 671.68,
   "text": "شنیده بودید اینو؟ یه چند تا گفت و گوش رو من براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 671.68,
   "end": 676.06,
   "text": "ببین چقدر شیرینه. یه کسی که دست-- بحث روز معلم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 676.06,
   "end": 681.14,
   "text": "شد. یه کسی که معلمش رسول خدا باشه، امیرالمؤمنین باشه، بلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 681.14,
   "end": 685.12,
   "text": "مؤذن پیغمبر یعنی دست‌پرورده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 685.12,
   "end": 691.2,
   "text": "چی باشه؟ دامن نبوت که معلمی هم حضرت امام فرمودند شغل انبیاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.2,
   "end": 693.88,
   "text": "حالا افتاده داره از دنیا میره بلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 693.88,
   "end": 696.88,
   "text": "چند تا از گفت‌وگوشونو من برای شما بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 696.88,
   "end": 702.72,
   "text": "ببین چقدر جالبه. همسرش وقتی اومد به بالین بلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 702.72,
   "end": 704.96,
   "text": "گفت \"واحسرتى که مبتلا شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 704.96,
   "end": 707.6,
   "text": "بلا به من نازل شد. واحسرتى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.6,
   "end": 712.32,
   "text": "بلال گفت \"بلکه موقع شور و شادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 712.32,
   "end": 715.38,
   "text": "تا کنون رنجور بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 715.38,
   "end": 718.58,
   "text": "تا حالا من گرفتار رنج و بلا و گرفتاری بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.58,
   "end": 721.1,
   "text": "الان دارم آزاد میشم. الان وقت شادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.1,
   "end": 724.72,
   "text": "چی میگی واحسرتى؟\" عجب وقت-- داره میره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 724.72,
   "end": 727.56,
   "text": "یعنی داره چشمش به اون ور باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 727.56,
   "end": 733.69,
   "text": "ماها لال میشیم. چه کرده پیغمبر به وجود بلال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 733.69,
   "end": 736.89,
   "text": "دوباره همسرش گفت هنگام فراق فرا رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 736.89,
   "end": 741.89,
   "text": "یعنی داریم جدا میشیم. بلال گفت اتفاقا هنگام وصال فرا رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 741.89,
   "end": 745.09,
   "text": "من دارم وصل میشم به اصلیتم، به اصل خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 745.09,
   "end": 749.95,
   "text": "عجب نگاه رو ببینید. همسرش گفت امشب به دیار غریبان می‌روی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 749.95,
   "end": 752.25,
   "text": "اونا غریبن کسی به یادشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 752.25,
   "end": 757.03,
   "text": "بلال گفت جانم به وطن اصلیم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 757.03,
   "end": 760.95,
   "text": "اصن دارم میرم به اصل جایگاهی که همه اتفاقا توجه‌ها اونجا به منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 760.95,
   "end": 764.33,
   "text": "وصیتش-- دوباره همسرش گفت وا حسرتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 764.33,
   "end": 768.13,
   "text": "بلال در جواب گفت وا دولتا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.13,
   "end": 769.91,
   "text": ". وا حسرتا رو گفت وا دولتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 769.91,
   "end": 772.91,
   "text": "یعنی دولت پیدا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 772.91,
   "end": 777.17,
   "text": "همسرش گفت تو از این پس کج-- تو رو از این پس کجا ببینم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 777.17,
   "end": 781.35,
   "text": "کجا پیدات کنم؟ بلال گفت در حلقه خاصان الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.35,
   "end": 784.13,
   "text": "ببینین اطمینان به نفس رو. حضرت امام می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 784.13,
   "end": 789.25,
   "text": "فرمود من با اطمینان، با قلبی آرام و قل-- و مطمئن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 789.25,
   "end": 791.39,
   "text": "ضمیری شاد اینا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 791.39,
   "end": 794.85,
   "text": "حضور مثلاً مرخص، از حضور شما مرخص میشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 794.85,
   "end": 796.87,
   "text": "و به دیار ابدی سفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 796.87,
   "end": 801.77,
   "text": "چیا-- اصلاً ببینید آدم واقعاً پاش می‌چسبه به زمین تا کسی تعلقاتش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 801.77,
   "end": 805.79,
   "text": "کلاً نکنده باشه نمی‌تونه یه همچین حرفی بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 805.79,
   "end": 811.19,
   "text": "بلال رو ببینید به نظر شما سر سوزنی تعلق تو این صحبت‌ها می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 811.19,
   "end": 814.57,
   "text": "دوباره حالا طولانیه یکی دو تا دیگرش هم بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 814.57,
   "end": 819.07,
   "text": "همسرش گفت دریغا که با رفتن تو خانه بدن خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 819.07,
   "end": 821.39,
   "text": "و خانه و خانمان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 821.39,
   "end": 824.35,
   "text": "ویران می‌شه. جواب بلال رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 824.35,
   "end": 826.97,
   "text": "این کالبد، الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 826.97,
   "end": 829.51,
   "text": "میگه، میگی بدن من ویران می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 829.51,
   "end": 835.79,
   "text": "این کالبد مانند ابر می‌باشد که لحظاتی به هم پیوند-- پیوسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 835.79,
   "end": 838.17,
   "text": "و از هم گسیخته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 838.17,
   "end": 840.99,
   "text": "نگاهش به بدن خودش مثل ابره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 840.99,
   "end": 843.39,
   "text": "میگه ابر رو ببین ابره گاهی اوقات به هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 843.39,
   "end": 845.95,
   "text": "به هم پیوسته است، گاهی از هم متشتته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 845.95,
   "end": 852.61,
   "text": "نگران چیه؟ یعنی همه ل-- یعنی لا حول و لا قوه الا بالله العلی العظیم یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 852.61,
   "end": 856.07,
   "text": "که خدا رحمت کنه arvون کشمیری رو می‌فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 856.07,
   "end": 860.33,
   "text": "کسی که روزی صد بار طبق روایات می‌فرمودن من خودم این روایت رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 860.33,
   "end": 868.17,
   "text": "روزی صد بار این ذکر شریف رو بگه خدا هفتاد نوع بلا رو ازش دور می‌کنه که کمترینش غم و غصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 868.17,
   "end": 870.97,
   "text": "لا حول و لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 870.97,
   "end": 879.73,
   "text": "ان‌شاءالله عاقبت هممون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}