  {
   "index": 1,
   "title": "## جرقهٔ دوست: تمنای موت و دخالت در کار خدا",
   "start": 107.08,
   "end": 242.9
  },
  {
   "index": 2,
   "title": "## ید الله فوق أیدیهم",
   "start": 242.9,
   "end": 536.58
  },
  {
   "index": 3,
   "title": "## دعا و خواست؛ زبان حال و قال",
   "start": 536.58,
   "end": 558.68
  },
  {
   "index": 4,
