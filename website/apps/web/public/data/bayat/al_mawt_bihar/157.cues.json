   "title": "## تمایز شهادت و تمنای خستگی",
   "start": 857.3,
   "end": 1039.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.6,
   "end": 6.66,
   "text": "بسم الله الرحمن الرحیم و به نستعین السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.66,
   "end": 9.64,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.64,
   "end": 11.52,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 14.82,
   "text": "عزیزی پیام فرستاده بود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 17.96,
   "text": "حج خانه خدا که ما اونجا رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.96,
   "end": 22.4,
   "text": "کعبه دست به سینه میگذاریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.4,
   "end": 26.6,
   "text": "به یاد شما و دوستان کلاس و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.6,
   "end": 30.0,
   "text": "همین سلام السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.0,
   "end": 32.9,
   "text": "رو میگیم و اینا خیلی برا من شیرین اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.9,
   "end": 37.66,
   "text": "که اونجا یاد ما هستند و به امام عصرشون کنار خونه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.66,
   "end": 44.12,
   "text": "سلام میدن که به حق هم همینطور هست که کعبه یک سنگ نشانی‌ست که ره گم نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.12,
   "end": 47.3,
   "text": "حاجی احرام دگر بند ببین یار کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.3,
   "end": 51.54,
   "text": "ماشاالله به حال کسی که اونجا یاد امام زمانش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.54,
   "end": 55.16,
   "text": "بحث ما رو روایت شانزدهم از باب چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.16,
   "end": 63.28,
   "text": "کتاب الموت بود. رسیده بودیم به این موضوع که پیغمبر عزیز عالم دو مرتبه به اون شخص شاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.28,
   "end": 67.98,
   "text": "که از درد به خودش می‌پیچید و مریضیش عود کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.98,
   "end": 70.98,
   "text": "فرمودن که تمنای موت نکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.98,
   "end": 75.48,
   "text": "که اگر چنانچه تو محسن باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.48,
   "end": 79.2,
   "text": "تزدد احساناً الی احسانک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.2,
   "end": 83.42,
   "text": "این حیات تو برکتش این میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.42,
   "end": 86.0,
   "text": "حسنه روی حسنه بذاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.0,
   "end": 89.3,
   "text": "و ان کنت مسیئاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.3,
   "end": 92.86,
   "text": "اگر چنانچه خدای نکرده مسیء باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.86,
   "end": 96.52,
   "text": "فتاخر لتستعتب فلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.52,
   "end": 103.14,
   "text": "تمنّول موت. یعنی اگرم مسیء باشی خب راهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.14,
   "end": 105.58,
   "text": "توبه و طلب آمرزشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.58,
   "end": 108.76,
   "text": "به اینجا رسیده بودیم. یکی از دوستان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.76,
   "end": 111.78,
   "text": "یه تو ذهنش ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.78,
   "end": 116.88,
   "text": "جرقه ای زده بود که البته این جرقه ما میگیم جرقه و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.88,
   "end": 121.72,
   "text": "فهم این چیزها همون تجلیات الهیه است در ذهن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.72,
   "end": 124.1,
   "text": "صغری نفس هرکسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.1,
   "end": 126.98,
   "text": "اگر مطابق با واقع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.98,
   "end": 135.74,
   "text": "به یک شکله نسبت به نفس اون شخص و همین دریچه‌های علمه که باز میشه به روی انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.74,
   "end": 138.68,
   "text": "اما القا و الهامات الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.68,
   "end": 146.3,
   "text": "که گفته بودند که پیام فرستادن ظاهرا دو جلسه پیش همین جلسه رو گوش داده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.3,
   "end": 150.54,
   "text": "که پیغمبر مخالفت کردند با اینکه ما تمنای موت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.54,
   "end": 154.24,
   "text": "ایشون از این منظر دیده بودند که میشه ما بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.24,
   "end": 160.32,
   "text": "چون روح ااا استیلا داره بر بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.32,
   "end": 168.74,
   "text": "و حیات بدن هم به یک معنا بعد از اینکه روح تکوّن پیدا کرد در دل جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.74,
   "end": 173.22,
   "text": "بر اساس اصل جسمانیت الحدوث بودن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.22,
   "end": 179.74,
   "text": "نفس که در دل جسم متکون شد بعد دیگه امورات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.74,
   "end": 182.2,
   "text": "جسم و بدن رو هم دست میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.2,
   "end": 185.26,
   "text": "یعنی در حقیقت مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.26,
   "end": 187.68,
   "text": "ااا بدن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.68,
   "end": 191.32,
   "text": "جاها عوض میشه. سلام علیکم. مادر بدن میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.32,
   "end": 193.56,
   "text": "نفس. سلام علیکم. بفرمایید خواهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.56,
   "end": 197.48,
   "text": "مادر بدن میشه نفس و نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.48,
   "end": 200.24,
   "text": "از اونجا به بعد ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.24,
   "end": 205.02,
   "text": "امورات بدن رو دست میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.02,
   "end": 209.9,
   "text": "حالا با توجه به این موضوع که بدن تحت مدیریت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.9,
   "end": 218.3,
   "text": "نفس یا روحه. و وقتی ما تمنای موت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.3,
   "end": 222.3,
   "text": "میتونیم اینطوری بگیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.3,
   "end": 226.12,
   "text": "در حقیقت کأنَّ می‌خوایم که اون تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.12,
   "end": 228.48,
   "text": "روح و نفسو برداریم، روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.48,
   "end": 234.8,
   "text": "و بدن رو برداریم و دخالت کنیم در کار روحی که تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.8,
   "end": 239.94,
   "text": "تدبیر روح اعظمه و روح اعظم هم تحت تدبیر الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.94,
   "end": 243.3,
   "text": "الوهیت نظام و رب مطلق است که الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.3,
   "end": 249.08,
   "text": "رب العالمين. اون رب عالمینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.08,
   "end": 252.34,
   "text": "ااا رزق آن فآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.34,
   "end": 259.2,
   "text": "از رزق وجود بگیر تا رزق‌های مادی رو تأمین میکنه از این حیث بهش میگن رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.2,
   "end": 262.86,
   "text": "خب در سلسله طولیه‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.86,
   "end": 265.96,
   "text": "اسباب و علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.96,
   "end": 269.02,
   "text": "برای رسیدن فیض به هر انسانی به هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.02,
   "end": 276.84,
   "text": "نفسی از حضرت حق رب مطلق بگیر بیا همینطور صادر اول و عقل اول و نفس اول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.84,
   "end": 284.02,
   "text": "همینطور بیا ملائکه در طول هم در تدبیرن دیگه در تدبیر امورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.02,
   "end": 288.22,
   "text": "یکیشم روح اعظمه که روح ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.22,
   "end": 292.02,
   "text": "جنسش از اونه. از مرتبه احدیت نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.02,
   "end": 294.62,
   "text": "خب حالا میتونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.62,
   "end": 297.18,
   "text": "یعنی ایشون این توضیحاتی از من بود اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.18,
   "end": 300.18,
   "text": "منظور نظر ایشون این بود که میشه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.18,
   "end": 303.12,
   "text": "این تمنای موت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.12,
   "end": 307.26,
   "text": "دخالت باشه به نوعی در کار خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.26,
   "end": 310.46,
   "text": "که کار خدا جاریه در عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.46,
   "end": 314.18,
   "text": "تدبیر الهی روح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.18,
   "end": 320.66,
   "text": "به تکافو میندازه، اون روح اعظم رو که روح ما در تحت تدبیر اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.66,
   "end": 322.8,
   "text": "سلام علیکم، بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.8,
   "end": 331.46,
   "text": "و روح مام روح فرد ما و شخص مام داره بدن ما رو مدیریت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.46,
   "end": 333.96,
   "text": "پس خلاصه سؤال این میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.96,
   "end": 341.68,
   "text": "آیا میشه تمنای موت کردن ما دخالت باشه در کار خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.68,
   "end": 344.44,
   "text": "از این جهت پیغمبر فرموده نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.44,
   "end": 349.14,
   "text": "تمنای موت نکن. چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.14,
   "end": 352.42,
   "text": "ظاهراً میگیم موت یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.42,
   "end": 357.18,
   "text": "انصراف نفس از بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.18,
   "end": 361.22,
   "text": "یعنی موت به اون معنای فوت که ما نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.22,
   "end": 364.52,
   "text": "جدایی بین بدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.52,
   "end": 370.12,
   "text": "نفس نفس میره تعلق می‌گیره به یک بدن دیگه‌ای به نام بدن، بدن مثالیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.12,
   "end": 372.86,
   "text": "از این بدن منصرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.86,
   "end": 376.74,
   "text": "این ظاهراً می‌گیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.74,
   "end": 380.98,
   "text": "خدا ما رو از این دنیا ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.98,
   "end": 385.16,
   "text": "جان منو بگیر. یعنی ظاهراً یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.16,
   "end": 388.74,
   "text": "من پوست بندازم، بمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 388.74,
   "end": 391.96,
   "text": "اما بدن که به تنهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.96,
   "end": 394.04,
   "text": "متکفل امور خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 394.04,
   "end": 397.3,
   "text": "بدن تحت تدبیر نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.3,
   "end": 405.24,
   "text": "نفس تحت تدبیر روحه، روح تحت تدبیر روح عظمه، روح اعظم تحت تدبیر حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.24,
   "end": 412.18,
   "text": "پس می‌شه این دخالت در کار خدا باشه، تمنای موت از این حیث پیغمبر فرموده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 412.18,
   "end": 415.76,
   "text": "این کارو نکن؟ بله کاملاً نگاه درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.76,
   "end": 420.06,
   "text": "چه نگاه قشنگی ایشون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.06,
   "end": 423.16,
   "text": "این عزیزی که این پیام رو فرستاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.16,
   "end": 427.18,
   "text": "چه نگاه قشنگی کرده و ما رو متوجه اون سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 427.18,
   "end": 432.28,
   "text": "طولی سلسله طولی وسائط فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.28,
   "end": 435.7,
   "text": "و \"ید الله فوق أيديهم\" کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.7,
   "end": 439.08,
   "text": "بله اگر کسی متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.08,
   "end": 447.9,
   "text": "این باشد که دست خدا در کار است و خداست و خدایی می‌کند هیچ‌وقت به این مرتبه و مرحله نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.9,
   "end": 451.74,
   "text": "مگر بحث، بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.74,
   "end": 454.7,
   "text": "عشق و عاشق و معشوق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.7,
   "end": 459.04,
   "text": "حب و حبیب و محبوب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 459.04,
   "end": 463.4,
   "text": "که مثل حضرت صدیقه شهیده که \"اللهم عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 463.4,
   "end": 467.6,
   "text": "فرجک الفرج السریع\" اینا دیگه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.6,
   "end": 470.38,
   "text": "اون شدت و اون شوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 470.38,
   "end": 473.16,
   "text": "عالیه اون‌ها برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.16,
   "end": 477.66,
   "text": "وصل به خدا و لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.66,
   "end": 480.94,
   "text": "و رسیدن به حضرت حقه، نه چیز دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.94,
   "end": 484.64,
   "text": "اما ما معمولاً می‌گیم خدایا مرگ منو برسون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.64,
   "end": 490.94,
   "text": "به جهت اینکه خسته شدیم از این دنیا، خسته شدیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.94,
   "end": 494.14,
   "text": "که اگر بخواهیم تدبیر الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 494.14,
   "end": 498.24,
   "text": "حق رو در نظر بگیریم العیاذ بالله خسته شدیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.24,
   "end": 503.28,
   "text": "الوهیت نظام، خسته شدیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.28,
   "end": 505.52,
   "text": "اینکه خداست و داره خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.52,
   "end": 510.14,
   "text": "به یک معنا اعتراض در کار خداست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.14,
   "end": 516.0,
   "text": "خدایا جان منو بگیر. مگه خدا خودش تشخیص نمیده کی جان تو رو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.0,
   "end": 520.6,
   "text": "و جان منو بگیر یعنی د-- عوض کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.6,
   "end": 523.48,
   "text": "اون تدبیرتو، حکمتت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.48,
   "end": 526.4,
   "text": "خب حکمت خدا اقتضاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.4,
   "end": 530.38,
   "text": "بر این تعلق گرفته اقتضاش که شما باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 530.38,
   "end": 539.04,
   "text": "پس حواسمون جمع باشه که بسیاری-- نکته‌ای که می‌خوایم عرض کنیم امروز تو همین فرصت کوتاه این هستش که بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 539.04,
   "end": 542.84,
   "text": "تمناهای ما حالا یا به صورت دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 542.84,
   "end": 545.98,
   "text": "در میاد یعنی بیان می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 545.98,
   "end": 549.76,
   "text": "ذکر می‌شه، بالزبون میاد خواست ما از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.76,
   "end": 554.76,
   "text": "گاهی اوقات هم به صورت دعا در نمیاد، تو وجود ما هست، خواست ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 554.76,
   "end": 557.34,
   "text": "مثل اون دستوری که امروز تو مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 557.34,
   "end": 561.72,
   "text": "در سیر بحث معرفت نفس عرض کردیم مسجد بلال که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 561.72,
   "end": 564.88,
   "text": "یکی از اون دوازده اثری که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 564.88,
   "end": 568.64,
   "text": "عمل ویژه بعد از نماز وتر داشت چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 568.64,
   "end": 571.54,
   "text": "اینکه یه، یه جاش می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.54,
   "end": 575.2,
   "text": "دعاهاش مستجاب می‌شه، یه جاش می‌فرمود خواسته‌هاش برآورده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.2,
   "end": 583.22,
   "text": "خب اینا با هم چه فرقی دارن؟ فرقش در اینه اون دعا رو زبون اومده، خواسته رو زبان نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 583.22,
   "end": 586.22,
   "text": "چه زبان حال، چه زبان قال رو خدا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 586.22,
   "end": 589.02,
   "text": "از این حیث. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 589.02,
   "end": 592.08,
   "text": "عرض اینجاست که خیلی از موقع‌هات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.08,
   "end": 596.3,
   "text": "چه زبان حال ما، چه زبان قال ما مطابق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.3,
   "end": 599.8,
   "text": "حکمت خدا نیست. یعنی مغایره با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 599.8,
   "end": 605.72,
   "text": "خواست خداست و حتی بعضاً ما این رو هم تشخیص میدیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 605.72,
   "end": 615.58,
   "text": "نفس ما بهترین محک ماست و چقدر حرف‌ها بزرگان مخصوصاً حضرت استاد اینجا پیاده کرده تو محک بودن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 615.58,
   "end": 618.12,
   "text": "در تمثلات مثلاً یادمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 618.12,
   "end": 621.5,
   "text": "در هم در فسوس هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 621.5,
   "end": 624.68,
   "text": "شرح فسوس البته و هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 624.68,
   "end": 628.5,
   "text": "شرح مصباح حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 628.5,
   "end": 634.7,
   "text": "فرمودن که از حیث اینکه نفس محکه فرمودن شما خواب می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 634.7,
   "end": 639.12,
   "text": "یه مثال قشنگی هم زدن. توی خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 639.12,
   "end": 642.38,
   "text": "نسبت به اینکه ارتباط با ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 642.38,
   "end": 647.48,
   "text": "ارتباط نفس شما با اون صورت و ش-- اشکالی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 647.48,
   "end": 652.1,
   "text": "رتبه مثالیه متصل وجود خودت داری می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 652.1,
   "end": 656.34,
   "text": "چه تأثیری در تو ایجاد می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 656.34,
   "end": 660.84,
   "text": "یعنی انبساط خاطر به تو می‌بخشه یا اضطراب خاطر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 660.84,
   "end": 665.26,
   "text": "کدومش؟ این نفس خودش محکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 665.26,
   "end": 668.5,
   "text": "حضرت استاد می‌فرمودن اینجا نفس محکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 668.5,
   "end": 672.36,
   "text": "نفس تشخیص میده که این خوابی که من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 672.36,
   "end": 673.94,
   "text": "خواب خوبی بود یا بد بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 673.94,
   "end": 677.22,
   "text": "یا رویا صادقه بود یا نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 677.22,
   "end": 681.98,
   "text": "یکی از ملاک‌هایی که ما برای رؤیاهای صادقه داریم همینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 681.98,
   "end": 687.14,
   "text": "که در آموزش اسرار نومیه باید اینا رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 687.14,
   "end": 689.66,
   "text": "روش تعبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 689.66,
   "end": 691.76,
   "text": "ما گفتیم هر چیزی روشمنده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.76,
   "end": 694.8,
   "text": "روش تعبیر خواب. یه روشی که الان داریم می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.8,
   "end": 699.66,
   "text": "حضرت علمی. نفس بهترین محکه، ملاکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 699.66,
   "end": 707.62,
   "text": "بهترین ملاکه. اون لحظه که خواب دیدی آرامش پیدا کردی یا مضطرب شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.62,
   "end": 711.46,
   "text": "نفس تو آرامش پیدا کرد، آرامید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 711.46,
   "end": 718.18,
   "text": "با این چیزی که دیدی یا برعکس رمید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 718.18,
   "end": 721.58,
   "text": "از اینجا می‌شه تشخیص داد که اون خواب شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.58,
   "end": 727.72,
   "text": "اعواقف احلام رقص بسته، بسته احلام پوچ و بیهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 727.72,
   "end": 731.96,
   "text": "از جهت موهوماتی که می‌بینیم و می‌شنویم و می‌گیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 731.96,
   "end": 736.7,
   "text": "می‌چشیم و این‌ها. این بسته‌هاییه که تو خواب خودش رو به ما نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 736.7,
   "end": 739.8,
   "text": "القاءات نفسه. اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 739.8,
   "end": 743.74,
   "text": "که هیچ پیامی هم از خدا توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 743.74,
   "end": 746.44,
   "text": "القاءات موهوم نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 746.44,
   "end": 753.14,
   "text": "که انسان رو پریشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 753.14,
   "end": 759.36,
   "text": "یا نه الهام واقعی از خواب گرفتی و وقتی بلند شدی یک انبساط خاطری داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 759.36,
   "end": 764.48,
   "text": "یه اصلاً یه قرب خاصی به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 764.48,
   "end": 767.56,
   "text": "علوی در خودت احساس می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 767.56,
   "end": 770.76,
   "text": "نفست این رو احساس می‌کنه دیگه از بیرون که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 770.76,
   "end": 775.04,
   "text": "پس اون خواب دارای حاوی پیام الهی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 775.04,
   "end": 780.08,
   "text": "حالا این پیام الهی می‌تونه به قول علامه یه رگه‌ای باشه نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 780.08,
   "end": 783.98,
   "text": "نفوس اشخاص و افراد و نفس‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 783.98,
   "end": 786.74,
   "text": "اینجا متغیر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 786.74,
   "end": 793.18,
   "text": "فرق می‌کنه با-- می‌تونه یه رگه‌ای باشه پیام الهی در بین اون همه خواب‌هایی که دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 793.18,
   "end": 796.74,
   "text": "می‌تونه از اول تا آخرش پیام باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 796.74,
   "end": 800.4,
   "text": "برای آدم‌ها متفاوته. حالا در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 800.4,
   "end": 802.8,
   "text": "چ-- از کجا به کجا رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 802.8,
   "end": 806.3,
   "text": "بحث ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 806.3,
   "end": 813.08,
   "text": "اینکه مدیریت حضرت حق در کل کائنات جاری و ساریه و خداست و خدایی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 813.08,
   "end": 816.06,
   "text": "و بسیاری از تمناهای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 816.06,
   "end": 820.4,
   "text": "و اون خواستگاه وجودی ما چه به زبان بیاد چه نیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 820.4,
   "end": 823.38,
   "text": "بسیارش می‌بینی مطابق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 823.38,
   "end": 825.42,
   "text": "عرض شود حکمت الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 825.42,
   "end": 827.48,
   "text": "یعنی چی مطابق با حکمت الهی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 827.48,
   "end": 832.44,
   "text": "چون حکمت مربوط به پنهان و باطن عالمه و باطن خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 832.44,
   "end": 835.1,
   "text": "در حقیقت به صلاح ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 835.1,
   "end": 839.44,
   "text": "مثل یک قارچه. خیلی تو خبرها چند روز پیش متأسف شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 839.44,
   "end": 842.94,
   "text": "شنیدیم که یه مادر و دو تا بچه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 842.94,
   "end": 850.92,
   "text": "در تو جنگل قارچ‌های خیلی خوشگل پیدا می‌کنن و اینا رو نمی‌دونستن قارچ هرچی زیباتره اتفاقا سمی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 850.92,
   "end": 853.32,
   "text": "اینا رو بار می‌ذارن و می‌پزن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 853.32,
   "end": 857.3,
   "text": "می‌خورن و تمام. طفلی از دنیا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 857.3,
   "end": 862.26,
   "text": "این در حقیقت این شکلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 862.26,
   "end": 867.0,
   "text": "که مطابق با حکمت خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 867.0,
   "end": 870.26,
   "text": "یعنی چی؟ یعنی مضر به حال شماست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 870.26,
   "end": 873.0,
   "text": "حالا شما می‌خوای ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 873.0,
   "end": 875.76,
   "text": "از خدا تمنای موت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 875.76,
   "end": 878.86,
   "text": "این موت یعنی این بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 878.86,
   "end": 882.3,
   "text": "در حقیقت روح یا نفس تعلقش رو از بدن برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 882.3,
   "end": 887.34,
   "text": "خب این تحت سیطره سلطنت و قدرت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 887.34,
   "end": 893.34,
   "text": "تحت تدبیر متفرد به جبروت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 893.34,
   "end": 899.0,
   "text": "شما می‌خوای این رو برداری؟ یعنی دخالت کنی در الهیت عالم، الهیت نظام اصلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 899.0,
   "end": 902.02,
   "text": "لذا پیغمبر با غیرت می‌فرمود نکن این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 902.02,
   "end": 907.1,
   "text": "شاید یه وجه اینکه دو بار پیغمبر تو این روایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 907.1,
   "end": 909.92,
   "text": "یه وجهش رو دیروز گفتیم. این هم یه وجه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 909.92,
   "end": 914.0,
   "text": "دو بار تأکید می‌کنه که تمنای موت نکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 914.0,
   "end": 917.52,
   "text": "همین باشه. یعنی این غیرت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 917.52,
   "end": 926.42,
   "text": "پس برو به خدا دیگه. عرض کردیم این و خلط بحث نشه با یک شهیدی که مثلاً اون لحظات آخر عمر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 926.42,
   "end": 931.78,
   "text": "شهید به جایی می‌رسه که هر خللی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 931.78,
   "end": 936.34,
   "text": "هر مانعی بین خودش و خدا رو کنار زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 936.34,
   "end": 939.92,
   "text": "برای لقای پروردگارش فقط مونده این بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 939.92,
   "end": 944.74,
   "text": "این بدن هرچی بگیم باز این غلظت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 944.74,
   "end": 946.76,
   "text": "کثیفه از جهت فلسفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 946.76,
   "end": 949.9,
   "text": "زمخته. حجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 949.9,
   "end": 952.6,
   "text": "این بدن باید برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 952.6,
   "end": 956.74,
   "text": "خب شهید به جایی می‌رسه که می‌بینه تنها راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 956.74,
   "end": 959.8,
   "text": "وصل مطلوبش به حضرت حق این برداشتن این بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 959.8,
   "end": 962.32,
   "text": "این یعنی معنای شهادت. می‌گه خدای من و بر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 962.32,
   "end": 965.6,
   "text": "یعنی من همه حجاب‌ها رو کنار زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 965.6,
   "end": 968.1,
   "text": "نه منی که غرق حجابم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 968.1,
   "end": 971.5,
   "text": "بعد میام آرزوم شهادته. خدایا شهادت رو نصیب من کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 971.5,
   "end": 975.36,
   "text": "از لابلای این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 975.36,
   "end": 980.66,
   "text": "انبوه از حجاب‌ها و اینا چجوری خدا می‌خواد تو رو انتخاب کنه، گلچین کنه، برداره ببره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 980.66,
   "end": 983.74,
   "text": "پیغمبر عزیز عالم یادش بخیر بچه بودیم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 983.74,
   "end": 989.8,
   "text": "محضر حضرت زهرا صلوة الله که می‌رسید ماه شهدا این همیشه این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 989.8,
   "end": 992.54,
   "text": "نهیب بود برای من و اشک تو چشام جمع می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 992.54,
   "end": 996.0,
   "text": "می‌خوندم که پیغمبر عزیز عالم فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 996.0,
   "end": 999.72,
   "text": "در آخرالزمان شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 999.72,
   "end": 1004.92,
   "text": "خوبان امت مرا گلچین می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1004.92,
   "end": 1007.1,
   "text": "نه اینکه تازه خوبا رو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1007.1,
   "end": 1010.0,
   "text": "از بین خوبام گلچین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1010.0,
   "end": 1015.94,
   "text": "اینطوری نیست که منی که غرق در حجابم، در حجابم، در حجابم بیام ما رو بردارن که اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1015.94,
   "end": 1020.82,
   "text": "تو همه حجاب‌ها رو باید به حول و قوه الهی در سیر لقاء الله گفتیم دیگه هم از حجاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1020.82,
   "end": 1023.82,
   "text": "ظلمانی و نورانی رو برداشته باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1023.82,
   "end": 1026.24,
   "text": "آماده باشی برای برداشتن آخرین حجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1026.24,
   "end": 1030.14,
   "text": "اون آخرین حجاب چیه؟ بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1030.14,
   "end": 1035.3,
