 },
 "chapters": [
  {
   "index": 0,
   "title": "## فوت و وفات؛ امکان نابودی",
   "start": 2.2,
   "end": 131.4
  },
  {
   "index": 1,
   "title": "## خلق موت و حیات؛ أحسن عملاً",
   "start": 131.4,
   "end": 216.52
  },
  {
   "index": 2,
   "title": "## موتوا قبل أن تموتوا و سعهٔ وجودی",
   "start": 216.52,
   "end": 482.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 3.42,
   "text": "رحمت الله. ما بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.42,
   "end": 5.44,
   "text": "اون روایتی که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.44,
   "end": 11.94,
   "text": "اللهم ارزقنا التجافي في اندار الغرور والعنابة الى دار الخلود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.94,
   "end": 15.36,
   "text": "والاستعداد للموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.36,
   "end": 17.6,
   "text": "قبل حلول الفوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.6,
   "end": 21.26,
   "text": "یه بحثی نیمه کاره‌مون که گفتیم این از نوادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.26,
   "end": 24.62,
   "text": "روایاتی‌ست که ثابت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.62,
   "end": 27.36,
   "text": "که میشه فوت اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.36,
   "end": 32.56,
   "text": "چون ما گفتیم وفات هست الله يتوفى الأنفس حين موتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.56,
   "end": 34.86,
   "text": "که اخذ به تمامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.86,
   "end": 38.5,
   "text": "اما این فوت یعنی نابودی بر اساس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.5,
   "end": 43.8,
   "text": "دعا نشون میده که امکانش هست نابودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.8,
   "end": 46.84,
   "text": "یعنی فوت، از بین رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.84,
   "end": 49.82,
   "text": "که گفتیم حالا یه وجهش رو می‌خوایم امروز عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.82,
   "end": 51.96,
   "text": "بحثمون هم البته این نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 51.96,
   "end": 54.72,
   "text": "که چگونه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 54.72,
   "end": 59.94,
   "text": "بالاخره کسی که به سمت اسماء جلال حضرت حق رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.94,
   "end": 63.62,
   "text": "اون که مظهرش شد جهنم، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.62,
   "end": 66.76,
   "text": "تجرد شقاوتی پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.76,
   "end": 73.68,
   "text": "بعد از مرگ. کسی که نه مؤمن بوده این تجرد سعادتی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.68,
   "end": 79.78,
   "text": "بینا بینش رو نداریم. این بزرگان فرمودن این حالت فوته، از بین رفتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.78,
   "end": 82.22,
   "text": "شاید یک وجهش این باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.22,
   "end": 88.82,
   "text": "چون تو سوره انشقاق می‌فرماید يا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.82,
   "end": 91.54,
   "text": "كَدْحًا فَمُلاقِيهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.54,
   "end": 96.36,
   "text": "قراره هر کسی بره رب خودش رو اونجا ملاقات کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.36,
   "end": 103.5,
   "text": "ما قبلاً گفتیم رب هر کسی اون اسمی از خداست که سلطان وجودش شده و در وجودش پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.5,
   "end": 108.94,
   "text": "اگر کسی نه اسم جلالی درش پیاده شده نه جمالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.94,
   "end": 113.56,
   "text": "یعنی گناه کرده، ثواب کرده، گناه کرده، ثواب کرده هم توی این وسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.56,
   "end": 115.76,
   "text": "خب این چه اسمی از خدا درش پیاده شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.76,
   "end": 119.52,
   "text": "یعنی سلطان وجود این آقا، این خانم، این شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.52,
   "end": 122.16,
   "text": "هیچ‌کدوم از اسماء الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.16,
   "end": 125.74,
   "text": "خب چنین کسی به ملاقات چه کسی بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.74,
   "end": 128.54,
   "text": "ربش کیه؟ معلوم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.54,
   "end": 130.92,
   "text": "شاید البته استنباط بنده است این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.92,
   "end": 133.68,
   "text": "شاید یه وجهش که بزرگان فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.68,
   "end": 136.1,
   "text": "که چنین کسی فوت میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.1,
   "end": 138.54,
   "text": "بر اساس این روایتی که عرض کردیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.54,
   "end": 142.0,
   "text": "مجموعه بهار شاید یه وجهش این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.0,
   "end": 145.32,
   "text": "حالا آیه‌ای که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 145.32,
   "end": 149.62,
   "text": "خلق موت و حیاته خیلی شیرین، آیه دو سوره ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.62,
   "end": 152.9,
   "text": "می‌فرماید الذي خلق الموت والحياة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.9,
   "end": 156.58,
   "text": "ببینید صراحتاً داره میگه که خدا خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 156.58,
   "end": 159.4,
   "text": "هم موت و هم حیات و یعنی موت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.4,
   "end": 161.96,
   "text": "خلق الهیه و موجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 161.96,
   "end": 165.54,
   "text": "یک وجود عدمی نیست، چیز عدمی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 165.54,
   "end": 168.26,
   "text": "موجوده. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.26,
   "end": 170.12,
   "text": "لی-- برای چی خلق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.12,
   "end": 173.56,
   "text": "ليبلوكم أَيُّكُمْ أَحْسَنُ عَمَلًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 173.56,
   "end": 181.2,
   "text": "حالا اینجا معلمان اخلاق اینجا حرف خیلی پیاده کردن که نفرمود أكثر عملا هرکی بیشتر عمل کنه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.2,
   "end": 187.52,
   "text": "أَحْسَنُ عَمَلًا. هرکی احسن عمل داشته باشه ولو کم اما احسن عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.52,
   "end": 190.12,
   "text": "و البته وهو العزيز الغفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.12,
   "end": 195.62,
   "text": "چون آیه با این دو اسم تموم میشه به قول حضرت استاد علامه عليه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.62,
   "end": 199.26,
   "text": "این دو تا اسم پیداست که موقع حیات و موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.26,
   "end": 201.82,
   "text": "این دو تا اسم با ما خیلی کار دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.82,
   "end": 205.16,
   "text": "اسم العزيز و الغفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.16,
   "end": 210.34,
   "text": "شاید موت به سمت اسم العزيز باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.34,
   "end": 212.96,
   "text": "حیات به سمت اسم الغفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.96,
   "end": 216.32,
   "text": "حالا باید درباره‌ش بحث کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.32,
   "end": 221.52,
   "text": "اون حدیث امام باقر که دومین حیا-- دومین حدیث کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 221.52,
   "end": 224.62,
   "text": "مرحوم مجلسی بود چی می‌فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.62,
   "end": 227.54,
   "text": "الحیاة و الموت خلقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.54,
   "end": 230.02,
   "text": "این، این دو تا خلق، دو تا خلق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.02,
   "end": 232.36,
   "text": "حالا نکته‌ای که می‌خوایم بگیم تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.36,
   "end": 234.42,
   "text": "قله بحثمون امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.42,
   "end": 239.94,
   "text": "فرمود من خلق الله فإذا جاء الموت فدخل في الإنسان لم يدخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 239.94,
   "end": 244.14,
   "text": "في شيء إلا وخرج من-- خرجت منه الحياة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.14,
   "end": 246.82,
   "text": "میگه م-موت و مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 246.82,
   "end": 249.94,
   "text": "وارد نمیشه در انسان مگر اینکه حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 249.94,
   "end": 253.48,
   "text": "خارج میشه. این خود یه نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 253.48,
   "end": 261.78,
   "text": "خب آقا اگر بگیریم تو بحث جسمیمون که مشخصه جسم یا زنده است یا مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.78,
   "end": 264.88,
   "text": "درسته؟ اما اگر بحث جسمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.88,
   "end": 268.94,
   "text": "اون حدیثی که موتوا قبل ان تموتوا چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 268.94,
   "end": 272.26,
   "text": "بمیرید قبل از اینکه شما را بمیرانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 272.26,
   "end": 277.76,
   "text": "اون حدیث داره نشون میده میشه شما در حالی که حیات داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 277.76,
   "end": 282.38,
   "text": "به موت هم برسی. چون میگه موتوا قبل ان تموتوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.38,
   "end": 291.8,
   "text": "یعنی میشه کسی برسه به اسم الممیت حضرت حق در حالی که اسم المحیی خدا درش پیاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.8,
   "end": 293.7,
   "text": "این دو تا با هم جمع شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.7,
   "end": 298.12,
   "text": "پس اینجا این حدیث چی می-- این حدیث دومه، کتاب الموت چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.12,
   "end": 300.42,
   "text": "میگه وارد نمیشه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.42,
   "end": 304.72,
   "text": "بر چیزی مگر اینکه قبلش حیات خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.72,
   "end": 310.06,
   "text": "میگیم این یک استثناءست برای انسان‌هایی که شدید القوی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.06,
   "end": 313.56,
   "text": "اینو من توضیح مختصر بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.56,
   "end": 317.04,
   "text": "توصیه اخلاقی نیست؟ مثلاً موتوا قبل ان تموتوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.04,
   "end": 320.36,
   "text": "میمیرید و- نه، نه فلسفه اعتقادی هم داره بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.36,
   "end": 328.98,
   "text": "بله سیر و سلوک اخلاقی هست اما از جهت اعتقادی ما اینجا ثابت کردیم اینو قبلاً چندین جلسه حداقل پونزده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.98,
   "end": 334.48,
   "text": "پونزده تعبیر از موت رو ما گفتیم که یک معناش خروج از ظاهر به باطن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.48,
   "end": 337.66,
   "text": "معنای موت. خروج از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.66,
   "end": 340.64,
   "text": "که میشه، میشه انسان قبل از اون مرگ اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.64,
   "end": 343.2,
   "text": "بچشه موت رو. اصلاً یه بالاتر از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.2,
   "end": 347.5,
   "text": "مگر ما نمیگیم که اهل بیت حیات و مماتشون یکیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.5,
   "end": 349.96,
   "text": "ها؟ مگه این اعتقاد رو نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.96,
   "end": 355.04,
   "text": "یعنی او مظهر هم اسم الممیت حضرت حقه، هم المحیی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.04,
   "end": 358.0,
   "text": "تمام اسماء در او پیاده شدن به نحوه اتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.0,
   "end": 360.98,
   "text": "خب چگونه اینو-- با چگونه با این حدیث جمعش کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.98,
   "end": 364.42,
   "text": "میگیم که آقا اون کسایی که شدید القوی میشن، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 364.42,
   "end": 369.85,
   "text": "صعه وجودی پیدا می‌کنند، می‌تونند اسماء متقابل رو در هم جمع کنن تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.85,
   "end": 378.19,
   "text": "یعنی اصلا داشتن اسماء متقابل یعنی جمال و جلال رو با هم داشتن عینا این نشانه سعه وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.19,
   "end": 382.73,
   "text": "مثل انسان کامل. مثل امیرالمؤمنین که چنان شدید القوی است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.73,
   "end": 389.93,
   "text": "چنان اسماء اجد، چنان حرکت میکنه در میدان جنگ که نگاهش نمیتونستن بکنن در میدان جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.93,
   "end": 393.37,
   "text": "میگن چشم امیرالمؤمنین رو کسی نمیتونست، جرات نداشت ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.37,
   "end": 398.61,
   "text": "هنگام جنگ. همون آقا امیرالمؤمنین میاد چجوری دست به سر یتیم میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.61,
   "end": 402.13,
   "text": "این دو تا با هم جمع شده تو یک نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.13,
   "end": 404.45,
   "text": "دقت بفرمایید. این یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.45,
   "end": 408.07,
   "text": "سعه وجودی. خدا هم به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.07,
   "end": 413.69,
   "text": "انسان کامل رو از میان کسانی اختیار کرده که أوسع به قول امام حسن که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.69,
   "end": 418.71,
   "text": "روز شهادتشونه و ما هدیه می‌کنیم مطالب رو خدمت این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.71,
   "end": 423.63,
   "text": "امام حسن مجتبی. امروز اتفاقا این روایت امروز محکم‌تر از اون روایت آخر صفرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.63,
   "end": 426.93,
   "text": "بدونید به قول شیخ مفید علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.93,
   "end": 429.37,
   "text": "که امام حسن فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.37,
   "end": 432.43,
   "text": "که این، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.43,
   "end": 435.47,
   "text": "چون خدای منان این فرمایش امام حسنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.47,
   "end": 442.43,
   "text": "قلب پیغمبر رو أوسع قلوب یافت لذا تمام علمش که قرآنه بر قلبش نازل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.43,
   "end": 445.91,
   "text": "اما در دیگران اینطوری نیست چون سعه وجودی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.91,
   "end": 451.17,
   "text": "معمولا ما ضیغ وجودی داریم برای همین اکثرمون تکامل برزخی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.17,
   "end": 456.93,
   "text": "یعنی تو برزخ گرفتاریم نسبت به تعلقاتی که داریم که بحثش قبلا گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.93,
   "end": 462.85,
   "text": "ضیغ وجودی داریم لذا نمیشه هم اسم الممیت در ما پیاده بشه عینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.85,
   "end": 464.65,
   "text": "هم اسم المحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 464.65,
   "end": 467.67,
   "text": "نمیشه وقتی موت اومد حیات میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.67,
   "end": 470.49,
   "text": "اما در خصوص بزرگان اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.49,
   "end": 472.93,
   "text": "انشاالله خدا به ما هم سعه وجودی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.93,
   "end": 477.91,
   "text": "عاقبتمون انشاالله ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.91,
   "end": 482.25,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}