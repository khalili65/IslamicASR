 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 2.58,
   "text": "و بهیم استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.58,
   "end": 6.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.62,
   "end": 12.44,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.44,
   "end": 15.34,
   "text": "یه چند تا کارهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.34,
   "end": 19.24,
   "text": "برای روزه دار کراهت داره رو من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.24,
   "end": 23.18,
   "text": "اولاً هر کاری که سبب ضعف بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.18,
   "end": 28.74,
   "text": "مثل خون دادن، مثل حمام رفتن این‌ها چون ضعف میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.74,
   "end": 34.2,
   "text": "کراهت داره. بوییدن گل و گیاهی که خوشبو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.2,
   "end": 38.76,
   "text": "البته عطر زدن نه، عطر زدن کراهت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.76,
   "end": 43.62,
   "text": "ولی بوییدن گل حالا چه سری درشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.62,
   "end": 46.36,
   "text": "چه سری درشه که گفتن مکروهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.36,
   "end": 50.02,
   "text": "بوییدن گل و گیاهی که خوشبو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.02,
   "end": 53.5,
   "text": "خیس کردن لباسی که به تنته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.5,
   "end": 58.74,
   "text": "یه مقدار شوخی چیزی بکنی، آب بپاشی طرف روزه است این کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.74,
   "end": 61.78,
   "text": "مسواک کردن اما با چوب تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.78,
   "end": 65.76,
   "text": "با چوب خشک کراهت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.76,
   "end": 68.9,
   "text": "کشیدن دندان یا هر کاری که باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.9,
   "end": 74.34,
   "text": "خونریزی دهان و دندان و این‌ها بشه کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.34,
   "end": 76.52,
   "text": "چشیدن غذا و ماننده‌آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.52,
   "end": 81.04,
   "text": "مثلاً خانم خونه داره برای افطار غذا درست می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.04,
   "end": 84.22,
   "text": "انگشتشو می‌ذاره تو غذا یه ذره می‌چشه، این کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.22,
   "end": 86.34,
   "text": "باطل نمی‌کنه روزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.34,
   "end": 96.46,
   "text": "اما کراهت داره. ریختن دارو توی بینی در صورتی که به حلق نرسه، اگه برسه که باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.46,
   "end": 102.84,
   "text": "اما اگر یعنی تو بینی دارویی بریزی به گونه‌ای که به حلقت نرسه باز کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.84,
   "end": 105.26,
   "text": "ریختن دارو تو چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.26,
   "end": 108.84,
   "text": "یا حتی سرمه کشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.84,
   "end": 113.6,
   "text": "در صورتی که بو یا مزه اون به حلق برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.6,
   "end": 116.92,
   "text": "طعمش یا بوش به حلق برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.92,
   "end": 121.0,
   "text": "دارو تو چشم بریزی که معمولاً هم می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.0,
   "end": 124.72,
   "text": "کراهت داره. نشستن زن البته نه مرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.72,
   "end": 130.54,
   "text": "در آب. زن بشینه در آب، این کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.54,
   "end": 133.68,
   "text": "مزه مزه کردن زیاد، کمش اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.68,
   "end": 139.94,
   "text": "زیاد مزه مزه کنی بعضیا هی دهنشون خشک می‌شه تندتند می‌برن آب مزه مزه می‌کنن می‌ریزن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.94,
   "end": 142.74,
   "text": "این زیادش کراهت داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.74,
   "end": 145.74,
   "text": "ملعبه کردن همسر با همسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.74,
   "end": 148.4,
   "text": "به گونه‌ای که شهوت تحریک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.4,
   "end": 151.4,
   "text": "این هم کراهت داره. امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.4,
   "end": 154.34,
   "text": "انشاالله ما بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.34,
   "end": 159.3,
   "text": "اون روایت دهم در باب چهارم کتاب الموت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.3,
   "end": 163.52,
   "text": "شاید دیگه بحثش رو جمع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.52,
   "end": 166.08,
   "text": "یادتون باشه برخورد کردیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.08,
   "end": 169.1,
   "text": "اون شش مرحله‌ی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.1,
   "end": 173.54,
   "text": "جلسه‌ی پیشمون که مرحله ششم بود در مسجد بلال عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.54,
   "end": 178.08,
   "text": "دوستانی که خواستن مراجعه کنن تو کانال سخنرانی‌ش بچه‌ها گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.08,
   "end": 186.92,
   "text": "فایلش رو. چون متن روایت دهم این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.92,
   "end": 190.68,
   "text": "هیچ چیزی مثل مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.68,
   "end": 193.82,
   "text": "یقینی نیست که هیچ شکی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.82,
   "end": 196.84,
   "text": "خدا مخلوقی خلق نکرده، خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.84,
   "end": 199.12,
   "text": "مرگ هم، موت هم خلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.12,
   "end": 201.94,
   "text": "که یقینی‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.94,
   "end": 204.5,
   "text": "مرگ باشه و هیچ شکی درش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.5,
   "end": 208.7,
   "text": "در حالی که مردم با اون به گونه‌ای رفتار می‌کنند انگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.7,
   "end": 211.66,
   "text": "شکیه که هیچ یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.66,
   "end": 215.6,
   "text": "متن روایت این بود که بعد چون گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.6,
   "end": 222.2,
   "text": "یکی از لحظاتی که به شدت شیطان و سدن و خدمش میان ما رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.2,
   "end": 229.24,
   "text": "شک و ریب بره، بندازن هنگام موته رفتیم سراغ اون مراحل شش گانه موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.24,
   "end": 234.14,
   "text": "که اونجاهایی که شیطان میاد و انسان رو به تردید می‌ندازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.14,
   "end": 241.24,
   "text": "اونجا صحبت کردیم. چیزهایی که انسان در هنگام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.24,
   "end": 247.64,
   "text": "موت می‌بینه، اینو مقدمه کنم تا نکته آخر رو عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.64,
   "end": 251.24,
   "text": "چند تاست. حالا اون مراحل شش گانه موت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.24,
   "end": 254.16,
   "text": "الان می‌خوایم بگیم چه چیزهایی رو میت می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.16,
   "end": 259.56,
   "text": "اصلاً اون حالتی که میت چشمش به اون سمت باز می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.56,
   "end": 261.9,
   "text": "یعنی هم دنیا رو می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.9,
   "end": 264.9,
   "text": "هم آخرت رو، به اون حالت می‌گن معاینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.9,
   "end": 269.1,
   "text": "دیگه به عینه می‌بینه. لحظه‌ی خاصیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.1,
   "end": 274.28,
   "text": "که اتفاقاً یه فرمایش امیرالمؤمنین برای تکون دادن ما، هشداری و هوشیاری ما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.28,
   "end": 276.64,
   "text": "خیلی فرمایش عجیبی، ایجاد سؤال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.64,
   "end": 279.16,
   "text": "چند تا سؤال حضرت مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.16,
   "end": 281.6,
   "text": "مثلاً تا حالا دیدید اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.6,
   "end": 285.02,
   "text": "تلنگر بزنن با ایجاد سؤال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.02,
   "end": 288.0,
   "text": "حضرت فرموده \"هل تشص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.0,
   "end": 290.16,
   "text": "بهی اذا دخل\" آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.16,
   "end": 292.36,
   "text": "حس کردی، دیدی همچین لحظه‌ای رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.36,
   "end": 294.42,
   "text": "\"اذا دخل منزلاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.42,
   "end": 298.4,
   "text": "وقتی که قابض الارواح وارد یه منزلی می‌شه، تا حالا دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.4,
   "end": 300.6,
   "text": "داره سؤال می‌کنه. هل، آیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.6,
   "end": 303.82,
   "text": "سؤالیه. آیا دیدی تا حالا وقتی، اصلاً می‌دونی چه شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.82,
   "end": 307.44,
   "text": "چجوری وارد می‌شه؟ چجوری قابض الارواح وارد منزلی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.44,
   "end": 311.62,
   "text": "\"ام هل تراه اذا توفى احداً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.62,
   "end": 315.44,
   "text": "اصلاً دیدی که چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.44,
   "end": 319.16,
   "text": "جون کسی رو می‌گیره؟ حواست هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.16,
   "end": 326.54,
   "text": "قراره ما هم ببینیم دیگه. قراره یک روزی وارد بر منزل ما و خود ما بشود و توفی کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.54,
   "end": 330.14,
   "text": "حضرت می‌گه تو اصلاً دیدی؟ آیا تا حالا دیدی چه شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.14,
   "end": 335.94,
   "text": "\"بل كيف يتوفى الجنين في بطن أمه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.94,
   "end": 339.82,
   "text": "الله اکبر. چقدر سؤال قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.82,
   "end": 343.24,
   "text": "یا اصلاً دیدی اون جنینی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.24,
   "end": 352.12,
   "text": "رحم مادر می‌میره، اون اص-اصطلاحاً سقط می‌شه، اون، اون رو هم دیدی که چگونه می‌گیره جونش رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.12,
   "end": 355.7,
   "text": "معلومه، پیداست که یه مسئله‌ای اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.7,
   "end": 361.02,
   "text": "می‌فرماید که \"أي لج عليه في بعض جوارحه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.02,
   "end": 364.32,
   "text": "اصلاً چجوری قبض روح می‌کنه جنین رو در رحم مادر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.32,
   "end": 369.22,
   "text": "از بعضی از جواره مادر وارد بر جنین می‌شه، وارد رحم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.22,
   "end": 372.44,
   "text": "چون در رحم مادره. بچه تو رحم مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.44,
   "end": 377.48,
   "text": "چگونه جون بچه رو می‌گیره، مادر زنده است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.48,
   "end": 380.6,
   "text": "خیلی سؤال پیچیده‌ست. از کدوم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.6,
   "end": 383.86,
   "text": "حضرت می‌فرماید از کدوم یکی از این جواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.86,
   "end": 387.78,
   "text": "قابض الأرواح وارد می‌شه بر رحم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.78,
   "end": 392.76,
   "text": "یعنی از اونو وارد می‌شه. \"أَمْ الرُّوحُ عَجَبَتْهُ بِإِذْنِ رَبِّهَا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.76,
   "end": 395.8,
   "text": "الله اکبر. حیرت اندر حیرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.8,
   "end": 400.68,
   "text": "سؤال‌ها همش حساب شده است. واقعاً باید چند جلسه آدم بشینه اینو واکاوی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.68,
   "end": 404.12,
   "text": "این روایت‌ها رو ما داریم می‌گیم رد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.12,
   "end": 411.58,
   "text": "می‌فرماید یا این، اینطوریه که روح جنین اجابت قابض الأرواح رو می‌کنه در رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.58,
   "end": 416.68,
   "text": "یعنی اون خود جنین اجابت می‌کنه و روحش رو تقدیم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.68,
   "end": 418.28,
   "text": "می‌دونی کدوم یکی از این‌هاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.28,
   "end": 422.04,
   "text": "\"أَمْ هُوَ سَاكِنٌ مَعَهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.04,
   "end": 426.66,
   "text": "فِي أَحْشَائِهَا\". یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.66,
   "end": 430.2,
   "text": "اصلاً \"سَاكِنٌ مَعَهُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.2,
   "end": 436.82,
   "text": "حضرت عزرائیل معیت داره، ساکنه با جنین در رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.82,
   "end": 440.62,
   "text": "یعنی قرینه با جنینه. یا اینه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.62,
   "end": 442.2,
   "text": "که می‌تونه اونجا قبضش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.2,
   "end": 446.6,
   "text": "به هر حال یکی از پیچیده‌ترین مباحث بحث جنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.6,
   "end": 451.44,
   "text": "یادش بخیر من برای دانشگاهی که درس می‌خوندم، رشته پزشکیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.44,
   "end": 457.36,
   "text": "دانشگاه تهران. سالی که قبول شدیم یادمه که خب من دیپلمم ریاضی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.36,
   "end": 460.4,
   "text": "بعد برای اینکه پزشکی قبول شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.4,
   "end": 463.0,
   "text": "ااا تجربی شرکت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.0,
   "end": 465.52,
   "text": "زیست شناسی که می‌خوندم بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.52,
   "end": 468.98,
   "text": "جنین، جنین شناسی اینا که بود هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.98,
   "end": 471.7,
   "text": "صفحه‌ای رو که می‌خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.7,
   "end": 474.74,
   "text": "قاطی می‌کردم. پاشدم نماز آیات می‌خوندم برا حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.74,
   "end": 478.06,
   "text": "یا مثل آدم خول و دیوونه می‌گفتم الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.06,
   "end": 480.8,
   "text": "این چه، چه صانعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.8,
   "end": 484.24,
   "text": "این صانع چه کرده و چه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.24,
   "end": 486.26,
   "text": "خیلی چیز عجیبیه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.26,
   "end": 488.22,
   "text": "خیلی پیچیده‌ست بحث جنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.22,
   "end": 490.76,
   "text": "خب حالا این سؤالات و عجب داره می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.76,
   "end": 495.48,
   "text": "یه هوشیاریه، هوش-هشداره به ما که حواست هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.48,
   "end": 500.66,
   "text": "چه اتفاقی قراره بیفته. حالا اونجا این حالت معاینه که پیش میاد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.66,
   "end": 502.48,
   "text": "یه چهره‌هایی رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.48,
   "end": 506.26,
   "text": "من اینا رو بگم یکیشو فقط توضیح بدم که مرتبطه با بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.26,
   "end": 509.2,
   "text": "الا هر کدوم رو بخوایم توضیح بدیم یه جلسه می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.2,
   "end": 511.78,
   "text": "یکی از کسایی که اونجا ما می‌بینیم کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.78,
   "end": 516.38,
   "text": "خیل ملائکه‌اند. حالا یا این ملائکه بلا و شدادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.38,
   "end": 519.7,
   "text": "یا روح ریحانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 519.7,
   "end": 522.8,
   "text": "یک دسته‌ای از ملائکه یادتون باشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.8,
   "end": 526.52,
   "text": "قبل از مرحله ششم دسته دسته ملائکه میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.52,
   "end": 530.38,
   "text": "برای معیت. اونا رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.38,
   "end": 533.84,
   "text": "دومین کسی که می‌بینیم حضرت عزرائله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.84,
   "end": 537.06,
   "text": "حضرت قابض الأرواح رو قطعاً همه می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.06,
   "end": 541.88,
   "text": "دیگریش ملائکه، این همه روایات‌ها، ملائکه ثبت اعمالند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.88,
   "end": 545.42,
   "text": "اون کسایی که ثبت اعمال خوب و بد ما کردن اونجا حاضرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.42,
   "end": 548.66,
   "text": "شما می‌بینیشون. حتی باهاشون بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.66,
   "end": 554.18,
   "text": "گفتگو می‌کنن با اینا. بعد خیلی جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.18,
   "end": 559.52,
   "text": "فرمایش داره از آقا که موکل فرشتگان، حالا اینا چرا خاص شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.52,
   "end": 562.72,
   "text": "موکل رزق، رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.72,
   "end": 565.1,
   "text": "اطعمه و رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.1,
   "end": 569.38,
   "text": "أشربه. یعنی غذا جدا جدا و آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.38,
   "end": 573.04,
   "text": "و نفس. چه جالبه هر کدوم ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.04,
   "end": 576.12,
   "text": "دارن. هر کدوم یه ملکی دارن در وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.12,
   "end": 579.78,
   "text": "موکلن. این سه تا رو ما می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.78,
   "end": 581.82,
   "text": "بعد اینا با ما حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.82,
   "end": 585.46,
   "text": "اون موکلی که مثلاً ملکی که مأمور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.46,
   "end": 591.36,
   "text": "غذاست می‌گه من گشتم شرق و غرب عالمو دیگه لقمه نان غذایی نمونده که تو رزقت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.36,
   "end": 594.58,
   "text": "دیگه هیچی دیگه نمونده برات. معلومه که کارت تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.58,
   "end": 600.62,
   "text": "اون آبیه هم اینجوری می‌گه. می‌گه من گشتم یه قطره آب دیگه رزق تو تو این دنیا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.62,
   "end": 603.04,
   "text": "اونم که نفسه می‌گه دیگه تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 603.04,
   "end": 606.0,
   "text": "پیداست همه اینا تو نفس آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.0,
   "end": 607.86,
   "text": "اتفاق می‌افته این حالت معاینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.86,
   "end": 612.94,
   "text": "یعنی نفس آخره. ببین چقدر طول می‌کشه، چه چیزهایی می‌بینی، چه گفت‌وگوهایی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 612.94,
   "end": 615.1,
   "text": "بعضیا فکر می‌کنن یه آن تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 615.1,
   "end": 618.1,
   "text": "ملک موکل نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.1,
   "end": 620.44,
   "text": "میگه آقا من نگاه کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.44,
   "end": 624.24,
   "text": "لوح محفوظ و همه رو دیدم. دیگه یک نفس دیگه برای تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.24,
   "end": 626.5,
   "text": "رزق باقی نمونده. تمام. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 626.5,
   "end": 629.56,
   "text": "از این حساب کتاب الهی. چقدر دلگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.56,
   "end": 631.62,
   "text": "حالا این گفت‌وگوها زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 631.62,
   "end": 638.0,
   "text": "هر کدوم از اینا که من دارم می‌گم بین او و ماها قراره گفت‌وگوها صورت بگیره، ما رد می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.0,
   "end": 642.64,
   "text": "در خصوص پیامبر و ائمه معصومین حتی حضرت صدیقه کبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.64,
   "end": 648.48,
   "text": "سلام الله علیهم أجمعین هم روایت داریم که این دیدار صورت می‌گیره و حتی گفت‌وگوهایی پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.48,
   "end": 651.48,
   "text": "یکی از بزرگان که حتی هشداری می‌زد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.48,
   "end": 656.44,
   "text": "نهیب می‌زد می‌فرمود که قطعاً امام عصر هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.44,
   "end": 659.74,
   "text": "مورد سؤال قرار می‌گیره توسط مادرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.74,
   "end": 662.66,
   "text": "حضرت زهرا سؤال می‌کنه در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 662.66,
   "end": 666.92,
   "text": "پسر من چه کردی؟ حالا گفت‌وگوهایی که برای اهلشه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 666.92,
   "end": 669.7,
   "text": "بهشت یا جهنم. می‌بینه هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.7,
   "end": 672.46,
   "text": "بهشتی بهشت رو می‌بینه، جهنمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.46,
   "end": 675.3,
   "text": "جهنمی رو. مال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.3,
   "end": 679.7,
   "text": "فرزندان، اعمال اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 679.7,
   "end": 682.78,
   "text": "اونجا حاضرن، ظهور دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 682.78,
   "end": 687.74,
   "text": "و به چهره‌های برزخی‌شون امیرالمؤمنین علیه الصلاة والسلام یه روایت خیلی شیرینی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 687.74,
   "end": 691.48,
   "text": "اینا رو یک یک توضیح میده که مال به تو چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 691.48,
   "end": 694.14,
   "text": "میگه از من فقط دیگه یه کفن برای تو فقط می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 694.14,
   "end": 696.26,
   "text": "دیگه هیچ تصرفی در من نمی‌تونی بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 696.26,
   "end": 699.26,
   "text": "بچه‌ها میگن که ما تا دم قبر باهات هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 699.26,
   "end": 703.8,
   "text": "اینا چهره‌های تمثلات برزخیه‌ی مال و فرزند و اینهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 703.8,
   "end": 707.56,
   "text": "یعنی اون حقیقت‌شون. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 707.56,
   "end": 710.94,
   "text": "از اعمال میگن ما دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 710.94,
   "end": 713.46,
   "text": "\"حاوي أعمالكم تردّ إليكم\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.46,
   "end": 716.5,
   "text": "این دیگه اعمال شما ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 716.5,
   "end": 718.02,
   "text": "تا ابد با تو هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.02,
   "end": 721.8,
   "text": "مثلاً اون کسی که قرین با توست همیشه با توست دیگه ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 721.8,
   "end": 724.46,
   "text": "خودت کردی و خودت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.46,
   "end": 728.37,
   "text": "دیگه کی به نظر شما؟ یه دونه مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.37,
   "end": 732.13,
   "text": "ببین دسته کلی‌ها بود. اینا هر کدومش جزئی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.13,
   "end": 734.01,
   "text": "یکی دیگه مونده که ما می‌بینیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 734.01,
   "end": 738.65,
   "text": "همه می‌بینن. یعنی حضرت میگه نمیشه کسی نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 738.65,
   "end": 743.37,
   "text": "تعجب می‌کنید بگم. شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 743.37,
   "end": 750.39,
   "text": "روایتشو بخونم. اصلا خود متن روایتو بخونم متوجه میشید که \"ما من أحد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 750.39,
   "end": 754.35,
   "text": "هیچ کس نیست مگر اینکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.35,
   "end": 755.89,
   "text": "یعنی اینکه پس همه می‌بینن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 755.89,
   "end": 760.07,
   "text": "\"ما من أحد که یحضره الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.07,
   "end": 764.33,
   "text": "هیچ کس نیست که حالت احتضار موت بهش دست بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.33,
   "end": 767.01,
   "text": "\"الا و کل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 767.01,
   "end": 769.63,
   "text": "ابلیس من شیاطینه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 769.63,
   "end": 773.37,
   "text": "مگر اینکه یه دونه از اون شیاطینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 773.37,
   "end": 777.93,
   "text": "خلاصه حسابی همون قدر قدرت‌های شیاطینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 777.93,
   "end": 780.49,
   "text": "چون میگه ابلیس جنسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 780.49,
   "end": 784.59,
   "text": "از جنس اون شیطون، از جنس ابالسه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 784.59,
   "end": 787.11,
   "text": "از جنس اون ابلیس ملعون خبیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 787.11,
   "end": 791.49,
   "text": "یعنی دیگه قدر-- منظور اینه که از اون سردمدارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 791.49,
   "end": 794.21,
   "text": "شیاطینه. شیطون معمولی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 794.21,
   "end": 795.91,
   "text": "چرا؟ حالا حضرت می‌فرماید چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 795.91,
   "end": 798.53,
   "text": "\"می Amoru هو بالکفر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 798.53,
   "end": 801.51,
   "text": "برای اینکه میاد امر می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 801.51,
   "end": 803.47,
   "text": "تو رو با کفر از این دنیا ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 803.47,
   "end": 805.27,
   "text": "یعنی دروغ بیخود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 805.27,
   "end": 807.55,
   "text": "حتی قدرت داره دیگه تو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 807.55,
   "end": 810.37,
   "text": "مرحله چندم بود گفتیم قدرت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 810.37,
   "end": 812.99,
   "text": "می‌تونه امواتی که از دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 812.99,
   "end": 816.03,
   "text": "رفتن رو متمثل کنه به تو دروغ بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 816.03,
   "end": 819.13,
   "text": "عمو تخالت که از دنیا رفته هرکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 819.13,
   "end": 821.45,
   "text": "یه دفعه متمثل میشه شیطان این کارو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 821.45,
   "end": 824.17,
   "text": "لحظه مرگ تو اونو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 824.17,
   "end": 826.73,
   "text": "عمو تو می‌بینی داد می‌زنه میگه آی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 826.73,
   "end": 828.51,
   "text": "شهادتین نگو دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 828.51,
   "end": 832.69,
   "text": "من رفتم اون بالا اصلاً نه خدایی نه بهشتی نه جه-- همه اینا رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 832.69,
   "end": 834.87,
   "text": "این قدرت شیطانه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 834.87,
   "end": 839.09,
   "text": "چرا خدا آخه تو لحظه آخر آخه خدا گیر آوردیم ما رو ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 839.09,
   "end": 843.39,
   "text": "آقا پر طاووس میخوان بدن به کرکس نمیدن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 843.39,
   "end": 848.71,
   "text": "باید تو خون و پوست و گوشت طرف نفوذ کرده باشه ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 848.71,
   "end": 852.59,
   "text": "بازی نیست مثل اینجا من یه تصویر هستم بیام لباس پیغمبر بپوشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 852.59,
   "end": 855.77,
   "text": "دلق و سجاده و من انقلابی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 855.77,
   "end": 858.97,
   "text": "بخوره تو سرت این انقلابی. دم زدن فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 858.97,
   "end": 865.21,
   "text": "اینطوری نیست. خون و پوست و گوشتت به جوش میاد به خروش میاد حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 865.21,
   "end": 867.37,
   "text": "بله حالا \"و یشککهو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 867.37,
   "end": 869.93,
   "text": "یعنی به خاطر همین مثلا این روایتو انتخاب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 869.93,
   "end": 873.89,
   "text": "\"و یشککهو فی دینه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 873.89,
   "end": 877.91,
   "text": "چون تو روایت میگه یقینی‌ترین چیزها موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 877.91,
   "end": 880.55,
   "text": "اما برای مردم اصلا انگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 880.55,
   "end": 883.57,
   "text": "ش-شک اصلاً هیچ یقینی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 883.57,
   "end": 889.25,
   "text": "و اصلاً ولت نمی‌کنه تا لحظه آخر \"و یشککهو فی دینه\" تا تو دینت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 889.25,
   "end": 891.45,
   "text": "تشکیک ایجاد نکنه، تا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 891.45,
   "end": 895.87,
   "text": "ش-شک و تردید قلب موری یادش به خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 895.87,
   "end": 900.47,
   "text": "مردد. یه ده پونزده جلسه بیست جلسه چقدر صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 900.47,
   "end": 902.43,
   "text": "تا با این حالت تو رو نبره ولت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 902.43,
   "end": 904.57,
   "text": "\"حتی تخرج نفسه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 904.57,
   "end": 909.45,
   "text": "تا اون لحظه‌ای که نفست می‌خواد خارج بشه کار تموم بشه ولت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 909.45,
   "end": 912.09,
   "text": "تشکیک، تشکیک، تشکیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 912.09,
   "end": 914.67,
   "text": "حالا بعد روایات دیگه داریم که این‌ها رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 914.67,
   "end": 916.87,
   "text": "چگونه تشکیک ایجاد می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 916.87,
   "end": 922.17,
   "text": "یه، یه منظره‌ش اینه که به هر چیزی که تو تعلق داری علاقه داری رو میگه اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 922.17,
   "end": 925.67,
   "text": "شهادتین بگی مثلا می‌زنم اینو لهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 925.67,
   "end": 929.07,
   "text": "اینو می‌کشم. اینو از مدیریتتو می‌گیرم آقای مدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 929.07,
   "end": 930.63,
   "text": "دلبستی. عاشق مدیریت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 930.63,
   "end": 932.95,
   "text": "اینو ازت می‌گیرم. دیگه مدیر نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 932.95,
   "end": 937.25,
   "text": "و و. مثلا به یه گلدون روایت داره دلبسته میگه این گلدونو می‌زنم می‌شکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 937.25,
   "end": 939.39,
   "text": "اینا وجه تمثیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 939.39,
   "end": 942.63,
   "text": "بضرب من البيان بضرب من--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 942.63,
   "end": 944.27,
   "text": "مثلا تمثیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 944.27,
   "end": 948.37,
   "text": "یه مثلیه. هرچی که تعلق داری رو میگه می‌زنم داغون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 948.37,
   "end": 954.33,
   "text": "بچتو سر می‌برن. ابراهیم مشرب باید باشی بتونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 954.33,
   "end": 957.59,
   "text": "طاقت بیاری. خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 957.59,
   "end": 961.63,
   "text": "\"فمن کان مؤمنا لم يقدر عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 961.63,
   "end": 963.69,
   "text": "آخه یه نفس چاق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 963.69,
   "end": 966.79,
   "text": "\"فمن کان مؤمنا لم يقدر عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 966.79,
   "end": 969.93,
   "text": "کسی که مؤمن باشه به تمام معنای دل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 969.93,
   "end": 973.43,
   "text": "دل کار ایمان حوزه‌ش تو قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 973.43,
   "end": 976.51,
   "text": "تعلقات تو قلبه. تعلقات ایمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 976.51,
   "end": 980.05,
   "text": "کسی که دل سپرده باشه به ولایت و به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 980.05,
   "end": 982.19,
   "text": "به قرآن و اهل بیت \"لم يقدر عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 982.19,
   "end": 985.13,
   "text": "نمی‌تونن، قدرت ندارن درش تسلط کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 985.13,
   "end": 987.11,
   "text": "تسلط داشته باشن. این الحمدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 987.11,
   "end": 990.47,
   "text": "\"و اذا حضرتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 990.47,
   "end": 993.93,
   "text": "موتاکم\". حالا یه توصیه داره حضرت انتهای روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 993.93,
   "end": 997.01,
   "text": "هر وقت حاضر شدید پیش کسایی که دارن می‌میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 997.01,
   "end": 1002.53,
   "text": "یکیشم خود ما هم وصیت می‌کنیم کسی اومد دید ما داریم دست پا می‌زنیم لحظه تا آخرمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1002.53,
   "end": 1005.25,
   "text": "\"فلقنوه الشهادة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1005.25,
   "end": 1008.25,
   "text": "تلقین کنید بهش شهادت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1008.25,
   "end": 1011.33,
   "text": "\"ان لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1011.33,
   "end": 1014.07,
   "text": "و ان محمدا رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1014.07,
   "end": 1018.01,
   "text": "صلی الله عليه و آله و سلم حتی یموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1018.01,
   "end": 1021.37,
   "text": "تا بمیره. الله اکبر از این \"حتی یموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1021.37,
   "end": 1024.91,
   "text": "طلبتون \"حتی یموت\" چرا میگی الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1024.91,
   "end": 1029.59,
   "text": "تا اون لحظه‌ای که نمرده تلقین کن، تلقین کن، تلقین کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1029.59,
   "end": 1031.83,
   "text": "چون اونور دست به کارن که اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1031.83,
   "end": 1034.07,
   "text": "مشکوکش کنن و با کفر از بین ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1034.07,
   "end": 1036.11,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1036.11,
   "end": 1039.39,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1039.39,
   "end": 1043.57,
   "text": "اللهُم صلي علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}