   "title": "## عمری که خدا در آن عذر می‌پذیرد",
   "start": 0.52,
   "end": 68.14
  },
  {
   "index": 1,
   "title": "## حسرت غفلت و سوف سوف",
   "start": 68.14,
   "end": 430.47
  },
  {
   "index": 2,
   "title": "## مناجات و حکمت‌های نهج",
   "start": 430.47,
   "end": 460.27
  },
  {
   "index": 3,
   "title": "## ضعف عمل و عادت راحت",
   "start": 460.27,
   "end": 549.59
  },
  {
   "index": 4,
   "title": "## فریب آرزو و شیطان",
   "start": 549.59,
   "end": 649.97
  },
  {
   "index": 5,
   "title": "## تک و پاتک شیطان",
   "start": 649.97,
   "end": 681.81
  },
  {
   "index": 6,
   "title": "## آغاز همین لحظه",
   "start": 681.81,
   "end": 699.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 5.36,
   "text": "روایت جدید البته از همون کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.36,
   "end": 11.74,
   "text": "باب دوم روایت نهم روایت هشتم رو دیگه تموم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.74,
   "end": 15.5,
   "text": "از نهج‌البلاغه این روایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.5,
   "end": 22.68,
   "text": "مرحوم مجلسی علیه الرحمه آورده که العُمرُ الذي أعذر الله فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.68,
   "end": 28.08,
   "text": "اون عمری که خدا عذر رو قبول می‌کنه درش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.08,
   "end": 30.44,
   "text": "کی خدا، تا کی خدا مهلت میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.44,
   "end": 34.2,
   "text": "خدا تا کی عُمر در عمر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.2,
   "end": 38.34,
   "text": "عذر ما رو قبول می‌کنه؟ در دعای کمیل میگیم اللهم فقبل عذری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.34,
   "end": 43.04,
   "text": "خدایا خیلی مهمه اینکه عذر ما رو خدا قبول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.04,
   "end": 48.12,
   "text": "حالا تا کی مهلت داریم که عذر ما در درگاه خدا پذیرفته شده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.12,
   "end": 52.62,
   "text": "تا کی به نظر شما؟ چهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.62,
   "end": 54.66,
   "text": "خب حالا اینجا ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.66,
   "end": 57.34,
   "text": "از یه جهت درست میگید از یه جهت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.34,
   "end": 63.46,
   "text": "الان، الان عرض می‌کنم. می‌فرماید الابن آدمه ستّون سنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.46,
   "end": 68.82,
   "text": "یعنی شصت سالگی. حالا شما اگر-- چطور میگم ایشون از یه جهت درست گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.82,
   "end": 73.58,
   "text": "شما اگر بیای اون دوران کودکی و خردسالی و نوجوانی و اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.58,
   "end": 76.16,
   "text": "دیگه تا سن بیست سالگی تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.16,
   "end": 80.78,
   "text": "نوجوون حساب می‌شه. یعنی بالاخره تازه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.78,
   "end": 84.3,
   "text": "تخم مرغ اومده بیرونه مثلاً نمی‌فهمه کجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.3,
   "end": 90.28,
   "text": "اینو بگیم حالا خدا این رو لطف کرده اون بیست سالو در نظر نگرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.28,
   "end": 97.3,
   "text": "اون بیست سال به علاوه چهل سال مخصـ-مخصوصاً اینطوری تقسیم کردن چون قبلاً ما بحث چهل سالو کرده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.3,
   "end": 99.96,
   "text": "هرچه کنی تا چهل سال وقت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.96,
   "end": 101.74,
   "text": "اینجا باز همونه. تصریح اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.74,
   "end": 106.44,
   "text": "اما در هر حال می‌شه به صورت معمول می‌شه شصت سالگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.44,
   "end": 108.54,
   "text": "حالا فکر کنم این ریش سفیدا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.54,
   "end": 111.46,
   "text": "ما رو بیرون کنن از اینجا. چند وقته گیر دادین به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.46,
   "end": 114.04,
   "text": "بنده خدایی که ریششون سفیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.04,
   "end": 119.44,
   "text": "دیگه اونجا کسی شصت ساله شد طبق این روایت دیگه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.44,
   "end": 123.58,
   "text": "عذرشو قبول نمی‌کنه. اگه اینطوری نگاه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.58,
   "end": 126.84,
   "text": "اون دعاهایی که توش صراحتا مثل کمیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.84,
   "end": 130.86,
   "text": "فرمود اللهم فقبل عذری ظاهراً برای آدماییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.86,
   "end": 136.32,
   "text": "جوونن. چون بعضیا تا چهل سالگی رو هم جوون گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.32,
   "end": 138.04,
   "text": "بالای اون رو میانسالی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.04,
   "end": 140.84,
   "text": "شصت به بعد رو پیری بعضیا هفتاد به بعد رو پیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.84,
   "end": 143.56,
   "text": "حالا کاری به اونش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.56,
   "end": 145.66,
   "text": "سرّ سرّ کمیل دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.66,
   "end": 149.32,
   "text": "حالا یه پیرمردی که معذرت می‌خوام از شما جسارت نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.32,
   "end": 152.52,
   "text": "جوونیش اصلاً نمی‌دونسته کمیل چیه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.52,
   "end": 155.2,
   "text": "شروع کرده آخر و دیگه هیچ جا راهش نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.2,
   "end": 158.16,
   "text": "اومده مسجد یه تسبیح دستش گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.16,
   "end": 160.8,
   "text": "در جوانی پاک بودن شیوه‌ی پیامبری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.8,
   "end": 164.36,
   "text": "و نه هر گبری به پیری می‌شود پرهیزگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.36,
   "end": 173.74,
   "text": "و می‌شینه به صورت تعقیب نماز کمیل که امام علیه الرحمه فرمود سرّ سرّ ادعیه اهل بیت هم همینطوری می‌خونه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.74,
   "end": 178.82,
   "text": "فقط تو هم اللهم فقبل عذریش ببین چه مطلبیه نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.82,
   "end": 182.82,
   "text": "شصت سال وقت داری فقط که اینو بگی بعد شصت سال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.82,
   "end": 189.12,
   "text": "راستی اینم بگم این نیعنی که کلاً در رحمت بسته می‌شه و خدا دیگه کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.12,
   "end": 194.34,
   "text": "هیچ عذری رو نمی‌پذیره. نه منظورش یک شدتیه، یک هدیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.34,
   "end": 196.9,
   "text": "یک نهیبیه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.9,
   "end": 200.22,
   "text": "چون دیگه هرچی کردی تا اون موقع کردی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.22,
   "end": 204.92,
   "text": "تموم شد. در ملکات نفست رسوخ کرده همون چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.92,
   "end": 211.04,
   "text": "خودت دنبالش بودی. خیلی به ندرت پیش میاد که انسان از شصت سالگی به بعد بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.04,
   "end": 213.66,
   "text": "مثلاً عوض بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.66,
   "end": 216.96,
   "text": "تغییر کنه. تغییرات زيل این سنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.96,
   "end": 223.08,
   "text": "برای همین تا می‌تونن اهل بیت علیهم الصلاة والسلام به انحاء مختلف چه در مناجات‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.08,
   "end": 229.56,
   "text": "و ادعیه‌شون که مقامات انشایی اون‌ها در درگاه حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.56,
   "end": 235.58,
   "text": "و چه در توصیه‌ها و روایات و احادیث‌شون ما رو از تسویف برحذر داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.58,
   "end": 238.34,
   "text": "تسویف یعنی صوفه صوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.34,
   "end": 241.5,
   "text": "امام صادق علیه السلام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.5,
   "end": 248.44,
   "text": "بیشترین حسرت که قیامت مردم می‌خورن از، یه روایت داریم از غفلتیه که در دنیا داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.44,
   "end": 250.28,
   "text": "یه روایت داریم از صوفه صوفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.28,
   "end": 254.68,
   "text": "حالا فردا، حالا پسفردا، حالا جوونیم، حالا بذار پیر شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.68,
   "end": 262.84,
   "text": "بالاخره میریم بالاخره فلان اینو اینطوری هم بالاخره بالاخره پدر ما رو درآورده این تسویف صوفه صوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.84,
   "end": 265.4,
   "text": "در یه عبارت خیلی جالبی می‌خوندم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.4,
   "end": 268.96,
   "text": "از بحار جلد یک صفحه صد و سی و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.96,
   "end": 275.26,
   "text": "که یه مالی رو شبانگاه آوردن محضر امیرالمؤمنین به عنوان بیت‌المال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.26,
   "end": 277.92,
   "text": "خب ایشون همونجا کارگزارا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.92,
   "end": 281.28,
   "text": "فراخواند شبانه، حالا همه رفتن بخوابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.28,
   "end": 286.48,
   "text": "و فرمود آقا بسم الله همین امشب کمک کنید اینو تقسیم کنیم بین فقرا و گرفتارا و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.48,
   "end": 289.48,
   "text": "گفتن آقا حالا فردا رو که عمو نگرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.48,
   "end": 295.22,
   "text": "اجازه بدید فردا. فرمود کدومتون می‌تونید ضمانت بدید که من و علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.22,
   "end": 302.2,
   "text": "تا فردا زنده باشم؟ این نگاه رو ببینید اگه مولای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.2,
   "end": 305.2,
   "text": "بعضی از ما چقدر بلندپروازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.2,
   "end": 310.1,
   "text": "مثلاً الان طرف مدیر کل آه می‌کشه برای اینکه یه روزی بره مثلاً مدیر مرکز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.1,
   "end": 313.06,
   "text": "اون آه می‌کشه بره ری-ریاست کل فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.06,
   "end": 317.36,
   "text": "دیدما یکی از دوستان خوب ما همینجا بچه خیلی خوبی هم است چندین بار اومد گفت حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.36,
   "end": 320.62,
   "text": "چرا من هرچی تقلا می‌کنم مدیر بشم نمی‌شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.62,
   "end": 324.08,
   "text": "اصلا نگاه رو ببین. بچه خوبی هم است واسه ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.08,
   "end": 327.16,
   "text": "یا یه مرد دیگه خیلی دوسش هم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.16,
   "end": 329.2,
   "text": "مثل دانشجو مثل بچه ما حساب می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.2,
   "end": 331.82,
   "text": "یه نوبه‌ام نیمچه معروف شد و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.82,
   "end": 337.82,
   "text": "با یه حسرت می‌گفت حاجی من باور کن غلط‌کاری‌هایی که بعضی مرد‌های معروف می‌کنن-- جسارت به اونا نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.82,
   "end": 339.76,
   "text": "اونا که واقعاً کارشون درسته که خوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.76,
   "end": 341.74,
   "text": "الحمدالله سر موقع دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.74,
   "end": 345.04,
   "text": "اینایی که اشتباهاتی دارن. کارایی که اونا می‌کنن من نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.04,
   "end": 349.26,
   "text": "اما چرا من معروف نمی‌شم؟ ببین نگاه‌ها چقدر غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.26,
   "end": 352.34,
   "text": "خب چه دردت می‌خوره معروف شدی که بدبخت بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.34,
   "end": 357.32,
   "text": "ما حالا یه ذره همین لباس معروفم رو کرده نیمچه میریم مثلاً حرم حضرت عبدالعظیم علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.32,
   "end": 358.88,
   "text": "اصلاً نمی‌تونم زیارت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.88,
   "end": 363.95,
   "text": "می‌ریزن دورمون سؤال، سؤال، استخاره، خواب، تعبیر خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.95,
   "end": 370.73,
   "text": "هیچی دیگه. یعنی خانمم میگه بابا تو رو خدا میری زیارت تو لباس روحانی تنت نکن بتونی به زیارتت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.73,
   "end": 372.35,
   "text": "چه برسه که دیگه همه بشناسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.35,
   "end": 375.55,
   "text": "آخه میخوای چه کنی؟ دام شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.55,
   "end": 379.01,
   "text": "این ثوفه ثوفه‌ها. خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.01,
   "end": 382.25,
   "text": "روایت پرنهیبی رو دیدم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.25,
   "end": 384.73,
   "text": "رسول خدا سؤال کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.73,
   "end": 389.25,
   "text": "که چرا این سؤال شاید برای همه ما پیش اومده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.25,
   "end": 391.31,
   "text": "ببین پیغمبر چه قشنگ جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.31,
   "end": 395.01,
   "text": "آقا چرا بعضیا می‌میرن چشمشون بسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.01,
   "end": 400.25,
   "text": "و بعضیا چشمشون بازه؟ پیغمبر چه جواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.25,
   "end": 404.31,
   "text": "پرنهیبی دادن. برای هزر داشتن ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.31,
   "end": 408.23,
   "text": "فرمودن که اون کسی که چشمش بسته است و مرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.23,
   "end": 414.23,
   "text": "پلک زده بوده، جبرائیل-- عزرائیل مجالش نداده پلکش رو باز کنه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.23,
   "end": 418.11,
   "text": "و اون کسی که چشمش بازه دیدید بعضیا چشم باز می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.11,
   "end": 422.67,
   "text": "اونم عزرائیل مجالش نداده که پلکش رو ببنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.67,
   "end": 428.35,
   "text": "تمام. خیلی واقعاً این‌ها رو آدم بهش توجه می‌کنه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.35,
   "end": 430.47,
   "text": "خیلی باید بترسه از ثوفه ثوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.47,
   "end": 433.19,
   "text": "مولا مون علی علیه الصلاة والسلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.19,
   "end": 438.83,
   "text": "در-- عرض کردن در مناجاتشون محضر حق \"و عد بفضلک علیّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.83,
   "end": 442.11,
   "text": "عبد غمره جهله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.11,
   "end": 446.27,
   "text": "یا جهلو\" یعنی خدایا به فضلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.27,
   "end": 452.85,
   "text": "ببخش، برگرد به سوی بنده تو که جهل گرفت غرق جهلش شده نادونیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.85,
   "end": 456.21,
   "text": "\"و استولی علیه تسویف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.21,
   "end": 458.69,
   "text": "استیلا پیدا کرده برش تسویف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.69,
   "end": 461.11,
   "text": "ثوفه ثوفه. حالا فردا فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.11,
   "end": 466.31,
   "text": "\"حتی سالم الأيام\" تا وقتی که عمرش می‌گذره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.31,
   "end": 468.69,
   "text": "سرش به سنگ قبر می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.69,
   "end": 471.47,
   "text": "بلند بگو لا اله الا الله زبانش بند میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.47,
   "end": 481.27,
   "text": "نمی‌تونه اونجا حرف بزنه. در حکمت دویست و هفتاد و پنج مولا فرمود \"جاهلکم مزداد و عالمکم مسوف\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.27,
   "end": 483.41,
   "text": "فرمودن جاهلای شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.41,
   "end": 492.91,
   "text": "آدمای نادونتون به مرض زیاده‌روی گرفتارن و علماتون اونا که آگاهن به گرفتاری تسویف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.91,
   "end": 497.23,
   "text": "حالا تو که بلدی مثل من بالا منبر این همه چیز می‌کنی چرا خوب عمل نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.23,
   "end": 498.87,
   "text": "شروع کن دیگه. همش برای این و اون میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.87,
   "end": 505.65,
   "text": "\"واعظان کین جلوه در محراب منبر می‌کنند چون به خلوت می‌روند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.65,
   "end": 511.01,
   "text": "آن کار دگر می‌کنند\". اهل عمل کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.01,
   "end": 518.33,
   "text": "باز در حکمت چهارصد و بیست و هفت ببین چقدر مهمه که انقدر روایت من دیدم حالا گلچین کردم سه چهار تاشون نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.33,
   "end": 521.31,
   "text": "انقدر زیاد بود پیس-- پیرامون تسویف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.31,
   "end": 524.27,
   "text": "باز مولا فرمود \"کل معاجل يسأل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.27,
   "end": 528.87,
   "text": "الإنغار\". اونایی که فرصت ندارن دنبال یه نظره رحیمی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.87,
   "end": 534.25,
   "text": "یه فرصت دوباره‌ن. هق هقش داره تموم می‌شه دیگه نفششو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.25,
   "end": 536.59,
   "text": "حضرت قابض الارواح داره از نوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.59,
   "end": 541.63,
   "text": "شست پاش می‌کشه می‌بره تا از دوسواخ بینیش بکشه بیرون جانشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.63,
   "end": 546.03,
   "text": "می‌خواد فریاد بزنه یک لحظه فقط یک آن دیگه به من اجازه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.03,
   "end": 551.63,
   "text": "نه یک شب و یک ساعت، یک آن مهلت بده بابا بذار من یه لا اله الا-- مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.63,
   "end": 557.81,
   "text": "لال. و اینجا مولا می‌فرماید و \"کل معجل\" متأسفانه اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 557.81,
   "end": 563.91,
   "text": "وقت دارن \"یتعلل بالتسویف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.91,
   "end": 567.49,
   "text": "اینا بهانه‌جویی می‌کنن به تأخیر انداختن کارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.49,
   "end": 574.09,
   "text": "حالا فردا حالا پس فردا. خیلی بیچاره کرد ما رو این تسویف واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 574.09,
   "end": 576.63,
   "text": "\"أتیتک\" دو مرتبه حضرت در مناجاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 576.63,
   "end": 581.41,
   "text": "\"یا ربه بضعف من العمل ونفس الراحة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.41,
   "end": 584.13,
   "text": "مهتاد\" این خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 584.13,
   "end": 586.53,
   "text": "من به سوی تو اومدم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 586.53,
   "end": 591.09,
   "text": "ضعف عملم، با nefsi که خودشو زده به راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 591.09,
   "end": 593.21,
   "text": "فکر کرده حساب کتاب خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.21,
   "end": 596.61,
   "text": "اینطوریه و مثل مردم عادی و به ظواهر نگاه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.61,
   "end": 600.49,
   "text": "نه. خدا ما درون را بنگریم و حال را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 600.49,
   "end": 602.23,
   "text": "نه بیرون را بنگریم و قال را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 602.23,
   "end": 607.29,
   "text": "\"ودواع التسویف منغاده\" و کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 607.29,
   "end": 611.81,
   "text": "عادت کرده به انگیزه‌های تسویف گونه همش خودشو به امروز و فردا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.81,
   "end": 615.03,
   "text": "خلاصه تا دلتون بخواد زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.03,
   "end": 616.61,
   "text": "یکی دیگه هم بگم حیفم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.61,
   "end": 618.17,
   "text": "اینا پر از نورن این روایت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.17,
   "end": 623.81,
   "text": "\"لا تقتر\" باز مولا فرمود \"لا تقتروا بالمنا و خدع الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.81,
   "end": 629.79,
   "text": "و تسویف– تسویفه فإن الشيطان عدوکم حریص على اهلاکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 629.79,
   "end": 634.75,
   "text": "آقایون غره نشید، مغرور نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 634.75,
   "end": 640.15,
   "text": "به انگیزه‌ها، به نیرنگ زدن‌های شیطان گولش رو نخورید، فریبشو نخورید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.15,
   "end": 644.53,
   "text": "و خودتون رو با تسویف یعنی ثوفه ثوفه به هلاکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.53,
   "end": 648.33,
   "text": "نندازید که این کار شیطانه، کید شیطانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 648.33,
   "end": 654.45,
   "text": "نقشه شیطان. آیا ما نقشه نقشه شیطان رو ندونیم می‌تونیم بدل بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 654.45,
   "end": 658.51,
   "text": "تک پاتک می‌خواد. باید اول بدونی تک چیه که پاتک بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 658.51,
   "end": 661.23,
   "text": "نقشه شیطان. امیرالمؤمنین داره می‌فرماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.23,
   "end": 664.67,
   "text": "توی روایت دیگه‌ای دیدم بیشتر نقشه شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 664.67,
   "end": 670.13,
   "text": "اصلاً کمینگاه مرصاد شیطان که کمین کرده زوم کرده رو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 670.13,
   "end": 672.81,
   "text": "با تسویفه. یعنی فردا فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 672.81,
   "end": 675.45,
   "text": "همین که میگی حالا از امشب شروع می‌کنم از فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 675.45,
   "end": 678.29,
   "text": "همین که زمان بهش بدی این تسویفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.29,
   "end": 681.81,
   "text": "همین الان. همین الان شروع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 681.81,
   "end": 684.49,
   "text": "هر مشکلی هست همین الان شروع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 684.49,
   "end": 686.97,
   "text": "این درسته. اونم با اراده قوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 686.97,
   "end": 691.79,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 691.79,
   "end": 694.59,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.59,
   "end": 699.21,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}