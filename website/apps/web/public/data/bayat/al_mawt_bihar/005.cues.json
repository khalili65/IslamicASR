 "chapters": [
  {
   "index": 0,
   "title": "## فارابی؛ عالم یکپارچه علم و حیات و سمع و بصر",
   "start": 164.68,
   "end": 233.7
  },
  {
   "index": 1,
   "title": "## غذای بدن مرده؛ غذای نفس حیات و کمال",
   "start": 233.7,
   "end": 294.74
  },
  {
   "index": 2,
   "title": "## انسان کامل؛ مجری اسم ممیت و محیی",
   "start": 294.74,
   "end": 364.26
  },
  {
   "index": 3,
   "title": "## جمع‌بندی؛ امتحان واکنش است نه دارایی",
   "start": 364.26,
   "end": 532.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.2,
   "end": 4.8,
   "text": "یه نکته‌ی دیگه ای رو هم به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 8.36,
   "text": "تقدیم کنم پیرامون روایت دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 11.22,
   "text": "کتاب الموت و انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.22,
   "end": 13.26,
   "text": "بریم سراغ روایت سوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.26,
   "end": 17.8,
   "text": "اگر دقت داشتید روایت دوم می‌فرمود الحیات والموت خلقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.8,
   "end": 19.5,
   "text": "این‌ها دو تا خلق الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.5,
   "end": 24.58,
   "text": "بعد فرمودند که موت وارد نمی‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.58,
   "end": 27.22,
   "text": "مگر اینکه قبلش حیات خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.22,
   "end": 30.4,
   "text": "خب این رو اگر ما بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.4,
   "end": 34.22,
   "text": "ببندیم به مطلق وجود انسان که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.22,
   "end": 38.06,
   "text": "با عقاید الهی ما سازگاری نداره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.06,
   "end": 42.44,
   "text": "موت خارج-- وارد شد کلاً حیات خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.44,
   "end": 48.92,
   "text": "یعنی موت به اون صورتی که کلاً حیات برداشته بشه اتفاق بیفته، این اصلا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.92,
   "end": 53.06,
   "text": "قاعده نیست، در علم کلام ما و اعتقادات ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.06,
   "end": 60.46,
   "text": "پس این چیه؟ قطعاً برمی‌گرده به یک وجهش برمی‌گرده به مرتبه نازله خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.46,
   "end": 67.16,
   "text": "مرتبه نازله ما. حالا یک وجه هست، یک وجهش برمی‌گرده به اینکه ما یک وجود واحدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.16,
   "end": 72.28,
   "text": "بدن ما، جسم ما همونطور که قبلاً بحثش گذشت مرتبه نازله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.28,
   "end": 79.12,
   "text": "نفس ناطقه ماست؛ یعنی حیات از مرتبه نازله خود ما خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.12,
   "end": 84.54,
   "text": "یعنی بدن ما، جسمیت ما رو می‌گیرن، اون موت بهش حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.54,
   "end": 88.3,
   "text": "و الا نفس ناطقه که مجرده و حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.3,
   "end": 91.16,
   "text": "دائمی داره. یک وجهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.16,
   "end": 93.62,
   "text": "یه وجهش هم می‌شه برگرده به عوالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.62,
   "end": 99.76,
   "text": "یعنی اینکه ما همین که از یک عالمی به عالم دیگری حرکت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.76,
   "end": 105.18,
   "text": "برای ما در اون نشئه ای که ازش خارج شدیم موت ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.18,
   "end": 110.28,
   "text": "یعنی در نشئه طبیعت دقت بفرمایید یا در طبیعت جان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.28,
   "end": 117.38,
   "text": "یا در عالم طبیعت که ما در اون هستیم برای ما اسم المومیت حضرت حق پیاده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.38,
   "end": 120.48,
   "text": "لذا ما خارج می‌شیم. می‌ریم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.48,
   "end": 123.16,
   "text": "عالم دیگری. این دو تا وجهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.16,
   "end": 127.38,
   "text": "که حالا در هر حال اونچه که مهمه ما بدونیم، بدانیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.38,
   "end": 136.42,
   "text": "از نظر اعتقادات صحیح حالا عرفان اسلامی، حکمت اسلامی، اعتقادات اسلامی، کلام، هرچه که بخواید بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.42,
   "end": 139.48,
   "text": "اصلاً این نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.48,
   "end": 144.52,
   "text": "به قول مرحوم حاجی سبزواری علیه الرحمه تو منظومه‌شون می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.52,
   "end": 146.42,
   "text": "\"حیات تفور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.42,
   "end": 149.86,
   "text": "به به به چه لفظ شیرینی به کار بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.86,
   "end": 154.48,
   "text": "\"حیات تفور\" اصلاً حیات می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.48,
   "end": 159.16,
   "text": "موت چیه؟ موت برمی‌گرده به مرتبه نازله انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.16,
   "end": 161.1,
   "text": "همینطور حالا دو وجهش رو ما عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.1,
   "end": 164.68,
   "text": "و الا یکپارچه عالم هستی حیات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.68,
   "end": 169.9,
   "text": "اصلاً حضرت علامه حسن زاده علیه الرحمه در درس صد و شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.9,
   "end": 172.74,
   "text": "شرح فصوص‌شون اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.74,
   "end": 178.62,
   "text": "می‌فرمایند که به نقل از مدینه فاضله مرحوم فارابی که خیلی هم توصیه می‌کردند به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.62,
   "end": 182.22,
   "text": "کتاب ناقلا کوچولو که خیلی عظمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.22,
   "end": 186.22,
   "text": "فرمودند اونجا بخونید ماحصلش مضمون کلیش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.22,
   "end": 188.38,
   "text": "که ان ها هنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.38,
   "end": 194.34,
   "text": "مرحوم فارابی که می‌دونید در حکمت و فلسفه ابوعلی سینا جانشین ایشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.34,
   "end": 198.76,
   "text": "و در طب جانشین زکریای رازی، شیخ الرئیس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.76,
   "end": 203.36,
   "text": "حالا اونجا می‌فرماید که ان ها هنا یعنی این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.36,
   "end": 206.7,
   "text": "لعلم، همش یکپارچه علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.7,
   "end": 209.54,
   "text": "لحیات، لاراده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.54,
   "end": 212.2,
   "text": "لسمع، لبصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.2,
   "end": 215.62,
   "text": "یکپارچه عالم بصره، یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.62,
   "end": 220.14,
   "text": "شنوده، یکپارچه حیات، یکپارچه عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.14,
   "end": 222.14,
   "text": "اونجا تو مدینه فاضله مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.14,
   "end": 224.44,
   "text": "فارابی این رو اثبات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.44,
   "end": 232.98,
   "text": "خیلی شیرین که ما وقتی نگاهمون اینطوری باشه اصلاً موت به اون معنای از بین رفتن این‌ها دیگه معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.98,
   "end": 235.3,
   "text": "همه چی هست حتی غذای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.3,
   "end": 239.1,
   "text": "اون چیزی که ما به بدنمون میدیم یه غذای مرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.1,
   "end": 242.26,
   "text": "حتی غذای وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.26,
   "end": 248.36,
   "text": "یا غذای نفس ناطقه ما که اصل اون هویت ذاتی ماست، اون هم حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.36,
   "end": 252.72,
   "text": "حضرت علامه حسن زاده میگه اصلاً غذای ما حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.72,
   "end": 255.56,
   "text": "غذای ما برای نفس ناطقه مون کماله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.56,
   "end": 258.44,
   "text": "علمه. حالا شما علم رو بگیری به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.44,
   "end": 262.96,
   "text": "بخوای سر رشته‌شو پیدا کنی که ام شیء الا عندنا خزائنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.96,
   "end": 266.18,
   "text": "خزائنه علم هم ذات حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.18,
   "end": 269.46,
   "text": "اونم که حی مطلقه. همه چی حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.46,
   "end": 272.86,
   "text": "ما فکر می‌کنیم یه چیزهایی در عالم مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.86,
   "end": 278.12,
   "text": "این‌ها، این اصطلاحات جهت خروج و تبدیل و تبدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.12,
   "end": 283.6,
   "text": "یکی وجه وجود ماست، یک خروج از ما، یک از یک عالمی به عالم دیگه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.6,
   "end": 286.86,
   "text": "که آیه قرآن هم در هر حال می‌فرماید اینا لیبلی و کو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.86,
   "end": 289.78,
   "text": "اینا ابتلا‌اند، بلا‌اند، امتحان‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.78,
   "end": 292.1,
   "text": "که شما نسبت به حیات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.1,
   "end": 294.74,
   "text": "ممات چگونه رفتار می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.74,
   "end": 297.42,
   "text": "که حالا البته اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.42,
   "end": 301.58,
   "text": "اسم المومیت رو در ما پیاده می‌کنه، صاحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.58,
   "end": 304.12,
   "text": "این اسم است به نحو اتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.12,
   "end": 313.34,
   "text": "اون کسی که اسم المحی، المحی رو در ما پیاده می‌کنه به اسم المحی حضرت حق حیات رو در ما پیاده می‌کنه، اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.34,
   "end": 318.06,
   "text": "صاحب اسم المحی حضرت حق است به نم-- به نحو اتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.06,
   "end": 323.04,
   "text": "اون کیه؟ انسان کامل. یعنی باز قابض الارواح وقتی میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.04,
   "end": 327.26,
   "text": "می‌میرانه، اون هم یک شأنی از شؤون انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.26,
   "end": 331.36,
   "text": "اون هم حالا انسان کامل به یک معنا فاصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.36,
   "end": 338.02,
   "text": "چون میاد بین نفس ناطقه ما و بدن و جسمیت ما فاصله می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.02,
   "end": 341.08,
   "text": "به وسیله عزرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.08,
   "end": 345.32,
   "text": "به یک معنا جامعه‌ست. چون میاد وقتی حیات می‌بخشه بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.32,
   "end": 351.58,
   "text": "نفس ناطقه ما و بدن ما جمعيت اجتماع برقرار می‌کنه، مجتمع می‌کنه این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.58,
   "end": 356.8,
   "text": "باز کار انسان کامله. اصلاً همه عالم سررشته‌ش دست انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.8,
   "end": 359.28,
   "text": "حیات، ممات همه برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.28,
   "end": 364.26,
   "text": "ما به توسط انسان کامل داریم امتحان پس می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.26,
   "end": 368.42,
   "text": "اجازه بفرمایید اینجا این نکته رو در جمع‌بندی عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.42,
   "end": 373.62,
   "text": "به نظر شما امتحان در داشتن است یا نداشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.62,
   "end": 376.62,
   "text": "در حیات است یا ممات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.62,
   "end": 380.0,
   "text": "حیات یعنی ممات امتحان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.0,
   "end": 383.46,
   "text": "این اینجا در آیه‌ای که براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.46,
   "end": 387.6,
   "text": "قرائت کردیم آیه سوره، آیه دو سوره ملک چی می‌فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.6,
   "end": 391.56,
   "text": "اینو ببینید. \"الذي خلق الموت والحياة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.56,
   "end": 395.88,
   "text": "ليبلوكم أيكم أحسن عملا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.88,
   "end": 401.38,
   "text": "میگه چه مطلق حیات و چه مطلق موت برای امتحان شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.38,
   "end": 404.3,
   "text": "پس ممات هم امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.3,
   "end": 406.86,
   "text": "ممات هم امتحانه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.86,
   "end": 410.2,
   "text": "یعنی این که دقت کنید این نکته خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.2,
   "end": 414.16,
   "text": "نه داشتن مهمه، نه نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.16,
   "end": 417.24,
   "text": "یعنی چه قنا، چه فقر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.24,
   "end": 419.5,
   "text": "چه مریضی، چه سلامت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.5,
   "end": 421.96,
   "text": "ها؟ چه قدرت، چه ضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.96,
   "end": 426.28,
   "text": "همه این‌ها. چه ضعف داری، چه قدرت داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.28,
   "end": 428.86,
   "text": "چه توانگری داری، یعنی قنا داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.86,
   "end": 436.08,
   "text": "چه فقر داری، چه دور از جونت مریضی داری، چه سلامت داری، چه جهل داری، چه علم داری، هرچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.08,
   "end": 438.2,
   "text": "داری یا نداری مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.2,
   "end": 441.9,
   "text": "اون امتحان نیست. امتحان روی اون پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.9,
   "end": 448.1,
   "text": "یعنی چی؟ یعنی عکس العمل ما نسبت به اون داشتن و نداشتن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.1,
   "end": 451.48,
   "text": "تمام شد. این معنای امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.48,
   "end": 454.28,
   "text": "عکس العمل ما نسبت به حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.28,
   "end": 457.38,
   "text": "عکس العمل ما نسبت به ممات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.38,
   "end": 462.0,
   "text": "عکس العمل ما نسبت-- ما چگونه رفتار می‌کنیم نسبت به فقر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.0,
   "end": 464.7,
   "text": "نسبت به قنا، نسبت به جهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.7,
   "end": 468.26,
   "text": "نسبت به علم، نسبت به مریضی و سلامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.26,
   "end": 469.9,
   "text": "اون می‌شه امتحان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.9,
   "end": 472.14,
   "text": "اون می‌شه نتیجه امتحان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.14,
   "end": 476.22,
   "text": "روی اون مریضی و سلامت امتحان پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.22,
   "end": 480.6,
   "text": "درست شد؟ اما مهم داشتن و نداشتن نیست اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.6,
   "end": 483.86,
   "text": "در حالی که ما میاییم می‌گیم فلانی مدیره تحویلش بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.86,
   "end": 487.78,
   "text": "فلانی هیچ‌کس هست اصلاً سلامش هم خشک جواب میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.78,
   "end": 491.62,
   "text": "فلانی پول داره تحویلش می‌گیریم، فلانی فقیره کاری باهاش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.62,
   "end": 497.82,
   "text": "اینطور نیست؟ در حالی که تو آموزه‌های ما فرمودن اگر کسی-- این حدیث رو ببینید بترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.82,
   "end": 500.22,
   "text": "اگر کسی صرفاً به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.22,
   "end": 503.72,
   "text": "پول کسی جلو پاش بلند شه ایمانش می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.72,
   "end": 507.58,
   "text": "پول چیه؟ اصلاً داشتن و نداشتن مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.58,
   "end": 511.84,
   "text": "هر دو امتحانه. همونطور که اینجا میگه هم ممات امتحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.84,
   "end": 514.16,
   "text": "هم حیات امتحانه. مهم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.16,
   "end": 521.2,
   "text": "که من و شما نسبت به حیات و ممات، مریضی و سلامت این‌ها چگونه رفتار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.2,
   "end": 523.96,
   "text": "اون رفتار ما مهمه، اون برای ما نوشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.96,
   "end": 532.24,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}