 "chapters": [
  {
   "index": 0,
   "title": "## بازگشت از انتهای روایت؛ ابن للخراب",
   "start": 15.54,
   "end": 71.46
  },
  {
   "index": 1,
   "title": "## واژگان قرآنی خراب و هلاک",
   "start": 71.46,
   "end": 459.38
  },
  {
   "index": 2,
   "title": "## خراب تکوینی نه تشریعی",
   "start": 459.38,
   "end": 742.97
  },
  {
   "index": 3,
   "title": "## و استعمرکم فیها؛ آبادانی در مسیر آخرت",
   "start": 742.97,
   "end": 838.81
  },
  {
   "index": 4,
   "title": "## عبرت از استهلاک تدریجی بدن",
   "start": 838.81,
   "end": 858.99
  },
  {
   "index": 5,
   "title": "## آلارم‌های بدن و صیحهٔ نهایی",
   "start": 858.99,
   "end": 935.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.56,
   "end": 7.66,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.66,
   "end": 12.9,
   "text": "السلام علیک یا داعی الله و ربانیة آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.9,
   "end": 15.54,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.54,
   "end": 18.78,
   "text": "در باب چهارم روایت دوم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.78,
   "end": 21.44,
   "text": "این روایت بسیار کثیر الفروع هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.44,
   "end": 24.08,
   "text": "از ابتدای روایت تا انتهای دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.08,
   "end": 26.8,
   "text": "اجمالاً رفتیم. حالا بالعکس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.8,
   "end": 29.94,
   "text": "انتها بیاییم به اول که امام باقر علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.94,
   "end": 35.7,
   "text": "فرمود لِلْ- لِد متولد کن لِلْمَوْت برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.7,
   "end": 39.04,
   "text": "موت. که حالا اجمالاً چیزکی از موت گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.04,
   "end": 43.24,
   "text": "واجمع للفنا جمع کن برای فنا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.24,
   "end": 48.64,
   "text": "همه چی فانی می‌شه. کل من علیها فان ويبقى وجه ربک ذو الجلال و الاکرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.64,
   "end": 52.96,
   "text": "وابن للخراب بنا کن برای خراب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.96,
   "end": 59.96,
   "text": "روی این حالا از انتهای روایت دو مرتبه، یه مرتبه برگردیم به ابتدا ببینیم چی گیرمون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.96,
   "end": 63.68,
   "text": "بحث ما شرح کتاب الموت مرحوم مجلسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.68,
   "end": 66.42,
   "text": "بحث رو گم نکرده باشید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.42,
   "end": 70.26,
   "text": "در خصوص خراب شدن اینجا سوالی پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.26,
   "end": 72.92,
   "text": "آیا اولاً در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.92,
   "end": 75.04,
   "text": "واژگان خراب شدن داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.04,
   "end": 80.42,
   "text": "یعنی خداي معنان در آیات الهی بر خراب شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.42,
   "end": 83.78,
   "text": "آنچه که ما بنا می‌کنیم تصریح داشته‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.78,
   "end": 87.34,
   "text": "در آیات. دو اینکه این خراب شدن چگونه خراب شدنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.34,
   "end": 94.12,
   "text": "اگر امام باقر علیه السلام فرموده هر روز منادی ندا می‌زنه که عرض کردیم این ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.12,
   "end": 98.26,
   "text": "ذکر کائناته. چون دائماً هر روز تکرار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.26,
   "end": 100.42,
   "text": "بنا کن برای خراب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.42,
   "end": 104.12,
   "text": "این چگونه خراب شدنه؟ پس ما هم بزنیم خراب کنیم همه چی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.12,
   "end": 109.32,
   "text": "دنیا رو خراب کنیم. اگه قراره میگه بنا کن برای خراب شدن پس ما هم خراب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.32,
   "end": 113.08,
   "text": "اصلاً بنا نکنیم‌ها. این باید درست جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.08,
   "end": 119.92,
   "text": "اولاً در خصوص واژگان قرآنیه چند تا-- زیاده، خیلی زیاده ماشاءالله در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.92,
   "end": 123.56,
   "text": "چند تاشو من براتون درآوردم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.56,
   "end": 127.5,
   "text": "یکی یخرون. مثلاً در آیه دو سوره هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.5,
   "end": 135.42,
   "text": "\"یخرون ابیوتهم بایدیهم\" با دستای خودشون خراب می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.42,
   "end": 138.96,
   "text": "و ایدی المؤمنین و با دستای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.96,
   "end": 140.82,
   "text": "اینو خراب کردن با دست خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.82,
   "end": 147.48,
   "text": "اهل ایمان خراب کردن. \"فاعتبروا یا اولی الابصار\" میگه از این عبرت بگیرید ای صاحبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.48,
   "end": 153.58,
   "text": "نگاه عمیق. این یه آیه که صراحتاً داره تصریح می‌کنه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.58,
   "end": 159.66,
   "text": "که به هم که میاد به دست اهل ایمان هم میگه یه نوع تأییدیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.66,
   "end": 161.92,
   "text": "یکی دیگه از واژگان قرآنی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.92,
   "end": 164.4,
   "text": "از بین بردن، تخریب این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.4,
   "end": 167.04,
   "text": "نابود کردن، \"تلفخ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.04,
   "end": 170.12,
   "text": "اونجایی که می‌فرماید \"تلفخ وجوههم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.12,
   "end": 175.98,
   "text": "این حالا آیاتشو دیگه بخوام بخونم طولانی می‌شه فقط عبارات رو بگم رد شم که یعنی می‌سوزاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.98,
   "end": 178.4,
   "text": "از لفظ میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.4,
   "end": 181.7,
   "text": "که مسمومیت جلدی و پوست صورت رو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.7,
   "end": 185.2,
   "text": "یه نوع پوست صورتشون از بین میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.2,
   "end": 187.54,
   "text": "خراب می‌شه، مسموم می‌شه تو آتیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.54,
   "end": 193.56,
   "text": "\"دمدمه\" اینم یکی از کلماتی‌ست در قرآن اومده به معنای فروریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.56,
   "end": 198.32,
   "text": "از دمدمه میاد به معنای خراب کردن بنا روی کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.32,
   "end": 202.26,
   "text": "وقتی یه بنا رو روی کسی خراب کنی ازش در عرب به دمدمه یاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.26,
   "end": 208.86,
   "text": "\"عروشها\" اونجا که \"خاویتن علی عروشها\" بیان کرده دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.86,
   "end": 213.02,
   "text": "تأکید هم توشه. یکی خاویتن، یکی عروشها تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.02,
   "end": 218.8,
   "text": "یک جهت دارن. عروشها کنایه است از خرابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.8,
   "end": 226.12,
   "text": "که چون وقتی که یه خونه رو خراب می‌کنند اول، اول سقفش خراب می‌شه، سقفش می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.12,
   "end": 228.76,
   "text": "این عروشه‌ها اشاره داره به اون سقف اون خونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.76,
   "end": 233.9,
   "text": "بعد دیوارها خراب می‌شه. یه تأکید بعد خاویتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.9,
   "end": 238.26,
   "text": "خود خاویه به چیز توخالی می‌گن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.26,
   "end": 242.0,
   "text": "دورش بندازن. خاویتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.0,
   "end": 246.74,
   "text": "یعنی سرنگون شده. استعاره از دیاریه که سکنش خالی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.74,
   "end": 251.72,
   "text": "سرنگون شده، دیواراش روی سقف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.72,
   "end": 258.62,
   "text": "سقفش ببخشید ریخته روی آدمایی که گرداگرد یا درون اون دیوار حصر پناه گرفته بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.62,
   "end": 260.38,
   "text": "نشانه از کمال خرابی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.38,
   "end": 264.06,
   "text": "ببینید اینا همه رد پای خرابی در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.06,
   "end": 266.48,
   "text": "متب- متب- متبرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.48,
   "end": 270.32,
   "text": "متبرون باز در قرآن اومده به معنای نابود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.32,
   "end": 273.36,
   "text": "و تباه شده. متبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.36,
   "end": 276.3,
   "text": "متبرون رو باهاش تشدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.3,
   "end": 282.48,
   "text": "این مثلاً از ماده تبار به معنای هلاکت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.48,
   "end": 288.88,
   "text": "\"يبور\" یه چیز بی‌نتیجه‌ای که نابود می‌شه و هلاک می‌شه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.88,
   "end": 291.66,
   "text": "تو این ریشه می‌بره عرب. \"یدحب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.66,
   "end": 295.42,
   "text": "یعنی تا نابود کنند. از ادحاض میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.42,
   "end": 297.76,
   "text": "به معنای هلاک کردن و باطل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.76,
   "end": 301.24,
   "text": "\"یوبقهن\". \"یوبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.24,
   "end": 305.3,
   "text": "هن\". یعنی اون‌ها رو نابود می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.3,
   "end": 309.2,
   "text": "این \"یوبق هن\" مضارع باب افعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.2,
   "end": 315.98,
   "text": "از مظهر ایباق. که ایباق به معنای اهلاک و نابود کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.98,
   "end": 318.94,
   "text": "کل شیء حال کن الا وجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.94,
   "end": 323.22,
   "text": "همه چی هلاک می‌شه. \"اقبوا الیا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.22,
   "end": 325.34,
   "text": "میگه کار منو تمام کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.34,
   "end": 328.58,
   "text": "مرا بکشید، نابود کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.58,
   "end": 332.46,
   "text": "خب این کلمه قضا توجه داشته باشید وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.46,
   "end": 337.62,
   "text": "با حرف الا متعدی می‌شه به معنای تمام کردن کار، کار مفعوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.62,
   "end": 340.8,
   "text": "یعنی آقا منو بکش تمومش کن بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.8,
   "end": 344.62,
   "text": "خرابم کن به یه معنا. \"طرفاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.62,
   "end": 352.02,
   "text": "اونجا که می‌فرماید \"لیقطع طرفاً من الذین کفروا\" میگه بعضی از کافرون رو ریشه‌کن و نابود کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.02,
   "end": 354.3,
   "text": "\"یقطع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.3,
   "end": 357.84,
   "text": "که قطع کند. قطع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.84,
   "end": 362.54,
   "text": "قطع دابر کنایه از نابود کردن و منقرض ساختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.54,
   "end": 365.06,
   "text": "اینا رو فرق‌هاشم بدونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.06,
   "end": 368.44,
   "text": "اینجا به گونه‌ای نابود می‌کنی که اصلاً منقرض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.44,
   "end": 373.68,
   "text": "دیگه هیچ اثری ازشون نیست. \"یسحتکم\" شما را نابود و ریشه‌کن می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.68,
   "end": 375.94,
   "text": "سهد به معنای پوسته‌هاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.94,
   "end": 380.6,
   "text": "دور ریخته می‌شه. پوستی که دی-- دور ریخته می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.6,
   "end": 383.46,
   "text": "مثل مثلاً مرغ رو می‌خورن پوستشو می‌ریزن بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.46,
   "end": 386.98,
   "text": "به درد نمی‌خوره. به اون می‌گن سهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.98,
   "end": 391.22,
   "text": "که حالا به پوسته‌ی توخالی هم در عرب اینچنین می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.22,
   "end": 394.64,
   "text": "دابر که متعلقات هر چیزو می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.64,
   "end": 401.78,
   "text": "اون قطع دابر المتکبرین یا این به گونه‌ای که اثری ازش هیچی نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.78,
   "end": 404.06,
   "text": "نعدو یعنی می‌شماریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.06,
   "end": 408.44,
   "text": "تو آیه \"فلا تجعل عليهم إنما نعد لهم عدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.44,
   "end": 411.24,
   "text": "دوباره تک- تاکید می‌کنه عدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.24,
   "end": 415.0,
   "text": "یعنی یه جوری بشمری یه چیزی رو تا آخرش بشمری تمومش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.0,
   "end": 419.5,
   "text": "امیرالمؤمنین می‌فرما جلوی صف دشمن که وایسادی \"أعر الله جمجمتك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.5,
   "end": 424.38,
   "text": "جمجمتو به خدا بسپر و تا آخرین نفر صف دشمن رو برانداز کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.38,
   "end": 428.08,
   "text": "اون‌ها رو بشمار. یعنی چی تا آخرشو بشمار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.08,
   "end": 430.32,
   "text": "یعنی دندونت رو هم فشار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.32,
   "end": 436.06,
   "text": "جمجمتو به خدا بسپر که تا آخرین نفر دشمن رو هلاک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.06,
   "end": 441.84,
   "text": "و عرض شود خدمتتون. عدا هم که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.84,
   "end": 444.42,
   "text": "حالا اجازه بدید یه روایتی تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.42,
   "end": 449.76,
   "text": "کلمات زیاده بخوایم بگیم امروز همش به عبارات قرآنی می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.76,
   "end": 457.08,
   "text": "این یه سؤال که آیا در قرآن واژگانی پیرامون هلاک و خراب شدن هست یا نه که تقدیم کردیم چند تا تبرکاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.08,
   "end": 461.64,
   "text": "سؤال دومم جواب بدیم که حالا این خراب شدن چه نوع خراب شدنیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.64,
   "end": 465.82,
   "text": "خراب شدن تشریعی‌ست یا تکوینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.82,
   "end": 469.4,
   "text": "اگر تشریعیه یعنی قانونه پس ما هم باید خراب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.4,
   "end": 475.44,
   "text": "بزنیم خراب کنیم. اما اگر تکوینه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.44,
   "end": 478.94,
   "text": "برای فهم این قصه از خود اهل بیت کمک می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.94,
   "end": 487.0,
   "text": "امیرالمؤمنین علیه الصلاة والسلام در ط- طوف العقول عن آل الرسول صفحه هفتاد و هفت این روایت رو از مولا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.0,
   "end": 490.38,
   "text": "فرمودن \"واعلم\" بدون که \"أن من كانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.38,
   "end": 495.48,
   "text": "متيته الليلة والنهار\" بدون اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.48,
   "end": 497.12,
   "text": "مرکبش شده شب و روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.12,
   "end": 499.68,
   "text": "مطیه. مرکبش شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.68,
   "end": 504.1,
   "text": "شب و روز. یعنی دائماً قوتوره به همین دن-- زندگی دنیایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.1,
   "end": 509.12,
   "text": "\"فإن هو یسار به وإن کان لا یسیر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.12,
   "end": 512.74,
   "text": "اگرچه خودش نخواد بره اما می‌برنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.74,
   "end": 517.58,
   "text": "اون کسی که دنیایی زندگی می‌کنه، می‌برنش اگرچه خودش نخواد بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.58,
   "end": 521.54,
   "text": "\"أب الله إلا خراب الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.54,
   "end": 524.18,
   "text": "وعمارة الآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 524.18,
   "end": 530.84,
   "text": "اینجا مقصود نظرم است. مولا تاکید می‌کنه حواستون رو جمع کنید که اصلا خدا اینچنین خواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 530.84,
   "end": 533.16,
   "text": "سنت الهی بر اینه. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.16,
   "end": 535.96,
   "text": "خراب الدنيا. یعنی جز اینو خدا نخواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.96,
   "end": 538.86,
   "text": "إلا خراب الدنيا وعمارة الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.86,
   "end": 541.68,
   "text": "که دنیا رو، اصلا دنیا خراب شدنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.68,
   "end": 543.96,
   "text": "خدا خواسته که دنیا خراب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.96,
   "end": 547.86,
   "text": "و عمارة الآخرة و آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.86,
   "end": 552.2,
   "text": "تعمیر بشه. آب-- مثلاً ابدی باشه، تخریبی درش وجود نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.2,
   "end": 554.4,
   "text": "\"أي بني\" ای پسرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.4,
   "end": 560.64,
   "text": "به فرزندش داره می‌فرماید \"و إن تزهد فيما زهدك الله فيه من الدنيا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.64,
   "end": 562.96,
   "text": "اگر تو به ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.96,
   "end": 564.9,
   "text": "توجه کن به نصیحت من گوش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.9,
   "end": 568.76,
   "text": "اگر از دنیا چنان که خدا خواسته اعراض کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.76,
   "end": 570.52,
   "text": "دنیا سزاوار آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.52,
   "end": 573.14,
   "text": "اونطور که خدا خواسته از دنیا اعراض کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.14,
   "end": 577.02,
   "text": "حالا عرض می‌کنیم یعنی چی. دنیا سزاوار اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.02,
   "end": 583.38,
   "text": "بعد ادامه میدن که \"وتعر– وتعرف نفسك عنها فهي أهل ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.38,
   "end": 591.52,
   "text": "وإن كنت غير قابل النصيحة يا كفيها فاعلم\" یقیناً \"أنك لن تبلغ أملك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.52,
   "end": 594.2,
   "text": "ولن تعدو یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.2,
   "end": 597.58,
   "text": "تعد و أجلك یا أجلك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.58,
   "end": 605.98,
   "text": "می‌فرماید حالا اگر نصیحت منو پذیرفتی، به یقین بدون که علاقه به دنیا سرنوشت تو رو تغییر نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.98,
   "end": 611.5,
   "text": "علاقه به دنیا سرنوشتت رو تغییر نمی‌ده و به آرزوهات نمی‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.5,
   "end": 615.6,
   "text": "از عمر متعددت اون پا فراتر نمی‌نهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.6,
   "end": 620.58,
   "text": "یعنی اون مقدرت، از اون چیزی که برات مقدر شده پا فراتر نمی‌گذاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 620.58,
   "end": 622.84,
   "text": "و راه پیشینیان، اینجا منظور مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.84,
   "end": 625.72,
   "text": "راه پیشینیان را به پیمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.72,
   "end": 628.6,
   "text": "راه پیشینیان را به پیمایی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 628.6,
   "end": 631.9,
   "text": "یعنی امر تکوینیه. خدا خواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.9,
   "end": 634.26,
   "text": "فرق تکوین با تشریع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 634.26,
   "end": 636.34,
   "text": "تکوین در کن و تک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 636.34,
   "end": 638.88,
   "text": "کن و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 638.88,
   "end": 643.12,
   "text": "کینونت در اون ذات عالم سرشته شده هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 643.12,
   "end": 646.46,
   "text": "یعنی همه به سمت مرگ در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.46,
   "end": 650.78,
   "text": "اگر قرار بود امر مرگ و موت تشریعی بشه، میشد قانون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.78,
   "end": 653.38,
   "text": "یعنی همه باید خودشونو می‌زدن می‌کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.38,
   "end": 657.38,
   "text": "اما همچین چیزی نیست. خرابی دنیا منظور اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 657.38,
   "end": 660.8,
   "text": "تشریعی نیست. یعنی شما هم بزن خراب کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.8,
   "end": 665.82,
   "text": "یعنی توجه بفرمایید، یعنی امر تکوینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 665.82,
   "end": 672.7,
   "text": "یعنی خدا خواسته است که دنیا به سمت استهلاک و خرابی پیش برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 672.7,
   "end": 675.52,
   "text": "خدا نخواسته ما بزنیم دنیا رو خراب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.52,
   "end": 679.58,
   "text": "بلکه در تکوین دنیا قرار داده استهلاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 679.58,
   "end": 682.08,
   "text": "\"كل شيء هالك إلا وجهه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.08,
   "end": 688.06,
   "text": "اینم یک امری‌ست، سنتی‌ست از سمت و ناحیه حضرت حق برای اعتبار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.06,
   "end": 690.6,
   "text": "عبرت گرفتن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.6,
   "end": 694.56,
   "text": "چرا؟ چون اگر غیر از این بود ما دل به دنیا خوش می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.56,
   "end": 697.86,
   "text": "ما قراره بمیریم. نباید دل به دنیا خوش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 697.86,
   "end": 703.44,
   "text": "همونطور که قبلًا عرض کردم هر مقدار که تعلق به دنیا داریم برزخمون طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 703.44,
   "end": 705.38,
   "text": "استهلاک در دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 705.38,
   "end": 709.08,
   "text": "یه ماشین می‌خری می‌بینی ده ساله دیگه عُد شد، شوت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.08,
   "end": 711.02,
   "text": "دیگه به درد نمی‌خوره. بیچاره‌ت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 711.02,
   "end": 713.38,
   "text": "می‌گه به استهلاک افتاده بفروشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 713.38,
   "end": 716.58,
   "text": "یه خونه می‌خری ده سال به بعد دیگه قیمتش می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.58,
   "end": 718.2,
   "text": "دیگه فقط پول زمینشو میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.2,
   "end": 721.4,
   "text": "اینا برای چیه؟ ببینید تو دنیا هم اعتبار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.4,
   "end": 725.68,
   "text": "به جهت اینه که همه چی به سمت خرابی تکویناً داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.68,
   "end": 729.9,
   "text": "نه اینکه تو بزن خراب کن. یعنی اینکه دل نس-- نبند به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 729.9,
   "end": 733.89,
   "text": "و الا ما مأمور شدیم به آبادی-- آبادانی دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 733.89,
   "end": 736.71,
   "text": "در انتهای بحث یه آیه هم تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.71,
   "end": 739.01,
   "text": "که قشنگ دیگه فرق رو متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.01,
   "end": 741.55,
   "text": "آیه شصت و یک سوره هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 741.55,
   "end": 744.27,
   "text": "می‌فرمود که حالا اجازه بدید از وسط آیه بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 744.27,
   "end": 746.69,
   "text": "\"هو انشأکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 746.69,
   "end": 750.47,
   "text": "آقا جنس ما از چیه؟ خدا ما رو از چی ساخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 750.47,
   "end": 754.77,
   "text": "او کسی‌ست که \"أنشأکم\" شما رو \"أنشأ\" کرده \"من الأرض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.77,
   "end": 757.97,
   "text": "از این خاکی که روش نشستی از جنس از اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 757.97,
   "end": 761.21,
   "text": "حالا که چی بشه؟ \"وستعمرکن فيها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 761.21,
   "end": 765.61,
   "text": "برای اینکه شما باید این خاک رو این عالم نشئیت طبیعت خاکی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 765.61,
   "end": 775.03,
   "text": "آباد کنید. اگر قرار باشه خرابی یعنی بزن خراب کن قانون دین باشه پس این \"وستعمرکن فيها\" چی کاره است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 775.03,
   "end": 779.85,
   "text": "این آبادانی که تو این آیه شصت و یک سوره هود دستور می‌ده چی کاره است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 779.85,
   "end": 783.97,
   "text": "میگه در جهت آخرت دنیات رو آباد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 783.97,
   "end": 789.43,
   "text": "مثلاً کسی اومد پیش امام صادق صلوات الله علیه گفت آقا جون من خونه‌ی بزرگ می‌خوام بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 789.43,
   "end": 791.15,
   "text": "حضرت فرمود برای چی می‌خوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.15,
   "end": 794.83,
   "text": "این نشون میده نیت مهمه. خونه‌ی بزرگ برای چی می‌خوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.83,
   "end": 797.11,
   "text": "عرض کرد آقا می‌خوام سعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 797.11,
   "end": 799.01,
   "text": "سعه بدم، سعه بدم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.01,
   "end": 801.65,
   "text": "مثلاً خانواده‌ام به همسرم، بچه‌هام در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 801.65,
   "end": 805.13,
   "text": "راحتی باشن، آسایش باشن. بعد درش کارهای خیر بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.13,
   "end": 807.09,
   "text": "مثلاً جلسه قرآن بگیرم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 807.09,
   "end": 809.15,
   "text": "حضرت فرمود این که عین آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 809.15,
   "end": 818.51,
   "text": "این که دنیا نیست. توجه کردی این آبادانی دنیا یعنی در مسیر آخرت بهره بگیره از دنیا در مسیر آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 818.51,
   "end": 826.71,
   "text": "اشتباه نشه. اونجا که می‌فرمود خدا \"وابن للخراب\" بنا کن ولی خدا خواسته خراب بشه یعنی دل نبند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 826.71,
   "end": 829.65,
   "text": "همه کل شی \"إن حال کل إلا وجه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 829.65,
   "end": 833.43,
   "text": "همه چی در حال هلاک شدن و از بین رفتن و تخریبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 833.43,
   "end": 837.83,
   "text": "یه نگاه کنین اصلاً از اول تا الان ما حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 837.83,
   "end": 844.07,
   "text": "تا همین الان نزدیک غریبه به نود جلسه پیرامون همین چند تا روایتی که از ابتدای کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 844.07,
   "end": 848.63,
   "text": "کتاب الموت مرحوم مجلسی هستیم پیرامون موت حرف زدیم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.63,
   "end": 852.79,
   "text": "همین یه نکته یه تأمل کنین، توجه به پیرامونمون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 852.79,
   "end": 856.47,
   "text": "تو آیه هم فرمود \"فاعتبروا يا اولي الابصار\" عبرت بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 856.47,
   "end": 858.99,
   "text": "که آقا همه چی داره از بین میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 858.99,
   "end": 861.79,
   "text": "ظاهراً. ما باید بناش کنیم دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 861.79,
   "end": 864.27,
   "text": "یعنی داره خراب می‌شه \"وابن للخراب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 864.27,
   "end": 868.35,
   "text": "چرا دل می‌بندی؟ بدن خودت ببین چقدر تخریب شده از بچگی تا حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 868.35,
   "end": 874.33,
   "text": "الان ببین هرچی که سنت میره بالا بحث ارز العلو العمرو که داشتیم از شصت سالگی به بعد دیگه تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 874.33,
   "end": 879.57,
   "text": "سفر موت آغاز شده. اینکه چشمت کم سو می‌شی یعنی سفر چشم آغاز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 879.57,
   "end": 882.09,
   "text": "گوشت کم می‌شنوه یعنی سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 882.09,
   "end": 884.65,
   "text": "مرگ گوش آغاز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 884.65,
   "end": 888.01,
   "text": "یهو می‌بینی دست و پات درد می‌گیره، می‌لنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 888.01,
   "end": 891.25,
   "text": "اینا یعنی سفر استخون‌ها و توان و قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.25,
   "end": 893.19,
   "text": "بازو بدنی شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 893.19,
   "end": 896.19,
   "text": "سفر موت شروع شده. به یکباره نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 896.19,
   "end": 898.61,
   "text": "همه چی دار، داره تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 898.61,
   "end": 901.33,
   "text": "خدا داره این تنبه خاطر رو به ما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 901.33,
   "end": 904.37,
   "text": "تازه باز اینه ما انقدر دل به دنیا بستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 904.37,
   "end": 907.37,
   "text": "آخرت رو رها کردیم. حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 907.37,
   "end": 913.47,
   "text": "همه چی داره آلارم می‌زنه. بازم میگم تأکید می‌کنه که حواست باشه ان قريب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 913.47,
   "end": 918.87,
   "text": "که چی؟ صدا بلند بشه بلند بگو لا اله الا الله که دل نبندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 918.87,
   "end": 923.09,
   "text": "انشاالله عاقبت-- چه بچه‌های حرف گوش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 923.09,
   "end": 926.17,
   "text": "انقدر نفس ما تأثیر داشت ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 926.17,
   "end": 928.05,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 928.05,
   "end": 930.87,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 930.87,
   "end": 935.73,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}