 "chapters": [
  {
   "index": 0,
   "title": "## ملاک تبرّی؛ معصیت نه بلا",
   "start": 0.14,
   "end": 30.2
  },
  {
   "index": 1,
   "title": "## تنحیص بلا برای مؤمن و اقسام کافر",
   "start": 30.2,
   "end": 80.06
  },
  {
   "index": 2,
   "title": "## کلام امیر؛ بازگشت نعمت با نیت صادق",
   "start": 80.06,
   "end": 390.22
  },
  {
   "index": 3,
   "title": "## تمثیل شمس؛ انسان کامل",
   "start": 390.22,
   "end": 601.96
  },
  {
   "index": 4,
   "title": "## لیالی قدر در سلسلهٔ طولی",
   "start": 601.96,
   "end": 647.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 2.24,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.24,
   "end": 7.34,
   "text": "علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.34,
   "end": 10.84,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.84,
   "end": 14.54,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.54,
   "end": 19.2,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.2,
   "end": 22.42,
   "text": "رسیدیم به باب سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.42,
   "end": 25.8,
   "text": "روایت دهم از کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.8,
   "end": 27.4,
   "text": "ال Amott مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.4,
   "end": 29.82,
   "text": "دیروز روایت رو براتون خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.82,
   "end": 34.08,
   "text": "دو تا نکته از این روایت عرض کنم و ازش رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.08,
   "end": 38.24,
   "text": "ابتدا به این متوجه شدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.24,
   "end": 43.56,
   "text": "ملاک اینکه ما کسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.56,
   "end": 51.04,
   "text": "حالا مثلا تنبیه کنیم نکنیم، قطع رابطه بکنیم نکنیم اینا همه در معصیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.04,
   "end": 53.68,
   "text": "ملاک در معصیت کردن طرفه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.68,
   "end": 56.98,
   "text": "نه اینکه بلا زده باشه، فقیر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.98,
   "end": 60.34,
   "text": "دشت پایین اجتماع باشه، ضعیف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.34,
   "end": 62.34,
   "text": "اصلا اینا هیچ‌کدوم مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.34,
   "end": 64.76,
   "text": "مریضی صعب العلاج داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 64.76,
   "end": 67.72,
   "text": "طاعون خورده باشه این حرفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.72,
   "end": 69.98,
   "text": "فقط ملاک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 69.98,
   "end": 72.08,
   "text": "در تبرّی جستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 72.08,
   "end": 74.32,
   "text": "عصیان‌کار بودن طرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 74.32,
   "end": 78.88,
   "text": "عاصی. خط قرمز خدا معصیته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 78.88,
   "end": 85.36,
   "text": "لذا وقتی که امیرالمؤمنین علیه الصلاة والسلام چقدر زرنگ بوده آقا از پیغمبر سؤال کرد که در این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 85.36,
   "end": 89.7,
   "text": "این همه اعمال هست بهترین کار در ماه مبارک رمضان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.7,
   "end": 91.72,
   "text": "همه می‌دونید پیغمبر چی جواب دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 91.72,
   "end": 96.26,
   "text": "فرمودن افضل الأعمال في هذا الشهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.26,
   "end": 99.88,
   "text": "الورع عن محارم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.88,
   "end": 102.32,
   "text": "ورع فرمودن نه تقوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 102.32,
   "end": 105.18,
   "text": "ورع شدت تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 105.18,
   "end": 108.28,
   "text": "یعنی حتی فکر گناه رو هم نکنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 108.28,
   "end": 112.38,
   "text": "این بهترین کاریه که در این ماه صورت می‌گیره که انّə",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 112.38,
   "end": 120.4,
   "text": "به یک وجه پیغمبر داره تصریح می‌کنه که قوای باطنی‌ت رو هم حتی قوه‌ی خیالت رو هم تو این ماه باید پاک‌سازی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.4,
   "end": 122.78,
   "text": "این یه نکته که از تو دل بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 122.78,
   "end": 128.76,
   "text": "بیرون اومد. نکته‌ی دوم متحرّیت بلاها و امراضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.76,
   "end": 132.3,
   "text": "تو اصل تنحیص که اونجا حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.3,
   "end": 137.04,
   "text": "تنحیص باعث بخشش و ریزش گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.04,
   "end": 140.76,
   "text": "اهل بلاست، مریضی‌ها و سختی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.76,
   "end": 146.48,
   "text": "و اون صبری که می‌کنن بشارته و بشّر الصابرین این بشارته بر صبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.48,
   "end": 149.36,
   "text": "می‌شه همون بخشش و غفران الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.36,
   "end": 152.66,
   "text": "این هم برای اهل ایمان که قضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.66,
   "end": 155.94,
   "text": "یعنی کسی اهل ایمان باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.94,
   "end": 159.98,
   "text": "هر نوع بلایی سرش بیاد این تنحیص گناهان و ذنون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.98,
   "end": 164.46,
   "text": "گناهاشو می‌ریزه. اما برای کفار چه تو-- چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.46,
   "end": 167.12,
   "text": "کفار دو قسم‌اند. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.12,
   "end": 170.1,
   "text": "کفار کافر اعتقادی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.1,
   "end": 171.86,
   "text": "یعنی زده‌ن به قول ما زیر میز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.86,
   "end": 174.78,
   "text": "اینا اصطلاحا می‌گیم جاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 174.78,
   "end": 176.98,
   "text": "بهشون می‌گن جاهل مقصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 176.98,
   "end": 185.64,
   "text": "تقصیرکارن. الانم که عص-عصر ارتباطات راحت می‌تونن ارتباط بگیرین، اطلاعات جمع کنن و به حقایق حقّه برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.64,
   "end": 189.36,
   "text": "اگر به اعتقاداتش نفوذ کرده کفر نه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.36,
   "end": 193.58,
   "text": "هرچی بلا سرش بیاد تنحیص ذنونش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.58,
   "end": 196.92,
   "text": "بلکه شرش دفع می‌شه از اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.92,
   "end": 202.36,
   "text": "اما اگر جاهل قاصر باشه، کوتاهی کرد-- کوتاهی نکرده بهش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.36,
   "end": 205.3,
   "text": "اون مقصر کوتاهی کرده، این کوتاهی نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.3,
   "end": 209.26,
   "text": "بهش نرسیده حقایق بهش نرسیده یا در اعتقاداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.26,
   "end": 211.74,
   "text": "قبول داره در عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.74,
   "end": 214.96,
   "text": "نماز نمی‌خونه مثلا قبول داره خدا رو ولی نماز نمی‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.96,
   "end": 217.6,
   "text": "این دیگه کافر اعتقادی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 217.6,
   "end": 219.84,
   "text": "کافر نجس که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 219.84,
   "end": 223.76,
   "text": "این چرا؟ این هر بلایی سرش بیاد این تنحیص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 223.76,
   "end": 225.92,
   "text": "ذنونش بزرگان فرمودن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.92,
   "end": 232.58,
   "text": "مخصوصا با توجه به آیه‌ی چهل و دو سوره انعام که صراحتا می‌فرماید و لقد ارسلنا الی امم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.58,
   "end": 236.94,
   "text": "قبل که همونطور که قبل از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 236.94,
   "end": 239.8,
   "text": "پیغمبر‌ها رو ارسال کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 239.8,
   "end": 243.04,
   "text": "فاخذناهم بالبعثی و البرّی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 243.04,
   "end": 249.98,
   "text": "این سختی‌هایی که به سر اینا ریخته شد ما اینا رو گرفتیم به سختی‌ها، به بلاها و مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.98,
   "end": 254.16,
   "text": "که چی بشه؟ لعلهم يتورعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.16,
   "end": 256.3,
   "text": "تذرّع، زاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 256.3,
   "end": 258.78,
   "text": "بلکه اینا تذرّع کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 258.78,
   "end": 263.78,
   "text": "پس تذرّع اگر که، اگر بلاها و سختی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 263.78,
   "end": 266.46,
   "text": "سبب بشه که اون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 266.46,
   "end": 269.48,
   "text": "از خدا دور بودند برگردند حتی ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 269.48,
   "end": 275.56,
   "text": "کافرند. ظاهرا یعنی از جهت اعتقادی نه ها عرض کردم از جهت عملی کافرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.56,
   "end": 279.92,
   "text": "حت-- اون‌ها هم اگر بلاها باعث، باعث بشه که برگردند متنبّه بشوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 279.92,
   "end": 286.94,
   "text": "اینجا قرآن می‌فرماید لعلهم يتورعون به تذرّع و زاری بیفتند، بفهمند چه غلطی کردن برگردند به سمت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.94,
   "end": 289.7,
   "text": "خدا اینا رو می‌بخشه. خیلی خدای خوبی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.7,
   "end": 294.44,
   "text": "اونجایی که هفتاد بار میگن فرعون داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.44,
   "end": 298.5,
   "text": "غرق می‌شد یا از شاید داشت فرو می‌رفت تو زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.5,
   "end": 300.78,
   "text": "اونجا موسی رو صدا زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.78,
   "end": 303.64,
   "text": "همه اینو شنیدید حتما. فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.64,
   "end": 310.86,
   "text": "تا وقتی که اون رود نیل شکافته شد این داشت غرق می‌شد هفتاد بار حضرت موسی رو صدا زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.86,
   "end": 313.28,
   "text": "بعد حضرت موسی جوابش نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.28,
   "end": 316.44,
   "text": "خدا بعدا به یک وجه گوش موسی رو پیچونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.44,
   "end": 321.2,
   "text": "فرموده که اگر یک بار منو صدا می‌زد جوابشو می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.2,
   "end": 325.42,
   "text": "اینطوریه یعنی این ولی خب به تذرّع به درگاه خدا نیفتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.42,
   "end": 332.88,
   "text": "البته در این روایت یک موضوعی هست، یه نکته‌ای هست که به جاش باید گفته بشه و ازش سوء برداشت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.88,
   "end": 339.5,
   "text": "فرمایش امیرالمؤمنین هم ذیل این آیه براتون بخونم در تفسیر اهل بیت علیهم الصلاة والسلام جلد چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.5,
   "end": 342.02,
   "text": "صفحه‌ی سیصد و هشتاد و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.02,
   "end": 344.86,
   "text": "حالا دیگه عبارت عربیشو نخونم فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.86,
   "end": 348.26,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمودند اگر مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.26,
   "end": 350.72,
   "text": "هنگامی که عذاب‌ها بر آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.72,
   "end": 358.12,
   "text": "فرود می‌آید و نعمت‌ها از دستشان می‌رود، عذاب اومده نعمت رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.12,
   "end": 365.14,
   "text": "با نیت‌های صادقانه‌ی خود و دل‌های مشتاق به پروردگارشان پناه می‌بردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.14,
   "end": 368.18,
   "text": "چی می‌شد؟ بلا اومده نعمت رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 368.18,
   "end": 370.7,
   "text": "حالا اینا پناه ببرن با نیت صادقشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.7,
   "end": 374.14,
   "text": "آنچه از دست رفته به آنها باز می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.14,
   "end": 376.68,
   "text": "عجب! و هر فسادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.68,
   "end": 379.7,
   "text": "را برایشان اصلاح می‌نمود خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 379.7,
   "end": 387.46,
   "text": "این یعنی بلا اومده نعمت هم برده اما اگر متذرّعانه برگردن خدا یه همچین خدایی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.46,
   "end": 394.46,
   "text": "و نکته‌ی آخر رو هم عرض کردیم تمثیلی که امام سجاد علیه السلام از خورشید آورده ما دیروز گفتیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.46,
   "end": 402.18,
   "text": "چیزکی. این نکته خیلی قابل تامله که حالا اونجا می‌فرماید خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.18,
   "end": 410.88,
   "text": "همونطور که خورشید برای یه سری عذاب عقابه، برای یه سری رحمت و نع-نعمت مثلاً میوه رو می‌پزه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.88,
   "end": 414.56,
   "text": "برای بعضیا کم آبی و قحطی و این‌ها به بار میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.56,
   "end": 417.64,
   "text": "تمثیلشو زدیم به انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.64,
   "end": 424.22,
   "text": "بر اساس روایاتی که ذیل آیات هست گفتیم این منظور این شمس انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.22,
   "end": 429.76,
   "text": "که مظهر جلالش میشد جهنم، مظهر جمالش میشد بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.76,
   "end": 432.24,
   "text": "حالا انسان اینو خیلی باید توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.24,
   "end": 435.5,
   "text": "انسان کامل یعنی امام عصر ما الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.5,
   "end": 442.56,
   "text": "هیچ گاه استعداد کسی رو ضایع نخواهد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.56,
   "end": 448.34,
   "text": "یعنی طرف بدترین آدم باشه اگر امام عصر تشخیص بده یه سر سوزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.34,
   "end": 451.86,
   "text": "این احتمال راه نجات براش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.86,
   "end": 456.18,
   "text": "استعدادی در درونش هنوز باقی مونده، مزمحل نکرده همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.18,
   "end": 461.02,
   "text": "قوای درونیش رو حضرت این رو پرورش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.02,
   "end": 466.18,
   "text": "مثالش تو اون روایتی که خیلی عجیبه این روایت چند جور روایت به این معنا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.18,
   "end": 469.54,
   "text": "یکی در رابطه با سید و شهدا تو کربلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.54,
   "end": 472.18,
   "text": "که ابالفضل می‌زد دو رو می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.18,
   "end": 475.96,
   "text": "سلام الله علیه ولی ابی عبدالله با تأمل می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.96,
   "end": 479.84,
   "text": "و در جنگ نهروان هم دیدن که امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.84,
   "end": 482.7,
   "text": "با بعضیا اینطوری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.7,
   "end": 488.6,
   "text": "شمشیرو میاره از بغل طرف رد می‌کنه یا زخمی‌ش می‌کنه، نمی‌زنه کارشو تموم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.6,
   "end": 494.06,
   "text": "اما مالک نه دو رو می‌کرد. اتفاقاً توی داستان شیرینی روایتی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.06,
   "end": 498.84,
   "text": "وقتی جنگ تموم شد دوتایی با هم امیرالمؤمنین و مالک رفتن کشته‌هاشون رو شمردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.84,
   "end": 501.18,
   "text": "دیدن به یک اندازه کشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.18,
   "end": 506.44,
   "text": "هم امیرالمؤمنین این تعداد کشته هم مالک به یک اندازه کشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.44,
   "end": 509.64,
   "text": "بعد امیرالمؤمنین یه جمله‌ی خیلی معناداری فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.64,
   "end": 514.42,
   "text": "فرمود مالک درسته که تو هم به اندازه‌ی من کشتی اما کشته‌های تو کجا، کشته‌های من کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.42,
   "end": 520.24,
   "text": "درسته همه‌ی این‌ها بر علیه امام به حق قیام کردند حقشون بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.24,
   "end": 526.0,
   "text": "قتل و کشتن و قاتلوهم حتی لاتکون فسن آیه‌ی قرآنه بکشید اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.0,
   "end": 530.08,
   "text": "اما من توجه می‌کردم به نسل در نسل‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.08,
   "end": 532.96,
   "text": "بعضی از روایات فرموده به هفت نسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.96,
   "end": 535.9,
   "text": "بعضی از روایات هم مطلق آورده به نسل در نسل‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.9,
   "end": 540.06,
   "text": "اگر یک امیرالمؤمنین به مالک میگه اگر یه نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.06,
   "end": 547.74,
   "text": "تو نسل اینا پیدا می‌کردم که عبد صالح خدا بشه، ایمان بیاره اون استعدادشو بروز بده، من اینو نمی‌کشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.74,
   "end": 552.84,
   "text": "اما تو زدی کشتی. اصلاً محال انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.84,
   "end": 556.58,
   "text": "استعداد کسی رو از بین ببره، مزمحل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.58,
   "end": 560.02,
   "text": "لذا این بلاها، این مشکلات این‌ها میاد می‌ریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.02,
   "end": 562.24,
   "text": "سر دیگران که اینجا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.24,
   "end": 565.46,
   "text": "تمثیل به شمس زده. شمسو بگیرید انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.46,
   "end": 568.38,
   "text": "اون اشعه شدید خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.38,
   "end": 571.56,
   "text": "می‌زنه اون میوه‌ای که استعدادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.56,
   "end": 575.8,
   "text": "رویدنه، درختی که رویدنه، میوه‌ای که رسیدنه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.8,
   "end": 579.66,
   "text": "استعدادش اینه هنوز تو وجودش استعداد داره خراب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.66,
   "end": 584.76,
   "text": "اما اون کسی که نه هیچ استعدادی در وجودش ایجاد نکرده و همه رو از بین برده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.76,
   "end": 590.66,
   "text": "قوای وجودیش رو به تعالی نرسونده، خورشید می‌زنه داغونش می‌کنه، می‌سوزونتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.66,
   "end": 594.16,
   "text": "قحطی و بی‌آبی براش میاره و بیچاره‌ش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.16,
   "end": 597.26,
   "text": "یه همچین تمثیلی چقدر قشنگ امام سجاد علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.26,
   "end": 599.5,
   "text": "آورده. بس به دامن امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.5,
   "end": 601.46,
   "text": "عزیز، امام زمان عزیزمون پناه ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.46,
   "end": 608.36,
   "text": "امروز هم روز قدر بود. به اندازه‌ی شب قدر حدیث داریم قدر و قیمت داره روز بیست و هفتم ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.36,
   "end": 614.38,
   "text": "تو تمام ادعیه روزهای ماه مبارک رمضان هم دقت کنید فقط تو دعای امروز میگه خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.38,
   "end": 616.3,
   "text": "درک لیلة القدر رو نصیبم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.3,
   "end": 621.7,
   "text": "یه سری درشه که حالا ما دیشب حدود نیم ساعت پیرامون لیالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.7,
   "end": 625.04,
   "text": "سلسله‌ی طولی لیالی قدر حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.04,
   "end": 632.06,
   "text": "انشاالله بچه‌ها تو کانال گذاشتن توصیه می‌کنم اونو حتما به دردتون می‌خوره که چشم و گوشمون باز بشه نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.06,
   "end": 635.28,
   "text": "لیالی قدر. فکر نکنیم یه شب بود تموم شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.28,
   "end": 640.22,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
