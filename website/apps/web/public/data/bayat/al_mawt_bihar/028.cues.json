   "start": 3.3,
   "end": 55.9
  },
  {
   "index": 1,
   "title": "## ذلت و انکسار در لحظهٔ انتقالِ امامت",
   "start": 55.9,
   "end": 175.68
  },
  {
   "index": 2,
   "title": "## فسخِ عظائم؛ خدا در کار است",
   "start": 175.68,
   "end": 254.88
  },
  {
   "index": 3,
   "title": "## خدا با هر کس به زبانی؛ داود و قورباغه",
   "start": 254.88,
   "end": 334.98
  },
  {
   "index": 4,
   "title": "## سلیمان و مورچه؛ تنبّه در حدّ خود",
   "start": 334.98,
   "end": 374.99
  },
  {
   "index": 5,
   "title": "## موت؛ بهترین اندرز و موعظه",
   "start": 374.99,
   "end": 395.17
  },
  {
   "index": 6,
   "title": "## شیطان و منبرِ نیم‌سوخته در معراج",
   "start": 395.17,
   "end": 740.71
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.3,
   "end": 6.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.56,
   "end": 13.76,
   "text": "السلام علیک ای داعی الله و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.76,
   "end": 17.72,
   "text": "قبل از اینکه ادامه بحث رو بدم عذرخواهی می‌کنم از اینکه بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.72,
   "end": 22.8,
   "text": "حقیر در این جایگاه می‌شینم واقعا بعضی از دوستان رو که می‌بینیم در عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.8,
   "end": 25.06,
   "text": "هم در حوزه نظر هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.06,
   "end": 27.8,
   "text": "حیث عمل از ما خیلی جلوترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.8,
   "end": 30.44,
   "text": "ببخشید ما جسارت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.44,
   "end": 35.44,
   "text": "به رسم \"فَذَكِّرْ فَإِنَّ الذِّكْرَى تَنفَعُ الْمُؤْمِنِينَ\" ما این مطالب رو عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.44,
   "end": 38.44,
   "text": "یه نفعی هم خود ما با گفتنش ببریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.44,
   "end": 41.42,
   "text": "و الا الحمد لله شما از ما جلوترید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.42,
   "end": 50.7,
   "text": "بحث موت بود که اینکه خدا به وسیله موت بالاخره همه رو می‌زنه تا اون‌ها رو از خودشیفتگی، معجب شدن، از تکبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.7,
   "end": 53.98,
   "text": "عجب اینا بکشونه پایین و به خشیت بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.98,
   "end": 63.12,
   "text": "و عجیب که در فرمایشات امام صادق هست بارها عرض کردیم خیلی عجیبه این حدیث که از حضرت سؤال کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.12,
   "end": 66.36,
   "text": "شما از کجا می‌فهمید که امام شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.36,
   "end": 69.38,
   "text": "مثلا ابا عبدالله تو گودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.38,
   "end": 72.9,
   "text": "غسلگاه امام سجاد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.9,
   "end": 75.7,
   "text": "خیمه‌ست. پرده هم انداخته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.7,
   "end": 78.98,
   "text": "از کجا متوجه شد یک لحظه امام شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.98,
   "end": 82.04,
   "text": "اون لحظه که امام از دنیا فارغ شد امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.04,
   "end": 86.04,
   "text": "امام سجاد تو خیمه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.04,
   "end": 92.88,
   "text": "امام صادق عجیبه فرمودن که اون لحظه یک ذلت و خاری، انکساری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.88,
   "end": 98.66,
   "text": "ذلتی در برابر حضرت حق در وجود ما ایجاد می‌شه که قبل از اون این شدت نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.66,
   "end": 104.18,
   "text": "یه امام که منسوب از حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.18,
   "end": 107.2,
   "text": "با ذلت منسوب می‌شه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.2,
   "end": 113.2,
   "text": "سمت امامتش. خیلی عجیبه یعنی با این خشیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.2,
   "end": 120.14,
   "text": "حالا کسایی که مدیریت می‌گیرن، مسئولیت می‌گیرن و هرچی این مسئولیت سنگین‌تر و درشت‌تر، اون خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.14,
   "end": 123.12,
   "text": "لازم در درون باید بیشتر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.12,
   "end": 125.16,
   "text": "که قبلش به این حالت می‌افتن یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.16,
   "end": 131.28,
   "text": "مثلا رهبر عزیزمون خودشون بارها فرمودن من اصلا نمی‌خواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.28,
   "end": 136.32,
   "text": "رهبری رو دست بگیرم. به اصرار آقاست تو جلسه هرچه من اصرار کردم نمی‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.32,
   "end": 138.5,
   "text": "این نشانه آدم باتقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.5,
   "end": 143.7,
   "text": "علارغم آدمایی که سر کله می‌شکنن، آبرو می‌برن، چقدر پول خرج می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.7,
   "end": 146.44,
   "text": "تا ریاست بگیرن. اینا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.44,
   "end": 149.54,
   "text": "قابل جمع نیست. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.54,
   "end": 151.5,
   "text": "نکن آقا تو این دنیا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.5,
   "end": 156.98,
   "text": "خودت خودت رو عقاب نکن، مؤدب نکن با موت می‌شی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.98,
   "end": 162.02,
   "text": "با موت. واقعا کسی که غافل از موتش می‌شه این بلاها هم سرش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.02,
   "end": 166.52,
   "text": "اما نه، آدمایی که چیز فهم‌ن، نکته سنج‌ن، حواسشون جمعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.52,
   "end": 169.38,
   "text": "آن به آن خدا داره با اونا صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.38,
   "end": 174.42,
   "text": "آقا حالا دیگه بالاتر از اینکه امیر بیان، امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.42,
   "end": 178.62,
   "text": "فرمود که عرفت الله. آقا من و شما خدا رو چگونه شناختیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.62,
   "end": 183.84,
   "text": "مولا چگونه شناخت؟ فرمود عرفت الله من شناختم خدا رو به چی یا مولا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.84,
   "end": 185.96,
   "text": "فرمود به فسخ العظائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.96,
   "end": 189.06,
   "text": "عجب. به فسخ کردن اراده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.06,
   "end": 191.86,
   "text": "زور می‌زنی یه اتفاقی بیفته نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.86,
   "end": 193.68,
   "text": "خداست و داره خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.68,
   "end": 196.44,
   "text": "چرا ما غافلیم از خدایی کردن خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.44,
   "end": 199.12,
   "text": "انگار که دنیا دست ماست هرچی ما می‌خوایم باید همون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.12,
   "end": 207.98,
   "text": "نخیر. اصلا یه دلیلی که ظهور آقا ظهور امام عصر هم اتفاق نمیفته چون خداست و داره خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.98,
   "end": 214.42,
   "text": "برای همین بعضی از ما بعضی او-- وقتی اینو می‌گیم تعجب می‌کنیم که آقا ما معتقدیم امام عصر هنوز برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.42,
   "end": 216.94,
   "text": "ظهور خودش دعا نکرده. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.94,
   "end": 223.98,
   "text": "چون اگر یقین کنه که رضایت-- چون اسم اعظمه لب تر کنه خدا میگه لبیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.98,
   "end": 226.44,
   "text": "پس دعا نکرده که اتفاق نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.44,
   "end": 233.38,
   "text": "چرا دعا نکرده؟ چون هنوز رضایت حضرت حق رو صد در صد در ظهورش نمی‌بینه و الا دعا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.38,
   "end": 237.9,
   "text": "ولی به ما میگه شما دعا کنید \"فأكثروا الدعاء بتعجیل الفرج\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.9,
   "end": 240.4,
   "text": "زیاد هم دعا کنید که این فرج خودتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.4,
   "end": 243.12,
   "text": "این فرج خودتونه نه فرج من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.12,
   "end": 246.9,
   "text": "آخرم خودش تو سجده شب جمعه فرجش رو از خدا طلب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.9,
   "end": 250.46,
   "text": "یقین می‌کنه که دیگه به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.46,
   "end": 254.88,
   "text": "موقعش رسیده طلب می‌کنه. این خشیت خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.88,
   "end": 260.16,
   "text": "با همه آدم‌ها به انواع، به انواع مختلف خدا حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.16,
   "end": 262.56,
   "text": "با انبیا یه جور. دیروز بحث حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.56,
   "end": 264.22,
   "text": "شیخ بهائی رو عرض کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.22,
   "end": 266.74,
   "text": "هر طوریه با هرکی یه جور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.74,
   "end": 274.58,
   "text": "مثلا حضرت داود در حالاتش می‌خوندم که یه شب جمعه‌ای تا سحر تا دم بین الطلوعین عبادت کرد، مناجات کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.58,
   "end": 279.46,
   "text": "حال خوش، انبساط خاطر بعضی موقع‌ها پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.46,
   "end": 282.94,
   "text": "خود حضرت داود میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.94,
   "end": 287.9,
   "text": "می‌فرماید که این در \"جواهر الثنیه فی احاديث القدسیه\" شیخ راملی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.9,
   "end": 292.14,
   "text": "میاد حالا در اون پستو منزلش یه نگاه به آسمون می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.14,
   "end": 296.98,
   "text": "تو وجود خودش میگه آیا کسی بود که یه همچین شبی مثل من تا صبح...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.98,
   "end": 300.78,
   "text": "اینم حالت خودشیفتگی که ما فکر می‌کنیم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.78,
   "end": 303.48,
   "text": "عجب نیست چون عجب گناه کبیره است و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.48,
   "end": 305.78,
   "text": "انبیا به دوره. سواله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.78,
   "end": 308.56,
   "text": "آیا کسی بود اینطور باشه امشب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.56,
   "end": 311.62,
   "text": "بغل پای ایشون یه قورباغه به صدا در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.62,
   "end": 315.84,
   "text": "خدا داره صحبت می‌کنه و الا قورباغه که نمی‌تونه حرف بزنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.84,
   "end": 321.5,
   "text": "می‌فرماید داود چگونه کسی نبود که من از وقتی که خدا خلقم کرده هر شب تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.5,
   "end": 327.68,
   "text": "صبح دارم میگم \"سبحون القدوس رب الملائكة والروح ربنا ورب الملائكة والروح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.68,
   "end": 330.18,
   "text": "یه قورباغه اما جلو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.18,
   "end": 334.84,
   "text": "حضرت داود به این شکل متنبّه می‌شه حالا در حد خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.84,
   "end": 339.6,
   "text": "یا حضرت سلیمان نبی وقتی قحطی اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.6,
   "end": 343.18,
   "text": "خب خدا می‌تونست مستجاب کنه ادعیه مؤمنین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.18,
   "end": 345.84,
   "text": "اهل ایمان رفتن چقدر نماز استغاثه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.84,
   "end": 347.54,
   "text": "نیایش‌های خاص اون موقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.54,
   "end": 353.64,
   "text": "خبری نشد. بعد یه مدتی گذشت باران شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.64,
   "end": 355.94,
   "text": "سرش رو از حضرت سلیمان پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.94,
   "end": 357.56,
   "text": "حضرت خودش کشف کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.56,
   "end": 361.36,
   "text": "فرمود یه روزی من رد می‌شدم دیدم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.36,
   "end": 364.24,
   "text": "مورچه، نمل که ما زیر پا لهش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.24,
   "end": 367.83,
   "text": "مولا علی فرمود اینو نکشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.83,
   "end": 371.63,
   "text": "مورچه دست به دعا برداشته داره به خدا میگه خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.63,
   "end": 374.99,
   "text": "ما رو به گناه بنی آدم عقاب نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.99,
   "end": 378.89,
   "text": "چرا از ما دریغ می‌کنی؟ باران رحمتت را نازل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.89,
   "end": 380.95,
   "text": "و اونجا دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.95,
   "end": 384.31,
   "text": "خدا استجابت کرد دعای مورچه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.31,
   "end": 386.69,
   "text": "سوره نمل رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.69,
   "end": 392.75,
   "text": "این حضرت سلیمان نبی متنبّه میشه به جهت یک مورچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.75,
   "end": 395.17,
   "text": "اینا همش حساب کتاب داره که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.17,
   "end": 398.15,
   "text": "حالا اونا در حد خودشون من و شما هم در حد خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.15,
   "end": 402.33,
   "text": "حالا ما در حد خودمون میگیم از عجب و تکبر بکشیم خودمونو پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.33,
   "end": 404.49,
   "text": "چرا میگه هر روز متوجه موت باش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.49,
   "end": 408.01,
   "text": "بهترین اندرز و موعظه موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.01,
   "end": 410.25,
   "text": "که بدونی کارت تمومه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.25,
   "end": 412.61,
   "text": "چقدر لب-- یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.61,
   "end": 415.27,
   "text": "چشم رو هم زدی ریشات سفید شد، تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.27,
   "end": 417.15,
   "text": "بلند بگو لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.15,
   "end": 422.29,
   "text": "تو هم رو دستایی که داری از اول صحبت تا حالا در گوشی حرف می‌زنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.29,
   "end": 424.33,
   "text": "تو هم به م-- به موت می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.33,
   "end": 427.57,
   "text": "حالا گوش نده. به موت می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.57,
   "end": 432.11,
   "text": "هممون، هممون من که اینجا نشستم مدعی‌ام تا شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.11,
   "end": 434.07,
   "text": "حواسمون جمع باشه این یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.07,
   "end": 437.45,
   "text": "به قول قدیمی‌ها میگن شتریه که جلو در خونه هر کسی می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.45,
   "end": 439.93,
   "text": "عذرخواهی می‌کنم اینو میگم از رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.93,
   "end": 445.65,
   "text": "کبر و تکبر خودمون حاضر نیستیم با یه آدم بد صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.65,
   "end": 452.65,
   "text": "جالبه که حضرت داوود به یک گنهکاری که می‌خواستن اعدامش کنن بالا دار بکشنش رفت پیشش گفت منو نصیحت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.65,
   "end": 456.53,
   "text": "اذنی. گفت هرگز گنهکار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.53,
   "end": 460.43,
   "text": "سرزنش نکن. عجب موعظه‌ای کرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.43,
   "end": 465.51,
   "text": "پیغمبر خدا. به یه گنهکار میگه منو موعظه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.51,
   "end": 472.77,
   "text": "پیغمبر خدا. بعد ما نمی‌دونم از دماغ فیل افتادیم از دماغ شتر افتادیم چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.77,
   "end": 474.85,
   "text": "اصلاً حوصله‌ی حرف شنیدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.85,
   "end": 481.63,
   "text": "صحبت شنیدن حتی از یه آدم بی‌عملی مثل من رو که نداریم که هیچی دیگه چه برسه به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.63,
   "end": 484.93,
   "text": "چی می‌خواستم بگم پیغمبر از معراج برمی‌گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.93,
   "end": 487.13,
   "text": "عجب شبی معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.13,
   "end": 488.73,
   "text": "اون معراج، معراج اصلی‌ش‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.73,
   "end": 491.19,
   "text": "چون صد و بیست معراج رو مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.19,
   "end": 494.51,
   "text": "شیخ طوسی در امالی‌ش میاره برای ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.51,
   "end": 502.01,
   "text": "برای پیغمبر. یک معراج اون اصل کارش که برمی‌گشت تو راه برخورد به شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.01,
   "end": 504.67,
   "text": "خب باید بره دیگه پیغمبر اعتنا نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.67,
   "end": 508.41,
   "text": "ولی شیطان گفت من می‌خوام به شما یه نصیحتی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.41,
   "end": 517.93,
   "text": "پیغمبر فرمود بگو. گفتش که یا رسول الله شما رفتی تو آسمون چهارم یه منبر نیم‌سوخته ندیدی که واژگون شده بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.93,
   "end": 522.59,
   "text": "پیغمبر فرمود چرا دیدم. گفت اون منبر من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.59,
   "end": 524.21,
   "text": "مگه شیطان هم منبر می‌رفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.21,
   "end": 527.13,
   "text": "بله. خیلی الان شیطان‌ها هستن منبر میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.13,
   "end": 531.15,
   "text": "دلیل نداره که هر کی رو منبر نشست کارش درست باشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.15,
   "end": 534.65,
   "text": "خیلی شیطان‌های عمامه به سر منبر میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.65,
   "end": 538.11,
   "text": "یه حرف قشنگی که یه بنده خدایی به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.11,
   "end": 542.27,
   "text": "در جواب بعضیا که حالا عمامه پرونی راه انداخته بودن خیلی کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.27,
   "end": 544.17,
   "text": "بهشون گفت آقا چرا اینا رو می‌زنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.17,
   "end": 550.75,
   "text": "این بیچاره‌هایی که اکثرشون هم قشر مستضعف و گرفتار جامعه برید تو زندگی‌هاشون ببینید چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.75,
   "end": 553.29,
   "text": "تو اجتماع داره یه پیرمرد عمامه به سر راه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.29,
   "end": 555.47,
   "text": "راست میگی برو عمامه روحانی رو بپرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.47,
   "end": 559.85,
   "text": "اون کله‌ش اون حسن کلیدسازو بکن بپرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.85,
   "end": 562.79,
   "text": "فلانی رو بپرون. اینو اونو حرف خوبی داره می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.79,
   "end": 567.17,
   "text": "اگه راست میگی به اونا بزن. چرا زورت به این می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.17,
   "end": 573.23,
   "text": "اونی که داره در لباس دین خیانت می‌کنه میری بهش رای میدی خراب می‌کنی کارو بعد میای اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.23,
   "end": 577.23,
   "text": "حالا بحثمون اونجا نره. شیطان گفت اون منبر من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.23,
   "end": 580.63,
   "text": "شش هزار سال عبادت کردم شدم امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.63,
   "end": 584.23,
   "text": "ملائکه و وقتی تسبیحم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.23,
   "end": 591.83,
   "text": "شیطان داره به پیغمبر میگه وقتی تسبیحم از دستم می‌افتاد ملائکه هجوم می‌آوردن که تسبیح منو تبرکی بردارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.83,
   "end": 596.97,
   "text": "به سر و روشون بمالن. خب تو چه کردی که به یه همچین حال و روزی افتادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.97,
   "end": 602.31,
   "text": "سقوط کردی. خدا بهت گفت گم شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.31,
   "end": 606.29,
   "text": "حالا نظام آفرینش انگار که خدا میگه برو گم شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.29,
   "end": 611.59,
   "text": "قرآنی‌ش فَاِنَّكَ رَجِیم نظام آفرینش برو گم شو خفه شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.59,
   "end": 614.65,
   "text": "ها؟ همینه. به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.65,
   "end": 617.61,
   "text": "به کسی که ملائکه می‌ریختن تسبیحشو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.61,
   "end": 620.93,
   "text": "تبرک بردارن. چه کردی که اینطوری شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.93,
   "end": 625.49,
   "text": "شیطان داره به پیغمبر من و شما میگه به خاطر تکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.49,
   "end": 628.25,
   "text": "بخاطر که تکبره. این تکبری که تو وجود منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 628.25,
   "end": 631.11,
   "text": "این چی این رو از بین می‌بره به نظرتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.11,
   "end": 636.07,
   "text": "در نهایت موت. وقتی دماغ ما به خاک قبر مالیده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.07,
   "end": 638.69,
   "text": "متأسفانه اون موقع دیگه همه می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 638.69,
   "end": 645.45,
   "text": "همه از اون حالت تبختر و تکبر و فرعون و این‌ها می‌افته میان به پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.45,
   "end": 649.45,
   "text": "یکی هم وقت مری- مریضیه که حالا در این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 649.45,
   "end": 654.23,
   "text": "فرموده که برای اینکه از نورانیتش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 654.23,
   "end": 657.65,
   "text": "بهره بگیریم این تیکه‌ش رو یه بار دیگه براتون بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.65,
   "end": 661.55,
   "text": "که فرمود \"لولا ثلاث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.55,
   "end": 664.19,
   "text": "في ابن آدم ما تعترع شيئا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 664.19,
   "end": 669.97,
   "text": "المرض والموت والفقر وكلهن فيه وإنه لمعهن وثاب.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 669.97,
   "end": 673.09,
   "text": "این سه تا تازه اومده تو رو بکشونه پایین به خشوع بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.09,
   "end": 676.31,
   "text": "در حالی که اکثراً باز نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.31,
   "end": 678.39,
   "text": "بله. که حالا اهل یه بحثی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 678.39,
   "end": 682.53,
   "text": "انشاالله بعدا اگه خدای منّان توفیق داد پیرامون مریضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.53,
   "end": 685.67,
   "text": "مرض، گرفتاری اینا لطف خدا به بندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 685.67,
   "end": 688.43,
   "text": "برعکس که ما فکر می‌کنیم خدا می‌زنه یکی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 688.43,
   "end": 690.55,
   "text": "اصلاً فر-- نمرود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.55,
   "end": 694.63,
   "text": "تا آخر عمرش میگن یه سردرد هم نگرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.63,
   "end": 696.87,
   "text": "نمرود. یه سردرد نگرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 696.87,
   "end": 700.25,
   "text": "ما باشیم بگیم این آدم خیلی خوبیه که هیچ سردرد...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.25,
   "end": 703.99,
   "text": "آخر یه پشه از پاش درآورد رفت تو دماغش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 703.99,
   "end": 708.53,
   "text": "ضعیف‌ترین موجود یه فرعون زمانو زمین زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 708.53,
   "end": 715.77,
   "text": "این همش حساب کتاب داره. اما ماها رو مریضی، درد، پریشانی، فقر، موت که تو این روایت داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 715.77,
   "end": 717.77,
   "text": "چی می‌شه؟ هی ما رو زمین می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.77,
   "end": 721.47,
   "text": "هی دماغامونو به خاک می‌مالونه. حواست باشه خداست داره خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 721.47,
   "end": 729.61,
   "text": "تفرعن نکن. این خیلی مهمه که انسان از نگاه به بالا، از نگاه بالا به پایین اگه باشه سقوط می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 729.61,
   "end": 731.35,
   "text": "انشاالله عاقبت بخیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 731.35,
   "end": 734.55,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.55,
   "end": 740.71,
   "text": "اللهم صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}