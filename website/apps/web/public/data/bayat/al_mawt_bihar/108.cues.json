 "chapters": [
  {
   "index": 0,
   "title": "## روایت هشتم باب چهارم؛ رضایت محب",
   "start": 18.64,
   "end": 46.96
  },
  {
   "index": 1,
   "title": "## ریشه و معنای تجلی",
   "start": 46.96,
   "end": 67.26
  },
  {
   "index": 2,
   "title": "## تجلی زهرا بر امیرالمؤمنین",
   "start": 67.26,
   "end": 203.1
  },
  {
   "index": 3,
   "title": "## تجلی بر موسی و کوه",
   "start": 203.1,
   "end": 873.96
  },
  {
   "index": 4,
   "title": "## جملهٔ شهید آوینی",
   "start": 873.96,
   "end": 922.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.22,
   "end": 8.86,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.86,
   "end": 14.16,
   "text": "و به این استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.16,
   "end": 18.64,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.64,
   "end": 22.54,
   "text": "در بحث روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.54,
   "end": 25.8,
   "text": "هشتم از باب چهارم کتاب الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.8,
   "end": 28.64,
   "text": "داشتیم عرض می‌کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.64,
   "end": 32.74,
   "text": "محب اهل بیت علیهم الصلاة والسلام تجلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.74,
   "end": 38.36,
   "text": "حضرت حق رو نسبت به صعë وجودیش می‌بیند و راضی به موت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.36,
   "end": 40.72,
   "text": "این یکی از عنایات حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.72,
   "end": 44.28,
   "text": "یکی از عنایات و الطاف الهی‌ست به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.28,
   "end": 49.38,
   "text": "محبین اهل بیت. اصلاً تجلی از ریشه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.38,
   "end": 53.66,
   "text": "جیم و تجلی، جیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.66,
   "end": 58.08,
   "text": "لام و یا، جلگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.08,
   "end": 60.42,
   "text": "به معنای روشن شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.42,
   "end": 67.26,
   "text": "یا روشن کردن. به یک معنا میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.26,
   "end": 73.14,
   "text": "وقتی چهره‌ی حجت خدا برای شما روشن شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.14,
   "end": 80.92,
   "text": "البته اون روشن شدن، باز شدن، منشرح شدن، اون شرحی که از متن وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.92,
   "end": 88.68,
   "text": "او برای شما خودش رو نشون میده و جلوه می‌کنه نسبت به صعë وجودی توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.68,
   "end": 91.52,
   "text": "اگر بیش از اون باشه چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.52,
   "end": 95.66,
   "text": "بیشتر از صعë وجودی شما تجلی کنه، جلوه کنه چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.66,
   "end": 100.06,
   "text": "وخر موسی صعقه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.06,
   "end": 104.12,
   "text": "اتفاقاً ما داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.12,
   "end": 107.82,
   "text": "و این حرف‌هام هر وقتی و هر جایی با هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.82,
   "end": 110.46,
   "text": "در هر بحثی نمی‌شه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.46,
   "end": 117.3,
   "text": "که حتی صدای اهل بیت علیهم الصلاة والسلام در پرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.3,
   "end": 124.3,
   "text": "مثلاً شما انشاالله زیارت کنی امام عصر رو صدای حضرت رو می‌شنوی، صدای اصلی ایشون رو نمی‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.3,
   "end": 126.78,
   "text": "قالب توهم می‌کنی. ظرفیت نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.78,
   "end": 129.22,
   "text": "چهره اصلی ایشون رو نمی‌تونی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.22,
   "end": 132.14,
   "text": "چگونه است که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.14,
   "end": 134.76,
   "text": "عزرائیل یا حضرت جبرائیل اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.76,
   "end": 139.34,
   "text": "چهره‌های اصلیشون رو وقتی به اولیای خدا نشون می‌دادن اون‌ها مدهوش می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.34,
   "end": 141.76,
   "text": "چرا؟ این یعنی تجلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.76,
   "end": 147.48,
   "text": "یعنی روشن شدن اون حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.48,
   "end": 158.56,
   "text": "داریم که حضرت زهرا صلوات الله علیها روزی سه مرتبه بر امیرالمؤمنین جلوه می‌کرد، تجلی می‌کرد، ظهور می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.56,
   "end": 162.5,
   "text": "این رو فقط امیرالمؤمنین قدرتش رو داره درک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.5,
   "end": 168.12,
   "text": "ما نداریم که. این تجلی، تجلی نوریه زهره زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.12,
   "end": 171.2,
   "text": "شدت نور بر امیرالمؤمنین چگونه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.2,
   "end": 175.76,
   "text": "تمام شهر مدینه می‌گفتند که روشن می‌شد شهر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.76,
   "end": 180.16,
   "text": "اصلاً تو تاریکی شب یه نوری ساطع بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.16,
   "end": 193.24,
   "text": "و همه ملعون‌ها خواستن این نورو بپوشونن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.24,
   "end": 196.6,
   "text": "اینا می‌خواستن نور خدا رو خاموش کنن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.6,
   "end": 200.9,
   "text": "خدا تکمیل کرد، تطمیم کرد نورش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 200.9,
   "end": 204.48,
   "text": "در قرآن فرمود حالا این تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.48,
   "end": 208.08,
   "text": "خدا برای حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.08,
   "end": 212.2,
   "text": "ارپس چی بود؟ یعنی چی شد که خدا تجلی کرد و موسی غش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.2,
   "end": 215.24,
   "text": "البته موسی غش کرد. اون هفتاد نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.24,
   "end": 217.22,
   "text": "بزرگان و کبار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.22,
   "end": 221.58,
   "text": "قوم ایشون همه مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 221.58,
   "end": 224.38,
   "text": "تجلی حضرت حق رو تحمل نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.38,
   "end": 228.32,
   "text": "حالا ببینین این، این تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.32,
   "end": 232.12,
   "text": "اساساً بر چ-- به‌خاطر چی بوده اتفاق افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.12,
   "end": 234.0,
   "text": "و چه جلوه‌ای بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.0,
   "end": 241.3,
   "text": "چه نحوه‌ از جلوه‌ای بوده که آیا می‌شه ما لب مرگ همچین تجلیاتی رو ببینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.3,
   "end": 244.12,
   "text": "اونجاییه که تو قرآن صریحاً می‌فرماید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.12,
   "end": 246.9,
   "text": "قال رب ارنی انظر الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.9,
   "end": 249.62,
   "text": "حضرت موسی عرض کرد خدایا خودت رو به من نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.62,
   "end": 251.78,
   "text": "انظر الیک. ارنی انظر الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.78,
   "end": 255.0,
   "text": "خودت رو نشون بده تا من تو رو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.0,
   "end": 256.64,
   "text": "خدا هم فرمود قال لن ترانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.64,
   "end": 258.28,
   "text": "نمی‌تونی من، نمی‌تونی منو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.28,
   "end": 260.74,
   "text": "ولکن انظر الی الجبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.74,
   "end": 265.26,
   "text": "پس حالا، حالا که می‌خوای ببینی به این کوه نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.26,
   "end": 268.4,
   "text": "فان استقر مکانه فصعفت ترانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.4,
   "end": 271.76,
   "text": "اگه دیدی این کوه طاقت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.76,
   "end": 273.68,
   "text": "بسم الله نگاه کن. این کوه رو نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.68,
   "end": 277.82,
   "text": "اگه دیدی طاقت داره تو هم می‌تونی منو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.82,
   "end": 280.46,
   "text": "حالا بعد اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.46,
   "end": 282.86,
   "text": "حالا حضرت موسی چرا این درخواست رو داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.86,
   "end": 287.02,
   "text": "به جهت قومش. قومش میگن به ایرادهای بنی‌اسرائیل که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.02,
   "end": 291.5,
   "text": "انقدر هی گفتن ما باید خدا رو ببینیم تا عبادتش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.5,
   "end": 297.22,
   "text": "منتها اینا منظورشون چشم سر بود و علی امیرالمؤمنین علیه الصلاة والسلام هم فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.22,
   "end": 299.44,
   "text": "من عبادت نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.44,
   "end": 302.8,
   "text": "لم عبد رب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.8,
   "end": 308.16,
   "text": "ربی لم أره. من پروردگارمو که تا نبینمش عبادتش نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.16,
   "end": 310.82,
   "text": "ولی این دیدن اینها منظور به چشم بصر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.82,
   "end": 319.64,
   "text": "حالا خدا فرمود اون بزرگانشون که خیلی دیگه اهل عرفان و چی و اینا معنویت جمع کن هفتاد نفر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.64,
   "end": 325.22,
   "text": "این‌ها رو البته میگه هفتصد نفر شدن بعد شکیده‌شون کرد در هفتاد نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.22,
   "end": 327.66,
   "text": "با حضرت موسی رفتن کوه تور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.66,
   "end": 333.5,
   "text": "خدا اینجا فلما تجلی ربه هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.5,
   "end": 335.36,
   "text": "دقت بفرمایید ربه هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.36,
   "end": 337.42,
   "text": "این های ضمیر به کی می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.42,
   "end": 339.74,
   "text": "پروردگار کی تجلی کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.74,
   "end": 343.12,
   "text": "موسی دیگه. برای همین اونا مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.12,
   "end": 345.9,
   "text": "اگر ربه هم بود نمی‌مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.9,
   "end": 349.14,
   "text": "اگه پروردگار اون‌ها، اون رب وجودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.14,
   "end": 351.3,
   "text": "که بارها گفتیم اون اسمی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.3,
   "end": 355.76,
   "text": "وجود این‌ها دولت گرفته سلطان وجودشون شده، با اون اسم محشورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.76,
   "end": 359.3,
   "text": "و از طریق اون جدول وجودی وصلن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.3,
   "end": 365.16,
   "text": "روح کلی یا به اون حقیقت کو-- حقیقت الحقایق و صورت الصور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.16,
   "end": 370.92,
   "text": "حضرت حق از اون طریق متصلاً به دریای وجود و دریای حق، اگر از طریق رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.92,
   "end": 374.6,
   "text": "خودشون این تجلی رخ می‌داد نمی‌مردند، غش می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.6,
   "end": 377.4,
   "text": "اما چون فلان ما تجلی رب هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.4,
   "end": 380.96,
   "text": "لل جبل فرمود جعله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.96,
   "end": 384.56,
   "text": "دکا و خر موسی سعقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.56,
   "end": 388.86,
   "text": "موسی گفت بی‌هوش شد. تیکه تیکه شد کوه موسی بی‌هوش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.86,
   "end": 391.16,
   "text": "چرا بی‌هوش شد؟ چرا موسی نمرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.16,
   "end": 394.58,
   "text": "چون رب بهو، چون پروردگار او بود که تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.58,
   "end": 399.56,
   "text": "حالا امام باقر علیه السلام خدا رحمت کند به بابه‌ش شیخش صدوق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.56,
   "end": 404.56,
   "text": "می‌فرماید که فکر می‌کنم در کتاب کمال الدین و تمام نعمت شونه، اونجا دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.56,
   "end": 406.62,
   "text": "می‌فرماید این امام باقر علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.62,
   "end": 410.7,
   "text": "فرمود می‌خواید به شما بگم این جلوه‌ای که خدا در این کوه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.7,
   "end": 414.28,
   "text": "و هفتاد نفر بزرگان و کبار قوم موسی مردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.28,
   "end": 418.06,
   "text": "و خود موسی کلیم الله اول العظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.06,
   "end": 421.1,
   "text": "غش کرد و خر موسی سعقا غش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.1,
   "end": 424.56,
   "text": "چی بود؟ چه میزانی از جلوه‌ی حق بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.56,
   "end": 430.3,
   "text": "فرمود جلوه‌ای از نور ولایت ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.3,
   "end": 433.6,
   "text": "جلوه‌ای از نور امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.6,
   "end": 437.76,
   "text": "جلوه‌ای از نور زهره‌ی زهرای اطهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.76,
   "end": 442.96,
   "text": "یک جلوه‌ای، یک رشه‌ای شو موسی طاقت نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.96,
   "end": 446.06,
   "text": "حالا شما ببینید شهدای ما چه مقامی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.06,
   "end": 450.36,
   "text": "این که هست امام فرمود شهید نظر می‌کند به وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.36,
   "end": 453.04,
   "text": "این وجه الله کیه؟ عین وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.04,
   "end": 457.64,
   "text": "تو ندبه می‌گید. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.64,
   "end": 459.88,
   "text": "الیه یتوجه الاولیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.88,
   "end": 464.48,
   "text": "اولیا خود بهش متوجه، اولیا خدا بهش متوجه می‌شن ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.48,
   "end": 466.8,
   "text": "بعد امام فرمود شهید نظر می‌کنه به وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.8,
   "end": 476.26,
   "text": "پس شهدا اولیاء الله‌اند. بله اولیاء الله‌اند که تحمل می‌کنند تجلی سید الشهدا رو لحظه‌ی شهادتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.26,
   "end": 478.62,
   "text": "اینطوری نیست که شما شهید حججی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.62,
   "end": 486.98,
   "text": "تیکه تیکه‌ش کنن، شک-- بدترین شکنجه‌ها رو بهش بدن لام تا کُم بعدم وقتی میان خنجر رو بذارن رو گردنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.98,
   "end": 495.62,
   "text": "بخنده. این خنده مستانه که امام می‌فرماید شهدا در قهقهه مستانه‌شون ان ضرب بهم یرزقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.62,
   "end": 500.04,
   "text": "عجب عبارتی. این خنده تجلی دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.04,
   "end": 508.12,
   "text": "اصلاً نمیشه نبینه. اصلاً هر کسی رو که دلش رو ربودن با تجلی حق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.12,
   "end": 511.9,
   "text": "حالا تجلیات گونه گونه متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.9,
   "end": 516.0,
   "text": "مثلاً تجلی عرض شود نورانی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 516.0,
   "end": 518.7,
   "text": "مثل فتجلی لمحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.7,
   "end": 522.78,
   "text": "نور الجبار صلی الله علیه و آله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.78,
   "end": 528.08,
   "text": "نور جبار بر-- یا مثلاً تجلی کلامی داریم همین صحبت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.08,
   "end": 531.46,
   "text": "تکلم خدا با موسی، با عیسی، با پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.46,
   "end": 534.98,
   "text": "تجلی نوشتاری داریم همین صحف، زبور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.98,
   "end": 537.64,
   "text": "تورات، انجیل و قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.64,
   "end": 540.02,
   "text": "تجلی تکوینی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.02,
   "end": 543.68,
   "text": "که خدای منان خودش رو در قالب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.68,
   "end": 546.84,
   "text": "نز-- مو-موجودات نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.84,
   "end": 549.14,
   "text": "این کلمات وجود نظام هستی نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.14,
   "end": 552.4,
   "text": "اینا ظهور حق‌اند. اینا ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.4,
   "end": 558.66,
   "text": "حق‌اند. نه اینکه یک ظرف ظهور باشن، یک ظرفی باشن تا در اون ظرف ظهور اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.66,
   "end": 563.48,
   "text": "نخیر. د-داریم که انت ظاهر فی کل شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.48,
   "end": 565.36,
   "text": "تو در هر شیی ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.36,
   "end": 567.74,
   "text": "چقدر شیرینه و کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.74,
   "end": 570.92,
   "text": "ظاهر غیره هو باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.92,
   "end": 575.0,
   "text": "هر چیزی ببینید و کل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.0,
   "end": 578.68,
   "text": "کل ظاهر غیر هو باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.68,
   "end": 584.14,
   "text": "به غیر از او هر ظاهری پوشیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 584.14,
   "end": 587.06,
   "text": "اونچه که دیده می‌شه و ظاهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.06,
   "end": 595.64,
   "text": "خداست. هو الاول و الآخر و الظاهر و الباطن و کل باطن غیره غیر ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.64,
   "end": 599.82,
   "text": "و هر باطنی هم به جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.82,
   "end": 602.0,
   "text": "اصلاً نمی‌تونه ادعا کنه که من باطنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.0,
   "end": 607.0,
   "text": "غیر ظاهر و کل باطن غیر هو غیر ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.0,
   "end": 609.16,
   "text": "یعنی با-- اصلاً همه چی اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 609.16,
   "end": 613.72,
   "text": "چیزی جز او نیست. اینکه سید الشهدا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.72,
   "end": 616.1,
   "text": "عرفه شریفش می‌فرمود علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 616.1,
   "end": 618.78,
   "text": "علی غیرک من الظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.78,
   "end": 622.8,
   "text": "اصلاً به غیر از تو مگر کسی می‌تونه ظهور داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 622.8,
   "end": 627.06,
   "text": "ما لیس لک حتی تکون هو الملهر لک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.06,
   "end": 631.3,
   "text": "تا بخواد او مظهر تو بشه، او تو رو ظهور بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 631.3,
   "end": 635.12,
   "text": "مثلاً اصلاً چیزی جز تو ظهور کرده که مگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.12,
   "end": 637.76,
   "text": "امام حسین تو عرفه داره میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.76,
   "end": 641.64,
   "text": "بخواد تو رو ظهور بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.64,
   "end": 644.16,
   "text": "چیزی جز تو ظهور نکرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.16,
   "end": 647.88,
   "text": "بخواد تو رو ظهور بده. اصلاً هرچی هست ظهور خود توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.88,
   "end": 653.8,
   "text": "الله اکبر. این نگاه رو ببینید. اینکه امیرالمؤمنین فرمود ما رأیت شیئاً هیچ چیزی رو ندیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.8,
   "end": 658.06,
   "text": "الا و-- م-مگر اینکه رأیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.06,
   "end": 660.42,
   "text": "مگر اینکه الله رو دیدم. کجا دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.42,
   "end": 663.02,
   "text": "قبله و بعده و معه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.02,
   "end": 666.06,
   "text": "و فیه. همش الله دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.06,
   "end": 669.9,
   "text": "این یعنی هو الاول و الآخر و الظاهر و الباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 669.9,
   "end": 672.58,
   "text": "این یه تجلیه. حالا همین تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.58,
   "end": 675.34,
   "text": "گفتیم از ریشه جلşe یعنی روشن شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.34,
   "end": 678.9,
   "text": "همین روشن بشه برای ما وقت مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.9,
   "end": 683.24,
   "text": "همه چی رو جلوه‌ی حق می‌بینیم، ظهور حق می‌بینیم و البته مظهر اتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.24,
   "end": 686.6,
   "text": "حق رو نسبت به سایر وجودمون می‌بینیم، غالب تهی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.6,
   "end": 689.74,
   "text": "اصلاً بذارید من به شما فصل الخطاب عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.74,
   "end": 693.92,
   "text": "اِمم خیلی خودمونی و مزه مزه شده‌ی همه‌ی حرفا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 693.92,
   "end": 698.92,
   "text": "آقا موت محب اهل بیت، موت محب حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.92,
   "end": 703.0,
   "text": "غالب تهی کردنش در دیدن وجه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.0,
   "end": 705.78,
   "text": "یعنی وقتی دید تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 705.78,
   "end": 710.22,
   "text": "می‌بینه تمام می‌کنه. و برای همه هم اون‌ها--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.22,
   "end": 713.94,
   "text": "یعنی الان شما اینجا نشستید قطعاً تجلیاتی رخ داده که اینجایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.94,
   "end": 716.86,
   "text": "ولی مگه بیکاری پاشید بیایید اینجا. برای چی اومدید اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 716.86,
   "end": 720.82,
   "text": "شما اینجا چیکار می‌کنید الان؟ این همه مردم سراغ کار و زندگیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.82,
   "end": 728.92,
   "text": "یه تجلیاتی، یه رو-- میگه غضوا ابصارکم قطعاً شما چشماتونو بستید به حرام‌های الهی که ترون العجائب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 728.92,
   "end": 731.78,
   "text": "عجائب رو ببین. دیدی که الان اینجایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 731.78,
   "end": 738.78,
   "text": "وگر سید و شهدا این همه میگیم تجلیات سید و شهدا دو سه تا نکته نقطه‌ای عرض کنم و رد شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 738.78,
   "end": 741.06,
   "text": "به اون راهب مسیحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 741.06,
   "end": 745.26,
   "text": "چگونه سر مقدس امام حسین تجلی کرد که ایمان آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 745.26,
   "end": 749.84,
   "text": "سرش شست و شو داد بعد هم شهید راه امام حسین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 749.84,
   "end": 751.92,
   "text": "یا توی تنور خولی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 751.92,
   "end": 754.48,
   "text": "همسر خولی چی دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 754.48,
   "end": 757.4,
   "text": "که افتاد به جان همسرش و لوش داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.4,
   "end": 759.84,
   "text": "به مختار. چی دید؟ نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 759.84,
   "end": 762.7,
   "text": "سر مقدس رو تو تنور دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.7,
   "end": 766.66,
   "text": "این نور سر مقدس رو چه-چگونه دیگری ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.66,
   "end": 769.1,
   "text": "حر اصلاً چی شد که برگشت؟ اون نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 769.1,
   "end": 773.82,
   "text": "صورت و چهره، چشم امام و نگاه امام حسین بهش عوضش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 773.82,
   "end": 776.68,
   "text": "یا حر یا زهیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 776.68,
   "end": 779.58,
   "text": "یا وهب، وهب نصرانی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.58,
   "end": 783.46,
   "text": "زهیر عثمانی مذهب الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 783.46,
   "end": 786.0,
   "text": "اون نگاهه، اون جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 786.0,
   "end": 788.32,
   "text": "که اومد سر و پا نمی‌شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 788.32,
   "end": 795.5,
   "text": "همش منزلش و زهیر یه قدم، یه قدم، یه منزل عقب یا جلوتر از امام حسین میزد دیگه بر نخوره به آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 795.5,
   "end": 798.98,
   "text": "هرچی زنش میگفت برو این فرزند زهراست میگفت ولمون کن بابا بذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 798.98,
   "end": 803.06,
   "text": "زندگیمونو بکنیم تا برای خودش تجارتی داشت، پول و من و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 803.06,
   "end": 805.84,
   "text": "مال و ملالی داشت خیلی وضعش خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.84,
   "end": 808.26,
   "text": "بعد گفت نه من برم کارم تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 808.26,
   "end": 814.36,
   "text": "مرگ آخرش. ولی سر از پا اومد گفت طلاقت میدم هرچی هم من دارم مال تو بزنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 814.36,
   "end": 816.6,
   "text": "گفت بذار من برم. خب چی دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.6,
   "end": 819.6,
   "text": "این تجلی سید و شهداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 819.6,
   "end": 824.48,
   "text": "برای یکی هم مثل حضرت زینب تجلی سید و شهدا دست روی سینه بی بی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.48,
   "end": 827.72,
   "text": "چی دید حضرت زینب از این تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 827.72,
   "end": 833.74,
   "text": "که فرمود حسین جان صبری می‌کنم که ملائکه آسمانها و زمین تعجب کنند از صبر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 833.74,
   "end": 835.66,
   "text": "اینم تجلی امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 835.66,
   "end": 837.7,
   "text": "اصلاً رهبر، این بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 837.7,
   "end": 843.6,
   "text": "اهل-- امام، حضرت امام چه جور، چه جوری این بار رو تحمل می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 843.6,
   "end": 845.74,
   "text": "بار مصائب، مشکلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 845.74,
   "end": 848.3,
   "text": "تجلی امامه از تو وجود اونا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 848.3,
   "end": 851.4,
   "text": "حالا در خصوص تجلی حرف زیاده همین مقدار من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 851.4,
   "end": 856.54,
   "text": "بسنده کردم اگرچه مطالب دیگه‌ای هم بود بماند انشاالله نوش جونتون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 856.54,
   "end": 860.68,
   "text": "ببینیم انشاالله این تجلیات رو ببینیم، کیف کنیم، صفا کنیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 860.68,
   "end": 867.16,
   "text": "لحظه موت هممون انشاالله تجلی با تجلی امام حسین موت برامون حاصل بشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 867.16,
   "end": 869.1,
   "text": "مثل شهدا. مثل شهید حججی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 869.1,
   "end": 871.7,
   "text": "شهید نظر می‌کند به وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 871.7,
   "end": 873.96,
   "text": "وجه الهی رو ببینه و قالب تویی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 873.96,
   "end": 875.96,
   "text": "به شهید آوینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 875.96,
   "end": 878.3,
   "text": "امام حسین فرستاده بودی خیلی شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 878.3,
   "end": 883.64,
   "text": "چی بود عبارتش؟ حالا عبارتش حفظ نیستم ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 883.64,
   "end": 889.8,
   "text": "فرموده بود که جان بلند بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 889.8,
   "end": 891.6,
   "text": "جان بهای دیدار است. احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 891.6,
   "end": 893.72,
   "text": "جان بهای دیدار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 893.72,
   "end": 895.6,
   "text": "چگونه از شهید آوینی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 895.6,
   "end": 898.54,
   "text": "سید شهیدان اهل قلم. اینو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 898.54,
   "end": 901.28,
   "text": "چگونه از جان نگذرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 901.28,
   "end": 904.04,
   "text": "در حالی که جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 904.04,
   "end": 907.74,
   "text": "بهای دیدار است. چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 907.74,
   "end": 912.84,
   "text": "این همه ما داریم می‌کشیم خودمون معارف رو ورق میزنیم تو یه جمله جمعش کرده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 912.84,
   "end": 914.6,
   "text": "شادیا رو همه‌شون صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 914.6,
   "end": 922.36,
   "text": "اللهم صل على محمد و آل محمد و عجّل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}