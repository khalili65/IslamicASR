 ],
 "cues": [
  {
   "i": 0,
   "start": 7.26,
   "end": 10.6,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.6,
   "end": 13.82,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.82,
   "end": 16.3,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.3,
   "end": 19.28,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.28,
   "end": 22.62,
   "text": "وعده داده بودیم که اجمالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.62,
   "end": 29.62,
   "text": "بعضی از دسته‌جات فرشته‌ها و ملائکه الله رو که به عنوان قوای عالم هستن رو معرفی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.62,
   "end": 35.74,
   "text": "ببینیم چه ساز و کاری در عالم و در بافت و چینش و نزد نز-نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.74,
   "end": 39.0,
   "text": "چه هیئتی برقرار است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.0,
   "end": 43.86,
   "text": "که اگر چنین انسان توجه کنه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.86,
   "end": 49.64,
   "text": "به بهانه‌ی ترس از موت از واجباتش مثل جهاد فرار نمی‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.64,
   "end": 51.94,
   "text": "این‌ها واسطه‌ی فیض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.94,
   "end": 54.94,
   "text": "واسطه‌ی امداد الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.94,
   "end": 57.96,
   "text": "خدا به وسیله‌ی این‌ها انسان رو کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.96,
   "end": 60.02,
   "text": "همشون هم با ماخذ. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.02,
   "end": 64.4,
   "text": "امروز به عدد اگر فرصت کنیم به عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.4,
   "end": 69.16,
   "text": "حروف بسم الله الرحمن الرحیم نوزده تا دسته‌شون رو به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.16,
   "end": 77.56,
   "text": "جمع‌بندی ارائه میدم. اولیش در عیون اخبار الرضا، جلد یک، صفحه دویست و بیست و چهار به نام راحیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.56,
   "end": 81.42,
   "text": "فرشته‌ای است به نام راحیل. \"ثم أمر الله تعالى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.42,
   "end": 87.28,
   "text": "تبارك وتعالى ملكاً من ملائكة الجنة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.28,
   "end": 89.24,
   "text": "این مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.24,
   "end": 91.26,
   "text": "بهشته این ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.26,
   "end": 94.56,
   "text": "\"يقال له راحيل وليس في الملائكة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.56,
   "end": 98.08,
   "text": "أبلغ منه فخطب بخطبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.08,
   "end": 101.86,
   "text": "ثم يخطب بمثلها أهل السماء ولا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.86,
   "end": 104.94,
   "text": "میگه خطیب‌ترین ملکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.94,
   "end": 108.94,
   "text": "این شخص. یعنی اون کسی که تو خطبه‌خوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.94,
   "end": 113.46,
   "text": "خیلی فصیح و بلیغ سخن میگه قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.46,
   "end": 117.04,
   "text": "با وساطت این ملک میتونه این کارو بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.04,
   "end": 122.38,
   "text": "و همون ملکی‌ست که خطبه‌ی عقد امیرالمؤمنین و حضرت زهرا رو جاری کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.38,
   "end": 128.74,
   "text": "که همه ملائکه آسمون و زمین به وجد اومدن از نحوه‌ی خطبه‌خوانی ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.74,
   "end": 132.54,
   "text": "و توضیح زیاد داره من فقط اجمالا میگم که آشنا بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.54,
   "end": 137.2,
   "text": "کمال الدین و تمام النعمه شیخ صدوق، ببینید مصادر چقدرم عالین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.2,
   "end": 139.56,
   "text": "جلد یک، صفحه دویست و هشتاد و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.56,
   "end": 142.04,
   "text": "هر کدوم رو از یه جا درآوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.04,
   "end": 145.06,
   "text": "ملکی به نام دردائیل رو معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.06,
   "end": 147.84,
   "text": "\"قال ابن عباس سمعت رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.84,
   "end": 154.6,
   "text": "يقول إن لله تبارك وتعالى ملكا يقال له دردائل.\" خدا یه ملکی داره اسمش دردائيله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.6,
   "end": 157.96,
   "text": "\"كان له ستة عشر ألف جناح.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.96,
   "end": 160.24,
   "text": "این ملک شونزده هزار بال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.24,
   "end": 166.26,
   "text": "عجب! \"ما بين الجناح إلى الجناح.\" بین این بالش با اون بالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.26,
   "end": 168.98,
   "text": "فرمود \"هواء كما بين السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.98,
   "end": 174.68,
   "text": "إلى الأرض.\" این هوایی که بین آسمان و زمین چه وسعتی داره بین دو بال فقط ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.68,
   "end": 178.84,
   "text": "شونزده هزار بال. اینه که می‌تونن مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.84,
   "end": 183.22,
   "text": "عدد هر بارونی که می‌ریزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.22,
   "end": 188.14,
   "text": "احصا کنن. هر برفی که میاد رو احصا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.14,
   "end": 191.64,
   "text": "بعدیش از کتاب شریف الزهد عن النصب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.64,
   "end": 195.62,
   "text": "مال کوفی اهوازیه. صفحه پنجاه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.62,
   "end": 197.46,
   "text": "ملکی به نام اسماعیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.46,
   "end": 203.4,
   "text": "\"وروینا من الكتاب المذكور باسناده إلى الصادق\" امام صادق فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.4,
   "end": 209.64,
   "text": "\"إن الله ملكا يقال له اسماعیل ساكن في السماء الدنيا إذا قال العبد\" حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.64,
   "end": 218.76,
   "text": "وظیفه اسماعیل چیه؟ وقتی که بنده میگه \"یا ارحم الراحمین سبع مرات\" هفت مرتبه بگه یا ارحم الراحمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.76,
   "end": 221.68,
   "text": "\"قال له اسماعیل\" اسماعیل رو بهش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.68,
   "end": 226.12,
   "text": "در عالم معنان قد-- بهش میگه \"قد سمع الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.12,
   "end": 227.9,
   "text": "خدا شنید، به تحقیق شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.9,
   "end": 230.74,
   "text": "کی شنید؟ \"أرحم الراحمین صوتک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.74,
   "end": 233.32,
   "text": "صداتو شنید \"فاسأل حاجتك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.32,
   "end": 235.56,
   "text": "حالا حاجتتو بخواه. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.56,
   "end": 239.9,
   "text": "این واسطه‌ی فیضه دیگه. یعنی نشون میده که واسطه‌ی حاجت دهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.9,
   "end": 244.54,
   "text": "المحاسن برقی، جلد دو، صفحه سیصد و پانزده، چهارمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.54,
   "end": 246.7,
   "text": "ملک به نام حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.7,
   "end": 249.28,
   "text": "\"إذا سكنت النطفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.28,
   "end": 252.42,
   "text": "في الرحم أربعة أشهر\" وقتی چهار ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.42,
   "end": 258.16,
   "text": "نطفه توی رحم مادر پرورش پیدا کرد، چهارمین ماه رسید \"وأنشأ فيه الروح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.16,
   "end": 263.66,
   "text": "اون روح دمیده شد \"بعث الله تبارك وتعالى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.66,
   "end": 271.0,
   "text": "إليه ملكا يقال له حيوان\" یه حیوانی میاد، یه ملکی میاد اسمش حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.0,
   "end": 274.6,
   "text": "که اونجا مراقب این بچه‌ست از چهار ماهگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.6,
   "end": 277.2,
   "text": "ببین همه چی حساب کتاب داره در عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.2,
   "end": 281.0,
   "text": "پنجمین فرشته رو در کافی کلینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.0,
   "end": 283.8,
   "text": "جلد شش، صفحه پونزده می‌تونید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.8,
   "end": 286.04,
   "text": "به نام زاجر. فبعث--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.04,
   "end": 290.48,
   "text": "فرمود \"فيبعث الله إليه ملكا يقال له زاجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.48,
   "end": 296.06,
   "text": "فيزجر.\" این، این ملک م-مأمور بیرون آوردن بچه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.06,
   "end": 301.06,
   "text": "هر کدوم از ما وقتی از رحم مادر که منشق از اسم الرحمن حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.06,
   "end": 303.92,
   "text": "خارج می‌خواستیم بشیم این ملک زاجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.92,
   "end": 308.16,
   "text": "ما رو بیرون آورده. ببین چه حقی گردن ما دارن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.16,
   "end": 309.72,
   "text": "ششمین ملک رضوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.72,
   "end": 312.76,
   "text": "\"إن ملكا يقال له رضوان ينادي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.76,
   "end": 314.54,
   "text": "کارش اینه. به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.54,
   "end": 321.52,
   "text": "داد می‌زنه تو آسمون \"دائماً لا سيف إلا ذو الفقار.\" هیچ شمشینی نیست إلا ذو الفقار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.52,
   "end": 324.82,
   "text": "یکی از افتخارات امیرالمؤمنین وجود همین ملک है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.82,
   "end": 327.7,
   "text": "حالا اینا باید بحث بشه. بحث هر کدومش که چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.7,
   "end": 329.88,
   "text": "به چه دلیله؟ مثلا به چه دردی می‌خوره این کار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.88,
   "end": 333.9,
   "text": "بیاد داد بزنه. اینا خیلی جای بحث داره دیگه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.9,
   "end": 338.18,
   "text": "روضة العاضين وبصيرة المطاعين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.18,
   "end": 341.72,
   "text": "از شبت مرحوم نیشابوری فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.72,
   "end": 344.0,
   "text": "جلد یک، صفحه چهل و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.0,
   "end": 346.98,
   "text": "هفتمین ملک به نام هز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.98,
   "end": 349.92,
   "text": "هزغائل با ه جیمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.92,
   "end": 352.78,
   "text": "\"وإن ملكا يقال له هزغائل له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.78,
   "end": 355.2,
   "text": "ثمانية عشر ألف جناح.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.2,
   "end": 358.36,
   "text": "اون شونزده هزار، این هجده هزار بال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.36,
   "end": 361.6,
   "text": "هجده هزار بال. همینطوری برو إلى ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.6,
   "end": 365.12,
   "text": "یکی یکی. یعنی خدا ماشاءالله همه جوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.12,
   "end": 367.56,
   "text": "خلق کرده و به هر کدوم هم یه مسئولیتی داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.56,
   "end": 369.64,
   "text": "بیکار نیستن اینا مثل من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.64,
   "end": 373.24,
   "text": "که بیان مثلا یه حقوقی بگیرن و صبح تا شب بیکار پشت میز بشینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.24,
   "end": 377.06,
   "text": "نه اینطوری نیستن جامع الاخبار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.06,
   "end": 378.89,
   "text": "شعيري صفحه هفتاد و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.89,
   "end": 383.2,
   "text": "هشتمین ملک، میخائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.2,
   "end": 385.34,
   "text": "بخند آقا مجتبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.34,
   "end": 392.3,
   "text": "میخائیل. این ایل حالا شما شاید بخندید بگه آره یه چیزی برداشته خدا پسوندی چسبونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.3,
   "end": 396.48,
   "text": "پیشوندی چسبونده به ایل، ایل، ایل سیخائیل، میکائیل اینا دردائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.48,
   "end": 400.46,
   "text": "ایل ایل یعنی بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.46,
   "end": 405.06,
   "text": "بنده. میخ-- یعنی بندگان خدا که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.06,
   "end": 407.38,
   "text": "پسوند پیشوند دارن. میخائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.38,
   "end": 412.6,
   "text": "پیغمبر فرمود \"إن لله تبارك وتعالی ملکا يقال له میخائیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.6,
   "end": 416.22,
   "text": "حالا این چیکار می‌کنه؟ الان با شماهاش محشورید اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.22,
   "end": 420.38,
   "text": "\"يأخذ البراعات للمصلین عند کل صلاة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.38,
   "end": 424.74,
   "text": "وقتی هر کسی نماز می‌خونه واقعاً نمازش نماز باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.74,
   "end": 428.54,
   "text": "این برائت از آتش و از خدا براش همون لحظه می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.54,
   "end": 434.36,
   "text": "به نام چی؟ میخائیل. میخ کوبت می‌کنه در خونه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.36,
   "end": 438.84,
   "text": "نهمین ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.84,
   "end": 442.9,
   "text": "نهمین ملک از کتاب الزهد عن النس صفحه پنجاه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.9,
   "end": 446.86,
   "text": "سجل. سجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.86,
   "end": 451.06,
   "text": "اسم ملکه \"إن في الهواء ملکا يقال له اسماعیل\" بعد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.06,
   "end": 456.16,
   "text": "انتهاش می‌خوره به اینکه \"يحسبون اعمال العباد فإذا رأس السنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.16,
   "end": 459.44,
   "text": "بعث الله اليهم ملکا يقال له سجّل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.44,
   "end": 463.8,
   "text": "اسماعیل روزانه حساب کتاب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.8,
   "end": 466.0,
   "text": "اعمال رو. یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.0,
   "end": 470.02,
   "text": "وظایف اسماعیل بود. آخر سال که می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.02,
   "end": 473.48,
   "text": "\"رأس السنة\" رأس سال که رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.48,
   "end": 477.26,
   "text": "می‌خوای مثلا حساب کتابتو بکنی این ملک انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.26,
   "end": 481.0,
   "text": "اسمش سجله. یعنی یک سالتو میاد سجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.0,
   "end": 485.94,
   "text": "شناسنامت می‌زنه. خیلی اینجا حرف داشتیم حیف نمیشه وقت نیست پیاده‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.94,
   "end": 487.72,
   "text": "چرا سجل؟ اسمش چرا سجله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 487.72,
   "end": 489.62,
   "text": "اصلاً شناسنامت میشه همون اعمالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.62,
   "end": 491.86,
   "text": "علم و عمل جوهرند انسان ساز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.86,
   "end": 496.56,
   "text": "تو اتحاد عمل، اتحاد وجودی پیدا می‌کنی با اعمالت، با علمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 496.56,
   "end": 498.92,
   "text": "دهمین به به مال همین ماهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.92,
   "end": 503.94,
   "text": "دهمین ملک به نام داعی از اقبال الأعمال جلد دو صفحه ششصد و بیست و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.94,
   "end": 506.7,
   "text": "سید بن طاووس رحمت الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.7,
   "end": 510.14,
   "text": "که خدای ملکی داره \"لیقال له الداعی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.14,
   "end": 513.74,
   "text": "و کارش چیه؟ \"فإذا دخل شهر رجب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.74,
   "end": 517.24,
   "text": "وقتی ماه رجب میشه \"ینادی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.24,
   "end": 525.62,
   "text": "فریاد می‌زنه این ملک به نام داعی که \"ذلك الملك کل ليلة منه الی الصباح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.62,
   "end": 529.6,
   "text": "از شب تا صبح هر شب، شب ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.6,
   "end": 535.14,
   "text": "این ملک به نام داعی فریاد می‌زنه \"طوبى للذاکرین طوبی للطائعین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.14,
   "end": 537.18,
   "text": "خوش به حال ذاکرین. خوش به حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 537.18,
   "end": 543.12,
   "text": "اطاعت کنندگان. که البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.12,
   "end": 547.44,
   "text": "ملک رو در یک روایت دیگه‌ای گفتن در آسمان هفتم قرار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.44,
   "end": 550.94,
   "text": "این نشون میده که چقدر ماه رجب مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.94,
   "end": 556.26,
   "text": "ملک مأمور شب‌هاش در اوج آسمان‌ها یعنی آسمان هفتم قرار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.26,
   "end": 561.22,
   "text": "یازدهمیش جمال الأصول في کمال العلم المشروع صفحه دویست و چهل و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.22,
   "end": 563.56,
   "text": "سید بن طاووس فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.56,
   "end": 566.32,
   "text": "یازدهمیش به نام زهلیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.32,
   "end": 568.76,
   "text": "باز زاد دست‌دار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.76,
   "end": 573.34,
   "text": "تازه. زهلیل های دو چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.34,
   "end": 582.42,
   "text": "و کل و \"وکل الله بقبر النبي\" خدا ایشونو مأمور کرده وکیل که وکالت داده بهش در کنار قبر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 582.42,
   "end": 590.66,
   "text": "که چی بشه؟ \"يقال له زهليل إذا صلى عليه قال له يا رسول الله فلانٌ تسلم عليك وصلى عليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.66,
   "end": 594.6,
   "text": "قال، قال فيرد النبي بالسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.6,
   "end": 601.62,
   "text": "هرکس هر کجا الان شما اینجا سلام صلوات اینو هر جا بفرستید اون ملکی که کنار قبره به پیغمبر می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.62,
   "end": 605.2,
   "text": "و پیغمبر رد سلام و صلوات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.2,
   "end": 609.58,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.58,
   "end": 611.66,
   "text": "الان حضرت زهلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.66,
   "end": 614.2,
   "text": "دست به کار شد با کار شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.2,
   "end": 620.72,
   "text": "اون رسوند دیگه انشاالله. خب دوازدهمیش از کتاب الصراط المستقيم الی مستحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.72,
   "end": 625.34,
   "text": "التقدیج جلد ص-- جلد یک صفحه صد و پنجاه و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.34,
   "end": 628.56,
   "text": "مرحوم عاملی می‌فرماید سیزدهمیش اسمش ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 628.56,
   "end": 632.44,
   "text": "اسمش رو خودشه. سنجش ایمان تو رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 632.44,
   "end": 635.52,
   "text": "\"ملک يقال له الايمان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 635.52,
   "end": 637.34,
   "text": "که ایمانت در چه وضعیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 637.34,
   "end": 643.34,
   "text": "یعنی اینطوری نیست که خدا ولت کنه همینطوری ادعا کنی آره من بچه یتیو با ایمان و حزب-- این حرف‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 643.34,
   "end": 648.24,
   "text": "سنجش باید بشه. مرکز سنجش داره خدا، ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.24,
   "end": 654.52,
   "text": "آن، آن تو رو می‌سنجد. سیزدهمیش ذو قابل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 654.52,
   "end": 658.06,
   "text": "تسلیت المجالس و زینه المجالس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 658.06,
   "end": 661.4,
   "text": "که به یک معنا مقتل الحسین هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.4,
   "end": 665.08,
   "text": "مرحوم موسوی نوشته \"فبعث الله ملکا يقال له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 665.08,
   "end": 669.92,
   "text": "ذو قابل\" حالا فرصت نیست ذو قابل دیگه اسمش شد اون مقتل الحسین هم اومده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 669.92,
   "end": 672.96,
   "text": "مرتبطه با محبین امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.96,
   "end": 677.58,
   "text": "حالا هر کاری شما در رابطه با امام حسین بکنی واسطه ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.58,
   "end": 679.9,
   "text": "به حضرت برسونه سلام حضرتو به تو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.9,
   "end": 681.9,
   "text": "انشاالله کربلا برات بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 681.9,
   "end": 687.66,
   "text": "ذو قابل. چهاردهمیش در آیه هفتاد و هفت ذخرف بود دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 687.66,
   "end": 689.74,
   "text": "به نام مالک. خیلی هم معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 689.74,
   "end": 692.72,
   "text": "انشاالله نبینیدش. \"وناود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.72,
   "end": 694.82,
   "text": "یا مالکو\" این آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.82,
   "end": 698.34,
   "text": "\"لیغبی علينا ربک قال إنكم ماکثون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.34,
   "end": 700.96,
   "text": "به مالک خازن جهنمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.96,
   "end": 703.52,
   "text": "میگن کاش خدا ما رو می‌میراند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 703.52,
   "end": 710.64,
   "text": "بعد ایشون می‌فرماید \"قال إنكم ماکثون\" حالا شما اینجا می‌مونید، اینجا ماندنی هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.64,
   "end": 713.62,
   "text": "خازن جهنمه. خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 713.62,
   "end": 717.36,
   "text": "اسمش ترسناکه. مالک جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.36,
   "end": 722.0,
   "text": "پونزدهمیش، شونزدهمی با همه نکی و منکر معروفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.0,
   "end": 726.46,
   "text": "که دیگه عربیشو نخونم که روایات زیادی داریم که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 726.46,
   "end": 730.78,
   "text": "\"یأتیان صاحب القبر فيسأل عن\" اینا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 730.78,
   "end": 736.36,
   "text": "و از هر کسی که وارد به عالم برزخ بشه، نه اون قبر فقهی‌ها، اون خاکه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 736.36,
   "end": 743.71,
   "text": "همین که بمیریم، موت حاصل بشه بریم از اینجا رخت ببندیم نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 743.71,
   "end": 748.79,
   "text": "اعلام انصراف از این بدن خاکی بده، بره به بدن برزخی شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.79,
   "end": 752.35,
   "text": "منتها یه ملکی دیگه‌ای هست قبل از اومدن نکیر و منکر میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 752.35,
   "end": 755.87,
   "text": "حالا اینو معمولاً کمتر شنیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.87,
   "end": 761.27,
   "text": "که این هفتدهمین ملکه به نام رومان، رومان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 761.27,
   "end": 764.39,
   "text": "تشدید نداره ها. رمان نه، رومان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.39,
   "end": 766.95,
   "text": "اینجا فر- فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.95,
   "end": 769.49,
   "text": "فصل علیهم و این در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 769.49,
   "end": 774.65,
   "text": "صحیفه سجادیه امام سجاد از ایشون یاد کرده صلوات فرستاده بر ایشون و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 774.65,
   "end": 780.35,
   "text": "کارش چیه؟ قبل از اینکه نکیر و منکر بیان تو قبر از ما سؤال کنن، از اون قبر برزخیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 780.35,
   "end": 782.71,
   "text": "سؤال کنن، ایشون میاد بو می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 782.71,
   "end": 787.89,
   "text": "ببینه اگه آدم خوبی هستی بوی بهشت می‌ده به اونا سفارشتو می‌کنه، پارتی‌بازی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 787.89,
   "end": 791.75,
   "text": "پارتی‌بازی به معنای بدش نه ها به معنای شفاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 791.75,
   "end": 795.17,
   "text": "بله این می‌گه که این آدم خوبیه سخت نگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 795.17,
   "end": 796.35,
   "text": "و اگر خدای نکرده بوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 796.35,
   "end": 802.37,
   "text": "جهنم داد می‌گه حسابی به چلونیدش حسابی حساب کتاب ازش بکشید بیچاره‌اش کنید شروع کنید عذابش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.37,
   "end": 806.53,
   "text": "پس رومان خیلی مهمه. به یک معنا می‌شه گفت همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.53,
   "end": 809.87,
   "text": "ملکی‌ست که قوه‌ ی شامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 809.87,
   "end": 815.77,
   "text": "یعنی می‌شه گفت بزرگ ملائکه‌ای که قوه شامه همه انسان‌ها رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 815.77,
   "end": 819.97,
   "text": "اگر بپذیریم که انشاالله پذیرفتید نظر ملا صدرا رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 819.97,
   "end": 825.33,
   "text": "قوای وجودی ما هر کدوم یک ملکه‌اند پس قوه شامه ما، بویایی ما ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 825.33,
   "end": 827.07,
   "text": "همه اینا تحت امر چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 827.07,
   "end": 830.27,
   "text": "رومانن. اون آخر سر بو می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 830.27,
   "end": 836.49,
   "text": "و آخری‌شم هجدهم و نوزدهمی‌شم که تو قرآن آیه صد و دو بقره اومده به نام هاروت و ماروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 836.49,
   "end": 841.37,
   "text": "اینا چیکار می‌کردن؟ آیه‌شم که دیدید \"و ما أنزل على الملكين ببارون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 841.37,
   "end": 843.05,
   "text": "ببابل هاروت و ماروت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 843.05,
   "end": 847.63,
   "text": "اینا کارشون چی بود؟ اینا سحر بلد بودن و راه بطلان سحر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 847.63,
   "end": 849.73,
   "text": "اونم به مردم یاد دادن. اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 849.73,
   "end": 854.27,
   "text": "سحر و جادو زیاد شده بود و یاد دادن که چگونه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 854.27,
   "end": 858.29,
   "text": "سحر و جادو فرار کنی. اونایی که گرفتار الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 858.29,
   "end": 860.43,
   "text": "سحر و جادو و اینا متأسفانه می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 860.43,
   "end": 865.57,
   "text": "اخیراً هم رهبر عزیز تو چند تا سخنرانی‌هاش از اجنه و اینا سخن گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 865.57,
   "end": 868.75,
   "text": "راه‌هایی داره انشاالله اگر خدا توفیق بده ما به زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 868.75,
   "end": 872.35,
   "text": "خود اهل بیت به شما می‌گیم چه کنیم که از شر این‌ها در امان باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 872.35,
   "end": 875.85,
   "text": "انشاالله اگه زنده بودیم و لطف خدا شامل شد فردا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 875.85,
   "end": 881.69,
   "text": "تقدیم می‌کنیم. انشاالله که عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 881.69,
   "end": 887.73,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}