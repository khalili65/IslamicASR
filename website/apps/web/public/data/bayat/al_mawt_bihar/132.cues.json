   "title": "## روایت یازدهم؛ اشتیاق امیرالمؤمنین به لقاء الله",
   "start": 102.46,
   "end": 177.08
  },
  {
   "index": 2,
   "title": "## دین ملائکه در تکوین آفرینش",
   "start": 177.08,
   "end": 260.68
  },
  {
   "index": 3,
   "title": "## لغت ملک و اقوال در ماهیت ملائکه",
   "start": 260.68,
   "end": 485.52
  },
  {
   "index": 4,
   "title": "## تقسیم‌بندی امام خمینی از ملائکه",
   "start": 485.52,
   "end": 616.18
  },
  {
   "index": 5,
   "title": "## ملائکهٔ مقرّب و تمثّل نه تجافی",
   "start": 616.18,
   "end": 872.58
  },
  {
   "index": 6,
   "title": "## جبرائیل و نماز میّت بر آدم؛ تقدّم ملائکه",
   "start": 872.58,
   "end": 1050.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.94,
   "end": 5.92,
   "text": "بسم الله الرحمن الرحيم و به نستعين السلام عليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.92,
   "end": 9.26,
   "text": "يا داعي الله و رباني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 13.2,
   "text": "آياته. سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.2,
   "end": 18.26,
   "text": "می‌رسیم به روایت یازدهم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.26,
   "end": 21.2,
   "text": "البته پیش از اینکه ورود به این روایت کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.2,
   "end": 23.94,
   "text": "تبریک عرض می‌کنم عید فطر رو برای همتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.94,
   "end": 32.22,
   "text": "انشاالله که عیدی‌های بزرگ، بزرگ و خوب و عالی بگیرید و دامنه این عیدی تا قیامت تون کشیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.22,
   "end": 38.6,
   "text": "امیدوارم که امسال سال ریشه‌کنی غده سرطانی اسرائیل از روی زمین باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.6,
   "end": 41.24,
   "text": "و البته نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.24,
   "end": 44.0,
   "text": "در خصوص احکام هم عرض کنم به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.0,
   "end": 47.92,
   "text": "اینکه میگن امشب که شب عید فطر اگر باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.92,
   "end": 53.14,
   "text": "کسی هرجا مهمون باشه و اونجا افطار کنه فطرش میفته گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.14,
   "end": 56.26,
   "text": "صاحب‌البد این اشتباه است. همچین چیزی ما نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.26,
   "end": 59.08,
   "text": "و یعنی نظر رهبری این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.08,
   "end": 63.6,
   "text": "از ایشون اتفاقا استفسار کردن همین موضوع رو فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.6,
   "end": 71.9,
   "text": "با یک شب و دو شب مثلا خ-غذا خوردن تو خونه یه نفر نونخور حساب نمیشه و باید حتما نونخور باشی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.9,
   "end": 74.22,
   "text": "نونخور طرف حساب بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.22,
   "end": 76.58,
   "text": "فطریه بیفته گردنش. پس همچین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.58,
   "end": 81.86,
   "text": "الانم که فطریه رو هم رهبر عزیزمون برای اونایی که قوت غالبشون نونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.86,
   "end": 85.16,
   "text": "شصت و پنج تومن اعلام کردن برای اونایی که برنجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.16,
   "end": 87.86,
   "text": "صد و هشتاد تومن برای یک نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.86,
   "end": 90.56,
   "text": "حالا اونایی که بینا بینن یعنی نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.56,
   "end": 94.22,
   "text": "میشه گفت صرفا نون مصرف می‌کنن، نه برنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.22,
   "end": 97.02,
   "text": "هر دو رو مصرف می‌کنن. اونها می‌تونند حد وسط رو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.02,
   "end": 101.22,
   "text": "مثلا نفری صدهزار تومن فطریه به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.22,
   "end": 105.52,
   "text": "انشاالله که موفق باشید. اما میریم سراغ روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.52,
   "end": 109.9,
   "text": "یازدهم. روایت دهم رو دیگه بابش رو جمع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.9,
   "end": 112.9,
   "text": "از همون باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.9,
   "end": 115.16,
   "text": "در این روایت که خیلی روایت شیرینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.16,
   "end": 118.84,
   "text": "امام صادق صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.84,
   "end": 121.02,
   "text": "عن ابيه عن جده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.02,
   "end": 123.64,
   "text": "از پدرشون و ایشون از جدشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.64,
   "end": 126.96,
   "text": "امیرالمؤمنین علیه الصلاة والسلام همچنین می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.96,
   "end": 131.54,
   "text": "یعنی سلسله روایت تا مولا علی علیه الصلاة والسلام که قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.54,
   "end": 137.56,
   "text": "سئل امیر المؤمنین سلام الله عليه بماذا احببت لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.56,
   "end": 144.42,
   "text": "از حضرت سؤال شد که آجان شما چرا انقدر اشتیاق به مردن دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.42,
   "end": 148.56,
   "text": "به لقاء الله دارید؟ قال لما رأيته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.56,
   "end": 154.08,
   "text": "قد اختار لي دين ملائكته ورسله و أنبيائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.08,
   "end": 157.06,
   "text": "فرمودن امیرالمؤمنین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.06,
   "end": 160.86,
   "text": "وقتی دیدم خدا، خدای متعال انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.86,
   "end": 168.28,
   "text": "به من لطف داره که دین ملائکه‌ش رو و انبیاش رو و رسولانش رو برای من انتخاب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.28,
   "end": 172.7,
   "text": "قد اختار لي، اختیار کرده برای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.7,
   "end": 178.52,
   "text": "دین ملائکته. دین ملائکه‌ش رو، رسولش رو و انبیاش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.52,
   "end": 182.74,
   "text": "علمت ان الذي أكرمني بهذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.74,
   "end": 185.76,
   "text": "دونستم که اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.76,
   "end": 192.72,
   "text": "با من با این لطف و کرامت برخورد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.72,
   "end": 194.54,
   "text": "الذي أكرمني بهذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.54,
   "end": 198.04,
   "text": "من این چنین تکریم کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.04,
   "end": 204.3,
   "text": "که منو اختیار کرده بر دین ملائکه‌ش برای دین رسولانش و انبیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.3,
   "end": 209.16,
   "text": "از اینجا حضرت می‌فرماید متوجه شدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.16,
   "end": 214.48,
   "text": "لیس ینسانی قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.48,
   "end": 217.92,
   "text": "به یقین منو فراموش نمی‌کنه چنین خدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.92,
   "end": 220.32,
   "text": "فاحببت لقائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.32,
   "end": 223.26,
   "text": "پس به خاطر همین این فا فای پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.26,
   "end": 227.4,
   "text": "نتیجه. نتیجه اینکه به همین خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.4,
   "end": 229.88,
   "text": "مشتاق لقای خدا شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.88,
   "end": 231.72,
   "text": "فاحببت لقائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.72,
   "end": 233.98,
   "text": "عاشق لقای او شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.98,
   "end": 237.14,
   "text": "چقدر شیرین مولا و چقدر عالی و خوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.14,
   "end": 242.46,
   "text": "حضرت چنین فر-بیان فرمودن و ما رو متوجه عنایات حضرت حق کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.46,
   "end": 250.78,
   "text": "واقعا ما وقتی که دقت نمی‌کنیم حواسمون نیست که یعنی این قبیل فرمایشات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.78,
   "end": 256.6,
   "text": "ارشیان رو که نمی‌بینیم اصلاً حواسمون نیست خدا چه تاج عزتی سر ما گذاشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.6,
   "end": 258.26,
   "text": "چه عنایتی به ما کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.26,
   "end": 260.68,
   "text": "اینجا حضرت می‌فرماید خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.68,
   "end": 264.32,
   "text": "حالا انشاالله به مرور صحبت می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.32,
   "end": 268.82,
   "text": "کلمه به کلمه‌ش قابل بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.82,
   "end": 275.56,
   "text": "یکی اینکه قد اختار لي خدا منو اختیار کرده و خدا اختیار کرده این دین رو برای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.56,
   "end": 279.28,
   "text": "و یعنی می‌زنش به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.28,
   "end": 281.74,
   "text": "این خیر رو به خدا منتسب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.74,
   "end": 285.64,
   "text": "بعد چی رو؟ توی این کلمه اجازه بدید امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.64,
   "end": 287.64,
   "text": "یه مقدار بیشتر صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.64,
   "end": 291.52,
   "text": "دين ملائكته ورسله و أنبيائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.52,
   "end": 293.88,
   "text": "خب رسول و انبیا که مشخص‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.88,
   "end": 298.84,
   "text": "ملائکه چگونه‌اند که یعنی ملائکه هم دین دارند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.84,
   "end": 301.94,
   "text": "بله اونها هم دین دارند. البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.94,
   "end": 307.08,
   "text": "به صورت کلی دین هر کسی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.08,
   "end": 310.58,
   "text": "در حقیقت چیزی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.58,
   "end": 313.68,
   "text": "در تکوین نظام آفرینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.68,
   "end": 320.68,
   "text": "براش تعبیه شده. یعنی مثلا يسبح لله ما في السماوات وما في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.68,
   "end": 324.24,
   "text": "همه عالم تسبیح گفتن این دینشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.24,
   "end": 330.96,
   "text": "و یک انسانه که مختارِ اختیار خدا بهش داده که بتونه خلاف دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.96,
   "end": 333.28,
   "text": "عمل کنه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.28,
   "end": 336.68,
   "text": "اون هم تصریح کردن در اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.68,
   "end": 342.46,
   "text": "رو به حضرت حق کردن و اوج دینداری که معراج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.46,
   "end": 348.8,
   "text": "نماز و صلاة بگو که إني وجهت وجهي للذي فطر السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.8,
   "end": 350.94,
   "text": "امشب هم که عید فطر انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.94,
   "end": 354.04,
   "text": "فطر السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.04,
   "end": 358.92,
   "text": "اونکه شکافنده و به وجود آورنده زمین و آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.92,
   "end": 362.56,
   "text": "رو به او می‌کنیم. این تمام عالم رو به او دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.56,
   "end": 368.84,
   "text": "حالا یا غافلن و اگرچه حاضر غافلن یا اینکه حاضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.84,
   "end": 372.08,
   "text": "غیر غافلن و توجه دارن که به این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.08,
   "end": 375.52,
   "text": "اینکه در حال حضور هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.52,
   "end": 377.66,
   "text": "خب این ملائکه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.66,
   "end": 381.28,
   "text": "مختصری اجمالاً پیرامون ملائکه صحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.28,
   "end": 385.94,
   "text": "که اولا ارباب لغت مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.94,
   "end": 388.7,
   "text": "احمد بن فارس در معجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.7,
   "end": 393.3,
   "text": "مقاییس اللغة اونجا جلد یک صفحه صد و سی و دو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.3,
   "end": 398.78,
   "text": "راغب اصفهانی در المفردات فی غریب القرآنش جلد یک صفحه بیست و یک میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.78,
   "end": 404.48,
   "text": "ابن منظور در لسان العرب جلد یک صفحه سیصد و نود و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.48,
   "end": 411.34,
   "text": "اقس علی هذا میارن که اصلا ملائکه که جمع ملک از ریشه یا الک است یا الوکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.34,
   "end": 415.04,
   "text": "حضرت تلمذ حسن زاده هم بارها در درس و بحث هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.04,
   "end": 417.24,
   "text": "تصریح داشتن به این موضوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.24,
   "end": 419.8,
   "text": "یا معنای رسالت رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.8,
   "end": 423.1,
   "text": "یعنی رسول الهی فرستاده الهی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.1,
   "end": 426.32,
   "text": "یا سلطنت که سلطنت دارن بر عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.32,
   "end": 429.2,
   "text": "اونها واسطه خیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.2,
   "end": 433.76,
   "text": "از این حیث که حالا یا الک یا الوکت از هر حیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.76,
   "end": 436.24,
   "text": "اِممم... حالا برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.24,
   "end": 438.6,
   "text": "ملائکه اینکه اصلا چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.6,
   "end": 440.96,
   "text": "اینها جنسشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.96,
   "end": 444.42,
   "text": "ماهیتشون به چه شکله؟ اصلا چی هستن اینها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.42,
   "end": 446.68,
   "text": "نظراتی بیان شده. مثلا متکلمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.68,
   "end": 451.48,
   "text": "شما می‌تونید این موضوعی که الان عرض می‌کنم رو در کتاب تلخیص المحصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.48,
   "end": 454.38,
   "text": "خواجه طوسی ببینید. صفحه دویست و سی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.38,
   "end": 459.04,
   "text": "اونجا از حیث مثلا نظر متکلمان به صورت کلی عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.04,
   "end": 462.44,
   "text": "میگن ملائکه اجسامی لطیف‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.44,
   "end": 466.28,
   "text": "و به شکل‌های مختلف در میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.28,
   "end": 472.74,
   "text": "اما از نظر فلاسفه بخواهیم بگیم مثلاً ملاصدرا علیه الرحمه در مفاتیح الغیبش میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.74,
   "end": 477.18,
   "text": "ملائکه همون عقول مجرده و نفوس فلکی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.18,
   "end": 480.08,
   "text": "که هیچ علقه ای با اجسام ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.08,
   "end": 483.58,
   "text": "هیچ علاقه ای، هیچ تعلقی به اجسام ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.58,
   "end": 487.84,
   "text": "حالا نظراتی‌ست به هر حال. نظر امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.84,
   "end": 496.16,
   "text": "که هم می‌تونید این نظرات حضرت امام رو در کتابهایشون مخصوصا در آداب الصلاه‌شون یا مثلاً شرح اربعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.16,
   "end": 498.38,
   "text": "اِاِه... اربعین حدیثشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 498.38,
   "end": 501.86,
   "text": "ببینید که اولا فرمودن ملائکه به صورت کلی دو قسمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.86,
   "end": 504.64,
   "text": "یا تعلق به اجسام دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.64,
   "end": 508.26,
   "text": "یا ندارن. اونهایی که تعلق ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.26,
   "end": 511.64,
   "text": "باز دو قسمند. یا مهیمین‌اند که قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.64,
   "end": 514.78,
   "text": "اجمالاً عرض کردیم که اونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.78,
   "end": 521.66,
   "text": "مرتبط با حضر حق‌اند و در ملکوت، ملکوت اعلی در ملأ اعلی در اون منتها الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.66,
   "end": 523.46,
   "text": "محو جمال حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.46,
   "end": 527.14,
   "text": "در حیمان الهی‌اند. اصلاً بی‌خبر از خلق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.14,
   "end": 530.28,
   "text": "غیر حق‌اند. یا اینکه جبروتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.28,
   "end": 533.24,
   "text": "جبروتیا مبادی سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.24,
   "end": 536.1,
   "text": "موجودات‌اند. ریشه اشواق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.1,
   "end": 539.14,
   "text": "اِاِه... عرض شود شوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 539.14,
   "end": 541.96,
   "text": "مادونی‌ها هستند. اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.96,
   "end": 544.62,
   "text": "در مرتبه در عالم جبروت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.62,
   "end": 547.2,
   "text": "همینطور که جلسه پیش عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.2,
   "end": 550.22,
   "text": "که اینها جبروتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.22,
   "end": 554.12,
   "text": "پیرامون عالم جبروت اجمالاً مطالبی رو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.12,
   "end": 559.68,
   "text": "که باز حضرت امام علیه الرحمه می‌فرماید خب حالا اینا اونایی‌اند که تعلق ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.68,
   "end": 563.48,
   "text": "اونایی که تعلق دارن یا به عبارتی به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.48,
   "end": 566.74,
   "text": "اجسام توجه دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.74,
   "end": 571.28,
   "text": "اینها که ملائکه موکل بر موجودات جسمی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.28,
   "end": 574.24,
   "text": "اینها به یک معنا مدبر این‌هاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.24,
   "end": 576.74,
   "text": "دارای اصنافی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.74,
   "end": 579.02,
   "text": "یعنی صنوف متعدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.02,
   "end": 582.42,
   "text": "و بسیار. اونم کثرتشون بی‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.42,
   "end": 587.56,
   "text": "یعنی بی‌ش-- هیچ خلقی روایت داریم که به اندازه ملائکه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.56,
   "end": 591.42,
   "text": "که اصناف متعدد. اینها و هر کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.42,
   "end": 594.0,
   "text": "وظیفه ای دارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.0,
   "end": 600.96,
   "text": "که بهشون اصطلاحا این‌هایی که تعلق به عالم جسمانی دارن رو بهشون میگن ملائکه برزخی یا مثالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.96,
   "end": 605.14,
   "text": "اونجایی هم که تو قرآن برای ملائکه بال و پر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.14,
   "end": 608.16,
   "text": "میشمره و میگه اینا بال و پر دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.16,
   "end": 610.78,
   "text": "مربوط به همین ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.78,
   "end": 613.86,
   "text": "ملائکه برزخی‌اند که این نظر حضرت امام علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.86,
   "end": 618.86,
   "text": "الرحمه. که البته این رو باید بدونیم که یه استثناء هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.86,
   "end": 623.74,
   "text": "اونم ملائکه مقرب. یه سری ملائکه هستند که اینها از بالا تا پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 623.74,
   "end": 627.92,
   "text": "تصرف دارن، استیلا دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 627.92,
   "end": 631.94,
   "text": "استعلای دارن. به هر حال حکمرانی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 631.94,
   "end": 633.56,
   "text": "سلطنت‌شون خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 633.56,
   "end": 635.18,
   "text": "مقرب‌اند. اسمشون رو خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.18,
   "end": 637.24,
   "text": "مثلاً اِممم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.24,
   "end": 639.44,
   "text": "حضرت جبرائیل صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 639.44,
   "end": 644.82,
   "text": "اینها به واسطه اون احاطه تام و قیومیتی که دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.82,
   "end": 649.34,
   "text": "می‌تونن تو هر عالمی به هیأت و صورت اون عالم تمثل بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.34,
   "end": 652.24,
   "text": "مثلاً حضرت جبرائیل صلوات الله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.24,
   "end": 655.96,
   "text": "تمثل ملکوتی داره در عین حال تجسد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.96,
   "end": 658.78,
   "text": "تجسد ملکی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.78,
   "end": 661.18,
   "text": "یعنی می‌تونه به چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.18,
   "end": 664.48,
   "text": "این دنیایی‌ها، ملکی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.48,
   "end": 667.22,
   "text": "که جسم دارن بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.22,
   "end": 672.04,
   "text": "و تمثلاً تجسد ملکی هم بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.04,
   "end": 676.14,
   "text": "که البته حضرت امام اینجا که می‌رسن تذکر میدن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 676.14,
   "end": 680.22,
   "text": "نزول و صعود ملائکه به معنی تجافي از مقامشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 680.22,
   "end": 684.18,
   "text": "باید توجه داشته باشیم که اینطور نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.18,
   "end": 688.36,
   "text": "چون بر اساس اون اصل توقیفیت اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 688.36,
   "end": 694.52,
   "text": "هر اسمی حالا بگیریم هر ملکی در مقام خودش میخکوبه به قول حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 694.52,
   "end": 698.0,
   "text": "و تکون نمی‌خوره. این صعود و نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 698.0,
   "end": 702.36,
   "text": "به منزله تنزل به نحو تمثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 702.36,
   "end": 706.62,
   "text": "نه تجافي. یعنی از اون مقام خودش خارج بشه بیاد پایین یا بره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 706.62,
   "end": 708.34,
   "text": "به این شکل نیست. تمثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 708.34,
   "end": 711.2,
   "text": "همونطور که در قرآن فرمود فتمثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 711.2,
   "end": 713.54,
   "text": "لهى، لهى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 713.54,
   "end": 716.06,
   "text": "چقدر حضرت استاد تاکید بر این ها داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 716.06,
   "end": 723.14,
   "text": "لهى بشراً سویًا. حضرت جبرائیل وقتی اومدن بشارت حضرت عیسی رو بدهند، بدهند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.14,
   "end": 726.24,
   "text": "حضرت مریم صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 726.24,
   "end": 728.18,
   "text": "اه فتمثل الله ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 728.18,
   "end": 729.9,
   "text": "متمثل شدن بر حضرت مریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 729.9,
   "end": 732.74,
   "text": "یعنی اونجا کسایی که بودن نمی‌دیدن حضرت مریم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 732.74,
   "end": 737.52,
   "text": "همونطور که حضرت پیغمبر عظیم الشأن اسلام و صلوات و درود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 737.52,
   "end": 742.06,
   "text": "خدا و ملائکه مقربش و اولیاش بر او و خاندانش باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 742.06,
   "end": 745.4,
   "text": "مثلاً اشاره می‌کردن که هذا جبرائیل می‌دیدن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 745.4,
   "end": 750.36,
   "text": "اما بقیه تا-- خب می‌دونستن که پیغمبره و حرف عبث و بیهوده نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 750.36,
   "end": 752.56,
   "text": "انه و الا وحی یوحا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 752.56,
   "end": 757.7,
   "text": "درست داره میگه. اما خب اونا نمی‌دیدن پیغمبر متمثل بر پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 757.7,
   "end": 760.16,
   "text": "به نحو تمثله. این رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 760.16,
   "end": 763.12,
   "text": "اما خب از عالم بالا بگیر تا پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 763.12,
   "end": 770.24,
   "text": "همینطور کشیده شدن. حالا اینجا بعضیا این دیگه اختلاف رأیه که بعضیا اون روح القدس رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.24,
   "end": 776.74,
   "text": "که اسم ج-- ظاهراً جبروتیه مثلاً ایشونه به هم گفتن هم حضرت جبرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 776.74,
   "end": 779.26,
   "text": "بعضیا روح اعظم رو ایشون گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 779.26,
   "end": 781.32,
   "text": "به هر حال نظرات هست. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 781.32,
   "end": 788.26,
   "text": "به صورت کلی اه بسیاری از حکما و عرفا فرمودن نه، روح اعظم حضرت جبرائیل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 788.26,
   "end": 790.02,
   "text": "روح القدس حضرت عزرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.02,
   "end": 792.5,
   "text": "همونطور که قبلاً تو فاطمیه بحثش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 792.5,
   "end": 798.1,
   "text": "گذشت بر رابطه‌ی اون روح اعظم با نفس کل و حضرت صدیقه سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 798.1,
   "end": 806.24,
   "text": "این اجمالا نکته‌ی پیرامون ملائکه که اینجا خیلی شیرین امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 806.24,
   "end": 810.54,
   "text": "در این روایت می‌فرماید که قد اختار لی دین ملائکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 810.54,
   "end": 814.8,
   "text": "و رسله و انبیائه. اینقدر که ملائکه عزیزن پیش ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 814.8,
   "end": 817.34,
   "text": "چقدر امام سجاد در ادعیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 817.34,
   "end": 819.44,
   "text": "صحیفه سجادیه داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 819.44,
   "end": 822.82,
   "text": "درود می‌فرستن بر ملائکه، بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 822.82,
   "end": 825.32,
   "text": "اسرافیل، بر میکائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 825.32,
   "end": 832.54,
   "text": "و اینها. که اون مهمات‌شون رو دیگه خدای عظیم الشأن در قرآن عزیزش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 832.54,
   "end": 835.5,
   "text": "اینها واسطه‌ی فیضن، تعلیم میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 835.5,
   "end": 837.86,
   "text": "حالا هر کدومشون وسیله‌ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 837.86,
   "end": 840.68,
   "text": "عرض شود مجری یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 840.68,
   "end": 843.62,
   "text": "یا محل فیض یک اسمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 843.62,
   "end": 848.36,
   "text": "اه حضرت-- مثلاً هر کجا که بحث علمه حضرت جبرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 848.36,
   "end": 851.26,
   "text": "پاش وسطه. بحث قبض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 851.26,
   "end": 854.48,
   "text": "از مادون به مافوق حضرت عزرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 854.48,
   "end": 856.6,
   "text": "قابض الارواح اسمش، اسمش روشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 856.6,
   "end": 861.88,
   "text": "هر کجا بحث روزی و اندازه‌گیری و این چیزاست حضرت میکائیل، کیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 861.88,
   "end": 867.12,
   "text": "فافلن الکیل. هر کجا که بحث اماته و احیا و در صور دمیدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 867.12,
   "end": 870.6,
   "text": "این چیزاست حضرت اسرافیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 870.6,
   "end": 874.14,
   "text": "و، و، و قس علی هذا. که ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 874.14,
   "end": 876.4,
   "text": "جلد اول تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 876.4,
   "end": 878.5,
   "text": "علی بن ابراهیم قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 878.5,
   "end": 883.7,
   "text": "دیدیم که اونجا هست عزیزان می‌تونن رجوع کنن در خصوص حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 883.7,
   "end": 886.18,
   "text": "سلام الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 886.18,
   "end": 888.1,
   "text": "وقتی ایشون از دنیا رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 888.1,
   "end": 891.4,
   "text": "خب حضرت شیس نمی‌دونست واقعاً چه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 891.4,
   "end": 893.9,
   "text": "فرزند ایشون که هبه حضرت حق به ایشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 893.9,
   "end": 898.86,
   "text": "نمی‌دونستن چه کنن. که البته می‌دون-- حضرت فی-- حضرت شیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 898.86,
   "end": 901.86,
   "text": "سلام الله علیه به یک معنا به جهت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 901.86,
   "end": 908.56,
   "text": "سوز دلی که در از دست دادن و شهادت حضرت هابیل سلام الله علیه بر دل حضرت آدم وارد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 908.56,
   "end": 912.08,
   "text": "که ان العطیات یادش بخیر علی قدر القابلیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 912.08,
   "end": 915.46,
   "text": "در فصوص الفص آدمی عرض می‌کردیم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 915.46,
   "end": 919.88,
   "text": "اونجا خداوند اون سوز دل آدم رو که دید شیس رو بهش هبه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 919.88,
   "end": 923.02,
   "text": "لذا هبت الله لقبشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 923.02,
   "end": 924.72,
   "text": "خب حضرت شیس مونده بود چه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 924.72,
   "end": 928.26,
   "text": "حضرت جبرائیل نازل شدن، متمثل شدن بر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 928.26,
   "end": 932.24,
   "text": "و فرمودن همینطوری هم دفن نکن بدن پدرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 932.24,
   "end": 935.32,
   "text": "ایشون اه بدنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 935.32,
   "end": 940.46,
   "text": "پیش خدا عزیز هست و بر اون نماز بخون تا این نور نماز هم به او منتقل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 940.46,
   "end": 943.82,
   "text": "که حضرت شیس عرض کرد من بلد نیستم نماز میت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 943.82,
   "end": 949.14,
   "text": "حضرت جبرائیل جلو ایستاد و فرمودن که من هرچی میگم القا می‌کنم شما تکرار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 949.14,
   "end": 956.14,
   "text": "او نماز میت رو به همان شکل که است القا کردن حضرت شیس بر حضرت آدم پدر عزیزشون خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 956.14,
   "end": 958.58,
   "text": "این چنین واسطه‌ی فیضن برای همه‌ی انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 958.58,
   "end": 964.12,
   "text": "حالا اینکه به صورت وحی بیاد این چنین قوانین رو به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 964.12,
   "end": 967.84,
   "text": "جزئی و کلی بر پیامبر عظیم الشأن اسلام بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 967.84,
   "end": 969.6,
   "text": "خب برای پیغمبر فقط بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 969.6,
   "end": 971.92,
   "text": "بر همه انبیا که جبرائیل نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 971.92,
   "end": 974.78,
   "text": "برای عده‌ای از اوهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 974.78,
   "end": 978.74,
   "text": "انبیا بودن. اونم نه همیشه و در همه‌ی موارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 978.74,
   "end": 984.7,
   "text": "بر پیغمبر به این شکل بودن و اصلاً جزو خدمه و صدنه پیغمبر و آل پیغمبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 984.7,
   "end": 988.28,
   "text": "ببینید دیگه آل پیغمبر چه مقامی دارن که همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 988.28,
   "end": 990.12,
   "text": "فرشته‌ای در خدمت ایشون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 990.12,
   "end": 991.78,
   "text": "همین مقدار کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 991.78,
   "end": 998.02,
   "text": "فرصت رفته. پس توجه داشته باشیم که این فرمایش که امیرالمؤمنین می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 998.02,
   "end": 1000.0,
   "text": "لما رأیتہ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1000.0,
   "end": 1006.64,
   "text": "قد اختار لی دین ملائکته و رسله و انبیائه اتفاقاً ملائکه هم اونجا مقدم شدن بر رسل و انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1006.64,
   "end": 1010.9,
   "text": "چون اونها واسطه‌ی فیض بین رسولان و انبیا بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1010.9,
   "end": 1014.8,
   "text": "و دین اونها اختیار کرده خدا دین اونها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1014.8,
   "end": 1018.5,
   "text": "برای امیرالمؤمنین و هر کسی که در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1018.5,
   "end": 1023.86,
   "text": "این قرآن و عترت است که ان هذا القرآن يهدی للتی هي اقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1023.86,
   "end": 1027.88,
   "text": "در مسیر هدایت و صراط مستقیم است باید شکرگذار باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1027.88,
   "end": 1034.56,
   "text": "و همینطور مثل مولا علی علیه الصلاة والسلام عاشق دیدار خدا باشه و دلکنده از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1034.56,
   "end": 1036.52,
   "text": "از تعلقات از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1036.52,
   "end": 1040.16,
   "text": "شبیه ملائکه بشه. انشاالله که ما هم به اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1040.16,
   "end": 1044.36,
   "text": "یکی از عیدی‌های بزرگ شب عید فطر انشاالله برای هممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1044.36,
   "end": 1047.7,
   "text": "همین باشه. انشاالله که عاقبت هممون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1047.7,
   "end": 1050.32,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}