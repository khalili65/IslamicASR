 },
 "chapters": [
  {
   "index": 0,
   "title": "## حکایت سلیمان و قابوس؛ ادب مدیریت و اجل حتمی",
   "start": 78.26,
   "end": 379.28
  },
  {
   "index": 1,
   "title": "متن موضوع آیهٔ بیست و شش سورهٔ توبه است — دیروز و پریروز آیهٔ پیشین گفته شد:",
   "start": 379.28,
   "end": 399.5
  },
  {
   "index": 2,
   "title": "## سکینه چیست؟ حدیث امام رضا",
   "start": 399.5,
   "end": 618.48
  },
  {
   "index": 3,
   "title": "## ملائکه در دعای سوم صحیفه؛ چهار صورت",
   "start": 618.48,
   "end": 666.34
  },
  {
   "index": 4,
   "title": "جملهٔ آخر را خوب باید گرفت؛ مباحث حکمی و فلسفی و گاه عرفانی‌اش گذشته است. هر چیزی در این نشئه هست چون:",
   "start": 666.34,
   "end": 871.05
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 3.7,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.7,
   "end": 5.76,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.76,
   "end": 8.7,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.7,
   "end": 12.2,
   "text": "عرض کردیم که طبق روایاتی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.2,
   "end": 15.84,
   "text": "باب سوم مرحوم مجلسی از روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.84,
   "end": 21.04,
   "text": "دوم تا نهم بررسی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.04,
   "end": 26.76,
   "text": "به این نتیجه رسیدیم که غالباً مردم از موت می‌ترسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.76,
   "end": 35.44,
   "text": "اگر از طاعون، از کرونا، از امیکرون این‌ها ترس دارند از این بلاهای ظاهری به جهت ترسشون از موته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.44,
   "end": 37.42,
   "text": "و شاید خود ما هم اینطوری هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.42,
   "end": 44.08,
   "text": "اکثراً می‌ترسند. حالا دلایلی هم داره که دلایلش زیادیم که ما دنیامون رو آباد کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.08,
   "end": 49.86,
   "text": "آخرتمون رو ویران. می‌ترسیم از یه جای آباد بریم به یه جای ویران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.86,
   "end": 53.88,
   "text": "روایتی هم داریم که حتی نزدیکان انبیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.88,
   "end": 55.48,
   "text": "حتی اولیا همچنین بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.48,
   "end": 59.56,
   "text": "این ترس از موت فقط مال آدم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.56,
   "end": 65.16,
   "text": "ضعیف نیست. آدم‌هایی که خیلی قوی هستند دیگه اون‌ها نه ترس ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.16,
   "end": 70.14,
   "text": "\"فتمنّوا الموت کنتم سادین\" حتی لحظه شماری برای موت‌شون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.14,
   "end": 73.68,
   "text": "اما آدمای متوسط اللیمان، ضعیف اللیمان این‌ها نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.68,
   "end": 76.96,
   "text": "همه ترس داریم. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.96,
   "end": 80.08,
   "text": "یه حکایت زیبایی در کتاب شریف احیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.08,
   "end": 85.12,
   "text": "علوم، احیا العلوم، جلد چهار، صفحه سیصد و سی و هفت دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.12,
   "end": 88.22,
   "text": "شیرین بود البته خیلی وقت پیش که یه مردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.22,
   "end": 91.64,
   "text": "می‌خوام به شما بگم که حتی نزدیکان انبیا همچنین بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.64,
   "end": 94.36,
   "text": "مردی که علی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.36,
   "end": 97.7,
   "text": "صبح علی الطلوع اومد محضر حضرت سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.7,
   "end": 103.2,
   "text": "اینکه صبح علی الطلوع میاد محضر نبی الله نشون میده که از نزدیکانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.2,
   "end": 105.26,
   "text": "اومد در حالی که خیلی به هم ریخته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.26,
   "end": 109.58,
   "text": "خب انبیا هم پدرانه رفتار می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.58,
   "end": 112.46,
   "text": "سریع آقا پرسید چرا انقدر مضطربی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.46,
   "end": 118.98,
   "text": "چته؟ قابل توجه مسئولین، متولیان امر، مدیران، پدران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.98,
   "end": 121.16,
   "text": "هرکس که مسئولیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.16,
   "end": 129.62,
   "text": "اگر از، از تو زیردستش پریشونی، اضطرابی، مشکلی، ضعفی، لرزشی، چیزی می‌بینه حتی لغزشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.62,
   "end": 132.18,
   "text": "سریع بخوادش پدرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.18,
   "end": 135.76,
   "text": "نه با سیستم اداری و سریع بزنه طرف رو ناک اوت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.76,
   "end": 138.98,
   "text": "حالا خواستش گفت چته اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.98,
   "end": 145.26,
   "text": "ایشون گفت یا نبی الله من می‌ومدم اینم دلیل دومم که معلومه از مقربین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.26,
   "end": 148.32,
   "text": "حضرت عزرائیل رو دیدم. خب دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.32,
   "end": 150.36,
   "text": "فرشته که کار هرکسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.36,
   "end": 154.48,
   "text": "دیدم ایشون یک نگاه تندی به من کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.48,
   "end": 158.0,
   "text": "و من خیلی به هم ریختم. از این جهت ناراحتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.0,
   "end": 161.02,
   "text": "گفت حضرت-- ببینید اینا نکته‌ست همش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.02,
   "end": 166.08,
   "text": "نبی خدا حضرت سلیمان نبی پرسید که من چی کار می‌تونم برات بکنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.08,
   "end": 170.18,
   "text": "یعنی خودش رو تمامه در اختیار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.18,
   "end": 172.56,
   "text": "مریدش قرار داد. بگو لب ترک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.56,
   "end": 176.86,
   "text": "کدوم یکی از ما خداوکیلی اینطوری‌ایم نسبت به زیردستان‌مون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.86,
   "end": 180.0,
   "text": "لب ترک کن مشکلت چیه؟ نه رو حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.0,
   "end": 186.1,
   "text": "پارتی بازی و باندبازی و رابطه و این‌ها که متاسفانه جای ضابطه رو تو اداره‌ات گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.1,
   "end": 188.98,
   "text": "نه، رو حساب که یه بنده خداست گرفتاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.98,
   "end": 191.94,
   "text": "من چیکار برات می‌تونم بکنم عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.94,
   "end": 195.3,
   "text": "به خدا نکته، نکته این روایات درس‌آموزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.3,
   "end": 198.58,
   "text": "ایشون گفتش که شما که باد مسخر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.58,
   "end": 202.44,
   "text": "میشه لطف کنی ما رو به وسیله باد روانه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.44,
   "end": 207.36,
   "text": "به سمت هندوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.36,
   "end": 210.68,
   "text": "اون، اونجا حالا نسبت به اونجا خیلی دور بوده هندوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.68,
   "end": 218.04,
   "text": "شاید مثلاً یه ماه راه بوده. ایشون هم حضرت سلیمان هم لبیک گفت و بلافاصله به ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.04,
   "end": 222.8,
   "text": "مأمور باد دستور داد ایشون رو درجا رسون به هندوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.8,
   "end": 226.68,
   "text": "و امتثال حرفش رو گوش داد به قول ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.68,
   "end": 233.62,
   "text": "حالا ببینم چی میشه رو تو کالتاب لم بذارید من رو میز حالا بعداً بررسی کنم اینا، نه، همون درجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.62,
   "end": 240.04,
   "text": "تموم شد. بعد فردا صبحش حضرت عزرائیل تشریف آوردند محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.04,
   "end": 247.42,
   "text": "سلیمان نبی. س-- ببینید پیگیری‌ها، این باور کن تو این روایات و آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.42,
   "end": 249.74,
   "text": "درس‌های مدیریتی نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.74,
   "end": 252.54,
   "text": "پیگیری حضرت نبی الله رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.54,
   "end": 255.6,
   "text": "کار رفیقشو انجام داده تموم شده حالا پیگیری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.6,
   "end": 259.4,
   "text": "شما برای چی نگاه تند کردی به رفیق ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.4,
   "end": 262.34,
   "text": "به حضرت-- تو روایته‌ها آقا، به حضرت قابوس بن ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.34,
   "end": 265.76,
   "text": "چرا نگاه تند کردی؟ چی بوده دلیلش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.76,
   "end": 271.04,
   "text": "دلیلشو به من بگو. حضرت قابوس بن ورد فرمود که من نگاه تند نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.04,
   "end": 272.86,
   "text": "ایشون سوء برداشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.86,
   "end": 275.82,
   "text": "من نگاه متعجب برانگیزی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.82,
   "end": 278.1,
   "text": "متعجب شده بودم. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.1,
   "end": 281.34,
   "text": "چرا نگاه متعجب برای چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.34,
   "end": 283.12,
   "text": "احسنت. احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.12,
   "end": 285.56,
   "text": "برای اینکه من قرار بود ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.56,
   "end": 289.92,
   "text": "همون روز ساعتی بعد در هندوستان قبض روح کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.92,
   "end": 294.24,
   "text": "دیدم ایشون به هر وسیله‌ای بخواد خودشو برسونه یه ماه تو راهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.24,
   "end": 297.3,
   "text": "چجوری خدا به من دستور داده که خدا هم که خل، خل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.3,
   "end": 300.64,
   "text": "خلاف وعده نمی‌کنه. این تعجب من بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.64,
   "end": 302.44,
   "text": "که شما کار ما رو-- بعد رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.44,
   "end": 306.62,
   "text": "میگه من رفتم سر قرار به امر الهی دیدم اِ ایشون اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.62,
   "end": 309.88,
   "text": "و قبض روحش کردم. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.88,
   "end": 312.24,
   "text": "ببینید وقتی حالا، حالا گذشته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.24,
   "end": 315.1,
   "text": "نکات ریزی که در این دست روایات هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.1,
   "end": 317.5,
   "text": "اینه که بالاخره اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.5,
   "end": 319.92,
   "text": "قضای حتمی، اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.92,
   "end": 322.84,
   "text": "قطعی و حتمی می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.84,
   "end": 324.6,
   "text": "رسیدنیه تمام میشه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.6,
   "end": 328.1,
   "text": "دیگه این انسان بخواد فرار کنه، بترسه این‌ها برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 328.1,
   "end": 331.56,
   "text": "دلیلش چیه؟ بعدم اینا همه قوای عالمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 331.56,
   "end": 334.24,
   "text": "ملائکه، حضرت عزرائیل چرا باهاش دشمنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.24,
   "end": 338.34,
   "text": "چرا بعد مرگ میاد ببینیمش؟ اتفاقا خیلی از خودت باشه ایشونو زیارت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.34,
   "end": 341.92,
   "text": "انقدر زیباست، انقدر خوشگله، انقدر تو دل بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.92,
   "end": 344.68,
   "text": "حالا شما فکر می‌کنین ما بارها ایشونو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.68,
   "end": 350.02,
   "text": "نه طبق روایات میگیم. خیلی دوست داشتنی، خوش بو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.02,
   "end": 357.16,
   "text": "اصلاً واقعاً آدم مشخصات ایشون رو بررسی کنه شما زیباتر از ایشون هیچ اصلاً ندیدید شاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.16,
   "end": 359.82,
   "text": "چرا آدم بترسه از اینا؟ اینا قوای عالمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.82,
   "end": 362.44,
   "text": "میان برای اینکه به ما امداد برسونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.44,
   "end": 365.2,
   "text": "آرامش بدن. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.2,
   "end": 368.04,
   "text": "همه اینا رو من مقدمه قرار دادم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.04,
   "end": 370.9,
   "text": "اصل موضوع. متن موضوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.9,
   "end": 373.1,
   "text": "آیه بعدیه، آیه بیست و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 373.1,
   "end": 376.7,
   "text": "دویست وپنج سوره توبه رو دیروز گفتیم، پریروز گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 376.7,
   "end": 382.24,
   "text": "امروز بیست وشش رو میگیم. خب اون امدادهای الهی چگونه نازل میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.24,
   "end": 389.22,
   "text": "آیه بیست وشش سوره توبه \"ثم انزل السکینه على رسوله و على المؤمنین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.22,
   "end": 394.56,
   "text": "سپس خدا آرامش، سکینه، اطمینان نازل میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.56,
   "end": 399.5,
   "text": "بر پیغمبرش و بر اهل ایمان \"و انزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.5,
   "end": 406.0,
   "text": "جنوداً\" بعد \"و انزل جنوداً\" اون قوای عالم، ملائکه، فرشته‌ها رو که بحثش چند روز پیش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.0,
   "end": 409.34,
   "text": "\"لم تروها\" که شما نمی‌بینیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.34,
   "end": 413.14,
   "text": "اینا رو هم نازل میکنه جنود الهی‌ان شما رو کمک بدن، امداد بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.14,
   "end": 415.18,
   "text": "چرا می‌ترسی؟ چرا مضطربی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.18,
   "end": 417.7,
   "text": "چرا گرفتاری؟ مگه عالم حساب کتاب نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.7,
   "end": 420.74,
   "text": "مگه خدا نداره؟ مگه ساحت نداریم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.74,
   "end": 428.02,
   "text": "\"وعذب الذين كفروا من ذلك جزاء الغافلين\" فکر می‌کنی کفار و مشرکین و منافقان رها‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.02,
   "end": 430.46,
   "text": "نخیر. چنان معذبشون می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 430.46,
   "end": 433.36,
   "text": "صبر کن. الان یه مهلتی بهشون داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 433.36,
   "end": 435.38,
   "text": "بعد چنان تو ماره این‌ها رو می‌پیچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.38,
   "end": 437.86,
   "text": "صبر کن جلوی چشم شماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.86,
   "end": 440.78,
   "text": "که تحت ظلم و ستم واقع شدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.78,
   "end": 446.58,
   "text": "ظالمین رو. اینکه \"انزل السکینه\" خب حالا دوباره سؤال ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.58,
   "end": 449.58,
   "text": "سکینه چیه؟ چگونه نازل میشه بر قلب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.58,
   "end": 453.62,
   "text": "این امداد بالاخره اینجا فهمیدیم که نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 453.62,
   "end": 455.4,
   "text": "آرامش چگونه نازل میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.4,
   "end": 458.84,
   "text": "به چه شکلی؟ اینا اصلا چی‌ان اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.84,
   "end": 462.22,
   "text": "اجازه بدید که ذیل این آیه یه حدیث تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.22,
   "end": 465.26,
   "text": "تفسیر اهل بیت جلد شش، صفحه نود و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.26,
   "end": 470.68,
   "text": "البته در کافی مرحوم کلینی اعلا الله مقامه الشریف، جلد پنج هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 470.68,
   "end": 473.32,
   "text": "صفحه دویست و پنجاه و هفت می‌تونید ببینید این روایتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 473.32,
   "end": 476.66,
   "text": "ذیل آیه بیست وشش توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.66,
   "end": 479.06,
   "text": "علی ابن اسبات میگه از امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 479.06,
   "end": 485.64,
   "text": "علیه السلام پرسیدم \"فقلت جعت فداک\" جونم به فدات آقا \"ما السکینه؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 485.64,
   "end": 489.96,
   "text": "سکینه چیه؟ \"قال ريح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.96,
   "end": 494.46,
   "text": "امام رضا فرمود یک نسیمی‌ست، بادی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.46,
   "end": 499.7,
   "text": "آرامش \"من الجنه\" البته جنسش بهشتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.7,
   "end": 503.04,
   "text": "این نسیم از بهشته \"لها وجه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.04,
   "end": 506.7,
   "text": "وجوهی دارد. وجهی دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 506.7,
   "end": 511.08,
   "text": "خ-- یه وجهی داره این نسیم یعنی یه صورتی داره، یه چهره‌ای داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.08,
   "end": 513.38,
   "text": "\"کوجه الانسان\" شبیه انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.38,
   "end": 515.92,
   "text": "یعنی شما-- چرا شبیه انسان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 515.92,
   "end": 521.7,
   "text": "یه وجهش اینه که به جای اینکه شما مانوس باشی باهاش غیر از انسانو ببینی یهو وحشت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.7,
   "end": 524.58,
   "text": "شبیه انسانه که تو وحشت نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.58,
   "end": 526.3,
   "text": "این البته تفسیر بنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 526.3,
   "end": 528.58,
   "text": "\"أطيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.58,
   "end": 531.06,
   "text": "رائحه من المشک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.06,
   "end": 534.34,
   "text": "از مشک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.34,
   "end": 540.76,
   "text": "خوشبوتره این صورت \"وهی التي انزلها الله على رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 540.76,
   "end": 543.98,
   "text": "بحنين\" و این همون چیزی‌ست که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 543.98,
   "end": 551.56,
   "text": "جنگ حنین بر پیغمبر نازل شد \"فهزم المشرکین\" بعد مشرکین رو هزم کرد خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.56,
   "end": 553.26,
   "text": "و همشون رو در و داغون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 553.26,
   "end": 559.12,
   "text": "این آرامش یعنی نشون میده که به صورت چی یک نسیمی میاد، یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.12,
   "end": 562.5,
   "text": "صورت داره، دو. شبیه انسانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 562.5,
   "end": 565.78,
   "text": "سه. انس می‌گیره با تو، چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 565.78,
   "end": 568.22,
   "text": "قدرتمنده، پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.22,
   "end": 573.44,
   "text": "اینا همه از توش داره بیرون میاد. به انسان نازل میشه و انسان رو کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 573.44,
   "end": 578.86,
   "text": "من به شخصه بعد از پنجاه و یکی دو سال عمری که از خدا گرفتم بیشتر زمان جنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 578.86,
   "end": 581.38,
   "text": "الانم تک و توکه اما اونموقع خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 581.38,
   "end": 586.16,
   "text": "زیاده دیدیم آدم‌هایی که حتی سنشون هم بعضا از ما کمتر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 586.16,
   "end": 590.96,
   "text": "اما این ریح، این باد، این نسیم خشک، این بوی عطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.96,
   "end": 593.88,
   "text": "خوشبوتر از مشک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.88,
   "end": 597.2,
   "text": "می‌دیدن، می‌چشیدن، می‌بوییدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 597.2,
   "end": 601.44,
   "text": "و می‌گفتن. مثلا طرف روضه‌خونی می‌گفت نسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.44,
   "end": 606.6,
   "text": "سید الشهدا داره میاد. خودتون رو در معرض نسیم قرار بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 606.6,
   "end": 609.48,
   "text": "باران داره می‌باره. خودت چتر رو بزن کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 609.48,
   "end": 612.28,
   "text": "بذار باران در-- این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 612.28,
   "end": 614.26,
   "text": "بر اثر مراقبت پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.26,
   "end": 619.86,
   "text": "میشه انسان به این جاها برسه. حالا اینکه این ملائکه چی هستن، این ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 619.86,
   "end": 621.88,
   "text": "به یک معنا قوای عالمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.88,
   "end": 624.58,
   "text": "که حالا اگر دوست داشتید یه جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.58,
   "end": 628.3,
   "text": "خیلی کلی پیرامون ملائکه حرف بزنیم مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 628.3,
   "end": 631.0,
   "text": "امام سجاد علیه السلام می‌خوام به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 631.0,
   "end": 635.44,
   "text": "تصریح کنم با زبان خود اهل بیت و-وجود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 635.44,
   "end": 643.64,
   "text": "موجودات زیجود رو در دعای سوم صحیفه برید ببینید در خصوص ملائکه چقدر با عظمت یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 643.64,
   "end": 645.58,
   "text": "حالا من ترجمه‌شو بخونم وقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 645.58,
   "end": 648.04,
   "text": "حضرت درود می‌فرسته بر خازنان باران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 648.04,
   "end": 650.42,
   "text": "الان بارش باران و رحمت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 650.42,
   "end": 653.74,
   "text": "درود می‌فرسته برای همینا. میگه خازن دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 653.74,
   "end": 655.68,
   "text": "روان کنندگان ابرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 655.68,
   "end": 662.08,
   "text": "امام سجاد داره میگه. ابر رو روان می‌کنند که چون ابرها بانگ زنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 662.08,
   "end": 663.88,
   "text": "ابرها فریاد می‌زنن. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.88,
   "end": 670.16,
   "text": "این قوای عالم که همون به یک معنا نسیم رحمتن داد می‌زنن سر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 670.16,
   "end": 674.76,
   "text": "حالا ما می‌گیم داد می‌زنن، بانگ می‌زنن یعنی تشر می‌زنن یعنی امر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 674.76,
   "end": 680.82,
   "text": "به چی؟ به ابرها. بعد آواز تندرها به گوش می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.82,
   "end": 685.92,
   "text": "یعنی چی؟ رعد و برق. و چون ابرها از آن نهیب به راه میفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.92,
   "end": 690.92,
   "text": "یعنی از اون تشر، از اون فریاد، از اون امر الهی، این ابرها به راه میفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 690.92,
   "end": 696.5,
   "text": "صدای رعد و برق رو می‌شنوی. یعنی میشه گفت شلاق ملائکه است به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.5,
   "end": 700.78,
   "text": "به گوش-- دوش و گرده‌ی ابرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.78,
   "end": 703.4,
   "text": "آذرخش‌ها از درونشان برقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 703.4,
   "end": 708.38,
   "text": "برق میزنه بیرون. بعد می‌فرماید درود بفرست بر ملائکه و خزان باران، برف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.38,
   "end": 712.06,
   "text": "یکی یکی امام سجاد میاره. این‌ها ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.06,
   "end": 716.22,
   "text": "این نکته، این جمله آخر منو خوب گوش بدید به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 716.22,
   "end": 722.9,
   "text": "چون مباحثش قبلاً تو مباحث حکمی، فلسفی‌مون حتی بعضا عرفانی‌مون گذشته الان باید بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 722.9,
   "end": 730.5,
   "text": "هر چیزی در این نشئه هست چون \"إن من شيء إلا عندنا خزائنه ومن نزلناه إلا بقدر معلوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 730.5,
   "end": 735.07,
   "text": "یه صورت طبیعی و ملکی و دنیوی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 735.07,
   "end": 740.31,
   "text": "خب یه صورت برزخی یا مثالی یا خیالی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 740.31,
   "end": 746.29,
   "text": "یه صورت عقلی داره. بعد یه صورت الهی هم داره که از حضرت اله نازل شده دیگه خزانه ها اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 746.29,
   "end": 750.79,
   "text": "ما هم همینطوریم. یه صورت دنیوی داریم که الان شما دارید منو می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 750.79,
   "end": 755.57,
   "text": "یه صورت برزخی دارم همین الان‌ها یه صورت عقلی دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 755.57,
   "end": 761.03,
   "text": "که خیلی کلیه که رو-روح منه به یک معنا یا قلب منه بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 761.03,
   "end": 764.01,
   "text": "صورت الهیت هم روح منه که وصله به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 764.01,
   "end": 767.53,
   "text": "همه ما اینطوریم. ملائکه هم اینطورین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 767.53,
   "end": 769.59,
   "text": "برای یه ت-تصویری بکنید حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 769.59,
   "end": 770.81,
   "text": "چون خیلی نگاهتون با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 770.81,
   "end": 777.89,
   "text": "همراه با تعجبه فردا درباره‌ش مفصل بهتر صحبت می‌کنیم که وقت هست الان فرصت نیست تند تند حقش ادا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 777.89,
   "end": 781.97,
   "text": "فقط اینو بدونین ملائکه هم که قوای عالم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 781.97,
   "end": 783.93,
   "text": "اون‌ها هم یه صورت ملکی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 783.93,
   "end": 786.07,
   "text": "میشه باد. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 786.07,
   "end": 788.33,
   "text": "یعنی این باده صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 788.33,
   "end": 791.11,
   "text": "ملکه. بله صورت دنیایی ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 791.11,
   "end": 794.07,
   "text": "میشه باران، میشه برف. این ملکه لذا حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 794.07,
   "end": 798.33,
   "text": "لذا رحمته. دریا صورت یه ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 798.33,
   "end": 800.79,
   "text": "آب صورت یه ملکه. اما صورت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 800.79,
   "end": 803.43,
   "text": "ملکی‌شه. اینا صورت مثالی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.43,
   "end": 807.79,
   "text": "برای حضرت مریم که سلام الله علیها تمثل کردند، قرآن میش-- می‌فرما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 807.79,
   "end": 811.55,
   "text": "\"فتمثل فتمثل لها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 811.55,
   "end": 814.33,
   "text": "برای حضرت مریم. \"بشراً سویا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.33,
   "end": 816.07,
   "text": "مثل یه بشر راست قامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 816.07,
   "end": 819.97,
   "text": "\"فتمثل\" تمثل پیدا کردن یعنی عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 819.97,
   "end": 822.61,
   "text": "یعنی تو قوه خیال دید ملائکه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 822.61,
   "end": 825.05,
   "text": "پس یه صورت مثالی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 825.05,
   "end": 828.77,
   "text": "و یه صورت عقلی دارن که اون صورت عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 828.77,
   "end": 833.57,
   "text": "جنود الله‌اند مافوق اون هم صورت الهیه که دیگه اون دیگه کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 833.57,
   "end": 839.99,
   "text": "روح عظمه که بیست جلسه ماه مبارک سال قبل پیرامونش حرف زدیم که چهار تا ملک زیردستشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 839.99,
   "end": 842.33,
   "text": "عزرائیل، بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 842.33,
   "end": 845.01,
   "text": "اسرافیل، میکائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 845.01,
   "end": 848.01,
   "text": "دیگه. نه جبرائیل نگفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 848.01,
   "end": 853.37,
   "text": "جبرائیل. این چهار تا میشن ملائکه کلی که تمام ملائکه زیردست اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 853.37,
   "end": 856.29,
   "text": "اون که بالا سر این چهار تاست روح عظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 856.29,
   "end": 859.75,
   "text": "حالا اینا هر کدوم یه وظایفی دارن که انشاالله فردا بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 859.75,
   "end": 861.99,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 861.99,
   "end": 864.81,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 864.81,
   "end": 871.05,
   "text": "سلام بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}