 },
 "chapters": [
  {
   "index": 0,
   "title": "## کتاب الموت؛ طاعون، موت و ستّار العیوب",
   "start": 96.16,
   "end": 181.08
  },
  {
   "index": 1,
   "title": "## دو هدیه از علامه؛ شیخ انصاری و آقای قاضی",
   "start": 181.08,
   "end": 899.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.12,
   "text": "رحیم و به he نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.12,
   "end": 7.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.14,
   "end": 12.5,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.5,
   "end": 14.64,
   "text": "تبریک عرض می‌کنم حلول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 16.56,
   "text": "ماه خدا رو، ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.56,
   "end": 22.34,
   "text": "رجب رو به یک معنا ماه ولایت، به یک معنا ماه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.34,
   "end": 27.8,
   "text": "و امروز هم که روز اول ماه، روز دوشنبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.8,
   "end": 34.98,
   "text": "اون دستورالعملی که آقای بهجت خیلی تاکید داشتن در کتاب بهجت و دعا هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.98,
   "end": 40.26,
   "text": "سوره واقعه، ختم سوره واقعه رو بتونید انجام بدید به هر منظوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.26,
   "end": 43.94,
   "text": "که از امروز شروع می‌شه و تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.94,
   "end": 51.96,
   "text": "چهارده روز هر روز امروز یک بار، فردا دو بار، پس فردا سه بار همین طوری تا روز چهاردهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.96,
   "end": 60.42,
   "text": "خیلی مجربه. البته آقای بهجت توصیه می‌کردن که حتی اگر کسی این طوری نمی‌تونه جماعتی جمع شن دور هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.42,
   "end": 63.88,
   "text": "صد و پنج بار سوره واقعه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.88,
   "end": 66.68,
   "text": "بخونن. نه همه با هم صد و پنج بار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.68,
   "end": 73.24,
   "text": "روی هم هر کس هر چقدر خوند به اضافه هم بکنن بشه صد و پنج بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.24,
   "end": 78.08,
   "text": "خیلی مجربه. امروز چون روز اول ماه، روز دوشنبه‌ست این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.08,
   "end": 81.18,
   "text": "وارد شده و ماه مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.18,
   "end": 83.54,
   "text": "البته حرام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.54,
   "end": 85.88,
   "text": "رجب هم هست که خیلی حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.88,
   "end": 90.22,
   "text": "از این حیث حرام. که ماه خدایی شدنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.22,
   "end": 93.84,
   "text": "خیلی خودمونی بخوایم عرض کنیم ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.84,
   "end": 100.02,
   "text": "خدایی شدنه. اتفاقاً برای اینکه مرتبط با بحث ما باشه، بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.02,
   "end": 104.02,
   "text": "کتاب الموت مرحوم مجلسیه و اون روایتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.02,
   "end": 107.8,
   "text": "بهش رسیدیم می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.8,
   "end": 112.6,
   "text": "وقتی که طاعون یه شهری میاد اگه یادتون باشه صحبت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.6,
   "end": 117.64,
   "text": "که برای عده‌ای طاعون رحمته برای عده‌ای عذابه مثل موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.64,
   "end": 121.5,
   "text": "موت هم برای اهل ایمان رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.5,
   "end": 124.68,
   "text": "برای اهل شرک و نفاق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.68,
   "end": 127.94,
   "text": "کفر نقمت و بدبختیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.94,
   "end": 134.86,
   "text": "مثل موته. عرض شود اونجا بعد گفتیم که اگر بلا وقتی نازل شد مثلاً اون موقع طاعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.86,
   "end": 138.44,
   "text": "الان کرونا، اونم زلزله، امیکرون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.44,
   "end": 141.6,
   "text": "حق شماتت دیگران رو نداریم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.6,
   "end": 144.98,
   "text": "که مثلاً بگیم کسی گناه کرد که خدا زدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.98,
   "end": 148.98,
   "text": "بحث همون ستّار العیوبی حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.98,
   "end": 154.28,
   "text": "که قرق ستاریت حضرت حق عرض کردیم هیچ‌وقت نباید شکسته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.28,
   "end": 161.7,
   "text": "اتفاقاً در روایت هم داریم که یک صفت رو از خدا بگیر، یک صفت رو از نبی، یک صفت رو از ولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.7,
   "end": 170.22,
   "text": "اینا رو می‌دونید همه. من باب تذکر عرض می‌کنم که اون صفتي که از خدا انسان باید در خودش پیاده کنه چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.22,
   "end": 172.46,
   "text": "اسم ستّار حضرت حق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.46,
   "end": 175.1,
   "text": "ستّار العیوب باشه برعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.1,
   "end": 181.08,
   "text": "خیلی از ماها که به راحتی آبرو می‌بریم، زیر پا خالی می‌کنیم، برخورد می‌کنیم، چکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.08,
   "end": 184.56,
   "text": "متأسفانه تو لباس دین هم هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.56,
   "end": 187.16,
   "text": "خدا نکنه یه کسی جلوی ما علم شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.16,
   "end": 190.4,
   "text": "تا علمشو زمین نزنیم، تا آبروشو نبریم ول نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.4,
   "end": 193.26,
   "text": "این خدایی شدن نیست عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.26,
   "end": 197.1,
   "text": "ماه رجب حالا بحث ما هم با بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.1,
   "end": 205.92,
   "text": "کتاب الموت و اون بلا و عدم شما- شماتت دیگران رو پیاده کردن اسم ستّار العیوبی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.92,
   "end": 214.26,
   "text": "عجین شده با همین بحث رجب و میلاد امام باقر که امروز هست برای همه انشاالله پر از خیر و برکت باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.26,
   "end": 216.48,
   "text": "خدایی شدن در این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.48,
   "end": 219.52,
   "text": "یعنی صفات خدا در انسان پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.52,
   "end": 222.92,
   "text": "نه فقط انسان ظاهراً در عملیات بندگی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.92,
   "end": 225.62,
   "text": "در این ایام بله کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.62,
   "end": 229.78,
   "text": "رکوع و سجود و کثار ادعه و اذکار این‌ها خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.78,
   "end": 232.36,
   "text": "اما خدایی شدن مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.36,
   "end": 236.26,
   "text": "اخلاق الهی. تخلّقوا بأخلاق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.26,
   "end": 240.56,
   "text": "تو این ماه پیدا کردن که البته مسیرش از سکوت می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.56,
   "end": 246.94,
   "text": "شما ببینید بهترین کارهایی که در این ماه بزرگان در این ماه مخصوصاً ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.94,
   "end": 252.18,
   "text": "بزرگان سفارش کردن جالبه که بدونید یکیش خود سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.18,
   "end": 256.54,
   "text": "سکوت، حدیث هم داریم که سکوت از صمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.54,
   "end": 259.2,
   "text": "سکوت باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.2,
   "end": 262.58,
   "text": "حکمته. حدیث داریم، قبلاً بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.58,
   "end": 266.76,
   "text": "یعنی کسی سکوت بگیره در حکمت به روش باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.76,
   "end": 271.32,
   "text": "قرآن هم که می‌فرماید و يعلمهم الكتاب و الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.32,
   "end": 273.64,
   "text": "کتاب و حکمت. این‌ها با هم چه فرق می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.64,
   "end": 276.72,
   "text": "کتاب قانونه، دستوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.72,
   "end": 284.94,
   "text": "عملیات بندگیه. خب اینکه این دستورات رو، این قانون رو، این عملیات رو چگونه مهندسی کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.94,
   "end": 291.18,
   "text": "الان چه کنی؟ این همه ذهن ما پر است از مفروضات، بایدها، نبایدها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.18,
   "end": 294.22,
   "text": "اوامر و نواهی. این کارو انجام بده، این کارو انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.22,
   "end": 296.2,
   "text": "خب چگونه این‌ها رو مهندسی کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.2,
   "end": 299.8,
   "text": "الان من چه کنم؟ الان من نماز بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.8,
   "end": 302.78,
   "text": "یا مثلاً مادرم صدام زده برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.78,
   "end": 307.12,
   "text": "لبیک بگم یا یه کسی داره غرق می‌شه برم اونو نجات بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.12,
   "end": 311.04,
   "text": "و و. این مهندسی کردن علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.04,
   "end": 316.88,
   "text": "دقت بفرمایید به یک معنا. البته هفتده هجده معنا برای حکمت گفتن یکیش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.88,
   "end": 318.62,
   "text": "مهندسی کردن علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.62,
   "end": 321.02,
   "text": "یعنی تو علمتو چگونه پیاده کنی در عمل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.02,
   "end": 323.4,
   "text": "به این می‌شن حکمت. بهش می‌گن حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.4,
   "end": 327.28,
   "text": "از کجا می‌رسی؟ روایت می‌فرمود سکوت از صمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.28,
   "end": 333.98,
   "text": "و چه جالب که امروز هم که روز اول این ماهه، ماه سکوته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.98,
   "end": 337.12,
   "text": "میلاد کسیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.12,
   "end": 343.04,
   "text": "شکافنده علمش، کسی شکافنده علمه یعنی به سر علم رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.04,
   "end": 346.68,
   "text": "که یعنی حکیمه. حکیم علی الاطلاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.68,
   "end": 352.8,
   "text": "یعنی به حکمت رسیده. یکی از معانی باقر العلوم مثلاً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.8,
   "end": 355.5,
   "text": "پرده‌های علم رو دریده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.5,
   "end": 358.48,
   "text": "یعنی اینکه به حکمت رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.48,
   "end": 361.04,
   "text": "از حکم میاد محکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.04,
   "end": 363.58,
   "text": "پشت سر امام باقر باشی کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.58,
   "end": 370.54,
   "text": "لذا حالا این ماه خیلی خوبه انسان خب اوراد و ادعیه یکی از کارهای خیلی خوب این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.54,
   "end": 374.12,
   "text": "ادعیه‌ست. استغفار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.12,
   "end": 376.16,
   "text": "تحلیل اینا تو این ماه خیلی وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.16,
   "end": 379.22,
   "text": "مثل ماه بعد صلوات خیلی وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.22,
   "end": 383.92,
   "text": "این ماه چی؟ تحلیل لا اله الا الله، استغفار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.92,
   "end": 388.14,
   "text": "دعا این چند تا. اما همه این‌ها چین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.14,
   "end": 390.7,
   "text": "در کنار سکوت جواب میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.7,
   "end": 393.08,
   "text": "یعنی انسان بفهمه چیکار داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.08,
   "end": 395.76,
   "text": "بفهمه داره چگونه بندگی خدا رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.76,
   "end": 398.5,
   "text": "همینطوری طوطی‌واری لغ لغه زبان نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.5,
   "end": 401.82,
   "text": "ادعیه رو بفهمه برای چی در، به زبان می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.82,
   "end": 405.54,
   "text": "اینکه به زبان داره ادعیه رو یا اذکار رو میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.54,
   "end": 410.76,
   "text": "تسبیح هم دستشو، صف اول نماز جماعت و شب جمعه هم هییتشو اینا ترک نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.76,
   "end": 414.1,
   "text": "اما راحت آبروی دیگران رو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.1,
   "end": 417.36,
   "text": "راحت زلزله تو وجود دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.36,
   "end": 419.46,
   "text": "می‌ریزه و آ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.46,
   "end": 423.02,
   "text": "خیلی راحت به اضطراب می‌ندازه قلوب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.02,
   "end": 426.74,
   "text": "الان که خیلیا نیاز به ترمیم روحی روانی دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.74,
   "end": 429.86,
   "text": "مشکلات اقتصادی به شدت اوج گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.86,
   "end": 433.58,
   "text": "خیلی راحت یه مدیر برمی‌گرده یکی از کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.58,
   "end": 437.32,
   "text": "بیکار می‌کنه. این نمی‌دونم قیامت چی می‌خواد جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.32,
   "end": 439.92,
   "text": "جواب صاحب این کشورو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.92,
   "end": 441.9,
   "text": "صاحب این سفره رو چی می‌خواد بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.9,
   "end": 444.5,
   "text": "صاحب اون سجاده‌ای که روش نشسته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.5,
   "end": 450.5,
   "text": "با این آینه، با این نما و نماد دین وارد می‌شه چجوری می‌خواد جواب بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.5,
   "end": 456.32,
   "text": "من نمی‌دونم. خدایی شدن یعنی اخلاق خدا تو انسان پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.32,
   "end": 458.32,
   "text": "حالا یه عده میان میگن حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.32,
   "end": 460.56,
   "text": "یه دستورالعمل بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.56,
   "end": 464.54,
   "text": "خب عزیز دلم چرا هی دنبال دستورالعملیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.54,
   "end": 467.22,
   "text": "حکمت از سکوت می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.22,
   "end": 471.2,
   "text": "برو بعد بهت میدن. دستورالعمل‌ها رو خودشون، خودشون بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.2,
   "end": 477.22,
   "text": "و جالبه که فهم اون دستورالعمل‌ها هم از همین سکوت و از همین خدایی شدن می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.22,
   "end": 479.24,
   "text": "ببینید چه ولوله‌ای در عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.24,
   "end": 481.84,
   "text": "\"یسبح لله ما في السماوات والارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.84,
   "end": 485.0,
   "text": "همه چی در حرکت جوهری خودش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.0,
   "end": 487.32,
   "text": "چیکار می‌کنه؟ آن فآن. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.32,
   "end": 490.0,
   "text": "خدای ممنون در تجلی جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.0,
   "end": 493.5,
   "text": "همه در، همه‌ی خلائق در حال ظهور جدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.5,
   "end": 495.52,
   "text": "در حال تسبیح الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.52,
   "end": 499.26,
   "text": "اما از خدا لام تا کام حرفی می‌شنوی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.26,
   "end": 502.9,
   "text": "از خدا صدا می‌شنوی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.9,
   "end": 509.92,
   "text": "از خود خدا. اصلاً سکوت مال مردان بزرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.92,
   "end": 512.68,
   "text": "حرف مردان بزرگ عملشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.68,
   "end": 517.74,
   "text": "اونم عمل خدایی. حالا اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.74,
   "end": 526.04,
   "text": "دنبال دستورالعمل بود، من تبرکاً یه دو تا یادگاری امروز به برکت میلاد امام باقر علیه السلام به شما تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.04,
   "end": 529.9,
   "text": "اگرچه اهل این حرفا خیلی نیستم از این یادگاری‌ها بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.9,
   "end": 534.64,
   "text": "اما به عشق امروز، روز اول ماه رجب، میلاد امام باقر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.64,
   "end": 540.0,
   "text": "و جمع باصفای شما میگم اگرچه خیلی جای شرح و بسط و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.0,
   "end": 542.2,
   "text": "توضیح داره همین دو تا نکته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.2,
   "end": 545.9,
   "text": "دو تا یادگاری میگم انشاالله که قدرشو بدانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.9,
   "end": 551.5,
   "text": "حضرت استاد که ما در مشرب ایشون نفس می‌کشیم و سر صفای ایشون حضرت علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.5,
   "end": 557.0,
   "text": "ایشون جالبه که دو تا یادگاری یکی از شیخ مرتضی انصاری می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.0,
   "end": 559.32,
   "text": "یکی هم از آستاد علی آقای قاضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.32,
   "end": 564.0,
   "text": "خب شما توجه کنید علامه حسن زاده معاصر ما بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.0,
   "end": 567.16,
   "text": "یعنی در زمان شیخ مرتضی انصاری نبودن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.16,
   "end": 568.98,
   "text": "در زمان آقای قاضی نبودن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.98,
   "end": 572.32,
   "text": "ایشون صراحتاً میگن من این دو تا دستورالعمل رو یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.32,
   "end": 575.42,
   "text": "شیخ مرتضی انصاری بزرگ گرفته‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.42,
   "end": 577.14,
   "text": "شیخ العلماء والمجتهدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.14,
   "end": 584.48,
   "text": "یکی هم از آقای قاضی. خب شما که شاگرد آقای علامه طباطبایی بودی، علامه طباطبایی آقای قاضی رو درک کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.48,
   "end": 590.74,
   "text": "شما چجوری مدعی شدی که از اون‌ها این ذکر رو گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.74,
   "end": 593.1,
   "text": "چ-چگونه باید توجیهش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.1,
   "end": 595.24,
   "text": "یعنی اینکه ارتباط گرفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.24,
   "end": 598.04,
   "text": "خیلی جالبه در اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.04,
   "end": 602.9,
   "text": "ز-این ذکر دوم که معلوم دو تاشو تقدیم می‌کنم خودش می‌فرماید، خود علامه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.9,
   "end": 605.7,
   "text": "\"من در طول حیات و عمرم بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.7,
   "end": 608.6,
   "text": "استفاده کردم از این ذکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.6,
   "end": 611.52,
   "text": "خیلی بهره‌ها بردم و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.52,
   "end": 613.92,
   "text": "روح بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.92,
   "end": 619.04,
   "text": "در خواب و بیداری ارتباط گرفتم و اهل بیت و اهل بیت علیهم السلام تا استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.04,
   "end": 621.18,
   "text": "به برکت این دو تا دستور.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.18,
   "end": 625.52,
   "text": "حالا یکیش رو که از شیخ مرتضی انصاری ایشون داره یعنی شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 625.52,
   "end": 628.28,
   "text": "مشخصه که حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.28,
   "end": 631.88,
   "text": "دیدار می‌کنه با شیخ مرتضی انصاری، با روح اون بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.88,
   "end": 635.7,
   "text": "مثل اینکه روح شیخ اکبر رو می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.7,
   "end": 639.54,
   "text": "و در خصوص فسوس، فسوس ابن عربی با ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.54,
   "end": 641.82,
   "text": "صحبت می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.82,
   "end": 644.56,
   "text": "فس بیست و هشتم رو می‌نویسه که فس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.56,
   "end": 647.22,
   "text": "حکمت اسمتیفی کلمة فاطمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 647.22,
   "end": 651.4,
   "text": "و ولی این بزرگه، البته برای این چ، این چیزا برای ما یه مقدار ثقیله، مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 651.4,
   "end": 654.22,
   "text": "ولی برای اونا اینا چیزی نبوده. اینا نخود کیش میش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 654.22,
   "end": 657.0,
   "text": "شما از ملک به ملکوت که رسیدی تمامه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 657.0,
   "end": 659.76,
   "text": "همه چی زیر پاته. ارتباط داری از ملک به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.76,
   "end": 662.26,
   "text": "البته ظرفیت می‌خواد، سکوت می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 662.26,
   "end": 664.48,
   "text": "رفتی تو بالا، بالا نگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.48,
   "end": 667.16,
   "text": "نگاه بالا به پایین پیدا نکنی مثل خیلی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.16,
   "end": 670.24,
   "text": "متأسفانه متکبرین ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 670.24,
   "end": 677.1,
   "text": "خب این هدیه اول رو حضرت علامه فرمودن که شیخ مرتضی انصاری فرمودن به تعداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.1,
   "end": 679.06,
   "text": "عدد اسم مولا علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.06,
   "end": 684.7,
   "text": "یعنی صد و ده بار بگید. البته همه‌ی ایام سال می‌شه مخصوصاً رجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.7,
   "end": 688.36,
   "text": "جالبه که بدونید هدیه رم مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.36,
   "end": 693.04,
   "text": "دیشب و امروزه. مال ماه رجب و البته ایام رجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.04,
   "end": 698.3,
   "text": "منتها ایشون شب اول ماه رجب این هدیه رو از شیخ مرتضی انصاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.3,
   "end": 702.92,
   "text": "اخذ می‌کنه. علامه می‌گه از شیخ مرتضی انصاری خواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 702.92,
   "end": 709.44,
   "text": "در خصوص شب اول رجب و این ایام و اینا یه هدیه‌ای به ما بدن، یه دستورالعملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.44,
   "end": 711.76,
   "text": "و ایشون دعای مولا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.76,
   "end": 715.06,
   "text": "توصیه کردن. یه دعای سه خطی داره مولا علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 715.06,
   "end": 717.72,
   "text": "خیلی کولاکه این دعا، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 717.72,
   "end": 721.08,
   "text": "به نظرم یکی از جامع‌ترین ادعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 721.08,
   "end": 727.58,
   "text": "سه خط هم است. که می‌فرماید \"الهی کفا بی عزا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 727.58,
   "end": 730.56,
   "text": "بسه به اره عزت من همین بسه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 730.56,
   "end": 733.76,
   "text": "\"أن أكون لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 733.76,
   "end": 736.64,
   "text": "عبدا\". اینکه من بنده‌ی تو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 736.64,
   "end": 738.42,
   "text": "چه عزتی بالاتر از این که بنده‌ی تو باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 738.42,
   "end": 741.06,
   "text": "\"وكفى بفخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 741.06,
   "end": 743.46,
   "text": "أن تكون لي ربا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 743.46,
   "end": 746.16,
   "text": "و چه فخری. اصلاً این، این فخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 746.16,
   "end": 749.56,
   "text": "کفایت میکنه برای من که تو پروردگار من باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.56,
   "end": 752.48,
   "text": "به به، به به. جمله‌ی سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 752.48,
   "end": 755.42,
   "text": "\"أنت كما أحب\". به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 755.42,
   "end": 759.3,
   "text": "چقدر شیرینه. تو اون طوری هستی که من دوست دارم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 759.3,
   "end": 763.72,
   "text": "\"فاجعلني كما تحب\". منو طوری قرار بده که تو دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 763.72,
   "end": 767.62,
   "text": "چی شد؟ خدایا تو اون طوری هستی که من دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 767.62,
   "end": 770.9,
   "text": "\"أنت كما أحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.9,
   "end": 772.86,
   "text": "فاجعلني كما تحب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 772.86,
   "end": 775.3,
   "text": "منو طوری قرار بده که تو دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 775.3,
   "end": 779.16,
   "text": "خیلی دعا قشنگه. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 779.16,
   "end": 784.54,
   "text": "ایشون می‌فرمود حضرت علامه می‌فرمود که من استفاده‌ها کردم و از به برکت همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 784.54,
   "end": 790.86,
   "text": "دعا با حضور معصومین در بیداری و خواب رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.86,
   "end": 798.26,
   "text": "نکته‌ی دوم که باز هم مربوط به ماه رجب از آقای قاضی در خصوص ماه رجب علامه دسترالامه رو می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 798.26,
   "end": 800.58,
   "text": "حضرت آقای قاضی می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 800.58,
   "end": 803.46,
   "text": "قرآن بخوانید تو این ماه، ماه رجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 803.46,
   "end": 805.82,
   "text": "قرآن بخوانید. چگونه بخوانید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 805.82,
   "end": 810.9,
   "text": "حضرت آقای قاضی فرمودند قرآن بخوانید لکن با تأمل در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 810.9,
   "end": 813.1,
   "text": "معانی آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 813.1,
   "end": 816.66,
   "text": "بلکه بتوانید یک قرآن ختم هم بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 816.66,
   "end": 821.18,
   "text": "یعنی نه این نه طور انقدر تأمل نشد که مثلا ماه تموم شد ختم قرآن نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 821.18,
   "end": 825.5,
   "text": "یه ختم قرآن حتی حداقل بکنید اما با تأمل در معانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 825.5,
   "end": 829.12,
   "text": "این دو تا هدیه‌ی ما از طرف حضرت استاد باشه به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 829.12,
   "end": 832.72,
   "text": "انشاالله که امروز پر از خیر و برکت بلکه این ماه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 832.72,
   "end": 838.64,
   "text": "پر از خیر و برکت باشه که امروز به منزله‌ی ورود به شهر الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 838.64,
   "end": 843.94,
   "text": "ورود به شهر الله. ماه شعبان میشه صحن شهر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 843.94,
   "end": 846.8,
   "text": "ماه رمضان میشه چی؟ روضه‌ی مقدسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 846.8,
   "end": 849.2,
   "text": "شب قدر هم میشه دیگه مژگع شریف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 849.2,
   "end": 851.32,
   "text": "اون قبر رو زیارت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 851.32,
   "end": 854.2,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 854.2,
   "end": 858.84,
   "text": "جان. سه تا صفت که گفتید یکی‌شون ستّار العیوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 858.84,
   "end": 863.5,
   "text": "بله از خدا فرمودند پیغمبر فرمودند از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 863.5,
   "end": 865.94,
   "text": "صفت ستّار العیوب رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 865.94,
   "end": 868.66,
   "text": "ای بنده بکن بپوشانید. از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 868.66,
   "end": 871.94,
   "text": "نبی اکرم اصمد مدارا رو بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 871.94,
   "end": 874.8,
   "text": "از ولی خدا یعنی از امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 874.8,
   "end": 877.28,
   "text": "چی رو بگیرید؟ صبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 877.28,
   "end": 882.72,
   "text": "مدارا از پیغمبر. صبر بر بلایا از ولی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 882.72,
   "end": 888.18,
   "text": "آقای دانش هم به من گفتن آقا حاج آقا به عزیزان بگید که خیلی صلوات‌هاشون شعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 888.18,
   "end": 892.04,
   "text": "راست میگن صلوات بلند نفاق رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 892.04,
   "end": 899.32,
   "text": "صلوات خط کن. اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}