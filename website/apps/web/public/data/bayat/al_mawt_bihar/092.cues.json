   "start": 30.92,
   "end": 132.46
  },
  {
   "index": 1,
   "title": "## خطبهٔ قاصعه و بیماری شیطان",
   "start": 132.46,
   "end": 175.5
  },
  {
   "index": 2,
   "title": "## خشوع قرب نه کبریای دروغین",
   "start": 175.5,
   "end": 274.3
  },
  {
   "index": 3,
   "title": "## لشکر سواره و پیاده؛ تیر از مکان نزدیک",
   "start": 274.3,
   "end": 374.84
  },
  {
   "index": 4,
   "title": "## رب بما أغویتنی و زینت دنیا",
   "start": 374.84,
   "end": 421.22
  },
  {
   "index": 5,
   "title": "## حکایت مباحثه با شیطان",
   "start": 421.22,
   "end": 767.63
  },
  {
   "index": 6,
   "title": "## یوم؛ ظرف ظهور",
   "start": 767.63,
   "end": 905.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.4,
   "end": 4.4,
   "text": "و آل محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.4,
   "end": 6.94,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.94,
   "end": 11.52,
   "text": "و به نستعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 17.3,
   "text": "و ربانی آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.3,
   "end": 20.82,
   "text": "قد استحققت و رایت الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.82,
   "end": 24.08,
   "text": "و الشقاء جاء العمل بین العينین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.08,
   "end": 28.06,
   "text": "و ذهب الأجل وراء الظهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.06,
   "end": 34.32,
   "text": "اگر انشاالله خدا توفیق بده دیگه امروز آخرین نکته رو پیرامون این روایت تقدیم کنیم و رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.32,
   "end": 37.66,
   "text": "روایت پنجم از باب چهارم کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.66,
   "end": 41.24,
   "text": "همونطور که دقت می‌کنید در متن روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.24,
   "end": 46.24,
   "text": "کسی که در ولایت شیطان قرار می‌گیره لذا بدبخت می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.24,
   "end": 49.58,
   "text": "می‌فرماید جا از این کلمات دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.58,
   "end": 53.14,
   "text": "جاء العمل بعد می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.14,
   "end": 57.24,
   "text": "ذهب الأجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.24,
   "end": 60.08,
   "text": "یه بار دیگه بخونم. جاء آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.08,
   "end": 63.52,
   "text": "چی آمد؟ عمل. آرزوی طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.52,
   "end": 68.22,
   "text": "چی رفت؟ ذهب الأجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.22,
   "end": 71.7,
   "text": "اجل رفت. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.7,
   "end": 75.32,
   "text": "توأمان. یعنی وقتی این اومد اون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.32,
   "end": 77.92,
   "text": "هر کدوم بیاد اون یکی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.92,
   "end": 81.02,
   "text": "آرزوی طولانی اگر بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.02,
   "end": 83.14,
   "text": "یاد موت از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.14,
   "end": 86.2,
   "text": "یعنی موت پشت سر قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.2,
   "end": 89.5,
   "text": "و ذهب الأجل وراء الظهر پشت سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.5,
   "end": 94.92,
   "text": "اصلاً فراموش می‌شه. ببینید کو-- اصلاً متن روایت داره اینو تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.92,
   "end": 98.68,
   "text": "اگر یاد موت اومد چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.68,
   "end": 102.02,
   "text": "آرزو میره. این بیاد اون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.02,
   "end": 108.36,
   "text": "اینا ملازم هم‌ند. بله عمل با الف یعنی آرزو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.36,
   "end": 113.44,
   "text": "که البته قبلاً گفتیم می‌فرماید جاء العمل بین العينین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.44,
   "end": 119.88,
   "text": "دو تا چشم. یعنی خدا نکنه کسی دو تا چشمش رو آرزوها پر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.88,
   "end": 123.02,
   "text": "اگه یه چشمش رو پر کنه باز امیدی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.02,
   "end": 126.82,
   "text": "اینجا میگه العينین دو تا یعنی دیگه کسی گرفتار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.82,
   "end": 132.46,
   "text": "هر، همه آرزوهاشو به دنیا می‌ده لذا فراموش کرده موت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.46,
   "end": 136.02,
   "text": "در بحث شیطان و ولایت شیطان داشتیم سخن می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.02,
   "end": 141.4,
   "text": "امروز خطبه قاصعه امیرالمؤمنین صلی الله علیه رو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.4,
   "end": 143.06,
   "text": "به واقع آدم تنش می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.06,
   "end": 147.74,
   "text": "اولاً می‌دونین این خطبه بزرگ‌ترین، طولانی‌ترین خطبه نهج البلاغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.74,
   "end": 153.5,
   "text": "در یه بخشی مولا به خطر شیطان خیلی به صورت جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.5,
   "end": 158.02,
   "text": "اشاره می‌کنه. من یک بخشی از متن رو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.02,
   "end": 160.98,
   "text": "چون فرصت نیست فقط ترجمه‌شو بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.98,
   "end": 165.28,
   "text": "که حضرت در بخشی از متن می‌فرماید با ما داره میگه امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.28,
   "end": 168.88,
   "text": "مولا علی صلی الله علیه. \"ای بندگان خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.88,
   "end": 174.16,
   "text": "از این دشمن خدا\" یعنی ابلیس \"برحذر باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.16,
   "end": 178.92,
   "text": "نکند شما را به بیماری خویش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.92,
   "end": 181.76,
   "text": "مبتلا سازد.\" بیماری شیطان چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.76,
   "end": 191.78,
   "text": "قبل از اینکه ورود کنه به این فرمایش قبلش مولا فرموده بود که این گرفتاریش تکبر و غرور و تعصب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.78,
   "end": 196.52,
   "text": "تعصب. که الان ما خیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.52,
   "end": 199.56,
   "text": "خیلی‌هامون گرفتار این مسئله هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.56,
   "end": 201.84,
   "text": "عزیزان علت عمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.84,
   "end": 205.22,
   "text": "گرفتاری‌های دنیایی اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.22,
   "end": 208.46,
   "text": "همینه که تکبر ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.46,
   "end": 212.36,
   "text": "شما گمان کنید مرگ نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.36,
   "end": 216.9,
   "text": "هممون متکبر می‌شدیم. بیماری نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.9,
   "end": 220.76,
   "text": "فقر نبود، مشکلات و مصائب نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.76,
   "end": 223.06,
   "text": "ما ادعای خدایی می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.06,
   "end": 226.44,
   "text": "درد تو جسم نبود. ادعای خدایی می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.44,
   "end": 229.3,
   "text": "اینا همه اومده که تکبر ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.3,
   "end": 232.06,
   "text": "کبریاi مخصوص خداست. به اهل بیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.06,
   "end": 237.6,
   "text": "امام صادق صلی الله علیه گفت آقا شما مگه نمی‌فرمایید کبریاi نزد خداست، مخصوص خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.6,
   "end": 241.94,
   "text": "شما هم یه استغفرالله العظیم چقدر بی‌معرفت بوده این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.94,
   "end": 244.24,
   "text": "شما هم گاهی آقا تو رفتارتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.24,
   "end": 248.3,
   "text": "یه حالت کبریایی و اینا دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.3,
   "end": 251.66,
   "text": "دامنتون مثلاً جمع می‌کنید یا خیلی ارتباط با مردم نمی‌گیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.66,
   "end": 255.14,
   "text": "حضرت فرمود این کبریایی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.14,
   "end": 258.36,
   "text": "به این نمیگن کبریایی. این خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.36,
   "end": 260.34,
   "text": "حاصله از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.34,
   "end": 266.72,
   "text": "مقام قرب. خشوعی که ما پیدا می‌کنیم، اون وقار، افتاد، سکینه، آرامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.72,
   "end": 271.76,
   "text": "اینچ که باید، باید اشتباه نباید بگیریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.76,
   "end": 275.62,
   "text": "خب ادامه سخن. پس می‌فرماید که شیطان کارش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.62,
   "end": 279.56,
   "text": "ما رو مثل خودش بیمار کنه. بیماریش هم که مشخصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.56,
   "end": 283.46,
   "text": "\"و با ندای خود شما را تحریک کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.46,
   "end": 288.82,
   "text": "و لشکریان سواره و پیاده‌اش را فریاد زند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.82,
   "end": 290.68,
   "text": "می‌تونه به یک وجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.68,
   "end": 295.82,
   "text": "به یک وجه البته لشکریان پیاده انسان‌ها باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.82,
   "end": 298.24,
   "text": "سواره اجنه باشن. می‌تونه اینجوری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.24,
   "end": 300.0,
   "text": "حالا دلیل هم براش دارم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.0,
   "end": 308.34,
   "text": "\"شما را تحریک کند و لشکریان سواره و پیاده‌اش را فریاد زند و بر ضد شما برانگیزد.\" یعنی خودش به تنهایی نمیاد ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.34,
   "end": 310.52,
   "text": "لشکریان دارد، نه لشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.52,
   "end": 313.88,
   "text": "\"به جانم سوگند\" عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.88,
   "end": 318.08,
   "text": "مولا به جان خودش سوگند بخوره معلومه که حرف خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.08,
   "end": 321.72,
   "text": "درسته؟ قبول دارید دیگه. بفرمایید چی می‌فرماید مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.72,
   "end": 324.96,
   "text": "\"به جانم سوگند او تیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.96,
   "end": 329.52,
   "text": "خطرناک را برای شما آماده نموده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.52,
   "end": 335.86,
   "text": "بر کمان گذاشته و با قدرت تا آخرین حد کشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.86,
   "end": 340.36,
   "text": "و از مکانی\" دور یا نزدیک به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.36,
   "end": 342.14,
   "text": "نزدیک. آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.14,
   "end": 344.98,
   "text": "مولا می‌فرماید از مکانی نزدیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.98,
   "end": 347.88,
   "text": "یعنی بغل گوشته، نه تو خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.88,
   "end": 351.96,
   "text": "همون نفس اماره‌ست. \"از مکانی نزدیک به سوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.96,
   "end": 355.22,
   "text": "شما پرتاب نموده است.\" شما داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.22,
   "end": 359.92,
   "text": "تازه میری یه جا جان پناه پیدا کنی پرتاب کرده تیرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.92,
   "end": 364.02,
   "text": "اینکه میگه هر نگاه به نامحرم تیری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.02,
   "end": 366.62,
   "text": "از شیطان، این یه وجهشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.62,
   "end": 374.84,
   "text": "تیر پرتاب شده و از مکانی نزدیک به سوی شما پرتاب نبوده است و گفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.84,
   "end": 379.82,
   "text": "ادعای شیطان، پروردگارا، به این جهت که مرا اغوا کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.82,
   "end": 384.74,
   "text": "همان که گفت این ملعون \"رب بما اغویتنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.74,
   "end": 388.36,
   "text": "لأزينن لهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.36,
   "end": 390.42,
   "text": "براشون زینت می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.42,
   "end": 394.42,
   "text": "داره اشاره به همون فرمایش می‌کنه مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.42,
   "end": 403.74,
   "text": "که چون که منو اغوا کردی زرق و برق زندگی دنیا را در چشم آنها جلوه می‌دهم و همه را اغوا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.74,
   "end": 407.74,
   "text": "زرق و برق زندگی دنیا خیلی باید مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.74,
   "end": 412.5,
   "text": "حالا کسایی که خیلی مراقب‌اند، دامن‌شون رو جمع می‌کنن، به مقام خشوع می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.5,
   "end": 414.98,
   "text": "اون‌ها یه طور، دیگران یه طور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.98,
   "end": 419.44,
   "text": "ولی همه در معرضیم. یادم میاد حالا متاسفانه هرچی فکر کردم اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.44,
   "end": 421.94,
   "text": "اسم اون عالم یادم نیست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.94,
   "end": 424.94,
   "text": "کبار علمای شیعه و امامیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.94,
   "end": 428.94,
   "text": "که در هم ردیف‌های مثلاً سید ابن طاووس اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.94,
   "end": 431.7,
   "text": "یه همچین شخصیتی رو در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.7,
   "end": 435.06,
   "text": "ایشون می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.06,
   "end": 438.8,
   "text": "از اساتیدمون شنیدیم اسمشون از خاطرم متاسفانه رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.8,
   "end": 442.0,
   "text": "که با شیطان مباحثه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.0,
   "end": 446.06,
   "text": "شیطان، شیطان رو می‌بینه و شروع می‌کنه مباحثه کردن بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.06,
   "end": 450.48,
   "text": "جدل بلند می‌گیره و وجادلهم بالتي هي احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.48,
   "end": 453.68,
   "text": "بعد این میگه مثلاً ملعون چرا تو سجده نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.68,
   "end": 456.2,
   "text": "اون دلیل میاره این خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.2,
   "end": 458.84,
   "text": "آخر سر که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.84,
   "end": 460.82,
   "text": "صحبت‌های شیرینی هم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.82,
   "end": 464.64,
   "text": "خیلی خیلی من یادم اون موقع برام خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.64,
   "end": 466.64,
   "text": "بعد آخر سر شیطان مغلوب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.64,
   "end": 471.82,
   "text": "مغلوب دست این عالم شیعی می‌شه و جوابی دیگه نداره بگه از جهت علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.82,
   "end": 480.82,
   "text": "درست شد؟ بعد که می‌خواد بره شیطان میگه یه دقیقه صبر کن ولی برنده این مجادله و مباحثه من بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.82,
   "end": 483.34,
   "text": "میگه رو چه حساب میگی خبیث؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.34,
   "end": 489.94,
   "text": "میگه چون همین مقداری که مشغول مباحثه با من بودی از عمرتو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.94,
   "end": 492.9,
   "text": "شما نگاه کنید از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.9,
   "end": 495.5,
   "text": "اینطوری عمرشو می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.5,
   "end": 498.8,
   "text": "از من و شما هرکی نسبت به صحنه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.8,
   "end": 501.6,
   "text": "یعنی انقدر قصه جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.6,
   "end": 505.34,
   "text": "نمیدونم حالا این حکایتو تا حالا شنیده بودید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.34,
   "end": 507.64,
   "text": "حالا یا همون کتابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.64,
   "end": 510.12,
   "text": "نوشت در رابطه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.12,
   "end": 515.04,
   "text": "راه‌های کنترل نفوذ شیطان یا شیطان شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.04,
   "end": 520.16,
   "text": "خدا حفظ کنه حضرت آقای مظاهری اصفهان محضرشون بودیم استاد عزیزانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.16,
   "end": 523.9,
   "text": "استاد نه یعنی ما شاگردش بودیم منظور استاد بودن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.9,
   "end": 529.88,
   "text": "والا ما شاگرد هیچ‌کدوم از اینا نبودیم و به گرد پای شاگرداشون نخواهیم رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.88,
   "end": 532.94,
   "text": "ادعایی نشه. این استاد کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.94,
   "end": 538.56,
   "text": "فرمودم که. حالا ایشونم یه کتاب دارن به نام راه‌های کنترل نفوذ شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.56,
   "end": 545.42,
   "text": "بعد شیطان رو که دید صاحب این کتاب گفت دیدی پوزتو به خاک مالوندم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.42,
   "end": 549.78,
   "text": "یه کتاب نوشتم شیطان شناسی همه بشناسنت چه دغلی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.78,
   "end": 555.6,
   "text": "گفت برو باباجون من خودم وسوسه ات کردم این کتابو بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.6,
   "end": 558.46,
   "text": "اینا برای کسایی که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.46,
   "end": 561.66,
   "text": "حواسشون نیست، ذره‌بین دستشون نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.66,
   "end": 565.08,
   "text": "اینا یه مقدار سخت جا افتادنش یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.08,
   "end": 568.02,
   "text": "ولی یه مقدار خود نگهداری که بالا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.02,
   "end": 570.98,
   "text": "طهارت نفس زیاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.98,
   "end": 575.44,
   "text": "اون موقع حسنات الأبرار سیئات المقربین که براش پیاده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.44,
   "end": 579.58,
   "text": "میبینه راست میگه. اصلا نباید مباحثه باهاش می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.58,
   "end": 582.48,
   "text": "گفت برو مثلا کاری با تو ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.48,
   "end": 585.58,
   "text": "حسنات الأبرار سیئات المقربین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.58,
   "end": 588.78,
   "text": "خیلی قصه جدیه. حالا نکته آخری که می‌خوام بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.78,
   "end": 591.44,
   "text": "البته خودش چند تا منبر می‌خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.44,
   "end": 596.26,
   "text": "یه چند تا اشاره کوچولو بکنم فرصتم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.26,
   "end": 601.44,
   "text": "که خیلی در این رابطه حرف‌ها دوست داشتم بشه پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 601.44,
   "end": 604.34,
   "text": "کجاها شیطان دستش بسته است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 604.34,
   "end": 611.6,
   "text": "بالاخره یه جاهایی هست که خدا دیده به ما رحم کرده گفته خب باشه زورت نمی‌رسه اگرچه تو رو از اون قوی‌تر خلق کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.6,
   "end": 616.22,
   "text": "قرآن میگه کیش ضعیفه. اما باشه یه جاهایی دستشو می‌بندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.22,
   "end": 619.04,
   "text": "یه زمان‌هایی و مکان‌هایی دستشو می‌بندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.04,
   "end": 621.34,
   "text": "یکیشو که همه می‌دونید ماه مبارک رمضانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.34,
   "end": 628.82,
   "text": "درسته؟ اینو همه میدونن. یکی دیگه از جاها اتفاقاً طبق روایات نشون میده بیشتر دستش بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 628.82,
   "end": 631.8,
   "text": "همین دهه‌ای که الان روز دومشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.8,
   "end": 635.16,
   "text": "دهه اول ماه ذی الحجه که آخرین ماه قمریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 635.16,
   "end": 638.4,
   "text": "بعد محرم شروع می‌شه. اون ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 638.4,
   "end": 640.94,
   "text": "معدودات که قرآن میگه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 640.94,
   "end": 648.36,
   "text": "و-- ولفجر قسم می‌خوره خدا به فجر ولیالی عشر قسم می‌خوره خدا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.36,
   "end": 650.88,
   "text": "شب‌های ده گانه همین ده شبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.88,
   "end": 653.68,
   "text": "طبق بعضی از روایات همین ده شبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.68,
   "end": 656.76,
   "text": "یه روایت دیدم که اتفاقاً آقا مجتهد تهرانی روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 656.76,
   "end": 661.06,
   "text": "ایشون می‌فرمودند که اگر به همین یه روایت استن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.06,
   "end": 668.74,
   "text": "استناد کنیم و اون روایتی که در ماه مبارک رمضان فرموده اگر کسی بخشیده نشد در ماه رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 668.74,
   "end": 672.72,
   "text": "فقط امیدش روز عرفه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.72,
   "end": 677.38,
   "text": "بعضیا حرف آقا مجتهد بود، بعضیا به همین‌ها استناد کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.38,
   "end": 681.64,
   "text": "که این ده روز می‌تونه از ماه رمضان بالاتر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.64,
   "end": 684.64,
   "text": "کدوم روایته؟ یکی این که الان عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.64,
   "end": 686.64,
   "text": "یعنی تو ماه رمضان بخشیده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 686.64,
   "end": 688.96,
   "text": "بدبخت و شقیه اما روز عرفه امید هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 688.96,
   "end": 691.4,
   "text": "بعد آقا مجتهد می‌فرمود که این منظور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 691.4,
   "end": 696.66,
   "text": "صحرای عرفات نیست، ظرفیت روز عرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 696.66,
   "end": 699.26,
   "text": "اونم دومین روایتم که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 699.26,
   "end": 706.16,
   "text": "خدا در هیچ ایامی بهتر از این دهه عبادت نشده و نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 706.16,
   "end": 709.96,
   "text": "یعنی انقدر مهمه عبادت اینجا تو این ده شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 709.96,
   "end": 713.18,
   "text": "بعد اونجا می‌فرماید و لیالی عشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 713.18,
   "end": 716.68,
   "text": "شب‌ها. این ده شب و روزه چرا لیل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.68,
   "end": 720.14,
   "text": "سرش رو در لیله قدر جستجو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 720.14,
   "end": 722.86,
   "text": "ان انزلناه فی لیلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 722.86,
   "end": 727.58,
   "text": "لیله همه بزرگ-- بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.58,
   "end": 733.04,
   "text": "با استناد به اهل بیت فرمودند لیله حضرت زهراست سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.04,
   "end": 738.17,
   "text": "و اینکه چرا شب حرف‌های عالی پیاده کردن بمانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 738.17,
   "end": 742.03,
   "text": "چرا؟ به شب خورده. قصه حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 742.03,
   "end": 743.81,
   "text": "و قدر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 743.81,
   "end": 746.81,
   "text": "ليلة القدر میشه زهرای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 746.81,
   "end": 749.31,
   "text": "که ظرف نزول قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 749.31,
   "end": 753.71,
   "text": "اونجا لیالی، لیالی عش شب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 753.71,
   "end": 758.35,
   "text": "یه سری هست، یه ارتباطی بین این ده و حضرت زهرا وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 758.35,
   "end": 762.03,
   "text": "اینا رو من دارم سریع رد میشم میگم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 762.03,
   "end": 766.71,
   "text": "یه نکته آخر رو هم بگم که هرکی گرفت نوش جونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 766.71,
   "end": 772.33,
   "text": "يوم عزیزان در فلسفه و حکمت و عرفان بهش میگن ظرف ظهور اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 772.33,
   "end": 775.91,
   "text": "يوم ظرف مثلا میگن کل يوم هو في شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.91,
   "end": 778.85,
   "text": "در هر يومی هو ال هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 778.85,
   "end": 780.79,
   "text": "اون الله هو في شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 780.79,
   "end": 786.23,
   "text": "توی شأن و تجلی خاصیه که قبلا خیلی درباره‌ش حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.23,
   "end": 789.09,
   "text": "يوم پس ظرف ظهور اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.09,
   "end": 792.21,
   "text": "وقتی میگه يوم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 792.21,
   "end": 798.45,
   "text": "ایام معدودات یعنی این ده شبانه روز، ده شبانه روز الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 798.45,
   "end": 802.19,
   "text": "یعنی چی؟ اگر بگیریم ظرف ظهور اشیا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 802.19,
   "end": 805.63,
   "text": "چون يوم الله ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 805.63,
   "end": 809.49,
   "text": "الله پس میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 809.49,
   "end": 812.69,
   "text": "ظرف ظهور الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 812.69,
   "end": 817.45,
   "text": "یعنی خدا تجلی داره میکنه، ظهور میکنه توی این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.45,
   "end": 822.03,
   "text": "هر چقدر که جایگاه این ایام بالاتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 822.03,
   "end": 824.33,
   "text": "ظهور حق اونجا آشکارتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 824.33,
   "end": 827.79,
   "text": "مثل شما خورشید به نظر بگیرید تجلیش همه جاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 827.79,
   "end": 831.61,
   "text": "از هر طرف یه شکله. به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.61,
   "end": 833.87,
   "text": "شدت و حدت تجلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.87,
   "end": 839.81,
   "text": "اما نسبت به اینکه به کجا برخورد کنه این نور یا تاریکی ایجاد میکنه یا نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 839.81,
   "end": 847.57,
   "text": "اگه شما جلوش یه مانع بگیری جلوی خورشید، سایه میندازه، تاریکی ایجاد میکنه، مانع رو بردار شدت نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 847.57,
   "end": 850.47,
   "text": "باز به خورشید ربط نداره. یعنی خدا آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 850.47,
   "end": 855.71,
   "text": "آن در حال تجلیه. اما به سعه وجودی‌ها ربط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 855.71,
   "end": 863.27,
   "text": "اینکه این زمان، این مکان، این شخص، این فرد چقدر ظرفیت داره که خدا درش تجلی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 863.27,
   "end": 868.19,
   "text": "اینکه میگه عبادت هیچ کجا به اندازه این ده شبانه روز نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 868.19,
   "end": 875.99,
   "text": "یعنی شدت ظهور خدا در این ظرف ظهور در این ده شبانه روز از هر شبانه روزی بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 875.99,
   "end": 879.33,
   "text": "یعنی خلاصشو حسیشو همه فهمشو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 879.33,
   "end": 885.59,
   "text": "خدا کأنت في این ده شبانه روز از هر شبانه روز دیگری به بنده‌ش نزدیک‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 885.59,
   "end": 888.57,
   "text": "قابل درک‌تره، قابل دسترسی‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 888.57,
   "end": 894.13,
   "text": "راحت‌تر میشه ارتباط گرفت از سر وجودی این ده شب که حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 894.13,
   "end": 899.07,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 899.07,
   "end": 903.89,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 903.89,
   "end": 905.17,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}