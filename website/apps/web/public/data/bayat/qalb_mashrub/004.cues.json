 "chapters": [
  {
   "index": 0,
   "title": "## عید غدیر؛ عیدالله اکبر و نصب امامت در دنیا و آخرت",
   "start": 12.94,
   "end": 221.72
  },
  {
   "index": 1,
   "title": "## توجه به امام؛ دعای توسل و استدلال علامه حلی",
   "start": 221.72,
   "end": 539.24
  },
  {
   "index": 2,
   "title": "## حب الهی، توجه متقابل و رفع اضطراب",
   "start": 539.24,
   "end": 689.0
  },
  {
   "index": 3,
   "title": "با ذکر الله دل‌ها به اطمینان می‌رسد و اضطراب برداشته می‌شود. از آن سو فرمود:",
   "start": 689.0,
   "end": 710.36
  },
  {
   "index": 4,
   "title": "## تحریف معنای مولا و تأکید بر وصی",
   "start": 710.36,
   "end": 830.56
  },
  {
   "index": 5,
   "title": "## استاد هادی شیرازی؛ تمیز خبیث از طیب",
   "start": 830.56,
   "end": 965.36
  },
  {
   "index": 6,
   "title": "## یک نظر پیر؛ خوپذیری نفس و مثال زغال",
   "start": 965.36,
   "end": 1112.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 7.12,
   "text": "و بهین هسته. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.12,
   "end": 10.58,
   "text": "آیاته. سلام علیکم و رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.58,
   "end": 17.5,
   "text": "الله. الحمد لله الذي جعلنا من المتمسکین بولایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.5,
   "end": 23.7,
   "text": "امیر المؤمنین علی ابن ابی طالب علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.7,
   "end": 25.82,
   "text": "تبریک و تهنیت عرض می‌کنم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.82,
   "end": 30.14,
   "text": "عید بسیار با عظمت و بی‌نظیر رو که عید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.14,
   "end": 33.6,
   "text": "اکبر است. با توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.6,
   "end": 37.62,
   "text": "شب مبارک و پربرکت عید غدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.62,
   "end": 40.72,
   "text": "و اینکه سلسله بحثمون هم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.72,
   "end": 45.12,
   "text": "قلب مشروب قطع نشه، ما دو تا بحث رو در هم توأمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.12,
   "end": 47.8,
   "text": "ارائه میدیم. فرمایشی رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.8,
   "end": 51.88,
   "text": "رهبر عزیزمون قطعا شنیدید پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.88,
   "end": 55.66,
   "text": "علت عید الله اکبر بودن غدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.66,
   "end": 58.06,
   "text": "چند تا وجه رو ایشون می‌شمرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.06,
   "end": 61.34,
   "text": "مهم‌ترین وجه رو می‌فرماین این هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.34,
   "end": 66.02,
   "text": "عین سخن مبارک ایشون اینه که غدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.02,
   "end": 69.84,
   "text": "یک جنبه‌اش نصب امامت هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.84,
   "end": 74.36,
   "text": "یعنی پیشوایی این خانواده در امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.36,
   "end": 81.22,
   "text": "آخرت و دنیا. او امام هست دیگه، پیشواس، جلودار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.22,
   "end": 85.34,
   "text": "ما مأمومیم. ما به او اقتدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.34,
   "end": 88.9,
   "text": "اینجا نکته‌ای که رهبر تصریح دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.9,
   "end": 93.2,
   "text": "می‌فرماین که هم در امر آخرت هم امر دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.2,
   "end": 95.66,
   "text": "چون می‌دونید اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.66,
   "end": 100.22,
   "text": "رشوه دادن، تطمیع کردن مردم رو نانجیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.22,
   "end": 102.3,
   "text": "گفتن خلافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.3,
   "end": 106.54,
   "text": "باطنی با امیرالمؤمنین یعنی امر آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.54,
   "end": 109.86,
   "text": "که الان هم در گوش میت‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.86,
   "end": 114.54,
   "text": "میرن میگن حق با علی بودا وقت موت، وقت دفنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.54,
   "end": 118.58,
   "text": "این کارو می‌کنن. و خلافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.58,
   "end": 123.58,
   "text": "ظاهری یعنی در دنیا، سیاست، تمدن اینا با ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.58,
   "end": 128.94,
   "text": "یه همچین کاری کردن، یه اختلافی انداختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.94,
   "end": 132.64,
   "text": "که همش نتیجه‌ش شد این همه اختناق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.64,
   "end": 136.62,
   "text": "نفاق و خونریزی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.62,
   "end": 140.5,
   "text": "و متاسفانه به قهر قرار رفتن ملت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.5,
   "end": 143.62,
   "text": "رهبر عزیزمون می‌فرمود که این امامت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.62,
   "end": 146.74,
   "text": "نصب امامت در عید غدیر اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.74,
   "end": 149.58,
   "text": "اونم هم در امر دنیا هم آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.58,
   "end": 155.6,
   "text": "یعنی علی دیگه میشه ترازو، دیگه میشه میزان، دیگه میشه محک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.6,
   "end": 160.34,
   "text": "یعنی امشب یا به عبارتی فردا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.34,
   "end": 163.7,
   "text": "این شب عزیز، این روز مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.7,
   "end": 166.8,
   "text": "جدا کننده‌ی بین حق و باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.8,
   "end": 169.24,
   "text": "هرکس در صف غدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.24,
   "end": 171.7,
   "text": "با حقه. مع الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.7,
   "end": 174.32,
   "text": "هرکس که نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.32,
   "end": 178.34,
   "text": "مقابل حقه. دیگه بینش رو ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.34,
   "end": 180.4,
   "text": "این نکته بسیار مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.4,
   "end": 183.8,
   "text": "اصلاً از همین جهت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.8,
   "end": 187.36,
   "text": "عید الله اکبر، نصب امامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.36,
   "end": 192.66,
   "text": "که اگر این نبود همه متحیر بودن، حیران بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.66,
   "end": 196.34,
   "text": "از سرگشتگی ما را نجات داد پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.34,
   "end": 198.02,
   "text": "در یه همچین روز مبارکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.02,
   "end": 203.52,
   "text": "لذا میگه حمد کن. چه شیرین که میگه هر مؤمنی رو دیدی بگو الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.52,
   "end": 208.52,
   "text": "لله الذي جعلنا من المتمسکین بولایه امیر المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.52,
   "end": 212.72,
   "text": "سرش در چیه؟ یعنی اینکه دیگه من و شما دیگه حیران نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.72,
   "end": 214.98,
   "text": "حمد، حمد و ثفاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.98,
   "end": 217.96,
   "text": "که او شد الگوی ما، جلودار ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.96,
   "end": 221.72,
   "text": "و مورد توجه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.72,
   "end": 227.86,
   "text": "معمولا ما در حیث چه امور دنیوی و اخرویمون میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.86,
   "end": 232.04,
   "text": "آقا به ما توجه کن. درسته، درست هم هست، غلط نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.04,
   "end": 234.12,
   "text": "آقا باید به ما توجه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.12,
   "end": 236.72,
   "text": "امیرالمؤمنین باید امشب به ما توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.72,
   "end": 242.74,
   "text": "اما چرا در دعای توسل در شروع تو-- اون توسل مبارکی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.74,
   "end": 248.18,
   "text": "شیخ عباس قمی فرمودن \"من نخواندم در امری مگر اینکه نتیجه گرفتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.18,
   "end": 250.68,
   "text": "همین دعای توسل معمولی رو حفظ کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.68,
   "end": 253.0,
   "text": "هر روز که دارین میاد اداره تو راه بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.0,
   "end": 255.28,
   "text": "ده دقیقه طول می‌شه. خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.28,
   "end": 261.56,
   "text": "چرا اولش میگه اللهم انی اسألك و اتوجه الیک، من توجه می‌کنم به تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.56,
   "end": 266.18,
   "text": "اتوجه الیک بنبيك یعنی به وساطت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.18,
   "end": 272.0,
   "text": "توجه به تو می‌کنم. به‌خاطر اینکه اون محکه، اون میزانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.0,
   "end": 274.98,
   "text": "اون جدا کننده بین حق و باطله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.98,
   "end": 278.36,
   "text": "که اگر امیرالمؤمنین علیه الصلاة والسلام نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.36,
   "end": 280.8,
   "text": "این دیگه پیدا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.8,
   "end": 285.1,
   "text": "یعنی همه متحیر بودن. اصلاً فلسفه خلقت می‌رفت زیر سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.1,
   "end": 287.68,
   "text": "چگونه است که خدا رحمت کنه مرحوم علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.68,
   "end": 290.24,
   "text": "حلی رو چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.24,
   "end": 300.02,
   "text": "کتاب شریفشون اه ش-- می‌فرمود که چگونه است که پیغمبر عزیز عالم پیرامون جزئی‌ترین شؤونات حتی پست بشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.02,
   "end": 303.88,
   "text": "مثل تخلی، پست‌ترین شؤونات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.88,
   "end": 305.8,
   "text": "بشر دستور العمل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.8,
   "end": 309.48,
   "text": "چقدر دستورات مستهبات، مکروهات، واجبات اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.48,
   "end": 312.78,
   "text": "بعد در خصوص مهم‌ترین موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.78,
   "end": 316.46,
   "text": "مورد نیاز جامعه بشری که زعامت امته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.46,
   "end": 318.7,
   "text": "حرف نزده باشه؟ مگه میشه همچین چیزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.7,
   "end": 323.24,
   "text": "این حرف فرمایش علامه حلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.24,
   "end": 330.92,
   "text": "که قریبه به دو هزار دلیل میاره برای حقانیت امیرالمؤمنین در کتابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.92,
   "end": 334.2,
   "text": "اینجا یعنی که اول تو باید متوجه امام باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.2,
   "end": 342.48,
   "text": "اصلاً اینکه پیغمبر دست یا بازو یا کتف مولا رو می‌گیره و میگن مولا رو از زمین میکنه بلند میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.48,
   "end": 346.46,
   "text": "که به همه نشون بده، یه کار عجیبی میکنه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.46,
   "end": 351.18,
   "text": "یعنی انقدر که مهمه با تمام قوا مولا رو از زمین بلند میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.18,
   "end": 357.1,
   "text": "نه فقط دستشون رو. یعنی اینکه دیگه از اینجا به بعد توجه شما به این آقا باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.1,
   "end": 360.0,
   "text": "شما باید متوجه به این آقا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.0,
   "end": 362.78,
   "text": "خب با بغضتون بر اساس او تأمین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.78,
   "end": 364.86,
   "text": "به قول اساتید عزیز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.86,
   "end": 368.0,
   "text": "اصلاً عید غدیر عود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.0,
   "end": 369.82,
   "text": "عید یعنی عود، برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.82,
   "end": 372.08,
   "text": "عود است به پدر اصلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.08,
   "end": 374.72,
   "text": "به آل الله، به انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.72,
   "end": 380.72,
   "text": "که همه‌ی آنچه که جهت‌گیری داری، حب و بغضت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.72,
   "end": 385.18,
   "text": "همشو و همش رو با او بسنجی، با او تنظیم کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.18,
   "end": 387.7,
   "text": "که اگر او رو ورداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.7,
   "end": 391.18,
   "text": "دیگه تمیزی نمیشه قائل شد بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.18,
   "end": 397.64,
   "text": "مشرک و منافق و مسلمون و کافر و اصلاً دیگه اصلاً معنا پیدا نمی‌کنه اگر او نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.64,
   "end": 401.7,
   "text": "برای همین میگه حمد کن، حمد کن، تک-- این همه ما داریم مؤمن می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.7,
   "end": 404.98,
   "text": "ها؟ میگه هرکیو دیدی حمد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.98,
   "end": 407.5,
   "text": "حالا نمی‌خواد بلند هم بگی روت نوشته تو دلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.5,
   "end": 411.9,
   "text": "الحمد لله الذي جعلنا من المتمسکین بولایت امیر المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.9,
   "end": 417.78,
   "text": "سر درش دیگه. یعنی بدون توجه داشته باش این نعمت چقدر نعمت بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.78,
   "end": 420.12,
   "text": "حالا ربطش به قلب مشروب چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.12,
   "end": 424.52,
   "text": "تو اون آیه که \"اشربوا فی قلوبهم العجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.52,
   "end": 429.36,
   "text": "بکفرهم\" عرض کردیم که در غیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.36,
   "end": 434.96,
   "text": "حضرت موسی توجهشون به خلیفه نرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.96,
   "end": 439.56,
   "text": "و \"قال موسی لاخیه هارون اخلفنی فی قومی\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.56,
   "end": 441.4,
   "text": "تو خلیفه منی، جانشین منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.4,
   "end": 446.56,
   "text": "اینا توجه به خلیفه نکردند اون بلا سرشون-- کارشون به گوساله پرستی کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.56,
   "end": 452.68,
   "text": "توجه کردی چی شد؟ اگر ما متوجه انسان کامل نباشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.68,
   "end": 457.7,
   "text": "از خلیفه که امشب و فردا پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.7,
   "end": 464.12,
   "text": "به رخ جهانیان می‌کشد و او رو وسی خودش معرفی می‌کنه، کارمون به گوساله پرستی می‌کشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.12,
   "end": 467.98,
   "text": "به پست پرستی، به نژادپرستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.98,
   "end": 470.18,
   "text": "به پول‌پرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.18,
   "end": 474.08,
   "text": "عذر می‌خوام به شهوت‌پرستی، به مقام‌پرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.08,
   "end": 479.58,
   "text": "اگر علی تراز، محک، میزان و جلودار و امام نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.58,
   "end": 483.98,
   "text": "خیلی موضوع مهمی اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.98,
   "end": 487.54,
   "text": "اصلاً اینکه خدا می‌فرماید \"ونفخت فیهم روحی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.54,
   "end": 490.78,
   "text": "من از روح خودم دمیدم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.78,
   "end": 495.74,
   "text": "انسان. انسان در وجود خودش ظرفیتی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.74,
   "end": 500.84,
   "text": "که می‌تواند الهی بشود چون روح الهی درش دمیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.84,
   "end": 503.6,
   "text": "خب این روح الهی از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.6,
   "end": 508.58,
   "text": "از عالم بالا اومده. امیرالمؤمنین رفته دیگه منتهی الیه عالم بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.58,
   "end": 510.6,
   "text": "می‌خوای هرچی اسمشو بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.6,
   "end": 514.14,
   "text": "اون بالاترین‌ها که صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.14,
   "end": 516.94,
   "text": "یعنی همه روح رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.94,
   "end": 519.26,
   "text": "یک بخشیش هم به تو بخشیده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.26,
   "end": 520.94,
   "text": "و تو باید از اون استفاده کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.94,
   "end": 524.72,
   "text": "در ما ظرفیت خلیفة الله شدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.72,
   "end": 526.4,
   "text": "ولی الله شدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.4,
   "end": 528.98,
   "text": "ما از اون بهره نبردیم. چگونه هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.98,
   "end": 538.8,
   "text": "وقتی علی حضرت وسی امام تو باشه، جلودار تو باشه و تو اول توجه کنی به امامت که او متوجه به تو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.8,
   "end": 541.98,
   "text": "درسته از حیث عرفانی چون یک اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.98,
   "end": 546.26,
   "text": "اول میگه خدا اینا رو دوست داره \"یحبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.26,
   "end": 549.82,
   "text": "تو قرآن می‌فرماید خدا اینا رو دوست داره و \"يحبونه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.82,
   "end": 555.68,
   "text": "اون‌ها هم خدا رو دوست دارن. اما چون اول مقدم دوستی خدا بر بندگانش اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.68,
   "end": 558.46,
   "text": "میگه دوستی تو بین دو تا دوستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.46,
   "end": 560.94,
   "text": "مثل اینکه توبه تو بین دو تا توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 560.94,
   "end": 567.26,
   "text": "اول خدا توبه می‌کنه به سمت تو تا تو توبه کنی بعد دوباره توبه می‌کنه به سمت تو که توبتو قبول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.26,
   "end": 570.64,
   "text": "توجه هم این چنینه. اول او به ما متوجه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.64,
   "end": 574.94,
   "text": "به ما این عنایت رو می‌کنه که بتونیم متوجه امام باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.94,
   "end": 577.68,
   "text": "توجه کردی؟ اون همه رو دعوت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.68,
   "end": 584.44,
   "text": "به من می‌گن آقا واقعاً کسی میره کربلا چیه قصه مثلاً قسمته چیه مشیته، طلبه، دعوته هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.44,
   "end": 590.76,
   "text": "میگم آقا امام حسین همه رو دعوت کرده نه فقط من و شما رو که همه عالم رو دعوت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 590.76,
   "end": 594.78,
   "text": "حالا کی اجابت کنه؟ کی توجه کنه به امام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 594.78,
   "end": 599.9,
   "text": "اگر توجه از تو حاصل شد، توجه بعدی از امام میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.9,
   "end": 602.48,
   "text": "همینطوری ضریب می‌خوره. قصه اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.48,
   "end": 605.08,
   "text": "می‌شه نظر. یعنی اگر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.08,
   "end": 607.16,
   "text": "توجه کردی به امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.16,
   "end": 609.48,
   "text": "امام به تو نظر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 609.48,
   "end": 615.84,
   "text": "آخر نوتبچی میگی \"فنظر الینا نظرة رحیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.84,
   "end": 617.8,
   "text": "اون نظره رحیمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 617.8,
   "end": 619.56,
   "text": "بعد از توجه ما به امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.56,
   "end": 621.78,
   "text": "اصطلاحا می‌شیم توجه عرفانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 621.78,
   "end": 624.82,
   "text": "نه فقط بریم دوای توسلی به سنگ و چوبی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 624.82,
   "end": 627.72,
   "text": "حرمشون زیارت کنیم بیاییم. یعنی اصلاً او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 627.72,
   "end": 629.44,
   "text": "امام ماست، پیشوای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 629.44,
   "end": 632.06,
   "text": "همه حرف همینه‌ها که رهبر فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 632.06,
   "end": 635.96,
   "text": "در امر دنیا و آخرت مطلقاً اون امام ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.96,
   "end": 640.18,
   "text": "اون هم انسان کامله. اصلاً اطمینان اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.18,
   "end": 642.72,
   "text": "الان مریضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 642.72,
   "end": 644.82,
   "text": "غالب نوع بشر به نظرتون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.82,
   "end": 647.62,
   "text": "اضطرابه، استرسه به قول امروزی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.62,
   "end": 651.06,
   "text": "ها؟ پریشانیه، حیرانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.06,
   "end": 654.2,
   "text": "همه این‌ها در عدم توجه به انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.2,
   "end": 656.74,
   "text": "چون ما ضعیفیم، ناقصیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.74,
   "end": 660.7,
   "text": "به اونکه کامله و قویه، شدید القواست توجه نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.7,
   "end": 664.5,
   "text": "همش در پی اینه. توجه به امیرالمؤمنین یعنی اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.5,
   "end": 672.8,
   "text": "اصلاً مگر قرآن نفرمود \"الا بذكر الله تطمئن القلوب\" با ذکر الله دل‌ها به اطمینان می‌رسه، اضطراب برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.8,
   "end": 679.28,
   "text": "بله از اون طرف فرمود \"من اعرض عن ذکری الا بذكر الله\" اینجام \"عن ذکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.28,
   "end": 684.26,
   "text": "فان له معیشة ضنكا ونحشره يوم القيامة اعمى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.26,
   "end": 685.98,
   "text": "معیشت زنگ گرفتار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.98,
   "end": 689.0,
   "text": "زنگ معیشتی. بعد قیامت نابینا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 689.0,
   "end": 692.48,
   "text": "کسی که غافل بشه، پشت کنه به ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 692.48,
   "end": 695.1,
   "text": "\"من اعرض عن ذکری\" به ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.1,
   "end": 700.76,
   "text": "اینجا تفاسیر شیعه به نقل از ائمه معصومین علیهم السلام همه آوردن که این \"ذکری\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.76,
   "end": 707.86,
   "text": "یعنی ذکرنا یعنی ذکر ما یعنی ذکر انسان کامل یعنی ذکر امیرالمؤمنین علی حضرت وسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 707.86,
   "end": 710.36,
   "text": "که ما متأسفانه از این حضرت وسی غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 710.36,
   "end": 713.9,
   "text": "جمعه عرض کردم در شرح مسائل سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 713.9,
   "end": 718.12,
   "text": "که همه میگیم \"من کنت مولا فقط علی مولا به حق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 718.12,
   "end": 720.94,
   "text": "ولی یه عده سنی‌ها هم چیکارش می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 720.94,
   "end": 723.94,
   "text": "این رو تحریفش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 723.94,
   "end": 728.74,
   "text": "میگن منظور اینجا اینه که هرکس منو دوست داره علی رو دوست داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 728.74,
   "end": 733.02,
   "text": "قریب به هجده تا معنا به مولا دادن اینو برداشتشون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 733.02,
   "end": 737.0,
   "text": "یعنی محبت. یعنی سه روز پیغمبر تو آفتاب گرم همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 737.0,
   "end": 740.36,
   "text": "نگه داره همه رو گرم که بگه هر کی منو دوست داره این آقا رو دوست داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 740.36,
   "end": 744.06,
   "text": "اینه واقعا؟ سرپرستی باید از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 744.06,
   "end": 749.86,
   "text": "توجه را چون توجه به این پیام خطبه غدیر نداریم که فرمود وسیع من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 749.86,
   "end": 755.88,
   "text": "علی است. وسیع یعنی دیگه فاصله‌ای بین پیغمبر و او نیست و شما این فاصله رو انداختید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 755.88,
   "end": 760.24,
   "text": "لذا حضرت استاد علامه حسن زاده علیه الرحمه همیشه می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.24,
   "end": 765.52,
   "text": "بگید حضرت وسیع. بگید مولا، بگید امیرالمؤمنین اما حضرت وسیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 765.52,
   "end": 770.22,
   "text": "اینو تأکید کنید. که حالا او باید به ما نظر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.22,
   "end": 777.12,
   "text": "اگر نظر کنه، نظره آقا در پس توجه ما به انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.12,
   "end": 780.2,
   "text": "قرار بگیره، به ما بیفته دیگه همه گره‌ها باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 780.2,
   "end": 784.82,
   "text": "اطمینان میاد، نشاط میاد، سرور میاد، فرح میاد، بهجت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.82,
   "end": 786.56,
   "text": "اصلا دغدغه ها برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 786.56,
   "end": 788.68,
   "text": "آدم از بند تعلق آزاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 788.68,
   "end": 792.8,
   "text": "استقلال میاد، آزادی میاد، شجاعت میاد، نترسی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 792.8,
   "end": 798.4,
   "text": "سیاستمداران ما دیگه میرن تو گفت و گوی تمدنی نه تو گفت و گو انفعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 798.4,
   "end": 801.08,
   "text": "صرفا برن از رو ترس و رعب که بخوان یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.08,
   "end": 806.0,
   "text": "مثلا امتیازی بگیرن بلکه یه گفت و گویی بکنن که اون اصلا گفت‌وگو نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 806.0,
   "end": 809.3,
   "text": "گفت و گفته. به قول اساتید ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 809.3,
   "end": 813.84,
   "text": "هی میگن، میگن. اون گفت خب حالا تو هم بگو گفت‌وگو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 813.84,
   "end": 819.98,
   "text": "نمیشه که. اگر علی علیه الصلاة والسلام جلو، جلو دار باشه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 819.98,
   "end": 822.62,
   "text": "دیپلماسی انفعالی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 822.62,
   "end": 826.24,
   "text": "دیپلماسی تمدنی با قدرت، با شجاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 826.24,
   "end": 830.26,
   "text": "یعنی مقاومت. یه فرمایشی هم خدا رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 830.26,
   "end": 833.44,
   "text": "من توصیه می‌کنم آثار حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.44,
   "end": 837.78,
   "text": "استاد هاوری شیرازی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 837.78,
   "end": 841.12,
   "text": "دقت کنید. خیلی نو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 841.12,
   "end": 844.92,
   "text": "واقعا بصیرت عمیق. بیخود نبود رهبر عزیزمون ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 844.92,
   "end": 850.66,
   "text": "بعد از ارتحال بزرگان اهل معرفت در تهران از جمله آقای حق شناس و دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 850.66,
   "end": 852.8,
   "text": "از ایشون دعوت کردن بیان جای پا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 852.8,
   "end": 854.66,
   "text": "خالی این‌ها رو پر کنن در تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 854.66,
   "end": 859.64,
   "text": "از شیراز ایشون اومدن تهران. متأسفانه خب چهارشنبه‌ها در شهرک محلاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 859.64,
   "end": 861.86,
   "text": "اینجا برنامه داشتن. بعد دیگه به رحمت حق رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 861.86,
   "end": 868.14,
   "text": "آقا یکی از جملات بسیار عالی ایشون که به نظر بنده از افاضات حضرت حق به اوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 868.14,
   "end": 872.02,
   "text": "وقتی که خبرنگاران اتریشی میان ازش سؤال می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 872.02,
   "end": 876.3,
   "text": "آقا ما خب شما انقلاب کردید، این همه از سال از انقلاب گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 876.3,
   "end": 881.0,
   "text": "و ما می‌بینیم که جوانان دارن از انقلاب گریزان می‌شن، رو برمی‌گردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 881.0,
   "end": 883.02,
   "text": "شما تأیید می‌کنید حرف ما رو یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 883.02,
   "end": 887.58,
   "text": "ایشون اشاره می‌کنه به اون حدی-- آیه شریفه \"ل یمیز الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 887.58,
   "end": 890.62,
   "text": "الخبیث من الطيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 890.62,
   "end": 893.5,
   "text": "خدا مثلا این قاعده الهیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 893.5,
   "end": 898.64,
   "text": "می‌خواد ممتاز کنه، جدا کنه خبیث و طيبو از هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 898.64,
   "end": 904.0,
   "text": "بعد ایشون می‌فرماید آقا ما انقلاب رو چنان صادر کردیم و می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 904.0,
   "end": 906.42,
   "text": "که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 906.42,
   "end": 911.64,
   "text": "پاکانی که در کشورهای شما هستن به ما میان، به ما برمی‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 911.64,
   "end": 915.84,
   "text": "ما جمعشون می‌کنیم. الان ببینید مقاومت تو کشورهای حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 915.84,
   "end": 918.62,
   "text": "اروپایی و آمریکایی چه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 918.62,
   "end": 920.92,
   "text": "می‌بینید؟ یعنی پاک‌های اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 920.92,
   "end": 923.32,
   "text": "دارن برمی‌گردن به سمت مقاومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 923.32,
   "end": 926.7,
   "text": "یعنی به سمت علی. یعنی به سمت غدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 926.7,
   "end": 929.34,
   "text": "چون اون پرچمش پرچم مقابله با زور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 929.34,
   "end": 931.92,
   "text": "و ظلم بود. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 931.92,
   "end": 935.52,
   "text": "شما چه می‌کنید؟ چون گفته بود جوونا دارن از انقلاب گریزан می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 935.52,
   "end": 938.92,
   "text": "خیلی زیرکی می‌خواد این فرمایش با استناد از آیه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 938.92,
   "end": 944.18,
   "text": "فرموده بود شما چیکار می‌کنید؟ خبیث‌های ما رو دارید انتخاب می‌کنید، می‌کشید سمت خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 944.18,
   "end": 947.34,
   "text": "ببرید آقا در جبهه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 947.34,
   "end": 950.58,
   "text": "خبیثین و خبیثات عالم جمع بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 950.58,
   "end": 958.04,
   "text": "طيبین و طيبات عالم هم تو جبهه ما جمع بشن و همین اتفاق خواهد افتاد و منجر به ظهور حضرت ولی عصر انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 958.04,
   "end": 961.8,
   "text": "خواهد شد. این نظر، نظر انداختن باید اه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 961.8,
   "end": 964.16,
   "text": "انسان کامل به انسان نظر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 964.16,
   "end": 968.64,
   "text": "یه فرمایش از مرحوم حضرت آقا شوشتری بخونم براتون روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 968.64,
   "end": 971.16,
   "text": "میرفتیم محضرش اصفهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 971.16,
   "end": 974.82,
   "text": "می‌فرماید یک نظر دقت کنید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 974.82,
   "end": 978.52,
   "text": "\"یک نظر پیر به از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 978.52,
   "end": 984.93,
   "text": "صد چله\". یک نظر پیر یعنی یه نگاه امیرالمؤمنین بهت بکنه کارت تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 984.93,
   "end": 988.26,
   "text": "\"یک نظر پیر به از صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 988.26,
   "end": 992.1,
   "text": "چله\". همون چیزی که بنی‌اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 992.1,
   "end": 998.26,
   "text": "غافل شدن ازش. نظر، نظره حضرت موسی که ازشون برداشته شد رفت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 998.26,
   "end": 1000.44,
   "text": "میقات. اینا ریختن به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1000.44,
   "end": 1004.52,
   "text": "گوساله پرست شدن. بعد ادامه میده حضرت آقا شوشتری روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1004.52,
   "end": 1010.86,
   "text": "\"اگر انسان به یک مرد کاملی برسد و اگر استاد نظری به انسان کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1010.86,
   "end": 1013.22,
   "text": "انسان کلی راه می‌رود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1013.22,
   "end": 1016.1,
   "text": "کلی موانع را پشت سر می‌گذارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1016.1,
   "end": 1019.92,
   "text": "مور بودم نظر پیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1019.92,
   "end": 1022.76,
   "text": "سلیمانم کرد.\" به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1022.76,
   "end": 1026.38,
   "text": "یه جمله هم از حضرت استاد علامه بخونمو بسه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1026.38,
   "end": 1028.62,
   "text": "شب عید غدیر یه ذره بیشتر صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1028.62,
   "end": 1033.34,
   "text": "تبرکاً ببخشید. حضرت علامه هم یه جمله خیلی طلایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1033.34,
   "end": 1039.52,
   "text": "می‌فرمایند البته همه جملات ایشون طلاییه، زبرجدیه، یاقوتیه، زمردیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1039.52,
   "end": 1042.0,
   "text": "مرواریدیه. چه کنیم؟ چه عرض کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1042.0,
   "end": 1046.12,
   "text": "می‌فرماید نفس انسانی خوپذیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1046.12,
   "end": 1049.82,
   "text": "انسان به هرچه رو کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1049.82,
   "end": 1053.82,
   "text": "اصلا دلیل امامت نصب امیرالمؤمنین به امامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1053.82,
   "end": 1056.12,
   "text": "خو-- رو کردن ما به امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1056.12,
   "end": 1059.1,
   "text": "رو کردن ما که مأمومین به امام دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1059.1,
   "end": 1063.26,
   "text": "می‌فرماید انسان به هرچه رو کند آن می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1063.26,
   "end": 1065.58,
   "text": "دیگه می‌شه لا فرق بینه و بین حبیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1065.58,
   "end": 1067.72,
   "text": "یعنی تو هم میشی علی. خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1067.72,
   "end": 1069.82,
   "text": "بعد ادامه میدن. یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1069.82,
   "end": 1077.26,
   "text": "قطع زغال، مثال می‌زنن، یک قطع زغال در اثر مجاورت با آتش برافتوخته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1077.26,
   "end": 1082.32,
   "text": "انسان هم بر اثر مراقبه و همنشینی با ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1082.32,
   "end": 1089.62,
   "text": "الهی می‌شود. همنشینی با ملکوت یعنی توجهت بیفته به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1089.62,
   "end": 1096.08,
   "text": "حق، بیفته به امیرالمؤمنین، به ملکوت عالم از ظاهر و تعلقاتش بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1096.08,
   "end": 1099.24,
   "text": "چی می‌شه؟ می‌شه مثل اون زغاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1099.24,
   "end": 1105.6,
   "text": "چنان اثر در تو، تو هم الهی میشی به جهت اون روحی که در من و شما هست که در هیچ کس نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1105.6,
   "end": 1109.3,
   "text": "جز انسان. انشاالله که عاقبتمون فتح به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1109.3,
   "end": 1112.64,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}