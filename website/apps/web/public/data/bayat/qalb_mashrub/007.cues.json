 },
 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ بقره؛ میثاق و امر به شنیدن",
   "start": 9.18,
   "end": 129.04
  },
  {
   "index": 1,
   "title": "## تقدم شنوایی بر بینایی",
   "start": 129.04,
   "end": 149.26
  },
  {
   "index": 2,
   "title": "## روایات گوش‌دادن",
   "start": 149.26,
   "end": 533.73
  },
  {
   "index": 3,
   "title": "## نظر به مردم؛ چهار منظره",
   "start": 533.73,
   "end": 670.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 5.62,
   "text": "عَلَيْكَ يَا دَاعِيَ اللَّهِ وَرَبَّانِيَّ آيَاتِهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.62,
   "end": 9.18,
   "text": "سلامٌ عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.18,
   "end": 14.58,
   "text": "در آیه نود و سه سوره بقره بودیم در موضوع قلب مشرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.58,
   "end": 17.96,
   "text": "قلبی که آمیخته شده با غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.96,
   "end": 21.26,
   "text": "یکی دیگه از نکاتی که در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.26,
   "end": 24.88,
   "text": "تصریح شده اگر دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.88,
   "end": 29.16,
   "text": "وقتی می‌فرماید \"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.16,
   "end": 31.94,
   "text": "فَوْقَكُمُ الطُّورَ خُذُوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.94,
   "end": 34.9,
   "text": "مَا آتَيْنَاكُمْ بِقُوَّةٍ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.9,
   "end": 39.16,
   "text": "بعد دستور به فعل امر داره که \"وَاسْمَعُوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.16,
   "end": 42.64,
   "text": "بشنوید، گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.64,
   "end": 48.6,
   "text": "اینجا نشون میده که اهمیت گوش دادن چقدر بالاست که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.6,
   "end": 52.6,
   "text": "داره امر می‌کنه و تذکر میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.6,
   "end": 56.76,
   "text": "گوش بدید، اهل گوش دادن باشید، حرف گوش بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.76,
   "end": 61.24,
   "text": "که ظاهراً این‌ها حرف گوش ندادنشون باعث شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.24,
   "end": 65.44,
   "text": "\"وَأَشْرَبُوا فِي قُلُوبِهِمُ الْعُجْلَ بِكُفْرِهِمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.44,
   "end": 69.92,
   "text": "این دل‌هاشون مشرب شد و قاطی شد با محبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.92,
   "end": 72.38,
   "text": "گوساله چون حرف گوش ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.38,
   "end": 77.46,
   "text": "که حالا اِاِاِ امروز بعید می‌دونم فرصت شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.46,
   "end": 81.52,
   "text": "چون بعدش می‌فرماید \"قَالُوا سَمِعْنَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.52,
   "end": 85.54,
   "text": "گفتن ما شنیدیم اما \"وَعَصَيْنَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.54,
   "end": 87.26,
   "text": "وَعَصَيْنَا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.26,
   "end": 91.38,
   "text": "این داره میگه که ظاهراً گوش می‌دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.38,
   "end": 95.32,
   "text": "اما باطناً نه یعنی \"وَعَصَيْنَا\" یعنی عصیان می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.32,
   "end": 98.58,
   "text": "یا عصیان می‌کنیم ما یعنی به دل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.58,
   "end": 102.64,
   "text": "به دل نگرفتیم که اونچه که می‌شنویم رو گوش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.64,
   "end": 106.86,
   "text": "این یه بحثیه که حالا شاید فردا عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.86,
   "end": 113.58,
   "text": "در خصوص اینکه انسان وقتی که حرف رو گوش میده باید دل بسپره و الا فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.58,
   "end": 118.02,
   "text": "ولی اصلاً امروز می‌خوام این نکته رو متذکر بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.02,
   "end": 123.54,
   "text": "اهمیت گوش دادن، اصلاً صرفاً گوش دادن و اصلاً داشتن این قوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.54,
   "end": 125.76,
   "text": "شما در میان این قوهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.76,
   "end": 128.58,
   "text": "در وجود ماست دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.58,
   "end": 131.82,
   "text": "اِاِاِ اگر مثلاً خدایی نکرده کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.82,
   "end": 136.26,
   "text": "نابینا باشه به تکلم می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.26,
   "end": 141.06,
   "text": "اما اگر ناشنوا باشه به تکلم نمی‌افته، نمی‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.06,
   "end": 144.28,
   "text": "آدم‌هایی که ناشنوااند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.28,
   "end": 149.26,
   "text": "لال هم می‌شن و حتی اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.26,
   "end": 153.92,
   "text": "بعد از اینکه می‌تونه گویش داره یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.92,
   "end": 157.6,
   "text": "شنوا، شنواییش درست بوده حالا می‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.6,
   "end": 161.52,
   "text": "بعد خدایی نکرده شنواییشو از دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.52,
   "end": 165.34,
   "text": "می‌بینید که باز تو تکلامش به مشکل می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.34,
   "end": 168.62,
   "text": "چون صدای خودش رو دریافت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.62,
   "end": 172.88,
   "text": "تقدم‌تأخرها رو اون این‌ها رو نمی‌تونه لحاظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.88,
   "end": 175.7,
   "text": "یه немноی مبهم‌گویی می‌کنه، ابهام‌گویی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.7,
   "end": 178.18,
   "text": "اِاِ این شنیدن یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.18,
   "end": 180.78,
   "text": "مهم‌ترین قوای وجوده که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.78,
   "end": 183.12,
   "text": "دانشگاه نیویورک وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.12,
   "end": 188.32,
   "text": "اِممم پرس‌وجو کردن از همه دانشجوها که آقا اگر قرار باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.32,
   "end": 193.32,
   "text": "شما یه دونه از این قوای پنج‌گانه رو داشته باشید، کدومش رو انتخاب می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.32,
   "end": 196.42,
   "text": "هفتاد درصد گفتن بینایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.42,
   "end": 203.1,
   "text": "در صورتی که علم ثابت کرده که قوه شنوایی اهمیت و ارزشش بالاتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.1,
   "end": 208.7,
   "text": "تا دیدن. اصلاً ثابت شده که اونچه که ما می‌شنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.7,
   "end": 212.5,
   "text": "ده برابر دیدن تأثیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.5,
   "end": 215.48,
   "text": "لذا اینجا خدا سریعاً می‌فرماید \"وَاسْمَعُوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.48,
   "end": 218.2,
   "text": "بشنوید. وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.2,
   "end": 223.36,
   "text": "بحث اخذ میثاق رو که عرض کردیم میثاق، میثاق ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.36,
   "end": 225.84,
   "text": "اهل بیت علیهم الصلاة والسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.84,
   "end": 229.02,
   "text": "مطرح می‌کنه بلافاصله می‌فرماید گوش بدید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.02,
   "end": 234.82,
   "text": "حرف شنو باشید. حالا الا ما شاء الله من بررسی می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.82,
   "end": 242.94,
   "text": "در مجامع روایی ما بسیار روایات مخصوصاً از امیر بیان حضرت علی علیه الصلاة والسلام داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.94,
   "end": 249.88,
   "text": "پیرامون اهمیت گوش دادن و چند تا تبرکه هم نسبت به ضیق وقت عرض می‌کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.88,
   "end": 254.12,
   "text": "مثلاً مولا فرمودند \"الصَّامِعُ شَرِيكُ الْقَائِلِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.12,
   "end": 256.16,
   "text": "شنونده شریک گوینده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.16,
   "end": 260.12,
   "text": "یعنی انقدر شنیدن در ما تأثیرگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.12,
   "end": 262.8,
   "text": "که اون چیزی که داریم می‌شنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.8,
   "end": 266.26,
   "text": "در اون سهیمیم. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.26,
   "end": 269.12,
   "text": "ر-روایت داریم که شنونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.12,
   "end": 273.28,
   "text": "غیبت دومین غیبت کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.28,
   "end": 276.2,
   "text": "غیبت نمی‌کنه ظاهراً اما داره گوش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.2,
   "end": 278.86,
   "text": "اینم براش می‌نویسن غیبت کننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.86,
   "end": 281.58,
   "text": "آقا من چیزی نگفتم که نخیر می‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.58,
   "end": 286.04,
   "text": "این نشون میده که گوش دادن چقدر اثر داره، چقدر تا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.04,
   "end": 289.16,
   "text": "یعنی همین که داره غیبت رو گوش میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.16,
   "end": 293.1,
   "text": "همون اثری رو که آن نه داره در نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.1,
   "end": 297.0,
   "text": "که غیبت کننده داره غیبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.0,
   "end": 304.12,
   "text": "خیلی مهمه این. در جای دیگه مولا فرمودند که \"مَنْ أَحْسَنَ الاسْتِمَاعَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.12,
   "end": 306.24,
   "text": "تَعَجَّلَ الانتِفَاعَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.24,
   "end": 309.44,
   "text": "\"تَعَجَّلَ الانتِفَاعَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.44,
   "end": 316.72,
   "text": "می‌فرمود هرکی خوب گوش کنه \"مَنْ أَحْسَنَ الاسْتِمَاعَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.72,
   "end": 321.14,
   "text": "به نحو احسن به نیکو‌ترین وجه گوش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.14,
   "end": 324.66,
   "text": "\"تَعَجَّلَ الانتِفَاعَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.66,
   "end": 326.42,
   "text": "خیلی زود بهره می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.42,
   "end": 331.56,
   "text": "زود بهره‌مند می‌شه. پس اصلاً یه هنره خوب گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.56,
   "end": 334.76,
   "text": "اینکه کسی گوش شنوا داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.76,
   "end": 337.36,
   "text": "بعضیا اصلاً حوصله حرف شنیدن ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.36,
   "end": 341.64,
   "text": "حرف به حق رو هم حوصله نداره بشنوه چه برسه به ناحقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.64,
   "end": 346.32,
   "text": "اصلاً گوشش رو بسته. گوشش به هیچی به قول امروزه بدهکار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.32,
   "end": 349.0,
   "text": "اصلاً حوصله نداره دو کلام حرف حق بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.0,
   "end": 353.58,
   "text": "خیلی خطرناکه. آدم‌هایی که اینطوری می‌شن، مریض می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.58,
   "end": 357.84,
   "text": "اینو نشانه مریضی وجود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.84,
   "end": 361.78,
   "text": "یا مولا دمرتبه فرمودند که \"سَامِعُ ذِكْرِ اللهِ ذَاكِرٌ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.78,
   "end": 365.0,
   "text": "حالا ما غیبتشو گفتیم ذکرش هم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.0,
   "end": 370.41,
   "text": "کسی که ذکر خدا رو سامع می‌شنوه ذاکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.41,
   "end": 373.55,
   "text": "چنین کسی کأنّ داره ذکر رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.55,
   "end": 378.43,
   "text": "پس از مراتب ذاکر بودن شنیدن ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.43,
   "end": 383.83,
   "text": "شما یه کسی داره قرآن میخونه، ذکر خدا میگه، مدحی میکنه اینو شما گوش میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.83,
   "end": 387.33,
   "text": "طبق این روایت حضرت وسیع علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.33,
   "end": 392.13,
   "text": "شما مثل روضه‌خونی مثل قاری قرآنی مثل سال ذاکر میمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.13,
   "end": 395.49,
   "text": "چنین-- یعنی این نشانه اثر خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.49,
   "end": 400.71,
   "text": "شنیدنه در نفس. باز حضرت فرمودن که حضرت مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.71,
   "end": 405.23,
   "text": "فرمودن \"عَوِّدْ أُذُنَكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.23,
   "end": 414.17,
   "text": "حُسْنَ الاسْتِمَاعِ\" یعنی گوش خودت رو عادت بده عَوِّد عادت بده أُذُنَكَ گوشت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.17,
   "end": 415.97,
   "text": "به، به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.97,
   "end": 418.65,
   "text": "حُسْنَ الاسْتِمَاعِ به خوب گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.65,
   "end": 421.43,
   "text": "عادت کن خوب گوش بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.43,
   "end": 425.87,
   "text": "بعضیا گوش میدن ظاهراً اما حواسشون جای دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.87,
   "end": 429.31,
   "text": "اصلا توجه نمی‌کنن به-- یا نصفشو گوش میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.31,
   "end": 433.87,
   "text": "سریع قوه خیالشون بازیگری می‌کنه می‌برشون توی یه وادی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.87,
   "end": 436.79,
   "text": "این هم فایده نداره. اون حسن قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.79,
   "end": 438.71,
   "text": "اتفاق نمی‌افته، نمی‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.71,
   "end": 441.27,
   "text": "می‌فرماید \"و لا تُصِغْ\" بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.27,
   "end": 447.17,
   "text": "حدیث \"و لا تُصِغْ إِلَى مَا لَا يَزِيدُ فِي صَلَاحِكَ اسْتِمَاعُهُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.17,
   "end": 449.43,
   "text": "می‌فرماید که به سخنانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.43,
   "end": 452.63,
   "text": "هیچ اصلاح و پاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.63,
   "end": 455.01,
   "text": "به تو نمیفزایه یعنی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.01,
   "end": 459.05,
   "text": "اصلاح تو و پاکی و طهارت تو اضافه نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.05,
   "end": 461.15,
   "text": "گوش نده. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.15,
   "end": 462.75,
   "text": "یعنی چیزی که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.75,
   "end": 465.07,
   "text": "حرف بیخود، حرف لغو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.07,
   "end": 469.15,
   "text": "حرف ناحق، حرفی که هیچ سودی برای تو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.15,
   "end": 472.35,
   "text": "به تو چیزی اضافه نمی‌کنه. میگه گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.35,
   "end": 479.17,
   "text": "چرا؟ این پیداست که حرف بیخود شنیدن در انسان در نفس اثر منفی میذاره که میگه گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.17,
   "end": 482.37,
   "text": "بیخود که نفع نمی‌کنه، نهی نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.37,
   "end": 485.11,
   "text": "یه روایت شیرین دیگه هم تقدیم کنم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.11,
   "end": 489.27,
   "text": "مولا فرمودن \"اِطْرِفْ بِطَرْفِكَ خَيْفَ شِئْتَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.27,
   "end": 495.17,
   "text": "مِنَ النَّاسِ\" میگه به هر کجا میخوای به مردم نظر بنداز، به هر طرف دوست داری نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.17,
   "end": 500.93,
   "text": "نظر بیفکن. می‌فرماید که \"فَهَلْ تُبْصِرُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.93,
   "end": 503.85,
   "text": "حالا آیا چی-- به غیر از اینا رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.85,
   "end": 505.39,
   "text": "چند تا چیز رو مولا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.39,
   "end": 510.81,
   "text": "میگه همین. به-- نگاه بنداز هر طرف نگاه کنی جز اینا نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.81,
   "end": 514.05,
   "text": "اول فرمود \"إِلَّا فَقِيرًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.05,
   "end": 518.27,
   "text": "يُكَابِدُ فَقْرًا\" یا فقیری رو می‌بینی که داره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.27,
   "end": 522.07,
   "text": "نداراییش رنج می‌بره \"أَوْ غَنِيًّا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.07,
   "end": 525.35,
   "text": "بَدَّلَ نِعْمَةَ اللَّهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.35,
   "end": 534.19,
   "text": "كُفْرًا\" یا یه آدم دارا و غنی و توانمندی رو می‌بینی، توانگری رو می‌بینی که در کفران نعمته، قدر نعمتشو نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.19,
   "end": 539.07,
   "text": "\"أَوْ بَخِيلًا اتَّخَذَ الْبُخْلَ بِحَقِّ اللَّهِ وَفْرًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 539.07,
   "end": 543.03,
   "text": "یا یه آدم بخیلی رو می‌بینی که اون حقوقی که خدا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.03,
   "end": 545.91,
   "text": "مالش داره در داشته‌هاش داره ادا نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.91,
   "end": 551.07,
   "text": "حق خدا رو نمیده. خمس و زکات و صدقه‌شو این چیزاشو نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.07,
   "end": 553.85,
   "text": "یا حتی حقوق خدا در دانشم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.85,
   "end": 557.35,
   "text": "\"زَكَاةُ الْعِلْمِ نَشْرُهُ\". زکات فقط در مال نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.35,
   "end": 560.19,
   "text": "کسی که آبرو داره زکات داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 560.19,
   "end": 563.75,
   "text": "آبروشو مایه بذاره. کسی که زیبایی داره حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.75,
   "end": 566.77,
   "text": "زکات زیبایی فرمودن عفافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.77,
   "end": 570.07,
   "text": "کسی که علم داره زکات علم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.07,
   "end": 572.51,
   "text": "نشرشه. \"زَكَاةُ الْعِلْمِ نَشْرُهُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.51,
   "end": 577.39,
   "text": "اینا کسی که این کارو نمی‌کنن حق خدا رو حبس کردن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 577.39,
   "end": 579.87,
   "text": "داشته‌هاشون. و فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.87,
   "end": 581.91,
   "text": "\"أَوْ مُتَمَرِّدًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.91,
   "end": 584.63,
   "text": "كَأَنَّ بِأُذُنِهِ عَنْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.63,
   "end": 586.87,
   "text": "سَمْعِ الْمَوَاعِظِ وَقْرًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.87,
   "end": 590.53,
   "text": "وَقْرَ گفتیم در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.53,
   "end": 594.81,
   "text": "گناهی که قلب، قلب س-سنگین یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.81,
   "end": 596.79,
   "text": "\"في آذانه وَقْرًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.79,
   "end": 601.51,
   "text": "سنگینی گوش. این‌ها میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.51,
   "end": 606.27,
   "text": "کسایی‌ان که تمرد می‌کنند از شنیدن مواعظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.27,
   "end": 608.51,
   "text": "چرا؟ چون گوششون سنگین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.51,
   "end": 612.57,
   "text": "مولا می‌فرماید شما به هر طرف نگاه کنی، به هر طرف می‌خوای نگاه بندازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.57,
   "end": 617.07,
   "text": "جز این چند تا رو نمی‌بینی که یکیشون آدمایی‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.07,
   "end": 621.57,
   "text": "تمرد می‌کنند، سرپیچی می‌کنند از شنیدن مواعظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 621.57,
   "end": 624.65,
   "text": "از شنیدن حرف حق و حرف درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.65,
   "end": 628.41,
   "text": "خدا نکنه مجاز به اون‌ها باشیم که چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.41,
   "end": 632.61,
   "text": "امام زمان هم اگر بیاد فایده‌ای نداره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.61,
   "end": 637.99,
   "text": "یعنی آقا هم بیاد بخواد حرف حق بزنه چون این عادت کرده گوشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.99,
   "end": 641.01,
   "text": "به تمرد از موعظه حرف آقاشم گوش نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.01,
   "end": 646.07,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.07,
   "end": 659.51,
   "text": "اللهم صل على محمد و آل محمد صفحه سیصد و هفتاد و هشت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.51,
   "end": 664.05,
   "text": "با هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.05,
   "end": 667.49,
   "text": "دوستان پیشنهاد دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.49,
   "end": 670.33,
   "text": "قرآن رو بین دو نماز بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}