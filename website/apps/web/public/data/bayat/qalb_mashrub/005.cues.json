 },
 "chapters": [
  {
   "index": 0,
   "title": "## قلب مشروب و میثاق ولایت",
   "start": 1.08,
   "end": 86.28
  },
  {
   "index": 1,
   "title": "قاعدهٔ عالم سختی است:",
   "start": 86.28,
   "end": 188.32
  },
  {
   "index": 2,
   "title": "و آیهٔ هفتادوهفت آل‌عمران که سخت‌تر است:",
   "start": 188.32,
   "end": 936.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.08,
   "end": 3.88,
   "text": "به فضل الهی ادامه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.88,
   "end": 7.88,
   "text": "قلب مشروب رو ارائه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.88,
   "end": 11.58,
   "text": "از خطرات قلب مشروب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.58,
   "end": 17.26,
   "text": "فرمود \"اشربوا فی قلوبهم العجل بكفرهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.26,
   "end": 22.88,
   "text": "چون ابتدای آیه و با \"اذ اخذنا میثاقكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.88,
   "end": 25.94,
   "text": "و رفعنا فوقكم الطور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.94,
   "end": 32.8,
   "text": "شروع می‌شه بحث میثاق رو که عرض کردیم که میثاق ولایت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.8,
   "end": 37.3,
   "text": ". این‌ها اول میثاق می‌بندن، عهد می‌بندن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.3,
   "end": 39.18,
   "text": "یعنی ناهل نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.18,
   "end": 44.88,
   "text": "دقت بفرمایید \"اذ اخذنا میثاقكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.88,
   "end": 48.72,
   "text": "وقتی که ما با شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.72,
   "end": 58.66,
   "text": "میثاق بستیم. خب یه سری اصلاً حاضر به عهد بستن با خدا و ولایت الله نیستن که هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.66,
   "end": 61.14,
   "text": ". عده‌ای نه میان میثاق می‌بندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.14,
   "end": 65.46,
   "text": "این که عهد می‌بندن با ولایت زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.46,
   "end": 70.46,
   "text": "یعنی می‌شه گفت بالاخره یه اهلیتی دارن که میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.46,
   "end": 78.1,
   "text": "میثاق می‌بندن. منتها چرا اینا منجر می‌شه کارشون به نقض عهد و پیمان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.1,
   "end": 82.08,
   "text": "علتش چیه؟ که حالا الان عرض می‌کنم بر سه آیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.08,
   "end": 85.98,
   "text": "چقدر نقض پیمان سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.98,
   "end": 90.2,
   "text": "مثل خیلی‌ها که اول این انقلاب پیمان وفاداری با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.2,
   "end": 93.52,
   "text": "امام، حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.52,
   "end": 97.3,
   "text": "بستن اما بعداً شکستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.3,
   "end": 99.74,
   "text": ". که چقدر سنگینه این نقض پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.74,
   "end": 103.44,
   "text": "چی باعث می‌شه به اونجا می‌کشه کار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.44,
   "end": 106.98,
   "text": "خود آیه داره می‌گه. به جهت این‌که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.98,
   "end": 108.62,
   "text": "قلبشون مشروب می‌شه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.62,
   "end": 112.26,
   "text": "یعنی آمیخته می‌شه با غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.26,
   "end": 118.16,
   "text": "علاقه غیر خدا، انگیزه‌ی غیر خدا میاد تو کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.16,
   "end": 121.58,
   "text": "خیلی از کسایی که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.58,
   "end": 123.46,
   "text": "به قول ماها چپ کردن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.46,
   "end": 131.1,
   "text": "یعنی از راه به بیراهه رفتن، حتی بعضا جلوی انقلاب و ارزش‌هاش ایستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.1,
   "end": 133.6,
   "text": "یه زمانی علمدار انقلاب بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.6,
   "end": 138.72,
   "text": "چرا؟ خودشونم شاید یه زمانی اصلا که باورشون نمی‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.72,
   "end": 143.04,
   "text": "اگه بهشون می‌گفتن آقا شما ده سال بعد، بیست سال بعد، چهل سال بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.04,
   "end": 149.68,
   "text": "جلوی این انقلاب می‌ایستی، شاید همون موقع می‌گفت آقا گردن منو بزنید، انقدر تعصبم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.68,
   "end": 151.96,
   "text": "مثل اون ملعون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.96,
   "end": 155.54,
   "text": "امیرالمؤمنین علیه الصلاة والسلام وقتی بهش گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.54,
   "end": 159.82,
   "text": "آقا تو قاتل من می‌شی، اون شقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.82,
   "end": 164.78,
   "text": "الی الأبد، ابن مرادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.78,
   "end": 167.92,
   "text": "گفت تو قاتل من می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.92,
   "end": 173.08,
   "text": "ملجم. تو قاتل من می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.08,
   "end": 176.02,
   "text": "چی گفت به نظر شما یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.02,
   "end": 182.12,
   "text": "گفت منو بکش. اگه واقعاً اینو جدی هم گفت‌ها، گفت اگه واقعاً اینه منو بکشید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.12,
   "end": 190.68,
   "text": "چون می‌دونید جماعتی از یمن اومدن نزد امیرالمؤمنین علیه الصلاة والسلام که عهد و پیمان ببندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.68,
   "end": 193.88,
   "text": "یکیشون خیلی قشنگ چرب زبونی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.88,
   "end": 201.24,
   "text": "حرف‌هایی زد به نمایندگی از جماعتی که از یمن اومده بودن برا مولا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.24,
   "end": 203.58,
   "text": "صحبت کنن و عهد و پیمان ببندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.58,
   "end": 206.56,
   "text": "انقدر حالا هستش، صحبت‌هاش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.56,
   "end": 209.48,
   "text": "که من یه روز اینجا صحبت‌هاشو به عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.48,
   "end": 212.72,
   "text": "خوندم ترجمه کردم. اول نگفتم این کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.72,
   "end": 215.46,
   "text": "بعد گفتم به نظر شما همکارای محترم این کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.46,
   "end": 219.84,
   "text": "هر کیه که از بزرگان و... یکی گفت مالکه، یکی گفت ابوذر، یکی سلمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.84,
   "end": 222.74,
   "text": "گفتم نخیر قاتل امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.74,
   "end": 229.12,
   "text": "خیلی تعجب کردن. بعد از اون چرب زمان-زبانی‌هاش مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.12,
   "end": 231.64,
   "text": "به ابن ملجم مرادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.64,
   "end": 234.6,
   "text": "تو گوشش گفت تو من رو می‌کشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.6,
   "end": 237.24,
   "text": "گفت چی؟ همین الان منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.24,
   "end": 240.3,
   "text": "کارم رو تموم کن اگه کار من قراره به اونجا بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.3,
   "end": 243.82,
   "text": "ولی کشید. علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.82,
   "end": 248.18,
   "text": "ما باید بالاخره از قرآن درس بگیریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.18,
   "end": 252.48,
   "text": "فقط به تمایز ثواب نباید آیات رو خوند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.48,
   "end": 257.62,
   "text": "اثر این آیه در نفس من چی شد، اون ثوابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.62,
   "end": 260.7,
   "text": "فرمود به جهت چی؟ تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.7,
   "end": 266.66,
   "text": "\"اشربوا\" این مشروب شد قلب، متمایل شد به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.66,
   "end": 269.68,
   "text": "باش خواهی کرد، وام خواهی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.68,
   "end": 272.16,
   "text": "به حق خودش قانع نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.16,
   "end": 274.08,
   "text": "سختی‌ها رو حاضر نبود تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.08,
   "end": 276.9,
   "text": "بالاخره یه علم رو برمی‌داری، چقدر آدم س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.9,
   "end": 280.06,
   "text": "پدر یه خانواده می‌شی، چقدر سختی باید بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.06,
   "end": 284.72,
   "text": "مادر چقدر باید له بشه تا این بچه پرورش پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.72,
   "end": 286.74,
   "text": "اصلاً قاعده عالم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.74,
   "end": 290.56,
   "text": "\"إنك كادحٌ إلى ربك كدحًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.56,
   "end": 294.14,
   "text": "كادحٌ كدحًا. قطعاً با سختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.14,
   "end": 296.12,
   "text": "بعد نمی‌تونه، تحمل نمی‌کنه سختی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.12,
   "end": 297.9,
   "text": "می‌خواد عافیت‌طلبی پیشه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.9,
   "end": 301.96,
   "text": "نمی‌شه آقا. واقعاً اگر خیلی از ماها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.96,
   "end": 304.52,
   "text": "شيب أبي طالب بودیم که سه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.52,
   "end": 309.68,
   "text": "هیچی نباشه، همه با ما عالم ما رو تحریم کنن، با ما قطع رابطه کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.68,
   "end": 312.92,
   "text": "نه به ما دختر بدن، نه از ما نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.92,
   "end": 314.98,
   "text": "از-- شاید از ما دختر بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.98,
   "end": 317.84,
   "text": "یعنی مراودات اجتماعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.84,
   "end": 321.02,
   "text": "قطع. هیچ معامله‌ی اقتصادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.02,
   "end": 323.8,
   "text": "اتفاق نیفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.8,
   "end": 326.08,
   "text": "کلاً همه محروم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.08,
   "end": 334.02,
   "text": "و هیچ غذا و آبی چیزی هم نباشه که بعضی روایات می‌گه یک دونه خرما در روز برای دوازده نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.02,
   "end": 340.32,
   "text": "شوخی نیست. خیلیا اونجا شهید شدن تو شيب از گرسنگی و تشنگی مثل غزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.32,
   "end": 346.04,
   "text": "کی جگر داره؟ بعد الان بله سختی، فشار اقتصادی برای هممون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.04,
   "end": 349.96,
   "text": "بعد چی می‌مونه این بار رو به دوش می‌کشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.96,
   "end": 351.9,
   "text": "حالا نقض پیمان خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.9,
   "end": 354.9,
   "text": "بذارید دو تا آیه من بخونم ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.9,
   "end": 362.06,
   "text": "اصلاً تفسیرم نمی‌خواد. خودتون ببینید چه تشری زده خدا به کسایی که عهد می‌شکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.06,
   "end": 364.2,
   "text": "بیخود نیست که از چشم همه می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.2,
   "end": 367.16,
   "text": "یکی آیه پـ بیست و پنج سوره رعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.16,
   "end": 372.84,
   "text": "\"والذین ينقضون عهد الله من بعد میثاقه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.84,
   "end": 378.12,
   "text": "اون کسایی که نقض عهد الهی می‌کنند بعد از اینکه میثاق بستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.12,
   "end": 382.4,
   "text": "\"ويقطعون ما امر الله به ان يوصل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.4,
   "end": 387.14,
   "text": "و قطع می‌کنند اون چیزی رو که خدا امر به وصلش کرده بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.14,
   "end": 390.1,
   "text": "\"ويفسدون في الارض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.1,
   "end": 393.0,
   "text": "و فساد می‌کنند در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.0,
   "end": 396.1,
   "text": "اینا چه اتفاقی براشون می‌افته به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.1,
   "end": 403.08,
   "text": "خدا داره در کتابش می‌فرماید \"اولئک لهم اللعنة ولهم سوء الدار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.08,
   "end": 405.62,
   "text": "خدایه درو لعن کنه و بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.62,
   "end": 409.46,
   "text": "یک منزلگاه بسیار بدی براشون مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.46,
   "end": 413.32,
   "text": "خدا بگه. شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.32,
   "end": 416.04,
   "text": "آیه بعد، آیه هفتاد و هفت آل عمران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.04,
   "end": 421.64,
   "text": "این آیه گریه داره، زجره داره، سخقه داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.64,
   "end": 426.4,
   "text": "بیابون شد- گرد شدن داره که اگه کسی اینطوری بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.4,
   "end": 431.1,
   "text": "خیلی خطرناکه. \"ان الذين يشترون بعهد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.1,
   "end": 436.0,
   "text": "وايمانهم ثمنًا قليلاً\" اونایی که عهد خدا رو پیمان‌شون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.0,
   "end": 439.68,
   "text": "می‌فروشند به یه ثمن بخس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.68,
   "end": 444.24,
   "text": "به کمترین حد ممکن. خیلی‌ها تو انقلاب ما این کارو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.24,
   "end": 446.44,
   "text": "فروختن عهد و پیمان‌شون رو به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.44,
   "end": 449.02,
   "text": "\"اولئک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.02,
   "end": 453.74,
   "text": "حالا خدا میگه اینایی که این کارو کردن به ثمن بخس فروختن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.74,
   "end": 458.74,
   "text": "چه بلایی سرشون میاد؟ من بعید می‌دونم رفقا اگه شما سراغ دارید به من بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.74,
   "end": 462.7,
   "text": "بعید می‌دونم عذابی بالاتر از این قیامت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.7,
   "end": 465.6,
   "text": "اول می‌فرماید \"لا خلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.6,
   "end": 469.8,
   "text": "لهم في الآخرة\". آخرت هیچ بهره‌ای برای اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.8,
   "end": 472.22,
   "text": "هیچ نصیبی ندارن. هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.22,
   "end": 479.92,
   "text": "فقیر و مفلس. \"ولا\" بدتر از اون اینه \"ولا يكلمهم الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.92,
   "end": 483.84,
   "text": "الله اکبر. خدا با اونا کلامی حرف نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.84,
   "end": 486.36,
   "text": "قهره باهاشون. باز بدتر از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.36,
   "end": 490.7,
   "text": "هی سخت‌ترش می‌کنه خدا. \"ولا ينظر اليهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.7,
   "end": 497.22,
   "text": "يوم القيامة\". خدا اصلاً به اینا نگاه نمی‌کنه روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.22,
   "end": 501.22,
   "text": "عجب. دوباره بعد سنگین‌ترش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.22,
   "end": 503.94,
   "text": "\"ولا يزكيهم\". اصلاً اینا رو چیکار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.94,
   "end": 506.86,
   "text": "پاک نمی‌کنه خدا. حالا هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.86,
   "end": 510.46,
   "text": "زار بزنن. اونجا گریه کنی تو صورتت می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.46,
   "end": 513.3,
   "text": "اینجا گریه کنی نازتو می‌خرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.3,
   "end": 516.22,
   "text": "اونجا دیگه کسی گریه کنه تو صورتش می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.22,
   "end": 518.94,
   "text": "\"ولا يزكيهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.94,
   "end": 523.8,
   "text": "آخ، آخ، آخ. خدا بفرماید \"ولهم عذاب أليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.8,
   "end": 526.58,
   "text": "عذاب درک‌ناکی براشون مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.58,
   "end": 529.52,
   "text": "چرا؟ دنیا را اختیار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.52,
   "end": 533.76,
   "text": "عهد خدا رو فروختن. مثلاً اون قصه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.76,
   "end": 539.78,
   "text": "سامری بنی‌اسرائیل رو که وعده داده بودم براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.78,
   "end": 542.76,
   "text": "حالا چیزکی ازش عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.76,
   "end": 546.28,
   "text": "اسم اصلیش موسi بن ظفر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.28,
   "end": 549.66,
   "text": "این شخص یکی از انقلابیون اون زمان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.66,
   "end": 553.06,
   "text": "خوبه که بدونید. سامری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.06,
   "end": 557.62,
   "text": "حالا معروفه به بن-- در بنی‌اسرائیل که اون گوساله سامری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.62,
   "end": 564.2,
   "text": "درست می‌کنه و وقتی حضرت موسی به کوه طور میره که اون الواح رو بگیره، تورات رو بگیره و این‌ها بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.2,
   "end": 568.24,
   "text": "بعد ایشون مر-مردم رو منحرف می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.24,
   "end": 573.22,
   "text": "به نام موسi بن ظفر. شاید بدونید، شاید ندونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 573.22,
   "end": 578.66,
   "text": "خیلی جالب بود برای من وقتی متوجه شدم که اون جریانی که تو قرآن میگه موسی با یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.66,
   "end": 581.96,
   "text": "مشت می‌زنه اون قبطیه که کافر بوده رو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.96,
   "end": 585.02,
   "text": "چرا؟ چون با ایشون درگیر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 585.02,
   "end": 588.22,
   "text": "اون کافره با یه بچه مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 588.22,
   "end": 592.82,
   "text": "که همین موس بن، موسi بن ظفر یعنی سامری بوده درگیر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.82,
   "end": 595.2,
   "text": "حضرت موسی میاد میانجی‌گری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.2,
   "end": 598.54,
   "text": "می‌بینه این قبطیه خیلی داره پرروگری درمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.54,
   "end": 602.12,
   "text": "افتاده به جون سامری یا موسi بن ظفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.12,
   "end": 605.38,
   "text": "و داره حساب اونو می‌رسه. حضرت موسی با یه مشت می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.38,
   "end": 610.06,
   "text": "تمامش می‌کنه. معلومه بچه نظام‌آباد بوده حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.06,
   "end": 613.88,
   "text": ". یه مشت می‌زنه تمام. قرآن هم میگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.88,
   "end": 616.88,
   "text": "اون کی بوده که حضرت موسی ازش دفاع می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.88,
   "end": 622.2,
   "text": "همین سامری. بعد میاد تو دور دسته حضرت موسی چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.2,
   "end": 627.76,
   "text": "حمایت‌هایی از حضرت موسی ظاهراً می‌کنه و این‌ها که حالا در علت اصلیش بماند بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.76,
   "end": 630.6,
   "text": "خب این چرا این حمایت به اونجا کشیده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 630.6,
   "end": 634.5,
   "text": "یه ریشه‌یابی دیگه‌ای هم داریم که انشالله بعداً می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.5,
   "end": 637.64,
   "text": "بعد خلاصه جزو انقلابی‌ها می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.64,
   "end": 640.4,
   "text": "مثل خیلی‌ها که دوآتیشه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.4,
   "end": 643.76,
   "text": "اول انقلاب. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 643.76,
   "end": 649.24,
   "text": "کار به جایی می‌رسه که وقتی حضرت موسی تشریف می‌برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 649.24,
   "end": 651.82,
   "text": "به کوه طور که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.82,
   "end": 654.26,
   "text": "حالا از سمت و ناحیه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 654.26,
   "end": 659.1,
   "text": "اون الواح و تورات و این‌ها رو برای هدایت مردم قوانین الهی رو بیارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 659.1,
   "end": 662.62,
   "text": "ایشون شروع می‌کنه اون سوء استفاده کردن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 662.62,
   "end": 666.0,
   "text": "مثل خیلی‌ها که تا جای خالی امام رو دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 666.0,
   "end": 672.6,
   "text": "دیگه نگاهشون رو از امام بعدی برداشتن و شروع کردن به اغواگری مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.6,
   "end": 675.52,
   "text": "منحرف شدن، منصرف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.52,
   "end": 678.76,
   "text": "اشربو، این قلبشون مشرب شد به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 678.76,
   "end": 682.92,
   "text": "دنیا گرفته‌شون. شکستن اون عهد و پیمان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.92,
   "end": 685.62,
   "text": "بعد حضرت موسی وقتی برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 685.62,
   "end": 691.34,
   "text": "چه کرد با این‌ها؟ دقیقاً کاری که کرد مصداق همین آیاتیه که الان در آورد کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 691.34,
   "end": 694.68,
   "text": "شیرینه. خیلی جالبه. اصلاً شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 694.68,
   "end": 703.2,
   "text": "ذره‌ای نقض پیدا نمی‌کنی بین دستورات الهی، آیات قر-قرآن و کارهای انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.2,
   "end": 706.5,
   "text": "به نظر شما چه تنبیهی براش قرار داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.5,
   "end": 709.28,
   "text": "بعد از اینکه اون گوساله رو شکستن و ریز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.28,
   "end": 713.52,
   "text": "ریز، ریزش کردن، طلاها رو اومده بودن آب کرده بودن، ذوب کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 713.52,
   "end": 715.98,
   "text": "سامری گوساله‌ای درست کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 715.98,
   "end": 719.06,
   "text": "حالا از اثر پای رسول خاک ریخته بود تو گلوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.06,
   "end": 726.12,
   "text": "ولی خب باد که می‌اومد یه سوراخ‌هایی تعبیه کرده بود در بدن این گوساله یا گاو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 726.12,
   "end": 728.64,
   "text": "حالا به علم خاصی هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.64,
   "end": 731.06,
   "text": "صرفاً علم غریبه نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 731.06,
   "end": 738.15,
   "text": "یه وقتی که نسیم می‌وزید تو این سوراخ‌هایی که تو بدن این گوساله بود، یه صداهایی شبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 738.15,
   "end": 743.89,
   "text": "صدای خود گوساله ازش در میومد که قبلاً گفتم خدا فرمود به موسی این صدا رو خود من در می‌آوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 743.89,
   "end": 745.91,
   "text": "برای اینکه مردم رو امتحان کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.91,
   "end": 748.29,
   "text": "خیلی امتحان‌های خدا عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.29,
   "end": 754.91,
   "text": "خیلی انسان باید زیرک و کیست باشه از امتحانات الهی سر بلند بیرون بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 754.91,
   "end": 757.97,
   "text": "پاکان رو می‌خرن فقط اینجوری نیست آلودگی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 757.97,
   "end": 760.79,
   "text": "یعنی الک خدا اینقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 760.79,
   "end": 764.11,
   "text": "درشته، اینقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.11,
   "end": 766.17,
   "text": "گشاده دونه‌هاش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.17,
   "end": 768.01,
   "text": "دونه درشت‌ها ازش می‌افتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 768.01,
   "end": 771.41,
   "text": "خیلی حواسمون باید جمع باشه. خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 771.41,
   "end": 775.55,
   "text": "بعد که اون گوساله رو تیکه تیکه کردن و ریختن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 775.55,
   "end": 779.91,
   "text": "رود نیل، تنبیه حضرت موسی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.91,
   "end": 788.41,
   "text": "سامری چی بود؟ این بود که گفت اولاً برو، ترزش کرد گفت برو از اجتماع ما خارج شو از اهل ایمان خارج شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 788.41,
   "end": 793.17,
   "text": "مثل اینکه یکی بهش بگن آقا دیگه حق نداری پاتو تو مسجد، هیئت، حرم، تو اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 793.17,
   "end": 796.13,
   "text": "جماعت اهل ایمان، بدتر از اون اصلاً مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.13,
   "end": 798.81,
   "text": "برو تو بیابون‌ها. حضرت تبعیدش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 798.81,
   "end": 802.25,
   "text": "رفت تو بیابون. بعد به جهت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.25,
   "end": 809.67,
   "text": "انحرافی که ایجاد کرده بود خدا هم یه مریضی درش إنشاء کرد، ایجاد کرد که ظاهراً اینطور که من متوجه شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 809.67,
   "end": 815.15,
   "text": "وقتی خوندم تاریخ رو ظاهراً پیش از ایشون کسی این مریضی رو نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 815.15,
   "end": 818.55,
   "text": "حالا شبیهش اگر بوده اما به این شکل، میگن لامساس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 818.55,
   "end": 822.75,
   "text": "مریضی لامساس. هیچکس مسش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 822.75,
   "end": 826.97,
   "text": "هیچکس باهاش حرف نزنه. ببین همونجوری که خدا فرمود قیامت با اینا حرف نمی‌زنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 826.97,
   "end": 830.41,
   "text": "پاکشون نمی‌کنه، بهشون توجه نمی‌کنه، باهاشون حرف نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 830.41,
   "end": 835.11,
   "text": "حضرت موسی فرمود هیچکس با این شخص نه حرف بزنه، نه سمتش بره، نه باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 835.11,
   "end": 839.43,
   "text": "ارتباط بگیره. لامساس. بعد هرکه، حالا کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 839.43,
   "end": 843.73,
   "text": "حرف ولی زمانشون رو گوش نمی‌دادن، می‌رفتن یواشکی، دزدکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 843.73,
   "end": 846.65,
   "text": "با سامری ارتباط بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 846.65,
   "end": 849.83,
   "text": "اصلاً نزدیکش که می‌شدن این مریضی بهشون می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 849.83,
   "end": 853.01,
   "text": "ویروسی بوده انگار. بعد مریضی‌ش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 853.01,
   "end": 856.87,
   "text": "عنوانش لامساس بود. ولی می‌گفتن انگار تو آتیش انداختنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 856.87,
   "end": 859.39,
   "text": "تمام بند بند وجودت می‌سوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 859.39,
   "end": 863.01,
   "text": "داد می‌زدن اینا. خوب شد-- خوب شدنی هم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 863.01,
   "end": 865.89,
   "text": "تموم بود کارشون. ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 865.89,
   "end": 870.87,
   "text": "اون عقوبتی که خدا برای کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 870.87,
   "end": 874.49,
   "text": "عهدش رو می‌شکنه و توجه به دنیا می‌کنه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 874.49,
   "end": 878.75,
   "text": "خیلی از کسایی که همین الانشم دم از انقلاب دارن می‌زنن، شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 878.75,
   "end": 883.65,
   "text": "رهبر عزیزمون در خصوص کاندیدا فرموده آقا ببینید پیشینه‌شون و کارنامه‌شون و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 883.65,
   "end": 885.87,
   "text": "می‌بینی آقا خیلی وقته این آقا اصلاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 885.87,
   "end": 888.69,
   "text": "قطار انقلاب پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 888.69,
   "end": 891.15,
   "text": "الان آقا معلومه داره عوام فریبی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 891.15,
   "end": 894.35,
   "text": "وقتی پیاده شده از قطار انقلاب بعد میاد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 894.35,
   "end": 897.77,
   "text": "مثلاً مناظره‌ها می‌گه آقا من قول میدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 897.77,
   "end": 903.03,
   "text": "نمی‌دونم قانون اساسی، قانون مملکت و منویات مقام معظم رهبری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 903.03,
   "end": 906.01,
   "text": "صفر تا صد پیاده‌سازی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 906.01,
   "end": 909.67,
   "text": "که این چرا دروغ میگی؟ چرا عوام فریبی می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 909.67,
   "end": 915.65,
   "text": "واقعاً دیدیم به عینه قرآن سر نیزه کردن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 915.65,
   "end": 921.87,
   "text": "با کلمات آنچنانی قرآن خواندن و نهج البلاغه و فلان مردم رو چجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 921.87,
   "end": 927.87,
   "text": "به انحراف کشوندن. انشاالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 927.87,
   "end": 934.43,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 934.43,
   "end": 936.51,
   "text": "علی محمد و آل محمد. صفحه سیصد و هفتاد و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}