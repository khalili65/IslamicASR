 "chapters": [
  {
   "index": 0,
   "title": "سلسلهٔ بحث در قلب مشروب بود. مشروب به آشامیدنی یا آنچه آشامیده شده می‌گویند. آیهٔ نود و سه سورهٔ بقره می‌فرماید:",
   "start": 30.66,
   "end": 99.26
  },
  {
   "index": 1,
   "title": "## المیزان و نمونه؛ سیراب شدن قلب از محبت یا شرک",
   "start": 99.26,
   "end": 332.56
  },
  {
   "index": 2,
   "title": "## وارستگی از دنیا؛ سه نشانهٔ دوستان صادق",
   "start": 332.56,
   "end": 496.7
  },
  {
   "index": 3,
   "title": "## نقض میثاق با تمایل به دنیا",
   "start": 496.7,
   "end": 562.48
  },
  {
   "index": 4,
   "title": "## اسماعیل صادق‌الوعد؛ یک سال انتظار",
   "start": 562.48,
   "end": 582.82
  },
  {
   "index": 5,
   "title": "## پیامبر در آفتاب؛ وفای به قرار",
   "start": 582.82,
   "end": 602.88
  },
  {
   "index": 6,
   "title": "## کانال و سلسلهٔ قلوب؛ درد دل دربارهٔ تولید علم",
   "start": 602.88,
   "end": 1057.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 4.26,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.26,
   "end": 8.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.44,
   "end": 13.44,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.44,
   "end": 17.66,
   "text": "در قلب مشروب بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.66,
   "end": 24.56,
   "text": "مشروب به آشامیدنی یا آشامیده شده میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.56,
   "end": 27.04,
   "text": "حالا در این آیه، آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.04,
   "end": 29.92,
   "text": "نود و سه سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.92,
   "end": 32.1,
   "text": "می فرماید و \"اشربوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.1,
   "end": 34.56,
   "text": "فی قلوبهم العجل بكفرهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.56,
   "end": 41.02,
   "text": "اشربوا معناش یعنی نوشانده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.02,
   "end": 43.74,
   "text": "فعلاً مجهول اومده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.74,
   "end": 53.44,
   "text": "نوشانده شدند. حالا این کلمه اشربوا که از مصدر اشراب و از ریشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.44,
   "end": 58.24,
   "text": "شرب هست دو تا معنا میتونه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.24,
   "end": 61.14,
   "text": "اگر از باب أشربت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.14,
   "end": 68.58,
   "text": "البعیر باشه به معنای ریسمان به گردن شتر بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 72.6,
   "text": "أشربت البعیر ریسمان به گردن شتر بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.6,
   "end": 76.5,
   "text": "اگه از این ریشه بگیریم از این باب بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.5,
   "end": 80.86,
   "text": "معناش این می‌شه که ریسمانی محکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.86,
   "end": 84.08,
   "text": "از علاقه و محبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.08,
   "end": 88.22,
   "text": "قلب اونها رو با گوساله ارتباط داد چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.22,
   "end": 91.1,
   "text": "عجل یعنی گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.1,
   "end": 97.3,
   "text": "یه ریسمانی محکم بین دل اونها و گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.3,
   "end": 102.46,
   "text": "مرتبط شد. یعنی اونا در بند گوساله شدن به این معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.46,
   "end": 104.9,
   "text": "دلشون در بند گوساله شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.9,
   "end": 108.14,
   "text": "اگر از ماده اشراب بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.14,
   "end": 113.6,
   "text": "که به معنی آبیاری کردنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.6,
   "end": 116.78,
   "text": "یا اینکه مثلا به دیگری آب نوشانیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.78,
   "end": 120.18,
   "text": "اگر از این ریشه بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.18,
   "end": 126.72,
   "text": "که در حقیقت در تقدیرش بحث محبت و حب اومده اینچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.72,
   "end": 132.22,
   "text": "بعد معنای این فراز از قرآن میشه بنی اسرائیل قلوب خودشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.22,
   "end": 136.26,
   "text": "با محبت گوساله سامری آبیاری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.26,
   "end": 138.44,
   "text": "این معناش می‌شه. حالا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.44,
   "end": 142.46,
   "text": "قلوب خودشون رو با محبت سامری آبیاری کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.46,
   "end": 147.2,
   "text": "یا رشته‌ای بین دل اینها و گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.2,
   "end": 149.28,
   "text": "ات-ارتباط برقرار کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.28,
   "end": 151.72,
   "text": "چون حالا هرچی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.72,
   "end": 155.04,
   "text": "یه چه در تقدیرش، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.04,
   "end": 159.58,
   "text": "ظاهرش یه ارتباطی بین دل اونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.58,
   "end": 165.2,
   "text": "و عجل که گوساله است وجود داره و این ارتباط البته محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.2,
   "end": 167.86,
   "text": "این ارتباط محکمه که منجر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.86,
   "end": 169.9,
   "text": "نقض میثاق با خدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.9,
   "end": 172.3,
   "text": "یعنی میثاق ولایت رو شکستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.3,
   "end": 175.82,
   "text": "با اینکه کوه طور اومده بود بالا سرشون که عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.82,
   "end": 183.5,
   "text": "حالا در زمان عرب، حالا شما تفسیر المیزان رو دقت بفرمایید ذیل این آیه، جلد یک، صفحه دویست و بیست و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.5,
   "end": 187.54,
   "text": "می فرماید که علامه طباطبایی می فرماید در میان عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.54,
   "end": 189.78,
   "text": "هم در دوستی و عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.78,
   "end": 194.34,
   "text": "و هم در کینه و بغض این اصطلاح کنایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.34,
   "end": 201.18,
   "text": "رواج دارد که آنان قلب خود را از محبت و یا کینه فردی سیراب کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.18,
   "end": 206.82,
   "text": "یه اصطلاح کنایه این بحث اشربوا، اشراب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.82,
   "end": 210.24,
   "text": "قلب مشروب. یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.24,
   "end": 214.68,
   "text": "قلبشون رو پر کردن از محبت گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.68,
   "end": 218.5,
   "text": "دلبستن به گوساله که یکی از مظاهر دنیاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.5,
   "end": 221.18,
   "text": "یه تشریه به امثال ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.18,
   "end": 226.22,
   "text": "دل به دنیا و مظاهرش نبندیم، دچار تعلقات دنیوی نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.22,
   "end": 232.04,
   "text": "در تفسیر نمونه جلد یک، صفحه سیصد و پنجاه و سه باز ذیل این آیه ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.04,
   "end": 237.24,
   "text": "آقای مکارم و یارانشون اونجا می فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.24,
   "end": 239.0,
   "text": "حالا یه جمله طولانی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.0,
   "end": 241.28,
   "text": "یه بخشیش که خیلی جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.28,
   "end": 245.9,
   "text": "نظرشون اینه که این اعمال مثل قتل پیغمبران، گناه، ظلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.9,
   "end": 254.1,
   "text": "عهدشکنی که تو این قرآن اومده تو این آیه چون میثاق با خدا رو شکستن میگن اینا همه علتش در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.1,
   "end": 256.82,
   "text": "چرا این گناهان سنگین رو انجام دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.82,
   "end": 259.84,
   "text": "این نظر آقای مکارم و یارانشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.84,
   "end": 263.42,
   "text": "می فرمایند محصول سرزمین قلب اونهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.42,
   "end": 266.1,
   "text": "چون که با آب شرک آبیاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.1,
   "end": 271.32,
   "text": "این اشربوا می فرمایند ش 与 با شرک آبیاری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.32,
   "end": 273.44,
   "text": "البته صریح آیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.44,
   "end": 279.4,
   "text": "این بود که و \"اشربوا فی قلوبهم العجل بكفرهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.4,
   "end": 282.94,
   "text": "این کفر رو اینجا معناش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.94,
   "end": 284.7,
   "text": "شرک گرفته آقای مکارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.7,
   "end": 293.7,
   "text": "به هر حال کار به جایی رسیده که این دل به گونه‌ای تعلق به گوساله پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.7,
   "end": 297.26,
   "text": "حالا میشه یک معناش اینچنین باشه به یک وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.26,
   "end": 301.46,
   "text": "بگیم که علتش اینکه چون میدونید سامری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.46,
   "end": 306.72,
   "text": "گفت من میخوام یه معجزه ای انجام بدم حالا داستانشو بعداً براتون میگم امروز فرصت نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.72,
   "end": 309.46,
   "text": "طلاهاتونو بیارید. طلاهاشون رو آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.46,
   "end": 311.74,
   "text": "این طلاها رو ذوب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.74,
   "end": 314.44,
   "text": "از اون طلاها این گوساله رو ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.44,
   "end": 323.12,
   "text": "میتونه به یک وجه اینطوری برداشت بشه که چون اینا بالاخره طلاشون بود، داشته‌ها و دارایی‌های دنیاشون بود داده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.12,
   "end": 330.3,
   "text": "اینا دل به اون داشته‌های دنیاییشون بسته بودن که به گوساله و الا گوساله که مضوعیتی نداشت که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.3,
   "end": 334.58,
   "text": "یعنی دل به دنیا داشتن. آیا کلی یکی از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.58,
   "end": 336.88,
   "text": "وارسته‌ایم از این صفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.88,
   "end": 339.42,
   "text": "مثلا دلبستگی به دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.42,
   "end": 342.56,
   "text": "کی می‌تونه دست رو قرآن بذاره قسم حضرت ابالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.56,
   "end": 348.22,
   "text": "بخوره که نه من به همه عهد و پیمان‌هایی که با خدا و امام عصر و انقلاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.22,
   "end": 352.46,
   "text": "شهدا و امام و اینو بستم هستم تا آخرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.46,
   "end": 355.94,
   "text": "و وارسته‌ام. نه این گرفتاری مال همه‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.94,
   "end": 366.72,
   "text": "این وضو خطابه ها، این گوش زد کردن‌ها، اونم با آیات قرآن، با روایات نه ن-می‌شه گفت نیاز روزمره همه ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.72,
   "end": 371.02,
   "text": "این موعظه‌ها، وعظ من نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.02,
   "end": 374.3,
   "text": "باید هممون در درون خودمون این وعظ و خطور رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.3,
   "end": 378.32,
   "text": "مخصوصاً ما‌هایی که تو جاهای کلیدی و حساس هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.32,
   "end": 385.9,
   "text": "خب همه ما اینو می‌دونیم. من الان بگم همه شما گوش مبارک‌تون بارها و بارها با این دست روایات آشنا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.9,
   "end": 389.86,
   "text": "که مثلاً امام صادق صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.86,
   "end": 394.26,
   "text": "دوستان ما رو از کثرت رکوع و سجودشون نشناسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.26,
   "end": 399.08,
   "text": "خب خیلیا تو-- اهل تسنن اتفاقا بیشتر از ما نماز می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.08,
   "end": 402.72,
   "text": "پس چی بشناسیم؟ دیگه همه می‌دونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.72,
   "end": 406.52,
   "text": "بک-- بسیار این به تواتر اومده این دست روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.52,
   "end": 409.34,
   "text": "فرمودن از سه چیز؛ راستگویی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.34,
   "end": 413.28,
   "text": "یعنی صداقت، امانت‌داری‌شون، وفای به عهدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.28,
   "end": 416.1,
   "text": "این سه تا. الان چه چیزایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.1,
   "end": 418.02,
   "text": "امانت دست من و شماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.02,
   "end": 421.7,
   "text": "مخصوصا اینایی که کارهای امنیتی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.7,
   "end": 428.8,
   "text": "به هر حال پرونده همکارا الان اینجا دست یه سری امانته، آبروشون امانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.8,
   "end": 434.14,
   "text": "خیلی مهمه دست بردن در این‌ها بالاخره اطلاعات می‌خواد جابه‌جا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.14,
   "end": 439.84,
   "text": "برداشتی که از این پرونده‌ها می‌خواد صورت بگیره، اقدامی که می‌خواد انجام بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.84,
   "end": 441.66,
   "text": "باید به واقع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.66,
   "end": 443.64,
   "text": "صداقت، راستگویی اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.64,
   "end": 448.86,
   "text": "یعنی مطلقا حب و بغض شخصی نباید وارد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.86,
   "end": 454.16,
   "text": "به اینا امانت داریم دیگه و عهدی که ما اینجا اومدیم، اون روزی که عهد بستیم اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.16,
   "end": 460.34,
   "text": "الان خلاصه جبهه فرهنگی نظام اگر بشود رسانه ملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.34,
   "end": 465.0,
   "text": "حالا شما رسانه ملی رو ذوبده‌ش کن، چکیده‌ش کن، خلاصه‌ش کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.0,
   "end": 470.44,
   "text": "می‌شه اینجا. یعنی آدم‌هایی که اینجا میان چلونده شدن اومدن اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 470.44,
   "end": 477.62,
   "text": "کم آدمایی نیستن. باید به اون عهد و پیمانشون پای نظام و انقلاب وفادار باشن یا نباشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 477.62,
   "end": 486.34,
   "text": "حالا اون دستورالعملی که امام علیه الرحمه داد یا رهبر عزیزمون اصلاً انقلابی‌گری یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.34,
   "end": 489.66,
   "text": "انقلابی بودن، اصلاً اسلام چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.66,
   "end": 493.66,
   "text": "ولایت چیه؟ اینا اینجا باید تبیین بشه یا نشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 493.66,
   "end": 496.28,
   "text": "باید پایبند به عهدمون باشیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.28,
   "end": 499.7,
   "text": "ببین صریح این آیه می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.7,
   "end": 505.4,
   "text": "\"و اذ اخذنا میثاقکم\" بحث میثاقه، میثاق ولایته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.4,
   "end": 507.24,
   "text": "که بحثش رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 507.24,
   "end": 512.94,
   "text": "چون اینا دلشون متمایل به دنیا شد، اینطوری بگیم به روزش کنیم، دلشون متمایل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.94,
   "end": 515.94,
   "text": "متمایل به دنیا شد، میل به دنیا پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 515.94,
   "end": 520.06,
   "text": "تعلق پیدا کرد، متعلق شد، بسته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 520.06,
   "end": 524.3,
   "text": "به دنیا و ما فیها، میثاقشونو شکستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.3,
   "end": 526.98,
   "text": "صداقتشونو از دست دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 526.98,
   "end": 530.0,
   "text": "امانت رو خیانت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 530.0,
   "end": 533.92,
   "text": "خب ما هم در معرضشیم. فکر نکنین ما خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 533.92,
   "end": 537.84,
   "text": "مخصوصا در موضوع عهد و پیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 537.84,
   "end": 540.06,
   "text": "واقعا الان رفیقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 540.06,
   "end": 544.8,
   "text": "محکم پای عهد و پیمانش وایسته کمه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 544.8,
   "end": 548.7,
   "text": "تو این سه تا شما برانداز کن، رفیقات رو دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 548.7,
   "end": 553.04,
   "text": "این سه تا خصوصیت در چه کسی ریشه دوانده واقعا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.04,
   "end": 555.1,
   "text": "اون رو اگر پیدا کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 555.1,
   "end": 558.96,
   "text": "دورش بگرد. واقعا اینطوریه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 558.96,
   "end": 562.02,
   "text": "ریشه انسانیت هستن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.02,
   "end": 568.36,
   "text": "اینکه در روایت داریم امام رضا حالا یه مقدار درک این روایت س-سخته یه مقدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 568.36,
   "end": 571.74,
   "text": "چون خیلی ما فاصله داریم سخته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.74,
   "end": 579.88,
   "text": "امام رضا صلوات الله علیه قربونش بریم فرمود می‌دونید چرا به حضرت اسماعیل گفتن صادق الوعد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 579.88,
   "end": 582.82,
   "text": "آخه من اینو کجای دلم بذارم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 582.82,
   "end": 585.0,
   "text": "فرمایش رو چکار کنم باهاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 585.0,
   "end": 588.66,
   "text": "کجا بگم کسی چشمش چهار تا نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 588.66,
   "end": 592.54,
   "text": "حضرت فرمود علت اینکه به حضرت اسماعیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.54,
   "end": 596.74,
   "text": "صادق الوعد گفتن اینه که یه جا قرار گذاشته بود با کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.74,
   "end": 601.86,
   "text": "شخص نیومد تا یک سال حضرت اونجا موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 601.86,
   "end": 604.2,
   "text": "تا طرف بیاد. یک سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.2,
   "end": 609.04,
   "text": "درکش سخته برای ما. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 609.04,
   "end": 611.92,
   "text": "اون روایت حالا بگیم آقا بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.92,
   "end": 615.08,
   "text": "سند این روایتو بررسی کن سریع ما میریم سمت این مسائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 615.08,
   "end": 617.04,
   "text": "مگه میشه؟ مگه شدنیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.04,
   "end": 621.08,
   "text": "یک سال. انقدر که ما دوریم از حقایق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.08,
   "end": 624.76,
   "text": "یکی هم که می‌خواد به انسانیت کامل رفتار کنه برامون سخت‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.76,
   "end": 628.38,
   "text": "پیغمبر خودمون سر یه قراری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 628.38,
   "end": 634.22,
   "text": "صبح تا حالا اینطور که روایت نشون میده حداقل تا ظهر ایستاده بود چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.22,
   "end": 636.88,
   "text": "یه جا قرار گذاشته بود با کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.88,
   "end": 639.02,
   "text": "روایت میگه سایه بود اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.02,
   "end": 641.76,
   "text": "بعد پیغمبر اومدن، طرف نیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.76,
   "end": 645.6,
   "text": "ساعت‌ها گذشت، آفتاب داغ روایت داره که به س-به سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.6,
   "end": 648.58,
   "text": "مبارک پیغمبر می‌زد. عصرا اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 648.58,
   "end": 654.24,
   "text": "دلشون سوخت گفتن یا رسول الله حالا جاتونو عوض کنید مثلا برید اونورتر تو سایه وایسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 654.24,
   "end": 657.1,
   "text": "فرمود نه من اینجا قرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 657.1,
   "end": 660.96,
   "text": "داشتم. اینجا قول دادم می‌ایستم تا اون بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.96,
   "end": 664.0,
   "text": "شما نگاه کنید رفتار پیغمبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 664.0,
   "end": 666.86,
   "text": "الان حرفای من به نظر شما سخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.86,
   "end": 670.52,
   "text": "مثلا این حرفا سر مگوئه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 670.52,
   "end": 673.44,
   "text": "این حرفا رو نباید زد؟ خیلی سنگینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 673.44,
   "end": 676.08,
   "text": "ما اگرم یه بحث فلسفی، عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 676.08,
   "end": 679.18,
   "text": "یا حتی روایات و آیات رو بشکافیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 679.18,
   "end": 681.52,
   "text": "می‌رسیم به چی؟ به غذا و قوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 681.52,
   "end": 685.06,
   "text": "روزمره‌مون. چیزی که نفسمون بهش احتیاج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 685.06,
   "end": 687.96,
   "text": "نگیم آقا این حرفا ما رو خسته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 687.96,
   "end": 690.84,
   "text": "نگیم این حرفا به چه درد ما می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.84,
   "end": 694.76,
   "text": "نگیم حاج آقا به من می‌گن متأسفانه حاج آقا یه حدیث بگو برو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.76,
   "end": 699.22,
   "text": "چی می‌شینی آیه رو می‌شکافی، روایت و وقت ما رو می‌گیری به خودتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 699.22,
   "end": 701.9,
   "text": "روایتو می‌شکافی. خب چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 701.9,
   "end": 704.58,
   "text": "خب این همه روایت ما یه عمر شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 704.58,
   "end": 706.88,
   "text": "این همه این روایات، همین آیه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.88,
   "end": 712.5,
   "text": "همین آیه نود و سه سوره بقره رو خوندیم ماه مبارک رمضان به طمع ثواب و پاداش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 712.5,
   "end": 715.74,
   "text": "که هر یک آیه در ماه مبارک رمضان مساوی است با یک ختم قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 715.74,
   "end": 717.74,
   "text": "این همه آیه رو، این آیه رو خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 717.74,
   "end": 720.2,
   "text": "چند بار انصاف پنجاه سالت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 720.2,
   "end": 724.72,
   "text": "همتون نشه، خیلیامون چند بار رفتیم واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 724.72,
   "end": 730.3,
   "text": "بررسی کردیم، زیر و رو کردیم، شخم زدیم قرآن و آیات و روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 730.3,
   "end": 734.86,
   "text": "نمی‌کنیم آقا. اینجور جاها هم اگر نکنیم که وا مصیبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 734.86,
   "end": 738.9,
   "text": "اگر قرار باشه به سینه کسایی هم که حاضرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 738.9,
   "end": 741.14,
   "text": "وقت بگذارن. حالا نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 741.14,
   "end": 745.48,
   "text": "خودم رو نمیگم هر کسی دلسوزی کنه وقت بگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 745.48,
   "end": 749.38,
   "text": "با عشق این‌ها رو بیاد بیان کنه تو سینه ش بزنیم عقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 749.38,
   "end": 751.6,
   "text": "برونیمش. بابا ول کن بابا وقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 751.6,
   "end": 753.3,
   "text": "یه تعقیبات نماز بخون برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 753.3,
   "end": 755.84,
   "text": "به من میگن‌ها دوستام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 755.84,
   "end": 762.02,
   "text": "یه تسبیح از زهرا بخون. ول کن بابا این حرفو وقت ما رو چرا می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 762.02,
   "end": 764.44,
   "text": "این بده، از ماها خیلی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 764.44,
   "end": 767.36,
   "text": "تازه ما سعی می‌کنیم مزه مزه کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 767.36,
   "end": 771.68,
   "text": "در حد جمعمون صحبت کنیم و الا انقدر این کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.68,
   "end": 776.18,
   "text": "پیچیده و قامضه و فهم این‌ها مال اولیا و خواص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 776.18,
   "end": 783.46,
   "text": "که اصلاً میگه جایی که عقاب پر بریزد من خودم رو دارم نشون میدم از پشه لاغری چه خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 783.46,
   "end": 789.16,
   "text": "یا واقعاً نکتهآخر هم درد دلی‌ست دیگه امروز یه ذره درد و دلم کردین ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.16,
   "end": 798.2,
   "text": "سخته برای من یه ذره که هنوز من بشنوم بعضیا بگن حاج آقا دنبال پر کردن کانالشه و چون نامه به من دادن هنوزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 798.2,
   "end": 801.84,
   "text": "که بالاخره این کانال رو خود بچه ها اینجا راه انداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 801.84,
   "end": 805.1,
   "text": "بعدم شما برید تو کانال ببینید رد پایی از بنده می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 805.1,
   "end": 807.56,
   "text": "اصلاً اسمی از من تو کانال هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 807.56,
   "end": 811.2,
   "text": "من تعجب می‌کنم اصلاً از بعضی صحبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 811.2,
   "end": 813.82,
   "text": "حالا خداروشکر بعضی دوستان با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 813.82,
   "end": 815.94,
   "text": "حفظ حرمت با احترام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 815.94,
   "end": 819.52,
   "text": "جسارت حداقل نمی‌کنن. مثلاً نامه میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 819.52,
   "end": 825.6,
   "text": "این‌ها ولی عجیبه برای من این کانال رو اولاً خود بچه های اینجا هفت هشت سال پیش راه انداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 825.6,
   "end": 830.68,
   "text": "اولین روزی که ما قلب در قرآن رو مثل الان قلب مشروبیم بیست و چهارمین قلب قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 830.68,
   "end": 834.92,
   "text": "قول دادیم شصت تا قرآن، شصت تا قلب رو از قرآن استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 834.92,
   "end": 837.06,
   "text": "بچه ها سریع دست به کار شدن کانال زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 837.06,
   "end": 839.52,
   "text": "سی نفر هم بودیم. حالا شده بیست هزار نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 839.52,
   "end": 842.1,
   "text": "من چیکار کنم؟ ولش کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 842.1,
   "end": 844.82,
   "text": "بگم برای پنج نفر؟ بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 844.82,
   "end": 849.24,
   "text": "بیست هزار نفر رو ول کنیم؟ بعد مگه ما داریم چی میگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 849.24,
   "end": 853.96,
   "text": "گذشته از اون اینکه اگر شما رفتید تو کانال دیدید زیر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 853.96,
   "end": 859.0,
   "text": "زیل این فایل‌ها نوشته حضرت حجت الاسلام ثقت الاسلام چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 859.0,
   "end": 862.56,
   "text": "اسمی از بنده بود حرف شما رو قبول می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 862.56,
   "end": 867.8,
   "text": "خب وقتی دیگران دارن بهره می‌برن چرا این اتفاق نیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 867.8,
   "end": 871.46,
   "text": "عه اصلاً من تعجب می‌کنم حاج آقا دنبال پر کردن کانالشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 871.46,
   "end": 875.94,
   "text": "واقعاً این حرف خیلی زشته از بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 875.94,
   "end": 878.26,
   "text": "خیلی زشته. من اصلاً تعجب می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 878.26,
   "end": 883.86,
   "text": "بعد اون مدتی که من سه ماه اصلاً صحبت نکردم برای دوستام امس-عزیز دلم ریش سفید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 883.86,
   "end": 886.5,
   "text": "جمعمون آقای مرادی، آقای ناطقی امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 886.5,
   "end": 892.26,
   "text": "اون‌ورم گفتن و این طغ رو دوباره گردن بنده انداختن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 892.26,
   "end": 896.2,
   "text": "ما داریم استفاده می‌کنیم. چی-چیکار به دیگران داری ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 896.2,
   "end": 898.06,
   "text": "نظر خواهی جمعی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 898.06,
   "end": 901.34,
   "text": "دوباره اون سه ماه کانال خالی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 901.34,
   "end": 904.8,
   "text": "خب خیلی جاها مسجد بلال، هیئت یا زهرا، شرق و غرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 904.8,
   "end": 908.98,
   "text": "جنوب، شمال. ادعایی که نداریم برای هرجا ما رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 908.98,
   "end": 917.18,
   "text": "بچه ها دلسوزی کردن حرفا رو ضبط کردن گذاشتن تو کانال بمونه چون مباحث سلسله‌واره و درسواره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 917.18,
   "end": 922.2,
   "text": "طرح درسه. من بزنم تو گوش اینا که چرا این کارو داری می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 922.2,
   "end": 926.82,
   "text": "بعد حالا فضای مجازی ما پر بشه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 926.82,
   "end": 930.08,
   "text": "یاوه گویی‌ها بر علیه ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 930.08,
   "end": 934.72,
   "text": "و یه کسی هم که اینطوری تولید علم صورت می‌گیره بزنیم تو دهنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 934.72,
   "end": 939.16,
   "text": "آقا اون تعجب بره برای من. اجازه بدید من یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 939.16,
   "end": 945.0,
   "text": "تعجب کنم حداقل اگر ناراحت نشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 945.0,
   "end": 947.58,
   "text": "به هر حال الان شما همین، همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 947.58,
   "end": 951.52,
   "text": "مثلاً تو دوستان نامه دادن که آقا موت به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 951.52,
   "end": 954.66,
   "text": "بحث موت. الان ما در هفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 954.66,
   "end": 963.88,
   "text": "امروز که بحث قلب مشروب، بحث قلب در قرآن از تو دلش اخلاق میاد، تقوا میاد، اعتقادات میاد، تفسیر میاد، تا-تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 963.88,
   "end": 966.64,
   "text": "اسلام میاد، همچی میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 966.64,
   "end": 968.86,
   "text": "از اون طرف بحث موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 968.86,
   "end": 971.86,
   "text": "یکی از اساسی‌ترین و مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 971.86,
   "end": 975.84,
   "text": "مسائل زندگی ماست که بهش بی‌توجه‌ایم که این بلا، بلا سر ما اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 975.84,
   "end": 981.36,
   "text": "از اون طرف مسائل مهم روز عبادی، سیاسی، اجتماعی که شنبه‌ها میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 981.36,
   "end": 984.84,
   "text": "معرفت نفس هم که گفتیم سنگینه بردیمش مسجد بلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 984.84,
   "end": 988.02,
   "text": "دیگه چقدر ما عقب نشینی می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 988.02,
   "end": 992.64,
   "text": "من حداقل از ریش سفیدای جمع می‌خوام که یه فکری بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 992.64,
   "end": 994.94,
   "text": "اگه واقعاً این حرف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 994.94,
   "end": 1001.28,
   "text": "به درد مجموعه نمی‌خوره باز بنده رو توی دام نندازن عزیزان جسارت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1001.28,
   "end": 1006.86,
   "text": "ما که ساکت شده بودیم و حتی گفتیم آقا کسی رو به جای ما بیارید ما بریم دنبال کار زندگیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1006.86,
   "end": 1009.7,
   "text": "بعدم میگن آخوندها بردن خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1009.7,
   "end": 1012.9,
   "text": "چه می‌دونم چیکار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1012.9,
   "end": 1016.0,
   "text": "با چه زبونی دیگه با-باور کنید من اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1016.0,
   "end": 1021.1,
   "text": "زبان تقاضا نیست. مدیون منید اگه فکر کنید من از شما دارم تقاضا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1021.1,
   "end": 1028.74,
   "text": "اما خدا شاهده نزدیک یک ساله که اینجا بابت نماز و صحبت‌های اینجای من هیچ گونه پولی به من داده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1028.74,
   "end": 1030.4,
   "text": "آخوندها بردن خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1030.4,
   "end": 1032.68,
   "text": "اوف، اوف، اوف اینا فلانم به صله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1032.68,
   "end": 1038.68,
   "text": "یکی‌تون یه ماه حقوق نگیره. من میام اینجا دو، دو ساعت حداقل وقت میذارم میام اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1038.68,
   "end": 1041.34,
   "text": "قبلش هم یکی دو ساعت مطالعه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1041.34,
   "end": 1045.28,
   "text": "بابا خوش انصاف. بعضی موقع‌ها خود این آقای مرادی اینا شاهدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1045.28,
   "end": 1051.22,
   "text": "میمونم سؤالات، استخاره، مشاوره، سه ساعت من وقت میذارم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1051.22,
   "end": 1053.62,
   "text": "حالا اینجا با ما قرارداد بستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1053.62,
   "end": 1057.96,
   "text": "که حالا دوستان انشاالله این بحث آخر رو دیگه تو چیز نذارن قیچی‌ش کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}