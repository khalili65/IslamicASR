 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 2.38,
   "text": "در آیه نود و سه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.38,
   "end": 6.04,
   "text": "بقره بودیم. پیرامون قلب مشروب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.04,
   "end": 10.7,
   "text": "نکته بسیار مهمی رو درش قرار گرفته بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.7,
   "end": 14.82,
   "text": "بحث شنیدنه، گوش دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 20.48,
   "text": "که در ابتدای آیه می‌فرمود \"و اذ اخذنا ميثاقكم و رفعنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.48,
   "end": 25.2,
   "text": "فوقكم الطور خذوا ما آتيناكم بقوة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.2,
   "end": 28.16,
   "text": "اون چیزی که به شما اومده از سمت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.16,
   "end": 32.24,
   "text": "محکم بگیرید \"وَاسْمَعُوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.24,
   "end": 37.82,
   "text": "این امر به شنیدن رو گوش دادن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.82,
   "end": 42.94,
   "text": "گذاشته کنار \"خذوا ما آتيناكم بقوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.94,
   "end": 45.26,
   "text": "که عنّاً یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.26,
   "end": 50.28,
   "text": "وجوه و مصادیق محکم و جدی گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.28,
   "end": 53.56,
   "text": "امر الهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.56,
   "end": 59.72,
   "text": "احکام دین همین شنیدنه، گوش فرا دادنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.72,
   "end": 64.4,
   "text": "البته که من حق میدم به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.4,
   "end": 69.46,
   "text": "و هر کس دیگه‌ای که نخواد فرمایش مولا رو از لسان بنده بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.46,
   "end": 75.24,
   "text": "من کیم که بخوام مثلاً آیات و روایات و گفتار بزرگانو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.24,
   "end": 77.96,
   "text": "بله من اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.96,
   "end": 84.08,
   "text": "هیچ ادعایی ندارم و حق هم داره کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.08,
   "end": 89.7,
   "text": "در حقیقت هیچ عطشی نداره از اینکه بخواد از امثال ما این حرفا رو بشنوه ما حق میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.7,
   "end": 97.56,
   "text": "اما اگه کسی کلاً و مطلقاً گوشش رو تعطیل کرده به شنیدن اینجور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.56,
   "end": 100.92,
   "text": "حقایق حتمی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.92,
   "end": 103.22,
   "text": "این رنگ خطره وجودی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.22,
   "end": 111.02,
   "text": "این باید بترسه. این یک مریضی مرضی وجودش گرفته به قول فا-- مرحوم فارابی به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.02,
   "end": 115.48,
   "text": "بولیموس که باید بره دنبال مداوای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.48,
   "end": 119.0,
   "text": "بحث در شنیدن بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.0,
   "end": 121.48,
   "text": "اهمیت اون. برای همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.48,
   "end": 124.54,
   "text": "من یه حکمتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.54,
   "end": 127.64,
   "text": "از نهج البلاغه انتخاب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.64,
   "end": 130.74,
   "text": "بسیار این فرمایش عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.74,
   "end": 137.3,
   "text": "یازده تا ویژگی و خصلت رو امیرالمؤمنین در این حکمت بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.3,
   "end": 140.5,
   "text": "این مورد نیاز همه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.5,
   "end": 142.88,
   "text": "حکمت دویست و هشتاد و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.88,
   "end": 145.9,
   "text": "یکی از این یازده ویژگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.9,
   "end": 149.6,
   "text": "همین اهمیت گوش دادنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.6,
   "end": 151.58,
   "text": "ما دو تا گوش داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.58,
   "end": 155.6,
   "text": "یک زبان. این خودش یعنی حکما گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.6,
   "end": 161.92,
   "text": "علت بر اینه که دو برابر اون چیزی که حرف می‌زنی گوش بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.92,
   "end": 165.56,
   "text": "که امثال من می‌بینی برعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.56,
   "end": 168.5,
   "text": "در دل این فرمایشات مولا این اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.5,
   "end": 176.82,
   "text": "حالا برای اینکه همه این یازده خصلت رو ما بشنویم ها صرفاً همون یه دونه رو نشنویم که م-مرتبط با بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.82,
   "end": 178.84,
   "text": "پای سفره درد دل مولا بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.84,
   "end": 181.3,
   "text": "چرا درد دل؟ چون مولا در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.3,
   "end": 184.74,
   "text": "حکمت می‌فرماید که من یه رفیقی داشتم قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.74,
   "end": 188.22,
   "text": "گذشته‌ها. حالا بعضیا گفتن این رفیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.22,
   "end": 191.74,
   "text": "بعضیا گفتن منظور حضرت اباذر هست بعضیا گفتن مالک اشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.74,
   "end": 194.86,
   "text": "حالا هرکی بوده حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.86,
   "end": 199.2,
   "text": "به عظمت از ایشون یاد می‌کنه و خصلت‌های وجود ایشون رو می‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.2,
   "end": 205.22,
   "text": "یعنی اگه کسی می‌خواد همین الان تو چشم امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.22,
   "end": 208.7,
   "text": "تعظیم بشه و تکریم بشه و مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.7,
   "end": 213.54,
   "text": "او رو قبول داشته باشه و تو چشم مولا جا کنه، بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.54,
   "end": 218.24,
   "text": "این خصلت‌ها رو باید داشته باشه چون خودش مولا می‌فرماید که از این جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.24,
   "end": 222.28,
   "text": "که می‌شماره این شخص تو چشم من عزیز بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.28,
   "end": 224.3,
   "text": "عظمت داشت. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.3,
   "end": 226.68,
   "text": "فرمایش مولا رو ببینیم. پس حکمت چند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.68,
   "end": 228.86,
   "text": "دویست و هشتاد و نه خواستید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.86,
   "end": 233.38,
   "text": "\"كان لي فيما مضى أخ في الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.38,
   "end": 238.84,
   "text": "برای من \"فيما مضى\" در این زمانی که گذشت یه برادری بود \"أخ في الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.84,
   "end": 242.84,
   "text": "چقدر قشنگه آدم برادری در راه خدا داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.84,
   "end": 245.9,
   "text": "یه نفر ولو در راه خدا همراهی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.9,
   "end": 249.96,
   "text": "همراهش باشه، باهاش باشه در راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.96,
   "end": 256.78,
   "text": "کمک کارش و کمک حالش باشه، هم دل و همراهش باشه در مسیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.78,
   "end": 258.86,
   "text": "حالا فرمایشات مولا رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.86,
   "end": 261.7,
   "text": "خصلت‌های ایشون چی بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.7,
   "end": 264.32,
   "text": "این چنین مولا تعظیمش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.32,
   "end": 268.82,
   "text": "\"و كان يعظمه في عيني\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.82,
   "end": 275.74,
   "text": "از این جهت او عظیم بود \"في عيني\" در چشم من علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.74,
   "end": 277.84,
   "text": "چرا؟ این اولین ویژگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.84,
   "end": 280.54,
   "text": "\"صغر الدنيا في عينه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.54,
   "end": 284.4,
   "text": "دنیا تو چشمش کوچیک بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.4,
   "end": 287.92,
   "text": "و اصلاً توجه به دنیا نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.92,
   "end": 290.64,
   "text": "\"صغر الدنيا في عينه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.64,
   "end": 294.36,
   "text": "کسی که تو چشمش دنیا کوچیک شد چنین کسی چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.36,
   "end": 299.5,
   "text": "\"يعظمه في عيني\" یا \"في عين علي عليه السلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.5,
   "end": 302.6,
   "text": "چنین کسی عظیم می‌شه در چشم مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.6,
   "end": 309.04,
   "text": "این اولین خصلت. \"و كان خارجا من سلطان بطنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.04,
   "end": 311.2,
   "text": "اهل شکم بارگی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.2,
   "end": 318.78,
   "text": "اهل پرخوری و این‌ها نبود که شکمش ملاکش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.78,
   "end": 322.7,
   "text": "که متأسفانه امروزه خیلی از گناهانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.7,
   "end": 326.64,
   "text": "مردم دارن انجام میدن به خاطر همین شکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.64,
   "end": 332.9,
   "text": "جسارتاً اکثراً غالباً مردم دارن شکم پر می‌کنن خالی می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.9,
   "end": 335.56,
   "text": ". گویی که هیچ بهره‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.56,
   "end": 338.22,
   "text": "اون انسانیت نبردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.22,
   "end": 340.36,
   "text": "پس خصلت دوم اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.36,
   "end": 345.02,
   "text": "شکم بارگی نبود. بعدیش \"فلا يشتهي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.02,
   "end": 352.16,
   "text": "ما لا يجد و لا يكثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.16,
   "end": 354.76,
   "text": "اذا وجد\". می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.76,
   "end": 360.16,
   "text": "با اون چیزی که \"لا يجد\" بهش نمی‌رسید اشتهايي هم نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.16,
   "end": 363.46,
   "text": "\"لا يشتهي ما لا يجد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.46,
   "end": 366.9,
   "text": "چیزی که بهش نمی‌رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.9,
   "end": 370.64,
   "text": "بهش اشتباهی هم نداشت. بعضی از ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.64,
   "end": 379.28,
   "text": "چقدر چنگ و دندان میندازیم پای به که به چیزایی برسیم که آرزومونه و نرسیدیم و بعضی موقع‌ها می‌دونیم نمی‌رسیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.28,
   "end": 381.12,
   "text": "چرا نمی‌دونیم، می‌دونیم که نمی‌رسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.12,
   "end": 385.22,
   "text": "چون هیچ تلاشی در اون جهت نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.22,
   "end": 388.58,
   "text": "اما از اون طرف می‌فرماید \"ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.58,
   "end": 395.28,
   "text": "أكثر إذا وجد\" اگر به یه چیزی می‌رسید زیاده‌روی نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.28,
   "end": 400.18,
   "text": "خط و خطوط و حدودش رو رعایت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.18,
   "end": 402.6,
   "text": "قروع ارالی نمیشک-- الهی رو نمیشکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.6,
   "end": 404.38,
   "text": "خط قرمز الهی رو رد نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.38,
   "end": 407.42,
   "text": "زیاده‌روی در اون کار نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.42,
   "end": 411.72,
   "text": "بعضیا خدا نکنه به یه جایی برسن که ظرفیتشو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.72,
   "end": 415.0,
   "text": "دیگه میترکونن. حالا از هر حیثش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.0,
   "end": 419.78,
   "text": "چه بحث دنیاش، چه پست و مقامش، چه جایگاهش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.78,
   "end": 422.44,
   "text": "علمیتشون، مدرک تحصیلی‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.44,
   "end": 424.82,
   "text": "مشهوریت و مقبولیت‌شون و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.82,
   "end": 429.44,
   "text": "حالا یه وقت خدایی نکرده تو بحث شهوانی و غضب و این‌ها بیفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.44,
   "end": 432.92,
   "text": "از اون طرف. خیلی اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.92,
   "end": 435.4,
   "text": "این فرمایشات مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.4,
   "end": 438.12,
   "text": "یه ریلیه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.12,
   "end": 439.72,
   "text": "از، از بنده بپذیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.72,
   "end": 443.02,
   "text": "یه ریلیه که ما رو روش بندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.02,
   "end": 444.66,
   "text": "تو مسیر ولایت قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.66,
   "end": 448.96,
   "text": "اون که \"اهدنا الصراط المستقيم\" هر روز میگیم خدا ما رو به صراط مستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.96,
   "end": 452.66,
   "text": "رهنمون کن. خب اون صراط ولایته دیگه بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.66,
   "end": 456.38,
   "text": "اینه. همینه. دیگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.38,
   "end": 459.7,
   "text": "\"و كان اكثر دهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.7,
   "end": 462.74,
   "text": "صامتا\". به به. اکثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.74,
   "end": 466.38,
   "text": "عمرش صامت بود، ساکت بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.38,
   "end": 471.04,
   "text": "حرف نمی‌زد. این خودش مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.04,
   "end": 472.94,
   "text": "اکثرش حرف نمی‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.94,
   "end": 477.28,
   "text": "خودش مسئله‌ست که خب کسی وقتی حرف نمی‌زنه پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.28,
   "end": 479.66,
   "text": "گوش میده دیگه. البته اونه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.66,
   "end": 481.62,
   "text": "باز حضرت منحصراً می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.62,
   "end": 484.26,
   "text": "\"فإن قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 484.26,
   "end": 485.94,
   "text": "بو القائلین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.94,
   "end": 489.44,
   "text": "\"فإن، فإن قال\" اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.44,
   "end": 492.42,
   "text": "می‌گفت یعنی سخن می‌گفت به حرف می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.42,
   "end": 497.8,
   "text": "اکثراً ساکت بود‌ها. اما اگر به حرف می‌افتاد \"بو القائلین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.8,
   "end": 501.74,
   "text": "می‌شربید بر سخنوران برتری پیدا می‌کرد بر همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.74,
   "end": 504.18,
   "text": "\"و تقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.18,
   "end": 507.2,
   "text": "قلیل السائلین\" با غین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.2,
   "end": 510.56,
   "text": "میگه سیراب می‌کرد اونایی که تشنه بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.56,
   "end": 513.78,
   "text": "سائل بودن، سؤال داشتن همه رو سیراب می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.78,
   "end": 519.56,
   "text": "واقعاً بعضیا حرف نمی‌زنن، حرف نمی‌زنن اما به حرف بزنن واقعاً دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 519.56,
   "end": 523.5,
   "text": "حرفشون شنیده نیست. \"و كان ضعيف مستضعفا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.5,
   "end": 526.44,
   "text": "در عین حال یه آدمی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.44,
   "end": 528.6,
   "text": "هم ضعیف بود هم تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.6,
   "end": 530.92,
   "text": "ضعف واقع شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.92,
   "end": 536.44,
   "text": "هر دوتاش. \"فإن جاء الجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.44,
   "end": 540.46,
   "text": "فهو ليث غاب و سل و واد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.46,
   "end": 545.46,
   "text": "دو تا خصلت جالبو اینجا میشماره برای وقتی که جدی میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 545.46,
   "end": 548.84,
   "text": "اما از اون وقتی که جدی میشد این شخص، چی میشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.84,
   "end": 551.5,
   "text": "مثل شیر بیشه شجاعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.5,
   "end": 555.14,
   "text": "یا مثل ماری که تو دل بیابون با سرعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.14,
   "end": 559.76,
   "text": "حرکت می‌کنه و کسی جرات نمی‌کنه نزدیکش بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.76,
   "end": 565.76,
   "text": "چه جالب. \"لا يدلی بحجة حتی یأتی قاضیا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 565.76,
   "end": 568.42,
   "text": "تا پیش قاضی نمی‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 568.42,
   "end": 570.72,
   "text": "هیچ حجتی، دلیل و برهانی نمی‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 570.72,
   "end": 572.58,
   "text": "یعنی بی‌خود حرف نمی‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.58,
   "end": 576.24,
   "text": "اضافه‌گویی نمی‌کرد. اگه لازم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.24,
   "end": 579.32,
   "text": "پیش کسی می‌رفت که ازش سؤال می‌پرسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.32,
   "end": 582.72,
   "text": "دلیل و برهانی می‌خواست اقامه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 582.72,
   "end": 585.76,
   "text": "بعضی از ما همین‌جوری بی‌دلیل شروع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 585.76,
   "end": 591.66,
   "text": "شروع می‌کنیم حرف زدن. بی‌دلیل برهان اقامه کردن، بحث‌های سیاسی، اجتماعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.66,
   "end": 595.54,
   "text": "همچنین وقت مردم هم گوش مفت گیر میاریم جسارتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 595.54,
   "end": 598.94,
   "text": "میگه این‌جوری نبود. تا نمی‌رفت پیش قاضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.94,
   "end": 600.44,
   "text": "اهل حرفی و این‌ها نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 600.44,
   "end": 605.2,
   "text": "\"و كان لا يلوم احدا على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.2,
   "end": 610.02,
   "text": "ما يجد العذر في مثله حتی يسمع اعتذاره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.02,
   "end": 614.88,
   "text": "\"لا يلوم احدا\" هیچ کسو ملامت نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.88,
   "end": 619.32,
   "text": "مخصوصاً وقتی که حجت می‌آورد شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.32,
   "end": 623.84,
   "text": "و اعت-- و معذرت‌خواهی می‌کرد یا عذر می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.84,
   "end": 627.9,
   "text": "عذرش رو که می‌شنید \"حتى يسمع اعتذاره\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 627.9,
   "end": 630.84,
   "text": "وقتی عذر طرف رو می‌شنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.84,
   "end": 634.8,
   "text": "حالا مخصوصاً اگه طرف دیگه عذرخواهی هم می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 634.8,
   "end": 637.6,
   "text": "دیگه تموم بود. دیگه اینجا ملامتش نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.6,
   "end": 642.68,
   "text": "قابل توجه خیلیا. الان ما امروز چند تا پرونده داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 642.68,
   "end": 645.4,
   "text": "که طرف اقرار کرد آقا ما اشتباه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.4,
   "end": 649.8,
   "text": "و دیگه حتی تعهدنامه نوشته به غلط کردن افتاده آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 649.8,
   "end": 653.32,
   "text": "حالا مثلاً یه حرفی، یه غلطی، یه چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 653.32,
   "end": 654.7,
   "text": "توی پیجش مثلاً گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.7,
   "end": 660.84,
   "text": "یه بار بعدم پاک کرده بعد داره اقرار می‌کنه من اشتباه کردم نمی‌دونستم پشت سری کی حرف زدم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 660.84,
   "end": 665.8,
   "text": "آقا می‌زنیم لهش می‌کنیم تا بیچاره‌ش نکنیم، تا از این سازمان بیرونش نکنیم، تا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 665.8,
   "end": 671.4,
   "text": "ضدانقلاب تحویل این اجتماع ندیم دست بر نمی‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.4,
   "end": 673.02,
   "text": "یه آقا ملامت نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 673.02,
   "end": 676.76,
   "text": "\"و كان لا يشكو وجعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 676.76,
   "end": 681.04,
   "text": "الا عند برئه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.04,
   "end": 683.3,
   "text": "می‌فرمود که از درد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.3,
   "end": 688.0,
   "text": "شکوه نمی‌کرد مگر اینکه این درد برطرف میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 688.0,
   "end": 694.94,
   "text": "تن درست که میشد، حالا مثلاً یه وقت یاد می‌کرد از اون مریضی‌ش که یادش باشه که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 694.94,
   "end": 698.8,
   "text": "چه بلایی رو ازش دفع کرد. ولی وقتی که مریض بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 698.8,
   "end": 701.28,
   "text": "شکوه نمی‌کرد. اصلاً این صفت اولیائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 701.28,
   "end": 704.86,
   "text": "اون موقعی که تو بلا هستن همه شاکران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 704.86,
   "end": 710.1,
   "text": "حامد الهی هستن. وقتی بلا رفع شد برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 710.1,
   "end": 712.2,
   "text": "حالا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 712.2,
   "end": 719.6,
   "text": "یادآوری اینکه خدا از او بلا رو دفع کرده و شکرگزاری یاد می‌کنه و الا اون لحظه اصلاً شکوهی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 719.6,
   "end": 723.44,
   "text": "از درد اون لحظه شکوه نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.44,
   "end": 728.36,
   "text": "دیگه چی؟ \"و كان يقول ما يفعل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.36,
   "end": 730.56,
   "text": "دقیقا عکس امثال من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 730.56,
   "end": 735.44,
   "text": "\"وکان یقول\" و متوجه میشیم دیگه \"ما یفعل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 735.44,
   "end": 741.16,
   "text": "می‌گفت اون چیزی که عمل می‌کرد \"ولا یقول ما لا یفعل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 741.16,
   "end": 743.56,
   "text": "اون کاری که عمل نمی‌کرد اصلا نمی‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 743.56,
   "end": 746.54,
   "text": "در حقیقت میشه گفت چی؟ اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 746.54,
   "end": 749.02,
   "text": "گفتنش عملش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.02,
   "end": 753.7,
   "text": "عملش. در خصوص خدا هم داریم \"قوله فعل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 753.7,
   "end": 756.56,
   "text": "قول خدا فعلشه. خیلی جالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 756.56,
   "end": 759.62,
   "text": "اینو بندگان خدا از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 759.62,
   "end": 762.64,
   "text": "گرفتن، ارث گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 762.64,
   "end": 768.82,
   "text": "دیگه \"وکان اذا غلب على الكلام لم يغلب على السكوت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 768.82,
   "end": 774.32,
   "text": "شاید تو کلام و گفت‌و‌گو کسی بهش غالب میشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 774.32,
   "end": 776.76,
   "text": "و اون مغلوب میشد. یعنی ادامه نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 776.76,
   "end": 780.2,
   "text": "کلام رو رها می‌کرد. اما خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.2,
   "end": 782.38,
   "text": "\"لم يغلب على السكوت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 782.38,
   "end": 785.04,
   "text": "هیچ‌کس تو سکوت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 785.04,
   "end": 787.58,
   "text": "بر او نمی‌تونست غالب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 787.58,
   "end": 794.4,
   "text": "پیدا می‌کنیم کسی رو که هیچ‌کس در سکوت کردن حریفش نباشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 794.4,
   "end": 799.14,
   "text": "جالبه. معمولا تو کلام و گفت‌وگو و سخن‌وری و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 799.14,
   "end": 802.84,
   "text": "دیگران حریف ندارن. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 802.84,
   "end": 807.54,
   "text": "دیگه این اون چیزی‌ست که ما دنبالش بودیم تازه بهش رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 807.54,
   "end": 816.76,
   "text": "مرتبط با بحث ماست. \"وکان على ما يسمع أهرص منه على أن يتكلم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 816.76,
   "end": 820.84,
   "text": "یعنی اون چیزی که می‌شنید \"ما يسمع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.84,
   "end": 824.62,
   "text": "اون چیزی که می‌شنید براش أهرص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.62,
   "end": 827.8,
   "text": "بر وزن افعل یعنی حریص‌تر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 827.8,
   "end": 830.94,
   "text": "\"منه على أن يتكلم\" بر اون چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 830.94,
   "end": 834.08,
   "text": "کلامی که می‌خواست بگه بر گفت‌وگو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 834.08,
   "end": 836.2,
   "text": "یعنی بیشتر حریف بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 836.2,
   "end": 839.04,
   "text": "حریص بود که چیکار کنه؟ بشنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 839.04,
   "end": 841.28,
   "text": "تا صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 841.28,
   "end": 849.36,
   "text": "اینجا گفتیم که تو آیه داره تصریح می‌کنه که \"وسمعوا\"، \"وسمعوا\" این کد و رمز رو که خدا داده به من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 849.36,
   "end": 853.08,
   "text": "تو ر-- حالا رد پاشو پیدا کردیم تو فرمایش مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 853.08,
   "end": 856.18,
   "text": "اون فرمایش خدا رو اینم فرمایش مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 856.18,
   "end": 859.36,
   "text": "که بیشتر دوست داره سکوت کنه و گوش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 859.36,
   "end": 862.7,
   "text": "سکوت البته همراه با گوش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 862.7,
   "end": 867.24,
   "text": "تا حرف زدن. چون می‌فرماید \"ما يسمع أهرص\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 867.24,
   "end": 869.64,
   "text": "نمی‌فرماید صرفا سکوت می‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 869.64,
   "end": 874.56,
   "text": "اون هم یه خصلتش هست اما میشه انسان ساکت باشه اما گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 874.56,
   "end": 880.58,
   "text": "نه اینجا مولا می‌فرماید که \"کان على ما يسمع أهرص منه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 880.58,
   "end": 885.4,
   "text": "اون چیزی که می‌شنوه دوست داره، اصلا دوست داره بیشتر بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 885.4,
   "end": 887.78,
   "text": "تمومش کنیم فرمایش مولا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 887.78,
   "end": 889.96,
   "text": "\"وکان اذا بدهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 889.96,
   "end": 893.08,
   "text": "امران\". اوه، اوه چه کار سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 893.08,
   "end": 900.1,
   "text": "\"ينظر أيهما أقرب إلى الهوى فيخالفه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 900.1,
   "end": 903.96,
   "text": "وقتی تو دوراهی قرار می‌گرفت، حالا دو تا کارو می‌خواد انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 903.96,
   "end": 906.62,
   "text": "دو تا راه می‌خواد بره. دو تا تصمیم بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 906.62,
   "end": 910.96,
   "text": "نگاه می‌کرد کدومش \"أقرب إلى الهوى\" به هوای نفسش نزدیک‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 910.96,
   "end": 914.8,
   "text": "\"فيخالفه\" اونو مخالفت می‌کرد باهاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 914.8,
   "end": 916.86,
   "text": "چه خصلت‌های بزرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 916.86,
   "end": 919.44,
   "text": "\"فعلیكم\" بعد حالا این تصریح مولا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 919.44,
   "end": 922.4,
   "text": "تاکید مولا، تذکر مولا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 922.4,
   "end": 925.2,
   "text": "\"فعلیكم\" من و شمام قاطیشیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 925.2,
   "end": 929.5,
   "text": "\"کم\" ضمیر جمع. \"فعلیكم بهذا الخلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 929.5,
   "end": 932.46,
   "text": "فألزموها وتنافسوا فيها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 932.46,
   "end": 938.36,
   "text": "میگه بر شما باد با اینجور آدما گشتن، با اینا همراه شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 938.36,
   "end": 940.94,
   "text": "اخلاق اینا رو در زندگی پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 940.94,
   "end": 945.18,
   "text": "اگه پیدا کردید ولش نکنید این آجا-- اینجور آدما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 945.18,
   "end": 952.6,
   "text": "باهاشون نفس بکشید. \"فإن لم تستطيعوها\" خیلی شیرین تمومش کرده مولا فرمایشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 952.6,
   "end": 956.54,
   "text": "اگه در استطاعت شما نیست همه این خصلت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 956.54,
   "end": 960.74,
   "text": "بردارید و داشته باشید. میگه آقا ما رو کجان این حرفا ولش کن کلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 960.74,
   "end": 964.58,
   "text": "ها؟ کلا ما بی‌خیال میشیم. حضرت تذکر میده به مریدانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 964.58,
   "end": 966.64,
   "text": "می‌فرماید \"فاعلموا\" بدانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 966.64,
   "end": 969.32,
   "text": "\"أن أخذ القلیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 969.32,
   "end": 973.0,
   "text": "ولو شده یه کوچولویی از این خصلت‌ها رو داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 973.0,
   "end": 975.4,
   "text": "\"خير من ترك الكثير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 975.4,
   "end": 979.56,
   "text": "بهتره از این که کلا رها کنی و بگی بی‌خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 979.56,
   "end": 981.4,
   "text": "یا ما که نمی‌تونیم پس ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 981.4,
   "end": 985.42,
   "text": "نه تا اونجایی که میشه از این یازده خصلت یکیش دو تاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 985.42,
   "end": 987.44,
   "text": "یا نه کلشو \"وعلیكم السلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 987.44,
   "end": 990.96,
   "text": "یازده تاشو داشته باش در حد ظرف خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 990.96,
   "end": 993.58,
   "text": "تا این که بگی کلا ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 993.58,
   "end": 996.06,
   "text": "پس بحث چی بود؟ اهمیت گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 996.06,
   "end": 999.88,
   "text": "من مخصوصا رو این قصه تاکید کردم و موندم سرشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 999.88,
   "end": 1002.68,
   "text": "و الا میشد ول کنیم بریم دیگه آقا چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1002.68,
   "end": 1005.38,
   "text": "قلب مشرب و قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1005.38,
   "end": 1008.56,
   "text": "اِمم تمایل پیدا کرده به غیر حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1008.56,
   "end": 1011.06,
   "text": "قاطی شده. مزافه. قلب مزافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1011.06,
   "end": 1014.64,
   "text": "مشربه. می‌تونستیم بگیم تمومش کنیم بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1014.64,
   "end": 1017.98,
   "text": "ولی انقدر مهمه گیر و گور ما اصلا تو همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1017.98,
   "end": 1020.78,
   "text": "خیلیامون اصلا ه-- اصلا بلد نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1020.78,
   "end": 1023.12,
   "text": "ه-- گوش شنوا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1023.12,
   "end": 1025.6,
   "text": "هرچی که من میگم همونه. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1025.6,
   "end": 1028.58,
   "text": "برید. ساکت باش حرف نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1028.58,
   "end": 1031.68,
   "text": "اصلا اجازه نمیدیم کسی با ما حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1031.68,
   "end": 1038.72,
   "text": "خدا به هممون رحم کنه. ان شا الله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1038.72,
   "end": 1042.2,
   "text": "اللهumma صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1042.2,
   "end": 1042.88,
   "text": "على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1042.88,
   "end": 1060.84,
   "text": "محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}