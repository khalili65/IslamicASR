 "chapters": [
  {
   "index": 0,
   "title": "## قلب مشروب؛ آمیختگی با غیر خدا",
   "start": 21.1,
   "end": 113.74
  },
  {
   "index": 1,
   "title": "## میثاق و رفع طور؛ اهمیت ولایت",
   "start": 113.74,
   "end": 175.08
  },
  {
   "index": 2,
   "title": "## دو امان؛ پیامبر و استغفار",
   "start": 175.08,
   "end": 503.72
  },
  {
   "index": 3,
   "title": "## سمعنا و عصینا؛ أشربوا العجل",
   "start": 503.72,
   "end": 618.26
  },
  {
   "index": 4,
   "title": "## امتحان موسی و اهل معرفت",
   "start": 618.26,
   "end": 778.61
  },
  {
   "index": 5,
   "title": "## رتبت و سنگینی امتحان",
   "start": 778.61,
   "end": 916.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 11.26,
   "text": "بسم الله الرحمن الرحیم و بهیم استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.26,
   "end": 17.38,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.38,
   "end": 21.1,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.1,
   "end": 23.14,
   "text": "به فضل الهی میریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.14,
   "end": 28.6,
   "text": "قلب جدیدمون. بیست و چهارمین قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.6,
   "end": 31.54,
   "text": "از قلوبی که در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.54,
   "end": 33.86,
   "text": "صریحا براش آیه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.86,
   "end": 39.6,
   "text": "یک آیه پیرامون قلب مشروب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.6,
   "end": 42.86,
   "text": "قلب مشروب قلبیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.86,
   "end": 48.44,
   "text": "آمیخته شده با غیر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.44,
   "end": 51.74,
   "text": ". اگر صراحتا نمیگه قلب کافر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.74,
   "end": 57.14,
   "text": "چون آمیختگی داره یعنی شما ظاهر طرف رو که نگاه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.14,
   "end": 60.32,
   "text": "گویشش رو که نگاه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.32,
   "end": 67.7,
   "text": "زندگیشو بررسی می‌کنی، می‌بینی قیافه صحبت‌ها اینا همه الهیه، خداییه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.7,
   "end": 71.2,
   "text": "اما بعضا ازش خطاهایی سر می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.2,
   "end": 74.92,
   "text": "لغزش‌هایی که ازش سر می‌زنه به جهت اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.92,
   "end": 78.44,
   "text": "همه‌ی قلبش خالصانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.44,
   "end": 80.94,
   "text": "با خدا نیست. قاطی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.94,
   "end": 84.9,
   "text": "به قولی قدیم‌ها میگن شیشه خرده داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.9,
   "end": 88.92,
   "text": "یعنی اینچنین. خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.92,
   "end": 92.0,
   "text": "مبتلا به امروزه عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.0,
   "end": 95.22,
   "text": "و اگر ما مراقبت نکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.22,
   "end": 99.1,
   "text": "چه بسا ما هم گرفتار می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.1,
   "end": 104.24,
   "text": "آیه رو قرائت کنیم حالا تا ببینیم چند جلسه سر سفره‌ی این آیه خدا ما رو می‌نشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.24,
   "end": 107.96,
   "text": "آیه نود و سه سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.96,
   "end": 113.74,
   "text": "و اذ اخذنا ميثاقكم و رفعنا فوقكم الطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.74,
   "end": 117.52,
   "text": "خدا برای اینکه ما رو متذکر بشه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.52,
   "end": 121.54,
   "text": "قلب مشروب که حواستون جمع باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.54,
   "end": 128.08,
   "text": "دلتون آمیخته به غیر خدا نباشه یه واقعه‌ای رو اینجا گوشزد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.08,
   "end": 137.0,
   "text": "فرمود: \"یاد کنید وقتی رو که اخذنا ميثاقكم وقتی از شما یه میثاقی رو گرفتیم.\" این میثاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.0,
   "end": 140.54,
   "text": "برمی‌گرده به زمان بنی‌اسرائیل، حضرت موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.54,
   "end": 143.68,
   "text": "اتفاقا الانم ایامشه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.68,
   "end": 148.62,
   "text": "و وعدنا موسی ثلاثین الليلة فاتممناها بعش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.62,
   "end": 154.2,
   "text": "این ایام میقات که حضرت رفته بودن به کوه تور برای مناجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.2,
   "end": 159.2,
   "text": "توی همچین ایامی اتفاقا خوبه بدونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.2,
   "end": 164.9,
   "text": "این آیه شأن نزولش مربوطه به این ایامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.9,
   "end": 167.7,
   "text": "از شما میثاق گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.7,
   "end": 172.5,
   "text": "و رفعنا فوقكم الطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.5,
   "end": 179.9,
   "text": "برای اینکه ما اهمیت این میثاق رو-- ببینید تو ظاهر آیه این نیستا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.9,
   "end": 186.8,
   "text": "اینکه برای اینکه اهمیت این میثاق رو اینا بر گرفته از تفاسیری من دارم به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.8,
   "end": 189.08,
   "text": "تفاسیر رو بررسی کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.08,
   "end": 192.44,
   "text": "تفسیر اهل بیت رو و تفاسیر روایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.44,
   "end": 195.36,
   "text": "دارم دیگه اینچنین برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.36,
   "end": 198.7,
   "text": "مخلصش رو میگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.7,
   "end": 204.76,
   "text": "این میثاق رو که می‌خواستیم از شما بگیریم انقدر که این میثاق اهمیت داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.76,
   "end": 209.56,
   "text": "و رفعنا بالا بردیم فوقكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.56,
   "end": 213.0,
   "text": "بالا سر شما الطور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.0,
   "end": 217.56,
   "text": "کوه تور رو. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.56,
   "end": 220.08,
   "text": "اصلا دقت کرده بودید هیچوقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.08,
   "end": 228.64,
   "text": "به این آیه؟ حالا بعضیا اگر تفاسیر رو دقت نکنن همینجوری از کنارش رد شن میگن مثلا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.64,
   "end": 232.14,
   "text": "کوهی برافراشته در کنار شما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.14,
   "end": 238.02,
   "text": "اینطوری برداشت می‌کنن. در صورتی که شما اگر تفاسیر رو ببینید میگه نه اصلا کوه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.02,
   "end": 240.34,
   "text": "کوه رو خدا از جا می‌کَنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.34,
   "end": 243.4,
   "text": "و می‌بره بالا سر اینا مثل ابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 243.4,
   "end": 246.32,
   "text": "مثل یک ابر متراکم بالا سر اینا قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.32,
   "end": 250.48,
   "text": "می‌خواد که انگار اهمیت این میثاق رو برسونه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.48,
   "end": 257.74,
   "text": "مثل اینکه یه پتکی بالا سر یکی نگه داری بگی اقرار می‌کنی یا بکوبم تو سرت یا همچین حالتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.74,
   "end": 261.74,
   "text": "انقدر که این میثاق مهم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.74,
   "end": 267.1,
   "text": "حالا میثاق رو بهتون عرض کنم البته خود میثاق انقدر شیرینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.1,
   "end": 269.94,
   "text": "که خودش یه جلسه باید درباره‌ش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.94,
   "end": 277.76,
   "text": "حالا اول بگیم میثاق چی بود حالا که انقدر مهم بود که کوه رو ببره خدا بالا سر بنی‌اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 277.76,
   "end": 280.16,
   "text": "چه کارهایی کرده خدا با این قوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.16,
   "end": 285.78,
   "text": "با قوم بنی‌اسرائیل. چقدرم بهانه جو بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.78,
   "end": 288.34,
   "text": ". میثاق چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.34,
   "end": 292.72,
   "text": "در تفسیر اهل بیت علی ابن ابراهیم قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.72,
   "end": 295.78,
   "text": "چندین روایت میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.78,
   "end": 299.42,
   "text": "از ائمه معصومین خصوصا امام عسکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.42,
   "end": 306.58,
   "text": "صلوات الله علیهم اجمعین روایت میاره که این میثاق خلافت و ولایت پیغمبر عزیز عالم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.58,
   "end": 311.94,
   "text": "یعنی خاتم الانبیا و جانشیناش خصوصا امیر المؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 311.94,
   "end": 315.04,
   "text": "انقدر ولایت آل الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 315.04,
   "end": 320.42,
   "text": "خاتمیت پیغمبر و ولایت امیر المؤمنین تا امام عصر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.42,
   "end": 324.92,
   "text": "به قدری ارزش و اهمیت پیش خدا داشته و داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.92,
   "end": 329.6,
   "text": "که خدا وقتی از یک قوم می‌خواد میثاق بگیره برای اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 329.6,
   "end": 332.76,
   "text": "کوه رو از جا می‌کَنه. یه همچین معجزه فع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.76,
   "end": 336.9,
   "text": "قع-- فو-- در حقیقت فعلیه است دیگه، قولیه که نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.9,
   "end": 341.44,
   "text": "فعلیه است. در عمل یه همچین معجزه‌ای می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 341.44,
   "end": 343.74,
   "text": "کوه رو از جاش، کوه طور رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 343.74,
   "end": 346.82,
   "text": "شاخص بوده. کوه طور شاخص بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.82,
   "end": 351.48,
   "text": "یه کوه بلند مثل الان که کشور ما مثلا کوه دماوند شاخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 351.48,
   "end": 356.06,
   "text": "یه دفعه گمان کن این کوه دماوند رو از جا بکَنن بالا سرمون نگه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.06,
   "end": 362.22,
   "text": "همه هم این حالت رو ببینن و پیغمبر خدا متذکر بشه به چه خاطر این حالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 362.22,
   "end": 365.2,
   "text": "و در یک روایتی که در تفسیر قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.2,
   "end": 367.98,
   "text": "دیدم که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.98,
   "end": 377.28,
   "text": "آتشی رو و آتش سوزانی رو و دریای شوری رو هم از پیش و پس قرار میده که هیچ راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.28,
   "end": 379.02,
   "text": "برون رفتی هم براشون نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 379.02,
   "end": 382.36,
   "text": "یعنی الا بالله باید این میثاق رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 382.36,
   "end": 389.4,
   "text": "خیلی عجیبه عزیزان. انقدر ولایت اهل بیت ارزش و اهمیت داره خدا همچین کاری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.4,
   "end": 391.96,
   "text": "اقرار می‌کنید یا بکوبن تو سرتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 391.96,
   "end": 397.5,
   "text": "انقدر برا خدا مهمه. حالا بعد سؤالات پیش میاد، حق هم دارین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 397.5,
   "end": 402.3,
   "text": "این سؤالات پیش بیاد که آقا بچه‌مونست که الان این همه بی‌ولایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.3,
   "end": 404.64,
   "text": "هیچ کوهی بالا سر ما نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 404.64,
   "end": 408.58,
   "text": "یه بخشش می‌تونه وجود خود امام عصر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 408.58,
   "end": 411.78,
   "text": "وجود امام عصر مأمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 411.78,
   "end": 415.1,
   "text": "امان مردمه. یکی از آیات قرآن هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 415.1,
   "end": 419.96,
   "text": "خداوند می‌فرماید که تا وقتی که پیغمبر تو در میان اینهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 419.96,
   "end": 425.56,
   "text": "و اینها البته استغفار می‌کنند، پناه به استغفار می‌برند که امان امته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.56,
   "end": 430.76,
   "text": "من اینا رو عذاب نمی‌کنم. خب پیغمبر که تشریف بردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 430.76,
   "end": 434.3,
   "text": "اون استغفار که امان دومه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 434.3,
   "end": 437.06,
   "text": "که این همه تا- تأکیده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 437.06,
   "end": 439.7,
   "text": "سمت اولیا خداوند استغفار چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 439.7,
   "end": 442.82,
   "text": "امان دومه. دو تا امان در قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.82,
   "end": 445.82,
   "text": "اولیش پیغمبر تشریف بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 445.82,
   "end": 450.72,
   "text": "دومیش استغفار. این استغفار حقیقت استغفار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.72,
   "end": 457.22,
   "text": "فرمودن امام عصره‌ته. یعنی اگر خدا هم بخواد تو رو ببخشه به واسطه‌ی او می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 457.22,
   "end": 462.26,
   "text": "الا اگر امام عصر دست به دعا نداره برنداره چگونه خدا تو رو ببخشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 462.26,
   "end": 465.96,
   "text": "با چه واسطه‌ای؟ با چه آبرویی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.96,
   "end": 471.46,
   "text": "خب یعنی امام عصر چون تشریف داره خدا سخت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 471.46,
   "end": 475.84,
   "text": "و الا اگر امام عصر صلوات الله علیه تشریف نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 475.84,
   "end": 480.84,
   "text": "و رفعنا فوقکم الطور یهو می‌شد فوقکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 480.84,
   "end": 486.34,
   "text": "قله‌ی دماوند. اقرار می‌کنید می‌پذیرید یا بزنم تو سر و کله‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.34,
   "end": 492.06,
   "text": "این اهمیت میثاق رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 492.06,
   "end": 496.2,
   "text": "که حالا قرآن همین‌طوری در ظاهرش گفته رد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.2,
   "end": 500.62,
   "text": "تا کسی نره این تفاسیر رو بررسی نکنه متوجه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 500.62,
   "end": 503.18,
   "text": "حالا چه بلایی سر ما اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 503.18,
   "end": 508.66,
   "text": "ما به جای اینکه اهمیت و ارزش این میثاق رو درک کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 508.66,
   "end": 512.72,
   "text": "به جهت این کاری که خدا کرده تا این میثاق رو بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 512.72,
   "end": 517.54,
   "text": "رفتیم سراغ چی؟ دنبال دنیا، تعلقات دنیوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 517.54,
   "end": 519.88,
   "text": "حالا در ادامه‌ی آیه میگیم چون امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 519.88,
   "end": 524.1,
   "text": "نمی‌خوایم که همه رو بگیم که انشاالله میگیم مصادیقش رو میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.1,
   "end": 527.26,
   "text": "تعلقات دنیوی که البته زیادم صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 527.26,
   "end": 531.76,
   "text": "قلب ما شد قلب مشروب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 531.76,
   "end": 536.64,
   "text": "شنیدید میگن عقل مشروب به وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.64,
   "end": 540.72,
   "text": "ع- عقلی که آلوده شده به وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 540.72,
   "end": 545.06,
   "text": "قلب مشروب حالا بعداً لغوی بحثشو می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 545.06,
   "end": 548.86,
   "text": "از همین آیه است. اج- اجازه بدید بقیه‌ی آیه رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 548.86,
   "end": 559.06,
   "text": "\"خذوا ما آتيناکم بقوة\" بگیرید اون چیزی که ما به شما عطا کردیم بقوة خذوا بگیرید فعل امره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 559.06,
   "end": 561.48,
   "text": "ما آتيناکم اون چیزی که به شما عطا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 561.48,
   "end": 564.44,
   "text": "اون چی بود؟ ولایت اهل بیت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 564.44,
   "end": 567.0,
   "text": "از اون موقع به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 567.0,
   "end": 570.96,
   "text": "قوم موسی ولایت امام عصر من و شما رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 570.96,
   "end": 572.92,
   "text": "میده و تأکید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 572.92,
   "end": 576.64,
   "text": "اونم بقوة محکم بگیریدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 576.64,
   "end": 579.78,
   "text": "خب و اسمعوا اینا زا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 579.78,
   "end": 581.88,
   "text": "می‌فرمود که بشنویدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 581.88,
   "end": 585.18,
   "text": "تأکید می‌کنه. بشنوید من به شما چی میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 585.18,
   "end": 590.02,
   "text": "قالوا اینا گفتن که حالا بعد از اون همه تأکید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 590.02,
   "end": 597.5,
   "text": "که خذوا اون چیزی که به شما گفتیم بگیرید اونم بقوة و اسمعوا بشنویدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 597.5,
   "end": 599.1,
   "text": "اونم کوه بالا سرتونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 599.1,
   "end": 602.38,
   "text": "اینها اینها. قالوا سمعنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 602.38,
   "end": 606.02,
   "text": "اینا گفتن بله ما شنیدیم و عصینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 606.02,
   "end": 609.58,
   "text": "اما عصیان کردیم. چرا عصیان کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 609.58,
   "end": 613.18,
   "text": "اینجا قرآن داره میگه نقطه سر خط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 613.18,
   "end": 616.68,
   "text": "سرفصل قلب جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 616.68,
   "end": 619.02,
   "text": "خدا ما رو حفظ کنه از این نوع قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 619.02,
   "end": 622.8,
   "text": "و أشربوا في قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 622.8,
   "end": 624.92,
   "text": "اینا مشروب شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 624.92,
   "end": 630.14,
   "text": "در قلبشون مثل یه شرابی که آمیخته‌ست با غیر، مزافه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 630.14,
   "end": 632.68,
   "text": "آب مزافه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 632.68,
   "end": 635.48,
   "text": "قلبشون آمیخته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 635.48,
   "end": 638.68,
   "text": "في قلوبهم العجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 638.68,
   "end": 640.52,
   "text": "عجل اون گاوس، اون گوساله‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 640.52,
   "end": 643.66,
   "text": "گوساله‌ که حالا جریان داره انشاالله عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 643.66,
   "end": 646.96,
   "text": "می‌دونید قطعاً که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 646.96,
   "end": 652.56,
   "text": "سامری از اثر پیغمبر در قرآن می‌فرماید از اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 652.56,
   "end": 658.46,
   "text": "پای رسول خدا. حالا این رسول رو بعضی از مفسرین خود حضرت موسی گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 658.46,
   "end": 660.96,
   "text": "اثر پاش. بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 660.96,
   "end": 663.18,
   "text": "جای پای جبرائیل گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 663.18,
   "end": 670.4,
   "text": "به هر حال از اثر پا که اثر گذاشته بود رو خاک این سامری معلومه حالیش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 670.4,
   "end": 672.84,
   "text": "اینو برداشت ریخت توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 672.84,
   "end": 676.7,
   "text": "گلوی این گوساله. گوساله‌ای که با طلا ساخته شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 676.7,
   "end": 680.38,
   "text": "طلاها رو جمع کرد از مردم خواست و بیایید من برای شما چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 680.38,
   "end": 686.22,
   "text": "نوبری دارم اینها و این گوساله رو درست کرد و حالا داستانش مفصله انشاالله بعداً میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 686.22,
   "end": 688.58,
   "text": "فعلاً یه کلیتی عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 688.58,
   "end": 691.72,
   "text": "بعد از این خاک رو که پاشید تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.72,
   "end": 694.8,
   "text": "گلوی این گوساله صدا ازش بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.8,
   "end": 697.48,
   "text": "حالا جالبه که بدونید بعداً هم عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 697.48,
   "end": 699.38,
   "text": "یعنی چی؟ منظور خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 699.38,
   "end": 702.4,
   "text": "در تفسیر اهل بیت علی ابن ابراهیم قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 702.4,
   "end": 707.08,
   "text": "می‌فرماید که حضرت موسی تو کوه طور مثل همچین ایامی که در کوه طور بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 707.08,
   "end": 708.96,
   "text": "به خدا گفت و خض--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 708.96,
   "end": 711.04,
   "text": "گفت و گو کرد. خدا بهش فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 711.04,
   "end": 716.98,
   "text": "که یه همچین اتفاقی میاد بیو-- می‌خواد بیفته و اینها و خیلی شیرین، خیلی گفت و گوهای خوب و قشنگ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 716.98,
   "end": 722.42,
   "text": "شیرینی. چه جالب که اصابت کرده به ایامش هم این آیه و این قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 722.42,
   "end": 725.3,
   "text": "قلب مشروب. گفت‌وگوهای شیرینی صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 725.3,
   "end": 734.17,
   "text": "اونجا حضرت موسی سؤال می‌کنه از خدا که این صدای درون گلوی گوساله رو کی درمیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 734.17,
   "end": 736.65,
   "text": "خب درسته این اثر پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 736.65,
   "end": 741.27,
   "text": "رسول تو رو ریخته تو اون گلو، اون صدا رو کی در میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 741.27,
   "end": 745.61,
   "text": "خیلی جالبه بدونید خدا می‌فرماید به حضرت موسی \"من این صدا رو در میارم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 745.61,
   "end": 748.69,
   "text": "عجب. صدا رو خدا در میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 748.69,
   "end": 753.93,
   "text": "که چی بشه؟ که اینا رو امتحان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 753.93,
   "end": 757.15,
   "text": "امتحانات خدا عجیبه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 757.15,
   "end": 760.71,
   "text": "قبول دارید رفقا؟ خیلی امتحانات خدا عجیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 760.71,
   "end": 762.95,
   "text": "و هر چقدر من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 762.95,
   "end": 769.25,
   "text": "ان‌شاءالله به وقتش عرض می‌کنیم رتبه‌مون دقیق‌تر و ظریف‌تر و شریف‌تر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 769.25,
   "end": 773.23,
   "text": "امتحاناتمون هم به همون اندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 773.23,
   "end": 775.77,
   "text": "هم وسعت می‌گیره هم سنگین‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 775.77,
   "end": 780.43,
   "text": "و من به شما عرض می‌کنم حتی تو همین قصه چه امتحانی خدا از حضرت موسی گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 780.43,
   "end": 785.07,
   "text": "که الواحش رو کوبید. الواحی که دستش بود حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 785.07,
   "end": 789.77,
   "text": "وقتی اومد، اینو گوشه‌ی ذهنتون داشته باشید تا بعداً بازشون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 789.77,
   "end": 793.07,
   "text": "وقتی اومد دید قصه رو که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 793.07,
   "end": 796.67,
   "text": "گرفتار و گوساله شدن دید الواح رو کوبید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 796.67,
   "end": 798.69,
   "text": "تیکه تیکه شد این الواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 798.69,
   "end": 801.09,
   "text": "که از سمت حضرت حق اومده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 801.09,
   "end": 803.35,
   "text": "به یادگار از کوه طور و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 803.35,
   "end": 807.37,
   "text": "بعد اونجا خدا گوش موسی رو می‌پوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 807.37,
   "end": 812.33,
   "text": "اینو امام عسکری فرموده. تفاسیر اینطوری نیست تو ظواهری آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 812.33,
   "end": 817.15,
   "text": "که چرا اون موقع که من بدین رو تو گوشت گفتم موسی چرا همون موقع نکوبیدی بشکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 817.15,
   "end": 820.17,
   "text": "حالا که دیدی، حالا اینو ببین امتحانات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 820.17,
   "end": 827.33,
   "text": "امتحانات الهی. یعنی هر چقدر شما رتبت پیش خدا بالاتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 827.33,
   "end": 830.17,
   "text": "امتحاناتت هم سنگین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 830.17,
   "end": 833.35,
   "text": "اینجوری نیست که شما فکر کنی حالا بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 833.35,
   "end": 836.61,
   "text": "اگر یه آدم معمولی باشی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 836.61,
   "end": 840.79,
   "text": "رشد نکرده باشی، امتحانات سنگینی هم ازت نمی‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 840.79,
   "end": 843.53,
   "text": "به قول علامه روحش شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 843.53,
   "end": 847.39,
   "text": "در شرح مصباح العنس مرحوم ابن فناری یادمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 847.39,
   "end": 851.39,
   "text": "ایشون توی جلسه‌ای فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 851.39,
   "end": 855.15,
   "text": "یه آقایی اسم نبرد گفت یه آقایی رو ما می‌شناختیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 855.15,
   "end": 858.45,
   "text": "از اهل معرفت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 858.45,
   "end": 863.47,
   "text": "گفت \"دیگه خدایا می‌خوام فقط برای تو باشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 863.47,
   "end": 866.63,
   "text": "مال تو باشم، فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 866.63,
   "end": 868.39,
   "text": "رضایت تو رو پیش بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 868.39,
   "end": 872.47,
   "text": "فقط خدا.\" خدا رحمت کنه مرحوم آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 872.47,
   "end": 875.11,
   "text": "بهاالدینی کلام ایشون بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 875.11,
   "end": 877.59,
   "text": "فقط خدا، فقط خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 877.59,
   "end": 882.93,
   "text": "فقط خدا کلام ایشون بود. بعد می‌گه وقتی رفت خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 882.93,
   "end": 885.19,
   "text": "دید که خونه‌شو آتیش گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 885.19,
   "end": 889.29,
   "text": "خونه آتیش گرفته، زن و بچه دارن می‌دوئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 889.29,
   "end": 894.47,
   "text": "آتیش رو خاموش کرد. چند روزی گذشت دید همه زن و بچه به مریضی بدی افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 894.47,
   "end": 896.55,
   "text": "پی سی افتاد. فقیر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 896.55,
   "end": 899.51,
   "text": "هی پشت سر هم بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 899.51,
   "end": 902.69,
   "text": "بعد برگشت گفت خدایا غلط کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 902.69,
   "end": 906.93,
   "text": "آقا حالا ما یه چیزی گفتیم. قلب مشروب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 906.93,
   "end": 911.89,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 911.89,
   "end": 916.37,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}