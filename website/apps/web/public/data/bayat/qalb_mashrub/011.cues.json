   "title": "## ادامهٔ بحث قلب مشروب از آیهٔ نودوسهٔ بقره",
   "start": 0.18,
   "end": 38.1
  },
  {
   "index": 1,
   "title": "## سمعنا و عصینا؛ نوشاندن گوساله در قلب",
   "start": 38.1,
   "end": 364.76
  },
  {
   "index": 2,
   "title": "چون به ذیل آیهٔ چهل‌وشش هود می‌رسیم:",
   "start": 364.76,
   "end": 629.22
  },
  {
   "index": 3,
   "title": "## اصلِ «جزاءُ العملِ نفسُه»",
   "start": 629.22,
   "end": 649.34
  },
  {
   "index": 4,
   "title": "## گوساله در قلب؛ نه صرفِ حبّ گوساله",
   "start": 649.34,
   "end": 927.48
  },
  {
   "index": 5,
   "title": "## شکستن میثاق ولایت و شنیدنِ جان",
   "start": 927.48,
   "end": 947.54
  },
  {
   "index": 6,
   "title": "## برید القلب؛ آلودگی از پایین به بالا",
   "start": 947.54,
   "end": 1156.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.18,
   "end": 4.12,
   "text": "لا اله الا الله محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.12,
   "end": 8.3,
   "text": "رسول الله. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 11.6,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 14.0,
   "text": "و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.0,
   "end": 16.54,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.54,
   "end": 23.0,
   "text": "امروز چون قلب مشرب یه مقدار بحثش عقب افتاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.0,
   "end": 30.32,
   "text": "دیگه نیت کردیم امروز ادامه بحث قلب مشرب رو از آیه نود و سه سوره بقره عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.32,
   "end": 35.6,
   "text": "در این آیه خدای متعال می فرماید که \"و اذ اخذنا میثاقکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.6,
   "end": 39.48,
   "text": "اون هنگامی که ما از شما میثاق گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.48,
   "end": 42.98,
   "text": "\" و رفعنا فوقکم الطور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.98,
   "end": 51.82,
   "text": "کوه طور رو بالا سر شما آوردیم مثل یه تیکه ابر که از معجزات فعلیه حضرت موسی بوده علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.82,
   "end": 56.58,
   "text": "یعنی نشون میده که چقدر این میثاق مهم بوده که خدا ازشون عهد کرده که قبلا گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.58,
   "end": 59.38,
   "text": "این میثاق ولایت امیرالمؤمنین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.38,
   "end": 62.66,
   "text": "انقدر که اهمیت داشته و مهم بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.66,
   "end": 65.54,
   "text": "برای اینکه اینا بپذیرن کوه رو آورد بالا سرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.54,
   "end": 70.62,
   "text": "\"خذوا ما آتيناکم بقوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.62,
   "end": 77.42,
   "text": "بگیرید اونچه که به شما اومد ما به شما آوردیم براتون آوردیم بقوة به قوت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.42,
   "end": 79.76,
   "text": "این نشون میده که قبلا راجع به این نکات رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.76,
   "end": 83.66,
   "text": "یه یادآوری کنیم که چقدر ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.66,
   "end": 85.96,
   "text": "امر دین مهمه که میگه بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.96,
   "end": 89.12,
   "text": "محکمم بگیرید بقوة با قدرت، با قوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.12,
   "end": 92.64,
   "text": "با ضعف و کسالت نمیشه دینداری کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.64,
   "end": 94.7,
   "text": "\" و اسمعوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.7,
   "end": 97.24,
   "text": "بشنوید که بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.24,
   "end": 99.84,
   "text": "شنیدن رو ما گفتیم چقدر اهمیت داره قبلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.84,
   "end": 103.78,
   "text": "\"قالوا\" اینا گفتن که \" سمعنا اعصینا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.78,
   "end": 107.58,
   "text": "ما شنیدیم ولی تو دلشون گرفتن که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.58,
   "end": 111.8,
   "text": "اعصینا. ما عصیان میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.8,
   "end": 114.72,
   "text": "ما شنیدیم اما عصیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.72,
   "end": 117.98,
   "text": "یعنی تو دلمون عصیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.98,
   "end": 121.26,
   "text": "یعنی خیلی جدی نگرفته بودن قصه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.26,
   "end": 124.88,
   "text": "و \"اشربوا\" از اینجاست که بحث قلب مشرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.88,
   "end": 128.44,
   "text": "مشخص میشه و \"اشربوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.44,
   "end": 135.88,
   "text": "فی قلوبهم العجل للكفر\" حالا چند تا نکته اینجا هست که بعضیاش رو گفتیم بعضیاشم انشاالله امروز و بعدا میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.88,
   "end": 141.84,
   "text": "اولا گفتیم که خب اشربوا اینجا به صورت مجهول اومده یعنی نوشانده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.84,
   "end": 147.2,
   "text": "به چی نوشانده شدند؟ اولا در \"فی قلوبهم\" در قلبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.2,
   "end": 150.54,
   "text": "یعنی تو اون مرحله باطنی شون در حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.54,
   "end": 152.7,
   "text": "تعلقاتشون نوشانده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.7,
   "end": 155.6,
   "text": "به چی؟ به خاطر چی نوشانده شدند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.6,
   "end": 158.38,
   "text": "به کفر. به خاطر کفری که داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.38,
   "end": 162.56,
   "text": "گفتیم مثلا نتیجه کفر و تکفیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.56,
   "end": 165.16,
   "text": "طریق تکفیری اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.16,
   "end": 168.42,
   "text": "این میشه که انسان قلبش مشرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.42,
   "end": 172.1,
   "text": "یعنی آمیخته با غیر خدا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.1,
   "end": 175.86,
   "text": "حالا اینها به \"فی قلوبهم العجل للكفر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.86,
   "end": 180.28,
   "text": "گوساله رو محبت گوساله، اون بحث سا-گوساله سامرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.28,
   "end": 185.66,
   "text": "رو که بحث تاریخیش رو ما گفتیم تب-- در چند جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.66,
   "end": 189.64,
   "text": "که اینها قلבשون گرفتار اون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.64,
   "end": 192.92,
   "text": "و چون اون گوساله رو از آب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.92,
   "end": 197.04,
   "text": "طلاهایی بود که از بین مردم جمع آوری کرده بود، در حقیقت میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.04,
   "end": 199.78,
   "text": "دلشون پر شده بود از حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.78,
   "end": 207.48,
   "text": "بعضیا به تقدیر گرفتن حب رو که عرض میکنیم یعنی محبت گوساله یعنی محبت طلا، یعنی محبت دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.48,
   "end": 214.46,
   "text": "یعنی اشاره به اینه که یعنی اینا دلشون حب دنیا گرفتار حب دنیا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.46,
   "end": 216.14,
   "text": "به چه خاطر؟ به خاطر کفرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.14,
   "end": 219.06,
   "text": "یعنی خیلی حرف خدا رو جدی نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.06,
   "end": 225.42,
   "text": "قبلش هم که می فرماید گفتن \" سمعنا\" ما شنیدیم ولی \"و اعصینا\" دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.42,
   "end": 228.14,
   "text": "بر سمت عصیان داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.14,
   "end": 232.96,
   "text": "جدی نگرفتن. نکته اینکه حالا بقیه آیه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.96,
   "end": 235.26,
   "text": "نکته ای که اینجا به ذهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.26,
   "end": 239.7,
   "text": "متبادر میشه خود شما هم دقت کنید اول ذهن شما رو بشورونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.7,
   "end": 244.12,
   "text": "با یه نکته ای و با یه سوالی بعد جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.12,
   "end": 251.14,
   "text": "چرا اینجا خدای متعال نفرموده و \"اشربوا فی قلوبه-فی قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.14,
   "end": 255.02,
   "text": "حب، حب العجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.02,
   "end": 258.6,
   "text": "و حب العجل بکفرهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.6,
   "end": 265.06,
   "text": "چرا فرموده \"فی قلوبهم العجل بکفرهم\" حب اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.06,
   "end": 269.56,
   "text": "ظاهرا درستش اینطوری به نظر میرسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.56,
   "end": 273.48,
   "text": "خدا بگه قلبشون آمیخته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.48,
   "end": 276.72,
   "text": "با محبت گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.72,
   "end": 279.38,
   "text": "به خاطر کفری که داشتن. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.38,
   "end": 283.56,
   "text": "اما اینجا بخوای ترجمه به ظاهر بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.56,
   "end": 286.66,
   "text": "یعنی قلب اینها آمیخته شد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.66,
   "end": 292.74,
   "text": "گوساله. اینجا چیزی ظاهرا از حب دیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.74,
   "end": 295.8,
   "text": "مفسرین معمولا این کار رو میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.8,
   "end": 298.92,
   "text": "مثلا که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.92,
   "end": 304.36,
   "text": "هر غالب تفاسیر رو شما برید نگاه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.36,
   "end": 310.62,
   "text": "اینچنین اومدن بیان کردن که اینجا حب به تقدیر گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.62,
   "end": 315.12,
   "text": "یعنی اینکه مضاف الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.12,
   "end": 318.38,
   "text": "در جای مضاف به کار رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.38,
   "end": 324.12,
   "text": "یعنی العجل اومده به جای حب قرار گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.12,
   "end": 328.4,
   "text": "حب اینجا در تقدیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.4,
   "end": 331.54,
   "text": "یعنی منظور نظر خدا حبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.54,
   "end": 336.26,
   "text": "حب العجل. این قاله مفسرین اینو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.26,
   "end": 338.86,
   "text": "اما یه نکته ای رو من میخوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.86,
   "end": 343.52,
   "text": "وقتی اینو من خودم دارم به شما تأسیسا عرض میکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.52,
   "end": 351.88,
   "text": "با برداشتی که از یکی از درسهای از علمای прежде علیه الرحمه در شرح مصباح الانس گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.88,
   "end": 356.44,
   "text": "وقتی که زیل آیه چهل و شش هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.44,
   "end": 360.5,
   "text": "میرسی \"قال یا نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.5,
   "end": 364.76,
   "text": "انه ليس من اهلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.76,
   "end": 369.18,
   "text": "گفته شد گفت که ای نوح این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.18,
   "end": 374.66,
   "text": "اِممم پسرش منظوره پسر نوح \"لیس من اهلك\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.66,
   "end": 377.8,
   "text": "اهل تو نیست. \"انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 377.8,
   "end": 382.5,
   "text": "عمل غیر صالح\". اون یعنی پسرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.5,
   "end": 386.7,
   "text": "عمل غیر صالحه. اینجا سؤال پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.7,
   "end": 390.12,
   "text": "که چرا گفته نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.12,
   "end": 393.1,
   "text": "\"انه ذو عمل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.1,
   "end": 396.94,
   "text": "او دارای عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.94,
   "end": 401.08,
   "text": "چرا قرآن میگه اون اصلاً خودش عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.08,
   "end": 404.32,
   "text": "متوجه میشی؟ آره. این سؤال مطرحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.32,
   "end": 407.72,
   "text": "چرا خدا نفرموده پسر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.72,
   "end": 410.7,
   "text": "دارای عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.7,
   "end": 416.08,
   "text": "اینو نفرموده. بلکه میگه اصلاً عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.08,
   "end": 423.5,
   "text": "خب؟ حالا یه روایتی هم اگر خواستید مراجعه کنید در تفسیر اهل بیت جلد شش صفحه ششصد و نود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.5,
   "end": 426.94,
   "text": "اونجا من دیدم که یک شخصی به نام وشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.94,
   "end": 434.34,
   "text": "از امام، امام رئوف حضرت اول حسن علی بن موسی الرضا علیه الصلاة والسلام پرسید که آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.34,
   "end": 439.46,
   "text": "حضرت ازش سؤال کرد که چگونه مردم اینو قرائت می‌کنند این آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.46,
   "end": 442.06,
   "text": "اون شخص عرض کرد که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.06,
   "end": 446.12,
   "text": "عده‌ای اینطوری قرائت می‌کنند که \"انه عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.12,
   "end": 449.74,
   "text": "غیر صالح\". یعنی اینکه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.74,
   "end": 453.4,
   "text": "عمل غیر صالحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 453.4,
   "end": 456.06,
   "text": "خب بعضیا هم اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.06,
   "end": 458.98,
   "text": "قرائت می‌کنند. \"انه عمل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.98,
   "end": 461.14,
   "text": "عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.14,
   "end": 465.46,
   "text": "غیر صالح. این ترجمه‌ش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.46,
   "end": 467.84,
   "text": "این میشه یعنی اون ثمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.84,
   "end": 470.92,
   "text": "عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.92,
   "end": 477.06,
   "text": "حضرت فرمودند این غلطه. اینطور تلفظ کردن و خوندن غلطه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.06,
   "end": 481.26,
   "text": "اون ثمره عمل غیر صالح نمی‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.26,
   "end": 485.76,
   "text": "چرا؟ چون ثمره صلب پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.76,
   "end": 488.62,
   "text": "پیغمبر که عمل غیر صالح نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.62,
   "end": 493.42,
   "text": "پس این غلطه که بگیم اینطوری بخونیم که \"انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.42,
   "end": 496.14,
   "text": "عمل غیر صالح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.14,
   "end": 499.56,
   "text": "او ثمره عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.56,
   "end": 505.14,
   "text": "چی درسته؟ همون که الان ما قرائت صحیح داریم از حفص از عاصم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.14,
   "end": 507.4,
   "text": "که \"انه عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 507.4,
   "end": 511.46,
   "text": "غیر صالح\" یعنی اون اصلاً عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.46,
   "end": 514.7,
   "text": "اینو داشته باشید. حالا علامه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.7,
   "end": 522.64,
   "text": "اشکال میکنه. البته علامه توی شرح مصباح الانس که سنگین‌ترین کتاب عرفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.64,
   "end": 527.14,
   "text": "و تو از جمله کتب سنگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.14,
   "end": 529.32,
   "text": "عرفانیه که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.32,
   "end": 532.0,
   "text": "آخرها خونده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.0,
   "end": 535.4,
   "text": "یعنی حتی بعد از فسوس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.4,
   "end": 538.74,
   "text": "بعد از فسوس ابن عربی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.74,
   "end": 543.56,
   "text": "مصباح الانس مرحوم ابن فناری خونده میشه بعد فتوحات ابن عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.56,
   "end": 547.66,
   "text": "خیلی کتاب. اونجا ایشون می‌فرماید البته علامه اشکال میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.66,
   "end": 549.9,
   "text": "میگه آقا این مفسرین شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.9,
   "end": 554.66,
   "text": "چرا برمی‌گردید میگید توی این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.66,
   "end": 556.98,
   "text": "ذو به تقدیر اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.98,
   "end": 562.74,
   "text": "یعنی خدا اگر گفته اون عمل غیر صالحه، منظور از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.74,
   "end": 565.2,
   "text": "اینه که ذو عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.2,
   "end": 567.58,
   "text": "یعنی اون دارای عمل صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.58,
   "end": 570.54,
   "text": "اون ذو در تقدیر اومده به تقدیر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.54,
   "end": 573.08,
   "text": "یعنی خدا نمی‌تونست عز و جل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.08,
   "end": 576.66,
   "text": "به جای عمل بگه ذو عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.66,
   "end": 581.18,
   "text": "به جای اینکه بگه اون عمل غیر صالحه، خدا نمی‌تونست بگه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.18,
   "end": 583.88,
   "text": "دارای عمل صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.88,
   "end": 588.98,
   "text": "چرا شما میخواید یه چیزی رو انتصاب بدید به خدا به زور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.98,
   "end": 594.54,
   "text": "علامه اشکال میکنه اینجا. چون ایشون اشکال میکنه ما هم جرات میکنیم بیایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.54,
   "end": 598.32,
   "text": "اینجا در خصوص نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.32,
   "end": 601.24,
   "text": "مفسرین پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.24,
   "end": 604.06,
   "text": "این \"فی قلوبهم الاجل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 604.06,
   "end": 606.78,
   "text": "که میگن اینجا حب در تقدیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.78,
   "end": 610.56,
   "text": "یعنی درستش حب بل اجل بوده این اشکال رو بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.56,
   "end": 613.6,
   "text": "پشت سر علامه راه بیفتیم بگیم آقا این اشکال به شما هم وارده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.6,
   "end": 619.14,
   "text": "یعنی چی؟ چرا به خدا اینو نسبت میدید که حتماً یه هبی در تقدیر بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.14,
   "end": 622.38,
   "text": "اتفاقاً نه خیر. همون که بر اساس اصل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.38,
   "end": 627.58,
   "text": "این خیلی مهمه این. اینو امروز ما بگیریم خیلی نکته مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.58,
   "end": 630.54,
   "text": "بر اساس این اصل، این اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 630.54,
   "end": 633.28,
   "text": "اصیل رکین رسینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.28,
   "end": 636.42,
   "text": "که جزاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 636.42,
   "end": 642.24,
   "text": "نفس عمله. و چقدر بزرگان در این خصوص قلم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 642.24,
   "end": 644.7,
   "text": "جزاء نفس عمله یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 644.7,
   "end": 649.34,
   "text": "اینکه \"فمن يعمل مثقال ذرة خيرا يره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 649.34,
   "end": 653.82,
   "text": "ومن يعمل مثقال ذرة شرا يره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.82,
   "end": 657.68,
   "text": "اینکه میبیند چی رو میبیند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.68,
   "end": 662.42,
   "text": "ثواب و عقاب رو میبینه یا خود عمل رو میبینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.42,
   "end": 666.48,
   "text": "میگه فمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.48,
   "end": 670.9,
   "text": "کسی که هر کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.9,
   "end": 676.38,
   "text": "ذره‌ای عمل غیر-- عمل خیر یا شر کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.38,
   "end": 678.28,
   "text": "درسته؟ عمل رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.28,
   "end": 683.44,
   "text": "يره. \"فمن يعمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.44,
   "end": 686.62,
   "text": "يعمل مثقال ذرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.62,
   "end": 690.18,
   "text": "خيرا أي شرا يره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.18,
   "end": 694.9,
   "text": "یعنی اون عمله رو میبینه. اینکه میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.9,
   "end": 701.58,
   "text": "جزاء نفس عمله اصلاً همین تا این عملی که انجام دادی تو همونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 701.58,
   "end": 705.44,
   "text": "تو همون عملی هستی که انجام دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 705.44,
   "end": 708.6,
   "text": "یعنی کتاب وجودیت رو داری مینویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 708.6,
   "end": 712.36,
   "text": "خط به خط، سطر به سطر، صفحه به صفحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.36,
   "end": 714.92,
   "text": "آخرش هم \"اقرأ كتابك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.92,
   "end": 717.14,
   "text": "كفى بنفسك اليوم عليك حسيبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 717.14,
   "end": 719.82,
   "text": "خودت حساب برای حسابرسی خودت کافی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 719.82,
   "end": 724.22,
   "text": "خودت خودتو بخون. کتاب وجودی خودتو خودت خودتو میخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.22,
   "end": 726.54,
   "text": "نیازی با کسی هم دعوا نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 726.54,
   "end": 730.92,
   "text": "خودت اینچنین خودت رو نوشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 730.92,
   "end": 735.6,
   "text": "تو همون عملتی. لذا علامه می‌فرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.6,
   "end": 737.98,
   "text": "ماحصل ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 737.98,
   "end": 740.66,
   "text": "علم و عملمون. ما اصلاً چیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 740.66,
   "end": 745.02,
   "text": "ما چی هستیم؟ ما مجموعه‌ای هستیم از علم و عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.02,
   "end": 748.4,
   "text": "علم و عمل جوهرند انسان‌ساز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.4,
   "end": 750.94,
   "text": "علم و عمل ما داره ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 750.94,
   "end": 752.92,
   "text": "ما چیزی جز علم و عملمون نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 752.92,
   "end": 755.84,
   "text": "ما ادعا نیستیم که بگیم آقا من پشت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 755.84,
   "end": 762.56,
   "text": "من عاشقم، سینه چاک امیرالمؤمنینم و من این ادعا که کار درست نمی‌شه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 762.56,
   "end": 766.28,
   "text": "عملت چیه؟ باور و اعتقاد و علمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.28,
   "end": 770.46,
   "text": "این دو تا داره تو رو می‌سازه. تو همونایی چیزی جز اون نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.46,
   "end": 773.8,
   "text": "این که میگن آقا هر عملی یه شکر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 773.8,
   "end": 777.84,
   "text": "یعنی اصلاً همین که اجازه دادن تو این عمل رو انجام بدی عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 777.84,
   "end": 783.92,
   "text": "خیر رو، همین که اجازه دادن نماز بخونی، اجازه دادن دعا کنی، اجازه دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 783.92,
   "end": 786.24,
   "text": "زیارت بری این نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 786.24,
   "end": 788.86,
   "text": "این جزای توئه. اصلاً جزا نفس عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 788.86,
   "end": 794.52,
   "text": "اصلاً جزای تو همینه که اجازه پیدا کردی در بارگاه حضرت حق حاضر بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 794.52,
   "end": 799.46,
   "text": "به حس حضور برسی. متوجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.46,
   "end": 802.78,
   "text": "این خیلی مهمه ها. لذا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.78,
   "end": 806.68,
   "text": "میاد میگه آقا به یک معنا شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.68,
   "end": 811.28,
   "text": "عمل یا اصرار بر عمل یا شدت حب رو داره می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 811.28,
   "end": 814.4,
   "text": "اینجا که می‌فرماید به نهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 814.4,
   "end": 817.24,
   "text": "عمل غیر صالح فرزند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 817.24,
   "end": 822.48,
   "text": "نوح اصلاً خود عمل غیر صالحه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 822.48,
   "end": 824.8,
   "text": "یعنی این چیزی که الان ما داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.8,
   "end": 828.74,
   "text": "یعنی اصلاً حضرت نوح چیزی نیست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 828.74,
   "end": 831.94,
   "text": "فرزندش چیزی نیست جز عملی که انجام داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 831.94,
   "end": 836.18,
   "text": "خب درسته؟ چون عملش ناسالح بوده پس خودش هم عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 836.18,
   "end": 842.12,
   "text": "تموم شده. یا اینجا تو آیه برگردیم به آیه خ-- که مورد بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 842.12,
   "end": 846.48,
   "text": "اینجا که می‌فرمود و اشرب فی قلوبهم العجل بکفرهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 846.48,
   "end": 849.74,
   "text": "چرا نفرمود حب العجل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 849.74,
   "end": 853.42,
   "text": "بلکه فرمود فی قلوبهم العجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 853.42,
   "end": 864.84,
   "text": "حب رو نیاورد به جهت اینکه انقدر این‌ها دلبسته به گوساله که در حقیقت مخلص و زبده و چکیده و عصاره طلاهاشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 864.84,
   "end": 867.6,
   "text": "انقدر اینا غرق در دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.6,
   "end": 869.64,
   "text": "حب دنیا بودن و عاشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 869.64,
   "end": 871.74,
   "text": "طلا که مصداق دنیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 871.74,
   "end": 875.02,
   "text": "حالا شبیه گوساله دراومده، بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 875.02,
   "end": 878.6,
   "text": "میگه اصلاً اینا نوشانده شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 878.6,
   "end": 880.56,
   "text": "دل‌هاشون با گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.56,
   "end": 884.8,
   "text": "نمیگه حب گوساله. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 884.8,
   "end": 891.02,
   "text": "یعنی اصلاً خود گوساله. اصلاً انگار اینا شدن خود گوساله .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.02,
   "end": 892.96,
   "text": "خود گوساله چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 892.96,
   "end": 897.04,
   "text": "طلا بود. این که یه آیه از قرآن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 897.04,
   "end": 902.22,
   "text": "می‌فرماید این ذخیره‌ها، سکه‌هایی که ذخیره می‌کنند ما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 902.22,
   "end": 905.0,
   "text": "پیشانی‌هاشون می‌چسبونیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 905.0,
   "end": 907.36,
   "text": "اینا یعنی اصلاً اینا شما همینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 907.36,
   "end": 910.76,
   "text": "شما آخرتون همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 910.76,
   "end": 915.14,
   "text": "همین زر و سیم و دنیایی هستید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 915.14,
   "end": 918.62,
   "text": "نزد خدا پست‌ترین چیزهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 918.62,
   "end": 922.98,
   "text": "یعنی شما همونی هستید که دارید عمل می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 922.98,
   "end": 925.68,
   "text": "پس اینجا دقت بفرمایید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 925.68,
   "end": 928.66,
   "text": "اینجا علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 928.66,
   "end": 931.88,
   "text": "اخ-- علت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 931.88,
   "end": 937.24,
   "text": "میثاق ولایت امیرالمؤمنین رو انقدر که اهمیت داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 937.24,
   "end": 939.64,
   "text": "خدا کوه طور رو بالا سر اینا آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 939.64,
   "end": 942.78,
   "text": "اما اینا این میثاق رو شکستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 942.78,
   "end": 946.62,
   "text": "علت اینکه این میثاق رو شکستن چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 946.62,
   "end": 950.3,
   "text": "چون دلشون پر شده بود از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 950.3,
   "end": 953.96,
   "text": "بهتره بگیم نه حتی حب دنیا، اصلاً خود دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 953.96,
   "end": 957.94,
   "text": "دل پر شده بود از دنیا .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 957.94,
   "end": 963.0,
   "text": "درست شد؟ حالا چرا دل پر شده بود از حب دنیا، از دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 963.0,
   "end": 966.2,
   "text": "چون بکفرهم که جلسه پیش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 966.2,
   "end": 971.58,
   "text": "چون اینا اصلاً تو دلشون-- یعنی دل نداده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 971.58,
   "end": 976.92,
   "text": "دل نفس-- نسپردده بودن به خدا و حجت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 976.92,
   "end": 984.12,
   "text": "لغلغه زبون. لذا اون بالا می‌فرماید قال و اینا گفتن سمعنا باشه ما شنیدیم و عصینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 984.12,
   "end": 988.62,
   "text": "عصیان هم کرد. چرا عصینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 988.62,
   "end": 996.66,
   "text": "مگه سمعنا نبود؟ مگه شنیدن-- ببین پیداست این شنیدن، اون شنیدنی نیستش که قبلش خدا می‌فرماید و اسمعوا بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 996.66,
   "end": 999.16,
   "text": "یعنی گوش جان نسپردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 999.16,
   "end": 1004.2,
   "text": "ما قبلاً توی بحثی گفتیم که دهان روح گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1004.2,
   "end": 1007.48,
   "text": "و اسمعوا یعنی جانتو به من بسپر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1007.48,
   "end": 1010.94,
   "text": "یعنی با زب-- با دلت حرف منو بپذیر و گوش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1010.94,
   "end": 1012.52,
   "text": "یعنی دل بسپر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1012.52,
   "end": 1016.06,
   "text": "یعنی دل بده، عاشق شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1016.06,
   "end": 1020.78,
   "text": "اینجا جایگاه عشق و حب و محبت پیدا می‌شه و آمنوا، آمنوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1020.78,
   "end": 1026.74,
   "text": "آمنوا دلدادگیه و عمل الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1026.74,
   "end": 1029.86,
   "text": "اصلاً چشم به سمتی میره که دل بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1029.86,
   "end": 1032.88,
   "text": "دستور میده. ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1032.88,
   "end": 1035.12,
   "text": "جلسمون فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1035.12,
   "end": 1037.72,
   "text": "امیرالمؤمنین علیه السلام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1037.72,
   "end": 1041.74,
   "text": "بیست دقیقه نشده؟ عیب نداره حالا یه ذره زودتر تموم کن عیب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1041.74,
   "end": 1043.48,
   "text": "مولا عجب فرمایشی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1043.48,
   "end": 1047.04,
   "text": "بارها در عظمت این فرمایش مولا ما گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1047.04,
   "end": 1050.6,
   "text": "که البصره برید القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1050.6,
   "end": 1053.04,
   "text": "یه جا هم فرمود برید العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1053.04,
   "end": 1057.2,
   "text": "یعنی برید یعنی جاسوس. یعنی چشم جاسوس قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1057.2,
   "end": 1061.64,
   "text": "اگر چشم هرجایی شده چون قلب هرجاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1061.64,
   "end": 1068.3,
   "text": "چون قلب دستور به جاسوس میده که کجاها برو تفحص کن، تجسس کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1068.3,
   "end": 1071.36,
   "text": "قلب آلوده شده که چشم رو به هر جایی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1071.36,
   "end": 1074.08,
   "text": "البته اینو بگیم در ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1074.08,
   "end": 1077.08,
   "text": "آلودگی از پایین میاد. در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1077.08,
   "end": 1086.26,
   "text": "بحث رساله سیر رسول که سید بهاءالدین علم علیه رحمة گفتیم آلودگی از مرتبه نازل میاد به بالا، نه از بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1086.26,
   "end": 1091.06,
   "text": "از پایین اول چشم پرش پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1091.06,
   "end": 1094.64,
   "text": "حور-- حرق شکنی می‌کنه، خط قرمز الهی رو می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1094.64,
   "end": 1102.46,
   "text": "بعد اون آلودگی اصرار که باشه آلودگی میاد بالا، میاد بالا تا اصرار، اصرار، اصرار می‌رسه به قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1102.46,
   "end": 1107.02,
   "text": "اون موقع دیگه وقتی قلب آلوش-- آلوده شد دیگه چشم جاسوس قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1107.02,
   "end": 1109.36,
   "text": "قلب دیگه اون دستور میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1109.36,
   "end": 1112.38,
   "text": "حالا چشمی که پاکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1112.38,
   "end": 1115.82,
   "text": "قلب اصلاً بهش اجازه نمیده که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1115.82,
   "end": 1121.22,
   "text": "زشتی‌ها، پر-- پستی‌ها، مظاهر گناه و اینا دوخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1121.22,
   "end": 1127.44,
   "text": "می‌شه مثل علامه طباطبایی که می‌فرماید انقدر من رو چشمم کار کردم خودبه‌خود وقتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1127.44,
   "end": 1133.56,
   "text": "مح-- محیط و منظر گناه قرار می‌گیرم اصلاً ناخودآگاه پلکم بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1133.56,
   "end": 1136.62,
   "text": "یعنی قلب چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1136.62,
   "end": 1141.2,
   "text": "آراسته است لا یمسه الّا المتحرون که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1141.2,
   "end": 1145.5,
   "text": "ناخودآگاه چشم رو می‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 287,
   "start": 1145.5,
   "end": 1151.82,
   "text": "اما اونا چون قلبشون پر بود از دنیا فقط هم مظاهر دنیا رو می‌دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 288,
   "start": 1151.82,
   "end": 1153.82,
   "text": "الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 289,
   "start": 1153.82,
   "end": 1156.98,
   "text": "صلوات ختم کنیم. اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}