 "chapters": [
  {
   "index": 0,
   "title": "## قلب مشروب و خطر تعلق به غیر",
   "start": 9.48,
   "end": 113.38
  },
  {
   "index": 1,
   "title": "## روایت امام صادق؛ کوه را می‌توان کند، دین مؤمن را نه",
   "start": 113.38,
   "end": 240.9
  },
  {
   "index": 2,
   "title": "## حکمت سیصدوسی‌سه؛ أصلب من الصلد",
   "start": 240.9,
   "end": 275.36
  },
  {
   "index": 3,
   "title": "## صلابت رهبر؛ طهارت و اطمینان",
   "start": 275.36,
   "end": 595.51
  },
  {
   "index": 4,
   "title": "## مسیر نفوذ آلودگی از حواس تا روح",
   "start": 595.51,
   "end": 688.49
  },
  {
   "index": 5,
   "title": "## نشانه‌های آلودگی در هر لایه",
   "start": 688.49,
   "end": 864.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.04,
   "end": 3.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 9.48,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.48,
   "end": 16.12,
   "text": "در بحث قلب در قرآن رسیده بودیم به قلب مشروب، قلب آمیخته با غیر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.12,
   "end": 18.74,
   "text": "که محبت و تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.74,
   "end": 21.0,
   "text": "اضافی به خودش گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.0,
   "end": 23.36,
   "text": "تعلق پیدا کرده به غیر حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.36,
   "end": 26.46,
   "text": "خیلی خطرناکه این نوع قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.46,
   "end": 34.56,
   "text": "که رسیده بودیم به این نکته از آیه نود و سه سوره بقره که پیرامون همین موضوع هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.56,
   "end": 39.82,
   "text": "که اشاره میکنه به اهمیت شنیدن، حرف گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.82,
   "end": 45.42,
   "text": "اینکه کسی حوصله نداره حرف گوش بده، حرف حق بشنوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.42,
   "end": 51.42,
   "text": "این نشانه اینه که افتاده تو ورطه یعنی ورطه یعنی از هلاکت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.42,
   "end": 59.56,
   "text": "در ورطه قلب مشروب یعنی قلبش قاطی شده با محبت به غیر خدا و غیر حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.56,
   "end": 63.28,
   "text": "و الا از شنیدن و گوش دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.28,
   "end": 64.92,
   "text": "به حرف حق لذت میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.92,
   "end": 69.5,
   "text": "\"و اذ اخذنا میثاقکم و رفعنا فوقکم الطور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.5,
   "end": 74.3,
   "text": "اینا رو که گفتیم این میثاق چیه و کوه طور چرا بالا سر اینا قرار گرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.3,
   "end": 76.38,
   "text": "\"خذو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.38,
   "end": 78.82,
   "text": "ما آتيناکم بقوة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.82,
   "end": 84.22,
   "text": "بعد از اینکه میفرماید بگیرید اونچه که بر شما اومد با قوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.22,
   "end": 89.48,
   "text": "در خصوص اون آیه که سپاه استفاده کرده \"واعددوا ما استطعتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.48,
   "end": 93.04,
   "text": "من قوة\". این قوة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.04,
   "end": 95.82,
   "text": "قوة میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.82,
   "end": 102.86,
   "text": "برای مقابله با دشمنان هرچی توان دارید، قوه دارید به کار ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.86,
   "end": 112.64,
   "text": "اینجا داره میفرماید \"خذو ما آتيناکم بقوة\" آنچه که بر شما آمد نازل شد یعنی در امر دینتون مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.64,
   "end": 114.68,
   "text": "با قوت رفتار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.68,
   "end": 117.18,
   "text": "بعد میفرماید \" واسمعوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.18,
   "end": 121.26,
   "text": "که اگر کسی، دقت بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.26,
   "end": 124.1,
   "text": "اگر کسی حوصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.1,
   "end": 127.4,
   "text": "این \"واسمعوا\" رو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.4,
   "end": 130.6,
   "text": "یعنی حوصله نداره گوش بده به حرف حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.6,
   "end": 133.9,
   "text": "حالا از زبان هر کی، یه آلوده‌ای مثل منم بیرون اومد، اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.9,
   "end": 139.08,
   "text": "حرف، حرف حقه. آیات الهیه، روایات آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.08,
   "end": 144.34,
   "text": "کسی حوصله نداره. این نشانه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.34,
   "end": 147.24,
   "text": "اینه که \"بقوة\" نگرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.24,
   "end": 151.12,
   "text": "اونچه که از سمت حضرت حق نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.12,
   "end": 157.56,
   "text": "چون بلافاصله بعد از \"خذو\" بگیرید \"ما آتيناکم\" آنچه که به شما آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.56,
   "end": 161.72,
   "text": "از طرف ما یعنی هرچی ما بر شما آوردیم \"بقوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.72,
   "end": 166.58,
   "text": "محکم بگیرید یعنی جدی بگیرید یعنی شوخی نگیرید امر دینتون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.58,
   "end": 171.2,
   "text": "بعد میفرماید \"واسمعوا\" آقا این حرفو بشنویدا به جانتون بشنویدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.2,
   "end": 173.68,
   "text": "حالا بعد میگن که قبلاً بحثش رو کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.68,
   "end": 177.66,
   "text": "بعد گفتن \"قالوا سمعنا\" بله ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.66,
   "end": 180.7,
   "text": "گوش دادیم \"وعصینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.7,
   "end": 186.06,
   "text": "ولی معصیت\". میگه که ادعا می‌کنند که گوش دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.06,
   "end": 189.32,
   "text": "اما گوش دادنی که منجر به معصیت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.32,
   "end": 192.86,
   "text": "چرا؟ چون صرفاً گوش ظاهری‌شون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.86,
   "end": 194.8,
   "text": "یعنی دل ندادن به حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.8,
   "end": 198.02,
   "text": "این دل ندادن نتیجه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.02,
   "end": 200.52,
   "text": "میشه قلب مشروب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.52,
   "end": 205.2,
   "text": "دل متعلق میشه، تعلق پیدا میکنه، متعلقش میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.2,
   "end": 212.14,
   "text": "هر چیز غیر از حق. خب پس چی باعث شده که اینا حرف حق رو نشنوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.14,
   "end": 219.48,
   "text": "عدم جدیت و قوت در امر دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.48,
   "end": 223.7,
   "text": "که حالا اینجا بزرگان کتاب‌ها نوشتن دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.7,
   "end": 226.64,
   "text": "که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.64,
   "end": 230.44,
   "text": "اهمیت و جدیت دادن به امر دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.44,
   "end": 233.44,
   "text": "مهمه. من به عنوان نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.44,
   "end": 240.34,
   "text": "فرمایش امیرالمؤمنین علیه الصلاة والسلام یه بخشیش رو از خطبه بیست و نه براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.34,
   "end": 242.88,
   "text": "فرمایش مولا رو بشنوید لذت ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.88,
   "end": 248.98,
   "text": "\"ولا یمنع ال-- ولا یمنع ضعیف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.98,
   "end": 251.92,
   "text": "میفرماید که \"من الضعیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.92,
   "end": 256.08,
   "text": "هرگز یه آدم ضعمو-- زبون و ذلیل، پست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.08,
   "end": 259.5,
   "text": "این‌ها نمی‌تونه با ظلم مقابله کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.5,
   "end": 262.16,
   "text": "نمی‌تونه جلوی ظلم وایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.16,
   "end": 264.52,
   "text": "\"ولا یدرک الحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.52,
   "end": 269.06,
   "text": "الا بالجد\" و هرگز نمیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.06,
   "end": 272.8,
   "text": "به حق رسید \"لا یدرک الحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.8,
   "end": 277.28,
   "text": "الا بالجد\" مگر اینکه با جدیت، جدیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.28,
   "end": 281.06,
   "text": "همون که قبلاً عرض کردیم اصلاً فصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.06,
   "end": 283.28,
   "text": "تمایز امثال بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.28,
   "end": 287.02,
   "text": "با اولیای خدا در همین جدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.02,
   "end": 291.2,
   "text": "اونا حرف حق رو، امر حق رو، دین رو جدی گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.2,
   "end": 297.24,
   "text": "\"خذو ما آتيناکم بقوة\" اینجا رو گوش دادن \"واسمعوا\" رو گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.24,
   "end": 301.18,
   "text": "گوش جان سپردن به امر دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.18,
   "end": 302.96,
   "text": "حالا امر دین کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.96,
   "end": 307.84,
   "text": "پیش صاحب الامر دیگه \"و اول الامر منکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.84,
   "end": 310.32,
   "text": "دل سپردن به امام عصرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.32,
   "end": 316.52,
   "text": "حالا اینجا میفرماید مولا داره تأکید می‌کنه آقا اصلاً نمیشه درک کرد حق رو مگر با جدیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.52,
   "end": 320.1,
   "text": "پس چرا خیلی از آدم‌ها هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.1,
   "end": 324.84,
   "text": "که درکی از حق ندارند یا حق رو اونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.84,
   "end": 327.3,
   "text": "شایسته است درک نمی‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.3,
   "end": 330.66,
   "text": "تو این قصه ضعف دارند. اینجا داره حضرت رمزگشایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.66,
   "end": 335.14,
   "text": "می‌فرماید \"الا بالجد\" چون جدیت ندارن، بازی گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.14,
   "end": 338.26,
   "text": "می‌خوان خوش باشن دو روزه دنیا رو کیف‌شونو بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.26,
   "end": 342.44,
   "text": "اینا حالا دیندار هم باشن و ال-- وقت معصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.44,
   "end": 346.9,
   "text": "بله قربانگوی نفسشون باشن اما در عین حال در کسوت دین هم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.9,
   "end": 351.48,
   "text": "این جدیت نیست که. و لذا می‌بینید که سر می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.48,
   "end": 357.36,
   "text": "به انواع اقسام گناهان. امام صادق صلوات الله علیه یه فرمایشی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.36,
   "end": 362.14,
   "text": "بیشتر از این جمله‌ای که الان من یه بخشیش رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.14,
   "end": 366.83,
   "text": "کافی جلد پنج صفحه شصت و سه می‌تونید متن روایت رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.83,
   "end": 369.05,
   "text": "امام کشاف حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.05,
   "end": 371.43,
   "text": "حضرت جعفر بن محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.43,
   "end": 374.23,
   "text": "صادق فرمودند \"ان الجبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.23,
   "end": 379.49,
   "text": "یستقل منه بالمعول\" معول یعنی کلنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.49,
   "end": 384.55,
   "text": "میشه یک کوه رو بکنی ازش با کلنگ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.55,
   "end": 388.09,
   "text": "\"یستقل منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.09,
   "end": 393.07,
   "text": "بالمعول\" استقلال بدی از-- ببخشی از اون کوه بکنی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.07,
   "end": 396.73,
   "text": "با کلنگ. اما \"و المؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.73,
   "end": 399.17,
   "text": "لا یستقل من دینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.17,
   "end": 405.23,
   "text": "شیئاً\" اصلا هیچی از دین مؤمن نمیتونی بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.23,
   "end": 408.75,
   "text": "مؤمن کسی که دل سپرده مؤمن اسمش رو خودشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.75,
   "end": 412.87,
   "text": "دل داده آقا. همه تعلقاتش در حوزه دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.87,
   "end": 417.51,
   "text": "نمیتونی با کلنگ و نمی‌دونم تیشه و چی و این‌ها بکنی ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.51,
   "end": 422.83,
   "text": "این نشان دهنده چیه؟ جدیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 422.83,
   "end": 425.95,
   "text": "یا مثلا مولامون علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.95,
   "end": 431.83,
   "text": "در حکمت سیصد و سی و سه نهج فرمودند \"المؤمن نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.83,
   "end": 433.55,
   "text": "أصلب من السلد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.55,
   "end": 438.33,
   "text": "به به، به به. فرمود مؤمن نفسش، جانش، اون روحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.33,
   "end": 440.75,
   "text": "سخت‌تر از سنگ خارا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.75,
   "end": 444.47,
   "text": "محکم‌تر از سنگ خارا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.47,
   "end": 448.09,
   "text": "اصلا سنگ خارا یه دلیلی که بهش میگن خارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.09,
   "end": 451.93,
   "text": "به جهت استحکامشه. اینا محکم‌تر از اینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.93,
   "end": 457.89,
   "text": "حالا چرا محکمه؟ چون حرف گوش، گوش جان سپرده \"و سمع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.89,
   "end": 461.85,
   "text": "گوش جان سپرده لذا گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.85,
   "end": 467.01,
   "text": "و به قوت. کسی هم که به قوت امر دین رو بگیره تزلزل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.01,
   "end": 469.49,
   "text": "ضعف نداره. چون گناه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.49,
   "end": 473.29,
   "text": "اصلا ضعف و تزلزل عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.29,
   "end": 478.41,
   "text": "ماره گناهه. هرچی انسان پاک‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.41,
   "end": 481.11,
   "text": "قوت و قدرتش و اس-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.11,
   "end": 485.69,
   "text": "استحکامش، حکمت وجودیش بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.69,
   "end": 488.45,
   "text": "خدای حکیم علی الاطلاق انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.45,
   "end": 490.37,
   "text": "با حکمتش آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.37,
   "end": 497.47,
   "text": "هرچی که طهارت به عالم بر اساس طهارت خلق شده دیگه مزاج عالم بر اساس طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.47,
   "end": 499.89,
   "text": "هرچی طهارت نفس بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.89,
   "end": 502.99,
   "text": "قوت نفس بیشتر. اینکه میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.99,
   "end": 506.05,
   "text": "امام، رهبر خم به ابرو نمیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.05,
   "end": 508.05,
   "text": "تمام دنیا سفارشی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.05,
   "end": 510.05,
   "text": "الان اسرائیل قطقط می‌کنه بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.05,
   "end": 513.55,
   "text": "برای امثال رهبر قطقط کردنه چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.55,
   "end": 516.99,
   "text": "اصلا سرش-- حالا من الان خنده‌ش می‌گیره این بحث نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.99,
   "end": 521.73,
   "text": "رهبر رو بعضیا چرت و پرت‌هایی، مزخرفاتی گفتن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.73,
   "end": 523.31,
   "text": "العیاذ بالله ترسیده و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.31,
   "end": 526.85,
   "text": "یه، یه جایی رو نگاه می‌کنه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.85,
   "end": 528.61,
   "text": "حالا بعضیا گفتن محرابو نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.61,
   "end": 532.27,
   "text": "اینقدر بی‌شعور و نفهم‌اند بر نسبت شما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.27,
   "end": 534.81,
   "text": "اگه می‌خواست بترسه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.81,
   "end": 538.37,
   "text": "چند ساله کشتی انقلاب رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.37,
   "end": 541.19,
   "text": "دریای مواج مشکلات داره مدیریت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.19,
   "end": 543.55,
   "text": "اصلا نمی‌اومد نماز اگه بحث ترس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.55,
   "end": 547.93,
   "text": "اینقدر بعضیا خرفت‌ند بر، بر نسبت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.93,
   "end": 550.73,
   "text": "خب این نشانه صلابتشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.73,
   "end": 552.99,
   "text": "این اطمینان نفس از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.99,
   "end": 557.17,
   "text": "طهارت. مزاج عالم هم بر اساس طرا-- طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.17,
   "end": 560.01,
   "text": "وقتی شما طاهر بودی، وقتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 560.01,
   "end": 566.77,
   "text": "سلام انتهای نمازت به عالم سلام می‌کنی، السلام علیکُم از امام عصر گرفته و انبیا تا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.77,
   "end": 569.33,
   "text": "خلائق اینا همه تسلیم تو می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.33,
   "end": 575.15,
   "text": "چرا نباشن؟ و تو چنان به استحکام و صلابت می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.15,
   "end": 577.61,
   "text": "محکم. بعد بهت میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.61,
   "end": 580.35,
   "text": "تو کی پشتته؟ خیلی جگر داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.35,
   "end": 583.97,
   "text": "خیلی جسوری. میگه نه کسی-- خدا پشت منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.97,
   "end": 587.01,
   "text": "فکر می‌کنن همه چی در قوالب مادی می‌گنجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.01,
   "end": 589.61,
   "text": "حالا آلودگی‌ها رو باید مراقب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.61,
   "end": 591.35,
   "text": "آلودگی تزلزل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.35,
   "end": 594.85,
   "text": "من خیلی نکته‌وار و در انتهای بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.85,
   "end": 599.89,
   "text": "بگم که این آلودگی اولا از کجا میاد و لایه‌های وجودی رو چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.89,
   "end": 601.87,
   "text": "نشت می‌کنه و نشانه‌هاش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.87,
   "end": 605.59,
   "text": "آلودگی اولا از مرتبه نازل میاد، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.59,
   "end": 609.65,
   "text": "اعلا مرتبه که روح و اون اشخص مراتب وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.65,
   "end": 611.67,
   "text": "از بالا نمیاد. قبلا بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.67,
   "end": 615.35,
   "text": "آلودگی از انزل مراتب، از نشئ ماده و طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 615.35,
   "end": 618.23,
   "text": "از حواس ظاهری ما میاد، از جسم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.23,
   "end": 622.55,
   "text": "یعنی از چشم و گوش و سمع و بصر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.55,
   "end": 625.59,
   "text": "س-- شم و از چه باید-- لمس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.59,
   "end": 628.69,
   "text": "ذوق. از این پنج تا ذائقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.69,
   "end": 631.71,
   "text": "از این پنج تا حواس ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 631.71,
   "end": 634.27,
   "text": "آلودگی از اینجا شروع میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.27,
   "end": 636.43,
   "text": "خط قرمزها رو رد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.43,
   "end": 639.71,
   "text": "بعد میزنه یواش یواش آلودگی نشت می‌کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 639.71,
   "end": 643.71,
   "text": "خاطر اصرار بر گناه میزنه قوه خیال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.71,
   "end": 651.29,
   "text": "آلوده می‌کنه. خدا نکنه کسی قوه خیالش آلوده بشه سخت میشه دیگه پاک کردن متخیلات فاسده به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.29,
   "end": 655.01,
   "text": "اصرار کنه میزنه عقلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.01,
   "end": 658.47,
   "text": "آلوده می‌کنه. خیلی دیگه کار خطرناک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.47,
   "end": 661.59,
   "text": "اصرار رو به گناه ببره دیگه قلبش آلوده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.59,
   "end": 665.61,
   "text": "امان از کسی که قلبش آلوده شد، قلب مشرب پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.61,
   "end": 668.41,
   "text": "این دیگه بیرون اومدنش خیلی سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.41,
   "end": 673.19,
   "text": "و امان از کسی که دیگه این آلودگی بزنه از قلب به روحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 673.19,
   "end": 677.31,
   "text": "اون دیگه مگر امام عصر توجه کنه که بتونه نجات پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 677.31,
   "end": 679.79,
   "text": "حالا بعد سر هم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 679.79,
   "end": 684.55,
   "text": "اما دیگه سر رو سر نداریم چون اون کانال وجودی ارتباط با حق و رب وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.55,
   "end": 688.21,
   "text": "اصلا اون دیگه آلوده بردار نیست. حالا از این پایین شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 688.21,
   "end": 692.75,
   "text": "آ-- نشانه‌های آلودگی هم از حواس ظاهر که مشخصه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 692.75,
   "end": 696.07,
   "text": "چشم پرش می‌کنه، رد می‌کنه خط قرمز الهی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.07,
   "end": 698.47,
   "text": "گوش همینطور و... باطن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 698.47,
   "end": 700.75,
   "text": "میری به لایه‌های باطنی. قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 700.75,
   "end": 702.45,
   "text": "خیال آلوده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 702.45,
   "end": 705.43,
   "text": "یکی از نشانه‌هاش عمدت-- عدم تمرکزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 705.43,
   "end": 708.81,
   "text": "تمرکز وجودی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.81,
   "end": 711.63,
   "text": "افکارش به هم ریخته‌ست. تشویش خاطر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 711.63,
   "end": 714.95,
   "text": "مضطربه. تصمیم جدی نمی‌تونه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 714.95,
   "end": 719.35,
   "text": "اینا نشانه‌هاشه. چون قوه خیالش مشوش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 719.35,
   "end": 721.25,
   "text": "آ-- س-- همش سوءظن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 721.25,
   "end": 725.65,
   "text": "اینا نشانه‌های آلودگی قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 725.65,
   "end": 728.43,
   "text": "اگر زد به عقل نشونش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.43,
   "end": 731.66,
   "text": "اینه که چون عقل برای جاهای پیچیده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 731.66,
   "end": 737.58,
   "text": "حوصله‌ی شنیدن مسائل قامض و پیچیده و سخت علمی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 737.58,
   "end": 740.82,
   "text": "این‌ها رو نداره. میگه آقا یه داستان بگو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 740.82,
   "end": 744.38,
   "text": "انقدر سختش نگیر. این معلومه عقلش آلوده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 744.38,
   "end": 748.24,
   "text": "\"و یجعل الرجس على الذین لا يعقلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 748.24,
   "end": 751.4,
   "text": "عقل رو که تعطیل کنی رجس آلودگی اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 751.4,
   "end": 754.18,
   "text": "اگر عقل آلوده شد قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 754.18,
   "end": 758.74,
   "text": "کار تمامه. دیگه انسان حوصله نداره اصلاً بره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 758.74,
   "end": 762.4,
   "text": "مثلاً اون ذرائف بحث حکمت و عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 762.4,
   "end": 764.94,
   "text": "اصلاً میگه ول کن این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 764.94,
   "end": 767.2,
   "text": "یه عده خوندن از خودشون معرکه گیری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 767.2,
   "end": 771.02,
   "text": "یه نمازامونو بخونیم بریم. اصلاً حوصله نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 771.02,
   "end": 774.9,
   "text": "چرا؟ قلب، ببخشید عقل، عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 774.9,
   "end": 777.52,
   "text": "مشوب به وهم شده و توهمی زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 777.52,
   "end": 780.56,
   "text": "اگر زد به باطن‌تر قلب خدا نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 780.56,
   "end": 783.3,
   "text": "قلب اگر آلوده شه چیه؟ دیگه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 783.3,
   "end": 786.84,
   "text": "محل تعلقه دیگه قلب. نشونه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 786.84,
   "end": 789.38,
   "text": "از چیزهایی که نماد مذهب‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 789.38,
   "end": 792.14,
   "text": "نماد معنویت و دین و ولایت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 792.14,
   "end": 795.42,
   "text": "خیلی دوست نداره، لذت نمی‌بره یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 795.42,
   "end": 799.58,
   "text": "محبتش به اینا رفته رفته کم می‌شه، تعلقش کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 799.58,
   "end": 803.94,
   "text": "هیئت می‌بینه، حرم می‌بینه، بچه هیئتی می‌بینه، آخوند می‌بینه بدش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 803.94,
   "end": 806.98,
   "text": "یا اگر بدش نیاد خیلی تعلق نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 806.98,
   "end": 811.28,
   "text": "اه پیش تلویزیون بزن یه کانال دیگه این آخوندام ولمون نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 811.28,
   "end": 814.44,
   "text": "خب آخوندها کی‌ان مگه؟ تو لباس دینن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 814.44,
   "end": 816.88,
   "text": "چرا لباس دین رو می‌بینی بدت میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 816.88,
   "end": 824.86,
   "text": "قلب آلوده شده. یه وقت یه آخوندی فساد می‌کنه، خب شخص اون طرف، اون، اون شخصه، اون فرد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 824.86,
   "end": 828.82,
   "text": "باهاش مخالفت کن نه با این لباس که هر آخوندی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 828.82,
   "end": 830.58,
   "text": "این نشانه آلودگی چیه؟ قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 830.58,
   "end": 833.24,
   "text": "رفته رفته تعلقش کنده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 833.24,
   "end": 836.06,
   "text": "اگر زد به روح چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 836.06,
   "end": 838.92,
   "text": "نشانه‌ش اینه که دیگه میفته به عناد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 838.92,
   "end": 841.18,
   "text": "پشت می‌کنه به معنویات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 841.18,
   "end": 847.4,
   "text": "میفته به دشمنی. حاضره جون بده ولی چهره‌ی اهل ایمان رو نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 847.4,
   "end": 852.5,
   "text": "اینم نشانه‌هاش بود حالا و نشانه شناسی کنیم که هر کدوم شربت منبر‌ها می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 852.5,
   "end": 855.66,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 855.66,
   "end": 857.94,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 857.94,
   "end": 864.1,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}