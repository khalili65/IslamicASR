   "title": "## نقض پیمان و آمیختگی قلب",
   "start": 14.4,
   "end": 72.04
  },
  {
   "index": 1,
   "title": "## سمعنا و عصینا؛ جدایی زبان و دل",
   "start": 72.04,
   "end": 240.82
  },
  {
   "index": 2,
   "title": "## ظاهر و باطن و توحید",
   "start": 240.82,
   "end": 391.32
  },
  {
   "index": 3,
   "title": "آیه می‌فرماید:",
   "start": 391.32,
   "end": 487.12
  },
  {
   "index": 4,
   "title": "قرآن تشر می‌زند:",
   "start": 487.12,
   "end": 573.96
  },
  {
   "index": 5,
   "title": "## دو روایت کافی دربارهٔ خطیب و چراغ دل",
   "start": 573.96,
   "end": 714.74
  },
  {
   "index": 6,
   "title": "## احمق به عین در کلام مولا",
   "start": 714.74,
   "end": 809.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 5.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.0,
   "end": 8.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 14.4,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.4,
   "end": 17.82,
   "text": "در ادامه قلب مشروب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.82,
   "end": 21.04,
   "text": "روایتی رو تقدیم می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.04,
   "end": 23.5,
   "text": "در خصوص ریشه‌یابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.5,
   "end": 27.78,
   "text": "و چرایی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.78,
   "end": 32.16,
   "text": "اینها با اینکه میثاق بسته بودند با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.16,
   "end": 36.64,
   "text": "حضرت موسی با ولایت زمانشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.64,
   "end": 41.82,
   "text": "مخصوصاً پیرامون ولایت کلیه الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.82,
   "end": 47.24,
   "text": "و ولایت اهل بیت عصمت و طهارت علیهم الصلاة والسلام قبلاً عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.24,
   "end": 51.36,
   "text": "همه انبیا از مریدانشون این ولایت رو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.36,
   "end": 54.14,
   "text": "چی شد که نقد پیمان کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.14,
   "end": 56.68,
   "text": "و قلب اینها مشروب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.68,
   "end": 59.6,
   "text": "آمیخته شد با غیر خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.6,
   "end": 66.2,
   "text": "اجازه بفرمایید که علت اصلیش رو با یک روایت تقدیم کنم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.2,
   "end": 69.56,
   "text": "تفسیر اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.56,
   "end": 72.04,
   "text": "جلد یک صفحه پانصد و پنجاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.04,
   "end": 75.38,
   "text": "امام عسکری صلوات الله علیه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.38,
   "end": 78.46,
   "text": "خیلی نهیب داره این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.46,
   "end": 85.3,
   "text": "عزیزان صحبت امروز ما یه هشدار و هوشیاری و نهیب است برای خودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.3,
   "end": 90.5,
   "text": "حدیث نفس برای خودم که ما هم در معرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.5,
   "end": 93.82,
   "text": "آمیخته شدن قلبمون با غیر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.82,
   "end": 98.88,
   "text": "و در نتیجه نقض پیمان ولایت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.88,
   "end": 105.44,
   "text": "حضرت فرمودن که اینها همین بنی‌اسرائیل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.44,
   "end": 109.68,
   "text": "عهد شکستند و گوساله پرست شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.68,
   "end": 115.1,
   "text": "گفتند ما به گوش، با گوش‌هامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.1,
   "end": 119.02,
   "text": "شنیدیم ما شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.02,
   "end": 122.26,
   "text": "ما قول حق رو شنیدیم. حرف حق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.26,
   "end": 130.96,
   "text": "شنیدیم اما عصیان کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.96,
   "end": 133.56,
   "text": "در دلمون. یعنی این رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.56,
   "end": 136.48,
   "text": "این حرفو شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.48,
   "end": 139.1,
   "text": "یا حتی چون قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.1,
   "end": 143.22,
   "text": "گفتن اینها که شنیدیم باشه حرف حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.22,
   "end": 148.1,
   "text": "اما به دلمون ما این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.1,
   "end": 150.6,
   "text": "نپذیرفتیم. یعنی دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.6,
   "end": 154.3,
   "text": "زیر بار این حرف نرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.3,
   "end": 157.58,
   "text": "سر همین. اصلا ریشه‌یابی اصلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.58,
   "end": 167.36,
   "text": "بخوای از این روایت انجام بدی، این آیه شریف انجام بدی که علت اینه که اینا قلبشون مشروب میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.36,
   "end": 172.48,
   "text": "چیه؟ همینه که دل مغایر با زبان شده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.48,
   "end": 176.06,
   "text": "زبان مخالف با قلب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.06,
   "end": 180.0,
   "text": "ظاهر فریبی ظاهر کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.0,
   "end": 184.48,
   "text": "چیزی رو میگه که قلباً به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.48,
   "end": 199.44,
   "text": "تعلق نداره. قلبش اون رو نپذیرفته بعد از اینا امام عسکری فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.44,
   "end": 202.22,
   "text": "وقتی به اینا نگاه می‌کنی ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.22,
   "end": 204.42,
   "text": "همشون اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.42,
   "end": 208.54,
   "text": "اطاعت و اظهار بندگی و زبانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.54,
   "end": 213.28,
   "text": "صاغرین، کوچیکی کردن در درگاه حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.28,
   "end": 216.38,
   "text": "میگی اینا، اینا خادم بیت الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.38,
   "end": 218.68,
   "text": "اینا آخر عشق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.68,
   "end": 220.94,
   "text": "آخر عرفان‌اند. آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.94,
   "end": 223.52,
   "text": "نگاه کن چقدر قشنگ حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.52,
   "end": 227.16,
   "text": "قیافشو نگاه کن. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.16,
   "end": 229.6,
   "text": "کسی خبر از باطنش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.6,
   "end": 236.64,
   "text": "درسته که این جمله اسمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.64,
   "end": 239.1,
   "text": "و خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.1,
   "end": 242.1,
   "text": "از شود. این جمله اسمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.1,
   "end": 244.98,
   "text": "با هو شروع شده و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.98,
   "end": 252.12,
   "text": "الاول الف فلان که اومده الآخر الظاهر الباطن اینا همش هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.12,
   "end": 260.42,
   "text": "درسته بحث، بحث وحدت وجود یک وجود واحد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.42,
   "end": 263.6,
   "text": "اما برداشت اخلاقی میشه اینطوری کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.6,
   "end": 266.68,
   "text": "که هو، هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.68,
   "end": 270.46,
   "text": "اول هو، آخر هم هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.46,
   "end": 273.36,
   "text": "ظاهر هم هو، باطن هم هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.36,
   "end": 277.08,
   "text": "کدوم یکی از ما ظاهر و باطنمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.08,
   "end": 279.24,
   "text": "واقعاً یک حقیقته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.24,
   "end": 281.64,
   "text": "یک چیزه؟ دم از یک چیز می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.64,
   "end": 285.44,
   "text": "دم از یک حقیقت می‌زنه؟ یک چیز بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.44,
   "end": 287.76,
   "text": "اصلاً علت اصلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.76,
   "end": 292.36,
   "text": "امام عسکری صلوات الله علیه می‌فرماید اینها نقض پیمان کردن این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.36,
   "end": 295.88,
   "text": "گفتن اما با دلشون نپذیرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.88,
   "end": 298.42,
   "text": "این علت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.42,
   "end": 302.5,
   "text": "که در آخرالزمان دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.5,
   "end": 305.26,
   "text": "تثبیت قلب یا ثبوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.26,
   "end": 308.24,
   "text": "تثبت حقایق در قلب اینقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.24,
   "end": 312.96,
   "text": "وارد شده که یا الله، یا رحمن، یا رحیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.96,
   "end": 314.96,
   "text": "یا مقلب القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.96,
   "end": 317.78,
   "text": "ببینید قلوب بحث قلوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.78,
   "end": 321.62,
   "text": "ای منقلب کننده، دگرگون کننده دلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.62,
   "end": 324.06,
   "text": "ثبت قلبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.06,
   "end": 326.8,
   "text": "قلبی. نمیگه لسانی ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.8,
   "end": 329.74,
   "text": "قلبی. چون الان ما همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.74,
   "end": 333.56,
   "text": "ارزیابی‌هامون بر اساس ظاهر و زبان دیگرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.56,
   "end": 339.36,
   "text": "از باطن خیلی توجه نداریم و اصلاً خودمون مأمور به باطن هم نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.36,
   "end": 345.36,
   "text": "اما خدا آیا به نظر شما خدای باطن، خدای ظاهر نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.36,
   "end": 348.58,
   "text": "خدای ظاهر، خدای باطن نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.58,
   "end": 352.66,
   "text": "خدای جسم ما که داره ظاهراً خضوع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.66,
   "end": 359.76,
   "text": "و حرکات بندگی از خودش انجام میده، ظاهراً عبادت داره می‌کنه، زاری می‌کنه، خاری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.76,
   "end": 365.5,
   "text": "آیا خدای باطن نیست که خشوع رو هم ببینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.5,
   "end": 369.72,
   "text": "باز درسته اون آیه شریفه که \"هو الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.72,
   "end": 373.31,
   "text": "في السماء إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.31,
   "end": 378.8,
   "text": "وفي الأرض إله\". او کسی‌ست که باز هم اون هوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.8,
   "end": 382.3,
   "text": "در سما او الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.3,
   "end": 384.7,
   "text": "در زمین هم او الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.7,
   "end": 387.0,
   "text": "یعنی یک وجود واحد. اله اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.0,
   "end": 390.34,
   "text": "الله اونه. باز بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.34,
   "end": 396.86,
   "text": "و اون توحید صمدی قرآنه از حیث حکمی اما باز نمیشه ازش برداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.86,
   "end": 401.02,
   "text": "معرفتی اینچنینی اخلاقی و سیر و سلوکی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.02,
   "end": 404.2,
   "text": "که خدایی که ظاهر منو داره میبینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.2,
   "end": 414.68,
   "text": "خدای ارضه یعنی الان به یک معنا بدن من، جسم من، جسد من، عرض وجود منه، زمین وجود منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.68,
   "end": 416.6,
   "text": "سما وجود من، روح منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.6,
   "end": 419.96,
   "text": "آیا \"هو الذي في السماء إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.96,
   "end": 421.72,
   "text": "وفي الأرض إله\" نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.72,
   "end": 428.08,
   "text": "قرآن که داره میگه هست. اون الهی که ظاهر من رو میبینه باطن من رو هم میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.08,
   "end": 431.5,
   "text": "مردم نمی‌بینن. مردم خبر از خلوت من ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.5,
   "end": 436.08,
   "text": "خبر از باطن من ندارن. اون‌ها صرفا ظاهر من رو نگاه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.08,
   "end": 437.68,
   "text": "لذا ارزیابی‌شون بر اساس اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.68,
   "end": 441.44,
   "text": "به به! چه عبایی، چه قبایی، چه عمامه‌ای، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.44,
   "end": 444.9,
   "text": "حرف خوشی، چه کلمات قصاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.9,
   "end": 449.04,
   "text": "چه خضوعی در عبادت، چه حالی، چه توجهی، چه زیارتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.04,
   "end": 451.36,
   "text": "این‌ها همه ظاهر این چیزا رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.36,
   "end": 453.96,
   "text": "قیافه‌شو که نگاه می‌کنی میگی آها این شهید زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.96,
   "end": 458.6,
   "text": "الان از قبر اومده بیرون. اما چندین بار خود ماها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.6,
   "end": 461.66,
   "text": "خود ماها شهدای زنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.66,
   "end": 464.84,
   "text": "چندین بار از همین چهره‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.84,
   "end": 468.82,
   "text": "به ظاهر به مثل شهید خیانت دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.82,
   "end": 471.06,
   "text": "می‌فرماید \"لم تقولون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.06,
   "end": 474.34,
   "text": "تشر میزنه. \"لم تقولون ما لا تفعلون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.34,
   "end": 477.66,
   "text": "چرا میگید حرفی رو میزنی که بهش عمل نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.66,
   "end": 485.84,
   "text": "\"کبر مقتاً عند الله ان تقولوا ما لا تفعلون\" اصلاً \"کبر مقتاً عند الله\" نزد خدا خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.84,
   "end": 488.9,
   "text": "\"کبر مقتاً\" اون گناه بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.9,
   "end": 492.46,
   "text": "چی؟ که بگی چیزی رو که عمل نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.46,
   "end": 495.45,
   "text": "چیزی رو که بدتر از اون اصلاً اعتقاد نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.45,
   "end": 497.6,
   "text": "صرفاً دوپون بازار خودت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.6,
   "end": 501.26,
   "text": "دین رو کردی کیسه دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.26,
   "end": 504.3,
   "text": "بارها عرض کردم باور کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.3,
   "end": 509.66,
   "text": "که اگر عواعد دنیایی دین‌داری رو حذف کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.66,
   "end": 512.78,
   "text": "بسیاری از ما تو دین باقی نمی‌مونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.78,
   "end": 514.56,
   "text": "در معرکه دین با نمی‌ایستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.56,
   "end": 519.56,
   "text": "پای دین با نمی‌ایستیم. اگر دنیا رو ازش برداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.56,
   "end": 524.02,
   "text": "واقعاً اینطوریه. چرا اهل بیت انقدر یار کم داشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.02,
   "end": 528.8,
   "text": "چون اون موقع‌ها با دین بودن با اهل بیت بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.8,
   "end": 531.72,
   "text": "مساوی نبود با دنیا دار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.72,
   "end": 535.24,
   "text": "هرکس که با اهل بیت بود بیچاره‌ش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.24,
   "end": 537.02,
   "text": "می‌کشتنش. لهش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.02,
   "end": 540.02,
   "text": "آبروشو می‌بردن. باهاش هیچ گونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.02,
   "end": 544.88,
   "text": "رفت و آمد اقتصادی و شؤونات اجتماعی رو نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.88,
   "end": 547.16,
   "text": "اما الان اینطوریه؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.16,
   "end": 549.56,
   "text": "الان هرکی می‌خواد یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.56,
   "end": 553.36,
   "text": "نونش بیشتر بشه سعی می‌کنه که قیافه‌شم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.36,
   "end": 555.38,
   "text": "حالا بگذریم این حرفا رو بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.38,
   "end": 558.32,
   "text": "میگن آقا حاج آقا حرفای سیاسی زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.32,
   "end": 560.88,
   "text": "اجازه بدید اگه یکی دو تا روایت تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.88,
   "end": 565.76,
   "text": "این دو تا روایت دیوانه کرده منو آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.76,
   "end": 569.64,
   "text": "چه کنیم که انشاالله تو دل شما خاک نخورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.64,
   "end": 573.96,
   "text": "چه کنم که ریشام سفید باید بشه و این روایات رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.96,
   "end": 577.86,
   "text": "کافی جلد دو صفحه چهارصد و بیست و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 577.86,
   "end": 581.74,
   "text": "امام صادق علیه السلام فرمود: \"تجد الرجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.74,
   "end": 585.1,
   "text": "یخطئ بلام ولا واو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.1,
   "end": 587.88,
   "text": "خطيبا مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.88,
   "end": 592.2,
   "text": "قاه\". عجب! چه بسیار وقتی می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.2,
   "end": 594.56,
   "text": "رجلی رو، مردی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.56,
   "end": 598.2,
   "text": "می‌فرماید این واو و لامی رو جا نمی‌اندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.2,
   "end": 602.18,
   "text": "چنان خطیبیست. قاه– قاهذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.18,
   "end": 606.08,
   "text": "چنان قشنگ و خ-- زیبا سخن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.08,
   "end": 608.4,
   "text": "سخنوری زبردست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.4,
   "end": 611.78,
   "text": "خب؟ اما حضرت داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.78,
   "end": 614.22,
   "text": "من نمیگم بعد بگید حاج آقا حرفای عجیب غریب زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.22,
   "end": 617.12,
   "text": "\"لقلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.12,
   "end": 621.62,
   "text": "أشد ظلمة من اللیل المظلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 621.62,
   "end": 632.0,
   "text": "من اللیل المظلم\". دلش رو که بررسی کنی همین آقایی که اینطوری مثل من روی منبر اینطوری خوش سخنه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.0,
   "end": 635.06,
   "text": "قلبشو که بررسی می‌کنی می‌بینی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 635.06,
   "end": 639.44,
   "text": "تاریکی شب تار هم تارتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.44,
   "end": 642.54,
   "text": "الله اکبر. یا گول ظاهر کسی رو نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.54,
   "end": 644.74,
   "text": "اینایی که قرآن به نیزه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 644.74,
   "end": 650.62,
   "text": "تو مناظرات ما دیدیم دیگه عرض کردم قرآن به نیزه کردن رو دیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 650.62,
   "end": 653.96,
   "text": "نهج‌البلاغه به نیزe کردن رو ندیده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.96,
   "end": 658.1,
   "text": "که دیدیم. \"وتجد الرجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 658.1,
   "end": 661.66,
   "text": "يستطيع أن يعبر عما في قلبه بلسانه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.66,
   "end": 664.12,
   "text": "قربون این خدای خوب و مهربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 664.12,
   "end": 666.76,
   "text": "قربون این آقای چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.76,
   "end": 669.76,
   "text": "بامرام بگم؟ باصفا بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 669.76,
   "end": 672.42,
   "text": "دلبَر و دوست داشتنی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.42,
   "end": 680.46,
   "text": "چی بگم؟ می‌فرماید چه بسا یه آدمی رو می‌بینی که \"لا يستطيع أن يعبر عما في قلبه بلسانه\" اصلاً نمی‌تونه حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.46,
   "end": 683.78,
   "text": "اون چیزی که تو دلشه نمی‌تونه به لسانش جاری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.78,
   "end": 687.0,
   "text": "سخنور نیست. اما و \"قلبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 687.0,
   "end": 691.02,
   "text": "به به \"يظهر كما يظهر المصباح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.02,
   "end": 694.52,
   "text": "مثل یه چراغ قلبش نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.52,
   "end": 699.02,
   "text": "و خداست دیگه. خدایی که خدای باطنه، خدای ظاهر هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 699.02,
   "end": 700.62,
   "text": "او فقط خضوع رو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.62,
   "end": 704.46,
   "text": "ما فقط خضوع رو می‌بینیم. خشوع رو هم می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.46,
   "end": 707.88,
   "text": "و روایت بعدی و آخر رو تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.88,
   "end": 710.52,
   "text": "زیاده بخوام اینطوری سخن بگم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.52,
   "end": 713.02,
   "text": "کام بعضیا تلخ میاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.02,
   "end": 720.66,
   "text": "مار چپ چپ نگام می‌کنن. مولا علی علیه الصلاة والسلام فرمود: \"من نظر في عيوب الناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 720.66,
   "end": 726.52,
   "text": "کسی که به عیب مردم نگاه می‌کنه \"فأنكرها\" میگه اه اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 726.52,
   "end": 728.92,
   "text": "اه زشت بود این عیب دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 728.92,
   "end": 731.34,
   "text": "چه کار زشتی. چه حرکت ناپسندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 731.34,
   "end": 735.42,
   "text": "داره می‌فرماید آقا \"من نظر في عيوب الناس فأنكرها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 735.42,
   "end": 742.16,
   "text": "اگه کسی عیبی رو در مردم ببینه بگه اه اه اه چقدر زشته \"ثم رضيها لنفسه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.16,
   "end": 745.22,
   "text": "ولی برای نفس خودش راضی بشه، بشه با اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 745.22,
   "end": 751.54,
   "text": "می‌دونی تو خود وجود خودش گندتر از این اخلاق و این سیره و این روش و این کارها می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 751.54,
   "end": 758.82,
   "text": "کسی خبر نداره. به نظر شما مولامون علی چنین کسی رو چه نامی درآش گذاشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 758.82,
   "end": 760.86,
   "text": "ها؟ به خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.86,
   "end": 763.94,
   "text": "به نظر شما مولا اسم این‌ها رو چی گذاشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 763.94,
   "end": 766.66,
   "text": "کلمه آخر رو بشنوید و برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 766.66,
   "end": 768.88,
   "text": "هرچی خواستید بیرون به ما بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 768.88,
   "end": 773.88,
   "text": "فرمود \"فذاک الأحمق بعينه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 773.88,
   "end": 778.84,
   "text": "مولا فرمود این‌ها عینا اصلاً \"أحمق بعينه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.84,
   "end": 785.94,
   "text": "احمق یعنی این‌ها. که خودش سر تا پاش آلوده است فقط گیر داده به آلودگی دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 785.94,
   "end": 789.0,
   "text": "خدا رحم-- خدایا به ما رحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 789.0,
   "end": 791.6,
   "text": "خدایا عاقبتمون خیر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 791.6,
   "end": 794.6,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 794.6,
   "end": 797.3,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 797.3,
   "end": 809.38,
   "text": "محمد وآل محمد. ای خوب. صفحه سیصد و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}