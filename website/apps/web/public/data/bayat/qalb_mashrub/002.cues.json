 },
 "chapters": [
  {
   "index": 0,
   "title": "## قلب مشروب؛ محبتِ غیر در دل",
   "start": 24.54,
   "end": 186.72
  },
  {
   "index": 1,
   "title": "## تمام الحج لقاء الامام",
   "start": 186.72,
   "end": 530.72
  },
  {
   "index": 2,
   "title": "## اباصالح باش؛ از سبیل مفسدین مرو",
   "start": 530.72,
   "end": 885.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.16,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.16,
   "end": 5.52,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.52,
   "end": 12.98,
   "text": "محمد بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.98,
   "end": 16.76,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.76,
   "end": 19.72,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.72,
   "end": 24.54,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.54,
   "end": 28.62,
   "text": "ادامه قلب مشروب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.62,
   "end": 33.48,
   "text": "قلبی که آمیخته شده با غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.48,
   "end": 39.72,
   "text": "بریم به امید خدا رو آیه کار کنیم که خیلی هم مرتبطه اتفاقا با این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.72,
   "end": 42.94,
   "text": "آیه نود و سه سوره بقره عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.94,
   "end": 48.96,
   "text": "می‌فرمود \"و اذ اخذنا میثاقکم و رفعنا فوقکم الطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.96,
   "end": 55.48,
   "text": "خذوا ما آتيناکم بقوة واسمعوا قالوا سمعنا وعصينا و اشربوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.48,
   "end": 58.96,
   "text": "اشربوا في قلوبهم العجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.96,
   "end": 63.2,
   "text": "محبت گوساله افتاد به دل این‌ها قاطی شد دلشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.2,
   "end": 65.3,
   "text": "آمیخته شد دلشون با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.3,
   "end": 68.42,
   "text": "محبت غیر. این بلا سرشون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.42,
   "end": 74.5,
   "text": "حالا اونجا انقدر عرض کردیم انقدر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.5,
   "end": 81.06,
   "text": "میثاق چون ابتدای آیه می‌فرمود \"و اذ اخذنا میثاقکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.06,
   "end": 83.36,
   "text": "اون موقعی رو یادآوری می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.36,
   "end": 85.72,
   "text": "از شما میثاقی گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.72,
   "end": 91.12,
   "text": "این میثاق به قدری با عظمت است که خدا یه معجزه‌ای انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.12,
   "end": 96.16,
   "text": "معجزه فعلیه که گفتیم کوه طور رو میاره بالا سر اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.16,
   "end": 100.5,
   "text": "مثل یه تیکه ابری کوه بالا سرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.5,
   "end": 105.06,
   "text": "که اگر شما این میثاق رو این عهد رو نپذیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.06,
   "end": 109.1,
   "text": "با خدا عهد نبندید، این کوه به سر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.1,
   "end": 112.7,
   "text": "برخورد می‌کنه. می‌ریزه رو سرتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.7,
   "end": 118.48,
   "text": "اینا یعنی همچین-- حتی میگن که در تفاسیر دیدم در تفسیر اهل بیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.48,
   "end": 121.06,
   "text": "وقتی این‌ها می‌خواستن سجده برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.06,
   "end": 125.56,
   "text": "از ترسشون اصلاً از اینجا این رسم یهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.56,
   "end": 130.38,
   "text": "شکل گرفت که سجده‌شونم دقت کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.38,
   "end": 132.32,
   "text": "به بغل صورته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.32,
   "end": 135.4,
   "text": "بغل صورتشون می‌ذارن زمین یهودیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.4,
   "end": 139.84,
   "text": "مثل ما پیشونی نمی‌ذارن. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.84,
   "end": 146.14,
   "text": "برمی‌گرده به همین آیه که اینا از ترس این کوهی که بالا سرشونه اینجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.14,
   "end": 152.94,
   "text": "صورتشونو کج می‌کردن با گوشه چشمشون کوه بالا سرشونو می‌دیدن که الان سرشون نخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.94,
   "end": 155.72,
   "text": "سجده کنن. یه همچین حالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.72,
   "end": 162.18,
   "text": "چرا؟ به جهت عظمت این میثاق که عرض کردیم این میثاق، میثاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.18,
   "end": 164.12,
   "text": "ولایت اهل بیت بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.12,
   "end": 167.42,
   "text": "ولایت پیغمبر عزیز عالم بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.42,
   "end": 170.24,
   "text": "همه ولایت پیش ایشون بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.24,
   "end": 172.18,
   "text": "و پیغمبر ختمی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.18,
   "end": 174.56,
   "text": "و همه انبیا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.56,
   "end": 177.3,
   "text": "شاگرد ایشون محسوب میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.3,
   "end": 184.26,
   "text": "و شا-- اون جانشین و اوسیاء بلا فصل ایشون از امیرالمؤمنین بگیرید تا امام عصر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.26,
   "end": 186.72,
   "text": "این میثاق، میثاق با امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.72,
   "end": 190.76,
   "text": "اتفاقاً ایام حج هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.76,
   "end": 196.2,
   "text": "ما از امام باقر صلی الله علیه در مجامع روایتمون داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.2,
   "end": 198.72,
   "text": "تعجب روایت شیرینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.72,
   "end": 201.32,
   "text": "چهار کلمه‌ست اما غوغاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.32,
   "end": 204.44,
   "text": "چهار طرف عالم رو می‌گیره این پیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.44,
   "end": 209.0,
   "text": "می‌فرماید \"تمام الحج\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.0,
   "end": 212.0,
   "text": "به نظر شما همه حج چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.0,
   "end": 218.56,
   "text": "\"تمام الحج لقاء الامام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.56,
   "end": 222.12,
   "text": "اگر کسی-- اصلاً حج یعنی قصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.12,
   "end": 226.68,
   "text": "روز جمعه عرض کردم. حج یعنی قصد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.68,
   "end": 229.72,
   "text": "یه طرف قصد کرده، قصد خدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.72,
   "end": 233.04,
   "text": "اما اگر داره میره به سمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.04,
   "end": 237.56,
   "text": "قصد امام نکرده باشه اصلاً حجش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.56,
   "end": 240.1,
   "text": "هیچ‌وقت فکر کردیم ما که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.1,
   "end": 242.42,
   "text": "دهه چرا این نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.42,
   "end": 247.94,
   "text": "و وعدنا اومده و چرا ما رو در ثواب حاجیان سهیم می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.94,
   "end": 250.64,
   "text": "این چرایی‌هاش خیلی قشنگه دیگه آدم توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.64,
   "end": 256.8,
   "text": "البته که این ثواب رو دیگه اهل حکمت و عرفان باید اشتباه نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.8,
   "end": 258.46,
   "text": "ثواب نه یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.46,
   "end": 266.26,
   "text": "به شما، به شما یه سیب و گلابی میدن مثلاً توی پرونده‌ی یه چیزی به شما اضافه بر سازمان می‌نویسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.26,
   "end": 269.52,
   "text": "اضافه حقوق مثلاً. این نه، این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.52,
   "end": 277.92,
   "text": "اثر نفس در-- اون اثری که در نفس شما از اون عمل ایجاد می‌شه، به اون میگن ثواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.92,
   "end": 281.0,
   "text": "درست شد؟ پاداش، جزا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.0,
   "end": 285.22,
   "text": "نفس عمله. مثلاً میگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.22,
   "end": 291.4,
   "text": "شما این نماز رو در دهه اول ذی الحجه بخونی بین نماز مغرب و عشا اون نماز و وعدنا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.4,
   "end": 294.98,
   "text": "بخونی در ثواب حاجیان سهیمی، شریکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.98,
   "end": 298.74,
   "text": "یعنی چی؟ یعنی اون اثری که حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.74,
   "end": 305.06,
   "text": "در وجود شما در نفس شما می‌ذاره، اگه می‌رفتی چقدر تاثیر می‌گذاشت این نماز انقدر تاثیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.06,
   "end": 308.62,
   "text": "عجب! چرا؟ مگه چه خبره تو این نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.62,
   "end": 314.32,
   "text": "برو کار کن رو اون وا، وعدنا رو اون آیه ببین چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.32,
   "end": 316.42,
   "text": "توجه بکنین بهش یه لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.42,
   "end": 320.14,
   "text": "\"و وعدنا موسی ثلاثین الليلة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.14,
   "end": 322.44,
   "text": "ما وعده دادیم به موسی سی شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.44,
   "end": 326.24,
   "text": "اونم سی شب. س-- سی شبانه روز بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.24,
   "end": 330.66,
   "text": "چرا لیلة ثلاثین الليلة به جهت عظمت شبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.66,
   "end": 334.4,
   "text": "لیلة. خب \"و اتممناها بعشر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.4,
   "end": 339.7,
   "text": "اصلاً سر هرچی که هست برمی‌گرده به این \"و اتممناها بعشر\" به این ده شب اضافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.7,
   "end": 344.1,
   "text": "به این ده شب اضافه برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.1,
   "end": 350.84,
   "text": "قرار بود اینا می‌دونستن که حضرت موسی قراره سی شب با خدا میقات بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.84,
   "end": 353.16,
   "text": "بره کوه طور مثلاً زیارت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.16,
   "end": 355.0,
   "text": "میقات باشه و اینا. ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.0,
   "end": 361.48,
   "text": "شب اصلاً مخصوصاً تو این آیه اومده‌ها \"و اتممناها بعشر\" ده شب اضافه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.48,
   "end": 364.24,
   "text": "آقا اینا تحمل نکردن غیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.24,
   "end": 367.92,
   "text": "حجت خدا رو ده روز بیشتر ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.92,
   "end": 371.78,
   "text": "ده روزم که چه عرض کنم همون روزای اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.78,
   "end": 375.08,
   "text": "به محض اینکه سی شب شد سی و یک شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.08,
   "end": 377.46,
   "text": "سی و دو شب شروع شد دیگه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.46,
   "end": 383.38,
   "text": "سه شب اضافه شد دیگه گوساله اون سامری دست به کار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.38,
   "end": 387.52,
   "text": "اینجا که می‌فرماید و ътشربو فی قلوبهم العجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.52,
   "end": 391.48,
   "text": "عجل اینجا چیه؟ گوساله است به کفرهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.48,
   "end": 396.44,
   "text": "اینا دلشون متمایل به اون گوساله شد که جریانشو قبلاً عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.44,
   "end": 399.5,
   "text": "جریان تاریخیش و گوساله پرست شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.5,
   "end": 403.14,
   "text": "میگه سرش رو دقت بفرماییدا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.14,
   "end": 409.24,
   "text": "می‌فرماید که اینا چند روز غیبت حجت خدا رو تحمل نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.24,
   "end": 413.68,
   "text": "توجه کردی؟ داره من و شما رو این رمز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.68,
   "end": 417.98,
   "text": "این شبا که این نمازو می‌خونیم حواس ما رو جمع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.98,
   "end": 423.74,
   "text": "که حواست جمع باشه الان در زمان غیبت حجت خدایی تو هم دلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.74,
   "end": 427.6,
   "text": "و ътشربو فی قلوبهم العجل بکفرهم نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.6,
   "end": 430.5,
   "text": "نره به سمت گوساله‌های زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.5,
   "end": 432.68,
   "text": "متمایل به سمت دنیا نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.68,
   "end": 437.78,
   "text": "تعلقات دنیوی تو رو در غیبت امامت نگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.78,
   "end": 441.4,
   "text": "اصلاً همه حج لقاء امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.4,
   "end": 444.86,
   "text": "اگر تو این شبا با این نماز نسوزی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.86,
   "end": 448.32,
   "text": "نبود آقات اصلاً به چه درد می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.32,
   "end": 455.5,
   "text": "این نماز و اون حج؟ حجی که میگه کعبه یک سنگ نشانی‌ست که ره گم نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.5,
   "end": 459.1,
   "text": "حاجی احرام دگر بند ببین یار کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.1,
   "end": 463.86,
   "text": "قصد امام باید کرد رفت به حج مثل علی بن مهزیار قوم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.86,
   "end": 468.48,
   "text": "اهوازی که بیست سفر رفت و آقاشو بالاخره دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.48,
   "end": 470.8,
   "text": "و جالبه اونجا آقا به ایشون تشرف دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.8,
   "end": 475.26,
   "text": "فرمودن بیست ساله منتظر شما هستم نیومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.26,
   "end": 480.3,
   "text": "خیلی عجیبه این فرمایش آقا برید روش کار کنید که بعد حضرت جواب میده خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 480.3,
   "end": 485.68,
   "text": "که چرا بیست سال آقا من اومدم چطور شما می‌فرمایید نبو-- نیومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.68,
   "end": 488.28,
   "text": "حضرت فرمود نه شما این کارا رو نکردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.28,
   "end": 492.02,
   "text": "حالا ببینید روایتشو الان مربوط به بحث ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.02,
   "end": 499.62,
   "text": "انقدر مهمه توجه به امام و تا از-- شما توجه به خود آیه دوباره ادامشو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.62,
   "end": 505.92,
   "text": "می‌فرماید و اتممناها بعشر فتم میقات ربه اربعین ليله چهل شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.92,
   "end": 508.32,
   "text": "وقال حالا اینجا وقال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.32,
   "end": 511.1,
   "text": "موسی لاخیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.1,
   "end": 513.28,
   "text": "موسی به برادرش گفت. کیه برادرش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.28,
   "end": 516.8,
   "text": "هارون. لاخیه هارون اخلفنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.8,
   "end": 520.96,
   "text": "بحث خلافته و اصله بر ه-- بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.96,
   "end": 527.4,
   "text": "صالحیته. تا شما صالح نباشی چگونه می‌خوای مصلحت مردم رو بفهمی و بسنجی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.4,
   "end": 533.48,
   "text": "صلح برقرار کنی و تا صالحیت نداشته باشی، تا خودت صالح نباشی چگونه می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.48,
   "end": 537.66,
   "text": "صالحیت ایجاد کنی و مردم رو به سمت صلاح دعوت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.66,
   "end": 539.46,
   "text": "باید أبا صالح باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.46,
   "end": 542.5,
   "text": "پدر همه صلحا باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.5,
   "end": 546.76,
   "text": "تا بتونی مردم رو بکشونی به سمت حضرت حق و عمل صالح و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.76,
   "end": 550.52,
   "text": "و اصله ولا تتبع سبيل المفسدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.52,
   "end": 552.22,
   "text": "یه وقت نری تو زمین دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.22,
   "end": 553.9,
   "text": "تبعیت از مفسدین نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.9,
   "end": 557.36,
   "text": "مفسد یعنی کسی که خروج کرده از مسیر ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.36,
   "end": 561.78,
   "text": "حالا وقتی این ظاهر بشه می‌شه فسق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.78,
   "end": 566.8,
   "text": "فساد درونه. باطن نسبت به امام زمانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.8,
   "end": 571.04,
   "text": "مشکوک می‌شه. ای بابا این همه کشتن زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.04,
   "end": 574.0,
   "text": "عرض شود فلسطین رو با خاک یکسان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.0,
   "end": 577.46,
   "text": "پس کو آقا امام؟ کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.46,
   "end": 582.46,
   "text": "ببینید مشکوک می‌شه دلش. توجه کردی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.46,
   "end": 584.56,
   "text": "شکی که نسبت به امامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 584.56,
   "end": 588.96,
   "text": "در دلش ایجاد می‌شه می‌کشونش به وادی کفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.96,
   "end": 592.1,
   "text": "میگه حواست جمع باشه اینطوری نشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 592.1,
   "end": 594.64,
   "text": "و اصله ولا تتبع سبيل المفسدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.64,
   "end": 597.46,
   "text": "بعد نگی حالا دیگه بری به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.46,
   "end": 600.64,
   "text": "این شک باطنی‌ت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.64,
   "end": 609.98,
   "text": "فساد اینو ظهورش بدی در عمل بی‌خیال بشی اصطلاحاً بهش می‌گن فسق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 609.98,
   "end": 612.84,
   "text": "میگه اصلاً بحث، بحث خلافته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.84,
   "end": 615.92,
   "text": "وقال موسی لاخیه هارون اخلفنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.92,
   "end": 618.04,
   "text": "تو جانشین من باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.04,
   "end": 621.74,
   "text": "من از شما سؤال می‌کنم. حالا شما هر جا مشغولید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.74,
   "end": 625.94,
   "text": "هر جا جای خیلی مهمی دارید، کارخونه‌ای دارید، کاسبی دارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.94,
   "end": 628.24,
   "text": "مغازه‌ای دارید، مؤسسه‌ای دارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.24,
   "end": 631.94,
   "text": "می‌خواید برید جایی چیو جانشین خودتون قرار می‌دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.94,
   "end": 635.52,
   "text": "کسی که به صفات خود شما باشه مثل شما فکر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.52,
   "end": 638.62,
   "text": "درسته؟ غیر از اینه؟ عقل اینو جواب می‌ده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.62,
   "end": 645.78,
   "text": "میگه مخت-- می‌شه-- می‌فرماید خلیفه به صفات مستخلف عنه باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 645.78,
   "end": 648.98,
   "text": "خب خلیفه امام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 648.98,
   "end": 651.3,
   "text": "خلیفه پیغمبر الان کیه برای ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 651.3,
   "end": 653.62,
   "text": "امام عصر که به همه صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.62,
   "end": 656.8,
   "text": "حضرت حق همه اسماء در او پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.8,
   "end": 660.78,
   "text": "اصلاً بحث، بحث این شبا شب بحث خلافته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.78,
   "end": 664.78,
   "text": "خلافت الهی روی زمینه و توجه به امامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 664.78,
   "end": 672.92,
   "text": "و اینه که حواست جمع باشه در غیبت امام زمان نری تو زمین دشمن نری به سمت ولا تتبع سبيل المفسدين و أصل الصلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.92,
   "end": 680.62,
   "text": "اهل صلاح و اهل عمل صالح باشی و اصله و دیگران را هم به صالحیت بکشونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 680.62,
   "end": 683.36,
   "text": "این با توجه به امام حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 683.36,
   "end": 686.4,
   "text": "همین حرف ما اینه که اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 686.4,
   "end": 691.18,
   "text": "خیلی شیرین این آیه و بحث قلب مشرب برخورد کرده به همین ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.18,
   "end": 692.98,
   "text": "حالا امروز هم که روز عرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.98,
   "end": 697.54,
   "text": "نکته آخر. اصلاً چرا بهش می‌گن عرفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 697.54,
   "end": 701.56,
   "text": "هیچ‌وقت فکر کردین؟ ریشه لغوی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 701.56,
   "end": 703.54,
   "text": "به کجا می‌خوره اصلاً؟ عرفه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 703.54,
   "end": 706.14,
   "text": "یعنی شناخت، عرفان، عرفان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.14,
   "end": 710.42,
   "text": "معرفت. اینا همه از یک ریشه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.42,
   "end": 714.94,
   "text": "یعنی شناخت. یعنی امروز هر کسی تونست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.94,
   "end": 721.54,
   "text": "یه پله بره به سمت شناخت امام عصرش به حقیقت حج نزدیک شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 721.54,
   "end": 724.36,
   "text": "که تمام الحج لقاء الامام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 724.36,
   "end": 726.82,
   "text": "خوش به حال کسی که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 726.82,
   "end": 733.38,
   "text": "با روزهای دیگه‌ش نسبت به ولی خدا و خلیفه خدا روی زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 733.38,
   "end": 739.16,
   "text": "شناختش بیشتر بشه و نزدیک‌تر بشه به حضرت و بسوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 739.16,
   "end": 743.46,
   "text": "اصلاً سر امروز به سوختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.46,
   "end": 749.54,
   "text": "کسی که دوری امام عصرش رو درک نمی‌کنه و نمی‌سوزه به درد لای جرز می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 749.54,
   "end": 752.38,
   "text": "می‌خواد من باشم یا هر کس دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 752.38,
   "end": 754.86,
   "text": "اون فرمایش امام صادق یادتون نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 754.86,
   "end": 756.98,
   "text": "خیلی این فرمایش عرشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 756.98,
   "end": 763.38,
   "text": "اصلاً مال من و شماست که از حضرت سؤال کردن همه ساله من عرض می‌کنم خدمتتون روز عرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 763.38,
   "end": 766.78,
   "text": "سؤال کردن آقا چرا شما فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 766.78,
   "end": 769.22,
   "text": "همه الحج عرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 769.22,
   "end": 774.46,
   "text": "اصلاً حج یعنی عرفة. در صورتی که سرزمین عرفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 774.46,
   "end": 776.76,
   "text": "که نیمه شب دیشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 776.76,
   "end": 780.46,
   "text": "رفتن حاجی‌ها تو منا و بالاخره از حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 780.46,
   "end": 782.78,
   "text": "خارج شدن جزء حرم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 782.78,
   "end": 785.58,
   "text": "سرزمین عرفات کیا اینجا حج رفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 785.58,
   "end": 787.7,
   "text": "سرزمین عرفات جزء حرم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 787.7,
   "end": 790.76,
   "text": "چرا همه حج عرفة شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 790.76,
   "end": 793.54,
   "text": "امام صادق صلوات الله علیه فرمود سر همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 793.54,
   "end": 797.6,
   "text": "شما رو از حرم بیرون می‌کنه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 797.6,
   "end": 801.4,
   "text": "که فراق حرم شما رو به سوختن بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 801.4,
   "end": 803.84,
   "text": "اون سوختنه موضوعیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 803.84,
   "end": 808.86,
   "text": "به آه بیفتید، آه بکشید، بسوزید، زجه بزنید، ناله بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 808.86,
   "end": 813.66,
   "text": "اون سوختن از دوری حرم از دوری امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 813.66,
   "end": 822.42,
   "text": "تو رو به همه جا می‌رسونه. آقا به خدا قسم سوختن از دوری امام حسین و کربلا ارزشش خیلی بالاتر از رفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 822.42,
   "end": 826.12,
   "text": "نفهمیدن و سنگ و چوب دیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 826.12,
   "end": 830.1,
   "text": "اصلاً اگر این سوختن نباشه، اون وصال شیرین نیست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 830.1,
   "end": 832.58,
   "text": "ما رو دارن آماده می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 832.58,
   "end": 835.52,
   "text": "برای اون وصال abadi انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 835.52,
   "end": 841.14,
   "text": "ولی با یک عمر سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 841.14,
   "end": 843.18,
   "text": "چقدر اصلاً سوختم بیچاره شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 843.18,
   "end": 850.34,
   "text": "سخت شده بر من که همه رو می‌بینم تو رو نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 850.34,
   "end": 854.96,
   "text": "پسر احمد، پسر فاطمه، پسر امیرالمؤمنین، امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 854.96,
   "end": 858.16,
   "text": "آیا راهی هست تا من تو رو ملاقات کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 858.16,
   "end": 862.22,
   "text": "این سوختن سر سوختن امروز ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 862.22,
   "end": 864.62,
   "text": "خوش به حال کسی که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 864.62,
   "end": 867.1,
   "text": "بسوزه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 867.1,
   "end": 870.6,
   "text": "غیبت امام عصرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 870.6,
   "end": 872.78,
   "text": "این سر عرفه است و بهش شناخت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 872.78,
   "end": 876.92,
   "text": "معرفت میدن. انشاالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 876.92,
   "end": 880.1,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 880.1,
   "end": 885.42,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}