 "chapters": [
  {
   "index": 0,
   "title": "## نذرِ مقید به حرم و نذرِ مطلق برای امام",
   "start": 12.08,
   "end": 103.8
  },
  {
   "index": 1,
   "title": "## آیهٔ اسراء و سنگینیِ سخن از توحید",
   "start": 103.8,
   "end": 244.22
  },
  {
   "index": 2,
   "title": "## تمثیل آینه؛ صورتِ مرآتی و یقه",
   "start": 244.22,
   "end": 440.44
  },
  {
   "index": 3,
   "title": "بهترین بیان شاید همان سخن قرآن باشد:",
   "start": 440.44,
   "end": 495.76
  },
  {
   "index": 4,
   "title": "## کلمه، فکرِ شرک‌آمیز، و اندیّتِ شهید",
   "start": 495.76,
   "end": 780.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.82,
   "end": 4.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.7,
   "end": 9.14,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.14,
   "end": 12.08,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.08,
   "end": 15.12,
   "text": "اگر کسی مالی رو نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.12,
   "end": 20.36,
   "text": "حرم اهل بیت بکنه و اسمم نبره بگه حرم ائمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.36,
   "end": 23.22,
   "text": "یا حرم مثلا امامزاده‌ها باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.22,
   "end": 27.04,
   "text": "چون مقید است به حرم باید در شئونات حرم صرف شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.04,
   "end": 29.36,
   "text": "حالا هرچی که در شئونات حرم هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.36,
   "end": 32.92,
   "text": "خادما، زائرها، مهمون سرا، نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.92,
   "end": 36.18,
   "text": "هر چیزی که خرج حرم باشد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.18,
   "end": 38.48,
   "text": "چون مقید است. اما حالا اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.48,
   "end": 40.6,
   "text": "گفت آقا من نذر می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.6,
   "end": 43.32,
   "text": "این مالمو برای امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.32,
   "end": 50.4,
   "text": "برای امیرالمؤمنین، برای امام حسن، بعضیا دیدید میگن بیمه امام زمان بشم مثلا یه بخشی از مالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.4,
   "end": 53.04,
   "text": "بیمه امام زمان می‌کنم، هدیه به امام حسن می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.04,
   "end": 56.46,
   "text": "این مقید نکرده که کجا هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.46,
   "end": 60.22,
   "text": "صرفا گفته برای فلان امام، برای فلان امامزاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.22,
   "end": 67.5,
   "text": "اینجا دیگه اگرچه مستحب است دقت کنید رهبر عزیزمون می‌فرماید مستحب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.5,
   "end": 71.36,
   "text": "که در شئونات حرم اون امام یا امامزاده هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.36,
   "end": 72.98,
   "text": "مستحب است اما واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.98,
   "end": 79.34,
   "text": "می‌تونه هر جای دیگه‌ای به هر شکلی حتی به فقیر کمک کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.34,
   "end": 83.66,
   "text": "توی هیئتی چیزی بده، مسجدی هرچی شئونات م-متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.66,
   "end": 86.84,
   "text": "اما به نیت اون امام یعنی ثوابش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.84,
   "end": 88.94,
   "text": "به منظور الله هدیه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.94,
   "end": 92.82,
   "text": "ولی چون مقید نکرده در چه موضوعی، چه جایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.82,
   "end": 96.04,
   "text": "چه ساعتی، چه مکانی. برای امام علی علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.04,
   "end": 100.74,
   "text": "حالا می‌تونه ص-صدقه‌ای که داره به یه فقیر میده به نیت امام علی بده تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.74,
   "end": 104.7,
   "text": "و نذرش ادا کرده. خب بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.7,
   "end": 108.86,
   "text": "آیه چهل و سه، چهل و شش اسرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.86,
   "end": 114.38,
   "text": "که بیچاره کرد ما رو این قسمته \"و اذا ذكر تربک في القرآن وحده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.38,
   "end": 118.4,
   "text": "وحده، وحده\". این بحث توحید خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.4,
   "end": 122.74,
   "text": "عجیب در این آیه اومده و ما رو متوقف کرده تو خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.74,
   "end": 128.36,
   "text": "که این کسانی که پرده‌شون در یک، این قلبشون در یک پرده‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.36,
   "end": 132.62,
   "text": "یا کنانی قرار گرفته از غفلت که نمی‌فهمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.62,
   "end": 139.46,
   "text": "ااا نشانه‌ش رو نفهمی در توحید یا ادبار به توحید بیان کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.46,
   "end": 142.8,
   "text": "و ما در خصوص توحید علیرغم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.8,
   "end": 147.54,
   "text": "خدا رو شاهد می‌گیرم که بار سنگینی‌ست رو دوش من حرف زدن از توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.54,
   "end": 149.54,
   "text": "اصلا این کاره نیستم که بخوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.54,
   "end": 152.34,
   "text": "اما چه کنم به هر حال قرآن است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.34,
   "end": 159.32,
   "text": "خطوطی که بزرگان ما چارچوبی که تعیین کردن، تبیین کردن، دلم نمیاد شما هم که با دقت گوش میدید آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.32,
   "end": 163.16,
   "text": "به هر حال دوست داره طمع می‌کنه بگه بعضی از حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.16,
   "end": 167.18,
   "text": "اینکه امام رئوف سلام الله علیه فرمودن به اون زندیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.18,
   "end": 175.4,
   "text": "که این کثرات یا زمین و آسمان‌ها و این موجودات که نمودار خدا هستند این‌ها مرآت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.4,
   "end": 182.12,
   "text": "مرآتن، آینه‌ی وجود Godان، وجود مطلق Godان، این‌ها خدا رو دارن به خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.12,
   "end": 185.66,
   "text": "می‌نمایانند. این فهمش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.66,
   "end": 188.44,
   "text": "من چند تا مثال می‌زنم. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.44,
   "end": 190.58,
   "text": "تو خود آینه بمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.58,
   "end": 194.7,
   "text": "نه به اون، حتی تو عکس در آینه هم بمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.7,
   "end": 200.4,
   "text": "نه به اون صاحب عکس، این دچار شرک شده، این کافر شده، این اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.4,
   "end": 203.18,
   "text": "عرض شود به حقیقت ایمان و توحید نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.18,
   "end": 206.02,
   "text": "انقدر دقیق و ظریف است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.02,
   "end": 208.74,
   "text": "اینکه می‌فرماید پل صراط مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.74,
   "end": 212.76,
   "text": "مو از مو باریک‌تر است و از شمشیر برنده‌تر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.76,
   "end": 215.48,
   "text": "منظور همین حقیقت توحیدی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.48,
   "end": 218.72,
   "text": "که اگر توحید برای ما درست جا نیفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.72,
   "end": 223.78,
   "text": "اون موقع به عرض شود ظهور توحید یا مصادیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.78,
   "end": 226.5,
   "text": "وادی توحید هم ما ادبار پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.5,
   "end": 229.04,
   "text": "مثلا از مؤمن به مؤمن پشت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.04,
   "end": 231.42,
   "text": "غیبت می‌کنیم، تهمت به مؤمن می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.42,
   "end": 234.38,
   "text": "در حالی که تهمت به مؤمن نشانه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.38,
   "end": 237.34,
   "text": "خروج از ولایت خدا و توحید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.34,
   "end": 241.54,
   "text": "حالا اینا شاید فردا در aboutش بحث کردیم مصداقش رو در خصوص مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.54,
   "end": 246.76,
   "text": "به هر حال می‌خوام عرض کنم که ببینید شما وقتی یک آینه رو جلوش وایمیستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.76,
   "end": 249.82,
   "text": "اینو دقت بفرمایید خوب چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.82,
   "end": 253.82,
   "text": "وقتی آینه رو جلوش وایمیستید، اگر شما بخواید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.82,
   "end": 256.14,
   "text": "خود آینه نگاه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.14,
   "end": 258.64,
   "text": "اینکه میگن صور مرآتیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.64,
   "end": 262.72,
   "text": "اگر به خود آینه نگاه کنید که جنسش چیه، چه شکلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.72,
   "end": 266.72,
   "text": "چه اندازه‌ست، نمی‌دونم این جیوش چه شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.72,
   "end": 268.58,
   "text": "تو باز به توحید نرسیدی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.58,
   "end": 272.2,
   "text": "باز اینجا مشغول این کثرات، مشغول این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 272.2,
   "end": 276.18,
   "text": "ظواهر شدی. اگر حتی به عکس خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.18,
   "end": 279.48,
   "text": "به عکس خودت در داخل آینه دقت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.48,
   "end": 281.96,
   "text": "که مثلا این عکس چگونه است، نه به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.96,
   "end": 284.1,
   "text": "یعنی اون عکس داخل آینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.1,
   "end": 286.64,
   "text": "تداعی وجود خودت نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.64,
   "end": 292.5,
   "text": "یا تداعی یا یه عکسی رو دستت می‌گیری تداعی از صاحب عکس نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.5,
   "end": 296.52,
   "text": "گیر بدی به خود عکس توجه بکنی، زوم کنی رو خود عکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.52,
   "end": 300.96,
   "text": "اینجا کلاهش کجه، اینجا مثلا یقه ش، دیدی عکاس عکس رو که برمی‌داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.96,
   "end": 305.14,
   "text": "نگاه می‌کنه میگه اِ اینجا نورش مثلا ضعیف بوده، اینجا نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.14,
   "end": 307.22,
   "text": "باید فتوشاپ میشد اینجا. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.22,
   "end": 309.8,
   "text": "اصلا صاحب عکس رو نمی‌بینه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 309.8,
   "end": 312.18,
   "text": "اصلا تداعی صاحب عکس براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 312.18,
   "end": 317.06,
   "text": "گیر کرده تو خود عکس. تو هم اگر این چنین بشی باز اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 317.06,
   "end": 320.26,
   "text": "مقصودی نیست که امام رضا سلام الله علیه فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.26,
   "end": 324.0,
   "text": "اگر تو آسمان رو فقط آسمان ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.0,
   "end": 330.3,
   "text": "و زمین رو زمین ببینی که این‌ها صور مرآتی‌اند به نوعی به قول امام رضا سلام الله علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.3,
   "end": 332.3,
   "text": "تو نمی‌تونی به حقیقت توحید برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.3,
   "end": 337.04,
   "text": "من از شما سؤال می‌کنم اگر جلوی آینه وایستی ببینی یقه ات کجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 337.04,
   "end": 341.94,
   "text": "از تو آینه دست دراز می‌کنی از تو آینه یقه رو درست کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.94,
   "end": 344.74,
   "text": "نه. چرا یقه خودتو درست می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.74,
   "end": 346.56,
   "text": "تو که داری تو آینه رو نگاه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 346.56,
   "end": 348.76,
   "text": "چرا دست میاری یقه خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.76,
   "end": 351.26,
   "text": "که تو آینه دیدی صاف می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.26,
   "end": 354.8,
   "text": "به جهت اینکه اون عکس داخل، اصلا تو توجه به اون عکس نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 354.8,
   "end": 357.48,
   "text": "در حقیقت توجه به خودت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.48,
   "end": 359.98,
   "text": "دقت بفرمایید چقدر ظریفه نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.98,
   "end": 362.64,
   "text": "خودت رو داری می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.64,
   "end": 364.68,
   "text": "اگرچه نگاهت به آینه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 364.68,
   "end": 371.98,
   "text": "لذا اگر نقصی در عکس خودت در آینه می‌بینی، در خودت جست‌وجوی اون می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 371.98,
   "end": 373.88,
   "text": "اون یقه رو تنظیم می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 373.88,
   "end": 379.06,
   "text": "این نکته‌ست. اگر تو صرفاً توجه به همون آینه، به خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 379.06,
   "end": 385.6,
   "text": "صورت آینه یا حتی عکسی که از آکِس درش افتاده بکنی، این هم توحید نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.6,
   "end": 391.12,
   "text": "اینکه امام رضا صلوات الله علیه می‌فرماید زمین و آسمان مرآت‌اند، خدا رو نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 391.12,
   "end": 394.26,
   "text": "یعنی تو اصلاً خدا رو می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 394.26,
   "end": 395.96,
   "text": "خدا رو داری نگاه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.96,
   "end": 398.96,
   "text": "نه اینکه آسمان عیذ بالله خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 398.96,
   "end": 404.72,
   "text": "نه اینکه اون آینه تو هستی، نه اینکه حتی اون عکسی که داخل آینه‌ست تو هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 404.72,
   "end": 407.9,
   "text": "اون عکس تو نیستی، اون عکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.9,
   "end": 411.02,
   "text": "داره می‌نمایاند تو را به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.02,
   "end": 414.48,
   "text": "این عکس‌ها این عرض شود مرآت این صور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 414.48,
   "end": 418.42,
   "text": "مرآتیه، این زمین و آسمان و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.42,
   "end": 420.94,
   "text": "دارن علامتن. بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 420.94,
   "end": 425.68,
   "text": "شاید بشه سخن این باشه که تو خود قرآن اومده آیه صد و نود آل عمران باشه فکر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 425.68,
   "end": 428.54,
   "text": "ان فی-- دقت کنید چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 428.54,
   "end": 431.52,
   "text": "ان فی خلق السماوات والارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.52,
   "end": 437.3,
   "text": "واختلاف الليل والنهار رفت و آمد شب و روز لا آيات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.3,
   "end": 440.08,
   "text": "لا آيات لأولي الالباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 440.08,
   "end": 442.38,
   "text": "این آیات یعنی چی؟ یعنی نشانه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 442.38,
   "end": 445.78,
   "text": "یعنی نشا-- یعنی همون علائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 445.78,
   "end": 447.68,
   "text": "علائم. چرا بهش میگن علائم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 447.68,
   "end": 450.54,
   "text": "از علم میاد. علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 450.54,
   "end": 456.7,
   "text": "اصلاً چرا و چقدر زیبا، چقدر خوش که به این علائم رانندگی گفته‌ن علائم رانندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 456.7,
   "end": 458.38,
   "text": "تو، من از شما سؤال می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 458.38,
   "end": 461.42,
   "text": "این یه مثال دیگه. حالا بحث علامت که رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 461.42,
   "end": 467.98,
   "text": "وقتی شما می‌رسین می‌خوای بری مشهد، قصد مشهد، قصد امام رضا علیه الصلاة والسلام کردی حتی ح-- حتی نه مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.98,
   "end": 470.04,
   "text": "اصلاً قصد خود حضرت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 470.04,
   "end": 475.5,
   "text": "خب میری به سمت مشهد دیگه. می‌رسی به این پیچ‌ها می‌بینی علائم رانندگی زده ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 475.5,
   "end": 480.92,
   "text": "بپیچ به سمت راست. هیچوقت شما میری توجه کنی که ببینی به چه رنگی نوشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.92,
   "end": 485.88,
   "text": "رو چه فلزی نوشتن، نقاش کی بوده نویس-- اصلاً اینطوری گیر نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 485.88,
   "end": 488.96,
   "text": "اگر گیر کنی اینجا تو اصلاً مشهدو نمی‌بینی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 488.96,
   "end": 493.76,
   "text": "امام رضا رو تو نمی‌ب-- تو اینه، این نشونه غرق در این نشانه و این علامت شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 493.76,
   "end": 497.64,
   "text": "توجه کردی چی شد؟ بلکه اصلاً وقتی شما این آی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 497.64,
   "end": 499.76,
   "text": "این علامت رو دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 499.76,
   "end": 502.44,
   "text": "داره به تو تدای کجا رو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 502.44,
   "end": 505.98,
   "text": "حضرت رو. تو تدای مشهد برات می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 505.98,
   "end": 508.3,
   "text": "تازه وقتی رفتی ب-- این می‌شه توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 508.3,
   "end": 510.18,
   "text": "تو داری علامت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 510.18,
   "end": 514.3,
   "text": "اما چیزی که در تو تدای می‌شود حضور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.3,
   "end": 520.96,
   "text": "به این میگن مراقبه. که اگر تو حتی به مشهدم که رسیدی مشهد می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 520.96,
   "end": 523.7,
   "text": "اما باز مشهد نمی‌بینی، امام رضا می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 523.7,
   "end": 528.86,
   "text": "این آیه ت-- دیگه اینجا مشهد می‌شود آیه کبری امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 528.86,
   "end": 532.84,
   "text": "اینکه میگه امیرالمؤمنین آیه الكبرى‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 532.84,
   "end": 535.78,
   "text": "مشهد برای تو می‌شود آیه، اون علامت کبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 535.78,
   "end": 539.32,
   "text": "یعنی تو اونو دیدی اصلاً امام رضا داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.32,
   "end": 542.96,
   "text": "توجه ک-- توجه به طلا و نقره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 542.96,
   "end": 545.84,
   "text": "زر کوب و سنگ و آینه نمی‌کنی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 545.84,
   "end": 548.26,
   "text": "حضرت رو می‌بینی. این مثال‌ها رو دارم می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 548.26,
   "end": 550.6,
   "text": "یا کلمه. مثال دیگه. کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 550.6,
   "end": 552.5,
   "text": "شما الآن من به شما میگم خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 552.5,
   "end": 555.58,
   "text": "روی کاغذ بنویس خور کلمه خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 555.58,
   "end": 558.76,
   "text": "آیا شما محو در این خا و وا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 558.76,
   "end": 562.26,
   "text": "ره و شین و یا و دال میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 562.26,
   "end": 567.92,
   "text": "یا نه؟ تداییت برای اون خورشید، اون ماه، اون آفتاب برا تدای می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 567.92,
   "end": 569.9,
   "text": "اصلاً نمی‌شه بگی خب خورشید اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 569.9,
   "end": 574.04,
   "text": "هیچوقت میگی خورشید این خور، این کلمه‌ای که رو کاغذ نوشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 574.04,
   "end": 575.72,
   "text": "این تدای می‌کند برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 575.72,
   "end": 579.18,
   "text": "اصلاً گیر نمی‌کنی تو این خا و وا و ره و شین و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 579.18,
   "end": 582.38,
   "text": "اصلاً اینو که می‌بینی این علامت است برای کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 582.38,
   "end": 585.14,
   "text": "در تو تدای کند آفتاب را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 585.14,
   "end": 587.06,
   "text": "نظام هستی این چنین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 587.06,
   "end": 591.48,
   "text": "اگر یک لحظه شما یک مو، یعنی فاصله یک موئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 591.48,
   "end": 595.12,
   "text": "یک آن توجه به این نظام بکنی که خب حتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 595.12,
   "end": 597.38,
   "text": "حتی به قول علامه می‌فرماید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 597.38,
   "end": 601.6,
   "text": "فکر بردار هم نیست. حالا من برم به آسمان نگاه کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 601.6,
   "end": 604.46,
   "text": "فکرم رو به کار بندازم ببینم خدا رو می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 604.46,
   "end": 607.18,
   "text": "این هم حتی شرکه به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 607.18,
   "end": 614.74,
   "text": "این هم حتی توحید نیست. اصلاً در همون لحظه که تو می‌بینی، خدا می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 614.74,
   "end": 618.34,
   "text": "یعنی اون لحظه چیزی جز خدا تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 618.34,
   "end": 622.28,
   "text": "نمودا-- این‌ها نمودار خدایاند برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 622.28,
   "end": 624.43,
   "text": "کلمه مثال قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 624.43,
   "end": 626.64,
   "text": "علائم رانندگی مثال قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 626.64,
   "end": 631.8,
   "text": "عکس، مرآت. همه این‌ها برای اینن که خدا رو به تو بنمایانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 631.8,
   "end": 637.66,
   "text": "حالا اگر کسی فکر کنه که حالا من برم از شنبه بشینم ف-- اصلاً فکر بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 637.66,
   "end": 642.54,
   "text": "تو اگر در یک مجلس توحیدی این ختم کلام رو هم دقت کنید خیلی ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 642.54,
   "end": 650.04,
   "text": "اگر در یک مجلس توحیدی بنشینی فکر به این بکنی که خب حالا این چیزایی که من دارم می‌شنوم بهش فکر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 650.04,
   "end": 652.58,
   "text": "چجوری فکر کنم؟ آخ خسته شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 652.58,
   "end": 656.16,
   "text": "آخ ساعت چنده؟ چیجوری؟ اصلاً این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 656.16,
   "end": 658.54,
   "text": "توحید نیست. این‌ها حضور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 658.54,
   "end": 662.22,
   "text": "حضور، توحید، اینکه به توحید میگن حضور تام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 662.22,
   "end": 665.8,
   "text": "علامه میگه مراقبه یعنی اصلاً همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 665.8,
   "end": 667.66,
   "text": "یعنی دائم الحضور بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 667.66,
   "end": 673.88,
   "text": "یعنی تو وقتی نشستی در جلوی علائم دیگه محو در چی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 673.88,
   "end": 677.78,
   "text": "در اون کسی هستی که این علم اون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 677.78,
   "end": 683.02,
   "text": "علامات، علم. اصلاً ج-- چه جالب که علم هم از ریشه علمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 683.02,
   "end": 688.42,
   "text": "علم و عالم و معلوم و اینا اصلاً همه عالم علائم اویاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 688.42,
   "end": 692.7,
   "text": "همه چی اوست. همه چی نمود اوست، نمودار اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 692.7,
   "end": 696.56,
   "text": "و تو اگر این چنین نگاه کردی تازه رسیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 696.56,
   "end": 701.2,
   "text": "به مرحله اول توحید. تازه از اون لبه تیز شمشیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 701.2,
   "end": 703.94,
   "text": "فاصله گرفتی، خ-- از خطر گذشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 703.94,
   "end": 706.8,
   "text": "و اون فاصله مو رو رد کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 706.8,
   "end": 708.94,
   "text": "یک آن حواست نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 708.94,
   "end": 711.98,
   "text": "لذا میگن این دقت کنید این نکته آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 711.98,
   "end": 717.36,
   "text": "میگه که این اصلاً علامه می‌فرماید این توحید همون اندیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 717.36,
   "end": 719.96,
   "text": "این حضور همون اندیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 719.96,
   "end": 721.9,
   "text": "این مراقبه همون اندیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.9,
   "end": 725.88,
   "text": "اندیت اینکه میگه شهید ان طرب بهم یزبون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 725.88,
   "end": 729.76,
   "text": "امام فرمود شهید نظر می‌کند به وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 729.76,
   "end": 732.2,
   "text": "وجه خدا می‌بیند شهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 732.2,
   "end": 734.62,
   "text": "همه چی رو وجه-- اینا صبغات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 734.62,
   "end": 737.1,
   "text": "وجه خدااند دیگه عالم. شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 737.1,
   "end": 741.06,
   "text": "خدا می‌بیند و خدا. چیزی جز خدا نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 741.06,
   "end": 746.68,
   "text": "اگر چیزی جز خدا می‌دید حاضر نمی‌شد عزیزترین چیزش که جانش رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 746.68,
   "end": 755.5,
   "text": "خدا می‌بیند لذا محو در خدا می‌شود و فانی در خدا می‌شود و هیچ جزا و پاداشی هم نمی‌خواد چون به خدا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 755.5,
   "end": 757.1,
   "text": "فهم این قصه خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 757.1,
   "end": 759.78,
   "text": "دارم زور می‌زنم. که این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 759.78,
   "end": 766.24,
   "text": "داره میگه اینا چون اینو نفهمیدن از بسم الله الرحمن الرحیم پیغمبر هم بعدشون می‌اومد و پشت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 766.24,
   "end": 768.44,
   "text": "چون به حقیقت توحید نرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 768.44,
   "end": 770.46,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 770.46,
   "end": 773.76,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 773.76,
   "end": 777.08,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 777.08,
   "end": 780.06,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}