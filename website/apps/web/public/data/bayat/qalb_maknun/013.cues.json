   "title": "## نذر روزه و سفر غیرضروری",
   "start": 12.04,
   "end": 32.08
  },
  {
   "index": 1,
   "title": "## تأسف بر قلب نفهم و آیهٔ کهف",
   "start": 32.08,
   "end": 133.72
  },
  {
   "index": 2,
   "title": "## پایین آوردن افق شهادت و عمل",
   "start": 133.72,
   "end": 422.98
  },
  {
   "index": 3,
   "title": "## حدیث مرسل مصباح الهدایه و معیت",
   "start": 422.98,
   "end": 587.18
  },
  {
   "index": 4,
   "title": "## معیت در  عبادت",
   "start": 587.18,
   "end": 707.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 4.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.7,
   "end": 8.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.24,
   "end": 12.04,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.04,
   "end": 17.56,
   "text": "اگر کسی نذر کنه مثلا روز پنج‌شنبه هر هفته روزه بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.56,
   "end": 21.28,
   "text": "یا مثلا یه پنج‌شنبه، یه روزی رو روزه بگیره نذر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.28,
   "end": 25.06,
   "text": "خب گرفتن روزه در اون روز براش واجب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.06,
   "end": 29.64,
   "text": "سؤال اینه که آیا اجازه داره حتی به غیر ضرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.64,
   "end": 32.76,
   "text": "یعنی ز-- سفر ضرورتی براش نداره، سفر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.76,
   "end": 38.96,
   "text": "وقتی که اون روزی که نذر کرده روزه گرفته بره سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.96,
   "end": 45.6,
   "text": ". فتوای رهبر عزیرمون اینه که بله حتی اگر سفرش غیر ضرور باشه می‌تونه بره سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.6,
   "end": 48.88,
   "text": "، اما قضای اون روزه گردنش می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.88,
   "end": 52.2,
   "text": "کفاره هم نداره. بعدا باید قضاشو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.2,
   "end": 56.2,
   "text": "در خصوص روزه واجب هم خب بالاخره نذر که می‌کنه واجب می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.2,
   "end": 58.5,
   "text": "روزه‌های ماه مبارک رمضان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.5,
   "end": 67.52,
   "text": "مثلا روزه‌های واجب کلا مطلقا این چنینه به فتوای رهبری حتی ماه مبارک رمضان هم شما می‌تونید سفر غیر ضرور حتی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.52,
   "end": 70.24,
   "text": "اینکه روزه نگیری بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.24,
   "end": 76.7,
   "text": ". فتوای رهبری و فقط قضا گردنش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.7,
   "end": 82.12,
   "text": ". یه تاسفی بخوریم شروع به این چند دقیقه‌ای که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.12,
   "end": 85.26,
   "text": "قلب نفهم می‌خوایم حرف بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.26,
   "end": 90.64,
   "text": ". خب آیه‌ای که ما رسیدیم بهش آیه پنجاه و هفت سوره کهف که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.64,
   "end": 99.82,
   "text": "\"و من علم من من و کرب آيات ربه فأعرض عنها و نسي ما قدمت يداها إنّا جعلنا على قلوبهم أكنّا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.82,
   "end": 107.0,
   "text": "أن يفقهوه و في آذانهم وقرا و إن تدعهم إلى الهدى فلن يهتدوا إذا أبدا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.0,
   "end": 113.74,
   "text": "الله اکبر. ما چه کردیم که خدا این چنین با ما حرف می‌زنه، سخن می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.74,
   "end": 115.76,
   "text": ". ان- انصافا انسان چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.76,
   "end": 118.08,
   "text": "انسانی که باید به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.08,
   "end": 126.54,
   "text": "والای وجود و اون مدارج عالیه که عرض شود نفس ناطقه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.54,
   "end": 130.02,
   "text": "لایغفی سیرش می‌تونه به فوق عرش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.02,
   "end": 137.86,
   "text": "آخه چه کرده که خدا این چنین باهاش سخن گفته تو قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.86,
   "end": 141.2,
   "text": "که گوشش سنگین شده \"في آذانهم وقرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.2,
   "end": 143.58,
   "text": "نسي ما قدمت يداه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.58,
   "end": 146.78,
   "text": "گذشته‌شو فراموش کرده چه غلط‌هایی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.78,
   "end": 150.26,
   "text": ". فکر کرده خبریه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.26,
   "end": 155.22,
   "text": "استغفرالله. یا یه کاری می‌کنه خدا باهاش که قلبش نفهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.22,
   "end": 159.08,
   "text": "\"إن تدعوهم إلى الهدى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.08,
   "end": 163.42,
   "text": "فلن يهتدوا إذا أبدا\" اصلاً ابداً این هدایت پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.42,
   "end": 166.16,
   "text": "آخه چه کرده این انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.16,
   "end": 174.1,
   "text": "؟ حالا من داشتم تو خلوتم فکر می‌کردم که در خصوص همین تک و توک آیاتی که داریم بهش می‌پردازیم ما چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.1,
   "end": 181.18,
   "text": "یهو برخوردم به شرحی از حضرت آيت الله صمدی آملی از برجسته‌ترین شاگردای علامه حسن زاده دیگه کوب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 181.18,
   "end": 187.64,
   "text": "ایشون فرمود نظر علامه حسن زاده اینه که اکثر غریب به اتفاق آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.64,
   "end": 193.74,
   "text": "مربوط به عموم مردمه و قلیلی از آیات برای خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.74,
   "end": 198.38,
   "text": "عرض شود آدمای خواص کم‌ملی نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.38,
   "end": 202.78,
   "text": ". آخه ما چه کردیم که خدا با ما اینطوری صحبت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.78,
   "end": 212.12,
   "text": "؟ چرا خدا ب-- ما چرا باید طوری رفتار کنیم که خدا با ما با این آیاتش سخن بگه که \"إن الله ليس بظلام للعبيد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.12,
   "end": 214.82,
   "text": ". هیچوقت خدا ظلم نمی‌کنه به بنده‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 214.82,
   "end": 218.72,
   "text": "چرا تو ذهن تو، تو عالم خیال و وهم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.72,
   "end": 227.2,
   "text": "این خطورات اومده که خدا ظلم می‌کنه، که خدا باید بیاد بگه نه بابا جان بنده من خدا ظلم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.2,
   "end": 229.48,
   "text": "الله اکبر .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 229.48,
   "end": 231.6,
   "text": "آخه خسران تا چه حد ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 231.6,
   "end": 234.12,
   "text": "این قرآن به این عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 234.12,
   "end": 237.24,
   "text": "که دفعة در شب قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 237.24,
   "end": 241.7,
   "text": "بر ظرف وجودی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.7,
   "end": 247.6,
   "text": "نبی اکرم بر قلب مقدسشون نازل شده و چون اون لیله رو حضرت زهرا سلام الله علیها، علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 247.6,
   "end": 254.6,
   "text": "اندیاری هم فرمودن اون لیله حضرت زهرا سلام الله علیهاست پس ظرف نوری قرآن حضرت زهراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 254.6,
   "end": 260.04,
   "text": ". این همه عظمت به یکباره نازل شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 260.04,
   "end": 262.7,
   "text": "، ولی می‌بینید بیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 262.7,
   "end": 267.58,
   "text": "یعنی اکثری آیات قرآن تشرف ما‌هاست، به عموم مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 267.58,
   "end": 271.2,
   "text": "چقدر ما باختیم، چقدر از خدامون دوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 271.2,
   "end": 277.86,
   "text": ". چرا خدا باید با ما این چنین سخن بگه که \"إن الله لا يضيع أجر من أحسن عملا\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 277.86,
   "end": 282.56,
   "text": "خدا کسی که خوب عمل کنه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 282.56,
   "end": 284.62,
   "text": "اجرش رو ضایع نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.62,
   "end": 287.52,
   "text": "\"لا يضيع أجر من أحسن عملا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 287.52,
   "end": 294.78,
   "text": ". و باید انسان به قول حضرت آ-- حضرت صمدی آملی به جایی برسه که اصلاً عملی از خودش نبینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.78,
   "end": 303.32,
   "text": ". یعنی اصلاً همه رو انقدر اعمالش پر نور باشه که مگه نفرمود ما \"أسألك من حسنة فمن الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 303.32,
   "end": 308.94,
   "text": "انقدر حسنه داشته باشه و یه دونه از این حسنات و اعمال خودش نبینه از خدا ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 308.94,
   "end": 312.24,
   "text": ". خودش رو خالی خالیه مثل امیرالمؤمنین علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 312.24,
   "end": 317.26,
   "text": "چقدر عجیبه این روایت، این کار مولا که رو کفن سلمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 317.26,
   "end": 320.62,
   "text": "نوشت با دست خالی دارم میام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 320.62,
   "end": 325.64,
   "text": "سلمان نوشت من با دست خالی دارم میام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 325.64,
   "end": 327.76,
   "text": "الله اکبر .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 327.76,
   "end": 329.68,
   "text": "اصلاً عملی در خودش نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 329.68,
   "end": 332.78,
   "text": "همه رو اتصاف به خدا می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 332.78,
   "end": 339.88,
   "text": ". حتی ما گاهی اوقات به قول ایشون وقتی میایم از شهادت و شهدا تازه با عظمت بالا منبر یاد می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 339.88,
   "end": 342.56,
   "text": "استناد به این قبیل آیات می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 342.56,
   "end": 345.1,
   "text": "\"إن الله اشترى من المؤمنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 345.1,
   "end": 347.56,
   "text": "أموالهم وأنفسهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 347.56,
   "end": 351.32,
   "text": "که چی بشه؟ رفته شهید شده، جان و مالشو داده که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 351.32,
   "end": 354.42,
   "text": "\"وأن لهم الجنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 354.42,
   "end": 357.1,
   "text": "که به بهشت برسه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 357.1,
   "end": 365.5,
   "text": "انقدر ما شهادت رو حدشو میاریم پایین حتی اصلاً انگار معامله‌ست، بده بستونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 365.5,
   "end": 370.16,
   "text": "واقعا شما ببینید حتی تو این آیه هم ما حرف داریم اگرچه این دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 370.16,
   "end": 374.32,
   "text": "حد بالاست اما \"من المؤمنين رجال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 374.32,
   "end": 377.54,
   "text": "صدقوا ما عاهدوا الله عليه ومنهم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 377.54,
   "end": 381.38,
   "text": "قضی نحبه ومنهم من ينتظر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 381.38,
   "end": 384.08,
   "text": "این هم الحمدالله باز این سطح بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 384.08,
   "end": 387.3,
   "text": "اما حرف چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 387.3,
   "end": 393.34,
   "text": "چرا ما به گونه‌ای رفتار نکنیم که خدای منّان چون ظرفیت وجودی انسان این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 393.34,
   "end": 398.6,
   "text": "آقا شوخی نیست و فخت-- و نفخت و در خصوص تک تک شما این رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.6,
   "end": 404.08,
   "text": "مگه بحثش نگذاشت که شماها بسم الله الرحمن الرحیم هستید، تک تک‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 404.08,
   "end": 407.9,
   "text": "مگر بحثش نگذشت که تک تک شما آیت الله‌اید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 407.9,
   "end": 411.68,
   "text": "مگر بحثش نگذشت که تک تک شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 411.68,
   "end": 413.72,
   "text": "کلمات، کلمات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 413.72,
   "end": 416.88,
   "text": "کلمت الله‌اید، کلمات وجودی هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 416.88,
   "end": 422.98,
   "text": "این‌ها اگر بحثش نگذشت چرا ما به گونه‌ای رفتار نکنیم که البته این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 422.98,
   "end": 427.64,
   "text": "من خیلی تلاش کردم دیدم که مرسله این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 427.64,
   "end": 432.22,
   "text": "این حدیثی که زمان جنگ خیلی به ما می‌گفتن مرسل یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 432.22,
   "end": 436.02,
   "text": "سند خاصی تو مجامع روایی ما براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 436.02,
   "end": 445.48,
   "text": "نیست. اما خب وقتی دیدیم یکی مثل آقای بهجت ازش سؤال کردن، ایشون استناد داده به کتاب مصباح الهدایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 445.48,
   "end": 449.32,
   "text": "همین حدیث رو به صفحه صد و شونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 449.32,
   "end": 453.54,
   "text": "و البته شبیه به همین حدیث در مستدرک الوسائل هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 453.54,
   "end": 458.28,
   "text": "من نوشتم خیلی هم کیف کردم خواستید برید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 458.28,
   "end": 461.72,
   "text": "جلد هجده صفحه چهارصد و نوزده شبیه به اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 461.72,
   "end": 464.6,
   "text": "بعد اونجا هم میگه مرسل، مرسل یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 464.6,
   "end": 468.36,
   "text": "این سند خاصی تو مجامع روایی ما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 468.36,
   "end": 476.3,
   "text": "ولی در مثلا متون عرفانی ما، اسلامی ما زیاد عرفا، حکما اینا ازش یاد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 476.3,
   "end": 481.04,
   "text": "چرا خدا اینطوری ما ج-- به گونه‌ای رفتار نکنیم که خدا با ما اینطوری حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 481.04,
   "end": 484.98,
   "text": "من اینو بخونم اونایی که جبهه بودن ذائقه‌شون شیرین بشه یادشون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 484.98,
   "end": 488.28,
   "text": "که \"من طلبنی وجدنی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 488.28,
   "end": 492.48,
   "text": "طلبنی. هرکس که منو طلب کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 492.48,
   "end": 496.46,
   "text": "نه از من بهش طلب کنه، درجه، مقام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 496.46,
   "end": 498.62,
   "text": "نورانیت و معنویت حتی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 498.62,
   "end": 502.52,
   "text": "من طلبنی، منو طلب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 502.52,
   "end": 505.26,
   "text": "بله اگر طلب کرد وجدنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 505.26,
   "end": 512.16,
   "text": "و \"من وجدنی عرفنی\" هرکس که منو پیدا کرد می‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 512.16,
   "end": 515.1,
   "text": "چرا ما خدا رو نمی‌شناسیم؟ چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 515.1,
   "end": 516.76,
   "text": "وجدنی صورت نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 516.76,
   "end": 519.74,
   "text": "چرا وجدنی نیست؟ چون طلبنی نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.74,
   "end": 523.52,
   "text": "و \"من عرفنی احبنی\" هرکس که منو شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 523.52,
   "end": 527.1,
   "text": "دوستدار من میشه. خدا دوست داشتنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 527.1,
   "end": 533.2,
   "text": "خب آقا وقتی کسی دوست خدا شد دیگه از خدا سیب و گلابی طلب میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 533.2,
   "end": 538.3,
   "text": "که حتی خدا با مژده‌ش میخواد با ما حرف بزنه از حورالعین و سیب و گلابی حرف بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 538.3,
   "end": 541.12,
   "text": "و \"من احبنی عشقنی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 541.12,
   "end": 548.62,
   "text": "میره بالاتر. هرکس که دوست من شد میبینه عه به عشق افتاد، شدت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 548.62,
   "end": 552.0,
   "text": "\"الذین آمنوا أشد حبا لله\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 552.0,
   "end": 556.14,
   "text": "این همون عشقه \"و من عشقنی عشقتو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 556.14,
   "end": 559.3,
   "text": "هرکس که عاشق من شد منم عاشقش میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 559.3,
   "end": 562.82,
   "text": "الله اکبر \"و من عشقتو قتلتو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 562.82,
   "end": 565.5,
   "text": "هرکی عاشق من شد من میکشمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 565.5,
   "end": 567.78,
   "text": "\"و من قتلته فعلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.78,
   "end": 570.34,
   "text": "دیته\" هرکس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 570.34,
   "end": 572.96,
   "text": "من بکشمش دیه‌ش پا منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 572.96,
   "end": 577.58,
   "text": "واقعا کسیو بکشی باید دیه بدی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 577.58,
   "end": 582.8,
   "text": ". \"و من علی دیته\" هرکس که دیه‌اش بر منه \"فأنا دیته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 582.8,
   "end": 586.88,
   "text": "من دیه‌شم. یعنی چی؟ یعنی خودم رو بهش می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 586.88,
   "end": 592.32,
   "text": "مثل \"صوم لی وأنا أجزی عن صیمه\" که هرکس روزه بگیره من پاداششم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 592.32,
   "end": 594.68,
   "text": "خیلی حرف بالاست. خیلی حرف عمیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 594.68,
   "end": 598.74,
   "text": "چرا، چرا ما به گونه‌ای رفتار نکردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 598.74,
   "end": 600.92,
   "text": "که خدا اینطوری با ما صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 600.92,
   "end": 609.32,
   "text": "بیایید رو اون کلماتی که رو قرآن پیغمبر یه عده رو همراه خودش میگه \"و من معي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 609.32,
   "end": 611.4,
   "text": "رو این معيّت‌ها کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.4,
   "end": 622.7,
   "text": "\"هو معكم أینما كنتم\" انقدر شیرینه، انقدر شیرینه اینجا دیگه آدم براش مهم نیست کجا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 622.7,
   "end": 628.5,
   "text": ". \"أینم یا فأینما تولوا فثم وجه الله\" هر طرف رو کنید رو به خدا کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 628.5,
   "end": 631.64,
   "text": "اصلا دیگه براش مهم نیست روش به چه سمتی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 631.64,
   "end": 636.46,
   "text": "او خدا می‌بیند و خدا که امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 636.46,
   "end": 641.78,
   "text": "ظاهرا داشتن بچه سال بودن نماز می‌خوندن رو درب باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 641.78,
   "end": 647.36,
   "text": "بعد ابو حنیفه پز علمشو می‌داد و اینا به امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 647.36,
   "end": 653.32,
   "text": "صلوات الله علیه گفت به پسرت تذکر بده بگو کراهت داره رو درب باز داره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 653.32,
   "end": 657.72,
   "text": "حضرت فرمود که از خودش نمازش که تموم شد از خودش بپرس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 657.72,
   "end": 660.94,
   "text": "نماز امام صادق صلوات الله علیه تموم شد بهش گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 660.94,
   "end": 665.62,
   "text": "حضرت فرمود خدایی که من رو به او کرده‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 665.62,
   "end": 671.84,
   "text": "\"فثم وجه الله\" این وجه خدا نزدیک‌تر از اون در باز به منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 671.84,
   "end": 673.48,
   "text": "آقا جلو پرستو جمع کن برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 673.48,
   "end": 677.72,
   "text": "چهارتا کلام یاد گرفتی پیاده نشده تو وجودت فکر می‌کنی خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 677.72,
   "end": 679.7,
   "text": "بیایید رشد کنیم بالا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 679.7,
   "end": 682.92,
   "text": "متاسفانه این قلوب رو تم-- حرف من تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 682.92,
   "end": 686.02,
   "text": "ولی هرچی می‌خوایم هی قلب خوبو بگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 686.02,
   "end": 688.22,
   "text": "قلب سالم رو ببینیم چند تا بیشتر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 688.22,
   "end": 693.04,
   "text": "همش قلب‌های ظلمانیه متاسفانه تو قرآن، قلب نفهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 693.04,
   "end": 696.84,
   "text": "خود قلب نفهم چند بخش حالا ما تو بخش اولشیم انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 696.84,
   "end": 701.62,
   "text": "عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 701.62,
   "end": 707.8,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
