   "start": 36.4,
   "end": 115.82
  },
  {
   "index": 2,
   "title": "## حرز کامل امام سجاد و حضور این آیه",
   "start": 115.82,
   "end": 258.38
  },
  {
   "index": 3,
   "title": "## شهید؛ آیت احیاگر زمین مرده",
   "start": 258.38,
   "end": 312.88
  },
  {
   "index": 4,
   "title": "## برکات شهادت سردار و یاران",
   "start": 312.88,
   "end": 368.76
  },
  {
   "index": 5,
   "title": "## قدرت بازدارندگی و بطلان مذاکرهٔ ذلیلانه",
   "start": 368.76,
   "end": 565.56
  },
  {
   "index": 6,
   "title": "## اعراض از ارزش‌های شهید؛ نفهمی قلب",
   "start": 565.56,
   "end": 623.74
  },
  {
   "index": 7,
   "title": "## مکث دنیاپرستی در برابر انتقام",
   "start": 623.74,
   "end": 708.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.04,
   "end": 7.42,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.42,
   "end": 11.46,
   "text": "آیاته السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.46,
   "end": 15.96,
   "text": "اگر چنانچه کسی نذری بکنه که در حد توانش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.96,
   "end": 19.12,
   "text": "نمی‌تونه تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.12,
   "end": 26.32,
   "text": "اون عرض شود حالا قوای وجودیش یا سعه مالیش یا هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.32,
   "end": 32.6,
   "text": "در جایی که در حد و در توانش نیست نذر رو بکنه، این نذر باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.6,
   "end": 35.52,
   "text": "مثلاً کسی نیت کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.52,
   "end": 39.94,
   "text": "نذر کنه که از اینجا تا کربلا پیاده بره، در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.94,
   "end": 45.72,
   "text": "طاقت و سعه جسمی نداره برای رفتن پیاده به کربلا، این باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.72,
   "end": 52.04,
   "text": "یا مثلاً کسی نیت کنه یه دفعه جو زده بشه بگه من نذر می‌کنم که کل تهرونو آش بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.04,
   "end": 53.84,
   "text": "خب چجوری می‌خوای کل تهرونو...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.84,
   "end": 56.58,
   "text": "مثلا این نذر باطله. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.58,
   "end": 61.98,
   "text": "باید نذری که می‌کنی مطابق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.98,
   "end": 66.88,
   "text": "توانت باشد. خب یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.88,
   "end": 75.04,
   "text": "پیرامون موضوع قلبی‌ست که در کنان و پرده‌هایی قرار گرفته که نمی‌فهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.04,
   "end": 77.6,
   "text": "آیه پنجاه و هفت سوره کهف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.6,
   "end": 82.4,
   "text": "عجب آیه‌ایه که ابتداش رو یک جلسه عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.4,
   "end": 88.94,
   "text": "\"و من علم من من ذکر بآیات ربه فاعرض عنها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.94,
   "end": 95.92,
   "text": "عرض کردیم که وقتی یاد از آیات الهی میشه \"فاعرض عنها\" پشت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.92,
   "end": 99.58,
   "text": "و چون پشت می‌کنند به آیات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.58,
   "end": 102.98,
   "text": "و همچنین البته که حالا بعداً انشاالله توضیحش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.98,
   "end": 106.84,
   "text": "\"نسی ما قدمت یدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.84,
   "end": 113.14,
   "text": "و فراموش می‌کنند پیشینه‌شونو اینجا \"انا جعلنا على قلوبهم اكنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.14,
   "end": 118.38,
   "text": "خیلی عجیبه من داشتم حرز امام سجاد سلام الله عليه رو بررسی می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.38,
   "end": 121.36,
   "text": "البته اون حرز که مشهور و معروفه نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.36,
   "end": 123.94,
   "text": "یه حرز دیگه‌ای دارن به نام حرز کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.94,
   "end": 126.5,
   "text": "اون حرز جامع رو نمیگم حرز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.5,
   "end": 129.42,
   "text": "کامل امام سجاد، نه جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.42,
   "end": 132.52,
   "text": "خیلی حرز عجیبی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.52,
   "end": 136.9,
   "text": "این حرز برای رفع و دفع مشکلات و بلاها و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.9,
   "end": 140.84,
   "text": "خیلی مؤثره و در کتاب تفسیر اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.84,
   "end": 145.72,
   "text": "بیت جلد هشت، صفحه پونصد و بیست می‌تونید ببینیدش که اونجام البته ارجاع داده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.72,
   "end": 148.72,
   "text": "بحار جلد هشتاد و دو، صفحه دویست و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.72,
   "end": 150.76,
   "text": "بین حرز امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.76,
   "end": 153.92,
   "text": "سجاد سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.92,
   "end": 161.0,
   "text": "همین آیه اومده. همین آیه از اینجا که \"انا جعلنا على قلوبهم اكنه\" اومده تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.0,
   "end": 167.62,
   "text": "انتهای آیه \"فلن يهتدوا اذا ابدا\" که اصلاً و ابداً این‌ها هدایت‌پذیر نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.62,
   "end": 174.5,
   "text": "بعد حضرت دو-- شروع به دعا می‌کنه که \"اللهم احرسنا بعینك التي لا تنام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.5,
   "end": 179.72,
   "text": "پیداست که یک رمز و رموزی در این آیه هست که ما بی‌خبریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.72,
   "end": 183.38,
   "text": "که در حرز کامل حضرت سجاد سلام الله عليه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.38,
   "end": 186.44,
   "text": "یکی از نکات خیلی مهم همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.44,
   "end": 188.88,
   "text": "بیان آیات است. ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.88,
   "end": 192.82,
   "text": "ببینید \"ذكر بآیات ربه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.82,
   "end": 197.84,
   "text": "اینکه آیات خدا که یک جلسه بحثش گذشت، همه نظام وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.84,
   "end": 200.48,
   "text": "کلمات وجودی به نوعی آیات الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.48,
   "end": 203.1,
   "text": "البته نسبت به رتبه وجودیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.1,
   "end": 205.58,
   "text": "نسبت به سعه وجودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.58,
   "end": 207.68,
   "text": "این کلمات و این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.68,
   "end": 213.76,
   "text": "کوچیک و بزرگن. تا جایی که آیت الله العظمی عرض کردیم مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.76,
   "end": 222.58,
   "text": "یه آیه‌ای از قرآن هستش که اینم براتون بخونم ببینید وقتی که آیه‌ای نازل، یک آیه‌ای نازل میشه چه اتفاقی میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.58,
   "end": 225.86,
   "text": "آیه شصت و پنج سوره نحل \"والله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.86,
   "end": 228.48,
   "text": "انزل من السماء ماء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.48,
   "end": 230.94,
   "text": "وقتی آبی از آسمون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.94,
   "end": 235.38,
   "text": "\"فاحیا به البر-- به الارض بعد موتها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.38,
   "end": 237.92,
   "text": "و زمین مرده با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.92,
   "end": 243.98,
   "text": "آیه، با اون عرض شود آ-- باران با اون آب از آسمان نازل شده زنده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.98,
   "end": 247.32,
   "text": "\"ان في ذلك لآیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.32,
   "end": 252.34,
   "text": "اینم آیه است. البته لقوم يسمعون برای کسی که گوش شنوا داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.34,
   "end": 254.56,
   "text": "گوشش سنگین نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.56,
   "end": 258.38,
   "text": "حالا شما دقت بفرمایید یه پیوند بدیم به موضوع روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.38,
   "end": 262.52,
   "text": "آیا جز این است که باران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.52,
   "end": 266.02,
   "text": "احیا می‌کند زمین مرده‌ها-- مرده را؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.02,
   "end": 268.64,
   "text": "و آیا جز این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.64,
   "end": 272.24,
   "text": "شهید احیاگری می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.24,
   "end": 275.68,
   "text": "زمین‌های مرده را احیا می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.68,
   "end": 279.96,
   "text": "پاک می‌کند. در زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.96,
   "end": 285.38,
   "text": "شهدا می‌گیم که \"تبتم و تبت الارض التي فيها دفنتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.38,
   "end": 287.64,
   "text": "تو خوده-- شما خودتون پاک شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.64,
   "end": 290.62,
   "text": "هر کجام که قدم گذاشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.62,
   "end": 293.3,
   "text": "یا دفن شدید، اونجا رم پاک می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.3,
   "end": 296.72,
   "text": "مثل بارانی هستید که از آسمان نازل می‌شید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.72,
   "end": 298.88,
   "text": "و احیاگری می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.88,
   "end": 301.3,
   "text": "خب تا اینجا دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.3,
   "end": 304.44,
   "text": "پس شهید هم به نوعی آیت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.44,
   "end": 308.6,
   "text": "بلکه یکی از آیات عظما و بزرگ الهی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.6,
   "end": 311.16,
   "text": "آیات اعظم الهی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.16,
   "end": 312.88,
   "text": "و سبب احیاگری می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.88,
   "end": 317.58,
   "text": "در این حین اگر کسی اعراض کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.58,
   "end": 323.14,
   "text": "به این شهید و به این احیاگری شهید اعراض کنه، پشت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.14,
   "end": 329.44,
   "text": "چه اتفاقی میفته؟ چون پشت کرده قرآن می‌فرماید \"فاعرض عنها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.44,
   "end": 334.16,
   "text": "چون پشت کرد \"انا جعلنا على قلوبهم اكنه\" این دیگه نمی‌فهمه حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.16,
   "end": 336.42,
   "text": "می‌بینی نمی‌فهمه. شما بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.42,
   "end": 340.74,
   "text": "ببینید تو همین آثار و برکاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.74,
   "end": 345.14,
   "text": "تو همین دو، سه روزه شهادت حاج قاسم عزیز و یارانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.14,
   "end": 349.46,
   "text": "داریم می‌بینیم نمودی که از آثار و برکات این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.46,
   "end": 353.0,
   "text": "عرض شود نزول باران رحمت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.0,
   "end": 357.34,
   "text": "توسط این شهدا تو اجتماع و پیکره اجتماع داریم می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.34,
   "end": 360.9,
   "text": "بشینید لیست کنید ببینید چند تا آثار و برکات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.9,
   "end": 363.48,
   "text": "من چندش رو براتون بشمرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.48,
   "end": 366.16,
   "text": "اولا حال عمومی مردم خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.16,
   "end": 372.74,
   "text": "دیروز عرض کردم دوباره حتی امثال ما که تو پیچ و خم کوچه‌ها و روزمرگی زندگی دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.74,
   "end": 380.18,
   "text": "فراموش کرده بودیم اینها خیلی چیزها رو دلبسته شده بودیم به دنیا احیا دوباره حالمون خوش شد، آماده پرواز شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.18,
   "end": 385.38,
   "text": "چیز کمی نیست. به نظر بنده حقیر ارزش‌های انقلاب دوباره زنده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.38,
   "end": 387.64,
   "text": "دوباره احیای ارزش‌ها صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.64,
   "end": 391.82,
   "text": "دوباره بر لسان مردم ارزش‌های اوایل انقلاب داره جاری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.82,
   "end": 396.06,
   "text": "اینا چیز کمی نیست. انقدر رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.06,
   "end": 402.3,
   "text": "توی عرض شود رای آوردن یکی از رییس جمهورهای سابق ما خوشحال شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.3,
   "end": 407.3,
   "text": "اون اوایل که میگفت ارزش‌های انقلاب زنده شده، دوباره بر لسان مردم جاری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.3,
   "end": 411.0,
   "text": "این چیز کمی نیست. عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.0,
   "end": 418.66,
   "text": "جالبه که تمام اون اغتشاشاتی که اخیرا تو آبان ماه تو کشور ایجاد شد، آلودگی‌هایی که ازش به پا شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.66,
   "end": 423.52,
   "text": "غبارهایی که نشوند رو اذهان و دل مردم این رو برطرف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.52,
   "end": 425.76,
   "text": "با یه نگاه سطحی هم میشه اینها رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.76,
   "end": 428.7,
   "text": "چه به موقع وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.7,
   "end": 431.38,
   "text": "انتخابات کشور خودمون نزدیکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.38,
   "end": 437.76,
   "text": "یه وفاق ملی دوباره ایجاد کرد، دوباره مردم حواسشون جمع کنن به هر کسی رای ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.76,
   "end": 442.54,
   "text": "بر علیه آمریکا و استکبار یه جبهه مقاومت متحد ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.54,
   "end": 445.82,
   "text": "متحد یعنی اتحاد بین جبهه مقاومت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.82,
   "end": 451.34,
   "text": "این‌ها چیز کمی نیست که انشاالله منجر بشه به خروج حداقل خروج آمریکا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.34,
   "end": 454.38,
   "text": "منطقه. یادم نمیره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.38,
   "end": 459.2,
   "text": "همین رییس جمهور فعلی متاسفانه وقتی میخواست رای بیاره یک یه عزیزی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.2,
   "end": 462.02,
   "text": "عزیز که اشتباه می‌کنم اشتباه گفتم عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.02,
   "end": 468.14,
   "text": "از نظر اونها عزیز که متاسفانه از سردمداران نظاممون هم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.14,
   "end": 471.9,
   "text": "توی جلسه عمومی عنوان کرده بود که حالا ما امیدواریم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.9,
   "end": 480.28,
   "text": "دولت این آقا این اتفاق بیفته که بودجه نظامی صرف مسائل فرهنگی بشه و همه هم هورا و کف و دست و شادی و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.28,
   "end": 487.6,
   "text": "انقدر شعورشون نمیرسید. الان دارن میفهمن اهمیت داشتن قدرت بازدارندگی و دفاعی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.6,
   "end": 492.81,
   "text": "و چقدر مهمه که به توانمندی‌های داخلی و نظامیمون متکی باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 492.81,
   "end": 496.42,
   "text": "اینکه پن پنبه مذاکره با آمریکا واقعا زده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 496.42,
   "end": 502.04,
   "text": "یعنی اگر الان کسی دوباره حرف از مذاکره با آمریکا بزنه، این یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 502.04,
   "end": 506.6,
   "text": "واقعا دیگه جز اینکه بگیم نفوذه چیزی دیگه‌ای نمیشه گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.6,
   "end": 510.34,
   "text": "یعنی اصلا دیگه این هیچ بویی از انقلاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 510.34,
   "end": 513.36,
   "text": "ارزش‌های نظام ما نبرده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.36,
   "end": 516.94,
   "text": "اتحاد سیاسی که عرض شود تو خود عراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.94,
   "end": 521.72,
   "text": "و بیرون از عراق تو خود کشورمون ایجاد شد یا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.72,
   "end": 525.66,
   "text": "دسیسه‌ای که چیدند ایران ستیزی کنند تو عراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 525.66,
   "end": 531.72,
   "text": "بین ایران و عراق انفکاک ایجاد کنند که بحثش دیروز گذشت با شهید شدن هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.72,
   "end": 533.82,
   "text": "هم سردار سلیمانی هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 533.82,
   "end": 536.18,
   "text": "هم شهید مهندس با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 536.18,
   "end": 541.36,
   "text": "این عرض شود توطئه خنثی شد چون هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.36,
   "end": 545.42,
   "text": "هر دو کشور با هم متحد شدن تو این عزاداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 545.42,
   "end": 553.94,
   "text": "عرض کنم خدمتتون اتحاد خود مردم عراق بر علیه اغتشاشاتی که اخیرا تو عراق رخ داده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 553.94,
   "end": 556.34,
   "text": "و خیلی چیزای دیگه که حالا فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 556.34,
   "end": 562.94,
   "text": "حالا شما بیایید ببینید این آیت الهی که این همه ثمرات داره که ما بخشیش رو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.94,
   "end": 565.56,
   "text": "تیتر می‌کنیم، عنوان می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.56,
   "end": 568.64,
   "text": "اگر کسی بیاد اعراض کنه به این آیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.64,
   "end": 572.3,
   "text": "به این شهدا پشت کنه به این شهدا با ارزش‌های شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 572.3,
   "end": 575.3,
   "text": "اگه کسی بگه آقا یعنی چی پشت کردن همه دارن تعظیم میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 575.3,
   "end": 577.64,
   "text": "خب به ارزش‌های شهدا پشت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 577.64,
   "end": 581.14,
   "text": "و اون چیزی که امثال سلیمانی‌ها دنبالش بودند پشت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.14,
   "end": 582.9,
   "text": "این قطعاً آدم نفهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 582.9,
   "end": 587.14,
   "text": "قلبش نمی‌فهمه. طبق صریح آیه قرآن این نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 587.14,
   "end": 593.14,
   "text": "ببینید این نماینده‌ای که با کمال خباثت و رذالت دو مرتبه توی همچین فضایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 593.14,
   "end": 597.54,
   "text": "که باران رحمت الهی نازل شده دو مرتبه میاد با صراحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.54,
   "end": 603.46,
   "text": "میگه که ما که زورمون به آمریکا نمی‌رسه، زورمون به نمی‌دونم فرانسه و انگلیس و اینا نمی‌رسه که مذاکره کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.46,
   "end": 605.66,
   "text": "یعنی این دیگه اوج خباثت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.66,
   "end": 609.08,
   "text": "این یعنی اوج اعراض کردن به آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 609.08,
   "end": 613.64,
   "text": "آخه من نمی‌دونم چرا تو دهن اینا نمی‌خورن از طرف یا اونها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.64,
   "end": 615.22,
   "text": "دستشون با اینا توی یک کاسه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 615.22,
   "end": 620.29,
   "text": "متاسفانه وقتی تو شورای امنیت ملی ما کسانی هستند که وقتی میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 620.29,
   "end": 627.3,
   "text": "دیدن خانواده شهید سلیمانی و خانواده شهید سلیمانی تقاضا میکنن که انتقام پدر ما رو کی میگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.3,
   "end": 631.76,
   "text": "متاسفانه با پررویی تمام میگن میگیرن، میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.76,
   "end": 635.98,
   "text": "به جای اینکه مقتدرانه وایسته میگیریم و دل این خانواده رو گرم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 635.98,
   "end": 639.42,
   "text": "وقتی اینجور کسای تو شورای امنیت ملی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.42,
   "end": 643.0,
   "text": "ما فقط امید داریم به دل شیر رهبر دوباره یه کاری بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 643.0,
   "end": 645.22,
   "text": "الان میبینید داره دیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.22,
   "end": 651.9,
   "text": "یعنی یمن هم امروز دوباره پیام داد که آقا این مکسی که ایران داره میکنه داره به ضرر تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.9,
   "end": 654.74,
   "text": "شما فکر میکنید این مکس از چی ناشی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 654.74,
   "end": 659.04,
   "text": "رهبر عزیز که همون اول اعلام کرد انتقام سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 659.04,
   "end": 666.1,
   "text": "این مردم همه به یکباره سیل خروشان دارن میگن انتقام سخت از بیرون مرزها و داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.1,
   "end": 669.98,
   "text": "این مکس از چیه؟ جز این مکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.98,
   "end": 673.04,
   "text": "دنیاپرستی و ترس و رعب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.04,
   "end": 676.02,
   "text": "غرب گراییه؟ جز اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.02,
   "end": 680.02,
   "text": "جز اعراض به آیات خدا و نفهمی محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.02,
   "end": 683.24,
   "text": "جز اینه؟ حالا ما کی باید بشناسیم خداوکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.24,
   "end": 688.46,
   "text": "کی باید دیگه اینها رو بشناسیم که متاسفانه خودمون زمام امورمون رو دستشون دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 688.46,
   "end": 692.42,
   "text": "امیدوارم که امثال سردار سلیمانی‌ها و عالم بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 692.42,
   "end": 697.26,
   "text": "خودشون دست به کار بشن یه کاری بکنن چون خیلی داره خطرناک میشه قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.26,
   "end": 702.56,
   "text": "انشاالله که عاقبت ما ختم بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 702.56,
   "end": 708.46,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}