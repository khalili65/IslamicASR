 },
 "chapters": [
  {
   "index": 0,
   "title": "## نذر زن بدون اذن شوهر",
   "start": 10.34,
   "end": 36.7
  },
  {
   "index": 1,
   "title": "## قلب مکنون؛ آیهٔ بیست‌وپنج انعام",
   "start": 36.7,
   "end": 62.06
  },
  {
   "index": 2,
   "title": "## حواس پنج‌گانه در یک آیه",
   "start": 62.06,
   "end": 86.82
  },
  {
   "index": 3,
   "title": "## هرم فکری کودک",
   "start": 86.82,
   "end": 674.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.88,
   "end": 10.34,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.34,
   "end": 13.54,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.54,
   "end": 20.88,
   "text": "در خصوص نذر اگر زنی بدون اذن شوهرش حتی در خصوص اموال خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.88,
   "end": 23.96,
   "text": "نذر کنه این نذر صحیح هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.96,
   "end": 26.74,
   "text": "آقا فرمودن نه خیر نذرش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.74,
   "end": 32.4,
   "text": "زن بدون اذن شوهر حتی در خصوص اموال خودش هم نمیتونه نذر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.4,
   "end": 37.48,
   "text": "حالا اینجا دقت بفرمایید این نه یعنی اینکه زن نمی‌تواند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.48,
   "end": 41.36,
   "text": "اموال خودش تصرف کند، به این معنا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.36,
   "end": 43.18,
   "text": "چرا؟ می‌تونه تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.18,
   "end": 46.6,
   "text": "اینجا به معنای این است که دیگه این نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.6,
   "end": 49.66,
   "text": "لا-- واجب الوفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.66,
   "end": 53.62,
   "text": "یعنی این نذر باطله. نه اینکه اون نمی‌تونه در اموالش تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.62,
   "end": 57.84,
   "text": "تصرف کنه اشکال نداره. اما نذرش واجب الادا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.84,
   "end": 62.06,
   "text": "یعنی نذرش باطله. این اشتباه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.06,
   "end": 69.0,
   "text": "در خصوص قلبی که در کنانی قرار گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.0,
   "end": 74.82,
   "text": "حقایق رو متوجه نمی‌شه به عنوان قلب مکنون اشاره به آیه بیست و پنج انعام می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.82,
   "end": 77.86,
   "text": "نکته دیگری به فضل الهی از این آیه بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.86,
   "end": 81.36,
   "text": "ان‌شاءالله بریم سراغ آیات بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.36,
   "end": 84.36,
   "text": "دقت اگر بفرمایید خیلی جالبه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.36,
   "end": 90.5,
   "text": "طی همین آیه به چند تا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.5,
   "end": 96.68,
   "text": "اعضا و جواره انسان که مربوط‌اند به اون حواس پنج گانه اشاره شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.68,
   "end": 103.04,
   "text": "اولاً می‌فرماید ‫وَمِنْهُم مَّن يَسْتَمِعُ إِلَيْكَ‬ این بحث گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.04,
   "end": 105.62,
   "text": "گوش، گوش که می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.62,
   "end": 111.42,
   "text": "یا یه جا دیگه‌ش می‌فرماید ‫وَفِي آذَانِهِمْ وَقْرًا‬ گوش‌هاشون سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.42,
   "end": 117.96,
   "text": "گوش. تو همون قسمت دوم آیه می‌فرماید ‫وَجَعَلْنَا فِي قُلُوبِهِمْ أَكْنَةً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.96,
   "end": 122.04,
   "text": "أَن يَفْقَهُوهُ‬ اینم بحث قلب است که ادراکات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.04,
   "end": 126.64,
   "text": "حوزه القاها و ادراکات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.64,
   "end": 132.26,
   "text": "که تمام این حواس به نوعی برمی‌گرده به مدیریت قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.26,
   "end": 137.32,
   "text": "یک جا بعدش می‌فرماید ‫وَأَن يَرَوُا كُلَّ آيَةٍ‬ اگر ببینن همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.32,
   "end": 143.8,
   "text": "آیات رو حتی لا یؤمنوا بها این دیدن است، چشم است، بصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.8,
   "end": 146.22,
   "text": "إذا جاءوك يجادلونك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.22,
   "end": 149.86,
   "text": "يقولون اینا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.86,
   "end": 153.62,
   "text": "جدال می‌کنن. بعد يقولون این بحث چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.62,
   "end": 156.52,
   "text": "زبان است. گویش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.52,
   "end": 159.94,
   "text": "زبان است. همینطور اگرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.94,
   "end": 167.06,
   "text": "بعد انتهاء آیه می‌فرماید ‫يَقُولُ الَّذِينَ كَفَرُوا إِنْ هَٰذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ‬ این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.06,
   "end": 171.36,
   "text": "این چنین گمان می‌کنند که استغفرالله آیات قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.36,
   "end": 175.08,
   "text": "افسانه‌های پیشینیان. این برمی‌ز-- برمی‌گرده به حوزه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.08,
   "end": 177.56,
   "text": "فکر و حوزه خیالشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.56,
   "end": 179.92,
   "text": "حوزه اون قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.92,
   "end": 184.36,
   "text": "فکرشون. در حقیقت می‌خوام اینطوری برداشت کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.36,
   "end": 187.56,
   "text": "که به نوعی حواس مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.56,
   "end": 190.24,
   "text": "پنج گانه انسان اینجا مطرح شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.24,
   "end": 200.92,
   "text": "تو همین آیه. حالا برگردیم به یک جمله بسیار عجیبی که بنده حقیر ندیدم جز علامه حسن زاده این جمله رو بفرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.92,
   "end": 205.5,
   "text": "که یک بار یادمه یک مـ-منبر مبسوطی بابتش رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.5,
   "end": 208.82,
   "text": "اون‌هایی که نبودن بشنون ببینن چقدر عجیبه این حرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.82,
   "end": 212.52,
   "text": "علامه می‌فرماین اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.52,
   "end": 215.24,
   "text": "ادراکاتی که هر بچه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.24,
   "end": 219.94,
   "text": "در همون عنفوان بچگیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.94,
   "end": 223.92,
   "text": "اولین ادراکاتی که با حواس پنج گانه ش داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.92,
   "end": 228.62,
   "text": "اولین تحریکاتی که حواس پنج گانه ش ایجاد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.62,
   "end": 234.72,
   "text": "اون خمیرمایه و درون مایه تمام تمثلات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.72,
   "end": 237.7,
   "text": "عجیبه، تمام خواب‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.7,
   "end": 241.1,
   "text": "تمام مکاشفات، نحوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.1,
   "end": 245.82,
   "text": "افکارش، جهت‌گیری‌هاش تو زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.82,
   "end": 248.28,
   "text": "و حتی برزخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.28,
   "end": 252.64,
   "text": "یعنی بعد از دنیاشو و آخ-آخرتش رو تشکیل می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.64,
   "end": 256.1,
   "text": "الله اکبر! درون مایه همه این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.1,
   "end": 264.18,
   "text": "خیلی عجیبه‌ها. حالا ببینید آیه چه با یه لطائف الحیالی با یک رمز و رموز خاصی داره این چنین میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.18,
   "end": 269.36,
   "text": "چه کسی این‌ها رو متوجه می‌شه جز کسی که با یک عینک طهارتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.36,
   "end": 274.04,
   "text": "با عینک طهارت که لا یمسّه إلا المطهرون بندازه رو آیات و بتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.04,
   "end": 277.02,
   "text": "عمق آیات رو بفهمه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.02,
   "end": 280.9,
   "text": "اینکه اسلام توصیه می‌کنه اولین تحریک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.9,
   "end": 286.36,
   "text": "قوه سامعه بچه با اذان و اقامه باشه، معلومه شه رو حسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.36,
   "end": 291.24,
   "text": "میگه آقا بچه رو جاهایی که صدای آلوده است، صدای دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.24,
   "end": 293.78,
   "text": "صداهایی که انسان رو از خدا غافل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.78,
   "end": 296.26,
   "text": "ولو این بچه ظاهراً هیچی نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.26,
   "end": 300.02,
   "text": "نبر ته-- این تحریک قوه سامعه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.02,
   "end": 305.02,
   "text": "داره درون مایه و خمیرمایه یک عمر بلکه ابدش رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 305.02,
   "end": 308.24,
   "text": "اینکه ما میگیم آقا جوون، آقا جوون گوش نده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.24,
   "end": 311.48,
   "text": "این موسیقی مطربه، این حرامه، این گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.48,
   "end": 315.86,
   "text": "به هر صدایی گوش نده. یا میگه بچه رو بغل هر کسی نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.86,
   "end": 318.98,
   "text": "بچه که به دنیا اومد بغل هر کسی نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.98,
   "end": 323.14,
   "text": "دو تا اتفاق می‌افته. یکی قوه لامسه‌ش داره تحریک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.14,
   "end": 326.48,
   "text": "این قوه لامسه نباید با بدن هر کسی تحریک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 326.48,
   "end": 328.68,
   "text": "باید یک طرف آدم معنوی‌ای باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.68,
   "end": 333.08,
   "text": "چرا می‌برن در بغل یه عالم میدن، یه عارف میدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.08,
   "end": 337.86,
   "text": "ها؟ و قوه بویایی‌ش هم به نوعی داره تحریک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.86,
   "end": 341.46,
   "text": "بوی به هر بدنی یه بوی خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.46,
   "end": 346.64,
   "text": "اصلا توی احکام ازدواج عجیب آقای بهجت می‌فرماید که برید اصلا بو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.64,
   "end": 348.84,
   "text": "اجازه داده آقای بهجت میگه هـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.84,
   "end": 352.82,
   "text": "این زوجین می‌خوان ازدواج کنن قبل ازدواج بدن همدیگه رو بو کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.82,
   "end": 356.22,
   "text": "ببینن اصلا بوی بدنشون دلنشین هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.22,
   "end": 358.84,
   "text": "نمی‌تونه یه وقت اون بوی این بدن رو تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.84,
   "end": 361.98,
   "text": "مشکل می‌شه. انقدر ظرافت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.98,
   "end": 370.96,
   "text": "اون تحریک-- میگه چرا میگه تربت سید الشهدا اولین چیزی که به کام بچه میذاری تحریک بویایی، حس بویایی بچه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.96,
   "end": 373.9,
   "text": "بوی سیب حرام امام حسین تحریک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.9,
   "end": 377.78,
   "text": "قوه چشایی‌ش با تربت امام حسین برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.78,
   "end": 382.3,
   "text": "تحریک قوه چشایی‌ش. آقا هر کسی شیر به این بچه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.3,
   "end": 384.56,
   "text": "هر غذایی به این بچه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.56,
   "end": 389.1,
   "text": "این‌ها درون مایه و خمیرمایه الی الابدش رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.1,
   "end": 395.04,
   "text": "توجه کردی چقدر مهمه؟ هر چیزی رو نبینه، هر چیزی رو لمس نکنه، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.04,
   "end": 401.18,
   "text": "چیزی رو ادراک نکنه. بعد از همون ابتدا شروع کنی خطوط کلی فکری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.18,
   "end": 404.22,
   "text": "فکری رو براش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.22,
   "end": 408.52,
   "text": "ساختمان یا هرم فکری‌ش رو تنظیم کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 408.52,
   "end": 412.9,
   "text": "که چگونه به اسلام بن-- نگاه کنه، چگونه به خدا و پیغمبر نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 412.9,
   "end": 415.72,
   "text": "همین نماز بخون بری بهشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.72,
   "end": 417.28,
   "text": "نماز نخونی جات جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.28,
   "end": 419.66,
   "text": "همین. تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.66,
   "end": 422.8,
   "text": "این هرم فکری و ذهنی بچه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.8,
   "end": 426.42,
   "text": "این درون مایه باید چنان قوی باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.42,
   "end": 430.02,
   "text": "که بتواند الی الابد بچه را بسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.02,
   "end": 433.28,
   "text": "خیلی این‌ها مهمه. نه همین چند روز پیش اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.28,
   "end": 437.2,
   "text": "داشتیم تسبیحات حضرت زهرا سلام الله علیها رو می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.2,
   "end": 440.34,
   "text": "بعدش که تموم شد نشستم اینجا سخنرانی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 440.34,
   "end": 444.08,
   "text": "دیدم یه جوونی عجیب بین شما نشسته زل زده به من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 444.08,
   "end": 446.5,
   "text": "چهره‌ش خیلی آشناست. خیلی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.5,
   "end": 449.2,
   "text": "می‌فهمیدم بالاخره ما روانشناسی هم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.2,
   "end": 452.8,
   "text": "می‌فهمیدم این داره با یک حس سوال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.8,
   "end": 454.94,
   "text": "ورای شماها منو نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.94,
   "end": 458.36,
   "text": "متفاوت از همتون که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.36,
   "end": 461.42,
   "text": "از شاید سنه و نوم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.42,
   "end": 467.9,
   "text": "پای منبر ما آخوندها تجربه می‌کنید \"ولا تأخذه سنة ولا نوم\" که قبلا بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.9,
   "end": 470.54,
   "text": "خواب این شکلی و این شکلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.54,
   "end": 472.86,
   "text": "که خدا ندارد این دو خواب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.86,
   "end": 477.26,
   "text": "تو منبر ما آخوندها خواب سنه و نوم خوب تجربه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.26,
   "end": 479.82,
   "text": "وقتی کله‌ش پایینه می‌خوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.82,
   "end": 482.5,
   "text": "نوم، بالا می‌خوابه سنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.5,
   "end": 485.18,
   "text": "و بالعکسش هم گفتم. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.18,
   "end": 488.02,
   "text": "اون عجیب تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.02,
   "end": 491.32,
   "text": "وجودش درگیر صحبت‌های من و حتی قیافه من بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.32,
   "end": 494.66,
   "text": "اینو فهمیدم. منم تشخیص دادم آشناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.66,
   "end": 496.98,
   "text": "تموم که شد اومد سمت ما با یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.98,
   "end": 499.72,
   "text": "احساسی ما رو بغل کرد. دیدیم ای بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.72,
   "end": 503.88,
   "text": "حدود پونزده سال پیش ایشون شاگرد بنده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.88,
   "end": 505.76,
   "text": "پونزده سال پیش شاگرد بنده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.76,
   "end": 511.26,
   "text": "الان ماشاءالله مهندس شده دست گل اومده متأسفانه تو این سازمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.26,
   "end": 515.04,
   "text": "مشغول به کار شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.04,
   "end": 517.28,
   "text": "داره تلف می‌شه. حالا بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.28,
   "end": 521.06,
   "text": "حرف‌های سیاسی نزنیم. این بنده خدایی یه جمله‌ای به من گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.06,
   "end": 527.36,
   "text": "گفت حاجی همون پونزده سال پیش برام کاملا همه اون حالات تداعی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.36,
   "end": 531.32,
   "text": "با چی؟ با همین تسبیح حضرت زهرا که جمع‌خوانی می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.32,
   "end": 537.92,
   "text": "حالا اون موقع صد و پنجاه تا دانش‌آموز، دویست تا دانش‌آموز با هم همه می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.92,
   "end": 541.96,
   "text": "همه استغفرالله مؤمن و کافر با هم می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.96,
   "end": 544.2,
   "text": "بلند یک صفایی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.2,
   "end": 546.66,
   "text": "خیلی از بچه‌ها به جهت همین برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.66,
   "end": 548.64,
   "text": "جمع‌خوانی تسبیح حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.64,
   "end": 551.0,
   "text": "مسلمون شدند. اهل نماز شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.0,
   "end": 554.18,
   "text": "شما باور نکن. انقدر برکت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 554.18,
   "end": 556.84,
   "text": "حالا نه مثل جمع ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.84,
   "end": 562.72,
   "text": "تو چرت و بیداری می‌گیم و بیحالی اصلا اشکال وارد می‌کنیم و آقا اصلا باید ارزیابی کرد، بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.72,
   "end": 565.38,
   "text": "یه کمیته تشکیل داد ببینیم این نحوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.38,
   "end": 568.04,
   "text": "تسبیحات آیا مشکل شرعی دارد، ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.04,
   "end": 570.42,
   "text": "استفتاء کنیم این از کجا پیدا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.42,
   "end": 574.82,
   "text": "و بماند. چرا اینطوری این حالاتش اینطوری شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.82,
   "end": 578.3,
   "text": "یه حالت می‌شه نیمچه یغزه‌ای براش ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.3,
   "end": 580.66,
   "text": "این یغزه، این بیداری. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.66,
   "end": 583.64,
   "text": "قبلا با حواسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.64,
   "end": 585.76,
   "text": "تحریک شده بوده، آشنایی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.76,
   "end": 588.24,
   "text": "آشنایی ب-برقرار بود بین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.24,
   "end": 594.2,
   "text": "نوا، این تسبیحات و این، این نحوه صحبت‌های من، این صدا، این قیافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.2,
   "end": 597.24,
   "text": "یه دفعه بیدار می‌شه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.24,
   "end": 600.04,
   "text": "اینکه خیلی از ماها می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 600.04,
   "end": 607.04,
   "text": "عمرمون تموم می‌شه و هیچ خبری هم از معنویات آنچنانی و یغزه در ما نیست به جهت اون تمسلات بد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.04,
   "end": 609.74,
   "text": "اون تحریکات حواس پنج گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 609.74,
   "end": 612.2,
   "text": "بیخود و نابجا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 612.2,
   "end": 616.36,
   "text": "دنیوی که دنیست و پسته است از ابتدای بچگی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.36,
   "end": 618.98,
   "text": "مگر اینکه یغز-یغزه‌ای ایجاد شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.98,
   "end": 623.02,
   "text": "یغزه هم کار خداست. لذا اول آیه میگه \"ومنهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 623.02,
   "end": 626.72,
   "text": "تمیز قائل می‌شه بعضی‌شون \"میستمع الیک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.72,
   "end": 628.84,
   "text": "گوش میدن. بعد قبول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.84,
   "end": 631.64,
   "text": "پیداست بعضی گوش میدن و قبول می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.64,
   "end": 635.2,
   "text": "کیا قبول می‌کنن؟ اون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.2,
   "end": 639.98,
   "text": "اون ز-- درون مایه شون از بچگی درست شکل گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.98,
   "end": 643.06,
   "text": "این خیلی مهمه. حالا شما شاید بگید آقا اما که گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.06,
   "end": 645.46,
   "text": "خب مراقب بچه‌هامون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 645.46,
   "end": 648.28,
   "text": "بچه‌هامون رو کاملا بپاییم با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.28,
   "end": 650.7,
   "text": "حواس پنج گانه‌شون تحریک می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.7,
   "end": 655.16,
   "text": "و حداقل خودمون هم حالا که خرابکاری شده بریم دنبال یغزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.16,
   "end": 657.7,
   "text": "از خدا بخواهیم بیداری در ما ایجاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 657.7,
   "end": 660.44,
   "text": "حالا این با-- بیداری باید روش بحث کرد که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.44,
   "end": 665.64,
   "text": "غوغاست دیگه. بزرگان اهل معرفت ببینید در خصوص یغزه چه‌ها گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.64,
   "end": 668.4,
   "text": "اگه توفیق شد فردا می‌گیم. انشاالله عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.4,
   "end": 672.26,
   "text": "ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.26,
   "end": 674.9,
   "text": "سلام الله علیكم و رحمه الله و بركاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}