 "chapters": [
  {
   "index": 0,
   "title": "## نذرِ مطلقِ نماز و روزه و صدقه و کار",
   "start": 11.6,
   "end": 82.82
  },
  {
   "index": 1,
   "title": "## قلب مکتوم؛ حساسیت توحید",
   "start": 82.82,
   "end": 151.78
  },
  {
   "index": 2,
   "title": "## اشمئزاز از وحده؛ بوی نفس در عبادت",
   "start": 151.78,
   "end": 345.92
  },
  {
   "index": 3,
   "title": "## صمد و نمودِ وجود؛ همه چیز بسم الله",
   "start": 345.92,
   "end": 444.34
  },
  {
   "index": 4,
   "title": "آیاتی از سورهٔ طه از هجده به بعد:",
   "start": 444.34,
   "end": 557.24
  },
  {
   "index": 5,
   "title": "## فرعون و مجرای ظهور؛ گناه مسحِ بی‌طهارت",
   "start": 557.24,
   "end": 752.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.76,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.76,
   "end": 7.58,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.58,
   "end": 11.6,
   "text": "آیاته سلامٌ علیکم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 14.34,
   "text": "بحث نذر بود در احکام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.34,
   "end": 20.86,
   "text": "اگر کسی نذر کرده باشه که اگر مثلا من حاجتمو گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.86,
   "end": 24.52,
   "text": "بر من است برای خدا که مثلا نماز بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.52,
   "end": 28.84,
   "text": "اما نمازشو مشخص نکرد، چقدر بخونه، چه نمازی بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.84,
   "end": 33.44,
   "text": "مطلق نماز بخونه. رهبر عزیزمون فرمودن وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.44,
   "end": 36.74,
   "text": "حاجتشو گرفت حالا اون نذر براش واجب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.74,
   "end": 40.1,
   "text": "دو رکعت نماز بخونه کفایت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.1,
   "end": 44.4,
   "text": "حالا ما اگر روزه نذر کرد، اگر من حاجتمو گرفتم چیکار می‌کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.4,
   "end": 46.28,
   "text": "روزه میگیرم. چه روزه‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.28,
   "end": 49.28,
   "text": "چه روزی؟ چند روز؟ مشخص نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.28,
   "end": 51.76,
   "text": "باز یه روز روزه بگیره کفایت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.76,
   "end": 56.6,
   "text": "اگر صدقه، گفت من اگر حاجتمو بگیرم نذر کرده صدقه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.6,
   "end": 58.4,
   "text": "چه مقدار؟ از چه جنسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.4,
   "end": 61.34,
   "text": "چی این‌ها؟ نه، مشخص نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 61.34,
   "end": 68.44,
   "text": "باز هرچه، هر مقدار پول یا هر جنسی هرچی مقدار صدقه بده از گردنش برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.44,
   "end": 74.5,
   "text": "اصلا مطلقا گفته که من نذر می‌کنم در راه خدا کاری رو انجام بدم، برای خدا یه کاری بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.5,
   "end": 76.94,
   "text": "مشخص نکرده چه کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.94,
   "end": 79.72,
   "text": "هر کدوم از این کارا رو انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.72,
   "end": 82.82,
   "text": "کفایت میکنه. نذرش رو ادا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.82,
   "end": 86.02,
   "text": "بحث ما در خصوص قلب مکتوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.02,
   "end": 95.16,
   "text": "نفهم بود. آیه چهل و شش سوره اسراء رو یه ذره دقت کردیم رسیدیم به حساسیت موضوع توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.16,
   "end": 98.32,
   "text": "که من چی بگم آخه از توحید عزیز دلم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.32,
   "end": 103.24,
   "text": "که گرفتاری همه‌ی ماست و دیروز عرض کردیم امام در تهذیب النفسش میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.24,
   "end": 110.14,
   "text": "تازه یقظه و بیداری و رد کردن دقت بکن، بکنید کلمه رو، این مضمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.14,
   "end": 117.18,
   "text": "رد کردن همه حجاب‌های ظلمانی و نورانی تازه تو رو میرسونیم به پایه اول توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.18,
   "end": 119.82,
   "text": "منزل اول توحید. آقا جان توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.82,
   "end": 122.0,
   "text": "یه چیزی میگیم، یه چیزی میشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.0,
   "end": 127.76,
   "text": "اون انا لله و انا الیه راجعون ما به سمتش داریم حرکت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.76,
   "end": 130.46,
   "text": ". یعنی بخوای نخوای باید به اون سمتش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.46,
   "end": 137.16,
   "text": "رموزشو از قرآن دقت بکنین که گفتیم چرا گاهی اوقات ما حالمون بد میشه و از کلمه توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.16,
   "end": 140.76,
   "text": "مشمعز میشیم. این‌ها قرآن داره رمزی به ارض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.76,
   "end": 148.74,
   "text": "بحث میکنه. آیه چهل و شش سوره اسراء میفرماید \"و جعلنا على قلوبهم اکلة ان يفقهوه و في اذانهم وقرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.74,
   "end": 154.36,
   "text": "این‌ها تو گوششون سنگین شده، قلبشون در یک کنانی قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.36,
   "end": 159.16,
   "text": "\"و اذا ذكرت ربک في القرآن وحده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.16,
   "end": 163.04,
   "text": "وقتی بحث توحید و وحدانیت خدا تو قرآن میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.04,
   "end": 167.96,
   "text": "\"ولاو على ادبارهم نفورا\" میرن پشت می‌کنن که عرض کردیم شرح نزولشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.96,
   "end": 173.42,
   "text": "که این‌ها تو نماز میدیدن پیغمبر بسم الله الرحمن الرحیم رو بلند میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.42,
   "end": 175.42,
   "text": "پشت می‌کردن. بدشون میومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.42,
   "end": 183.8,
   "text": "کلمه توحید است. جالبه که بدونید بیش از هزار بار تو قرآن در خصوص توحید کلمه تکرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.8,
   "end": 186.18,
   "text": "مضمون از توحید داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.18,
   "end": 190.66,
   "text": "ها؟ هزار بار در قرآن از توحید کلام آورده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.66,
   "end": 193.78,
   "text": "بعد باز ما انقدر در خصوص توحید کم‌کاریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.78,
   "end": 198.36,
   "text": "بی‌توجه‌ایم. کدوم اون، کدوم یکی از ما پیش از سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.36,
   "end": 204.34,
   "text": "و عبادیات رفتیم یه دوره توحید یاد گرفتیم تو اعتقاداتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.34,
   "end": 211.8,
   "text": "تو آیه چهل و پنج سوره زمر میفرماید \"و اذا ذكر الله وحده\" ببینید باز میگه وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.8,
   "end": 215.88,
   "text": "کلمه توحیدو که دیگه اون سرفصلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.88,
   "end": 217.62,
   "text": "بسم الله الرحمن الرحیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.62,
   "end": 224.5,
   "text": "وقتی اینو میشنون \"اشمعزت قلوب الذين لا يؤمنون بالآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.5,
   "end": 231.62,
   "text": "اینا وقتی که چون ایمان ندارن به آخرت حتی عرض کردیم عباداتشونم بوی دنیا رو میده به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.62,
   "end": 234.26,
   "text": "طمع دنیا اومدن تو خط دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.26,
   "end": 236.48,
   "text": "الان نون به نرخ روزه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.48,
   "end": 239.2,
   "text": "دیندار باشی مثلا اینطوری اومده بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.2,
   "end": 242.12,
   "text": "اصلا نه بگو آدم خوبیه دنبال بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.12,
   "end": 245.9,
   "text": "اینم بوی نفس میده. اینم توحید خالص نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.9,
   "end": 249.04,
   "text": "قربونت برم. میگه این‌ها وقتی کلمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.04,
   "end": 253.0,
   "text": "حرف توحید زده میشه ببین حرف داریم تا حرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.0,
   "end": 258.74,
   "text": "یکی وقت‌ها یک کسی میگه سلامٌ علیکم و رحمة الله همینجوری فیلم داره باز میکنه بدتم میاد، اشمعزازم پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.74,
   "end": 261.34,
   "text": "می- ولی یکی میاد میگه سلام عزیزم فدات بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.34,
   "end": 263.86,
   "text": "یعنی تمام وجود، گرمای وجودت‌،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.86,
   "end": 265.76,
   "text": "تو اگه بدت بیاد بی احساسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.76,
   "end": 269.34,
   "text": "حالی از، به دلت نشینه تو گرفته ای، تو مشکل داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.34,
   "end": 272.34,
   "text": "ولی یه وقت از ادا و اصول یکی بدت میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.34,
   "end": 276.86,
   "text": "یکی مثل من لبا-لباس پیغمبر تنش کرده ادا در میاره بدت بیاد خوب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.86,
   "end": 279.54,
   "text": "اما یه وقت از اساس توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.54,
   "end": 282.88,
   "text": "از کلمه بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.88,
   "end": 289.18,
   "text": "آقا جان من به شما عرض می‌کنم اگر بزرگان فرمودن دلت رو با سلام به امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.18,
   "end": 291.66,
   "text": "بشناس، من امروز به شما عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.66,
   "end": 295.2,
   "text": "با بسم الله الرحمن الرحیم حال دلت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.2,
   "end": 298.8,
   "text": "بسنج چگونه است؟ یا خودت بگو یا دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.8,
   "end": 304.06,
   "text": "یکی از بزرگان روزی دوازده هزار بار بسم الله الرحمن الرحیم می‌گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.06,
   "end": 306.94,
   "text": "هیچی دیگه نمیگفته. همه ذکرش این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.94,
   "end": 309.28,
   "text": "اگر بدانیم این بسم الله چیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.28,
   "end": 311.66,
   "text": "اون حدیث عجیب رو برید پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.66,
   "end": 315.0,
   "text": "برید سرچ کنید. برید الحمدالله متون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.0,
   "end": 318.0,
   "text": "ببینید علامه پیرامون بسم الله چی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.0,
   "end": 320.06,
   "text": "این بسم الله، این آ این س-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.06,
   "end": 326.72,
   "text": "حدیث زهرة الموجودات عن بسم الله الرحمن الرحیم رو برید ببینید بزرگان ذیلش چی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.72,
   "end": 329.06,
   "text": "اصلا همه چی بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.06,
   "end": 333.72,
   "text": "ما چیزی جز بس- همه چی بروز و ظهور بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.72,
   "end": 336.86,
   "text": "بسم الله یک حقیقت واحد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.86,
   "end": 339.0,
   "text": "همون توحید خالص و محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.0,
   "end": 344.04,
   "text": "اون در مجلای وجود هر موجودی ریخته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.04,
   "end": 345.92,
   "text": "نمود خاص خودشو پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.92,
   "end": 348.38,
   "text": "اصلا ما جز وجود که خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.38,
   "end": 351.64,
   "text": "صمد است، پر است، همه جا رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.64,
   "end": 353.34,
   "text": "ها؟ الله الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.34,
   "end": 357.04,
   "text": "بعد امام نهم قبلا عرض کردین در خصوص صمد چی فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.04,
   "end": 360.12,
   "text": "الصمد الذي لا جوف له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.12,
   "end": 362.04,
   "text": "هیچی اصلا جا خالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.04,
   "end": 364.76,
   "text": "همه جا خداست. یک وجود واحد است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.76,
   "end": 367.7,
   "text": "پس اصلا جز وجود ما چیزی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.7,
   "end": 374.82,
   "text": "ماها هم نمود همون وجودیم نسبت به اینکه دقت کنید اون حقیقت بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.82,
   "end": 380.16,
   "text": "در مجرای در این کانال وجودی ما چگونه ظهور کرده، ما نمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.16,
   "end": 382.9,
   "text": "خدا، نمود وجود رو پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.9,
   "end": 386.14,
   "text": "توجه کردید؟ اصلا چیزی جز بسم الله نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.14,
   "end": 387.78,
   "text": "شما تک تک بسم الله‌اید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.78,
   "end": 391.6,
   "text": "آسمون بسم الله زمین بسم الله الرحمن الرحیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.6,
   "end": 396.04,
   "text": "همه چی حتی حیوانات، جمادات همه نسبت به مجرای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.04,
   "end": 400.54,
   "text": "وقتی این بسم الله در هر چیزی ظهور می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.54,
   "end": 405.98,
   "text": "نسبت به اون مجرا و اون حدی که خورده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.98,
   "end": 408.54,
   "text": "رنگ، رنگ می‌گیره در حقیقت رنگ می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.54,
   "end": 411.88,
   "text": "شما این آیه من خیلی برام جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.88,
   "end": 413.82,
   "text": "چیزایی که برام جالبه برای شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.82,
   "end": 416.46,
   "text": "یعنی واقعا برای خودم اینا انقدر زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.46,
   "end": 421.3,
   "text": "مثل یه گوهر گرانبها وقتی اینا رو پیدا می‌کنم پرواز می‌کنم میگم برای رفیقام هم بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.3,
   "end": 425.54,
   "text": "چیکار کنم؟ تک خور نباشه. برید آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.54,
   "end": 428.12,
   "text": "عرض شود خدمتتون سوره طه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.12,
   "end": 431.36,
   "text": "آیه بیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.36,
   "end": 433.9,
   "text": "از هجده به بعدشو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.9,
   "end": 437.94,
   "text": "آیه هجده. میگه \"و ما تلک بیمینک یا موسی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.94,
   "end": 444.34,
   "text": "شنیدید دیگه. خدا اینو، اینو دقت کنید دیگه با این نگاه امروز بهش نگاه کنید یه نگاه جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.34,
   "end": 446.84,
   "text": "خدا به موسی میگه این چیه تو دستت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.84,
   "end": 449.86,
   "text": "عصا بوده دیگه. خدا نمی‌دونسته که این عصاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 449.86,
   "end": 456.12,
   "text": "خب مقصودش چیه؟ خب بله حضرت موسی هم قربونش برم کلیم الله و عاشق صحبت با خدا شروع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.12,
   "end": 460.4,
   "text": "\"قال هیه عصای\". یعنی عصا \"أتوکأ علیها\" بهش تکیه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.4,
   "end": 464.38,
   "text": "با-- و \"أهش بها علقنمی\" برگا رو می‌ریزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.38,
   "end": 466.4,
   "text": "نمی‌دونم گوسفندا رو باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.4,
   "end": 472.06,
   "text": "چرا می‌برم. \"ولی فیها معارب أخرى\" کارهای دیگه شؤونات دیگه هم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.06,
   "end": 475.76,
   "text": "بسه دیگه. حالا یه خدا سوال کرد بگو عصا دیگه هی داره می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.76,
   "end": 478.64,
   "text": "خدا میگه باشه عصائه؟ عصا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.64,
   "end": 482.48,
   "text": "تو میگی این عصاست؟ مگه نمیگی عصاست و این کارا رو باهاش می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.48,
   "end": 486.04,
   "text": "ها؟ من می‌خوام به تو بفهمونم یه حقیقت دیگه‌ای رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.04,
   "end": 490.74,
   "text": "این عصا به، این عصا به معنای که تو داری میگی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.74,
   "end": 494.0,
   "text": "میفرما چی \"فألقها\" بزنش زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.0,
   "end": 496.96,
   "text": "بزنش زمین. \"فألقها فإذا هیه حیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 496.96,
   "end": 501.16,
   "text": "زد زمین. فرمود \"قال ألقها يا موسى\" بزنش زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.16,
   "end": 502.92,
   "text": "\"فألقاها\" زدش زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.92,
   "end": 506.02,
   "text": "\"فإذا هیه حیه تسعى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.02,
   "end": 509.2,
   "text": "یه دفعه شد یه موجود زنده، یه اژدها، یه مار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 509.2,
   "end": 511.46,
   "text": "موسی ترسید فرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 511.46,
   "end": 513.16,
   "text": "این که عصا بود دست من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.16,
   "end": 514.84,
   "text": "نه خیر. عصا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.84,
   "end": 517.9,
   "text": "کی گفته عصاست؟ این یه-- الان شده مار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.9,
   "end": 520.54,
   "text": "برو بزن اونجا دوازده تا چشمه میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 520.54,
   "end": 523.16,
   "text": "بزن اونجا جاده میکنه، چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.16,
   "end": 525.02,
   "text": "رود نیل رو جاده میکنه برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.02,
   "end": 526.88,
   "text": "عجب! آقا این عصاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.88,
   "end": 528.7,
   "text": "نه خیر. عصا، کی گفته عصاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 528.7,
   "end": 531.34,
   "text": "این بسم الله الرحمن الرحیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 531.34,
   "end": 534.22,
   "text": "من هر جور اراده کنم ظهور میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.22,
   "end": 536.98,
   "text": "همین بسم الله رو اراده کنم میشی تو ای موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 536.98,
   "end": 539.46,
   "text": "اراده کنم میشه این عصای دست تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.46,
   "end": 544.08,
   "text": "اراده کنم میشه چی؟ ثعبان، اژدها، مار افی هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 544.08,
   "end": 546.06,
   "text": "اراده کنم میشه جاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.06,
   "end": 549.08,
   "text": "اراده کنم نمی‌دونم ید بیضا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.08,
   "end": 552.9,
   "text": "اراده-- آقا جان همه چی بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.9,
   "end": 557.24,
   "text": "است. به اذن الله. در مجرا اینکه حضرت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 557.24,
   "end": 560.32,
   "text": "حالا اینکه فرعون داشت غرق میشد شنیدید روایت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 560.32,
   "end": 566.5,
   "text": "داد میزد بعضی روایات دیدم نوشته هفتاد بار حالا هفت بار حداقل هفت بارش دیگه عقلانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 566.5,
   "end": 570.56,
   "text": "داد زده \"یا موسى\". داد میزد نجاتم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.56,
   "end": 577.64,
   "text": "موسی هم نجاتش نداد. چرا خدا فرمود موسی اگر یک بار منو صدا زده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 577.64,
   "end": 580.64,
   "text": "به دادش می‌رسیدم. گفت یا موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 580.64,
   "end": 585.7,
   "text": "توجه کردید؟ چون بسم الله الرحمن الرحیمی که شده موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.7,
   "end": 592.62,
   "text": "از مجرای موسی تجلی کرده، از کانال موسی ظهور که پیدا کرده جوابتو نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 592.62,
   "end": 599.22,
   "text": "باید بسم الله الرحمن الرحیمی که مثلا از عصا تجلی می‌کرد به اذن من جوابتو می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.22,
   "end": 604.04,
   "text": "شاید به قول یکی از اساتید ما اگر اونجا فرعون می‌گفت ای عصا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.04,
   "end": 607.18,
   "text": "شاید خدا به دادش می‌رسید. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 607.18,
   "end": 609.96,
   "text": "اگر یه بار می‌گفت یا الله به دادش می‌رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 609.96,
   "end": 612.16,
   "text": "یعنی مجرا فرق می‌کرد. ظهور و بروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 612.16,
   "end": 614.48,
   "text": "عزیز دلم بحث ما چیه؟ توحید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.48,
   "end": 618.78,
   "text": "توحید هم چیزی جز حقیقت بسم الله الرحمن الرحیم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.78,
   "end": 620.4,
   "text": "حالا شما به من بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.4,
   "end": 627.44,
   "text": "این‌هایی که از بسم الله الرحمن الرحیم پیغمبر تو نماز بدشون می‌اومد، حالت اشمئزاز بهشون دست می‌داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 627.44,
   "end": 629.58,
   "text": "از چی بدشون میاد در حقیقت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 629.58,
   "end": 633.2,
   "text": "از خودشون. از خودشون بدشون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 633.2,
   "end": 637.34,
   "text": "پا رو خودشون گذاشتن. اصلا چرا گناه بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 637.34,
   "end": 641.52,
   "text": "چرا گناه بده؟ وقتی وجود من گناه می‌کنم آلوده میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 641.52,
   "end": 647.56,
   "text": "بسم الله الرحمن الرحیم نجس بشه بر هر کسی واجبه سریع اونو تطهیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 647.56,
   "end": 653.1,
   "text": "تو خودت تو نجس کردی. تو حق داری بدون وضو دست به بسم الله الرحمن الرحیم بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.1,
   "end": 656.44,
   "text": "حق داری یا نه؟ حق نداری بزنی گناه کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 656.44,
   "end": 661.72,
   "text": "کسی که گناه میکنه دائما داره بدون وضو دست به بسم الله الرحمن الرحیم میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.72,
   "end": 667.3,
   "text": "توجه کردید با این نگاه اخلاقی وقتی میبینی گناه این اعتقادت تو چقدر زیبا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 667.3,
   "end": 669.22,
   "text": "اینا رو من امروزه بهش فکر کردم بهش رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 669.22,
   "end": 671.64,
   "text": "حالا اگه شما بخواید قبول کنید، بخواید نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.64,
   "end": 674.02,
   "text": "ولی همه چی البته بر مبانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 674.02,
   "end": 676.76,
   "text": "که علامه حسن زاده فرمودن، همش مبنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.76,
   "end": 678.58,
   "text": "ببینید با این نگاه برید جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 678.58,
   "end": 681.58,
   "text": "بعد خودتون رو با بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 681.58,
   "end": 686.28,
   "text": "بسنجید. ببینید نسبت به این اسم چگونه در تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 686.28,
   "end": 690.24,
   "text": "حالا اون فعل و انفعالاتی که در تو ایجاد میشه چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.24,
   "end": 695.46,
   "text": "اگر خوشت میاد به همون میزانی که خوشت میاد به توحید رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 695.46,
   "end": 700.46,
   "text": "اگر العیاذ بالله اشمئزاز به همون میزان از توحید فاصله گرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 700.46,
   "end": 705.88,
   "text": "نسبت به بسم الله الرحمن. اینکه امام حسین تو کربلا گریه می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 705.88,
   "end": 708.02,
   "text": "آقا گریه می‌کرد که منو نکشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 708.02,
   "end": 713.02,
   "text": "آره؟ یعنی واقعا امام حسین اینه که آقا برای چی منو داری می‌کشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 713.02,
   "end": 717.84,
   "text": "گریه می‌کنه برای اینه که تو داری خودزنی می‌کنی نه که من حسین رو می‌کشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 717.84,
   "end": 724.62,
   "text": "من دارم به آرزوم می‌رسم. گریه برای تو می‌کنه ای شرم که تو داری خودزنی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.62,
   "end": 728.04,
   "text": "داری خودتو می‌زنی. تو داری پا رو بسم الله می‌ذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.04,
   "end": 730.16,
   "text": "تو داری بدون طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 730.16,
   "end": 732.52,
   "text": "بسم الله رو مسح می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 732.52,
   "end": 734.78,
   "text": "و این گناه بزرگیه. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 734.78,
   "end": 739.1,
   "text": "با این نگاه قرآن رو دیدن عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 739.1,
   "end": 740.98,
   "text": "انشاالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 740.98,
   "end": 743.88,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 743.88,
   "end": 750.16,
   "text": "الله محمد صلوات الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 750.16,
   "end": 752.3,
   "text": "علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}