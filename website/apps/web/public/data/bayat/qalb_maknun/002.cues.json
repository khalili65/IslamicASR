 "chapters": [
  {
   "index": 0,
   "title": "## استفادهٔ شخصی از امکانات مسجد جایز نیست",
   "start": 12.78,
   "end": 103.38
  },
  {
   "index": 1,
   "title": "## قلب مکنون؛ پرده‌ای بر فهم حقایق",
   "start": 103.38,
   "end": 155.36
  },
  {
   "index": 2,
   "title": "## خوردن‌ و اثر بر خلق و فهم",
   "start": 155.36,
   "end": 278.8
  },
  {
   "index": 3,
   "title": "## علامه حسن‌زاده، بوعلی و سبک زندگی",
   "start": 278.8,
   "end": 304.88
  },
  {
   "index": 4,
   "title": "## حکایت سردرد کودک نزد علامه",
   "start": 304.88,
   "end": 456.28
  },
  {
   "index": 5,
   "title": "## دین در همهٔ خلقت؛ نطفه و شب‌های ماه",
   "start": 456.28,
   "end": 523.96
  },
  {
   "index": 6,
   "title": "## میوهٔ سبک زندگی صحیح",
   "start": 523.96,
   "end": 652.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.9,
   "end": 7.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.84,
   "end": 12.78,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.78,
   "end": 17.86,
   "text": "از احکام نذر و وقف یکیش این هستش که اگر جایی م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.86,
   "end": 24.9,
   "text": "وقف مسجد شد، مسجد شد اونجا صیغه مسجد خوندن و نه حالا یه جایی ب- بعضی جاها هست مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.9,
   "end": 32.9,
   "text": "تو راه میری یه محله توریستیه نمی‌دونم اقامتیه یا یه گوشه‌ای رو برای نمازخونه منظور می‌کنن این‌ها نه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.9,
   "end": 35.44,
   "text": "مسجد شد و بعضی اداره‌جات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.44,
   "end": 41.46,
   "text": "برای اینکه همکاراشون بتونن یه جا ن- نماز بخونن یه گوشه‌ای رو، یه ساختمونی احداث می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.46,
   "end": 46.18,
   "text": "عرضم که یا شاید مثل همین جا مثلاً به عنوان نمازخانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.18,
   "end": 49.76,
   "text": "این نه، اگر جایی مسجد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.76,
   "end": 52.96,
   "text": "صیغه مسجد جاری شد و این‌ها فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.96,
   "end": 57.56,
   "text": "استفاده از وسایل اون مسجد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.56,
   "end": 62.64,
   "text": "وادی شخصی ش- اشکال شرعی داره یعنی جایز نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.64,
   "end": 66.5,
   "text": "حتی برق اون مسجد. مثلا همسایه مسجد بگه آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.5,
   "end": 68.72,
   "text": "می‌خوام جوشکاری کنم برق نیاز دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.72,
   "end": 72.74,
   "text": "متولی مسجد بگن آقا همسایه مسجد حق داره گردن ما بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.74,
   "end": 75.8,
   "text": "نه خیر همچین اجازه‌ای نداری. شما چikاره‌اید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.8,
   "end": 78.28,
   "text": "بخواید به جای خدا فتوا بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.28,
   "end": 86.0,
   "text": "قانون خداست. یا بعضی جاها میری می‌بینی تو مسجد می‌زنن شارژ موبایل می‌کنن، دارن از برق مسجد استفاده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.0,
   "end": 88.22,
   "text": "این‌ها اشکال داره. جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.22,
   "end": 91.54,
   "text": "باید پرسید که آیا این مسجد مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.54,
   "end": 94.24,
   "text": "صیغه خونده شده براش، نخونده شده شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.24,
   "end": 99.66,
   "text": "حتی اون آبی که باهاش وضو می‌گیرن اونم احکامی داره که حالا همه اینا باید به موقعش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.66,
   "end": 101.9,
   "text": "بیان بشه. این‌ها رو رعایت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.9,
   "end": 105.22,
   "text": "اما در خصوص قلب مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.22,
   "end": 111.54,
   "text": "یعنی قلبی که در یک کنان و پرده‌ای قرار گرفته است که حقایق رو نمی‌فهمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.54,
   "end": 116.6,
   "text": "ما تنزل دادیم بحث رو به حد اقل ممکن گفتیم دیگه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.6,
   "end": 121.3,
   "text": "این آیه ای که ما از آیه بیست و پنج انعام استفاده کردیم می‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.3,
   "end": 128.78,
   "text": "دیگه اون آل-- بالاترین مراتب که دیگه اصلا اینا هرچی حقایق و آیات رو براشون می‌خونی \"لم يؤمن هذه\" ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.78,
   "end": 134.74,
   "text": "اصلا ایمان نمیارن. ولی ما اومدیم بحثو تنزل دادیم از حد اقل ممکن گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.74,
   "end": 139.28,
   "text": "گاهی اوقات بحث اصلا عارضه‌ایست یعنی به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.28,
   "end": 142.96,
   "text": "خوردن‌ها، بد خوردن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.96,
   "end": 147.36,
   "text": "عرض شود مرکب خوردن‌ها نه بسط خوردن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.36,
   "end": 149.62,
   "text": "اینکه چیو با چی بخوری، چیو با چی نخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.62,
   "end": 153.78,
   "text": "اینا یه علمه دیگه که اطلا- اعتدال مزاج میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.78,
   "end": 158.8,
   "text": "این بحثو آوردیم تا اینجا گفتیم حتی خوردن‌ها می‌تونه باعث نفهمی ما بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.8,
   "end": 161.54,
   "text": "باعث کج خلقی و عصبیت ما بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.54,
   "end": 163.4,
   "text": "باعث بی‌حوصلگی ما بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.4,
   "end": 165.82,
   "text": "ناسپاسی ما بشه. خوردن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.82,
   "end": 168.52,
   "text": "گاهی اوقات دیدید اصلا اس- انبساط خاطر ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.52,
   "end": 171.32,
   "text": "اصلا حوصله هیچی رو ندارید. خودتم نمی‌دونید چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.32,
   "end": 176.42,
   "text": "تو همون آدم دیروزه حلیم هستی امروز اصلا حوصله هیچکسو نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.42,
   "end": 179.42,
   "text": "عزیز دلم این کاملا مرتبط با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.42,
   "end": 182.32,
   "text": "عرض شود خوابیدن و خوراک توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.32,
   "end": 188.14,
   "text": "چه ساعتی خوابیدی، چقدر خوابیدی، چگونه خوابیدی، با چه لباسی خوابیدی، کجا خوابیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.14,
   "end": 194.22,
   "text": "عرض شود خدمتتون با چه شرایطی خوابیدی، قبل خواب چه کردی، به چه چیزهایی فکر کردی، خ- خوردن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.22,
   "end": 200.16,
   "text": "چه چیزهایی خوردی، چی رو با چی خوردی، چی رو با چی نخوردی، چه ساعتی خوردی، چند بار خوردی، چه حجمی خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.16,
   "end": 202.68,
   "text": "اینا همش تو طب ما اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.68,
   "end": 206.4,
   "text": "که اگر این‌ها رعایت نشه عزیز دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.4,
   "end": 210.4,
   "text": "مثل که بعضیا یاد اون چیزه همشو بدم افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.4,
   "end": 216.52,
   "text": "آره از خنده‌ها مشخصه. بله چقدر خوبه که احکام دینی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.52,
   "end": 221.5,
   "text": "آره همشو بده آقا همه احکامو بده بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.5,
   "end": 226.36,
   "text": "بله عرض شود خدمت شما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.36,
   "end": 230.36,
   "text": "خوردن‌ها در مزاج انسان تاثیر مستقیم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.36,
   "end": 234.14,
   "text": "عرض کردیم که اهل بیت شیخ الرئیس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.14,
   "end": 241.68,
   "text": "اشارات می‌فرمود اهل بیت اگر نمی‌میرن چون اعتدال مزاج دارن هرکس معتدل بشه مزاجش هیچوقت نمی‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.68,
   "end": 245.58,
   "text": "مشکل ما اینه که یه روز داریم یه روز نداریم، یک ساعت داریم یک ساعت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.58,
   "end": 249.38,
   "text": "این یک علم است که متأسفانه لعنت کنن اینا که دست ما رو از دامن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.38,
   "end": 253.96,
   "text": "اهل بیت کوتاه کردن و الا همه ما عمرمون جاودانه میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.96,
   "end": 257.94,
   "text": "اگر امیرالمؤمنین رو میذاشتن سلطنتشو ادامه بده، اون ولایتش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.94,
   "end": 260.72,
   "text": "کلیه رو در قالب حکومت اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.72,
   "end": 264.0,
   "text": "چون به هر حال همه ما معتقدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.0,
   "end": 268.14,
   "text": "همه علوم در سینه امیرالمؤمنین جمع بوده دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.14,
   "end": 271.14,
   "text": "که فرمود \"إنها هنا لعن من جمع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.14,
   "end": 273.6,
   "text": "سينهدر عنه السيل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.6,
   "end": 278.34,
   "text": "ولایلغ عليه التل\". خدا لعنت کنه اونه که دست ما رو کوتاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.34,
   "end": 282.3,
   "text": "حالا در میان این غذا خوردن‌ها باید برید خودتون ببینید علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.3,
   "end": 287.78,
   "text": "بحث‌هایی دارن، علامه حسن زاده دارن، کتاب‌هایی پیرامون این قصه دارن، رساله‌هایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.78,
   "end": 290.04,
   "text": "عرض شود بوعلی سینا که دیگه غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.04,
   "end": 293.9,
   "text": "عرض کردیم که شا-- دانشگاه‌های خارج دارن تدریس می‌کنن، اینجا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.9,
   "end": 296.64,
   "text": "اصلا سبک زندگی اسلامی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.64,
   "end": 303.56,
   "text": "اینکه این همه رهبرا تاکید می‌کنه اگر سبک زندگی ما از خوردن و خوابیدن و گویش و شنیدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.56,
   "end": 310.4,
   "text": "مطلق متعارف این برنامه‌های روزمره ما اگر به سبک دینی و اسلامی شد همه چی درست میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.4,
   "end": 313.18,
   "text": "بعد فهم ما عمیق میشه، حقایق رو می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.18,
   "end": 318.84,
   "text": "گاهی اوقات تو دل میدی به منبری اصلا پرواز می‌کنی با صحبتای منبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.84,
   "end": 321.72,
   "text": "بعد یه روز مثلا حوصله نداری ریخت این بیایاتو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.72,
   "end": 323.64,
   "text": "باز دوباره این گیرا بود ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.64,
   "end": 325.42,
   "text": "بابا ولمون کن دیگه بسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.42,
   "end": 330.1,
   "text": "گاهی اوقات می‌خوای بخوریش انقدر عاشق حرفش میشی، نه خودشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.1,
   "end": 332.6,
   "text": "خودش که قیافه نداره. گاهی اوقاتم بدت میاد ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.6,
   "end": 334.88,
   "text": "چرا؟ چرا اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.88,
   "end": 337.24,
   "text": "به خاطر اون کج فهمی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.24,
   "end": 341.44,
   "text": "نفهمی‌هایی که به جهت س-- عدم سبک زندگی اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.44,
   "end": 347.68,
   "text": "در انسان ایجاد شده. اینا ریزه کاری‌هاش حالا در آیات و روایات اومده کسی نمیره دقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.68,
   "end": 351.28,
   "text": "خیلی جالبه دقت می‌کردم که از دستورات علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.28,
   "end": 354.88,
   "text": "می‌دونید یکی از مشکلات کج فهمی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.88,
   "end": 358.14,
   "text": "ااا تطهیر نشدن قوه خیال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.14,
   "end": 361.86,
   "text": "خیالات ما، افکار متعدد که تو خیال ما می‌پر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.86,
   "end": 365.0,
   "text": "میاد و ما رو باعث میشه که نفهمیم خیلی چیزا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.0,
   "end": 369.76,
   "text": "تطهیر قوه خیال باعث میشه ما حقایق رو بفهمیم که این بحث مبصوتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.76,
   "end": 374.2,
   "text": "حالا یکی از چیزایی که قوه خیال رو تطهیر می‌کنه اگه گفتید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.2,
   "end": 377.8,
   "text": "خطاطی، نقاشی من یه مدت خیلی کار می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.8,
   "end": 382.36,
   "text": "انقدر جوونی‌ام خیلی افکار پرش دار زیاد داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.36,
   "end": 384.64,
   "text": "رفتم تو دل نقاشی و خطاطی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.64,
   "end": 387.92,
   "text": "انقدر آرامش خاطر پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.92,
   "end": 391.78,
   "text": "حالا یه وجهش از کار نمیدونم مداومت بر ذکر لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.78,
   "end": 395.98,
   "text": "یه وجهش هم اینه. خیلی جالبه دیدم همین تیراندازی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.98,
   "end": 400.1,
   "text": "از شود، تیراندازی و اسب سواری و شنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.1,
   "end": 402.08,
   "text": "که این همه اسلام تاکید داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.08,
   "end": 404.08,
   "text": "اگه گفتی تو کجا این‌ها کارسازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.08,
   "end": 407.62,
   "text": "چه می‌کنند این‌ها با انسان‌ها؟ اعتدال مزاج میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.62,
   "end": 411.22,
   "text": "خیلی جالبه. دستورات علامه حسن زاده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.22,
   "end": 416.64,
   "text": "خب اینا رو یه حکیم متأله مثل ایشون باید بیاد پرده‌برداری کنه از حقایق و اسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.64,
   "end": 420.08,
   "text": "ما هی نگیم بابا ول کن بریم سراغ نسخه‌های غربی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.08,
   "end": 426.2,
   "text": "اعتدال مزاج میاره. وقتی اعتدال مزاج آورد بر تو، تو حقایق رو می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.2,
   "end": 431.02,
   "text": "دیگه کشف فهمی نداری، عصبیت نداری، آرامش داری، حلیمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.02,
   "end": 433.88,
   "text": "زود نمی پاشی. عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.88,
   "end": 435.9,
   "text": "این‌ها همش نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.9,
   "end": 440.22,
   "text": "یه جو-- یه خونواده‌ای اومدن محضر علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.22,
   "end": 446.86,
   "text": ". حالا یه بار ما رفته بودیم محضر ایشون چقدر آدم اومده بود بیچاره‌ی علامه حالا اون موقع که حال و روزش خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.86,
   "end": 450.8,
   "text": "مشکلات متعدد. یه خونواده‌ای اومده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.8,
   "end": 454.7,
   "text": "بچه‌شون یه ساعت خاصی در روز سردرد میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.7,
   "end": 457.18,
   "text": "هرچی پزشک و دارو هیچ فایده نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.18,
   "end": 459.84,
   "text": "دیدی بعضیا صرع دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.84,
   "end": 464.76,
   "text": "آقا این بعد جالبه اومده بودن محضر علامه مثلا علامه وردی بخونه و دستی بکشه و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.76,
   "end": 468.96,
   "text": "آقا جان این نظام خلقت ما همش بر اساس طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.96,
   "end": 473.48,
   "text": "کوچک‌ترین بی‌طهارتی تو هر زمینه‌ای، بی‌قانونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.48,
   "end": 478.98,
   "text": "میزنه آدمو داغون میکنه. یه گوشه‌ای از بدن و و وجود رو باعث میشه که انسان اینطوری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.98,
   "end": 482.88,
   "text": "خب علامه اول کاری که کرد گفت این بچه اینجا بمونه شما بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.88,
   "end": 485.84,
   "text": "این پدر مادر رو برده بود توی اتاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.84,
   "end": 491.96,
   "text": "بهشون گفته بود که آقا جان به من بگید ببینم این بچه چه ساعت‌هایی مثلا سردرد میشه و اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.96,
   "end": 494.32,
   "text": "آیا دائما بله چقدر فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.32,
   "end": 497.2,
   "text": "یه سری سوالات. بعد بهشون گفته بود ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.2,
   "end": 500.98,
   "text": "این همه نظام خلقت بر اساس دین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.98,
   "end": 506.22,
   "text": "حتی این ساعتی که می‌گفت این ساعتی که پدر دست توئه این هم دین داره، آیین داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.22,
   "end": 509.58,
   "text": "قانون داره. میگه اینطوری باهاش رفتار کنی خراب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.58,
   "end": 511.88,
   "text": "اینطوری بکنی تنظیم هم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.88,
   "end": 514.82,
   "text": "این پر-- این از شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.82,
   "end": 519.3,
   "text": "هواپیمایی که میره آسمون مهندسی که این رو تعبیه کرده براش یه قوانینی گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.3,
   "end": 521.2,
   "text": "غیر اون رفتار کنی سقوط میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.2,
   "end": 523.4,
   "text": "اینا رو علامه فرموده بود به این پدر و مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.4,
   "end": 528.48,
   "text": "کشتی اگر بدونی چجوری باهاش رفتار کنی دائما رو آب در حرکت روانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.48,
   "end": 532.34,
   "text": "اما کوچک‌ترین اختلافی در این قانون‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.34,
   "end": 536.12,
   "text": "طریقه استفاده از کشتی رخ بده غرق میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.12,
   "end": 539.14,
   "text": "وجود ما هم این کشتی وجود ما هم قانون‌هایی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.14,
   "end": 544.28,
   "text": "اصلا دین همه جا پی-- هیچ کجا تو نظام خلقت نیست که دین پیاده نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.28,
   "end": 548.38,
   "text": "دین یعنی مجموعه قوانینی که ما رو به سعادت دنیا و آخرت برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.38,
   "end": 550.8,
   "text": "علامه فرموده بود، مچشون رو گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 550.8,
   "end": 559.76,
   "text": "گفته بود آقا جان چرا قبل از اینکه بخواید نطفه ببندید و بچه دار بشید نمیرید قانون‌های دین رو نگاه کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.76,
   "end": 565.46,
   "text": "داریم در شب اول و دوم و سوم ماه اگر نطفه بسته بشه بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 565.46,
   "end": 569.88,
   "text": "گرفتار مشکلات صرع و در-دردسر شدید میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.88,
   "end": 571.86,
   "text": "این ما رو اینه. حالا مچشون رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.86,
   "end": 574.5,
   "text": "حالا شما رفتید کار خرابی کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 574.5,
   "end": 580.68,
   "text": "الان اساسا این بحث شهوت و اینها نه برای اتفاف غریزه شهوات، شهوانیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.68,
   "end": 583.22,
   "text": "برای ایجاد صورت انسانیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.22,
   "end": 586.64,
   "text": "شما پیش از اینکه علمشو کسب کنید رفتید نطفه بستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.64,
   "end": 593.04,
   "text": "این نتیجه‌شه. فقط یه جا استثناء هست که اشتباه نکنید بعضیا که اهل تحقیق‌اند مچ ما رو نگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.04,
   "end": 596.18,
   "text": "شب اول ماه مبارک رمضان چرا مستحبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.18,
   "end": 599.02,
   "text": "اون بحث حالا این‌ها مجامعت و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.02,
   "end": 601.98,
   "text": "بقیه نه. شب اول، دوم و سوم ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.98,
   "end": 605.82,
   "text": "اگر نطفه‌ای تشکیل بشه مشکلات عدیده‌ای براش پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.82,
   "end": 607.66,
   "text": "و اینطوری خودشو گُروز میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.66,
   "end": 609.6,
   "text": "بعد گرفتار نفهمی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.6,
   "end": 612.12,
   "text": "میبینی حرفای قرآن و احادیث رو نمیفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.12,
   "end": 614.4,
   "text": "حکما هرچی میگن تو کله‌ش نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.4,
   "end": 616.3,
   "text": "پدر مادر کار خرابی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.3,
   "end": 619.46,
   "text": "چه ربطی به نظام هستی و خدا داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.46,
   "end": 623.9,
   "text": "این‌ها ریز به ریز ربط به سبک زندگی اسلامی ما داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.9,
   "end": 631.6,
   "text": "که اگر ما بتونیم یک مجموعه‌ای از این قواعد رو برای سبک زندگی خودمون انتخاب کنیم، قطعاً میبینیم مثل خیلیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.6,
   "end": 633.24,
   "text": "با یه جمله پرواز می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 633.24,
   "end": 635.54,
   "text": "با یه جمله شهید میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 635.54,
   "end": 639.28,
   "text": "جان میدیم پای امام عصرمون، پای دین و آیین‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.28,
   "end": 641.16,
   "text": "به نفهمی دچار نمیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.16,
   "end": 646.1,
   "text": "انشاالله که عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 646.1,
   "end": 652.12,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}