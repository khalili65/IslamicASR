 "chapters": [
  {
   "index": 0,
   "title": "## مرگ منذورٌله و مرگ ناذر",
   "start": 10.9,
   "end": 114.44
  },
  {
   "index": 1,
   "title": "## کَدح و قوسین و تسویه",
   "start": 114.44,
   "end": 201.34
  },
  {
   "index": 2,
   "title": "## حکمت؛ تشبّه به الله",
   "start": 201.34,
   "end": 232.14
  },
  {
   "index": 3,
   "title": "## طاقت و وسع در مثال‌ها",
   "start": 232.14,
   "end": 384.17
  },
  {
   "index": 4,
   "title": "## کشف اسرار و علامت أکنّه",
   "start": 384.17,
   "end": 682.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.96,
   "end": 4.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 8.36,
   "text": "والسلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 10.9,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.9,
   "end": 17.78,
   "text": "اگر چنانچه نذر کرده باشید به شخص خاصی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.78,
   "end": 24.52,
   "text": "اه حالا فقیری صدقه بدید یا نه یه مؤمنی که خیلی دوسش دارید هستن نذر می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.52,
   "end": 26.78,
   "text": "هدیه ای بدن مبلغی رو یا هرچی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.78,
   "end": 29.28,
   "text": "مثلا رهبر عزیزمون می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.28,
   "end": 31.86,
   "text": "همون‌طور که بحثش قبلا گذشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.86,
   "end": 34.3,
   "text": "اه هسته امام هم این‌چنیـ، این چنین بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.3,
   "end": 37.24,
   "text": "زندگیشون خب حقوق رهبری نمی‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.24,
   "end": 40.0,
   "text": "از طریق همین هدایا و نذورات مردمی می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.0,
   "end": 41.32,
   "text": "این‌که یه دفعه برای سلز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.32,
   "end": 47.8,
   "text": "سیل‌زده‌ها، زلزله‌زده‌ها یا جهیزیه می‌بینید میلیون‌ها تومن ایشون کمک می‌کنند از همین هدایا و نذورات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.8,
   "end": 49.42,
   "text": "مردمه که دوست دارن ایشونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.42,
   "end": 51.76,
   "text": "به کسی هم ربطی نداره نه به شما نه به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 51.76,
   "end": 55.22,
   "text": "دوسش دارن. خدا دوست‌دارنشون زیاد هم بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.22,
   "end": 57.74,
   "text": "هدیه میدن ایشونم خب ما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.74,
   "end": 61.04,
   "text": "پولی دستمون برسه شاید بذاریم تو جیبمون و هزینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 61.04,
   "end": 62.62,
   "text": "زندگی شخصی خودمون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 62.62,
   "end": 64.46,
   "text": "ایشون خرج دیگران می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 64.46,
   "end": 68.28,
   "text": "خدا هم برکت میده. به هر حال اگر کسی بخوا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 68.28,
   "end": 71.38,
   "text": "نذرش این باشه که به شخص خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 71.38,
   "end": 76.02,
   "text": "هدیه ای بده، کمک مالی بده، باید به همون شخص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 76.02,
   "end": 78.9,
   "text": "حالا اگر اون شخص از دنیا رفت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 78.9,
   "end": 85.42,
   "text": "اگر از دنیا رفت، اه احتیاط واجب کردن رهبر عزیزمون فتوا ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 85.42,
   "end": 89.3,
   "text": "احتیاطاً فرمودن که به ورثه اون شخص بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 89.3,
   "end": 93.34,
   "text": "حالا اگر خود ما مُردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 93.34,
   "end": 96.2,
   "text": "حالا نگید دور از جون. این دور از جون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 96.2,
   "end": 98.6,
   "text": "امم حرف غلطیه و حرف زشتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 98.6,
   "end": 102.44,
   "text": "مثل این‌که به شما بگن آقا می‌خواید تشریف ببرید ملاقات امام عصر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 102.44,
   "end": 104.36,
   "text": "بگی دور از جون این حرفا چیه می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 104.36,
   "end": 111.24,
   "text": "زبونتو گاز بگیر. در حالی که ما در آیه شش سوره انشقاق داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 111.24,
   "end": 116.26,
   "text": "يا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 116.26,
   "end": 119.42,
   "text": "إِلَىٰ رَبِّكَ كَدحًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 119.42,
   "end": 122.94,
   "text": "کاده یعنی رونده، رونده همراه با سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 122.94,
   "end": 125.3,
   "text": "تو در حال رفتن به سمت خدا هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 125.3,
   "end": 127.52,
   "text": "إِلَىٰ رَبِّكَ كَدحًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 127.52,
   "end": 131.14,
   "text": "البته فَمُلَاقِيهِ. قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 131.14,
   "end": 135.52,
   "text": "پس از این سیر فَمُلَاقِيهِ خدا رو قراره ملاقات کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 135.52,
   "end": 140.62,
   "text": "بله إنّا لِلَّهِ در قوس نزول از سمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 140.62,
   "end": 147.72,
   "text": "و إنّا إِلَيْهِ رَاجِعُونَ و در قوس صعود همه به سمت خدا در حرکتیم و انشاالله در آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 147.72,
   "end": 150.92,
   "text": "قراره که ما خدا رو ملاقات کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 150.92,
   "end": 154.44,
   "text": "و اصلاً مرگ و از دنیا رفتن ارتقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 154.44,
   "end": 157.64,
   "text": "رتبه‌ای است. اینه که انسان ارتقاء وجودی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 157.64,
   "end": 161.06,
   "text": "این‌که انسان به سمت إِلَيْ الْمَسِيرِ به سمت خدا حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 161.06,
   "end": 163.74,
   "text": "حتی جهنم هم به نوعی آماده باش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 163.74,
   "end": 166.5,
   "text": "آماده‌سازی برای ملاقات با خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 166.5,
   "end": 168.94,
   "text": "تسویه ناخالصی‌های درونی و اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 168.94,
   "end": 171.84,
   "text": "حالا ما تو احکام به چه سمتی هم رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 171.84,
   "end": 177.08,
   "text": "حالا اگر چنانچه شمایی که نذر کردی خودت از دنیا رفتی، اون موقع چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 177.08,
   "end": 180.8,
   "text": "اونچه که نذر کردی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 180.8,
   "end": 186.46,
   "text": "اه ورثت باید بدن. اون هدیه ای که نذر کردی از دنیا رفتی ورثت باید به اون شخص برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 186.46,
   "end": 191.48,
   "text": "اما دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 191.48,
   "end": 197.58,
   "text": "یه نکته بسیار مهمی که البته ده‌ها منبر می‌طلبه اهلش برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 197.58,
   "end": 200.24,
   "text": "خیلی خوب هوش و گوش باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 200.24,
   "end": 202.24,
   "text": "عرض کنم خدمتتون لطیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 202.24,
   "end": 210.3,
   "text": "صد و سی و نه کتاب شریف معاصر آثار جلد دو علامه حسن زاده حفظه الله تعالی رو برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.3,
   "end": 212.7,
   "text": "در اونجا ایشون حدود هج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 212.7,
   "end": 220.54,
   "text": "شونزده تعریف رو از فلسفه میارن که می‌دونید فلسفه به زبان یونانی‌ست و قرآنیش میشه همون حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.54,
   "end": 223.5,
   "text": "در حقیقت تعریف حکمت رو میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 223.5,
   "end": 229.46,
   "text": "یکی از تعاریف خیلی دقیق و لطیف ایشون می‌فرمود الحكمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.46,
   "end": 231.04,
   "text": "یعنی همون الفلسفتو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.04,
   "end": 235.22,
   "text": "الحكمة هي تشبه بالاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 235.22,
   "end": 238.2,
   "text": "حکمت شباهت گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 238.2,
   "end": 243.08,
   "text": "به الله هست. خیلی جالبه که اسم الله میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.08,
   "end": 245.54,
   "text": "مثل این‌که عرض کردیم در اون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 245.54,
   "end": 252.58,
   "text": "يا أَيُّهَا الْإِنسَانُ نوع انسان رو نمیگه أَيُّهَا الْمُؤْمِنُونَ، يا أَيُّهَا الْإِنسَانُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.58,
   "end": 255.78,
   "text": "أَنتُمُ الْفُقَرَاء إِلَى اللَّهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.78,
   "end": 259.4,
   "text": "همه شما که فقرتون ذاتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.4,
   "end": 261.48,
   "text": "به سمت الله در حرکتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.48,
   "end": 263.52,
   "text": "در حقیقت الله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 263.52,
   "end": 267.42,
   "text": "امم مستجمع جميع اسماء است و لایتناهی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 267.42,
   "end": 269.36,
   "text": "یک وجود واحد لایتناهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 269.36,
   "end": 274.36,
   "text": "او نیا، برطرف کننده همه نیازها و فقر ذاتی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 274.36,
   "end": 281.76,
   "text": "و چون الله لایتناهی‌ست و ما به سمت الله در حرکتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.76,
   "end": 286.38,
   "text": "این در حقیقت نشون میده که ما ظرفیتمون چقدر بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.38,
   "end": 290.7,
   "text": "به قول علامه اگر کسی اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 290.7,
   "end": 295.3,
   "text": "در این حرکت در این سیر احساس کنه عطشش برطرف شد، دیگه نیازی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 295.3,
   "end": 298.06,
   "text": "اینا این معلومه که مریضه. و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.06,
   "end": 300.54,
   "text": "اینا این بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.54,
   "end": 304.68,
   "text": "ادامه همین تعریف علامه می‌فرمود هي تشبه بالاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 304.68,
   "end": 307.22,
   "text": "بعد به چه غ، چه میزان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 307.22,
   "end": 311.02,
   "text": "به چه مقداری؟ به قدر طاقت البشرية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.02,
   "end": 315.22,
   "text": "جالبه. نمی‌فرمود به قدر وسع البشرية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 315.22,
   "end": 318.38,
   "text": "به قدر طاقت. ما یه طاقت داریم، یه وسع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 318.38,
   "end": 321.02,
   "text": "به نظر شما وسع بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 321.02,
   "end": 326.72,
   "text": "یا طاقت؟ ببینید عزیزان طاقت بیشتر از وسعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.72,
   "end": 331.04,
   "text": "جالبه که قرآن هم می‌فرماید لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.04,
   "end": 333.9,
   "text": "خدا آسون گرفته به بنده‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.9,
   "end": 337.72,
   "text": "میگه تکلیفی که به شما می‌کنم بر نفس شما به قدر وسع شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 337.72,
   "end": 341.12,
   "text": "نمیگه طاقت شما. ببینید مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 341.12,
   "end": 345.1,
   "text": "یکی وقت هست شما طاقت داری گرسنگی و تشنگی رو تحمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 345.1,
   "end": 347.48,
   "text": "لذا روزه می‌گیری. میگی من طاقت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 347.48,
   "end": 354.14,
   "text": "اما وقتی این روزه رو می‌گیری بعداً باعث میشه که مریضی‌ت عود کنه، سنگ کلیه بیاری، مشکلاتی ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 354.14,
   "end": 360.52,
   "text": "خب اینم برای شما هم حرامه. چون بر وسع تعلق گرفته تا تکلیف، نه بر طاقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.52,
   "end": 363.41,
   "text": "طاقت داشتی بگیری اما وسع تو نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.41,
   "end": 365.51,
   "text": "از اینجا تا تو خونه‌تو میدویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 365.51,
   "end": 368.89,
   "text": "به سرعت طاقت داری تحمل می‌کنی، میدویی می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 368.89,
   "end": 374.29,
   "text": "میگی رسیدم طاقت داشتم. اما همونجا یا عضلات پات می‌گیره وقتی گرمای وجودت رفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.29,
   "end": 377.93,
   "text": "سرد شد بدنت عضلاتت می‌گیره میفتی یا شاید هم بیهوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.93,
   "end": 381.29,
   "text": "خب این وسع تو نبود. اگرچه طاقتت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.29,
   "end": 383.51,
   "text": "اینجا خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 383.51,
   "end": 387.05,
   "text": "می‌فرماید حکمت تشبه به الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 387.05,
   "end": 392.31,
   "text": "اینکه تو هم که خودت اسم اللهی به سمت این الله حرکت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 392.31,
   "end": 396.75,
   "text": "شباهت پیدا کنی، تلبس به اسماء الله پیدا کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 396.75,
   "end": 399.17,
   "text": "به قدر طاقت خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 399.17,
   "end": 406.93,
   "text": "خب اگر چنانچه ما به سمت خدا و الله در حرکتیم، او که لایتناهی است، پس ما به قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.93,
   "end": 409.95,
   "text": "طاقتمون به سمت خدا در حرکتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 409.95,
   "end": 413.45,
   "text": "ل-- یعنی اینکه این طاقت هم لایتناهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.45,
   "end": 422.53,
   "text": "چون ظرفیت وجودی ما به حدی است که نیازهای وجودی ما قراره با اسم الله برتر-برطرف شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 422.53,
   "end": 427.05,
   "text": "أنتم الفقراء إلى الله که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.05,
   "end": 433.39,
   "text": "این نشون میده که این، اینو بهش میگن اصطلاحاً مقام لایقفی نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.39,
   "end": 437.73,
   "text": "خب حالا بحث چیه؟ ما که صحبتمون پیرامون قلب مکنون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.73,
   "end": 443.39,
   "text": "میخوام عرض کنم که اگر چنانچه کسی به سمت الوهیت برود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.39,
   "end": 452.51,
   "text": "سیر کند و حقایق نظام هستی رو کشف کند، میدونید معنای فلسفه یا حکمت چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.51,
   "end": 455.75,
   "text": "این بود که بهترین معنا را این چنین کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.75,
   "end": 463.55,
   "text": "که آگاهی به اسرار نظام خلقت، آگاهی به اسرار اعیان موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.55,
   "end": 469.87,
   "text": "سر و سر و سر موجودات رو که علامه هم می‌فرماید عالم همه علم انباشته شده روی هم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.87,
   "end": 472.67,
   "text": "به این انسان ملتفت شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.67,
   "end": 476.19,
   "text": "آگاهی هر مقدار وسعه وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.19,
   "end": 480.17,
   "text": "به اون‌ها برسد، به میزان طاقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.17,
   "end": 482.81,
   "text": "خدا در او ایجاد کرده برسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.81,
   "end": 484.47,
   "text": "و جلو برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.47,
   "end": 488.11,
   "text": "تعال إلى ما شاء الله از تو حرکت از خدا برکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.11,
   "end": 491.85,
   "text": "هی سیرش شدیدتر، سریع‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.85,
   "end": 493.67,
   "text": "و معراجش بالاتر می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.67,
   "end": 498.61,
   "text": "حالا اگر کسی در این کشف حقایق نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.61,
   "end": 500.89,
   "text": "احساس کسالت و کراهت کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.89,
   "end": 504.45,
   "text": "حقیقتی براش آشکار شد، علمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 504.45,
   "end": 507.19,
   "text": "معرفتی، عرفانی براش ایجاد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.19,
   "end": 511.57,
   "text": "احساس کراهت کرد. حرف خوب شنید، احساس کراهت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.57,
   "end": 516.83,
   "text": "آیه‌ای از قرآن شنید، حرف و حدیثی شنید، احساس کراهت یا کسالت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.83,
   "end": 519.77,
   "text": "حال نداشت. دوست نداشت چیزی این حرفا رو بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.77,
   "end": 522.23,
   "text": "این معلومه که چیه عزیزان دلم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.23,
   "end": 525.23,
   "text": "این گرفتار چی شده؟ قلب مکنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.23,
   "end": 529.71,
   "text": "یعنی کنان پرده‌هایی دور قلبش رو گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.71,
   "end": 531.89,
   "text": "که نمی‌ذاره بفهمه از حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.89,
   "end": 535.51,
   "text": "و الا اگر در حقیقت این گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.51,
   "end": 540.19,
   "text": "علم فکری شده، حتی اگر کسی بره فلسفه یاد بگیره حکمت یاد بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.19,
   "end": 543.99,
   "text": "علمش رو داره تحصیل می‌کنه اما زود کسل می‌شه، خسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.99,
   "end": 547.89,
   "text": "این خستگی نشانه از علم فکری دارد نه شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.89,
   "end": 550.43,
   "text": "یعنی می‌داند، در نمی‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.43,
   "end": 553.53,
   "text": "یافتن فرق می‌کنه با دانستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 553.53,
   "end": 559.41,
   "text": "پس آنچه که مهم است این است که انسان آن به آن در حال کشف اسرار نظام هستی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.41,
   "end": 561.91,
   "text": "و اگر از این کشف اسرار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 561.91,
   "end": 565.63,
   "text": "رسیدن به حقایق و معارف الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 565.63,
   "end": 569.45,
   "text": "و رسیدن به بعضی از اسرار حتی تو نماز تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.45,
   "end": 572.55,
   "text": "آقا میگه نماز معراج. نمی‌تونه نمی-- پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.55,
   "end": 574.43,
   "text": "میگه حرفات چیه؟ کجا معراج؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 574.43,
   "end": 577.21,
   "text": "چطور پس من نمی‌تونم معراج؟ میگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 577.21,
   "end": 579.83,
   "text": "إذا قدر قدر عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.83,
   "end": 583.97,
   "text": "رزقه قرآن می‌فرماید وقتی تنگ شد رزقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.97,
   "end": 586.39,
   "text": "فلینفق مما آتاه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.39,
   "end": 588.61,
   "text": "از اونچه که خدا بهت عطا کرده انفاق کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 588.61,
   "end": 590.99,
   "text": "وقتی ببخشی خدا زیاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.99,
   "end": 593.69,
   "text": "میگه آقا من اصلاً نمی‌تونم این تو کچ من نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.69,
   "end": 595.95,
   "text": "با دو تا چهار تای من س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.95,
   "end": 599.01,
   "text": "جور در نمیاد. آخه من دارم پولم کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.01,
   "end": 600.99,
   "text": "چطوری میگید زیاد میشه؟ نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 600.99,
   "end": 603.21,
   "text": "چرا؟ چرا اینطوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 603.21,
   "end": 605.87,
   "text": "چرا نمازش معراج نیست؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 605.87,
   "end": 609.91,
   "text": "ساعت‌ها وقت میذاره برای فیلم نگاه کردن، تلویزیون نگاه کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.91,
   "end": 614.13,
   "text": "ساعت‌ها وقت میذاره برای گپ‌های بی‌مورد، گفتگوهای بی‌مورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.13,
   "end": 618.45,
   "text": "به محض اینکه یکی بگه آقا یک حقیقتی رو از یک آیه کشف کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.45,
   "end": 624.15,
   "text": "نمی‌فهمه، نمی‌گیره. آقا از ولایت فقیه میخواد حرف بزنه یکی پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.15,
   "end": 630.19,
   "text": "بابا جان به خدا تمام ائمه‌ی ما در زمان حیاتشون نایب خاص و عام داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 630.19,
   "end": 634.85,
   "text": "ما اینو ایجاد نکردیم. یا از ولایت امیرالمؤمنین میخوای حرف بزنی پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.85,
   "end": 638.63,
   "text": "به قول علامه فرمودند نیازی به مجامع روایی شیعه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.63,
   "end": 645.73,
   "text": "از طریق سهاه ستوه و مجامع روایی اهل تسنن می‌تونیم اثبات کنیم حقانیت ولایت امیرالمؤمنین علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.73,
   "end": 647.39,
   "text": "رو. می‌شنوه پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 647.39,
   "end": 651.17,
   "text": "چرا پس می‌زنه؟ به جهت اینکه عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 651.17,
   "end": 655.39,
   "text": "قلبش در یک پرده‌هایی قرار گرفته که نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 655.39,
   "end": 658.45,
   "text": "حالا باید ریشه‌یابی کنه. این معلومه مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 658.45,
   "end": 662.05,
   "text": "چرا قلبش در کنان قرار-- چرا قلبش نمی‌فهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 662.05,
   "end": 669.95,
   "text": "حالا یا هرزنگاهی کرده یا هرزنگاری کرده یا هرزگویی کرده یا هرز شنیدن داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 669.95,
   "end": 673.19,
   "text": "دستش، پاش، قلبش، فکرش، اینها هرزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 673.19,
   "end": 677.25,
   "text": "هرزه هرزه پروری کردن اینها به هر حال نتیجه‌اش شده این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 677.25,
   "end": 680.31,
   "text": "ان شا الله که عاقبتمون ختم بخیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 680.31,
   "end": 682.51,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}