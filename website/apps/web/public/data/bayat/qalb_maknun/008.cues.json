 "chapters": [
  {
   "index": 0,
   "title": "## نذر همهٔ پنج‌شنبه‌های عمر؛ وحدت قصد یا تعدد",
   "start": 17.06,
   "end": 169.04
  },
  {
   "index": 1,
   "title": "## قلب مکنون؛ پرده‌ای بر فهم حقایق",
   "start": 169.04,
   "end": 269.84
  },
  {
   "index": 2,
   "title": "## روح توحید؛ ولایت",
   "start": 269.84,
   "end": 317.02
  },
  {
   "index": 3,
   "title": "## سخن امیر پازواری؛ سر دادن در برابر چون‌وچرا",
   "start": 317.02,
   "end": 365.77
  },
  {
   "index": 4,
   "title": "## غربال ولایت؛ یقین در برابر لغلغهٔ زبان",
   "start": 365.77,
   "end": 636.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 4.28,
   "text": "بسم الله الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 17.06,
   "text": "الرحیم. السلام علیک یا باقیم الله و باقی عایازه سلام علیکم و رحمة الله وبركاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.06,
   "end": 23.32,
   "text": "در خصوص نذر و شهیدی که باید احکام رو بیان می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 23.32,
   "end": 25.54,
   "text": "امروز عرض می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.54,
   "end": 34.66,
   "text": "فتوای رهبر عزیرم و اگر کسی نذر کرده باشه به عنوان مثال همه پنج شنبه‌های عمرش رو نذر روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.66,
   "end": 40.74,
   "text": "نذرش این بوده که همه پنج شنبه‌ها رو به صورت یک نذر واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 40.74,
   "end": 49.16,
   "text": "روزه که اگر دقت کنید نکته رو ظرافت رو اگر یه دونه از این پنج شنبه‌ها ترک شد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 49.16,
   "end": 54.0,
   "text": "اون قصدی که در نذرش داشته ادا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 54.0,
   "end": 59.04,
   "text": "این چنین نذر کرده همه پنج شنبه‌ها رو به عنوان یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 59.04,
   "end": 63.22,
   "text": "وجود واحد روزه بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 63.22,
   "end": 65.26,
   "text": "که اگر چنین شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 65.26,
   "end": 69.92,
   "text": "چنین نذری کرد اگر یه دونه از این پنج شنبه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 69.92,
   "end": 72.4,
   "text": "روزه نتونست بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.4,
   "end": 75.8,
   "text": "به اون مقصودی که خودش داشته نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.8,
   "end": 79.64,
   "text": "توجه کردید چی شد؟ اینطور نیست که حالا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.64,
   "end": 84.16,
   "text": "نذر می‌کنم پنج شنبه‌های عمرم رو ن-- روزه بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.16,
   "end": 88.34,
   "text": "حالا اگر یه وقت یه روز از این پنج شنبه‌ها رو هم نتونستم عیبی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 88.34,
   "end": 91.54,
   "text": "تو ذهنش اگه اینطوری باشه قصه فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.54,
   "end": 94.4,
   "text": "چطور فرق می‌کنه؟ دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.4,
   "end": 97.72,
   "text": "اگر نذرش اینه که همه پنج شنبه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.72,
   "end": 101.6,
   "text": "بدون استثناء روزه بگیره حتی یه دونه‌شم ترک نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.6,
   "end": 103.9,
   "text": "به عنوان یک وجود واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.9,
   "end": 107.38,
   "text": "اگر چنین کسی یه پنج شنبه‌اش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.38,
   "end": 113.14,
   "text": "نتونست روزه بگیره، روزه‌ش منحل، اون نذرش منحل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.14,
   "end": 116.06,
   "text": "دیگه نیاز نیست برگرده به انجام نذرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.06,
   "end": 118.5,
   "text": "کلاً نذرش منحل میشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.5,
   "end": 122.28,
   "text": "قصدش این بود چی؟ تمام پنج شنبه‌ها رو بدون استثناء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.28,
   "end": 125.56,
   "text": "حتی یه دونه‌شم فوت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.56,
   "end": 129.7,
   "text": "کلاً نذرش منحل میشه و البته کفاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.7,
   "end": 136.36,
   "text": "یک روز باطل شدن نذر روزه‌شو باید بده که قبلاً گفتیم یا ده تا فقیر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.36,
   "end": 139.7,
   "text": "لباس بپوشونه یا ده تا فقیر رو سیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.7,
   "end": 143.52,
   "text": "اما اگر نیتش این نیست همه پنج شنبه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.52,
   "end": 149.82,
   "text": "بدون استثناء، حالا یکیشم نشد دو تاشم نشد اما کلاً پنج شنبه‌ها رو روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.82,
   "end": 152.24,
   "text": "اگر نذرش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.24,
   "end": 155.2,
   "text": "هر پنج شنبه‌ای که روزه نگرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.2,
   "end": 163.26,
   "text": "بر اساس هر پنج شنبه‌ای یک کفاره گردنش میاد و این نذرشم دیگه منحل نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.26,
   "end": 166.14,
   "text": "همیشه باید این نذرش گردنش هست تا آخر عمرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.14,
   "end": 169.04,
   "text": "ظرافتو دقت کردید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.04,
   "end": 175.96,
   "text": "بحث ما قلب مکنون بود و قلبی که در کنانی قرار گرفته و حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.96,
   "end": 180.84,
   "text": "نظام هستی و اسرار عالم رو متوجه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.84,
   "end": 186.16,
   "text": "به قدری قلب، به خودتون توجه کنید، به حالات قلبی‌تون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.16,
   "end": 193.08,
   "text": "به اون وديعه‌ای که خدا در وجود من و تو قرار داده و قراره که لحظه مرگ همون رو از ما پس بگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.08,
   "end": 194.94,
   "text": "اون من تو، من من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.94,
   "end": 200.28,
   "text": "شخص تو، شخص من، وجود تو، وجود من، همون قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.28,
   "end": 204.2,
   "text": "ماحصل آنچه که از ما باقی می‌ماند قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.2,
   "end": 210.54,
   "text": "لذا سرتاسر قرآن ابتدا آمنوا میاد یعنی مقدم میشه بر عملوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.54,
   "end": 215.3,
   "text": "ایمان بحث قلب است، دلدادگی، بحث قلب و دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.3,
   "end": 225.6,
   "text": "به قدری مهم است که اگر کسی کوچک‌ترین بی‌طهارتی در این نظام هستی انجام بدهد، چه فکری، چه عملی، چه لسانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.6,
   "end": 228.68,
   "text": "هر کدوم از اعضا و جوارحش بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.68,
   "end": 237.08,
   "text": "خدایی نکرده کوچک‌ترین بی‌طهارتی انجام بدهد بر اساس قاعده \"لا یمسه إلا المتحرون\" از فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 237.08,
   "end": 240.64,
   "text": "حقایق نظام هستی باز می‌ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 240.64,
   "end": 245.08,
   "text": "بر اساس آیه‌ای که جلسه پیش بحث کردیم گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 245.08,
   "end": 250.78,
   "text": "این‌ها، این‌هایی که کافر بودند، مشرک بودند یا منافق بودند یا کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 250.78,
   "end": 253.84,
   "text": "دچار قلب مکنون شده بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.84,
   "end": 257.48,
   "text": "به جایی رسیده بودند که وقتی پیغمبر کلمه توحید بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.48,
   "end": 264.76,
   "text": "زبانش جاری می‌کرد یا بسم الله الرحمن الرحیم رو بلند قرائت می‌کرد فاصله می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.76,
   "end": 268.64,
   "text": "پشت می‌کردن با نفرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 268.64,
   "end": 275.5,
   "text": "خب بحث حالا مسائلی رو پیرامون توحید عرض کردیم که یه مقداری هم سنگین و ثقیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 275.5,
   "end": 280.06,
   "text": "لکن در دل توحید بحث ولایت هم وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 280.06,
   "end": 285.1,
   "text": "بله علیٌ حبه ایمان و بغضه کفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.1,
   "end": 287.98,
   "text": "اصلاً روح توحید، ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 287.98,
   "end": 290.52,
   "text": "به همین دلیل اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 290.52,
   "end": 293.74,
   "text": "کسی گرفتار قلب مکنون شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 293.74,
   "end": 303.02,
   "text": "گرفتار قلبی شد که در یک کنان و پرده‌ای قرار گرفته و حقایق رو نمی‌فهمد قطعاً با ولایت زاویه می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.02,
   "end": 307.92,
   "text": "به قدری این قلب ظریف است، لطیف است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 307.92,
   "end": 317.02,
   "text": "به قول اهل معرفت فرمودن مظهر اسم \"یا آلن فی دون وه و یا دانن فی علو وه\" است قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 317.02,
   "end": 321.5,
   "text": "خدا در، در عین حالی که بالاست \"آلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 321.5,
   "end": 325.1,
   "text": "فی دون وه\" در عین حال پایین هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 325.1,
   "end": 329.84,
   "text": "در عین حالی که پایین هست \"دون وه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 329.84,
   "end": 334.86,
   "text": "یا دانن\" در عین حال \"فی علو وه\" بالا هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 334.86,
   "end": 340.12,
   "text": "\"هو الاول والآخر والظاهر والباطن\" یک وجود واحد است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 340.12,
   "end": 344.1,
   "text": "که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 344.1,
   "end": 350.04,
   "text": "به قول حالا اون صحبتی که پیرامون اسم اعظم از رساله علامه حسن زاده براتون کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 350.04,
   "end": 353.78,
   "text": "\"الصمد الذي\" یادتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 353.78,
   "end": 358.08,
   "text": "\"لا جوف له\" اصلاً هیچ جای خالی‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 358.08,
   "end": 362.56,
   "text": "پره، پره. یک وجود واحدی که همه جا رو پر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 362.56,
   "end": 372.31,
   "text": "اون خدایی که همه جا هست در حین اینکه در دسترس است و قریب است با قاف نزدیک است، بعید هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 372.31,
   "end": 378.93,
   "text": "در عین اینکه بعید است نزدیک هم هست قلب من و تو مظهر اون اسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 378.93,
   "end": 381.57,
   "text": "یعنی به شدت این راه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 381.57,
   "end": 384.29,
   "text": "راه قلبی، طریق قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 384.29,
   "end": 386.35,
   "text": "سخت و دشوار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 386.35,
   "end": 390.23,
   "text": "این راه از مو باریکتر و از شمشیر برنده تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 390.23,
   "end": 394.23,
   "text": "یعنی همین به یک معنا. به شدت سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 394.23,
   "end": 398.31,
   "text": "که تو بخواهی به حقیقت توحید برسی، به ولایت دست پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 398.31,
   "end": 400.09,
   "text": "به لغلغه زبان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 400.09,
   "end": 403.23,
   "text": "خدا رحمت کنه امیر، امیر پازواری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 403.23,
   "end": 407.53,
   "text": "این عارف به الله یک جمله عجیبی عاشقانه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 407.53,
   "end": 410.31,
   "text": "شعرهای عجیبی هم داره ایشون این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 410.31,
   "end": 411.73,
   "text": "به مولامون امیرالمؤمنین علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 411.73,
   "end": 417.53,
   "text": "الصلاة والسلام عرض میکنه علی جان اگر تو بگوئی خداوکیلی من و تو کدوممون اینطوری هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 417.53,
   "end": 419.47,
   "text": "اگه هستی خوش به حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 419.47,
   "end": 427.95,
   "text": "علی جان اگر همین الان به من بگی دسته شمشیر رو روی زمین بگذار نوک تیز شمشیر رو رو سینه و قلبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 427.95,
   "end": 433.29,
   "text": "چنان فشار بده که این نوک شمشیر از اون سمت و پشتت بیرون بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 433.29,
   "end": 438.91,
   "text": "من چون و چرا نمیکنم بلا درنگ این کار رو انجام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 438.91,
   "end": 441.01,
   "text": "ولی من به چون و چرا میفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 441.01,
   "end": 444.45,
   "text": "اولین چیزی که تا مولای من همچین حرفی بزنه چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 444.45,
   "end": 446.51,
   "text": "دلیلش چیه آقا جان؟ حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 446.51,
   "end": 452.49,
   "text": "خیلی آدم مخلص و با صفایی باشم میگم آقا جان میشه بفرمایید چه گناهی کردم که من باید این غلط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 452.49,
   "end": 456.45,
   "text": "مثلا این کفاره رو انجام بدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 456.45,
   "end": 459.03,
   "text": "اصلا این چون و چراها کار دست ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 459.03,
   "end": 468.57,
   "text": "تو قصه اخیر، تو قصه اخیر حالا فتنه بنزینی هرچی اسمش رو بخوای بذاری خیلیا متاسفانه سر خوردن از وادی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 468.57,
   "end": 473.57,
   "text": "تا پیش از این سینه چاک رهبری بودن و جان پای رهبر میدادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 473.57,
   "end": 475.77,
   "text": "به محض اینکه نتونستن هضم نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 475.77,
   "end": 478.07,
   "text": "چرا؟ چرا اینطوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 478.07,
   "end": 481.55,
   "text": "چرا یکی میگه آقا جان سر بباید داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 481.55,
   "end": 484.13,
   "text": "میگه سر میدم تا سرورم رو پیدا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 484.13,
   "end": 486.89,
   "text": "دل میدم که دلبرم رو پیدا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 486.89,
   "end": 491.75,
   "text": "یکی اینطوریه که سر میده اصلا مثل شهید حججی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 491.75,
   "end": 497.05,
   "text": "میگه م- ب- بعد مینویسه برای رهبرش دل نوشته که آقا جان ما اصلا اینجاییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 497.05,
   "end": 499.31,
   "text": "که حرف شما رو زمین نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 499.31,
   "end": 502.59,
   "text": "من به یقین رسیدم که شما جانشین ولی فقیه هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 502.59,
   "end": 506.55,
   "text": "بعد به شهادت میرسه. جانشین امام عصر هستی به عنوان ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 506.55,
   "end": 510.07,
   "text": "فقیه زمان. بعد به شهادت میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 510.07,
   "end": 512.75,
   "text": "سر میده پای یقینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 512.75,
   "end": 516.05,
   "text": "اینطوری هم بله چون دل داده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 516.05,
   "end": 519.15,
   "text": "مظهر اون اسمه است، تکون میده به همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.15,
   "end": 520.79,
   "text": "عالم. همه رو تکون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.79,
   "end": 526.93,
   "text": "میشه مظهر مقاومت که از غریبه به بیست کشور دنیا زائر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 526.93,
   "end": 528.97,
   "text": "و تمام شهرهای کشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 528.97,
   "end": 532.73,
   "text": "یک آن سر قبر این شهید بی زائر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 532.73,
   "end": 535.15,
   "text": "یکی هم نه مثل من فقط لغلغه زبانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 535.15,
   "end": 538.45,
   "text": "فقط کافیه جیبش خالی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 538.45,
   "end": 541.43,
   "text": "فقط کافیه به مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 541.43,
   "end": 545.47,
   "text": "مالی بیفته. فشار اقتصادی که رو دوش همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 545.47,
   "end": 548.49,
   "text": "آقا جان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 548.49,
   "end": 553.73,
   "text": "غربالی که امیرالمؤمنین علیه الصلاة والسلام فرمود به شدت در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 553.73,
   "end": 559.93,
   "text": "انجام است. غربال. حضرت فرمود مثل این آش که این نخودها میره بالا میاد پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 559.93,
   "end": 567.65,
   "text": "همین طور چطور کفگیر میخوره ته دیگ اینا بالا پایین میشن همین طوری بالا پایین میشید که دارین میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.65,
   "end": 572.55,
   "text": "باور کنید حالا خسته تون نکنم ختم کلام تو فامیلای بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 572.55,
   "end": 574.99,
   "text": "هستند کسانی که مخالف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 574.99,
   "end": 577.67,
   "text": "سرسخت اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 577.67,
   "end": 581.19,
   "text": "نظام و اسلام و انقلاب و اصلا این حرفا حالیشون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 581.19,
   "end": 587.95,
   "text": "بی حجاب محض. نگم چه خطاها و خلاف‌هایی میکردن از مشروب خوری بگیر تا کارهای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 587.95,
   "end": 592.55,
   "text": "اصلا باورت نمیشه الان من به شما بگم اینا چادری شدن، بسیجی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 592.55,
   "end": 597.65,
   "text": "میگن اگه آمریکا بخواد با ما بجنگه اول کسی که میره جنگ منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 597.65,
   "end": 599.69,
   "text": "چند نفر تو فامیل ما اینطوری بودن الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 599.69,
   "end": 604.97,
   "text": "بعد از این طرف آدمایی که سینه چاک ولایت و دایه ولایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 604.97,
   "end": 608.03,
   "text": "وسط گود الان چپ کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 608.03,
   "end": 611.07,
   "text": "میگن بابا ول کن بس که الکی سینه میزدیمو و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.07,
   "end": 615.55,
   "text": "عزیز دلم این غربال بر اساس قلب ما صورت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 615.55,
   "end": 619.59,
   "text": "کوچکترین بی طهارتی بکنی از فهم می افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 619.59,
   "end": 623.71,
   "text": "وقتی فهم نکردی حقایقو یادت میره اِ جلوی امامتم قدم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 623.71,
   "end": 627.27,
   "text": "چیز عجیبی نیست. ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 627.27,
   "end": 636.53,
   "text": "به برکت صلوات بر محمد و آل محمد. محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}