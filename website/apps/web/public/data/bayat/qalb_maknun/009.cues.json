 "chapters": [
  {
   "index": 0,
   "title": "## نذر زن و فرزند",
   "start": 0.34,
   "end": 53.46
  },
  {
   "index": 1,
   "title": "## گوسالهٔ زمان؛ آنچه قلب را در کنان می‌نهد",
   "start": 53.46,
   "end": 182.16
  },
  {
   "index": 2,
   "title": "## گوسالهٔ امت ما؛ دینار و درهم",
   "start": 182.16,
   "end": 271.28
  },
  {
   "index": 3,
   "title": "## سه بیم پیامبر: مکسب حرام، شهوت خفی، ربا",
   "start": 271.28,
   "end": 391.92
  },
  {
   "index": 4,
   "title": "## سامری امت؛ ابوموسی اشعری",
   "start": 391.92,
   "end": 677.58
  },
  {
   "index": 5,
   "title": "## لعن در قنوت صبح؛ خون به دل ولایت",
   "start": 677.58,
   "end": 828.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 2.88,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.88,
   "end": 6.94,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.94,
   "end": 9.6,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.6,
   "end": 14.64,
   "text": "عرض کردیم که زن بدون اذن شوهرش نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 16.54,
   "text": "نذر کنه. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.54,
   "end": 20.4,
   "text": "اذن بگیره و اگر نذر کنه بدون اذن شوهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.4,
   "end": 22.4,
   "text": "اون نذر واجب الادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.4,
   "end": 26.66,
   "text": "نیست، واجب الوفا نیست. اگرچه عرض کردیم این به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.66,
   "end": 29.5,
   "text": "این نیست که نمی‌تونه تصرف در مالش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.5,
   "end": 34.54,
   "text": "چرا؟ می‌تونه تصرف بکنه اما نذرش واجب الادا و واجب الوفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.54,
   "end": 39.26,
   "text": "حالا بچه چطور؟ فرزند چه دختر، چه پسر می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.26,
   "end": 41.96,
   "text": "بدون اذن پدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.96,
   "end": 46.16,
   "text": "نذر کنه؟ فرمودن بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.16,
   "end": 47.98,
   "text": "نذرش اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 47.98,
   "end": 52.7,
   "text": "بچه بدون اذن پدر می‌تونه نذر کنه و ادا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.7,
   "end": 55.6,
   "text": "خب روز بسیار مبارکی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.6,
   "end": 60.64,
   "text": "تبریک میگیم خدمت شما و همه‌ی دوستداران و شیفتگان این نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.64,
   "end": 66.62,
   "text": "که خون پاک هزاران هزار شهید پاش ریخته شد، چه در هشت سال دفاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.62,
   "end": 70.94,
   "text": "مقدس، چه در هشت سال دفاع از حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.94,
   "end": 76.82,
   "text": "و به قول رهبر باید آماده باشیم که خرمشهرهایی در پیش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.82,
   "end": 80.6,
   "text": "نکته‌ای رو عرض کنم که هم پیرامون نهضت‌ای باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.6,
   "end": 87.16,
   "text": "مرتبط باشد هم ما از بحثمون خارج نشیم که قلب مکنون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.16,
   "end": 95.12,
   "text": "یکی از چیزهایی که باعث می‌شه قلب انسان در کنانی قرار بگیره و حقایق رو نفهمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.12,
   "end": 98.76,
   "text": "گرفتار گوساله‌ی ر، زمان شدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.76,
   "end": 101.14,
   "text": "حالا این گوساله‌ی زمان یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.14,
   "end": 104.2,
   "text": "دقت بفرمایید که بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.2,
   "end": 107.8,
   "text": "فتنه سامری ایجاد شده و می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.8,
   "end": 111.46,
   "text": "اینو من یه مقدار باز کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.46,
   "end": 113.74,
   "text": "گوساله چیه؟ عجل حالا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.74,
   "end": 116.66,
   "text": "عربیش می‌شه عجل و سامری چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.66,
   "end": 120.72,
   "text": "ما اولا از امام صادق صلوات الله علیه حدیث داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.72,
   "end": 123.34,
   "text": "همه امت‌ها فتنه دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.34,
   "end": 129.46,
   "text": "و همه امت‌ها سامری دارن و عجل یا گوساله دارن، گوساله سامری دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.46,
   "end": 134.78,
   "text": "و البته هم امیرالمؤمنین، پیامبر اعظم و شهن اسلام، امام صادق، امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.78,
   "end": 142.74,
   "text": "به نوعی این سامری رو، سامری امت ما رو و اون عجل رو مشخص کردن که حالا روایتشو تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.74,
   "end": 148.76,
   "text": "در زمان حضرت موسی خب وقتی بحث سامری و گوساله و عجل یعنی گوساله میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.76,
   "end": 155.42,
   "text": "ما ذهنمون میره سمت اون داستان قرآنی که حضرت، زمان حضرت موسی پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.42,
   "end": 157.88,
   "text": "می‌دونید که وقتی رفت کوه طور و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.88,
   "end": 160.3,
   "text": "یه شخصی که سامری نام داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.3,
   "end": 163.2,
   "text": "اومد بر اثر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.2,
   "end": 169.26,
   "text": "عرض شود دلبستگی به دنیایی که داشت به مردم گفت، حالا داستانش مفصله وقت من ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.26,
   "end": 171.78,
   "text": "برید تو تفاسیر ببینید ذیل آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.78,
   "end": 176.96,
   "text": "که این از مردم طلا و زرشون رو جمع کرد، بهشون وعده داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.96,
   "end": 183.72,
   "text": "طلاها رو گرفت، ذوب کرد، در هم ریخت و باهاش یک گوساله درست کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.72,
   "end": 185.96,
   "text": "گوساله‌ای که به طلا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.96,
   "end": 191.1,
   "text": "و به خاطر اینکه به بعض از اسرار آگاه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.1,
   "end": 193.2,
   "text": "اینه که گاهی اوقات آدم می‌ره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.2,
   "end": 197.16,
   "text": "یه آدمی که محذب نیست بعضی اسرار رو می‌فهمه سوء استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.16,
   "end": 199.42,
   "text": "مثل بعضی دعانویس‌ها مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.42,
   "end": 202.86,
   "text": "از اثر حالا دو تا روایت داریم، پای رسول میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.86,
   "end": 206.96,
   "text": "این رسول رو بعضیا از حضرت موسی گرفتن بعضیا از حضرت جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.96,
   "end": 212.5,
   "text": "بر خاک این اثر متبرک رو برداشت ریخت تو گلو گوساله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.5,
   "end": 217.26,
   "text": "تأثر کرد صدای گاو قشنگ صدای گوساله در میومد انگار که زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.26,
   "end": 221.78,
   "text": "مردم به سجده افتادند و گول خوردند و خلاصه فتنه‌ای به پا شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.78,
   "end": 224.86,
   "text": "که بعدها منجر به کشته شدن خیلی‌ها شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.86,
   "end": 227.52,
   "text": "همین قصه و خیلی‌ها رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.52,
   "end": 231.96,
   "text": "حالا امام می‌فرماید، امام صادق صلوات الله علیه می‌فرماید شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.96,
   "end": 234.86,
   "text": "هم گوساله دارید هم سامری دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.86,
   "end": 240.64,
   "text": "حالا من توی سیما دیدم الحمد لله سخنران‌های خوب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.64,
   "end": 246.52,
   "text": "مثل آقای حالا عرض شود پناهیان و دیگران بحث سامری رو به خوبی بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.52,
   "end": 251.3,
   "text": "اما اون گوساله رو من ندیدم کسی بگه در حالی که روایت درباره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.3,
   "end": 254.22,
   "text": "در ارتباط با اون‌ها داریم. گوساله ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.22,
   "end": 257.02,
   "text": "ز، امت ما، پیغمبر زمان ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.02,
   "end": 262.44,
   "text": "گوساله ما چیه؟ این روایت رو اول مقدمه قرار بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.44,
   "end": 268.0,
   "text": "که سندش هم میزان الحکمه آقای ری‌شهریه، کتاب خیلی خوبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.0,
   "end": 270.64,
   "text": "جلد یازده، صفحه صد و بیست و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.64,
   "end": 273.6,
   "text": "بنده دیروز این حدیث رو دیدم و درآوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.6,
   "end": 277.92,
   "text": "که پیغمبر فرمودند که «لکل امه عجل یعبدونه».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.92,
   "end": 284.02,
   "text": "برای هر امتی عجلی است یعنی گوساله‌ایست که میفتن به پاش و عبادتش می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.02,
   "end": 286.26,
   "text": "و عجل امتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.26,
   "end": 291.04,
   "text": "اون گوساله امت من الدنانیر جمع دینار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.04,
   "end": 294.38,
   "text": "و دراهم و درهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.38,
   "end": 297.8,
   "text": "پول، طلا، سکه، دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.8,
   "end": 302.4,
   "text": "پول، همه ثروت‌هایی که انسان البته می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.4,
   "end": 304.76,
   "text": "بعضیا فکرشون اشتباه نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.76,
   "end": 309.04,
   "text": "اس-اسلام مخالف با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.04,
   "end": 311.7,
   "text": "تجمیع ثروته، نه تولید ثروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.7,
   "end": 313.72,
   "text": "اسلام میگه تولید ثروت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.72,
   "end": 319.76,
   "text": "فقیر نباشی، فشار اقتصادی از رو دوشت برداشته بشه، از روی دوش دیگران هم مردانگی کن وردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.76,
   "end": 321.94,
   "text": "اما نه انباشت ثروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.94,
   "end": 325.7,
   "text": "اینا اشتباه نشه. در هر حال دلبستن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.7,
   "end": 329.68,
   "text": "دنوا، دنانیر به قول پیغمبر یا دراهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.68,
   "end": 332.14,
   "text": "که الان بیچاره کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.14,
   "end": 335.98,
   "text": "بیچاره کرده هر کس حتی کسایی که تو لباس دینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.98,
   "end": 341.38,
   "text": "فاصله گرفتن از زهد، به سمت اشرافی‌گری رفتن و تجملات و شع و شع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.38,
   "end": 346.24,
   "text": "این مسابقه‌ای، این سبقت که دارن از هم می‌گیرن متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.24,
   "end": 348.76,
   "text": "حتی بین هم لباسی‌های ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.76,
   "end": 351.68,
   "text": "مسابقه قدرت، مسابقه ثروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.68,
   "end": 354.14,
   "text": "عجیب دیگه دارید می‌بینید دیگه همتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.14,
   "end": 362.58,
   "text": "این همون گوساله است. اینکه مثلا مجلس‌های ما جرات نمی‌کنن جلوی مثلا خلاف‌های دولت رو بگیرن چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.58,
   "end": 366.78,
   "text": "دستشون توی یه کاسه است دیگه. مسابقه ثروت گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.78,
   "end": 370.38,
   "text": "نمی‌تونن یعنی یکیشونو بخوان یک، به یکیشون گیر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.38,
   "end": 373.76,
   "text": "یهو از اون طرف می‌بینی صد تا بیرون اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.76,
   "end": 375.36,
   "text": "شت-صد تا شاخ بیرون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.36,
   "end": 377.2,
   "text": "یعنی همشون گرفتار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.2,
   "end": 379.46,
   "text": "گرفتار این گوساله شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.46,
   "end": 384.74,
   "text": "تعارفم ندارین. اینطوری هم نیست که بگه لباس پیغمبر بشناسه برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.74,
   "end": 386.96,
   "text": "نخیر اتفاقا بیشتر سراغ ماها میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.96,
   "end": 389.14,
   "text": "ماها، هیئتی‌ها، ماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.14,
   "end": 391.92,
   "text": "گرفتار شدن اینا. گرفتار فتنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.92,
   "end": 396.92,
   "text": "سامری شدن. این حدیث رو دقت کنید از اصول کافی براتون دارم نقل می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.92,
   "end": 401.54,
   "text": "مرحوم کلینی، جلد پنج، صفحه صد و بیست و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.54,
   "end": 408.82,
   "text": "عجیب حدیثی‌ست. ان پیغمبر فرمود \"ان اخوف ما اخاف على امتی من بعدی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.82,
   "end": 416.8,
   "text": "می‌خواید بگم به شما، پیغمبر داره می‌فرماید بیشتر از هر چیزی بر شما از چی نگرانم و ترسانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.8,
   "end": 420.9,
   "text": "بیشتر از همه پیغمبر از سه چیز بر ما نگران بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.9,
   "end": 424.66,
   "text": "ها-- اول \"هذه المكاسب الحرام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.66,
   "end": 430.0,
   "text": "کسب حرام که تا دلت بخواد الا ماشاءالله الان زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.0,
   "end": 432.66,
   "text": "که بعضیا هم توجیهشو فشار اقتصادی میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.66,
   "end": 435.3,
   "text": "میگن دیگه چاره‌ای نداریم، چیکار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.3,
   "end": 437.84,
   "text": "دو فرمود \"والشهوة الخفية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.84,
   "end": 440.2,
   "text": "عجیبه رو این برید کار کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.2,
   "end": 444.46,
   "text": "خیلی من بهش دقت کردم \"والشهوة الخفية\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.46,
   "end": 446.42,
   "text": "چرا میگه شهوت خفی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.42,
   "end": 448.96,
   "text": "پنهان؟ نه میگه جلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.96,
   "end": 455.38,
   "text": "شهوت خفی شاید به یک معنا همین فضاهای مجازی و اینترنت و ماهواره و این‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.38,
   "end": 458.56,
   "text": "توی موبایل خ-- پنهانه، خفیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.56,
   "end": 462.98,
   "text": "دیده نمی‌شه. ولی به محض اینکه دریچه‌شو باز می‌کنی می‌بینی اوه، اوه، اوه!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.98,
   "end": 466.44,
   "text": "چه دریای متلا-متلاطمی از فساد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.44,
   "end": 470.0,
   "text": "شهوت خفی هم هست. در خفاست، دیده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.0,
   "end": 473.3,
   "text": "با خودت می‌تونی شهوتخانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.3,
   "end": 476.28,
   "text": "معذرت می‌خوام حمل کنی این ور اون ور در خفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.28,
   "end": 482.08,
   "text": "هیچکس هم متوجه نیست. ببین چقدر رمزی پیغمبر بیان کرده و ربا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.08,
   "end": 484.48,
   "text": "ربا که دیگه تا دلتون بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.48,
   "end": 487.88,
   "text": "اگرچه اون قانونی که به بانک‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.88,
   "end": 490.9,
   "text": "ابلاغ شده، سیاست‌های بانک مرکزی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.9,
   "end": 493.08,
   "text": "اسلامیه درسته اما رعایت نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.08,
   "end": 497.0,
   "text": "چون بانک‌ها رعایت نمی‌کنن دیگه ربا متاسفانه همه جا رو...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.0,
   "end": 501.22,
   "text": "حالا شما دقت کنید که این چقدر تو جامعه ما الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.22,
   "end": 503.24,
   "text": "بروز پیدا کرده، ظهور پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.24,
   "end": 507.06,
   "text": "به نظر شما کسی که گرفتار این گوساله شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.06,
   "end": 513.46,
   "text": "و سجده می‌کنه همه چیش شده پول، اصلاً هیچی دیگه حالیش نیست، آیا می‌تونه بفهمه حقایق رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.46,
   "end": 517.24,
   "text": "چنین کسی قطعاً قلبش در یک کنانی قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.24,
   "end": 520.58,
   "text": "همه چی رو با پول و دلار و سکه می‌سنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.58,
   "end": 523.42,
   "text": "اصلاً چنان چشمش کور می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.42,
   "end": 526.26,
   "text": "محاله حتی می‌بینی هیئتش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.26,
   "end": 530.14,
   "text": "چارت، این چرتکه ای میندازه برای هیئتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.14,
   "end": 533.58,
   "text": "بر اساس پول میندازه که حالا اونور نریم درد دلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.58,
   "end": 535.98,
   "text": "باز نشه دیگه بچه هیئتی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.98,
   "end": 540.34,
   "text": "اما سامری چیه؟ این رو هم نکته‌ای عرض کنم البته الحمدلله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.34,
   "end": 542.92,
   "text": "هست کردم این چند روز سخنرانی‌های خوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.92,
   "end": 545.0,
   "text": "صحبت‌های جالبی کرد-کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 545.0,
   "end": 549.48,
   "text": "دو تا روایت براتون عرض کنم از دو تا کتاب خیلی مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 549.48,
   "end": 552.5,
   "text": "شیعه. یکی امالی شیخ مفید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.5,
   "end": 556.48,
   "text": "صفحه سی. که می‌فرمود سامری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.48,
   "end": 564.02,
   "text": "امت پیغمبر، هم امیرالمؤمنین این رو بیان کردن، هم امام صادق دارن، هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.02,
   "end": 570.02,
   "text": "پیغمبر فرمودن. سامری امت پیغمبر فرمودن ابو موسی اشعری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.02,
   "end": 573.6,
   "text": "حالا برید شما ابو موسی اشعری رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.6,
   "end": 577.54,
   "text": "سامری زمان موسی یه شعار داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 577.54,
   "end": 580.3,
   "text": "شعارش چی بود؟ لا مساسه، لا مساسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.3,
   "end": 585.02,
   "text": "حالا بعضیا میگن وسواسی شیطون-- شیطنتی گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.02,
   "end": 586.66,
   "text": "شیطان درش وسواس ایجاد کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.66,
   "end": 589.78,
   "text": "گفت سمت من نیاید. شما نجسید، برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 589.78,
   "end": 593.14,
   "text": "بعضیا میگن نه، چهره زاهدها رو با خودش گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.14,
   "end": 595.46,
   "text": "لا مساسه، منو مس نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 595.46,
   "end": 600.9,
   "text": "سامری امت پیغمبر توی این حدیثی که الان سندشو براتون بیان کردم می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 600.9,
   "end": 603.2,
   "text": "این سامری ابو موسی اشعری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 603.2,
   "end": 604.9,
   "text": "شعارش لا قتال بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.9,
   "end": 608.56,
   "text": "لا قتال، لا قتال. یعنی جنگ نه، جنگ نه، سازش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.56,
   "end": 610.9,
   "text": "صلح، آرامش. جنگ چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.9,
   "end": 615.32,
   "text": "برای چی بزنیم سر کله هم؟ ببین با این خط و خطوط‌هایی که ائمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 615.32,
   "end": 618.74,
   "text": "هزار و چهارصد سال پیش تو کتاب‌های ما دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 618.74,
   "end": 621.62,
   "text": "خیلی راحت می‌شه تشخیص داد الان سامری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 621.62,
   "end": 625.04,
   "text": "فعل حال ابو موساهای اشعری زمان ما کیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 625.04,
   "end": 626.62,
   "text": "اینایی که دم از سازش می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 626.62,
   "end": 629.68,
   "text": "اینایی-- میگه باباجان ببین چقدرم قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 629.68,
   "end": 632.44,
   "text": "کلماتو ببین، صلح، آرامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 632.44,
   "end": 637.66,
   "text": "جنگ چیه؟ خونریزی و ب-- میگه باباجان که حمله شده به همه جای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 637.66,
   "end": 640.26,
   "text": "به اقتصاد ما، به فرهنگ ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 640.26,
   "end": 645.24,
   "text": "حتی از جهت نظامی دور تا دور ما رو محاصره، همه جوره به ما حمله کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.24,
   "end": 648.28,
   "text": "به اعتقادات ما، به کیان ما، به ناموس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 648.28,
   "end": 651.96,
   "text": "بعد ما بگیم نه آقا جان سازش، چاره‌ای جز سازش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 651.96,
   "end": 655.32,
   "text": "جنگ چیه؟ این کاملاً فکر ابو موسی اشعریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 655.32,
   "end": 662.22,
   "text": "همینا، همون ابو موسی که می‌گفت جنگ نه، جنگ نه و تو اون مذاکره دست امیرالمؤمنین علیه الصلاة والسلام رو بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 662.22,
   "end": 667.74,
   "text": "همون منجر، همین دست مولا بسته شدن منجر به جنگ‌های داخلی بعدی یا بی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 667.74,
   "end": 673.22,
   "text": "و غیره شد. چقدر خون‌ها ریخته شد به خاطر همین یه شعار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 673.22,
   "end": 676.1,
   "text": "این فتنه ها بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 676.1,
   "end": 684.7,
   "text": "خونبها می‌خواد دیگه. حدیث آخر رو هم تقدیم کنم خدمتتون که ببینید چقدر این قصه خون به دل امیرالمؤمنین کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.7,
   "end": 692.34,
   "text": "و الان این قصه فتنه و سامری و اجل و این‌ها چه خونی به دل امام عصر ما و جانشینش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 692.34,
   "end": 696.48,
   "text": "ولی فقیه زمان و شما دلسوختگان ولایت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 696.48,
   "end": 699.64,
   "text": "که امیر-- این امالی شیخ طوسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.64,
   "end": 701.72,
   "text": "اون قبلی شیخ مفید بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 701.72,
   "end": 704.36,
   "text": "این شیخ طوسی. صفحه هفتصد و بیست و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.36,
   "end": 710.76,
   "text": "\"ان عبدالله بن معقل عن علی علیه الصلاة والسلام انه قنت في الصبح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.76,
   "end": 716.32,
   "text": "میگه امیرالمؤمنین علیه الصلاة والسلامی راوی میگه مولا وقتی تو قنوت قرار می‌گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 716.32,
   "end": 719.42,
   "text": "می‌فرmo-- تو قنوت نماز صبحش می‌گفت فل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 719.42,
   "end": 721.18,
   "text": "مخصوصاً میگه نماز صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.18,
   "end": 724.04,
   "text": "اینم نکته‌ایه. شروع و آغاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.04,
   "end": 728.54,
   "text": "یک ز، یک روز جدید رو مولا با قنوت نمازش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.54,
   "end": 733.54,
   "text": "اوج و معراج نمازشه داره با چی شروع می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 733.54,
   "end": 739.78,
   "text": "فلعن. اونایی که میگن قابل توجه اونایی که میگن همش صلح، آرامش، جنگ چیه، لعن چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 739.78,
   "end": 742.08,
   "text": "مرگ چیه، این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 742.08,
   "end": 745.36,
   "text": "صبحش رو مولا با این شروع می‌کرده تو قنوت نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 745.36,
   "end": 749.78,
   "text": "\"فلعن معاویه وعمر بن العاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 749.78,
   "end": 752.86,
   "text": "وابا موسی\" هم ابو موسی اشعری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 752.86,
   "end": 755.88,
   "text": "\"وابا الاعور واصحابهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 755.88,
   "end": 760.24,
   "text": "و اصحابشون. با لعن بر این‌ها مخصوصاً ابو موسی شروع می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 760.24,
   "end": 763.44,
   "text": "چه خونی به دل امیرالمؤمنین علیه الصلاة والسلام کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 763.44,
   "end": 765.1,
   "text": "حالا ما بگیم آقا این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 765.1,
   "end": 771.74,
   "text": "کی می‌رسه یک روزی شعار مرگ برها پاک بشه از اذهان مردم و جنگ فلان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 771.74,
   "end": 776.42,
   "text": "تو خودت داری اسباب جنگ ایجاد می‌کنی با این شعار مسخره و لا قتال، لا قتال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 776.42,
   "end": 778.74,
   "text": "تو خودت ابو موسی اشعری زمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 778.74,
   "end": 782.24,
   "text": "تو خودت جلوی ولایت رو گرفتی و خون به دل ولایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 782.24,
   "end": 785.7,
   "text": "ولایتی‌ها کردی. امیدوارم که همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 785.7,
   "end": 789.8,
   "text": "مقدار بصیرتی که بر اساس این روایات، حرفا، حرفای منم نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 789.8,
   "end": 793.02,
   "text": "و آیاتی که بیان کردیم در این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 793.02,
   "end": 797.52,
   "text": "امروز ثوابش برسه به شهدا و اون‌ها ما رو دعا کنن و خواهشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 797.52,
   "end": 802.34,
   "text": "این صوت امروز رو تو همین فرصت کم بدید برسونید به دست هر کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 802.34,
   "end": 806.62,
   "text": "هنوز در خصوص مسئله همین فتنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 806.62,
   "end": 812.98,
   "text": "فعلی که در کشور ما بروز کرده در شک و تردید قرار داره که واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 812.98,
   "end": 817.66,
   "text": "شبیه خون فرهنگی هست، فتنه هست، نیست، اینا توهمه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.66,
   "end": 822.54,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 822.54,
   "end": 828.66,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}