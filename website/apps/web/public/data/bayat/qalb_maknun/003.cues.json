 "chapters": [
  {
   "index": 0,
   "title": "## حکم نذر: صیغه برای خدا یا برای امام حسین",
   "start": 13.84,
   "end": 93.24
  },
  {
   "index": 1,
   "title": "## قلب مکنون و آیهٔ بیست‌وپنجِ انعام",
   "start": 93.24,
   "end": 284.28
  },
  {
   "index": 2,
   "title": "## جدل حتی در برابر باطلِ یقینی",
   "start": 284.28,
   "end": 348.48
  },
  {
   "index": 3,
   "title": "## مدرسه، نماز، و عقده از امرِ بی‌برهان",
   "start": 348.48,
   "end": 489.28
  },
  {
   "index": 4,
   "title": "## امام موسی صدر؛ برهانِ پیش از حکم",
   "start": 489.28,
   "end": 671.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 4.0,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.0,
   "end": 7.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.82,
   "end": 13.18,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.18,
   "end": 19.9,
   "text": "می‌دونید که صیغه نذر در صورتی که بر زبان جاری بشه، اون نذر بر ما واجب میشه اداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.9,
   "end": 27.16,
   "text": "شرعا واجب میشه و فرقی نمی‌کنه که این صیغه عربی جاری بشه بر لسان ما یا فارسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.16,
   "end": 33.94,
   "text": "و مضمون صیغه به این صورت هستش که لله علي برای خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.94,
   "end": 37.02,
   "text": "که بر من این چنین کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.02,
   "end": 39.14,
   "text": "یعنی شما با خدا معامله می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.14,
   "end": 42.7,
   "text": "امروز از دفتر آقا من این استفتارو کردم خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.7,
   "end": 46.8,
   "text": "که حالا اگر کسی بگه من با امام حسین معامله می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.8,
   "end": 50.76,
   "text": "نه با خدا. ها؟ بعضیا می‌بینید عامه مردم این چنین هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.76,
   "end": 54.06,
   "text": "اشکالی هم نداره‌ها. میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.06,
   "end": 56.28,
   "text": "یعنی میگه من با امام حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.28,
   "end": 58.68,
   "text": "نظرم با امام حسینه. میگه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.68,
   "end": 65.08,
   "text": "مثلا اگه امام حسین علیه الصلاة والسلام این حاجت منو داد، حالا توجه هم داره که امام حسین وسیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.08,
   "end": 66.88,
   "text": "او به اذن الله می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.88,
   "end": 70.68,
   "text": "تا که اگه امام حسین مثلا حاجت منو بده من هر روز مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.68,
   "end": 73.74,
   "text": "اربعین آش میدم به عنوان مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.74,
   "end": 79.42,
   "text": "این نگفته لله عليکه گفته للحسین بن علی علي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.42,
   "end": 81.28,
   "text": "توجه کردید صیغه این چنین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.28,
   "end": 88.04,
   "text": "آیا اینم واجبه؟ دفتر آقا فرمودن نخیر، این دیگه شرعا بر او واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.04,
   "end": 90.96,
   "text": "می‌تونه شر-- نذرش رو ادا نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.96,
   "end": 93.02,
   "text": "دیگه از ریزه کاریای فقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.02,
   "end": 95.74,
   "text": "اما در خصوص قلب مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.74,
   "end": 99.0,
   "text": "نکته ظریفی رو اشاره کنیم و یک برداشت اخلاقی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.0,
   "end": 102.02,
   "text": "هنوز تو آیه بیست و پنج سوره انعام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.02,
   "end": 107.36,
   "text": "دقت می‌کردم به تفسیر نور آقای قرائتی دیدم یکی از نکاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.36,
   "end": 110.72,
   "text": "ایشون بهش توجه داشته و خیلی زیبا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.72,
   "end": 114.68,
   "text": "این نکته بود که ابتدای آیه می‌فرمود \"و منهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.68,
   "end": 119.64,
   "text": "این منهم رو دقت کنید \"و منهم من يستمع إلي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.64,
   "end": 124.86,
   "text": "از اینا هستن از این‌ها یعنی همشون نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.86,
   "end": 129.22,
   "text": "کلهم نیستن \"و منهم\" بعضیشون از اینا هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.22,
   "end": 134.08,
   "text": "که \"يستمع إلي\" میان حرف تو رو گوش میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.08,
   "end": 138.86,
   "text": ". در حالی که \"وجعلنا على قلوبهم أكنة أن يفقهوه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.86,
   "end": 142.08,
   "text": "یه کنانی، پرده‌ای رو قلبشونه که اینا نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.08,
   "end": 144.58,
   "text": "این پرده باعث میشه که حقایق رو نفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.58,
   "end": 146.62,
   "text": "اگرچه آیات قرآن رو می‌شنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.62,
   "end": 151.06,
   "text": "حالا شأن نزولش هم قطعاً مراجعه کردید دیدید مربوط میشه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.06,
   "end": 155.1,
   "text": "داستانی که جالبه که حتی ابو سفیان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.1,
   "end": 158.46,
   "text": "ابو سفیان سرکرده‌های کفر اون زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.46,
   "end": 164.92,
   "text": "یا نصر بن حارث که افسانه‌های پیشین رو حتی جالبه که دیدم تو تفاسیر بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.92,
   "end": 171.32,
   "text": "بزرگان نوشته رستم و افراسیاب اون موقع همین نصر بن حارث می‌اومده برای اعراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.32,
   "end": 175.26,
   "text": "می‌گفته اون موقع، می‌گفته بعد اینام کیف می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.26,
   "end": 177.26,
   "text": "هی می‌گفتن دوباره بیا برا ما بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.26,
   "end": 183.6,
   "text": "جالبه. از عجم‌ها برای اعراب اینطوری مثلا از مثال‌ها و داستان‌های ما می‌رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.6,
   "end": 192.26,
   "text": "حالا اسطوره‌های ما. بعد وقتی که اینا می‌رفتند \"و منهم\" برمی‌گرده به این‌ها، می‌رفتند گوش می‌دادند \"يستمع إليك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.26,
   "end": 196.54,
   "text": "قرآن رو گوش می‌دادند اما هیچ تأثیری درشون نمی‌گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.54,
   "end": 198.48,
   "text": "حالا اینجا داره قرآن بررسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.48,
   "end": 204.22,
   "text": "این شأن نزولش این چنینه که بعد میان بهشون میگن شما که این همه آیه قرآن گوش دادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.22,
   "end": 205.86,
   "text": "شد در شما تأثیر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.86,
   "end": 210.58,
   "text": "مثلا مثل همین نصر بن حارث می‌گفت نه بابا اینام همون استغفرالله همون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.58,
   "end": 215.28,
   "text": "چون آخر آیه چی میگه؟ \"إن هذا إلا أساطير الأولين\" اینا میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.28,
   "end": 221.34,
   "text": "اینا همون اسطوره‌ها و همون داستان‌هایی مثل رستم و افسا-افراسیاب که من برای شما می‌گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.34,
   "end": 224.5,
   "text": "مثل اوناست. استغفرالله این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.5,
   "end": 227.18,
   "text": "می‌گفتن. بعد شأن نزول این آیه نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.18,
   "end": 231.54,
   "text": "حالا قرآن داره می‌فرماید که اولا همشون این چنین نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.54,
   "end": 235.32,
   "text": "بعضیاشون تأثیر می‌گرفتن، می‌اومدن گوش می‌دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.32,
   "end": 238.0,
   "text": "و برمی‌گشتن. خیلیا هم اینطوری بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.0,
   "end": 243.22,
   "text": "حالا دقت بفرمایید کدوم یکی از این‌ها بودن که تأثیر نمی‌گرفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.22,
   "end": 247.24,
   "text": "با یک لطافت خاصی خود قرآن داره م-می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.24,
   "end": 249.38,
   "text": "کیا بودند؟ \"وفي آذانهم وقرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.38,
   "end": 250.88,
   "text": "سنگین شده بود گوششون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.88,
   "end": 253.18,
   "text": "\"يرى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.18,
   "end": 255.42,
   "text": "كل آية لا يؤمن بها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.42,
   "end": 260.02,
   "text": "کیا بودند همه آیات رو هم اگر نگاه می‌کردن ایمان نمی‌آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.02,
   "end": 264.0,
   "text": "ببینید اینجا به زیبایی داره با یک لطافت خاصی بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.0,
   "end": 267.14,
   "text": "اهل نظر متوجه میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.14,
   "end": 269.94,
   "text": "خدا می‌فرماید \"إذا جاؤك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.94,
   "end": 273.1,
   "text": "وقتی اینا می‌اومدن پیش تو \"يجادلونك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.1,
   "end": 276.98,
   "text": "\"يجادلونك\" اینا هم اهل جدل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.98,
   "end": 280.06,
   "text": "اهل نزاع و جدل و بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.06,
   "end": 284.12,
   "text": "و-- اصلا نیومده بودند که تشخیص بدن حق از باطل چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.12,
   "end": 289.2,
   "text": "این نکته مهمیه. \"لذا يقول الذين كفروا إن هذا إلا أساطير الأولين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.2,
   "end": 296.16,
   "text": "چون اصلا نیومده بودند که حق رو بفهمند، فقط صرفا برای مجادله اومده بودند و بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.16,
   "end": 300.34,
   "text": "که مثلا طرفشونو مغلوب کنن و کنف کنن به قول ما اومده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.34,
   "end": 304.64,
   "text": "لذا هیچ فایده‌ای... این نکته مهمیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.64,
   "end": 309.88,
   "text": "گاهی اوقات ماها حتی در برابر شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.88,
   "end": 312.68,
   "text": "یه سری جریان‌های باطل هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.68,
   "end": 314.4,
   "text": "این کار باطل رو انجام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.4,
   "end": 315.98,
   "text": "آقا باطله. می‌دونیم باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.98,
   "end": 318.52,
   "text": "یقین داریم. اما چرا مجادله می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.52,
   "end": 321.86,
   "text": "میگه آقا \"وجادلهم بالتي هي أحسن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.86,
   "end": 328.38,
   "text": "به بهترین وجه حتی با دشمنتم بزرگان فرمودن حرف دشمنتم درست بشنو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.38,
   "end": 331.18,
   "text": "طرف اومده بود مس کرده بود تو محراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.18,
   "end": 335.88,
   "text": "مسجد خودشو انداخت تو لبان پیغمبر ریختن صحابه بزنن پرتش کنن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.88,
   "end": 338.52,
   "text": "فرمود ولش کنید به من پناه آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.52,
   "end": 342.28,
   "text": "ولش کنید بذارید از این حالت خارج شه بعد درد دلشو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.28,
   "end": 344.86,
   "text": "ببینید این چگونه‌ست، این چطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.86,
   "end": 349.72,
   "text": "شما ببینید این جدل رو برمی‌داره حتی در مواجهه با دشمناش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.72,
   "end": 354.72,
   "text": "جدل باعث میشه که میگه آقا جان حتی در برابر دشمنتم بذار حرفتو بشنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.72,
   "end": 358.22,
   "text": "مگه تو منطق نداری؟ مگر برهانت عین عرفانت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.22,
   "end": 360.86,
   "text": "مگر عرفانت عین قرآنت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.86,
   "end": 367.58,
   "text": "کتاب عرفان و برهان قرآن علامه سنزاده رو کسی بخونه میفهمه تا آخرش دیگه یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.58,
   "end": 371.1,
   "text": "اگر اینا عین هم هست خب بشنو، بشنو نترس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.1,
   "end": 373.92,
   "text": "تو برهان داری برهان او رو هم بشنو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.92,
   "end": 377.76,
   "text": "یکی از مشکلاتی که اخیراً توی همین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.76,
   "end": 385.34,
   "text": "فتنه‌ی اخیر پیش اومد این بود که بعضی از ماها اهل جدلیم و اکثراً هم اون‌ها اهل جدل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.34,
   "end": 389.36,
   "text": "این مشکل هیچ وقت درست بشو نیست تا نخواهیم برهان نیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.36,
   "end": 394.62,
   "text": "جالبه که ببینید حتی این شهید اخیری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.62,
   "end": 398.24,
   "text": "بچهشو تلویزیون نشون داد، بچهشو آورده بودن گذاشته بودن رو سینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.24,
   "end": 401.28,
   "text": "چقدرها گریه کردن این ملت با این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.28,
   "end": 403.26,
   "text": "خانمش جمله‌ی کلیدی‌ای گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.26,
   "end": 405.9,
   "text": "گفت وقتی میخواست بره بهش گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.9,
   "end": 407.96,
   "text": "کلتتو با خودش-- با خودت ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.96,
   "end": 411.26,
   "text": "گفته بود من میخوام با اینا برم حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.26,
   "end": 414.74,
   "text": "من قصدم کشتن نیست که کلت برای چی ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.74,
   "end": 417.82,
   "text": "میخوام برم با اینا صحبت کنم، نصیحتشون کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.82,
   "end": 422.46,
   "text": "الله اکبر. شما منطق یه بسیجی و یه فدای امام حسین رو ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.46,
   "end": 426.06,
   "text": "تا بعضی از ما که چپ کشی بزن بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.06,
   "end": 429.38,
   "text": "توجه کردی چی شد؟ این‌ها بعد عقده‌ای بار میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.38,
   "end": 432.66,
   "text": "مثل اینکه من رفتم توی دب-دبستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.66,
   "end": 438.44,
   "text": "خوبه، یکی از دبستان‌های خوب و نمونه برای مردم صحبت کنم در-در رابطه با نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.44,
   "end": 440.76,
   "text": "انگار که بمب انداختیم اون وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.76,
   "end": 443.0,
   "text": "مادرها شروع کردن داد و فریاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.0,
   "end": 445.02,
   "text": "ولمون کنید حاج آقا بنزین فلان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.02,
   "end": 447.42,
   "text": "شما-- اصلاً ما نمیخوایم بچمون نماز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.42,
   "end": 450.5,
   "text": "چیو باید ببینیم؟ بعد یکیشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.5,
   "end": 454.52,
   "text": "خیلی قیافه نگاه میکردی ظاهراً عین شیطان بود اما شاید از من بهتر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.52,
   "end": 458.32,
   "text": "خب چه میدونی؟ ما ظاهرمون رو درست کردیم شاید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.32,
   "end": 464.86,
   "text": "موهاش یه ذره بیرون بود. گفتش که چطور ما یه ذره موهامون بیرونه میاد میزنه تو کله ما موتو بکن تو فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.86,
   "end": 471.22,
   "text": "حالا که الان مثلاً ما حرف داریم برای گفتن چرا بنزین گرون شده، شما حرف از نماز میزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.22,
   "end": 474.26,
   "text": "ببینید عقده شده رو دلش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.26,
   "end": 477.8,
   "text": "کوبیدن تو سرش که بدون برهان و منطق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.8,
   "end": 481.48,
   "text": "خیلی از گرفتاری‌های ما اینجا ناشی از اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.48,
   "end": 488.66,
   "text": "اگر ما نمی‌تونیم حرفمون رو به کرسی بنشونیم حتی تو امر به معروف و نهی از منکر افراط کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.66,
   "end": 493.22,
   "text": "تفریط که تا دلت بخواد داریم تو اون انجامش هم افراط داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.22,
   "end": 495.36,
   "text": "نتونستیم چگونه عمل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.36,
   "end": 502.66,
   "text": "خدا رحمت کنه. باور کنید تا من این رو از منبع موثق ندیده بودم، خودم انقدر که کج خلقه‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.66,
   "end": 504.94,
   "text": "شاید باور نمی‌کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 504.94,
   "end": 508.98,
   "text": "امام موسی صدر چرا بهش می‌گفتن مسیح لبنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.98,
   "end": 511.74,
   "text": "این حالت رو مثلاً می‌رفت، می‌رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.74,
   "end": 516.42,
   "text": "امر به معروف و نهی از منکر، نهی از منکر کنه برهان میاورده و برهان می‌شنیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.42,
   "end": 519.5,
   "text": "می‌گفت شما برهانتون رو بگید. اول هم جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.5,
   "end": 522.04,
   "text": "بدونید امام موسی صدر چرا امام شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.04,
   "end": 525.84,
   "text": "امام موسی. میگن اول برهان طرف مقابل رو می‌شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.84,
   "end": 529.34,
   "text": "بعد برهان میاورد. میگن رفته بود یه کار عجیبی کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.34,
   "end": 532.14,
   "text": "اینم بگیم و السلام. رفته بود توی کاباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.14,
   "end": 534.9,
   "text": "توی حالا زندگی نامه‌ش ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.9,
   "end": 538.3,
   "text": "میره توی کاباره میشینه میگن اه امام موسی صدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 538.3,
   "end": 544.72,
   "text": "فکر کنید مثلاً رهبر عزیز ما حضرت امام مثلاً تشریف می‌بردن استغفرالله مثلاً کارا-کاباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.72,
   "end": 547.78,
   "text": "مثل توپ صدا می‌کرد. دیگه همچین شخصیتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.78,
   "end": 549.9,
   "text": "اه دهان به دهان این به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 549.9,
   "end": 551.48,
   "text": "امام موسی صدر اومده کاباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.48,
   "end": 554.54,
   "text": "تازه اون محله‌ی خاصی که اون کاباره بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.54,
   "end": 557.74,
   "text": "یه جایی بوده که هر کسی اصلاً قدم اونجا نمی‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.74,
   "end": 560.42,
   "text": "مثل توپ صدا می‌کنه. ایشون اومده کاباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.42,
   "end": 564.14,
   "text": "جالبه میره میشینه سر میز میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.14,
   "end": 566.84,
   "text": "بیارید برام. چی بیاریم؟ همون که برای همه میارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.84,
   "end": 569.06,
   "text": "اینجا مشروب سرو می‌کنن برای همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.06,
   "end": 571.1,
   "text": "بله بیارید برای منم بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.1,
   "end": 572.84,
   "text": "اصلاً همه می مونن. چی کار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 572.84,
   "end": 577.88,
   "text": "نیاریم؟ میخواد چی کار کنه؟ خلاصه یکی دلش رو میزنه به-- از این گارسونه به دریا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 577.88,
   "end": 581.94,
   "text": "مشروب رو میذاره جلوش. به نظر شما چگونه رفتار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 581.94,
   "end": 584.1,
   "text": "حالا ما بودیم بلند میشدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 584.1,
   "end": 586.94,
   "text": "لگد میزدم زیر میز و شمشیر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 586.94,
   "end": 590.7,
   "text": "بر-برمی‌کردیم. از رداش از تو این جیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 590.7,
   "end": 596.04,
   "text": "قباش یه تیکه جگر، یه تیکه جگر سالم برمی‌داره میندازه توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.04,
   "end": 598.6,
   "text": "چی؟ این مشروبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.6,
   "end": 601.06,
   "text": "بعد میگه خب حالا با هم صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.06,
   "end": 602.84,
   "text": "نظر شما در رابطه با مشروب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 602.84,
   "end": 605.76,
   "text": "همینطوری شروع میکنن برهان اون‌ها رو شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 605.76,
   "end": 608.96,
   "text": "بعد برهان خودش رو عملی نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 608.96,
   "end": 614.86,
   "text": "یه مدت می‌گذره تو بحثشون میگه ببینید این جگر چه بلایی سرش اومد توسط این مشروب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.86,
   "end": 619.2,
   "text": "چگونه جمع شده؟ چگونه سلول‌هاش از هم پاچیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.2,
   "end": 622.3,
   "text": "اینه که اسلام نهی میکنه بخاطر اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.3,
   "end": 626.34,
   "text": "بخاطر خودتونه. عزیزان دلم، اسلام میخواد شما سالم باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.34,
   "end": 628.88,
   "text": "آقا همه‌ی اینا مریدش میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.88,
   "end": 632.74,
   "text": "و جالبه یکی از اون‌ها میگن شهید راه امام موسی صدر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 632.74,
   "end": 636.26,
   "text": "همون مشروب خورا. آدم بدونه چگونه رفتار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 636.26,
   "end": 638.0,
   "text": "به خدا این فطره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.0,
   "end": 642.14,
   "text": "فطرت که همه دارن. کل مولود یولد علی الفطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.14,
   "end": 650.32,
   "text": "حواسمون جمع باشه. میگه اون کسایی قلبشون در یک کنا نیست که نور الهی درش نمیره، که اهل مجادله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 650.32,
   "end": 652.72,
   "text": "اصلاً برهان مرهان سرشون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 652.72,
   "end": 654.86,
   "text": "فقط میخوان دعوا راه بندازن و نزاع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 654.86,
   "end": 659.76,
   "text": "خدا نکنه ما بچه حزب‌اللهی یا حامیان یا ولایتی‌ها گرفتار این قصه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.76,
   "end": 661.62,
   "text": "انشاالله عاقبت بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 661.62,
   "end": 664.38,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 664.38,
   "end": 667.92,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 667.92,
   "end": 671.16,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}