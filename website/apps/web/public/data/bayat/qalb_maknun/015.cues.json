   "title": "## احکامِ قسم؛ شرطِ انعقاد",
   "start": 4.34,
   "end": 75.44
  },
  {
   "index": 1,
   "title": "## موضوعِ قسم؛ فعل و ترک",
   "start": 75.44,
   "end": 199.88
  },
  {
   "index": 2,
   "title": "## فهم و ارتباط با ملکوت؛ اثرِ رحم و صلب",
   "start": 199.88,
   "end": 275.08
  },
  {
   "index": 3,
   "title": "## الولد سر أبیه؛ اهمیّتِ رحمِ مادر",
   "start": 275.08,
   "end": 295.24
  },
  {
   "index": 4,
   "title": "## المرأة مصنعة صنع الله",
   "start": 295.24,
   "end": 375.0
  },
  {
   "index": 5,
   "title": "## جایگاهِ رفیعِ زن و پاکیِ رحم",
   "start": 375.0,
   "end": 422.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.6,
   "end": 5.2,
   "text": "نذر بیان کردی. اما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 8.58,
   "text": "احکام قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.58,
   "end": 15.2,
   "text": "حالا چون سرویس‌هاتون هم ساعت دو میره امروز ظاهراً، من کوتاه‌تر امروز صحبت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.2,
   "end": 18.92,
   "text": "چهار پنج دقیقه فقط. در خصوص احکام قسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.92,
   "end": 24.02,
   "text": "قسم اصلاً یعنی چی؟ قسم اولاً باید به خدا خورده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.02,
   "end": 28.46,
   "text": "به خدا یا به اسماء و صفاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.46,
   "end": 36.02,
   "text": "فقط در خصوص خدا استعمال میشه مثل رزاقیت، مثل قدرت، مثل حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.02,
   "end": 40.96,
   "text": "حکیم، خالق و این‌ها باید خصوص خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.96,
   "end": 47.12,
   "text": "اگر کسی قسم در رابطه با خدا نخوره مثلاً در رابطه با طبیعیات بخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.12,
   "end": 51.78,
   "text": "به آسمان قسم به از-- حتی در خصوص پیغمبر، انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.78,
   "end": 55.12,
   "text": "ائمه یا قرآن هم قسم بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.12,
   "end": 58.12,
   "text": "براش واجب نمی‌شه انجام اون عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.12,
   "end": 60.68,
   "text": "اینو حواسمون باشه باید قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.68,
   "end": 64.6,
   "text": "به خدا خورده بشه یا یکی از اسماء خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.6,
   "end": 66.7,
   "text": "به خدای حکیم قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.7,
   "end": 69.14,
   "text": "یا به حکمت خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.14,
   "end": 73.6,
   "text": "اون موقع بر شما واجب می‌شه اون قسمی که خوردی رو انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.6,
   "end": 76.98,
   "text": "حالا اینو توجه داشته باشید، این نکته مهمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.98,
   "end": 80.02,
   "text": "که موضوعی که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.02,
   "end": 83.84,
   "text": "قسم برش می‌خوری اگر فعله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.84,
   "end": 87.58,
   "text": "باید یا واجب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.58,
   "end": 91.26,
   "text": "یا مستحب باشه یا مباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.26,
   "end": 97.88,
   "text": "اگر فعله یا باید واجب باشه یعنی بخوای کاریو-- قسم به خدای حکیم می‌خورم این کارو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.88,
   "end": 100.54,
   "text": "باید حتماً این چون فعل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.54,
   "end": 104.72,
   "text": "یا واجب باشد یا مستحب باشد یا مک-- یا مباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.72,
   "end": 109.26,
   "text": "اما اگر ترک باشد قسم به خدای رحمان می‌خورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.26,
   "end": 111.2,
   "text": "که این کارو دیگه انجام ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.2,
   "end": 116.62,
   "text": "اون موقع باید چی باشه؟ یا حرام باشه یا مکروه باشه یا مباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.62,
   "end": 120.66,
   "text": "اگر بالعکس باشه اصلاً اون قسم باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.66,
   "end": 123.44,
   "text": "مثل اینکه من قسم بخورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.44,
   "end": 128.1,
   "text": "که من به خدای رحمان قسم می‌خورم دیگه هیئت نمی‌رم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.1,
   "end": 131.48,
   "text": "مثلا این قسم باطله چون هیئت رفتن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.48,
   "end": 137.08,
   "text": "مستحبه. و تو داری ترک رو بر مستحب بار می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.08,
   "end": 139.84,
   "text": "ترک باید بر حرام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.84,
   "end": 142.26,
   "text": "مکروه و مباح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.26,
   "end": 146.2,
   "text": "مباح هم مثل خوردن و خوابیدن و اینجور چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.2,
   "end": 149.1,
   "text": "می‌شه براش چه فعل باشه، چه ترک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.1,
   "end": 155.48,
   "text": "مثلاً من به خدای احد و واحد قسم می‌خورم دیگه بین الطلوعین نخوابم، بر تو واجب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.48,
   "end": 159.52,
   "text": "مباحه، چه نه اصلاً قسم می‌خورم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.52,
   "end": 164.66,
   "text": "هر روز ساعت مثلا قبل اذان ظهر بخوابم چون قیلوله است خواب رحمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.66,
   "end": 167.92,
   "text": "خواب بین الطلوعین قیلوله است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.92,
   "end": 171.4,
   "text": "علیل می‌کنه آدمو. علیل، زمین‌گیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.4,
   "end": 175.28,
   "text": "هم از جهت رزق و روزی هم جسم و روحو داغون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.28,
   "end": 179.16,
   "text": "خواب قبل اذان ظهر قیلوله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.16,
   "end": 181.98,
   "text": "چه فعل باشه، چه ترک باشه چون این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.98,
   "end": 185.32,
   "text": "کلاً مطلقاً خواب مباحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.32,
   "end": 187.92,
   "text": "قسمت باید انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.92,
   "end": 189.82,
   "text": "این حالا تا همین مقدار بسنده کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.82,
   "end": 196.54,
   "text": "نکته‌ای رو فقط عرض کنم چون فرصت کوتاهه دو سه دقیقه من حرف بزنم نمی‌شه این حقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.54,
   "end": 199.58,
   "text": "ادا بشه. انشاالله روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.58,
   "end": 205.22,
   "text": "ما یکی از دلایل بسیار مهمی که حالا اینو مبسطاً انشاالله می‌گیم روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.22,
   "end": 208.36,
   "text": "دلایل مهمی که معتقدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.36,
   "end": 212.56,
   "text": "در فهم ما و استنباط‌های عقلی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.56,
   "end": 216.42,
   "text": "و خطورات قلبی ما در این نشئه طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.42,
   "end": 221.92,
   "text": "و ارتباط ما از این نشئه طبیعت با عالم م-ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.92,
   "end": 226.74,
   "text": "ار-- تاثیر مستقیم دارد، تاثیر به سزا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.74,
   "end": 229.28,
   "text": "رحمی‌ست که از اون بیرون اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.28,
   "end": 231.54,
   "text": "صلبی‌ست که از اون بیرون اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.54,
   "end": 234.32,
   "text": "یکی از معانی‌ای که اینو روش برید فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.32,
   "end": 238.8,
   "text": "حالا مبسطاً درباره‌ش بحث می‌کنیم شاید دو سه جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.8,
   "end": 243.58,
   "text": "یکی از معانی‌ای که اینجا و قدم و قدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.58,
   "end": 246.34,
   "text": "و نسی ما قدمت یداه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.34,
   "end": 249.34,
   "text": "تو همین آیه‌ای که داریم مورد بحث قرار می‌دیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.34,
   "end": 254.28,
   "text": "در رابطه با قلب نفع و نسیه فراموش می‌کنند چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.28,
   "end": 257.26,
   "text": "ما قدمت یداه. پیشینه‌شون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.26,
   "end": 259.2,
   "text": "خب می‌شه این برگرده به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.2,
   "end": 262.66,
   "text": "گناه‌هایی که کرده، می‌شه به خیلی چیزای دیگه که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.66,
   "end": 266.94,
   "text": "اما اینم مهمه. اینو شاید شما جایی گیر نیارید‌ ها این نکته رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.94,
   "end": 269.7,
   "text": "که پیشینه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.7,
   "end": 274.92,
   "text": "برمی‌گرده به نوعی به رحم و صلبی که درش بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.92,
   "end": 277.4,
   "text": "که الولد سر أبيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.4,
   "end": 280.68,
   "text": "فرزند سر و جان پدرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.68,
   "end": 285.62,
   "text": "سر پدره. آنچه پدر دارد به تو می‌رسد و آنچه تو داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.62,
   "end": 288.72,
   "text": "به پسرت و به فرزندت، به دخترت می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.72,
   "end": 291.26,
   "text": "و مهم‌تر از صلب عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.26,
   "end": 294.42,
   "text": "رحم مادر است. رحم مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.42,
   "end": 298.64,
   "text": "و حالا یه فرمایشی تو همین مقدار من توقف می‌کنم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.64,
   "end": 302.28,
   "text": "نمی‌خوام زیاد حرف بزنم بعد مطلب از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.28,
   "end": 307.02,
   "text": "انشاالله فردا مفصل می‌گیم اگر توفیق باشه، حیات باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.02,
   "end": 312.06,
   "text": "یه جمله‌ای علامه داره این جمله جا داره کتاب‌ها درباره‌ش بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.06,
   "end": 315.7,
   "text": "می‌فرماید المرأة مصنعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.7,
   "end": 318.58,
   "text": "صنع الله. صنع الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.58,
   "end": 320.74,
   "text": "می‌فرماید مرأة یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.74,
   "end": 323.74,
   "text": "زن. زن مصنعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.74,
   "end": 327.64,
   "text": "کارخانه صنعت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.64,
   "end": 332.52,
   "text": "کارخانه صنع الهی رحم مادر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.52,
   "end": 337.86,
   "text": "یعنی این عالم ما حرکت وجودیه رو گفتیم، حرکت ایجادیه رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.86,
   "end": 341.32,
   "text": "گفتیم عالم در حال حرکت است، مشق زنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.32,
   "end": 344.42,
   "text": "غایت این حرکت در عالم رسیدن به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.42,
   "end": 346.74,
   "text": "به اینکه نطفه تشکیل بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.74,
   "end": 350.32,
   "text": "و نطفه به مقام انسان کامل برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.32,
   "end": 352.58,
   "text": "حالا می‌گیم اون نطفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.58,
   "end": 358.2,
   "text": "تشکیل شد در مشق زنی عالم به قول علامه کجا باید بره تعبیه بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.2,
   "end": 360.72,
   "text": "تا این سیر استکمالیش رو طی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.72,
   "end": 365.1,
   "text": "به کمال برسه و بشه به انسان کامل برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.1,
   "end": 367.46,
   "text": "در رحم مادر. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.46,
   "end": 369.78,
   "text": "می‌فرماید المرأة مصنعة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.78,
   "end": 375.0,
   "text": "این زن، این رحمش کارخانه انسان‌سازی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.0,
   "end": 378.74,
   "text": "همین جایگاه رفیع و بی‌نظیر برای زن بس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.74,
   "end": 381.46,
   "text": "که حالا هی بیاییم بزنیم تو سر زن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.46,
   "end": 386.92,
   "text": "که محدودش کردن. نمی‌تونه قاضی باشه، نمی‌تونه مسئولیت چه می‌دونم چی چی بگیره، نمی‌دونم ارث بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.92,
   "end": 390.06,
   "text": "یک سوم مرد می‌رسه. از اینجور خزعبلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.06,
   "end": 394.68,
   "text": "که وقتی جایگاه زن درک نشود، از این حرفا در کنارش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.68,
   "end": 397.6,
   "text": "اگر کسی اون رحمی که درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.6,
   "end": 399.84,
   "text": "قرار گرفته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.84,
   "end": 404.48,
   "text": "اون رحم، رحме به تمام معنا نباشد، پاک و مطهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.48,
   "end": 413.02,
   "text": "و آلو-- و پاکیزه از قذارات و آلودگی‌های دنیوی قطعاً در فهمش نسبت به حقایق عالم بالا مشکل پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.02,
   "end": 415.26,
   "text": "حالا اینو انشاالله مفصل توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.26,
   "end": 422.24,
   "text": "عاقبتمون انشاالله ختم به خیر بشه به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}