 },
 "chapters": [
  {
   "index": 0,
   "title": "## کفارهٔ ترک نذر",
   "start": 13.42,
   "end": 73.22
  },
  {
   "index": 1,
   "title": "## قلب مکنون و نشانهٔ بیزاری از توحید",
   "start": 73.22,
   "end": 100.72
  },
  {
   "index": 2,
   "title": "## کلمات وجودی در سراسر نظام هستی",
   "start": 100.72,
   "end": 131.5
  },
  {
   "index": 3,
   "title": "## زیارت برادر مؤمن و امام أخ شقیق",
   "start": 131.5,
   "end": 359.3
  },
  {
   "index": 4,
   "title": "## توحید یعنی سوختن مشترک",
   "start": 359.3,
   "end": 432.29
  },
  {
   "index": 5,
   "title": "## اشارات پایانی درس",
   "start": 432.29,
   "end": 689.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.24,
   "end": 4.36,
   "text": "بسم الله الرحمن الرحیم و به او نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 8.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.28,
   "end": 13.14,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.14,
   "end": 22.28,
   "text": "حالا اگر کسی نذری رو انجام داد و توان انجام اون نذر رو هم داشت اما به هر دلیلی انجام نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.28,
   "end": 29.76,
   "text": "نذری کرده، موعد نذرش رسیده، چه نذر مطلق، چه نذر مقید به زمان و مکان و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.76,
   "end": 32.94,
   "text": "انجام نداد نذرشو. چه باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.94,
   "end": 36.34,
   "text": "اینجا فرمودن که کفاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.34,
   "end": 39.96,
   "text": "انجام ندادن نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.96,
   "end": 41.68,
   "text": "کفاره داره. کفاره‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.68,
   "end": 44.44,
   "text": "فرمودن باید ده تا فقیر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.44,
   "end": 50.8,
   "text": "اطعام کنه. اگر نمی‌تونه اطعام کنه ده تا فقیر رو لباس بپوشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.8,
   "end": 55.02,
   "text": "اگر این رو هم توان نداره فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.02,
   "end": 58.7,
   "text": "سه روز پیاپی روزه بگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.7,
   "end": 62.9,
   "text": "این کفاره‌ی، یعنی یکیشو انجام بده کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.9,
   "end": 66.16,
   "text": "کفاره‌ی انجام ندادن نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.16,
   "end": 70.44,
   "text": "که شخص ناظر در منظور خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.44,
   "end": 73.04,
   "text": "در نذری که کرده کوتاهی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.04,
   "end": 77.08,
   "text": "خب بحث ما در خصوص قلب نفهم بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.08,
   "end": 81.12,
   "text": "طبق قرآن در کنانی و پرده‌ای قرار می‌گیره و حقایق رو نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.12,
   "end": 84.78,
   "text": "نشانه‌ش هم عرض کردیم در حقایق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.78,
   "end": 88.04,
   "text": "کلمات توحیدی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.04,
   "end": 94.6,
   "text": "که این چند روز مختصراً این باب سنگین رو باز کردیم و تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.6,
   "end": 100.14,
   "text": "عرض کردیم که می‌فرماید \"و اذ اذكر ربک فی القرآن وحده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.14,
   "end": 104.94,
   "text": "وقتی کلمات وحدت رو وقتی توحید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.94,
   "end": 108.3,
   "text": "تو در قرآن میگی، ذکر می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.3,
   "end": 111.92,
   "text": "\"واللا علی اباره النفور\" با نفرت میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.92,
   "end": 116.88,
   "text": "خب این کلمات وجودی در تمام نظام وجود هستن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.88,
   "end": 122.5,
   "text": "یعنی شما اساساً برید سراغ درس اول معرفت النفس علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.5,
   "end": 127.02,
   "text": "دقت بفرمایید. ایشون در درس اول‌شون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.02,
   "end": 129.1,
   "text": "جالبه که بدونید همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.1,
   "end": 132.24,
   "text": "معرفت النفس فهم همین درس اول است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.24,
   "end": 138.6,
   "text": "و اگر شما به درس نود و نه هم که برسید که حدیث هم داریم نود و نه اسم خدا دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.6,
   "end": 143.6,
   "text": "باز خروجی‌ش همین فهم عمیق و پیچیدگی همین درس اول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.6,
   "end": 147.22,
   "text": "عین عبارت علامه اینه. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.22,
   "end": 149.56,
   "text": "وجود است که مشهود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.56,
   "end": 153.98,
   "text": "ببینید علامه می‌فرماید آنچه که مشهود ماست وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.98,
   "end": 157.82,
   "text": "ما موجودیم و جز ما همه موجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.82,
   "end": 161.08,
   "text": "ما جز وجود نیستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.08,
   "end": 169.26,
   "text": "و جز وجود را نداریم و جز وجود را نمی‌بینیم و جز وجود را نمی‌یابیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.26,
   "end": 171.2,
   "text": "همش چی درش مشترکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.2,
   "end": 175.8,
   "text": "وجود، وجود، وجود. ما قائل به کثرت و کثرات هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.8,
   "end": 179.32,
   "text": "بالاخره آسمان و زمین و ماه و خورشید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.32,
   "end": 183.12,
   "text": "جمادات و نباتات و حیوانات و انسان‌ها این همه کثرات هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.12,
   "end": 187.48,
   "text": "اما قبلاً بحث کردیم همه‌ی این‌ها بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.48,
   "end": 192.62,
   "text": "اون وحدت شخصیه‌ی وجود یا همون بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.62,
   "end": 194.96,
   "text": "همه، همه‌ی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.96,
   "end": 198.68,
   "text": "درسته کثرات‌اند اما از یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.68,
   "end": 202.1,
   "text": "از یک حقیقت وا-واحد‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.1,
   "end": 204.52,
   "text": "یعنی ما هم قائل به کثرت هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.52,
   "end": 207.96,
   "text": "هم قائل به این هستیم که وجود یک وجود بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.96,
   "end": 211.52,
   "text": "این‌ها نمودارهای همون یک وجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.52,
   "end": 213.32,
   "text": "در عین حال همه وجود دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.32,
   "end": 215.78,
   "text": "شما وجود داری، آسمان وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.78,
   "end": 219.84,
   "text": "و همه هم به قول علامه علم انباشت‌رای روی هم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.84,
   "end": 222.78,
   "text": "الان هر چیزی حتی صنع بشری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.78,
   "end": 227.68,
   "text": "این ماشین‌هایی که ساختن، لوسترها، فرش‌ها، هرچی ساختمان‌ها شما ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.68,
   "end": 235.22,
   "text": "همش درش اراده انسان دخیل بوده، علم انسان دخیل بوده، حیات انسان، شعور انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.22,
   "end": 237.38,
   "text": "عقل و فکر انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.38,
   "end": 239.68,
   "text": "الا اینه؟ قدرت انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.68,
   "end": 245.16,
   "text": "تمام این نظامات هستی رو، کلمات وجودی رو شما دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.16,
   "end": 247.64,
   "text": "انباشته علم روی هم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.64,
   "end": 251.8,
   "text": "حیات محض‌اند. یعنی اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.8,
   "end": 254.56,
   "text": "مظهر اسم حیی خدااند، حیات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.56,
   "end": 259.22,
   "text": "اراده‌ی محض‌اند. قدرت محض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.22,
   "end": 262.74,
   "text": "الا اینه؟ شعور محض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.74,
   "end": 265.98,
   "text": "حتی حیوانات قرآن می‌فرماید \"و اذ الوحوش حشرت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.98,
   "end": 268.34,
   "text": "ما میگیم وحشی، حیوان وحشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.34,
   "end": 270.96,
   "text": "اما حشرت، محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.96,
   "end": 273.58,
   "text": "اصلاً همه عالم شعور دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.58,
   "end": 277.2,
   "text": "اینا همه یک وجود، عرض شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.2,
   "end": 280.24,
   "text": "یک نموداری از یک وجود واجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.24,
   "end": 284.86,
   "text": "واجب‌اند و همه می‌شه گفت مرآ-- صور مرآتی‌اند که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.86,
   "end": 289.8,
   "text": "حالا بحث ما چیه؟ میگم وقتی شما حتی نگاهت توحیدی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.8,
   "end": 294.36,
   "text": "اگر همه این‌ها رو نگاه کردی در این‌ها چی می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.36,
   "end": 298.14,
   "text": "خدا می‌بینی. چون نمودار خداند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.14,
   "end": 303.36,
   "text": "حتی آسمان رو دیدی فکر نمی‌کنی که حالا از این آسمان خدا ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.36,
   "end": 307.18,
   "text": "مثل اینکه نگاه تو آینه می‌کنی فکر نمی‌کنی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.18,
   "end": 312.42,
   "text": "فکرمو متمرکز کنم این عکسی که از خودم در این آینه می‌بینم آیا من است یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.42,
   "end": 314.48,
   "text": "نه، اصلاً توجه به آینه هم نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.48,
   "end": 317.02,
   "text": "توجه به عکس داخل آینه هم نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.02,
   "end": 320.12,
   "text": "به خودت توجه داری. خودت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.12,
   "end": 323.84,
   "text": "تو خدا می‌بینی. هر آنچه می‌بینی خدا می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.84,
   "end": 327.06,
   "text": "لذا امیرالمؤمنین علیه السلام قبلاً عرض کردیم فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.06,
   "end": 330.62,
   "text": "ما رأیت شیئاً هیچی رو ندیدم الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.62,
   "end": 334.32,
   "text": "رأیت. ما رأیت شیئاً الا رأیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.32,
   "end": 337.02,
   "text": "رأیت الله. مگر اینکه خدا رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.02,
   "end": 341.08,
   "text": "قبله و بعده و معه و فيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.08,
   "end": 345.78,
   "text": "قبل و بعد و همراه و در هر چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.78,
   "end": 352.52,
   "text": "من خدا دیدم. وقتی اینطوری دیدی عزیز دلم شما برای هر چ-- همه چیز حرمت قائلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.52,
   "end": 355.2,
   "text": "اگر چی باشی؟ موحد باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.2,
   "end": 357.4,
   "text": "این تا اینجا. اما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.4,
   "end": 360.12,
   "text": "قلب انسان دچار نفهمی شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.12,
   "end": 363.74,
   "text": "اینجا میگه وقتی بحث از توحید می‌کنی پشت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.74,
   "end": 365.82,
   "text": "با نفرت هم پشت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.82,
   "end": 371.18,
   "text": "کسی که توحید-- به توحید نرسیده است از کلمات وجودی هم بیزار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.18,
   "end": 374.8,
   "text": "از آسمان بیزاره. به آسمان و زمین فحش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.8,
   "end": 380.87,
   "text": "ببین به کجا می‌رسیم یهو به همه چی، به ذرات ذرات این کرات و آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.87,
   "end": 382.99,
   "text": "است-- میگه همه اینا بی خودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.99,
   "end": 384.85,
   "text": "استغفرالله. همه اینا باطلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.85,
   "end": 392.09,
   "text": "در حالی که یک موحد میگه \"ربنا ما خلقت هذا باطلا سبحانک فقنا عذاب النار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.09,
   "end": 398.85,
   "text": "توجه کردید؟ البته این‌ها نموداری‌اند که به سعه‌ی وجودی خودشون تجلی اسم خدا رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.85,
   "end": 401.31,
   "text": "بعضیاشون خب حد بیشتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.31,
   "end": 406.55,
   "text": "بیشترین حد رو انسان کامل دارد که مرتبه وجودیش از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.55,
   "end": 409.93,
   "text": "کلمات وجودی هستی بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.93,
   "end": 413.95,
   "text": "طوری که همه جمادات آرزوشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.95,
   "end": 415.87,
   "text": "خرج نباتات بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.87,
   "end": 420.21,
   "text": "نباتات آرزوشونه خرج حیوانات بشن، حیوانات آرزوشونه خرج چی بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.21,
   "end": 424.01,
   "text": "انسان. کمالشون در اینه. همه میخوان به انسان برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.01,
   "end": 426.69,
   "text": "انسان به کی میخواد برسه؟ به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.69,
   "end": 431.53,
   "text": "اگر تو به جایی رسیدی که اهل توحید شدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.53,
   "end": 434.13,
   "text": "انسان رو که دیدی کیف می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.13,
   "end": 436.11,
   "text": "انسان رو که دیدی خدا رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.11,
   "end": 439.77,
   "text": "لذت می‌بری با انسان‌ها، نه با حالت نفرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.77,
   "end": 446.49,
   "text": "لذا موسی بن جعفر می‌فرماید حتی اینو ببین ظرافت‌ها رو تو بحث اعتقادی د-- تو دلش بحث اخلاقی بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.49,
   "end": 449.67,
   "text": "آقا می‌فرماید اگر از محب به ما گناه دیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.67,
   "end": 452.77,
   "text": "مبادا از خودش بدت بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.77,
   "end": 454.85,
   "text": "از عملش بدت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.85,
   "end": 457.63,
   "text": "او فاسق العمل است فوقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.63,
   "end": 460.23,
   "text": "از خودش باید خودش خوشش، خوشت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.23,
   "end": 463.53,
   "text": "پس این کینه‌ها چیه؟ این دشمنی‌ها رمزش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.53,
   "end": 467.63,
   "text": "از کجا نشأت می‌گیره این زیر پا خالی کردن‌ها، آبرو بردن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.63,
   "end": 472.13,
   "text": "به قول ماها زیرآبی، زیر آب زدن‌ها اینا از کجا در میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.13,
   "end": 479.13,
   "text": "این توحید پیاده نشده. اگر توحید پیاده شد، تو مثل یک پدر با رفیقت رفتار می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.13,
   "end": 482.81,
   "text": "یک مدیر مثل یک پدر با زیردستش رفتار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.81,
   "end": 485.13,
   "text": "نه طوری رفتار کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.13,
   "end": 488.85,
   "text": "زیردستش جرات نداشته باشه یه کلام باهاش صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.85,
   "end": 493.07,
   "text": "این توحید پیاده نشده. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.07,
   "end": 501.59,
   "text": "این حدیثی که خدا رحمت کنه مرحوم آقای حائری شیرازی می‌فرمود و من دیدم که بعضیا این حدیثو شنیدن تعجب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.59,
   "end": 503.19,
   "text": "تعجب کردن باور نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.19,
   "end": 507.91,
   "text": "چون ما در خصوص امام حسین داریم \"من زار الحسین بکربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.91,
   "end": 510.15,
   "text": "کمن زارالله فی عرشه\" همه شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.15,
   "end": 513.89,
   "text": "در کامل الزيارات ابن قولویه آورده امام صادق علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 513.89,
   "end": 518.35,
   "text": "آقا جان حدیث داریم \"من زار أخاه المؤمن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.35,
   "end": 523.21,
   "text": "عجب! \"کمن زارالله فی عرشه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.21,
   "end": 527.43,
   "text": "الله اکبر. ببینید وقتی تو با توحید رفتی جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.43,
   "end": 530.69,
   "text": "می‌تونی برادر مؤمنت رو زیارت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.69,
   "end": 537.59,
   "text": "مثل قدیم‌ها که به قول آقای حائری می‌گفت مسافرت می‌رفتن از این شهرش به اون شهر که برادر مؤمن‌شون رو زیارت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.59,
   "end": 540.81,
   "text": "الان برادر مؤمن بغل دستشه زیر پاشو خالی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.81,
   "end": 545.83,
   "text": "آقا این چه توحیدیه؟ تهمت می‌زنه، فحش میده، کینه می‌ورزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.83,
   "end": 551.35,
   "text": "اصلاً منتظره، مترصده یه عیب، یه ایراد، یه خدشه‌ای از کارش بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.35,
   "end": 557.79,
   "text": "نگه داره برای روز مبادا که حدیث داریم اگر کسی این کارو بکنه از ولایت من خدا خروج کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.79,
   "end": 559.57,
   "text": "و تحت ولایت شیطان رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.57,
   "end": 563.07,
   "text": "الله اکبر. چقدر ما این کارا بلدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.07,
   "end": 566.59,
   "text": ". چقدر بلد نیستیم توجیه کنیم کارهای همدیگه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.59,
   "end": 571.95,
   "text": "سینه سپر می‌کنیم الا ولا but حق با من است تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.95,
   "end": 577.27,
   "text": ". میگه اگر تو برادر مؤمنت رو زیارت کنی کأنّ خدا رو زیارت کردی در عرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.27,
   "end": 585.75,
   "text": "آقا، او تجلی کامل، یک تجلی بیشتر از هر کلمه‌ی وجودی دیگری، یک بنده، یک برادر مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.75,
   "end": 587.41,
   "text": "تجلیگاه اسماء خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.41,
   "end": 591.29,
   "text": "اونم به نوعی بسم الله که قبلاً بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.29,
   "end": 597.15,
   "text": "وقتی اینطوری تو نگاه کردی خداوکیلی نگاهت به همه چی عوض نمی‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.15,
   "end": 600.71,
   "text": "عوض می‌شه یا نمی‌شه؟ اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.71,
   "end": 606.53,
   "text": "به هر حال البته اینو هم عرض کنم با یک ظرافتی دیگه وقت نیست خودتون برید دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.53,
   "end": 612.31,
   "text": "وقتی من دقت می‌کردم البته آره آقای-- حضرت آیت الله حائری شیرازی رحمت الله علیه اینو نگفته اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.31,
   "end": 615.05,
   "text": "یه حدیث امام رضا صلوات الله علیه داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.05,
   "end": 618.09,
   "text": "امام رو معرفی می‌کنه در اصول کافی برید نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.09,
   "end": 622.69,
   "text": "می‌فرماید \"الامام الأخ الشقيق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.69,
   "end": 625.21,
   "text": "امام برادر دوقلو توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.21,
   "end": 628.51,
   "text": "الله اکبر از این جمله. حالا اینو بذار کنار همین حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 628.51,
   "end": 630.43,
   "text": "اینجا می‌فرماید \"من زار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 630.43,
   "end": 632.95,
   "text": "أخاه المؤمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 632.95,
   "end": 636.75,
   "text": "پس می‌تونه وجه اتمش زیارت امام باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 636.75,
   "end": 638.29,
   "text": "چون میگه امام برادر دوقلو توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.29,
   "end": 644.59,
   "text": "اینجا می‌فرماید کسی بره زیارت برادر با ایمانیش \"کمن زارالله فی عرشه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 644.59,
   "end": 647.77,
   "text": "این هم هست. اما این وجه اتمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.77,
   "end": 657.01,
   "text": "وجه پایین‌ترش هم هست. اینکه تو به نیت خود به خاطر خدا صرفاً به خاطر خدا، نه نیات دنیوی و چیزهای اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.01,
   "end": 664.39,
   "text": "بری به دیدار برادر مؤمنت، خواهر مؤمنت \"کمن زارالله فی عرشه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 664.39,
   "end": 665.99,
   "text": "الله اکبر از این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 665.99,
   "end": 669.09,
   "text": "ببینید توحید چه بلایی سر انسان میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 669.09,
   "end": 672.03,
   "text": "همش میشه سوختن و سوختن و سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.03,
   "end": 675.35,
   "text": "غم اون میشه غم تو، غم برادرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.35,
   "end": 677.09,
   "text": "خب؟ شادیشم میشه شادی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 677.09,
   "end": 679.69,
   "text": "ان شا الله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 679.69,
   "end": 682.75,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 682.75,
   "end": 687.39,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.39,
   "end": 689.53,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}