   "start": 10.02,
   "end": 115.08
  },
  {
   "index": 1,
   "title": "## آیهٔ کهف؛ أکنّه بر قلوب و مدارج نفهمی",
   "start": 115.08,
   "end": 229.4
  },
  {
   "index": 2,
   "title": "## تحمل نکردن نور علی؛ ملکه و مقام",
   "start": 229.4,
   "end": 304.42
  },
  {
   "index": 3,
   "title": "## اسامی انسان از اعمال راسخ",
   "start": 304.42,
   "end": 533.01
  },
  {
   "index": 4,
   "title": "## پسر نوح؛ إنه عمل غیر صالح",
   "start": 533.01,
   "end": 658.49
  },
  {
   "index": 5,
   "title": "## توبه‌ناپذیری و گناه در مواطن مقدس",
   "start": 658.49,
   "end": 909.44
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 2.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.9,
   "end": 10.02,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.02,
   "end": 14.92,
   "text": "نذر می‌دونید یا مشروط است یا مطلق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.92,
   "end": 17.54,
   "text": "نذر مشروط خودش سه قسمه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.54,
   "end": 25.22,
   "text": "یا جهت شکر نعمت است یا جهت دفع بلاست یا جهت بازداشتن نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.22,
   "end": 27.8,
   "text": "از محرمات و مکروحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.8,
   "end": 30.76,
   "text": "یعنی چی؟ اگر بابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.76,
   "end": 33.64,
   "text": "همه اینا صحیحه ها. اگر بابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.64,
   "end": 40.24,
   "text": "شکر نعمت باشد نذر می‌کنی که مثلا اگر خداوند به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.24,
   "end": 43.34,
   "text": "فرزندی عطا کند این کار رو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.34,
   "end": 46.38,
   "text": "به شکرانه عطای خدا این کار رو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.38,
   "end": 49.8,
   "text": "این نذر مشروط است. یا جهت دفع بلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.8,
   "end": 53.18,
   "text": "اگر خدا پدرم را شفا دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.18,
   "end": 58.68,
   "text": "این کار را انجام می‌دهم. اگر خدا فلان بلا رو از من دفع کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.68,
   "end": 61.56,
   "text": "این هم درست است و مشروط است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.56,
   "end": 64.46,
   "text": "سومین شرط مشروط بازداشتن نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.46,
   "end": 66.56,
   "text": "اگر از من حرامی مرتک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.56,
   "end": 70.54,
   "text": "اِاِاِ سر بزند یا مکروهی حتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.54,
   "end": 73.36,
   "text": "مکروهی از من سر بزند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.36,
   "end": 76.8,
   "text": "من مثلا بین الطلوعین خوابیدن کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.8,
   "end": 82.7,
   "text": "من اگر بین الطلوعین خوابیدم نذر می‌کنم ان تمن صدقه بدم، روزه بگیرم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.7,
   "end": 86.64,
   "text": "اینم بی‌اشکال است. یکی از اقسام نذر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.64,
   "end": 88.9,
   "text": "اما نذر مطلق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.9,
   "end": 92.02,
   "text": "اینه که تو اصلا قیدی نداری، شرطی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.02,
   "end": 94.6,
   "text": "میگی لله-- لله علي فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.6,
   "end": 97.88,
   "text": "بر من بر، برای خداست بر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.88,
   "end": 101.98,
   "text": "که این روزه رو بگیرم، این مقدار صدقه بدم، این کارو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.98,
   "end": 106.12,
   "text": "تمام. دیگه شرطی نداری که اگر اون شرط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.12,
   "end": 112.1,
   "text": "انجام شد نذر شما ادا کردنش واجب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.1,
   "end": 121.2,
   "text": "این‌ها همه صحیح هست. خب ما هنوز در بحث قلب مکنون هستیم و فعلا رسیدیم به آیه پنجاه و هفت سوره کهف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.2,
   "end": 124.3,
   "text": "ببینید عزیزان امروز نکته دقیقی رو میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.3,
   "end": 129.24,
   "text": "که دیدم و الحمدالله فیض بردم و شنیدم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.24,
   "end": 131.18,
   "text": "بعض از عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.18,
   "end": 133.98,
   "text": "شاگردان خوب علامه حسن زاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.98,
   "end": 138.62,
   "text": "این نکته رو ده‌ها جلسه یک ساعته درباره‌ش بحث کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.62,
   "end": 142.68,
   "text": "حالا ما چجوری می‌خوایم تو هفت هشت ده دقیقه بگیم خدا کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.68,
   "end": 148.82,
   "text": "تو همین ابتدای آیه \"و من أظلم ممن ذکر بآیات ربه فأعرض عنها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.82,
   "end": 153.56,
   "text": "که میگه این‌ها چون اعراض از آیات و نشانه‌های ما می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.56,
   "end": 156.1,
   "text": "و قدیمشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.1,
   "end": 159.08,
   "text": "سابقه‌شون رو این‌ها رو فراموش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.08,
   "end": 163.86,
   "text": "\"وجعلنا على قلوبهم أکنه لا يفقهون\" ما یه کاری می‌کنیم اینا نفهمن حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.86,
   "end": 169.28,
   "text": "این نکته مهمه که ما بدانیم این مدرج است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.28,
   "end": 173.58,
   "text": "ببینید همونطور که مراتب ایمان درجه داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.58,
   "end": 178.7,
   "text": "مرا-مراتب کفر و نفاق و شرک و کلا گناه و معصیت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.7,
   "end": 187.08,
   "text": "محالك داره. یعنی احتمال داره یکی تو همین مراتب ابتدایی نفهمی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.08,
   "end": 192.88,
   "text": "خیلی چیزا رو می‌فهمه اما مطالب خیلی دقیق‌تر و ظریف‌تر رو نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.88,
   "end": 194.9,
   "text": "این هم باز می‌بینید آلودگی ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.9,
   "end": 196.6,
   "text": "اینجوری نیست که بگه چون من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.6,
   "end": 203.5,
   "text": "دارم خیلی چیزا رو می‌فهمم، درک و شعورم می‌رسه به خیلی چیزا، ولایت رو پذیرش کردم پس من مصداق این آیه نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.5,
   "end": 209.74,
   "text": "این غلطه. اتفاقا بزرگان اهل معرفت میگن حتی آیات عذابی قرآن رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.74,
   "end": 212.08,
   "text": "خطاب به خودتون بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.08,
   "end": 216.18,
   "text": "به خودمون. چون اینا محالك داره، مدارج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.18,
   "end": 218.86,
   "text": "و البته بعضیا هم نه، دیگه انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.86,
   "end": 223.96,
   "text": "درجه در این طی می‌کنند این محالك رو میرن دیگه به عمق قضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.96,
   "end": 227.2,
   "text": "یعنی دیگه مطلقا نمی‌فهمن هیچی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.2,
   "end": 229.4,
   "text": "اصلا اعراض کلی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.4,
   "end": 234.32,
   "text": "چگونه میشه که خدای نکرده انسان این هلكات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.32,
   "end": 241.26,
   "text": "این محالك رو یک یک طی می‌کنه تا به اونجا می‌رسه که مطلقا اعراض کرده و مطلقا نمی‌فهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.26,
   "end": 249.12,
   "text": "تا جایی که حدیث داریم وقتی امیرالمؤمنین و اهل بیت علیهم الصلاة والسلام میان از پل صراط رد شن جهنم خاموش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.12,
   "end": 252.52,
   "text": "میگن چه خبره؟ خدایا ما رو بخشیدی عذاب رو برداشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.52,
   "end": 255.58,
   "text": "میگن نه که مثلا امیرالمؤمنین داره گذر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.58,
   "end": 258.32,
   "text": "میگن نه خدایا عذاب رو به ما برگردون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.32,
   "end": 261.02,
   "text": "ما حاضریم عذاب رو به جان بخریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.02,
   "end": 263.1,
   "text": "ولی تحمل نور علی رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.1,
   "end": 265.18,
   "text": "اصلا تحمل این شخص رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.18,
   "end": 269.22,
   "text": "أستغفرالله. ببین دیگه چقدر به نفهمی فرو رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.22,
   "end": 273.7,
   "text": "به یه همچین حالتی اصطلاحا در فلسفه میگن ملکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.7,
   "end": 276.82,
   "text": "در عرفان میگن چی؟ مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.82,
   "end": 279.42,
   "text": "اینو خوب دقت کنید. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.42,
   "end": 281.62,
   "text": "مثال بزنم. شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.62,
   "end": 285.52,
   "text": "وقتی می‌افتید به حرکات عرضی، دستتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.52,
   "end": 289.18,
   "text": "حرکت عرضی می‌کنه، چشمتون حرکت عرضی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.18,
   "end": 292.62,
   "text": "به چی؟ به نوشتن. شروع می‌کنید به کتبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.62,
   "end": 297.66,
   "text": "می‌نویسید. یه روز، دو روز قلم رو برمی‌دارید، چشمتون می‌چرخه آن به آن، دستت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.66,
   "end": 300.72,
   "text": "حرکت می‌کنه از حرکت باز می‌ایسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.72,
   "end": 303.32,
   "text": "چشمت حرکت می‌کنه می‌ایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.32,
   "end": 305.74,
   "text": "این عرض این عمل تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.74,
   "end": 308.16,
   "text": "هی داری عملی رو انجام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.16,
   "end": 310.42,
   "text": "الف تمام. دال تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.42,
   "end": 312.7,
   "text": "ب هم همینطوری می‌کشی می‌نویسی تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.7,
   "end": 315.1,
   "text": "کلا تمام. قلم و دَباتو جمع می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.1,
   "end": 321.34,
   "text": "این حرکات عرضی که عمل ظاهری تو رو تشکیل میدن تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.34,
   "end": 325.3,
   "text": "اما در وجود تو، در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.3,
   "end": 327.6,
   "text": "درون و ما فی الضمیر تو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.6,
   "end": 337.04,
   "text": "صفتی رفته رفته ایجاد می‌شود نسبت به اینکه تو چه میزان مداومت در این کتبت به صورت ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.04,
   "end": 339.78,
   "text": "انجام داده باشی یک صفتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.78,
   "end": 344.5,
   "text": "وجود تو ایجاد می‌شود به نام صفت کتبت، نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.5,
   "end": 348.84,
   "text": "از چی ایجاد میشه؟ از اون همون حرکات عرضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.84,
   "end": 352.06,
   "text": "اصطلاحا بهش میگیم به عملی که داری انجام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.06,
   "end": 358.84,
   "text": "اگر این تمرین، هی نوشتن، هی غلط نوشتن، درست کردن، هی تمرین، ممارست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.84,
   "end": 364.0,
   "text": "ادامه پیدا نکنه، بعد یه مدت این صفتی که حالا یه مقدار در وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.0,
   "end": 371.07,
   "text": "رسوخ کرده این دیگه از بین میره و اصلا کلا دیگه تو دوباره از اول باید شروع کنی به نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.07,
   "end": 377.75,
   "text": "اما نه اگر انقدر این کتابت رو ادامه بدی، تمرین کنی، انقدر بنویسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.75,
   "end": 383.61,
   "text": "تا دیگه اصطلاحاً در علم فلسفه بهش میگن راسخ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.61,
   "end": 386.35,
   "text": "راسخ بشه در وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.35,
   "end": 388.43,
   "text": "این صفت کتابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.43,
   "end": 392.33,
   "text": "خب. بعد چگونه میشه فهمید که راسخ شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.33,
   "end": 396.15,
   "text": "یعنی تو اصلاً ده سال بعدم دیگه اصلاً دست از عمل کشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.15,
   "end": 401.01,
   "text": "ده سال بعد یهو به تو گفتن آقا می‌نوشتی بله مثل روز اول بنویسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.01,
   "end": 406.15,
   "text": "مثل همون، مثل اون روزی که دیگه ترک کردی، مثل اون روزی که ترک کردی دیگه ننوشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.15,
   "end": 409.57,
   "text": "به اون عالی می‌نوشتی مثل همون بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.57,
   "end": 414.41,
   "text": "یه کتابی رو خوندی کیف کردی تا عمق مافالضمیرت اثر کرده بعد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.41,
   "end": 416.01,
   "text": "ذهنت منصرف میشه ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.01,
   "end": 422.89,
   "text": "چند وقت بعد یکی ازت می‌پرسه اون ح-- اون حقیقتی که از کتاب درک کردی رو بگو ببینم دوباره بس بلبل براش میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.89,
   "end": 426.97,
   "text": "چرا دوباره میگی؟ چون این راسخ شده در وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.97,
   "end": 429.43,
   "text": "به چنین حالتی میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.43,
   "end": 432.85,
   "text": "ملکه یا در عرفان مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.85,
   "end": 436.71,
   "text": "قبل از اینکه قابل زایل شدن بود که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.71,
   "end": 444.19,
   "text": "تو تمرینت رو رها می‌کردی دوباره باید از اول شروع می‌کردی و همه چی رو یادت رفته بود بهش می‌گفتن حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.19,
   "end": 447.51,
   "text": "حال. وقتی کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.51,
   "end": 450.71,
   "text": "این عملیات، عمل ارضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.71,
   "end": 454.13,
   "text": "عملی که انجام میده با همین اعضا و جواره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.13,
   "end": 457.81,
   "text": "چه تو بحث حالا میگه تو رونده‌ای، ماشی هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.81,
   "end": 462.35,
   "text": "خن-- می‌خندی، ضاحکی، گریه می‌کنی، باکی هستی، می‌نویسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.35,
   "end": 468.83,
   "text": "کاتبی. نمی‌دونم از جهت اینکه عقل داری و اینق-- عقلت رو دائم داری بروز میدی عاقلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.83,
   "end": 472.15,
   "text": "از جهت اینکه همین حقایق کلی که عقل ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.15,
   "end": 475.55,
   "text": "درک می‌کند و می‌تونی جزئی‌سازی کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.55,
   "end": 478.55,
   "text": "متوهمی. از جهت اینکه می‌تونی اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.55,
   "end": 484.31,
   "text": "صورت‌پردازی بهش بکنی، مادرتو می‌شناسی، پدرتو می‌شناسی، رفیقاتو می‌شناسی، متخیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.31,
   "end": 490.59,
   "text": "عالم خیال داری. از جهت اینکه تو می‌تونی این‌ها رو همه‌ی این مفروضات و این عکس‌ها و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.59,
   "end": 496.63,
   "text": "پردازش‌ها، اینایی که تو ذهنت داره اتفاق می‌افته اینا رو سان بدی همه رو ببینی حاضر کنی در وجودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.63,
   "end": 498.99,
   "text": "تو مق-- به مقام قلبت رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.99,
   "end": 504.09,
   "text": "از جهت اینکه در آن واحد که در همون حال که تمام این مفروضات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.09,
   "end": 506.43,
   "text": "و اطلاعات در درونت وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.43,
   "end": 514.01,
   "text": "اما یه حالت استکان و سکون داری و اصلا توجه به هیچ کدوم از این مسائل هم نداری، تو مقام روحت هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.01,
   "end": 518.63,
   "text": "ببین این‌ها در حقیقت اسامی مختلف در تو هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.63,
   "end": 522.19,
   "text": "تو یک وجودی، یک منی، اسم‌های متعدد داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.19,
   "end": 524.37,
   "text": "چرا این اسامی در بر تو بار شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.37,
   "end": 530.79,
   "text": "نسبت به اون اعمالی که از تو بروز کرده و راسخ شده در جانت و در نفست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.79,
   "end": 534.55,
   "text": "این خلاصه مطلب. حالا اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.55,
   "end": 536.61,
   "text": "به حدی یک عملی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.61,
   "end": 541.39,
   "text": "ادامه بده که راسخ بشه، ملکه وجودیش بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.39,
   "end": 545.97,
   "text": "اون حالت ملکه، ملکه شدن یه چیزی در عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.97,
   "end": 551.25,
   "text": "اون منظور و غایت نهایی این آیه نسبت به مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.25,
   "end": 553.45,
   "text": "از نظر نفهمی قلب انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.45,
   "end": 558.07,
   "text": "یعنی اگر کسی دائم به آیات خدا پشت کنه \"فأعرض عنها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.07,
   "end": 563.81,
   "text": "به هر آیه‌ای، هر نشانه‌ای از خدا پشت کنه تا جایی که به زمین و زمان فحش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.81,
   "end": 566.81,
   "text": "این چه آسمونیه، این چه زمینیه، این چه روزگاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.81,
   "end": 570.17,
   "text": "ای روزگار از دست روزگار فحش، دری وری به همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.17,
   "end": 572.13,
   "text": "اصلاً با همه، با خودش هم دعوا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.13,
   "end": 573.97,
   "text": "اصلاً چرا منو خلق کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.97,
   "end": 583.27,
   "text": "چنین کسی دیگه به حد نهایت اعراض رسیده و لذا هلكات رو چنان رفته جلو راسخ شده ملکه وجودیش شده نفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 583.27,
   "end": 586.69,
   "text": "هیچی نمی‌فهمه. مثالش مثل کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.69,
   "end": 589.35,
   "text": "مصداقی که قرآن میگه کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.35,
   "end": 595.73,
   "text": "سوره نوح که وقتی حضرت نوح به خدا میگه خدایا پسرم رو نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.73,
   "end": 600.07,
   "text": "حالا من شماره آیه اش هم نوشتم اینجا اگر خواستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.07,
   "end": 602.77,
   "text": "بله آیه چهل و شش سوره هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.77,
   "end": 607.85,
   "text": "\"قال یا نوح إنه ليس من أهلك\" وقتی حضرت نوح گفت خدایا پسرمو نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.85,
   "end": 611.25,
   "text": "ببینید عبارت رو خوب دقت کنید با توجه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.25,
   "end": 613.27,
   "text": "زمینه خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.27,
   "end": 618.61,
   "text": "\"قال یا نوح\" خدا گفت ای نوح \"إنه ليس من أهلك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.61,
   "end": 621.55,
   "text": "این اهل تو نیست. حالا اهل رو توضیح بده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.55,
   "end": 625.55,
   "text": "\"إنه عمل غير صالح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.55,
   "end": 628.85,
   "text": "عجب. میگه، نمیگه این آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.85,
   "end": 632.89,
   "text": "ناسالحه. میگه عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.89,
   "end": 636.43,
   "text": "چرا خدا اینجا به پسر نوح میگه عمل غیر صالح؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 636.43,
   "end": 642.89,
   "text": "یعنی انقدر ناسالحی انجام داده، انقدر عم-- اعمال غیر صالح انجام داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 642.89,
   "end": 645.69,
   "text": "رسوخ کرده در جانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.69,
   "end": 648.65,
   "text": "اصلاً اتحاد وجودی با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.65,
   "end": 650.71,
   "text": "زشتی‌ها برقرار کرده وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.71,
   "end": 653.11,
   "text": "اصلاً شده عین عمل غیر صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.11,
   "end": 656.01,
   "text": "لذا قرآن از-- مؤمن هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.01,
   "end": 659.89,
   "text": "مؤمن هم انقدر اعمال صالح انجام میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.89,
   "end": 662.57,
   "text": "که میگه در سوره اسرا داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.57,
   "end": 664.63,
   "text": "\"قل كل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 664.63,
   "end": 666.89,
   "text": "يعمل على شاکلته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.89,
   "end": 670.35,
   "text": "همه بر اساس شاکله وجودیشون عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.35,
   "end": 674.69,
   "text": "اگر این شاکله درست بود، درست عمل می‌کنن، نادرست بود، نادرست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 674.69,
   "end": 682.75,
   "text": "لذا اینکه تو چه کارهایی رو هر روز داری تمرین می‌کنی و مبارزت می‌کنی که اون رسوخ کنه در نفس تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.75,
   "end": 685.17,
   "text": "این خیلی مهمه. بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.17,
   "end": 692.11,
   "text": "ببخشید چون همه بچه هیئتی هستیم و مسجدی هستیم و بالاخره ریش و تسبیح و بذارید یه ذره راحت‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.11,
   "end": 694.55,
   "text": "بعضیا حتی تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.55,
   "end": 696.47,
   "text": "معنویت هم میان گناه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.47,
   "end": 700.67,
   "text": "اصلا یه حدیث عجیبی بذارین تا حالا که اینطور شد یه دقیقه دیگه به من وقت بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 700.67,
   "end": 705.71,
   "text": "یه حدیث عجیبی مرحوم نراقی تو کتاب معراج السعاده‌ش داره میگه بعضیا-- حدیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 705.71,
   "end": 708.71,
   "text": "بعضیا توبه‌ش، توبه ندارن اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 708.71,
   "end": 710.83,
   "text": "شنیده بودید تا حالا اصلا بعضیا توبه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.83,
   "end": 716.11,
   "text": "درب توبه به روی همه بازه که. بعد حضرت می‌فرمایند چون تا توبه می‌کنند به یه گناه جدید می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.11,
   "end": 719.59,
   "text": "اصلا رسوخ کرده این عمل غیر صالح تو وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.59,
   "end": 722.79,
   "text": "اعراض از نعمت‌ها. نفهم شده اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.79,
   "end": 725.43,
   "text": "از این گناه-- لذا پا میشه میره کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.43,
   "end": 728.57,
   "text": "کربلا هم گناه می‌کنه. اونجا چه گناهی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.57,
   "end": 730.61,
   "text": "فحش میده، دری-- اصلا عادت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 730.61,
   "end": 733.1,
   "text": "نمی‌تونه. نمی‌تونه اونجا هم ذکر بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 733.1,
   "end": 736.94,
   "text": "من خیلی دیدم تو کربلا دعوا بزن بزن اهل ایمان با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 736.94,
   "end": 739.18,
   "text": "فحش و در وری. این چه غذاییه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 739.18,
   "end": 743.92,
   "text": "تو پول ما رو خوردی تو کرب-- تو خود حرم امام حسین بزن بزن دیدم بین دو تا بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 743.92,
   "end": 746.06,
   "text": "اومدن دو تا ظاهر امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 746.06,
   "end": 748.44,
   "text": "اصلا تو نمی‌تونی توبه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 748.44,
   "end": 750.7,
   "text": "نمی‌تونی. به ذکر مطلق رسیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 750.7,
   "end": 753.22,
   "text": "به حقیقت ذکر رسیدی اعراض می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 753.22,
   "end": 757.12,
   "text": "اصلا بعضیا تو هیئت به گ-- اصلا میرن هیئت که گناه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 757.12,
   "end": 760.12,
   "text": "معذرت می‌خوام بعضیا اصلا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 760.12,
   "end": 763.52,
   "text": "مسجد. حالا استاد ما این مثال رو می‌زد انشاالله درکش رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 763.52,
   "end": 766.6,
   "text": "می‌گفت این پیر، بعضی از این پیرمردهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.6,
   "end": 769.86,
   "text": "نمی‌دونم کلاه عرقچین به سر، بترسید از اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.86,
   "end": 774.3,
   "text": "که اصلا سر قفلی صفحه اولو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 774.3,
   "end": 777.0,
   "text": "مثل اینکه ما رفتیم چند شب پیش یه مسجدی نماز بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 777.0,
   "end": 779.26,
   "text": "یه پیرمرد بعد ن-- شب جمعه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.26,
   "end": 781.2,
   "text": "آقا چقدر اینا نماز خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.2,
   "end": 785.1,
   "text": "نماز لیلةالدفن، نماز قفیله، آخ پدر ملت رو در آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 785.1,
   "end": 789.78,
   "text": "بعد یه پیرمرد ظاهرشم نورانی بود اومد به من گلایه کرد بعد نماز گفت حاج آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.78,
   "end": 791.78,
   "text": "شما مهمان مایی ولی یه خطایی که...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.78,
   "end": 794.4,
   "text": "بفرمایید چی شده؟ چی، چه خطایی عمو سرزاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 794.4,
   "end": 796.84,
   "text": "گفت چرا نماز والدینو نخوندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 796.84,
   "end": 800.58,
   "text": "گفتم عزیزم نماز والدینو تو خونه مردم بخونن مگه گیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 800.58,
   "end": 804.04,
   "text": "حالا پیرمرد دیگه بیکاره معذرت می‌خوام بعد نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 804.04,
   "end": 808.78,
   "text": "گفت ببینید حاج آقا این نماز قفیله‌ رو من تو این مسجد باب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 808.78,
   "end": 810.86,
   "text": "این من، من گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 810.86,
   "end": 814.94,
   "text": "آخه این چه، این چه عبادتیه که تورو به من، من میندازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 814.94,
   "end": 819.26,
   "text": "خدا حفظ کنه آقای قراحتری یه مثال هم بزنیم حالا شیرین بشه ذائقه تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 819.26,
   "end": 821.76,
   "text": "میگن بعضیا جاهای مقدس هم میرن گناه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 821.76,
   "end": 824.94,
   "text": "حالا شاید این پیش نیومده مثال به هر حال آقای قراحتری می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 824.94,
   "end": 830.4,
   "text": "یه آخوندی بالا منبر داشت صحبت می‌کرد زیر منبرش دید، دیدی زیر منبر یه جای خالی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 830.4,
   "end": 833.56,
   "text": "دید زیر منبر تق و توق صدا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 833.56,
   "end": 837.34,
   "text": "یه نگاه کرد دید یه دختر و پسری اون زیر دارن با هم شوخی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 837.34,
   "end": 842.38,
   "text": "حالا سوال سوال نکن. چه وقتی هم بهشون تشریف آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 842.38,
   "end": 846.54,
   "text": ". دید این دختر و پسره دارن زیر منبر با هم شوخی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 846.54,
   "end": 849.42,
   "text": "بعد این بنده خدا هم خب حفظ آبرو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 849.42,
   "end": 851.94,
   "text": "شروع کرد مثلا با کنایه پشت بلندگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 851.94,
   "end": 854.16,
   "text": "آی مردم مگر غیرت ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 854.16,
   "end": 857.12,
   "text": "مگر دین ندارید؟ مگر شرف ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 857.12,
   "end": 862.32,
   "text": "این پسره سرشو از زیر منبر آورد بیرون گفت همه اینا رو داریم، جا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 862.32,
   "end": 866.84,
   "text": "بعضیا دنبال جان برای گناه کردن میرن حتی تو جاهای مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 866.84,
   "end": 871.92,
   "text": "چرا؟ برای اینکه ملکه‌ای که تو وجودشون ایجاد شده چیز دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 871.92,
   "end": 876.4,
   "text": "میاد تو لباس آخوندی، میاد تو لباس حزب‌اللهیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 876.4,
   "end": 880.08,
   "text": "مثل بز، مثل گرگی که اومده تو لباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 880.08,
   "end": 882.9,
   "text": "میش و بز و بره و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 882.9,
   "end": 888.44,
   "text": "میاد تو لباس معنویت و تقوی خودشو ولی ملکه وجودش خباثته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 888.44,
   "end": 890.16,
   "text": "اینا خیلی، اینارو بهشون میگن کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 890.16,
   "end": 892.12,
   "text": "اینا نفهم‌ن. اینا قلب منافقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 892.12,
   "end": 895.16,
   "text": "اینا مشرکن اینا. خدا همه ما رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 895.16,
   "end": 898.44,
   "text": "این بحث خیلی داره داغ میشه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 898.44,
   "end": 903.54,
   "text": ". خدا، خدا عاقبت ما رو به خیر کنه انشاالله به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 903.54,
   "end": 909.44,
