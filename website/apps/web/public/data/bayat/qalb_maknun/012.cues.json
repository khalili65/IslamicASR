 "chapters": [
  {
   "index": 0,
   "title": "## نذرِ مشروط و صدقهٔ پیش از تحققِ شرط",
   "start": 0.16,
   "end": 30.32
  },
  {
   "index": 1,
   "title": "## ستمِ اعراض از آیات و مرگ به مثابهٔ آیه",
   "start": 30.32,
   "end": 212.52
  },
  {
   "index": 2,
   "title": "## خواب، تعبیر، و خودشناسی",
   "start": 212.52,
   "end": 387.96
  },
  {
   "index": 3,
   "title": "## چشم دریچهٔ قلب و بیداریِ حاج قاسم",
   "start": 387.96,
   "end": 755.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 2.18,
   "text": "بسم الله الرحمن الرحیم و به او نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.18,
   "end": 5.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.66,
   "end": 11.58,
   "text": "آیاته السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.58,
   "end": 14.98,
   "text": "عزیزان این نکته پیرامون نذر رو خیلی دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.98,
   "end": 16.94,
   "text": "خیلیا این رو نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.94,
   "end": 19.96,
   "text": "اون هم این هستش که اگر شما نذر کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.96,
   "end": 22.64,
   "text": "مثلاً مریضی‌تون خوب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.64,
   "end": 25.56,
   "text": "این مقدار صدقه بدید. دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.56,
   "end": 28.32,
   "text": "نذر می‌کنید مریضی‌تون خوب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.32,
   "end": 33.6,
   "text": "انتمان صدقه میدید. قبل از اینکه مریضی‌تون خوب بشه صدقه رو رد می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 33.6,
   "end": 36.7,
   "text": "بعضیا این‌طوری‌ان، کریمانه انجام میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 36.7,
   "end": 39.56,
   "text": "آیا وقتی مریضی‌ت خوب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 39.56,
   "end": 43.9,
   "text": "اون صدقه قبل از خوب شدن مریض کفایت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.9,
   "end": 49.08,
   "text": "قبل از اینکه مریضی‌ت خوب شد صدقه دادی به همون میزانی که نذر کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.08,
   "end": 53.68,
   "text": "آیا کفایت می‌کنه یا مریضی‌ت خوب شد دوباره باید بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.68,
   "end": 59.46,
   "text": "حکم رهبری این هستش که اون صدقه قبل از مریضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.46,
   "end": 63.28,
   "text": "قبل از خوب شدن کفایت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.28,
   "end": 68.02,
   "text": "حواستون جمع باشه. مثلا شما نذر می‌کنی پنج شنبه روزه بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.02,
   "end": 71.5,
   "text": "حالا چهارشنبه می‌گیری یا جمعه می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.5,
   "end": 74.54,
   "text": "قبل و بعدش می‌گیری. نه ادا نشده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.54,
   "end": 78.4,
   "text": "شما نذر کردی که مریضی‌ت خوب شد صدقه میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.4,
   "end": 83.08,
   "text": "خب الان که خوب نشده که. حالا دادی، کریمانه هم رفتار کردی دستت هم درد نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.08,
   "end": 85.3,
   "text": "به قول بچه های نظام آباد دمت هم گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.3,
   "end": 87.38,
   "text": "اما الان که تازه الان خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.38,
   "end": 91.8,
   "text": "خب الان خوب شد تو هم نذرت این بود خوب شد اد-ادا کنی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.8,
   "end": 95.0,
   "text": "خب الان گردنته. اینا حواسمون جمع باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.0,
   "end": 98.7,
   "text": "خیلی اینو رعایت نمی‌کنیم. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.7,
   "end": 102.36,
   "text": "دقت کنید به آیه نکته جدیدی رو ازش استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 102.36,
   "end": 107.48,
   "text": "اگر الی يوم القيامة پای همین یه آیه بنشینیم حرف توش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.48,
   "end": 110.52,
   "text": "خب کو گوش شنوا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.52,
   "end": 116.64,
   "text": "کو گوش شنوا؟ به شما جسارت نشه ها از جهت عظمت این، به خودمم میگم، عظمت این آیات میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.64,
   "end": 120.48,
   "text": "انقدر درون مایه دارن این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.48,
   "end": 127.14,
   "text": "که در آیه پنجاه و هفت کهف می‌فرماید \"و من أظلم ممن ذكر بآيات ربه فأعرض عنها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.14,
   "end": 133.98,
   "text": "چه کسی ستمکارتر از اون کسی‌ست که وقتی ذکر آیات می‌شه \"فأعرض عنها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.98,
   "end": 136.78,
   "text": "پشت می‌کنه بهش که نتیجه‌ش می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.78,
   "end": 140.94,
   "text": "این که ما پرده‌ای می‌ندازیم به قلبش حقایق رو نفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.94,
   "end": 144.4,
   "text": "صاحب قلب نفهم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.4,
   "end": 148.24,
   "text": "یکی از آیات الهی مرگ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.24,
   "end": 151.58,
   "text": "یکی از آیات الهی چیه؟ مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.58,
   "end": 155.0,
   "text": "این که ما قراره هممون بمیریم یکی از آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.0,
   "end": 165.58,
   "text": "خداست. جالبه که در حدیثی که من دو تا سند براش رو کنم یکی مجموعه وررام ابن ابی فراسه که از پیغمبر نقل کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.58,
   "end": 168.8,
   "text": "یکی هم کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.8,
   "end": 172.64,
   "text": "مرحوم شریح-شریف الرضیه به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.64,
   "end": 178.14,
   "text": "خصائص الأئمه که از امیرالمؤمنین علیه الصلاة والسلام این حدیث رو نقل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.14,
   "end": 183.72,
   "text": "که می‌فرماید الناس نیامون مردم همه خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.72,
   "end": 188.12,
   "text": "الناس، الف و لام هم آورده یعنی همه، همه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.12,
   "end": 193.88,
   "text": "نیامون خوابن حتی خود شما الان حضرت جناب عالی حضرت عالی الان خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.88,
   "end": 196.36,
   "text": "یعنی چی خوابید؟ الان عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.36,
   "end": 198.06,
   "text": "فإذا ماتوا انتبهوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.06,
   "end": 200.54,
   "text": "ببینید وقتی مردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.54,
   "end": 203.58,
   "text": "چی می‌شن؟ بیدار می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.58,
   "end": 206.9,
   "text": "آدم وقتی خوابه چیکار می‌کنه تو عالم خواب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.9,
   "end": 210.58,
   "text": "خواب می‌بینه اصطلاحا. یه چیزایی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.58,
   "end": 212.52,
   "text": "وقتی بیدار شد باید چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.52,
   "end": 217.88,
   "text": "علامه سنگزاده حفظه الله تعالی می‌فرمود یکی از بهترین راه‌های خودشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.88,
   "end": 222.64,
   "text": "توجه به خوابته. که این بحثش قبلا چند جلسه گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.64,
   "end": 225.72,
   "text": "که چگونه خواب دیدی؟ چه خواب‌هایی دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.72,
   "end": 231.5,
   "text": "تمثلات که در خواب دیدی مثل امام صادق صلوات الله علیه فرموده آنچه که پیرامون شماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.5,
   "end": 235.38,
   "text": "مخصوصا حیوانات، تمثلات درونی شمااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.38,
   "end": 239.42,
   "text": "تو اینکه صبح پیغمبر می‌اومد دم اذان صبح نمی‌ذاشت ظهر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.42,
   "end": 241.38,
   "text": "می‌فرمود حل مبشرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.38,
   "end": 243.76,
   "text": "کی بشارت داره به من بگه؟ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.76,
   "end": 246.76,
   "text": "حالا دیشب تا همه خواب بودن تا صبح که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.76,
   "end": 248.94,
   "text": "منظور این بود که چه خوابی دیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.94,
   "end": 252.64,
   "text": "الان یکی بگه من این خوابو دیدم میگن خواب آلوئه، آدم خواب آلوئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 252.64,
   "end": 256.44,
   "text": "آقای جوادی آملی می‌فرمود من اصلاً نمی‌خوابم که خواب ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.44,
   "end": 259.04,
   "text": "اصلاً دنبال چیه؟ دنبال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.04,
   "end": 260.9,
   "text": "دنبال تعبیر خوابشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.9,
   "end": 263.96,
   "text": "یک علم الهی‌ست. تعبیر خواب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.96,
   "end": 266.48,
   "text": "از خواب به راحتی کنار نکشید کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.48,
   "end": 271.8,
   "text": "اینجوری نباشه حالا یه خوابی دیدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.8,
   "end": 276.64,
   "text": "که یکی از بزرگان در نجف قبل از شهادت سردار سلیمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.64,
   "end": 279.76,
   "text": "خواب دیده بود که رئیس جمهور فعلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.76,
   "end": 283.76,
   "text": "رو مردم کنار گذاشتن سردار سلیمانی به دولت نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.76,
   "end": 286.96,
   "text": "به دولت جمهوری اسلامی نجف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.96,
   "end": 290.42,
   "text": "تکیه کرده. یعنی ایشون دو-دولت مرد ما شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.42,
   "end": 295.56,
   "text": "براش تعجب‌آور بود که بعد حالا الحمد لله این قصه رخ داد که ها-کاملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.56,
   "end": 299.98,
   "text": "مشخصه دیگه. اصلا این خواب تعبیرش بروز پیدا کرد به زودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.98,
   "end": 302.7,
   "text": "البته بعضی جان‌ها قوی هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.7,
   "end": 306.76,
   "text": "خوابی که می‌بینن مال چهل سال بعده، مال بیست سال بعده، مال ده سال بعده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.76,
   "end": 311.56,
   "text": "بعضی خواب‌ها ضعیفن، جانشون، جانشون، صاحب خواب جانش ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.56,
   "end": 314.26,
   "text": "خواب فردا رو می‌بینه، خواب پس فردا رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.26,
   "end": 318.52,
   "text": "زیاد هم برام پیش اومده. اما همه دنبال تعبیر خوابشون باید باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.52,
   "end": 322.04,
   "text": "حالا میگه شما همین الان، اصلا اونو ولش کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.04,
   "end": 324.84,
   "text": "اون یک نشانه است. آنچه که آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.84,
   "end": 330.54,
   "text": "است، اون مرگه که تو رو از این خوابی که الان درشی بیدار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.54,
   "end": 336.36,
   "text": "در حقیقت آنچه که بعد از این، بعد از مرگ برای ما اتفاق می‌افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.36,
   "end": 338.78,
   "text": "تعبیر این خوابمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.78,
   "end": 343.76,
   "text": "همه عمر خواب بودی. آنچه الان داری می‌بینی خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.76,
   "end": 347.18,
   "text": "بعد از مرگ تعبیرش رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.18,
   "end": 349.62,
   "text": "همین نمازی که الان خوندید یه نوع خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.62,
   "end": 351.82,
   "text": "خب ب-طبق فرمایش پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.82,
   "end": 355.86,
   "text": "حالا اینجا داره چکش کاری بشه کلی حرف بزنیم و حرف بشنویم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.86,
   "end": 358.88,
   "text": "حالا دیگه خودتون بدونید فرصت که ما نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.88,
   "end": 362.0,
   "text": "ولی خیلی حرف اینجا، خیلی درون مایه داره این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.0,
   "end": 366.04,
   "text": "الان ما خوابیم. تعبیر اینچه که می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.04,
   "end": 372.28,
   "text": "اون ور معلوم میشه. البته امیرالمؤمنین علیه الصلاة والسلام فرموده که \"من نگاهت می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.28,
   "end": 376.42,
   "text": "چشمات\" یه روایت میگه \"از پیشونیت می‌فهمم چه خبره.\" این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.42,
   "end": 378.42,
   "text": "یعنی تعبیر خوابت رو می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.42,
   "end": 383.24,
   "text": "این فرمایش مولا یعنی. یعنی الان تو اونچه که داری الان خواب می‌بینی رو تعبیرش رو می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.24,
   "end": 385.38,
   "text": "یعنی اونورتو می‌دونم چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 385.38,
   "end": 387.96,
   "text": "تعبیر اونور اتفاق میفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.96,
   "end": 390.96,
   "text": "خدا رحمت کنه مرحوم آیت الله حائری شیرازی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 390.96,
   "end": 393.52,
   "text": "یه جمله در رابطه با مرحوم حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.52,
   "end": 395.82,
   "text": "شهید سلیمانی داره خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.82,
   "end": 399.5,
   "text": "آسمونیه این جمله و هر کسی نمی‌تونه این حرفا رو بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 399.5,
   "end": 402.7,
   "text": "ما فوقش می‌تونیم بگیم چه چشمای خوشگلی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.7,
   "end": 405.48,
   "text": "آقای حائری می‌گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.48,
   "end": 412.58,
   "text": "چشم، تو رو خدا دقت کنید، عبارتش رو دقت کنید که ترجمه یک حدیث است البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.58,
   "end": 415.92,
   "text": "چشم دریچه قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.92,
   "end": 421.06,
   "text": "شما وقتی دریچه یه جایی رو باز می‌کنی معلوم میشه توش چه خبره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.06,
   "end": 425.76,
   "text": "ها؟ نوره، ظلمته، تاریکه، روشنه، بوی خوب میاد ب-- چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.76,
   "end": 432.0,
   "text": "میگه چشم دریچ-- مرحوم آقای شیرازی داره میگه که البته ترجمان یک حدیث از امام علیه الصلاة والسلام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.0,
   "end": 434.4,
   "text": "\"چشم دریچه قلب است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.4,
   "end": 437.7,
   "text": "و بلافاصله ایشون می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.7,
   "end": 443.4,
   "text": "حاج قاسم سلیمانی چه چشم الهی و آسمانی‌ای دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.4,
   "end": 445.94,
   "text": "الهی و آسمانی. اونا می‌فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 445.94,
   "end": 451.28,
   "text": "این یعنی چی؟ یعنی عجب تعبیری داره این خواب‌هایی که حاج قاسم داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 451.28,
   "end": 456.68,
   "text": "اونور چه تعبیری داره که ما رو همه رو بیدار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 456.68,
   "end": 461.36,
   "text": "این خواب‌هایی که حاج قاسم دید همه ما رو بیدار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.36,
   "end": 466.88,
   "text": "در هر حال دیگه کسی وسط صحبت من یهو تختی کنه، سوئیچ کنه بیاد حرف منو بشناسه گیج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.88,
   "end": 471.5,
   "text": "باید از اول گوش بده. یعنی چی؟ خواب قاسم سلیمانی ما رو از خواب بیدار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.5,
   "end": 473.94,
   "text": "این حرفا چیه؟ تعبیرش این حرف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.94,
   "end": 477.5,
   "text": "باید خوب حرف رو شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.5,
   "end": 484.66,
   "text": "یکی از آیات الهی مرگ اگر ما بدونیم‌ها، می‌گیم عجب چه خوابی بود، چه خواب شیرینی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.66,
   "end": 487.32,
   "text": "اگر انشاالله اهل ولایت بوده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.32,
   "end": 491.4,
   "text": "اگر خدای نکرده نبوده باشی میگی عجب خواب تلخی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.4,
   "end": 497.62,
   "text": "و شما بگید اگر خواب تلخ باشه برات میگی خدارو شکر که بیدارم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.62,
   "end": 505.92,
   "text": "درسته؟ برای همین حتی مرگ برای کفار و مشرکین و منافقین هم رحمت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.92,
   "end": 509.36,
   "text": ". و برای خوبان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.36,
   "end": 512.6,
   "text": "چیه؟ باز رحمته چون به تعبیرش می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.6,
   "end": 516.72,
   "text": "به اصلش می‌رسن. اینجا همه یه سایه‌ای از اون اصل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.72,
   "end": 519.54,
   "text": "اصل اونوره. اصلاً اینجا خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.54,
   "end": 522.26,
   "text": "اینه که امثال سردار سلیمانی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.26,
   "end": 526.66,
   "text": "وقتی می‌خواد سه چهار ساعت مونده به شهادتش میره روی کاغذ می‌نویسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.66,
   "end": 529.34,
   "text": "\"خدایا دوست دارم ببینمت.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.34,
   "end": 532.54,
   "text": "ببین این یعنی چی. می‌خوام ببینمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.54,
   "end": 535.38,
   "text": "بعد قبلاً هم نیت کرده بوده مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.38,
   "end": 538.34,
   "text": "شهید مغنیه، عماد مغنیه شهید شه همون طوری هم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 538.34,
   "end": 542.0,
   "text": "تو ماشین هم می‌زننش. ایناها همش رمز و رموزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.0,
   "end": 545.12,
   "text": "یعنی خودش تعبیر خواب خودش رو بلده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 545.12,
   "end": 546.74,
   "text": "دقت بفرمایید چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.74,
   "end": 549.38,
   "text": "با چه نگاهی داریم می‌بینیم از تو آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.38,
   "end": 554.28,
   "text": "به چه حقایقی داریم می‌رسیم. حالا شما ببینید درون مایه این آیات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.28,
   "end": 560.58,
   "text": "و البته راهی هست که تو همین عالم با تعبیر خوابمون رو دسترسی پیداش پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 560.58,
   "end": 568.04,
   "text": "بکنیم. این رو هم بگم والا حرفا که خیلی دقیق و رقیق و لطیف و اینها عمیق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.04,
   "end": 572.42,
   "text": "خدا رحمت کنه حاج میرزا آقا، جواد آقا ملکی تبریزی استاد استادمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.42,
   "end": 574.82,
   "text": "بگ-- یه ک-- تو کتابشون ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 574.82,
   "end": 579.62,
   "text": "در خصوص خروج روح از بدن حرف زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.62,
   "end": 585.9,
   "text": ". و به نوعی هم شهید آوینی این رو تبیین کرده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.9,
   "end": 588.86,
   "text": "بمیرید قبل از اینکه شما را بمیرانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.86,
   "end": 594.6,
   "text": "یادتونه؟ ایشون-- بعد اومدن به آقا میرزا جواد آقا گفتن شما تو کتابت گفتی خروج از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.6,
   "end": 598.14,
   "text": "خروج روح از بدن و اینا یعنی پیدا کردن تعبیر خواب همین الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.14,
   "end": 602.64,
   "text": "همین حالا که خوابت رو دیدی حالا روح رو از بدن بکشی بیرون تعبیرش رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.64,
   "end": 610.88,
   "text": "این یعنی این. حالا ازش سؤال کردن که شما خودت الان به اینجا رسیدی که روحت رو همین الان از بدنت خارج کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.88,
   "end": 613.68,
   "text": "جواب آقا میرزا جواد آقا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 613.68,
   "end": 616.38,
   "text": "فرمود \"اصلاً دست خودم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.38,
   "end": 620.94,
   "text": "دست من نیست. من الان اراده کنم ارادی روحم رو خارج کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 620.94,
   "end": 624.66,
   "text": "گاهی اوقات یه دفعه این اتفاق برام رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 624.66,
   "end": 626.7,
   "text": "یه دفعه روح خارج میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.7,
   "end": 628.68,
   "text": "از بدنم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.68,
   "end": 634.46,
   "text": "روح از بدن خارج میشه و اصلاً من دیگه حسی از جسمم ندارم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.46,
   "end": 637.0,
   "text": "یعنی وقتی که شما روحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.0,
   "end": 641.76,
   "text": "انشاالله با عروج به سمت خدا و الی المسیر خارج شد از جسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.76,
   "end": 646.38,
   "text": "جسم دیگه هیچ حسی نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 646.38,
   "end": 648.14,
   "text": "روح میره به تعالی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.14,
   "end": 652.42,
   "text": "جسم حالا هرچی شد. البته حرمتش باید حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.42,
   "end": 660.02,
   "text": "مگر به قدری روح بزرگ شده باشه که هنوز تس-تأثیر در جسمش بذاره جسمش خراب نشه، فاسد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 660.02,
   "end": 662.92,
   "text": "و الا دیگه جسم حالا هر بلایی سر جسم بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 662.92,
   "end": 665.28,
   "text": "هرچی اینکه میگ-ما میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.28,
   "end": 668.42,
   "text": "فشار قبر روحه، یه وجهشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.42,
   "end": 671.34,
   "text": "جسم حالا هرچی فشار قبر-- لهش کنن اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.34,
   "end": 673.64,
   "text": "بعضیا اصلاً جسمی دیگه ندارن پودر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.64,
   "end": 676.56,
   "text": "یعنی فشار قبر نداره؟ داره، به روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 676.56,
   "end": 678.7,
   "text": "روح فشار قبر. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.7,
   "end": 682.54,
   "text": "می‌خوام بگم که مرحوم جواد آقا ملکی تبریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 682.54,
   "end": 687.1,
   "text": "می‌فرماید که روح یک باره خارج میشه از جسمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.1,
   "end": 690.9,
   "text": "از خدا بخواهید گاهی اوقات شده اینو به شما بچشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.9,
   "end": 696.56,
   "text": "یه وقت وسط یه نمازی، وسط یه زیارتی، وسط یه اشکی برای ابی عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 696.56,
   "end": 698.0,
   "text": "سرش رو-- ببین من نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 698.0,
   "end": 705.02,
   "text": "حیف، حیف، حیف که ما داریم می‌میریم هممون و فرصت نداریم بشینیم و این حرفا رو بزنیم ذائقمون شیرین‌تر از قبل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.02,
   "end": 707.1,
   "text": "خوابامون احلام نل عسل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.1,
   "end": 709.6,
   "text": "این خواب‌هایی الان داریم می‌بینیم‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.6,
   "end": 713.38,
   "text": "که فرمود من زار الحسین بکر-- من اینو دیگه توضیح نمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.38,
   "end": 718.12,
   "text": "خودتون برید درباره‌ش. من زار الحسین بکربلا كمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 718.12,
   "end": 720.34,
   "text": "زار الله فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 720.34,
   "end": 723.98,
   "text": "عرشه. یه تعبیر خوابتو داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.98,
   "end": 728.68,
   "text": "رفتی زیارت امام حسین، تعبیر خوابت زیارت خدا در عرششه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.68,
   "end": 732.3,
   "text": "الله اکبر. اون تعبیرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 732.3,
   "end": 734.06,
   "text": "الان خوابی تو حرم امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.06,
   "end": 736.76,
   "text": "تعبیرش میشه بعداً انشاالله زیارت امام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 736.76,
   "end": 740.14,
   "text": "خدا در عرش. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 740.14,
   "end": 745.04,
   "text": "انشاالله که ثواب اونچه که امروز عرض کردیم برسه به روح حاج قاسم و یاران شهیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 745.04,
   "end": 746.66,
   "text": "عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 746.66,
   "end": 750.14,
   "text": "انشاالله به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 750.14,
   "end": 752.2,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 752.2,
   "end": 755.12,
   "text": "علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}