 "chapters": [
  {
   "index": 0,
   "title": "## نذرِ مطلق؛ تأخیر تا ظهور آثار مرگ",
   "start": 10.52,
   "end": 157.68
  },
  {
   "index": 1,
   "title": "برسیم به آیهٔ پنجاه و هفت سورهٔ کهف. نکتهٔ تکمیلی در خصوص این آیه:",
   "start": 157.68,
   "end": 202.0
  },
  {
   "index": 2,
   "title": "## عهدِ یس و عهدِ آدم در طه",
   "start": 202.0,
   "end": 306.58
  },
  {
   "index": 3,
   "title": "## حرکت وجودیه؛ از نقص به کمال",
   "start": 306.58,
   "end": 366.04
  },
  {
   "index": 4,
   "title": "## حرکت ایجادی؛ از ملکوت به ماده",
   "start": 366.04,
   "end": 455.22
  },
  {
   "index": 5,
   "title": "## کنز مخفی و مشک‌زنی؛ انسان کامل ثمرهٔ وجود",
   "start": 455.22,
   "end": 662.12
  },
  {
   "index": 6,
   "title": "## ونسی ما قدمت یداه؛ برزخ و أکنّة",
   "start": 662.12,
   "end": 803.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 10.52,
   "text": "بسم الله الرحمن الرحیم و به نستعین السلام علیک یا داعی الله و ربانی آیاته السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.52,
   "end": 13.18,
   "text": "عزیزان اگر چنانچه نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.18,
   "end": 19.18,
   "text": "مقید نباشد یعنی مطلق باشد به یک زمان و مکان خاصی تعلق نداشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.18,
   "end": 22.72,
   "text": "مطلق باشه. شما دیروز بحثش گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.72,
   "end": 28.24,
   "text": "که حالا بر من برای خداست بر من که این کارو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.24,
   "end": 30.48,
   "text": "مقید به یک زمان، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.48,
   "end": 36.42,
   "text": "مکان خاص نیست. چنین نظری چون زمان و مکان بردار نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.42,
   "end": 39.16,
   "text": "لذا تأخیرش جایزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.16,
   "end": 43.06,
   "text": "اشکال نداره شما انجام دادنش رو به تأخیر بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.06,
   "end": 48.58,
   "text": "حالا مثلا گفتی همینطوری نذر کردی دوست دارم به خاطر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.58,
   "end": 52.92,
   "text": "یه آشی بدم، چهار تا بچه هیئتی جمع کنم یه آشی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.92,
   "end": 57.18,
   "text": "حالا چون زمان و مکان نداره میتونی هر وقتی انجام بدی تأخیر بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.18,
   "end": 59.86,
   "text": "لکن توجه کنید اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.86,
   "end": 62.7,
   "text": "آثار مرگ ظاهر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.7,
   "end": 67.2,
   "text": "یعنی انسان متوجه شد که دیگه عنقریب است که ان لله و ان الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.2,
   "end": 78.12,
   "text": "سفر کند و آخر اونجا دیگه جایز نیست و اگر اونجا تأخیر بندازه نذرش رو کفاره هم گردنش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.12,
   "end": 80.64,
   "text": "خب برسیم به آیه پنجاه و هفت سوره کف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.64,
   "end": 86.56,
   "text": "نکته تکمیلی رو در خصوص این آیه بیان کنیم که \"و من أظلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.56,
   "end": 91.02,
   "text": "ممن ذكر بآيات ربه فأعرض عنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.02,
   "end": 94.12,
   "text": "و نسي ما قدمت يداه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.12,
   "end": 99.12,
   "text": "إنا جعلنا على قلوبهم أكنة أن يفقهوه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.12,
   "end": 101.64,
   "text": "میگه اونایی که به ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.64,
   "end": 108.88,
   "text": "و به آیات خدا جنبان- استاد خواهش میکنم آثار مرگ که همیشه هست یعنی هر لحظه میمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.88,
   "end": 113.0,
   "text": "نمیشه که مثلا آقا امروز من مریض هستم حتما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.0,
   "end": 115.28,
   "text": "آثار مرگ هستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.28,
   "end": 120.86,
   "text": "بله دیگه تعیین کنه که من آقا چون مریض هستم شاید بمیرم یا من اصلا سلامت هم هیچوقت نمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.86,
   "end": 125.12,
   "text": "این آثار مرگ- یعنی اینکه انسان ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.12,
   "end": 129.04,
   "text": "گو، به گمانش تو فقه اینطوری اومده تو فتوای رهبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.04,
   "end": 132.04,
   "text": "که به گمانش این بیاد که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.04,
   "end": 136.24,
   "text": "باید آماده رفتن باشه. یعنی دیگه چ-- خیلی حالا میتونه هر دلیلی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.24,
   "end": 139.58,
   "text": "میتونه معرفتش باشه. اصلا مریضی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.58,
   "end": 145.12,
   "text": "میتونه معرفتش باشه که به این معرفت، حد از معرفت برسه که من دیگه دارم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.12,
   "end": 151.66,
   "text": "ها؟ اونجا هم دیگه نباید جایز. یعنی زمانش رو فقه سپرده به اون حالت درونی خودت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.66,
   "end": 157.38,
   "text": "اگر یقین کردی به رفتن دیگه جایز نیست به تأخیر بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.38,
   "end": 162.92,
   "text": "بله نکته‌ای که میخوایم امروز در خصوص قلب مکنون بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.92,
   "end": 165.04,
   "text": "تکمیله بحث دیروزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.04,
   "end": 169.86,
   "text": "خوب دقت کنید که ما به این قصه اصلا این چند وقت نپرداختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.86,
   "end": 173.94,
   "text": "یکی از چیزهایی که در این آیه می‌فرمود موجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.94,
   "end": 178.82,
   "text": "قرار گرفتن قلب در یک پرده‌ای میشه که نفهمه حقایقو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.82,
   "end": 182.38,
   "text": "\"و نسي ما قدمت يداه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.38,
   "end": 185.86,
   "text": "یعنی فراموش کردن گذشته‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.86,
   "end": 190.28,
   "text": "حالا بعضیا مثل مثلا آقای قرائتی تو تفسیر نورش اومده این رو پر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.28,
   "end": 191.86,
   "text": "برگردونده به بحث گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.86,
   "end": 197.62,
   "text": "اینکه گناهان قبلیش رو فراموش کنه یادش بره چه خطاهایی مرتکب شده لذا توبه نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.62,
   "end": 201.76,
   "text": "خب این هم درست. اما این کامل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.76,
   "end": 210.52,
   "text": "شما برگردید به اون آیه سوره یاسین که \"ألم عهد إليكم يا بني آدم ألا تعبدوا الشيطان إنه لكم عدو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.52,
   "end": 213.48,
   "text": "مبين و أن اعبدوني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.48,
   "end": 219.1,
   "text": "هذا صراط مستقيم\". مگه من به شما نگفتم یه عهدی بین من و شما مگه نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.1,
   "end": 220.7,
   "text": "چرا این عهدو فراموش کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.7,
   "end": 224.0,
   "text": "اون عهد چی بود؟ \"أن اعبدوني هذا صراط مستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.0,
   "end": 228.34,
   "text": "این دعایی که هر روز ما تو نماز \"اهدنا الصراط المستقيم\" میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.34,
   "end": 230.58,
   "text": "همینه که ما به اون عبودیت برگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.58,
   "end": 236.74,
   "text": "عبودیت هم قبلاً بحثش گذشته اینجا تو بحثای فلسفی‌مون که یعنی تشبه به خدا پیدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.74,
   "end": 239.18,
   "text": "تلبس اسماء الهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.18,
   "end": 242.72,
   "text": "شبیه خدا شدن. \"يا تشبهوا باله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.72,
   "end": 245.78,
   "text": "اونم به قدر طاقت البشری یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.78,
   "end": 248.26,
   "text": "خب این هم میتونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.26,
   "end": 252.88,
   "text": "یعنی این فراموشی عهدی که با خدا داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.88,
   "end": 255.9,
   "text": "این عهد ولایت، عهد عبودیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.9,
   "end": 258.44,
   "text": "عهد تلبس به اسماء خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.44,
   "end": 261.1,
   "text": "عهد شباءت گرفتن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.1,
   "end": 267.4,
   "text": "تو آیه صد و پونزده سوره طه هم قبلاً باز تو یه موضوع دیگه‌ای دربارش حرف زدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.4,
   "end": 270.36,
   "text": "خدا می‌فرماید \"ولقد عهدنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.36,
   "end": 276.16,
   "text": "إلى آدم من قبل\". ما قبلاً یه عهدی از آدم گرفته بودیم \"فنسي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.16,
   "end": 279.24,
   "text": "پس فراموشش کرد \"ولم نجد له عزما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.24,
   "end": 282.88,
   "text": "لذا اولوالعزم نشد. این اصلا فراموشی کار دست ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.88,
   "end": 285.08,
   "text": "نه فقط گناهانمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.08,
   "end": 288.56,
   "text": "اینکه ما در این نشئه طبیعت پی چی باید باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.56,
   "end": 291.48,
   "text": "این صراط مستقیم اصلاً یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.48,
   "end": 295.34,
   "text": "ما اینو فراموش می‌کنیم. عزیز دلم لذا گرفته به نفهمی میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.34,
   "end": 299.36,
   "text": "اینا مهمه ها. میگه تو چرا عهدتو فراموش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.36,
   "end": 302.9,
   "text": "چرا؟ چرا عهدی که با خدا داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.9,
   "end": 306.58,
   "text": "عهد ولایت، عهد عبودیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.58,
   "end": 309.72,
   "text": "حالا ما دیروز حرکت وجودیه رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.72,
   "end": 311.4,
   "text": "یادتونه از نقص به کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.4,
   "end": 316.36,
   "text": "تمام در این نشئه طبیعت، عالم ماده، همه موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.36,
   "end": 318.86,
   "text": "به س-- از نقص به کمال دارن حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.86,
   "end": 325.84,
   "text": "مثال کتابت رو زدیم با اون اعراز، با اون حرکات عرضی دست و چشم و اینها قلم حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.84,
   "end": 330.32,
   "text": "انقدر، انقدر کتابت میکنی، میکنی تا از نقصی به کمال میرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.32,
   "end": 333.46,
   "text": "اون کمال خودش وجوده. وجود کتابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.46,
   "end": 337.32,
   "text": "عدم که نیست. یعنی ز-وجود تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.32,
   "end": 342.74,
   "text": "ذات تو به سمت کتابت حرکت، صفت کتابت در وجود تو مستکن میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.74,
   "end": 344.42,
   "text": "و قائم به ذات میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.42,
   "end": 346.62,
   "text": "در آن صورت میگیم این تجسم عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.62,
   "end": 349.62,
   "text": "تجسم عمل توئه. اینو بحثش دیروز گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.62,
   "end": 352.64,
   "text": "که توی فلسفه اصطلاحاً بهش میگن حرکت وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.64,
   "end": 357.42,
   "text": "چون وجود میاد رو وجود از نقص به سمت کمال میری چیزی عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.42,
   "end": 360.84,
   "text": "و گفتیم این همون ملکه شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.84,
   "end": 365.36,
   "text": "و اینه که انسان عین علم و عملش میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.36,
   "end": 369.16,
   "text": "خب حالا یه حرکت دیگه‌ای داریم به نام حرکت ایجادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.16,
   "end": 371.54,
   "text": "حرکت ایدا، ایجادی به عکس اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.54,
   "end": 374.4,
   "text": "مال عالم ملکوته به نوعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.4,
   "end": 377.7,
   "text": "اون تحریک می‌کنه عالم ماده رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.7,
   "end": 382.3,
   "text": "یعنی این حرکتی که در ما هست از نقص به کمال میریم حرکت وجودیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.3,
   "end": 384.46,
   "text": "حرکت ایجادیه مال عالم ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.46,
   "end": 387.3,
   "text": "اون ما رو تحریک می‌کنه که از نقص به کمال بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.3,
   "end": 391.16,
   "text": "اون در حقیقت دعوت می‌کنه ما به عقل کل برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.16,
   "end": 392.74,
   "text": "ما به مجردات برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.74,
   "end": 394.5,
   "text": "اصلا می‌میریم که مجرد بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.5,
   "end": 396.66,
   "text": "هی رتبه به رتبه بریم بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.66,
   "end": 400.7,
   "text": "اون بلعکسه. این از بیرون ما داریم نقصی رو کسب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.7,
   "end": 407.4,
   "text": "نقصی رو برطرف می‌کنیم، کمالی رو کسب می‌کنیم در حرکت وجودیه و سیر استکمالی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.4,
   "end": 410.12,
   "text": "اونجا بلعکسه. درونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.12,
   "end": 416.08,
   "text": "درون اون ذات پنهان یک کمالی وجود داره اینو میخواد بروز بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.08,
   "end": 419.44,
   "text": "حالا عالم عقل، عالم مجردات، ملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.44,
   "end": 424.38,
   "text": "عرش، ملکوت. مثل اینکه خدای من مثل اینکه شما گمان کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.38,
   "end": 429.08,
   "text": "اصلا کتابت در درون شما بوده، تعبیه شده بوده اصلا از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.08,
   "end": 431.5,
   "text": "صفت کتابت، صفت جود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.5,
   "end": 436.04,
   "text": "اما آیا شما به من بگید تا ننوشته باشی فایده‌ای داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.04,
   "end": 441.52,
   "text": "شما در درون خود صفت کتابت داری اما تا ننویسی به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.52,
   "end": 447.82,
   "text": "در درون خودت بگین آدم جوادی هستی اما تا نبخشی این صفت درونی تو، جود تو به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.82,
   "end": 452.92,
   "text": "چه کمالیه؟ لذا اصلا اون ذات پنهان باید آشکار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.92,
   "end": 455.22,
   "text": "این کمالشه آشکار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.22,
   "end": 459.82,
   "text": "برگردید به اون حدیث بسیار عجیب که عمادالدین تبری در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.82,
   "end": 463.54,
   "text": "ابتدای کتاب کامل بهائی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.54,
   "end": 467.7,
   "text": "که اینجا هم باز الحمدالله بحثش گذشته ذهنی گوش‌هاتون آشناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.7,
   "end": 472.22,
   "text": "که کنتو خدا، خدا فرمود \"کنتو کنزاً مخفیا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.22,
   "end": 475.64,
   "text": "من اون گنج مخفی بودم \"فاحببت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.64,
   "end": 478.94,
   "text": "ان اعرف\" دوست داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.94,
   "end": 481.32,
   "text": "شناخته بشم. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.32,
   "end": 484.34,
   "text": "\"فخلقت الخلق لکی اعرف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.34,
   "end": 486.68,
   "text": "خلق رو خلق کردم تا آشکار بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.68,
   "end": 489.14,
   "text": "این حرکت ایجادیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.14,
   "end": 491.9,
   "text": "ایجاد کرد خلق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.9,
   "end": 500.82,
   "text": "یعنی از بالا تحریک می‌کنه عالم ماده رو، من و شما رو که جزئی از این عالم هستیم رو از نقص به کمال بریم برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.82,
   "end": 502.92,
   "text": "چرا؟ \"فاحببت ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.92,
   "end": 507.04,
   "text": "اعرف\" چون شناخته بشه. خدا درونش رو می‌خواست آشکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.04,
   "end": 511.72,
   "text": "ذات خودش رو، باطن وجود خودش رو ظاهر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.72,
   "end": 515.78,
   "text": "لذا ما رو خلق کرد. در حقیقت حرکت ایجادی اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.78,
   "end": 517.4,
   "text": "ظهور و بروز ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.4,
   "end": 521.44,
   "text": "ظهور و بروز باطنه. ظاهر شدن باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.44,
   "end": 524.96,
   "text": "در عالم عقل، در عالم حالا بالا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.96,
   "end": 527.9,
   "text": "درست شد؟ اون ایجادیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.9,
   "end": 531.94,
   "text": "که ما به سمت است، استکمالمون، کمالمون حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.94,
   "end": 534.98,
   "text": "به این میگن وجودی. خب اینا رو گفتم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.98,
   "end": 546.24,
   "text": "چه ربطی به بحث داره؟ غایت-- علامه حسن زاده یه جمله‌ای دارن می‌فرماین، غایت حرکت ایجادی که عالم ملکوته است و م،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.24,
   "end": 550.96,
   "text": "وجودی که عالم طبیعته است، اصلا عالم در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.96,
   "end": 552.8,
   "text": "یک آن ایستا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.8,
   "end": 555.04,
   "text": "آن‌ات عالم در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.04,
   "end": 558.32,
   "text": "لذا علامه می‌فرمود که عالم در حال مشک‌زنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.32,
   "end": 561.36,
   "text": "هی مشک می‌زنه خدا. مشک رو دیدید تکون میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.36,
   "end": 564.92,
   "text": "عصاره و زبده‌ش بیاد رو شیر واسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.92,
   "end": 568.9,
   "text": "میگه غایت دقت کنید چقدر زیباست این نتیجه‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.9,
   "end": 571.76,
   "text": "غایت و نهایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.76,
   "end": 577.66,
   "text": "این حرکت ایجادی و وجودی عالم، مشک‌زنی عالمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.66,
   "end": 582.74,
   "text": "تا که چی بشه؟ تا یک نطفه‌ای درست بشه به نام نطفه‌ی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.74,
   "end": 584.94,
   "text": "اونم نه نطفه‌ی حیوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.94,
   "end": 587.8,
   "text": "نه نطفه‌ی جماد، نه نطفه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.8,
   "end": 589.46,
   "text": "عرض شود نبات. هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.46,
   "end": 593.98,
   "text": "نطفه‌ی انسان در این مشک‌زنی، اون عصاره و زبده‌ی عالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 593.98,
   "end": 600.26,
   "text": "درست بشه در رحم مادر قرار بگیره و برسه به مقام انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.26,
   "end": 603.28,
   "text": "در حقیقت انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.28,
   "end": 606.16,
   "text": "ثمره‌ی شجره‌ی وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.16,
   "end": 613.96,
   "text": "این جمله‌ی علامه است و غایت حرکت ایجادی و وجودی عالم رسیدن به مقام چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.96,
   "end": 616.5,
   "text": "انسان کامل است. این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.5,
   "end": 618.24,
   "text": "این به این میگن صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.24,
   "end": 622.44,
   "text": "به روی عهدی از ما این راه بسته نبوده و نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 622.44,
   "end": 624.44,
   "text": "او رفته رسیده امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.44,
   "end": 628.84,
   "text": "چون در نشئه عنصری باید حداقل یک نفر انسان کاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.84,
   "end": 634.86,
   "text": "کامل، انسان کامل در نشئه عنصری با عنصرش باشه که این عالم به هم نریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 634.86,
   "end": 639.78,
   "text": "اما ما هم می‌تونیم برسیم. اصلا عزیز دلم قربونت برم که داری گوش میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.78,
   "end": 642.08,
   "text": "این صراط مستقیم یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 642.08,
   "end": 644.76,
   "text": "یعنی ما بریم بشیم انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 644.76,
   "end": 647.96,
   "text": "تمام این نظام افلاکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.96,
   "end": 650.34,
   "text": "این عالم ایجاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.34,
   "end": 653.16,
   "text": "این حرکت ایجادی، حرکت وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.16,
   "end": 660.16,
   "text": "دم به دم تمام اینا دست به دست هم دادن ما رو هل بدن، کمک کنن بریم به سمت این که چی بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.16,
   "end": 664.36,
   "text": "انسان کامل بشیم. حالا اینجا برگردید به آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.36,
   "end": 666.24,
   "text": "زور زدیم این مقدمه رو چیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.24,
   "end": 669.64,
   "text": "\"ونسی ما قدمت یداه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.64,
   "end": 672.16,
   "text": "فراموش کرده اون قبلشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 672.16,
   "end": 676.66,
   "text": "چی بوده؟ \"الم اهد الیکم\" اون صراط مستقیم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 676.66,
   "end": 681.06,
   "text": "صراط مستقیم چی بود؟ انسان کامل شدن که من و تو هم می‌تونیم بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.06,
   "end": 684.24,
   "text": "و الا اگر نمی‌تونستیم اصلا بیخود بود این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 684.24,
   "end": 686.52,
   "text": "بیخود بود که او امام ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.52,
   "end": 688.5,
   "text": "امام ما شده که ما پشت سرش راه بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 688.5,
   "end": 691.64,
   "text": "تمام این مقامات به روی ما هم بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.64,
   "end": 693.62,
   "text": "که ب، الحمدالله بحثش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.62,
   "end": 698.74,
   "text": "شما هم می‌تونید امام بشید، خلیفه بشید، ولی خدا بشید، ولایت پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.74,
   "end": 701.94,
   "text": "همه نبوت انبایی پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.94,
   "end": 706.52,
   "text": "همه این راه. اصلا ما اومدیم که به اون مقام برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 706.52,
   "end": 710.7,
   "text": "اگر کسی این حالا نقطه سر خط خودش یه بحث مفصلیه بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 710.7,
   "end": 713.42,
   "text": "اگر کسی تو این نشئه خا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 713.42,
   "end": 716.78,
   "text": "خاکی توی این حرکت وجودیه نرسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 716.78,
   "end": 722.36,
   "text": "در این سیر استکمالی نرسه به اون مقام انسان کامل، به عقل طام، به مجرد شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 722.36,
   "end": 724.42,
   "text": "نرسه چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 724.42,
   "end": 726.74,
   "text": "یه راست نمی‌برنش تو آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 726.74,
   "end": 728.74,
   "text": "آخرت اون نشئه طامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.74,
   "end": 731.22,
   "text": "کجا می‌برنش؟ بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 731.22,
   "end": 734.8,
   "text": "برزخ. متوجه شدید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.8,
   "end": 736.54,
   "text": "برزخ مال آدمای ناقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 736.54,
   "end": 739.46,
   "text": "لذا اکثریت مردم میرن برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 739.46,
   "end": 742.56,
   "text": "عده‌ی قلیلی‌اند که اصلا برزخ چیه براشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 742.56,
   "end": 748.16,
   "text": "یه راست به عالم آخرت. اونا آدمای کمل‌اند اصطلاحاً تو عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 748.16,
   "end": 753.06,
   "text": "اونا همه چی این حقایق عالم ملکات وجودی‌شون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 753.06,
   "end": 755.06,
   "text": "اونا به انس، به حقیقت انسان کامل رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 755.06,
   "end": 758.22,
   "text": "اگر کسی این رو، این عهد رو فراموش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 758.22,
   "end": 763.58,
   "text": "دچار روزمرگی زندگی شد، تشبه به اسماء الهی پیدا نکرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 763.58,
   "end": 766.54,
   "text": "سیر عبودیت رو پیش نگرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 766.54,
   "end": 771.96,
   "text": "در این چرخه روزگار گیر می‌کنه، مجبوره برزخ سختی داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 771.96,
   "end": 778.16,
   "text": "و چنین کسی چی میشه؟ \"ونسی ما قدمت یداه\" فراموش کرده عهدو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 778.16,
   "end": 780.46,
   "text": "حالا دیگه خدا دست به کار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.46,
   "end": 786.82,
   "text": "تکوینش. \"اناجعلنا على قلوبهم اكنة ان يفقهوه وفي اذانهم وقرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 786.82,
   "end": 788.98,
   "text": "هرچی زور بزنه حقایق رو نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 788.98,
   "end": 790.94,
   "text": "گوشش سنگین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.94,
   "end": 794.72,
   "text": "وای به حال همچین کسی. ایشالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 794.72,
   "end": 798.04,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 798.04,
   "end": 800.32,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 800.32,
   "end": 803.76,
   "text": "على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}