 },
 "chapters": [
  {
   "index": 0,
   "title": "## بطلان نذر بر عهدهٔ دیگران",
   "start": 12.3,
   "end": 47.04
  },
  {
   "index": 1,
   "title": "## ورود به قلب مکنون؛ پرده بر فهم",
   "start": 47.04,
   "end": 565.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.96,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 7.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 12.3,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 19.14,
   "text": "در خصوص نذر خوبه بدونیم که ما حق اینکه در رابطه با دیگران نذر کنیم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.14,
   "end": 23.12,
   "text": "اصلا نذری که در خصوص دیگران باشد باطل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.12,
   "end": 25.5,
   "text": "یا کسی در مورد ما نذر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.5,
   "end": 30.6,
   "text": "به من بعضی موقع‌ها کسی می‌رسه میگه من نذر کردم برای اینکه مریضم شفا بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.6,
   "end": 34.14,
   "text": "شما ده تا رو روضه مثلاً مسلم بن جعفر بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.14,
   "end": 40.92,
   "text": "میگم خیلی ممنون شما مریضی‌ت مشکل داره و خـ‌ شما داری نذر می‌کنی منو تو گرفتاری میندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.92,
   "end": 45.74,
   "text": "خوندن روضه بر رو دوش من سنگینی می‌کنه بعد شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.74,
   "end": 47.98,
   "text": "اصلا این باطله از جهت شرعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.98,
   "end": 52.44,
   "text": "شما نمی‌تونی دیگری رو به زحمت بندازی برای اینکه خودت نذر داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.44,
   "end": 55.98,
   "text": "باطله. خودت باید زحمت بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.98,
   "end": 61.92,
   "text": "اجازه بدید از موضوع قلب ممتحن گذر کنیم و وارد بر ساحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.92,
   "end": 69.18,
   "text": "چهاردهمین قلب از انواع قلب در قرآن بشویم به نام قلب مکنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.18,
   "end": 71.6,
   "text": "که چند تا آیه در قرآن پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.6,
   "end": 76.12,
   "text": "قلبی که در کنان قرار گرفته است یا در یک پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.12,
   "end": 79.68,
   "text": "قرار گرفته است که نمی‌فهمد حقایق رو هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.68,
   "end": 84.04,
   "text": "البته خب معنای همه فهمش میشه همون قلب نفهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.04,
   "end": 86.28,
   "text": "جسارتا. قلبی که نمی‌فهمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.28,
   "end": 90.26,
   "text": "لakin خب این فهمیدن مدرج است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.26,
   "end": 93.46,
   "text": "بعضیا کمتر، بعضیا بیشتر، بعضیا اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.46,
   "end": 96.26,
   "text": "اه-اهل فهم نیستن، فهم حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.26,
   "end": 98.96,
   "text": "حالا برای اینکه تبرکه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.96,
   "end": 105.16,
   "text": "صدر صحبت ما هم آیه باشه اشاره می‌کنیم به یکی از آیات که آیه بیست و پنج سوره انعام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.16,
   "end": 111.04,
   "text": "می‌فرماید \"و منهم من يستمع إليك\" بعضی از اینا هستن که میان حرف تو رو هم گوش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.04,
   "end": 119.84,
   "text": "\"يستمع إليك\". لakin \"وجعلنا\" اینجا، اینجا سری است که خدا چرا این نفهمی قلب بعضیا رو به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.84,
   "end": 124.52,
   "text": "استناد میده. این همون توحید افعالی خداست که بعد یه جلسه در رابطه باهاش انشاالله صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.52,
   "end": 127.82,
   "text": "\"وجعلنا على قلوبهم أكنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.82,
   "end": 131.54,
   "text": "ما رو قلب این‌ها یه پرده‌ای قرار دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.54,
   "end": 139.42,
   "text": "که \"أيفقهون\". که این‌ها برای اینکه نفهمن به پرده‌ای قرار دادیم که متوجه نشن تو چی میگی، نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.42,
   "end": 144.0,
   "text": "یکی از ظرائف آیه اینجاست \"وفي آذانهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.0,
   "end": 147.78,
   "text": "وقرا\". وقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.78,
   "end": 150.68,
   "text": "میگه تو گوش اینا یک سنگینی خاصی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.68,
   "end": 154.5,
   "text": "عرب به حالتی از شتر میگه شتر وقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.5,
   "end": 159.9,
   "text": "که انقدر بارش سنگین شده که شکمش داره می‌خوره به زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.9,
   "end": 163.42,
   "text": "میگه اینا تو گوششون یه سنگینی خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.42,
   "end": 170.4,
   "text": "خیلی جالبه اینجا تو این ظرافت آیه البته هر کسی اهل دقت نظر این چنینی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.4,
   "end": 175.08,
   "text": "اما اینجا از تو این ظرافت آیه بحث ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.08,
   "end": 179.26,
   "text": "علم طب با معنویت در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.26,
   "end": 184.16,
   "text": "چگونه؟ ما اصلا داریم که بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.16,
   "end": 186.56,
   "text": "اه مریضی‌های روحی حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.56,
   "end": 188.8,
   "text": "مستقیما مرتبط‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.8,
   "end": 194.3,
   "text": "یا البته اگر بخوایم درست صحبت کنیم، کارشناسی صحبت کنیم تمام مریضی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.3,
   "end": 197.98,
   "text": "مرتبط‌اند با نحوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.98,
   "end": 201.86,
   "text": "تغذیه ما. اینکه شیخ الرئیس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.86,
   "end": 208.96,
   "text": "العشاراتش یک بحث بسیار زیبای و مبسوطی رو میاره در خصوص اعتدال مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.96,
   "end": 215.98,
   "text": "و اونجا ثابت می‌کنه که اهل بیت علیهم السلام یه دلیل اینکه همیشه زنده‌اند تا کسی نکششون از این دنیا نمیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.98,
   "end": 218.48,
   "text": "اینه که عدل امزجه رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.48,
   "end": 223.94,
   "text": "مزالش مزاج اون‌ها کاملا معتدل است بلکه از همه اعتدالش بیشتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.94,
   "end": 226.62,
   "text": "این کام-- یک بحث بسیار مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.62,
   "end": 229.98,
   "text": "طبیس که متاسفانه تو کشور ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.98,
   "end": 235.42,
   "text": "ازش خبری نیست. تو مجامع تدریسی ما اما تو کشورهای خارجی دارن اینو درس میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.42,
   "end": 240.52,
   "text": "بسیاری از کشورهای اروپایی دارن همین فکر می‌کنم تو نمت دهم اشارات شیخ الرئیس باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.52,
   "end": 244.46,
   "text": "حالا نمتش یادم نیست. اونجا اینو دارن اونجا درس میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.46,
   "end": 246.38,
   "text": "و دارن، دارن نتیجه هم می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.38,
   "end": 250.22,
   "text": "بسیاری از تغذیه‌هاشون رو دارن قطع می‌کنند به خاطر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.22,
   "end": 255.76,
   "text": "اصلا وقتی که بعضی چیزا رو ما می‌خوریم سودامون میره زی-- بالا م-مزاجمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.76,
   "end": 257.6,
   "text": "از حالت اعتدال خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.6,
   "end": 260.06,
   "text": "خوبه بدونید ناسپاسی گل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.06,
   "end": 262.5,
   "text": "عجب. ارتباط مستقیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.5,
   "end": 265.72,
   "text": "بالا رفتن سودا در بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.72,
   "end": 269.46,
   "text": "با ناسپاسی. ناسپاسی ریشه در نفهمی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.46,
   "end": 271.78,
   "text": "آدم نمی‌فهمه. نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.78,
   "end": 275.96,
   "text": "نفهمیش گل می‌کنه که ناسپاسی می‌کنه دیگه ناشکری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.96,
   "end": 279.44,
   "text": "عزیز دلم. اگر کسی سوداش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.44,
   "end": 282.08,
   "text": "اون اعتدال مزاج رو داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.08,
   "end": 285.12,
   "text": "قطعا فهمش دقیق‌تر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.12,
   "end": 288.9,
   "text": "و به ناشکری هم نمیفته. یا بعضی از چیزا هست سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.9,
   "end": 292.48,
   "text": "بعضی از غذاها هستن که ما می‌خوریم اینا سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.48,
   "end": 296.12,
   "text": "سرد مزاجی حتی گناهان، گناهان سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.12,
   "end": 301.52,
   "text": "حالا اینا یک بحث‌هایی است که الان ما تو این فرصت هفت، هشت، ده دقیقه‌ای که وقت نداریم اینا رو بشکافیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.52,
   "end": 303.88,
   "text": "تبرکه هم میگیم شما تشنه بشید برید دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.88,
   "end": 308.28,
   "text": "ببینید چه غوغاییه تو مجامع روایی ما پیرامون همین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.28,
   "end": 312.92,
   "text": "وقتی خدا روح بزرگان ما رو شاد کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.92,
   "end": 318.88,
   "text": "این‌ها رو برامون مثل علمه حسن زاده‌ها بعضا این‌ها رو نگه داشتن به دست ما برسه اما داره خاک می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.88,
   "end": 323.42,
   "text": "وقتی لقمان حکیم تو یک تمثلش، ما چند تا تمثل تو عمرمون داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.42,
   "end": 327.62,
   "text": "تمثلات برزخی. تا دلت بخواد هر وقت خوابیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.62,
   "end": 332.52,
   "text": "داریم تمثلات و صور برزخی و عبارات برزخی می‌بینیم و می‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.52,
   "end": 334.66,
   "text": "اما هیچ کدومش به کار ما نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.66,
   "end": 340.76,
   "text": "در یک تمثلش لقمان حکیم چهار هزار خاصیت درمانی از گیاهان رو کشف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.76,
   "end": 342.98,
   "text": "الله اکبر. خب اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.98,
   "end": 345.84,
   "text": "تو بعضی از کتاب‌های بزرگان ما اومده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.84,
   "end": 348.96,
   "text": "آدم اینا رو بدونه و استفاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.96,
   "end": 350.78,
   "text": "که اصلا گناهان سردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.78,
   "end": 356.1,
   "text": "وقتی که انسان گناهی می‌کنه ناسپاسی می‌شنوه، نفهمی می‌شنوه حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.1,
   "end": 360.95,
   "text": "مگر ما عرض نکردیم که یعنی حکما نگفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.95,
   "end": 362.63,
   "text": "گوش دهان روح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.63,
   "end": 367.33,
   "text": "پس آنچه که می‌شنوی مطلق شنیداری تو غذای روح تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.33,
   "end": 370.99,
   "text": "رو داره تامین می‌کنه. اگر اون شنیدن تو سرد باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.99,
   "end": 373.67,
   "text": "غذای روح تو که سرد باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.67,
   "end": 376.27,
   "text": "روح تو رو سرد می‌کند و به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.27,
   "end": 379.93,
   "text": "بی‌انضباطی و نفهمی و ناشکری می‌روی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.93,
   "end": 383.05,
   "text": "این‌ها کاملاً-- ببینید اینکه حدیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.05,
   "end": 387.85,
   "text": "شما عذر شود خدمتتون، روغن زیتون زیاد استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.85,
   "end": 393.13,
   "text": "اسفند تو طب اسلامی برید ببینید چقدر تأکید شده از استفاده از این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.13,
   "end": 395.37,
   "text": "انجیر، زیتون، انگور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.37,
   "end": 398.01,
   "text": "تو قرآن هم زیاد اومده. این‌ها اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.01,
   "end": 401.17,
   "text": "روایت دارما. هر کجا که این‌ها هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.17,
   "end": 403.69,
   "text": "شیطان فرار می‌کنه. حالا این شیطان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.69,
   "end": 408.87,
   "text": "باید بحث بشه روش. این شیطان و ابلیس ابا-- ابا است، ابا وسط اکبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.87,
   "end": 410.93,
   "text": "یا نه اون میکروبه یا هرچی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.93,
   "end": 413.93,
   "text": "میگه شیطان اونجا نمی‌مونه. چرا اسفند دود می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.93,
   "end": 415.91,
   "text": "چرا اسفند رو می‌خورن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.91,
   "end": 420.41,
   "text": "دانه‌ی اسفند رو بدون اینکه بکوبنش، اون موقع دیگه حالت سمی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.41,
   "end": 423.63,
   "text": "بکوبیده شده بخوری نه، دانه‌ی کاملشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.63,
   "end": 430.15,
   "text": "اصلاً هر کجا بوته‌ی اسفند تو هر خانه‌ای بوته گلون اسفند داشته باشی شیطان نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.15,
   "end": 433.09,
   "text": "بعد این همه اجنه تو خونه ما میاد و میره و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.09,
   "end": 435.97,
   "text": "یه کسی اومد پیش امام صادق سلام الله علیه گفت آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.97,
   "end": 438.81,
   "text": "اتفاقات عجیب و غریب تو خونه ما رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.81,
   "end": 441.03,
   "text": "یه چیزیمون گم میشه یا زیاد مریض میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.03,
   "end": 443.89,
   "text": "پریشان احوالیه زیاد. نکنه طلسم و جادوعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.89,
   "end": 446.05,
   "text": "همشم می‌چسبونیم به طلسم و جادو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.05,
   "end": 450.99,
   "text": "حضرت ببینید حکیمانه‌ترین سخن‌ها در سخنرانی‌های اهل بیت جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.99,
   "end": 455.07,
   "text": "ما اهل دقت نظر نیستیم. حضرت فرمود ارتفاع خونه‌ت چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.07,
   "end": 457.99,
   "text": "حالا شما بیا این حرفو به آدمای امروزی بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.99,
   "end": 460.53,
   "text": "اصلاً فکرشون طرف این‌ها میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.53,
   "end": 462.77,
   "text": "میگن نه. حالا برو به دعانویس بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.77,
   "end": 465.63,
   "text": "میگه بیا دعا ن-- بیا برات یه دعا بنویسم گره‌هال شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.63,
   "end": 468.37,
   "text": "حضرت فرمود ارتفاع خونه‌ت چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.37,
   "end": 471.09,
   "text": "گفت هشت متر. خب خونه‌های قدیم بلند می‌ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.09,
   "end": 473.59,
   "text": "هشت متر ارتفاع سقف خونه‌مه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.59,
   "end": 479.47,
   "text": "حضرت فرمود اون-- برو اون یک سوم باقی‌مانده به سقف رو پنجره‌گذاری کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.47,
   "end": 482.31,
   "text": "پنجره بذار و پنجره‌ها رو باز کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.31,
   "end": 484.37,
   "text": "طرف موند تو سرش. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.37,
   "end": 486.05,
   "text": "بعد این کارو کرد. گره‌ش باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.05,
   "end": 490.31,
   "text": "مشکلاتش حل شد. حالا حکمای امروز اومدن پرده‌برداری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.31,
   "end": 494.51,
   "text": "گفتن چون گرم و جن جنس جن از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.51,
   "end": 499.03,
   "text": "و خلق، و خلق جانمه مارج من نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.03,
   "end": 501.43,
   "text": "جن جان همون جنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.43,
   "end": 503.33,
   "text": "از ما-- از نطفه آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.33,
   "end": 505.99,
   "text": "مثل ما که از نطفه خاکی ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.99,
   "end": 508.97,
   "text": "جنسشون از آتشه. گرما رو دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.97,
   "end": 512.23,
   "text": "وقتی هشت متر ارتفاع سقفه این گرما میره اون بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.23,
   "end": 515.03,
   "text": "وقتی رفت اون بالا اجنه اونجا متمرکز میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.03,
   "end": 518.23,
   "text": "از گرما خوششون میاد. بعد سب-- بالای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.23,
   "end": 521.43,
   "text": "همون نشیمن‌گاه‌های شما پر است از اجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.43,
   "end": 525.39,
   "text": "اون‌ها این اتفاقات عجیب و غریب تو منزلت به خاطر حضور اونا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.39,
   "end": 529.17,
   "text": "اون پنجره‌ها رو که باز می‌کنه این گرما میره اجنه هم فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.17,
   "end": 532.31,
   "text": "از سرما بدشون میاد. ببینید ارتباطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 532.31,
   "end": 533.97,
   "text": "آقا جان! عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.97,
   "end": 536.39,
   "text": "سبک زندگی اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.39,
   "end": 539.37,
   "text": "تو جز جز مسائل زندگی ما ورود و خروج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.37,
   "end": 541.25,
   "text": "حالا ما داریم برا شما آیه قرآن می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.25,
   "end": 544.33,
   "text": "قلب مکنون ارتباطش با خوردنی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.33,
   "end": 546.95,
   "text": "با معماری اسلامی. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 546.95,
   "end": 549.55,
   "text": "آیه قرآن می‌بینی چه نکاتی هست توش در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 549.55,
   "end": 552.99,
   "text": "حالا ما فرصت نداریم چیزکی عرض می‌کنیم انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 552.99,
   "end": 554.57,
   "text": "اگر زنده بودیم ادامه‌ش میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 554.57,
   "end": 556.55,
   "text": "عاقبتمون انشاالله ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 556.55,
   "end": 559.69,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 559.69,
   "end": 562.67,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 562.67,
   "end": 565.31,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}