 },
 "chapters": [
  {
   "index": 0,
   "title": "## قبرستان، دو بال، و برزخِ زهرایی",
   "start": 123.12,
   "end": 289.58
  },
  {
   "index": 1,
   "title": "## رضا تا جلوهٔ جمالِ حق",
   "start": 289.58,
   "end": 664.32
  },
  {
   "index": 2,
   "title": "## ملاکِ کلی در رؤیا",
   "start": 664.32,
   "end": 841.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 6.16,
   "text": "مشکل اینه مثل مادری که بچه ترسیده چجوری میاد بغلش میکنه و آغوش میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.16,
   "end": 10.76,
   "text": "از گرمای وجود مادر بچه آروم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.76,
   "end": 13.6,
   "text": "کاری که حضرت زهرا میکنه این کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.6,
   "end": 16.24,
   "text": "میاد اون چیزی که شما تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.24,
   "end": 21.76,
   "text": "یاد گرفتی و شنیدی و خوندی و اینا رو به یکباره به تو چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.76,
   "end": 24.68,
   "text": "وقتی که بهت نشون داد امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.68,
   "end": 27.76,
   "text": "جلالشو نشون داد، جبروتشو نشون داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.76,
   "end": 30.6,
   "text": "حضرت زهرا میاد اینو به تو میچشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.6,
   "end": 34.12,
   "text": "این مقام پرورشه. چشوندن مقام پرورشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.12,
   "end": 39.06,
   "text": "مثل بچه‌ای که از سینه مادر، از سینه مادر شیر میخوره، داره پرورش پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.06,
   "end": 45.14,
   "text": "نساءکم حرث لكم دیگه قرآن میگه زنان شما زمین کشاورز شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.14,
   "end": 48.32,
   "text": "مرد مقامش دهنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.32,
   "end": 50.34,
   "text": "آسمانه، عقله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.34,
   "end": 52.54,
   "text": "کلیه، جلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.54,
   "end": 58.52,
   "text": "زن زمینه، کشاورز، پرورش دهنده است، نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.52,
   "end": 61.92,
   "text": "رابط بین مادون و مافوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.92,
   "end": 64.6,
   "text": "هرچه هست از حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.6,
   "end": 68.28,
   "text": "حضرت زهرا اینو برای شما چشیدنی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.28,
   "end": 75.3,
   "text": "برای همین اگر کسی بخواد سیر و سلوکش خوب جواب بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.3,
   "end": 79.42,
   "text": "زودتر بچشه، زودتر به نتیجه برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.42,
   "end": 84.58,
   "text": "خیلی حیرت نکنه، به هیمان نیفته، نترسه، دهشت نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.58,
   "end": 87.42,
   "text": "فرار اگر میکنه سریع برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.42,
   "end": 89.52,
   "text": "همه اینا الان داریم راهکار میدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.52,
   "end": 93.4,
   "text": "راهش چیه؟ اسماء جماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.4,
   "end": 96.06,
   "text": "او پیش کی تجلی اعظم کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.06,
   "end": 99.0,
   "text": "حضرت زهرا. راهش توسل به حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.0,
   "end": 103.18,
   "text": "الان بچه‌های یا زهرا یه‌ذره بهتر متوجه میشن چرا بنده هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.18,
   "end": 109.78,
   "text": "س-شب قدر هر ساله میگم اگر هیچ کاری رو نتونستید شب قدر انجام بدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.78,
   "end": 113.56,
   "text": "نماز استغاثه به حضرت زهرا فراموشتون نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.56,
   "end": 117.36,
   "text": "کل بارتون رو برمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.36,
   "end": 120.84,
   "text": "این یعنی این-- حضرت زهرا شما رو میرسونه به مقام چشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.84,
   "end": 123.12,
   "text": "از اون دهشت خارجتون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.12,
   "end": 129.84,
   "text": "اون عرض شود بارقه ها که آنی بود تبدیل به جذبه شد و موندنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.84,
   "end": 133.02,
   "text": "دیگه نمی‌ترسی. دیگه وحشت نمی‌کنی از خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.02,
   "end": 136.38,
   "text": "دوست داری دوباره نماز بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.38,
   "end": 139.86,
   "text": "چه‌گونه است که شما به قبرستان نصف، نصف شب بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.86,
   "end": 143.02,
   "text": "اتفاقاتی بیفته که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.02,
   "end": 145.1,
   "text": "ایمانش قوی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 145.1,
   "end": 150.66,
   "text": "نهی شده بره. چون یه اتفاقاتی میفته ضعف ایمان میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.66,
   "end": 153.84,
   "text": "من خودم دفعات اول که می‌رفتم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.84,
   "end": 157.26,
   "text": "مثلا پونزده شونزده سالم بود. تازه مادرم از دنیا رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.26,
   "end": 161.32,
   "text": "از عشق مادر می‌رفتم تا صبح هم می‌ترسیدم، می‌لرزیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.32,
   "end": 164.7,
   "text": "خب. اما الان اصلاً روز هم نمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.7,
   "end": 167.9,
   "text": "اصلاً هیچ-- اصلاً روز نمیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.9,
   "end": 170.34,
   "text": "هر اتفاقیه تو شبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.34,
   "end": 174.06,
   "text": "اول ترسه، اول وحشته، اول دهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.06,
   "end": 177.38,
   "text": "بعد حضرت زهرا میاد کمک کارو برای شما آسون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.38,
   "end": 179.74,
   "text": "راحت الحلقوم میگذاره تو گلوتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.74,
   "end": 183.74,
   "text": "به شرط چی؟ چی گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.74,
   "end": 186.14,
   "text": "این دو تا بال با هم بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.14,
   "end": 188.56,
   "text": "حوزه عمل و حوزه نظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.56,
   "end": 191.42,
   "text": "این دو تا با هم بیاد بپره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.42,
   "end": 196.72,
   "text": "شما رو قشنگ می‌بره بالا میشونه رو آشیانه خونه حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.72,
   "end": 200.46,
   "text": "بقیه کار دیگه با حضرت زهراست. خسته نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 200.46,
   "end": 204.64,
   "text": "پرورش وجودی شما با حضرت صدیقه شهیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.64,
   "end": 208.44,
   "text": "اصلاً شما برزخ که دارید میرید، برزخ کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.44,
   "end": 214.2,
   "text": "ملکوت عالمه. رتبه مثال بین جبروت و ناسوت یعنی دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.2,
   "end": 216.44,
   "text": "اون عالمه حضرت زهراست. اصلاً اِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.44,
   "end": 220.28,
   "text": "شما وقتی می میری، میری به سمت حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.28,
   "end": 224.8,
   "text": "چی بهتر از این؟ بده آدم بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.8,
   "end": 230.84,
   "text": "پیش مادرش؟ امام صادق فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.84,
   "end": 235.96,
   "text": "شیعیان ما فقط. بله، يا حارس امدان میموت یرنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.96,
   "end": 240.0,
   "text": "هرکی بمیره من و علی رو میبینه که جلاله بذار بترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 240.0,
   "end": 241.66,
   "text": "همه بترسن. باید بترسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.66,
   "end": 244.7,
   "text": "چرا تو دنیا نترسیدی؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 244.7,
   "end": 249.46,
   "text": "از مقام علی حضرت امیر یا خدای منان نترسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.46,
   "end": 254.18,
   "text": "چرا؟ چرا جبروت عالم نگرفتت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.18,
   "end": 257.12,
   "text": "لذا همه بترسن. لذا مولا رو همه میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.12,
   "end": 261.18,
   "text": "اما ولت قبر رو که برای همه پیش میاد لحظه مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 261.18,
   "end": 263.9,
   "text": "فقط برای یه عده برش میدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.9,
   "end": 265.62,
   "text": "شرح صدر میاد کمکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 265.62,
   "end": 268.46,
   "text": "اسماء جمالی میاد آرومش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 268.46,
   "end": 271.08,
   "text": "مثل مادری که بچه‌شو بغل میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 271.08,
   "end": 275.22,
   "text": "اون فقط برای شیعیان امیرالمؤمنینه که حضرت زهرا دست به کار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.22,
   "end": 280.54,
   "text": "امام صادق فرمود حضرت زهرا میاد به بالین تک تک شیعیان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 280.54,
   "end": 285.9,
   "text": "اینو من هم تو کتاب دیدم هم از خود حضرت استاد چندین بار شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.9,
   "end": 289.58,
   "text": "جمال حضرت زهرا رو میبینی و آروم میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.58,
   "end": 294.94,
   "text": "خدا قسم یاد کرده محب علی رو از این دنیا نبره مگر راضیش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.94,
   "end": 296.82,
   "text": "هرچی میگه بیا برو راضی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.82,
   "end": 299.7,
   "text": "میگه بچه‌ام، مادرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.7,
   "end": 304.38,
   "text": "نمی‌دونم گرفتارم، بدهکاری دارم، نماز فلانم قضا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 304.38,
   "end": 308.14,
   "text": "روایت داریم بهشتو نشون میدن. آفرین، آفرین که راضی نمیشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.14,
   "end": 312.9,
   "text": "با بهشت راضی نمیشه، با حورالعین راضی نمیشه، با انهار و اشجار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 312.9,
   "end": 317.56,
   "text": "قصور راضی نمیشه. آخر و آخر و آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 317.56,
   "end": 320.92,
   "text": "فرمودن با جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.92,
   "end": 323.78,
   "text": "جمال حق راضی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.78,
   "end": 327.22,
   "text": "جلالو که همه میبینن. چه مؤمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.22,
   "end": 329.46,
   "text": "چه کافر. با جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.46,
   "end": 331.18,
   "text": "جمال حق راضی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 331.18,
   "end": 333.16,
   "text": "به به. این جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 333.16,
   "end": 338.06,
   "text": "جمال حق کیه جز حضرت زهرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.06,
   "end": 343.7,
   "text": "راضیش می‌کنن می‌برنش. حالا این رساله میاد به ما کمک میده دوستان تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 343.7,
   "end": 348.62,
   "text": "همین نشئه طبیعت ما اینا رو بچشیم و ببینیم و بهش برسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.62,
   "end": 353.22,
   "text": "آشنا بشیم، مرگمون آسون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.22,
   "end": 359.84,
   "text": "دیگه سؤال؟ مطالب مسجد بلال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.84,
   "end": 363.78,
   "text": "چجوری بخونیم؟ مطالب چی رو؟ مسجد بلال رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.78,
   "end": 366.0,
   "text": "از عزیزان آقای گندم‌کار اینجا تشریف دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.0,
   "end": 368.94,
   "text": "آقایون از ایشون کانالو تو ایتا بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 368.94,
   "end": 371.08,
   "text": "آدرسشو. همین عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 371.08,
   "end": 375.48,
   "text": "ماسک زدن. آره شماره موبایل‌هاتونو به آقای گندم‌کار بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 375.48,
   "end": 381.02,
   "text": "خانوما هم به خانم گندم‌کار. کانالی که تشکیل دادن یا حالا گروهو تشکیل دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.02,
   "end": 387.54,
   "text": "اونجا کانال مرام گمنامی هم بهتون معرفی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.54,
   "end": 392.28,
   "text": "خدمت شما عرض کنم چند تا از جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.28,
   "end": 395.48,
   "text": "بله مطالب اینجا هم تو کانال اونجا گذاشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.48,
   "end": 399.76,
   "text": "تو کانال مرام گمنام. چند تا، یه مژده هم بهتون بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.76,
   "end": 410.84,
   "text": "چند تا از اساتید که شاگردان بلا فصل حضرت علامه حسن‌زاده هستن هم تو کانال مرام هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.84,
   "end": 418.24,
   "text": "هم خانوما هم آقایون. چند تا از اساتید فن که شاگردان علامه حسن‌زاده هستن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.24,
   "end": 427.48,
   "text": "تو کانال هستن. دیگه سؤال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.48,
   "end": 429.78,
   "text": "بله مطالب این کلاس هم تو ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.78,
   "end": 434.34,
   "text": "البته ما مثلا جلسه پیشو نه دقیقه شو حذف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.34,
   "end": 437.54,
   "text": "عینا اون چیزی که تو کلاس گفتیمو عینشو تو ک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.54,
   "end": 441.38,
   "text": "تو کانال نمی‌ذاریم. اینم به شما بگم سرتون کلاه نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.38,
   "end": 444.78,
   "text": "بگید خب تو کانال میذارن ما نمیریم تو کلاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.78,
   "end": 451.7,
   "text": "بعضا ما مسجد بلالم از پنج دقیقه حذر داشتیم تا چهل و پنج دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.7,
   "end": 454.54,
   "text": "چهل و پنج دقیقه هم مطالب کلاس رو در گوشی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.54,
   "end": 457.06,
   "text": "اصلا نباید می‌رفته بیرون، حذف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.06,
   "end": 467.52,
   "text": "اینجا هم این اتفاق می‌افته. برای همین خیلی دلمونو-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.52,
   "end": 473.68,
   "text": "بله، اوجش تو حضرت زهراست، جمال و اوجش جلال تو امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.68,
   "end": 476.5,
   "text": "اوجش. دیگه بالاتر از اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.5,
   "end": 481.08,
   "text": "حالا اینا رو تو مراتب عرفان نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.08,
   "end": 483.82,
   "text": "همه رو ما گفتیم. اگر لطف کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.82,
   "end": 487.18,
   "text": "حالا اینجا هم یه چیزایی که مثل امروز عرض می‌کنیم که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.18,
   "end": 489.58,
   "text": "جا بیفته براتون مباحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.58,
   "end": 496.34,
   "text": "ولی برای اینکه قشنگ جا بیفته براتون حتما تو کانال برید روزی یه صوت گوش بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.34,
   "end": 498.98,
   "text": "از اون صوت‌هایی که تو کانال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.98,
   "end": 502.22,
   "text": "معرفت نفس و مسائل دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.22,
   "end": 510.22,
   "text": "بله. بله حتما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.22,
   "end": 511.78,
   "text": "من اولش توصیه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.78,
   "end": 513.9,
   "text": "نمی‌دونم شما شاید تشریف نداشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.9,
   "end": 519.56,
   "text": "اشکالم حتما باید مباحثه کنید با همسرتون، با رفیقتون گروه مباحثه کننده داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.56,
   "end": 522.98,
   "text": "صوت‌ها رو پیاده کنید، بنویسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.98,
   "end": 525.88,
   "text": "اصلا تا این کارا رو نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 525.88,
   "end": 528.74,
   "text": "برکت نمی‌کنه کارتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.74,
   "end": 536.64,
   "text": "اصلا تو خونه‌تون یه کلاس معرفت نفس، یه کلاس سیر و سلوک بذارید با خونوادتون بشینید بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.64,
   "end": 543.02,
   "text": "خیلی‌ها به من گفتن ما عین مطالبی که از شما می‌شنویمو میریم تو خونه برای خانوممون، برای بچه‌هامون میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.02,
   "end": 552.1,
   "text": "این تسبت وجودی برای خودت طرف میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.1,
   "end": 557.78,
   "text": "دیگه سؤال؟ خب الحمد لله دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.78,
   "end": 559.7,
   "text": "کسی سؤال ندارد. استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.7,
   "end": 572.46,
   "text": "جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.46,
   "end": 574.08,
   "text": "اون خودش یه یک و بیست دقیقه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.08,
   "end": 579.02,
   "text": "زمان می‌خواد. الان من بخوام حرف بزنم که دوباره بیست دقیقه باید بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 579.02,
   "end": 589.98,
   "text": "اجازه بدید که جلسه بالاخره هم اول جلسه یادآوری کنید اینو من توضیح بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 589.98,
   "end": 597.64,
   "text": "ببینید الان سؤال شده چقدر می‌توان به خواب‌هایی که می‌بینیم توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.64,
   "end": 600.58,
   "text": "اغراق اگر نکنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 600.58,
   "end": 607.22,
   "text": "اگه اغراق نکنم حداقل پنجاه جلسه در مورد همین موضوع ما حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 607.22,
   "end": 612.42,
   "text": "تو اون کاناله هست. الان من چی بگم از پنجاه جلسه به شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.42,
   "end": 616.16,
   "text": "اصلا یه رساله داره علامه به عنوان رؤیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.16,
   "end": 621.64,
   "text": "یه رساله داره به نام رؤیا. امیدوارم یه روزی بشه ما سر سفره این رساله علامه بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.64,
   "end": 625.02,
   "text": "رؤیا. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 625.02,
   "end": 629.34,
   "text": "این مژده رو به شما میدیم به جهت اینکه بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 629.34,
   "end": 633.82,
   "text": "سیر و، روش‌های سیر و سلوکی که از علامه طباطبایی میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 633.82,
   "end": 637.18,
   "text": "ربط به خواب‌های شما پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.18,
   "end": 640.64,
   "text": "شما باید یه علم کلی به نحوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 640.64,
   "end": 643.72,
   "text": "عبور از ظاهر خواب به باطن پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 643.72,
   "end": 646.92,
   "text": "ما تو مسجد بلال خیلی کلی گفتیم رد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 646.92,
   "end": 649.6,
   "text": "اینجا یه ذره جزئی‌تر، مصداقی‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 649.6,
   "end": 653.38,
   "text": "براتون با لسان خود حضرت استاد میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 653.38,
   "end": 656.68,
   "text": "راه‌های عبور از صور و اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 656.68,
   "end": 660.12,
   "text": "رتبه مثالی که خواب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.12,
   "end": 666.26,
   "text": "به اون حقایق عرشیه که پیام‌های الهیه در خواب به ما القا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 666.26,
   "end": 673.08,
   "text": "راه عبورش رو به شما میگیم. حالا به حرمت این سوالی که از من شده یه جواب کلی من بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.08,
   "end": 676.44,
   "text": "یه ملاک حضرت استاد دارن، اینو یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.44,
   "end": 679.64,
   "text": "یه ملاک کلی. دیگه این آخرین سؤال باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 679.64,
   "end": 682.46,
   "text": "خیلی طول کشید. یه ملاک کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 682.46,
   "end": 685.4,
   "text": "هرکس می‌خواد ببینه آقا این خوابی که دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 685.4,
   "end": 688.92,
   "text": "خواب رؤیا صادقه‌ست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.92,
   "end": 691.86,
   "text": "شیاطین تصرف کردن در خوابش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 691.86,
   "end": 697.44,
   "text": "یا ملائکه بودن؟ تنزل حقایق عرشیه در صغری نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.44,
   "end": 699.72,
   "text": "اعتنا کنه به خوابش یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 699.72,
   "end": 703.9,
   "text": "ممنونم. راه کلیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.9,
   "end": 707.18,
   "text": "بچه‌های مسجد بلال یادشون هست چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.18,
   "end": 712.58,
   "text": "گفتم این راه کلی رو. راه تشخیص اینکه خواب می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 712.58,
   "end": 716.38,
   "text": "بدونی این خواب رحمانیه یا شیطانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 716.38,
   "end": 719.66,
   "text": "رؤیا صادقه‌ست یا کاذبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.66,
   "end": 721.26,
   "text": "آفرین نترسید بگید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.26,
   "end": 725.64,
   "text": "شما اینا رو می‌دونم می‌دونید. ابا می‌کنید بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 725.64,
   "end": 728.3,
   "text": "نفس، نفس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 728.3,
   "end": 732.5,
   "text": "مراتب شناخت نفس اینجا خودشو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.5,
   "end": 736.32,
   "text": "شناخت نفس که شاهراه توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 736.32,
   "end": 740.12,
   "text": "اینو یادتون باشه خواهرها و برادرها هر خوابی دیدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 740.12,
   "end": 744.78,
   "text": "اگر این خواب در شما اثری که گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 744.78,
   "end": 748.46,
   "text": "رشحی از جهنم بود، الان توضیح میدم نترسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.46,
   "end": 750.58,
   "text": "رشحی از جهنم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 750.58,
   "end": 753.76,
   "text": "اون ازغاس أحلامه. اون آشفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 753.76,
   "end": 755.86,
   "text": "هیچ اعتباری بهش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 755.86,
   "end": 761.92,
   "text": "هیچ رگه‌ای از حقیقت از پیام‌های الهی تنزل پیدا نکرده در صغر نفس شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 761.92,
   "end": 766.34,
   "text": "اما اگر رشحی از بهشت در صغر نفس شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 766.34,
   "end": 768.54,
   "text": "ایجاد کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 768.54,
   "end": 771.46,
   "text": "توضیح میدم، اون رؤیا صادقه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 771.46,
   "end": 774.08,
   "text": "اما چه میزانش صادقه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 774.08,
   "end": 779.98,
   "text": "می‌تونه به قول استاد یک رگه‌ای صادقه و یه رگه‌ای از نور پیام الهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 779.98,
   "end": 782.38,
   "text": "می‌تونه کل خواب پیام الهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 782.38,
   "end": 787.38,
   "text": "اون رشحه چیه؟ اگر خواب دیدی احساس انبساط خاطر کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 787.38,
   "end": 790.88,
   "text": "احساس فرح کردی، نشاط گرفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 790.88,
   "end": 795.46,
   "text": "حالت خوشه. دیگه به چه زبانی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 795.46,
   "end": 801.04,
   "text": "این رؤیا صادقه‌ست. اون صور و اشکالی که در خواب دیدی پیام‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 801.04,
   "end": 803.12,
   "text": "اجازه تعریف کردنشو داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 803.12,
   "end": 809.96,
   "text": "نه، نه، نه. اینم به شما میگم به چه کسایی اجازه دارید تع-تعریف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.96,
   "end": 815.54,
   "text": "اونم خودش یه روشه. اما اگر نه حالت بد شد، حالت غرض بهت دست داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 815.54,
   "end": 818.28,
   "text": "اعصابت خورده، حالت خوش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 818.28,
   "end": 821.8,
   "text": "حوصله نداری. این خواب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 821.8,
   "end": 824.58,
   "text": "غیر رحمانیه. رؤیا صادقه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 824.58,
   "end": 826.96,
   "text": "شیاطین دخالت کردن. ازغاس أحلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 826.96,
   "end": 835.12,
   "text": "بسته‌هاییه که شما طی شبانه روز باهاشون محشور بودی تو خواب اومدن سراغت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 835.12,
   "end": 838.46,
   "text": "باز هم والحمد لله رب العالمين صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 838.46,
   "end": 841.56,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}