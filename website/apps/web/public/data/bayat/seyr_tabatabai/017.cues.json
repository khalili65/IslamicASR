   "block": 0
  },
  {
   "i": 93,
   "start": 419.31,
   "end": 422.73,
   "text": "آواره‌ی تنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 422.73,
   "end": 429.49,
   "text": "مونده‌ی برین. آی بیابون گرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 429.49,
   "end": 435.65,
   "text": "مثل اینکه تو بیابونا راحت‌تری از شهر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 435.65,
   "end": 441.41,
   "text": "تو خیمه راحت‌تری از اینکه بیای تو خونه زندگی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 441.41,
   "end": 444.43,
   "text": "وای بر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 444.43,
   "end": 453.35,
   "text": "تو رو هم مثل مادرت از شهر بیرون کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 453.35,
   "end": 456.23,
   "text": "به مادرتم گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 456.23,
   "end": 459.83,
   "text": "از این شهر بیرون برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 459.83,
   "end": 464.03,
   "text": "ما مسئله ناله تو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 464.03,
   "end": 471.23,
   "text": "آخ این آوارگی به ارث رسید به فرزندان زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 471.23,
   "end": 476.35,
   "text": "پسرش ابی عبدالله هم آواره‌ی بیابونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 476.35,
   "end": 481.15,
   "text": "شد. وقتی تو کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 481.15,
   "end": 484.67,
   "text": "سی هزار لشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 484.67,
   "end": 488.25,
   "text": "دورشو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 488.25,
   "end": 493.45,
   "text": "تا صدای غربتش بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 493.45,
   "end": 498.75,
   "text": "کیست مرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 498.75,
   "end": 504.11,
   "text": "یاری کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 504.11,
   "end": 508.87,
   "text": "تو داری ناله می‌زنی. اونا عجیبا با سنگ جواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 508.87,
   "end": 512.95,
   "text": "آقامونو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 512.95,
   "end": 517.31,
   "text": "آخ دور آقامونو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 517.31,
   "end": 522.31,
   "text": "یه جمله بگم نالت بلند بشه بگم به شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 522.31,
   "end": 528.91,
   "text": "غریبگی آوردنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 528.91,
   "end": 532.57,
   "text": "حسین جان لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 532.57,
   "end": 541.33,
   "text": "تشنگی سر بریدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 541.33,
   "end": 548.69,
   "text": "ببخشید مادرش. بیشش آی مادرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 548.69,
   "end": 555.59,
   "text": "روی زمین کشوندنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 555.59,
   "end": 558.95,
   "text": "السلام کسی ساکت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 558.95,
   "end": 562.53,
   "text": "السلام علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 562.53,
   "end": 582.53,
   "text": "ساكن کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 593.15,
   "end": 613.15,
   "text": "حسین. وای حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 614.55,
   "end": 621.13,
   "text": "حسین. وای حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 621.13,
   "end": 623.37,
   "text": "اگه قلب زیاد کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 623.37,
   "end": 628.81,
   "text": "از پدر و مادرت که انقدر قشنگ تو تربیت کردن سر سفره ارباب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 628.81,
   "end": 632.25,
   "text": "یادشون کنی همه با هم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 632.25,
   "end": 635.89,
   "text": "انشاالله همه شو پدر مادر برادر منم فیض ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 635.89,
   "end": 639.21,
   "text": "پدر مادر شما رفتگان تو همه، همه با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 639.21,
   "end": 644.13,
   "text": "السلام علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 644.13,
   "end": 648.51,
   "text": "الحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 648.51,
   "end": 654.09,
   "text": "و علی علی ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 654.09,
   "end": 659.17,
   "text": "حسین و علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 659.17,
   "end": 670.81,
   "text": "اولاد حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 670.81,
   "end": 673.87,
   "text": "اسم العظیم الاعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 673.87,
   "end": 679.65,
   "text": "الهی به مولا و تنا فاطمة الزهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 679.65,
   "end": 685.01,
   "text": "و به مولانا و سیدنا حسین کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 685.01,
   "end": 692.39,
   "text": "یا الله. یا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 692.39,
   "end": 700.95,
   "text": "یا الله. یا الله، یا رحمن، یا رحیم، یا مقلب القلوب ثبت قلبی علی دینک. فرج آقامونو برسون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}