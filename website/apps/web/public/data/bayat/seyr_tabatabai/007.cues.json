 },
 "chapters": [
  {
   "index": 0,
   "title": "## سجده‌ی سوره در نماز مستحب؛ خاکساری برای سوغات",
   "start": 0.0,
   "end": 55.72
  },
  {
   "index": 1,
   "title": "## فنا برای سالک و مقام ویژه‌ی انسان کامل",
   "start": 55.72,
   "end": 179.74
  },
  {
   "index": 2,
   "title": "نکته‌ی دیگر آنکه آنان به مقامی پس از فنا می‌رسند که ما نمی‌توانیم برسیم. آن را چه می‌نامند؟ پیامبر از آن چنین یاد کرد:",
   "start": 179.74,
   "end": 770.44
  },
  {
   "index": 3,
   "title": "## عجله در عمل و شکیبایی در نتیجه",
   "start": 770.44,
   "end": 859.2
  },
  {
   "index": 4,
   "title": "## انجذاب؛ وقتی دست حق تو را می‌برد",
   "start": 859.2,
   "end": 1092.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 2.54,
   "text": "حديث ابتدایی کلاس رو سؤال داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.54,
   "end": 5.66,
   "text": "همون قسمت دعای توسل رو که فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.66,
   "end": 9.7,
   "text": "وارد اعداد و ارقام که شدید بنده نتونستم بنویسم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.7,
   "end": 13.86,
   "text": "اصلا کامل متوجه نشدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.86,
   "end": 16.16,
   "text": "صوت رو تو کانال میذارم خواهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.16,
   "end": 23.08,
   "text": "کانال رو گوش بدید. اعداد و ارقام رو اگه متوجه نشدید یا هر چیز دیگه، تو کانال عضو شید میذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.08,
   "end": 28.02,
   "text": "هم تو کانال بعله اینجا عضو شید هم تو مراسم عمومی همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.02,
   "end": 30.52,
   "text": "اونجا کانال کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.52,
   "end": 32.2,
   "text": "همیشه خدمتتون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.2,
   "end": 35.36,
   "text": "حالا بعضی از صحبت‌ها رو بنده شاید قطع کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.36,
   "end": 39.56,
   "text": "تقطیع کنم، حذف کنم. بعضی اوقات که بیرون نباید بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.56,
   "end": 45.86,
   "text": "دیگه؟ اشاره کردید کههه توی نمازهای مستحبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.86,
   "end": 47.96,
   "text": "سوره سجده رو میتونیم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.96,
   "end": 51.14,
   "text": "اون آیه سجده رو بعد از نماز باید ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.14,
   "end": 54.02,
   "text": "رو سجده انجام داد؟ نه خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.02,
   "end": 60.94,
   "text": "دستوری که حضرت استاد دارن ما در مقدمه، به عنوان یکی از هدایای آن در یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.94,
   "end": 63.04,
   "text": "جلسات مرکز نشر معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.04,
   "end": 66.46,
   "text": "مسجد دلها رو هم عرض کردیم روشش رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.46,
   "end": 74.16,
   "text": "فرمودن کسی میخواد سوغاتی بگیره از خدا، غره راهی ببره بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.16,
   "end": 79.32,
   "text": "خودش رو باید بکوبه در برابر حضرت حق بزنه به خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.32,
   "end": 82.9,
   "text": "بعد می‌فرمایند که در نماز مستحبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.9,
   "end": 86.62,
   "text": "چون در نماز واجب خواندن سوره هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.62,
   "end": 90.7,
   "text": "سجده داره نماز باطله اصلاً حق نداری بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.7,
   "end": 97.0,
   "text": "در نماز مستحبی سوره ای که مثل سوره علق که کوتاه هم هست میخونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.0,
   "end": 101.08,
   "text": "آیه سجده داری که خوندی تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.08,
   "end": 105.16,
   "text": "باید سجده کنی دیگه واجبه. همونجا به عنوان فرمودن خودتو میکوبی زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.16,
   "end": 108.24,
   "text": "نه آهسته سلانه سلانه داری میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.24,
   "end": 116.96,
   "text": "خودتو میکوبی به نیت خاکساری در برابر حضرت حق و درگاه ایشون خودتو میکوبی زمین سجده میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.96,
   "end": 122.7,
   "text": "بعد بلند میشی. بلند که شدی ادامه نماز رو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.7,
   "end": 127.68,
   "text": "به این شکل. که حالا فرمودن سوغاتی‌های خیلی خوبی دست پیدا میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.68,
   "end": 136.62,
   "text": "حالا این تو وسط، تقریبا اواسط رساله علامه طباطبایی این دستور العمل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.62,
   "end": 139.84,
   "text": "ولی خب کسی دوست داشته باشه میتونه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.84,
   "end": 143.8,
   "text": "ماهی یه بار، سالی یه بار انجام بده یه سوغاتی بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.8,
   "end": 145.96,
   "text": "دیگه؟ ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.96,
   "end": 151.0,
   "text": "بله. شما فرمودید که رساله علامه حسن زاده آملی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.0,
   "end": 156.54,
   "text": "علامه طباطبایی اینا فنا-- میرسن به جایی که فناء لله میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.54,
   "end": 161.74,
   "text": "یعنی نهایت کمال انسانی اینه که فناء لله بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.74,
   "end": 165.54,
   "text": "اگر عین-- به این صورت اینا میتونن به اینجا برسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.54,
   "end": 169.82,
   "text": "انسان کامل اونا به کجا میرسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.82,
   "end": 173.84,
   "text": "احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.84,
   "end": 179.54,
   "text": "اولا اینکه خیلی نکته خوبی رو اشاره کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.54,
   "end": 184.0,
   "text": "توی این رساله خود حضرت استاد علامه طباطبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.0,
   "end": 186.6,
   "text": "داره که مقامات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.6,
   "end": 189.58,
   "text": "مقامات حتی ولایت، مخصوص ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.58,
   "end": 194.82,
   "text": "اینم توجه کردین یا نه. در واقع این مقام مختص الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.82,
   "end": 200.34,
   "text": "یعنی شما میتونید به اندازه خودتون وارد محیط ولایت بشید و شما ولی الله بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.34,
   "end": 203.18,
   "text": "البته ولی الله اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.18,
   "end": 206.28,
   "text": "فقط امام معصومه. ولی شما میتونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.28,
   "end": 210.28,
   "text": "این یک نکته. نکته دیگه ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.28,
   "end": 214.38,
   "text": "اونها به مقامی بعد از فنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.38,
   "end": 216.82,
   "text": "میرسن که ما نمیتونیم برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.82,
   "end": 220.38,
   "text": "اون چیه؟ اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.38,
   "end": 224.5,
   "text": "اون رو بهش میگن، ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.5,
   "end": 232.94,
   "text": "مثلاً پیغمبر ازش اینطوری یاد کرد که \"لی مع الله وقت لا يستعانی فيه ملك مقرب ولا نبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.94,
   "end": 236.3,
   "text": "مرسل\". این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.3,
   "end": 241.1,
   "text": "نکره در سیاق نهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.1,
   "end": 243.82,
   "text": "دلالت استثنا میکنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.82,
   "end": 246.82,
   "text": "یعنی همه رو. وقتی میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.82,
   "end": 250.06,
   "text": "\"لی مع الله\" اونم \"وقت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.06,
   "end": 256.28,
   "text": "یه وقت‌هایی هست. یا امام صادق علیه السلام فرمود \"لنا حالات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.28,
   "end": 258.36,
   "text": "یه حالاتی برا پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.36,
   "end": 261.52,
   "text": "حضرت استاد فرمودن پیداست همیشه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.52,
   "end": 265.46,
   "text": "چه، چه اتفاقی میفته؟ اونجا که پیامبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.46,
   "end": 269.98,
   "text": "توی اون مقام و تو اون حقیقت که ما میرسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.98,
   "end": 272.28,
   "text": "\"لا يستعانی فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.28,
   "end": 275.92,
   "text": "ملك مقرب ولا نبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.92,
   "end": 280.64,
   "text": "مرسل\" یعنی نه نبی مرسلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.64,
   "end": 283.36,
   "text": "نه ملک مقربی اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.36,
   "end": 286.44,
   "text": "توانایی همراهی ما رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.44,
   "end": 291.54,
   "text": "بعد حضرت استاد خودشون حضرت علامه حسن-- میگم حضرت استاد یعنی علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.54,
   "end": 293.72,
   "text": "فرمودن که خب شما خودت مگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.72,
   "end": 298.04,
   "text": "نبی رسول نبودی؟ چرا نفی کردی رسالت رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.04,
   "end": 301.06,
   "text": "یعنی هیچ نبی و م-مرسلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.06,
   "end": 303.6,
   "text": "پس خود شما چی هستی اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.6,
   "end": 305.98,
   "text": "می‌فرمود این همون مقامی که او می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.98,
   "end": 309.76,
   "text": "حالا اینجاشو برای فهم بیشتر امام صادق فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.76,
   "end": 313.06,
   "text": "این البته زوده الان بیانش برای من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.06,
   "end": 315.98,
   "text": "همون اول که سؤال فرمودید کلیاتی عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.98,
   "end": 318.72,
   "text": "حضرت فرمود \"نحن هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.72,
   "end": 321.22,
   "text": "وهو نحن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.22,
   "end": 324.02,
   "text": "اما در عین حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.02,
   "end": 326.02,
   "text": "ما مایی، او اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.02,
   "end": 328.82,
   "text": "\"نحن نحن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.82,
   "end": 331.82,
   "text": "وهو هو\" یک رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.82,
   "end": 337.32,
   "text": "اون دیگه ما نمیتونیم بهش برسیم. اون فقط مخصوص انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.32,
   "end": 340.88,
   "text": "که حالا اسامی‌ای دارد در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.88,
   "end": 344.0,
   "text": "هر وادی مثلاً یه اسمی روش گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.0,
   "end": 346.86,
   "text": "این اسامی رو بعداً برای شما توضیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.86,
   "end": 350.5,
   "text": "میدم. دیگه؟ بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.5,
   "end": 355.46,
   "text": "سلامت باشید. اجازه بدید خواهر و آقا دارن سؤال...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.46,
   "end": 361.56,
   "text": "نه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.56,
   "end": 365.72,
   "text": "چون عبای مدرسی میخونن، میگفتن چیزی من متوجه نمیشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.72,
   "end": 371.43,
   "text": "از درس و اینها ولی بعدها چی شد که علامه شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.43,
   "end": 373.53,
   "text": "اتفاقا اولین جلسه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.53,
   "end": 380.47,
   "text": "فرمودن که علامه طباطبایی اذعان کردن من اوایل چی از درس و بحث‌ها متوجه نمی‌شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.47,
   "end": 387.41,
   "text": "اولین جلسه‌ای که ما اینجا داشتیم پایین هم برگزار شد از رو خود کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.41,
   "end": 390.95,
   "text": "از لسان خود علامه طباطبایی همین موضوع رو براتون گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.95,
   "end": 393.69,
   "text": "اگه کسی جلسه اول رو گوش داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.69,
   "end": 399.41,
   "text": "یا بوده یادشه. بوده بودن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.41,
   "end": 401.65,
   "text": "نه اون فرمایش پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.65,
   "end": 406.15,
   "text": "علامه طباطبایی- آفرین، آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.15,
   "end": 408.39,
   "text": "یکی از شاگرداشون هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.39,
   "end": 411.19,
   "text": "مزه مزه میکنه روش نمیشه بپرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.19,
   "end": 414.33,
   "text": "علامه کمکش میکنه میگه بپرس نترس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.33,
   "end": 417.51,
   "text": "عرض میکنه که من شنیدم شما جوونیاتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.51,
   "end": 420.03,
   "text": "اصن درس و بحثو خیلی متوجه نمی‌شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.03,
   "end": 422.47,
   "text": "پس چی شد که شما به این مقامات رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.47,
   "end": 426.43,
   "text": "بعد ایشون تأمل می‌کنند میگن بله درست به شما گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.43,
   "end": 431.05,
   "text": "من تا جایی شد که استادم وقتی دید من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.05,
   "end": 433.85,
   "text": "کمترین نمره رو گرفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.85,
   "end": 438.97,
   "text": "اون همه زحمت برای من کشید و من کلاً رد شدم تو همه دروسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.97,
   "end": 440.81,
   "text": "از همه دروسم پایین‌تر بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 440.81,
   "end": 445.51,
   "text": "سر ما داد کشید که حیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.51,
   "end": 448.91,
   "text": "عم-- اون هم عمر ما رو حیف کردی هم خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.91,
   "end": 452.33,
   "text": "استادش هم شد. مضمون جمله رو کار میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.33,
   "end": 455.93,
   "text": "بعد علامه به عموم ما چیکار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.93,
   "end": 462.67,
   "text": "به کوه‌های اطراف حق به تضرع و زاری و التماس و گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.67,
   "end": 466.03,
   "text": "شکست، شکست. این حالت انکسار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.03,
   "end": 470.23,
   "text": "این نشانه چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.23,
   "end": 473.05,
   "text": "عطش، عطش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.05,
   "end": 476.93,
   "text": "میگه تشنگی کم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.93,
   "end": 480.01,
   "text": "آب کم جی. تشنگی آور به دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.01,
   "end": 483.59,
   "text": "یعنی همین. آب کم جی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.59,
   "end": 488.03,
   "text": "انقدر سراغ آب نرو. تو تشنه باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.03,
   "end": 490.83,
   "text": "چند بار تا حالا اومدن اینو از من پرسیدن دوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.83,
   "end": 494.85,
   "text": "فرمایش علامه رو گفتم اشک تو چشاشون جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.85,
   "end": 496.57,
   "text": "علامه، این جمله علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.57,
   "end": 500.43,
   "text": "هم در شرح مثیر العقول صدر المعتقین تنهایی ازشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.43,
   "end": 503.33,
   "text": "هم در شرح فصوص ابن عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.33,
   "end": 506.21,
   "text": "فکر کنم در اشارات هم ازشون شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.21,
   "end": 508.09,
   "text": "چندین بار ازشون شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.09,
   "end": 511.59,
   "text": "فرمودن دوستان من، عزیزان من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.59,
   "end": 515.03,
   "text": "انقدر که تشنه میگه آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.03,
   "end": 519.79,
   "text": "آب، هزاران برابرش آن، فعان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 519.79,
   "end": 523.57,
   "text": "آب میگه تشنه، تشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.57,
   "end": 526.23,
   "text": "انقدر که گدا میگه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.23,
   "end": 529.57,
   "text": "خدا. آن فعانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 529.57,
   "end": 534.59,
   "text": "هزاران برابرش خدا میگه گدا، گدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.59,
   "end": 539.23,
   "text": "تو تشنه باش ببین چه میکنه ملکوتی عالم برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.23,
   "end": 543.29,
   "text": "بخواه. آدمی که بخواد خودش رو در دیوار میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.29,
   "end": 549.83,
   "text": "خودش رو در و دیوار میکوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.83,
   "end": 554.31,
   "text": "جواب گرفتین از جواب؟ آره ایشون فرمودن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.31,
   "end": 556.79,
   "text": "انکسار و زاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.79,
   "end": 561.31,
   "text": "و خود ملاصدرا اسفار ایشون حیرون کردن علم عقلا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.31,
   "end": 564.39,
   "text": "فرمود اینو من از سجاده و اشک دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.39,
   "end": 567.27,
   "text": "در کهک قم که تبعید شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.27,
   "end": 574.29,
   "text": "اسفار و اون عظمت رو اون چند سالی که اونجا تبعید بود سر سجاده و اشک و دعا و اخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.29,
   "end": 578.13,
   "text": "بسم الله. یه بار شد بریم ضریح امام رئوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.13,
   "end": 580.45,
   "text": "میگیم امام رئوف، امام رئوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.45,
   "end": 584.47,
   "text": "مریضَم، کمردرد دارم، بچم فلان شده، گرفتاری مستاجرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.47,
   "end": 589.75,
   "text": "آقا همه اینا درسته. اما آقا معروفن به عالم آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.75,
   "end": 593.35,
   "text": "سلام بر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.35,
   "end": 597.03,
   "text": "یک بار شد ضریح ایشونو انصافاً بگیریم اشک بریزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 597.03,
   "end": 599.25,
   "text": "هی بگیم العلیییچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.25,
   "end": 601.93,
   "text": "چون نذرش-- نذر عطمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.93,
   "end": 604.33,
   "text": "العلیییی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.33,
   "end": 610.79,
   "text": "یه بار شد ضریح امیرالمؤمنین رو به عنوان کسی که همه حکمت رو که باطن علم خدا بهش داده بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.79,
   "end": 613.97,
   "text": "هی بگیم یا علی، یا علی، یا علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.97,
   "end": 615.73,
   "text": "میدونی ازت چی میخوام؟ بعد چی میکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 615.73,
   "end": 618.15,
   "text": "الحکییییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.15,
   "end": 623.55,
   "text": "من حکمت میخوام. بعد ببین چه بلایی سرت میارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.55,
   "end": 625.41,
   "text": "واقعاً بلا سرت میادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.41,
   "end": 629.27,
   "text": "یعنی خ-- چنان آتیشت میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.27,
   "end": 634.45,
   "text": "صبر کن. تو تشنه باشی چه بلاهایی سرت بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.45,
   "end": 636.31,
   "text": "خودت میمونی از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.31,
   "end": 639.19,
   "text": "چی شد؟ ما هنوز یه ذره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 639.19,
   "end": 642.71,
   "text": "خب اغلب شما لوسانیا هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 642.71,
   "end": 645.03,
   "text": "رفاقتامون اینطوری پیدا نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.03,
   "end": 648.01,
   "text": "مقدار در لفافه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 648.01,
   "end": 652.57,
   "text": "و با احتیاط حرف میزنم. یه ذره نزدیکتر شیم، رفیق‌تر شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 652.57,
   "end": 655.67,
   "text": "من برای شما از تجربیات شخصی خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 655.67,
   "end": 659.19,
   "text": "بگم چه بلاهایی سرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 659.19,
   "end": 663.75,
   "text": "اومد. بگم بعد ببینید که چقدر راحت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.75,
   "end": 668.19,
   "text": "راحت که میگم خیلی سخته اما میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 668.19,
   "end": 672.91,
   "text": "میشه. راحت از این جهت میگم که راحت حله حلقومش میکنی به اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.91,
   "end": 677.83,
   "text": "تو خیلی زجر میکشی، سختی میکشی اما راحت حله حلقومش میکنی به اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 677.83,
   "end": 681.59,
   "text": "دیگه سؤال؟ بفرمایید خواهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.59,
   "end": 690.13,
   "text": "سؤال جدیدی که تو شماره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.13,
   "end": 695.51,
   "text": "قبلش که راجع به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.51,
   "end": 699.95,
   "text": "که آقا ماسد فرمودن که هنوز نتونستم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.95,
   "end": 702.43,
   "text": "ااا یه جورایی اصن در--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 702.43,
   "end": 705.51,
   "text": "نمیتونم وارد این وادی بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 705.51,
   "end": 709.71,
   "text": "یعنی بارها و بار این شش آگه رو خوندم کار کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.71,
   "end": 713.23,
   "text": "و نت-- میخوام ببینم این نتیجه‌ای که خودم گرفتم درسته یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.23,
   "end": 716.21,
   "text": "فکر کردم که من باید همین منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.21,
   "end": 722.79,
   "text": "معرفت نفس رو طی کنم و چون از این منزل دورم اینه که خب اول اول و آخر و ظاهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 722.79,
   "end": 729.51,
   "text": "باطن اینا رو میخونم ولی اونی که باید دستم بیاد که حتی واسم بتونم یادداشت کنم هنوز تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 729.51,
   "end": 731.29,
   "text": "در چیزم مشکل دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 731.29,
   "end": 735.96,
   "text": "میخواستم ببینم به همین دلیل هستش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 735.96,
   "end": 741.28,
   "text": "بله البته که شناخت حضرت حق بدون معرفت نفس امکان پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 741.28,
   "end": 746.66,
   "text": "خودش میگه باید از چهار راه معرفت نفس عبور کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 746.66,
   "end": 751.12,
   "text": "ولی معرفت نفس باید منجر بشه به یک سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 751.12,
   "end": 757.6,
   "text": "عملیات بندگی. عملیات بندگی سیر و سلوکیه که الان تو این رساله ما دست گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.6,
   "end": 761.6,
   "text": "به نظرم سؤال شما یه مقدار عجولانه است خواهرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.6,
   "end": 766.52,
   "text": "باید صبوری کنید و این عطشتون رو با سوالتون دارید نشون میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.52,
   "end": 770.44,
   "text": "اما صبوری کنید. یک شبه و دو شبه و سه شبه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.44,
   "end": 775.38,
   "text": "این فرمایش رو بنویسید اصلاً همیشه در خاطر شریفتون باشه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 775.38,
   "end": 778.3,
   "text": "اگر اینو ندونید خراب‌تون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 778.3,
   "end": 781.28,
   "text": "همین درس و بحث‌ها خراب‌تون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 781.28,
   "end": 785.16,
   "text": "علامه بارها و بارها و بارها اینو به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 785.16,
   "end": 787.8,
   "text": "سوغات امشب ببرید با خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 787.8,
   "end": 791.16,
   "text": "علامه اصلاً زده بارها و بارها فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 791.16,
   "end": 794.24,
   "text": "هرچ-- فرمودن عجول نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 794.24,
   "end": 800.26,
   "text": "هرچی دیرتر بهتون بدم پخته تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 800.26,
   "end": 802.06,
   "text": "عجول نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 802.06,
   "end": 806.54,
   "text": "هرچی دیرتر بهتون بدم پخته‌تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 806.54,
   "end": 809.48,
   "text": "حالا یعنی چی؟ یعنی خودمون رو ول کنیم عجله نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 809.48,
   "end": 812.76,
   "text": "نه، در عملیات بندگی عجول باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 812.76,
   "end": 814.7,
   "text": "تا میتونی زحمت بده به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 814.7,
   "end": 817.84,
   "text": "تلاش کن. البته نسبت به صله‌ی وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.84,
   "end": 822.16,
   "text": "بیشتر از حد وجودی قدم برداری چرت می‌کنی، خراب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 822.16,
   "end": 824.44,
   "text": "اما در حصول نتیجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.44,
   "end": 829.34,
   "text": "در دیدن نتیجه، در رسیدن به نتیجه عجول نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 829.34,
   "end": 833.18,
   "text": "پیشون فرمودن میوه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 833.18,
   "end": 837.66,
   "text": "از درخت وقتی زود بچینی کاله، تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 837.66,
   "end": 840.58,
   "text": "خودت رو تلخ نچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 840.58,
   "end": 843.3,
   "text": "بذار قشنگ پخته بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 843.3,
   "end": 848.28,
   "text": "رو درخت ولایت. برسی اصلاً خودت میفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 848.28,
   "end": 850.56,
   "text": "میوه که رسید میفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 850.56,
   "end": 854.36,
   "text": "خودت میفتی. دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 854.36,
   "end": 859.2,
   "text": "یه سؤال دیگه هم جواب بدیم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 859.2,
   "end": 861.94,
   "text": "آخر درس فرمودین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 861.94,
   "end": 864.9,
   "text": "در مورد مراتب، ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 864.9,
   "end": 866.78,
   "text": "بقا صحبت کردین. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 866.78,
   "end": 870.14,
   "text": "افعال و صفات و اسما و بعد هم ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.14,
   "end": 873.14,
   "text": "ذات. که سه مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 873.14,
   "end": 875.92,
   "text": "محو، تمس و محو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 875.92,
   "end": 880.22,
   "text": "بله. گفتم اسامی‌ای داره که حالا بعداً بهتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 880.22,
   "end": 884.3,
   "text": "اون که در بقا فرمودید ما یک شنیدیم که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 884.3,
   "end": 887.58,
   "text": "مرتبه آخر محو در ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 887.58,
   "end": 890.78,
   "text": "بله. و حالا منتظریم این بقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 890.78,
   "end": 894.34,
   "text": "کجایی اینجا میگیم؟ یعنی در این محو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 894.34,
   "end": 898.74,
   "text": "بقا پیدا میکنن یا در تمس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 898.74,
   "end": 903.98,
   "text": "محو هم؟ نه محو و تمس و محو اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 903.98,
   "end": 907.58,
   "text": "اولاً، ا، برای ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 907.58,
   "end": 913.8,
   "text": "برای مایی که مبتدی هستیم فعلاً یه چیزکی ازشون بدونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 913.8,
   "end": 916.46,
   "text": "چون ما الان هر حال جلو پامونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 916.46,
   "end": 920.44,
   "text": "یه چیزکی ازشون بدون، افق رو پیدا کنیم ما داریم به چه سمتی میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 920.44,
   "end": 924.48,
   "text": "گوشمون آشنا باشه. حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 924.48,
   "end": 927.82,
   "text": "ذاتی رو و صفاتی، اسمایی رو فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 927.82,
   "end": 929.88,
   "text": "افعالی رو فوقش دیگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 929.88,
   "end": 933.22,
   "text": "متوجه‌ش باشیم. فعلاً عجول نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 933.22,
   "end": 936.82,
   "text": "ثانیاً اونجا که شما الان براتون سؤال شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 936.82,
   "end": 940.22,
   "text": "اون مرحله‌ای‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 940.22,
   "end": 943.74,
   "text": "دست حضرت حق میاد دست به کار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 943.74,
   "end": 948.12,
   "text": "و تو رو می‌بره. تو خودت نمیروی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 948.12,
   "end": 950.54,
   "text": "شما یک سلسله عملیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 950.54,
   "end": 953.9,
   "text": "بندگی، سیر و سلوک انجام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 953.9,
   "end": 963.28,
   "text": "باید حداقلش بیست سال زحمت بکشی، ورزش فکری کنی، تحصیل علم کنی، مباحثه کنی، کتاب بخونی، بنویسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 963.28,
   "end": 968.72,
   "text": "قلم بزنی، پیاده کنی، فکر کنی، تأمل کنی، تعقل کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 968.72,
   "end": 970.8,
   "text": "مراقبه کنی، ترک گناه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 970.8,
   "end": 977.38,
   "text": "این چیزایی که تو رساله است. با این‌ها پیش بری رفته، رفته، رفته به یه جایی می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 977.38,
   "end": 981.38,
   "text": "تازه منزل آ-- منزل آیه سی رو هم رد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 981.38,
   "end": 984.66,
   "text": "بعد اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 984.66,
   "end": 990.0,
   "text": "رسیدی به اون مرحله که دیگه اصطلاحاً میگیم دیگه رسید، یعنی رسیده شدی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 990.0,
   "end": 994.64,
   "text": "دیگه وقت افتادنه. میگن اینا وقتی رسید از درخت میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 994.64,
   "end": 1001.52,
   "text": "چی میندازش از درخت؟ درخت میندازش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1001.52,
   "end": 1006.72,
   "text": "خودش میفته؟ چی میندازش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1006.72,
   "end": 1010.22,
   "text": "جاذبه. آفرین جاذبه زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1010.22,
   "end": 1012.42,
   "text": "جاذبه‌ی زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1012.42,
   "end": 1016.3,
   "text": "اینا همه رو حساب اسم‌گذاری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1016.3,
   "end": 1023.36,
   "text": "اون، اون جذب دیگه این جذب 初 ابتدایی که حالت باعده داره نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1023.36,
   "end": 1025.72,
   "text": "اون حالت انجذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1025.72,
   "end": 1032.66,
   "text": "این فرق میکنه با این. مثل اونجا دیگه خود حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1032.66,
   "end": 1036.86,
   "text": "تو رو چنان فانی در وجود خودش میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1036.86,
   "end": 1042.12,
   "text": "که دیگه تو هیچ کس و جز خدا نه میبینی، نه میخوای، نه میچشی، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1042.12,
   "end": 1044.88,
   "text": "میشنوی. از خودت رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1044.88,
   "end": 1048.38,
   "text": "جلوه‌ی حق و وجه الهی میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1048.38,
   "end": 1051.64,
   "text": "اونو بسپر به خدا دیگه. شما الان فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1051.64,
   "end": 1054.98,
   "text": "کاری که مربوط به خودت هست رو انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1054.98,
   "end": 1058.82,
   "text": "تا اون مرحله‌ها. خب اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1058.82,
   "end": 1063.56,
   "text": "چون تقریباً هفت تا، هشت تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1063.56,
   "end": 1067.76,
   "text": "فک میکنم پونزده تا کتاب مونده، پونزده شونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1067.76,
   "end": 1071.1,
   "text": "تا. از خواهرها و برادرها نصف نصف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1071.1,
   "end": 1073.98,
   "text": "هرکی جزوه‌ی خوبی داره بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1073.98,
   "end": 1076.86,
   "text": "نشون بده. ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1076.86,
   "end": 1079.56,
   "text": "هفت تا خانم بیان هفت تا آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1079.56,
   "end": 1082.98,
   "text": "خانم‌ها از اینور بیان، خانم‌ها از این سمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1082.98,
   "end": 1085.6,
   "text": "از این سمت. آقاها هم از این سمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1085.6,
   "end": 1089.44,
   "text": "من ببینم و تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1089.44,
   "end": 1092.94,
   "text": "بیاید اینا رو اجازه باهاتون عقب بیاید اینجا اصلاً یه مقایسه‌ای هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}