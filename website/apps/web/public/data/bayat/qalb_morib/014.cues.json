   "start": 0.54,
   "end": 61.1
  },
  {
   "index": 1,
   "title": "## قرآن معدوبه؛ سید مرتضی و سید رضی",
   "start": 61.1,
   "end": 211.68
  },
  {
   "index": 2,
   "title": "## سفرهٔ آماده؛ ترش کردن از مرض قلب",
   "start": 211.68,
   "end": 325.14
  },
  {
   "index": 3,
   "title": "## داستان آقای بهجت؛ ناصبی و علی‌اصغر",
   "start": 325.14,
   "end": 514.15
  },
  {
   "index": 4,
   "title": "## نسخهٔ علامه؛ کتاب تنزیه الأنبیاء",
   "start": 514.15,
   "end": 549.57
  },
  {
   "index": 5,
   "title": "## آدم و ظلمت‌سرا؛ لطف آمدن به دنیا",
   "start": 549.57,
   "end": 639.19
  },
  {
   "index": 6,
   "title": "## إنی کنت من الظالمین؛ حقیقت ذکر یونس",
   "start": 639.19,
   "end": 937.88
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 5.36,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.36,
   "end": 11.08,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.08,
   "end": 15.28,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.28,
   "end": 18.14,
   "text": "این ماشینایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.14,
   "end": 22.88,
   "text": "که آشغال‌ها رو جمع می‌کنند این ور اون ور می‌برن مال شهرداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.88,
   "end": 25.16,
   "text": "بالاخره آبش میچکه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.16,
   "end": 30.2,
   "text": "گاهی اوقات مردم از کنارشون رد می‌شن یا از اینا از کنار در خونه مردم می‌پاشه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.2,
   "end": 32.24,
   "text": "این آب‌هاش بالاخره چیه جریان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.24,
   "end": 36.18,
   "text": "نجسن، پاکن، چیه؟ رهبر فرمود نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.18,
   "end": 42.1,
   "text": "محکوم به طهارن مگر یقین حاصل بشه به شما که نجاستی اون توئه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.1,
   "end": 46.42,
   "text": "رو صورتش منتقل بشه. اگه یقین حاصل نشد نه پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.42,
   "end": 51.1,
   "text": "حتی این آب‌هایی که رو زمین می‌ریزه مثلا بارون می‌زنه تو خیابون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.1,
   "end": 53.98,
   "text": "یه ماشین میاد رد می‌شه آبش می‌پاشه به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.98,
   "end": 57.06,
   "text": "اینام رهبری می‌فرمایند محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.06,
   "end": 59.26,
   "text": "این اصلا نیاز نداره که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.26,
   "end": 63.18,
   "text": "جا نماز آب بکشیم. اما بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.18,
   "end": 67.28,
   "text": "شکاک و مرید رو رسوندیم به اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.28,
   "end": 70.84,
   "text": "قرآن رو معدوبه یا معدبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.84,
   "end": 72.8,
   "text": "در بر اساس حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.8,
   "end": 76.2,
   "text": "شریف نبوی از کتاب غرر و درر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.2,
   "end": 81.4,
   "text": "مرحوم سید مرتضی علم الهدی که معروف است به الشریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.4,
   "end": 83.48,
   "text": "نقل کردیم. الشریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.48,
   "end": 87.76,
   "text": "دو تا برادر معروف‌اند به شریف، شریف مرتضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.76,
   "end": 90.42,
   "text": "یا سیـ– شریف رضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.42,
   "end": 99.04,
   "text": "اگه شنیده باشید اگه شریف رضی، شریف مرتضی این دو تا برادرن که حالا داستان قشنگی حتما شنیدید که این دو بزرگوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.04,
   "end": 104.36,
   "text": "اِممم شاگرد شیخ مفید بودن تو همون کاظمین هم دفنن هر دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.36,
   "end": 106.98,
   "text": "ظاهرا درب سمت درب شرقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.98,
   "end": 111.16,
   "text": "شیخ مفید هم بغل استادش ابن غلویه قمیه که صاحب کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.16,
   "end": 118.2,
   "text": "شریف کامل الزيارات که قدیمی‌ترین منبع روایات پیرامون بصره، کربلا و عاشورا و هیئتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.2,
   "end": 120.76,
   "text": "و وای به حال مداحی که این کتابو نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.76,
   "end": 122.84,
   "text": "هیئتی که این کتابو نخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.84,
   "end": 125.84,
   "text": "هرچی بخواید. بعد جالبه سند عاشورا هم مال این کتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.84,
   "end": 130.44,
   "text": "این دو کنار همن زریح‌شون رو امام حسین بوسیده بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.44,
   "end": 134.32,
   "text": "گریه کرده دیده شده. حالا بعد گفتیم دیگه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.32,
   "end": 138.46,
   "text": "ما به حاشیه نریم. این دو بزرگوار شا-- شیخ مفید دیگه اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.46,
   "end": 143.5,
   "text": "فقها بود که میگن تا دویست سال بعدش فقها جرات فتوا نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.5,
   "end": 146.04,
   "text": "یه همچین عظمتی داشت شیخ مفید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.04,
   "end": 152.86,
   "text": "علیه الرحمه که بعد ایشون جالبه حالا اینم بدونید یه دفعه نمی‌دونم چرا به این سمت رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.86,
   "end": 155.8,
   "text": "حالا رزق دل شماست که حالا شنیدید شاید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.8,
   "end": 165.12,
   "text": "شیخ مفید شب خواب دید که حضرت صدیقه کبری سلام الله علیها دست حسنین رو گرفته اومده محضر ایشون میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.12,
   "end": 167.48,
   "text": "\"یا شیخ به این بچه‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.48,
   "end": 170.84,
   "text": "به حسنین ما فقه یاد-- علم دین یاد بده.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.84,
   "end": 174.88,
   "text": "بیدار شد. حالا تمسلات برزخی‌ه ببین تا کجا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.88,
   "end": 177.36,
   "text": "حالا خوابای من و شما چه شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.36,
   "end": 179.92,
   "text": "کی میاد تو خواب به ما رو می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.92,
   "end": 181.7,
   "text": "ها؟ اعوان و انصار شیاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.7,
   "end": 185.86,
   "text": "خب ایشالله از شما به دوره. ابا عبدالله تطهیر کنه نفوس ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.86,
   "end": 191.62,
   "text": "حالا الحمد لله چون قبل منبرها تو این دهه روضه خونده می‌شه اینجا من راحت‌تر حرف می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.62,
   "end": 193.8,
   "text": "تطهیر قوا صورت می‌گیره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.8,
   "end": 197.26,
   "text": "اشک برواسه ناله سوختن برای امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.26,
   "end": 199.74,
   "text": "خلاصه تعجب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.74,
   "end": 204.82,
   "text": "در اثناء ظهر قبل ظهر می‌بینه یه خانمی، یه مادری اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.82,
   "end": 209.86,
   "text": "و دست دو تا بچه‌ش رو گرفته آورده به شیخ مفید میگه به این بچه‌های ما علم دین یاد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.86,
   "end": 213.2,
   "text": "اینا کیا بودن؟ سید رضی، سید مرتضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.2,
   "end": 217.7,
   "text": "که حالا اینا بعد در محضر شیخ مفید از بزرگان حالا بحثش گذشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.7,
   "end": 220.14,
   "text": "ش-سید مرتضی علم الهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.14,
   "end": 223.68,
   "text": "که برادر بزرگتر هم بوده ظاهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.68,
   "end": 227.4,
   "text": "این بزرگوار اون معدوبه رو این چنین ترجمه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.4,
   "end": 229.6,
   "text": "می‌فرما طعامی‌ست چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.6,
   "end": 233.14,
   "text": "دیروز حدیثشو خوندیم که قرآن معدوبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.14,
   "end": 237.96,
   "text": "اگه معدوبه بگیریم تو حدیث معدبه هم اومده که ادبستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.96,
   "end": 240.8,
   "text": "معدوبه طعام سفره طعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.8,
   "end": 244.48,
   "text": "سید مرتضی میگه حواستون باشه ها این سفره طعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.48,
   "end": 246.52,
   "text": "یعنی سفره طعام آماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.52,
   "end": 249.04,
   "text": "یعنی همین الان آماده‌ست بفرمایید تناول کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.04,
   "end": 254.54,
   "text": "نه اون غذای مثلا که باید پخته بشه، آماده بشه، طبخ بشه اینا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.54,
   "end": 256.46,
   "text": "الان آماده‌ی تنوله. بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 256.46,
   "end": 262.88,
   "text": "قرآن این چنینه. برای هر کی اشتها داشته باشه \"لَهُم مَا يَشْتَهُونَ\" هرچی که اشتها داشته باشی توش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.88,
   "end": 266.78,
   "text": "بسم الله. سید مرتضی این نکته رو که میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.78,
   "end": 270.68,
   "text": "میگه این طعام آماده‌ست. حالا سؤال چرا من و شما می‌خوریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.68,
   "end": 273.46,
   "text": "چرا من می‌خورم ترش می‌کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.46,
   "end": 276.32,
   "text": "چرا؟ سوهاضمه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.32,
   "end": 279.88,
   "text": "جهاز هاضمه من، قوای هاضمه من مریض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.88,
   "end": 282.34,
   "text": "مریض. چون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.34,
   "end": 286.62,
   "text": "قلبمون دچار مرض شده، مریضی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.62,
   "end": 288.68,
   "text": "درمان نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 288.68,
   "end": 292.9,
   "text": "لذا وقتی قرآن می‌خورم، این طعامو می‌خورم ترش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.9,
   "end": 296.16,
   "text": "شک، ریب میاد پشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.16,
   "end": 298.64,
   "text": "و دچار اصلا تنقیص می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.64,
   "end": 301.6,
   "text": "نقص وارد می‌کنیم. می‌بینیم به قرآن، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.6,
   "end": 306.66,
   "text": "آیات، به چقدر یاد داریم باور کنید از کسایی که ما باشیم جمع‌کران می‌رفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 306.66,
   "end": 312.86,
   "text": "دیوانه امام حسن و ابا عبدالله بودم، خادم هیئت بودن می‌بینم کم هم نمی‌بینم اخیرا متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.86,
   "end": 316.46,
   "text": "البته ما معتقدیم اینا بالاخره ارباب سراغشون رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.46,
   "end": 319.5,
   "text": "یعنی اینطوری حالا واقعا این قل-- حرف قلبی نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.5,
   "end": 322.28,
   "text": "وا به واقع میگیم. یه بار سر سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.28,
   "end": 325.02,
   "text": "با امام حسین نمک بخوری کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.02,
   "end": 327.68,
   "text": "من از خود آقای بهجت این حرفو شنیدم که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.68,
   "end": 333.78,
   "text": "جرن اون ناصبی رو گفت که اِاِاِ رفت حالا یه شیعه مولا علی رو اذیت می‌کرد داستانش بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 333.78,
   "end": 336.88,
   "text": "آقای بهجت فرمودن اینو. نه من مداح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.88,
   "end": 341.16,
   "text": "بعد رفت حرم مولا این شیعت گلایه کرد از این ناصبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.16,
   "end": 344.24,
   "text": "گفت یا علی این هر روز منو اذیت می‌کنه ناسزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.24,
   "end": 347.24,
   "text": "یه چیزی به حضرت فرمود من دست و بالم بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.24,
   "end": 350.14,
   "text": "چرا آخه شما امیر مؤمنانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.14,
   "end": 356.34,
   "text": "پدر اهل علم فرمود که یه روز کنار این آب تو مسیّب هست نهر مسیّب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.34,
   "end": 359.66,
   "text": "سمت دو طفلان مسلم دو شقه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.66,
   "end": 361.64,
   "text": "یه سمت میره کوفه، یه سمت میره کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.64,
   "end": 364.34,
   "text": "اینا اونجا نشسته بود این آبو نگاه می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 364.34,
   "end": 368.93,
   "text": "یک لحظه یاد ابا عبدالله امام حسین ما افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 368.93,
   "end": 375.63,
   "text": "و زیر لب گفتش که آقا خب حسین کشتن تو رو کشتن آ چ دیگه چرا به علی اصغر آب ندادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.63,
   "end": 377.99,
   "text": "آقای بهجت فرمودن و ازشون شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.99,
   "end": 381.45,
   "text": "و یه مثلا دلش سوخت برای حسین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.45,
   "end": 385.75,
   "text": "گفت مثلا علی اصغر چقدر یا خود شما چقدر مثلا آبت میدادن بعد میکشتنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.75,
   "end": 388.29,
   "text": "الله اکبر. امیرالمؤمنین به خاطر همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 388.29,
   "end": 393.11,
   "text": "سوزی که تو دلش نشست، گردن ما حق نداره ما نمی‌تونیم کاریش تو این دنیا نمی‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.11,
   "end": 395.41,
   "text": "الله اکبر. اینا داستان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.41,
   "end": 402.27,
   "text": "یکی مثل آقای بهجت داره این رو تایید می‌کنه و به لسان پاک خودش جاری می‌کنه عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 402.27,
   "end": 405.77,
   "text": "حالا بحث کجا بود به اینجا اومدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 405.77,
   "end": 410.05,
   "text": "هم بچه هیئتا رو می‌بینی اونوری می‌شن انشاالله ابا عبدالله میاد دستشون رو می‌گیره یه روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.05,
   "end": 414.41,
   "text": "اما الان حرفشون چیه؟ می‌گن آقا همه انبیا گناه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 414.41,
   "end": 420.55,
   "text": "از آدم استغفرالله آدمتون بگیر تا بقیه همه حضرت آدم که خطا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.55,
   "end": 423.09,
   "text": "ربنا ظلمنا انفسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.09,
   "end": 426.13,
   "text": "ها؟ نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.13,
   "end": 429.15,
   "text": "می‌گه ولا تقربا هذه الشجرة فتكونا من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.15,
   "end": 437.13,
   "text": "اگه نزدیک تو و حوا نزدیک این زمین این مثلا شجره حالا هرچی که هست بشوید فتكونا من الظالمین ظالمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 437.13,
   "end": 440.11,
   "text": "خب نزدیک شد دیگه. رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.11,
   "end": 443.87,
   "text": "لا تقربا نزدیک نشید. رفت نزدیک شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.87,
   "end": 446.89,
   "text": "حضرت موسی که آدم کشت، آدمکش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.89,
   "end": 451.51,
   "text": "موسی آدم کشت. با یه مشت زدی که اون قبطیه رو کشت و فراری بود اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 451.51,
   "end": 454.45,
   "text": "پیغ-- چه پیغمبریه که فراری بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 454.45,
   "end": 456.67,
   "text": "چیه حالا رفت و بعدش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 456.67,
   "end": 459.05,
   "text": "عرض کنم خدمتتون اون طوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 459.05,
   "end": 462.91,
   "text": "حالا داستانشو می‌دونید. یا حضرت یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.91,
   "end": 468.99,
   "text": "ول کرد رفت مردم افتاد تو شکم ماهی انی کنت من الظالمین هم که اقرار کرده ظالمه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.99,
   "end": 471.91,
   "text": "حضرت ایوب روایات ما می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 471.91,
   "end": 474.13,
   "text": "قرآن می‌گه خب به صبر عظیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 474.13,
   "end": 476.19,
   "text": "به بلای عظیم گرفتار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.19,
   "end": 478.39,
   "text": "بعد حالا حتی بعضی روایات می‌گه که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 478.39,
   "end": 483.93,
   "text": "کرم رو بدنش زده بود کرما رو برمی‌می‌افتاد می‌ذاشت روی بدنش می‌گفت بخورید این روزی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.93,
   "end": 486.79,
   "text": "ببین با ساحت عصمت سازگار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.79,
   "end": 489.27,
   "text": "اینا باید همه ترجمه بشه، معنا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 489.27,
   "end": 492.81,
   "text": "آقا همه شدن که استغفرالله گناهکار و خاطی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.81,
   "end": 495.27,
   "text": "خب ببینید می‌خوام بگم که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 495.27,
   "end": 498.99,
   "text": "در، اگر جهاز هاضمه‌ی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 498.99,
   "end": 503.41,
   "text": "سالم نباشه، مریض باشه ترش می‌کنی که کردن، ترش کردن خیلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 503.41,
   "end": 511.51,
   "text": "الان خیلی فضای مجازی پره از همه آیات قرآن هر به دست می‌گیرن و یه سید مرتضی نمی‌گیم معد ابت الله بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 511.51,
   "end": 514.85,
   "text": "خب؟ حالا دقت بفرمایید یه سند رو کنم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.85,
   "end": 517.41,
   "text": "کتاب لقاء الله‌ش مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.41,
   "end": 523.47,
   "text": "حضرت استاد علامه حسن زاده ببینید چقدر زیبا من و شما رو از این تنقیص بیرون کشیده، نجات داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.47,
   "end": 526.43,
   "text": "راه حل نشون داده. آقا بریم سراغ، سراغ این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 526.43,
   "end": 529.11,
   "text": "که شما چیکار کنی؟ قرآن رو با چی بخونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 529.11,
   "end": 531.25,
   "text": "شما گفتین برای نجات از شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.25,
   "end": 534.59,
   "text": "و قلب مریب باید خودمون رو تحویل به قرآن بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.59,
   "end": 537.41,
   "text": "چگونه؟ هر قرآن خوندنی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 537.41,
   "end": 541.89,
   "text": "هر تحویل دادنی نه، اگه درست قرآن رو نخونی به بیراهه میری ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.89,
   "end": 545.73,
   "text": "و ما نزلنا من القرآن ما هو شفاء ورحمة للمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.73,
   "end": 554.99,
   "text": "بله برای اهل ایمان که دل داده شفاست رحمت اما ولا يزيد الظالمين الا خسارا برای اهل ظلم خسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.99,
   "end": 558.43,
   "text": "بالاخره من ظلم به نفسم کردم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.43,
   "end": 565.57,
   "text": "حالا علامه می‌فرمود علیک فی ذلک بعد از اینکه می‌فرمود بر شما باد به تلاوت قرآن، به قرائت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 565.57,
   "end": 569.77,
   "text": "بعد می‌فرمود علیک داره نجات می‌ده علامه دستگیری می‌کنه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.77,
   "end": 572.37,
   "text": "فی ذلک توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.37,
   "end": 575.71,
   "text": "خوندن حواست باشه دچار تنقیص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.71,
   "end": 579.87,
   "text": "قرآن و نقص وارد کردن به انبیا نشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.87,
   "end": 583.53,
   "text": "نکنه یه وقت ظلم به نفست تو رو به خسارت بکشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.53,
   "end": 587.15,
   "text": "و این طعام رو دل کنی با این طعام و می‌خوای نجات پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.15,
   "end": 589.71,
   "text": "حالا یه نسخه است دیگه نه که فقط این باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.71,
   "end": 593.35,
   "text": "یه نسخه است. علیک فی ذلک بکتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.35,
   "end": 596.29,
   "text": "تنزیه الانبیاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.29,
   "end": 599.07,
   "text": "تنزیه، منزه کردن انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.07,
   "end": 601.65,
   "text": "والائمه مال کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.65,
   "end": 609.37,
   "text": "لسید المرتضی فأن همون سید مرتضی که الان یه کتابی داره به نام تنزیه الانبیاء والائمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 609.37,
   "end": 614.89,
   "text": "این روایات، این آیاتی که از نظر ما نقص وارد می‌کنه به انبیا ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 614.89,
   "end": 621.83,
   "text": "ما رو دل می‌کنیم وقتی اینا رو می‌خوریم، این طعام‌های معنوی و معرفتی رو قشنگ میاد موشکافی می‌کنه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 621.83,
   "end": 623.59,
   "text": "شما نگاهت رو درست کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.59,
   "end": 626.09,
   "text": "منظور لم داره اینا همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 626.09,
   "end": 631.47,
   "text": "اینا همه لم داره. لم‌هاشو یک یک شروع می‌کنه رمز و کنوزش رو بیان کردن سید مرتضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.47,
   "end": 633.43,
   "text": "خب چرا ما این کتاب‌ها رو نخونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.43,
   "end": 639.19,
   "text": "چرا حداقل به توصیه یکی که موافق ماست علامه حسن زاده توجه نکنیم نریم سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 639.19,
   "end": 641.75,
   "text": "بعد گیر می‌کنیم‌ها. باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 641.75,
   "end": 644.59,
   "text": "باورتون بشه حداقل دو نفر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.59,
   "end": 648.51,
   "text": "دوستان نزدیک که برای من خیلی عزیز بودن از بانیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 648.51,
   "end": 655.95,
   "text": "سفره ابا عبدالله یعنی یه گاف می‌زدن، گوساله می‌زدن زمین شب تاسوعا ول کرده بودن رفته بودن یه شب جمعه تا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 655.95,
   "end": 661.13,
   "text": "همین حرفا رو برای من می‌زدن که حضرت آدم خطا کرده چرا ما باید توش رو پس بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 661.13,
   "end": 663.87,
   "text": "باور کنید با همین، با همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.87,
   "end": 667.61,
   "text": "لطفی که علما به ما کردن ما جواباشونو دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 667.61,
   "end": 669.41,
   "text": "صبح نفس راحت کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 669.41,
   "end": 671.75,
   "text": "تا صبح بیدار نشستیم. حرف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 671.75,
   "end": 674.93,
   "text": "گفتن این، اون بنده خدا اقرار کردن که حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.93,
   "end": 679.07,
   "text": "حالا یادم نیست یک سوم یا دو سوم گفتن شبهات ذهنی ما رو برطرف کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 679.07,
   "end": 681.91,
   "text": "من نکردم که. معارف بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 681.91,
   "end": 684.75,
   "text": "باید اینو بعد ببینید جا-جمله رو ببینید علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.75,
   "end": 688.61,
   "text": "می‌فرمود فإنه شفاء الأليل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 688.61,
   "end": 692.09,
   "text": "می‌گن فعلاً الألیل مریضه نمی‌تونه درست راه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 692.09,
   "end": 698.37,
   "text": "شفاء الأليل یعنی قلب مریض شده، قلب شکاکه، مریبه، دچار چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 698.37,
   "end": 701.91,
   "text": "گرفتار شده، طعام خورده رو دل کرده بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 701.91,
   "end": 708.33,
   "text": "س-- از طریق قلم علما، نفس بزرگان اهل معرفت باید قرآن رو یاد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.33,
   "end": 711.29,
   "text": "نه هرکسی خودش پا راه بیفته قرآن بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 711.29,
   "end": 715.77,
   "text": "به بیراهه می‌برش. بعد الحمد لله به فضل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 715.77,
   "end": 720.11,
   "text": "و الحمد الله والمنه من قبلاً چند جلسه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 720.11,
   "end": 724.43,
   "text": "حالا متاسفانه تو سرور ایتا متاسفانه اینا همه پاک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.43,
   "end": 726.57,
   "text": "انقدر به ما پیام برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 726.57,
   "end": 733.26,
   "text": "ادمین کانال پیام میاد که آقا مثلا این چقدر این مباحث به درد ما می‌خوره زیرنویسی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 733.26,
   "end": 736.8,
   "text": "تا چیه بچه‌ها نوشتن ما دسترسی نداریم پاک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 736.8,
   "end": 739.7,
   "text": "خب چه کنیم دیگه پاک شده. باید بچه‌ها نگه داشتن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 739.7,
   "end": 742.14,
   "text": "چند جلسه پیرامون همین تنقیص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 742.14,
   "end": 745.2,
   "text": "و موضوع تنزیه الأنبیاء و ائمه ما حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 745.2,
   "end": 750.04,
   "text": "آیات و بررسیش کردیم. چرا اون معنای خوردن و ظلمت اونجا چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 750.04,
   "end": 753.14,
   "text": "که اصلا حضرت آدم اومد به دنیا برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 753.14,
   "end": 757.72,
   "text": "باید می‌اومد. \"إني جاعل في الأرض خليفة\" من در زمین جعل خلیفه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 757.72,
   "end": 763.78,
   "text": "باید می‌اومد رو زمین و اون ظلمت اینه که دانه در دل ظلمت سرا باید رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 763.78,
   "end": 767.24,
   "text": "بچه تو رحم تاریک مادر باید رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 767.24,
   "end": 769.8,
   "text": "\"يخرجهم من الظلمات إلى النور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 769.8,
   "end": 776.12,
   "text": "دنیا ظلمت داره. باید می‌اومدیم از ظلمت می‌رفتیم در قوس النزول انا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 776.12,
   "end": 779.76,
   "text": "ما در انزل مراتب که جمادیست، خاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 779.76,
   "end": 782.22,
   "text": "سنگ و این‌هاست، شوبه‌ست ما قرار گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 782.22,
   "end": 785.42,
   "text": "انسان در قوس النزول در انزل مراتب قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 785.42,
   "end": 789.06,
   "text": "همه ما جماد، جماد بودیم، نطفه بودیم دیگه خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 789.06,
   "end": 792.52,
   "text": "خب بعد در قوس صعود باید به بالاترین مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 792.52,
   "end": 797.58,
   "text": "این قوس باید طی می‌شد. باید حضرت آدم می‌اومد اینجا باید می‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 797.58,
   "end": 803.86,
   "text": "باید لذا قرآن می‌گه اگه می‌خوای نزدیک این شجره بشی و این شجره همون نماد شجره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.86,
   "end": 808.98,
   "text": "طیبه‌ست که اصلها ثابت و فرعهاها في السماء که قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 808.98,
   "end": 814.04,
   "text": "راهش اینه که بری به دنیا. می‌خواید از بهشت \"كلوا منها حيث شئتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 814.04,
   "end": 816.44,
   "text": "رغدا\" هرچی می‌خوای بخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 816.44,
   "end": 823.04,
   "text": "بخور بخواب این بهشت. اما اگه می‌خوای به بهشت قرب من \"فادخلی جنتی وادخلی عبادی\" برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 823.04,
   "end": 826.22,
   "text": "که حضرت امام می‌فرماید این يا يا ذاتیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 826.22,
   "end": 830.02,
   "text": "یعنی خدا به ذات خودش نسبت می‌ده بهشتشو، عبادشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 830.02,
   "end": 835.54,
   "text": "راهش دنیاست. یعنی اگه حضرت آدم اونجا می‌موند همه ما بهشت بخور بخواب داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 835.54,
   "end": 838.3,
   "text": "بعد یزیدم کنار من و تو می‌خورد می‌خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 838.3,
   "end": 840.54,
   "text": "شمرم کنار من لعنت الله علیهم اجمعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 840.54,
   "end": 842.9,
   "text": "چه بهشتی بود! بخور تو سر من و این بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 842.9,
   "end": 846.06,
   "text": "حضرت آدم بزرگ‌ترین لطفو به من و شما کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 846.06,
   "end": 851.96,
   "text": "آورد تو این ظلمت سرا \"يخرجهم من الظلمات إلى النور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 851.96,
   "end": 855.4,
   "text": "که ما از ظلمت بریم. اینا یک یک حالا من تند و تند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 855.4,
   "end": 862.28,
   "text": "یکیشو یه ذره باز کردم که قبلاً باز کردیم چند جلسه تک تک انبیا را به فضل الهی ما سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 862.28,
   "end": 866.62,
   "text": "اگر به غیر از این بری سمت قرآن \"ولا يزيد الظالمين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 866.62,
   "end": 870.24,
   "text": "إلا خسارا\". بعد می‌گه \"فتكون من الظالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.24,
   "end": 877.36,
   "text": "یعنی باید به جایی برسی اگه می‌خوای به مقام ولایت و شجره طیبه تناول کنی از درخت ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 877.36,
   "end": 882.02,
   "text": "که برسی به حقیقت این ذکر که \"إني كنت من الظالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 882.02,
   "end": 885.84,
   "text": "لا اله الا انت چرا علما می‌گن بزرگ‌ترین ذکر اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 885.84,
   "end": 890.0,
   "text": "لا اله الا انت سبحانك إني كنت من الظالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 890.0,
   "end": 892.02,
   "text": "یعنی به این حقیقت برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 892.02,
   "end": 897.54,
   "text": "که من به قول upstate علامه ماحصل درس و بحثم این شد که جاهلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 897.54,
   "end": 899.52,
   "text": "خدایا بر جهلم بی‌افزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 899.52,
   "end": 904.74,
   "text": "هرچی می‌کنم نمی‌تونم حقیقت عبادت تو رو حق معرفت تو رو ادا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 904.74,
   "end": 907.1,
   "text": "ما عبدناک حق عبادتک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 907.1,
   "end": 909.38,
   "text": "ما عرفناک حق معرفتک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 909.38,
   "end": 911.18,
   "text": "إني كنت من الظالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 911.18,
   "end": 918.9,
   "text": "اگه به این حقیقت برسی که بحث شب قدر گذشت دوستان می‌تونن رجوع کنن به کانالشون تو اونجا هست مفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 918.9,
   "end": 922.24,
   "text": "اون موقع رسیدی به حقیقت اون مایه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 922.24,
   "end": 924.68,
   "text": "ما ازش غافلیم، ازش غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 924.68,
   "end": 927.52,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 927.52,
   "end": 929.78,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 929.78,
   "end": 932.52,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 932.52,
   "end": 935.02,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 935.02,
   "end": 937.88,
   "text": "محمد و عجل فرجهم دیگه شما روضه خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}