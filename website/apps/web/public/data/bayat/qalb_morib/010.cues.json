   "start": 91.26,
   "end": 194.6
  },
  {
   "index": 2,
   "title": "## دو وعاء علم: فکر و قلب",
   "start": 194.6,
   "end": 214.78
  },
  {
   "index": 3,
   "title": "## نشانه‌های تردید در عمل",
   "start": 214.78,
   "end": 464.44
  },
  {
   "index": 4,
   "title": "## ذکر مراتب دارد",
   "start": 464.44,
   "end": 523.22
  },
  {
   "index": 5,
   "title": "## تسبیح غافل و ذکر مشاهدتی",
   "start": 523.22,
   "end": 602.0
  },
  {
   "index": 6,
   "title": "## یقین در نگاه شهید حججی",
   "start": 602.0,
   "end": 881.34
  },
  {
   "index": 7,
   "title": "## نتیجه",
   "start": 881.34,
   "end": 916.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 6.54,
   "text": "و بهی نستعین. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.54,
   "end": 9.34,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.34,
   "end": 11.96,
   "text": "در خصوص این الکل‌ها و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.96,
   "end": 13.94,
   "text": "خب عزیزان خیلی سؤال می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.94,
   "end": 20.32,
   "text": "همون ابتدا ما استفتاء کردیم از دفتر آقا هم اولی که تازه این باب شده بود و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.32,
   "end": 23.94,
   "text": "و البته در استفتائات حضرت هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.94,
   "end": 29.04,
   "text": "که بالاخره ملاک تشخیص اینکه این الکل‌ها نجس‌اند یا نه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.04,
   "end": 33.76,
   "text": "به صورت کلی در با داشتن دو شرط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.76,
   "end": 37.0,
   "text": "الکل نجسه. یکی اینکه مست کننده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.0,
   "end": 39.82,
   "text": "دو اینکه مایع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.82,
   "end": 46.14,
   "text": "بعد حالا اینکه آیا این الکل‌هایی که الان ما استفاده می‌کنیم و در بازار به فروش میره و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.14,
   "end": 48.56,
   "text": "آیا این‌ها، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.56,
   "end": 54.66,
   "text": "در حقیقت همون مصداق اون الکل، الکل نجس هستند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.66,
   "end": 58.28,
   "text": "خب مایع که هستند همون مست کننده‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.28,
   "end": 60.32,
   "text": "خب این مصداقش اینا میشن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.32,
   "end": 68.5,
   "text": "آقا فرمودن از آدم مورد اطمینان اگر بپرسید و بگه نه اینا مشکلی ندارن کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.5,
   "end": 74.44,
   "text": "یعنی برای عامه مردم دیگه تفحص آنچنانی نیاز نداره بری تحقیق کنی تو labratory بذاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.44,
   "end": 80.12,
   "text": "بررسی کنی و نه، همین مقدار کفایت می‌کنه که داره به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.12,
   "end": 86.32,
   "text": "در میان مردم تو همین حکومت اسلامی تحت حکومت اسلامی داره خرید و فروش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.32,
   "end": 91.1,
   "text": "نمی‌خواد دیگه اونطور خودتونو اذیت کنید ان شا الله که پاک هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.1,
   "end": 95.3,
   "text": "خب بحث ما پیرامون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.3,
   "end": 99.68,
   "text": "شکاک یا به عبارتی مریب یا مردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.68,
   "end": 103.42,
   "text": "رسید به جایی که باید خودمون رو تحویل قرآن بدهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.42,
   "end": 106.26,
   "text": "قرآن یکی از اسامیش ذکر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.26,
   "end": 110.54,
   "text": "این و اینجا خیلی این حرف امروزمون خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.54,
   "end": 117.78,
   "text": "یادمه که چندی بار این مثال رو زدیم در ابتدای کتاب آداب الصلاة حضرت امام علیه الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.78,
   "end": 120.4,
   "text": "اونجا میان وقتی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.4,
   "end": 125.88,
   "text": "بحث یقین و عدم یقین و شک و تردید و اینا سخ-سخن به میان میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.88,
   "end": 129.34,
   "text": "حضرت امام علیه الرحمة مثال جالبی می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.34,
   "end": 131.88,
   "text": "میگن که آقا از شما می‌پرسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.88,
   "end": 138.64,
   "text": "که آیا میت می‌تونه بلند شه یقه شما رو بگیره به شما آسیبی برسونه این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.64,
   "end": 143.58,
   "text": "میگی نه نمی‌تونه. توجه کنید علم شما جواب میده که نه نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.58,
   "end": 145.44,
   "text": "مفروضات ذهنی شما میگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.44,
   "end": 148.14,
   "text": "جواب شما محکم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.14,
   "end": 152.26,
   "text": "آیا شب فرقی با روز می‌کنه الا اینکه فقط هوا تاریک شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.26,
   "end": 155.8,
   "text": "میگی نه. باز جا-- علم شما جواب میده نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.8,
   "end": 159.8,
   "text": "سؤال این، اینو امام هسته علیه-- امام رحمة الله علیه می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.8,
   "end": 166.62,
   "text": "اگر دل شب یه میتی رو بگذارن شما هم تنها باشی حاضری باهاش تنها بمونی یه شب تا صبح؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.62,
   "end": 169.22,
   "text": "میگی نه. بازم میگی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.22,
   "end": 170.86,
   "text": "چرا؟ نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.86,
   "end": 173.56,
   "text": "مگر تو علمت جواب نداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.56,
   "end": 177.6,
   "text": "که شب فرقی با روز نمی‌کنه، میت هم نمی‌تونه آسیبی به من برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.6,
   "end": 180.66,
   "text": "چرا حاضر نیستی شب تنها بمونی با یه میت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.66,
   "end": 184.8,
   "text": "میگی نمی‌دونم. نمی‌دونم رو امام جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.8,
   "end": 188.26,
   "text": "فرموده به جهت اینکه جایگاه علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.26,
   "end": 191.06,
   "text": "در وجود انسان دو جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.06,
   "end": 194.6,
   "text": "دو تا جایگاه مبر علم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.6,
   "end": 199.04,
   "text": "جایگاه اول اون وعاء و ظرف اول علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.04,
   "end": 203.52,
   "text": "حوز-- اون حواجس افکاره، فکره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.52,
   "end": 207.72,
   "text": "حوزه حالا به عبارتی میشه گفت مغز انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.72,
   "end": 210.04,
   "text": "جایگاه دوم قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.04,
   "end": 213.94,
   "text": "وقتی ما یک چیزی رو ابتداً یاد می‌گیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.94,
   "end": 219.6,
   "text": "می‌فهمیم و این علم رو به صورت کسبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.6,
   "end": 223.08,
   "text": "حصولی، نه حضوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.08,
   "end": 225.6,
   "text": "کسبی این رو کسب می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.6,
   "end": 227.48,
   "text": "میشه میره در جایگاه اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.48,
   "end": 230.56,
   "text": "جایگاه اول کجاست؟ مغز ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.56,
   "end": 236.52,
   "text": "فکر ما. حالا به عبارتی حواجس افکاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.52,
   "end": 240.04,
   "text": "قوه وهم کمک می‌کنه اون صورت جزئیه‌ش رو بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.04,
   "end": 244.48,
   "text": "قوه عقل کمک می‌کنه مفاهیم کلیه‌ش رو بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.48,
   "end": 249.0,
   "text": "قوه خیال هم براش صورت‌گری ایجاد می‌کنه، تسهیل می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.0,
   "end": 251.24,
   "text": "فهم این رو با صورت‌گری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.24,
   "end": 255.44,
   "text": "تو رو با صور رو چون ما محشوریم با صور و اشکال تو این نشر طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.44,
   "end": 260.76,
   "text": "قوه خیال میاد همون مفاهیم کلیه عقلی رو، همون مفاهیم جزئیه وهمی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.76,
   "end": 264.26,
   "text": "صورت بهش میده تو، تو قوه خیالت اینا رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.26,
   "end": 266.36,
   "text": "اینا دست به دست هم میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.36,
   "end": 273.16,
   "text": "که به صورت یک امر بسیتی در روح شما شکل بگیره، جان بگیره، در سر و سرت بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.16,
   "end": 276.98,
   "text": "چون این عملیات یکی جاش قطع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.98,
   "end": 280.54,
   "text": "یه جاش این سیم اتصالی پاره شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.54,
   "end": 283.4,
   "text": "و لذا این علم از حوز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.4,
   "end": 286.1,
   "text": "حواجس افکار و حوزه فکرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.1,
   "end": 289.46,
   "text": "وارد به حوزه قلبت نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.46,
   "end": 291.64,
   "text": "لذا دچار يق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.64,
   "end": 294.1,
   "text": "در حقیقت شک و تردید شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.1,
   "end": 297.7,
   "text": "باور نکردیم اونچه... این تو همه حوزه ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.7,
   "end": 306.24,
   "text": "الان من اگر شاید خدایی نکرده یه مدیر کلی بیاد بغل من وایسه نمازم با وقتی که اون نیست فرق کنه این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.24,
   "end": 309.68,
   "text": "چرا اینطوریه؟ چرا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.68,
   "end": 314.78,
   "text": "برعکس یه جا اصلاً مدیر کل که میاد یه سری نمیان نماز بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.78,
   "end": 316.66,
   "text": "اینم میگن زشته. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.66,
   "end": 320.52,
   "text": "اصلاً برات نباید مهم باشه که آیا مدیری هست یا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.52,
   "end": 324.4,
   "text": "که تو با بودنش بهتر نماز بخونی یا تو با نبودنش بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.4,
   "end": 326.38,
   "text": "اصلاً این هر دو تاش زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.38,
   "end": 331.54,
   "text": "این حرفا چیه؟ اینا همش نشانه تردیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.54,
   "end": 334.22,
   "text": "رد شده. یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.22,
   "end": 337.32,
   "text": "در حقیقت اتصالات برقرار نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.32,
   "end": 343.22,
   "text": "لذا مجموعه این اتصالات باید، باید همشون با هم برقرار باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.22,
   "end": 347.32,
   "text": "که اگر قوه عقل ادراک کلی بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.32,
   "end": 354.58,
   "text": "بده به قوه خیالت حتی قوه خیالت بر اساس چون محل ذخیره قوه خیال حس مشترکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.58,
   "end": 357.16,
   "text": "تو خودش نمی‌تونه صور و اشکال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.16,
   "end": 360.74,
   "text": "ذخیره کنه. همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.74,
   "end": 363.9,
   "text": "محل ذخیره ادراکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.9,
   "end": 368.72,
   "text": "عقلی خود قوه عقل نیست، جایی‌ست به نام حافظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.72,
   "end": 372.92,
   "text": "که اگر سریع یادت بیاد، یادت رفته اما س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.92,
   "end": 376.2,
   "text": "مثلاً یه مقدار فشار میاری یادت میاد بهش میگن سهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.2,
   "end": 378.88,
   "text": "اگه مطلقا یادت نیاد میگن نسیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.88,
   "end": 381.52,
   "text": "چرا مطلقا یادت نیومد؟ تو اون جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.52,
   "end": 386.32,
   "text": "حافظه که محل ذخیره مدرکات عقلیه مونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.32,
   "end": 388.88,
   "text": "چون این رفت و آمد صورت نگیره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.88,
   "end": 391.58,
   "text": "نگرفته، اتصالات قطع شده، اصلا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.58,
   "end": 394.36,
   "text": "خاک خورده این اطلاعات توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.36,
   "end": 401.78,
   "text": "لذا اونچه که اینو خوب دقت کنید عرض می‌کنم بحث علمیه من دارم زبان کاربردی عرض می‌کنم همه فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.78,
   "end": 406.36,
   "text": "اونچه که باعث می‌شه این اتصالات خوب برقرار بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.36,
   "end": 415.54,
   "text": "و پارگی قطعی رخ نده و این فعل و انفعالات به نحو احسن انجام بشه و ما بتوانیم آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.54,
   "end": 424.08,
   "text": "علم کسب کردیم رو در قلبمون جای بدیم و هیچ وقت هم یادمون نره و همیشه بدله به باور باشه یقین کامل داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.08,
   "end": 427.84,
   "text": "که الان داریم نماز می‌خونیم در محضر حضرت حق هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.84,
   "end": 433.0,
   "text": "هیچ فرقی با اون سحرمون که خلوت در محضر حق هستیم نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.0,
   "end": 438.9,
   "text": "که اونجا اگر، اگر اینجا سوز و گداز تو جماعت دارم تو خلوت هم چرا ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.9,
   "end": 441.66,
   "text": "همین چرایی‌ها همه به خاطر اون پارگی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.66,
   "end": 445.0,
   "text": "اون قطع شدن اطلاعات در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.0,
   "end": 454.52,
   "text": "ارتباطاته. اینجا تنها چیزی که بزرگان فهمیدن باعث می‌شه این رفت و آمدها درست بشه، اتصالات درست برقرار بشه و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.52,
   "end": 459.16,
   "text": "بفهمی آنچه که کسب می‌کنی رو یقین داشته باشی یک چیزیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.16,
   "end": 464.04,
   "text": "یک حقیقتیه اصطلاحاً بهش میگن ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.04,
   "end": 466.04,
   "text": "حالا ذکر مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.04,
   "end": 468.86,
   "text": "همونطور که همه‌ی نظامات هستی مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.86,
   "end": 470.84,
   "text": "خود شخص حضرت علی هم مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.84,
   "end": 477.1,
   "text": "انزلت می‌شه بدن، شامخت می‌شه روح و سر و سر و سر همینطور مراتب محفوظ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.1,
   "end": 482.82,
   "text": "عالم طبیعت، عالم مثال، عالم عقول و عالم الاه همه مراتب دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.82,
   "end": 486.12,
   "text": "و حتی بهشت هم به درجات آیات قرآن مراتب دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.12,
   "end": 489.64,
   "text": "این هم مراتب داره. ذکر از اسم شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.64,
   "end": 492.32,
   "text": "اسم رو با ذکر نباید قاطی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.32,
   "end": 494.66,
   "text": "یه وقت می‌گیم این اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.66,
   "end": 498.62,
   "text": "تو کلمات بزرگان دقت کنید بعضیا میگن این اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.62,
   "end": 502.52,
   "text": "اون خیلی زیرکه اون عالم که میگه این اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.52,
   "end": 505.52,
   "text": "اون عالمی که میاد میگه این ذکر اعظمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.52,
   "end": 507.8,
   "text": "مثل من بچه طلبه نمی‌فهمه چی داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.8,
   "end": 510.68,
   "text": "میگه آقا این ذکر اعظمه. چه ادعایی داری می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.68,
   "end": 513.3,
   "text": "ذکر جاییه که همراه با یقین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.3,
   "end": 517.2,
   "text": "یعنی اون حلقه مفقوده‌ای که میاد کنار اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.2,
   "end": 522.68,
   "text": "و اون رو بدله به ذکر می‌کنه یا ب-- در حقیقت بدله به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 522.68,
   "end": 526.82,
   "text": "ااا میشه گفت اون حقیقت ذکر می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.82,
   "end": 529.7,
   "text": "صرفا در حقیقت اسم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.7,
   "end": 532.44,
   "text": "اسم باید کنار یقین بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.44,
   "end": 535.54,
   "text": "اگر اسم بخواد بشه ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.54,
   "end": 539.1,
   "text": "اسم اعظم بخواد بشه ذکر اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.1,
   "end": 543.12,
   "text": "نیاز است که کنار اسم یقین بیاد بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.12,
   "end": 546.34,
   "text": "حالا ذکر از اسم شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.34,
   "end": 549.68,
   "text": "البته علمیش درستش اینه که بگیم اسم الاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 549.68,
   "end": 555.14,
   "text": "همه‌ی عوالم همه آنچه که از خدا ظهور کرده است اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.14,
   "end": 558.1,
   "text": "یه اسمی روی اون اسم الله گذاشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.1,
   "end": 560.92,
   "text": "که تو بتونی اون اسم الله رو بخوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.92,
   "end": 567.36,
   "text": "لذا می‌شه اسم الاسم. حالا وقتی می‌خوای ذکر رو شروع کنی لاجرم از اسم شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.36,
   "end": 576.04,
   "text": "اگر این اسم همراه با باطن و توجه به باطن باشه، تو رو یواش یواش رفته رفته می‌کشونه به ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.04,
   "end": 579.72,
   "text": "یه مثال بزنم همه فهمش کنن خیالتون راحت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.72,
   "end": 582.8,
   "text": "یه وقت تسبیح دستت می‌گیری هی میگی لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.8,
   "end": 587.74,
   "text": "لا اله-- اصلا توجه نداری چی داری-- توجه هم بکنی حتی خیلی تو دلت نمی‌شینه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.74,
   "end": 591.36,
   "text": "انقدر تضاهوم، افکار مزاحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 591.36,
   "end": 597.36,
   "text": "تو قوه خیالت اومده تشویش ایجاد کرده که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.36,
   "end": 605.24,
   "text": "که هی سؤال می‌شه مرابت-مراتب تطهیر قوه خیال تو-- شما انقدر در حقیقت اهمیت به قوه خیال تو هر قلبی میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.24,
   "end": 610.26,
   "text": "چیه؟ بهترین کار حضرت علامه فرمودن برای تطهیر قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.26,
   "end": 612.2,
   "text": "کار ف-- کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.2,
   "end": 615.56,
   "text": "فکری با دیده عقل. یعنی کار فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.56,
   "end": 617.74,
   "text": "خروج نفس، حرکت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.74,
   "end": 619.94,
   "text": "فکر یعنی حرکت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 619.94,
   "end": 623.1,
   "text": "نفست رو حرکت بدی با تفکر عقلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.1,
   "end": 625.84,
   "text": "به کلمات نظام وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 625.84,
   "end": 630.6,
   "text": "به کلمات. حالا این بحث‌هایی که قبلاً گذشت از نظامات وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.6,
   "end": 635.68,
   "text": "این ذکر رو یه وقت تو دستت تسبیح می‌گیری شروع می‌کنی حتی صلوات اصلا توجه نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.68,
   "end": 637.94,
   "text": "صلوات می‌فرستی یا تسبیح میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.94,
   "end": 640.82,
   "text": "مثلا میگی لا اله الا الله. بچه‌ها اون تلویزیون رو خاموش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.82,
   "end": 643.08,
   "text": "لا اله الا الله. اِ بچه‌ها ارباب رجوع داریم پاشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.08,
   "end": 646.62,
   "text": "لا اله الا الله. این چه ذکریه تو آقا تعطیلش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 646.62,
   "end": 653.16,
   "text": "این ذکر جز این که هیچ خیری-- امیرالمؤمنین صلوات الله علیه می‌فرماید تو این نوع ذکر هیچ خیری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.16,
   "end": 655.8,
   "text": "به قول علامه هم می‌فرماید بسبسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.8,
   "end": 658.44,
   "text": "هی دستش گرفته بسم الله، بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.44,
   "end": 661.52,
   "text": "مخصوصا از کاری هم میگه که این لب می‌جنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.52,
   "end": 664.62,
   "text": "نه لا اله الا الله که اصلا لبم نمی‌جنبه میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 664.62,
   "end": 669.7,
   "text": "ولی یک وقت هست اینجا معنای ذکر خودشو نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 669.7,
   "end": 671.98,
   "text": "یک وقت هست شما میری توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.98,
   "end": 674.98,
   "text": "اون ظلمات ثلاث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 674.98,
   "end": 677.98,
   "text": "بطن مادر که تو دعای عرفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 677.98,
   "end": 681.28,
   "text": "امام حسین صلوات الله علیه می‌فرماید توجه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.28,
   "end": 687.1,
   "text": "حرکت جنین از اون سه تا ظلمت رو دقت می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 687.1,
   "end": 692.38,
   "text": "اصلا عظمتی از خدا توی جنین در بطن مادر می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.38,
   "end": 698.16,
   "text": "به یکباره یا اصلا تو کلمات وجودی توی عقرب، توی سوسک، توی موش، توی یه مورچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.16,
   "end": 701.84,
   "text": "توجه می‌کنی یک عظمتی رو می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.84,
   "end": 708.42,
   "text": "یک جلالتی رو مشاهده می‌کنی ناخودآگاه میگی سبحان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 708.42,
   "end": 712.26,
   "text": "مثلاً یه دونه رو پات می‌کوبی. لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.26,
   "end": 716.58,
   "text": "یه در حقیقت درکی به تو اضافه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.58,
   "end": 720.0,
   "text": "نه مفروض ذهنی، نه یک لفظی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 720.0,
   "end": 723.44,
   "text": "صوت عرضی‌ست و کم مسموعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 723.44,
   "end": 725.9,
   "text": "نه شنیداریه مربوط به عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.9,
   "end": 728.56,
   "text": "نه یک درکی می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.56,
   "end": 731.94,
   "text": "میگی ناخودآگاه میگی سبحان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.94,
   "end": 739.4,
   "text": "این اصل ذکره. این که اگر کسی به اینجا رسید تقویت کرد خودش رو و تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 739.4,
   "end": 746.22,
   "text": "کلمات وجودی نظام هستی اعم از خودش رو به گونه‌ای دید که دائماً در حیرت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 746.22,
   "end": 750.82,
   "text": "که الرب زدنی فیك تحیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 750.82,
   "end": 753.54,
   "text": "پیغمبر از خدا میگه به من تحیر که هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 753.54,
   "end": 757.34,
   "text": "در حقیقت حیرت ثمره‌ی علمه ایجاد شد براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 757.34,
   "end": 761.6,
   "text": "علامه می‌فرماید این دیگه به ذکر رسیده، ذکرم رد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 761.6,
   "end": 765.52,
   "text": "یعنی اصلاً خودش یک‌پارچه شده ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.52,
   "end": 769.46,
   "text": "چنین کسی هیچ‌وقت دچار تردید و ریب شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 769.46,
   "end": 772.26,
   "text": "من داشتم فکر می‌کردم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 772.26,
   "end": 776.6,
   "text": "نقطه پایانی بحثو نگاه کنید تو قوه خیال تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 776.6,
   "end": 779.58,
   "text": "اون کلیپ‌هایی که از شهید حججی اول پخش شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 779.58,
   "end": 784.24,
   "text": "چرا همه رو منقلب کرد؟ تو نگاه این شهید هیچ تزلزلی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 784.24,
   "end": 788.02,
   "text": "داعش هرکی رو می‌گرفت می‌زد تو سرش، سرش رو خم می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 788.02,
   "end": 791.4,
   "text": "حتی اون دو تا سرباز ترکیه ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 791.4,
   "end": 797.24,
   "text": "خدا لعنتشون کنه قلاده بسته بودن به س-- گردنشون مثل سگ دور از جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 797.24,
   "end": 801.78,
   "text": "چهار دست و پا گفتن رو زمین راه برید بعد سوزوندنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 801.78,
   "end": 803.9,
   "text": "یعنی همش حقارت، تحقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 803.9,
   "end": 807.04,
   "text": "اما این شهید سینه جلو من تنها شهیدی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 807.04,
   "end": 810.24,
   "text": "دیدم، یعنی تنها کسی حالا کلیپی بود که پخش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 810.24,
   "end": 812.56,
   "text": "این شهید مطلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 812.56,
   "end": 816.38,
   "text": "نه که سرش پایین نباشه که هیچی چشمش هم نشانه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 816.38,
   "end": 820.7,
   "text": "مثلاً ضعف و تزلزل و تردید و اینا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 820.7,
   "end": 824.02,
   "text": "حتی اون سرداری که ما باهاش صحبت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 824.02,
   "end": 827.24,
   "text": "تنها کسی بود که حالا کلیپ لحظه شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 827.24,
   "end": 830.12,
   "text": "آیشونو دیده بوده بعد حذفش کرده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 830.12,
   "end": 832.98,
   "text": "و با پدر شهیدم من نجف‌آباد صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 832.98,
   "end": 837.6,
   "text": "فرمودن هرچی می‌زنن شکنجه که این شهید و پاشو بسته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 837.6,
   "end": 841.66,
   "text": "که مثلاً این حرف بزنه حداقل اظهار ندامت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 841.66,
   "end": 850.86,
   "text": "مطلقا. 이제 یکی از دلایلی که کلیپ لحظه شهادت شهید حججی پخش نشد توسط داعش همین بود که مطلقا اظهار ندامت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.86,
   "end": 854.56,
   "text": "ش-- در حقیقت می‌شه گفت رجزخوانی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 854.56,
   "end": 859.94,
   "text": "اینام پخشش نمی‌کنن دیگه. چی باعث می‌شه این شهید مطلقا متزلزل نشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 859.94,
   "end": 862.3,
   "text": "تو نگاهشم تزلزل نباشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 862.3,
   "end": 866.44,
   "text": "که وقتی هم که اون داعشی با کارد میاد کارو تموم کنه، می‌خنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 866.44,
   "end": 871.18,
   "text": "شهید حججی اون لحظه میبینه که اومد دیگه مثلاً اینو به آرزوش برسونه می‌خنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 871.18,
   "end": 873.66,
   "text": "میگه خدایا کمکم کن فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 873.66,
   "end": 879.0,
   "text": "ببینید این با-- در حقیقت یقین در وجودش مستقر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 879.0,
   "end": 881.34,
   "text": "مطلقا شک و تردید وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 881.34,
   "end": 883.02,
   "text": "پس نتیجه بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 883.02,
   "end": 888.18,
   "text": "برای خروج از قلب مردد و مریب یا شکاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 888.18,
   "end": 891.8,
   "text": "و رسیدن به قلب دارای یقین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 891.8,
   "end": 896.46,
   "text": "ذکر بهترین کاره که یکی از اسامی قرآن ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 896.46,
   "end": 898.6,
   "text": "خودمون رو تحویل قرآن بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 898.6,
   "end": 900.84,
   "text": "با توجه، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 900.84,
   "end": 905.2,
   "text": "نظره، با نظر کردن که حالا اینو باید ترجمه کنیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 905.2,
   "end": 907.62,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 907.62,
   "end": 910.96,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 910.96,
   "end": 916.26,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}