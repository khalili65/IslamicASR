 "chapters": [
  {
   "index": 0,
   "title": "## تکبیرة الإحرام مأموم پس از امام",
   "start": 0.2,
   "end": 30.18
  },
  {
   "index": 1,
   "title": "## قلب مریب؛ أشد شک در تسنیم",
   "start": 30.18,
   "end": 376.44
  },
  {
   "index": 2,
   "title": "## دعوت قرآن؛ برهان و ذکر",
   "start": 376.44,
   "end": 461.1
  },
  {
   "index": 3,
   "title": "## سه راه عبور به باطن قرآن",
   "start": 461.1,
   "end": 751.63
  },
  {
   "index": 4,
   "title": "## هدیه از هزار و یک کلمه؛ مس ظاهر",
   "start": 751.63,
   "end": 1093.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.2,
   "end": 3.96,
   "text": "و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 7.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.1,
   "end": 11.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.2,
   "end": 16.08,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.08,
   "end": 23.74,
   "text": "چون فرمودن که احکام جماعت رو دو مرتبه مرور کنیم اگرچه ما گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.74,
   "end": 26.08,
   "text": "از ابتدا نکته‌ای رو عرض کنم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.08,
   "end": 28.5,
   "text": "بهت، از شما خواهش می‌کنم به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.5,
   "end": 33.0,
   "text": "یه هدیه‌ای که می‌خوام تو بحث به شما از طرف از تعلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.0,
   "end": 36.04,
   "text": "تقدیم کنم امروز رو حوصله کنید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.04,
   "end": 38.84,
   "text": "یه چند دقیقه‌ی دیرتر تشریف ببرید بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.84,
   "end": 41.1,
   "text": "از بحث نرید حیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.1,
   "end": 44.36,
   "text": "دعوته. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.36,
   "end": 47.62,
   "text": "خب اجزای نماز عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.62,
   "end": 51.24,
   "text": "نباید مأموم جلوتر از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.24,
   "end": 54.96,
   "text": "ورود کنه به اجزا حتی تکبیرة الاحرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.96,
   "end": 61.04,
   "text": "قبلاً اینجا دیده می‌شد چند بارم من تذکر دادم باز یه بنده خدایی رعایت نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.04,
   "end": 64.14,
   "text": "حالا الحمد لله الان دیگه ما نمی‌شنویم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.14,
   "end": 68.7,
   "text": "تا رای الله اکبر تکبیرة الاحرام امام تموم نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.7,
   "end": 73.14,
   "text": "مأموم حق گفتن الف الله اکبر رو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.14,
   "end": 75.94,
   "text": "و که اگر بگه نمازش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.94,
   "end": 80.78,
   "text": "باید صبر کنه الله اکبر اون رای الله که تموم شد بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.78,
   "end": 84.34,
   "text": "شروع کنه الله اکبر گفتن که اگر بگه نمازش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.34,
   "end": 87.32,
   "text": "یعنی اگر دید متوجه شد زودتر گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.32,
   "end": 89.78,
   "text": "باید نمازشو بشکنه از نو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.78,
   "end": 94.6,
   "text": "اینا بالاخره آدابی داره که اسراری هم دارن این آداب که ماها بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.6,
   "end": 99.08,
   "text": "خب بحث ما پیرامون قلب مرید بود که گفتیم مرید رو حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.08,
   "end": 106.04,
   "text": "آقای جوادی آملی در تفسیر تسنیم‌شون أشد شک بیان می‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.04,
   "end": 107.64,
   "text": "می‌برنش سمت اون آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.64,
   "end": 111.28,
   "text": "الم را لکل کتاب لا ریب فیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.28,
   "end": 114.82,
   "text": "یه مقدمه ای اینجا بچینم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.82,
   "end": 118.58,
   "text": "نبودن، شایسته نبودن شک در قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.58,
   "end": 124.4,
   "text": "این که اصلاً در حقیقت قرآن نمیشه شک کرد رو دیروز عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.4,
   "end": 134.04,
   "text": "حالا چرا در قرآن شایسته نیست که شک کرد یا به عبارتی در قرآن اصلاً چیز مشکوکی وجود نداره که تو بخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.04,
   "end": 137.82,
   "text": "شک کنی چه برسه به أشد شک یعنی ریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.82,
   "end": 140.96,
   "text": "اولاً قرآن به تعبیر حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.96,
   "end": 146.3,
   "text": "جوادی آملی حفظه الله تعالی دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.3,
   "end": 150.84,
   "text": "بعد داره همه آیات روی هم از یک معنا به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.84,
   "end": 156.76,
   "text": "یک بعد دعوی، دعوتشه یک بعد دعواشه یا ادعای قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.76,
   "end": 159.4,
   "text": "ادعای قرآن اینه که این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.4,
   "end": 164.9,
   "text": "این کلام الله، این وحیه، این تنزیله، این تلقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.9,
   "end": 169.08,
   "text": "إنک لتلقى القرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.08,
   "end": 174.38,
   "text": "نزل به الروح الامین علی قلبک یعنی توسط روح الامین آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.38,
   "end": 177.58,
   "text": "تنزل الون إنا أنزلناه في ليلة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.58,
   "end": 183.7,
   "text": "اینا ادعای قرآنه، دعوی قرآنه، خب که درش هم صادقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.7,
   "end": 189.22,
   "text": "و به هر حال آیاتی هم این رو داره تصریح می‌کنه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.22,
   "end": 195.04,
   "text": "شنیدن این کلام الله که ادعای قرآنه، قرآن تصریح داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.04,
   "end": 198.4,
   "text": "که خیلی مهمه شنیدن این کلام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.4,
   "end": 201.5,
   "text": "مثلاً آیه شش توبه می‌فرمود و إن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.5,
   "end": 205.7,
   "text": "دقت بفرمایید به کی داره میگه، به پیغمبر در خصوص کی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.7,
   "end": 211.42,
   "text": "و إن أحدا من المشرک-- أحدا من المشرکین استجارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.42,
   "end": 217.98,
   "text": "عجب! فأجره حتی اگه مشرکین اومدن به تو پناه آوردن پناه بهشون بده که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.98,
   "end": 220.58,
   "text": "چرا بخوای به مشرکین پناه بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.58,
   "end": 226.98,
   "text": "حتی یسمع کلام الله برای اینکه بشنوند کلام خدا رو نشنیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.98,
   "end": 229.36,
   "text": "خیلی جالبه می‌فرمایند ثم أبلغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.36,
   "end": 232.18,
   "text": "مأمنه بعد به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.18,
   "end": 234.84,
   "text": "پناهگاهشون سوقشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.84,
   "end": 240.64,
   "text": "والک بأنهم قوم لا يعلمون نمی‌دونن بسیاری از مردم باور کنید نشنیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.64,
   "end": 243.72,
   "text": "شما شاید باورتون نشه چون با قرآن معنوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.72,
   "end": 246.5,
   "text": "نشنیدند آیات قرآن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.5,
   "end": 248.2,
   "text": "حالا من نمی‌خوام خاطره‌گویی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.2,
   "end": 249.82,
   "text": "بدم هم میاد تو منبر سوءاستفاده...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.82,
   "end": 252.02,
   "text": "اما تو از حرم حضرت عبدالعظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.02,
   "end": 259.26,
   "text": "حسنی علیه السلام معمولاً سعی می‌کنم بدون لباس روحانیت برم چون انقدر می‌ریزن اونجا سر آدم اصلاً وقت نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.26,
   "end": 262.42,
   "text": "زیارت کنه. یه بار رفتیم جوونا دور ما رو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.42,
   "end": 269.42,
   "text": "حالا ما وسط زیارت و. سؤالات این‌ها معلوم بود یک دونه از آیات قرآن رو نخوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.42,
   "end": 271.24,
   "text": "من به زرت قاطع میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.24,
   "end": 279.14,
   "text": "اصلاً نمی‌دونستن ما در قرآن آیاتی داریم بر حرمت شراب‌خواری، بر حرمت زنا، بر حرمت-- نمی‌دونستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.14,
   "end": 282.86,
   "text": "که من اونجا قرآن رو براشون باز کردم باور نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.86,
   "end": 285.16,
   "text": "حالا ما به اون سمت نریم بحثمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.16,
   "end": 289.24,
   "text": "به حاشیه نره. آیه صد و نود و سه شعرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.24,
   "end": 293.6,
   "text": "نزل به الروح الامین علی قلبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.6,
   "end": 295.96,
   "text": "که علی قلبک آیه بعدشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.96,
   "end": 298.84,
   "text": "خب این ته-- این چیه قرآنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.84,
   "end": 301.92,
   "text": "در حقیقت ادعای قرآنه، دعوی قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.92,
   "end": 304.52,
   "text": "که دع-- عرض شود اد-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.52,
   "end": 307.52,
   "text": "ادعاییه که قرآن داره می‌کنه این کلام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.52,
   "end": 316.54,
   "text": "برای اینکه بفهمونه به ما هیچ گونه شکی اصلاً و ابداً راه نداره و شایسته شک کردن نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.54,
   "end": 320.36,
   "text": "خداوند تهدی کرده. تهدی قرآن رو من یک نمونه براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.36,
   "end": 322.4,
   "text": "چند جا اومده چون وقت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.4,
   "end": 325.26,
   "text": "یه نمونه. سوره بقره آیه بیست و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.26,
   "end": 329.8,
   "text": "إن کنتم في ريب مما نزلنا في ريب مما نزلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.8,
   "end": 332.24,
   "text": "اگه توی شد، شد، شکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.24,
   "end": 334.28,
   "text": "اون ش-شدت شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.28,
   "end": 339.16,
   "text": "هستید که این نزلنا ما نازلش کردیم على عبدنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.16,
   "end": 342.24,
   "text": "بسم الله فأتوا بسورة من مثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.24,
   "end": 345.54,
   "text": "یه سوره ای مثلشو بیارید و ادعوا شهداءكم من دون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.54,
   "end": 348.28,
   "text": "به جز خدا هرکیو می‌خواید فرا بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.28,
   "end": 351.14,
   "text": "خب این داره تهدی قرآن بر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.14,
   "end": 353.58,
   "text": "بر اون ادعای قرآنه که نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.58,
   "end": 356.96,
   "text": "حالا اومدن یه خودشونو مضحکه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.96,
   "end": 361.32,
   "text": "اومدن یه سوره ای هم ساختن الکی که والفیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.32,
   "end": 367.5,
   "text": "و، وما الفیل و ما أدراک ما الفیل والخرطوم الطويل یه همچین چیزی حالا تو ذهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.5,
   "end": 370.72,
   "text": "آره آره، آره یه هم چیز از ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.72,
   "end": 373.64,
   "text": "خیلی بچه بودم و اینو دیدم تو ذهنم اینطوری مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.64,
   "end": 376.24,
   "text": "حالا خودشونم مضحکه قرار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.24,
   "end": 384.16,
   "text": "اما در خصوص دعوت قرآن حالا به عنوان نمونه آیه چهار سوره احزاب \"والله یقول الحق وهو یهدی السبیل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.16,
   "end": 389.58,
   "text": "خدا هرچی میگه حقه که این کلام الله شه بعد دعوته، یهد السبيله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.58,
   "end": 391.52,
   "text": "به راه دعوت میکنه تو رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.52,
   "end": 394.22,
   "text": "راه جلو پات میگذاره. دعوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.22,
   "end": 398.14,
   "text": "که به صورت کلی میشه گفت اگر احکام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.14,
   "end": 402.5,
   "text": "اِاِاِ مجزا کنیم مثلا به صورت کلی میشه گفت همون توحید و نبوت و ام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.5,
   "end": 404.6,
   "text": "معاد. این سه اصل اساسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.6,
   "end": 406.64,
   "text": "قرآن دعوته به سمت ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.64,
   "end": 409.34,
   "text": "بعد برای تهدی قرآن اینجا چی میفرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.34,
   "end": 412.74,
   "text": "آیه صد و یازده بقره \"هاتوا برهانکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.74,
   "end": 415.22,
   "text": "برای دعوت برهان میخواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.22,
   "end": 418.84,
   "text": "اساس عقلی میخواد. چون دعوته دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.84,
   "end": 421.14,
   "text": "ادعا دیگه اینجا نیست. دعوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.14,
   "end": 424.58,
   "text": "\"هاتوا برهانکم ان کنتم صادقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.58,
   "end": 430.62,
   "text": "در آیه بیست و چهار انبیا میفرماید \"هذا ذکری من معي وذكر من قب-قب-قبلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.62,
   "end": 434.62,
   "text": "این هم ذکره. الانه آنچه که الان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.62,
   "end": 438.66,
   "text": "و به اتفاق الان هست، معي به اتفاق من است و هم قبلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.66,
   "end": 443.6,
   "text": "هرچی که هست که از اینجا معلوم میشه قرآن علم ماکان و مایكون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.6,
   "end": 448.54,
   "text": "یعنی تمام ع-علم درش جمع شده که \"من اراد علم الاولین والاخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.54,
   "end": 452.78,
   "text": "فلیأته من القرآن\". شخ-- بذار قرآن رو پیدا کن این علوم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.78,
   "end": 456.08,
   "text": "همه چی تو قرآنه. ما توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.08,
   "end": 460.76,
   "text": "ظاهرش حقه، باطنش حقه، ظاهرش سره، باطنش سر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.76,
   "end": 464.58,
   "text": "به قول علامه ظاهرشم کنزه، رمزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.58,
   "end": 471.08,
   "text": "چه برسه به باطنش. که حالا برای رسیدن به این ما یه زمانی چندین جلسه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.08,
   "end": 473.98,
   "text": "یازده ده دوازده جلسه در هیئت یا زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.98,
   "end": 479.24,
   "text": "تو تهران حدود پنج جلسه اگر اشتباه نکنم در محضر شهید حجتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.24,
   "end": 483.28,
   "text": "چند جلسه همینجا در صدا و سیما پیرامون عبور از ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.28,
   "end": 490.16,
   "text": "به باطن قرآن بر اساس ده تا نظر ملا صدرا در مفاتيح الغیبش حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.16,
   "end": 492.84,
   "text": "که نشد بحثم جمع کنیم و رها کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.84,
   "end": 498.68,
   "text": "اونجا یه صحبتی کردیم برای بعضیا سؤال پیش اومد این هدیه‌مونو تقدیم کنم که آقا چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.68,
   "end": 505.1,
   "text": "قرآن رو باید بخونیم. خب یه بحث قرآن روحانی، روان خوانی، تجوید، لهجه، صوت، نمی‌دونم اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.1,
   "end": 510.9,
   "text": "اجزاء روش توجه به قول رهبر عزیزمون مقدمه رسیدن به باطن و مفاهیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.9,
   "end": 514.72,
   "text": "بعد مفهوم خوانی، تفسیر خوانی، تأویل اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.72,
   "end": 518.98,
   "text": "اینا حالا همه‌ی اینا میشه گفت یه راه‌هایی‌اند ولی همه راه نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.98,
   "end": 521.66,
   "text": "بعد میری سراغ اینکه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.66,
   "end": 528.72,
   "text": "ز-از ظاهر قرآن به کمک راه حل‌هایی که بزرگان گفتن عبور کنی به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.72,
   "end": 532.6,
   "text": "قبلاً گفتیم حالا من سه راه، سه روش رو به شما میگم که چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.6,
   "end": 537.5,
   "text": "ما محور بحثمون نظرات حضرت علامه، این استاد کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.5,
   "end": 541.32,
   "text": "علیه الرحمه هست اجازه بدید از نظرات ایشون استفاده کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.32,
   "end": 543.62,
   "text": "و الا راه‌های دیگه‌ای هم بزرگان گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.62,
   "end": 545.26,
   "text": "یه راهش توجه عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.26,
   "end": 547.62,
   "text": "توجه عرفانی چند جلسه درباره‌ش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.62,
   "end": 553.7,
   "text": "مثلاً شما بعد از مخصوصاً نماز صبح بهترین وجه، وقت توجه عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.7,
   "end": 555.92,
   "text": "در سکوت مطلق هیچ‌چی هم نمیگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.92,
   "end": 559.16,
   "text": "توجه می‌کنی به یک آیه از جهت مفهومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.16,
   "end": 561.6,
   "text": "اونچه که از یک آیه می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.6,
   "end": 568.48,
   "text": "بعد میری مطلقا به هیچ چیزی جز اون مفهوم اون آیه فکر نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.48,
   "end": 572.16,
   "text": "می‌برنت دیگه. یعنی متو-- آهسته، آهسته از همین جا شروع می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.16,
   "end": 575.48,
   "text": "می‌شینی به توجه عرفانی. فکرتو تخلی می‌دی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.48,
   "end": 583.0,
   "text": "این قوه خیالت رو، اون مخصوصاً از متخیلات فاسده باید پاک‌سازی بشه که قبلاً بحثش گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.0,
   "end": 586.5,
   "text": "بعد می‌بینی یواش، یواش تو رو می‌کشونن، می‌برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.5,
   "end": 589.08,
   "text": "به جاهایی که منتهی می‌شه به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.08,
   "end": 592.0,
   "text": "حالا از اون عالم ظاهر قرآن به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.0,
   "end": 598.56,
   "text": "مثال، بعد به عقل، بعد الوهیت رسیدن بعضیا رفتن از جمله خود حضرت علامه مثال‌هایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.56,
   "end": 602.38,
   "text": "کتاب انسان در عرف عرفان رو شما بخونید تمثلات ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.38,
   "end": 605.28,
   "text": "می‌تونید بعضیشو ببینید. اما راه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.28,
   "end": 609.96,
   "text": "اینه که حالا مورد سؤال هم شده بود و بعضیا گفتن چقدر شیرین بود برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.96,
   "end": 612.44,
   "text": "اینه که شما بیاید قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.44,
   "end": 616.0,
   "text": "شروع کنید خوندن. نه که سکوت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 616.0,
   "end": 624.34,
   "text": "در حین که باز تخلی ذهنی و قوه خیال دارید شروع کنید خوندن بدون توجه به معانی و حتی تفاسیر و تعابیر، هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.34,
   "end": 627.28,
   "text": "فقط قرآن رو حتی به اون تجوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.28,
   "end": 633.22,
   "text": "و این چیزا هم توجه-- هر طور بلدی تو سکوت سحر مخصوصاً شروع کنی قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.22,
   "end": 635.58,
   "text": "به این نیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 635.58,
   "end": 640.38,
   "text": "کأنّ همین الان دو مرتبه این قرآن از الوهیت نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.38,
   "end": 644.54,
   "text": "هستی تنزل پیدا می‌کنه بر عقل پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.54,
   "end": 648.76,
   "text": "بر قلب پیغمبر، بر عقل پیغمبر، بر قوه مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.76,
   "end": 653.1,
   "text": "و همون خیال و لسان مبارک ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.1,
   "end": 655.08,
   "text": "ایشون داره بیان می‌کنه، تو می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.08,
   "end": 657.56,
   "text": "یواش، یواش به این نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.56,
   "end": 660.96,
   "text": "حضرت استاد می‌فرمایند شما چند جلسه شروع کنی با طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.96,
   "end": 666.5,
   "text": "نفس این روش رو پی بگیری می‌خونی اما خالی از ذهن، از حرم-- همه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.5,
   "end": 671.88,
   "text": "علوم. بعد یواش، یواش می‌بینی تلقی می‌شه به اصطلاحا به ما می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 671.88,
   "end": 674.38,
   "text": "اصل تردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 674.38,
   "end": 676.42,
   "text": "من نه، حکما می‌گن، عرفا می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 676.42,
   "end": 682.88,
   "text": "اصل تردد یعنی هی ورود می‌کنی مخصوصاً اگر تو یه آیه بمونی هی تکرارش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 682.88,
   "end": 685.88,
   "text": "ما حدیث داریم مثال براتون بزنم خیلی آسون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.88,
   "end": 689.8,
   "text": "امام صادق علیه السلام فرمودن که یه حالتی داشتن ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.8,
   "end": 692.56,
   "text": "که یه نماز می‌خوندن دور یک از نماز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.56,
   "end": 698.66,
   "text": "\"ایاک نعبد و ایاک نستعین\" که می‌رسیدن انقدر تکرار می‌کردن تا بیهوش می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.66,
   "end": 702.54,
   "text": "از حضرت سؤال کردن. حالا بیهوشی امام بماند خودش چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 702.54,
   "end": 707.2,
   "text": "نه این بیهوشی متعارف. سؤال کردن آقا چی می‌شه که شما از حال می‌رید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.2,
   "end": 713.24,
   "text": "فرمودن که انقدر تکرار می‌کنم به همین روشی که حضرت علامه می‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 713.24,
   "end": 717.6,
   "text": "تکرار می‌کنم تا مشافهتاً از خود خدا می‌شنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 717.6,
   "end": 721.62,
   "text": "دو مرتبه کأنّ آیه داره نازل می‌شه بر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 721.62,
   "end": 724.3,
   "text": "این راه وجود داره. تو هم این راه رو بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 724.3,
   "end": 731.0,
   "text": "نبوت انبایی بهش می‌گن. باخبر شدن از اسرار عالم بسته نیست به قول حضرت علامه حسن زاده رحمت الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 731.0,
   "end": 733.98,
   "text": "تو هم می‌تونی. راهش طهارت نفسه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 733.98,
   "end": 737.0,
   "text": "اینکه این راه رو بری. شروع کنی یه چند جلسه چله بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 737.0,
   "end": 740.35,
   "text": "چله‌های اینطوری رفتن و رسیدن خیلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 740.35,
   "end": 742.99,
   "text": "آدمایی که نه حوزه خوندن، نه دانشگاه خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 742.99,
   "end": 747.57,
   "text": "آقا من خبر دارم، مرتبط‌ام با آدمایی که رفتن و اصلام اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 747.57,
   "end": 751.23,
   "text": "این شیله پیله و دکان بازار نه مطلقا خالص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 751.23,
   "end": 754.47,
   "text": "و اما سومین راه رو که اینم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 754.47,
   "end": 757.73,
   "text": "بسیار شیرینه. اینم حالا هدیه ما به شما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.73,
   "end": 759.99,
   "text": "اجازه بدید از رو خود کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 759.99,
   "end": 763.75,
   "text": "حضرت علامه. این کتاب هزار و یک کلمه ایشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 763.75,
   "end": 766.19,
   "text": "که هفت جلده. این جلد اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.19,
   "end": 767.85,
   "text": "در کلمه بیست و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 767.85,
   "end": 770.43,
   "text": "اگه کتاب رو دارید رجوع کنید اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.43,
   "end": 773.01,
   "text": "شاید بعضیا نداشته باشن و مرتبط بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 773.01,
   "end": 778.25,
   "text": "حالا تو اون کانال نزدیک ده هزار نفر آدم هست اینا رو پیگیری می‌کنن و پرسش هم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.25,
   "end": 782.31,
   "text": "اجازه بدید من توضیحش رو بدم اگه کسی کتاب رو نداشت حداقل بن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 782.31,
   "end": 785.31,
   "text": "بشنوه. اگه کسی کتاب رو داره دیگه تشریف ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 785.31,
   "end": 787.77,
   "text": "من فقط این رو از رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 787.77,
   "end": 790.23,
   "text": "حالا همه جاشم نمی‌خونم چون بعضیاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 790.23,
   "end": 792.71,
   "text": "بعضی جاشو خیلی صلاح نیست همه بشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 792.71,
   "end": 797.83,
   "text": "حضرت علامه می‌فرمایند که یک دستوری داریم برای اینکه شما اگر این کارو انجام بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 797.83,
   "end": 802.71,
   "text": "آثار عجیبی داره. بعد همتونم می‌تونید مثل اونا یه ذره سخت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 802.71,
   "end": 805.41,
   "text": "توجه کردین؟ همتونم می‌تونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 805.41,
   "end": 807.65,
   "text": "اونم مس ظاهر قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 807.65,
   "end": 810.25,
   "text": "ببین ظاهر قرآن چی توشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.25,
   "end": 812.15,
   "text": "که مسش آثار عجیب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 812.15,
   "end": 815.13,
   "text": "علامه می‌گه حتی در درمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 815.13,
   "end": 817.81,
   "text": "من سراغ دارم کسی که این کارو کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 817.81,
   "end": 822.49,
   "text": "دست گذاشته رو سر مریضیای صع، صع، صعب العلاج و شفا گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 822.49,
   "end": 827.47,
   "text": "مریضی‌ها. خود علامه تو همین کلمه میگه آث-- اثر شفا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 827.47,
   "end": 831.21,
   "text": "برای استخاره. کسی که استخاره میخواد بکنه دستش رو طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 831.21,
   "end": 834.31,
   "text": "چون حضرت علامه می‌فرمایند استخاره معصوم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 834.31,
   "end": 836.85,
   "text": "البته به عصمت دست کسی که می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 836.85,
   "end": 839.19,
   "text": "اینا همه آثارش رو حالا من عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 839.19,
   "end": 842.49,
   "text": "می‌فرمایند بین الطلوعین راهش بین الطلوعینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 842.49,
   "end": 844.81,
   "text": "تو سه روز از هفته، چهارشنبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 844.81,
   "end": 848.57,
   "text": "پنجشنبه و جمعه. فردا چهارشنبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 848.57,
   "end": 850.67,
   "text": "منم قاطی شما نیت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 850.67,
   "end": 854.73,
   "text": "از فردا انشاالله شروع کنیم. می‌تونید انشاالله سختم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 854.73,
   "end": 857.85,
   "text": "می‌فرماید که از بین الطلوعین شروع می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 857.85,
   "end": 861.81,
   "text": "قرآن رو باز می‌کنید از بسم الله surه حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 861.81,
   "end": 866.07,
   "text": "با طهارت. می‌شینید رو به قبله بعد از نماز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 866.07,
   "end": 869.35,
   "text": "«بسم الله الرحمن الرحیم» رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 869.35,
   "end": 873.17,
   "text": "می‌گید. چهارده بار صلوات می‌فرستید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 873.17,
   "end": 875.37,
   "text": "شکلی علامه تاکید می‌کنه به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 875.37,
   "end": 880.01,
   "text": "«اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 880.01,
   "end": 884.43,
   "text": "فرجهم». یعنی به این شکل حتما \"وعجل فرجهم\" داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 884.43,
   "end": 887.19,
   "text": "بعد انگشتان دست راستت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 887.19,
   "end": 889.99,
   "text": "بر سطر، سطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 889.99,
   "end": 894.11,
   "text": "surه فاتحه می‌کشی. روی هر سطر از خود بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 894.11,
   "end": 896.93,
   "text": "از بسم الله شروع می‌کنی تا \"وللضالین\" می‌کشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 896.93,
   "end": 900.07,
   "text": "همین طوری که داری دستتو می‌کشی مس می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 900.07,
   "end": 905.17,
   "text": "این آیه رو هی تردد می‌کنی یعنی تلاوت می‌کنی پشت سر هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 905.17,
   "end": 908.43,
   "text": "\"لا یمسه إلا المتحرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 908.43,
   "end": 911.91,
   "text": "\"لا یمسه إلا\". تو surه واقعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 911.91,
   "end": 916.49,
   "text": "بعد که surه هم تموم شد این اقلشه که دارین میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 916.49,
   "end": 922.41,
   "text": "اقلش اینه. میری سراغ بسم الله surه نبع که از اول جزئ سی قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 922.41,
   "end": 926.15,
   "text": "از بسم الله surه نبع شروع می‌کنی دوباره همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 926.15,
   "end": 933.75,
   "text": "دست رو می‌کشی و همون \"لا یمسه إلا المتحرون\" رو میگی سطر، سطر میری تا \"والناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 933.75,
   "end": 936.07,
   "text": "surه ناس آخر قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 936.07,
   "end": 939.93,
   "text": "تموم شد چهارده بار باز صلوات به همون شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 939.93,
   "end": 945.55,
   "text": "بعد این آیه رو می‌خونی. \"وننزل من القرآن ما هو شفاء ورحمة للمؤمنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 945.55,
   "end": 949.57,
   "text": "ولا يزيد الظالمين إلا خسارا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 949.57,
   "end": 955.63,
   "text": "که در سه روز علامه گفتن تاثیر عجیبی داره به این شکل انزل مراتبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 955.63,
   "end": 958.83,
   "text": "دیگه اون بالاترشو که دیگه جلوتر دستوراتی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 958.83,
   "end": 963.71,
   "text": "که اگه کسی خواست می‌تونه حتما تو این سه روز باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 963.71,
   "end": 967.57,
   "text": "و از جزء‌های دیگه هم شروع کنه مانعی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 967.57,
   "end": 971.33,
   "text": "یعنی مثلا حمدو خوند بره، بره از جزئ بیست و هشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 971.33,
   "end": 974.37,
   "text": "ولی مهم اینه که بره تا آخر الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 974.37,
   "end": 978.63,
   "text": "از جزئ پونزدهم شروع کنه. اما برو تا آخر جزئ آخر تا الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 978.63,
   "end": 980.97,
   "text": "مس کن به این شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 980.97,
   "end": 983.51,
   "text": "و- بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 983.51,
   "end": 985.89,
   "text": "نه دیگه «بسم الله الرحمن الرحیم» رو میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 985.89,
   "end": 990.01,
   "text": "شروع می‌کنی بعد چهارده تا صلوات می‌فرستی شروع می‌کنی به اون شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 990.01,
   "end": 993.59,
   "text": "دستتو رو بسم الله surه حمد می‌کشی تا آخر حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 993.59,
   "end": 999.17,
   "text": "بعد شروع می‌کنی از اول جزئی که خودت متمایلی ولی تا آخر قرآن باید بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 999.17,
   "end": 1001.75,
   "text": "اگر علامه فرمودن که تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1001.75,
   "end": 1003.75,
   "text": "کلمه‌شون دارن. کلمه بیست و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1003.75,
   "end": 1007.29,
   "text": "هزار و یک کلمه. فرمودن اگر بین الطلوعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1007.29,
   "end": 1012.79,
   "text": "وقتش گذشت یعنی شما یه دفعه دیدی طلوع آفتاب رخت داد عیبی نداره ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1012.79,
   "end": 1018.17,
   "text": "و اگر حالا من دیگه اینو نمیگم برید رجوع کنید چون رسانه‌ای می‌شه میره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1018.17,
   "end": 1021.65,
   "text": "اگر کسی بتونه اینو این تو این سه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1021.65,
   "end": 1024.29,
   "text": "برای کل قرآن انجام بده یعنی از بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1024.29,
   "end": 1030.17,
   "text": "surه حمد شروع کنه بسم الله رو بگه چهارده صلواتو بگه شروع کنه مس کردن سطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1030.17,
   "end": 1031.91,
   "text": "\"لا یمسه إلا المتحرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1031.91,
   "end": 1034.23,
   "text": "\"لا یمسه إلا\" تا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1034.23,
   "end": 1039.35,
   "text": "تا \"والناس\". نه که تقسیم کنه تو سه روزهای کل قرآن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1039.35,
   "end": 1041.87,
   "text": "نه. روز اول کل قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1041.87,
   "end": 1044.13,
   "text": "دوم چهار-- پنجشنبه کل قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1044.13,
   "end": 1046.87,
   "text": "جمعه دوباره کل قرآن. آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1046.87,
   "end": 1050.25,
   "text": "شگرفی اینجا حضرت علامه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1050.25,
   "end": 1060.33,
   "text": "من فقط کلمه‌شو به شما عرض می‌کنم که می‌فرمایند در رشته‌های ارسماتیقی مطلقد-- مطلقا گشادی می‌آبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1060.33,
   "end": 1061.93,
   "text": "حالا این رو یعنی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1061.93,
   "end": 1064.73,
   "text": "دیگه برید اهلشو رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1064.73,
   "end": 1069.09,
   "text": "اگر دوست داشتید خصوصا خدمتتون عرض می‌کنم می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1069.09,
   "end": 1073.67,
   "text": "ااا رسانه‌ای نشه. خب این، اینم هدیه ما امروز به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1073.67,
   "end": 1077.71,
   "text": "ااا فکر کنم دیگه فردا انشاالله بحث قلب در، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1077.71,
   "end": 1081.63,
   "text": "ریب یا مریب در قرآن رو ما به فضل الهی جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1081.63,
   "end": 1087.41,
   "text": "انشاالله که عاقبتمون ختم به خیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1087.41,
   "end": 1093.23,
   "text": "الله- اللهُم صَلّ عَلَى مُحَمَّد وَآلِ مُحَمَّد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}