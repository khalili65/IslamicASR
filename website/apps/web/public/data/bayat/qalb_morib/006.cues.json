 "chapters": [
  {
   "index": 0,
   "title": "## علاج قلب مریب؛ چنگ زدن به اقوم",
   "start": 125.78,
   "end": 201.62
  },
  {
   "index": 1,
   "title": "آیهٔ نهم سورهٔ اسراء همین معنا را به زیبایی تمام تصویر کرده است:",
   "start": 201.62,
   "end": 273.62
  },
  {
   "index": 2,
   "title": "## دو راه ورود به بحث؛ تحویل نفس به حجت",
   "start": 273.62,
   "end": 327.4
  },
  {
   "index": 3,
   "title": "## قرآن صورت کتبیهٔ انسان کامل؛ صد کلمه",
   "start": 327.4,
   "end": 398.95
  },
  {
   "index": 4,
   "title": "## عوالم ذومراتب و یکپارچگی قرآن",
   "start": 398.95,
   "end": 790.24
  },
  {
   "index": 5,
   "title": "## رسالهٔ لقاءالله؛ پانزده ادب و تلاوت قرآن کریم",
   "start": 790.24,
   "end": 927.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 4.6,
   "text": "باني آيات. سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.6,
   "end": 11.64,
   "text": "تسلیت عرض می‌کنم ایام شهادت حضرت امام باقر صلوات الله عليه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.64,
   "end": 17.06,
   "text": "که ماثر باقریه صاحبش امام عصر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.06,
   "end": 21.44,
   "text": "و البته چون الحمد لله دیروز آل یاسین خونده شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.44,
   "end": 29.0,
   "text": "عزاداری شد مختصراً دیگه امروز ما بحث رو ادامه میدیم به فضل الهی هدیه به خود حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.0,
   "end": 34.86,
   "text": "یکی از دلایلی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.86,
   "end": 40.22,
   "text": "بحث امروز رو می‌خوایم عرض کنیم اینه که عنوان بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.22,
   "end": 42.44,
   "text": "تزلزل و شکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.44,
   "end": 44.94,
   "text": "هر کجا که شک باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.94,
   "end": 48.88,
   "text": "خصوصاً توقف در شک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.88,
   "end": 51.98,
   "text": "این سبب تزلزل است یا اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.98,
   "end": 54.88,
   "text": "خودش عین تزلزل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.88,
   "end": 59.52,
   "text": "اون آیه‌ای که ما سر فصل بحثمون قرار داده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.52,
   "end": 64.1,
   "text": "توش می‌فرمود که انما یستعذنوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.1,
   "end": 67.38,
   "text": "از تو درخواست می‌کنند عذر می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.38,
   "end": 70.32,
   "text": "که چی بشه؟ چه کسانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.32,
   "end": 75.54,
   "text": "الذین لا يؤمنون بالله واليوم الآخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.54,
   "end": 77.18,
   "text": "این‌ها دل ندادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.18,
   "end": 79.76,
   "text": "چرا دل ندادند؟ متزلزل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.76,
   "end": 82.76,
   "text": "اساساً ریشه‌ی شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.76,
   "end": 86.2,
   "text": "خصوصاً چون در این آیه‌ای که مورد بحث انتهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.2,
   "end": 91.86,
   "text": "می‌فرمود این‌ها دائماً در شکشون می‌مونن، در ریبشون می‌مونن، ریشه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.86,
   "end": 96.92,
   "text": "ریشه‌ی تزلزل خود شکه یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.92,
   "end": 98.7,
   "text": "شک عین تزلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.7,
   "end": 101.02,
   "text": "اتحاد وجودی دارن با این هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.02,
   "end": 104.24,
   "text": "اینو حواسمون باشه هر کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.24,
   "end": 108.14,
   "text": "شک ایجاد شد تزلزل ورود کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.14,
   "end": 110.92,
   "text": "اگر مثل یک راهرو ازش رد شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.92,
   "end": 114.54,
   "text": "خب سبب استحکامت می‌تونه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.54,
   "end": 120.4,
   "text": "اما اگر موندی طبق این آیه میگه دیگه اینا میمونن برای همیشه تو ریبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.4,
   "end": 122.94,
   "text": "و این‌ها از رحمت خدا به دور میشن و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.94,
   "end": 130.4,
   "text": "حالا چه باید کرد که از تزلزل بحث قلب مریب است و ریب و شک، شک و شکاکیت و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.4,
   "end": 133.56,
   "text": "چه کنیم که از قلب م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.56,
   "end": 135.44,
   "text": "شکاک در امان باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.44,
   "end": 137.82,
   "text": "خب راهش خروج از تزلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.82,
   "end": 139.88,
   "text": "راه خروج از تزلزل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.88,
   "end": 142.68,
   "text": "اینه که به یک چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.68,
   "end": 147.52,
   "text": "نه فقط قیام دارد و قائم است بلکه اقوم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.52,
   "end": 149.96,
   "text": "چنگ بندازیم. اقوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.96,
   "end": 152.16,
   "text": "بر وزن افعل، افعل تفضیل دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.16,
   "end": 155.1,
   "text": "خیلی محکم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.1,
   "end": 159.88,
   "text": "بلکه اقوم یعنی همه به او قیام دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.88,
   "end": 162.52,
   "text": "همه به-- این اسمی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 162.52,
   "end": 165.44,
   "text": "طول نماز وقتی بلند میشی ذکر می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.44,
   "end": 168.52,
   "text": "یا حی یا قيوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 168.52,
   "end": 175.4,
   "text": "جالبه که روایاتی داریم یا اولیاء الله مثل مرحوم آقا کشمیری هم توصیه دارند که این اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.4,
   "end": 181.64,
   "text": "خیلی اسم عجیبیه. اصلاً بگید ببینید چجوری کمرتون می‌لرزه تو نماز وقتی می‌خواید پاشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.64,
   "end": 185.72,
   "text": "یا حی یا قيوم همه به تو قائم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.72,
   "end": 188.8,
   "text": "چون همه به تو قائم‌اند و قیام دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.8,
   "end": 191.14,
   "text": "پس تو اقومی. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.14,
   "end": 195.8,
   "text": "آیه‌ی نه سوره اسرا به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.8,
   "end": 198.88,
   "text": "همین رو برای ما به این قشنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 198.88,
   "end": 202.3,
   "text": "تصویرسازی کرده. می‌فرمود که إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.3,
   "end": 204.34,
   "text": "هذا القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.34,
   "end": 210.4,
   "text": "اولاً هذا ثانیاً القرآن همه‌ی قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.4,
   "end": 213.16,
   "text": "نه یه بخشی از قرآن و یک جزئی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.16,
   "end": 216.54,
   "text": "که بعضیا پاره پاره کردن قرآن و احکام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.54,
   "end": 220.14,
   "text": "گفتن ما این بخشش رو می‌خوایم، این بخش-- ما نماز رو می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.14,
   "end": 225.0,
   "text": "روزه نمی‌گیریم، روزه می‌گیریم، زکات نمی‌دیم، زکات میدیم، جهاد نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.0,
   "end": 228.12,
   "text": "نمیشه. القرآن اینا نکاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.12,
   "end": 231.94,
   "text": "بعد هذا این قرآن، این قرآنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 231.94,
   "end": 237.68,
   "text": "در حقیقت عین ولایت است، عین علم ذاتی حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.68,
   "end": 240.92,
   "text": "نه اون قرآنی که به انحراف کشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 240.92,
   "end": 245.3,
   "text": "حالا نه الفاظش رو کسی نمی‌تونه لفظ قرآن رو اما معانیش رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.3,
   "end": 249.22,
   "text": "تعابیرش رو هم به انحراف در حسب ظاهر البته کشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.22,
   "end": 254.22,
   "text": "إن هذا القرآن يهدي هدایت می‌کنه، می‌کشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.22,
   "end": 257.22,
   "text": "هدایت کشنده است، می‌کشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.22,
   "end": 262.56,
   "text": "یک جذبه داره. للتي می‌کشونه، هدایت می‌کنه به چه چیزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.56,
   "end": 265.66,
   "text": "به چیزی که للتي به یک چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.66,
   "end": 268.54,
   "text": "هِيَ اون چیزه اقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.54,
   "end": 271.06,
   "text": "الله اکبر. رسیدیم به موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.06,
   "end": 273.62,
   "text": "اقومه. خب آقا جون ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.62,
   "end": 276.9,
   "text": "از دو راه می‌شد ما به این بحث برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.9,
   "end": 282.4,
   "text": "یک راه این که ما در جلسات پیش عرض کردیم برای خروج از قلب شکاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.4,
   "end": 285.18,
   "text": "چون یستعذنوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 285.18,
   "end": 291.58,
   "text": "این‌ها از تو، اون کاف مخاطب رو یادتون باشه گفتیم اینا می‌خوان از تو فارغ بشن، نمی‌خوان در جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.58,
   "end": 295.66,
   "text": "شرکت کنن چون تو رو نمی‌خوان گفتیم پس راهش اینه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.66,
   "end": 303.46,
   "text": "بالعکس. تو باید بری خودت رو تحویل امام بدی، تحویل حجت خدا، ولی خدا، پیغمبر بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.46,
   "end": 305.8,
   "text": "یک راه ورود به این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.8,
   "end": 309.44,
   "text": "اینه که خب الان داریم میریم که الان حالا داریم ادامه‌ش میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.44,
   "end": 312.34,
   "text": "یه راه دیگه هم می‌شد رفت که حالا اونو فردا میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.34,
   "end": 315.82,
   "text": "از طریق علم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.82,
   "end": 322.04,
   "text": "تطهیر ق-- چون جلسه پیش ما صحبت کردیم که متخیلات فاسده کار دست انسان میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.04,
   "end": 324.88,
   "text": "و باعث میشه که انسان شکاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.88,
   "end": 329.88,
   "text": "بعد روشی علم الallame ارائه میده در خصوص خروج از متخیلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.88,
   "end": 332.44,
   "text": "فاسده که ربط به علم و قرآن پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.44,
   "end": 335.74,
   "text": "اون انشاالله فردا اگر عمری باقی بود و توفیق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.74,
   "end": 339.04,
   "text": "پس الان از طریق این وارد که، وارد شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.04,
   "end": 343.68,
   "text": "که ما گفتیم خودمون رو تحویل چی بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.68,
   "end": 349.44,
   "text": "ولی خدا، حجت خدا. خب چه ربطی به قرآن داره که شما داری از قرآن الان حرف می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.44,
   "end": 351.76,
   "text": "عزیز دلم در رساله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.76,
   "end": 357.08,
   "text": "صد کلمه‌ی حضرت Allame که من توصیه می‌کنم این رساله رو به کتابه بگیرید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.08,
   "end": 359.72,
   "text": "صد کلمه در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.72,
   "end": 364.69,
   "text": "اصلاً ه-از هر کلمه‌ش هزار کلمه باز میشه اگه با دقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.69,
   "end": 366.71,
   "text": "و طهارت نفسش انشاالله بررسی شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.71,
   "end": 370.43,
   "text": "اونجا علامه می‌فرمود که قبلاً هم براتون توصیه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.43,
   "end": 376.21,
   "text": "توضیح دادیم اجمالاً. که می‌فرماט",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.21,
   "end": 380.77,
   "text": "این کتاب قرآن، کتاب قرآن، کتاب کتبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.77,
   "end": 384.31,
   "text": "این کتاب کتبی قرآن صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.31,
   "end": 387.61,
   "text": "کتبیه انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.61,
   "end": 391.09,
   "text": "صورت کتبیه انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.09,
   "end": 395.33,
   "text": "یا به عبارتی فرمودن شرح کتبی انسان کامل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.33,
   "end": 402.39,
   "text": "و این عالم و نظام آفاقی که اونم خودش یک بحثی داره تو همین ردیف قلب شکاک که از اونم میشه بهره برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.39,
   "end": 407.19,
   "text": "یه وقت دیگه‌ای موقعش انشاالله عرض می‌کنیم چگونه کاربردیش می‌کنیم بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.19,
   "end": 410.69,
   "text": "عالم آفاقی، این آسمان و زمین و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.69,
   "end": 412.97,
   "text": "اینا همه چی‌ان؟ صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.97,
   "end": 416.73,
   "text": "عینیه انسان کامل‌اند یا به عبارتی شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.73,
   "end": 419.73,
   "text": "عینی انسان کامل‌اند. یعنی خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.73,
   "end": 423.89,
   "text": "چون وقتی، وقتی میگه آقا خودتو تحویل امام عصرت بده میگه کو آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.89,
   "end": 427.21,
   "text": "دست من نمی‌رسه. این نگاه ابتداییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.21,
   "end": 432.67,
   "text": "از او ظاهر به باطن سفر نکرده، حق هم داره، چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.67,
   "end": 435.01,
   "text": "در حالی که ما پارسال محرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.01,
   "end": 437.63,
   "text": "ده جلسه تو یازده رای تهران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.63,
   "end": 440.29,
   "text": "پنج جلسه پیش شهید حججی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.29,
   "end": 443.61,
   "text": "و چند جلسه هم همین جا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.61,
   "end": 447.83,
   "text": "عبور از ظاهر به باطن را از نظرات ملاصدرا گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.83,
   "end": 451.49,
   "text": "و خیلی‌ها الحمد لله عبور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.49,
   "end": 454.79,
   "text": "من که میگم شاهد مثال دارم که عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.79,
   "end": 458.73,
   "text": "راهش مشخصه، بزرگان گفتن ما به سمتش نمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.73,
   "end": 463.03,
   "text": "حالا اونجا می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.03,
   "end": 466.47,
   "text": "در رساله صد کلمه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.47,
   "end": 471.15,
   "text": "اساساً این صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.15,
   "end": 475.19,
   "text": "انسان کامل فقط این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.19,
   "end": 476.89,
   "text": "لفظی نیست که دست توه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.89,
   "end": 479.05,
   "text": "اینو خوب دقت کنید اینجا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.05,
   "end": 481.83,
   "text": "اینو خوب بگیرید. خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.83,
   "end": 487.23,
   "text": "بعد شیرین میشه براتون. دقت کنید وقتی ما میگیم قرآن صورته یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.23,
   "end": 489.09,
   "text": "شرح کتبی انسان کامله؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.09,
   "end": 491.39,
   "text": "یعنی اگر انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.39,
   "end": 493.15,
   "text": "میگه آقا دستم نمی‌رسه چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.15,
   "end": 497.75,
   "text": "خب دستت نمی‌رسه اگرچه راه هست برای عبور از ظاهر به باطن که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 497.75,
   "end": 500.15,
   "text": "اما بسم الله قرآن که دستت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.15,
   "end": 508.19,
   "text": "قرآن که هست که. که آقای بهجت فرمودن که اگر شما اینایی که می­خواید-- ای آقای بهجت فرمودن اینو من به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.19,
   "end": 510.77,
   "text": "ما محضرشون خیلی اذیتشون می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 510.77,
   "end": 516.67,
   "text": "خب الحمد لله اون اذیت‌ها متأسفانه البته ولی خوشبختانه باعث شد یه هدایایی هم داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.67,
   "end": 520.83,
   "text": "ایشون می‌فرمودن که می‌خواید بهتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.83,
   "end": 526.39,
   "text": "امام عصر تشریف بیارن چقدر شما اصلاً اجازه داری محضر حضرت رو درک کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.39,
   "end": 528.21,
   "text": "اجازه داره، نه این همینطوری نیستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.21,
   "end": 530.47,
   "text": "باید اجازه بگیری. چقدر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 530.47,
   "end": 537.53,
   "text": "خودمونو کشتیم تا آقا بیاد دیگه سرباز پاره‌کاب فرمود همین مق-- همین مقدار که الان برای قرآن وقت می‌گذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.53,
   "end": 540.49,
   "text": "چون این شرح کتبی همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.49,
   "end": 544.53,
   "text": "حالا این نکته رو می‌خوام بگم. دستت به آقا ظاهراً نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.53,
   "end": 546.69,
   "text": "بسم الله قرآن که هست اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.69,
   "end": 552.09,
   "text": "این قرآن، این کتبی، این لفظی که دست ماست، من و شماست و اینو می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 552.09,
   "end": 554.25,
   "text": "این انزل مراتب قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.25,
   "end": 558.23,
   "text": "این انزل مراتب قرآن، این لفظی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.23,
   "end": 563.27,
   "text": "توی قرآن هست اگرچه ملاصدرا می‌فرماید این هم همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.27,
   "end": 566.67,
   "text": "نورانیت و عظمت و عبوهجت رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.67,
   "end": 570.67,
   "text": "اما این همه قرآن نیست که این ظاهر قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.67,
   "end": 574.15,
   "text": "اون که می‌فرمود این هذا القرآن بحث اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.15,
   "end": 577.51,
   "text": "هذا القرآن همه قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.51,
   "end": 580.97,
   "text": "همه قرآن میشه صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.97,
   "end": 583.87,
   "text": "امام عصر و تو باید خودتو تحویل همه قرآن بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.87,
   "end": 589.93,
   "text": "هاج آقا همه قرآن چیه؟ تو اون بحث قرآن، عبور از ظاهر به باطنش گفته بودیم اگه یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 589.93,
   "end": 592.63,
   "text": "گفتیم أعلی Meratb القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.63,
   "end": 601.63,
   "text": "می‌شود إنك لتلقى القرآن القاء شده به تو قرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.63,
   "end": 603.75,
   "text": "دو تا اسمم آورده حکیم و علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.75,
   "end": 609.87,
   "text": "صفت مشبّع هم است. یعنی حکمت و علم مستکنه در وجود توست ای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 609.87,
   "end": 613.23,
   "text": "اصلاً ذات توست. همچنین در ذات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 613.23,
   "end": 615.79,
   "text": "استکان داره. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 615.79,
   "end": 620.33,
   "text": "حالا می‌خوام بگم که از اون أعلی Meratbش بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 620.33,
   "end": 623.19,
   "text": "از اون حالت اقدس قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.19,
   "end": 626.65,
   "text": "در حقیقت میشه گفت صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 626.65,
   "end": 629.61,
   "text": "علمیه ذات حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.61,
   "end": 633.99,
   "text": "چون علم لدنّی و ذاتی خداست قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 633.99,
   "end": 638.31,
   "text": "از اونجا تنزل پیدا کرده اومده به عالم اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 638.31,
   "end": 640.21,
   "text": "به عالم قلب پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.21,
   "end": 644.55,
   "text": "از قلب پیغمبر تنزل پیدا کرده به عالم عقل پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 644.55,
   "end": 648.51,
   "text": "از عقل اومده به عالم مثال یا خیال پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 648.51,
   "end": 651.71,
   "text": "بعد بر لسان مبارک جاری شده، شده این لفظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 651.71,
   "end": 654.03,
   "text": "اون حقیقت، اون حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.03,
   "end": 656.55,
   "text": "اون بالا، اون صورت علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 656.55,
   "end": 660.67,
   "text": "در حقیقت ذات حضرت حق از اونجا تنزل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 660.67,
   "end": 669.19,
   "text": "تو، شما این مجموعه رو باید بگیری از اون مراتب عالیه و شامخه تا این انزل مراتب، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.19,
   "end": 672.75,
   "text": "یکپارچه ذو مراتبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.75,
   "end": 676.05,
   "text": "این یک حقیقت کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 676.05,
   "end": 680.43,
   "text": "صورت کتبیه یا شرح کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 680.43,
   "end": 685.05,
   "text": "انسان کامل است که ما باید به اون خودمون رو تحویل بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.05,
   "end": 693.27,
   "text": "که اگر به اون تحویل ندیم باز رگه‌هایی از شک و ریب و این‌ها تو وجود ما خواهد موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.27,
   "end": 695.51,
   "text": "لب مرگ کار دست ما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.51,
   "end": 699.43,
   "text": "در برزخ بیچاره می‌کنه، پوست می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.43,
   "end": 703.49,
   "text": "و بعد از اون هم تا بخوای به سیر استکمالی و تدریجی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.49,
   "end": 708.03,
   "text": "برزخ بخوای برسی به اون مراتبی که تو این دنیا ازش جا موندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 708.03,
   "end": 711.37,
   "text": "بیچاره میشی که ازش به عذاب برزخی یاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 711.37,
   "end": 718.61,
   "text": "و بعد از اون قیامت که دیگه وحشتناک‌تر و وحشکناک‌تر از تو به صورت که این رگه‌ها باقی مونده باشه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 718.61,
   "end": 722.31,
   "text": "وحشتناک‌تر از اون عالم آخرته که بعد از قیامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 722.31,
   "end": 727.66,
   "text": "چون ما از اولین عالم حالا باز داریم بحث داریم ولی اولین عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 727.66,
   "end": 729.84,
   "text": "صلب پدر. عالمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 729.84,
   "end": 731.88,
   "text": "بعضیا همون عالم زر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 731.88,
   "end": 733.78,
   "text": "عالم بعدی رحم مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 733.78,
   "end": 736.38,
   "text": "اوه، اوه چه غوغاییه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 736.38,
   "end": 741.96,
   "text": "تشکیل نطفه در رحم. چه حرف‌ها بزرگان اینجا پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.96,
   "end": 744.64,
   "text": "بعد از-- تا میگی نطفه میگن حاج آقا زشت حرف نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 744.64,
   "end": 746.86,
   "text": "بابا جان یک، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 746.86,
   "end": 749.12,
   "text": "به شما عرض کنم تا کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 749.12,
   "end": 758.38,
   "text": "موقعیت و اهمیت نطفه رو که خودمان بودیم متوجه نشه، اصلاً نمی‌فهمه عالم تربیت در اسلام یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.38,
   "end": 760.08,
   "text": "عالم بعدی دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 760.08,
   "end": 763.62,
   "text": "ورود کردی از عالم رحم که الان درش هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 763.62,
   "end": 768.4,
   "text": "عالم بعدی، حالا بعضیا بین دنیا و برزخ هم گرفتن سکرات مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 768.4,
   "end": 770.7,
   "text": "کاری نداریم. حالا میگم اینا جزئیات هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.7,
   "end": 775.88,
   "text": "برزخ و بعد از برزخ قیامت و بعدش آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 775.88,
   "end": 778.84,
   "text": "همه اینها ذو مراتب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 778.84,
   "end": 784.04,
   "text": "باید قرآن رو به یک پاره از همه از اون عالم بالا تا پایین گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 784.04,
   "end": 786.82,
   "text": "و توجه کرد. خب چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 786.82,
   "end": 788.98,
   "text": "حاج آقا خیلی سختش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 788.98,
   "end": 794.08,
   "text": "چگونه؟ حضرت علامه یه جمله دارن اجازه بدید این جمله رو فردا توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 794.08,
   "end": 797.92,
   "text": "دیگه فرصت نیست. دوست داشتید روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 797.92,
   "end": 806.16,
   "text": "یه کتابی علامه دارن می‌دونید ایشون هشت رساله عربی دارن که یکی از این رساله‌ها لقاءالله مرسومه به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 806.16,
   "end": 809.74,
   "text": "یعنی اینطوری جا افتاده بین همه به اسم لقاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 809.74,
   "end": 815.9,
   "text": "دارم این رساله رو من دارم خیلی شیرینه بگیرید بخونید عربی بوده ولی به فارسی ترجمه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 815.9,
   "end": 818.7,
   "text": "اونجا حضرت علامه باز میاد این س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 818.7,
   "end": 825.18,
   "text": "بحث قرآن رو که صورت کتبیه‌ست دوباره میاد اونجا مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 825.18,
   "end": 831.52,
   "text": "پونزده تا ادب در بخش آداب و از کار این رساله میاره میگه اگر کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 831.52,
   "end": 833.72,
   "text": "سه این مقدمه بحث فردا مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 833.72,
   "end": 837.44,
   "text": "و تتم-- در حقیقت اتمام بحث امروزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 837.44,
   "end": 846.2,
   "text": "اگر کسی می‌خواد مسیر سیر و سلوک رو پیش بره هیچ چاره‌ای نداره الا این پونزده ادب رو موعظه منو لحاظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 846.2,
   "end": 848.62,
   "text": "اولیشو می‌فرماید این جمله‌ی علامه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 848.62,
   "end": 851.26,
   "text": "\"علیکم بتلاوت القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 851.26,
   "end": 852.92,
   "text": "کریم\". جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 852.92,
   "end": 857.3,
   "text": "نمیگه قرآن میگه قرآن کریم که حالا این باید بحث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 857.3,
   "end": 859.16,
   "text": "خب این قرآن کریم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 859.16,
   "end": 863.08,
   "text": "اینجا می‌فرماید \"سوره انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 863.08,
   "end": 867.52,
   "text": "الكتبیه\". دوباره همون حرف صد کلمه رو اینجا علامه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 867.52,
   "end": 871.76,
   "text": "میگه تلاوت کنی. حالا باید رفتی تلاوت قرآن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 871.76,
   "end": 874.72,
   "text": "فرق تلاوت با قرائت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 874.72,
   "end": 878.26,
   "text": "اینا اسراره. اینا به درد می‌خوره، خیلی هم به درد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 878.26,
   "end": 881.42,
   "text": "و چگونه؟ و چگونه‌شو اجازه بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 881.42,
   "end": 884.8,
   "text": "فردا. پس خلاصه بحث امروزمون این شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 884.8,
   "end": 890.66,
   "text": "اگر می‌خوایم از رگ و ریشه‌هایی که جون گرفتن تو وجودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 890.66,
   "end": 897.12,
   "text": "ما رو دچار شک و ریب نسبت به حقایق نظام هستی کردن خلاص بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 897.12,
   "end": 903.42,
   "text": "یکی دیگه از راه‌هاش بعد از تحویل دادن خودت به امام و حجت زمان ولی الله کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 903.42,
   "end": 908.06,
   "text": "و اعظمه تحویل دادن خودت به قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 908.06,
   "end": 911.02,
   "text": "اونم از اعلی المراتب تا انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 911.02,
   "end": 914.58,
   "text": "اینو اجازه بدید یه روشی علامه داره فردا خدمتتون عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 914.58,
   "end": 920.02,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 920.02,
   "end": 927.92,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}