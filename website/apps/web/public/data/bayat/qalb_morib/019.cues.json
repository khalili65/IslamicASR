 ],
 "cues": [
  {
   "i": 0,
   "start": 3.26,
   "end": 8.48,
   "text": "خدا لعنت کنه صدام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.48,
   "end": 10.68,
   "text": "بله گفتم اسم پدرشون عباسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.68,
   "end": 13.1,
   "text": "ان شا الله فردا خواستید بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.1,
   "end": 16.3,
   "text": "پدر آقای گودرزی نثارشون صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.3,
   "end": 19.16,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.16,
   "end": 21.14,
   "text": "و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.14,
   "end": 26.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.48,
   "end": 30.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.28,
   "end": 34.8,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.8,
   "end": 42.98,
   "text": "می‌دونید این مراکز عمومی، وسایل نقلیه خب در معرض استفاده همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.98,
   "end": 52.1,
   "text": "خب بالاخره اهل کتاب، کفار، منافقین، مشرکین میان سوار اتوبوس‌ها، جاهای مختلف، مترو اینا، قطار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.1,
   "end": 54.84,
   "text": "هواپیما می‌شن و بعضا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.84,
   "end": 58.82,
   "text": "شاید مثلا بر اثر بارون لباس اینا نج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.82,
   "end": 62.98,
   "text": "رطوبت داره منتقل می‌شه نجاست یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.98,
   "end": 65.82,
   "text": "نه عرق می‌کنن بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.82,
   "end": 68.46,
   "text": "اون رطوبت منتقل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.46,
   "end": 71.44,
   "text": "سؤال اینجاست که آیا جایزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.44,
   "end": 77.3,
   "text": "استفاده کردن از این صندلی‌ها اینها وقتی ما هم بدنمون مرطوبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.3,
   "end": 81.36,
   "text": "بالاخره نجاست منتقل می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.36,
   "end": 87.24,
   "text": "رهبر عزیزمون می‌فرمایند که چون علم یقینی به نجاست ندارید اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.24,
   "end": 93.52,
   "text": "محکوم به طهارن. همه این صندلی‌ها، این جاهایی که حالا مرکز عمومی هستش، تو پارک‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.52,
   "end": 100.24,
   "text": "اتوبوس‌ها، متروها، قطارها، هواپیما اینها چون علم یقینی به نجس، نجس شدن این‌ها نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.24,
   "end": 104.74,
   "text": "محکوم به طهارته. بارها عرض کردیم خدا تو این قصه خیلی سخت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.74,
   "end": 108.46,
   "text": "خدا تو نجاست باطنی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.46,
   "end": 113.04,
   "text": "تو قضیه گناه و اینا سخت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.04,
   "end": 121.32,
   "text": "ما دیروز به فضل الهی موضوعی رو عرض کردیم پیرامون تحویل خودمون یا در حقیقت تطبیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.32,
   "end": 126.04,
   "text": "آدم و عالم. در ادامه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.04,
   "end": 135.24,
   "text": "نکته‌ای رو هم امروز عرض کنیم که برای بعضیا تعجب شاید بود که گفتیم خیلی از این مشکلات درونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.24,
   "end": 140.0,
   "text": "در نظام انفسی به جهت مشکلات جسمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.0,
   "end": 147.24,
   "text": "اینکه قدیم‌ها می‌گفتن عقل سالم در بدن سالم واقعاً یک موضوع علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.24,
   "end": 155.68,
   "text": "و اگر بدن مزاجش سالم نبود قطعاً دچار مشکلاتی می‌شه حتی شک و ریب قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.68,
   "end": 158.58,
   "text": "می‌تونه یه دلیلش عدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.58,
   "end": 162.06,
   "text": "اعتدال مزاج و مشکلات جسمی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 162.06,
   "end": 165.0,
   "text": "ببین آدمی که جسمش سالم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.0,
   "end": 167.12,
   "text": "دچار فشارهای عصبی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.12,
   "end": 170.38,
   "text": "اون عصبیتش زود عصبانیش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.38,
   "end": 173.24,
   "text": "غضبناک‌ش می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.24,
   "end": 180.36,
   "text": "به هر حال یا وقتی که زیاده از حد به جسمش رسیده، پرخوری کرده، اینا شهوتش تحریک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 180.36,
   "end": 187.48,
   "text": "بالاخره اینا چی کار می‌کنه؟ انسان رو می‌کشونه به یک وادی که قطعاً نتیجه‌ش می‌شه تزلزل اعتقادی، فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.48,
   "end": 191.64,
   "text": "و همون حالا شک، ریب، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.64,
   "end": 194.56,
   "text": "این نکته رو خوب توجه داشته باشید که ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.56,
   "end": 197.66,
   "text": "نفس انسان قطعاً مجرده، تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.66,
   "end": 200.64,
   "text": "داره از ابتدا این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.64,
   "end": 206.8,
   "text": "اما نفس برای ارتقاء وجودی و رشد نیاز به بدن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.8,
   "end": 211.72,
   "text": "یعنی نفس درست خودش مجرده اما برای اینکه رشد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.72,
   "end": 217.28,
   "text": "در حقیقت باید با افعالش رشد کنه دیگه صیغه وجودی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.28,
   "end": 220.14,
   "text": "افعال نفس کجا پیاده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.14,
   "end": 223.76,
   "text": "فعل نفس، فعل و انفعالات نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.76,
   "end": 226.54,
   "text": "کجا بروز می‌کنه؟ در بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.54,
   "end": 230.1,
   "text": "بدن دیگه انزل مراتب خود نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.1,
   "end": 232.14,
   "text": "جدایی از نفس هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.14,
   "end": 239.62,
   "text": "اینایی که میان بدن رو از نفس جدا می‌دونن درست متوجه نشدن بحث حکمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.62,
   "end": 241.94,
   "text": "اساساً حضرت علامه حسن زاده رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.94,
   "end": 248.32,
   "text": "نکته هم خیلی تک– تکیه دارن و تاکید می‌کنم که حواستون جمع باشه گولتون نزنن‌ ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.32,
   "end": 250.82,
   "text": "نگن بدن جدایی از نفسه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.82,
   "end": 252.52,
   "text": "هیچوقت اینا از هم جدا نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.52,
   "end": 256.6,
   "text": "یک حقیقتن. ذو مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 256.6,
   "end": 258.52,
   "text": "که بارها درباره‌ش حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.52,
   "end": 260.96,
   "text": "اگر این چنین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.96,
   "end": 263.34,
   "text": "پس نفس قراره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.34,
   "end": 265.4,
   "text": "بدن به کمال برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.4,
   "end": 268.86,
   "text": "چون افعال نفس در بدن پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.86,
   "end": 271.98,
   "text": "خب شما بفرمایید ببینم خستگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.98,
   "end": 275.8,
   "text": "خواب، بیماری حتی غشوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.8,
   "end": 279.44,
   "text": "هیپنوتیزم، اینا بیهوشی، اینا مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.44,
   "end": 282.12,
   "text": "چیه؟ عوارض نفسه یا بدنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.12,
   "end": 289.94,
   "text": "همه مال بدنه. یعنی نفس که بیهوشی نداره، نفس که خواب نداره، نفس که خستگی نداره، نفس که گرسنگی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.94,
   "end": 292.9,
   "text": "همه مال بدنه. پس چی کار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.9,
   "end": 297.24,
   "text": "چون اصل نفسه و نفسه که قراره به کمال برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.24,
   "end": 304.5,
   "text": "بدن رو گرسنه نگه داریم یا نه برعکس پر، پر پرش کنیم اینقدر بخورونیم که بالا بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.5,
   "end": 309.6,
   "text": "یا حالا هرچی. نه باید اعتدال اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.6,
   "end": 314.16,
   "text": "اعتدال مزاج باید معتدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.16,
   "end": 317.24,
   "text": "رفتار کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.24,
   "end": 319.42,
   "text": "قرآن هم ما رو امت وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.42,
   "end": 323.32,
   "text": "معرفی کرده. امت وسط نه تفریط، نه افراط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.32,
   "end": 326.24,
   "text": "در-- پس برای اینکه نفس به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.24,
   "end": 329.06,
   "text": "رشدش و ارتقاء وجودیش برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.06,
   "end": 331.48,
   "text": "باید از ناحیه جسم حرکت کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.48,
   "end": 338.46,
   "text": "جسم باید تعادل داشته باشه. البته ضررهایی که در پر بودن و امتلای شکم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.46,
   "end": 342.02,
   "text": "بیشتر از ضررهاییه که در خالی بودن شکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.02,
   "end": 346.28,
   "text": "این رو عرض کنیم. یعنی این بحث هم کاملاً علم، اصلاً پزشکیه، طبیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.28,
   "end": 349.28,
   "text": "حالا به شما بگید پزشکی ما می‌گیم طبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.28,
   "end": 353.54,
   "text": "کاملاً طبیعه که وقتی بدن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.54,
   "end": 358.92,
   "text": "ااا معده پر پر می‌شه ضررش به مراتب بیشتر از وقتیه که خالی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.92,
   "end": 361.66,
   "text": "اتفاقاً وقتی معده خالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.66,
   "end": 364.06,
   "text": "به خدا هم نزدیک‌تره. حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.06,
   "end": 368.68,
   "text": "کتابی که الان پیش ماست و ما در محضرش هستیم محققی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.68,
   "end": 373.35,
   "text": "کتاب لقاء الله حضرت استاد علامه حسن زاده البته لقاء الله خیلیا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.35,
   "end": 376.17,
   "text": "آقا جواد آقا دارن، حضرت امام دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.17,
   "end": 381.69,
   "text": "و حضرت استاد علامه حسن زاده دارن، مرحوم فیض دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.69,
   "end": 385.59,
   "text": "پونزده تا راهکار حضرت علامه میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.59,
   "end": 388.67,
   "text": "برای اهل سیر و سلوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.67,
   "end": 390.57,
   "text": "برای کسی که میخواد به لقای خدا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.57,
   "end": 394.61,
   "text": "در بخش چهارم راهکارهای استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.61,
   "end": 399.77,
   "text": "وقتی بحث کلوا اشربوا ولا تسرفوا رو بیان میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.77,
   "end": 405.01,
   "text": "ایشون میفرماید \"واعلم حبیبی\" این عین کلامه چون رساله شون عربی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.01,
   "end": 409.49,
   "text": "عین کلام استاده. \"واعلم حبیبی\" دوست من بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.49,
   "end": 413.51,
   "text": "\"أن فضول الطعام يميت القلب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.51,
   "end": 417.93,
   "text": "اضافه ز-- غذا یعنی زیادی خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.93,
   "end": 421.67,
   "text": "قلب رو میمیراند. این قلب که بمیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.67,
   "end": 425.65,
   "text": "وقتی قلب مرد دیگه میفته به وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.65,
   "end": 430.69,
   "text": "شک و ریب و و از اونجا کشیده میشه به \"أن كذبوا بآيات الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.69,
   "end": 433.87,
   "text": "\"يميت القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.87,
   "end": 437.97,
   "text": "بلا كلام\". بلا كلام یعنی قطعاً، قطعاً یعنی این موضوع قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.97,
   "end": 444.85,
   "text": "اصلاً نیاز به گفتن نداره \"ومفتی إلى جح-- جموح النفس وطغيانها والجوع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.85,
   "end": 448.31,
   "text": "حالا اینجا بحث جوع رو مطرح میکنه است-استاد علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.31,
   "end": 452.79,
   "text": "\"والجوع من أجل الخصال المؤمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.79,
   "end": 461.11,
   "text": "و خالی بودن شکم یا گرسنگی یعنی به قدری شکمت خالی نباشه که البته بمیری یا ضعف عارض بشه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 461.11,
   "end": 464.03,
   "text": "یعنی شکمت به قدری خالی باشه که بگی خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.03,
   "end": 466.75,
   "text": "مثلا الان من نیاز دارم غذا بخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.75,
   "end": 470.67,
   "text": "اون حالت میگه از بهترین حالات مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.67,
   "end": 476.07,
   "text": "خیلی جالبه که ااا یه حدیثی هم اینجا حضرت علامه میاره از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.07,
   "end": 479.99,
   "text": "صادق صلوات الله علیه که راوی ابا بصیر است تو همین خصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.99,
   "end": 481.89,
   "text": "این حدیث رو گوش بدید چقدر زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.89,
   "end": 484.81,
   "text": "میفرماید \"إن البطن\" امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.81,
   "end": 487.75,
   "text": "صلوات الله علیه فرمود \"إن البطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.75,
   "end": 490.41,
   "text": "ليثقا من أكله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.41,
   "end": 494.71,
   "text": "طغیان شکم از غذاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.71,
   "end": 497.75,
   "text": "یعنی شکم وقتی طغیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.75,
   "end": 500.99,
   "text": "\"إن البطن ليثقا من أكله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.99,
   "end": 503.83,
   "text": "از غذا خوردنش. حالا میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.83,
   "end": 508.25,
   "text": "پر خورده، میشه گفت در هم بر هم خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.25,
   "end": 512.31,
   "text": "یعنی رعایت نکرده چی رو با چی بخوره یا بد خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.31,
   "end": 515.05,
   "text": "همه اینا میتونه باشه یا بد وقتی خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.05,
   "end": 519.99,
   "text": "\"أقرب ما يكون العبد من الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.99,
   "end": 526.77,
   "text": "جل وعلا\". نزدیک‌ترین وقت بنده به خداش کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.77,
   "end": 528.65,
   "text": "\"إذا خف بطنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.65,
   "end": 532.25,
   "text": "وقتیه که نمیگه کلاً خالی خالی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.25,
   "end": 535.69,
   "text": "معده میگه خف، خفیفه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.69,
   "end": 541.33,
   "text": "پر نیست. مشکل تو امتلای شکمه که معمولاً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.33,
   "end": 548.67,
   "text": "گرفتارش هستیم و \"أبغض ما يكون العبد إلى الله عز وجل إذا امتلأ بطنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.67,
   "end": 554.61,
   "text": "مبغوض‌ترین حالت یه بنده به خدا وقتیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 554.61,
   "end": 556.87,
   "text": "پر باشه. امتلای شکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.87,
   "end": 559.53,
   "text": "این امتلای شکم یا برعکسش هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 559.53,
   "end": 563.77,
   "text": "کلاً خالی نگه داشتن مثل این مرتاض‌ها که اصلا هیچی نمیخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.77,
   "end": 567.13,
   "text": "هر دوش میزنه مزاج رو به هم میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.13,
   "end": 570.55,
   "text": "خب حالا شما بفرمایید مزاج که به هم خورد چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 570.55,
   "end": 578.77,
   "text": "از اون حالت اعتدال بدن خارج میشه و دیگه بدن نمیتونه سکوی ارتقای نفس ناطقه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 578.77,
   "end": 586.33,
   "text": "چون قرار شد نفس ناطقه افعالش در بدن بروز کنه و با ف-فعالیت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.33,
   "end": 588.77,
   "text": "اون قابلیتش رو بروز بده و رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 588.77,
   "end": 591.67,
   "text": "دیگه وقتی بدن ضعف داره، مشکل داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 591.67,
   "end": 595.93,
   "text": "یا دچار گرفتاری‌های پرخوری و چیز و اینها شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.93,
   "end": 597.69,
   "text": "نمیتونه نفس رو ارتقا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.69,
   "end": 601.37,
   "text": "بعد یه همچین کسی آدم ناقصی میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 601.37,
   "end": 606.81,
   "text": "پس اینو توجه داشته باشیم. حالا من داشتم به آیه شصت و دو سوره مریم رسیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 606.81,
   "end": 610.43,
   "text": "صلوات الله علیها. دیدم چه جالب که تو این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 610.43,
   "end": 614.43,
   "text": "خوردن و خوردن، حالا غذا خوردن، طعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 614.43,
   "end": 616.75,
   "text": "بهشتی رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.75,
   "end": 622.87,
   "text": "صبح و شب میرسونه. به قدری فرمود \"لا يسمعون فيها لغوا إلا سلاما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 622.87,
   "end": 627.41,
   "text": "ولهم رزقهم فيها بكرة وعشيا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.41,
   "end": 632.39,
   "text": "صبح و شب رزق و طعام اهل بهشت داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 632.39,
   "end": 635.19,
   "text": "این خودش یه کده، یه رمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 635.19,
   "end": 638.35,
   "text": "که اگر کسی به قول حضرت استاد اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 638.35,
   "end": 641.15,
   "text": "غذای مقوی بخوره نه پر بخوره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.15,
   "end": 645.71,
   "text": "اسلام مخالف پرخوریه، موافق خوب خوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.71,
   "end": 653.99,
   "text": "اگر کسی مقوی و خوب بخوره اینطوری اثبات شده که دو بار صبح و شب کفایت میکنه بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 653.99,
   "end": 656.69,
   "text": "و این قصه جوع هم با روزه فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 656.69,
   "end": 661.03,
   "text": "اینو حواستون باشه. این نیست که حالا جو-- یعنی حتما روزه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.03,
   "end": 664.85,
   "text": "نه. میتونه طرف روزه هم نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 664.85,
   "end": 667.39,
   "text": "اما جوع رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 667.39,
   "end": 672.21,
   "text": "یعنی اون دو بار رو بخوره بقیه دیگه هی پر نکنه شکمشو تا گ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 672.21,
   "end": 681.77,
   "text": "خیلی جالبه که حالا بحث دیروز که تطابق بین انسان و یا آدم و عالم شما به قول استاد میگه دقت کنید به بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 681.77,
   "end": 688.99,
   "text": "بچه تون هنوز مز-مزاجش از اعتدال خارج نشده از همون شیرخوارگی ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 688.99,
   "end": 691.61,
   "text": "آرومه تا گشنه شد گریه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.61,
   "end": 696.35,
   "text": "شیر بهش میدن. به محض اینکه نیازش برطرف شد آروم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 696.35,
   "end": 700.51,
   "text": "دیگه س-سرش رو میکشه، صورتشو برمیداره از سینه مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 700.51,
   "end": 703.17,
   "text": "یعنی دیگه بسه مگه. یعنی تکوین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 703.17,
   "end": 705.45,
   "text": "کی به بچه یاد داد که الان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 705.45,
   "end": 710.85,
   "text": "مثلا نیاز داری گریه کن الان که نیازت برطرف شد آرامش داشته باش دیگه نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 710.85,
   "end": 713.83,
   "text": "دیگه نخور بسه. کی بهش یاد داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 713.83,
   "end": 717.03,
   "text": "تکوینه. تکوین نظام افقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 717.03,
   "end": 723.87,
   "text": "داره بهش درس میده. و جالبه بچه حتی از شیرم که میگیری تا وقتی که اعتدال مزاج داره اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 723.87,
   "end": 726.51,
   "text": "بچه معمولاً کمتر پرخوری میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 726.51,
   "end": 729.97,
   "text": "یه مقداری که نوجوون و جوون شد میفته به پرخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 729.97,
   "end": 732.23,
   "text": "لذت غذا خوردن و چشیدن و الی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 732.23,
   "end": 736.11,
   "text": "داره بازی میکنه، بازیگوشه. اصلاً نیاز نداره تو بهش بگی بیا غذات رو بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 736.11,
   "end": 740.24,
   "text": "خودش میگه مامان گشنمه. چهار تا لقمه خورد دیگه بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 740.24,
   "end": 742.96,
   "text": "میگه دیگه ول میکنه میره. غذاشم نصفه کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 742.96,
   "end": 746.56,
   "text": "ول کن اجبار نکن که الا بلا تا آخر غذاتو بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 746.56,
   "end": 751.34,
   "text": "اون تکوین نظام هستی داره بهش میگه کی بخور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 751.34,
   "end": 758.84,
   "text": "کی نخور. اینه که خیلی از موقع‌ها ماها میایم متاسفانه می‌زنیم تو تربیت، دخالت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 758.84,
   "end": 761.82,
   "text": "اصلا آقا ول کن تو نمی‌خواد تربیت کنی بچه‌تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 761.82,
   "end": 767.1,
   "text": "بذار خود نظام تکوین هستی داره تربیتش می‌کنه حتی تو مباحث اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 767.1,
   "end": 769.98,
   "text": "بچه از ابتدا میگن از قدیمیا می‌گفتن راست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 769.98,
   "end": 773.84,
   "text": "از بچه حرف راستو بشنو اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 773.84,
   "end": 775.94,
   "text": "یک پارچه صداقت محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 775.94,
   "end": 781.66,
   "text": "یواش یواش از پدر و مادر دروغ و حیله و نیرنگ و عدم صداقت و اینا رو یاد می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.66,
   "end": 790.38,
   "text": "پس اینو یادمون باشه که به هر حال این حالا روایات از شود مباحث از تعلمه رو من عرض کردم از این حیث که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 790.38,
   "end": 797.16,
   "text": "بدانیم هم کم گذاشتن برای بدن ضرر داره هم پر گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 797.16,
   "end": 799.08,
   "text": "اگرچه پر گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 799.08,
   "end": 803.26,
   "text": "ضررش بیشتره. خدا رحمت کنه الان یادم اومد که آقای مشکینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 803.26,
   "end": 806.02,
   "text": "خب ایشون خیلی گردن همه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 806.02,
   "end": 812.76,
   "text": "حق دارن. خیلی زحمت انقلاب رو کشیدن و معارف و حقایق رو پشتوانه امام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 812.76,
   "end": 816.02,
   "text": "ایشون یادمه توی سخنرانی‌هاشون یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 816.02,
   "end": 819.0,
   "text": "درس اخلاق برای طلبه‌ها داشتن می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 819.0,
   "end": 826.22,
   "text": "فرمودن، \"آی طلبه‌ها خوب بخورید، خوبم استراحت کنید تا بتونید خوب درس بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 826.22,
   "end": 832.48,
   "text": "من که الان میام برای شما درس بدم بیست تا قرص می‌خورم تا بتونم حرف بزنم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 832.48,
   "end": 836.54,
   "text": "چرا؟ گفت، \"من طلبه نوجوون و جوون که بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 836.54,
   "end": 838.24,
   "text": "فقر شدید مالی داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 838.24,
   "end": 840.32,
   "text": "نمی‌تونستم غذای مقوی بخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 840.32,
   "end": 842.98,
   "text": "بدنم ضعیفه. الان کشش ندارم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 842.98,
   "end": 847.48,
   "text": "و جالب اینجاست که شما ببینید این نکته پایانی رم خوب بهش توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 847.48,
   "end": 850.94,
   "text": "اینایی که کارهای پژوهشی، علمی اینا می‌کنن، فکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 850.94,
   "end": 854.02,
   "text": "یه آدمی که کارمنده، آدمی که کاسبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 854.02,
   "end": 860.26,
   "text": "اینایی که بالاخره کارشونو می‌کنن چهل پنجاه سالگی دیگه بازنشستن، پولشونو جمع کردن، مغازه‌شونو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 860.26,
   "end": 863.0,
   "text": "نمی‌دونم بیمه شدن. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 863.0,
   "end": 865.38,
   "text": "از شود خدمتتون بازنشستگی می‌گیرن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 865.38,
   "end": 867.36,
   "text": "هیچ-- اینا دیگه استراحت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 867.36,
   "end": 870.84,
   "text": "اما یه آدمی که تو وادی کار علمیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 870.84,
   "end": 873.48,
   "text": "یعنی کار علمی می‌کنه، عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 873.48,
   "end": 879.28,
   "text": "ها. اینایی که تو کار پژوهشی و تح-تحقیق و اینا هستن اتفاقاً هرچی سنشون میره بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 879.28,
   "end": 882.46,
   "text": "پخته‌تر می‌شن و نیاز اجتماع به اون‌ها بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 882.46,
   "end": 886.74,
   "text": "یعنی اینا وقتی مثلا چهل پنجاه ساله شدن، ببین پیغمبرم چهل سالگی مبعوث شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 886.74,
   "end": 889.68,
   "text": "تمام انبیا چهل سالگی به بعد مبعوث شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 889.68,
   "end": 896.26,
   "text": "وقتی ریشش سفید شد، یادش بخیر یکی از اولیای خدا رو من یه روزی زیارت کردم حدود سی سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 896.26,
   "end": 899.32,
   "text": "اون موقع خیلی من بال و پر می‌زدم برای خیلی چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 899.32,
   "end": 902.26,
   "text": "خیلی خودمو اذیت می‌کردم. اذیت‌های عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 902.26,
   "end": 905.7,
   "text": "هیچ‌وقت یادم نمیره. اون موقع به من گفت خودتو اذیت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 905.7,
   "end": 910.26,
   "text": "تو ما این ریشات که چند تاش سفید شد تازه اول کارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 910.26,
   "end": 913.98,
   "text": "نمی‌فهمیدم اون موقع چی میگه. و خودمون رو اذیت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 913.98,
   "end": 917.22,
   "text": "الان خود منم از جهت جسمی می‌بینین ضعف‌هایی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 917.22,
   "end": 924.38,
   "text": "آدم وقتی مخصوصاً کار علمی می‌کنه باید به گونه‌ای رفتار کنه که سنش رفت بالا تازه اول کارشه، تازه اول پختگیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 924.38,
   "end": 930.32,
   "text": "مثلا چقدر خوب بود الان رهبر عزیزمون بدن مثلا یه جوان بیست ساله اونجوری داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 930.32,
   "end": 933.36,
   "text": "چقدر خوب بود. از تعلم حسن زاده مثلا اینطوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 933.36,
   "end": 939.72,
   "text": "چقدر قشنگ می‌شد. خب اینا رو خب رعایت کنیم بلکه دچار شک و ریب و شکاکیت و این‌ها نشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 939.72,
   "end": 944.8,
   "text": "عاقبتمون انشاالله ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 944.8,
   "end": 950.24,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}