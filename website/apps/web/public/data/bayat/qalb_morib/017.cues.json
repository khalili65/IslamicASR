 "chapters": [
  {
   "index": 0,
   "title": "## طهارت اهل کتاب و غلو دربارهٔ علی",
   "start": 1.98,
   "end": 85.54
  },
  {
   "index": 1,
   "title": "## قلب مریب و ملکه نشدن حقایق",
   "start": 85.54,
   "end": 178.52
  },
  {
   "index": 2,
   "title": "## خواب و فراموشی؛ نشانهٔ نبود ملکه",
   "start": 178.52,
   "end": 215.54
  },
  {
   "index": 3,
   "title": "## نفس هرگز از خود غافل نیست",
   "start": 215.54,
   "end": 256.34
  },
  {
   "index": 4,
   "title": "## موت و تلقین؛ آشکار شدن ملکات",
   "start": 256.34,
   "end": 554.87
  },
  {
   "index": 5,
   "title": "امروز آیهٔ بیست و دو احزاب خوانده شد:",
   "start": 554.87,
   "end": 699.15
  },
  {
   "index": 6,
   "title": "## شهدا و حب الحسین",
   "start": 699.15,
   "end": 852.79
  },
  {
   "index": 7,
   "title": "## ملکات مواد صور برزخی",
   "start": 852.79,
   "end": 920.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.98,
   "end": 6.76,
   "text": "بسم الله الرحمن الرحیم و به him نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.76,
   "end": 12.34,
   "text": "این اکو شو. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.34,
   "end": 17.58,
   "text": "آیاته سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.58,
   "end": 21.42,
   "text": "خدا به شما خیر بده. می‌دونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.42,
   "end": 26.32,
   "text": "بعضی از مراجع، اهل کتاب رو ذاتاً نجس می‌دونن مثل کفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.32,
   "end": 28.46,
   "text": "اما رهبر عزیزمون چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.46,
   "end": 32.64,
   "text": "رهبر قربونشون بریم ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.64,
   "end": 36.76,
   "text": "نظرشون اینه که اهل کتاب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.76,
   "end": 40.32,
   "text": "ذاتاً پاک‌اند. حالا اهل کتاب چی-- کی‌آن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.32,
   "end": 43.04,
   "text": "باز استفتعا شده از آقام که اصلا کی هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.04,
   "end": 50.62,
   "text": "فرمودن کسانی که قائل به یکی از انبیا یا یکی از کتب آسمانی باشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.62,
   "end": 53.1,
   "text": "و چه عجیب اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.1,
   "end": 61.08,
   "text": "وقتی از همین آقا می‌پرسن که اون‌هایی که علی علیه الصلاة والسلام رو خدا فرض می‌کنند چه گونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.08,
   "end": 65.3,
   "text": "آقا می‌فرما صریحاً می‌فرما اون کسی که علی صلوات الله علیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.3,
   "end": 70.48,
   "text": "العیاذ بالله خدا می‌داند، اون در حکم کافره و نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.48,
   "end": 76.6,
   "text": "نجس علینه. که متأسفانه هنوزم که هنوزه رگه هاش دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.6,
   "end": 78.88,
   "text": "حتی بعضا نماز و روزه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.88,
   "end": 81.4,
   "text": "این گروهها نمی‌خونن، نمی‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.4,
   "end": 85.54,
   "text": "به جاش دعا و نیایش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.54,
   "end": 89.24,
   "text": "بحث امروز ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.24,
   "end": 92.62,
   "text": "هم به نوعی مهک زدن خودمونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.62,
   "end": 96.6,
   "text": "قلبمون در وضعیت يقينه یا شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.6,
   "end": 100.28,
   "text": "و تردیده. هم به نوعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.28,
   "end": 107.1,
   "text": "متوجه شدن وضعیت کلاً نفس ناطقه به صورت کلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.1,
   "end": 110.36,
   "text": "از دلایل اینکه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.36,
   "end": 117.14,
   "text": "دچار شک و ریب هستیم یعنی از نه، کلاً دلیل اصلی که دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.14,
   "end": 120.5,
   "text": "قلب مردد یا مریب هستیم اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.5,
   "end": 127.9,
   "text": "این حقایق کلی ملکات وجودی ما نشده، ملکه نشده برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.9,
   "end": 132.3,
   "text": "که حالا چون قبلاً بحث ملکات گذشته ازش می‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.3,
   "end": 139.68,
   "text": "خب چگونه میشه فهمید که حقیقتی ملکه وجودی ما شده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.68,
   "end": 144.28,
   "text": "یکی از بهترین جاها وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.28,
   "end": 146.32,
   "text": "عوض شدن طور انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.32,
   "end": 152.06,
   "text": "خلقکم اتوارا که قرآن میگه ما شما رو به طورهای مختلف خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.06,
   "end": 154.46,
   "text": "چه جالبه که دم دست ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.46,
   "end": 156.76,
   "text": "مثلاً طور منامیه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.76,
   "end": 159.54,
   "text": "یعنی اصطلاحاً همون خواب که میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.54,
   "end": 163.78,
   "text": "طور ما از حالت مادی عوض می‌شه، به برزخی تبدیل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.78,
   "end": 167.4,
   "text": "طور وجودیمون. حتی بدنمون هم تغییر میده-- می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.4,
   "end": 174.52,
   "text": "مت-- یعنی اون بدنمون همین بدن تفاله بدنمون که جسممونه اینجاست ما وارد بدن برزخی می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.52,
   "end": 179.4,
   "text": "و نفس ناطقمون اون طوله-- طور مجرد خودش رو در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.4,
   "end": 183.28,
   "text": "در حقیقت اون بدن برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.28,
   "end": 186.82,
   "text": "به حیاتش ادامه می‌ده. حالا اونجا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.82,
   "end": 190.86,
   "text": "خواب اصطلاحاً طور منامیه که حکما می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.86,
   "end": 194.26,
   "text": "خیلی اتفاقات میفته. اینجا رو خوب گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.26,
   "end": 198.06,
   "text": "چگونه است که وقتی ما بیدار می‌شیم هیچی یادمون نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.06,
   "end": 201.86,
   "text": "توجه کردید؟ همین آن، الان مثلاً شما تو خوابید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.86,
   "end": 206.82,
   "text": "انواع و اقسام چیزها رو می‌بینید، می‌چشید، می‌خورید، می‌شنوید، می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.82,
   "end": 214.52,
   "text": "به محض اینکه آنی که وارد طور مادیتون شدید برگشتید از برزخ که اون، اون می‌شه برزخ وجودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.52,
   "end": 216.94,
   "text": "از اون عالم مثال برگشتید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.94,
   "end": 222.4,
   "text": "طور مادیتون یعنی به نشئه طبیعت، یک آنه اما تمام چیزا یادتون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.4,
   "end": 225.68,
   "text": "می‌گی من الان یه خوابی داشتم می‌دیدم هرچی بهت میگن خب چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.68,
   "end": 230.54,
   "text": "چی بود؟ یادت نمیاد. چرا یادت نمیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.54,
   "end": 233.98,
   "text": "به جهت اینکه ملکه وجودیت نبوده این چیزایی که دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.98,
   "end": 237.52,
   "text": "ملکات نبودن. یعنی راسخ نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.52,
   "end": 239.78,
   "text": "تو علم اخلاق میگن راسخ نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.78,
   "end": 242.68,
   "text": "تو حکمت میگن ملکه نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.68,
   "end": 245.68,
   "text": "توجه کردی؟ اینجا راحت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.68,
   "end": 253.7,
   "text": "یعنی در طور منامیه می‌شه تشخیص داد چه چیزایی راسخ شده در وجود انسان یا ملکه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.7,
   "end": 256.8,
   "text": "البته بعضی چیزا هست نصفه نیمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.8,
   "end": 260.66,
   "text": "یعنی طرف یک عمر خو کرده با اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.66,
   "end": 263.42,
   "text": "تا حدی داره به سمت ملکه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.42,
   "end": 265.9,
   "text": "اونا چگونه است؟ برای همه اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.9,
   "end": 270.06,
   "text": "یه دفعه یه حالتی رو درک می‌کنید، یک مکانی، یک زمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.06,
   "end": 275.66,
   "text": "یک طوری رو یه دفعه می‌گی اِ انگار که این اتفاق یه بار دیگه برای من رخ داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.66,
   "end": 278.66,
   "text": "اینطور زیاد شدیم قطعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.66,
   "end": 282.92,
   "text": "انگار یک بار دیگه یعنی انگار این واقعه برای من تکراریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.92,
   "end": 286.02,
   "text": "انگار یک بار دیگه من این حالت رو درک کرده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.02,
   "end": 290.26,
   "text": "چی بوده این؟ همین حالت رو شما در خواب قبلاً دیده بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.26,
   "end": 294.78,
   "text": "یادت رفته بوده. الان همونی که در خواب دیدی دوباره داری الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.78,
   "end": 300.78,
   "text": "در نشئه طبیعت می‌بینیش. که اگر کسی هیچوقت خواباش یادش نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.78,
   "end": 303.9,
   "text": "می‌رسه به چی؟ به همون علم الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.9,
   "end": 306.16,
   "text": "و از آینده‌ها می‌تونه خبر بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.16,
   "end": 309.12,
   "text": "پیام‌های الهی رو می‌گیره. منتها چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.12,
   "end": 312.4,
   "text": "متأسفانه اتصالش به مبدأ وحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.4,
   "end": 316.72,
   "text": "قطع شده بر اثر خیلی چیزها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.72,
   "end": 323.7,
   "text": "دیگه این می‌مونه. منتها این نکته مهمه که بدونیم نفس هیچوقت از خودش غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.7,
   "end": 326.18,
   "text": "موتور نفس دائماً روشنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.18,
   "end": 330.06,
   "text": "و آنچه که نفس درک می‌کنه در هر نشئه ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.06,
   "end": 334.76,
   "text": "در وجود خودش ضبط می‌کنه و دائماً اینا رو با خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.76,
   "end": 341.74,
   "text": "منتها اگر ما متوجه نمی‌شیم از حالت توجه خارج می‌شیم چون اونچه که در نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.74,
   "end": 345.88,
   "text": "در حالا حافظه نفس بگیم در اون گنجینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.88,
   "end": 349.5,
   "text": "نفس جمع شده، اون‌ها جزو ملکات ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.5,
   "end": 351.58,
   "text": "به نوعی برای ما اضافاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.58,
   "end": 357.38,
   "text": "مثل کسی که یه غذایی رو می‌خوره چون سوء هاضمه داره یا هرچی عق می‌زنه جسارتاً بالا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 357.38,
   "end": 361.57,
   "text": "یعنی این ماله این نبود. زد آورد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.57,
   "end": 368.47,
   "text": "اینه که پس یکی از بهترین طورهایی که جاهایی که انسان می‌تونه تشخیص بده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.47,
   "end": 371.69,
   "text": "ملکات وجودیش شده چیزی یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.69,
   "end": 375.93,
   "text": "در همون طور منامیه است وقت خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.93,
   "end": 379.65,
   "text": "که حالا خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.65,
   "end": 384.65,
   "text": "به هر حال ما وقتی که هممون قراره این طور منامیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.65,
   "end": 387.77,
   "text": "در عالم برزخ به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.77,
   "end": 391.93,
   "text": "اجباری حداقل بچشیم بعضیا خب عهدی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.93,
   "end": 396.47,
   "text": "عزیزان می‌تونن به موت اختیاری هم بک-- بچشن اما کم‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.47,
   "end": 401.53,
   "text": "اونایی که به موت اجباری‌اند همه‌ن، همه به موت اجباری این حالت رو می‌چشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.53,
   "end": 404.71,
   "text": "اونجا چه اتفاقی میفته؟ باز نفس از خودش غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.71,
   "end": 407.57,
   "text": "اونجا دیگه باز ملکات می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.57,
   "end": 411.81,
   "text": "خیلی جالبه که شما دقت بفرمایید چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.81,
   "end": 417.05,
   "text": "وقتی کسی مرد می‌ذارنش تو قبر شارع مقدس فرموده تلقین بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.05,
   "end": 419.65,
   "text": "چرا؟ بعد جالبه می‌گه عربی هم بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.65,
   "end": 422.39,
   "text": "آقا این زبانش انگلیسیه، فرانسویه، فارسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.39,
   "end": 427.37,
   "text": "چرا برای همه عربی می‌خونن؟ این پیداست که اصلا نفس داره می‌شنوه نه جسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.37,
   "end": 430.41,
   "text": "این بابا جسمش فارس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.41,
   "end": 439.87,
   "text": "حواجس افکاره اون حالا حواس پنجگانه ش قواي سامعه ظاهریه‌ش بود که فارسی می‌فهمید عربی نمی‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.87,
   "end": 443.77,
   "text": "نفس ناطقه اصلاً یه مجرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 443.77,
   "end": 446.91,
   "text": "اصلاً ربطی به کلام نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 446.91,
   "end": 453.71,
   "text": "که حالا چه کلمه‌ایه. منتها چون کلام که حالا عربی نور داره و کلام خداست و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 453.71,
   "end": 456.37,
   "text": "مبانی‌ای داره. میگه به عربی بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.37,
   "end": 462.05,
   "text": "اینکه میگه و اذا مثلاً اذا اتاك الملكان المقربان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.05,
   "end": 468.15,
   "text": "رسولین من عند الله تبارک وتعالی وسألا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 468.15,
   "end": 470.25,
   "text": "وقتی اومدن به کی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 470.25,
   "end": 473.95,
   "text": "به اون میته که تو خاک ظاهراً خوابوندیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.95,
   "end": 477.01,
   "text": "اسمع بشنو افهم بفهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.01,
   "end": 478.89,
   "text": "چند بارم تو تلقین هی اینو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 478.89,
   "end": 483.25,
   "text": "یا مثلاً عبدالله ابن عبدالله یا فلان ابن فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 483.25,
   "end": 489.97,
   "text": "و س-- وقتی اینا اومدن اون دو تا ملک اومدن و سألا که ازت سؤال کردن عن ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.97,
   "end": 494.99,
   "text": "و عن نبیك و عن دینك و عن كتابك و عن قبلتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 494.99,
   "end": 498.81,
   "text": "و عن ائمتك فلا تخف ولا تحزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.81,
   "end": 503.47,
   "text": "سؤال مگه اینا برای ما ملکه نبوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.47,
   "end": 505.89,
   "text": "چگونه است که دوباره داره میگه تکرار کن براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.89,
   "end": 508.71,
   "text": "یعنی الان از ما بپرسن آقا قبله کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 508.71,
   "end": 511.53,
   "text": "مکه. پیغمبرت كه؟ رسول اکرم اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.53,
   "end": 515.27,
   "text": "ائمه کی‌اند؟ امیرالمؤمنین. همینطور مثل بلبل میگیم قر-- کتابت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 515.27,
   "end": 517.65,
   "text": "قرآن. دینت؟ اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 517.65,
   "end": 522.47,
   "text": "چرا دوباره اونجا میگن؟ به جهت اینکه یه دهشتی، یه وحشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.47,
   "end": 525.39,
   "text": "یه حالت بیهوشی اونجاست دست میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 525.39,
   "end": 527.59,
   "text": "طور که عوض می‌شه ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 527.59,
   "end": 531.09,
   "text": "طور که عوض می‌شه فقط ملکات می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.09,
   "end": 533.39,
   "text": "دیگه بقیه اصلاً میره از ذهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.39,
   "end": 536.13,
   "text": "مثل اینکه منها می‌شن از وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 536.13,
   "end": 540.09,
   "text": "اونچه که می‌مونه در دخل وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 540.09,
   "end": 543.43,
   "text": "ملکات نفسانیته یعنی راسخ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.43,
   "end": 548.69,
   "text": "لذا جالبه که داشتم امروز می‌خوندم آیه‌ی بیست و دو احزاب رو سری هم نوشتمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 548.69,
   "end": 552.99,
   "text": "خیلی برام جالب بود که خدا اونجا می‌فرماید ولما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.99,
   "end": 556.11,
   "text": "ولما رأى المؤمنون الاحزاب وقتی اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 556.11,
   "end": 560.31,
   "text": "تو جنگ احزاب قرار گرفتن و اون همه سیطره دشمن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.31,
   "end": 562.73,
   "text": "اون سپاه انبوه رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.73,
   "end": 567.39,
   "text": "حالا منافقین و حزب‌های مختلف دیدن، اومدن حمله ور شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 567.39,
   "end": 572.85,
   "text": "قالوا هذا خ-- جالبه قرآن میگه اصلا مطلقا نترسیدن که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 572.85,
   "end": 577.83,
   "text": "گفتن هذا ما وعدنا الله ورسوله وصدق الله ورسوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 577.83,
   "end": 583.45,
   "text": "این همون وعده‌ایه که خدا و پیغمبر دادن و درستم گفتن و صدقه راستم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 583.45,
   "end": 586.97,
   "text": "و ما زادهم اینجا رو ببینید انتهای آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 586.97,
   "end": 590.79,
   "text": "و ما زادهم الا إيمانا وتسليما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 590.79,
   "end": 598.13,
   "text": "با اون هیمنه دشمن و شکوه ظاهری باز اینا بهشون به اهل ایمان اضافه نشد مگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.13,
   "end": 600.91,
   "text": "چی؟ ایمان و تسلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 600.91,
   "end": 605.33,
   "text": "چرا؟ پیداست اینایی که قرآ-- این آیه درباره‌شون اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.33,
   "end": 608.69,
   "text": "اینا ملکه وجودشون ایمان به خدا و رسول بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 608.69,
   "end": 612.07,
   "text": "ملکه بوده که لذا حتی وقت ترس هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.07,
   "end": 614.99,
   "text": "خودش رو اینطوری نشون داده. وقت ترس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 614.99,
   "end": 618.41,
   "text": "اتفاقا یکی از جاهایی که آدم خوب می‌تونه خودشو بشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 618.41,
   "end": 621.69,
   "text": "که قلبش به یقین رسیده یا هنوز مشکوکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 621.69,
   "end": 623.67,
   "text": "وقت ترس ببینه چه حالتی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.67,
   "end": 627.17,
   "text": "اونم یه طوریه. عوض شدن طوره وقت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.17,
   "end": 633.97,
   "text": "جالبه که توی خود تلقین هم بهش میگه به میت میگی \"لا تخف\" نترسیا \"لا تحزن\" محزون نشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.97,
   "end": 637.75,
   "text": "این طور وجودی که عوض شد وقت ترس خودتو بیاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 637.75,
   "end": 642.63,
   "text": "یکی وقت بیدار شدن از خوابه، یکی وقت اومدن از حالت بیهوشی به بیرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 642.63,
   "end": 644.79,
   "text": "اینا قبلاً بحث‌هاش براتون گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.79,
   "end": 646.87,
   "text": "یکی وقت ترسه. چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 646.87,
   "end": 651.89,
   "text": "به محض اینکه یه خبر هولناکی می‌رسه از یه چیزی می‌ترسی، چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 651.89,
   "end": 655.19,
   "text": "اونجا چی میگی؟ اون که میگی ملکه وجودیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 655.19,
   "end": 658.97,
   "text": "یکی اوو میگه يا اباالفضل ع اصلاً ناخودآگاه میگه یا زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 658.97,
   "end": 662.83,
   "text": "اینا ملکه وجودیشه. بعد وقت مرگ هم همین رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 662.83,
   "end": 664.93,
   "text": "چطور اون که هیزم فروش بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 664.93,
   "end": 667.81,
   "text": "حضتم بفلس حضتم بفلس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 667.81,
   "end": 671.29,
   "text": "فلس حالا پول اون زمان بود. یه بسته هیزم به یه فلس فلس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 671.29,
   "end": 675.73,
   "text": "وقت مرگش هرچی تلقینش کردن هی می‌گفت حضتم بفلس حضتم به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 675.73,
   "end": 679.01,
   "text": "هرچی ملکه وجودیته اون موقع می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 679.01,
   "end": 681.25,
   "text": "دیگه اینطوری نی-- اونجا نمیشه فیلم بازی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 681.25,
   "end": 686.47,
   "text": "نمیشه ریاکاری کرد. مثل من الان لباس پیغمبر بپوشم و شروع کنم حرف‌های مقدس مآبانه زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 686.47,
   "end": 688.43,
   "text": "نه، اونجا طور وجودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.43,
   "end": 691.73,
   "text": "که عوض شد هرچی حق تو وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.73,
   "end": 694.13,
   "text": "قشنگ حاق شده. یعنی ریشه داد ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.13,
   "end": 699.15,
   "text": "تعادل وجودی با تو برقرار کرده همون خودش رو نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.15,
   "end": 705.25,
   "text": "پس نتیجه اگر بخواهیم بفهمیم که بالاخره وضعیت ما چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 705.25,
   "end": 707.37,
   "text": "چه کنیم؟ بالاخره ما جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 707.37,
   "end": 712.43,
   "text": "قلب مریب هستیم یا قلبی که به یقین رسیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 712.43,
   "end": 716.55,
   "text": "وقت عوض شدن تورمون می‌تونیم این رو متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 716.55,
   "end": 719.41,
   "text": "چطوره که شهدا رو شهداي کربلا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 719.41,
   "end": 722.83,
   "text": "هر کدومشون روایت داریم می‌رفتن بالا سرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 722.83,
   "end": 724.99,
   "text": "حالا واقع‌نگارهایی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 724.99,
   "end": 729.29,
   "text": "می‌رفتن مثل الان خبرنگارا تک تک هرکی شهید میشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 729.29,
   "end": 736.13,
   "text": "مثل مثلاً مقتل ابی مخنف که قدیمی‌ترین مقاتله ماست که متأسفانه مداح‌ها خیلی ازش حرف نمی‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.13,
   "end": 738.63,
   "text": "از مستندترین مقاتله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 738.63,
   "end": 744.61,
   "text": "خودش واقع‌نگار بوده. خبرنگار بوده اون موقع یک یک می‌رفت هرکی می‌افتاد می‌شنید، می‌نوشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 744.61,
   "end": 751.07,
   "text": "حتی ابا عبدالله رو. هر شهیدی که می‌افتاد به اونایی که زنده بودن می‌گفت \"اوسی ک بحب الحسین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 751.07,
   "end": 753.57,
   "text": "\"اوسی ک بحب الحسین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 753.57,
   "end": 756.47,
   "text": "یا \"اوسی ک به هذا\" تو رو وصیت می‌کنم به این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 756.47,
   "end": 760.29,
   "text": "دارن جون میده. اومدن سر از تنش جدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 760.29,
   "end": 763.19,
   "text": "نیزه و شمشیر می‌زنن میگه \"اوسی ک به هذا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 763.19,
   "end": 766.11,
   "text": "به این آقا سفارشت می‌کنم، به این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 766.11,
   "end": 770.01,
   "text": "یا یکی از علما و برجستگان و بزرگان بود که همش براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 770.01,
   "end": 776.23,
   "text": "سؤال بود این سعید بن عبدالله که رو به رو ابا عبدالله وایساد وقت نماز سیزده تیر خورد آخرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 776.23,
   "end": 779.05,
   "text": "پیشونیش افتاد رو آغوش امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 779.05,
   "end": 781.73,
   "text": "آقا سلام داد. آقا بلند شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 781.73,
   "end": 786.91,
   "text": "سلام نماز رو که داد سر سعید رو به دامن گرفت گفت \"أوفيت بعهدي\" به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 786.91,
   "end": 789.83,
   "text": "اربابش گفت وای من به عهدم وفا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.83,
   "end": 796.19,
   "text": "ابا عبدالله گریان شد دست به سرش کشید فرمود چگونه به عهدت وفا نکردی که تو در بهشت همیشه رو به روی منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 796.19,
   "end": 802.89,
   "text": "الله اکبر. این عالم میگه که من برام سؤال بود چگونه سعید بن عبدالله به یه همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 802.89,
   "end": 806.13,
   "text": "مثلاً استقامتی رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 806.13,
   "end": 811.39,
   "text": "بشین-- وایسته جلوی ابا عبدالله سیزده تا چوبه تو ب-تیر به خودش بگیره آخرش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 811.39,
   "end": 815.25,
   "text": "شک داشته باشه که آیا من واقعاً وفادار بودم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 815.25,
   "end": 821.55,
   "text": "میگه در حالت مکاشفه همین سعید بن عبدالله رو و همه‌ی هفتاد و دو تن رو بهم نشون دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 821.55,
   "end": 826.91,
   "text": "و یکی از مراجع ایشون الان اسمش از خاطرم رفته متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 826.91,
   "end": 829.69,
   "text": "بعد از خود سعید بن عبدالله تو اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 829.69,
   "end": 832.61,
   "text": "تو اون طور وجودی خودم سؤال کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 832.61,
   "end": 836.57,
   "text": "که تو چه کردی که اینطوری تونستی تحمل کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 836.57,
   "end": 839.91,
   "text": "سریع اشاره به همین کرد. \"حب الحسین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 839.91,
   "end": 843.39,
   "text": "\"حب الحسین\". \"حب الحسین\" از عشق امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 843.39,
   "end": 849.25,
   "text": "والسلام. عشق، اون حب، حب ریشه می‌دونه، می-می‌دواند در وجود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 849.25,
   "end": 852.79,
   "text": "و اون طور وجودی رو تثبیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 852.79,
   "end": 855.63,
   "text": "پس حواسمون جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 855.63,
   "end": 859.27,
   "text": "ان-اونچه که برای ما می‌ماند ملکات نفسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 859.27,
   "end": 866.83,
   "text": "یه جمله‌ی خاتمه بگم که در رابطه با این چند جمله از سر حرف زدم الان این بحث رو الصاق کنیم و سنجاق کنیم به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 866.83,
   "end": 868.93,
   "text": "حضرت علامه حسن زاده در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 868.93,
   "end": 872.53,
   "text": "شریف و عرشی انسان در عرف عرفانش یه اصلی رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 872.53,
   "end": 875.83,
   "text": "پیرامون معرفت نفس می‌فرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 875.83,
   "end": 880.19,
   "text": "ملکات نفسانی انسان، این جمله آخر رو گوش بدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 880.19,
   "end": 882.49,
   "text": "ملکا خیلی جمله عرشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 882.49,
   "end": 885.83,
   "text": "ملکات نفسانی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 885.83,
   "end": 889.93,
   "text": "مواد، صور و اشکال برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 889.93,
   "end": 892.99,
   "text": "یه بار دیگه میگم ملکات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 892.99,
   "end": 895.69,
   "text": "ملکات نفسانی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 895.69,
   "end": 900.51,
   "text": "مواد، مواد، صور و اشکال برزخی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 900.51,
   "end": 904.75,
   "text": "یعنی هرچی اونور ما صور و اشکال می‌بینیم در عالم برزخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 904.75,
   "end": 906.53,
   "text": "ملکات نفس ناطقه مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 906.53,
   "end": 909.31,
   "text": "اونچه که ریشه دوانده و غیر از اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 909.31,
   "end": 914.37,
   "text": "ان‌شاءالله که عاقبتون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 914.37,
   "end": 920.17,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}