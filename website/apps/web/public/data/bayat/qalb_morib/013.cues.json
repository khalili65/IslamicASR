 },
 "chapters": [
  {
   "index": 0,
   "title": "## طهارت ظاهری و خرید از مغازه",
   "start": 0.44,
   "end": 21.86
  },
  {
   "index": 1,
   "title": "بحث قلب مریب — قلب دچار تردید و شک — است. آیهٔ بیست و سوم بقره را بنگرید:",
   "start": 21.86,
   "end": 316.48
  },
  {
   "index": 2,
   "title": "## مأدبة الله و اطعام جان",
   "start": 316.48,
   "end": 372.28
  },
  {
   "index": 3,
   "title": "## پرچم هیئت؛ دهان جان",
   "start": 372.28,
   "end": 638.22
  },
  {
   "index": 4,
   "title": "## سید رضی و سید مرتضی؛ شافی و کافی",
   "start": 638.22,
   "end": 835.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 5.66,
   "text": "و به این استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 17.08,
   "text": "آیا ص سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.08,
   "end": 21.86,
   "text": "خدا بهتون سلامتی بده انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.86,
   "end": 28.96,
   "text": "سؤال می‌شه که این بعضیا هستن که خب مغازه مثلاً اغذیه فروشی و این چیزها زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.96,
   "end": 32.86,
   "text": "و بعضاً می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.86,
   "end": 38.18,
   "text": "حتی از خارج از کشور اومدن یا بالاخره ما خبر نداریم که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.18,
   "end": 44.26,
   "text": "دینشون چیه. خیلی مغازه‌هایی که ما می‌ریم حتی موادی که غذا توش پخته می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.26,
   "end": 52.44,
   "text": "اینها بالاخره اینها احتمال این هستش یا حتی دیده بشه که بدنش که مرطوبه داره با غذا لمس می‌کنه این غذا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 52.44,
   "end": 54.76,
   "text": "و رطوبت منتقل می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 54.76,
   "end": 58.46,
   "text": "بالاخره ما خبر نداریم دین این آقا چیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 58.46,
   "end": 60.46,
   "text": "چه باید کرد اینجور مواقع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.46,
   "end": 68.34,
   "text": "اشکالی داره از این مغازه‌ها خرید کرد یا اصلاً واجبه که بری دین طرف رو بپرسی چه دینی داره، چه مذهبی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.34,
   "end": 73.52,
   "text": "رهبر عزیزمون فرمودن نخیر، پرس‌وجو پیرامون دین طرف واجب نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 73.52,
   "end": 75.9,
   "text": "و همون طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.9,
   "end": 81.96,
   "text": "حکم طهارت اشیا به صورت کلی، اون محکوم بودن به طهارت در خصوص این‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.96,
   "end": 87.12,
   "text": "حتی اگر برخورد داشته باشن با اون مواد هم بدنشون برخورد داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.12,
   "end": 89.32,
   "text": "اون حکم برقراره و باقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.32,
   "end": 91.48,
   "text": "این یه مجری شرعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.48,
   "end": 94.84,
   "text": "که شرع دین، اون ظاهر دین داره به ما دستور می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.84,
   "end": 97.5,
   "text": "اما یکی هست می‌خواد لطیف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.5,
   "end": 100.78,
   "text": "ذیل اسم لطیف خدا حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.78,
   "end": 104.24,
   "text": "یعنی لطف خدا بیشتر شامل حالش بشه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.24,
   "end": 107.78,
   "text": "عرض کردیم دیگه مدارج انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.78,
   "end": 110.88,
   "text": "اون درجات یا معارج بهتره بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.88,
   "end": 113.66,
   "text": "اون معراج‌های انسانی به عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.66,
   "end": 116.08,
   "text": "مدارج قرآنیه که همون آیات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.08,
   "end": 119.82,
   "text": "یعنی تو هرچی بخوای رشد کنی راه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.82,
   "end": 123.96,
   "text": "مثلاً چرا امام عصر صلوات الله علیه به یکی از دوستانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.96,
   "end": 127.14,
   "text": "از علمای که حالا اسمش از خاطرم رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.14,
   "end": 135.36,
   "text": "می‌فرمودن که شما خواستی مواد غذایی تهیه کنی برای منزلت از این، از این مغازه از این شخص بخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.36,
   "end": 137.52,
   "text": "یعنی مشخص کرد حتی آقا براش از کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.52,
   "end": 140.66,
   "text": "این نشون میده که خب اگر کسی بخواد رشد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.66,
   "end": 144.72,
   "text": "باید حواسش جمع باشه دیگه. مثل اون بچه‌ای که چشمش باز شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.72,
   "end": 148.06,
   "text": "می‌اومد مسجد به این خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.06,
   "end": 153.44,
   "text": "حاج آقا سید عبدالله تهرانی بودن اگه اشتباه نکنم تو مسجد جامع امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.44,
   "end": 156.1,
   "text": "قبل انقلاب نماز می‌خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.1,
   "end": 159.64,
   "text": "گفته بود چقدر بچه به پیش نماز گفته بود چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.64,
   "end": 161.78,
   "text": "یا امام جماعت چقدر مسجد شلوغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.78,
   "end": 164.02,
   "text": "چقدر مثلاً آدم تا اون پشت‌ها می‌شینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.02,
   "end": 167.02,
   "text": "نگو ملائکه الله رو می‌دیده این بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.02,
   "end": 170.14,
   "text": "بعد این آقا می‌بینه این بچه به دردسر می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.14,
   "end": 174.72,
   "text": "بهش یه پولی میده میگه برو تو همین بازار، همین بازار یه چیزی بخر بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.72,
   "end": 177.4,
   "text": "میره می‌خوره. پولم از دست یه عالم گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.4,
   "end": 179.98,
   "text": "فردا میاد میگه خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.98,
   "end": 181.72,
   "text": "چه خبر؟ مسجد شلوغه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.72,
   "end": 185.26,
   "text": "میگه نه امروز خیلی خلوته. کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.26,
   "end": 188.22,
   "text": "اکثراً رفتن. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.22,
   "end": 195.44,
   "text": "خب حالا این فرق بین پول حلال و پول طیبه که قبلاً روش بحث کردیم که چه فرقی با هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.44,
   "end": 199.36,
   "text": "پس جای رشد هست. اما بحث ما پیرامون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.36,
   "end": 203.68,
   "text": "مریب یا قلبی که دچار تردید و شک و این‌هاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.68,
   "end": 208.22,
   "text": "اجازه بفرمایید به آیه بیست و سه سوره البق-- سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.22,
   "end": 212.66,
   "text": "توجه کنید. می‌فرماید \"وإن كنتم في ريبٍ ريب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.66,
   "end": 221.02,
   "text": "اگه شما دچار شکیید \"مما نزلنا على عبدنا\" بر این چیزی که ما نازل کردیم بر بنده‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.02,
   "end": 228.78,
   "text": "اگه دچار ريبيد و شک و تردید، یقین ندارید \"فاتوا بسورة مثله\" بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.78,
   "end": 232.06,
   "text": "مثلش رو، یه سوره مثلش رو بیارید ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.06,
   "end": 240.12,
   "text": "بسم الله. بعد تازه \"وادعوا شهداءكم\" هرکی هم می‌خواید بخونید از شاهدین این قصه هرکی می‌خواید شاهد بگیرید بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.12,
   "end": 242.38,
   "text": "همه‌تون با هم جمع شید به جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.38,
   "end": 244.86,
   "text": "\"من دون الله\" به جز الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.86,
   "end": 247.28,
   "text": "\"إن كنتم صادقين\" اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.28,
   "end": 255.4,
   "text": "صادقید راست می‌گید. که حالا اینا اومدن ملعونا به خی-- به زحمت باطل خودشون یه سوره هم خلق کردن و درست کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.4,
   "end": 258.82,
   "text": "کردن. والفيل و ما و مال فيل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.82,
   "end": 261.94,
   "text": "وما أدراك ما الفيل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.94,
   "end": 264.96,
   "text": "والخرطوم الطويل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.96,
   "end": 269.02,
   "text": "یه چیز چرتی برای خودشون درست کردن به عنوان حالا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.02,
   "end": 273.32,
   "text": "خوش نه-- در صورتی که این آیات و این سوره حالا اونی که تو علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.32,
   "end": 278.76,
   "text": "ظاهری قرآن کار کردن به قدری اسرار کشف کردن که کتاب‌ها نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.76,
   "end": 282.18,
   "text": "ارتباط این عدد حتی آیات، عدد حروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.18,
   "end": 287.14,
   "text": "شکل ان-- حالا ازدواج این حروف و کلمات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.14,
   "end": 289.76,
   "text": "جملات و مضامین و اسامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.76,
   "end": 295.1,
   "text": "سوره ها اینا تعدادش، عدد آیاتش اینا همه با حتی این نظام افقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.1,
   "end": 298.08,
   "text": "که دو تا قرآن شد دیگه. این قرآنه که از این اون نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.08,
   "end": 300.82,
   "text": "اون قرآن هستی که قبلاً بحث کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.82,
   "end": 303.24,
   "text": "هر دو مرتبطن. نمیشه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.24,
   "end": 311.16,
   "text": "قرآن یه سفره‌ایست که خدای منان خودش ایجاد کرده از علم ذاتی حضرت حق هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.16,
   "end": 315.36,
   "text": "حالا به قول حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.36,
   "end": 318.74,
   "text": "اشاره می‌کنم به اون حدیث شریفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.74,
   "end": 321.66,
   "text": "به صورت کاملش در غرر والدرر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.66,
   "end": 324.14,
   "text": "سید مرتضی علم-- علم الهدى اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.14,
   "end": 329.16,
   "text": "برادر سید رضی. نصف و نیمه‌ش تو کتاب مجمع البيان جلده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.16,
   "end": 334.38,
   "text": "صفحه شونزده اومده که پیامبر فرمودن إن هذا القرآن این، این قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.38,
   "end": 338.06,
   "text": "هذا القرآن این قرآنه نه قرآن دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.06,
   "end": 340.48,
   "text": "معدوبة الله. دو تاش هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.48,
   "end": 343.42,
   "text": "هم معدبه اومده هم معدوبة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.42,
   "end": 346.46,
   "text": "که حالا یادمه یه جلسه درباره‌ش بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.46,
   "end": 349.48,
   "text": "فتعلموا معدبه یا معدبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.48,
   "end": 354.12,
   "text": "مستطعتُم. هر مقدار که استطاعت دارید از این معدوبة یا معدبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.12,
   "end": 358.64,
   "text": "فیض ببرید. حالا اگر معدوبة بگی-- دو تاشم عرض کردم اومده تو حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.64,
   "end": 363.82,
   "text": "هر دوتاش هم درسته. معدوبة بگیری میشه طعام، سفره طعام الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.82,
   "end": 370.08,
   "text": "خدای قضایی تو قرآن برات مهیا کرده طعامی گذاشته که اگر بخوری جانت قوی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.08,
   "end": 373.32,
   "text": "علت اینکه من و شما خیلیامون انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.32,
   "end": 376.86,
   "text": "ضعیفیم، دچار قلب مریبیم، انقدر مرددیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.86,
   "end": 381.94,
   "text": "دچار شک و تردید میشیم به جهت اینه که از این معده بت الله خیلی کم اس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.94,
   "end": 384.74,
   "text": "تناول فرمودیم. توجه کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.74,
   "end": 388.56,
   "text": "خیلی کم خوردیم، نخوردیم یا کم خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.56,
   "end": 391.26,
   "text": "بالاخره بین این آیات هم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.26,
   "end": 393.5,
   "text": "مثل اینکه شما میری داروخانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.5,
   "end": 397.2,
   "text": "یه دفعه میبینی یه فقط ویتامین ب، یه ویتامین ث اینا جدای از هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.2,
   "end": 402.44,
   "text": "یه دفعه میبینی یه مولتی ویتامینه. اینطوری آیات و کلمات اینا هم همه با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.44,
   "end": 407.56,
   "text": "یا یه، یه دفعه میبینی یک سوره می-- جان قرآن میشه، قلب قرآن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.56,
   "end": 409.96,
   "text": "یا سین. اینا فرق می‌کنند با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.96,
   "end": 414.18,
   "text": "حتی حروف، حروف. مثل اون بزرگی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.18,
   "end": 418.34,
   "text": "ماه مبارک رمضان تسبیح دستش می گرفت فقط می گفت قاف، قاف، قاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.34,
   "end": 420.48,
   "text": "یه، یه حرف از قرآن رو دست گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.48,
   "end": 424.38,
   "text": "چرا؟ حالا برو اسرارش رو بپرس. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.38,
   "end": 427.96,
   "text": "می‌خوام بگم این معده بت الله ما اطعام نکردیم از سفره‌ی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.96,
   "end": 430.08,
   "text": "اگه معدبه بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.08,
   "end": 434.5,
   "text": "می‌فرمود که ادبستان الهیه، مؤدب شو با قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.5,
   "end": 439.52,
   "text": "حالا بعد بقیه‌ش از اینجا به بعد حدیث که حدیث نبوی است تو کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.52,
   "end": 443.76,
   "text": "قرر و درر سید مرتضی بود که علامه حسن زاده بهش خیلی تاکید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.76,
   "end": 447.58,
   "text": "بقیه‌ش هم اینه و ان اسفر البيوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.58,
   "end": 451.12,
   "text": "اسفر معناش یعنی خالی، اجوف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.12,
   "end": 456.9,
   "text": "اجوف. اسفر البيوت خالی‌ترین بیت‌ها، خانه‌ها رو می‌خوای به شما بگم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.9,
   "end": 459.56,
   "text": "حالا اینو شما خانه‌ی دلت فرض کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.56,
   "end": 463.46,
   "text": "لا بیت اسفر من کتاب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.46,
   "end": 468.82,
   "text": "اون خونه‌ایه، اون دلیه که خالیه از کتاب الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.82,
   "end": 471.7,
   "text": "کتاب الله. که واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.7,
   "end": 475.96,
   "text": "جالبه که یه حدیث می‌بینم در ی-ینابی المودة صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.96,
   "end": 479.6,
   "text": "دویست و هفتاده که پیامبر چقدر زیبا فرموده می‌خوای تلا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.6,
   "end": 482.66,
   "text": "بچه‌هات رو مؤدب کنی؟ ادب اولادک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.66,
   "end": 484.98,
   "text": "مؤدب کنید بچه‌هاتونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.98,
   "end": 487.16,
   "text": "به چی؟ على ثلاث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.16,
   "end": 490.04,
   "text": "خصال. به سه تا خصلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.04,
   "end": 492.76,
   "text": "حب نبیک. محبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.76,
   "end": 496.46,
   "text": "ان-- نبی شما اونکه باخبره از عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.46,
   "end": 500.36,
   "text": "نبی، نابع، بر وزن فاعل یعنی باخبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.36,
   "end": 502.44,
   "text": "نبی صفت مشبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.44,
   "end": 504.88,
   "text": "یعنی دیگه اصلاً خبر تو وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.88,
   "end": 508.5,
   "text": "ساکن شده و حب اهل بیته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.5,
   "end": 510.96,
   "text": "و دوستی اهل بیتش. سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.96,
   "end": 516.88,
   "text": "و قراعت القرآن. الان واقعا ما با این سه تا خصلت داریم بچه‌هامون رو تربیت می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.88,
   "end": 521.32,
   "text": "محبت پیغمبر، محبت اهل بیت پیغمبر و قرائت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.32,
   "end": 525.1,
   "text": "اصلاً خبری هست تو خونه‌های خیلی از ماها از این چیزا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 525.1,
   "end": 529.96,
   "text": "که من توصیه می‌کنم حالا شب اول محرم ت-شده توصیه می‌کنم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.96,
   "end": 534.82,
   "text": "اگر به هر دلیلی هیئت نمی‌ریم، حالا به خاطر شرایط کرونایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.82,
   "end": 537.34,
   "text": "یا هیئتمون رو تعطیل کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.34,
   "end": 540.0,
   "text": "پرچم هیئت رو تعطیل نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.0,
   "end": 542.82,
   "text": "پرچم هیئت، نماد هیئت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.82,
   "end": 546.98,
   "text": "اون علم، اون حالا بحث مفصلی روش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.98,
   "end": 550.04,
   "text": "الان فو-- جاش نیست، وقت ضیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.04,
   "end": 553.56,
   "text": "اما اون پرچم به منزله دهان روح من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.56,
   "end": 555.34,
   "text": "دهان جان من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.34,
   "end": 561.7,
   "text": "مثل اون روایتی که امام صادق صلوات الله علیه به اون شخص گفت چرا اون ظرف، اون صندوقچه، اون ظرفی که توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.7,
   "end": 564.82,
   "text": "اه حبوبات و برنج و اینا می‌ریزی چرا درش رو بستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.82,
   "end": 568.06,
   "text": "گفت آقا خالیه چیزی توش نیست. فرمود برای همین خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.06,
   "end": 573.84,
   "text": "درش رو باز بذار. اون دهان این ظرف به سمت آسمانه و في السماء رزق يوم و ما توعدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.84,
   "end": 576.24,
   "text": "بذار دهان این به سمت آسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.24,
   "end": 579.54,
   "text": "این پرچم‌ها به منزله دهان هیئت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.54,
   "end": 582.54,
   "text": "دهان هیئت رو بذار باز باشه رزقش رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 582.54,
   "end": 586.26,
   "text": "پرچمی، سردر تو خونه‌هات اسراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.26,
   "end": 588.44,
   "text": "سردر خونه تو خونه اصلاً پرچم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.44,
   "end": 590.38,
   "text": "هیئت که پرچم نداشته باشه چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.38,
   "end": 592.4,
   "text": "نماده. دهان روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.4,
   "end": 596.0,
   "text": "چرا وقتی قنوت دستتو میاری بالا تاکید شده بیار بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.0,
   "end": 601.14,
   "text": "چرا بزرگان اهل معرفت میگن شده ولو یه دستمال کوچولو زیر مهرد بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.14,
   "end": 603.58,
   "text": "سجده اصلاً حکایتش چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.58,
   "end": 606.04,
   "text": "ها؟ اینا برای چیه؟ اینا همون کاسه گداییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.04,
   "end": 608.24,
   "text": "همون دهان جانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.24,
   "end": 612.88,
   "text": "گدایی تو از در-- یادتونه قدیم‌ها این گداهای دستمال مینداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.88,
   "end": 616.24,
   "text": "اینا عجیبه حتی تو گداییه اینا هم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 616.24,
   "end": 622.96,
   "text": "فرهنگ اومده بوده. این دهان جان توئه به سمت آسمان و في السماء رزق يوم و ما توعدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.96,
   "end": 628.66,
   "text": "باید گدایی کرد. حالا قرآن هرچی طعام بخوای بهترین اطعمه توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.66,
   "end": 631.14,
   "text": "بهترین اشربه به جان تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.14,
   "end": 632.86,
   "text": "به دردت بخوره توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.86,
   "end": 635.9,
   "text": "خب بسم الله. حالا اونم حالا سید ر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 635.9,
   "end": 639.28,
   "text": "مرتضی ما میگیم یه سید مرتضی میگیم یه سید رضی میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 639.28,
   "end": 641.42,
   "text": "اینا این دو تا برادر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 641.42,
   "end": 646.86,
   "text": "سید رضی اون کسیه که جمع، جمع‌آوری نهج‌البلاغه رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.86,
   "end": 649.86,
   "text": "حالا حاج آقا دین‌پرور اخیراً فرموده بودند که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 649.86,
   "end": 651.52,
   "text": "که بنیاد نهج‌البلاغه دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.52,
   "end": 656.12,
   "text": "اخیراً فرمودند صد برابر نهج‌البلاغه از کلمات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.12,
   "end": 660.56,
   "text": "نامه‌ها و خطب امیرالمؤمنین صلوات الله علیه جمع‌آوری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.56,
   "end": 665.04,
   "text": "صد برابر نهج-- یعنی سید رضی همه رو جمع نکرد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.04,
   "end": 668.36,
   "text": "گلچین کرده. با این همه دشمنی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.36,
   "end": 671.44,
   "text": "که دوستان از ترس نگفتن، دشمن‌ها از بغض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.44,
   "end": 675.18,
   "text": "باز صد برابر این قطر نهج-- صد تا کتاب به قطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.18,
   "end": 681.28,
   "text": "مفاتیح مثلاً. از خطب و نامه‌ها و کلمات و حکمت‌های امیرالمؤمنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.28,
   "end": 684.2,
   "text": "سید رضی اینو جمع‌آوری کرد به گلچین خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.2,
   "end": 688.2,
   "text": "بعد سید مرتضی که علم الهدی رو امام عصر این لقب رو بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 688.2,
   "end": 691.8,
   "text": "پرچم هدایت. این بزرگوار هم کتاب زیاد دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 691.8,
   "end": 695.1,
   "text": "یکیش هم این قرر و درریه که این حدیث که الان براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.1,
   "end": 700.26,
   "text": "عرض کردیم در اون کتابه. ایشون یه کتاب دیگه‌ای داره به نام الشافی فی الامامة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.26,
   "end": 706.02,
   "text": "اسمو دقت کنین که حالا اون ملا عبدالجبار بغدادی یه کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 706.02,
   "end": 709.5,
   "text": "چند جلدی نوشت. چ-کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.5,
   "end": 713.0,
   "text": "خیلی مجلداتش حالا زیاد بود ظاهراً چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.0,
   "end": 716.6,
   "text": "جلد بوده. یکی، چند تا این مجلداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.6,
   "end": 721.06,
   "text": "یا یه دونه‌ش مش-مخصوص بوده به ادله امامتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.06,
   "end": 726.2,
   "text": "بر اساس خودش اومده بود ادله امامت شیعه رو رد کرده بود تو این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 726.2,
   "end": 733.84,
   "text": "توجه کردید؟ بعد سید، این سید مرتضی علیه الرحمه اومد کتاب الشافی فکر می‌کنم سه جلد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 733.84,
   "end": 735.84,
   "text": "الشافی فی الامامة رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 735.84,
   "end": 739.26,
   "text": "جواب یا در حقیقت در رد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 739.26,
   "end": 742.32,
   "text": "اقوال ایشون بیان کرد. اسمشو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 742.32,
   "end": 744.9,
   "text": "الشافی. یعنی می‌خوای شفا بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 744.9,
   "end": 747.96,
   "text": "دچار شک و ریبی پیرامون موضوع امامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 747.96,
   "end": 751.78,
   "text": "بسم الله. این سفره مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 751.78,
   "end": 756.32,
   "text": "الكافي. مرو مرهم کلینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 756.32,
   "end": 760.38,
   "text": "که امام عصر فرمود این کافی کلینی کفایت می‌کنه برای محبین ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 760.38,
   "end": 764.22,
   "text": "که البته سه بخش دیگه می‌دونید الان بین ما معروف شده اصول کافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 764.22,
   "end": 767.74,
   "text": "اما فروع هم داره که مربوط به بخش احکامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 767.74,
   "end": 770.56,
   "text": "اصول خب اصول دینه دیگه مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 770.56,
   "end": 774.2,
   "text": "روضه هم داره که آداب و برنامه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 774.2,
   "end": 777.4,
   "text": "سنن و اینها از این کارا. کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 777.4,
   "end": 782.96,
   "text": "خب اگر می‌خواین خلاصه بحث، اگر بخواهیم از شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 782.96,
   "end": 788.2,
   "text": "قلبی در خصوص خاص معتقداتمون نجات پیدا کنیم این سفره آماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 788.2,
   "end": 789.86,
   "text": "بسم الله. سفره قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 789.86,
   "end": 792.32,
   "text": "بعد می‌فرماید مستطاعتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 792.32,
   "end": 795.46,
   "text": "هر مقدار استطاعت داری بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 795.46,
   "end": 797.64,
   "text": "یعنی تو هر-- اینطوری معنا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 797.64,
   "end": 802.22,
   "text": "هر مقدار که جانت غذا می‌خواد بسم الله مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 802.22,
   "end": 805.9,
   "text": "چقدر می‌خوای بخوری؟ ما متاسفانه فقط به جسممون رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 805.9,
   "end": 808.16,
   "text": "جسممون رو قوی می‌کنیم. انواع و اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 808.16,
   "end": 812.4,
   "text": "غذاها و اینا. ولی انواع و اقسام غذاها رو قبول کنید به روحمون نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 812.4,
   "end": 815.6,
   "text": "برای همین جانمون، قلبمون ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 815.6,
   "end": 818.76,
   "text": "برای همین دچار شک و ریب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 818.76,
   "end": 822.52,
   "text": "خب بسم الله بهترین غذاها در قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 822.52,
   "end": 826.92,
   "text": "ان شاء الله رجوع کنیم. ان شاء الله که عاقبتمون ختم به خیر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 826.92,
   "end": 829.96,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 829.96,
   "end": 835.38,
   "text": "الله- اللهumma صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}