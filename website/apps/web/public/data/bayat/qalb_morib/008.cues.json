 },
 "chapters": [
  {
   "index": 0,
   "title": "## خروج از قلب مریب؛ سپردن خود به قرآن",
   "start": 0.68,
   "end": 29.64
  },
  {
   "index": 1,
   "title": "ترجمه‌های تحت‌اللفظی غالباً ضمیر «به» را به قرآن آیهٔ پیش نمی‌چسبانند. آیهٔ پیش می‌فرماید:",
   "start": 29.64,
   "end": 51.46
  },
  {
   "index": 2,
   "title": "## ظاهر و باطن قرآن؛ رود بی‌کران",
   "start": 51.46,
   "end": 391.32
  },
  {
   "index": 3,
   "title": "## اسماء بی‌کران و تجلی قرآن در اشیاء",
   "start": 391.32,
   "end": 573.28
  },
  {
   "index": 4,
   "title": "## تجربهٔ انکسار با صوت خویش",
   "start": 573.28,
   "end": 960.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 5.14,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 8.42,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.42,
   "end": 12.72,
   "text": "ما در جلسه‌ی آخر عرض کردیم که بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.72,
   "end": 16.12,
   "text": "فرمایش هم قرآن، هم عسرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.12,
   "end": 20.3,
   "text": "هم اولیاء خدا مثل حضرت آلامه حسن زاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.3,
   "end": 23.08,
   "text": "ما برای خروج از قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.08,
   "end": 25.08,
   "text": "شکاک و مریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.08,
   "end": 31.48,
   "text": "و مردد چاره‌ای نداریم الا اینکه خودمون رو تحویل به قرآن بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.48,
   "end": 33.26,
   "text": "و نکته‌ای رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.26,
   "end": 37.12,
   "text": "جالبه که در آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.12,
   "end": 40.14,
   "text": "هفتاد و نه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.14,
   "end": 44.12,
   "text": "مبارکه اسرا می‌فرمود \"و من اللیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.12,
   "end": 46.1,
   "text": "فتهجد بهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.1,
   "end": 51.46,
   "text": "نافلة لك عسی ان یبعثک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.46,
   "end": 53.18,
   "text": "ربک مقاما محمودا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.18,
   "end": 58.78,
   "text": "اینجا ترجمه‌های تحت اللفظی قرآن رو شما دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.78,
   "end": 62.54,
   "text": "این بهی رو، این ضمیر بهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.54,
   "end": 65.14,
   "text": "نمیارن معمولاً بچسبونن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.14,
   "end": 66.88,
   "text": "قرآن آیه‌ی قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.88,
   "end": 75.08,
   "text": "چون آیه‌ی قبل می‌فرمايد \"اقم الصلاة لدلوك الشمس الی غسق الليل و قرآن الفجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.08,
   "end": 80.14,
   "text": "إن قرآن الفجر کان مشهودا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.14,
   "end": 84.6,
   "text": "قرآن رو که قرآن در فجر خوانده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.6,
   "end": 87.72,
   "text": "مشهود عالمه و یکی از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.72,
   "end": 91.78,
   "text": "رسیدن به مقام شهادت رو این آیه داره برام بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.78,
   "end": 94.96,
   "text": "می‌خوای شهید بشی به قول حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.96,
   "end": 101.24,
   "text": "خدا رحمت کنه سردار سلیمانی جمله زیبایی داره که کسایی شهید می‌شن که شهید باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.24,
   "end": 104.48,
   "text": "شهید بوده‌ن، شهید می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.48,
   "end": 107.62,
   "text": "حالا اینجا داره مقام شهادت رو می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.62,
   "end": 111.7,
   "text": "اون قرآن فجر کان مشهودا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.7,
   "end": 115.5,
   "text": "باعث-- کاری می‌کنه که تو به مقام شهود برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.5,
   "end": 117.74,
   "text": "تو رو به شهود کامل می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.74,
   "end": 121.98,
   "text": "\"و من الليل فتهجد بهی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.98,
   "end": 127.32,
   "text": "به یک وجه این ها ضمیر بهی باید برگرده به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.32,
   "end": 130.88,
   "text": "یعنی در دل شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.88,
   "end": 137.3,
   "text": "سحر، اینجا تهجد یکی از بخش‌هاش خب می‌شه نافله، نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.3,
   "end": 141.3,
   "text": "یکیش می‌شه بهی یعنی با اون قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.3,
   "end": 143.58,
   "text": "با قرآن تهجد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.58,
   "end": 148.26,
   "text": "اتفاقاً تو دستور امیرالمؤمنین صلوات الله عليه به اب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.26,
   "end": 150.84,
   "text": "به پسرش محمد حنفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.84,
   "end": 154.12,
   "text": "این اومده که اول می‌فرماید و علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.12,
   "end": 161.82,
   "text": "بتلاوت القرآن. یه جای دیگه می‌فرماید \"علیکم\" جمع می‌بنده بتلاوت القرآن که مقام تلاوت رو عرض کردیم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.82,
   "end": 163.82,
   "text": "بعد می‌فرماید که و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.82,
   "end": 166.64,
   "text": "با این قرآن تهجد کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.64,
   "end": 170.04,
   "text": "و بهی فتهجد بهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.04,
   "end": 173.94,
   "text": "نافلة الليل. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.94,
   "end": 177.7,
   "text": "به یک معنا سهرت رو حتی نافلت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.7,
   "end": 181.6,
   "text": "حتی نافلت رو مزین کن به آیات قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.6,
   "end": 184.62,
   "text": "که این قرآن همون‌طوری که بحث شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 184.62,
   "end": 189.58,
   "text": "حقیقتش-- چون وقتی ما مرتبط می‌شیم با ظاهر قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.58,
   "end": 194.98,
   "text": "چون درک معذرت میخوام زیادی از ظاهر قرآن نداریم، خسته می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.98,
   "end": 199.14,
   "text": "اون کسی که متصل به باطن قرآن می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.14,
   "end": 202.74,
   "text": "اون‌چنان سیراب می‌شه که هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.74,
   "end": 205.78,
   "text": "بیشتر از آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.78,
   "end": 209.74,
   "text": "ماء گوارای قرآن بهش می‌نوشن باز میگه هل من مزید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.74,
   "end": 214.4,
   "text": "دیگه نبود. اصلاً باید از قرآن بکشیش بیرون به زور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.4,
   "end": 217.64,
   "text": "انقدر دیگه خلوتش با قرآن شکل می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.64,
   "end": 222.22,
   "text": "چون باطن قرآن یک عظمت لایتناهی‌ست که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.22,
   "end": 227.7,
   "text": "\"إنك لتلقى القرآن من لدن حكيم عليم\" از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.7,
   "end": 231.22,
   "text": "ذات، از علم ذاتی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.22,
   "end": 235.42,
   "text": "سرچشمه گرفته. شما این رو یک رودی فرض کنید، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.42,
   "end": 239.98,
   "text": "رود لایتناهی که اول و آخر ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.98,
   "end": 243.72,
   "text": "شروع شده از سرچشمه ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.72,
   "end": 246.82,
   "text": "این قرآن. شما اینطوری نگاه کنید لحظه به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.82,
   "end": 251.94,
   "text": "شروع شده به قول عرفا این مثالی که می‌زنن مثلاً میگن رود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.94,
   "end": 255.86,
   "text": "دجله و فرات و نمی‌دونم نیل و اینا رو شما در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.86,
   "end": 258.36,
   "text": "ببینید در راه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.36,
   "end": 262.94,
   "text": "رود به این عظمت راه می‌افته چقدر انشعابات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.94,
   "end": 266.84,
   "text": "رگه، رگه، رگه از این روده، از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.84,
   "end": 271.72,
   "text": "روستاها، شهرها چقدر سیراب می‌شن همینطوری در راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.72,
   "end": 274.88,
   "text": "همه از این رودن اما رگه، رگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.88,
   "end": 277.1,
   "text": "منشعب شده، شریعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.1,
   "end": 280.2,
   "text": "منشعب شده. حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.2,
   "end": 283.22,
   "text": "مثالی که حکما برای فهم ما می‌زنن همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.22,
   "end": 287.76,
   "text": "میگن قرآن هم از علم ذاتی حضرت حق نشأت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.76,
   "end": 290.32,
   "text": "جاری شده اومده به قلب مقدس پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.32,
   "end": 292.56,
   "text": "این رود رو شما در سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.56,
   "end": 296.24,
   "text": "طولیه‌ی نزولی قرآن در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.24,
   "end": 303.9,
   "text": "بعد وارد به عقل مبارک پیغمبر، بعد عالم مثال و خیال ایشون، بعد به صورت صوت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.9,
   "end": 309.7,
   "text": "محضرش هستیم ما در نشئه طبیعت در دنیا \"اقرأ باسم ربك الذي خلق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.7,
   "end": 313.6,
   "text": "اینجا خودش رو جلوه داده، ظاهر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.6,
   "end": 319.26,
   "text": "اون از علم ذاتی حضرت حق، از کتاب مکنون، از لوح محفوظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.26,
   "end": 322.96,
   "text": "اینها سرچشمه گرفته اومده اینجا تموم شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.96,
   "end": 325.44,
   "text": "نخیر. اینجا قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.44,
   "end": 330.7,
   "text": "نزول بود. در قوس صعود هم دوباره قرآن همین‌طور مثل این رود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.7,
   "end": 334.08,
   "text": "همین‌طور در حرکت و جاریست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.08,
   "end": 342.06,
   "text": "میره تا دو مرتبه از قوه مثال من و شما بره به قوه عقل و اله و الهیت نظام هستی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.06,
   "end": 344.96,
   "text": "هرکس مرتک-- مرتبط شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.96,
   "end": 347.76,
   "text": "با یکی از اون شریعه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.76,
   "end": 351.2,
   "text": "اون رگه‌ها مرتبط شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.2,
   "end": 353.04,
   "text": "در نهایت می‌ریزه به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.04,
   "end": 358.98,
   "text": "میره دو مرتبه در قوس صعود می‌ریزه به-- در عالم آخرت می‌ریزه به حوض کوثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.98,
   "end": 362.68,
   "text": "که حالا ساقی کوثر هم قربونش بریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.68,
   "end": 365.78,
   "text": "آقامون امیرالمؤمنین صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.78,
   "end": 369.7,
   "text": "که از تمام این نهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.7,
   "end": 375.44,
   "text": "این نهر جوشان از علم ذاتی حضرت حق بهره جفته-- جسته بلکه اتحاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.44,
   "end": 378.72,
   "text": "وجودی پیدا کرده، شده خودش قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.72,
   "end": 380.78,
   "text": "قرآن ناطق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.78,
   "end": 384.8,
   "text": "اساساً همون، همون وجوده که حالا بحثش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.8,
   "end": 391.32,
   "text": "قبلاً گذشته. این سلسله رو شما در نظر بگیرید در مسیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.32,
   "end": 399.26,
   "text": "در مسیر با اسماء لایتناهی حضرت حق نگید فقط هزار و یک اسم در جوشندار خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.26,
   "end": 401.8,
   "text": "یا یک حدیث داریم که نود و نه تا اسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.8,
   "end": 405.42,
   "text": "اینا بر اساس دسته‌بندی‌ها اینچنین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.42,
   "end": 412.76,
   "text": "بر اساس یه سری لحاظ‌ها، یه محدودیت‌ها اینچنین گفتن مثلاً هزار و یک اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.76,
   "end": 416.3,
   "text": "یه روایت میگه مثلاً چهار هزار اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.3,
   "end": 421.26,
   "text": "قرآن می‌فرماید \"ما یعلم لا یعلم جنود ربک الا هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.26,
   "end": 424.8,
   "text": "هیچ کس این جنود و لشکریان حضرت حق که بق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.8,
   "end": 427.3,
   "text": "به قول علامه رفیع قزوینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.3,
   "end": 431.1,
   "text": "اسماء الهی هستند رو کسی نمی‌دونه جز خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.1,
   "end": 434.52,
   "text": "لایتناهی‌اند چون حضرت حق لایتناهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.52,
   "end": 437.96,
   "text": "یک یک این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.96,
   "end": 440.36,
   "text": "سرچشمه گرفته اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.36,
   "end": 442.68,
   "text": "شریعه‌هاش می‌شه اسماء خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.68,
   "end": 446.22,
   "text": "یعنی اون رگه‌ها، اون حالا به قولی بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.22,
   "end": 453.26,
   "text": "یه دفعه از یه اسم جدا می‌شه از این شریعه در یک اسم تجلی می‌کنه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.26,
   "end": 458.98,
   "text": "و در کل اشیاء نظام هستی در حقیقت قرآن تجلی کرده، یکشم تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.98,
   "end": 463.28,
   "text": "یکشم من و شما هستیم که در مام قرآن تجلی کرده و الا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.28,
   "end": 468.42,
   "text": "وجود نداشتیم که، که قبلاً بحثش الحمدالله گذشته با گوشتون آشناست این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 468.42,
   "end": 475.82,
   "text": "که اساساً تجلی حضرت حق یک تجلی بود، تجلی اعظممون هم قرآن بود به سه شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.82,
   "end": 478.88,
   "text": "قرآن کتبی، قرآن افقی، قرآن انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.88,
   "end": 481.22,
   "text": "من و شما هم به یک معنا قرآنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.22,
   "end": 484.94,
   "text": "منتها این جوشش رو ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.94,
   "end": 489.66,
   "text": "متأسفانه گیر کردیم تو این دنیا خروج از عادت رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.66,
   "end": 493.38,
   "text": "اون بحث‌هایی که گذشت در مباحث قبلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.38,
   "end": 496.78,
   "text": "و به دیده دفعی نگاه نکردیم به نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.78,
   "end": 498.94,
   "text": "احسن عالم همینطوری موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.94,
   "end": 503.02,
   "text": "در هر حال در اسماء که همون اشیاء‌اً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.02,
   "end": 509.88,
   "text": "اون رگه‌های خروجی از این شریعه و از این رود مقدس بلکه اقدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.88,
   "end": 512.32,
   "text": "و در حقیقت آب قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.32,
   "end": 517.0,
   "text": "می‌شه گفت شکل گرفتن، جوشیدن و دیگران دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.0,
   "end": 520.32,
   "text": "سیراب می‌شن. یکشم مایییم و لو بی‌خبر باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.32,
   "end": 524.14,
   "text": "و لو بی‌خبر باشیم \"ام من شيء الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.14,
   "end": 526.54,
   "text": "عندنا خزائنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.54,
   "end": 529.16,
   "text": "و ما ننزله الا بقدر معلوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.16,
   "end": 534.48,
   "text": "در مام به قدر معلوم خودمون، به قدر معلوممون، به سر القدرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.48,
   "end": 538.98,
   "text": "از اون قرآن هی داره نازل می‌شه، می‌ریزه در وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.98,
   "end": 544.7,
   "text": "که آن به آن در ما در-- داره تجلی می‌کنه منتها ما بی‌خبریم، ما در غفلتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.7,
   "end": 548.34,
   "text": "اون حالت حضور رو به جهت نداشتن مراقبه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.34,
   "end": 552.24,
   "text": "ما باید خودمون رو تحویل بدیم به این قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.24,
   "end": 557.82,
   "text": "حالا نکته‌ای که می‌خواستم بگم همه اینا رو مقدمه کردم که این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.82,
   "end": 560.66,
   "text": "معمولاً ما میریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.66,
   "end": 562.32,
   "text": "شنیدن قرآن از این و اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.32,
   "end": 569.22,
   "text": "اونم خوبه‌ها. اما اون دستور العملی که جلسه‌ی پیش عرض کردیم حضرت علامه دارن در خلوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.22,
   "end": 575.22,
   "text": "بشینی قرآن رو به گونه‌ای که همین الان که انّ قرآن داره دو مرتبه نازل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.22,
   "end": 581.76,
   "text": "شروع کنی به خوندن، اون هم بدون توجه حتی به معانی، تعابیر، تعاويل، تفاسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.76,
   "end": 584.66,
   "text": "اصلاً انگار که هیچی از این قرآن نمی‌دونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.66,
   "end": 587.86,
   "text": "شروع می‌کنی صوت قرآن رو حزین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.86,
   "end": 591.96,
   "text": "با صوت خودت نه که کسی برات بخونه شروع کنی تو خلوت خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.96,
   "end": 595.4,
   "text": "اون دستور العملی گفتیم این رو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.4,
   "end": 598.86,
   "text": "اساساً مغز انسان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.86,
   "end": 606.24,
   "text": "عرض شود خدمتتون روانشناسی اسلامی مغز انسان حالا اون وری‌ها روانشناسی غربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.24,
   "end": 610.18,
   "text": "میگه موسیقی. ما در اسلام موسیقی نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 610.18,
   "end": 613.4,
   "text": "حالا ترجمه به عربی میگه موسیقی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 613.4,
   "end": 616.8,
   "text": "و که حالا ظاهراً هم از یونان گرفته شده این لفظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.8,
   "end": 620.78,
   "text": "عرب میگه یا اسلام میگه صوت حسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 620.78,
   "end": 623.14,
   "text": "صوت حسن یا حزین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.14,
   "end": 629.38,
   "text": "یا تفاسیر تو در آیات یا در روایات هست با صوت حسن یا حزین خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.38,
   "end": 633.48,
   "text": "این مهم اینه که صدا، صدای خودت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.48,
   "end": 641.96,
   "text": "از درون خودت بجوشه که مغز انسان نیاز عجیبی به شنیدن این صوت حسن دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.96,
   "end": 648.06,
   "text": "حالا روانشناسی غربی میگه مغز انسان نیاز به شنیدن موسیقی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.06,
   "end": 651.72,
   "text": "موسیقی‌ها میگن به یونانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.72,
   "end": 658.22,
   "text": "و ما میاییم می‌گیم که ما می-- ما مسلمانه میگیم اون موسیقی منظور همین صوت حسن قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 658.22,
   "end": 661.24,
   "text": "اونو اومدن بدلش کردن به موسیقی امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 661.24,
   "end": 666.34,
   "text": "و الا والا رهبر موسیقی جایگاهی در این موسیقی متعارف امروزو میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 666.34,
   "end": 669.86,
   "text": "در دین ما، در فرهنگ دینی ما جایگاهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 669.86,
   "end": 676.34,
   "text": "بله اساساً همه نظام هستی دارای حالا بگیم به یک معنا موسیقیه یا صوته، یک صو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.34,
   "end": 678.68,
   "text": "صدایی و \"سبح لله ما في السماوات والارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 678.68,
   "end": 682.26,
   "text": "این صدای باد، صدای باران، صوت من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 682.26,
   "end": 684.76,
   "text": "اینا همه بله اینا موسیقی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 684.76,
   "end": 687.92,
   "text": "اما چه موس-- ما باید ببینیم ترجمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 687.92,
   "end": 690.52,
   "text": "ترجمه‌مون از موسیقی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.52,
   "end": 696.86,
   "text": "بهترین چیزی که دلنوازه و باعث می‌شه انکسار قلبی رو صورت بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 696.86,
   "end": 702.66,
   "text": "و بر اثر انکسار قلبی تو متصل بشی با مبدأ وحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 702.66,
   "end": 705.04,
   "text": "یا قرآن صوت خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 705.04,
   "end": 707.5,
   "text": "صوت حزین و حسن خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 707.5,
   "end": 711.18,
   "text": "شاید دیگری صدای شما رو بشنوه خوشش نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.18,
   "end": 713.18,
   "text": "ها؟ اما خودت اینطوری نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 713.18,
   "end": 718.42,
   "text": "خودت که خلوت می‌کنی خیلی هم صدای خودت برای خودت دلنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 718.42,
   "end": 724.16,
   "text": "همون صدا ملاکه. اصلاً و ابداً اینکه گمان کنی کسی داره می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 724.16,
   "end": 726.26,
   "text": "یا داری برای دیگری می‌خونی، نه اینا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 726.26,
   "end": 728.48,
   "text": "مثل مدح‌هایی که ما می‌کنیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 728.48,
   "end": 733.34,
   "text": "چرا ما مداح‌ها وقتی که می‌خونیم معمولاً کمتر گریه می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 733.34,
   "end": 735.6,
   "text": "چون متوجه جمعیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 735.6,
   "end": 741.7,
   "text": "روی دستگاه‌هایی خوندنمونو پیاده می‌کنیم که اون صوت اصلی خودمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 741.7,
   "end": 745.9,
   "text": "اون صوت حزن و درون و جوشش درونی خودمون نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 745.9,
   "end": 747.96,
   "text": "که قلب منکسر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 747.96,
   "end": 752.1,
   "text": "برای همین سنگ‌دلیم معمولاً وقتی برای دی-- داریم برای دیگران می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 752.1,
   "end": 756.22,
   "text": "وقتی برای دیگران می‌خونیم از این دستگاه به اون دستگاه، از این سبک به اون سبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 756.22,
   "end": 760.76,
   "text": "لذا شایدم خیلیا دلشون نشکنه مگر خیلی دل آماده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 760.76,
   "end": 767.06,
   "text": "اما همین من که وقتی می‌خونم از این دستگاه به اون دستگاه همه‌م دلشون سنگدینه می‌جوشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 767.06,
   "end": 773.6,
   "text": "در خلوتم بدون توجه به اینکه عهدی داره توجه می‌کنه و می‌شنوه خودم برای خودم و خدای خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.6,
   "end": 777.04,
   "text": "شروع کنم با همون صوتی که خودش می‌جوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 777.04,
   "end": 780.46,
   "text": "شروع کنم خوندن قرآن یا هر چیز دیگه‌ای رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 780.46,
   "end": 786.56,
   "text": "می‌بینی یواش‌یواش قلب انکسار بر وزن انفعال یعنی طلب شکست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 786.56,
   "end": 788.78,
   "text": "طلب می‌کنه شکستن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 788.78,
   "end": 792.68,
   "text": "درم می‌شکنه و وقتی قلب شکست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 792.68,
   "end": 794.74,
   "text": "این قلب منکسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 794.74,
   "end": 797.22,
   "text": "متصل شده به اون مبدا جوشان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 797.22,
   "end": 801.92,
   "text": "به چی؟ به همون آبی که داریم عرض می‌کنیم جوشان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 801.92,
   "end": 806.8,
   "text": "جوشش گرفته از ذات حضرت حق اومده همینطور داره میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 806.8,
   "end": 809.3,
   "text": "تا آیه بیست و یک سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 809.3,
   "end": 811.94,
   "text": "انسان که می‌فرماید \"و سقاهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 811.94,
   "end": 814.36,
   "text": "ربهم شرابا طهورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.36,
   "end": 817.2,
   "text": "تفاسیر فرمودن همینه، همین قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 817.2,
   "end": 822.74,
   "text": "همین قرآنی‌ست که با اون در حقیقت خدا سیرابشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 822.74,
   "end": 826.94,
   "text": "اون‌هایی که در نعمت خدا غرق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 826.94,
   "end": 829.62,
   "text": "اهل ایمان رو. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 829.62,
   "end": 832.76,
   "text": "به‌هرحال پس یکی از بهترین راه‌ها خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 832.76,
   "end": 835.0,
   "text": "خودت ببین خدا چه صوتی داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 835.0,
   "end": 837.04,
   "text": "بله بلبل هم می‌خونه خیلی قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 837.04,
   "end": 840.86,
   "text": "گنجشک هم خیلی قشنگ. در میان این‌ها کلاغ هم می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 840.86,
   "end": 843.44,
   "text": "دیگری از صدای کلاغ خوشش نمیاد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 843.44,
   "end": 847.42,
   "text": "کلاغ س-- از خودش از صدای خودش لذت می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 847.42,
   "end": 849.8,
   "text": "تو هم از، منم از صدای خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 849.8,
   "end": 853.26,
   "text": "در خلوت اگر برای خودم بخونم لذت می‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 853.26,
   "end": 855.72,
   "text": "قطعاً هم انکسار رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 855.72,
   "end": 857.88,
   "text": "انکسار که رخ داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 857.88,
   "end": 860.16,
   "text": "وصل میشی به اون چشمه جوشان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 860.16,
   "end": 862.18,
   "text": "این نقطه آغازینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 862.18,
   "end": 866.34,
   "text": "باید دیگه ادامه بدی. هی بخونی بس-- با صوت خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 866.34,
   "end": 870.26,
   "text": "عجین بشی. من خدا لطف کرده بالاخره سی ساله نوکری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 870.26,
   "end": 872.56,
   "text": "ختم کلام عرض کنم خدمت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 872.56,
   "end": 875.46,
   "text": "بین شما هستند ذاکرین اهل بیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 875.46,
   "end": 882.28,
   "text": "قاریان قرآن نشستید. هر وقت من مدعی یه جایی میرم می‌شینم طرف می‌خونه بیچاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 882.28,
   "end": 884.64,
   "text": "زور می‌زنه می‌کشه خودش رو من دلم نمی‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 884.64,
   "end": 892.36,
   "text": "شاید دلم مریضه یا هرچی. بعد آروم، آروم خودم شروع می‌کنم برای خودم با همون صوت خدادادی خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 892.36,
   "end": 895.64,
   "text": "که شاید برای بعضیا انکر الاسوات باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 895.64,
   "end": 897.44,
   "text": "شروع می‌کنم به خوندن دلم می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 897.44,
   "end": 900.82,
   "text": "اصلاً محاله نشکنه. چون برای خودم، خلوت خودمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 900.82,
   "end": 905.92,
   "text": "امتحان کنید. رفته، رفته با اون صوت حزین خودتون آشنا می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 905.92,
   "end": 909.4,
   "text": "انکسار که رخ داد یعنی قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 909.4,
   "end": 912.32,
   "text": "شادمان شد، سرور پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.32,
   "end": 915.02,
   "text": "منفتح شد، انفتاح پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 915.02,
   "end": 917.14,
   "text": "اونیه دیگه از حالت مریضی اومده بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 917.14,
   "end": 922.08,
   "text": "قلبی که مریضه قسی میشه، سخت میشه، خشک میشه، نمی‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 922.08,
   "end": 923.86,
   "text": "با صدای خودت می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 923.86,
   "end": 926.78,
   "text": "حواست باشه این یه دستورالعمل برای همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 926.78,
   "end": 932.44,
   "text": "در دل شب با صدای خودت هر طور که بلدی آروم، آروم، آروم شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 932.44,
   "end": 936.68,
   "text": "یه مدت می‌گذره بعد آشنا میشی با صداهای درونی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 936.68,
   "end": 941.2,
   "text": "سال‌ها دل طلب جام جم از ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 941.2,
   "end": 944.48,
   "text": "آن که خود داشت ز بیگانه تمنا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 944.48,
   "end": 949.82,
   "text": "اون موقع ببین چجوری اون شک و تردیدها برات به یقین تبدیل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 949.82,
   "end": 952.54,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 952.54,
   "end": 955.64,
