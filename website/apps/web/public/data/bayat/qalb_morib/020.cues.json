 },
 "chapters": [
  {
   "index": 0,
   "title": "## امتلای شکم؛ مرگ قلب و افتادن به ریب",
   "start": 69.64,
   "end": 107.54
  },
  {
   "index": 1,
   "title": "## چرا کم‌اند؟ آلودگی نطفه در قوس نزول",
   "start": 107.54,
   "end": 538.64
  },
  {
   "index": 2,
   "title": "آیهٔ نودوشش اعراف همین را تصریح می‌کند و اصلی برای اهلش القا می‌نماید:",
   "start": 538.64,
   "end": 707.44
  },
  {
   "index": 3,
   "title": "## صورت علمیه از قدس؛ قوس نزول و صعود",
   "start": 707.44,
   "end": 856.15
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.66,
   "text": "یا سه. سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.66,
   "end": 8.0,
   "text": "علیکم السلام. استفتاء شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.0,
   "end": 14.14,
   "text": "اگر کسی بعضی از ضروریات دین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.14,
   "end": 17.6,
   "text": "انجام نده، مثلاً نماز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.6,
   "end": 23.04,
   "text": "نخونه، روزه رو نگیره یا اصلاً اینا رو قبول نداشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.04,
   "end": 28.54,
   "text": "اگرچه اسمشم مسلمان شیعه است، آیا این کافر حساب می‌شه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.54,
   "end": 31.3,
   "text": "رهبر عزیزمون فرمودن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.3,
   "end": 34.58,
   "text": "منکر این ضروریات بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.58,
   "end": 39.7,
   "text": "یا انکار این بخشی از ضروریات بکشه به جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.7,
   "end": 44.6,
   "text": "منکر رسالت پیغمبر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.6,
   "end": 52.06,
   "text": "یا نقصی به رسالت پیغمبر و شریعت وارد کنه، اگه اینطوری باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.06,
   "end": 55.72,
   "text": "یعنی انکارش موا-- مساوی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.72,
   "end": 59.88,
   "text": "نقصه وارد کردن و قبول نداشتن بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.88,
   "end": 63.84,
   "text": "کافره. اما یه وقت هست کسی قبول داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.84,
   "end": 66.58,
   "text": "کاهله، انجام نمی‌ده و الا قبول داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.58,
   "end": 72.42,
   "text": "این نه، این کافر نیست. دیروز ما عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.42,
   "end": 75.18,
   "text": "خب ما یکی از راه‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.18,
   "end": 79.2,
   "text": "در حقیقت هیچ چاره‌ای هم ازش نداریم‌ها، که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.2,
   "end": 82.8,
   "text": "نجات بدیم قلب‌مون رو از شک و ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.8,
   "end": 87.08,
   "text": "که در پس مردن قلب این اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.08,
   "end": 94.82,
   "text": "که گفتیم حضرت علامه بر اساس اون روایت می‌فرماید وقتی امتلای شکم صورت گرفت، شکم پر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.82,
   "end": 101.88,
   "text": "قلب می‌میره و میفته به شک و ریب و تزلزل و اینا تا می‌کشه به تکذیب آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.88,
   "end": 104.7,
   "text": "ما گفتیم هیچ راهی جز تطبیق بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.7,
   "end": 110.08,
   "text": "آدم و عالم نیست و گفتیم که باید این نظام تکوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.08,
   "end": 115.04,
   "text": "ما رو کمک میده، باید منطبق بشیم و البته چون نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.04,
   "end": 119.96,
   "text": "افعالش از طریق بدن بروز می‌کنه باید بدن سالم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.96,
   "end": 123.86,
   "text": "و باید بدونه انسان کی بخوره، کی بخوابه، چگونه بخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.86,
   "end": 127.38,
   "text": "چگونه بخوابه، چی رو با چی بخوره، چی رو با چی نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.38,
   "end": 132.4,
   "text": "اینا اون حالا سبک زندگیه به قول رهبر عزیزمون اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.4,
   "end": 136.56,
   "text": "حالا این سؤال پیش میاد که چطور بعضیا هستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.56,
   "end": 140.62,
   "text": "از طریق افعال بدن فیض رو در-دریافت نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.62,
   "end": 147.58,
   "text": "چون ما گفتیم که خب ما هیچ چاره‌ای جز این نداریم که با قوای سامعه‌مون علم رو بشنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.58,
   "end": 149.88,
   "text": "از علت مؤده البته نه طامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.88,
   "end": 154.46,
   "text": "مؤده می‌شه معلم، استاد، کتاب، صوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.46,
   "end": 157.4,
   "text": "اینا علت مؤده‌اند کمک می‌کنند ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.4,
   "end": 159.8,
   "text": "علت طامه می‌شه حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.8,
   "end": 164.7,
   "text": "خب سؤال پیش میاد که چگونه بعضیا هستن که بدون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.7,
   "end": 170.44,
   "text": "یعنی مثل مثلاً محقق حلی یا شیخ طوسی اینا که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.44,
   "end": 176.46,
   "text": "حالا اون صورت‌های علمیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.46,
   "end": 178.44,
   "text": "فیض الهی‌ست و بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.44,
   "end": 181.18,
   "text": "وجود ما، بر نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.18,
   "end": 185.4,
   "text": "نازل-- تنزل پیدا می‌کنه و ما می‌فهمیم، فهم می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.4,
   "end": 189.6,
   "text": "می‌چشیم، درک می‌کنیم. یه چیزی رو متوجه می‌شیم اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.6,
   "end": 192.96,
   "text": "اون از عالم قدسه دیگه. از بیرون که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.96,
   "end": 197.86,
   "text": "بیرون ماده‌ست، صدا ماده‌ست، کتاب ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.86,
   "end": 200.76,
   "text": "چطور بعضیا بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.76,
   "end": 204.04,
   "text": "استفاده از این آلات و وسایل، یعنی بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.04,
   "end": 208.58,
   "text": "استفاده از قوای سامعه‌شون، باصره‌شون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.58,
   "end": 212.78,
   "text": "مستقیم گرفتن حقایق رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.78,
   "end": 214.84,
   "text": "و شما چطور میگی که نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.84,
   "end": 221.66,
   "text": "هیچ چاره‌ای نداره الا اینکه از طریق افعالش که در بدنه، احکامش در بدن پیاده می‌شه از طریق بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.66,
   "end": 227.42,
   "text": "فیض رو دریافت کنه که بعد ما بگیم خب پس باید بدن سالم باشه که عده--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.42,
   "end": 233.76,
   "text": "اگه بدن سالم نباشه میگه عقل سالم در بدن سالم باید در مسیر سیر صعودیش به مشکل می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.76,
   "end": 236.4,
   "text": "و دچار شک و تزلزل و ایناها می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.4,
   "end": 239.92,
   "text": "باید بدن سالم باشه و اسلام خیلی به سلامت بدن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.92,
   "end": 243.76,
   "text": "تازه در سطح بالا-بالاتر از این شما می‌گید اصلاً بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.76,
   "end": 248.08,
   "text": "خ-- یکی از مراتب خود نفسه، جدای از نفس نیست، دیگه بدتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.08,
   "end": 252.6,
   "text": "پس چگونه بعضیا بدون دخالت بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.6,
   "end": 255.24,
   "text": "فیض رو دریافت می‌کنند؟ اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.24,
   "end": 257.54,
   "text": "اون‌ها عده بسیار قلیلی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.54,
   "end": 263.24,
   "text": "خیلی کم‌اند. اوحدی از اولیا-- البته همه انبیا و ائمه که اینچنین بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.24,
   "end": 265.68,
   "text": "اما به غیر از ائمه ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.68,
   "end": 268.4,
   "text": "اوحدی از، از اولیاء الله اینطوری بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.4,
   "end": 271.46,
   "text": "بله. من یه خاطره‌ای براتون نقل کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.46,
   "end": 275.42,
   "text": "آخرین بار که حضرت رهبر عزیزمون تشریف آورده بودند قم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.42,
   "end": 277.58,
   "text": "اونجا محضر آقای بهجت رسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.58,
   "end": 281.2,
   "text": "خب می‌رفت هر از چند گاهی خدمت آقای بهجت می‌آمدند ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.2,
   "end": 286.76,
   "text": "اون آخرین دیداری که این دو تا عزیز با هم داشتند سی و پنج دقیقه به سکوت گذشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.76,
   "end": 290.02,
   "text": "هر دو. یکی این ور اتاق، یکی اون ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.02,
   "end": 293.46,
   "text": "هر از چند گاهی یه نگاه به هم می‌کردن سرشون رو می‌انداختن پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.46,
   "end": 296.38,
   "text": "این چه جلسه‌ایه که سی و پنج دقیقه بشینن سکوت کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.38,
   "end": 299.26,
   "text": "بیکارن مگه؟ نه این آدم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.26,
   "end": 304.2,
   "text": "حالا یکی از مقامات عارفین که قبلاً بحثش گذشته صرح اطلاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.2,
   "end": 308.54,
   "text": "یعنی بی‌قید و بندی رها شدن از اطلاقات، از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.54,
   "end": 311.12,
   "text": "دست چیزایی که دست و پاگیر انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.12,
   "end": 313.06,
   "text": "قیدها. رها می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.06,
   "end": 315.24,
   "text": "صرحه. صرح مطلقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.24,
   "end": 319.96,
   "text": "و با سکوت می‌تونه از جان استادش مطلب بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.96,
   "end": 323.92,
   "text": "که حالا قبلاً گفتیم افلاطون سه دسته شاگرد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.92,
   "end": 326.88,
   "text": "اون مشایون که در حال مش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.88,
   "end": 329.18,
   "text": "یعنی شاگردان سرگذری ایشون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.18,
   "end": 332.56,
   "text": "رواقیون که می‌رفتند تو خونه و حجره ایشون درس و بحث می‌گرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.56,
   "end": 335.58,
   "text": "اشراقیون اونایی که در محو سکوت نیمه شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.58,
   "end": 339.58,
   "text": "حاج ملا حسین‌قلی همدانی به اون عظمت هم اتفاقاً دو سری شاگرد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.58,
   "end": 342.52,
   "text": "یه سری شاگردای درس و بحثی و کلامی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.52,
   "end": 344.58,
   "text": "می‌نشستن با قوه سامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.58,
   "end": 348.9,
   "text": "کمک می‌گرفتند از بدنشون بشنوند، ببینند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.9,
   "end": 355.16,
   "text": "تا بچشند، بفهمند. اما بعضیاشون هم عده قلیلی بودند، شاگردان سکوتی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.16,
   "end": 357.12,
   "text": "دل شب می‌نشستند پیش آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.12,
   "end": 362.96,
   "text": "حاج ملا حسین، حسین‌قلی همدانی ف-- اصلاً با سکوت می‌گرفتند حقایق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.96,
   "end": 368.92,
   "text": "اگر غیر از اینه چطوره امیرالمؤمنین صلوات الله علیه اگه بخوایم منکر این باشیم لحظه‌ی شهادت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.92,
   "end": 373.08,
   "text": "فرمود پیغمبر در گوش من القا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.08,
   "end": 376.06,
   "text": "حقایقی‌رو که هزار باب علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.06,
   "end": 379.14,
   "text": "که از هر بابی هزار باب دیگه باز می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.14,
   "end": 383.26,
   "text": "این مگه چقدر-- می‌دونید چه زمانی می‌خواد شما اینو ضرب و تقسیم کنید چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.26,
   "end": 386.48,
   "text": "چه عددی در میاد؟ یه چه زمانی می‌خواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.48,
   "end": 389.34,
   "text": "چه درس و بحث می‌خواد. تو یک آن القا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.34,
   "end": 393.76,
   "text": "پس هست که جالبه مرحوم ملا محسن فیض کاشانی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.76,
   "end": 396.12,
   "text": "وافی میگه این هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.12,
   "end": 399.5,
   "text": "علم، هزار باب علم، هزار اصله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.5,
   "end": 406.32,
   "text": "اصوله و اون هزار تا دیگه‌ای که از هر کدوم از این هزار تا منشعب شده هزار تا فرعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.32,
   "end": 408.14,
   "text": "اصول و فروعه رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.14,
   "end": 410.34,
   "text": "حالا بحثش که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.34,
   "end": 414.86,
   "text": "اصول چقدر مهم‌ند که قرآن اومده اصول رو برای ما بیان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.86,
   "end": 418.62,
   "text": "خب این سؤال رو اولا باید این‌چنینی بله این حقیقت وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.62,
   "end": 421.14,
   "text": "اما اولا اینا کم‌اند. چرا کم‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.14,
   "end": 423.64,
   "text": "این نکته رو توجه داشته باشید. همه این زور رو زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.64,
   "end": 426.14,
   "text": "مقدمه شدیم برای اینا. چرا کم‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.14,
   "end": 433.14,
   "text": "به جهت اینکه اولین جایی که آلودگی در انسان در قوس نزول که همه پاک‌اند انا لله میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.14,
   "end": 437.02,
   "text": "اولین جایی که در قوس صعود شروع می‌شه آلودگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.02,
   "end": 439.02,
   "text": "در نطفه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.02,
   "end": 442.58,
   "text": "اون حالا تعلقات صلب و رحم مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.58,
   "end": 445.92,
   "text": "اونچه که شنیده، چشیده، گفته، خورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.92,
   "end": 451.7,
   "text": "پدر، مادر مثل بارونی که از آسمون میاد تو راه با خودش آلودگی می‌گیره، رنگ تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.7,
   "end": 455.54,
   "text": "این نطفه آلوده شده. حالا پدر مادر پاک به دنیا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.54,
   "end": 458.42,
   "text": "نفس دیگران، تربیت دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.42,
   "end": 461.06,
   "text": "و این‌ها همینطوری چی می‌شه؟ هی آلودگی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.06,
   "end": 464.88,
   "text": "چون این آلودگی‌ها اومده ذیق شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.88,
   "end": 468.6,
   "text": "در حقیقت وجود این آقا مجبوره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.6,
   "end": 472.16,
   "text": "با واسطه بره جلو این قضارات آلودگی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.16,
   "end": 479.28,
   "text": "برطرف کنه. بدن کمک می‌کنه در سیر استکمالی نفس ناطقه که نفس ناطقه رشد کنه بدن به کمکش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.28,
   "end": 482.16,
   "text": "بعداً به جایی می‌رسه که دیگه رها می‌شه اصلاً از بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.16,
   "end": 485.82,
   "text": "دیگه اون مال کساییه که دیگه این سیرو رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.82,
   "end": 490.04,
   "text": "ولی می‌شه شدنیه. یعنی شما باید افق دیدت به اونجا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.04,
   "end": 495.06,
   "text": "تا کی همش خودت رو در بند کتاب و استاد و اینا بدونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.06,
   "end": 498.2,
   "text": "همین. یعنی هرچی که استاد فهمید یا تو کتابه همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.2,
   "end": 500.62,
   "text": "شما دیگه هیچ هنر دیگه‌ای نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.62,
   "end": 503.64,
   "text": "از همش که می‌شی مجتهد-- مقلد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.64,
   "end": 506.02,
   "text": "مقلد بودن هنر نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.02,
   "end": 509.88,
   "text": "پس کی می‌خوای خودت محقق بلکه بالاتر از مجتهد بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.88,
   "end": 514.1,
   "text": "تلاش کنی و تو خودت بچشی، بفهمی و به دیگران بچشونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.1,
   "end": 517.06,
   "text": "راهش اینه و خی-- زیاد هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.06,
   "end": 519.8,
   "text": "حالا من یه آیه‌ای رو امروز داشتم در قرآن توجه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.8,
   "end": 526.68,
   "text": "ببینید چقدر زیبا اتفاقاً همین رو تصریح فرموده با البته یه اصلی رو اینجا القا کرده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.68,
   "end": 528.76,
   "text": "برای اهلش. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.76,
   "end": 530.52,
   "text": "آیه نود و شش اعراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.52,
   "end": 535.56,
   "text": "خیلی قشنگه این آیه. \"ولو ان اهل القری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.56,
   "end": 539.74,
   "text": "آمنوا واتقوا\" اگه اهل این قریه حالا دو تا شرط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.74,
   "end": 544.12,
   "text": "خدا میگه اگه دو تا کار می‌کردن ایمان می‌آوردن یعنی دل می‌دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.12,
   "end": 549.54,
   "text": "و \"اتقوا\" حدود الهی رو رعایت می‌کردن، عمله یعنی به عمل می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.54,
   "end": 551.7,
   "text": "ایمان و عمل در حقیقت تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.7,
   "end": 553.72,
   "text": "چه اتفاقی می‌افتاد به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.72,
   "end": 556.5,
   "text": "اگه کسی این دو تا شرط رو بیاره تو وجودش پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.5,
   "end": 560.42,
   "text": "\"لا\" قطعاً \"فتحنا عليهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.42,
   "end": 562.82,
   "text": "ما باز می‌کنیم بر اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.82,
   "end": 566.24,
   "text": "برکات \"من السماء والارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.24,
   "end": 568.8,
   "text": "اگه فقط می‌گفت سما بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 568.8,
   "end": 572.76,
   "text": "مشکل می‌شد چون \"وفی السماء رزقكم وما توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.76,
   "end": 577.96,
   "text": "سما آسمون الان برای اینکه بچه‌ای که تو رحم مادره می‌شه نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.96,
   "end": 580.22,
   "text": "یعنی مادر تو نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 580.22,
   "end": 583.22,
   "text": "بچه تو یه رتبه پایین‌تره، تو رحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 583.22,
   "end": 585.2,
   "text": "داره از سما رزق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 585.2,
   "end": 587.44,
   "text": "\"وفی السماء رزقكم وما توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.44,
   "end": 591.0,
   "text": "بچه تو رحم مادر سماش می‌شه نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.0,
   "end": 594.7,
   "text": "یعنی یه رتبه بالاتر. مادر داره بهش رزق می‌ده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.7,
   "end": 598.98,
   "text": "الان که ما اومدیم تو نشئه طبیعت سما ما که رزق مادر اون‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.98,
   "end": 603.78,
   "text": "به یک معنا می‌شه عالم قدس، ملکوت به یک معنا می‌شه ملکوت وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.78,
   "end": 607.76,
   "text": "یعنی رزق از ملکوت خودت نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.76,
   "end": 610.9,
   "text": "اگه فقط این بود بله مسئله حل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.9,
   "end": 615.02,
   "text": "اما می‌گه \"والارض\" یعنی از عرض وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 615.02,
   "end": 617.22,
   "text": "این عرض رو بدن بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 617.22,
   "end": 620.06,
   "text": "اون سما رو نفس ناطقه بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 620.06,
   "end": 623.7,
   "text": "عرض رو بدن بگیر. یعنی از عرض خودت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.7,
   "end": 627.88,
   "text": "برکات می‌ریزه. یعنی بدن خودت هم به کار می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 627.88,
   "end": 630.86,
   "text": "و کمک می‌کنه که از سما رزق نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 630.86,
   "end": 637.18,
   "text": "یعنی از زمین و زمان، از زمین و آسمان، از بدن و نفس، از هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.18,
   "end": 642.08,
   "text": "برکات الهی ناشی می‌شه، منتج می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 642.08,
   "end": 645.12,
   "text": "و تن-- در حقیقت به تو می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.12,
   "end": 652.8,
   "text": "بعد بقیه‌ش می‌فرماید \"ولکن كذبوا\" اینا خراب کردن، تكذیب کردن \"فاخذناهم بما كانوا يكسبون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.8,
   "end": 655.7,
   "text": "به ша-- به خاطر اون کارهای بدی که کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.7,
   "end": 660.04,
   "text": "اینا تکذیب کردن، کارهای زشتی که کردن، این راه برکات بسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.04,
   "end": 662.32,
   "text": "یعنی از نه از طریق بدنشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.32,
   "end": 665.12,
   "text": "عرض وجودشون می‌تونن بگیرن فیض رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 665.12,
   "end": 667.98,
   "text": "نه از طریق سما یعنی نفس ناطقه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 667.98,
   "end": 672.5,
   "text": "هر دو قفل شده. چرا؟ انقدر که گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.5,
   "end": 675.86,
   "text": "تکذیب و دروغ و نیرنگ و ریا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 675.86,
   "end": 678.42,
   "text": "این‌ها، این چیزا که آلودگی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 678.42,
   "end": 681.12,
   "text": "پس آلودگی اومده ما رو به اینجا کشونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 681.12,
   "end": 686.04,
   "text": "اما راه بازه. اگر-- ببینید این آیه‌ست دیگه من از خودم که حرف نمی‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 686.04,
   "end": 688.96,
   "text": "ختم کلام. آیه نود و شش سوره اعراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 688.96,
   "end": 691.7,
   "text": "برید ببینید تفاسیر رو ببینید تأویلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 691.7,
   "end": 694.62,
   "text": "اهل بیت علیهم الصلاة والسلام براش دارن ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 694.62,
   "end": 702.06,
   "text": "نظرات حکما رو ذیل این آیه ببینید که بنده حقیر دیدم به شما دارم عرض می‌کنم که تطبیق دادن با روایات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 702.06,
   "end": 706.94,
   "text": "آیات دیگر. همین چیزی که من خلاصه‌شو به شما عرض کردم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 706.94,
   "end": 712.4,
   "text": "یعنی رزق الهی اون صورت علمیه که به تو می‌فهمونه حقایق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 712.4,
   "end": 717.08,
   "text": "عزیز دلم و تو رو ثبات قدم می‌ده در مسیر دین باعث می‌شه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 717.08,
   "end": 719.62,
   "text": "شک و ریب نجات پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 719.62,
   "end": 721.98,
   "text": "هم باید از سما بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 721.98,
   "end": 726.56,
   "text": "یعنی از عالم قدس، از الهیت وجود تو که تو هم رتبه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 726.56,
   "end": 731.15,
   "text": "در حقیقت قبلاً گفتیم عوالم وجودی داری رتبه‌بندی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 731.15,
   "end": 738.17,
   "text": "بیاد از اون سماع وجودتو، از قلب وجودتو تنزل پیدا کنه به عالم عقلت، به عالم خیالت یا مثالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 738.17,
   "end": 744.37,
   "text": "بعد بیاد به لسانت یا به فکرت، به این مغز عادیت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 744.37,
   "end": 752.33,
   "text": "همین که از عرض وجودت یعنی با شنیدن یک کیف مسموعه دیگه شنیدن ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 752.33,
   "end": 759.49,
   "text": "با شنیدن، با نوشتن، با دیدن، با تکلم و درس و بحث از اینجا دیگه این می‌شه قوس چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 759.49,
   "end": 763.95,
   "text": "صعود. یعنی از عرض وجودت کمک می‌گیری از معلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 763.95,
   "end": 770.53,
   "text": "بفهمی این حقیقت قوس صعود می‌شه از اینجا می‌ره بالا تا به قدس برسه کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.53,
   "end": 774.47,
   "text": "اون برعکس اولیه از سماع که میاد قوس نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 774.47,
   "end": 776.37,
   "text": "از آسمان به وجود خودت نازی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.37,
   "end": 779.47,
   "text": "اما در هر حال چه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.47,
   "end": 782.23,
   "text": "عرضت کمک بگیری، چه از سماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 782.23,
   "end": 787.93,
   "text": "آنچه که تو می‌فهمی و می‌چشی بخوای نخوای از قدس نظام هستیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 787.93,
   "end": 790.81,
   "text": "جنسش قدسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.81,
   "end": 795.35,
   "text": "جنسش ملکوتیه. \"ولا يمسه إلا المتحرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.35,
   "end": 798.99,
   "text": "جز با طهارت نمی‌شه مس کرد این حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 798.99,
   "end": 807.03,
   "text": "اگر کسی دچار ریبه، شک، گرفتاری، انحرافات قلبیه، نمی‌تونه متمرکز باشه رو حقایق، ایمانش ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 807.03,
   "end": 812.05,
   "text": "هیچ چاره‌ای نداره الا این مراتیبی که ما داریم عرض می‌کنیم و که حکما گفتن و بزرگان و اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 812.05,
   "end": 814.29,
   "text": "بیت و آیات قرآن رو طی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 814.29,
   "end": 816.91,
   "text": "بیفته به طهارت. این آیه چی گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.91,
   "end": 820.21,
   "text": "دل دادن و تقوا، رعایت حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 820.21,
   "end": 825.07,
   "text": "بعد می‌بینی می‌ریزه. به جایی می‌رسی که س-- در سکوت بهره می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 825.07,
   "end": 827.03,
   "text": "در سکوت از استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 827.03,
   "end": 830.29,
   "text": "یعنی القا می‌شه بهت. که حالا من خاطراتی اینجا دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 830.29,
   "end": 834.25,
   "text": "هم وقت گذاشته هم خیلی دوست ندارم اینا رو بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 834.25,
   "end": 841.53,
   "text": "چه عزیزانی رو درک کردیم که القاءاتی کردن که شما باید هزار تا کتاب بخونی تا اون القا بهت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 841.53,
   "end": 845.41,
   "text": "هست، وجود داره انشاالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 845.41,
   "end": 847.13,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 847.13,
   "end": 856.15,
   "text": "اللهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ. اللهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}