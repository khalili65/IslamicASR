 "chapters": [
  {
   "index": 0,
   "title": "## تقدم بر امام جماعت",
   "start": 13.04,
   "end": 64.38
  },
  {
   "index": 1,
   "title": "## لا ریب فیه؛ ریب أشد شک است",
   "start": 64.38,
   "end": 278.62
  },
  {
   "index": 2,
   "title": "## فرض حاجی سبزواری؛ آمدن دفعتاً به دنیا",
   "start": 278.62,
   "end": 701.51
  },
  {
   "index": 3,
   "title": "## حب بقا در کودک و حیوان؛ برهان صدیقین",
   "start": 701.51,
   "end": 761.08
  },
  {
   "index": 4,
   "title": "## دو نظر در انکار فطرت؛ از شک تا ریب تا یقین",
   "start": 761.08,
   "end": 945.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 4.58,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.58,
   "end": 8.34,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.34,
   "end": 13.04,
   "text": "آیاته، السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 15.16,
   "text": "عزیزی پیرامون احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.16,
   "end": 17.88,
   "text": "تذکر دادن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.88,
   "end": 21.1,
   "text": "احکام نماز جماعت رو دو مرتبه بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.1,
   "end": 24.68,
   "text": "حالا چون من عرض کردم یه دوره رفتیم ما این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.68,
   "end": 28.0,
   "text": "برای دوستان. منتها گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.0,
   "end": 31.42,
   "text": "مدتی که شما نبودید و کسالت داشتید و اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.42,
   "end": 36.74,
   "text": "حالا دیگران یا ما می‌خوندیم، متوجه شدیم خیلیا رعایت نمی‌کنن احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.74,
   "end": 41.02,
   "text": "خصوصاً تقدم و تأخر نسبت به امام جماعت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.02,
   "end": 47.7,
   "text": "ما اینا رو حالا گفتیم اگرچه عزیزان عوض شدن، تغییر کرد، خیلیا رفتن جدید اومدن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.7,
   "end": 52.86,
   "text": "به هر حال، ولی چشم دو مرتبه ما یه مروری می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.86,
   "end": 56.94,
   "text": "که فعلاً حالا امروز عاجلاً بدونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.94,
   "end": 65.36,
   "text": "دیگه این یه امر محرزی‌ست که همه فقها و مراجع، همه اختلافیا هم نیست که مطلقا کسی حق اینکه تقدم کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.36,
   "end": 67.76,
   "text": "اجزاء نماز بر امام رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.76,
   "end": 73.24,
   "text": "یعنی اگر کسی عمداً زودتر از امام بره رکوع و سجود که اصلاً نمازش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.24,
   "end": 78.5,
   "text": "اتفاقاً اگه توجه کنید اگه کسی بتونه از من زودتر بره رکوع و سجود که دیگه عیدالله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.5,
   "end": 83.0,
   "text": "یعنی چون من خیلی سریع، چون یه مدت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.0,
   "end": 86.06,
   "text": "از شاید خدمتتون ارزیاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.06,
   "end": 91.52,
   "text": "برنامه بودم چندین سال اذانگاهی‌ها رو ارزیابی می‌کردم دیدم اوه، اوه چه فاجعه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.52,
   "end": 94.98,
   "text": "مثلاً حرم امام حسین نشون میده یه آیت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.98,
   "end": 102.7,
   "text": "مرجع مثلاً آقای مکارم جلو ایستاده بعد اکثراً زودتر از ایشون اکثراً حتی صف اولیا میرن رکوع و سجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.7,
   "end": 109.4,
   "text": "اون موقع به این وضعیت وخیم پی بردم برای همین من اون سمع الله هل من هم دهر اصلاً نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.4,
   "end": 114.6,
   "text": "تا از رکوع بلند شدم سریع میرم سجده اگر دقت، بین دو سجده الله اکبر نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.6,
   "end": 117.58,
   "text": "تا از سجده اول پا شدم سریع میرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.58,
   "end": 119.66,
   "text": "سجده دوم که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.66,
   "end": 121.9,
   "text": "از ما جلو نزنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.9,
   "end": 125.2,
   "text": "باز با این تفاصيل اگر کسی از من جلو زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.2,
   "end": 131.04,
   "text": "جایزه داره واقعاً. چشم باز ما هم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.04,
   "end": 133.36,
   "text": "اما اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.36,
   "end": 137.16,
   "text": "نکته بسیار مهمی رو پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.16,
   "end": 142.0,
   "text": "بحث مریب، شک شدید در قرآن امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.0,
   "end": 147.42,
   "text": "به فضل الهی پی بگیریم که این هرچی خب میریم جلوتر بحث دقیق‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.42,
   "end": 150.66,
   "text": "خطیرتر میشه این‌ها اما خب حوصله هم میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.66,
   "end": 157.52,
   "text": "اجازه بفرمایید که برای اینکه بحث علمی‌تر باشه رفرنس بدم خدمتتون که در ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.52,
   "end": 162.76,
   "text": "سوره بقره خب داریم که الف لام میم ذالک الکتاب لا ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.76,
   "end": 165.22,
   "text": "فیه، لا ریب فیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.22,
   "end": 168.88,
   "text": "ظاهرش میگیم هیچ شکی در اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.88,
   "end": 171.12,
   "text": "در تفسیر تسلیم حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.12,
   "end": 174.96,
   "text": "جوادی آملی این حکیم متعلم می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.96,
   "end": 181.92,
   "text": "اینجا این ریب منظور اون شک متعارفی نیستش که ما فکر می‌کنیم و مورد بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.92,
   "end": 187.0,
   "text": "خیلیاست که شک مصطلح بلکه رriebe.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.0,
   "end": 190.0,
   "text": "ریب یعنی شک یا أشد شک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.0,
   "end": 194.74,
   "text": "أشد شک. بعد ایشون می‌فرمایند دو وجه داره این أشد شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.74,
   "end": 201.08,
   "text": "یا اینکه اصلاً و ابداً جایگاه شک نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.08,
   "end": 204.58,
   "text": "که مثل شک در حقیقت قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.58,
   "end": 208.82,
   "text": "در اون حقیقت قرآن، حق قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.82,
   "end": 212.04,
   "text": "وجود قرآن اصلاً جایگاه شک نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.04,
   "end": 215.06,
   "text": "حالا عرض می‌کنم چرا، چرا آقای جوادی آملی البته ر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.06,
   "end": 218.28,
   "text": "از-- میگن و رد میشن. اما حالا با مبانی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.28,
   "end": 226.56,
   "text": "آقای-- حضرت حسن زاده رحمت الله علیه، استاد کل عرض می‌کنم چگونه جای شک نداره در حقیقت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.56,
   "end": 228.72,
   "text": "اما خب قسمت بعدیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.72,
   "end": 233.72,
   "text": "جا-- میشه گفت جای شک داره اما شایسته شک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.72,
   "end": 238.46,
   "text": "اون چیه؟ اینکه چیز مشکوکی در قرآن باشه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.46,
   "end": 240.08,
   "text": "چیز مشکوکی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.08,
   "end": 244.28,
   "text": "اگرچه جای شک هست چون شک می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.28,
   "end": 246.62,
   "text": "اما شایسته شک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.62,
   "end": 248.48,
   "text": "این فرمایش حضرت آقای جوادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.48,
   "end": 255.12,
   "text": "اونجاهایی که آقای جوادی می‌فرماید اصلاً در حقیقت هیچ‌گونه جای شکی نیست از کجا بلند میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.12,
   "end": 257.54,
   "text": "این همون برهان صدیقینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.54,
   "end": 261.5,
   "text": "که دیگه الحمد لله همه‌تون اهل فضل هستید، می‌دونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.5,
   "end": 266.02,
   "text": "کمالین یه برهانی دارن که در توحید به تمکن رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.02,
   "end": 268.2,
   "text": "حالا میگیم کمالین نترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.2,
   "end": 271.2,
   "text": "این‌ها به-- اصطلاحاً بهش میگن برهان صدیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.2,
   "end": 273.2,
   "text": "این برخاسته از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.2,
   "end": 278.62,
   "text": "از همون فطرت و ذات ماست که فطرت الله التي فطر الناس عليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.62,
   "end": 282.68,
   "text": "برای اینکه اینو توضیح بدم اجازه بدید چند تا مبنا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.68,
   "end": 285.5,
   "text": "از فرمایش بزرگان خدمتتون عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.5,
   "end": 289.86,
   "text": "که این‌ها رو، این دسته‌بندی‌ها رو خود حضرت علامه حسن زاده در شرح فسوسشون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.86,
   "end": 291.88,
   "text": "حالا من چند تاشو براتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.88,
   "end": 295.84,
   "text": "مثلاً مرحوم حاجی سبزواری علیه رحمة در حاشیه سر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.84,
   "end": 299.12,
   "text": "منظومه‌شون که قبلاً به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.12,
   "end": 303.86,
   "text": "نحو دیگه‌ای من این رو بیان کرده بودم که می‌فرماید اگر شما تصور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.86,
   "end": 307.16,
   "text": "ابداعاً به یکباره دفعةً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.16,
   "end": 311.38,
   "text": "با همین فعلیتی که الان دارید و استعدادی که الان دارید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.38,
   "end": 314.86,
   "text": "گویش و فهم و درک و علمی که دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.86,
   "end": 317.64,
   "text": "به یکباره یه همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.64,
   "end": 320.82,
   "text": "وضعیتی که الان دارید به فعلیت رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.82,
   "end": 323.9,
   "text": "می‌اومدید تو این دنیا. خو نگرفته بودید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.9,
   "end": 326.14,
   "text": "خرد خرد حالا از بچگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.14,
   "end": 329.82,
   "text": "یعنی اون استدراج یا تدریجاً وجود نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.82,
   "end": 334.62,
   "text": "چون بر اساس آیه دوازده به بعد سوره مؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.62,
   "end": 337.14,
   "text": "تدریج کاملاً درک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.14,
   "end": 340.34,
   "text": "تو این آیه می‌فرماید و لقد خلقنا الانسان من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.34,
   "end": 343.88,
   "text": "صلالة من طین. خب از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.88,
   "end": 349.2,
   "text": "گل خشکیده بعد ثم جعلناه نطفة فی قرار مکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.2,
   "end": 351.58,
   "text": "ببینید این استدراجو درک شده هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.58,
   "end": 356.16,
   "text": "طول کشیده. میاد در یک قرار مکینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.16,
   "end": 358.0,
   "text": "نطفه قرار می‌گیره رحم مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.0,
   "end": 361.08,
   "text": "ثم خلقنا النطفة علقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.08,
   "end": 363.3,
   "text": "که چهل روز طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.3,
   "end": 365.92,
   "text": "فخلقنا العلقة مضغة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.92,
   "end": 370.03,
   "text": "اون علقه بعد میشه مضغه دوباره چهل روز طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.03,
   "end": 373.75,
   "text": "فخلقنا المنيت عظام میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.75,
   "end": 379.15,
   "text": "استخوان. اون گوشت مثل جویده شده این شبیه این شکلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.15,
   "end": 382.89,
   "text": "میشه استخوان که باز حدودا چهل روز طول میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.89,
   "end": 386.05,
   "text": "یعنی سه تا چهل روز رو یعنی صد و بیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.05,
   "end": 388.19,
   "text": "روز رو که میشه چهار ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.19,
   "end": 391.73,
   "text": "طی میکنه. فکصون العظام لحما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.73,
   "end": 398.17,
   "text": "اینجا دیگه بعد روش گوشت و پوست و اینا کشیده میشه رو اون استخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.17,
   "end": 401.11,
   "text": "ثمه انشأناه خلق آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.11,
   "end": 404.87,
   "text": "دیگه به اون بهترین وجه و آخر حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.87,
   "end": 414.71,
   "text": "ممکن تو. حالا خلق به بهترین صورت و وجه ممکن خلق که شد اونجا که حالا بعد دیگه روح دمیده میشه بعد چهار ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.71,
   "end": 417.69,
   "text": "که یه دوران بسیار حساسی‌ست در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.69,
   "end": 421.91,
   "text": "دوران بارداری مادر که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.91,
   "end": 426.57,
   "text": "خلقیاتش اونچه که می‌شنوه، میشی-- می-میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.57,
   "end": 428.77,
   "text": "میخوره، می‌چشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.77,
   "end": 431.31,
   "text": "می‌بویه، nefsi که بهش میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.31,
   "end": 435.31,
   "text": "همه اینا در خلق و خو و مزاج بچه تاثیر میذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.31,
   "end": 440.67,
   "text": "حالا بعد اینجا، اینجا که رسید فتبارک الله احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.67,
   "end": 445.47,
   "text": "این تدریج رو حاجی سبزوارى رحمة الله علیه می‌فرماید تو گمان کن اصلا این نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.47,
   "end": 450.35,
   "text": "این تدریج نبود. با همین فعلیت که الان داری به یکباره می‌اومدی تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.35,
   "end": 453.41,
   "text": "خب این هستی که الان هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.41,
   "end": 462.45,
   "text": "این بود خودت، این حقیقتی که الان ادراک می‌کنی با این فعلیت یک ور-- به یکباره بیای تو این دنیا دفعتا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.45,
   "end": 464.35,
   "text": "الان این حس-- چون قبلا خو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.35,
   "end": 467.43,
   "text": "کردی برات عادی شده متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.43,
   "end": 471.61,
   "text": "مثل کسی که چرا میگه زیاد تو زریح نمون، زیاد تو حرم نمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.61,
   "end": 474.67,
   "text": "میری نمکی زیارت کن برای اینکه خو نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.67,
   "end": 478.49,
   "text": "یعنی عادی نشه برات. عادی سازی خیلی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.49,
   "end": 481.19,
   "text": "اون جلالت حضرت باید همیشه حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.19,
   "end": 484.39,
   "text": "جمال اگه فقط باشه خراب می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.39,
   "end": 486.37,
   "text": "برای همین تشع هم گاهی اوقات خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.37,
   "end": 489.95,
   "text": "جلالت، بودن دوزخ، اینا آتش، نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.95,
   "end": 494.45,
   "text": "به هر حال میگه که شما گمان کن به یکباره خو نکرده بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.45,
   "end": 496.43,
   "text": "یه دفعه می‌اومدی تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.43,
   "end": 499.93,
   "text": "این حقیقت، این بود، این هست، اینی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.93,
   "end": 502.21,
   "text": "حالا این جمله ای که الان من گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.21,
   "end": 506.59,
   "text": "واقعا وقتی از علامه شنیدم باور کنید تنم واقعا لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.59,
   "end": 511.25,
   "text": "داشت علامه تبیین می‌کرد حقیقت وجود و حق رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.25,
   "end": 515.53,
   "text": "اینجا یه لحظه گفت اینی که هست واقعا من تا-- همینی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.53,
   "end": 518.85,
   "text": "اینو می‌خوای چی تعبیر کنی؟ چون جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.85,
   "end": 525.53,
   "text": "حالا در اوایل شرح فصوص قیسری تو اون مداخل دوازدهگانه‌ش اون مدخل اول باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.53,
   "end": 530.85,
   "text": "که می‌فرماید الفصل الاول في الوجود و انه هو الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.85,
   "end": 538.17,
   "text": "حق رو مساوق وجود می‌گیره و اونجا توضیح میده و بس-- اصلا کتب نوریه و صحف عرفانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.17,
   "end": 542.83,
   "text": "حتی حکمت متعالیه مثل اسفار و دیگر کتب آخوند اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.83,
   "end": 544.65,
   "text": "اومدن پیرامون وجود حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.65,
   "end": 547.33,
   "text": "اونم وجود صمدی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.33,
   "end": 555.59,
   "text": "نه بیان صرفا پیرامون شؤون حضرت حق یا اطوار حضرت حق که مثلا یکیش من و شما و زمین و آسمون و نباتات و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.59,
   "end": 557.67,
   "text": "این اصطلاحات رو بذار کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.67,
   "end": 559.99,
   "text": "کلا موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.99,
   "end": 565.57,
   "text": "ک-- بحث کتب عرفانیه و حکمت متعالیه وجود است، وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.57,
   "end": 571.79,
   "text": "موضوعش وجوده. نه وجود مفهومی‌ها که تو ذهنت تصور کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 571.79,
   "end": 574.05,
   "text": "اونچه که متن اعیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.05,
   "end": 576.61,
   "text": "یعنی در خارج وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.61,
   "end": 578.85,
   "text": "وجود داره، هست، هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.85,
   "end": 581.05,
   "text": "که الان تو داری درکش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.05,
   "end": 587.13,
   "text": "اون رو میشه انکار کرد؟ مرحوم حاجی سبزوارى اینو در-- زور زدم که به اینجا برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.13,
   "end": 590.13,
   "text": "میگه اون تدریج رو اگر در نظر نگیری به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.13,
   "end": 597.17,
   "text": "یکباره بیای با همین فعلیت که داری و این علم و دانش و استعداد به یکباره بیای تو این دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 597.17,
   "end": 600.25,
   "text": "این هست رو، این هستی رو، این بود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.25,
   "end": 602.17,
   "text": "که داری درک می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.17,
   "end": 605.11,
   "text": "مفهوم بودن نه، این هستی خودت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 605.11,
   "end": 609.59,
   "text": "اینو می‌تونی انکار کنی؟ این اصلا کاملا تجربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 609.59,
   "end": 613.91,
   "text": "شهودی‌ست. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.91,
   "end": 616.41,
   "text": "مرحوم شیخ الرئیس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.41,
   "end": 620.37,
   "text": "اوایل نوبت سوم اشاراتش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.37,
   "end": 623.73,
   "text": "وقتی مقایسه نفس و بدن رو می‌خواد بیان کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.73,
   "end": 626.35,
   "text": "می‌فرماید نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.35,
   "end": 630.13,
   "text": "از هر چیز غیر از خودش غافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.13,
   "end": 631.93,
   "text": "از هر چیزی غیر از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 631.93,
   "end": 636.01,
   "text": "یعنی به خودش نمی‌تونه غا-- هیچ وقت نفس از خودش غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 636.01,
   "end": 640.47,
   "text": "چون هسته. هست و خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.47,
   "end": 644.59,
   "text": "اصطلاحا ما ابد در پیش داریم علامه طباطبایی می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.59,
   "end": 646.37,
   "text": "ابد. هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 646.37,
   "end": 651.39,
   "text": "میشه اینو انکار کرد؟ یا نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 651.39,
   "end": 657.13,
   "text": "یا مرحوم ملا صدر در اسفارش می‌فرمود این کاملا توحید فطریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 657.13,
   "end": 661.45,
   "text": "این شهودیه. این درک بودن و وجود و حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.45,
   "end": 663.85,
   "text": "فطریه. که حالا شما میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.85,
   "end": 666.71,
   "text": "وجود، حق، هر اصطلاحی شما دوست داری بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 666.71,
   "end": 669.91,
   "text": "اگه میدان-- وسعت میدانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 669.91,
   "end": 677.33,
   "text": "اعم از یعنی بیشتر از کلمه وجود و حقه بسم الله شما هرچی دوست-- اصلا لفظ هرچی دوست داری بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.33,
   "end": 681.13,
   "text": "بذار حقیقت الحقائق. بذار نور الانوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.13,
   "end": 683.97,
   "text": "بذار هرچی دوست داری بذار. ما رو لفظ بحث نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 683.97,
   "end": 687.75,
   "text": "اون بودن، اون هست رو میشه انکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 687.75,
   "end": 692.35,
   "text": "قرآن هست یا نه؟ یک حقیقتی‌ست که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 692.35,
   "end": 695.19,
   "text": "درک می‌تونی بکنی. چرا اینو انکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 695.19,
   "end": 699.01,
   "text": "چرا با خودت درگیر می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.01,
   "end": 701.05,
   "text": "اصلا قابل انکار نیست. اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 701.05,
   "end": 703.77,
   "text": "مرحوم شیخ در شفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.77,
   "end": 708.41,
   "text": "یه بحث جالبی رو میاره اینم گوش بدید جمع‌بندی کنید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 708.41,
   "end": 711.79,
   "text": "خیلی بحث شیرینیه و دیگه هیچکس نمی‌تونه اینو انکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.79,
   "end": 718.45,
   "text": "می‌فرماید که چطور یه بچه‌ای می‌خواد وقتی بیان کنه که این توحید، این برهان صدقین، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 718.45,
   "end": 720.71,
   "text": "وجود داشتن وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.71,
   "end": 723.47,
   "text": "حق، هستی، بودن، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 723.47,
   "end": 726.71,
   "text": "فطریه، ذاتیه، اصلا انکار بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 726.71,
   "end": 728.45,
   "text": "اصلا شک بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 728.45,
   "end": 730.63,
   "text": "چه برسه به اشد شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 730.63,
   "end": 740.08,
   "text": "که ریب باشه اینجوری بیان میکنه مثال میزنه میگه چطور بچه‌ای که هنوز هیچی رو تشخیص نمیده تو بغل مادر از همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 740.08,
   "end": 742.48,
   "text": "بچگی یه دفعه بچ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.48,
   "end": 746.86,
   "text": "ب-مادر بغل کرده بچه رو یه لحظه دست مادر سست بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 746.86,
   "end": 750.2,
   "text": "این بچه محکم مادرشو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 750.2,
   "end": 755.62,
   "text": "نه حرف زدن بلده، نه راه رفتن بلده، نه چیزی بهش تعمیلی-- تعلیم داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 755.62,
   "end": 760.08,
   "text": "چگونه‌ست که می‌خواست بقای خودش رو حفظ کنه این بچه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.08,
   "end": 764.3,
   "text": "چی شد؟ چی در درون این بچه چی داره بهش الهام میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 764.3,
   "end": 769.14,
   "text": "بقای خودت رو-- این حب به بقا حتی در حیوانات هم وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.14,
   "end": 770.62,
   "text": "کی این مورچه رو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 770.62,
   "end": 776.72,
   "text": "مورملک و این عنکبوت و این سگ و این گربه رو کی اینا رو تعلیم داده که تو تا میری سمتش فرار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.72,
   "end": 779.12,
   "text": "این پرنده رو چرا میری سمتش فرار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.12,
   "end": 781.48,
   "text": "حب بقا. خب اینو کی بهش تعلیم داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.48,
   "end": 785.02,
   "text": "رفتی کلاس؟ نه. فطریه دیگه شهودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 785.02,
   "end": 787.8,
   "text": "میخواد اون بودنش، اون هستش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 787.8,
   "end": 793.44,
   "text": "اون وجودش رو که عین حقه \"سنریهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 793.44,
   "end": 799.76,
   "text": "آیاتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 799.76,
   "end": 802.22,
   "text": "حقه. هرچه هست حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 802.22,
   "end": 805.04,
   "text": "اطوارش حقند. شؤوناتش حقند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 805.04,
   "end": 808.32,
   "text": "شما حقید. آسمان و زمین حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 808.32,
   "end": 811.92,
   "text": "میخواد این بودن که حقه رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.92,
   "end": 815.0,
   "text": "لذا فرار میکنه. بچه خودش رو حفظ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 815.0,
   "end": 817.5,
   "text": "این ا-- کاملاً عین فطریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 817.5,
   "end": 820.04,
   "text": "شهودیه. بهش میگن برهان صدقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.04,
   "end": 824.54,
   "text": "اصلاً هیچ برهان دیگه‌ای تو نیاز نداری برای کشف حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.54,
   "end": 827.38,
   "text": "اینو چجوری میخوایم انکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 827.38,
   "end": 830.0,
   "text": "چگونه میشه که کسی در این هم ریب کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 830.0,
   "end": 833.68,
   "text": "اونم نه شک، شدت شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 833.68,
   "end": 838.6,
   "text": "چگونه میشه؟ حالا بزرگان اهل اخلاق و اخلاقیون ما اینجا جواب دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 838.6,
   "end": 841.72,
   "text": "گفتن دیگه بر اساس اون آیه \"أن كذبوا بآياتنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 841.72,
   "end": 844.34,
   "text": "گفتن اصرار بر گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 844.34,
   "end": 848.46,
   "text": "گناه پشت گناه. ظلمت روی ظلمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 848.46,
   "end": 853.16,
   "text": "کاری میکنه که دیگه اصلاً کلاً آیات الهی رو هم تکذیب میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 853.16,
   "end": 856.68,
   "text": "ولی اینجا البته عرض کنم تو ختم کلام دو نظر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 856.68,
   "end": 860.04,
   "text": "بعضیا معتقدن که نه، اون حقیقت محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 860.04,
   "end": 870.2,
   "text": "اون عرض شود شهود خودت به بودن و وجود رو، اینکه اصلاً خودت رو خودت خودت رو میگی عینا هستم و میخوام همیشه باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 870.2,
   "end": 873.24,
   "text": "ها؟ این رو دیگه هیچکس نمیتونه انکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 873.24,
   "end": 875.48,
   "text": "این چون فطریه نمیشه. اما بعضیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 875.48,
   "end": 879.14,
   "text": "بعضی از اخلاقیون گفتن نه اگر گناه شدت بگیره اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.14,
   "end": 881.54,
   "text": "انکار میشود. دو تا نظره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 881.54,
   "end": 884.32,
   "text": "در هر حال بدانیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 884.32,
   "end": 893.66,
   "text": "شک دالویی است، یک کانالی‌ست، یک راهرویی‌ست که متاسفانه اگر توش بمونه انسان به ریب میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 893.66,
   "end": 899.56,
   "text": "شدت شک انسان رو به جایی میکشونه که دیگه حقایق مسلم رو هم انکار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 899.56,
   "end": 901.72,
   "text": "اون موقع باید به چی برسه؟ به یقین برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 901.72,
   "end": 903.82,
   "text": "یکی از معنای يق-یقین چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 903.82,
   "end": 909.04,
   "text": "مرگ. \"واعبد ربك حتى يأتيك اليقين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 909.04,
   "end": 911.62,
   "text": "عبادت کن تا وقتی که یقین به تو برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 911.62,
   "end": 914.18,
   "text": "این یقین رو روایات فرمودن مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 914.18,
   "end": 915.86,
   "text": "دیگه اونجا همه میرسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 915.86,
   "end": 922.54,
   "text": "اونجا دیگه همه، اون کسی هم که مسلمات رو انکار کرده فطریاتم اگر بگیم قابل انکار باشد که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 922.54,
   "end": 925.74,
   "text": "اگر انکار کرده باشه اونجا دیگه نه، مشهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 925.74,
   "end": 927.84,
   "text": "اونجا دیگه کاملاً درک میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 927.84,
   "end": 929.92,
   "text": "و یقین براش حاصل میشه. لذا یکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 929.92,
   "end": 932.54,
   "text": "یکی از معانی مرگ یقین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 932.54,
   "end": 935.96,
