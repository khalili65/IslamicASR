 "chapters": [
  {
   "index": 0,
   "title": "## روایت شش حال جسم و روح؛ از گنجینهٔ گوهر روان",
   "start": 0.42,
   "end": 187.88
  },
  {
   "index": 1,
   "title": "## ستة أحوال للجسم والروح",
   "start": 187.88,
   "end": 208.22
  },
  {
   "index": 2,
   "title": "## مراتب یقین؛ از علم‌الیقین تا بردالیقین",
   "start": 208.22,
   "end": 439.85
  },
  {
   "index": 3,
   "title": "## مجالست با صاحب نفس؛ راه خروج از شک",
   "start": 439.85,
   "end": 526.89
  },
  {
   "index": 4,
   "title": "## شک مرض روح؛ درمان با ولی خدا",
   "start": 526.89,
   "end": 605.93
  },
  {
   "index": 5,
   "title": "## حکایت سوگند جوان و هو الأول والآخر",
   "start": 605.93,
   "end": 805.65
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 12.74,
   "text": "بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.74,
   "end": 16.68,
   "text": "الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.68,
   "end": 20.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.38,
   "end": 25.46,
   "text": "آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.46,
   "end": 27.9,
   "text": "یه روایت بسیار زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.9,
   "end": 31.76,
   "text": "و پرمغز، قشنگ، شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.76,
   "end": 39.92,
   "text": "که واقعاً به حق عرض می‌کنم اغراق نمی‌کنم که واقعاً یه دهه می‌طلبه که روی این روایت کار کنن اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.92,
   "end": 43.48,
   "text": "که البته عرض کنم سند رو که من از کجا این روایت رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.48,
   "end": 48.14,
   "text": "کتابی که دستم هست کتاب گنجینه‌ی گوهر روان از علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.14,
   "end": 52.66,
   "text": "روحی فدا هست. علامه حسن زاده که ابتدای این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.66,
   "end": 56.48,
   "text": "چون ایشون یه کتاب دیگه‌ای فکر می‌کنم اکه باز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.48,
   "end": 58.94,
   "text": "ایشون یه کتاب دیگه‌ای دارن به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.94,
   "end": 62.14,
   "text": "صد کلمه در معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.14,
   "end": 64.62,
   "text": "و البته اون کتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.62,
   "end": 67.8,
   "text": "یه مقدار بسیط‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.8,
   "end": 70.44,
   "text": "اون چیزی‌ست که در اینجا مقدمه آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.44,
   "end": 74.42,
   "text": "اینجا در مقدمه‌ی کتاب گنجینه‌ی گوهر روان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.42,
   "end": 77.72,
   "text": "که شاگردان علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.72,
   "end": 86.96,
   "text": "اون‌هایی که خیلی موفق‌ترن خیلی توصیه می‌کنن به جوونا در خواندن این کتاب بعد از کتاب معرفت نفس علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.96,
   "end": 89.4,
   "text": "بسیار من اون مدتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.4,
   "end": 91.76,
   "text": "تو بستر بیماری بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.76,
   "end": 94.88,
   "text": "ممهد الهمم علامه رو با این کتاب رو خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.88,
   "end": 97.94,
   "text": "خیلی برام شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.94,
   "end": 102.16,
   "text": "مقدمه‌ی این کتاب صد کلمه در معرفت نفس رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.16,
   "end": 105.46,
   "text": "بعد ورود می‌کنه به بحث گنجینه‌ی گوهر روان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.46,
   "end": 109.5,
   "text": "منظورش از روان هم همون نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.5,
   "end": 113.6,
   "text": "به زبان تازی نفس، به زبان پارسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.6,
   "end": 116.24,
   "text": "جان یا روان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.24,
   "end": 121.98,
   "text": "حالا اون روانشناسی اسلامی که ما می‌گیم یعنی همین معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.98,
   "end": 125.12,
   "text": "متأسفانه کسای دیگه دایی‌اش شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.12,
   "end": 133.92,
   "text": "اینجا در کلمه اگر خواستید رجوع کنید در کلمه هفتاد و چهار این روایت رو از علامه میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.92,
   "end": 138.88,
   "text": "و حالا از رو من این جمله خود علامه رو براتون بخونم تا برسم به روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.88,
   "end": 142.84,
   "text": "می‌فرماید «آنکه در جسم و روح خود بیندیشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.84,
   "end": 146.5,
   "text": "در جسم و روح خود بیندیشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.5,
   "end": 152.44,
   "text": "هر یک را بدین احوال شش گانه بیابد که آدم اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.44,
   "end": 158.28,
   "text": "حضرت وسی» خیلی جالبه که از علامه خیلی تأکید رو وسی بودن امیرالمؤمنین دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.28,
   "end": 162.62,
   "text": "«حضرت وسی امام علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.62,
   "end": 167.36,
   "text": "زبان داده است» که یعنی این روایت رو مولا فرمودن که ایشون اصطلاح می‌کنند به آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.36,
   "end": 169.16,
   "text": "اولیاء الله از مولامون علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.16,
   "end": 175.02,
   "text": "وایسین کلمات رو ببینین که واقعاً از دهان چنین کسی باید همچین کلماتی خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.02,
   "end": 177.22,
   "text": "ما بخوایم مولا رو معرفی کنیم چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.22,
   "end": 180.5,
   "text": "می‌گیم زور بازوی علی بابل فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.5,
   "end": 185.34,
   "text": "چه می‌دونم فوقش بگیم چشم و ابروی علی و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.34,
   "end": 188.6,
   "text": "حالا خستتون نکنیم روایتو ببینید \"إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.6,
   "end": 191.98,
   "text": "للجسم ستة أحوال\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.98,
   "end": 196.02,
   "text": "برای جسم شش تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.02,
   "end": 200.86,
   "text": "احوال وجودس-- شش تا حالت وجود داره \"الصحة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.86,
   "end": 202.8,
   "text": "والمرض والموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.8,
   "end": 207.46,
   "text": "والحياة والنوم\". هر کدوم دو به دو مقابله، متقابلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.46,
   "end": 211.14,
   "text": "الصحة مقابل المرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.14,
   "end": 213.16,
   "text": "والموت مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.16,
   "end": 218.02,
   "text": "الحياة. النوم مقابل اليقظة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.02,
   "end": 223.36,
   "text": "وكذلك الروح میگه الروح یعنی همه‌ی روح انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.36,
   "end": 226.96,
   "text": "الف لا میاد سر روح، همه‌ی روح انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.96,
   "end": 230.3,
   "text": "این هم می‌فرماید همین حالت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.3,
   "end": 233.2,
   "text": "یعنی روح انسان هم شش تا حالت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.2,
   "end": 238.76,
   "text": "بعد توضیح میده آقا امیرالمؤمنین توضیح میده که حالا تو، تو جسم که معلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.76,
   "end": 241.22,
   "text": "صحت و مریضی‌ش چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.22,
   "end": 243.36,
   "text": "خواب و بیداری‌ش چگونه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.36,
   "end": 245.8,
   "text": "یا موت و حیاتش چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.8,
   "end": 248.62,
   "text": "اما در روح رو حضرت چگونه تصویر می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.62,
   "end": 252.1,
   "text": "\"فحياتهها علما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.1,
   "end": 254.74,
   "text": "علم حیات روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.74,
   "end": 257.9,
   "text": "یعنی اگر کسی به سراغ علم نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.9,
   "end": 260.1,
   "text": "این مرده‌ست. مرده‌ی متحرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.1,
   "end": 263.18,
   "text": "قرآن هم می‌فرماید هَلْ يَسْتَوِي الَّذِينَ يَعْلَمُونَ وَالَّذِينَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.18,
   "end": 267.58,
   "text": "لَا يَعْلَمُونَ آیا مساوی‌اند کسانی که می‌دانند و اونایی که نمی‌دانند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.58,
   "end": 269.68,
   "text": "قابل توجه اونایی که از علم فراری‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.68,
   "end": 271.78,
   "text": "\"و موتها جهلها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.78,
   "end": 275.64,
   "text": "این جهل، نادانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.64,
   "end": 278.28,
   "text": "مرگ روح کسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.28,
   "end": 284.8,
   "text": "و حالا چون بحث ما اینجاست، اینجا می‌خوایم یه ذره توقف کنیم و \"مرضها شك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.8,
   "end": 287.42,
   "text": "مرض، مریضی روح انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.42,
   "end": 292.14,
   "text": "حالا شما بگیر همون روان انسان، جان انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.14,
   "end": 294.76,
   "text": "ها؟ اون میگه مریضی‌ش تو شکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.76,
   "end": 297.42,
   "text": "بحث ما هم تو چی بود؟ قلب مرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.42,
   "end": 301.06,
   "text": "قلبی که دائماً دچار شک و ریب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.06,
   "end": 303.64,
   "text": "این‌هاست. خب صحتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.64,
   "end": 307.32,
   "text": "مقابلش چیه؟ \"صحتها يقينها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.32,
   "end": 312.0,
   "text": "صحتش به يقينه. يقين مقابل شکه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.0,
   "end": 315.6,
   "text": "و البته \"نومها غفلتها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.6,
   "end": 317.94,
   "text": "یعنی خوابش تو غفلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.94,
   "end": 323.18,
   "text": "خواب روح، جان ما. \"ويقظتها حفظها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.18,
   "end": 325.66,
   "text": "و اینکه تو بتونی این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.66,
   "end": 328.44,
   "text": "در حقیقت نگهداریش کنی، روح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.44,
   "end": 333.44,
   "text": "همون مراقبت. مراقبت که علامه خیلی بهش تأکید داره این می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.44,
   "end": 336.4,
   "text": "در حقیقت بیداری روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.4,
   "end": 341.8,
   "text": "تا اگر کسی ما-- یعنی غافل باشه از مراقبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.8,
   "end": 345.06,
   "text": "حضور و مراقبت قطعاً روحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.06,
   "end": 348.24,
   "text": "می‌میره یا حالا به خواب می‌ره اینطوری بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.24,
   "end": 354.26,
   "text": "حالا رو بحث شک من نکته‌ای رو می‌خواستم عرض کنم که بحث قلب مرید بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.26,
   "end": 356.22,
   "text": "که مقابل یقین قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.22,
   "end": 362.69,
   "text": "جالبه که مراتب یقین هم شما اگر دقت بفرمایید تمام بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.69,
   "end": 366.91,
   "text": "بر اساس روایات ما مراتب یقین رو از علم شروع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.91,
   "end": 369.97,
   "text": "علم اليقين که پایه‌ی اولشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.97,
   "end": 372.79,
   "text": "اصلاً نمیشه به جز دانستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 372.79,
   "end": 377.25,
   "text": "و فهمیدن که منجر به چشیدن بشه انسان به یقین برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.25,
   "end": 380.75,
   "text": "باید رفت سح- سمت علم و دانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.75,
   "end": 386.81,
   "text": "علم اليقين مبدل می‌شه به عين اليقين که تو اون چیزی که می‌دانی رو ببینیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.81,
   "end": 389.67,
   "text": "بعد بشه حالا حق اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.67,
   "end": 393.23,
   "text": "یعنی بچشی. اون که می‌بینی رو بعد دیگه بچشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.23,
   "end": 396.53,
   "text": "بعد تازه به قول علامه بشود برد اليقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.53,
   "end": 401.73,
   "text": "که اصلاً بیارمی. یعنی آرامش پیدا کنی، به اطمینان برسی و اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.73,
   "end": 404.05,
   "text": "تو چشیدی تو رو به اطمینان برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.05,
   "end": 408.03,
   "text": "یعنی کاملاً در تو پیاده‌شا-- پیاده‌سازی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.03,
   "end": 412.03,
   "text": "یعنی متحقّق بشه اسماء الهی در وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.03,
   "end": 415.53,
   "text": "تو که محقّق میشی بعد پیاده بشه بشی متحقّق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.53,
   "end": 417.95,
   "text": "یا دقت نظر داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.95,
   "end": 423.05,
   "text": "متدقق. یعنی اون دقت‌هات پیاده بشه در وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.05,
   "end": 427.01,
   "text": "که این مقابلش می‌شه چی؟ مقابلش می‌شه شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.01,
   "end": 431.13,
   "text": "کسی که شکاک همش به هر چیزی شک می‌کنه ایناها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.13,
   "end": 434.01,
   "text": "قطعاً به سمت یقین حرکت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.01,
   "end": 437.93,
   "text": "یعنی به یه پله‌ی یقینش می‌لنگه که از کجا شروع باید می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.93,
   "end": 439.85,
   "text": "نکرده. از علم، علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.85,
   "end": 443.59,
   "text": "و چه خوش که انسان پیدا کنه یه س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.59,
   "end": 450.47,
   "text": "صاحب نفسی رو. افسوس که از دست ما رفتن خیلی از این بزرگان مثل خود حضرت علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.47,
   "end": 452.99,
   "text": "آقای حق شناس یادش بخیر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.99,
   "end": 457.31,
   "text": "اصلاً می‌شستیم محضر ایشون تو حجره باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.31,
   "end": 459.31,
   "text": "انگار که بار یه سالمون رو می‌بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.31,
   "end": 462.55,
   "text": "یادش بخیر. آخه کجا رفتن اینا واقعاً ما رو تنها گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.55,
   "end": 465.09,
   "text": "انشاالله ما بریم با اون‌ها ملحق شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.09,
   "end": 467.97,
   "text": "و یه آدم خوش نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.97,
   "end": 471.43,
   "text": "خوش سُرو، خوش بیان رو پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.43,
   "end": 474.25,
   "text": "حقایق علمی رو از اون تلقی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.25,
   "end": 476.15,
   "text": "و الا به یقین نمی‌رسه و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 476.15,
   "end": 481.35,
   "text": "شک اون رو می‌کشونه به سمت ان کاردبوایات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.35,
   "end": 483.57,
   "text": "به تکذیب می‌رسه از شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 483.57,
   "end": 486.37,
   "text": "باید بره به سمتی بالاخره رفت باید هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 486.37,
   "end": 490.63,
   "text": "به قول استاد قاضی نصف عمرتو صرف کنی تا پیدا کنی یه نفر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 490.63,
   "end": 493.99,
   "text": "ولی پیدا کردی دیگه ولش نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.99,
   "end": 501.77,
   "text": "خود بنده هری چه شب‌ها تا صبح در خونه‌ی آقای بهجت می‌شستیم گریه می‌کردیم پشت در خونه‌ش تو هوای سرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.77,
   "end": 505.27,
   "text": "گریه می‌کردیم پشت خود علامه پشت در خونه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.27,
   "end": 507.33,
   "text": "حضرت علامه رحمت‌الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.33,
   "end": 511.29,
   "text": "می‌شستم من. شعر می‌گفتم در حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.29,
   "end": 514.21,
   "text": "علامه. غزل می‌گفتم مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.21,
   "end": 519.75,
   "text": "بعد می‌دیدمش بهش می‌دادم. حالا اونم به برکت این کار ما یه هدیه به ما می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.75,
   "end": 521.97,
   "text": "و آدم بره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.97,
   "end": 524.69,
   "text": "واقعاً نمی‌دونم چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.69,
   "end": 526.89,
   "text": "غیر از این باشه ما باختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 526.89,
   "end": 528.79,
   "text": "بعد حالا شک رو می‌گه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.79,
   "end": 531.11,
   "text": "مرض دیگه. مریضی روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.11,
   "end": 533.79,
   "text": "خوبه آدم روحش مریض باشه از دنیا بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 533.79,
   "end": 539.03,
   "text": "بعد دچار اون در تکامل برزخی مجبورن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.03,
   "end": 542.57,
   "text": "فشارش بدن که نجاتش بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.57,
   "end": 545.93,
   "text": "تو زیر فشار قرارش میدن که اونم می‌شه همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.93,
   "end": 550.01,
   "text": "عذاب‌های برزخی. حالا چه خوش که انسان بتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 550.01,
   "end": 555.29,
   "text": "از طریق همین حالا کمالین که در توحید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.29,
   "end": 559.49,
   "text": "تمکن رسیدن راه پیدا کنه به نفس مولامون علی علیه‌السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.49,
   "end": 563.19,
   "text": "به حجت بن الحسن که مرحوم سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.19,
   "end": 566.55,
   "text": "که حالا ما گروه های جمعه بحث رسائل عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.55,
   "end": 568.09,
   "text": "از این هفته پیش شروع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.09,
   "end": 573.55,
   "text": "کسایی که رجوع کنن به کانال آقای مران گمنامی اولین جلسه‌ش بارگذاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.55,
   "end": 575.91,
   "text": "رساله سیر و سلوکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 575.91,
   "end": 580.05,
   "text": "سید بحر العلوم رو اونجا شروع کردیم به فضل الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.05,
   "end": 582.77,
   "text": "که البته اصل رساله مال سید بن طاووسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.77,
   "end": 586.39,
   "text": "ایشون شروع کرد، ایشون شرحش داده ولی منتسبه به سید بحر العلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.39,
   "end": 589.15,
   "text": "آقای قاضی گفتم. خب آدم بتونه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.15,
   "end": 595.77,
   "text": "اونجا سید بحر العلوم کسی بوده که دائما باب تشرف محضر امام عصر به روش باز بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.77,
   "end": 601.55,
   "text": "آدم بتونه از امام عصر که نفسش نفس مولا علی‌ست بهره ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.55,
   "end": 605.93,
   "text": "یه نفس اون‌ها برای یک عمر انسان بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.93,
   "end": 610.47,
   "text": "یا حالا در کتاب توحید صدوق که اتفاقاً در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 610.47,
   "end": 615.73,
   "text": "فسوس الحکمه از علامه هم می‌ذارم جلسه‌ای کس خواست رجوع کنه جلسه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 615.73,
   "end": 622.15,
   "text": "هشتم شرحش علامه به همین نکته اشاره می‌کنه در توحید صدوق که روایتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.15,
   "end": 626.39,
   "text": "که امام باقر صلوات الله علیه فرمودن ظاهراً از امیرالمؤمنین باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 626.39,
   "end": 629.37,
   "text": "آدم اولیاء الله به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 629.37,
   "end": 631.57,
   "text": "ایشون از همین رد می‌شدن یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 631.57,
   "end": 634.09,
   "text": "دو تا جوان داشتن می‌رفتن. یکیشون قسم خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.09,
   "end": 637.49,
   "text": "سوگند به خدایی که پشت اون آسمون هفتمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 637.49,
   "end": 641.53,
   "text": "مولا زد رو دوشش فرمود کدوم خدایی که پشت آسمون هفتمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.53,
   "end": 643.61,
   "text": "کدوم خدا رو میگی؟ موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 643.61,
   "end": 647.53,
   "text": "اصلاً نفس مولا، اون القا‌ات و اشراقات حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 647.53,
   "end": 651.01,
   "text": "زد تمام اون بت‌های وجودیشو شکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 651.01,
   "end": 656.27,
   "text": "لال شد. نتونست حرف بزنه. حضرت فرمود چ-چگونه خدا پشت آسمان‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 656.27,
   "end": 661.09,
   "text": "در حالی که او خودش رو در قرآن این چنین معرفی کرده که هو الاول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.09,
   "end": 664.35,
   "text": "والآخر والظاهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.35,
   "end": 668.73,
   "text": "هو في السماء اله و في الارض اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 668.73,
   "end": 674.19,
   "text": "همون اله که ما می‌گیم لا اله الا الله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.19,
   "end": 677.13,
   "text": "اول ی-- نفی می‌کنیم هر الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.13,
   "end": 679.79,
   "text": "به جز او بعد اثباتش می‌کنیم الله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 679.79,
   "end": 682.13,
   "text": "می‌گه تو آسمون همون اله ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.13,
   "end": 684.71,
   "text": "همون ه. همون قل ه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 684.71,
   "end": 689.73,
   "text": "الله احد. همون ه تو آسمون همون ه است و فی الارض اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 689.73,
   "end": 693.65,
   "text": "آیه قرآنه. تو زمین هم همین الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.65,
   "end": 700.97,
   "text": "خب چگونه این می‌شه؟ بعد اون طرف سس شد گفت یعنی متوجه حالا نفس مولا زد و متوجه‌اش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 700.97,
   "end": 707.51,
   "text": "آدم بشینه پای درس توحیدی اشراقی القایی یک ولی خدا چقدر دست ما کوتاه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 707.51,
   "end": 711.41,
   "text": "خدا لعنت کنه اونایی که دست و بال ما رو از اماممون کوتاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 711.41,
   "end": 713.59,
   "text": "دست مولامون علی رو بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 713.59,
   "end": 715.17,
   "text": "ما رو به این حال روز کشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 715.17,
   "end": 722.03,
   "text": "به خدا. که بعد خلاصه گفت آقا متنبّه شد گفت آقا حالا من باید کفاره بدم که قسم خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 722.03,
   "end": 725.43,
   "text": "حضرت فرمود تو خدای به واقع رو قسم نخوردی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 725.43,
   "end": 727.95,
   "text": "یه خدای دروغین رو قسم خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 727.95,
   "end": 734.87,
   "text": "اما اگر می‌خوای کفاره بدی باشه کفارت این باشه که دیگه از این به بعد اعتقادت به این باشه که هو الاول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 734.87,
   "end": 737.29,
   "text": "والآخر والظاهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 737.29,
   "end": 739.73,
   "text": "هو في السماء اله و في الارض اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 739.73,
   "end": 742.81,
   "text": "ه اون ه اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 742.81,
   "end": 746.01,
   "text": "همون هو الاول الآخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 746.01,
   "end": 750.49,
   "text": "روش فکر کنید و همون هو الاول والاخر الظاهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 750.49,
   "end": 753.35,
   "text": "و همون هو الاول والاخر والظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 753.35,
   "end": 755.81,
   "text": "الباطن. یعنی باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 755.81,
   "end": 759.19,
   "text": "حضرت حق است. ظاهر عالم حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 759.19,
   "end": 761.81,
   "text": "اول عالم اول بی اول خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.81,
   "end": 767.23,
   "text": "آخر بی آخر خ-- اصلاً چیزی جز حضرت حق نیست و بقیه همین کفرات هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 767.23,
   "end": 770.31,
   "text": "تشؤنات و شؤونات و اطوار حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 770.31,
   "end": 775.29,
   "text": "طورهای مختلف و ظهور باطن حضرت حق‌اند که یکی از اون اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.29,
   "end": 778.31,
   "text": "و اون ظهورات یا مظاهر شما هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 778.31,
   "end": 784.81,
   "text": "پس مراقب باشیم وقتتون رو نگیریم که مولامون علی علیه‌السلام تصریح می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 784.81,
   "end": 787.45,
   "text": "شک مریضی روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 787.45,
   "end": 791.69,
   "text": "زودتر خودمون رو انشاالله به دست یه ولی خدا درمان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 791.69,
   "end": 794.41,
   "text": "عاقبتمون انشاالله ختم بخیر بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 794.41,
   "end": 797.25,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 797.25,
   "end": 800.47,
   "text": "اللهم صل على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 800.47,
   "end": 805.65,
   "text": "آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}