   "start": 2.26,
   "end": 121.2
  },
  {
   "index": 1,
   "title": "## آیهٔ قاف؛ منّاع للخیر معتد مریب",
   "start": 121.2,
   "end": 207.64
  },
  {
   "index": 2,
   "title": "## سه قرآن و تحویل‌دادن خود به نظام هستی",
   "start": 207.64,
   "end": 320.0
  },
  {
   "index": 3,
   "title": "## تطابق آدم و عالم در خواب",
   "start": 320.0,
   "end": 595.62
  },
  {
   "index": 4,
   "title": "## بدن و نفس یک حقیقت‌اند؛ خوردن و بو کردن طعام",
   "start": 595.62,
   "end": 781.53
  },
  {
   "index": 5,
   "title": "## فصل میوه و ذخیره نکردن؛ اصل انطباق برای یقین",
   "start": 781.53,
   "end": 941.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.26,
   "end": 5.12,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.12,
   "end": 8.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 13.64,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.64,
   "end": 15.58,
   "text": "می‌دونید که نذر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.58,
   "end": 20.2,
   "text": "کلاً مورد نذر و موضوع نذر و کلاً باید همونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.2,
   "end": 24.8,
   "text": "شما مد نظرتون بوده و نذر کردید، نیت کردید، همونجا هزینه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.8,
   "end": 27.74,
   "text": "هیچ کجای دیگه‌ای نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.74,
   "end": 34.58,
   "text": "مگر اینکه اون صیغه نذر بر لسان جاری نشده باشه یعنی به لسانتون به زبانتون جاری نکرده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.58,
   "end": 38.88,
   "text": "نگفته باشید که این مثلا نذری که دارید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.88,
   "end": 45.54,
   "text": "مثلا مخصوص فلان هیئت، مقصود فلان خیریه است مقص-- اگه نگفته باشید هر کجا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.54,
   "end": 47.8,
   "text": "و اصلاً وجوبش هم برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.8,
   "end": 54.08,
   "text": "اما اگر به لسان صیغه نذر جاری شد عین همون باید انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.08,
   "end": 56.46,
   "text": "حالا سؤال اینه که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.46,
   "end": 60.48,
   "text": "نذر می‌کنن، نذرشون مطلقه، مقید نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.48,
   "end": 63.86,
   "text": "که حالا مثلاً یه غذایی بپزن بدن به یه جایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.86,
   "end": 72.4,
   "text": "بعد می‌برن میدن به جاهایی که توی اونجاها کفار هست، مشرکین هست، مخالفین با این نظام هست، مخالفین با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.4,
   "end": 75.46,
   "text": "مثلاً ولایت هست و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.46,
   "end": 81.16,
   "text": "آیا این جایزه؟ نذری که مثلاً کسی برای امام حسین نذر کرده، برای مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.16,
   "end": 85.72,
   "text": "اهل کعبه نذر کرده و چه وچه ببره بده به جاهایی که اینچنوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.72,
   "end": 93.34,
   "text": "یا مثلاً می‌برن به بعضیا میدن به دراویش یا میدن به جاهایی که علی‌اللهی‌ان هستند صراحتاً میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.34,
   "end": 99.4,
   "text": "رهبر عزیزمون فرمودن که اگر باعث تقویت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.4,
   "end": 102.12,
   "text": "اعتقادات فاسد باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.12,
   "end": 105.16,
   "text": "حرامه اصلاً. دادن نذر، نذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.16,
   "end": 108.22,
   "text": "داره یه کار مستحب می‌کنه، یه کار خیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.22,
   "end": 111.04,
   "text": "اگه بده حرام کرده. بده به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.04,
   "end": 114.9,
   "text": "جاهایی که این کار باعث تقویت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.9,
   "end": 118.34,
   "text": "افکار غلط و باطل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.34,
   "end": 127.22,
   "text": "اینو حواسمون جمع باشه. آیه‌ای رو در قرآن می‌خوندم حالا چون بحث ما قلب مریب هست و قلب مردد و شکاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.22,
   "end": 133.32,
   "text": "خب خوبه آدم هر موردی رو که داره بررسی می‌کنه یه دور قرآن رو خسف کنه به همین نیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.32,
   "end": 135.74,
   "text": "بعد می‌بینه به مطالب جالبی می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.74,
   "end": 140.54,
   "text": "و من دیروز بود رسیدم به آیه قاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.54,
   "end": 145.18,
   "text": "سوره قاف، آیه بیست و پنج که \"مناع للخير معتد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.18,
   "end": 149.56,
   "text": "مریب\". چه عجیب که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.56,
   "end": 156.46,
   "text": "شکاک رو آورده هم‌ردیف معتد یعنی ستمکار کسی که ظلم می‌کنه به مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.46,
   "end": 158.94,
   "text": "چقدر بده، چقدر وقیحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.94,
   "end": 166.6,
   "text": "بد کردن به دیگران و در کنار مناع اونم بر وزن فعال نه فقط یه بار دو بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.6,
   "end": 171.74,
   "text": "منع خیر کنه. \"مناع للخير\" یعنی دائماً اصلاً مشغول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.74,
   "end": 174.7,
   "text": "منع خیره. اصلاً نمی‌خواد خیر به اهدی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.7,
   "end": 178.32,
   "text": "خیلی بده. یعنی ببینید این شک و قلب شکاک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.32,
   "end": 181.34,
   "text": "قلب مریب چقدر وضعیتش خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.34,
   "end": 184.24,
   "text": "اصلاً شک داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.24,
   "end": 189.42,
   "text": "ریب داشتن، مردد بودن تو مسائل معنوی و حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.42,
   "end": 194.54,
   "text": "خیلی چیز بدیه. یعنی آدم واقعاً از چشم خدا و اهل بیت می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.54,
   "end": 200.44,
   "text": "مگر اینکه حالا قبلاً بحثش گذشته که به عنوان یه راهروی فقط ازش بگذری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.44,
   "end": 207.4,
   "text": "به یقین برسی. برسی به یقین نه اینکه توقف کنی که باز اون هم به طور absolute خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.4,
   "end": 211.86,
   "text": "یه اصلی اینجا هست این اصل رو خوب گوش بدید خیلی به دردتون می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.86,
   "end": 217.06,
   "text": "که من تأسف می‌خورم بابت کسانی که این مباحث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.06,
   "end": 220.78,
   "text": "پس می‌زنن و میگن حاج آقا یه حدیث بگو، یه داستان بگو برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.78,
   "end": 224.78,
   "text": "مثلاً این حرفو در حالی که اصلاً این چیزاست که به درد ما می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.78,
   "end": 228.54,
   "text": "و روایات و آیات اینا باید بیاد در کمک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.54,
   "end": 232.6,
   "text": "این حقایق. یعنی ما باید به ما کمک کنن اینا رو بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.6,
   "end": 240.58,
   "text": "ما قبلاً گفتیم که برای نجات از شک، از شک و ریب راهی نداریم جز اینکه خودمون رو تحویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.58,
   "end": 245.76,
   "text": "قرآن بدیم که قرآن کتبی بود، کتاب کتبی حضرت حق بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.76,
   "end": 248.0,
   "text": "یا قرآن انسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.0,
   "end": 253.6,
   "text": "در حقیقت متن قرآن نظام هستی‌ست یا قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 253.6,
   "end": 260.6,
   "text": "ناطق است یا امام عصر است یا حالا هر اسم می‌خوای بگذار، حجت زمان یا خودمون رو تحویل حجت زمان بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 260.6,
   "end": 264.36,
   "text": "در این مرحله سوم میگیم که یکی دیگه از راه‌ها اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 264.36,
   "end": 267.5,
   "text": "مگه شما نگفتی قرآن سه تا قرآن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.5,
   "end": 270.36,
   "text": "قرآن کتبی، همین قرآنی که دستمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.36,
   "end": 273.98,
   "text": "قرآن انسی، جان امام، انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.98,
   "end": 277.7,
   "text": "قرآن هستی یا افقی یعنی نظام افقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 277.7,
   "end": 281.88,
   "text": "پس در نتیجه میشه خودمون رو تحویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.88,
   "end": 284.32,
   "text": "نظام افقی هم بدهیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.32,
   "end": 287.58,
   "text": "بله. اتفاقاً سومین راه و روش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.58,
   "end": 290.28,
   "text": "همینه. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.28,
   "end": 293.94,
   "text": "مگر اون قرآن نیست و تو هم قرآن نیستی با خودتو تب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.94,
   "end": 298.66,
   "text": "مثلاً چگونه نفسش رو-- نفست رو تطبیق با قرآن کتبی میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.66,
   "end": 300.44,
   "text": "قرآن رو مرور می‌کنی، می‌خونی، شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.44,
   "end": 306.94,
   "text": "قدر می‌ذاری رو سرت که این تطبیق داده بشه با قلبت یکی بشه، اتحاد وجودی برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.94,
   "end": 311.82,
   "text": "الانم با نظام هستی-- اصلاً یه اصله از تئوریمه حسن زاده روی این خیلی تأکید دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.82,
   "end": 315.82,
   "text": "می‌فرمایند تطابق بین آدم و عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.82,
   "end": 320.0,
   "text": "حالا من چند تا نمونه مثال می‌زنم ببینید یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 320.0,
   "end": 323.42,
   "text": "مثلاً در خصوص الان بیشترین مشکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.42,
   "end": 328.16,
   "text": "س-- اهل سیر و سلوک تو وادی خوردن، خوابیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.16,
   "end": 331.44,
   "text": "معاشرت و خوردن و خوابیدن و اینا بیشتر مشکل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.44,
   "end": 335.76,
   "text": "هرکی هم می‌رسه میگه آقا مثلاً یه دستورالعملی به ما بدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.76,
   "end": 337.38,
   "text": "بیشتر تو این دو تا مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.38,
   "end": 339.9,
   "text": "یکی خوردنش، یکی خوابیدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.9,
   "end": 344.56,
   "text": "خب شما نگاه کنید ببینید حیوانات چگونه می‌خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.56,
   "end": 347.88,
   "text": "این تطابق بین آدم و عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.88,
   "end": 351.76,
   "text": "حیوانات چگونه می‌خوابن؟ اولاً تو ساعت خوابیدنشون نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.76,
   "end": 356.08,
   "text": "شما اصلاً می‌بینید حیوانی رو که از بین طلوعین به بعد بخوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.08,
   "end": 361.16,
   "text": "بله بین روز دیده شده حیوانات مثلاً مخصوصاً قبل از اذان ظهر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.16,
   "end": 365.18,
   "text": "احکام که میگن مثلاً خواب قیلوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.18,
   "end": 367.66,
   "text": "قبل اذان ظهر اصلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.66,
   "end": 371.26,
   "text": "حالا غذاشم بعد از اذان ظهر میشه انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.26,
   "end": 375.96,
   "text": "اما باور کنید دقت کنید خیلی از حیوانات تو اون لحظه تو چرتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.96,
   "end": 378.44,
   "text": "تو خوابن، یه چشم رو هم میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.44,
   "end": 381.72,
   "text": "اینا همش برگرفته از این نظام هستی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.72,
   "end": 383.28,
   "text": "همه چی با هم منطبق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.28,
   "end": 390.88,
   "text": "ما توجه نداریم. دیده نشده حیوانی شب تا صبح بیدار باشه بعد صبح تا شب بخوابه یا صبح تا بعدازظهر بخ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.88,
   "end": 394.22,
   "text": "در حالی که آدما مخصوصاً جوونای امروز این کارو زیاد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.22,
   "end": 396.46,
   "text": "شب‌ها تا دیروقت بیدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.46,
   "end": 400.42,
   "text": "اکثراً شما مثلاً نمی‌دونم مرغ و خروس داشتید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.42,
   "end": 406.18,
   "text": "همین که هوا داره تاریک می‌شه، هنوز تاریک نشده میرن دنبال جاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.18,
   "end": 409.22,
   "text": "اصلاً نیاز نداره تو جاشون کنی، خودشون میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.22,
   "end": 412.94,
   "text": "هوا داره تاریک می‌شه می-- میدونن وقت خوابه، میرن می‌خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 412.94,
   "end": 416.2,
   "text": "بعد هنوز هوا روشن نشده میان بیرون از تو جاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.2,
   "end": 419.26,
   "text": "اگه داشته باشید اینو دقت کرده باشید می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.26,
   "end": 423.0,
   "text": "این خودش یه دستور العمله. خب تطبیق بده خودت رو با اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.0,
   "end": 425.32,
   "text": "یکی هم نحوه خوابیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.32,
   "end": 431.84,
   "text": "نحوه خوابیدن یعنی چی؟ بسیاری از ماها یا به پشت می‌خوابیم یا به رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.84,
   "end": 433.56,
   "text": "یا به پشت می‌خوابیم یا آره به رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.56,
   "end": 436.58,
   "text": "آقا به رو رو شنیده بودیم خواب شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.58,
   "end": 438.64,
   "text": "به پشت هم نباید بخوابین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.64,
   "end": 441.26,
   "text": "مگه حدیث نداریم که خواب انبیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.26,
   "end": 445.72,
   "text": "هرکی گفته اشتباه گفته. خواب انبیا این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 445.72,
   "end": 447.5,
   "text": "خواب انبیا به پشت خوابیدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.5,
   "end": 449.62,
   "text": "وقت تلقی وحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.62,
   "end": 453.38,
   "text": "در حال خوابیدن به پشت می‌خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.38,
   "end": 455.92,
   "text": "نه خواب. خواب نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.92,
   "end": 462.52,
   "text": "وقتی می‌خواستن وحی رو تلقی کنن تو اون حالت‌ها، حالا می‌خوای اسمشو هرچی بذار مکاشفه یا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.52,
   "end": 466.22,
   "text": "هنگام الهامات و وحی و تلقی وحی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.22,
   "end": 468.98,
   "text": "به پشت دراز می‌کشیدند نه که بخوابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.98,
   "end": 471.64,
   "text": "خواب فقط نحوه صحیح خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.64,
   "end": 473.76,
   "text": "به راست خوابیدن، به چپ خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.76,
   "end": 476.7,
   "text": "هیچ حیوانی تا حالا دیدید به پشت بخوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.7,
   "end": 479.18,
   "text": "هیچ حیوانی دیدید به شکم بخوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.18,
   "end": 482.16,
   "text": "همه ل-- یا به بغلن یا به اینور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.16,
   "end": 484.46,
   "text": "یا به راستن یا به چپ. تازه حیوا-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.46,
   "end": 487.76,
   "text": "پرنده‌ها که چه عجیب اصلاً روی یه پاش می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.76,
   "end": 492.26,
   "text": "اصلاً عجیب. تو می‌تونی؟ یا اصلاً یه پاشو آویزون، آویزون خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.26,
   "end": 495.1,
   "text": "یه پاشو گرفته چنگولشو اینطوری گرفته آویزون خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.1,
   "end": 497.76,
   "text": "چه عجیب! اینا دیگه جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.76,
   "end": 500.0,
   "text": "ماض-- واقعاً عجایب خلقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.0,
   "end": 505.0,
   "text": "حالا پس این قصه مخصوصاً حالا به رو خوابیدن که شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.0,
   "end": 509.5,
   "text": "حالا قوه، اون قوای تحریکی که هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.5,
   "end": 511.3,
   "text": "قوای ت-- ادراکی که هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.3,
   "end": 517.18,
   "text": "قوای تحریکی یعنی شهوت و غضب خصوصاً شهوت این موقع تحریک می‌شن وقتی به رو می‌خوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.18,
   "end": 519.24,
   "text": "به پشت می‌خوابی چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.24,
   "end": 523.48,
   "text": "می‌خوای بخوابی آقا یه وقت به پشت دراز می‌کشی فکر می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.48,
   "end": 528.6,
   "text": "میری تو حالت مکاشفه و خلسه و توجه عرفانی که اون هیچی، اون خیلی هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.6,
   "end": 533.02,
   "text": "ولی برای نوم حالا یه چه صنه باشه، چه نوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.02,
   "end": 535.86,
   "text": "برای هر دوتاش وقتی به پشت خوابیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.86,
   "end": 539.58,
   "text": "مریضی‌های متعددی خصوصاً برای قلب ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.58,
   "end": 541.86,
   "text": "البته پزشکای امروزم اینو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.86,
   "end": 543.58,
   "text": "بعضیا اصلاً توجه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.58,
   "end": 547.32,
   "text": "بسیاری به خاطر به پشت خوابیدن سکته می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.32,
   "end": 550.94,
   "text": "اصلاً قلب رو از کار میندازه، ضعیف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.94,
   "end": 554.22,
   "text": "یه مریضی حتی ایجاد می‌کنه بهش می‌گن سکالچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.22,
   "end": 557.98,
   "text": "به پشت که می‌خوابی. دیدی معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.98,
   "end": 562.7,
   "text": "به پشت خوابیدی رو به آسمون یه دفعه یه حالت خفگی بهت دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.7,
   "end": 565.5,
   "text": "قدیم‌ها می‌گفتن آل افتاد روم، بختک افتاد روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.5,
   "end": 567.8,
   "text": "از این چرت و پرت‌ها که حقیقت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.8,
   "end": 574.86,
   "text": "نخیر، شما بد خوابیدی و نظام وجود تو اینجا منطبق با نظام عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.86,
   "end": 580.92,
   "text": "آدم و آدم، آدم و عالم با هم منطبق نشدن مشکل ایجاد می‌شه حتی تو خوابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.92,
   "end": 583.08,
   "text": "اینا باید منطبق باشن. نباید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.08,
   "end": 585.26,
   "text": "پشت و رو به آسمون بخوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.26,
   "end": 589.24,
   "text": "این مشکلات پیش میاد. یه دفعه حالت خفگی بهت دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.24,
   "end": 592.08,
   "text": "م-میپری از خواب یه دفعه یا مثلاً فکر می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.08,
   "end": 595.48,
   "text": "یا حالای-- خواب‌های بد می‌بینی، پریشون، مال اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 595.48,
   "end": 599.14,
   "text": "حالا این بخش خوابیدنش زیاده، حرف زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 599.14,
   "end": 603.66,
   "text": "مثلاً مثال‌هایی زدم که یعنی چی انطباق بین عالم و آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 603.66,
   "end": 606.92,
   "text": "باور کنید اینا تو مزاج تاثیرگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 606.92,
   "end": 610.94,
   "text": "و کسی هم مزاجش ضعیف شد دچار شک و ریب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.94,
   "end": 613.26,
   "text": "یعنی اینا کاملاً با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 613.26,
   "end": 616.98,
   "text": "چرا می‌گه عقل سالم در بدن سالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.98,
   "end": 619.18,
   "text": "اینا کاملاً با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 619.18,
   "end": 621.8,
   "text": "اصلاً این غلطه که بگیم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 621.8,
   "end": 624.5,
   "text": "نفس راکبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.5,
   "end": 628.2,
   "text": "بدن مثلاً مرکوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.2,
   "end": 631.04,
   "text": "یا بگیم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.04,
   "end": 635.64,
   "text": "حرف هست وقتی می‌خوان تو مراتب نفس بعضیا بفهمونن اشتباه می‌فهمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.64,
   "end": 640.18,
   "text": "می‌گن آقا مثلاً این بدن به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.18,
   "end": 643.62,
   "text": "یه ماشین فرض کن مثلاً الاغ نفسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.62,
   "end": 647.22,
   "text": "نفست-- این غلطه. اصلاً این دو تا از هم جدا نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 647.22,
   "end": 650.72,
   "text": "بدن و نفس یک حقیقتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 650.72,
   "end": 655.58,
   "text": "که مرتبه نازله این یک حقیقت می‌شه بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.58,
   "end": 659.12,
   "text": "مرتبه شامهه‌ش می‌شه روح و سرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.12,
   "end": 661.74,
   "text": "یک حقیقتن، جدای از هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.74,
   "end": 663.48,
   "text": "اصلاً نمی‌شه اینا از هم جدا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.48,
   "end": 666.04,
   "text": "لذا وقتی هم می‌میریم بدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 666.04,
   "end": 668.92,
   "text": "کی گفته بدن از بین می‌ره با بدن برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.92,
   "end": 672.7,
   "text": "اینکه می‌خوابوننش تو خاک، این تفاله بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.7,
   "end": 675.56,
   "text": "مربوط به نشئه طبیعت که بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.56,
   "end": 677.74,
   "text": "اینا کاملاً باید با هم منطبق باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 677.74,
   "end": 685.18,
   "text": "مسائل طبیعی یا نظام حالا طبیعیات فلسفه با الهیات فلسفه اینا با هم منطبق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 685.18,
   "end": 689.08,
   "text": "تو بازه خوابید-- خوردن هم مثال بزنم، خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 689.08,
   "end": 693.08,
   "text": "تا حالا دیدید حیوانی چیزی رو بخوره بو نکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.08,
   "end": 696.48,
   "text": "من ندیدم. هر وقت چیزی می‌ذاری جلوی یه حیوون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.48,
   "end": 700.14,
   "text": "قبل از اینکه سریع بپره بخورش یه بو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.14,
   "end": 702.9,
   "text": "این بو می‌کنه برای چیه؟ می‌خواد ببینه این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.9,
   "end": 707.9,
   "text": "سالمه، سالم نیست. فَلْيَنْظُرِ الْإِنْسَانُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 707.9,
   "end": 710.68,
   "text": "إِلَىٰ طَعَامِهِ. یه آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 710.68,
   "end": 714.68,
   "text": "امام باقر سلام الله علیه داره، امام با-- صادق سلام الله علیه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 714.68,
   "end": 718.14,
   "text": "که این یعنی اینکه این طعامتو نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 718.14,
   "end": 720.32,
   "text": "انسان اصلاً باید نگاه کنه به طعامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 720.32,
   "end": 723.08,
   "text": "به قول حالا حیوانی بگیم باید بو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 723.08,
   "end": 726.68,
   "text": "حالا اهل بیت فرمودن منظور از این آیه اون طعام علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 726.68,
   "end": 730.25,
   "text": "یعنی ببین علمتو از کجا اخذ می‌کنی، این معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 730.25,
   "end": 733.89,
   "text": "این حقایقی که داری کسب می‌کنی داره جانتو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 733.89,
   "end": 739.99,
   "text": "می‌دونید بعد از مرگ اعمال ما بدن ما رو شکل میدن، این بحثش گذشته قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 739.99,
   "end": 747.29,
   "text": "و افکار ما، اعتقادات ما، معارفی که، علومی که کسب می‌کنیم جان و نفس ما رو شکل میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 747.29,
   "end": 749.79,
   "text": "پس خیلی مهمه باید بو کرد. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.79,
   "end": 755.23,
   "text": "معرفتی که داری کسب می‌کنی، این علمی که داری اخذ می‌کنی از کجاست-- کدوم منبع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 755.23,
   "end": 758.69,
   "text": "کی گفته اینو؟ آیا منبع الهیه یا هرچی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.69,
   "end": 760.67,
   "text": "پس بو کردن یعنی ببینی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 760.67,
   "end": 765.69,
   "text": "در حقیقت غذایی که داری می‌خوری، چه غذای ظاهری، چه باطنی از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 765.69,
   "end": 768.43,
   "text": "چگونه است؟ آیا طیبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 768.43,
   "end": 771.19,
   "text": "دیگه حداقلش باید حلال باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 771.19,
   "end": 773.63,
   "text": "حالا طیب دیگه باشه طلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 773.63,
   "end": 778.21,
   "text": "ولی حلال که باید باشه که فرق بین حلال و طیب رو قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 778.21,
   "end": 781.53,
   "text": "دیگه حداقل شبهناک نباشه، حرام نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 781.53,
   "end": 785.07,
   "text": "یا مثلاً شما کدوم حیوانی رو دیدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 785.07,
   "end": 788.43,
   "text": "چیزی رو که در فصلش نیست بخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 788.43,
   "end": 791.01,
   "text": "الان فصلشه خب می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 791.01,
   "end": 796.01,
   "text": "م-- خیلی از ماها ب-- مثلاً حیوا-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 796.01,
   "end": 800.85,
   "text": "آبمیوه گیری‌ها هست دیدید میره اصلاً چیزی که الان فصلش نیست رو قر-- ورداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 800.85,
   "end": 803.83,
   "text": "منجمد کرده تو فریزر فریز کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.83,
   "end": 806.33,
   "text": "یا سبزیجات یا خیلی-- الان فصلش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 806.33,
   "end": 808.53,
   "text": "منجمد کرده الان میده می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 808.53,
   "end": 814.15,
   "text": "این مثلاً پدر هاضمت رو درمیاره، بیچاره‌ت می‌کنه، سوهاضمه می‌گیری فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.15,
   "end": 817.09,
   "text": "اینا باید منطبق باشه. هیچ حیوانی نمیاد چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 817.09,
   "end": 820.51,
   "text": "مثلاً میوه ا-- مار فصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 820.51,
   "end": 824.03,
   "text": "مثلاً زمستون رو الان تو تابستون بیاد بذار جلوش نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 824.03,
   "end": 825.91,
   "text": "بو می‌کنه نمی‌خوره. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 825.91,
   "end": 829.05,
   "text": "اینا باید انطباق بین ان-- آدم و عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 829.05,
   "end": 831.91,
   "text": "صورت-- بعد ما فریزر می‌کنیم اینا رو نگه می‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 831.91,
   "end": 835.93,
   "text": "اصلاً کدوم حیو-- شما شیر رو دیدید تو راز بقا چقدرم شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 835.93,
   "end": 837.81,
   "text": "چقدر این راز بقا رو من دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 837.81,
   "end": 842.43,
   "text": "نگاه می‌کنه این شی-شیره با تمام گرسنگی می‌پره رو این آهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 842.43,
   "end": 845.99,
   "text": "بیچاره شروع می‌کنه خوردن. هر مقدار خورد سیر شد تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 845.99,
   "end": 847.97,
   "text": "اصلاً میره اینو فریزش کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 847.97,
   "end": 851.95,
   "text": "میره یه جا جمعش کنه، نگهش داره، خاکش کنه بعداً بره سراغش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 851.95,
   "end": 854.31,
   "text": "نه. ولش می‌کنه. ولی ما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 854.31,
   "end": 857.77,
   "text": "همش جمع می‌کنیم، نگهداری می‌کنیم برای روز مبادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 857.77,
   "end": 862.03,
   "text": "حالا این روز مبادا کی می‌خوای-- اینا تمام آثارش رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 862.03,
   "end": 864.79,
   "text": "در فعل و انفعال، اینا همه بحث‌های علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 864.79,
   "end": 866.67,
   "text": "که بزرگان و حکما اینا رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 866.67,
   "end": 874.15,
   "text": "در فعل و انفعالات شبانه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 874.15,
   "end": 876.81,
   "text": "اینا در مد و جزر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 876.81,
   "end": 879.35,
   "text": "تمام آثار اینا خیلیاش از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 879.35,
   "end": 887.03,
   "text": "یعنی یه مد بخوره بهش یا برعکس یه جزر بخوره به این مواد غذایی یک‌دفعه پنجاه درصد اثرش رو از دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 887.03,
   "end": 889.01,
   "text": "بعد ما نگه می‌داریم، استفاده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 889.01,
   "end": 893.21,
   "text": "در حقیقت عزیزان اگر اینطوری باشه باید-- داریم چیکار می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 893.21,
   "end": 895.73,
   "text": "داریم تفاله می‌خوریم، اون چیزی که می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 895.73,
   "end": 899.03,
   "text": "حالا فست فود که دیگه بماند، اصلاً وحشتناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 899.03,
   "end": 901.31,
   "text": "اصلاً بیچاره کرده ما رو فست فود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 901.31,
   "end": 903.41,
   "text": "پس اینو اومدیم بیشتر از این وقتتون نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 903.41,
   "end": 908.69,
   "text": "وقت گذشت مطالب دیگه‌ای موند که بماند خودتون رجوع کنید به آثار حکما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 908.69,
   "end": 910.77,
   "text": "از مهم‌ترین اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 910.77,
   "end": 922.49,
   "text": "برای اینکه مزاج ما معتدل باشد و در پس مزاج معتدل ما به شک، شک و ریب نیفتیم یعنی به حالت یقین برسیم که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 922.49,
   "end": 925.55,
   "text": "مزاج معتدل است که به یقین می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 925.55,
   "end": 930.97,
   "text": "هیچ چاره‌ای جز انطباق بین آدم و عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 930.97,
   "end": 932.97,
   "text": "انشاالله که عاقبتmu ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 932.97,
   "end": 936.07,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 936.07,
   "end": 941.55,
   "text": "الله- اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}