 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ نجاست در خانه و حداقلِ طهارت",
   "start": 0.72,
   "end": 190.38
  },
  {
   "index": 1,
   "title": "دلیلِ اول آنکه شیطان به خدا وعده داده است:",
   "start": 190.38,
   "end": 229.08
  },
  {
   "index": 2,
   "title": "## دلیلِ دوم؛ پس زدنِ مقدسات و امانت",
   "start": 229.08,
   "end": 279.94
  },
  {
   "index": 3,
   "title": "و نیز:",
   "start": 279.94,
   "end": 300.14
  },
  {
   "index": 4,
   "title": "## تشبیهِ فقهیِ ارتداد و پس دادنِ نظامِ اقدس",
   "start": 300.14,
   "end": 618.21
  },
  {
   "index": 5,
   "title": "## ابن‌عربی؛ مراقبه مقام است نه حال",
   "start": 618.21,
   "end": 759.44
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 4.08,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 6.74,
   "text": "بعضیا هستن که رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.74,
   "end": 9.6,
   "text": "حدود الهی رو نمی‌کنن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.6,
   "end": 15.56,
   "text": "باعث می‌شن که منزل و اثاثیه‌ش نجس بشه و بالاخره رعایت نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 18.48,
   "text": "نجس و پاکی رو اصلا قبول ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.48,
   "end": 23.06,
   "text": "و از قضا many در خانواده‌های مذهبی هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.06,
   "end": 28.0,
   "text": "دیده می‌شه بعضا. سؤال اینجاست که اگر کسی رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.0,
   "end": 32.4,
   "text": "حدود رو نمی‌کنه، نجس، پاکی رو رعایت نمی‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.4,
   "end": 39.16,
   "text": "اون خونواده بیچاره‌ای که می‌خوان تو اون خونه نماز بخونن، برای سید الشهدا مجلس بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.16,
   "end": 44.02,
   "text": "این بالاخره چی می‌شه؟ استفتاء کردن از آقا همین موضوع رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.02,
   "end": 47.18,
   "text": "که اگر یه نفر از اعضای خونواده رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.18,
   "end": 52.94,
   "text": "حدود الهی نکرد، نجس، پاکی رو رعایت نکرد، اثاث منزل رو نجس کرد، اینا چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.94,
   "end": 57.32,
   "text": "آقا فرمودن که طهارت کل اشیاء منزل نیازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.32,
   "end": 61.34,
   "text": "اونچه که خیلی مهمه و ضروری و نیازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.34,
   "end": 66.34,
   "text": "یک لباس نمازگزاره، دو محل سجده نمازگزاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.34,
   "end": 69.56,
   "text": "سه خوردن و آشامیدن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.56,
   "end": 76.0,
   "text": "اون ظرف‌هایی که مثلا توش می‌خواد چیزی بخوره اینا پاک باشه، لباسش پاک باشه، محل سجده هم پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.0,
   "end": 78.46,
   "text": "دیگه بقیه حالا اگرم نجس هست مشکلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.46,
   "end": 80.86,
   "text": "حالا این بحث فقهی قضیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.86,
   "end": 82.5,
   "text": "اما از-- حالا بحث شرعی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.5,
   "end": 86.36,
   "text": "اما بحث عرفانی و حکمیشو بخوای بکنی چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.36,
   "end": 90.28,
   "text": "مثلا هر کجا که نجسی، نجاستی، چیزی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.28,
   "end": 93.68,
   "text": "به هر حال محل حضور شیاطین جنی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.68,
   "end": 96.26,
   "text": "و ملائکه اونجا نازل نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.26,
   "end": 99.72,
   "text": "این خیلی تو بحث عرفان خیلی بحث دقیقی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.72,
   "end": 101.38,
   "text": "اونجا دیگه قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.38,
   "end": 105.24,
   "text": "اونجا باید فکر‌هایی کرد، بعضی کارهایی باید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.24,
   "end": 110.12,
   "text": "یکی از دلایلی که می‌گن حتی سگ رو در منزل نگه ندارید همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.12,
   "end": 113.98,
   "text": "حدیث داریم جایی که سگ باشه ملائکه نازل نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.98,
   "end": 116.26,
   "text": "حالا ببینید چقدر الان تو خونواده‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.26,
   "end": 122.1,
   "text": "آپارتمان‌ها حتی مثلا متاسفانه هست و می‌بینید طرف هرچی داد می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.1,
   "end": 124.38,
   "text": "در خونه خدا بالا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.38,
   "end": 127.3,
   "text": "خب واسطه‌ی فیض نیست، ملائکه نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.3,
   "end": 129.08,
   "text": "این‌ها به هر حال باید لحاظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.08,
   "end": 131.28,
   "text": "اما نکته‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.28,
   "end": 138.98,
   "text": "عرض می‌کنم امروز که حدیث نفس برای خود بیچاره‌م می‌خونم و به شما عزیزان که تو لباس مشکی ابا عبدالله هستید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.98,
   "end": 144.58,
   "text": "بالاخره ده شب، بیش از ده شب، سیزده چهارده شب توفیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.58,
   "end": 151.42,
   "text": "عزاداری برای ابا عبدالله رو داشتید به در- به نظرم به درد می‌خوره اونم اینجاست که دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.42,
   "end": 159.0,
   "text": "چرا ما معمولا قلبمون دچار شک و ریب می‌شه و گرفتار تزلزل می‌شه خصوصا بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.0,
   "end": 162.54,
   "text": "مجالس. یعنی وقتی توی مجالسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.54,
   "end": 165.64,
   "text": "به تعبیر بزرگان مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.64,
   "end": 171.28,
   "text": "حالا شما الک چه عرض کنم سبدی رو فرض کنید که تو آبه، پر آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.28,
   "end": 176.72,
   "text": "به محض اینکه میاد از جلسه بیرون مثل سبدی که از آب کشیدن بیرون خالی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.72,
   "end": 179.12,
   "text": "چرا خالی می‌شه؟ چرا دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.12,
   "end": 181.74,
   "text": "گرفتاری‌های بعد از این دهه می‌شیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.74,
   "end": 184.0,
   "text": "دو تا دلیل عمده وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.0,
   "end": 186.32,
   "text": "دلیل اول اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.32,
   "end": 190.28,
   "text": "خود خ-- شیطان به خدا وعده داده در قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.28,
   "end": 193.72,
   "text": "که \"لأَقْعُدَنَّ لَهُمْ عَلَىٰ صِرَاطِكَ الْمُسْتَقِيمِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.72,
   "end": 196.8,
   "text": "وعده‌ی صریح شیطان و دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.8,
   "end": 200.8,
   "text": "خونین من و شماست. که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.8,
   "end": 204.56,
   "text": "قطعا \"لأَقْعُدَنَّ\" یعنی این لام تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.56,
   "end": 206.8,
   "text": "قطعا من به اینا کمین می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.8,
   "end": 210.1,
   "text": "کی؟ وقتی تو مسیر تو هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.1,
   "end": 214.48,
   "text": "وقتی تو مسیر تو نیستن، تو صراط مستقیم نیستن کاری باهاشون ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.48,
   "end": 219.28,
   "text": "ما گمان می‌کنیم تو حسینیه‌ها، تو هیئت‌ها، تو مساجد، تو حرم‌ها حتی شیطان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.28,
   "end": 224.94,
   "text": "چرا اتفاقا میان؟ به صریح آیه قرآن هرچی ما حسینی‌تر می‌شیم شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.94,
   "end": 227.46,
   "text": "اعوان و انصارشو بیشتر بر علیه ما غسیل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.46,
   "end": 230.36,
   "text": "این دلیل اول. دلیل دوم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.36,
   "end": 236.92,
   "text": "ما این دومی‌شو خوب دقت کنید و اولی‌شو می‌دونید ولی دومی‌شو متاسفانه غالبا توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.92,
   "end": 239.3,
   "text": "پس زدن مقدساته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.3,
   "end": 244.08,
   "text": "شما بفرما ببینم اگر یه چیز خوب و مقدسی رو، ذی قیمتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.08,
   "end": 248.68,
   "text": "بدی به یه کسی که رعایت نکنه بزنه داغونش کنه بار دومم میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.68,
   "end": 251.14,
   "text": "بار سومم میدی؟ هی بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.14,
   "end": 255.74,
   "text": "از بینش ببره آسیب برسونه به اون چیز خ-- ذی قیمت بازم بهش میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.74,
   "end": 257.42,
   "text": "در حالی که قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.42,
   "end": 261.04,
   "text": "\"إِنَّ اللّهَ يَأْمُرُكُمْ أَن تُؤَدُّواْ الأَمَانَاتِ إِلَىٰ أَهْلِهَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.04,
   "end": 264.7,
   "text": "خدا دستور داده که امانت رو به اهلش بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.7,
   "end": 268.08,
   "text": "یا اونجا که در قرآن فرمود \"إِنَّا عَرَفْنَا الأَمَانَةَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.08,
   "end": 271.02,
   "text": "عَلَى السَّمَاوَاتِ وَالأَرْضِ وَالْجِبَالِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.02,
   "end": 275.0,
   "text": "فَأَبَيْنَ أَن يَحْمِلْنَهَا وَشَقَّنَا مِنْهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.0,
   "end": 279.94,
   "text": "حَمَلَهَا الإِنسَانُ\". این امانتی که اینجا فرموده انسان بارشو برداشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.94,
   "end": 282.82,
   "text": "امام صادق علیه السلام فرموده ولایت ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.82,
   "end": 289.42,
   "text": "که سر سفره‌ی همین جلسات و تکیا، هیئت‌ها، مساجد، همین عزاداری‌ها دارن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.42,
   "end": 291.32,
   "text": "امانت رو براش-- من و شما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.32,
   "end": 295.9,
   "text": "تو زیارت جامعه کبیره هم به اون‌ها عرض می‌کنیم \"وَالأَمَانَةُ الْمَحْفُوظَةُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.9,
   "end": 298.78,
   "text": "شما امانت محفوظه حضرت حق هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.78,
   "end": 303.28,
   "text": "محفوظه‌اید. اگر کسی خیانت به شما بکنه خدا می‌گیرتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.28,
   "end": 310.18,
   "text": "اون امانت رو می‌گیره. چرا ما معمولا بعد از این دهه‌ها گرفتار فراز و نشیب‌های روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.18,
   "end": 313.76,
   "text": "حتی خانوادگی و فکری و حتی عقیدتی و اخلاقی می‌شیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.76,
   "end": 316.62,
   "text": "چون مقدسات رو پس می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.62,
   "end": 322.92,
   "text": "یعنی چی حاج آقا این مقدسات و ما که در عین و در متن مقدسات هستیم، در لباس مشکی آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.92,
   "end": 330.78,
   "text": "به جهت اینکه اون عق-- در حقیقت فیض اقدس نظام هستی رو، اون امانت اصلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.78,
   "end": 333.84,
   "text": "که در این نظام هستی بالاتر از اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.84,
   "end": 338.12,
   "text": "حب و محبت ابا عبدالله که \"من أراد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.12,
   "end": 347.32,
   "text": "من أراد الله به خيرا\" هرکیو خدا اراده‌ی خیر در بارش کرده \"قذف في قلبه محبة الحسن\" یا \"حب الحسن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.32,
   "end": 352.88,
   "text": "هرکیو خدا اراده‌ی خیر براش کرده تو قلبش محبت امام حسین رو می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.88,
   "end": 355.38,
   "text": "یعنی مقدس‌ترین چیز عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.38,
   "end": 359.62,
   "text": "از نظام اقدس هم تنزل پیدا کرده اومده تو دل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.62,
   "end": 362.64,
   "text": "ما مقدس‌ترین چیز عالم رو پس می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.64,
   "end": 365.21,
   "text": "یعنی چی؟ چگونه؟ با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.21,
   "end": 368.01,
   "text": "ادامه همون کارهایی که قبل از دهه داشتیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.01,
   "end": 370.39,
   "text": "یعنی محاسبه نفس ندارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.39,
   "end": 374.27,
   "text": "مراقبه ندارم. دوباره همون آش و همون کاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.27,
   "end": 377.53,
   "text": "چشم کار خودشو می‌کنه، گوش کار خودشو می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.53,
   "end": 380.11,
   "text": "قلب به سمت سوء زن‌ها میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.11,
   "end": 386.79,
   "text": "فکر تخیلات و به قول حضرت علامه متخیلات فاسده داره که چندین بار درباره‌ش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.79,
   "end": 391.57,
   "text": "یعنی برنامه مدونی به سوی خیمه سو-- سید و شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.57,
   "end": 395.43,
   "text": "بعد از دهه ما نداریم. دو مرتبه پس می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.43,
   "end": 398.93,
   "text": "چرا میگه حالا کسی که کافره از اول کافر بوده هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.93,
   "end": 402.27,
   "text": "مسلمون شد خیلی خوش اومدید، قدم رو چشم گذاشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.27,
   "end": 406.33,
   "text": "هرچی هم تا حالا شما نماز و روزه، قضا داشتی اصلاً حساب نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.33,
   "end": 409.67,
   "text": "از نو شروع کن. اصلاً اونا قضا نداره از نو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.67,
   "end": 412.19,
   "text": "اما کسی مسلمان بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.19,
   "end": 414.85,
   "text": "بعد به سمت کفر و نفاق رفت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.85,
   "end": 417.67,
   "text": "مرتد. یعنی باید قتلش واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.67,
   "end": 419.51,
   "text": "حاکم شهر می‌تونه حکم قتلش رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.51,
   "end": 423.95,
   "text": "چرا؟ شما بفرمایید از جهت فقهی چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.95,
   "end": 428.29,
   "text": "زیربنای مباحث فق-فقهی، مباحث عرفانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.29,
   "end": 432.61,
   "text": "عقلی و برهانی هم هست دیگه. چون نظام اقدس رو پس داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.61,
   "end": 435.75,
   "text": "پس داده. یکی از دلایل مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.75,
   "end": 438.27,
   "text": "این که ما بعد از این دهه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.27,
   "end": 441.81,
   "text": "رکود عجیبی داریم، نوسان عجیبی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.81,
   "end": 445.69,
   "text": "به شدت رکود می‌کنیم. یعنی دوباره نماز قضا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.69,
   "end": 448.13,
   "text": "دوباره افتادیم به همون گناه‌های قبلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.13,
   "end": 451.25,
   "text": "اینه که محاسبه و مراقبه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.25,
   "end": 458.73,
   "text": "آیه یک سوره نساء می‌فرمود \"ان الله کان عليكم رقيبا\" قطعاً خدا مراقب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.73,
   "end": 463.11,
   "text": "رقیبه. اصلاً فلسفه اون فرشته رقیب و عطید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.11,
   "end": 467.79,
   "text": "اینه که مراقبت کنه از ما که دوباره پس نزنیم مقدسات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.79,
   "end": 469.65,
   "text": "این نکته خیلی نکته مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.65,
   "end": 474.59,
   "text": "وقتی پس زدی بعد یعنی در حقیقت بی‌تحارتی کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.59,
   "end": 481.21,
   "text": "چون در نظام اقدس عالم بی‌تحارتی نیست، تمام عالم دست به دست هم میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.21,
   "end": 484.09,
   "text": "که این بی‌تحارتی تو رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.09,
   "end": 490.21,
   "text": "در دنیا با مصائب و مشکلات و بلاها خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.21,
   "end": 492.11,
   "text": "این فشار، این ضیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.11,
   "end": 495.05,
   "text": "که این ت-- بی‌تحارتی من و شما رو از ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.05,
   "end": 501.79,
   "text": "از بین ببرن. اگر تو این دنیا نبود رفت به برزخ کشیده شد، اونجا هم به همون عذاب برزخی بدل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.79,
   "end": 506.97,
   "text": "چی؟ اون فشارها و سختی‌ها که اون بی‌تحارتی ما رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.97,
   "end": 509.65,
   "text": "اون پس دادن امانت الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.65,
   "end": 516.95,
   "text": "برطرف کنن. لذا تمام حکمای عرفا، بزرگان، علما، شما هرچی بری کتابای اینا رو بخونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.95,
   "end": 519.31,
   "text": "فلق و سائل سید ابن طاووس رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.31,
   "end": 523.69,
   "text": "العراقات آقا مجتبی ملکی تبریزی رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.69,
   "end": 528.41,
   "text": "عرض شود هر کدوم از این کتاب‌ها رو می‌خونی، ابن فهد حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.41,
   "end": 530.35,
   "text": "کتابی داره به نام عُدت الدّاعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.35,
   "end": 534.67,
   "text": "عجیب کتاب عرشیه. نامه‌ها، برنامه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.67,
   "end": 539.67,
   "text": "حضرت علامه حسن زاده که نامه‌ها و برنامه‌ها بعضیا می‌خونن اشتباه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 539.67,
   "end": 545.01,
   "text": "نامه‌ها، برنامه‌ها. یعنی نامه‌هایی که علامه به نامه‌ها داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.01,
   "end": 548.91,
   "text": "جواب به نامه‌هاست. نامه‌ها، برنامه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.91,
   "end": 551.51,
   "text": "خیلی کتاب-- میان میگن حاج آقا یه دستورالعمل، یه چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.51,
   "end": 554.11,
   "text": "میگم من کیم که بخوام دستورالعمل بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.11,
   "end": 556.99,
   "text": "بسم الله، کتاب نامه‌ها و برنامه‌های علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.99,
   "end": 559.73,
   "text": "شما هرچی این کتاب‌ها رو می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.73,
   "end": 562.37,
   "text": "بدون استثناء توصیه کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.37,
   "end": 567.39,
   "text": "محاسبه، محاسبه‌ای که تو رو بکشونه به وادی مراقبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.39,
   "end": 571.13,
   "text": "هیچ چاره دیگه‌ای نداریم. به خدا هیچ، هیچ چاره‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.13,
   "end": 573.45,
   "text": "یعنی اگر کسی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.45,
   "end": 577.27,
   "text": "کار رو نداشته باشه قطعاً امام حسین رو از دست میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 577.27,
   "end": 579.99,
   "text": "و این همه روضه خونده بعد از دهه می‌بینه عه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.99,
   "end": 582.49,
   "text": "شمر وجودش نشست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.49,
   "end": 588.87,
   "text": "سینه حسین وجودش، تو وجودش داره قصله‌گاه ایجاد می‌شه و حسین ابن علی تو وجودش داره ذبح می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.87,
   "end": 592.73,
   "text": "این یا اون روضه خونده، گریه کرده، الان ذبح شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.73,
   "end": 595.29,
   "text": "حضرت زینب تو وجودش به اسارت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.29,
   "end": 598.27,
   "text": "بعد از دهه دوباره چادرها میره کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.27,
   "end": 602.99,
   "text": "اون کارها دوباره نگاه به نامحرم، دروغ، فحاشی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.99,
   "end": 605.03,
   "text": "تو خیمه نیستا این حرف ولی بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.03,
   "end": 607.41,
   "text": "چرا؟ نظام اقدس رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.41,
   "end": 610.53,
   "text": "یه جمله‌ای رو هم از ابن عربی براتون بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.53,
   "end": 612.99,
   "text": "که بحث رو تکمیل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.99,
   "end": 615.89,
   "text": "و ش-- در حقیقت برکت بحثمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 615.89,
   "end": 618.21,
   "text": "این عین عبارت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.21,
   "end": 622.77,
   "text": "شیخ اکبر ابن عربی علیه الرحمه در فتوحاتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 622.77,
   "end": 628.11,
   "text": "یه جمله‌ست. می‌فرماید مراقبه از بهترین مقامات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.11,
   "end": 633.39,
   "text": "مقام، مقام یعنی قیام کرده، حال نیست که از بین ببرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.39,
   "end": 639.31,
   "text": "مقامه. می‌مونه. از بهترین مقامات دقیق‌ترین آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.31,
   "end": 642.53,
   "text": "خیلی دقیقه، خیلی دقت می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 642.53,
   "end": 646.69,
   "text": "و خیلی جالبه می‌فرماید و غنی‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.69,
   "end": 648.75,
   "text": "آن به فتوحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.75,
   "end": 654.03,
   "text": "و اسرار است. اگر کسی می‌خواد فتح و گشایش براش ایجاد بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 654.03,
   "end": 656.03,
   "text": "چنان به چ-- قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.03,
   "end": 660.47,
   "text": "یکپارچه حقایق عالم رو درک کنه، شک چیه، ریب چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.47,
   "end": 665.11,
   "text": "یکپارچه برسه به اسم یقین حضرت حق که از اسامی حقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 665.11,
   "end": 668.81,
   "text": "برسه به اونجا و به قول علامه به برdl یقین برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 668.81,
   "end": 671.87,
   "text": "و اسرار رو کشف کنه، راهش مراقبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 671.87,
   "end": 680.05,
   "text": "هیچ راه دیگه‌ای ندارد که خدا در قرآن در آیه سی و هفت انفال می‌فرماید \"لیمیز الله الخبیث من الطيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.05,
   "end": 683.63,
   "text": "اگه دوباره بری به سمت خبیثات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.63,
   "end": 685.91,
   "text": "چیزهای زشت، خبائث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.91,
   "end": 690.47,
   "text": "\"لیمیز الله الخبیث من الطيب\" خدا دست به کار می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.47,
   "end": 694.15,
   "text": "که خباثت رو از طیبات جدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.15,
   "end": 697.37,
   "text": "بعد می‌شه مشکلات، گرفتاری‌ها، بلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.37,
   "end": 701.23,
   "text": "یکی از اون مشکلات ریبه. دچار شک و تردید می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.23,
   "end": 704.89,
   "text": "بعد خدا نکنه گرفتار فضای مجازی و این‌ها هم بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.89,
   "end": 707.17,
   "text": "بعد خدایی نکرده زبون املال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.17,
   "end": 711.07,
   "text": "بعد مشکوک بشی اصلاً به جریان سید و شهدا، به روضه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 711.07,
   "end": 731.07,
   "text": "بابا مگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 757.97,
   "end": 759.29,
   "text": "اصلاً خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.29,
   "end": 759.44,
   "text": "رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}