   "start": 0.3,
   "end": 136.88
  },
  {
   "index": 1,
   "title": "## طهارتِ فقهی و مراقبت در ریبِ اعتقادی",
   "start": 136.88,
   "end": 181.72
  },
  {
   "index": 2,
   "title": "## دو آیه در سورهٔ توبه؛ حصرِ عذر جهاد",
   "start": 181.72,
   "end": 281.3
  },
  {
   "index": 3,
   "title": "## اسلامِ زبانی و ایمانِ قلبی",
   "start": 281.3,
   "end": 355.42
  },
  {
   "index": 4,
   "title": "## علامتِ تراشیدن سر در یاریِ علی علیه‌السلام",
   "start": 355.42,
   "end": 497.98
  },
  {
   "index": 5,
