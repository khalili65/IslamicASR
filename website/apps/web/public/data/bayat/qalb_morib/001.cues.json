   "start": 497.98,
   "end": 662.8
  },
  {
   "index": 6,
   "title": "## گرداب خیال و مثل‌های قرآن",
   "start": 662.8,
   "end": 684.32
  },
  {
   "index": 7,
   "title": "## فذکر و ولیتلطف؛ کلید بحث قلب مردد",
   "start": 684.32,
   "end": 816.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 5.8,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.8,
   "end": 10.64,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.64,
   "end": 13.72,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.72,
   "end": 20.22,
   "text": "گاهی آقا لباسی که ما مثلاً نجس شده و میندازیم توی تشتی، ظرف آبی، چیزی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.22,
   "end": 24.7,
   "text": "و می‌گیریم زیر آب لوله‌کشی و کر و اینا بعد یه سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.7,
   "end": 26.9,
   "text": "اجزا، پرز مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.9,
   "end": 29.96,
   "text": "غبار اینا از این لباس جدا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.96,
   "end": 33.4,
   "text": "داخل خود آب قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.4,
   "end": 36.68,
   "text": "اون نخ ریزه‌ها، پرزها اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.68,
   "end": 44.12,
   "text": "بعد میگن که تو استفتا اینطوری اومده که ما احتیاطاً خب این بعد آب که سرریز می‌کنه این پرزها و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.12,
   "end": 46.58,
   "text": "مثلاً نخ ریزه‌ها اینا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.58,
   "end": 52.48,
   "text": "از لباس نجس جدا شدن میریزه زمین، ما اون زمین رو دوباره تطهیر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.48,
   "end": 57.36,
   "text": "چون اون پرزها و اینها بالاخره از لباس نجس جدا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.36,
   "end": 61.48,
   "text": "و میریزه زمین و تو آبه و رطوبت هم انتقال پیدا می‌کنه، این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.48,
   "end": 65.84,
   "text": "رهبری آقا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.84,
   "end": 69.12,
   "text": "همین که چه ظرف، دقت کنید چه ظرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.12,
   "end": 72.96,
   "text": "چه لباس، اینها توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.96,
   "end": 76.28,
   "text": "محل حالا تشتی هرچی قرار بگیرن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.28,
   "end": 80.14,
   "text": "در تصرف آب لوله‌کشی و آب کر قرار بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.14,
   "end": 84.38,
   "text": "همین این باعث می‌شه همین که توی آب کر قرار گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.38,
   "end": 89.68,
   "text": "دیگه هرچی هم اون‌ها نجس باشن دیگه پاکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.68,
   "end": 93.9,
   "text": "حتی اون پرزها. بعد آقا می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.9,
   "end": 101.36,
   "text": "ضمن اینکه در صورتی شما می‌تونید بگید اون پرزهایی که از لباس جدا شدن نجسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.36,
   "end": 104.26,
   "text": "که یقین داشته باشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.26,
   "end": 108.88,
   "text": "این پرزها از محل نجس شده جدا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.88,
   "end": 113.04,
   "text": "و وقتی نجس-- وقتی یقین نداری محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.04,
   "end": 118.4,
   "text": "خودتو اذیت نکن و آقا اینجا فرمودن نیاز به احتیاط هم حتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.4,
   "end": 122.06,
   "text": "چون شما شک داری آقا این پرزهایی که الان تو این آبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.06,
   "end": 126.94,
   "text": "از کدوم قسمت این حالا فرض کنیم آب قلیله، کر هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.94,
   "end": 131.52,
   "text": "از کدوم بخش این لباس جدا شده از بخش نجسش یا پاکش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.52,
   "end": 134.8,
   "text": "همین که شک داری تمام دیگه محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.8,
   "end": 136.7,
   "text": "اینقدر خودمون اذیت نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.7,
   "end": 147.76,
   "text": "ما باید در خصوص شک و شبهه و تردید نسبت به آیات الهی، نسبت به اعتقادات و حقایق نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.76,
   "end": 152.24,
   "text": "خیلی مراقبت کنیم. حالا در طهارت دیگه حکمه دیگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.24,
   "end": 156.6,
   "text": "وقتی شک داری چیزی پاکه یا نجسه محکومه به طهارته تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.6,
   "end": 163.1,
   "text": "مگر اینکه یقین کنیم. اتفاقاً قلب جدیدی که به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.1,
   "end": 166.66,
   "text": "ما می‌خوایم درباره‌ش سخن بگیم و از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.66,
   "end": 169.94,
   "text": "آیه‌ش رو پیدا کردیم، قلب مشکوک یا مُـ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.94,
   "end": 173.38,
   "text": "مردده، قلب مردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.38,
   "end": 178.2,
   "text": "قلبی که دائماً دچار شک و ریب و تردید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.2,
   "end": 180.56,
   "text": "هی رفت و آمد در باورهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.56,
   "end": 187.34,
   "text": "این حالا دو تا آیه در قرآن هست، یکی آیه صد و ده سوره توبه است، هر دو هم در سوره توبه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.34,
   "end": 189.6,
   "text": "یکی هم آیه چهل و پنج سوره توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.6,
   "end": 192.42,
   "text": "ما آیه چهل و پنج رو دقت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.42,
   "end": 197.88,
   "text": "\"انما یستعذنوک الذین لا يؤمنون بالله والیوم الاخر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.88,
   "end": 201.86,
   "text": "پیغمبر فقط انما حصر دیگه فقط و فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.86,
   "end": 207.4,
   "text": "کسانی تا از تو عذر می‌طلبند که شرکت نکنند در جهاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.4,
   "end": 211.14,
   "text": "که \"لا يؤمنون بالله والیوم الاخر\" اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.14,
   "end": 216.5,
   "text": "دل ندادن. لا يؤمنون یعنی دلشونو ندادن، باور ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.5,
   "end": 222.04,
   "text": "و شک و تردیدن. اینا به یقین نرسیدن نسبت به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.04,
   "end": 224.04,
   "text": "الله و آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.04,
   "end": 230.1,
   "text": "به این‌ها یقین ندارن. \"ورتابت قلوبهم\" اینجا مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.1,
   "end": 234.06,
   "text": "\"ورتابت قلوبهم\" از همین جهت که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.06,
   "end": 236.84,
   "text": "ایمان ندارن به خدا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.84,
   "end": 241.28,
   "text": "روز جزا، از همین جهت \"ورتابت قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.28,
   "end": 245.98,
   "text": "یعنی اینکه دل‌هاشون توی شک، شک و ریبی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.98,
   "end": 250.44,
   "text": "ورتابه از تردید میاد، رد شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.44,
   "end": 252.08,
   "text": "رفت و برگشت، تردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.08,
   "end": 255.92,
   "text": "\"فهم فی ربهم یتر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.92,
   "end": 258.34,
   "text": "في ریبهم یترددون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.34,
   "end": 262.38,
   "text": "عجب! این دیگه نکته آخرش عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.38,
   "end": 264.6,
   "text": "آیه آخ-- آخر آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.6,
   "end": 268.68,
   "text": "پس این‌ها توی اون شکشون \"یترددون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.68,
   "end": 272.48,
   "text": "فعل مضارع دائماً توی شک می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.48,
   "end": 276.24,
   "text": "بیرون نمیان. چرا؟ به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.24,
   "end": 278.5,
   "text": "ایمان نیاوردن، دل ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.5,
   "end": 281.3,
   "text": "بحث دل دادن قصه‌اش خیلی...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.3,
   "end": 288.64,
   "text": "اصلاً بحث ایمان باید دو مرتبه مورد بازنگری قرار بگیره تو جمعیت ما اهل ایمان باور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.64,
   "end": 294.24,
   "text": "ما فکر می‌کنیم ایمان مثلاً مؤمن به کسی میگن که بگه لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.24,
   "end": 296.38,
   "text": "محمد الرسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.38,
   "end": 298.82,
   "text": "علی ولی الله صلی الله علیه و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.82,
   "end": 301.86,
   "text": "این مثلاً دیگه نه این تازه اگر وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.86,
   "end": 310.68,
   "text": "اقرار کردی بر زبانت جاری شد، دیگه جان و مال و اینا همه چیت محفوظه و در امانه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.68,
   "end": 312.78,
   "text": "دیگه مسلمان حساب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.78,
   "end": 316.04,
   "text": "اومدی تشکیل-- خودتو تشکیل کنی ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.04,
   "end": 318.56,
   "text": "ایمان دیگه مرتبه باطنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.56,
   "end": 321.04,
   "text": "ایمان، \"یؤمنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.04,
   "end": 323.86,
   "text": "ایمان بحث دله، بحث قلبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.86,
   "end": 326.68,
   "text": "دل دادنه. می‌شه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.68,
   "end": 329.86,
   "text": "سالیان سال نماز بخونه سر به سجده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.86,
   "end": 332.34,
   "text": "طولانی نمازهای آنچنانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.34,
   "end": 335.6,
   "text": "جهاد در راه خدا هم حتی بره ها اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.6,
   "end": 337.22,
   "text": "هنوز ایمان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.22,
   "end": 340.24,
   "text": "یعنی دل نداده برای منافع شخصیش می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.24,
   "end": 343.78,
   "text": "بسیاری از آدما هستن که در لباس دین هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.78,
   "end": 346.3,
   "text": "شاید منم جزو اونام و بی‌خبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.3,
   "end": 349.98,
   "text": "که اگر منافع دنیوی دین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.98,
   "end": 353.74,
   "text": "حذف کنی از لباس دین خارج می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.74,
   "end": 357.8,
   "text": "چرا؟ شما توجه کردید چرا امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.8,
   "end": 360.64,
   "text": "وقتی با حضرت زهرا سلام الله علیها رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.64,
   "end": 364.82,
   "text": "در خونه اون ااا حالا انصار و صحابی و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.82,
   "end": 368.38,
   "text": "چند شب رفتن در خونه بعضی روایات میگه تا چهل شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.38,
   "end": 374.28,
   "text": "بعد حضرت می‌فرمودند که فردا سر تراشیده بیایید مسجد صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.28,
   "end": 378.06,
   "text": "صبح هل التلو سر تراشیده این خودش یه نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.06,
   "end": 380.3,
   "text": "چرا سر تراشیده باید می‌اومدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.3,
   "end": 383.4,
   "text": "چه ربطی داشت؟ من همیشه به این فکر می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.4,
   "end": 386.74,
   "text": "خیلی بهش فکر می‌کردم از وقتی که عمو-- بچه بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.74,
   "end": 392.44,
   "text": "این روایت رو شنیدم. چرا حضرت زهرا تأکید داشت فردا سرتون رو بتراشید بیایید مسجد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.44,
   "end": 394.36,
   "text": "یعنی یه نشونه، یه نماد داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.36,
   "end": 398.08,
   "text": "اگر مردید، اگر دل دادید به علی علیه الصلاة والسلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.08,
   "end": 404.34,
   "text": "دم می‌زنید که شما می‌خواید بیایید طرفدار علی علیه الصلاة والسلام هستید نشونه بذارید، سرتون رو بتراشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.34,
   "end": 407.1,
   "text": "که اگر حالا خواب موندید نیامدید، مریض شدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.1,
   "end": 414.08,
   "text": "هر دلیلی یا دیرتر اومدید یا اصلاً اومدید و باز برگشتید دوباره تو اجتماع اون نشونه رو توتون باقی بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.08,
   "end": 418.28,
   "text": "ببینم جیگرتون رو دارید، جیگر دارید که اون نشانه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.28,
   "end": 421.28,
   "text": "ایمان، نشانه‌ی ولایت رو شما‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.28,
   "end": 424.62,
   "text": "خیلی از ماها می‌بینیم که حتی شاید تو دلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.62,
   "end": 429.76,
   "text": "خب جسارت نمی‌کنیم، دوست داریم اهل بیت رو، دوست داریم ایمان رو، دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.76,
   "end": 433.38,
   "text": "یه دلبستگی‌هایی وجود داره اینطوری نیست که نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.38,
   "end": 436.08,
   "text": "اما چرا جرأت و جسارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.08,
   "end": 439.86,
   "text": "ظهورش رو نداریم؟ چرا در جمعیتی که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.86,
   "end": 447.38,
   "text": "مثلا خدایی نکرده بدحجاب یا بی‌حجاب‌اند یه زن خجالت بکشه چادرش رو حفظ کنه با حجاب خوب شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.38,
   "end": 453.1,
   "text": "یا یه جایی که هیچکس نماز نمی‌خونه کسی خجالت بکشه پاشه نماز بخونه یا در محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.1,
   "end": 457.76,
   "text": "تردد رفت و آمد مردم خجالت می‌کشه کسر شأن میدونه اذان بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.76,
   "end": 461.82,
   "text": "چرا در جمعیت‌های اهل ایمان ما ظهور و بروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.82,
   "end": 466.36,
   "text": "کارهای ایمانیمون قوت بیشتری داره اما اون ور که می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.36,
   "end": 470.78,
   "text": "وقتی در جمعیت مخالف قرار می‌گیریم این شدتش کم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.78,
   "end": 472.98,
   "text": "جرأت و جسارت‌مون کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.98,
   "end": 476.28,
   "text": "چرا؟ چرا خط شکن نیستیم اونجا جا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.28,
   "end": 478.14,
   "text": "همش به خاطر همین ضعف ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.14,
   "end": 482.36,
   "text": "هیچی جز این نیست. و این ضعف ایمان پدر ما رو درآورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.36,
   "end": 487.46,
   "text": "ضعف ایمان دیگه نشونه‌شو اینجا می‌فرمود \"ور تابت قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.46,
   "end": 489.84,
   "text": "اینا همش دچار شک و ریب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.84,
   "end": 492.1,
   "text": "به همه چی هم شک می‌کنند. حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.1,
   "end": 497.52,
   "text": "بحث می‌ریم پیرامون بحث علمیش هم می‌کنیم که این شک از کجا بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.52,
   "end": 501.32,
   "text": "ربط به قوه خیال داره، ربط به قوه عقل داره، به قلب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.32,
   "end": 503.48,
   "text": "از کجا شروع می‌شه این شک؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.48,
   "end": 505.48,
   "text": "که حالا بحثش مفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.48,
   "end": 511.18,
   "text": "مختصراً عرض کنیم که با توجه به صحبتی که دیروز عرض کردیم خدمتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.18,
   "end": 513.44,
   "text": "شک و ریب عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.44,
   "end": 517.82,
   "text": "اول از همه از عدم طهارت قوه خیال شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.82,
   "end": 519.94,
   "text": "اگر یادتون باشه دیروز هم گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.94,
   "end": 525.82,
   "text": "قوه خیال تا تطهیر نشه از سه جبهه که یکیش اعتقاداته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 525.82,
   "end": 529.1,
   "text": "همیشه ما در این شک و ریب خواهیم ماند و گرفتار می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.1,
   "end": 531.6,
   "text": "و خدا نکنه اون قسمت آیه آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.6,
   "end": 536.5,
   "text": "آخر آیه محقق بشه که \"فهم فی ریبه یترددون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.5,
   "end": 538.86,
   "text": "اینا دیگه دائماً تو این شک می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.86,
   "end": 541.0,
   "text": "این خیلی خطرناکه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.0,
   "end": 543.74,
   "text": "سراغ تطهیر قوه خیالشون نرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.74,
   "end": 547.86,
   "text": "حالا قوه خیال رو می‌خواید یه فرقی براتون باز کنم توش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.86,
   "end": 554.4,
   "text": "عقل؟ یعنی قوه خیال، اینایی که خیالاتی زندگی می‌کنند، خیالاتی عبادت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.4,
   "end": 556.62,
   "text": "با قوه خیالشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.62,
   "end": 559.08,
   "text": "عبد خدا و در خونه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.08,
   "end": 561.74,
   "text": "خیالی امام عصرشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.74,
   "end": 569.08,
   "text": "دوست دارن و حتی می‌بیننش تو قوه خیالشون چه فرقی با اونی که داره که عقلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.08,
   "end": 573.0,
   "text": "و حتی قلباً اومده در خونه خدا، این فرقش در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.0,
   "end": 575.62,
   "text": "خیلی واضحه. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 575.62,
   "end": 578.3,
   "text": "قوه خیال مر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.3,
   "end": 580.52,
   "text": "یک چیزی است بین-- از معجزات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.52,
   "end": 582.98,
   "text": "بین ق-- عالم طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.98,
   "end": 585.5,
   "text": "و ملکوت، بین ملک و ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.5,
   "end": 588.28,
   "text": "یعنی بخشیش دنیویه، ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.28,
   "end": 590.84,
   "text": "لذا صور و اشکاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.84,
   "end": 593.86,
   "text": "شما چطور تو قوه خیالت صورت‌گری می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.86,
   "end": 597.72,
   "text": "چون مرتبط به عالم ماده‌ست، به عالم طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 597.72,
   "end": 600.2,
   "text": "چرا تو خواب هرچی خواب می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 600.2,
   "end": 603.14,
   "text": "محسوسات خواب می‌بینی. حتی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 603.14,
   "end": 608.24,
   "text": "وجود مجرد عقلی مثل ملائکه الله رو ببینی به شکل یک انسان می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.24,
   "end": 612.2,
   "text": "چرا؟ به شکل رفیقت می‌بینی حتی شاید به فکر-- به شکل خودت ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.2,
   "end": 617.98,
   "text": "چرا؟ به جهت اینکه به قول حضرت علامه دائماً محشوری با همین محسوسات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.98,
   "end": 622.02,
   "text": "قوه خیالت از اینا صور و اشکال درست می‌کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.02,
   "end": 626.86,
   "text": "برزخ وجودت، همون عالم خیالت یا در خوابت همه حقایتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.86,
   "end": 629.96,
   "text": "چون عالم محسوساته. پس ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.96,
   "end": 633.84,
   "text": "ماده هم دیروز گفتیم عالم کثراته، کثرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.84,
   "end": 636.54,
   "text": "تضاهنه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 636.54,
   "end": 645.72,
   "text": "کثرته، وحدت توش دیده نمی‌شه به ظاهرها، به ظاهر اشتباه نکنید و الا همه عالم یک وجود واحد یکپارچه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.72,
   "end": 647.4,
   "text": "بر اساس توحید صمدی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 647.4,
   "end": 650.22,
   "text": "اما عقل موجود مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 650.22,
   "end": 654.36,
   "text": "اسمش رو خودشه. برهنه از ماده و کثراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 654.36,
   "end": 658.2,
   "text": "وحدت محضه. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 658.2,
   "end": 661.1,
   "text": "کار عقلی نکرد، وجه تمایز رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.1,
   "end": 666.94,
   "text": "این باید بحث بشه بعداً. اگر کسی کار عقلی نکرد، کار فکری نکرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.94,
   "end": 673.98,
   "text": "اهل تفکر و تأمل و تمرکز و تعقل و تدبر و این‌ها نبودddd",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 673.98,
   "end": 677.0,
   "text": "قطعاً میفته در گرداب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 677.0,
   "end": 679.8,
   "text": "وحشتناک قوه خیالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.8,
   "end": 683.46,
   "text": "و قوه خیالش با خودش می‌بره این رو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.46,
   "end": 686.06,
   "text": "همش حتی در نسبت به حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.06,
   "end": 688.2,
   "text": "عالیه نظام هستی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.2,
   "end": 690.1,
   "text": "با خیالش فکر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.1,
   "end": 698.56,
   "text": "و چون عموم مردم متأسفانه گرفتار قوه خیال‌اند شما ببینید دائماً قرآن مثل می‌زنه، تمثیل میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.56,
   "end": 701.86,
   "text": "چرا تمثیل؟ چرا مثال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.86,
   "end": 705.7,
   "text": "چون قوه خیال ما مربوط به عالم مثال وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.7,
   "end": 710.04,
   "text": "مثال. عالم مثال همون برزخه، همون قوه خیاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 710.04,
   "end": 716.4,
   "text": "همون صورت‌گریه، شکل و صورت دادن به حقایق نظام هستی که تو بهتر بتونی بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.4,
   "end": 718.98,
   "text": "لذا \"تلك الأمثال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 718.98,
   "end": 723.6,
   "text": "قرآنه. \"تلك الأمثال نذر بها للناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 723.6,
   "end": 729.7,
   "text": "تازه اون مثل‌های قرآنی هم قرآن خودش می‌فرماید \"لا يعقلها إلا العالمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 729.7,
   "end": 732.92,
   "text": "جز عالم نمی‌تونه اینو تعقل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 732.92,
   "end": 739.36,
   "text": "وجه تمایز بین آدمی که دچار شک و تردید و گرفتار قلب مردده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 739.36,
   "end": 741.76,
   "text": "که متأسفانه آخر هم مردود می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 741.76,
   "end": 745.0,
   "text": "با کسی که ثبات داره و یقین داره همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 745.0,
   "end": 747.04,
   "text": "این کار عقلی کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 747.04,
   "end": 750.8,
   "text": "این بابا اهل تفکر و تأمل بوده لذا تو این جلسه ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 750.8,
   "end": 755.58,
   "text": "کلام بارها گفتیم بازم می‌گیم \"فذكر فإن الذكرى تنفع المؤمنين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 755.58,
   "end": 757.5,
   "text": "حضرت علامه بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 757.5,
   "end": 762.64,
   "text": "تأکید به قلب عبارتی قرآن دارن \"وليتلطف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.64,
   "end": 766.56,
   "text": "تلطیف سر تا صورت نگیره انسان به حقایق نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 766.56,
   "end": 770.1,
   "text": "دستش از ملکوت کوتاهه و فهم عمیق نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 770.1,
   "end": 772.52,
   "text": "بعد علامه کار رو تموم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 772.52,
   "end": 778.16,
   "text": "\"وليتلطف\" قرآن رو ذیلش می‌نه، می‌فرماید \"أيتعقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.16,
   "end": 781.12,
   "text": "کار عقلی کردن، تفکر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.12,
   "end": 783.08,
   "text": "عقل هم کار جاهای دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 783.08,
   "end": 785.64,
   "text": "کار جاهای چیه؟ دشوار. سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 785.64,
   "end": 788.28,
   "text": "خب سخته بله. عقل داری یا نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 788.28,
   "end": 790.28,
   "text": "درسته که سخته نباید پس بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 790.28,
   "end": 793.1,
   "text": "عقل که داری. میگه آقا سخته نمی‌فهمم، ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 793.1,
   "end": 796.1,
   "text": "فرار می‌کنه. این از خودش داره فرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 796.1,
   "end": 798.24,
   "text": "این بحث تازه کلیدش خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 798.24,
   "end": 801.84,
   "text": "خیلی به درد بخور و کاربردیه این بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 801.84,
   "end": 803.72,
   "text": "مردد یا مشکوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 803.72,
   "end": 805.32,
   "text": "انشالله خدا هممون رو یاری بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 805.32,
   "end": 809.84,
   "text": "عاقبتمون ختم به خیر باشه. به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 809.84,
   "end": 812.94,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 812.94,
   "end": 816.8,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}