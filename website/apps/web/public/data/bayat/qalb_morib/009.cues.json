   "start": 484.68,
   "end": 568.32
  },
  {
   "index": 6,
   "title": "## چرا همه مولا را زیارت می‌کنند؛ میزان",
   "start": 568.32,
   "end": 1018.81
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.26,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.26,
   "end": 7.4,
   "text": "السلام علیک یا دعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.4,
   "end": 11.64,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.64,
   "end": 21.0,
   "text": "الحمد لله الذي جعلنا من المتمسکین بولایه امیر المؤمنین علی ابن ابی طالب صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.0,
   "end": 25.56,
   "text": "بنا بود که بچه‌ها جشن بگیرن البته صبح الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.56,
   "end": 27.42,
   "text": "جشن خوب و قشنگی داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.42,
   "end": 31.78,
   "text": "الانم خوب بود که داشته باشیم اما ظاهراً تشریف نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.78,
   "end": 33.98,
   "text": "مجبورید ماه جهنمی رو تحمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.98,
   "end": 41.72,
   "text": "لحظاتی اجازه بدید که نقطه‌ اتصال‌مون به بحث با مولامون علی علیه الصلاة والسلام باشه به جهت این شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.72,
   "end": 43.74,
   "text": "با عظمت غدیر و عید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.74,
   "end": 46.32,
   "text": "اکبر که بزرگ‌ترین عید شیعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.32,
   "end": 50.86,
   "text": "و حالات ما و خانواده‌مون هم باید متفاوت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.86,
   "end": 57.18,
   "text": "اون حدیث شریف میم و طیرنی که مولا فرمودن هر کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.18,
   "end": 59.58,
   "text": "بمیرد مرا می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.58,
   "end": 61.74,
   "text": "حالا چه کافر باشه چه مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.74,
   "end": 69.06,
   "text": "خیلی عجیبه. همه باید مولامون علی علیه الصلاة والسلام رو ببینن لب مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.06,
   "end": 77.6,
   "text": "چرایی این حدیث رو عرض کنم الصاقش بدیم انشاالله سنجاقش کنیم به بحث قلب مریب یا مردد یا شکاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.6,
   "end": 82.56,
   "text": "که انشاالله اونجا اگر کسی به هر حال تو دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.56,
   "end": 87.06,
   "text": "تو شیب نام و لایمات و اینهائه و خدای نکرده گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.06,
   "end": 91.24,
   "text": "انحرافی شد، اونجا به امید خدا مولا جبران کنه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.24,
   "end": 94.8,
   "text": "اشکال نداره پذیرایی بشن دوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.8,
   "end": 100.26,
   "text": "این رو خوب توجه کنید از جهت علمی چرا ما اساساً امیر المؤمنین صلوات الله علیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.26,
   "end": 104.06,
   "text": "لب مرگ انشاالله زیارت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.06,
   "end": 108.52,
   "text": "ما عرض کردیم که برای نجات و خروج از قلب مریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.52,
   "end": 114.0,
   "text": "و شکاک و مردد هیچ چاره‌ای نداریم الا اینکه خودمون رو تحویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.0,
   "end": 116.88,
   "text": "امام و حجت زمان بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.88,
   "end": 119.34,
   "text": "تحویل ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.34,
   "end": 126.68,
   "text": "اعظم حق بدیم و اگر شما بگید دسترسی به امام نداریم میگیم قرآن که بحثش گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.68,
   "end": 130.26,
   "text": "که البته این بحث هنوز نا-- نیمه کاره است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.26,
   "end": 136.2,
   "text": "در خصوص کیفیت رجوع به قرآن و تحویل دادن به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.2,
   "end": 139.96,
   "text": "الان این رو یه پرانتزی بین بحث به جهت امشب باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.96,
   "end": 144.9,
   "text": "اونم اینکه امام امیر المؤمنین صلوات الله علیه مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.9,
   "end": 149.52,
   "text": "همه اسماء و صفات حضرت حقه یعنی اسم جامع داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.52,
   "end": 152.48,
   "text": "مقام مولامون علی مقام جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.48,
   "end": 157.22,
   "text": "همونطور که قرآن، قرآن مقام جمعی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.22,
   "end": 167.78,
   "text": "و اگر یک حرف از قرآن رو بگیری از مقام جمعی میفتد لذا خدا اون رو حفظ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.78,
   "end": 174.5,
   "text": "امام هم، امام امیر المؤمنین صلوات الله علیه هم که امیر همه اهل ایمان هست مقام جمع دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.5,
   "end": 177.38,
   "text": "همه اسماء درش هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.38,
   "end": 182.82,
   "text": "یکی از اسماء حضرت حق و صفات حضرت حق یقین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.82,
   "end": 186.54,
   "text": "یکی از صفات حضرت حق صبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.54,
   "end": 188.48,
   "text": "خدا بلکه صبار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.48,
   "end": 192.68,
   "text": "تو قرآن خودشو به در وزن فعال به شدت صبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.68,
   "end": 196.12,
   "text": "معرفی میکنه. بلکه صبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.12,
   "end": 199.0,
   "text": "در ذات حضرت حق مستکنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.0,
   "end": 204.22,
   "text": "یقین هم اینچنین است. در حقیقت اگر کسی بخواد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.22,
   "end": 213.4,
   "text": "قلب مریب که ما معمولاً در انحرافات دچارش میشیم به جهت غفلت و قلبمون شکاک میشه، شک میکنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.4,
   "end": 217.66,
   "text": "حقایق روزگار، نجات پیدا کنه هیچ چاره‌ای نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.66,
   "end": 219.96,
   "text": "الا حرکت به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.96,
   "end": 225.26,
   "text": "صفت یقین و اسم یقین حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.26,
   "end": 228.36,
   "text": "همونطور که ما برای نجات از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.36,
   "end": 233.02,
   "text": "نام و لایمات هیچ چاره‌ای جز حرکت به سمت اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.02,
   "end": 237.58,
   "text": "صبر حضرت حق، صفت صبر حضرت حق نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 237.58,
   "end": 241.74,
   "text": "تمام اسماء در مولامون علی علیه الصلاة والسلام جمع‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.74,
   "end": 246.36,
   "text": "و ما اساساً بر اساس آیه صد و پنجاه و پنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.36,
   "end": 255.26,
   "text": "صد و پنجاه و شش و صد و پنجاه و هفت سوره بقره به سمت اسماء الهی در حرکت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.26,
   "end": 259.62,
   "text": "این آیه رو دقت بکنید. \"ولنبلونكم\" در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.62,
   "end": 262.86,
   "text": "جهات مختلف ما این آیه رو مورد بحث قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.86,
   "end": 265.22,
   "text": "حالا اینجا یک وجه دیگری show.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.22,
   "end": 270.04,
   "text": "\"ولنبلونكم\" قطعاً شما رو به بلا دچار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.04,
   "end": 273.54,
   "text": "از چه جنسی؟ \"من الخوف والجوع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.54,
   "end": 275.96,
   "text": "ترس و گرسنگی و نقص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.96,
   "end": 279.88,
   "text": "نقص در چی؟ \"من الأموال والأنفس والثمرات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.88,
   "end": 284.08,
   "text": "در مالتون، در جانتون، در ثمرات و فرزندانتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.08,
   "end": 286.08,
   "text": "در کشتزار، کشتزارتون هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.08,
   "end": 289.1,
   "text": "\"وبشر الصابرین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.1,
   "end": 292.06,
   "text": "ببینید رفت سراغ اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.06,
   "end": 295.76,
   "text": "صابر حضرت حق و صفت صبر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.76,
   "end": 298.04,
   "text": "بشارت بده به اینا که اهل صبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.04,
   "end": 302.02,
   "text": "حالا اینجا معرفی میکنه صابرین چه کسانی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.02,
   "end": 304.46,
   "text": "نبض آیه اینجاست. آیه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.46,
   "end": 309.64,
   "text": "\"الذین اذا اصابتهم مصيبة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.64,
   "end": 315.86,
   "text": "به محض اینکه اصابت کرد مصیبت، همون مصیباتی که آیه قبل شمرد از چه جنسیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.86,
   "end": 322.5,
   "text": "بهشون به محض اصابت \"قالوا\" اینا میگن \"انا لله\" این قوس نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.5,
   "end": 327.56,
   "text": "انا از چی؟ لله. الله اسم جمع، اسم جامع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.56,
   "end": 330.64,
   "text": "اسم خاصه. همه اسماء درشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.64,
   "end": 335.46,
   "text": "رسیدیم به نقطه عطف. الصاق به بحث ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.46,
   "end": 337.98,
   "text": "و البته الان خب آقا بگیم تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.98,
   "end": 340.62,
   "text": "ما که از طرف حضرت حق اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.62,
   "end": 347.22,
   "text": "به قول علامه رفیع قزوینی تمام اسماء و اسحاکه اسماء و لشگریانه اسماء در همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.22,
   "end": 352.64,
   "text": "در حقیقت کلمات وجودی نظام ارضی تجلی کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.64,
   "end": 358.28,
   "text": "عینیت پیدا کردن. یکیش هم ماییم که به نحوه اتم از همه موجودات در انسان تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.28,
   "end": 360.18,
   "text": "لذا صاحب نفس ناطقه شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.18,
   "end": 363.68,
   "text": "در فعل و ذات و صفات به وزان حضرت حق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.68,
   "end": 366.64,
   "text": "خب در قوس نزول بود. صعود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.64,
   "end": 369.18,
   "text": "و إنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.18,
   "end": 372.16,
   "text": "اون إليه ضمیرها برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.16,
   "end": 378.5,
   "text": "به الله. انا لله و إنا إليه دوباره برمی‌گردی به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.5,
   "end": 382.84,
   "text": "الله هم که اسم جمعه. اسم جمعو توجه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.84,
   "end": 387.46,
   "text": "مقام جمع، اسم خاص، تمام اسماء و صفات درشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.46,
   "end": 392.66,
   "text": "پس ما قراره چه بخوایم چه نخوایم بریم به سمت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.66,
   "end": 394.98,
   "text": "و إنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.98,
   "end": 398.82,
   "text": "جالبه که آیه بعدش تو همین سوره می‌فرمود أولئك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.82,
   "end": 400.98,
   "text": "حالا اینا رو دوباره بازشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.98,
   "end": 408.76,
   "text": "اینایی که قالوا انا لله و انا الیه راجعون یعنی توجه دارن به اینکه در قوس صعود به سمت الله در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.76,
   "end": 413.12,
   "text": "أولئك اینا کسایی‌ان که عليهم صلوات من ربهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.12,
   "end": 421.08,
   "text": "و رحمة. این صلوات و رحمت که و أولئك هم المهتدون اینا اهل هدایتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.08,
   "end": 426.26,
   "text": "صلوات خدا و رحمت خدا اون کسری‌ها رو جبران می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.26,
   "end": 432.36,
   "text": "که حالا اینجا بحث مبسوطی مفسرین دارن ما الان بازش نمی‌کنیم هم وقت نداریم هم خیلی مرتبط با بحث نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 432.36,
   "end": 435.64,
   "text": "می‌تونید رجوع کنید به تفاسیر حرف‌های شیرینی زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 435.64,
   "end": 443.06,
   "text": "صلوات ببینید أولئك عليهم صلوات من ربهم از پروردگارشون صلوات دریافت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 443.06,
   "end": 445.74,
   "text": "اونایی که تو گرفتاری‌ها و مصیبت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.74,
   "end": 453.94,
   "text": "افتادن اما گفتن انا لله یعنی توجه داشتن و إنا إليه راجعون به اینکه دارن به سمت الله حرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.94,
   "end": 455.88,
   "text": "کی به سمت الله حرکت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 455.88,
   "end": 459.0,
   "text": "همه عالم. اساسا آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.0,
   "end": 461.16,
   "text": "شش سوره انشقاق چی می‌فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 461.16,
   "end": 464.58,
   "text": "بارها عرض کردیم يا ايها الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 464.58,
   "end": 468.28,
   "text": "الف و لام سر انسان، همه انسان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.28,
   "end": 472.18,
   "text": "انک کادهون تو رونده به همراه سختی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.18,
   "end": 474.74,
   "text": "به چه سمتی؟ الى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 474.74,
   "end": 476.64,
   "text": "به سمت پروردگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.64,
   "end": 478.58,
   "text": "البکه البته به چه صورت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.58,
   "end": 481.66,
   "text": "كدحا دوباره تاکید می‌کنه با سختی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 481.66,
   "end": 486.6,
   "text": "و لنبلونکن بشیء من الخوف والجوع ونقص من الاموال والانفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 486.6,
   "end": 492.2,
   "text": "والثمرات. کادهون‌ها اما بعد ف این فای نتیجه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 492.2,
   "end": 495.22,
   "text": "پس فملاقیهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 495.22,
   "end": 499.82,
   "text": "به جهت اینکه قراره ملاقات کنی او را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.82,
   "end": 504.04,
   "text": "خب این ملاقات یعنی همون و إنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 504.04,
   "end": 506.0,
   "text": "یعنی ما بخواهید نخواهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 506.0,
   "end": 509.16,
   "text": "همه عوالم هستی إنا إليه راجعون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 509.16,
   "end": 513.1,
   "text": "اما یکی در حضور حضوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.1,
   "end": 517.02,
   "text": "یعنی حاضره در حضور، مراقب بر حضوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.02,
   "end": 523.6,
   "text": "یعنی مؤمنه. یکی نه غافله از حضوره و الا همه در حضورن که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 523.6,
   "end": 527.14,
   "text": "اون که غافله هیچی، اون میره به سمت اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 527.14,
   "end": 529.18,
   "text": "جلالیه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.18,
   "end": 533.64,
   "text": "یا اسماء فعلیه حضرت حق مثل ذي انتقام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 533.64,
   "end": 538.12,
   "text": "مثل شدید العقاب که در مولامون علی این اسماء متقابل جمع‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.12,
   "end": 542.16,
   "text": "باز اونا هم دارن به سمت علی حرکت می‌کنند حتی کاف-کفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 542.16,
   "end": 544.86,
   "text": "لذا میگه چه کافر، چه منافق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 544.86,
   "end": 547.34,
   "text": "چه مؤمن لب مرگ منو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.34,
   "end": 549.66,
   "text": "توجه کردی این سرشه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 549.66,
   "end": 552.02,
   "text": "کسی که حواسش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 552.02,
   "end": 556.38,
   "text": "حواسش هست که إنا إليه راجعون یعنی غافل نیست یعنی مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 556.38,
   "end": 562.3,
   "text": "یعنی شیعه امیرالمؤمنین صلوات الله علیه که ان شا الله اگر خطایی گناهی چیزی هم هست آقا اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.3,
   "end": 565.54,
   "text": "جبران می‌کنه لحظه دیدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.54,
   "end": 568.32,
   "text": "و از قبل البته دو-جبران شده هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.32,
   "end": 573.74,
   "text": "چرا؟ چون أولئك عليهم صلوات من ربهم و رحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.74,
   "end": 578.1,
   "text": "خدا به رحمتش و صلواتش جبران می‌کنه تا بتونی برسی به مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 578.1,
   "end": 581.74,
   "text": "به شرط اینکه طبق بحثی که پیرامون استعداد گذشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.74,
   "end": 590.26,
   "text": "استعداد رو با گناه پی در پی از بین نبرده باشی که به مقام شفع یا شفاعت برسی، جفت بشی، شفع جفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.26,
   "end": 593.52,
   "text": "که اونجا مولا بتونه تو رو شفاعت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.52,
   "end": 596.82,
   "text": "حالا پس همه داریم میریم به چه سمتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.82,
   "end": 599.78,
   "text": "انا لله و إنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 599.78,
   "end": 602.36,
   "text": "فملاقیهه قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.36,
   "end": 604.94,
   "text": "ملاقات کنیم. کیو؟ ربك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 604.94,
   "end": 612.7,
   "text": "به یک معنا این ربهم این ربك اینجا اون رب مقام ولایت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 612.7,
   "end": 618.58,
   "text": "یعنی قراره همه برید به دیدار ولایت، صاحب ولایت کلیه الهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 618.58,
   "end": 622.48,
   "text": "صاحب ولایت کلیه الهی امیرالمؤمنین صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 622.48,
   "end": 627.2,
   "text": "آقا جون، خواهر عزیزم، برادر گرامی که شب عید غدیر دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 627.2,
   "end": 632.44,
   "text": "هم جمع شدید توجه دارین مخصوصا کلمات رو حساب شده کنار هم میذارما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 632.44,
   "end": 635.88,
   "text": "پس اینطوری نگین گفت توجه یعنی حواست جمع باشه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 635.88,
   "end": 639.22,
   "text": "چون پیرامون توجه عرفانی قبلا چند جلسه حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 639.22,
   "end": 641.5,
   "text": "توجه دارین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 641.5,
   "end": 645.0,
   "text": "که دارین میرین به زیارت امیرالمؤمنین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 645.0,
   "end": 648.68,
   "text": "هی هوای نجف سرمون می‌زنه، اونم عشق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 648.68,
   "end": 650.84,
   "text": "اما اون نجف اصلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 650.84,
   "end": 653.86,
   "text": "اون صاحب بقعه و بارگاه نجف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 653.86,
   "end": 658.82,
   "text": "اون صاحب ول-- اصلاً صاحب ولایت کلیه الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 658.82,
   "end": 664.22,
   "text": "که همه اسماء درش تجلی کرده است که یکی از اون اسماء یقینه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 664.22,
   "end": 666.48,
   "text": "صبر است و بشر الصابرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.48,
   "end": 670.04,
   "text": "داریم میریم به زیارتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 670.04,
   "end": 677.04,
   "text": "عزیز دلم که نسبت به قابلیت و سعای وجودی که در خودت ایجاد کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 677.04,
   "end": 685.28,
   "text": "ان الاعطیات به قول محی الدین عربی علیه الرحمة علی قدر القابليات در فصوصالحکمش در فصل شیسی میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 685.28,
   "end": 691.48,
   "text": "که به قدر قابلیتت اون فاعلیت نظام هستی عطا می‌کنه به تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 691.48,
   "end": 700.34,
   "text": "اون فاعلیت م-- خدا از دایره اسباب یعنی از دست یداللهیش از دست مولا علی همه عطاهارو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 700.34,
   "end": 706.5,
   "text": "لب مرگ به میزان سعای وجودیت از مولا علی عطا می‌گیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 706.5,
   "end": 709.58,
   "text": "عطا. حالا عطایی که از مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 709.58,
   "end": 712.98,
   "text": "به کفار و مشرکین و منافقین میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 712.98,
   "end": 717.1,
   "text": "اون هم به یک معنا عطاست اما ن-نسبت به سعی وجودیشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 717.1,
   "end": 720.26,
   "text": "چیه اون؟ جهنمه. دوزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 720.26,
   "end": 722.44,
   "text": "آتشه. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 722.44,
   "end": 725.58,
   "text": "که ما قبلاً بحث کردیم نار و نور یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 725.58,
   "end": 728.44,
   "text": "همونطور که قابض الارواح یک حقیقته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 728.44,
   "end": 731.79,
   "text": "نسبت به قابلیت‌ها قیافش عوض می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 731.79,
   "end": 737.59,
   "text": "در حقیقت مولا علی علیه الصلاة والسلام در آینه‌ی وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 737.59,
   "end": 743.55,
   "text": "یا بلعکسش رو بگیم تو در آینه‌ی وجودی مولا علی خودت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 743.55,
   "end": 750.95,
   "text": "خودت رو در آینه. آینه هم مرآت در عربی اون قاب رو نمیگن، اون نمایاندن رو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 750.95,
   "end": 758.35,
   "text": "اونچه که در صفحه‌ی وجودی همه‌ی اسماء اسم جمع حضرت حق که مولا علی علیه الصلاة والسلام هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 758.35,
   "end": 761.51,
   "text": "نمایانده می‌شود خودت هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 761.51,
   "end": 765.75,
   "text": "تو خودت رو در وجود مولا لحظه‌ی مرگ می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 765.75,
   "end": 767.39,
   "text": "چی از خودت ساختی؟ بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 767.39,
   "end": 772.25,
   "text": "حالا بعضی جاش دیدی بعضی آینه‌ها نگاه می‌کنی دماغو کج نشون میده، گوشو کج نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 772.25,
   "end": 775.05,
   "text": "این‌ها دیگه اعوجاج‌ها، انحراف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 775.05,
   "end": 777.17,
   "text": "به، به جهت غفلت‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 777.17,
   "end": 779.85,
   "text": "اونجا مولا جبران می‌کنه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 779.85,
   "end": 783.89,
   "text": "به شرط اینکه بتونی استعداد رو بکشونی تا لحظه‌ی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 783.89,
   "end": 786.13,
   "text": "حالا بحث ما اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 786.13,
   "end": 788.39,
   "text": "تو این نقطه به پایان می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 788.39,
   "end": 792.31,
   "text": "که چرا ما مولا علی علیه الصلاة والسلام رو قراره زیارت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 792.31,
   "end": 794.89,
   "text": "چون اسم جامع، صاحب اسم جامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 794.89,
   "end": 799.33,
   "text": "تمام اسماء در وجود حضرته و ما به سمت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 799.33,
   "end": 805.71,
   "text": "که مجمع جميع اسماء در حرکتیم لاجرم باید مولا علی رو زیارت کنیم و ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 805.71,
   "end": 807.99,
   "text": "همه می‌بینن، همه و همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 807.99,
   "end": 814.27,
   "text": "حالا که همه قراره ببینن نسبت به صعه‌ی وجودی‌شون خودشون رو در درون مولا زیارت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 814.27,
   "end": 821.33,
   "text": "خودت خودت رو می‌بینی. لذا میگه بخوان اقرأ کتابک کفا بنفسک اليوم عليك حسيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 821.33,
   "end": 827.43,
   "text": "با خودت کافی. اینجا معنای میزان معلوم می‌شه که مولا فرمود انا الميزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 827.43,
   "end": 832.21,
   "text": "اصلا نه اینکه من یک ترازو ام تو رو بذارن در من بکشه یا مثلا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 832.21,
   "end": 836.69,
   "text": "صاحب یه ترازو ام که تو رو بذارن تو اون ترازو من بکشمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 836.69,
   "end": 838.65,
   "text": "نه اصلا من میزانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 838.65,
   "end": 840.39,
   "text": "یعنی تو رو با من می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 840.39,
   "end": 842.73,
   "text": "وزن کشی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 842.73,
   "end": 846.45,
   "text": "یعنی دیدن خودت در من علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 846.45,
   "end": 850.37,
   "text": "تو نمایان می‌شی در صفحه‌ی، در آینه‌ی وجودی من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 850.37,
   "end": 852.21,
   "text": "خودت رو می‌بینی در لحظه‌ی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 852.21,
   "end": 856.77,
   "text": "حالا اگر کسی خدای نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 856.77,
   "end": 859.51,
   "text": "یا مرید بوده دچار قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 859.51,
   "end": 863.15,
   "text": "حالا مردد بوده این‌ها باید سریع بجنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 863.15,
   "end": 865.25,
   "text": "این به انحراف می‌برتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 865.25,
   "end": 867.23,
   "text": "این می‌کشونتش به اسماء جلالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 867.23,
   "end": 870.59,
   "text": "می‌کشونتش به سمت اسماء فعلیه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 870.59,
   "end": 874.31,
   "text": "که مستقلاً در ذات حضرت حق نیستن مثل ذو انتقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 874.31,
   "end": 876.15,
   "text": "خدا ذاتاً مهربانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 876.15,
   "end": 878.85,
   "text": "اصلا دارای انتقام نیست. فعلیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 878.85,
   "end": 884.19,
   "text": "بر اثر عمل من فعلیت حضرت حق به انتقام کشیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 884.19,
   "end": 886.85,
   "text": "حالا اینا در مولا علی علیه الصلاة والسلام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 886.85,
   "end": 891.33,
   "text": "لذا الان یه رگه متوجه شدیم یه مقدار تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 891.33,
   "end": 894.07,
   "text": "شرایط خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 894.07,
   "end": 898.81,
   "text": "صاحب قلب مارئیب رو یا شکاک رو در وضع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 898.81,
   "end": 907.29,
   "text": "زیارت مولا علی. اونجا یه مقدار خطرناک می‌شه کسی که دچار شک و تردید بوده باید به داد دلش زودتر برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 907.29,
   "end": 914.27,
   "text": "چه کنه؟ قبل از لحظه‌ی مرگ همینجا باید زیارت کنه مولا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 914.27,
   "end": 918.97,
   "text": "قبل از لحظه‌ی مرگ همینجا باید زیارت کنه قرآن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 918.97,
   "end": 922.27,
   "text": "قبل از رسیدن به اون فملاقیحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 922.27,
   "end": 927.07,
   "text": "باید همینجا با اسماء الهی محشور باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 927.07,
   "end": 936.15,
   "text": "یعنی انقدر اسم رئوف خدا رو در خودش جا داده باشه که تا امیرالمؤمنین رو دید آقا رو رئوف ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 936.15,
   "end": 940.37,
   "text": "انقدر اسم علیم صفت مشبّه است، شدت علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 940.37,
   "end": 945.65,
   "text": "استکان علم، آرامش علم در وجودش ریشه دوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 945.65,
   "end": 954.45,
   "text": "شما مؤمن مولا انقدر به سمت حقایق و علوم رفته تا علی علیه الصلاة والسلام رو درک علمی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 954.45,
   "end": 957.79,
   "text": "علم مولا رو فرا می‌گیره که ان‌ها هنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 957.79,
   "end": 962.25,
   "text": "حالا تمام سینه‌ش رو اشاره می‌کرد مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 962.25,
   "end": 964.67,
   "text": "قربون اون سینه‌ت بریم الهی علی جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 964.67,
   "end": 968.69,
   "text": "ان‌ها هنا لعلم جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 968.69,
   "end": 970.87,
   "text": "تمام علم تو این سینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 970.87,
   "end": 973.21,
   "text": "سينهدر عن السيل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 973.21,
   "end": 975.87,
   "text": "سیل این علم جاریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 975.87,
   "end": 979.63,
   "text": "کی می‌تونه بهش برسه؟ هیچ پرنده‌ای ولا یلقي علیه طي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 979.63,
   "end": 983.07,
   "text": "نمی‌تونه به اون افق برسه. اما هرکی به قدر قابلیتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 983.07,
   "end": 989.35,
   "text": "خلاصه بحث از قلب شکاک الان پیش از مرگ پناه ببرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 989.35,
   "end": 992.59,
   "text": "به ولایت، به مولا علی خصوصا امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 992.59,
   "end": 995.53,
   "text": "و قرآن. نگید کو مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 995.53,
   "end": 998.21,
   "text": "بسم الله. صورت کتبیه‌ی مولا قر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 998.21,
   "end": 1000.97,
   "text": "قرآن است. به قرآن پناه ببریم امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1000.97,
   "end": 1003.77,
   "text": "ان شاء الله که عاقبتمون ختم به خیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1003.77,
   "end": 1006.79,
   "text": "ببرید. ببخشید شما یه ذره من تندتند حرف زدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1006.79,
   "end": 1012.09,
   "text": "به جهت اینکه وقت ضیقه و مطلب دشوار و قامض بود باید جا می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1012.09,
   "end": 1018.81,
   "text": "ان شاء الله که عاقبت ما ختم به خیر باشد به برکت عید غدیر مولا و صلوات بر محمد و آل محمد. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}