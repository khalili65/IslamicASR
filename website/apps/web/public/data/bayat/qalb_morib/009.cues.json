   "start": 11.64,
   "end": 104.94
  },
  {
   "index": 1,
   "title": "## خروج از قلب مریب با سپردن به حجت",
   "start": 104.94,
   "end": 141.54
  },
  {
   "index": 2,
   "title": "## امیرالمؤمنین؛ مظهر اسم جامع",
   "start": 141.54,
   "end": 266.98
  },
  {
   "index": 3,
   "title": "## لنبلونکم؛ صابرین و انا لله",
   "start": 266.98,
   "end": 464.58
  },
  {
   "index": 4,
   "title": "آیه‌ی شش سوره‌ی انشقاق:",
   "start": 464.58,
   "end": 484.68
  },
  {
   "index": 5,
