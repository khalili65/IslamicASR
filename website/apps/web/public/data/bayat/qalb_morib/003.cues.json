   "title": "## ازالهٔ نجاست و ماشین لباسشویی",
   "start": 0.46,
   "end": 201.58
  },
  {
   "index": 1,
   "title": "## قلب مردد و روایت شفاعت زهرا",
   "start": 201.58,
   "end": 385.64
  },
  {
   "index": 2,
   "title": "## سه دستهٔ بازمانده و ولایت سه بخشی",
   "start": 385.64,
   "end": 489.52
  },
  {
   "index": 3,
   "title": "## راه نجات: تحویل به ولی خدا",
   "start": 489.52,
   "end": 509.72
  },
  {
   "index": 4,
   "title": "## خطبهٔ امام رضا: امام مفزع العباد",
   "start": 509.72,
   "end": 561.76
  },
  {
   "index": 5,
   "title": "## مناجات امام عصر در سرداب برای شیعه",
   "start": 561.76,
   "end": 1033.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 10.58,
   "text": "و بهین استعین. السلام علیک ای داعی الله و ربانی ایاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.58,
   "end": 18.74,
   "text": "می‌دونید که برای تطهیر شیء نجس اول کاری که باید اتفاق بیفته ازاله نجاسته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.74,
   "end": 22.22,
   "text": "یعنی باید نجاست از اون شیء متنجس برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 22.22,
   "end": 25.78,
   "text": "عین نجا-- نجاست باید رفع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.78,
   "end": 28.58,
   "text": "بعد حالا شست‌شو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.58,
   "end": 33.74,
   "text": "سؤال اینجاست که استفتایی که از رهبر عزیزمون شده و مبتلا به امروز همه‌ی ما هم هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.74,
   "end": 36.32,
   "text": "این ماشین‌های لباسشویی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.32,
   "end": 39.38,
   "text": "حالا متعارف این ماشین‌ها که تو خونه‌ها هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.38,
   "end": 42.04,
   "text": "و این لباسو داخلش میندازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.04,
   "end": 46.2,
   "text": "معمولاً هم چهار بار این‌ها شست‌شو می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.2,
   "end": 50.9,
   "text": "آیا این لباس نجس که داخل اون ماشینه شست‌شو میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.9,
   "end": 53.02,
   "text": "نجاستش برطرف میشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.02,
   "end": 58.56,
   "text": "یعنی پاک میشه؟ خب اولاً باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.56,
   "end": 61.02,
   "text": "عین نجاست برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.02,
   "end": 63.62,
   "text": "یعنی شما باید مطمئن بشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.62,
   "end": 68.14,
   "text": "بر اثر این شست‌شو عین نجاست برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.14,
   "end": 71.6,
   "text": "حداقل تو اون چهار باری که میشوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.6,
   "end": 75.86,
   "text": "حداقل بار سوم دیگه عین نجاست برطرف شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.86,
   "end": 79.52,
   "text": "یعنی بار اول، دوم، سوم حداقل دیگه تا سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.52,
   "end": 82.08,
   "text": "برطرف بشه. چرا تا سوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.08,
   "end": 84.52,
   "text": "چون یه بار دیگه داره بشوره دیگه چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.52,
   "end": 90.12,
   "text": "دفعه چهارم دیگه باید ب-- دیگه عین نجاست برطرف شده چ-- دفعه چهارم باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.12,
   "end": 92.68,
   "text": "شست‌شو برای طهارتش باید بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.68,
   "end": 96.08,
   "text": "یعنی وقتی عین نجاست برطرف شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.08,
   "end": 99.38,
   "text": "با آب کلر مثل آب لوله‌کشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.38,
   "end": 102.22,
   "text": "یک بار شست‌شو بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.22,
   "end": 111.74,
   "text": "پاک میشه این لباس‌ها. حالا رهبر عزیزمون در خصوص لباس و امثال لباس و این‌ها احتیاط واجب کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.74,
   "end": 114.06,
   "text": "که به گونه‌ای فشار داده بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.06,
   "end": 118.88,
   "text": "آب غساله اصطلاحاً یا اون آبی که داخلشه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.88,
   "end": 127.08,
   "text": "بیرون بیاد. ماشینای لباسشویی وقتی که با سرعت شروع می‌کنه اون آخر سر چرخیدن این کارو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.08,
   "end": 132.16,
   "text": "یعنی اون آب از توش البته رهبر فتوا نداده‌ها احتیاط واجب کرده، این یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.16,
   "end": 137.68,
   "text": "دوماً اصلاً همه ماشین‌های لباسشویی‌ها الا اونایی که سطلی‌ان، اونا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.68,
   "end": 141.0,
   "text": "این یکیا وقتی میشورن مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.0,
   "end": 143.0,
   "text": "اتوماتیک‌ها اینا میشورن ف-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.0,
   "end": 146.52,
   "text": "مثل فشار دادنه قشنگ آبو میکشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.52,
   "end": 152.08,
   "text": "لذا پس چی شد؟ در نهایت فتوای آقا اینه، یک؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.08,
   "end": 154.2,
   "text": "عین نجاست برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.2,
   "end": 161.68,
   "text": "دو؛ وقتی که به مرحله‌ای رسید که عین نجاست برطرف شده و آب لوله‌کشی دوباره میاد تو ماشین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.68,
   "end": 165.82,
   "text": "آب به تمام قسمت‌های این لباس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.82,
   "end": 171.18,
   "text": "متنجس بوده و جاهای مختلف ماشین لباسشویی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.18,
   "end": 174.52,
   "text": "چون بالاخره اون آبی که اول بود اون نجسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.52,
   "end": 178.08,
   "text": "داره بالاخره داره خارج میشه میگه دوباره اون آب تمیزی که دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.08,
   "end": 181.62,
   "text": "پاکی که میاد به تمام قسمت‌های ماشین لباسشویی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.62,
   "end": 184.22,
   "text": "مثلا اون لاستیک‌های دورش، اونکه داخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.22,
   "end": 187.26,
   "text": "ماشین قرار گرفته که معمولاً این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.26,
   "end": 194.24,
   "text": "برای همین خیلی نگران نباشید. نگرانی ما از اینه فقط که اون عین نجاسته بالاخره برطرف میشه یا نه، اون مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.24,
   "end": 201.58,
   "text": "خب خیال خودتو راحت کن. اول عین نجاست رو برطرف کن بعد بنداز تو ماشین دیگه با خیال راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.58,
   "end": 204.18,
   "text": "بحث ما قس-- قلب مردد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.18,
   "end": 207.24,
   "text": "قلبی که دچار شک و ریب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.24,
   "end": 211.28,
   "text": "یه روایتی رو قطعاً همه‌ی شما تو منبرها شنیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.28,
   "end": 219.28,
   "text": "و میخوام اون انتهای این روایتو که مرحوم مجلسی در کتاب چهارده معصومش آورده که بی‌ارتباط با امروز هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.28,
   "end": 223.16,
   "text": "روز صدیقه طاهره و امیرالمؤمنین ازدواج این دو بزرگوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.16,
   "end": 225.72,
   "text": "و به سهم خودم تبریک میگم به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.72,
   "end": 228.24,
   "text": "این روز بسیار با عظمت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.24,
   "end": 230.36,
   "text": "بسیار روز با عظمت و فرخنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.36,
   "end": 233.26,
   "text": "انشاالله هدیه‌های بزرگ بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.26,
   "end": 237.22,
   "text": ". که تو اون روایت مرحوم مجلسی روایت مفصلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.22,
   "end": 242.3,
   "text": "این متأسفانه معمولاً تو قالب مداحی این گفته میشه که یه اشکی بگیریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.3,
   "end": 246.82,
   "text": "که در روز قیامت وقتی حضرت خدای منان رو می‌کنه به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.82,
   "end": 251.46,
   "text": "صدیقه طاهره سلام الله علیها که فاطمه‌جان تو چی میخوای از من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.46,
   "end": 256.86,
   "text": "خلاصه کار به اینجا میره که-- می‌رسه که خانم در مقام شفاعت کبرا قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.86,
   "end": 259.04,
   "text": "و خدا میگه هرکیو میخوای تو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.04,
   "end": 262.78,
   "text": "امام باقر صلوات الله علیه میفرما-- دارم من مختصر دارم می‌کنم روایتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.78,
   "end": 265.06,
   "text": "اصل اون قصه آخر رو میخوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.06,
   "end": 269.14,
   "text": "آخر روایت چیه. امام باقر صلوات الله علیه می‌فرماید مثل مرغی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.14,
   "end": 275.5,
   "text": "دانه‌های خوب و بد رو از لای شنزار و این سنگ و کلفت‌ها بر می‌داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.5,
   "end": 281.4,
   "text": "یک یک شیعیان و محبینش رو حضرت زهرا از صحنه‌ محشر انتخاب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.4,
   "end": 284.42,
   "text": "و وارد بهشت می‌کنه. جالب اینجاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.42,
   "end": 288.98,
   "text": "اینجای روایت میگه وقتی بهشتی‌ها، شیعیان و محبین وارد بهشت شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.98,
   "end": 291.72,
   "text": "یه تأملی می‌کنند اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.72,
   "end": 294.12,
   "text": "که انگار که یه ت-- مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.12,
   "end": 296.46,
   "text": "توقعی از خدا دارن، یه نگاهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.46,
   "end": 299.16,
   "text": "بالاخره اینا صاحبان سختی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.16,
   "end": 302.7,
   "text": "سختی کشیدن تو دنیا خیلی زحمت کشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.7,
   "end": 308.54,
   "text": "صاحبان ولایت، خب. خدا تو این روایت می‌فرماید، خدا بهشون میگه چی می‌خواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.54,
   "end": 310.76,
   "text": "چتونه شما؟ چه تأمل کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.76,
   "end": 317.58,
   "text": "برید دیگه بهشتو. اینا میگن که خدایا ما دوست داریم ما دیدیم حضرت زهرا سلام الله علیها ما رو شفاعت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.58,
   "end": 320.2,
   "text": "خب مقام خانم که شفاعت کبراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.2,
   "end": 326.54,
   "text": "مقام ما رو هم مشخص کن. ما می‌خوایم اینجا منزلتی که ما پیش تو داریم هم معلوم بشه تو چشم همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.54,
   "end": 328.62,
   "text": "انقدر که اینا تو این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.62,
   "end": 333.04,
   "text": "انگشت نما شدن، فحش شنیدن، ناسزا شنیدن، انقدر اذیت شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.04,
   "end": 335.48,
   "text": "همیشه هم در اقلیت بودن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.48,
   "end": 339.18,
   "text": "همین الان هشت میلیارد چقدر آدم رو زمینه چند تا شیعه‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.18,
   "end": 345.46,
   "text": "خیلی قلیل. حالا اینجا خدا می‌فرماید خب می‌خواید منزلت شما رو به رخ بکشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.46,
   "end": 348.46,
   "text": "برگردید تو صحنه‌ محشر نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.46,
   "end": 352.2,
   "text": "هرکی که به شما یه جرعه آب داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.2,
   "end": 354.76,
   "text": "به-- اونم خیلی قیدش خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.76,
   "end": 356.3,
   "text": "یه جرعه آب داده به خاطر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.3,
   "end": 359.56,
   "text": "به خاطر محبت فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.56,
   "end": 364.14,
   "text": "یه طعام به شما خورونده به خاطر محت-- محبت فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.14,
   "end": 366.86,
   "text": "اینجا محور رو فاطمه بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.86,
   "end": 373.28,
   "text": "فاظ- فاطم، فاطمه و ابوها و بعلها و بنوها محور قرار گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.28,
   "end": 377.12,
   "text": "از شما غیبتی و بدی رو دفع کرده به خاطر فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.12,
   "end": 380.24,
   "text": "لباسی به شما پوشونده به خاطر فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.24,
   "end": 383.72,
   "text": "همه اینا رو بردارید انتخاب کنید، بردارید بیارید با خودتون بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.72,
   "end": 390.36,
   "text": "اینا این کارو انجام میدن. بعد امام باقر صلی الله علیه این نهی به اینجا من مقصودم اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.36,
   "end": 393.44,
   "text": "خب اینجا کارمون شیرین شد اما حواسمون به آخر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.44,
   "end": 396.08,
   "text": "بحث ما قلب مشکوک و شکاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.08,
   "end": 398.52,
   "text": "مردد و در ریب و شک و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.52,
   "end": 403.2,
   "text": "حضرت می‌فرماید همه رو انتخاب می‌کنند می‌برن تو بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.2,
   "end": 405.68,
   "text": "الا سه دسته می مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.68,
   "end": 408.9,
   "text": "مشرکین، کفار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.9,
   "end": 411.48,
   "text": "اونایی که شکاک بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.48,
   "end": 415.4,
   "text": "قلب شکاک داشتن، قلب مردد داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.4,
   "end": 419.8,
   "text": "مردد بودن. همش سوءظن داشتن به هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.8,
   "end": 424.68,
   "text": "آقا اومده هیاتشم میاد از برکات ولایت هم داره بهره می‌گیره مسجد و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.68,
   "end": 432.68,
   "text": "اصلا زندگیش هم هرچی که داره از ولایت داره از این راه داره از برکت این انقلاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.68,
   "end": 436.54,
   "text": "باز می‌بینی مشکوکه، باز مردده، باز گرفتاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.54,
   "end": 440.36,
   "text": "باز اصلا در مقام دفاع از حقایق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.36,
   "end": 443.36,
   "text": "همین طوری می‌شنوه و بله هم تازه متأسفانه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.36,
   "end": 446.28,
   "text": "چیزی که نمی-- همین طوری. این خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.28,
   "end": 451.54,
   "text": "خیلی خطرناکه. در مقام دفاع چون ولایت تو سه بخش باید تعریف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.54,
   "end": 454.36,
   "text": "التزام در سه بخش قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.36,
   "end": 457.62,
   "text": "که معمولا دارید. الحمد لله داریم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.62,
   "end": 461.6,
   "text": "بعد عمل به ارکان اعضا و جوارح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.6,
   "end": 463.82,
   "text": "بعد لسان مخصوصا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.82,
   "end": 467.26,
   "text": "مخصوصا لسان. عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.26,
   "end": 469.62,
   "text": "قلب، لسان. اینا باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.62,
   "end": 472.82,
   "text": "اگه اینا یه دونه‌ش نباشه ولایت کامل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.82,
   "end": 475.24,
   "text": "خب پس این نشون میده که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.24,
   "end": 477.84,
   "text": "شکاک مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.84,
   "end": 486.62,
   "text": "توی روایت حالا اون مشرکین رو منافق فرمودن که کافر و منافق و حالا مقصود ما اون شکاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.62,
   "end": 490.4,
   "text": "شکاک خیلی خطر بزرگیه و ما عرض کردیم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.4,
   "end": 493.42,
   "text": "نجات از شک جلسه پیش عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.42,
   "end": 495.54,
   "text": "باید چیکار کرد یادتون هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.54,
   "end": 498.74,
   "text": "مثلا یادتون هستش که مثلا دیشب شام چی خوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.74,
   "end": 505.26,
   "text": "ما عرض کردیم که برای نجات از شک مهم‌ترین راه اینه که خودتو تحویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.26,
   "end": 508.08,
   "text": "یک ولی خدا بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.08,
   "end": 514.54,
   "text": "تحویل بدی. خب رأس همه اولیاء الله خاتم الاولیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.54,
   "end": 516.68,
   "text": "و الاوصیا کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.68,
   "end": 521.64,
   "text": "خاتم الاوصیا آقا حضرت بقیةالله الاعظم آدم خودشو تحویل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.64,
   "end": 524.88,
   "text": "ما گفتیم نماز استغاثه سؤال کردن کدوم نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.88,
   "end": 527.04,
   "text": "منظورتون نماز امام حسن نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.04,
   "end": 529.82,
   "text": "نماز استغاثه به امام حسن اونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.82,
   "end": 532.62,
   "text": "دوره که از نماز می‌خونی زیر آسمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.62,
   "end": 536.82,
   "text": "کبود و بعد آخرش سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.82,
   "end": 539.9,
   "text": "الکامل و تا اون و اون دعای بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.9,
   "end": 541.66,
   "text": "بعد اون خیلی نماز عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.66,
   "end": 545.42,
   "text": "خب گفتیم یک بار اینو بخونید خودتونو تحویل به آقا بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.42,
   "end": 547.64,
   "text": "بگید آقا بسم الله ما اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.64,
   "end": 552.84,
   "text": "تحویل ولی خدا. از آقا بخوایم دست ما رو بگذاره تو دست یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 552.84,
   "end": 557.7,
   "text": "اون اولیایی که تحت امر حضرت هستند و بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.7,
   "end": 564.16,
   "text": "حلقه‌هایی که شعون مرتبط به حضرت بقیةالله رو در نظام عالم دارن تدبیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.16,
   "end": 566.96,
   "text": "ائمه اطهار، ابدال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.96,
   "end": 568.94,
   "text": "نجبا، صلحا، اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.94,
   "end": 572.84,
   "text": "اینا صاحبان امت که بحثشون گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.84,
   "end": 576.66,
   "text": "که این نشون میده که واقعاً ما آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.66,
   "end": 581.14,
   "text": "تو قلب مردد و شکاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.14,
   "end": 582.78,
   "text": "حساسیت داریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.78,
   "end": 585.38,
   "text": "اگه داریم بسم الله پناه ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.38,
   "end": 588.42,
   "text": "چرا همش میگی الهی لا تکلنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.42,
   "end": 590.58,
   "text": "الى نفسي طرفة عين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.58,
   "end": 593.28,
   "text": "أبدا. یک آن منو رها نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.28,
   "end": 598.66,
   "text": "یک آن تمومه. این شک و ریب، موج شک و ریب میاد آدمو بیچاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.66,
   "end": 601.2,
   "text": "و چه کسی بهتر از امام برای پناه بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.2,
   "end": 604.0,
   "text": "یه حدیث تقدیم کنم ببینید چقدر این حدیث زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.0,
   "end": 606.42,
   "text": "امام رضا قربونش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 606.42,
   "end": 608.98,
   "text": "خوش به حال اونا که الان حرمشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.98,
   "end": 614.26,
   "text": "فرمودن الامام. یه رو-- یه خطبه امام رضا در خصوص معرفی امام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.26,
   "end": 617.04,
   "text": "این خطبه رو بخونید خیلی شیرینه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 617.04,
   "end": 621.62,
   "text": "بعضی از علما دیدم چندین جلسه این خطبه رو شرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 621.62,
   "end": 627.14,
   "text": "یه بخشش می‌فرماید الامام مفزع العباد في الداهية الناد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.14,
   "end": 633.02,
   "text": "الله اکبر. می‌فرماید امام پناهگاه عباده، نه شیعه و مویه پا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 633.02,
   "end": 639.18,
   "text": "عباد. همه، همه، همه حتی معذرت میخوام حیوانات به امام پناه می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.18,
   "end": 641.28,
   "text": "اون پنجره فولاد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.28,
   "end": 643.3,
   "text": "حالا توی نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.3,
   "end": 647.0,
   "text": "تاریخش خوندید که اصلا چی شد این پنجره فولاد بنا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.0,
   "end": 651.34,
   "text": "یه شتر رو میان توی حالا اون باغ مخصوص به حضرت نگهداری می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.34,
   "end": 653.82,
   "text": "میان میگن پیر شده ذبحش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.82,
   "end": 655.6,
   "text": "بعد میان که ذبحش کن فرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.6,
   "end": 660.12,
   "text": "همه همه کنن میاد زانو می‌زنه جلو اینجایی که الان پنجره فولاد هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.12,
   "end": 662.16,
   "text": "و میگن این دیگه آزاد شده امام رضاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.16,
   "end": 666.44,
   "text": "می‌برن تو باغ همونجا می‌ذارن تا آخر عمرش بچره برا خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 666.44,
   "end": 670.56,
   "text": "دیگه اونجا پنجره فولاد میایین گره می‌بندن رو به رو حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 670.56,
   "end": 672.72,
   "text": "اینها حیوان پناه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.72,
   "end": 675.68,
   "text": "معذرت میخوام ما چرا نبریم؟ میگه عباد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 675.68,
   "end": 678.18,
   "text": "همه. اون آیه‌ای که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 678.18,
   "end": 684.9,
   "text": "قل بگو پیغمبر یا عبادی الذین اسرفوا علی انفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 684.9,
   "end": 687.36,
   "text": "خودتو اینجا منفك نکنی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 687.36,
   "end": 691.48,
   "text": "اینجا باز میگه بندگان منم اسرفوا علی انفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 691.48,
   "end": 695.16,
   "text": "خیلی گناه کردن اما باز خدا چه غیرتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 695.16,
   "end": 698.6,
   "text": "این ربوبیت حق. میگه بندگان من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 698.6,
   "end": 703.14,
   "text": "به کی جز من پناه ببرن؟ کیو ما داریم جز خدا و امام عصرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 703.14,
   "end": 705.7,
   "text": "این عبادی رو بذار کنار اون عباد تو اون روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 705.7,
   "end": 715.8,
   "text": "این عبادی قرآن یا عبادی الذین اسرفوا علی انفسهم لا تقنطوا من رحمة الله إن الله يغفر الذنوب جميعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 715.8,
   "end": 719.8,
   "text": "تو دل بده، تو خودتو تقدیم کن همه گذشته رو خدا می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 719.8,
   "end": 722.8,
   "text": "التائب من الذنب کمن لا ذنب له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 722.8,
   "end": 726.62,
   "text": "حدیثه. خودش محو اثبات رو دست خودشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 726.62,
   "end": 729.12,
   "text": "محو می‌کنه. حالا رو بحث محو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 729.12,
   "end": 732.7,
   "text": "حرف داریم که تو بحث فلسفه یه مقدار ترسناکه، خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 732.7,
   "end": 735.31,
   "text": "ولا بماند پس ملجأ همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.31,
   "end": 738.53,
   "text": "اونم تو چی؟ در رنج و سختی‌های عظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 738.53,
   "end": 741.31,
   "text": "\"فدائهت الناد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 741.31,
   "end": 744.53,
   "text": "تو سختی‌های بزرگ پناهگاه امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 744.53,
   "end": 752.55,
   "text": "خب چه سختی بزرگتر از این که قلب ما دچار شک و تردید و ریب و ترید اینا چیزا بشه که پدر ایمان رو در میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 752.55,
   "end": 758.07,
   "text": "پدر ایمان. چون تو آیه‌ای که خوندیم مبنای بحث قرار دادیم می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.07,
   "end": 761.93,
   "text": "\"انما یستهزنو کم\" رو اون کافه الان موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 761.93,
   "end": 764.59,
   "text": "می‌خوان از تو جدا بشن از تو عذر می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 764.59,
   "end": 768.93,
   "text": "\"کیا الذین لا يؤمنون بالله واليوم الآخر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 768.93,
   "end": 772.09,
   "text": "یعنی بیچاره می‌کنه این خطر ریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 772.09,
   "end": 774.87,
   "text": "یعنی ایمان را از انسان سلب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 774.87,
   "end": 777.33,
   "text": "و تا ما پناه به امام عصر نبریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 777.33,
   "end": 785.71,
   "text": "تا امام عصر دست دعا برای ما برنداره، آن به آن حضرت به فکر و به یاد ما نباشه، ما بیچاره‌ترین‌هاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 785.71,
   "end": 792.05,
   "text": "در اون مناجات اینو هم تقدیم می‌کنم حالا چون روز عید هست کامتون شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 792.05,
   "end": 799.15,
   "text": "که در اون مناجاتی که سعید ابن طاووس داره میگه تو سرداب مقدس سامرا رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 799.15,
   "end": 802.87,
   "text": "یه مناجاتی هست که معمولا تو مداحی هم به شما میگم که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 802.87,
   "end": 807.31,
   "text": "عصر تو سرداب، سعید ابن طاووس میگه میخکوب شدم رو اون پله‌ها نشستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 807.31,
   "end": 811.29,
   "text": "دیدم آقا امام عصر داره در دل سحر با خدا مناجات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.29,
   "end": 816.95,
   "text": "خدا رو قسم می‌ده به جدش، به مادرش، به پدرش، به امام حسن، به امام حسین این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 816.95,
   "end": 820.57,
   "text": "که بعد آخرش میگه که ببخش گناهان شیعیان ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 820.57,
   "end": 825.21,
   "text": "اون یه مناجاته. یه مناجات دیگه داره باز اینم سعید ابن طاووس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.21,
   "end": 828.71,
   "text": "خیلی سنگین. یه بخشی‌ش رو من به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 828.71,
   "end": 831.75,
   "text": "امام عصر داره می‌فرماید که \"اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 831.75,
   "end": 839.27,
   "text": "ان شیعتنا خلقت من شعاع انوارنا و بقیت طینتنا\" که این افتخار من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 839.27,
   "end": 844.75,
   "text": "حالا اینجاشو داشته باش. این شیعه‌ی ما رو خدایا من یه خواهشی از تو در موردشون دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 844.75,
   "end": 848.81,
   "text": "\"و قد فعلوا ذنوبا كثيرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 848.81,
   "end": 853.15,
   "text": "اینا قطعا یک \"ذنوبا كثيرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 853.15,
   "end": 857.29,
   "text": "یه گناهان زیاد کثیری دارن، انجام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 857.29,
   "end": 859.69,
   "text": "چرا؟ چرا این گناه رو انجام دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 859.69,
   "end": 862.89,
   "text": "\"اتکالا علی حبنا و ولایتنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 862.89,
   "end": 867.33,
   "text": "الله اکبر. به پشتوانه‌ی حب و ولایت ما گناه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 867.33,
   "end": 869.35,
   "text": "گفتن خدا می‌بخشه، خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 869.35,
   "end": 873.57,
   "text": "محب علی رو می‌بخشه. امام عصر داره تو دل سحر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 873.57,
   "end": 877.51,
   "text": "تو سرداب با خدا میگه خدا به این خاطر گناه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 877.51,
   "end": 881.17,
   "text": "\"فان كانت ذنوبهم بینک و بینهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 881.17,
   "end": 886.47,
   "text": "اینکه این اگه گناهایی که اینا کردن بین تو و اوناست یعنی حق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 886.47,
   "end": 890.11,
   "text": "به تو ربط داره \"فسفه عنهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 890.11,
   "end": 894.51,
   "text": "ببخش. اینا رو پاک کن، پاکشون کن \"فسفه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 894.51,
   "end": 897.29,
   "text": "بالاتر از بخششه. یعنی اصن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 897.29,
   "end": 900.51,
   "text": "پاکش کن اصن انگار نبوده. به خاطر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 900.51,
   "end": 904.85,
   "text": "\"فقد رضینا\" که اگه این کارو بکنی \"رضینا\" ما راضی می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 904.85,
   "end": 906.91,
   "text": "تو هم که دوست داری مهدی رو راضی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 906.91,
   "end": 911.27,
   "text": "اِ چجوری دلبری کرده از خدا امام عصر برای من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 911.27,
   "end": 913.51,
   "text": "بعد پناه نبری به همچین آقایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 913.51,
   "end": 917.55,
   "text": "بعد ادامه می‌فرماید. بعد بالاخره این حق الله حق الناس رو چی کار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 917.55,
   "end": 920.19,
   "text": "الله اکبر. این حدیثو نمیشه هرجا گفت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 920.19,
   "end": 925.09,
   "text": "بعد پر رو می‌کنه آدما رو. \"وما کان فینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 925.09,
   "end": 928.93,
   "text": "و ما کان منها فيما بینهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 928.93,
   "end": 933.09,
   "text": "اگر این گناه‌هایی که کردن بین خودشونه یعنی توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 933.09,
   "end": 936.17,
   "text": "حق الناس. اینجا چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 936.17,
   "end": 940.63,
   "text": "حضرت عرض می‌کنه به خدا \"فصلح بینهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 940.63,
   "end": 943.99,
   "text": "بینشون صلح و آشتی برقرار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 943.99,
   "end": 947.43,
   "text": "درستش کن اینطوری. \"وقاسبها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 947.43,
   "end": 955.91,
   "text": "الله اکبر. \"وقاسبها من خمسنا و ادخلهم الجنة و زهزههم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 955.91,
   "end": 962.29,
   "text": "و زهزههم ان النار و لا تجمع بینهم و بین اعدائنا فی سخطک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 962.29,
   "end": 967.11,
   "text": "خدایا اون گناهانی که بین خودشونه، حق الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 967.11,
   "end": 975.27,
   "text": "از اون خمس ما حق ما که تو حق ما قرار دادی \"وقاسبها عن خمسنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 975.27,
   "end": 977.85,
   "text": "از خمس ما به این‌ها ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 977.85,
   "end": 984.05,
   "text": "از حق ما به این‌ها برسون از خزانه‌ی غیبت که این‌ها راضی بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 984.05,
   "end": 986.17,
   "text": "این‌ها همدیگه رو از هم راضی بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 986.17,
   "end": 992.05,
   "text": "صاحبان حق از محبین و شیعیان ما راضی بشن از حق ما به اون‌ها ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 992.05,
   "end": 996.67,
   "text": "الله اکبر. که بعد میگه اینا رو وارد بهشت کن با دشمنمون یه جا قرار نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 996.67,
   "end": 1005.61,
   "text": "الا آخر. خب شما بفرمایید در این روز تزویج آقامون امیرالمؤمنین و حضرت زهرا که یک ثمره‌ی وجودشون آقا بقیت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1005.61,
   "end": 1008.45,
   "text": "ما پناه نبریم به این خانواده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1008.45,
   "end": 1011.79,
   "text": "کی دیگه پناه ببریم؟ امروز روز اول ذی الحجه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1011.79,
   "end": 1021.59,
   "text": "ایام الله و الفجر و لیالی نعش بعض تفاسیر فرمودن همین ده شب، ده شب و روز اول ماه ذی الحجه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1021.59,
   "end": 1023.77,
   "text": "خیلی важное هست این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1023.77,
   "end": 1026.61,
   "text": "خب از امروز پناه ببریم. بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1026.61,
   "end": 1028.69,
   "text": "ان شا الله که عاقبتmon خط به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1028.69,
   "end": 1033.83,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}