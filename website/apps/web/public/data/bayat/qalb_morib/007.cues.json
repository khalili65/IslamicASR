   "start": 1009.05,
   "end": 1059.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 5.58,
   "text": "و ربانی آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.58,
   "end": 10.72,
   "text": "استفتاء شده از رهبر عزیزمون که این نوشابه‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.72,
   "end": 13.52,
   "text": "معمول هست در بازار و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.52,
   "end": 16.76,
   "text": "که بعدش دلستر هم بهش اضافه شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.76,
   "end": 23.46,
   "text": "این‌ها اینطوری میگن که مواد اولیش رو از خارج از کشور میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.46,
   "end": 32.12,
   "text": "خب؟ و میگن که این مواد اولیه که از خارج از کشور میارن درش الکل مایع و این‌ها وجود داره و ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.12,
   "end": 36.74,
   "text": "بالاخره اینا نجس نیست. آقا صراحتا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.74,
   "end": 44.24,
   "text": "مطلقا پاکند اینا. مگر اینکه برای خود شخص شخصا یقین حاصل بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.24,
   "end": 48.32,
   "text": "که اون مواد اولیه‌ای که در این نوشابه‌ها ریختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.32,
   "end": 55.94,
   "text": "الکل درشه، مسکننده مواد مسکننده درشه که البته اون هم جا-- مایع هستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.94,
   "end": 59.22,
   "text": "در خصوص آیه شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.22,
   "end": 64.46,
   "text": "چهل و پنج سوره توبه عرض شد \"إنما يستأذنك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.46,
   "end": 66.92,
   "text": "رو اون کاف ما فعلا موندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.92,
   "end": 73.14,
   "text": "که این‌ها منحصرا فقط و فقط \"يستأذنك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.14,
   "end": 77.84,
   "text": "از تو ، اذن می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.84,
   "end": 80.04,
   "text": "که درش جنگ شرکت نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.04,
   "end": 84.14,
   "text": "یعنی موضوع بحث موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.14,
   "end": 88.36,
   "text": "اصلا آیه همون ابتدا جدایی از توئه یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.36,
   "end": 92.46,
   "text": "اون کاف مخاطب حرف رو اون پیاده داره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.46,
   "end": 97.86,
   "text": "حالا علتشم عرض کردیم اینه که \"الذین لا يؤمنون بالله واليوم الآخر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.86,
   "end": 99.5,
   "text": "چون اینا دل ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.5,
   "end": 103.96,
   "text": "اتفاقا تو اون آیه نه سوره اسرا که دیروز عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.96,
   "end": 109.46,
   "text": "که \"إن هذا القرآن\" عرض کردیم هذا مهمه، القرآن مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.46,
   "end": 112.38,
   "text": "\"يهدي للتي هي أقوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.38,
   "end": 115.44,
   "text": "که ریشه همه قوام‌ها اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.44,
   "end": 117.76,
   "text": "همه به این قوام دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.76,
   "end": 122.52,
   "text": "آخرش می‌فرماید \"ويبشر المؤمنين\"؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.52,
   "end": 124.76,
   "text": "مؤمنین، اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.76,
   "end": 127.78,
   "text": "توجه کردین؟ یعنی این قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.78,
   "end": 132.52,
   "text": "برای کسی این هدایتگری رو داره که دل داده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.52,
   "end": 135.26,
   "text": "در سوره بقره هم که می‌فرمود دیگه \"الم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.26,
   "end": 140.16,
   "text": "را لک الكتاب لا ريب فيه هدى للمتقين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.16,
   "end": 144.78,
   "text": "برای اهل تقواست. این یه بستریه، یه مبنای کلیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.78,
   "end": 147.96,
   "text": "همه رو باید لحاظ کنیم. میگه آقا چرا من ذکر گفتم اثر نکرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.96,
   "end": 150.92,
   "text": "چون فرمودید چهل روز این کارو بکن قطعا اثر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.92,
   "end": 153.22,
   "text": "این همه چله، چله، خطومات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.22,
   "end": 155.7,
   "text": "ها؟ چرا نمی‌کنه؟ سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.7,
   "end": 164.82,
   "text": "خب این قرآن اصول و امهات قرآن که یه جلسه دربارش مفصل از نظرات علامه بهبهانی صحبت کردیم خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.82,
   "end": 166.78,
   "text": "باید ما انسان اصولی بار بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.78,
   "end": 171.34,
   "text": "تو نقطه، نقطه زندگیمون اصول و امهات داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.34,
   "end": 174.62,
   "text": "بعد فرعیات به دنبالش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.62,
   "end": 177.26,
   "text": "اصل قرآنه که باز میگه \"إنما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.26,
   "end": 181.54,
   "text": "فقط و فقط \"يتقبل الله\" خدا فقط از کیا قبول می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.54,
   "end": 183.78,
   "text": "\"من المتقين\". تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.78,
   "end": 186.52,
   "text": "تموم. یه اصل کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.52,
   "end": 191.02,
   "text": "یعنی اگر کسی رعایت حدود الهی رو انجام نده...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.02,
   "end": 195.04,
   "text": "حالا دیشب ما رفته بودیم یه جایی تو خیابون یکی اومد جلو ما رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.04,
   "end": 197.22,
   "text": "اصلا نگاهش عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.22,
   "end": 202.8,
   "text": "سنش هم بالا بود. گفت حاج آقا من اصلا آخوند می‌بینم خوشم میاد برعکس خیلی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.8,
   "end": 204.58,
   "text": "اصلا دوست داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.58,
   "end": 207.54,
   "text": "اصلا شما رو دیدم نتونستم برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.54,
   "end": 210.88,
   "text": "بعد تازه بابام آخوند بوده این و تبار فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.88,
   "end": 213.96,
   "text": "یعنی عالم‌دیده بود. گفتم که خب حالا چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.96,
   "end": 216.02,
   "text": "ما خوشحال شدیم چهره نورانی شما رو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.02,
   "end": 218.96,
   "text": "گفت نه دوست دارم یه حرفی از شما ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.96,
   "end": 225.96,
   "text": "فرقو ببین. یکی لباس هیئت دین رو می‌بینه نماد عقل و این عمامه نماد عقله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.96,
   "end": 228.58,
   "text": "امام حسین تو کربلا گذاشت سرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.58,
   "end": 232.84,
   "text": "عمامه پیغمبر رو رفت جلو یعنی می‌خواد بگه که ما نماد عقلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.84,
   "end": 236.68,
   "text": "من فرزند همون عقل کلم، عقل اولم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.68,
   "end": 239.68,
   "text": "و یکی اینطوری فحش میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.68,
   "end": 242.84,
   "text": "دری وری میده یکم نه به این صورت می‌خواد بهره ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.84,
   "end": 246.48,
   "text": "نمی‌خواد دست خالی بره. گفت تقوا رو به من معنا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.48,
   "end": 249.14,
   "text": "من خیلی کتاب خوندم اما به اونجا نرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.14,
   "end": 252.5,
   "text": "بعد شروع کردم از جهت حکم این اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.5,
   "end": 254.9,
   "text": "از براش تقوا رو جا انداختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.9,
   "end": 256.7,
   "text": "خب اشکش دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.7,
   "end": 259.92,
   "text": "تنش لرزید. گفت حاج آقا تن من لرزوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.92,
   "end": 263.84,
   "text": "گفتم من نلرزوندم. این مباحث داره می‌لرزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.84,
   "end": 266.9,
   "text": "به هر حال تقوای اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.9,
   "end": 269.12,
   "text": "که رعایت حدود الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.12,
   "end": 274.44,
   "text": "یعنی در حد اون وسطش که الان میگه نه خیلی پایین، نه خیلی بالا ترجمه کردن آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.44,
   "end": 277.52,
   "text": "جوادی آملی فرمودن رعایت حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.52,
   "end": 279.78,
   "text": "حالا اگر کسی اینو رعایت نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.78,
   "end": 286.48,
   "text": "الان دستورالعملی که از حضرت علامه پیرامون قرآن می‌خوایم عرض کنیم و هزاری هم انجام بده هیچ اثری نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.48,
   "end": 290.4,
   "text": "تازه خسته میشه. پس اون بسترها باید لحاظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.4,
   "end": 292.6,
   "text": "خب ورتابت قلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.6,
   "end": 298.5,
   "text": "این باعث میشه که یعنی علت اصلی که می‌خوان از تو جدا بشن چون در شک‌اند، در ریب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.5,
   "end": 301.0,
   "text": "\"فهم فی ریبهم یترددون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.0,
   "end": 305.34,
   "text": "اگر از این تزلزل و شک خارج نشن که دیروز بحثش بود شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.34,
   "end": 313.3,
   "text": "تزلزل میاره، تزلزل، شک میاره این‌ها \"يترددون\" همیشه مردد می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.3,
   "end": 317.44,
   "text": "این صفت منافقینه. حالا ما عرض کردیم که تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.44,
   "end": 321.28,
   "text": "سیر بحث عرض کردیم که چون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.28,
   "end": 327.14,
   "text": "اون کاف مخاطبی \"يستأذنك\" است پس راهش اینه که ما اگر می‌خوایم از قلب مروب نجات پیدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.14,
   "end": 330.16,
   "text": "خودمون رو تحویل حجت خدا بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.16,
   "end": 332.64,
   "text": "در خصوص این یه مقدار صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.64,
   "end": 336.44,
   "text": "ذهن‌ها، نگاه‌ها می‌گفت که آقا حجت خدا کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.44,
   "end": 339.34,
   "text": "ولمون کن داریم بیچاره میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.34,
   "end": 343.78,
   "text": "ها؟ عزيز علي عن الخلق ولا ترا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.78,
   "end": 348.78,
   "text": "نمی‌دونم هل الیک يا ابن احمد سبيل الفتقی این همه ندبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.78,
   "end": 354.28,
   "text": "ناله، za فلان. حواسش هم نیست که اصل-- اساسا اصل زیارت همون زیارت قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.28,
   "end": 356.04,
   "text": "اصل توجه قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.04,
   "end": 358.72,
   "text": "اصل اتصال وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.72,
   "end": 361.72,
   "text": "ولی حالا خیلی‌ها جسما در کنار اون‌ها بودن و خبری نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.72,
   "end": 364.96,
   "text": "البته اون هم مراتب محفوظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.96,
   "end": 367.02,
   "text": "خب بعد گفتیم که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.02,
   "end": 373.32,
   "text": "در جواب این قبیل سوالات و این نگاه‌ها که خب حالا حجت خدا کو که ما بریم خودمون رو تحویل بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.32,
   "end": 375.34,
   "text": "عرض کردیم که قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.34,
   "end": 379.54,
   "text": "صورت کتبیه یا شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.54,
   "end": 385.7,
   "text": "کتبیه انسان کامل یا امام عصر ص-- صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.7,
   "end": 391.62,
   "text": "حالا این یعنی چی؟ یعنی اینکه اگر شما میخوای مختصات یه نفر الان بیاد به ما بگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.62,
   "end": 397.64,
   "text": "امام عصر تو به من معرفی کن یه مکتوبه‌ای، یه نوشته‌ای، یه چیزی که مختصات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.64,
   "end": 401.82,
   "text": "مشخصات و مرام‌نامه امام عصرت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.82,
   "end": 405.88,
   "text": "من اینو بشناسم این آقا کیه؟ میگیم به فرموده قرآن، قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.88,
   "end": 409.76,
   "text": "اگر انسان کامل کتاب بشود می‌شود قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.76,
   "end": 414.88,
   "text": "خب حالا عرض هم کردیم که قرآن اون صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.88,
   "end": 419.9,
   "text": "که شرح متن وجود امام عصر و انسان کامل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.9,
   "end": 428.46,
   "text": "از اون اعلی مرتبه که علم ذاتی حضرت حق و صورت علمیه حضرت حق است باید گرفته بشه تا این انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.46,
   "end": 432.66,
   "text": "اینجاها رو عرض کردیم که اینا رو باید یکپارچه با هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.66,
   "end": 436.08,
   "text": "حالا این چنین اگر میخوای قرآن بخونی فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.08,
   "end": 441.38,
   "text": "بله ابتدا باید شروع کرد مثلا فرمایش حضرت امیر صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.38,
   "end": 444.86,
   "text": "به پسرشون محمد بن حنفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.86,
   "end": 447.82,
   "text": "فرمودن که آقا شما حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.82,
   "end": 453.08,
   "text": "دلیل اینم که منتسبش میدن به حنفیه محمد رو نه به مولا می‌دونید اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.08,
   "end": 457.88,
   "text": "مادر ایشون که با حضرت امیر صلوات الله علیه ازدواج کرد قبلا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.88,
   "end": 459.52,
   "text": "مردی داشت که از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.52,
   "end": 461.9,
   "text": "اون مرده حنفیه بود اسمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.9,
   "end": 466.06,
   "text": "دیگه این آقا رو ملقب کردن به محمد حنفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.06,
   "end": 468.88,
   "text": "چون مادر ایشون قبلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 468.88,
   "end": 471.58,
   "text": "شوهری داشت که از دنیا رفت به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.58,
   "end": 475.04,
   "text": "حنفیه و الا ایشون فرزند مولا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.04,
   "end": 481.24,
   "text": "در هر حال آقا به ایشون فرمود مبادا پسرم شبانه روزی بر تو بگذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.24,
   "end": 486.42,
   "text": "وای بر من و امثال من بر تو بگذرد که در محضر قرآن نباشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.42,
   "end": 489.22,
   "text": "حداقل پنجاه آیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.22,
   "end": 491.8,
   "text": "روز در محضر قرآن باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.8,
   "end": 493.54,
   "text": "امام صادق صلوات الله علیه هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.54,
   "end": 496.8,
   "text": "حالا این در محضر قرآن پنجاه آیه باش یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.8,
   "end": 499.66,
   "text": "که البته بعد امیرالمؤمنین سطح بحثو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.66,
   "end": 505.28,
   "text": "چنان میکشه بالا که دیگه آدم کُل و پَ-- کل و پرش به قول معروف میریزه، بار و پرش میریزه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.28,
   "end": 506.98,
   "text": "ما آقا خب پنجاه آیه میخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.98,
   "end": 512.16,
   "text": "بسم الله الرحمن الرحیم. إذا وقعت الواقعة لیس لواقعة حاكمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.16,
   "end": 514.26,
   "text": "همینطور تا صد-- نود و چهار تا آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.26,
   "end": 517.82,
   "text": "بیشتر هم خوندیم یا مولا. نخیر بشین تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.82,
   "end": 522.28,
   "text": "عرض کنیم خدمتتون. مولا فرمودن پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.28,
   "end": 527.14,
   "text": "قیامت که میشه میگن اقرأ برقع عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.14,
   "end": 529.7,
   "text": "یعنی در حقیقت سطح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.7,
   "end": 533.14,
   "text": "درجات بهشت به عدد آیات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.14,
   "end": 535.28,
   "text": "حالا این کلی توش حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.28,
   "end": 542.34,
   "text": "یعنی چی؟ یعنی شش هزار و ششصد و شصت و شش تا مثلا به یک روایت اونجا عدد بگیریم انقدر درجه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.34,
   "end": 547.52,
   "text": "اینکه محدود میشه. هر درجه لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.52,
   "end": 549.34,
   "text": "مثل این دنیای لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.34,
   "end": 554.32,
   "text": "میگه پس چجوری بخوریم به سقف عالم بریم به آخرت بریم به قیامت بریم به برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.32,
   "end": 557.42,
   "text": "میگیم همین دنیای لایتناهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.42,
   "end": 560.8,
   "text": "همین پرده میره کنار باطن این عالمو میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.8,
   "end": 565.16,
   "text": "عالم مثال یعنی مثال این عالمو میبینی میشه برزخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.16,
   "end": 568.62,
   "text": "عقل همین عالمو میبینی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.62,
   "end": 572.96,
   "text": "قیامتت. عالم عقول، ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.96,
   "end": 577.16,
   "text": "الهیت همین عالمو نه که زمین و زمان از بین بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 577.16,
   "end": 580.12,
   "text": "همین عالمو میبینی میشه آخرتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.12,
   "end": 585.06,
   "text": "اینه. حالا اونجا مولا خیلی حرفو سطحو برده بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.06,
   "end": 587.76,
   "text": "پیداست که باید قرآن رو یه طور دیگه خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.76,
   "end": 591.98,
   "text": "در-- بعدم میفرمود در محضر قرآن باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.98,
   "end": 594.42,
   "text": "در محضر قرآن بودن فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.42,
   "end": 596.54,
   "text": "من اینو میخوام خدمتتون عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.54,
   "end": 599.8,
   "text": "حضرت علامه می فرمود حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.8,
   "end": 603.62,
   "text": "بحثو گم نکنیم. برای نجات از قلب شکاک باید چکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.62,
   "end": 605.82,
   "text": "خودمونو در محضر قرآن قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 605.82,
   "end": 609.84,
   "text": "حضرت علامه دو تا روش جانانه ارائه میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 609.84,
   "end": 614.56,
   "text": "که یکیش ظاهریه یعنی به بدن و اینها ربط پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.56,
   "end": 619.56,
   "text": "مس قرآنه که چهارشنبه، پنجشنبه و جمعه‌های درس رو العمل خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.56,
   "end": 622.88,
   "text": "اونو بنا به دلایلی الان عرض نمی‌کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.88,
   "end": 627.36,
   "text": "باید عطشش باشه. اون یکی مربوط به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 627.36,
   "end": 631.32,
   "text": "اون که مربوط به باطنه می فرماید که آقا جان شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.32,
   "end": 637.7,
   "text": "خلوت کن. به هر حال سحر مخصوصا در سکوت، خلوت، تاریکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.7,
   "end": 639.74,
   "text": "میگه که هیچ سر و صدایی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.74,
   "end": 643.18,
   "text": "یه گوشه‌ای در شبانه روز خلوتی داشته باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.18,
   "end": 646.76,
   "text": "و خودت رو در محضر قرآن ارائه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.76,
   "end": 649.08,
   "text": "خودتو تحویل قرآن بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.08,
   "end": 655.16,
   "text": "نه به این نیت بخونی که الان داری قرآن میخونی فیض ببری، ثواب ببری، درجه ببری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.16,
   "end": 657.94,
   "text": "به مقامات برسی، گره‌ات باز شه، مشکلت حل شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.94,
   "end": 659.9,
   "text": "نه که غالبا متاسفانه ما به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.9,
   "end": 663.64,
   "text": "تجارت می‌کنیم با قرآن. نه به این نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.64,
   "end": 667.74,
   "text": "که همون آنی که تو داری قرآن رو میخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.74,
   "end": 673.18,
   "text": "دو مرتبه این آیات بر قلب مقدس پیغمبر نازل بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.18,
   "end": 679.24,
   "text": "از اون حالت از سر پیغمبر و قلب پیغمبر از جان پیغمبر بر عالم عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.24,
   "end": 685.12,
   "text": "و بر مثال و خیال پیغمبر و بر لسان مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 685.12,
   "end": 691.38,
   "text": "در حقیقت از باطن جان پیغمبر این دو مرتبه آیات بیاد سیر نزولی طی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 691.38,
   "end": 693.46,
   "text": "بیاد تبدیل به لفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 693.46,
   "end": 698.34,
   "text": "تو داری میخونی اما یواش یواش اول تو شروع میکنی خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 698.34,
   "end": 707.16,
   "text": "به این نیت سکوت محض شروع کن خوندن که خدا دوباره از لسان پیغمبر داره به تو این آیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 707.16,
   "end": 710.76,
   "text": "قرائت میکنه و تو تلاوت میکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.76,
   "end": 716.0,
   "text": "که حالا فرقی بین تلاوت و قرائت هست که باید قب-- بعدا عرض کنیم الان وقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.0,
   "end": 718.84,
   "text": "که او داره اقرأ میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.84,
   "end": 729.26,
   "text": "املاء میکنه. تو مثل یک درس‌آموزی در مکتب پیغمبر می‌شنوی و در سطر سطر کتاب وجودت اینا رو می‌نویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 729.26,
   "end": 732.29,
   "text": "به این نیت آقا شروع کن بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 732.29,
   "end": 734.47,
   "text": "نگو نمی‌شه مگه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 734.47,
   "end": 738.57,
   "text": "کجا این حرفا چیه آقا جان خب چطور خیلیا رفتن رسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 738.57,
   "end": 741.95,
   "text": "اینی که من به شما الان میگم از باطن قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 741.95,
   "end": 746.43,
   "text": "خدا رو شاهد می‌گیرم از دو لب مبارک خود حضرت علامه شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 746.43,
   "end": 751.61,
   "text": "که ایشون با یک حالت عجیبی و حتی پیاده‌اش کردم نوشتم که چون عدد داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 751.61,
   "end": 755.01,
   "text": "یه وقت اشتباه نکنم. ایشون می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.01,
   "end": 758.53,
   "text": "من تفسیر مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 758.53,
   "end": 761.77,
   "text": "سلطان محمد گنابادی رو که می‌خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 761.77,
   "end": 763.81,
   "text": "تب-- بیان السعادة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 763.81,
   "end": 767.51,
   "text": "یه تفسیر خیلی شیرین و بسیار با عظمتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 767.51,
   "end": 769.55,
   "text": "میگه اونجا رو که می‌خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 769.55,
   "end": 772.63,
   "text": "دیدم که مرحوم گنابادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 772.63,
   "end": 775.27,
   "text": "نوشته که بیان السعادة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 775.27,
   "end": 779.81,
   "text": "اونجا داره بیان می‌کنه که اون پنج آیه اول سوره بقره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 779.81,
   "end": 785.71,
   "text": "ما چند جور می‌تونیم اونو با چند وجه بخونیم که معانی مختلف داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 785.71,
   "end": 789.41,
   "text": "علامه فرمود تازه زعف وجوهشو بذار کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.41,
   "end": 793.53,
   "text": "که هر وجهی تازه لفظ قرآن باطن که چه عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 793.53,
   "end": 797.39,
   "text": "یه معنای خاصی می‌ده. مرحوم گنابادی اینو من از دو لب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 797.39,
   "end": 800.37,
   "text": "حضرت علامه پیاده کردم تو کا-کاغذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 800.37,
   "end": 806.05,
   "text": "می‌فرماید یازده تریلیون و چهارصد و هشتاد و چهار بیلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 806.05,
   "end": 811.31,
   "text": "و دویست و پنج میلیون و هفتصد و هفتاد هزار و دویست و چهل وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 811.31,
   "end": 815.69,
   "text": "قرائت شده. همین پنج آیه اول که هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 815.69,
   "end": 817.89,
   "text": "وجهی یک معنای جدید می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.89,
   "end": 825.09,
   "text": "الله اکبر. بعد خود علامه ادامه داد که دید خب می‌بینه مخاطب متعجب می‌شه میگه مگه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 825.09,
   "end": 829.41,
   "text": "علامه فرمود چطور یک شکل هندسی قطاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 829.41,
   "end": 836.19,
   "text": "نیم میلیون وجه حتی عددشم من نوشتم چهارصد و نود و هفت هزار و ششصد و شصت و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 836.19,
   "end": 839.11,
   "text": "حکم هندسی مرحوم خواجه طوسی از یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 839.11,
   "end": 846.21,
   "text": "شکل هندسی یا قط-قطاب چیز می‌کنه، استخراج می‌کنه نزدیک نیم میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 846.21,
   "end": 849.47,
   "text": "بعد مثلا آیه قرآن نشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 849.47,
   "end": 855.63,
   "text": "آقا غوغاست وقتی از علم ذاتی حضرت حق نشأت گرفته چرا نباشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 855.63,
   "end": 858.19,
   "text": "خب اونم که لایتناهی‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 858.19,
   "end": 861.37,
   "text": "توجه کردید؟ پس می‌شه باید شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 861.37,
   "end": 867.31,
   "text": "چطور خیلیا رفتن؟ چرا رفتن رسیدن بعد ما هنوز تو ظاهر قرآن گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.31,
   "end": 870.33,
   "text": "باید خودمون رو در محضر قرآن تحویل بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 870.33,
   "end": 873.43,
   "text": "این شیوه‌هایی هم که حضرت علامه و امثالهم میگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.43,
   "end": 876.21,
   "text": "خودشون چشیدن دارن به من و شما میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 876.21,
   "end": 880.21,
   "text": "اینطوری نیست که مثل من بیان زباط باشن هر چیزی رو ضبط کنن به شما بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 880.21,
   "end": 882.43,
   "text": "شما بر که برید بچشید و ما رو هم دعا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 882.43,
   "end": 885.27,
   "text": "نه، خودش اول چشیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 885.27,
   "end": 887.81,
   "text": "دارایی‌شو داره در خدمت شما می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 887.81,
   "end": 890.15,
   "text": "در محضر قرآن باید بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 890.15,
   "end": 891.69,
   "text": "باید در محضر قرآن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 891.69,
   "end": 895.85,
   "text": "هیچ راهی هم جز این نیست. علم ذاتی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 895.85,
   "end": 900.43,
   "text": "حالا به هر حال میگه تلاوت کن دیگه اون دیروزم عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 900.43,
   "end": 904.19,
   "text": "حضرت علامه می‌فرمود که قرآن رو تلاوت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 904.19,
   "end": 906.41,
   "text": "عليكم بتلاوت القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 906.41,
   "end": 909.09,
   "text": "اول اینو میگه. تلاوت چه فرقی با قرائت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 909.09,
   "end": 915.19,
   "text": "اینم سریع بگم و بسه. حالا که قشنگ داری نگاه می‌کنی منو گوش میدی معلومه تشنه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 915.19,
   "end": 917.37,
   "text": "تلاوت البته یه بار دیگه هم اینجا عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 917.37,
   "end": 919.97,
   "text": "تلاوت از تلوع میاد، تلوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 919.97,
   "end": 923.23,
   "text": "تلوع یعنی در حقیقت کنار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 923.23,
   "end": 927.61,
   "text": "بغل. شما چایی رو به تنهایی می‌خوری تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 927.61,
   "end": 931.43,
   "text": "وقتی یه قند می‌ذاری کنارش شکر می‌زنی بهش شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 931.43,
   "end": 936.21,
   "text": "وقتی شیرین می‌خوری چای تلخه می‌شه تلاوت چایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 936.21,
   "end": 939.33,
   "text": "و این میگه قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 939.33,
   "end": 943.49,
   "text": "تلاوت کن. یعنی قرآن رو خالی خالی نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 943.49,
   "end": 945.17,
   "text": "توجه کردید؟ جالبه خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 945.17,
   "end": 951.31,
   "text": "مولا علی علیه الصلاة والسلام اونایی که اشکال به این بحث دارن در نهج البلاغه می‌فرماید الحق مر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 951.31,
   "end": 956.49,
   "text": "حق تلخه. اگر حق تلخه، قرآن هم حقه پس تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 956.49,
   "end": 962.71,
   "text": "چه کنیم شیرین بشه؟ مولا می‌فرماید در کنارش عمل بگذار عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 962.71,
   "end": 967.17,
   "text": "یا به عبارتی رعایت حدود الهی که همون تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 967.17,
   "end": 970.17,
   "text": "اگر قرآن رو بدون تقوا خوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 970.17,
   "end": 974.97,
   "text": "اگر قرآن رو بدون عمل خوند سختشه، کسل می‌شه، زود خسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 974.97,
   "end": 979.93,
   "text": "اما اگر کسی به قرآن به آیه آیه اش عمل کرد تقوا رو رعایت کرد شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 979.93,
   "end": 982.65,
   "text": "هی می‌خواد تلاوت کنه. این روشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 982.65,
   "end": 985.85,
   "text": "میگه تلاوت کن نه اینکه قرائت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 985.85,
   "end": 989.17,
   "text": "قرائت اق-- به نحو اقرا و املاء دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 989.17,
   "end": 991.65,
   "text": "اقرأ باسم ربك الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 991.65,
   "end": 993.47,
   "text": "البته اونم معنای باطنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 993.47,
   "end": 996.51,
   "text": "حالا کاری فعلا نداریم. جاش اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 996.51,
   "end": 998.33,
   "text": "اما تلاوت باید بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 998.33,
   "end": 1002.05,
   "text": "باید بچشی. خودمون رو در محضر قرآن قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1002.05,
   "end": 1006.45,
   "text": "وقتی چشیدیم چشیده باعث می‌شه دیگه متزلزل نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1006.45,
   "end": 1011.87,
   "text": "دیگه شک نکنی چون چشیدی. نو-- خط آخر بحثم این خط رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1011.87,
   "end": 1019.25,
   "text": "برید روش فکر کنید. دست رو قرآن می‌ذارم قسم می‌خورم ماحصل پنجاه سال عمرم همین جمله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1019.25,
   "end": 1022.55,
   "text": "فرق ما بین ما و اولیاء الله اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1022.55,
   "end": 1025.33,
   "text": "که اون‌ها آنچه که از حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1025.33,
   "end": 1029.99,
   "text": "و وحی، پیغمبر و قرآن و عترت از حقایق نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1029.99,
   "end": 1033.77,
   "text": "شنیدن رو باور کردن، باور کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1033.77,
   "end": 1036.37,
   "text": "یقین کامل کردن. ما شک داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1036.37,
   "end": 1039.65,
   "text": "تمام. فرق بین ما و اون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1039.65,
   "end": 1041.97,
   "text": "شک ما و یقین اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1041.97,
   "end": 1045.39,
   "text": "که اگر این شک برطرف نشه عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1045.39,
   "end": 1048.33,
   "text": "خدا نکنه که این دیگه انسان رو می‌کشونه به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1048.33,
   "end": 1050.09,
   "text": "أن كذبوا بآيات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1050.09,
   "end": 1051.95,
   "text": "دیگه تکذیب آیات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1051.95,
   "end": 1056.47,
   "text": "این بحث ان‌شاءالله ادامه داره. امیدوارم که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1056.47,
   "end": 1059.91,
   "text": "به برکت صلوات بر محمد و آل محمد. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}