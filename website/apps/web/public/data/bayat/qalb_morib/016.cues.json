 },
 "chapters": [
  {
   "index": 0,
   "title": "## وسواس و حکم طهارت",
   "start": 10.4,
   "end": 57.86
  },
  {
   "index": 1,
   "title": "## ریشهٔ وسواس: توجه به غیر خدا",
   "start": 57.86,
   "end": 302.54
  },
  {
   "index": 2,
   "title": "## توجه عرفانی و هشدار پیامبر",
   "start": 302.54,
   "end": 378.32
  },
  {
   "index": 3,
   "title": "## حاج عباس تربتی و نگاه بازار",
   "start": 378.32,
   "end": 476.66
  },
  {
   "index": 4,
   "title": "گاهی ظاهراً نگاه نکشیده اما شیطان گول می‌زند؛ مستقیم به حدود و نامحرم توجه نمی‌کند اما با گوشهٔ دید می‌پاید. آیه داریم:",
   "start": 476.66,
   "end": 544.06
  },
  {
   "index": 5,
   "title": "## دوربین مراقبت الهی",
   "start": 544.06,
   "end": 694.86
  },
  {
   "index": 6,
   "title": "## ناز نظام اقدس و نور علی نور",
   "start": 694.86,
   "end": 872.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 10.4,
   "text": "و بهی نستعین. السلام علیک یا داعی الله و ربانی ایاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.4,
   "end": 13.36,
   "text": "یکی از بیماری‌های روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.36,
   "end": 19.86,
   "text": "وسواس هست که در احکام هم استفتائاتی پیرامون این قصه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.86,
   "end": 25.76,
   "text": "که مثلاً به چند نوع استفتاء شده از رهبر عزیزمون که ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.76,
   "end": 29.5,
   "text": "گرفتار بیماری وسواس هستیم و هر چیزی رو نجس می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.5,
   "end": 33.38,
   "text": "غبار شیء نجس رو، دست بچه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.38,
   "end": 36.56,
   "text": "نمی‌دونم حتی سجاده‌ای که روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.56,
   "end": 39.42,
   "text": "نماز می‌خونیم اون پرزهایی که داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.42,
   "end": 41.74,
   "text": "همینطور هر جا ته--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.74,
   "end": 47.58,
   "text": "رطوبتی منتقل می‌شه می‌گیم الان مثلاً جورابمون نجس می‌شه، جورابمون رو در میاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.58,
   "end": 51.2,
   "text": "و امثال این‌ها. رهبر عزیزمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.2,
   "end": 54.04,
   "text": "اون‌هایی که دچار وسواس‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.04,
   "end": 62.06,
   "text": "یه حکم کلی دارن می‌فرمایند که شما تا وقتی که گرفتار این بیماری روحی هستید و البته رفع می‌شه همیشگی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.06,
   "end": 68.0,
   "text": "شما هر چیزی که خیلی عجیبا آقا می‌فرمایند حتی یقین کردی چیزی نجسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.0,
   "end": 72.32,
   "text": "یقین به یقین رسیدی که چیزی نجسه ولی با چشمت ندیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.32,
   "end": 75.12,
   "text": "خودت انتقال نجاست رو ندیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.12,
   "end": 77.62,
   "text": "به هر دلیلی یقین کردی اینجا نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.62,
   "end": 82.44,
   "text": "باز حکم به طهارت کن تا وقتی اون وسوسه برطرف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.44,
   "end": 86.5,
   "text": "مگر با چشمت انتقال نجاست رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.5,
   "end": 91.52,
   "text": "در این صورت حتی غبار شیء نجس و دست بچه رو اینا رو همه رو پاک بدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.52,
   "end": 94.66,
   "text": "حکم طهارت مطلقه رو بر همه جاری کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.66,
   "end": 98.5,
   "text": "تا این حالت برطرف بشه. که حتی بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.5,
   "end": 105.0,
   "text": "فقها در قدیم من یادمه که در حالاتشون می‌خوندم به بعضی از مریدانشون که گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.0,
   "end": 109.0,
   "text": "مریضی وسواس بودن نماز بدون نیت می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.0,
   "end": 112.24,
   "text": "مثلاً طرف نیتش هی میومد به پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.24,
   "end": 114.58,
   "text": "مرجعش می‌گفت من نیتم نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.58,
   "end": 116.4,
   "text": "صد بار الله اکبر می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.4,
   "end": 118.68,
   "text": "نمیاد، میاد، نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.68,
   "end": 123.58,
   "text": "آخر مرجعش گفته بود آقا شما تا این بیماری رو داری اصلاً بدون نیت نماز بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.58,
   "end": 126.62,
   "text": "نیت ح-- رکنه دیگه حتی رکن هم برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.62,
   "end": 128.66,
   "text": "انقدر قصه حساسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.66,
   "end": 132.12,
   "text": "حالا این از کجا ایجاد می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.12,
   "end": 140.4,
   "text": "قطعاً مریضی وسواس که حالا بی‌ربط با قلب مریب و قلب شکاک و مردد هم نیست که بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.4,
   "end": 143.98,
   "text": "همش از توجه به غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.98,
   "end": 146.64,
   "text": "توجه به خبائصه نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.64,
   "end": 149.64,
   "text": "چیزهایی که پاک و مطهرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.64,
   "end": 153.7,
   "text": "همش تو این نکته‌ست. یعنی انسان توجه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.7,
   "end": 158.08,
   "text": "به شیطان، به شیاطین، به اهرمن‌ها، به چیزهای بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.08,
   "end": 161.1,
   "text": "این همه دعای خوب تو مفاتیح ریخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.1,
   "end": 165.74,
   "text": "می‌ره خدا رحمت کنه بعضی از رفقا همیشه ما سفارش می‌کنیم آقا این چیزی که تو مفاتیحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.74,
   "end": 172.46,
   "text": "جای دیگه نرید. بعد هی میره سراغ خطومات عجیب و غریبی که مثلاً اجنه موکل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.46,
   "end": 174.36,
   "text": "از از میان اجنه موک–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.36,
   "end": 178.22,
   "text": "موکل دارن. یا آدمایی که حتما موکل-- به منم می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.22,
   "end": 180.28,
   "text": "می‌گن آقا شما موکل جن داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.28,
   "end": 183.88,
   "text": "اصلاً درد همینه. این توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.88,
   "end": 186.56,
   "text": "اون‌ها. شما بفرمایید ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.56,
   "end": 190.54,
   "text": "درمان آدمی که متکبره چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.54,
   "end": 194.16,
   "text": "خیلی تکبر داره. أبا مستکبرًا على ค น من الکافرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.16,
   "end": 197.34,
   "text": "شیطان چیکار کرد؟ ابا کرد و استکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.34,
   "end": 199.68,
   "text": "تکبر داشت. یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.68,
   "end": 203.36,
   "text": "چیزی که باعث شد شیطان به اون بیچارگی بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.36,
   "end": 207.48,
   "text": "تکبرش بود. با آدم متکبر چگونه باید رفتار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.48,
   "end": 210.82,
   "text": "روایات می‌گه عین خودش، متکبرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.82,
   "end": 214.06,
   "text": "یعنی چی؟ یعنی اصلاً توجه بهش-- اصلاً آدم حسابش نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.06,
   "end": 217.5,
   "text": "یعنی اصلاً توجه این موضوع توجه رو کلمه رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.5,
   "end": 220.62,
   "text": "اصلاً توجه بهش نکن تا گورشو گم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.62,
   "end": 225.76,
   "text": "چون توجه می‌کنی پررو می‌شه اونم متوجه تو می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.76,
   "end": 229.14,
   "text": "اصلاً راه خلاصی از درمان وسواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.14,
   "end": 233.88,
   "text": "عدم توجهه. اصلاً مطلقا توجه نکنی خودتو بزنی به بی‌خیالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.88,
   "end": 236.86,
   "text": "آدم متکبر همینطور، شیطان همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.86,
   "end": 243.14,
   "text": "شما تا حالا دیدید اینجا من از این همه چندین جلسه ما چند ساله اینجا داریم با هم درس و بحث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.14,
   "end": 249.12,
   "text": "تو این فرصت کوتاه و البته پربرکت، کی دیدید بشینم در خصوص جن با شما حرف بزنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.12,
   "end": 252.12,
   "text": "خیلی به ندرت مثل امروز مثلاً یه اتفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.12,
   "end": 254.68,
   "text": "وقتی از همونا حرف می‌زنی اصلاً خوششون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.68,
   "end": 257.44,
   "text": "از آدم متکبر حرف می‌زنی خوشش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.44,
   "end": 260.1,
   "text": "اصلاً حرف نزن. اصلاً سمتش نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.1,
   "end": 266.02,
   "text": "اصلاً بی‌توجه باش. حتی اینایی که می‌گن آقا من تا گرفتاری تو زندگیشون می‌افته می‌گه آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.02,
   "end": 268.32,
   "text": "یه تل– یه طلسمی درست نوشتم طلسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.32,
   "end": 270.5,
   "text": "طلسم کردن این طلسماتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.5,
   "end": 272.6,
   "text": "حالا به قول امروزی‌ها طلسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.6,
   "end": 278.12,
   "text": "جادو کردن فلان پیش-- همین که توجه می‌کنه اونا میان اگرچه نیومده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.12,
   "end": 282.32,
   "text": "اصلاً مطلقا توجه به این‌ها نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.32,
   "end": 285.66,
   "text": "چون ما توجه کردیم اینطوری گرفتار شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.66,
   "end": 289.86,
   "text": "توجه تو باید از اینا مطلقا منصرف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.86,
   "end": 294.52,
   "text": "هرچی تو توجه می‌کنی اونا توجهتون-- توجهشون به تو بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.52,
   "end": 296.94,
   "text": "حالا این موضوع توجه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.94,
   "end": 299.36,
   "text": "ما هی ازمونم می‌پرسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.36,
   "end": 301.9,
   "text": "و عده هم می‌دیم اما باید به وقتش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.9,
   "end": 304.72,
   "text": "اصلاً موهبت الهیه به انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.72,
   "end": 307.72,
   "text": "که اصطلاحاً بهش می‌گن توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.72,
   "end": 310.36,
   "text": "که می‌گن نمازتو با توجه بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.36,
   "end": 317.3,
   "text": "علامه حسن زاده حفظه الله تعالی فرمود به توجه عرفانی بنشین ببین چگونه عوالم رو سیر می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.3,
   "end": 321.74,
   "text": "حالا ما متأسفانه این موضوع توجه رو بد جایی ازش استفاده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.74,
   "end": 324.12,
   "text": "اومدیم توجه کردیم. توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.12,
   "end": 326.8,
   "text": "حالا به یک معنا می‌شه نگاه عمیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.8,
   "end": 332.02,
   "text": "یه وقت تو یه نگاهی می‌ندازی صورتتو برمی‌گردونی، توجه خیلی نمی‌کنی، نگاهتو نمی‌کشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.02,
   "end": 335.22,
   "text": "و لا تمدن عينيك إلى ما متعنا به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.22,
   "end": 340.24,
   "text": "می‌گه چشمتو نکش پیغمبر به این چیزهایی که ما از دنیا به دیگران دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.24,
   "end": 345.94,
   "text": "همین که توجه می‌کنی به مظاهر دنیا خود به خود دیگه بعد پشت سر خودش حب هم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.94,
   "end": 349.32,
   "text": "مثلاً پیغمبر از یه جا رد می‌شد شتران سرخ مو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.32,
   "end": 353.6,
   "text": "حالا به قول ما مثلاً یه بنز آخرین سیستم بود فرض کن امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.6,
   "end": 357.58,
   "text": "چند تا اونجا وایساده بودن یک مثلاً فرض کن یه گله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.58,
   "end": 361.44,
   "text": "هی یارو آقا هی زد به آقا بی‌تربیت هی زد با شونه به آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.44,
   "end": 363.56,
   "text": "به شونه آقا. آقا نگاه کن، نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.56,
   "end": 365.46,
   "text": "عجب ماشینای مدل بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.46,
   "end": 369.5,
   "text": "حضرت اصلاً توجه نکرد. بعد گفت آقا چرا نگاه نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.5,
   "end": 372.6,
   "text": "فرمود می‌ترسم نگاه کنم دلم بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.6,
   "end": 374.76,
   "text": "پیغمبر داره میگه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.76,
   "end": 377.88,
   "text": "یعنی متوجه بشی دیگه کار دستت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.88,
   "end": 380.78,
   "text": "از مرحوم حاج عباس تربتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.78,
   "end": 387.74,
   "text": "که وقت از دنیا رفتنش، یه هفته قبل از دنیا رفتنش، ساعت رفتنش و چگونه بودنش اینا همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.74,
   "end": 391.74,
   "text": "ف-- می‌دونست و به پسرش گفت چند تا از اولیا دورش جمع شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.74,
   "end": 395.2,
   "text": "لحظه‌ی ارتحالش جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.2,
   "end": 399.04,
   "text": "سلام به پیغمبر داد، سلام به امیرالمؤمنین، حضرت زهرا داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.04,
   "end": 402.32,
   "text": "و اون کسایی که دور و برش بودند می‌گفتن یهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.32,
   "end": 407.16,
   "text": "بغضش گرفت نگاه به گوشه‌ی حجره کرد لحظه‌ی ارت-ارتحالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.16,
   "end": 408.8,
   "text": "سلام داد به بی بی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.8,
   "end": 414.44,
   "text": "زینب سلام الله علیه، گفت شروع-- سلام الله علیها شروع کرد گریه کردن لحظه‌ی از دنیا رفتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.44,
   "end": 417.22,
   "text": "گفت بی بی جان شما چرا قدم رنجه کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.22,
   "end": 419.32,
   "text": "تشریف آوردید. بعد شروع کرد گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.32,
   "end": 423.64,
   "text": "گفت آها چون یه عمر گریه کردن ما برای حسین رو دیدی حالا اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.64,
   "end": 425.74,
   "text": "تو این حال از دنیا، دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.74,
   "end": 431.84,
   "text": "پسرش میگه می‌رفتیم تو بازار تهران، می‌رفتیم مطلقا نگاه نمی‌کرد مغازه‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.84,
   "end": 434.54,
   "text": "حجره‌ها رو. چند بار بهش گفتم پس-- بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.54,
   "end": 438.0,
   "text": "اینا با یه امیدی اومدن جنس ریختن تو حجره‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.0,
   "end": 440.48,
   "text": "بابا یه نگاهی فرمود همین حرف پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.48,
   "end": 444.98,
   "text": "می‌ترسم ببینم توجه که بکنم حب بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 444.98,
   "end": 447.7,
   "text": "اینی که انسان به چی توجه می‌کنه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 447.7,
   "end": 451.1,
   "text": "حتی گاهی اوقات می‌بینی ظاهراً نگاهش رو نکشونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 451.1,
   "end": 453.36,
   "text": "ولی می‌دونی شیطون میاد گولت می‌زنه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.36,
   "end": 457.0,
   "text": "ظاهراً مستقیم توجه نمی‌کنی مثلاً به حدود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.0,
   "end": 460.24,
   "text": "به خط قرمز الهی مثلاً به یه نامحرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.24,
   "end": 463.06,
   "text": "اما با گوشه‌ی دیدت می‌پایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.06,
   "end": 465.26,
   "text": "اینم دربارش آیه داریم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 465.26,
   "end": 470.3,
   "text": "تو قرآن فرمود \"یاعلم خائنة الأعين وما تخفي الصدور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.3,
   "end": 476.66,
   "text": "خدا می‌داند خیانت چشم‌ها و آنچه که مخفیه در سینه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.66,
   "end": 483.12,
   "text": "در تفاسیر می‌دیدم که از اهل بیت علیهم السلام روایت آورده بودند که این خیانت چشم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 483.12,
   "end": 486.22,
   "text": "این مستقیم زل زدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 486.22,
   "end": 488.16,
   "text": "می‌فرماید اون زاویه‌ی دیدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 488.16,
   "end": 490.3,
   "text": "من الان شما رو دارم نگاه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 490.3,
   "end": 492.66,
   "text": "الان سمت چپ و راستم هم دارم می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.66,
   "end": 497.76,
   "text": "زاویه‌ی دیده. یعنی اگه کسی سمت چپ و راست من حرکت کنه اونا رو هم می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 497.76,
   "end": 500.42,
   "text": "توجه. به این میگن خیانت اعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.42,
   "end": 502.54,
   "text": "خدا میگه اینم ما می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 502.54,
   "end": 506.78,
   "text": "یعنی احتمال داره انسان مستقیماً هم داره چیزی رو می‌بینه اما اونو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 506.78,
   "end": 509.06,
   "text": "داره بغلیشو می‌پاید. اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 509.06,
   "end": 511.28,
   "text": "اون هم به یک نوع توجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 511.28,
   "end": 513.78,
   "text": "توجه یه گونه زیرکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 513.78,
   "end": 519.74,
   "text": "خویسانه‌ست که داره یه جوری توجه می‌کنه که مثلاً ظاهر مشخص نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 519.74,
   "end": 524.6,
   "text": "به هر حال میگه تخفی الصدور. اونچه که در سینه ناپیداستو تو فکر می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 524.6,
   "end": 526.82,
   "text": "خبری نیست و ما داریم می‌پاییمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 526.82,
   "end": 530.12,
   "text": "آلارم خدا داره می‌زنه. اون آلارم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 530.12,
   "end": 535.04,
   "text": "آلارم الهی همین دوربین مداربسته‌ی الهی‌ست که دائما مشغول به کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 535.04,
   "end": 541.44,
   "text": "ما فکر می‌کنیم خبری نیست. به محض اینکه می‌فهمیم دوربینی داره مستقیم ما رو می‌پاید چقدر حواس اون جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.44,
   "end": 546.46,
   "text": "چند تا خدا آلارم داده تو خود قرآن \"هو معکم أينما كنتم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 546.46,
   "end": 549.64,
   "text": "هر جا باشید \"هو معکم\" او با شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.64,
   "end": 552.98,
   "text": "\"فأينما تولوا فثم وجه الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.98,
   "end": 555.84,
   "text": "به هر طرف رو کنید رو به خدا کرده‌اید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 555.84,
   "end": 559.3,
   "text": "\"إن الله يحول بين المرء وقلبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 559.3,
   "end": 562.72,
   "text": "تو از قلبت به خودت نزدیک‌تر داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 562.72,
   "end": 568.28,
   "text": "میگه خدا حائل بین قلب و خودت، قلب تو و خودت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.28,
   "end": 570.68,
   "text": "رابطه‌ی تو با خودت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 570.68,
   "end": 573.02,
   "text": "میگه خدا از خودت به تو نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 573.02,
   "end": 577.98,
   "text": "الله اکبر. \"نحن أقرب إليه من حبل الوريد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 577.98,
   "end": 580.64,
   "text": "او از رگ گردن نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 580.64,
   "end": 583.24,
   "text": "الله-- اینا همه آلارم‌های الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 583.24,
   "end": 588.84,
   "text": "چون اینا رو ما توجه نداریم بی‌توجه‌ایم، توجهمون رفته سمت خبائث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 588.84,
   "end": 591.84,
   "text": "و اون خبیثات به ما متوجه شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.84,
   "end": 595.32,
   "text": "ما رو کشوندن به واز-وادی وسواس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 595.32,
   "end": 598.82,
   "text": "شکاکیت و... دیروز ما یه نکته‌ی مهمی رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.82,
   "end": 602.4,
   "text": "اجازه بدید با چند تا س-س-سرچ سوال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 602.4,
   "end": 606.54,
   "text": "موضوع مهم دیروز رو دوباره تاکید کنیم و بحث رو جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.54,
   "end": 609.04,
   "text": "رو این سؤالات تورو خدا دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 609.04,
   "end": 612.76,
   "text": "پوست بنده‌ی حقیر کنده شده تا به این‌ها رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 612.76,
   "end": 615.66,
   "text": "چرا معمولاً اولین زیارت ما دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.66,
   "end": 619.24,
   "text": "تکرار نمی‌شه؟ اولین باری که رفتی کربلا دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 619.24,
   "end": 622.78,
   "text": "چجوری منفجر شدی؟ اصلاً دست خودت نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 622.78,
   "end": 626.36,
   "text": "حالا الان بیا برو کربلا می‌بینی دیگه اونطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 626.36,
   "end": 629.82,
   "text": "اولین باری که میری مثلاً یه عالم و یه رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 629.82,
   "end": 634.54,
   "text": "مثلاً رهبر عزیزم اولین بار که می‌بینی چنان منفجر می‌شی ولی دفعه‌های بعد عادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 634.54,
   "end": 641.94,
   "text": "اولین باری که-- اصلاً این اولین بارها، چرا نمازهای ما دیگه اون نمازهای قدیممون نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 641.94,
   "end": 644.6,
   "text": "چرا حالات خوش نوجوونمون از بین رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 644.6,
   "end": 646.88,
   "text": "چرا حتی زندگی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 646.88,
   "end": 651.12,
   "text": "زندگی‌های زناشویی اول خیلی خوشن، خیلی خوب، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 651.12,
   "end": 655.0,
   "text": "به هم احترام. ولی که میری جلو یهو می‌بینی شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.0,
   "end": 659.24,
   "text": "طلاق عاطفی دیگه. دیگه خیلی چیز بگیم مثلاً حالا طلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 659.24,
   "end": 661.08,
   "text": "شرعی کشیده نشد، طلاق عاطفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 661.08,
   "end": 664.62,
   "text": "هیچ عاطفه دیگه نیست. چرا ما اول انقدر خوش بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 664.62,
   "end": 668.62,
   "text": "چرا هرچی نگاه می‌کنی اون اولیات یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 668.62,
   "end": 672.54,
   "text": "چرا هرچی داریم میریم نمازمون بدتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 672.54,
   "end": 678.4,
   "text": "اشک برای امام حسین اوایل تا برا ما روضه می‌خوندن چنان می‌ریخت الان دل چرا سنگ شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 678.4,
   "end": 681.32,
   "text": "این چراها، خیلی چرا اینطوری داریم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 681.32,
   "end": 686.72,
   "text": "چرا؟ چرا؟ چرا؟ به جهت یک مورد، یک موضوع، فقط یک مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 686.72,
   "end": 694.86,
   "text": "اونم اینکه به ما از اقدس از مق-- از مقام اقدس نه قدس تا از-- یعنی بالاتر از مقدسات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 694.86,
   "end": 698.36,
   "text": "مقدس‌ترین حقیقت نظام هستی تقد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.36,
   "end": 704.04,
   "text": "تنزل پیدا کرد که مثلاً در قالب ولایت اهل بیت یا محبت حسین ابن علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 704.04,
   "end": 706.94,
   "text": "اینو تو دل من و شما ریختن. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 706.94,
   "end": 711.88,
   "text": "بعد این مقدسات رو این بلکه نظام اقدس رو ما پس دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 711.88,
   "end": 715.24,
   "text": "یعنی همون اولین باری که ما چشیدیم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 715.24,
   "end": 719.26,
   "text": "مراقبت نداشتیم، محاسبه نداشتیم، پس دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 719.26,
   "end": 724.4,
   "text": "بلافاصله بعد از اینکه ما چشممون به ضریح امام حسین افتاد، اون حال خوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 724.4,
   "end": 728.48,
   "text": "از حرم که اومدیم بیرون دوباره چشم رفت سراغ همون چیزی که بهش عادت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 728.48,
   "end": 732.68,
   "text": "توجه به خبیثات. الخبيثات للخبيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 732.68,
   "end": 734.56,
   "text": "خب زایده‌ش می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 734.56,
   "end": 737.3,
   "text": "عکس العملش می‌شه چی؟ خبیثات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 737.3,
   "end": 742.94,
   "text": "این شد که خدا هم غیور-- غیرت داره وقتی نظام اقدس رو پس زدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 742.94,
   "end": 747.34,
   "text": "می‌گیره. بعد میای دوباره تو جلسه می‌شینی میبینی نه حال خوش پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 747.34,
   "end": 750.3,
   "text": "دوباره نور گرفتی. این نور یه نور جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 750.3,
   "end": 753.72,
   "text": "اون نور قبلیه رو ازت گرفتن بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 753.72,
   "end": 756.1,
   "text": "هنر داشتی می‌شدی مثل آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 756.1,
   "end": 760.56,
   "text": "که نور على نور هی از یه تسبیح بی بی زهرا نور بیاد نور نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 760.56,
   "end": 767.82,
   "text": "نورش رو خرج نکنه. ما چون پس زدیم مقدسات رو توجه به غیر مقدسات کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 767.82,
   "end": 770.04,
   "text": "نظام اقدس عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 770.04,
   "end": 771.86,
   "text": "عرض شود خدمتتون ناز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 771.86,
   "end": 775.16,
   "text": "اینطوری به شما بگم مثل یک پرنده‌ای است عرفا گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.16,
   "end": 778.7,
   "text": "نازدار که میره پر می‌کشه میره دیگه هم نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 778.7,
   "end": 781.64,
   "text": "اگر چیزی اومد یه چیز جدید اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 781.64,
   "end": 784.76,
   "text": "دیگه اون نیست. اینو من به شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 784.76,
   "end": 789.26,
   "text": "این مر-- گرفتاری ما که دچار وسوسه، شک، تردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 789.26,
   "end": 793.08,
   "text": "این‌ها شدیم به جهت پس زدن نظام مقدساته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 793.08,
   "end": 795.58,
   "text": "مقدسات رو پس زدیم و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 795.58,
   "end": 799.78,
   "text": "خدا کم نذاشته برای ما از الان ختم کلام نقطه سر خط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 799.78,
   "end": 808.3,
   "text": "از الان اونچه که از حقایق هستی بر ما چشاندେ می‌شه و به ما می‌چشون اون رو حفظش کنیم پسش نزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 808.3,
   "end": 812.52,
   "text": "حفظش کنیم، نگرش داریم بعد ببینیم چجوری نور على نور می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 812.52,
   "end": 820.98,
   "text": "که از آقای بهجت پرسیدن از قول استادش آقای کمپانی و آقای کمپانی از اس-- قول استادش فرمود اونچه که تسبیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 820.98,
   "end": 824.18,
   "text": "مثال زدن مثل تسبیح حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 824.18,
   "end": 828.92,
   "text": "که حتی یه تسبیح بی بی رو بعد از نماز ما گفتیم حفظش کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 828.92,
   "end": 835.6,
   "text": "چون حفظش کردیم به شرط محاسبه و مراقبه از دست ندادیم هی نور على نور شد به اینجا رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 835.6,
   "end": 842.5,
   "text": "ما هی خرج کردیم رفت نظام عالم هم پس زدیم مقدساتو رفتن ناز کردن دیگه هم برنگشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 842.5,
   "end": 847.9,
   "text": "برای اینکه فعلا ما رو توی پوسته ای نگه دارن بیشتر از این آبروریز-- آبروریزی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 847.9,
   "end": 850.08,
   "text": "یه چیزکی به ما می‌چشون هر لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 850.08,
   "end": 853.58,
   "text": "ولی دیگه اون نیست. دیگه اون زیارت اول تکرار نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 853.58,
   "end": 856.36,
   "text": "دیگه اون نمازه نیست. دیگه اون توجهه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 856.36,
   "end": 860.44,
   "text": "مگر دیگه واقعاً زیر و رو بشه انسان از این رو به اون رو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 860.44,
   "end": 863.7,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 863.7,
   "end": 866.52,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 866.52,
   "end": 872.26,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}