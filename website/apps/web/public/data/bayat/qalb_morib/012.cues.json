 "chapters": [
  {
   "index": 0,
   "title": "## ترکیب حمد و تسبیحات در دو رکعت آخر",
   "start": 16.94,
   "end": 179.68
  },
  {
   "index": 1,
   "title": "## دو محور: مداومت و یافتن",
   "start": 179.68,
   "end": 239.1
  },
  {
   "index": 2,
   "title": "## خروج از دین تقلیدی و رجوع تحقیقی",
   "start": 239.1,
   "end": 344.14
  },
  {
   "index": 3,
   "title": "## کثرت فرق مذهبی در مشارق انوار",
   "start": 344.14,
   "end": 885.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 10.84,
   "text": "السلام علیک یا داعی الله و ربانی یا آیازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.84,
   "end": 13.24,
   "text": "یه صلوات بفرستین. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.24,
   "end": 16.94,
   "text": "صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.94,
   "end": 20.22,
   "text": "یکی از دوستان خوبمون سؤال پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.22,
   "end": 23.22,
   "text": "اگر کسی در نماز چهار رکعتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.22,
   "end": 25.46,
   "text": "تو اون دو تا رکعت انتهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.46,
   "end": 29.74,
   "text": "ضربدری بخونه چون می‌دونید به جای تسبیحات اربعه میشه حمد رو هم خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.74,
   "end": 34.68,
   "text": "حالا تو یه رکعت تسبیحات بگه یه رکعت حمد اشکال داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.68,
   "end": 36.74,
   "text": "می‌فرماید نخیر اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.74,
   "end": 40.74,
   "text": "باز من چون مشکوک بودم از ذهنم رفته بود از دفتر آقام استفتاء کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.74,
   "end": 43.86,
   "text": "فرمودند که نخیر اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.86,
   "end": 46.08,
   "text": "خب بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.08,
   "end": 49.04,
   "text": "شکاک، قلب مریب، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.04,
   "end": 51.82,
   "text": "گرفتار شک و ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.82,
   "end": 54.5,
   "text": "و بسیار هم خطرناک هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.5,
   "end": 57.1,
   "text": "ما رسیدیم به اینجا که باید خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.1,
   "end": 59.16,
   "text": "معرفی کنیم به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.16,
   "end": 62.16,
   "text": "قرآن هم یکی از اسماءش ذکر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.16,
   "end": 66.34,
   "text": "خودش، خودش ذکر رو برای خودش اسم ذکر رو معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 66.34,
   "end": 69.56,
   "text": "خود قرآن میگه من ذکرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 69.56,
   "end": 75.48,
   "text": "بعد می‌فرمود فذکر فإن الذکرى تنفع المؤمنین دائما مشغول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.48,
   "end": 80.14,
   "text": "ذکر باش. همه عبادیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.14,
   "end": 86.1,
   "text": "و اعبد ربک امر می‌کنه خدا که عبادت کن خدا حتی یأتیک الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.1,
   "end": 88.76,
   "text": "این یقینی که اینجا اومده نه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.76,
   "end": 92.38,
   "text": "فقط وجهش این باشه که انقدر عبادت کن تا به یقین برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.38,
   "end": 99.5,
   "text": "این یک معناست که این نشون میده عبادت خودش نور عبادت باعث می‌شه که قلب مشکوک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.5,
   "end": 101.62,
   "text": "قلب شکاک به یقین برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.62,
   "end": 104.62,
   "text": "این خودش یه معناست که حالا بعداً باید بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.62,
   "end": 108.88,
   "text": "اما مفسرین ویل یقین اینجا آوردن مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.88,
   "end": 114.12,
   "text": "حتی یأتیک الیقین یعنی انقدر عبادت کن تا وقت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.12,
   "end": 117.82,
   "text": "خب حالا این عبادت رو همش حد خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.82,
   "end": 120.96,
   "text": "روزه تو حق نداری همیشه روزه داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.96,
   "end": 123.34,
   "text": "حق نداری که دائماً نماز بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.34,
   "end": 125.72,
   "text": "پس بقیه شؤونات زندگی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.72,
   "end": 127.82,
   "text": "حق نداری دائماً حج بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 127.82,
   "end": 130.0,
   "text": "این نمیشه اصلاً. نشدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 130.0,
   "end": 132.98,
   "text": "تنها چیزی که دائمه ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 132.98,
   "end": 136.28,
   "text": "واذكر الله ذكراً كثيرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 136.28,
   "end": 141.1,
   "text": "اتفاقاً همون روز که این بحث رو کردیم تو سوره بقره آیه دویست شما خوندید اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 141.1,
   "end": 143.6,
   "text": "سریع منم اینجا یادداشتش کردم همون روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 143.6,
   "end": 149.54,
   "text": "فإذا قضیتم مناسککم وقتی که مناسک حج شما قضیتم تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 149.54,
   "end": 151.62,
   "text": "دوباره چیه دستور؟ فاذكر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 151.62,
   "end": 154.28,
   "text": "آقا تموم شد حج. میگه فاذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 154.28,
   "end": 158.76,
   "text": "بازم الله رو ذکر کن. حالا این تازه جالبه ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 158.76,
   "end": 162.14,
   "text": "و ذکر کن این کد-- کی رو باید ذکر کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 162.14,
   "end": 166.66,
   "text": "ذکر کی؟ آباؤکم و أشد ذکرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 166.66,
   "end": 169.18,
   "text": "اونم أشد ذکر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 169.18,
   "end": 172.84,
   "text": "اصلاً حد یقف تو ذکر نیست که حالا معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 172.84,
   "end": 176.18,
   "text": "حقیقت ذکر و فرق ذکر و اسم رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 176.18,
   "end": 179.44,
   "text": "بیان کردیم. حالا باید به هر حال رجوع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 179.44,
   "end": 183.0,
   "text": "اینجا دو تا بحث پیش میاد. یکیشو تو این جلسه عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 183.0,
   "end": 185.8,
   "text": "یکیش اینه که ما بیاییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 185.8,
   "end": 194.62,
   "text": "زی-- سعی کنیم دائماً اهل مداومت با ذی-- مداومت با ذکر، این بحث مداومت چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.62,
   "end": 197.04,
   "text": "همه‌شون حد خوردن جز ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 197.04,
   "end": 201.22,
   "text": "یه بحث دیگه هم هست اون که اساساً ذکر رو پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 201.22,
   "end": 203.9,
   "text": "اساساً توجه به ذکر بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 203.9,
   "end": 208.12,
   "text": "بحث جلسه پیش نظر بندازی که نگاه عمیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 208.12,
   "end": 211.44,
   "text": "یعنی اهل تحقیق و تفحص باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 211.44,
   "end": 213.84,
   "text": "تا متحقq بشی و تحقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 213.84,
   "end": 218.06,
   "text": "که حق است در وجود تو متحقq بشه و پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 218.06,
   "end": 222.88,
   "text": "ما متأسفانه غالبمون اینچنین هستیم حتی شیع‌گی‌مون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 222.88,
   "end": 225.9,
   "text": "الحمد لله روح اجدادمون شاد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.9,
   "end": 230.84,
   "text": "جدیه مثلاً جدتیه، پدرم، مادرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 230.84,
   "end": 237.84,
   "text": "توجه کردید اینکه خودمون بریم اهل تفحص و تحق-تحقیق باشیم خیلی کم پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.84,
   "end": 240.92,
   "text": "بابا حضرت استاد علامه زنده می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 240.92,
   "end": 246.06,
   "text": "\"من خوشحالم که از دین بیرون اومدم دوباره لباس دین به تن کردم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.06,
   "end": 248.84,
   "text": "نه اینکه یعنی که استغفرالله دین رو تعطیل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.84,
   "end": 251.56,
   "text": "منظورش اینه که رفتم تحقیق کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 251.56,
   "end": 255.18,
   "text": "خودم لباس دین به تنم کردم، نه دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.18,
   "end": 263.2,
   "text": "و غ-غالباً این رو نداریم. یکی از دلایلی که قلب ما دائماً نوسان داره هی شک و تردید می‌کنه اساساً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.2,
   "end": 269.3,
   "text": "که ما خودمون نرفتیم اجتهاد کنیم، به اجتهاد برسیم، متخصص امر دین بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.3,
   "end": 277.02,
   "text": "توجه کردید؟ و اگر هم به متخصص رجوع کردیم وقتی نیستیم باید به ت-متخصص رجوع کنیم، کم رجوع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.02,
   "end": 280.78,
   "text": "اون بحث فذکر رو دائم که حالا اونو بعداً باید بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.78,
   "end": 285.1,
   "text": "دائم نرفتیم رجوع کنیم. هی دائماً با قرآن معنوس نبودیم که ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.1,
   "end": 290.9,
   "text": "قرآن ذکره. دائماً کدوممون دائماً راه میریم قرآن، می‌خوابیم قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.9,
   "end": 293.52,
   "text": "الذين يذكرون الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.52,
   "end": 297.0,
   "text": "يذكرون ها فعل مضارع دلالت بر استمرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.0,
   "end": 299.16,
   "text": "يذكرون ذکرشون دائمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.16,
   "end": 304.98,
   "text": "چگونه؟ قياماً وقعوداً وعلى جنوبهم حتی خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.98,
   "end": 308.18,
   "text": "اینچنینه. مداومت نداریم حالا بحثش بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.18,
   "end": 311.94,
   "text": "و گذشته از اون مداومت اساساً اهل رجوع نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.94,
   "end": 315.58,
   "text": "اهل تحقیق و تفحص و توجه نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.58,
   "end": 317.74,
   "text": "همینطوری‌ش باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.74,
   "end": 322.5,
   "text": "غالب مردم همین شیعه‌هامون از این هشت میلیارد آدمی که رو کره زمینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.5,
   "end": 326.3,
   "text": "چندتاشون شیعه‌ان؟ بعید می‌دونم بیشتر از سیصد میلیون باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.3,
   "end": 329.18,
   "text": "تازه همینام چقدر شناسنامه‌ای‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.18,
   "end": 331.34,
   "text": "اصلاً نماز نمی‌خونه نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 331.34,
   "end": 338.0,
   "text": "حالا همین نمازخون‌هاش، همین مسجدبه‌هاش هم می‌بینین غریب، به اتفاقشون اصلاً اهل توجه و تحت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.0,
   "end": 341.7,
   "text": "تدقق نیستن، بخوان دقت نظر بکنن اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.7,
   "end": 343.86,
   "text": "هر چیزی رو از هر جا می‌شنون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.86,
   "end": 347.38,
   "text": "هر کتابی می‌خونن، گوش به هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.38,
   "end": 351.32,
   "text": "سخنگویی میدن و لذا وجودشون مشوش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.32,
   "end": 354.4,
   "text": "پر از پریشانی، افکار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.4,
   "end": 359.7,
   "text": "ا-- حالا اون تضادهمات افکار که اوه، اوه چه می‌کنه در ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.7,
   "end": 363.9,
   "text": "و دانسته‌های متناقض بیچاره کرده ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.9,
   "end": 367.2,
   "text": "کدوممون اهل تفحص و تحق-- تدقق و تحققیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.2,
   "end": 371.64,
   "text": "کدوممون؟ واقعاً برنامه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 371.64,
   "end": 377.96,
   "text": "چطور الان برنامه‌ته این ساعت نماز مثلاً قضاست، این ساعت برم خونه، این ساعت برم فلان جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.96,
   "end": 381.52,
   "text": "برنامه داری‌ها. چرا برای این ما برنامه نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.52,
   "end": 386.48,
   "text": "خدا شاهد حضرت استاد علامه حسن زاده می‌فرمودن هر وقت من از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.48,
   "end": 389.06,
   "text": "کتابخونه، کتابخونه خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.06,
   "end": 391.82,
   "text": "یادش بخیر ما تو این کتابخونه یه روز بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.82,
   "end": 394.76,
   "text": "با ایشون نشسته بودیم. اصلاً یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.76,
   "end": 397.62,
   "text": "روح، من نمی‌دونم ایشالا شما هم رفتید دیدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.62,
   "end": 400.1,
   "text": "یک روح عجیبی تو اون کتابخونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.1,
   "end": 402.48,
   "text": "اصلاً انگار باور کنید العیاذ بالله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 402.48,
   "end": 404.66,
   "text": "به تشبیه شما ناراحت نشن از این تشبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 404.66,
   "end": 407.5,
   "text": "من چیز دیگه پیدا نمی‌کنم. انگار نشستی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 407.5,
   "end": 410.7,
   "text": "کعبه. این کتاب‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.7,
   "end": 416.38,
   "text": "یه-- بعد ایشون می‌فرمودن من هر وقت از این کتابخونه میام بیرون حالم عوض می‌شه، حالم بد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.38,
   "end": 418.2,
   "text": "دلتنگ کتابخونم می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 418.2,
   "end": 420.12,
   "text": "باید برگردم حتماً اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.12,
   "end": 422.5,
   "text": "الله اکبر. خب این می‌شه، می‌شه علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.5,
   "end": 426.98,
   "text": "ولی ما چی؟ و کتاب‌هایی هم که می‌خونیم کتاب‌های بازاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.98,
   "end": 431.58,
   "text": "اصلاً تحقیق کجا؟ همین کتاب‌های بازاری شما برو این همه کتاب تو بازار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.58,
   "end": 434.34,
   "text": "یه بار من رفتم نماز-- نمایشگاه دست خالی برگشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 434.34,
   "end": 436.58,
   "text": "هرچی کتاب برمی‌داشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.58,
   "end": 439.1,
   "text": "چه ظاهر بزک کرده‌ای. توشو می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 439.1,
   "end": 444.86,
   "text": "همش تکرار مکررات. ده تا کتاب گذاشته جلوش چهار تا از این گلچین کرده چهار تا از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.86,
   "end": 447.02,
   "text": "اصلاً تحقیق کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 447.02,
   "end": 450.24,
   "text": "حرف جدید و دقیق و خطیر کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 450.24,
   "end": 453.7,
   "text": "کو؟ اینه که می‌بازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 453.7,
   "end": 459.58,
   "text": "در حالی که همه بزرگان اهل معرفت ما اگر اهل معرفت شدند و اهل یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 459.58,
   "end": 463.04,
   "text": "از شک و این‌ها خارج شدند برای همیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.04,
   "end": 466.96,
   "text": "جهت اینه که اهل تحقیق بودند. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.96,
   "end": 470.6,
   "text": "یه کتابی هست به نام مشارق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 470.6,
   "end": 475.94,
   "text": "انوار اليقين في حقائق اسرار امیر، اسرار امیر المؤمنین صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 475.94,
   "end": 479.8,
   "text": "جالبه که اینو حافظ رجب برسی نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 479.8,
   "end": 485.08,
   "text": "عربی هم هست. من نمی‌دونستم خودم تا همین امروز دیدم که جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 485.08,
   "end": 492.84,
   "text": "توی این کتاب از اهل تسنن از فرقه‌های سنی‌ها بیش از بیست و سی-- دویست و بیست تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.84,
   "end": 496.12,
   "text": "قریب به دویست و سی فرقه رو یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 496.12,
   "end": 499.48,
   "text": "از شیعه چند تا؟ از شیعه هم همین مقدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.48,
   "end": 502.62,
   "text": "بیش از دویست و بیست فرقه از شیعه یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 502.62,
   "end": 505.34,
   "text": "چند تا ما می‌تونیم بشماریم؟ اسماعیلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 505.34,
   "end": 508.72,
   "text": "نمی‌دونم واقفیه، حالا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 508.72,
   "end": 513.26,
   "text": "از بگیر از چهار امامی بگیر تا پنج امامی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 513.26,
   "end": 514.92,
   "text": "شش امامی، هفت امامی تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 514.92,
   "end": 518.84,
   "text": "دیگه هشت امامی نداریم. چند تا می‌تونیم بشماریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 518.84,
   "end": 521.92,
   "text": "دویست تا. بعد عنوان آورده توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 521.92,
   "end": 526.74,
   "text": "چه خبره؟ بعد یکی مثل هانری کوربن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.74,
   "end": 529.9,
   "text": "این اندیشمند فرانسوی راه می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 529.9,
   "end": 534.04,
   "text": "راه می‌افته می‌گه من باید برم ببینم بالاخره دین حق چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.04,
   "end": 537.2,
   "text": "خب راه می‌افته تمام این ادیان مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 537.2,
   "end": 541.42,
   "text": "قرآن می‌فرماید \"إن الدين عند الله الإسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.42,
   "end": 547.18,
   "text": "فقط اسلام. \"إني وجهت وجهي للذي فطر السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.18,
   "end": 549.36,
   "text": "حنيفا مسلما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.36,
   "end": 552.28,
   "text": "اینو حضرت ابراهیم گفته. \"و ما أنا من المشركين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.28,
   "end": 554.32,
   "text": "مسلمانا. اون هم مسلمون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 554.32,
   "end": 557.2,
   "text": "حضرت موسی هم مسلمون بوده. حضرت عیسی هم مسلمون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 557.2,
   "end": 562.08,
   "text": "این یهود و نمی‌دونم نصارا و اینا از عناوینیه که اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 562.08,
   "end": 566.38,
   "text": "پیروانشون گذاشتن. و الا همه \"إن الدين عند الله الإسلام\" تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 566.38,
   "end": 568.16,
   "text": "همه انبیا مسلمون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 568.16,
   "end": 570.78,
   "text": "دین ما هم از-- اصلاً یه دین بیشتر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.78,
   "end": 572.56,
   "text": "ایشون تحقیق کرد، تفحص کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 572.56,
   "end": 575.34,
   "text": "هر جا رفت دید نه. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 575.34,
   "end": 578.56,
   "text": "به قول خودشون آرامش پیدا نمی‌کنه تو این ادیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 578.56,
   "end": 580.5,
   "text": "حتی شیعه. وارد شیعه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 580.5,
   "end": 583.9,
   "text": "چقدر بحث. تا رسید محضر علامه طباطبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 583.9,
   "end": 588.72,
   "text": "علامه طباطبایی فرمود که من دیدم اصلاً این آقایه، آقای دیگه‌ایه، آدم دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 588.72,
   "end": 590.92,
   "text": "حالا من زبان علامه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 590.92,
   "end": 593.16,
   "text": "چیز می‌کنم، هم فهمش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 593.16,
   "end": 596.56,
   "text": "یه چیز دیگه‌ای انگار توش. بهش گفتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 596.56,
   "end": 598.88,
   "text": "حالا بحث شد بین ادیان و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 598.88,
   "end": 604.08,
   "text": "گفتم که تو مسیحیت علامه می‌گه من با هانری کوربن که دیدم تو یه بحثی که داشتیم بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 604.08,
   "end": 610.88,
   "text": "عرض کردم که مسیحیت وقتی می‌خواد با خدا صحبت کنه چون اسم نداره از خدا، قائل به اسماء نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 610.88,
   "end": 614.88,
   "text": "یه اله و اب و تمام. نمی‌تونه حرف بزنه با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.88,
   "end": 616.58,
   "text": "بعدم باید بره پیش کشیشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 616.58,
   "end": 618.56,
   "text": "کشیشش رابط او بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 618.56,
   "end": 620.18,
   "text": "اصلاً اون نمی‌تونه با خدا حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 620.18,
   "end": 624.12,
   "text": "بعدم اگر دلش بگیره باید صبر کنه تا یکشنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 624.12,
   "end": 627.42,
   "text": "در صومعه‌شون باز بشه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 627.42,
   "end": 635.1,
   "text": "اما علامه می‌گه من به هانری کوربن گفتم مطلقا تو اسلام چیزی ما هر کجا دلت گرفت سجده کن، اونجا می‌شه مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 635.1,
   "end": 639.74,
   "text": "هر کجا یاد خدا کردی با هر اسمی که به حالت منطبقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 639.74,
   "end": 642.8,
   "text": "مطابق با جدول وجودی تو خدا رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 642.8,
   "end": 645.8,
   "text": "اصلاً همه جا خدا هست. خدا کجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 645.8,
   "end": 650.72,
   "text": "\"هو الله، قل هو الله احد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 650.72,
   "end": 653.24,
   "text": "الصمد\". الصمد دیگه جایی نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 653.24,
   "end": 656.1,
   "text": "خدا اونجا نباشه. \"فإنما تولد الصمد وجه الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 656.1,
   "end": 659.38,
   "text": "همه جا هست. بعد ایشون منقلب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 659.38,
   "end": 661.64,
   "text": "علامه یه، یه مدت گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 661.64,
   "end": 664.9,
   "text": "شاگرداشون می‌فرمودن که خیلی گریه می‌کرد علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 664.9,
   "end": 666.92,
   "text": "بعد می‌گفتیم شما خیلی گریه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 666.92,
   "end": 672.16,
   "text": "می‌فرمود که دیدم از هانری کوربن فرانسوی که اومده تحقیق کنه پرسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 672.16,
   "end": 677.28,
   "text": "شما وقتی می‌خوای با خدا مرتبط بشی، سخن بگی چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 677.28,
   "end": 679.96,
   "text": "چه می‌کنی؟ فرمود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 679.96,
   "end": 683.96,
   "text": "صحیفه‌ای دارم به نام صحیفه مهدویه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 683.96,
   "end": 690.48,
   "text": "شیعه‌ها که ام-- از کار و عوراد و نمازهای امام آخر شما توشه، اونا رو با اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 690.48,
   "end": 700.88,
   "text": "صفا می‌کنم. علامه می‌گفت من گریه می‌کنم از اینکه یه همچین کسی با صحیفه مهدویه اینجوری خو گرفته بعد ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 700.88,
   "end": 705.48,
   "text": "چند تا از ما خداوکیلی اهل توجه و تدق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 705.48,
   "end": 708.38,
   "text": "هر کی به هر کی، آقا من شنیدم اینو می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 708.38,
   "end": 712.12,
   "text": "شنیدی از کی شنیدی؟ از کجا دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 712.12,
   "end": 714.58,
   "text": "بعد هم که فضای مجازی بیداد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 714.58,
   "end": 717.32,
   "text": "این اینو گفت، اون اینو گفت. من کاری به کسی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 717.32,
   "end": 720.84,
   "text": "مرجع تقلید من مدعی هیتمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 720.84,
   "end": 724.4,
   "text": "خاک بر سر من کنه. چقدر اینطوری الان ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 724.4,
   "end": 728.3,
   "text": "من خودم نوکر امام حسینم و سی ساله روضه‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 728.3,
   "end": 730.86,
   "text": "اما اینا خطرناکه. من کاری به کسی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 730.86,
   "end": 733.04,
   "text": "مرجع تقلید من فلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.04,
   "end": 734.66,
   "text": "ولی می‌بینید دو هزار سواد نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 734.66,
   "end": 738.42,
   "text": "اصلاً نمی‌فهمه دین چیه اینا خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 738.42,
   "end": 741.52,
   "text": "پدر ما رو درآورده. باید راه افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 741.52,
   "end": 744.48,
   "text": "بعدم از یک چشم آبشخور، یه چشمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 744.48,
   "end": 748.48,
   "text": "ختم کلام، یه هدیه به شما از خدا رحمت کنه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 748.48,
   "end": 754.66,
   "text": "آیت‌الله عظمی آقای آقا مرتضی تهرانی بدم که یه بارم فکر کنم خدمت حضرتون عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 754.66,
   "end": 756.96,
   "text": "من خودم از این عالم به اون عالم بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 756.96,
   "end": 759.44,
   "text": "یه مدت گرفتار آقای بهجت بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 759.44,
   "end": 761.12,
   "text": "یه مدت گرفتار آقای حق شناس بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 761.12,
   "end": 764.1,
   "text": "یه مدت می‌رفتم پیش آقای مصباح. یه مدت می‌رفتم پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 764.1,
   "end": 765.72,
   "text": "نمی‌دونم آقا مرتضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 765.72,
   "end": 767.98,
   "text": "یه مدت می‌رفتم پیش-- هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 767.98,
   "end": 770.26,
   "text": "آقای بهلول لیوانم کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 770.26,
   "end": 773.76,
   "text": "اصلاً از این آ-- آقای جوادی آملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 773.76,
   "end": 776.46,
   "text": "علامه حسن زاده حتی، این، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 776.46,
   "end": 779.22,
   "text": "آقای حداد. زیادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 779.22,
   "end": 783.44,
   "text": "اصلاً آقای فاطمی نیا از این جلسه به اون جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 783.44,
   "end": 787.82,
   "text": "توجه کردین؟ آخر رفتیم یه روز پیش آقای آقا مرتضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 787.82,
   "end": 789.74,
   "text": "خدا رحمتش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 789.74,
   "end": 791.42,
   "text": "در دل کردم گفت بس کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 791.42,
   "end": 796.56,
   "text": "اینجوری گفت بس کن. من درونت و دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 796.56,
   "end": 799.12,
   "text": "ضبط کردن اتفاقا صداش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 799.12,
   "end": 801.22,
   "text": "یه جمله اونجا-- حالا حرف زیاد زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 801.22,
   "end": 803.84,
   "text": "یه جمله‌ش این موند. گفت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 803.84,
   "end": 807.44,
   "text": "اشکال کارت این بوده که یه آش شله قلمکاری تو وجود خودت درست کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 807.44,
   "end": 811.66,
   "text": "بیست سال پیش بود ما رفتیم. پیش این عالم، پیش این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 811.66,
   "end": 813.82,
   "text": "ما جای بدی نرفتیم که. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 813.82,
   "end": 818.3,
   "text": "جای بدی رفتیم. همه این اسامی که من برای شما خوندم همشون رو چشم ما جا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 818.3,
   "end": 822.44,
   "text": "اما فرمود اشتباه‌ست این. یه مشرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 822.44,
   "end": 825.38,
   "text": "توجه کردید؟ دیگه به خط هم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 825.38,
   "end": 830.3,
   "text": "دیگه ما افتادیم خدا ما رو لطف کرد، عنایت کرد، انداخت تو مشرب علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 830.3,
   "end": 833.08,
   "text": "حسن زاده. دیگه اصلاً کاری به کسی من ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 833.08,
   "end": 837.48,
   "text": "بعضی وقت‌ها بحث علمی می‌شه، تضادها رو بررسی می‌کنی اما با مشرب ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 837.48,
   "end": 845.64,
   "text": "خیلیا اصلاً من با، به اسمشون قسم می‌خوردم اساتید برجسته تو فیضیه درس خارج می‌ره طرف رو چشمم جا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 845.64,
   "end": 848.84,
   "text": "چقدر عزیز. به محض اینکه دیدم تعارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 848.84,
   "end": 851.64,
   "text": "فکری با علامه داره، دیگه آثارشو بررسی نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 851.64,
   "end": 854.54,
   "text": "دیگه کتاب‌هاشو نخوندم. دیگه جلساتشو نرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 854.54,
   "end": 858.12,
   "text": "با یه مشرب برو جلو. خراب نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 858.12,
   "end": 866.26,
   "text": "اگر این چنین نباشه عزیز دلم دچار قلب شکاک و مریب و پر از ریب و شک و تردید می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 866.26,
   "end": 871.14,
   "text": "و آخرش هم معلوم نیست از کج ناکجا آباد سر در، سر در بیاریم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 871.14,
   "end": 873.5,
   "text": "خیلی خطرناکه ها. الان گرفتاری ما اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 873.5,
   "end": 878.38,
   "text": "انشالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 878.38,
   "end": 885.64,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}