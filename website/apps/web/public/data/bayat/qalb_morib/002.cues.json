 "chapters": [
  {
   "index": 0,
   "title": "## طهارت لباس در خشکشویی و اهل کتاب",
   "start": 7.7,
   "end": 165.58
  },
  {
   "index": 1,
   "title": "قلب مردد بسیار پرحرف است و کاربردی. بر پایهٔ آیهٔ چهل و پنج سورهٔ توبه:",
   "start": 165.58,
   "end": 207.54
  },
  {
   "index": 2,
   "title": "## مثل میت و غسال؛ ذکر سودمند",
   "start": 207.54,
   "end": 227.7
  },
  {
   "index": 3,
   "title": "## کوتاهی از امام عصر؛ محاسبهٔ النفس شهید ثانی",
   "start": 227.7,
   "end": 353.34
  },
  {
   "index": 4,
   "title": "## تمثل کلاهبرداری و ملکات حیوانی",
   "start": 353.34,
   "end": 701.78
  },
  {
   "index": 5,
   "title": "## گریهٔ امروز ما و گریهٔ علامه",
   "start": 701.78,
   "end": 756.48
  },
  {
   "index": 6,
   "title": "## اصل خروج از شک؛ استغاثه به امام عصر",
   "start": 756.48,
   "end": 832.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 5.22,
   "text": "السلام علیک یا داعی الله و ربانی یا آیهاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.22,
   "end": 7.7,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 10.18,
   "text": "در خصوص لباس‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.18,
   "end": 14.68,
   "text": "به خشکشویی داده میشه حالا یا جهت شستشو یا اتو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.68,
   "end": 18.08,
   "text": "سوالی از رهبر عزیزمون داریم که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.08,
   "end": 20.4,
   "text": "به هر حال دیده میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.4,
   "end": 24.98,
   "text": "عموم مردم لباس می‌برن میدن چه جهت شستشو، چه اتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.98,
   "end": 28.26,
   "text": "اقلیت‌های مذهبی، مسیحیت اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.26,
   "end": 34.06,
   "text": "اهل کتاب. خب این چجوری میشه لباس‌هایی که ما میدیم بالاخره ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.06,
   "end": 35.74,
   "text": "حکم طهارتش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.74,
   "end": 38.46,
   "text": "اینا قاطی میشه تو شستشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.46,
   "end": 42.98,
   "text": "رهبر عزیزمون فرمودن که اولا اون لباسی که شما میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.98,
   "end": 45.38,
   "text": "اگر خودش پاک باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 45.38,
   "end": 50.08,
   "text": "خود اون لباسی که داری میدی پاک باشه، از اول نجس نبوده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.08,
   "end": 54.04,
   "text": "مشکلی نیست. ثانیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.04,
   "end": 59.34,
   "text": "اینکه صرف ارتباط این لباس با لباس‌های اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.34,
   "end": 66.1,
   "text": "کتاب هم موجب نجاست نیست، انتقال نجاست و محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.1,
   "end": 69.78,
   "text": "ضمن اینکه حالا این استفتائا تموم شد، ضمن اینکه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.78,
   "end": 73.46,
   "text": "خب معمولا کسی که میره لباسی، فرشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.46,
   "end": 75.76,
   "text": "روفرشی چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.76,
   "end": 78.48,
   "text": "به صورت نجس باشه بده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.48,
   "end": 80.54,
   "text": "عرض شود خشکشوییا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.54,
   "end": 85.26,
   "text": "من خودم یه وقت مثلا پتویی چیزی دادیم بچه نجس کرده بوده گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.26,
   "end": 87.66,
   "text": "گفتم آقا این نجسه شما به روش اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.66,
   "end": 90.94,
   "text": "گفته خیالتون راحت حاج آقا. هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.94,
   "end": 95.62,
   "text": "البته بعضی جاها س-- مواد شیمیایی مخصوصا برای فرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.62,
   "end": 99.76,
   "text": "خصوصا فرش رو اگه میدید نجس شده بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.76,
   "end": 103.04,
   "text": "بگید که آقا مثلا این نجسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.04,
   "end": 106.84,
   "text": "اون رعایت کنه. اگه نگید یعنی مخصوصا فرش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 106.84,
   "end": 112.7,
   "text": "حالا لباس رو نه، لباس رو با آب می‌شورن اما فرش رو به از-- الان بعضی جاها فقط با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.7,
   "end": 115.28,
   "text": "مواد شیمیایی می‌شورن، اصلاً آب نمی‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 115.28,
   "end": 119.76,
   "text": "اگر فرش نجسه یا نجسش رو برطرف کنید بدید برای شستشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.76,
   "end": 124.38,
   "text": "یا به اون طرف بگید. قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.38,
   "end": 129.74,
   "text": "م-مردد قلب بسیار پرحرفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.74,
   "end": 137.18,
   "text": "و البته دیروز عرض کردم کاربردی هم حالا به قول امروزی‌ها یعنی به درد می‌خوره، در عمل به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.18,
   "end": 148.02,
   "text": "بر اساس آیه چهل و پنج سوره توبه \"انما یستأذنک الذين لا يؤمنون بالله واليوم الآخر بد ورتابت قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.02,
   "end": 151.48,
   "text": "کسایی که دچار ریب و شک‌اند، قلبشون دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.48,
   "end": 156.22,
   "text": "تردیده همش. این‌ها فقط از تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.22,
   "end": 160.28,
   "text": "اذن می‌خوان برای شرکت نکردن در جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.28,
   "end": 165.04,
   "text": "اینجا نکته‌ای هست که با یه دقت معمولی دیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.04,
   "end": 170.76,
   "text": "می‌فرماید \"انما\" فقط و فقط \"یستأذنک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.76,
   "end": 173.7,
   "text": "از تو. اون کافش خیلی روش حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.7,
   "end": 177.52,
   "text": "یعنی چی حاج آقا؟ فقط کسایی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.52,
   "end": 179.9,
   "text": "تو اذن می‌خوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.9,
   "end": 182.52,
   "text": "دیگه کاری با بقیش فعلا نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.52,
   "end": 186.32,
   "text": "که در جهاد شرکت نکنن که حالا این خصوصیتشونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.32,
   "end": 189.88,
   "text": "ایمان نیاوردن، دل ندادن، در شک و ریبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.88,
   "end": 192.94,
   "text": "از کی می‌خوان این اذن و از تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.94,
   "end": 196.18,
   "text": "یعنی چی؟ یعنی اینکه از تو جدا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.18,
   "end": 204.5,
   "text": "اصلا گیر اینجاست. گیر اینجاست که طرف حاضر نیست تن بده، دل بده، خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.5,
   "end": 207.54,
   "text": "ببخشه، خودش رو تقدیم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.54,
   "end": 210.68,
   "text": "مثل طبق روایات مثل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.68,
   "end": 213.5,
   "text": "میتی که خودش رو می‌سپره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.5,
   "end": 215.98,
   "text": "دست غسال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.98,
   "end": 222.56,
   "text": "آقا هر طرف می‌خوای منو این ور اون ور کن، هر طور عشقتو بشور فقط بشور پاک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.56,
   "end": 227.1,
   "text": "میگه میت حتی از میت هم می‌تونی اینجا شما چی کار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.1,
   "end": 230.36,
   "text": "\"فذكر فإن الذكرى تنفع المؤمنین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.36,
   "end": 232.04,
   "text": "از این ذی-- میگه هی نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.04,
   "end": 235.9,
   "text": "چرا؟ تو هم مثل این میت خودت رو بسپر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.9,
   "end": 237.78,
   "text": "حقایق نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.78,
   "end": 240.32,
   "text": "بسپر به پیغمبر. این خیلی نکته‌ست‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.32,
   "end": 244.26,
   "text": "و با یه نگاه معمولی عرض کردم دیده نمیشه تو آیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.26,
   "end": 247.5,
   "text": "خیلی موقعا ما آیه‌ها رو می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.5,
   "end": 250.94,
   "text": "و متاسفانه اِ-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.94,
   "end": 253.5,
   "text": "حقیقت آیه رو از بین می‌بریم اصلا با خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.5,
   "end": 256.52,
   "text": "همینجوری می‌خونیم میریم. یه چیز کلی بردا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.52,
   "end": 261.34,
   "text": "باید کلمه به کلمه، حرف به حرف مورد دقت قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.34,
   "end": 263.94,
   "text": "اگر می‌خوای بری به لایه‌های پنهان‌تر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.94,
   "end": 267.5,
   "text": "\"انما یستأذنک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.5,
   "end": 270.56,
   "text": "می‌خوان از تو جدا باشن. گیرشون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.56,
   "end": 276.34,
   "text": "و خدا نکنه انسان حاضر نباشه خودش رو تحویل به ولی خدا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.34,
   "end": 278.68,
   "text": "حالا الان ما که متاسفانه دستمون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.68,
   "end": 282.6,
   "text": "امام عصرمون کوتاهه. دستمون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.6,
   "end": 285.18,
   "text": "خدا لعنت کنه اونایی که دست ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.18,
   "end": 289.56,
   "text": "از دامن امام عصر که علی زمان هست کوتاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.56,
   "end": 296.18,
   "text": "خدا ریشه‌شونو بسوزونه که امیرالمؤمنین اتفاقا کتابی هست به نام محاسبت النفس مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.18,
   "end": 300.78,
   "text": "شهید ثانی. کتابای شهید ثانی رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.78,
   "end": 305.76,
   "text": "من چون میگم تاکید می‌کنم چون خودم این کارو کردم تاثیرش رو دیدم به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.76,
   "end": 308.48,
   "text": "کتاب‌های عجیبی داره. سر و سلاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.48,
   "end": 311.52,
   "text": "اصلا از این رو به اون رو می‌کنه نماز ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.52,
   "end": 313.68,
   "text": "محاسبت النفسش خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.68,
   "end": 317.1,
   "text": "ترجمه به فارسیش محاسبه نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.1,
   "end": 319.94,
   "text": "اونجا یه روایتی رو میاره از ام-- از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.94,
   "end": 325.94,
   "text": "آقامون امیرالمؤمنین علیه الصلاة و السلام که رفتن وارد بازار ظاهرا کوفه اگر اشتباه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.94,
   "end": 328.84,
   "text": "بله ظاهرا اینطور یادم مونده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.84,
   "end": 331.16,
   "text": "خیلی سال‌های پیش بود دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.16,
   "end": 334.88,
   "text": "که وارد بازار کوفه میشن قطعا شما هم شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.88,
   "end": 342.6,
   "text": "حالات مردم رو می‌بینن که چگونه گرفتار و غافل و قسم می‌خورن سر یه متر پارچه می‌خوان بفروشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.6,
   "end": 347.6,
   "text": "اینو قسم می‌دن، خدا رو قسم می‌دن، قرآن رو قسم می‌خورن، قسم دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.6,
   "end": 350.42,
   "text": "حالا چ-- پرده برای مولا کنار رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.42,
   "end": 354.24,
   "text": "چی دید؟ وضعیت حقیقی این‌ها رو دید که استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.24,
   "end": 360.94,
   "text": "می‌فرمودن که این جمله رو من از استاد عزیزمون شنیدم که می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.94,
   "end": 364.64,
   "text": "وقتی یه نفر می‌خواد سر دیگری کلاه بذاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.64,
   "end": 368.72,
   "text": "اگر تو بخوای تمثلش برات رخ بده یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.72,
   "end": 371.8,
   "text": "مثال این قصه رو ببینی نه طبیعتشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.8,
   "end": 376.76,
   "text": "یعنی یه لایه پنهان‌تر این حقیقت رو ببینی میبینه اون طرف مثل مثلاً چجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.76,
   "end": 380.16,
   "text": "قورباغه زبونشو میاره می‌خواد یه پشرو قورت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.16,
   "end": 384.54,
   "text": "یه همچین حالتی داره. داره از همون طرف مقابلشو قورت میده، می‌خورش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.54,
   "end": 387.38,
   "text": "یه تمثلش تو حیوانات همچنین رخ داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.38,
   "end": 391.3,
   "text": "که امام صادق صلوات الله علیه فرمود ملکات اعمال شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.3,
   "end": 395.36,
   "text": "همون حیواناتی‌اند که تو بیابونا ولن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.36,
   "end": 401.28,
   "text": "و اینا رو شما ناک کنید به اونا ملکات اعمالتون و تمثلات اعمالتون تو اونا جلوهگره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.28,
   "end": 404.06,
   "text": "خب امیرالمؤمنین حالا چی دید گریه‌ش گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.06,
   "end": 407.74,
   "text": "تو بازار های های بلند مولامون علی گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.74,
   "end": 411.62,
   "text": "گفتن آقا چی شده؟ کسی مرده به قول ما الان یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.62,
   "end": 416.8,
   "text": "تا یکی گریه می‌کنه تا نمی‌دونم صدای قرآن بلند می‌شه کی-- عزیزت مرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.8,
   "end": 419.36,
   "text": "چی شده آقا؟ حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.36,
   "end": 425.65,
   "text": "دست رو دست زدن. امان از این غفلتی که شما مردم رو به خودش مشغول کرده این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.65,
   "end": 428.66,
   "text": "کی می‌خواید شما برگردید به سمت حق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.66,
   "end": 432.44,
   "text": "چقدر غافل، چقدر برای دنیاتون صبح تا شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.44,
   "end": 435.48,
   "text": "شبم که می‌رید مثل یک جیفه‌ای میفتید تا صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.48,
   "end": 438.64,
   "text": "دیگه کی؟ این گریه مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.64,
   "end": 443.56,
   "text": "یکی اونجا باشه اشک ولی خدا رو از دست خودش ببینه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.56,
   "end": 446.22,
   "text": "اصلاً یه بار برای ما پرده بره کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.22,
   "end": 449.56,
   "text": "اشکی که میگن امام عصر صلوات الله علیه وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.56,
   "end": 452.3,
   "text": "خوندن نامه اعمال ما می‌ریزه رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.3,
   "end": 454.78,
   "text": "ببینم یالا بذار ببینیم. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.78,
   "end": 458.36,
   "text": "علت اینکه من پررو شدم اینه که این چیزا رو نمی‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.36,
   "end": 460.9,
   "text": "نفس ولی خدا بهم نخورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.9,
   "end": 464.28,
   "text": "خدا لعنت کنه اونایی که دست ما رو کوتاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.28,
   "end": 467.28,
   "text": "ما پیغمبر درک نکردیم، امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.28,
   "end": 473.86,
   "text": "درک نکردیم. وقتی می‌نویسن حضرت موسی علی نبی و آله و علیه صلوة السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.86,
   "end": 478.08,
   "text": "چون حالات امام عصر رو فرمودن از هر نبی یه ارثی بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 478.08,
   "end": 481.9,
   "text": "به شدت حریص علی المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.9,
   "end": 484.12,
   "text": "در خصوص پیغمبر قرآن میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.12,
   "end": 486.38,
   "text": "إنک بخع نفسك ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.38,
   "end": 490.6,
   "text": "تو میخوای خودتو به کشتن بدی پیغمبر برای هدایت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.6,
   "end": 495.04,
   "text": "حریصٌ عليكم. حرص میزنه برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.04,
   "end": 498.06,
   "text": "حضرت موسی دید یه بره از گله‌ش جدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.06,
   "end": 500.42,
   "text": "جالبه که غالب انبیا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.42,
   "end": 502.3,
   "text": "چوپونی کردن حتی پیغمبر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 502.3,
   "end": 505.2,
   "text": "چوپانی خیلی عجیبه. یکی ماهیگیریه یکی چوپانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.2,
   "end": 508.42,
   "text": "من انجام دادم که به شما میگم هر دو تاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.42,
   "end": 511.52,
   "text": "خیلی صبر می‌خواد. واقعاً صبر عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.52,
   "end": 514.48,
   "text": "گاهی اوقات من مثلاً یعنی چهار پنج ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.48,
   "end": 517.8,
   "text": "منتظر بودم این توری که انداختیم ماهی بیاد توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.8,
   "end": 520.4,
   "text": "خودم از صبر خودم تعجب می‌کردم بچه که بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 520.4,
   "end": 522.94,
   "text": "اینا خیلی تمرین عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 522.94,
   "end": 524.88,
   "text": "حضرت دید بره فرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.88,
   "end": 528.74,
   "text": "پیغمبر دنبال این بره چون میدونه داره میره تو دل گرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.74,
   "end": 532.36,
   "text": "انقدر رفت روایت میگه موسی به نفس نفس زدن افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 532.36,
   "end": 535.54,
   "text": "بابا کجا میری؟ ول نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.54,
   "end": 539.68,
   "text": "چه جالب نشون داد پیغمبر یعنی این دلسوزه حتی یه حیوونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.68,
   "end": 542.64,
   "text": "انقدر رفت کوه، دشت، بالا، پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.64,
   "end": 544.94,
   "text": "تا بالاخره بغلش کرد باخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.94,
   "end": 548.12,
   "text": "کجا بعد شروع کرد نوازش کردن و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 548.12,
   "end": 550.18,
   "text": "و با این بره حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 550.18,
   "end": 554.34,
   "text": "تو روایت میگه به بره می‌گفت تو می‌دونی کجا داری میری عزیزم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 554.34,
   "end": 557.82,
   "text": "داشتی می‌رفتی تو دل گرگ. ببین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 557.82,
   "end": 560.62,
   "text": "دل ولی خداست که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.62,
   "end": 563.86,
   "text": "متأسفانه ظاهراً در عصر ظاهر دور افتادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 563.86,
   "end": 566.4,
   "text": "به هر حال باید خودمون رو بسپریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 566.4,
   "end": 569.14,
   "text": "تحویل بدیم به امام عصرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 569.14,
   "end": 575.02,
   "text": "کی رفق-- خداییش الان همه عزیزانی که اینجا تشریف دارن تو ذهن خودتون بفرمایید ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 575.02,
   "end": 578.62,
   "text": "کی ما رفتیم جمع کران خودمون رو تحویل امام عصر بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 578.62,
   "end": 582.74,
   "text": "یا هر وقت رفتیم مریض داشتیم یا فوقش دلمون تنگ آقامون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 582.74,
   "end": 585.82,
   "text": "کربلا کی رفتیم خودمون رو تحویل اباعبدالله بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 585.82,
   "end": 588.2,
   "text": "بگیم من زائر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 588.2,
   "end": 590.58,
   "text": "نه به اون معنای مسافر ما، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 590.58,
   "end": 594.06,
   "text": "من حائرم اصلاً حائر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 594.06,
   "end": 596.22,
   "text": "حائر قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 596.22,
   "end": 600.12,
   "text": "من اومدم در حقیقت راحل باشم اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 600.12,
   "end": 604.4,
   "text": "راحل، راحل یعنی رحل اقامت با-- اومدم که دیگه برنگردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.4,
   "end": 608.98,
   "text": "اصل زیارت امام حسین به این نیته نه مسافر که قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 608.98,
   "end": 613.76,
   "text": "بریم خودمون رو تحویل بدیم به ولی خدا و اونا هم که زنده‌ن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 613.76,
   "end": 618.39,
   "text": "أشهد أنك تشهد مقامي وتسمع كلامي وترد سلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.39,
   "end": 621.51,
   "text": "مگه اینا رو نمیگیم تو زیارت-- اذن دخول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.51,
   "end": 625.8,
   "text": "خب پس زنده‌ن، زنده و مرده و زنده ندارن اصلاً یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 625.8,
   "end": 629.26,
   "text": "تحویل بدی خودتو. بعد ببینی اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 629.26,
   "end": 631.96,
   "text": "دستتو میذارن تو دست یه ولی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 631.96,
   "end": 638.26,
   "text": "درسته کم شدن. خدا رحمت کنه امثال آقای علامه طباطبایی یا آقای بهجت‌ها اینا کم شدن خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 638.26,
   "end": 642.96,
   "text": "آقای حق شناس یادش بخیر نفسش به ما می‌خورد هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 642.96,
   "end": 645.72,
   "text": "اما خب خیلی کم شدن اما هستن هنوزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 645.72,
   "end": 649.88,
   "text": "هنوز هم هستن. از امام عصر بخوای تحویلت بده به یه ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 649.88,
   "end": 656.96,
   "text": "خدایی که البته یه وقت به اشتباه نره آدم بعداً بحثشو می‌کنیم انشاالله که خیلیا به اشتباه میرن ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 656.96,
   "end": 658.06,
   "text": "خدا رو اشتباه می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 658.06,
   "end": 662.2,
   "text": "نه حواست-- اگه به صدق بری اشتباه نمی‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 662.2,
   "end": 665.16,
   "text": "به قول علامه. علامه طباطبایی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 665.16,
   "end": 669.9,
   "text": "حالا این رو هم از، از استادمون شنیدم من نشنیده بودم که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 669.9,
   "end": 672.96,
   "text": "علامه کم می‌شده که یه وقت از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 672.96,
   "end": 678.14,
   "text": "وارد منزل شد پریشون باشه، بگريه، گریه کنه، بریزه به هم، مضطرب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 678.14,
   "end": 681.1,
   "text": "همسرش می‌فرماید یه روز دیدیم حضرت علامه وارد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 681.1,
   "end": 685.74,
   "text": "این صاحب تفسیر گران سنگ و سنگین المیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 685.74,
   "end": 687.66,
   "text": "که نمونه ندارد به واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 687.66,
   "end": 690.26,
   "text": "وارد منزل شد در حالی که گریانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 690.26,
   "end": 695.46,
   "text": "همسر علامه طباطبایی. ح-- میگه من تعجب کردم چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 695.46,
   "end": 697.74,
   "text": "از آقا پرسیدم چرا شما انقدر گریانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 697.74,
   "end": 700.64,
   "text": "ببینید تورو خدا شما حرف علامه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 700.64,
   "end": 704.86,
   "text": "برای چی گریه می‌کرده؟ امروز گریه من و شما برای چیه خداوکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 704.86,
   "end": 707.86,
   "text": "یه وقت دلمون بترکه گریه کنیم برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 707.86,
   "end": 710.38,
   "text": "خودتو محک بزن. علامه داره گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 710.38,
   "end": 712.34,
   "text": "همسرش می‌پرسه چرا گریه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 712.34,
   "end": 715.02,
   "text": "میگه یه دونه از شاگردامو از دست دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 715.02,
   "end": 717.44,
   "text": "عجب! یعنی چی از دست دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 717.44,
   "end": 720.32,
   "text": "مرد؟ نه. درسو ول کرد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 720.32,
   "end": 722.68,
   "text": "رفت دنبال زندگی و دنیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 722.68,
   "end": 728.08,
   "text": "اگر می‌موند آدم قابلی از آب در می‌اومد به حقایق نظام اصلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 728.08,
   "end": 731.84,
   "text": "ببینید این دلسوزی‌ای که تو اولیاء خدا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 731.84,
   "end": 737.64,
   "text": "گاهی اوقات رهبرمونو دیدی در خصوص جوونا حرف می‌زنه با چه سوز دلی میگه عزیزان دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 737.64,
   "end": 739.6,
   "text": "فرزندان عزیز من اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 739.6,
   "end": 742.86,
   "text": "این فرق می‌کنه با اون جنبه شعاری که بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 742.86,
   "end": 745.92,
   "text": "دولت مردان ما صرفاً برای کرسی ریاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 745.92,
   "end": 748.76,
   "text": "آی جوونا دم زدن شعاری اینو ول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 748.76,
   "end": 752.14,
   "text": "چه سوزی از جوون‌ها داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 752.14,
   "end": 756.1,
   "text": "رهبر. اینطوری کم‌ند ولی خب بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 756.1,
   "end": 758.82,
   "text": "پس نکته‌ای که امروز بگیم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 758.82,
   "end": 762.56,
   "text": "می‌خواستیم عرض کنیم با این چند تا حالا تمثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 762.56,
   "end": 767.06,
   "text": "و قصه‌گویی یا داستان‌های حقیقی و روایت به اینجا رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 767.06,
   "end": 774.02,
   "text": "که یکی از مهم‌ترین شاید اینطوری بتونم بگم اصلاً مهم‌ترین نه یکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 774.02,
   "end": 778.1,
   "text": "مهم‌ترین اصلی که ما را از شک و تردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 778.1,
   "end": 781.9,
   "text": "از قلب شکاک بیرون می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 781.9,
   "end": 785.42,
   "text": "و انشاالله باعث دلدادگی ما می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 785.42,
   "end": 792.2,
   "text": "اینه که اون کاف مخاطب اینجا إنما یستع و نوکر و حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 792.2,
   "end": 794.9,
   "text": "ما نخوایم از ولی خدا جدا باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 794.9,
   "end": 799.8,
   "text": "و خودمون رو بسپریم، تحویل بدیم به ولی خدا، به امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 799.8,
   "end": 801.52,
   "text": "یه نماز استغاثه بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 801.52,
   "end": 803.34,
   "text": "استغاثه به امام عصر تو مفاتیح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 803.34,
   "end": 807.02,
   "text": "خیلی نماز عجیبیه. من از بعضی از اساتیدمون یاد گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 807.02,
   "end": 809.42,
   "text": "انجام-- هر وقت انجام دادم نتیجه دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 809.42,
   "end": 812.78,
   "text": "و گریه کنیم. اس-استغاثه کنیم به آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 812.78,
   "end": 814.76,
   "text": "آقا منو تحویل بگیر من ولم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 814.76,
   "end": 816.64,
   "text": "اصلاً من ولم. هیچکسو ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 816.64,
   "end": 818.88,
   "text": "می‌خوام خودمو تحویل به شما بدم با صداقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 818.88,
   "end": 822.86,
   "text": "بعد ببین آقا باهات چیکار می‌کنه. انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 822.86,
   "end": 825.78,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 825.78,
   "end": 832.26,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}