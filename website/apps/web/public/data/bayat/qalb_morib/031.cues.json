 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.5,
   "text": "[سخنگوی 1] و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.5,
   "end": 6.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.32,
   "end": 10.0,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.0,
   "end": 12.82,
   "text": "در خصوص احکام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.82,
   "end": 18.32,
   "text": "همونطور که یادمه حدود دو سال پیش همین حکم رو عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.32,
   "end": 20.48,
   "text": "باز هم برای اطمینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.48,
   "end": 24.3,
   "text": "بالاخره بعضی از فتواهای خیلی قلیل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.3,
   "end": 31.9,
   "text": "فتواهای رهبری استنباطشون عوض شده اینا دو مرتبه امروز من استفتاء کردم از دفتر ایشون در این خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.9,
   "end": 34.74,
   "text": "و این که دیده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.74,
   "end": 44.24,
   "text": "تو نمازخونه‌ها، مساجد این‌ها بعضیا میان به نماز دوم که می‌رسن بعد می‌خوان دو تا نمازشون رو به یک نماز ابتدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.24,
   "end": 49.46,
   "text": "برای همین دو رکعت اولو با امام می‌خونن که امام حمد و سوره رو بخونه تا حمد و سوره تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.46,
   "end": 52.72,
   "text": "از قنوت به بعدو به سرعت می‌خونن خودشونو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.72,
   "end": 57.68,
   "text": "رکعت سوم امام می‌رسونن، نماز بعدی رو ابتدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.68,
   "end": 64.24,
   "text": "آیا این اشکال داره؟ بعضی از مراجع فرمودن اشکال داره و جز به ضروره نمی‌شه این کارو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.24,
   "end": 66.82,
   "text": "اما رهبر عزیزمون فرمودن اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.82,
   "end": 75.82,
   "text": "نظر رهبر این هستش که بی‌اشکال است فقط ثواب نماز جماعت کم می‌شه به همون مقدار که از جماعت فارغ می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.82,
   "end": 80.22,
   "text": "ثواب جماعتش کم می‌شه. در خصوص سلام زودتر از امام هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.22,
   "end": 83.1,
   "text": "سلام اگر کسی زودتر از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.1,
   "end": 85.84,
   "text": "سلام بدهد باز اون هم بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.84,
   "end": 94.34,
   "text": "از مراجع اشکال کردن اما رهبری فرمودن اشکالی ندارد فقط به همون میزان که زودتر سلام میده ثواب نماز جماعتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.34,
   "end": 97.48,
   "text": "کم می‌شه. اجازه بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.48,
   "end": 100.06,
   "text": "آخرین جلسه رو پیرامون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.06,
   "end": 108.28,
   "text": "قلب مرید داشته باشیم که البته خود همین نکته‌ای که در این جلسه آخر می‌خوایم بگیم خودش جای بحث طولانی‌ای داره و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.28,
   "end": 114.82,
   "text": "بعضی از آیات قرآن رو ما اصلاً فرصت نکردیم که پیرامون ریب، حس مطلق ریب و شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.82,
   "end": 116.94,
   "text": "در رابطه باهاش سخن بگیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.94,
   "end": 120.52,
   "text": "ان‌شاءالله امام عصر همین قلیل رو از ما بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.52,
   "end": 123.56,
   "text": "اجازه بفرمایید برای خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.56,
   "end": 125.64,
   "text": "گوشزد کردن خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.64,
   "end": 128.16,
   "text": "شک و ریب و دو دلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.16,
   "end": 130.56,
   "text": "شت-- اشد شک و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.56,
   "end": 133.14,
   "text": "یا اضطراب و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.14,
   "end": 138.54,
   "text": "ناآرامی که سبب شک می‌شود یا در دل شک هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.54,
   "end": 141.9,
   "text": "یکی از در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.9,
   "end": 145.04,
   "text": "جملات حضرت آیت الله سعادت پرور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.04,
   "end": 147.78,
   "text": "شیخ علی آقای پهلوانی معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.78,
   "end": 150.42,
   "text": "به سعادت پرور رو که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.42,
   "end": 153.04,
   "text": "رهبر عزیزمون خیلی از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.04,
   "end": 155.36,
   "text": "به خوبی و بزرگی یاد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.36,
   "end": 158.24,
   "text": "براتون یه بخشیش رو بخونم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.24,
   "end": 164.78,
   "text": "قسمتی که براتون می‌خونم هم در کتاب سرّ الاسراء ایشون جلد یک صفحه هفت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.78,
   "end": 168.48,
   "text": "هم در کتاب عید وصالشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.48,
   "end": 173.1,
   "text": "الان جلوی من هست که در سیر و سلوک هشتصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.1,
   "end": 175.24,
   "text": "موضوع رو از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.24,
   "end": 179.32,
   "text": "در این کتاب جمع کردن که به نظرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.32,
   "end": 185.22,
   "text": "یه کتاب بالینیه. یعنی کسی قبل خوابش یه کلمه، دو کلمه، سه کلمه، چهار کلمه از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.22,
   "end": 188.1,
   "text": "کتاب رو بخونه خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.1,
   "end": 196.82,
   "text": "در کلمه‌ی امم موضوع اولش که عنوان هست خورشید حقیقت، می‌فرمایند برای دیگران حقیقت آشکار نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.82,
   "end": 199.16,
   "text": "اینجوری نیست که حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.16,
   "end": 201.96,
   "text": "برای همه آشکار بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.96,
   "end": 204.26,
   "text": "و عموم مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.26,
   "end": 208.34,
   "text": "عجب! عموم یعنی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.34,
   "end": 214.22,
   "text": "عارف می‌فرمود عموم مردم از درک آن یعنی درک حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.22,
   "end": 219.82,
   "text": "عاجز و از مشاهده آن محروم مانده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.82,
   "end": 222.22,
   "text": "حالا چرا محروم مانده‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.22,
   "end": 229.42,
   "text": "ایشون می‌فرماید و دیده دلشان در پس ابر تردید کور گشته، تردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.42,
   "end": 237.34,
   "text": "و لایه‌های شک و ناباوری آنها را پوشانیده و مانع رؤیت حقیقت شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.34,
   "end": 241.46,
   "text": "یعنی تا جایی شده که حالا عبارت بعدی نهیبش باز بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.46,
   "end": 246.54,
   "text": "از این رو یعنی به جهت همین شک و ریب و تردید و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.54,
   "end": 250.6,
   "text": "از این رو اینان از اشارات کتاب‌های آسمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.6,
   "end": 258.56,
   "text": "و روشنگری‌های فرستادگان خداوند و به ویژه قرآن کریم و رسول اکرم و آل پاکش علیهم الصلاة والسلام بهره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.56,
   "end": 265.16,
   "text": "نمی‌برند. بلکه گروهی از آنها به طور کلی از مسیر حق دور افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.16,
   "end": 270.76,
   "text": "و آنچه را به چشم نبینند و به گوش نشنوند یکسره انکار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.76,
   "end": 278.76,
   "text": "آقا گوشمون ندیده، چشممون ندی-- نشنیده، گوشمون نشنیده، چشممون ندیده انکار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.76,
   "end": 282.72,
   "text": "چرا؟ به جهت اینکه به دلشون راه دادن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.72,
   "end": 285.84,
   "text": "شک رو. ما بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.84,
   "end": 294.08,
   "text": "اون مؤلفه‌هایی که عرض کردیم اگه کسی جمع‌بندی کرده باشه متوجه شد که واژه ریب در لغت کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.08,
   "end": 296.96,
   "text": "به سه معنا به صورت کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.96,
   "end": 301.64,
   "text": "در خ-- پیرامون یعنی جملات بزرگان رو وقتی بررسی می‌کنی بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.64,
   "end": 307.16,
   "text": "یکی مطلق شکه، یکی شک همراه ترس و بدگمانیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.16,
   "end": 309.58,
   "text": "سوءظن، تهمت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.58,
   "end": 313.72,
   "text": "یکی هم شک همراه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 313.72,
   "end": 317.18,
   "text": "ناآرامی و اضطراب و توهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 317.18,
   "end": 321.76,
   "text": "این‌هاست که جالبه که بدونید اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.76,
   "end": 326.28,
   "text": "حالا به شکی که تو قرآن ریب به اطلاق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.28,
   "end": 331.96,
   "text": "بسیاری از محققین همون شک همراه با ناآرامی و اضطراب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.96,
   "end": 336.8,
   "text": "فرمودن که یعنی منظور حالا نه باز همه آیات اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 336.8,
   "end": 343.98,
   "text": "البته در یک فرمایشی هم امیرالمؤمنین علیه الصلاة والسلام در نهج‌البلاغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 343.98,
   "end": 346.84,
   "text": "لا ترتابوا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.84,
   "end": 352.76,
   "text": "حضرت می‌فرماید ریب، دچار ریب نشید، مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 352.76,
   "end": 355.92,
   "text": "لا ترتابوا گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 355.92,
   "end": 359.26,
   "text": "ریب نشید. ریب نبرزید که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 359.26,
   "end": 362.6,
   "text": "کی-- این باعث چی می‌شه؟ فتشکوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.6,
   "end": 366.78,
   "text": "که اگر شما دچار ریب شدید تازه میفتید به شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.78,
   "end": 371.26,
   "text": "این نشون میده چون ریب رو مقدمه بر شک آورده مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.26,
   "end": 374.46,
   "text": "منظور همون ناآرامی و اضطرابی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 374.46,
   "end": 378.56,
   "text": "که باعث می‌شه که انسان در عمل بر خلاف علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 378.56,
   "end": 381.26,
   "text": "و فرو رفتن در شبهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.26,
   "end": 383.7,
   "text": "بیفته در ورطه‌ی شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.7,
   "end": 386.06,
   "text": "از کجا شروع می‌شه ناآرامی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.06,
   "end": 391.86,
   "text": "از اضطراب، اضطراب که امروزه این اضطراب بیچاره کرده مردم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.86,
   "end": 399.32,
   "text": "اون مریضه. بسیاری از مریضی‌های حذ- حتی جسمی و مزاجی باور کنید بر می‌گرده به همین اضطراب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.32,
   "end": 402.9,
   "text": "حالا می‌گن استرس امروزه بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.9,
   "end": 410.38,
   "text": "یعنی دلنگرانی‌های عجیب و غریب، عدم نا، عدم آرامش، عدم نقط مقابل یقین و خلوصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 410.38,
   "end": 413.5,
   "text": "نقط، نقط مت-- مقابل اطمینانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 413.5,
   "end": 420.56,
   "text": "آرامش قلبیه. جالبه که در لحظه‌ی مرگ هم ما داریم در قرآن و روایت، در آیه‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.56,
   "end": 424.02,
   "text": "قرآن و روایت از لحظه‌ی مرگ به ریب المنون یاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 424.02,
   "end": 429.26,
   "text": "ریب المنون یعنی اضطراب هنگام مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 429.26,
   "end": 431.5,
   "text": "خب اضطراب هنگام مرگ چیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.5,
   "end": 434.32,
   "text": "مگه چرا اضطراب می‌گیره طرف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.32,
   "end": 437.26,
   "text": "اضطراب وقت مرگ به چه جهته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.26,
   "end": 443.96,
   "text": "چرا ناآرامه؟ چرا اطمینان خاطر نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 443.96,
   "end": 446.26,
   "text": "اولا قرآن می‌فرماید نقط مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 446.26,
   "end": 449.36,
   "text": "ریب چی شد اینجا؟ نقط مقابل ناآرامی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.36,
   "end": 454.1,
   "text": "اطمینان. قرآن می‌فرماید \"یا ایتها النفس المطمئنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.1,
   "end": 456.4,
   "text": "اطمینان. \"ارجعی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 456.4,
   "end": 459.02,
   "text": "برگرد \"الى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.02,
   "end": 461.7,
   "text": "راضية مرضية",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.7,
   "end": 464.86,
   "text": "فادخلي في عبادي وادخلي جنتي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.86,
   "end": 470.32,
   "text": "قشنگ این آیه داره نشون میده مؤلفه‌ها رو که کسی که دچار اضطرابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.32,
   "end": 473.02,
   "text": "اضطرار رو نمیگم ها اشتباه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.02,
   "end": 476.6,
   "text": "مضطر بودن چیز خوبیه، انسان رو به خدا می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.6,
   "end": 479.34,
   "text": "\"اما یجيب ما دعاه و ینصر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 479.34,
   "end": 483.36,
   "text": "انسان رو به استجابت می‌رسونه. به جایی می‌رسه که انسان فقط خدا رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 483.36,
   "end": 487.26,
   "text": "اون بحثش گذشت. اضطراب رو می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.26,
   "end": 491.3,
   "text": "که مقدمه‌ی ورود به شک و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.3,
   "end": 497.18,
   "text": "ناآرامی. اونجا نشون داره میده این آیه‌ای که قرائت کردیم چی باعث ناآرامی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.18,
   "end": 499.58,
   "text": "اونجا می‌گه \"فادخلي في عبادي\" بیا تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 499.58,
   "end": 504.96,
   "text": "جلگه بندگان من. پس دوری از بندگان خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.96,
   "end": 507.56,
   "text": "از عباد الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.56,
   "end": 512.54,
   "text": "باعث می‌شه که این یه مؤلفه، انسان بیفته به عدم اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 512.54,
   "end": 515.4,
   "text": "\"فادخلي عبادي وادخلي جنتي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 515.4,
   "end": 517.76,
   "text": "بهشتی زندگی نکردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.76,
   "end": 521.88,
   "text": "دور- دوری کردن از هر چیزی که انسان رو به بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.88,
   "end": 525.46,
   "text": "تقرب می‌ده اینم می‌شه دلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.46,
   "end": 527.06,
   "text": "دور شدن از اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.06,
   "end": 530.32,
   "text": "خیلی راحت این آیه داره گرا می‌ده به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.32,
   "end": 535.18,
   "text": "\"راضية مرضية\" اینکه تو راضی نباشی به رضای خداها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.18,
   "end": 538.78,
   "text": "یعنی اصلاً رضای خدا مد نظرت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.78,
   "end": 540.88,
   "text": "چه برسه به اینکه خدا از تو راضی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 540.88,
   "end": 542.88,
   "text": "اون که دیگه. یعنی اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 542.88,
   "end": 546.46,
   "text": "موضوع رضایت برات مهم نبوده، مطرح نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 546.46,
   "end": 551.32,
   "text": "این‌ها توجه و توسل به اسم رضای خدا نداشتی یا کم داشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 551.32,
   "end": 554.46,
   "text": "اینکه می‌گه برو پیش امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 554.46,
   "end": 557.18,
   "text": "بیجا نیست که اسم آقا رضاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 557.18,
   "end": 561.88,
   "text": "که حضرت آیت الله جوادی آملی خیلی قدیم‌ها که می‌رفتیم پای درسشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 561.88,
   "end": 564.24,
   "text": "خیلی ما اون موقع بچه‌تر بودیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 564.24,
   "end": 568.76,
   "text": "ایشون می‌فرمود که اصلاً توی کل، حالا آقای جوادی آملی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 568.76,
   "end": 570.56,
   "text": "همچین فرمایشی دارن البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.56,
   "end": 577.42,
   "text": "تو کل این عالم و نظام هستی، ممکنات، عوالم، هر کجا رضایتی پیش بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 577.42,
   "end": 580.06,
   "text": "این تحت سیطره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 580.06,
   "end": 583.16,
   "text": "امام رضا صلوات الله علیه رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.16,
   "end": 587.16,
   "text": "راضی بودن. یعنی ولایت کلیه‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.16,
   "end": 591.44,
   "text": "خب کسی بره پیش امام رضا زیارت حضرت به این قصد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 591.44,
   "end": 598.36,
   "text": "به این قصد که هموار کند راه رسیدن به اطمینان رو از طریق رضایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 598.36,
   "end": 601.0,
   "text": "درست شد این؟ بعد می‌ف– می‌فرمود \"ارجعی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.0,
   "end": 603.74,
   "text": "همون ابتدا می‌فرمود \"ارجعی الى ربك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 603.74,
   "end": 608.06,
   "text": "پس اگر تو از رب خودت غافل باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.06,
   "end": 613.4,
   "text": "یا به یک معنا از آیه‌ی \"انا لله و انا الیه راجعون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 613.4,
   "end": 620.22,
   "text": "از قوس النزول و صعود خودت ببینی چجوری از یه آیه داره در میاد، غافل باشی به اطمینان نمی‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 620.22,
   "end": 625.08,
   "text": "باید توجه داشته باشی به رجعتت، به برگشتت که ریب المنون نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 625.08,
   "end": 627.56,
   "text": "اضطراب هنگام مرگ نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 627.56,
   "end": 630.74,
   "text": "باید توجه داشته باشی به رب خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 630.74,
   "end": 633.34,
   "text": "که توی بحث لقاء اللهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.34,
   "end": 638.8,
   "text": "ما شب‌های جمعه در هیئت یا زهرا شرقی تهران داشتیم و عزیزان هم در کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 638.8,
   "end": 641.06,
   "text": "برهان گمنامی برگزار کردن، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 641.06,
   "end": 649.62,
   "text": "مفصل صحبت کردیم پیرامون این موضوع که چگونه است که تو رب خودت رو زیارت قراره بکنی، نه رب مطلقه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 649.62,
   "end": 652.98,
   "text": "البته بعضیا لقاء الله می‌رسن، الله رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 652.98,
   "end": 656.36,
   "text": "اینا با هم فرق می‌کنند با کسی که رب خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 656.36,
   "end": 658.86,
   "text": "زیارت می‌کنه. \"یا ایها الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 658.86,
   "end": 662.18,
   "text": "انک کادح الی ربک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 662.18,
   "end": 664.24,
   "text": "ارادگار خودت. \"کادحا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 664.24,
   "end": 666.82,
   "text": "با سختی داری میری به سمت ارادگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 666.82,
   "end": 670.46,
   "text": "\"فملاقيه\". قراره رب خودت رو زیارت کنی ها، نه رب دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 670.46,
   "end": 672.68,
   "text": "مگه رب‌ها با هم فرق می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.68,
   "end": 678.62,
   "text": "به این معنا بله. یعنی حالا خلاصشو بگیم و کسی که اون بحث‌ها رو دنبال کرده می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.62,
   "end": 681.52,
   "text": "اما حالا شاید کسی نباشه تو جمع شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 681.52,
   "end": 683.84,
   "text": "هر کدوم از اسامی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 683.84,
   "end": 689.24,
   "text": "در کانال و جدول وجودی شما جاری شد، ساری شد و پیاده‌سازی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 689.24,
   "end": 692.86,
   "text": "یعنی شما مظهری شدی از یکی از اسماء خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 692.86,
   "end": 694.56,
   "text": "نه اینکه دستت بگیری تسبیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.56,
   "end": 699.32,
   "text": "غلا از تلامه حسن زاده خیلی شیرین می‌فرمودن که خودم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 699.32,
   "end": 704.88,
   "text": "یکی از درساشون داشتن شرح fusus می‌دادن شنیدم در می‌گفت، می‌فرمودن طرف دستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 704.88,
   "end": 709.42,
   "text": "تسبیح می‌گیره و ظاهراً ذاکر می‌شه به ذکر یا بار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 709.42,
   "end": 715.32,
   "text": "یا رئوف، یا رحیم. اینا بعد وقتی یه دفعه مواجه می‌شه به جایی که باید رأفت به خرج بده، نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 715.32,
   "end": 718.82,
   "text": "غضب به خرج می‌ده. این اسماء متقابل رو استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 718.82,
   "end": 720.82,
   "text": "این اصلاً این اسم در وجودش پیاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 720.82,
   "end": 723.64,
   "text": "این اصلاً به ذاکر به واقع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.64,
   "end": 726.7,
   "text": "حقیقتاً ذاکر نیست. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 726.7,
   "end": 729.98,
   "text": "این اسمی که پیاده بشه در انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 729.98,
   "end": 735.88,
   "text": "درست شد؟ اون اسم اگر پیاده شد در وجود انسان نه لقلقه زبان بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 735.88,
   "end": 743.26,
   "text": "همون مقدار و همون میزانی که از اون دریای لایتنای اون اسم بی‌انتها، اون اسم حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 743.26,
   "end": 748.38,
   "text": "که عین وجود سم-سمدی حضرت حق است، پره پر است و همه جا رو گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.38,
   "end": 754.22,
   "text": "در وجود تو پیاده شد به همون میزانی که پیاده شده او می‌شود رب تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 754.22,
   "end": 757.18,
   "text": "و تو همونو زیارت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 757.18,
   "end": 759.46,
   "text": "یعنی در حقیقت تو مظهر چه اسمی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.46,
   "end": 762.46,
   "text": "مظهر اسم رأفت خدا شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 762.46,
   "end": 764.8,
   "text": "دیروز من با داماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 764.8,
   "end": 769.74,
   "text": "توفیقی شد با داماد حضرت علامه حسن زاده نیم ساعتی تلفنی صحبت می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 769.74,
   "end": 772.96,
   "text": "اصلا نفس ایشون خب معلوم بود چندین سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 772.96,
   "end": 775.06,
   "text": "خب علامتش ایشون بودن دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 775.06,
   "end": 778.9,
   "text": "و نفس علامه بهش خدا اصلا صدا نشاط داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 778.9,
   "end": 782.92,
   "text": "اصلا تا شب شارژ کرده بود ما رو تا همین الانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 782.92,
   "end": 784.84,
   "text": "عجیب شبی داشتیم ما دیشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 784.84,
   "end": 788.06,
   "text": "باور کنید حالا اینا رسانه‌ای می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 788.06,
   "end": 791.02,
   "text": "خیلی نمی‌خوام چیزی بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 791.02,
   "end": 793.3,
   "text": "بعضیا متعجب بشن اما واقعاً اینطوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 793.3,
   "end": 796.34,
   "text": "اثر نفس. به ایشون گفتم آقا یه عمر ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 796.34,
   "end": 801.44,
   "text": "فراق بودیم. شما این همه در تحت نفس ایشون خوشا به سعادتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 801.44,
   "end": 807.48,
   "text": "واقعاً. ایشون می‌فرمودن که علامه واقعاً ما از نزدیک می‌دیدیم مظهر رحمت واسعه خدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 807.48,
   "end": 811.6,
   "text": "با همه رحمت، رأفت داشت، رحمت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 811.6,
   "end": 817.5,
   "text": "عجیب! عجیب! و ما اگر بعضی موقع‌ها که از نزدیکشونو زیارت کرده‌ بنده، خود بنده اینو واقعاً دیدم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 817.5,
   "end": 819.52,
   "text": "تو همون چند بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 819.52,
   "end": 821.88,
   "text": "واقعاً اینطوری بود. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 821.88,
   "end": 826.72,
   "text": "کسی که از دنیا برود مظهر این رأفت باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 826.72,
   "end": 829.94,
   "text": "اون رب خودش می‌شه رب رؤوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 829.94,
   "end": 831.9,
   "text": "رب رؤوف رو زیارت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 831.9,
   "end": 835.36,
   "text": "اما کسی شد مظهر ذو انتقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 835.36,
   "end": 839.08,
   "text": "یا اسم قهار خدا، شکنندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 839.08,
   "end": 844.48,
   "text": "او خدا رو در مقام ذو انتقام، خدا رو در با اون اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 844.48,
   "end": 846.96,
   "text": "یا قهارش زیارت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 846.96,
   "end": 850.04,
   "text": "خدا می‌شکندش. خدا انتقام می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 850.04,
   "end": 853.94,
   "text": "شدید العقابه. اصلاً رحم نداره به احدی این آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 853.94,
   "end": 857.28,
   "text": "این شخص، این خانم. خب وقت مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 857.28,
   "end": 859.46,
   "text": "یه معنای ریب المنون اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 859.46,
   "end": 863.32,
   "text": "اضطراب می‌گیرتش چون با هیچکس آرامش نداشته با هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 863.32,
   "end": 865.6,
   "text": "با همه شلاقی برخورد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 865.6,
   "end": 867.94,
   "text": "حالا با شلاقی باهاش برخورد می‌کنند لب مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.94,
   "end": 871.34,
   "text": "ریب المنون. توجه کردید این اضطراب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 871.34,
   "end": 880.8,
   "text": "یه معنای دیگه‌ش حالا این معنای دوم رو بعداً قبلاً یه چیزهایی عرض کرده بودیم در این ات-اختتامیه بحث جهت اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 880.8,
   "end": 883.44,
   "text": "موضوع دو مرتبه عرض می‌کنیم چیزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 883.44,
   "end": 890.24,
   "text": "اونم اینکه حواستون جمع باشه یعنی حواسمون ما هم قاطی شما جمع باشه که لحظه مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 890.24,
   "end": 894.68,
   "text": "علت اون سکره، اون بیهوشی، علت این اضطراب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 894.68,
   "end": 899.7,
   "text": "ناراحتی، علت این ترس و وحشت و غلبه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 899.7,
   "end": 903.86,
   "text": "نامأنوس بودن با حقایق باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 903.86,
   "end": 906.48,
   "text": "ما همش با ظاهر طرف بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 906.48,
   "end": 910.1,
   "text": "مگر نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 910.1,
   "end": 914.04,
   "text": "من هر درسی از در-دروس علامه رو گوش میدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 914.04,
   "end": 916.62,
   "text": "صوتش رو عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 916.62,
   "end": 921.98,
   "text": "حتی موضوع چیز دیگه‌ای علامه ببینید تو همه درساش به این آیه اشاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 921.98,
   "end": 924.62,
   "text": "هو ظاهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 924.62,
   "end": 929.2,
   "text": "هو باطنه. خب چرا تو فقط با ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 929.2,
   "end": 932.14,
   "text": "مرتبط بودی، با باطن نبودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 932.14,
   "end": 935.3,
   "text": "توحیدت کامل نبوده. ناقصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 935.3,
   "end": 937.42,
   "text": "باید در سیر استکمالی‌ت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 937.42,
   "end": 942.94,
   "text": "در تکامل برزخی توحیدت تکمیل بشه و الا نمی‌شه به سمت حضرت حق حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 942.94,
   "end": 945.72,
   "text": "اون مظهر اون همه کمالات رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 945.72,
   "end": 947.8,
   "text": "تو می‌خوای به سمت او حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 947.8,
   "end": 951.18,
   "text": "خب باید این نقص برطرف بشه. می‌شه عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 951.18,
   "end": 953.72,
   "text": "رفع این نقص‌ها می‌شه عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 953.72,
   "end": 956.64,
   "text": "رفع این نقص‌ها می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 956.64,
   "end": 958.74,
   "text": "اون ترس و اضطراب و عذاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 958.74,
   "end": 964.18,
   "text": "هنگام مرگ. خب برطرف بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 964.18,
   "end": 970.14,
   "text": ". ارتباط با باطن عالم عزیزان دلم یعنی عبور از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 970.14,
   "end": 975.7,
   "text": "مثل این که می‌خوای خواب رو تعبیر کنی از ظاهر به باطن عبور باید بکنی، تعبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 975.7,
   "end": 977.86,
   "text": "از ظاهر خواب به باطن خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 977.86,
   "end": 984.1,
   "text": "عبور کنی. ما هیچ چاره‌ای نداریم جز اینکه از ظاهر این عالم به باطنش سفر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 984.1,
   "end": 989.94,
   "text": "یعنی همون مرگ یا موت اختیاری که اگر غیر از این باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 989.94,
   "end": 994.06,
   "text": "خیلی خدا ما رو دوست داشته باشه با موت اضطراری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 994.06,
   "end": 999.68,
   "text": "اضطراری، با موت اضطراری ما رو آماده موت اجباری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 999.68,
   "end": 1003.6,
   "text": "موت اجب- اضطراری، مصیبت‌ها، سختی‌ها، مریضی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1003.6,
   "end": 1005.74,
   "text": "اینا موت اضطراری میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1005.74,
   "end": 1010.0,
   "text": "باید کسیو دوستش نداشته باشه که هیچی موت اضطراری هم بهش نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1010.0,
   "end": 1012.3,
   "text": "همون موت اجباری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1012.3,
   "end": 1017.5,
   "text": "تمام. ریب المنون. چنان ناآرامه، چنان چرا مأنوس نبوده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1017.5,
   "end": 1023.08,
   "text": "یه دفعه مواجه می‌شه با یه عالمی که به هیچ عنوان از این عالم سر در نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1023.08,
   "end": 1025.04,
   "text": "خودتون رو بذارید جای همچین کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1025.04,
   "end": 1028.52,
   "text": "چه حالتی پیدا می‌کنه؟ خب ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1028.52,
   "end": 1032.84,
   "text": "انشاالله که امام عصر همین مقدار رو از ما قبول کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1032.84,
   "end": 1035.7,
   "text": "اگرچه می‌دونم همه مباحث ما ناپخته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1035.7,
   "end": 1038.8,
   "text": "همش. واقعاً بخوای بحث پخته بشه اوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1038.8,
   "end": 1040.36,
   "text": "باید سالیان سال وقت گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1040.36,
   "end": 1042.54,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1042.54,
   "end": 1047.68,
   "text": "عاقبتمون انشاالله ختم به خیر باشد به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1047.68,
   "end": 1054.46,
   "text": "الله- اللهumma صلي على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}