   "title": "## تبعیت سهوی از امام جماعت",
   "start": 0.24,
   "end": 112.08
  },
  {
   "index": 1,
   "title": "## نفی ریب از قیامت در قرآن",
   "start": 112.08,
   "end": 215.16
  },
  {
   "index": 2,
   "title": "## تنزل تجلی نه تجافی؛ صمدیت حق",
   "start": 215.16,
   "end": 390.56
  },
  {
   "index": 3,
   "title": "## الصلاة معراج المؤمن؛ درک قیامت در همین‌جا",
   "start": 390.56,
   "end": 410.7
  },
  {
   "index": 4,
   "title": "چگونه چشم باز شود؟ سورهٔ تکاثر آیهٔ پنج و شش:",
   "start": 410.7,
   "end": 684.28
  },
  {
   "index": 5,
   "title": "## نماز شب و جلوات الهی در چهره",
   "start": 684.28,
   "end": 1025.6
  },
  {
   "index": 6,
   "title": "آیهٔ بیست سورهٔ حدید همین موضوع را تصریح می‌کند:",
   "start": 1025.6,
   "end": 1130.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 4.18,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.18,
   "end": 8.16,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.16,
   "end": 13.48,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.48,
   "end": 17.02,
   "text": "در خصوص احکام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.02,
   "end": 19.12,
   "text": "عرض کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.12,
   "end": 25.82,
   "text": "اگر کسی در تبعیت از امام جماعت سهواً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.82,
   "end": 29.62,
   "text": "مشکل پیدا کنه به این صورت که مثلا از رکوع یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.62,
   "end": 35.08,
   "text": "سجود یا سجده بلند شه ببینه هنوز امام در رکوعه یا سجده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.08,
   "end": 41.98,
   "text": "اینجا تکلیفش چیه؟ باید صبر کنه تا امام سر برداره از رکوع یا سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.98,
   "end": 49.14,
   "text": "یا باید ملحق بشه؟ فرمودن که باید ملحق بشه به امام سریعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.14,
   "end": 53.2,
   "text": "سریعاً باید تبعیت کنه، برگرده به رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.2,
   "end": 56.0,
   "text": "و سجده. حالا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.0,
   "end": 59.8,
   "text": "وقتی که در اثنایی که داره میره به رکوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.8,
   "end": 64.08,
   "text": "قبل از اینکه به رکوع وارد بشه امام سر بلند کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.08,
   "end": 69.14,
   "text": "یا در سجده و ایشون رفت به رکوع یا سجده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.14,
   "end": 70.78,
   "text": "امام سرش رو بلند کرد ایشون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.78,
   "end": 75.36,
   "text": "یعنی سجده یا رکوع امام رو دیگه تو نوبت دوم درک نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.36,
   "end": 79.0,
   "text": "اینجا چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.0,
   "end": 83.02,
   "text": "اگر در رکوع باشه چون دو تا رکوع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.02,
   "end": 88.14,
   "text": "و میشه دو تا رکن یعنی اضافه میشه به رکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.14,
   "end": 92.7,
   "text": "اضافه و کم شدن رکن هم چه سهواً چه عمداً نماز رو باطل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.7,
   "end": 99.88,
   "text": "در سجده اگر تو دو تا سجده این اتفاق بیفته نماز باطل میشه چون سجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.88,
   "end": 103.3,
   "text": "رکنه نه سجده. دو تاش با هم رکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.3,
   "end": 106.8,
   "text": "پس وظیفه ما این هست که برگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.8,
   "end": 111.88,
   "text": "اما حواسمون به این نکته ظریف هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.88,
   "end": 118.06,
   "text": "اما امروز اگر خدا بخواد، اگر به هر حال خدا لطف کنه بتونیم جمع کنیم بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.06,
   "end": 124.0,
   "text": "قلب مرید رو وقتی میریم جلو خب ما هم از اول که خیلی قصد نداریم اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.0,
   "end": 129.46,
   "text": "ااا بحث رو طولانی کنیم اما می‌جوشه، حقایق، مطالب اینا می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.46,
   "end": 131.76,
   "text": "حالا چگونه بماند می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.76,
   "end": 135.46,
   "text": "بعد ما دلمون نمیاد بعضی نکات بسیار کلیدی رو نگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.46,
   "end": 143.14,
   "text": "چه کنیم؟ اما خب باید الان زودتر جمع شه ما از شصت نکته تازه تو بیست تاش موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.14,
   "end": 147.28,
   "text": "یکی از دیگه از جاهایی که قرآن نفی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.28,
   "end": 153.22,
   "text": "شک رو در رابطه با او یا أشد شک رو یا ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.22,
   "end": 156.94,
   "text": "در خصوص قیامت است. اتفاقاً بعضی از دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.94,
   "end": 162.14,
   "text": "عضو کانال مرام گمنامی پرسش‌هایی کرده بودند از طریق حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.14,
   "end": 164.02,
   "text": "ادمین به ما رسوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.02,
   "end": 168.62,
   "text": "خوب این نکته رو گوش بدن انشاالله سؤالشون برطرف می‌شه که حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.62,
   "end": 172.8,
   "text": "قیامت یا برزخ اینا نوع ارتباط ما با اون‌ها چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.8,
   "end": 176.88,
   "text": "اولاً آیه 9 سوره آل عمران می‌فرماید \"ربنا إنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.88,
   "end": 183.12,
   "text": "جامع الناس\" پروردگار ما تو کسی هستی که جمع می‌کنی، جامعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 183.12,
   "end": 186.14,
   "text": "جمع می‌کنی همه مردم را الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.14,
   "end": 188.16,
   "text": "\"ليوم لا ريب فيه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.16,
   "end": 193.86,
   "text": "لا ريب فيه. مطلقا شک در-- اصلاً شک بردار نیست اون روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.86,
   "end": 197.32,
   "text": "روز قیامت، روز تجمع، روز جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.32,
   "end": 199.7,
   "text": "یعنی مقام جمعی دارد قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.7,
   "end": 203.54,
   "text": "مثل ااا دنیا نیست که این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.54,
   "end": 207.4,
   "text": "کثرات باشد و پخش و پلا و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.4,
   "end": 211.08,
   "text": "در اونجا یک حقیقت واحده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.08,
   "end": 213.44,
   "text": "مجرداته دیگه. همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.44,
   "end": 217.66,
   "text": "جمع می‌شن. حالا این چگونه قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.66,
   "end": 224.42,
   "text": "توجیه یا فهم هست این رو-- این نکته رو داشته باشید که اتفاقاً هم در فصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.42,
   "end": 227.58,
   "text": "ابن عربی پیرامون این پرداخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.58,
   "end": 234.38,
   "text": "هم در ممت اللهمم حضرت آقا مصطفی نژاد علیه رحمة توضیح داده، شرح این نکته رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.38,
   "end": 237.46,
   "text": "من مختصرًا عرض می‌کنم. جمله اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.46,
   "end": 239.12,
   "text": "که حالا اونا شرح و بسطش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.12,
   "end": 241.94,
   "text": "مطلقا هیچ چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.94,
   "end": 245.16,
   "text": "بالاستقلال نازل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.16,
   "end": 247.98,
   "text": "استقلال نه، یعنی کاملاً نازل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.98,
   "end": 251.68,
   "text": "هیچ چیزی. آیه‌ش هم بارها قرائت کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.68,
   "end": 254.22,
   "text": "\"إن من شيء\" یعنی هیچ چیزی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.22,
   "end": 258.22,
   "text": "\"إلا عندنا خزائنه\" خزانه‌ش پیش ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.22,
   "end": 261.42,
   "text": "و ما \"ننزلها إلا بقدر معلوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.42,
   "end": 265.52,
   "text": "به قدر معلوم هر کسی به سه وجودی هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.52,
   "end": 268.8,
   "text": "حقایق نازل شده. هیچ چیزی نازل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.8,
   "end": 272.02,
   "text": "تماماً نازل نشده حتی من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.02,
   "end": 280.34,
   "text": "که اگر قرار باشد پیوست ما از اون الهیت نظام هستی بهتره بگیم از ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.34,
   "end": 284.5,
   "text": "جدا بشه و ما استقلالاً پیاده شده باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.5,
   "end": 287.66,
   "text": "اصلاً دیگه وجود حضرت حق صمدی نمی‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.66,
   "end": 289.68,
   "text": "صمد از صمد پر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.68,
   "end": 293.22,
   "text": "پره پر. همه جا ازش همه جا رو پر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.22,
   "end": 295.86,
   "text": "هیچ کجا ازش خالی نیست که اگر بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.86,
   "end": 299.14,
   "text": "مثلاً این یک چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.14,
   "end": 303.9,
   "text": "این یک چیز حالا انسان، جماد، نبات، حیوان، ملائکه، هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.9,
   "end": 311.98,
   "text": "اینجا مثلاً استقلال داره یعنی خدا درش نیست که اصلاً این دیگه تو یه جایی رو پیدا کردی یعنی در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.98,
   "end": 313.54,
   "text": "محدود کردی خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.54,
   "end": 315.58,
   "text": "دیگه صمد نیست. نامحدوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.58,
   "end": 318.66,
   "text": "پره پره. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.66,
   "end": 325.64,
   "text": "اینطوری میشه متوجه شد که اگرچه هم قرآنه هم بحث عقلیه اما قابل فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.64,
   "end": 328.82,
   "text": "جمع می‌شه با کمک روایات که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.82,
   "end": 331.66,
   "text": "اصلی داریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.66,
   "end": 337.04,
   "text": "فرعی یا اون اصل متفرع است بر فروعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.04,
   "end": 344.2,
   "text": "متعددی. یه وجهش، یه فرعش عالم ظاهره اصطلاحاً که بهش می‌گیم دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.2,
   "end": 346.76,
   "text": "نسبت به این دنیا بقیه غیب‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.76,
   "end": 350.08,
   "text": "نسبت به این دنیا. و الا همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.08,
   "end": 352.04,
   "text": "به یک معنا ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.04,
   "end": 355.8,
   "text": "به یک معنا همه چی غائب است، غیب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.8,
   "end": 357.82,
   "text": "حالا اینا رو قبلاً غیب یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.82,
   "end": 361.02,
   "text": "ظاهر یعنی چی؟ صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.02,
   "end": 365.76,
   "text": "پس مهم فعلاً اینجا اینه که بدونیم هممون بدون استثنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.76,
   "end": 369.32,
   "text": "اتصال داریم و تنزل پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.32,
   "end": 372.9,
   "text": "نه مثل تجافی باران که وقتی از اون بالا اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.9,
   "end": 374.76,
   "text": "رسید به زمین دیگه اون بالا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.76,
   "end": 379.68,
   "text": "نه، تجلیه. مثل خورشید که اونجا هست نورش اینجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.68,
   "end": 386.42,
   "text": "این انشعاب این شعاع نور همینطوری ممتد ادامه داره از خورشید کشیده شده تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.42,
   "end": 389.8,
   "text": "من و شمام ارتباطمون قطع نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.8,
   "end": 396.82,
   "text": "این که میگه اس-- الصلاة معراج المؤمن یعنی شما باید به گونه‌ای نماز بخونی که متوجه اون اتصالت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.82,
   "end": 402.04,
   "text": "اگر کسی متوجّه هر میزان، اینجا دقت کنید بحث مقدار عقلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.04,
   "end": 405.14,
   "text": "اگرچه مبناش قرآن و نقل و روایته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.14,
   "end": 407.06,
   "text": "که روایات هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.06,
   "end": 409.32,
   "text": "می‌دونید با فرمایش حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.32,
   "end": 412.22,
   "text": "به منزله بدن‌ن برای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.22,
   "end": 420.44,
   "text": "در خصوص قرآن. چگونه که نه-- چگونه که بدن یکی از شئون نفسه و مرتبه انزل نفس وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.44,
   "end": 422.9,
   "text": "بدن جدایی از نفس که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.9,
   "end": 426.88,
   "text": "یعنی قوای نفس در بدن تجلی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.88,
   "end": 432.88,
   "text": "روایات هم نسبت به قرآن به منزله بدن‌ن برای نفس یا برای اون روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.88,
   "end": 435.7,
   "text": "یعنی روایات مبین آیات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.7,
   "end": 443.22,
   "text": "حالا کمک‌های عقلی هم باعث می‌شه که ما بهتر این روایات و آیات رو بفهمیم که بزرگان کمک کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 443.22,
   "end": 450.68,
   "text": "هر مقدار در این اتش-- این شعاع نور و این اتصال رو توجه داشته باشید پس هیچ چیزی استقلال نداره من‌جمله من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.68,
   "end": 456.9,
   "text": "هر مقدار از این نقطه‌ای که الان درش قرار گرفتی ظاهر، ظاهر دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.9,
   "end": 462.9,
   "text": "هر مقدار دیدت باز بشه این اتصال رو بفایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.9,
   "end": 465.66,
   "text": "افق دیدت، نگاهت بالا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.66,
   "end": 473.3,
   "text": "حالا هی هر چقدر بتونی عروج کنی، معراج بری، بالا بری، نگاهت باز بشه به این مدارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.3,
   "end": 475.72,
   "text": "که بهش می‌گن معارج، عروجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.72,
   "end": 478.9,
   "text": "مدارج مراتب معراج‌مان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.9,
   "end": 482.22,
   "text": "هر مقدار نگاهت باز بشه به باطن باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.22,
   "end": 484.36,
   "text": "همون مقدار از قیامت رو درک کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.36,
   "end": 486.44,
   "text": "ولی همین جا درک می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.44,
   "end": 489.74,
   "text": "همین جاست. جای دیگه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.74,
   "end": 493.5,
   "text": "اتصال ادامه پیدا کرده و الا همین جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.5,
   "end": 497.04,
   "text": "لذا همه بزرگان اهل معرفت، حکما، عرفا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 497.04,
   "end": 499.66,
   "text": "صحف نوریه عرفانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.66,
   "end": 503.9,
   "text": "حتی حکمت متعالیه ملاصدرا اینا همه متفق القول‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.9,
   "end": 509.56,
   "text": "که قیامت، آخرت، برزخ، مثال همه اینا باطن همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.56,
   "end": 515.0,
   "text": "همین جا. لذا شما همین جا می‌تونی ارتباط پیدا کنی با عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.0,
   "end": 521.5,
   "text": "بهترین وجهش هم بر فهم و سهولت فهم این قصه همون خوابیه که خدا کار رو برا ما آسون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.5,
   "end": 529.26,
   "text": "در عالم خواب من و شما به برزخ وجودیمون سرکشی می‌کنیم، میریم مرتبط می‌شیم حتی اونجا ارواح رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.26,
   "end": 532.08,
   "text": "کسایی که از دنیا رفتن رو چگونه می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 532.08,
   "end": 534.28,
   "text": "همین ارتباط همینه. حالا اون یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 534.28,
   "end": 541.72,
   "text": "تنزل داره چون همه می‌تونن، همه می‌تونن تو عالم برزخ اون چنینی در خواب اذنش داده شده بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.72,
   "end": 545.88,
   "text": "اما حالا اون برزخ چون برزخ منفصل داریم، متصل داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 545.88,
   "end": 548.72,
   "text": "این برازخ هم یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.72,
   "end": 551.76,
   "text": "مثال‌ها، عالم مثال هم این‌ها هم مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 551.76,
   "end": 554.5,
   "text": "ذو مراتب‌اند. همه عالم ذو مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 554.5,
   "end": 558.26,
   "text": "همچون که حضرت حق ذو مراتبه، تو ذو مراتبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.26,
   "end": 560.4,
   "text": "حالا این چنینی می‌شه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.4,
   "end": 563.56,
   "text": "چگونه چه کنیم که چشممون باز بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 563.56,
   "end": 569.46,
   "text": "اجازه بفرمایید از یکی از آیات قرآن این سؤال رو جواب بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.46,
   "end": 574.8,
   "text": "در سوره تکاثر آیه پنج و شش رو اگر ملاحظه فرموده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 574.8,
   "end": 579.36,
   "text": "کَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 579.36,
   "end": 586.28,
   "text": "نه قطعاً اگر به علم یقین برسید لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 586.28,
   "end": 588.52,
   "text": "لا تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 588.52,
   "end": 591.06,
   "text": "تَرَوُنَّ الْجَحِيمَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 591.06,
   "end": 594.2,
   "text": "قطعاً می‌بینید جهنم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 594.2,
   "end": 596.88,
   "text": "قطعاً می‌بینید. اگه به چی برسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.88,
   "end": 600.26,
   "text": "علم اليقين. که اینا هم بحث‌هاش گذشته یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 600.26,
   "end": 608.74,
   "text": "معرفت که به تو دید می‌ده که بهترین جایی که به تو دید میده و معرفت درش خوابیده قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 608.74,
   "end": 612.48,
   "text": "از حضرت علامه عسگرزاده رحمت الله علیه در جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.48,
   "end": 620.78,
   "text": "شرح فصوص‌شون شنیدم که ایشون فرمود مشایخ ما بسیار تأکید می‌کردن که اگر می‌خوای دیدت باز بشه قرآن زیاد بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 620.78,
   "end": 623.56,
   "text": "معنوس با قرآن باش. دید میده به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.56,
   "end": 626.44,
   "text": "نگاه رو باز می‌کنه. البته ممارست می‌خواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.44,
   "end": 628.48,
   "text": "تمرین می‌خواد. حالا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 628.48,
   "end": 633.28,
   "text": "چطور هستش که ما اینو تو دنیا خیلی نمی‌فهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 633.28,
   "end": 638.78,
   "text": "به جهت اینکه تو دنیا مشوبه یعنی باطل و حق با هم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 638.78,
   "end": 641.7,
   "text": "توجه کردید باطل در کنار حق وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.7,
   "end": 645.16,
   "text": "برای همین مشوب شده. قاطیان این‌ها با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.16,
   "end": 651.34,
   "text": "برای همین تو دنیا که هستی یه مقدار دچار شک، بعضاً ریب، تزلزل می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.34,
   "end": 655.5,
   "text": "اما وقتی ورود کردی به قیامت اصلاً دیگه شک‌بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 655.5,
   "end": 659.74,
   "text": "و اگر کسی تو همین دنیا، تو همین دنیا قیامتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 659.74,
   "end": 663.0,
   "text": "که به پا شده، همین الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 663.0,
   "end": 665.54,
   "text": "اقترب الساعة، اقترب الساعة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.54,
   "end": 668.52,
   "text": "ساعت قیامت نزدیک شده که از معنایش-- معانیش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 668.52,
   "end": 670.18,
   "text": "نزدیک توئه، بغل دست توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 670.18,
   "end": 672.46,
   "text": "چشمتو باز کن لَتَرَوُنَّ الْجَحِيمَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 672.46,
   "end": 675.56,
   "text": "ببین حتی لَتَرَوُنَّ النَّعِيمَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 675.56,
   "end": 678.06,
   "text": "به یک معنا نعیم رو هم می‌تونی الان ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.06,
   "end": 683.36,
   "text": "چشمتو باز کن ببین. چشمتو باز کنی قیامت به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 683.36,
   "end": 691.7,
   "text": "الان چگونه قیامت به پا شده که وقتی یه کسی یه مقدار تمرین و ممارست در همین نماز شب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 691.7,
   "end": 694.48,
   "text": "که نماز شب به انسان توحد میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.48,
   "end": 698.22,
   "text": "وحدت میده، از اون تفرق و تشتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 698.22,
   "end": 703.44,
   "text": "دور می‌کنه انسان رو. باعث می‌شه ورود کنی به حقایق و به باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.44,
   "end": 706.86,
   "text": "که بدون اون نمی‌شه اصلاً، امکان‌پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 706.86,
   "end": 711.04,
   "text": "چگونه است که یه آدمی که مداومت داره بر سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 711.04,
   "end": 716.28,
   "text": "و بیداریش سحر و نماز شب قیافه‌ش کاملاً با دیگران فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 716.28,
   "end": 719.3,
   "text": "حتی بدون چشم مسلح تو می‌تونی اینو بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.3,
   "end": 721.62,
   "text": "کاملاً قیافه چگو-- این نور از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.62,
   "end": 724.08,
   "text": "این جلوات الهیه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 724.08,
   "end": 730.24,
   "text": "صورتش از کجا اومده؟ که دیروز تو رسانه برنامه‌ای بود به بچه‌ها نشون دادم گفتم این آقا دکتر رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.24,
   "end": 733.76,
   "text": "این از آدمای خیلی خوب و نزد خدا مقربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 733.76,
   "end": 738.56,
   "text": "قیافه‌ش رو نگاه کردن یه ته ریشی داشت و کت شلوار اصلا به قیافه‌ش نمیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 738.56,
   "end": 740.84,
   "text": "گفتن حاجی فقط پوستش سفیده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 740.84,
   "end": 748.28,
   "text": "گفتم نه قشنگ توجه کنی متوجه میشی حتی با چشم غیرمسلح اون نور دیده می‌شه، اون جلوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 748.28,
   "end": 752.28,
   "text": "البته خوشش میاد دوست داره ببینه ادامه بده نگاهش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 752.28,
   "end": 757.72,
   "text": "اوه یعنی قیامت دیگه حتی خودت وقتی گناه می‌کنی چگونه حالت به هم می‌ریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 757.72,
   "end": 761.98,
   "text": "اعصابت به هم می‌ریزه، چگونه هی حالت ضیق پیدا می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 761.98,
   "end": 766.18,
   "text": "قیامت به پا شده، چشمت باز نشده ولی قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 766.18,
   "end": 771.86,
   "text": "به پا شده. عرض شود خدمتتون که حالا روایاتی داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 771.86,
   "end": 776.8,
   "text": "تو همین دنیا اهل دوزخ میرن به برهوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 776.8,
   "end": 781.44,
   "text": "حالا یه صحرایی هست بعضیا میگن سمت افریقاست حالا بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 781.44,
   "end": 789.28,
   "text": "و روایاتی هم از امام صادق صلوات الله علیه داریم که اهل ایمان میرن تو الحمد لله وادی السلام تجمع، تجمع می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 789.28,
   "end": 794.46,
   "text": "جالبه که امام صادق صلوات الله علیه با توجه به بعضی از آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 794.46,
   "end": 796.96,
   "text": "تصریح می‌کنند این قصه رو که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 796.96,
   "end": 799.24,
   "text": "بهشت و دوزخ برزخیه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 799.24,
   "end": 803.32,
   "text": "یعنی تو همین دنیاست. حضرت می‌فرمایند مال همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 803.32,
   "end": 805.66,
   "text": "یعنی تو همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 805.66,
   "end": 808.12,
   "text": "تو دل و تو باطن همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 808.12,
   "end": 809.82,
   "text": "به کدوم آیات استناد می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 809.82,
   "end": 814.28,
   "text": "مثلا آیه چهل و شش سوره غافر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 814.28,
   "end": 821.28,
   "text": "این حدیثی که دارم ذیل این آیه می‌خونم، مجمع البیان، جلد هشت، صفحه پونصد و بیست و شش امام صادق می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 821.28,
   "end": 825.72,
   "text": "ذیل کدوم آیه \"النار یعرضون عليها غدوا وعشیا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 825.72,
   "end": 829.14,
   "text": "به اهل این فرعونیان اینا کفار، مشرکین اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 829.14,
   "end": 831.92,
   "text": "صبح و شام آتش عرضه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 831.92,
   "end": 838.14,
   "text": "بعد حضرت فرمودن این مربوط به این دنیاست به این برزخ این دنیاییه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 838.14,
   "end": 840.12,
   "text": "که چون می‌گه صبح و شام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 840.12,
   "end": 845.44,
   "text": "اگر قرار باشه صبح و شب آتش بین عرضه بشه بین این دو، بین این دو اینا آسایش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 845.44,
   "end": 846.98,
   "text": "در حالی که قیامت این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 846.98,
   "end": 850.6,
   "text": "اصلاً آسایشی نیست. قیامت یعنی اونجا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 850.6,
   "end": 852.54,
   "text": "مطلقا. این مربوط به این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 852.54,
   "end": 854.86,
   "text": "یعنی همین جا تو برزخ دنیایی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 854.86,
   "end": 857.64,
   "text": "پس می‌شه مرتبط شد تو دنیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 857.64,
   "end": 862.86,
   "text": "یا آیه ای عرض شود خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 862.86,
   "end": 866.94,
   "text": "بله، آیه \"ربنا لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 866.94,
   "end": 870.74,
   "text": "تقم لنا الساعة\". اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 870.74,
   "end": 875.18,
   "text": "اهل آتش می‌گن که خدایا بر ما اون ساعت رو به پا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 875.18,
   "end": 878.12,
   "text": "الساعة اینجا فرمودن منظور روز قیامت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 878.12,
   "end": 881.42,
   "text": "اون قیامت کبری چون ما یه قیامت صغری داریم برزخ است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 881.42,
   "end": 883.58,
   "text": "قیامت کبری داریم. اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 883.58,
   "end": 886.66,
   "text": "اهل عذاب می‌گن برا ما به پا نکن اون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 886.66,
   "end": 890.5,
   "text": "چرا؟ چون الان تو مختصری عذاب‌اند صبح و شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 890.5,
   "end": 895.68,
   "text": "این نشون می‌ده که تو همین دنیا فعلاً معذب‌اند تو همین دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 895.68,
   "end": 900.58,
   "text": "منتها تو باطن لایه‌های باطنی که عرض شد اگه چشم باز بشه می‌شه دیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 900.58,
   "end": 904.9,
   "text": "یا مثلا سوره در خصوص نعمت بگیم اینقدر هم از عذاب نگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 904.9,
   "end": 909.62,
   "text": "آیه شصت و دو سوره مریم \"ولهم رزقهم فيها بكرة وعشیا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 909.62,
   "end": 913.08,
   "text": "روزی اهل بهشت صبح و شب می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 913.08,
   "end": 915.58,
   "text": "این نشون می‌ده که اینها باز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 915.58,
   "end": 919.76,
   "text": "بین اگر قرار باشه صبح و شب برسه بین اون دو تا یعنی معذب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 919.76,
   "end": 925.12,
   "text": "پس اینم مربوط به دنیاست. لذا پیغمبر فرمود \"الناس نيام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 925.12,
   "end": 927.66,
   "text": "اذا ماتوا انتبهوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 927.66,
   "end": 930.3,
   "text": "مردم همه خوابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 930.3,
   "end": 932.42,
   "text": "وقتی می‌میرن بیدار می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 932.42,
   "end": 936.66,
   "text": "یعنی چی بیدار می‌شن؟ مثل اینکه تو می‌خوابی تازه بیدار شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 936.66,
   "end": 939.7,
   "text": "چشمت به ملکوت عالم تو خواب باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 939.7,
   "end": 943.06,
   "text": "قطعاً چشم تو، تو ملکوت عالم باز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 943.06,
   "end": 945.34,
   "text": "و الا هرچی، هرچی می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 945.34,
   "end": 947.26,
   "text": "یه مرحله اینو دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 947.26,
   "end": 951.2,
   "text": "یه مرحله باطنی‌تر از عالم ماده رو داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 951.2,
   "end": 956.5,
   "text": "هرچی می‌بینی حتی تو خواب اگه خودت رو ببینی مرحله مثالی خودت رو داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 956.5,
   "end": 958.78,
   "text": "یعنی چشمت باز شد به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 958.78,
   "end": 961.68,
   "text": "اگه کعبه ببینی کعبه مثالی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 961.68,
   "end": 965.58,
   "text": "یعنی اون اتصالات \"ان من شيء الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 965.58,
   "end": 970.64,
   "text": "و عندنا خزائنه\" اون رفتی به بالاتر نزدیک به خزانه شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 970.64,
   "end": 972.84,
   "text": "هرچی که می‌بینی تو خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 972.84,
   "end": 975.34,
   "text": "مرتبه مثالیشه حداقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 975.34,
   "end": 982.76,
   "text": "اگر کسی قوی شد تمثيلات حضرت علمه رو ببینید در کتاب انسان در عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 982.76,
   "end": 985.38,
   "text": "هرچی قوی‌تر بشیم می‌تونیم اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 985.38,
   "end": 989.4,
   "text": "ممثلا اون حالا مثال‌های بالاتر رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 989.4,
   "end": 992.98,
   "text": "بودن کسایی که قشنگ قیامت کبری رو بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 992.98,
   "end": 996.72,
   "text": "که الهیت نظام رو هم شنید، دیدن، شنیدن صوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 996.72,
   "end": 998.48,
   "text": "پیغمبر چگونه معراج رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 998.48,
   "end": 1002.96,
   "text": "اون جهنم قطعیه رو دید همه معذب بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1002.96,
   "end": 1005.2,
   "text": "چگونه رفت؟ مگه تو همین دنیا نرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1005.2,
   "end": 1008.18,
   "text": "پس تو همین جا چشم باز می‌شه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1008.18,
   "end": 1011.04,
   "text": "اگرچه وقت گذشته ولی این آیه خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1011.04,
   "end": 1013.06,
   "text": "این رو هم گوش بدید و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1013.06,
   "end": 1017.1,
   "text": "ببینید این آیه چقدر قشنگ همین موضوع رو تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1017.1,
   "end": 1020.52,
   "text": "آیه بیست سوره حدید برید ذیلش بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1020.52,
   "end": 1025.6,
   "text": "اعلموا، بدونید \"انما الحياة الدنيا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1025.6,
   "end": 1027.88,
   "text": "حیات دنیا پنج تا چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1027.88,
   "end": 1030.48,
   "text": "خصوصیاتش این چیزاست. \"لعب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1030.48,
   "end": 1039.64,
   "text": "و لهو و زينة وتفاخر بينكم وتكاثر في الاموال والاولاد\" این پنج تا چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1039.64,
   "end": 1043.28,
   "text": "چیه؟ لعب، لهو، زینه، تفاخر، تکاثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1043.28,
   "end": 1045.54,
   "text": "البته تکاثر در اموال و اولاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1045.54,
   "end": 1055.92,
   "text": "\"كمثل غيب اعجب الكفار نباته ثم يهج فتراه مصفرا ثم يكون حطاما وفي الاخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1055.92,
   "end": 1062.86,
   "text": "عذاب شديد ومغفرة من الله ورضوان وما الحياة الدنيا الا متاع الغرور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1062.86,
   "end": 1069.28,
   "text": "این را اگر این آیه \"وفي الاخرة عذاب شديد\" رو این قسمت آیه رو بیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1069.28,
   "end": 1071.24,
   "text": "کنار لعب و لهو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1071.24,
   "end": 1081.22,
   "text": "زینه و تفاخر و تکاثر و اینا قشنگ متوجه می‌شی که این پنج تا خاصیت دنیا همین عین این پنج تا باطن دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1081.22,
   "end": 1082.92,
   "text": "باطنش شده \"ولهم عذاب شديد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1082.92,
   "end": 1087.02,
   "text": "همین الانم همین الان این دنیا باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1087.02,
   "end": 1089.62,
   "text": "تو این پنج قصه آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1089.62,
   "end": 1093.7,
   "text": "مثل اون حدیثی که فرمود کسی که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1093.7,
   "end": 1098.88,
   "text": "مال یتیم می‌خوره، مال یتیم رو نمی‌خوره، آتش می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1098.88,
   "end": 1105.34,
   "text": "عینا داره آتش می‌خوره که اگر کسی چشم باطن بینش باز بشه می‌بینه داره آتش می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1105.34,
   "end": 1110.36,
   "text": "پس تو همین دنیاست. هیچ وقت خدا نمیاد این زمین و آسمون رو به این زیبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1110.36,
   "end": 1114.3,
   "text": "خلق کرده بعد بزنه داغونش کنه که می‌خواد قیامت به پا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1114.3,
   "end": 1117.04,
   "text": "تو همین باطن همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1117.04,
   "end": 1120.14,
   "text": "قیامت همه به پا می‌شه. دوره دوره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1120.14,
   "end": 1125.4,
   "text": "ایشالا که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1125.4,
   "end": 1130.84,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}