 "chapters": [
  {
   "index": 0,
   "title": "## خانهٔ ساختهٔ کافر؛ حکم شرعی و دقایق عرفانی",
   "start": 1.22,
   "end": 179.96
  },
  {
   "index": 1,
   "title": "یکی دیگر از آیاتی که قلب شکاک و مریب را محل بحث قرار داده آیهٔ شصت‌ودو سورهٔ هود است. فرمودند:",
   "start": 179.96,
   "end": 266.76
  },
  {
   "index": 2,
   "title": "## تعصب جاهلی و زلزلهٔ باطن در برزخ",
   "start": 266.76,
   "end": 288.22
  },
  {
   "index": 3,
   "title": "یکی از معانی و بطون زلزلهٔ روز قیامت همان لحظهٔ من و توست:",
   "start": 288.22,
   "end": 411.49
  },
  {
   "index": 4,
   "title": "## فرق فینا و فی سبیلنا در مرام‌نامهٔ کربلا",
   "start": 411.49,
   "end": 591.15
  },
  {
   "index": 5,
   "title": "## جهاد اکبر و معرفت نفس؛ نمونهٔ عالم بی‌یقین",
   "start": 591.15,
   "end": 646.95
  },
  {
   "index": 6,
   "title": "## یقین در باطل؛ سخن حاج قاسم از رهبر",
   "start": 646.95,
   "end": 1086.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.22,
   "end": 3.88,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.88,
   "end": 6.42,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.42,
   "end": 11.42,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.42,
   "end": 14.96,
   "text": "استفتاء شده از رهبر عزیزمون که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.96,
   "end": 22.26,
   "text": "درسته که میگن خونه‌ای که توسط کافر ساخته شده باشه، چون الان خیلی این اتفاق میفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.26,
   "end": 28.76,
   "text": "حتی این شهرک‌سازی‌هایی که انبوه‌سازی‌هایی که صورت می‌گیره مثلا در پردیس خودمون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.76,
   "end": 33.8,
   "text": "تو تهران جاهای دیگه اینا بعضیاش رو میگن مثلا مال کوزوئه چه هم کجاست اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.8,
   "end": 38.42,
   "text": "بعضی پیمانکارا اصلا خارجی‌ان اصلا اسلام ندارن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.42,
   "end": 40.98,
   "text": "بعضیاشون اصلا کافرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.98,
   "end": 44.06,
   "text": "یعنی هیچ قائل نیستن. حالا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.06,
   "end": 46.78,
   "text": "سیاسی اقتصادی و این‌هاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.78,
   "end": 51.72,
   "text": "نیاز نظام کاری نداریم. بالاخره اون خونه‌ای که میگه کافر ساخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.72,
   "end": 54.82,
   "text": "بخوای بری توش زندگی کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.82,
   "end": 60.0,
   "text": "الان تو اجتماع این هست، این صحبت هست که آقا حداقلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.0,
   "end": 63.08,
   "text": "مکروهه. چون اون کافر نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.08,
   "end": 66.46,
   "text": "نجس اللعینه و داره با دست خودش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.46,
   "end": 70.76,
   "text": "خونه رو بنا می‌کنه و اون خونه نجس هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.76,
   "end": 76.74,
   "text": "یه مقدارم خب تو این قدیم‌ها این‌ها مرسوم بوده دیگه از جهت اخلاقی سیر و سلوک عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.74,
   "end": 82.96,
   "text": "می‌گفتن این درست بوده این بحث که آقا خونه‌تو بده دست یه آدم باخدا، مخصوصا چهارچوب در خونه‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.96,
   "end": 86.36,
   "text": "اینا اسراریه. ولی خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.36,
   "end": 93.32,
   "text": "آیا از جهت شرعی واقعاً نجسه اون خونه یا از جهت شرعی کراهت داره تو اون خونه نماز خوندن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.32,
   "end": 97.38,
   "text": "رهبر فرمودن نخیر، نه نجسه، نه کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.38,
   "end": 102.72,
   "text": "این بحث شرعی‌شه. اما بحث‌های عرفانی‌ش نه دیگه، اون قصه چیز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.72,
   "end": 104.96,
   "text": "کسی می‌خواد رشد کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.96,
   "end": 108.46,
   "text": "کسی می‌خواد ترقی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.46,
   "end": 113.26,
   "text": "به هر حال باید مسائل عرفانی رو با دقت نظر بیشتری توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.26,
   "end": 116.28,
   "text": "مثل اینکه یه حسینیه‌ای ساخته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.28,
   "end": 118.6,
   "text": "به نام حالا فاطمیون بود فکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.6,
   "end": 122.92,
   "text": "تمام کارکنا و بنا اینا همه کار می‌کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.92,
   "end": 126.38,
   "text": "براشون یه نفر مشغول بود بیست و چهار ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.38,
   "end": 128.16,
   "text": "روضه می‌خوند. زیرآشورا می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.16,
   "end": 133.24,
   "text": "روضه می‌خوند اینا کار می‌کردن و حالا هر کی میره تو اون حسینیه اصلاً منقلب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.24,
   "end": 136.04,
   "text": "اینا خیلی اینا اسرار نظام هستی‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.04,
   "end": 142.8,
   "text": "ولی خب شرعا اشکال نداره. حتی خونه می‌خواید بخرید خیلی خوبه که بدونید کی ساخته‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.8,
   "end": 151.08,
   "text": "اصلاً اون کسی که این خونه دستش بوده توش زندگی می‌کرده نفس شما یه آینه رو بگیر جلو دهنت ها کن ببین چی تار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.08,
   "end": 158.48,
   "text": "نفس خیلی مؤثره و اون کسی که این چهارچوب در خونه رو مخصوصاً باب منزل رو کار گذاشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.48,
   "end": 160.14,
   "text": "اینا همش توش حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.14,
   "end": 164.66,
   "text": "حالا بحث ما رو قلب مشک-- شکاک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.66,
   "end": 174.0,
   "text": "یکی دیگه از آیاتی که قلب، قلب شکاک رو و مریب رو مورد بحث قرار داده آیه شصت و دو سوره هوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.0,
   "end": 176.72,
   "text": "فرمود: \"قالوا یا صالح قد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.72,
   "end": 179.96,
   "text": "كنت فينا مرجوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.96,
   "end": 183.64,
   "text": "به حضرت صالح گفتن که آقا تو پیش از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.64,
   "end": 187.2,
   "text": "پیش ما آبرومند بودی. مورد اعتماد و آبروی ما بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.2,
   "end": 189.42,
   "text": "بهت امیدوار بودیم. چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.42,
   "end": 194.02,
   "text": "این‌ها \"قبل هذا\" قبل از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.02,
   "end": 199.56,
   "text": "\"أتهانا أن نعبد ما يعبد آباؤنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.56,
   "end": 206.84,
   "text": "ما تا وقتی که دیدیم تو با پدران ما مخالفت نمی‌کنی و با خدایان پدران ما مخالفت نمی‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.84,
   "end": 211.4,
   "text": "یعنی علنا حداقل قلباً که نبوده علنا اینو از تو ندیده بودیم با تو بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.4,
   "end": 214.3,
   "text": "اما حالا که اینطور شد \"و إننا لفي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.3,
   "end": 218.88,
   "text": "شك مما تدعونا إليه مريب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.88,
   "end": 221.6,
   "text": "ما دچار یه ریب و شکی شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.6,
   "end": 224.34,
   "text": "مریب، قلب مریب. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.34,
   "end": 226.64,
   "text": "چی باعث شده اینا اینجا با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.64,
   "end": 229.4,
   "text": "یکپارچه از حضرت صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.4,
   "end": 235.52,
   "text": "این‌ها خوبی و امانت‌داری و راستگویی و این‌ها دیده بودن هیچ خلافی از این‌ها ندیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.52,
   "end": 237.64,
   "text": "مثلا از پیغمبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.64,
   "end": 245.96,
   "text": "همه خوبی سرشار از امانت‌داری، راستگویی که امام صادق فرمود اصلا شیعیان ما رو با سه چیز امتحان کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.96,
   "end": 250.16,
   "text": "نه به کثرت و ط- طول رکوع و سجود با سه چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.16,
   "end": 252.7,
   "text": "امانت‌داری، راستگویی، وفای به عهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.7,
   "end": 257.14,
   "text": "همه این‌ها در اوج بود در پیغمبر ما یا حضرت صالح، انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.14,
   "end": 260.48,
   "text": "چطور می‌شه که یه دفعه این‌ها به شک می‌افتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.48,
   "end": 263.98,
   "text": "خودشونم داره قرآن داره می‌فرماید متزلزل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.98,
   "end": 266.76,
   "text": "میرن تو وادی ریب، تعصب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.76,
   "end": 270.56,
   "text": "تعصبات پدرانه، مادرانه، قوم و خیشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.56,
   "end": 277.18,
   "text": "که الان تو ما کم نیست. بسیاری از مردم متاسفانه حتی این‌هایی که برای حق هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.18,
   "end": 279.36,
   "text": "دچار تعصبات جاهلی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.36,
   "end": 282.44,
   "text": "خیلی جاهای قرآن تاکید به این نکته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.44,
   "end": 285.98,
   "text": "یعنی اصلاً از سر معرفت پیش نگرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.98,
   "end": 288.22,
   "text": "اعتقادات‌شون رو و اینا چوب می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.22,
   "end": 292.44,
   "text": "وقتی که ما رفتیم تو نشئه برزخ قرار گرفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.44,
   "end": 295.42,
   "text": "اونجا از ما سؤال کردن پیغمبرت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.42,
   "end": 297.04,
   "text": "امامت کیه؟ قبلت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.04,
   "end": 299.52,
   "text": "اینطور نیست که به لسانت جاری بشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.52,
   "end": 302.48,
   "text": "مثل الان حفظ کرده باشم بیام بشینم و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.48,
   "end": 307.66,
   "text": "اصلاً اینطوری نیست. اونجا اونچه که در باطن ماست بروز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.66,
   "end": 311.24,
   "text": "اونچه که در باطنه همون خودش رو نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.24,
   "end": 313.9,
   "text": "اصلاً کسی نمی‌تونه اونجا فیلم بازی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.9,
   "end": 318.2,
   "text": "آنچه که يقينه در وجودش می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.2,
   "end": 323.72,
   "text": "حالا اگر کسی دچار تعصبات بوده بدون معرفت همینطوری اونجا متزلزل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.72,
   "end": 328.14,
   "text": "یعنی اون یکی از معانی و بطون معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.14,
   "end": 331.22,
   "text": "اون باطن یکی از بواتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.22,
   "end": 335.24,
   "text": "معانی زلزله روز قیامت همون لحظه من و توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.24,
   "end": 341.24,
   "text": "\"إذا زلزلت الأرض زلزالها\" وقتی ارضه این زمین وجود من و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.24,
   "end": 349.8,
   "text": "به لرزه در میاد \"وأخرجت الأرض أثقالها\" اون چیزایی که ثقل بوده، سنگین بوده، ثقیل بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.8,
   "end": 356.52,
   "text": "می‌ریزه بیرون. اونچه که تو وجودت بوده يقينه‌ها می‌ریزه، يقيني‌ها می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.52,
   "end": 358.24,
   "text": "اصلاً نمی‌تونی جلو خودتو بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.24,
   "end": 362.86,
   "text": "هرچی در بعد \"وقال الإنسان ما له\" انسان می‌گه چه خبر شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.86,
   "end": 364.44,
   "text": "چرا من اینجوری دارم حرف می‌زنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.44,
   "end": 367.8,
   "text": "چرا؟ یعنی زبان به شهادت می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.8,
   "end": 371.47,
   "text": "حقیقتش رو نشون می‌ده توجه که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.47,
   "end": 374.37,
   "text": "حتی تو مرتبه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.37,
   "end": 379.05,
   "text": "راه حق ا-- شیعه اثنی عشریه که دیگه راهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.05,
   "end": 383.31,
   "text": "یقینی‌تر و محق‌تر از این ما نداریم که دیگه حاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.31,
   "end": 387.13,
   "text": "قضیه است اما همین جا هم بدون معرفت رفته باشه همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.13,
   "end": 393.45,
   "text": "کور کورانه و پدرم شیعه بود، مادرم شیعه بود، رفیقام، معلم و فامیلام اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.45,
   "end": 398.73,
   "text": "اینم اگر با نور معرفت نرفته باشه این نور بدل به ظلمت میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.73,
   "end": 401.63,
   "text": "و یخرجهم من النور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.63,
   "end": 405.35,
   "text": "الى الظلمات میشه. اینا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.35,
   "end": 407.59,
   "text": "نور خارج میشن به سمت ظلمت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.59,
   "end": 412.53,
   "text": "چرا؟ دچار تعصبات می‌شن. شما اگر توجه داشته باشید به اون فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.53,
   "end": 416.25,
   "text": "عجیبه، واقعا عجیبه ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.25,
   "end": 424.01,
   "text": "که جا داره واقعا یه دهه‌ی محرم رو این فرمایش ابا عبدالله که مرام‌نامه‌ی کربلائیا و حسینی‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.01,
   "end": 428.11,
   "text": "توجه کنید دو سه جمله آقا در خطبه‌ی حرکتشون از مکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.11,
   "end": 432.11,
   "text": "بیان می‌کنه. اول می‌فرماید إن کان باذلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.11,
   "end": 435.13,
   "text": "من کان ببخشید. من کان کسی که میخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.13,
   "end": 439.31,
   "text": "من کان باذلاً فينا مهجته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.31,
   "end": 441.81,
   "text": "که قبلاً مورد بحث قرار گرفت مختصراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.81,
   "end": 447.15,
   "text": "اگه کسی قصد کرده بریزه، بذل کنه، باذلاً فينا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.15,
   "end": 449.35,
   "text": "در ما. نمیگه فی سبيلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.35,
   "end": 453.21,
   "text": "اونم مهجته. الذین بذلوا مهجهم دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.21,
   "end": 456.39,
   "text": "که اون آخرین قطره‌ی خون قلبشون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.39,
   "end": 459.67,
   "text": "میگن تا آخرین قطره‌ی خون، تا آخرین نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.67,
   "end": 464.27,
   "text": "اینو بریزه پای ما. این اولین شرط حسینی شدن و کربلایی شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.27,
   "end": 466.53,
   "text": "آخرین قطره خونشون هم در ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.53,
   "end": 470.69,
   "text": "این خیلی نکته ظریفیه آقا اینجا برای اهلش گفته و رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.69,
   "end": 472.85,
   "text": "قربونش بریم. چه زیرکانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.85,
   "end": 474.97,
   "text": "فينا گفته نه فی سبيلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.97,
   "end": 477.71,
   "text": "چه فرقی بین فينا و فی سبيلنا داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.71,
   "end": 483.19,
   "text": "قبلاً یادمه تو بحث فرق بین مخلص و مخلص بر-بیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.19,
   "end": 486.33,
   "text": "مخلص برای خدا کار می‌کنه اما توقع پاداش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.33,
   "end": 491.45,
   "text": "گاهی حتی گلایه هم می‌کنه، منت هم می‌گذاره، توقع داره، چشم‌داشت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.45,
   "end": 493.83,
   "text": "اما مخلص مطلقا هیچی نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.83,
   "end": 496.93,
   "text": "اصلاً. انقدر شدت محبت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.93,
   "end": 502.21,
   "text": "یه معنای دیگه‌ش رو حضرت آقای جوادی آملی در تفسیر تسنیمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.21,
   "end": 505.77,
   "text": "انتهای سوره عنکبوت اونجایی که می‌فرماید الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.77,
   "end": 510.37,
   "text": "جاهدوا فينا لنهدينهم سبلنا رمزگشایی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.37,
   "end": 517.47,
   "text": "اونجا حضرت آقای جوادی آملی می‌فرماد اگر فينا یا فالله همون فی سبيل الله بود چرا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.47,
   "end": 520.19,
   "text": "میگه فينا لنهدينهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.19,
   "end": 524.81,
   "text": "سبلنا. سبل رو همون سبيل رو که جمعش میشه سبل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.81,
   "end": 527.89,
   "text": "اومده دوباره مطرح کرده بعد از فينا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.89,
   "end": 532.25,
   "text": "پس معلوم میشه که فالله با فی سبيل الله فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.25,
   "end": 535.49,
   "text": "معلوم میشه فلحسن یا فينا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.49,
   "end": 539.75,
   "text": "با فی طريق الحسن، فی سبيل الحسن با هم فرق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.75,
   "end": 544.41,
   "text": "اینا مشخص بشه. مثلاً میشه ما ت-- فی طريق الحسن باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.41,
   "end": 549.11,
   "text": "نجف تا کربلا که پیاده میرن انشاالله اولین قسمتش رو میگن طريق الحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.11,
   "end": 553.27,
   "text": "میشه کسی تو این طریق باشه اما در حینی که تو این طریقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 553.27,
   "end": 555.03,
   "text": "دچار شک و ریب هم باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.03,
   "end": 561.43,
   "text": "نگاهش به گناه هم بیفته، لذت‌های دیگه‌ای هم ببره، گناه هم و معصیت هم مثلاً اومده باشه اونجا دزدی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 561.43,
   "end": 567.31,
   "text": "ها؟ پیش میاد دیگه. میشه کسی تو جهاد باشه اما بعداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.31,
   "end": 572.53,
   "text": "منکر اصل جهاد مثل خیلی‌ها که تو جبهه شرکت کردن الان جلسات توبه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.53,
   "end": 577.19,
   "text": "هر شب جمعه جمع می‌شن توبه‌نامه می-می‌کنن و گریه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.19,
   "end": 583.53,
   "text": "تو قم هم متاسفانه زیاده که چرا اینا رفتن تو جنگ ما شرکت کردن مثلاً مسلمون‌کشی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 583.53,
   "end": 587.75,
   "text": "خب این تو جهاد بوده. این فی سبيل الله بوده اما فالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.75,
   "end": 591.95,
   "text": "نبوده. به یک معنا اینو بخوام بازترش کنم حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.95,
   "end": 594.53,
   "text": "خود آقای جوادی آملی مثال رو اینطوری می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.53,
   "end": 599.25,
   "text": "حرف ایشونه ها. نگید استنباط بنده‌ست و کاملاً هم دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.25,
   "end": 604.99,
   "text": "چون با فرمایشات دیگر حکما م-مخصوصاً حضرت علامه حسن‌زاده هم کاملاً می‌بینی منطبق है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.99,
   "end": 610.69,
   "text": "همه‌شون انگار یه حرف زدن. یه فرق بین فينا و فل-- فی سبيلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 610.69,
   "end": 615.03,
   "text": "یا فالله و فی سبيل الله اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.03,
   "end": 618.83,
   "text": "فی سبيل الله بدون معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.83,
   "end": 625.77,
   "text": "یا اگر هست کمه یا اگر هست هم-همراه با شک و ریبه یا اگر هست محکم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 625.77,
   "end": 627.51,
   "text": "استحکام پیدا نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.51,
   "end": 630.83,
   "text": "و یٰسِین، وَالْقُرْآنِ الْحَكِيمِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.83,
   "end": 633.45,
   "text": "حکیم از حکمت، از استحکام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 633.45,
   "end": 636.35,
   "text": "لا یمکن رفع الرد من حکومتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 636.35,
   "end": 638.67,
   "text": "یعنی حکومت ولایت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 638.67,
   "end": 641.37,
   "text": "حکومت وجودش به ولایت نرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.37,
   "end": 645.87,
   "text": "یعنی ولایت تو وجودش حکومت نکرده به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.87,
   "end": 649.07,
   "text": "اون میشه مثل این کسی که داره جهاد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.07,
   "end": 651.95,
   "text": "رفته تو راه خدا، تو راه خداست ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.95,
   "end": 655.75,
   "text": "اما بدون معرفت. یعنی بعد جالبه که حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 655.75,
   "end": 660.69,
   "text": "جوادی آملی می‌فرماید خصوصاً دست می‌ذاره رو بحث معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 660.69,
   "end": 665.35,
   "text": "می‌فرماید این فالله میشه جهاد اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 665.35,
   "end": 667.99,
   "text": "اینو یادتون باشه. فالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 667.99,
   "end": 674.77,
   "text": "میشه جهاد اکبر. فی سبيل الله میشه جهاد کبیر به قول ایشون یا جهاد اصغر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 674.77,
   "end": 677.01,
   "text": "یعنی رفته تو جهاد اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 677.01,
   "end": 678.93,
   "text": "جهاد اکبر نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 678.93,
   "end": 682.27,
   "text": "جهاد اکبر چی بود؟ خودشناسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.27,
   "end": 685.45,
   "text": "که نتیجه‌ش میشه خداشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 685.45,
   "end": 688.11,
   "text": "باید خودت رو بشناسی، خدا رو بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 688.11,
   "end": 694.71,
   "text": "پس اینجا ببینید چه قشنگ ابا عبدالله زیرکانه می‌فرماید من کان باذلاً فينا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.71,
   "end": 699.27,
   "text": "یعنی کسی که چنان خودش رو شناخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.27,
   "end": 702.37,
   "text": "و چنان بر خودش مستولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.37,
   "end": 709.57,
   "text": "استیلا پیدا کرده که ولایت ما در تمام سرائر وجودش که یوم الطبل سرائر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 709.57,
   "end": 715.97,
   "text": "این باطنش بعداً آشکار میشه، چنان حکومت وجودش بر اساس ولایت شکل گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 715.97,
   "end": 719.01,
   "text": "که دیگه این چی میشه؟ مهجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 719.01,
   "end": 723.13,
   "text": "حاضر میشه آخرین قطره خونش رو بده وگرنه اگر غیر از این باشه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.13,
   "end": 728.05,
   "text": "نمیشه. حضرت امام علیه الرحمه خ-- من از خود ایشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.05,
   "end": 731.31,
   "text": "صوت ایشون رو تو رادیو معارف بود ظاهراً پخش میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 731.31,
   "end": 733.85,
   "text": "گفت رفتیم بالا سر یه عالمی اسم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 733.85,
   "end": 736.48,
   "text": "عالمی که مستعد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.48,
   "end": 738.28,
   "text": "چقدر شاگر تربیت کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 738.28,
   "end": 743.84,
   "text": "چقدر کتاب داشت. هرچی شهادتین رو گفتیم تلقین کن دری وری به خدا گفت و مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.84,
   "end": 747.72,
   "text": "حضرت امام اینو گفت. چرا؟ اینا باید بترسونه ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 747.72,
   "end": 749.66,
   "text": "یعنی اینا یقین به یقین نرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 749.66,
   "end": 753.2,
   "text": "اونچه که دارن میگن معرفت شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 753.2,
   "end": 758.28,
   "text": "این گفتن‌ها، شنیدن‌ها بارها گفتیم اینا کم و کیف مسموع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 758.28,
   "end": 760.66,
   "text": "ماده‌ست. اینا باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 760.66,
   "end": 765.32,
   "text": "چون کانال وجودی تو رو به سوی اشراقات الهیه باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 765.32,
   "end": 772.18,
   "text": "یعنی تو، تو نری بررسی نکنی زندگی امام حسین رو از جهت فکری کار عقلی نکنی رو معارف به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 772.18,
   "end": 777.16,
   "text": "به سمت کسب معارف نری کانال وجودیت مسدوده بعد اشراقاتی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 777.16,
   "end": 786.14,
   "text": "اما اگر رفتی زحمت کشیدی، شخم زدی این علت مؤده میاد تو رو کمک می‌کنه برای علت طامعه که اشراقات اباعبدالله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 786.14,
   "end": 789.72,
   "text": "یعنی دیگه اباعبدالله خودش، خودش رو به تو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 789.72,
   "end": 797.42,
   "text": "اون می‌شه باز شدنت وقتی تو شخم زدی کانال وجودت رو باز کردی اون می‌شه دیگه نور معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 797.42,
   "end": 800.26,
   "text": "اصل نور معرفت مال ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 800.26,
   "end": 802.58,
   "text": "مال عالم بالاست. مال اباعبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 802.58,
   "end": 806.7,
   "text": "مال مرتبه‌ی قدس وجوده که بحث‌هاش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 806.7,
   "end": 809.52,
   "text": "اما از اینجا باید شروع کرد. از کسب معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.52,
   "end": 813.82,
   "text": "کسی بدون معرفت، بدون شناخت خودش بره کربلا می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 813.82,
   "end": 815.64,
   "text": "می‌شه مثل کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 815.64,
   "end": 823.94,
   "text": "اون که بارها گفتیم دیگه. می‌شه گفت مصداق شاید مهم-- بهترین مصداقش همون زها-زهاک بن عبدالله مشرقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 823.94,
   "end": 829.96,
   "text": "اما کسی که نه، رفته به سمت واقعاً به سمت یقینیات حرکت کرده، اشتباه رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 829.96,
   "end": 833.9,
   "text": "خدا رحمت کنه حاج قاسم رو. می‌گفت ما پیش رهبر که رفتیم یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 833.9,
   "end": 838.88,
   "text": "بحث داعش داغ شده بود آقا فرمود تا می‌تونید از دو طرف کم کشته بدیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 838.88,
   "end": 845.2,
   "text": "هم از خودمون هم از اونا. این که از خودمون کم کشته بدی-بدیم برامون مشخص بود، مبرهن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 845.2,
   "end": 848.88,
   "text": "اما این که چرا از داعش کمتر کشته بدیم نمی‌دونستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 848.88,
   "end": 851.3,
   "text": "تا از خود آقا پرسیدیم چرا از اونا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 851.3,
   "end": 854.36,
   "text": "فرمودن خیلی از اینا به یقین رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 854.36,
   "end": 857.22,
   "text": "یعنی یقین دارن که راهشون اشتباهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 857.22,
   "end": 862.32,
   "text": "چی-- درسته. راهشون اشتباهه اما یقین دارن تو راه باطلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 862.32,
   "end": 865.44,
   "text": "توجه کردین؟ اینا چون به یقین رفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 865.44,
   "end": 873.56,
   "text": "اینا اگر برگردن این معرفتشون رو پیدا کنن چون به اسم یقین خدا رفتن اینها عاقبت به خیر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 873.56,
   "end": 875.98,
   "text": "برای همین اینا رو نکشید تا بفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 875.98,
   "end": 880.5,
   "text": "نمی‌فهمن. نمی‌دونن. بسیاری از مردم به اسم یقین رفتن سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 880.5,
   "end": 885.24,
   "text": "باطل‌ها. نه با تعصبات، نه با-- یقین بحثش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 885.24,
   "end": 887.62,
   "text": "این خیلی نکته ظریفیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 887.62,
   "end": 890.58,
   "text": "باید با یقین رفت. خیلی از ما دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 890.58,
   "end": 893.16,
   "text": "تزلزل و گرفتاری هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 893.16,
   "end": 896.38,
   "text": "خب اما کسایی مثل ابوالحتوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 896.38,
   "end": 899.62,
   "text": "که دیروز عرض کردیم سریع ازش گذشتیم نگفتیم آخرش چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 899.62,
   "end": 906.1,
   "text": "برادرش سعد. تا لحظه‌ای که آقا تو گودی قتلگاه بود شمشیر می‌زدن بر علیه امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 906.1,
   "end": 910.88,
   "text": "حالا اونجا اشراقات اباعبدالله تو قتلگاه اینا یه نگاه انداختن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 910.88,
   "end": 915.56,
   "text": "رخ نشون داد. امام حسین تجلی کرد اصطلاحاً براشون خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 915.56,
   "end": 918.96,
   "text": "نشون داد به این‌ها. دید قابلیتی در وجودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 918.96,
   "end": 924.58,
   "text": "اگر تو صف باطلن یقین کردن و اشتباهاً یقین کردن اون راه درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 924.58,
   "end": 927.72,
   "text": "اما اشتباه کردن. تعصب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 927.72,
   "end": 929.86,
   "text": "تو کسب معرفتشون به اشتباه رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 929.86,
   "end": 932.98,
   "text": "یعنی جاهل مقصر نیستن، قاصرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 932.98,
   "end": 935.04,
   "text": "اباعبدالله براشون تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 935.04,
   "end": 939.82,
   "text": "حالا بعضیا میگن توی-- از این جهت تجلی کرد که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 939.82,
   "end": 944.5,
   "text": "وقتی حمله کردن به سمت خیمه‌ها صدای شیون زن‌ها که بلند شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 944.5,
   "end": 946.44,
   "text": "چهره‌ی اباعبدالله متغیر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 946.44,
   "end": 949.66,
   "text": "اینا شکستن یه دفعه. دیدن بحث ناموسی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 949.66,
   "end": 953.24,
   "text": "بعضیا گفتن نه ده نفر آب ریختن جلوی امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 953.24,
   "end": 956.66,
   "text": "ش-- مثلاً زشت، کشته کنن آقا رو که آب می‌ریزیم زمین به تو نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 956.66,
   "end": 958.82,
   "text": "از اینجور مسائل تو مقاتل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 958.82,
   "end": 961.44,
   "text": "هرچی بود بر می‌گرده به تجلی امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 961.44,
   "end": 967.34,
   "text": "آقا تجلی کرد. اینا یه دفعه متزلزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 967.34,
   "end": 970.96,
   "text": "اون یقین ریخت بیرون. گفتن نه مثل که ما اشتباه می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 970.96,
   "end": 975.28,
   "text": "دوتایی با هم این داستانو گوش بدید تا آخرش بس سراغ بفرستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 975.28,
   "end": 977.34,
   "text": "خیلی شیرینه. خیلی قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 977.34,
   "end": 981.6,
   "text": "من کمتر دیدم بگن. داداش بزرگ‌تره گفت بریم مثل اینکه اشتباه می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 981.6,
   "end": 984.36,
   "text": "کوچیکه گفت بابا ما تا حالا کشتیم از اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 984.36,
   "end": 986.28,
   "text": "مگه می‌شه حسین ما رو قبول کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 986.28,
   "end": 989.4,
   "text": "داداش بزرگ‌تره گفت من می‌دونم اینا خاندان کرمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 989.4,
   "end": 992.5,
   "text": "پدرانشون رو می‌شناسم، مادراشون رو می‌شناسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 992.5,
   "end": 998.56,
   "text": "تا این فکر و س-سخن بر زبان این دو تا برادر با همدیگه گفت‌وگو می‌کردن جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 998.56,
   "end": 1000.12,
   "text": "یه نگاه به قتلگاه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1000.12,
   "end": 1004.64,
   "text": "اباعبدالله آغوش باز کرده، دستاشو اینطوری باز کرده به سمت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1004.64,
   "end": 1007.92,
   "text": "برادر بزرگ‌تره گفت دیدی داداش اینا خاندان کرمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1007.92,
   "end": 1011.5,
   "text": "بریم. اومدن محضر آقا اجازه خواستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1011.5,
   "end": 1014.52,
   "text": "آقا اجازه میدید ما کمک شما باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1014.52,
   "end": 1016.94,
   "text": "حضرت فرمود شما مهمان ما هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1016.94,
   "end": 1020.62,
   "text": "تازه به ما گرویدید. تازه سر سفره‌ی ما مهمان شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1020.62,
   "end": 1023.94,
   "text": "ما مهمان‌کشی نمی‌کنیم. اونا گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1023.94,
   "end": 1028.54,
   "text": "اولین گریه‌شون رو برای قربت امام حسین اینجا کردن و همین نجاتش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1028.54,
   "end": 1031.8,
   "text": "نجاتشون داد. گفتن آقا شما مهمان ما بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1031.8,
   "end": 1033.7,
   "text": "ما از شما دعوت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1033.7,
   "end": 1035.72,
   "text": "نه، ش-- ما مهمان شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1035.72,
   "end": 1038.96,
   "text": "گریه‌شون شروع شد. همونجا اینا دیدن دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1038.96,
   "end": 1041.14,
   "text": "حرف‌های عاشقانه می‌زنن با امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1041.14,
   "end": 1043.66,
   "text": "اون وری‌ها لشکردن افتادن به جونشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1043.66,
   "end": 1047.06,
   "text": "اباعبدالله گفت حاجی حالا که برگشتید برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1047.06,
   "end": 1049.2,
   "text": "برید کارتون رو بکنید. شمشیر برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1049.2,
   "end": 1052.8,
   "text": "نمی‌دونم بیست نفر سی نفر رو اونجا به عشق اباعبدالله کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1052.8,
   "end": 1057.38,
   "text": "آخرش هم خودشون خونی مالی افتادن تو گودی قتلگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1057.38,
   "end": 1060.94,
   "text": "تنها کسایی‌ان که بدنشون بدل قتل-- بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1060.94,
   "end": 1063.64,
   "text": "کنار بدن اباعبدالله تو گودی قتلگاه افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1063.64,
   "end": 1065.82,
   "text": "خونشون با خون حسین قاطی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1065.82,
   "end": 1067.9,
   "text": "چرا؟ تجلی امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1067.9,
   "end": 1072.34,
   "text": "باید تلاش کرد تا به اونجا رسید تا امام حسین به ما خودش رو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1072.34,
   "end": 1076.0,
   "text": "اون نور معرفته. تا بهش انشاالله از شک و ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1076.0,
   "end": 1081.92,
   "text": "نجات پیدا کنیم. عاقبتمون انشاالله ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1081.92,
   "end": 1084.56,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1084.56,
   "end": 1086.84,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}