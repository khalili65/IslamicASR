 ],
 "cues": [
  {
   "i": 0,
   "start": 109.36,
   "end": 112.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 112.9,
   "end": 117.28,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 117.28,
   "end": 121.32,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 121.32,
   "end": 126.32,
   "text": "استفتا شده از رهبر عزیزمون که آیا استفراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 126.32,
   "end": 131.72,
   "text": "بچه‌ای که شیرخواره یا بچه‌ای که هم شیر میخوره هم غذا میخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 131.72,
   "end": 135.4,
   "text": "یا فرد بالغ این‌ها نجسن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 135.4,
   "end": 138.2,
   "text": "از درون بدن میریزن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 138.2,
   "end": 142.3,
   "text": "رهبر عزیزمون هم فرمودن که مطلقاً پاکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 142.3,
   "end": 146.56,
   "text": "محکوم به طهارت هستن و پاکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 146.56,
   "end": 150.36,
   "text": "بحث ما امروز خیلی دقیق‌تر از دیروز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 150.36,
   "end": 153.6,
   "text": "دیروز یه مقدار خب قاطی حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 153.6,
   "end": 155.6,
   "text": "امروز یه مقدار علمی‌ترش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 155.6,
   "end": 161.52,
   "text": "در خصوص قلب مریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 161.52,
   "end": 166.58,
   "text": "کسی که دچار ریب و شک میشه همش، مردده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 166.58,
   "end": 173.98,
   "text": "بر اساس آیه چهل و پنج توبه که \"إنما يستأذنك الذين لا يؤمنون واليوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 173.98,
   "end": 180.0,
   "text": "یا لا يؤمنون بالله واليوم الآخر ورتابت قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 180.0,
   "end": 183.06,
   "text": "رو اون کاف حرف زدیم که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 183.06,
   "end": 186.58,
   "text": "کسایی‌ان که میخوان از تو جدا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 186.58,
   "end": 188.54,
   "text": "بهانه‌شون هم بهانه‌های مختلفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 188.54,
   "end": 191.34,
   "text": "یه بهانه‌شون نرفتن به جنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 191.34,
   "end": 194.08,
   "text": "\"إنما يستأذنك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 194.08,
   "end": 198.72,
   "text": "از چی جهت، چه جهتی میخوان از تو پیغمبر اذن بگیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 198.72,
   "end": 204.0,
   "text": "که در جنگ شرکت نکنن. این جنگ چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 204.0,
   "end": 208.14,
   "text": "جهاد اصغر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 208.14,
   "end": 212.04,
   "text": "خب علت اینکه این‌ها حاضر نیستن در جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 212.04,
   "end": 215.16,
   "text": "و جهاد اکبر شرکت کنن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 215.16,
   "end": 217.78,
   "text": "یادش بخیر زمان جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 217.78,
   "end": 225.04,
   "text": "که من خیلی بچه‌تر حدود مثلا دوازده، سیزده سالم بود، یه چیز خیلی از همون موقع تو ذهنمم مونده از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 225.04,
   "end": 229.94,
   "text": "حدود مثلا سی و پنج سال چقدر گذشته، سی و پنج، شش سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 229.94,
   "end": 232.72,
   "text": "همیشه تو ذهنمه که چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 232.72,
   "end": 236.2,
   "text": "خب اون موقع من میدیدم بعضی از این بچه بسیجی‌هامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 236.2,
   "end": 241.3,
   "text": "می‌اومدن از امام جماعت نامه می‌گرفتن که اینا نیفتن تو جبهه، نیفتن خط مقدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 241.3,
   "end": 243.76,
   "text": "می‌خواستن برن خدمت سربازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 243.76,
   "end": 246.3,
   "text": "بچه بسیجی‌ام بودن، مسجدی‌ام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 246.3,
   "end": 252.66,
   "text": "این برای من همیشه سؤال بود. تو چجوری بسیجی هستی که داری از جهاد فرار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 252.66,
   "end": 256.38,
   "text": "توجه کردی؟ حالا علتش رو الان می‌خوام عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 256.38,
   "end": 260.72,
   "text": "چرا اینا از جهاد اصغر سر بار می‌زنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 260.72,
   "end": 264.58,
   "text": "به جهت اینکه از جهاد اکبر واموندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 264.58,
   "end": 269.28,
   "text": "کاملاً مشخصه. وقتی از اون اصلیه افتادن از این فرعیه هم میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 269.28,
   "end": 276.2,
   "text": "یعنی چون جهاد اکبر نداشتن جهاد اصغر رو سرباز می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 276.2,
   "end": 279.28,
   "text": "حالا این جهاد اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 279.28,
   "end": 284.12,
   "text": "همون موت اختیاریه. به یک معنا یکی از اقسام موت اختیاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 284.12,
   "end": 292.22,
   "text": "چون عزیزان سؤال هم داشتن که حاج آقا یه روز در رابطه با موت اختیاری شما چند بار حرف زدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 292.22,
   "end": 295.16,
   "text": "که اساساً ما دائماً در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 295.16,
   "end": 298.82,
   "text": "اماته و احیا توسط حضرت اسرافیل هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 298.82,
   "end": 304.02,
   "text": "که در نو-- در Sur نفس ناطقه ما می‌دمد و ما رو اماته و احیا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 304.02,
   "end": 307.44,
   "text": "از نقص به کمال میریم. این یک معناش اماته و احیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 307.44,
   "end": 311.14,
   "text": "جهل ما می‌میره، عقل ما زنده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 311.14,
   "end": 317.36,
   "text": "این اماته و احیاست و مرگ، اون مرگ اضطراری و اجباری که برای همه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 317.36,
   "end": 321.5,
   "text": "به غیر از مرگ فلسفی که اونم بحثش خیلی سنگینه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 321.5,
   "end": 327.98,
   "text": "اون مرگ اضطراری و اجباری که همه قراره \"كل نفس ذائقة الموت\" به یک معنا البته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 327.98,
   "end": 331.54,
   "text": "اینجا خب همه قراره اون رو بچشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 331.54,
   "end": 335.52,
   "text": "اون مرگ گفتید حاج آقا خروج از عادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 335.52,
   "end": 340.24,
   "text": "برای این اتفاق میفته که همه رو از عادت بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 340.24,
   "end": 344.3,
   "text": "بعد شما گفتید که بعضی‌ها اصلاً نیازی دیگه ندارن به عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 344.3,
   "end": 348.12,
   "text": "اینا چون به موت اختیاری رسیده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 348.12,
   "end": 349.7,
   "text": "بعد گفتید حاج آقا اینو توضیح بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 349.7,
   "end": 352.9,
   "text": "الان رسیدیم بهش. پله پله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 352.9,
   "end": 355.78,
   "text": "ما در موت اد-- اختیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 355.78,
   "end": 358.56,
   "text": "یا ارادی اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 358.56,
   "end": 363.18,
   "text": "چهار نوع موت رو برامون تصور کردن که این دو تا چهارتاش باید با هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 363.18,
   "end": 366.18,
   "text": "اینطور نیست که یکیشو بگیری بقیه‌شو نگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 366.18,
   "end": 371.58,
   "text": "اگر کسی می‌خواد به حقیقت موت اختیاری یا ارادی برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 371.58,
   "end": 376.77,
   "text": "که مثلاً می‌شنویم یکی مثل آقای بهجت نوزده سالگی، بیست سالگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 376.77,
   "end": 379.87,
   "text": "عنایت رو بهش کرده بودن که می‌تونست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 379.87,
   "end": 382.05,
   "text": "رو-- جسمش فارغ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 382.05,
   "end": 385.01,
   "text": "نفس ناطقه انصراف بده نه به صورت کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 385.01,
   "end": 389.31,
   "text": "اون عنایت تدبیری‌ش رو تعلق خاطرش به جسمو داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 389.31,
   "end": 392.77,
   "text": "میره اما ج-- اون روح نفس ناطقه انصراف میده میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 392.77,
   "end": 396.35,
   "text": "نه به صورت کامل که اون مرگ قطعی رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 396.35,
   "end": 400.79,
   "text": "و این دلیلش چیه؟ چون در این چهار جهت حرکت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 400.79,
   "end": 406.61,
   "text": "حالا اینا رو من به شما میگم هر کدومش جای منبر مفصل داره که اهلش البته باید برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 406.61,
   "end": 410.67,
   "text": "این چهار نوع موت رو موت أبیض گفتن سفید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 410.67,
   "end": 413.29,
   "text": "موت أسود گفتن سیاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 413.29,
   "end": 418.89,
   "text": "موت أخضر گفتن سبز و موت أحمر گفتن با حجی می،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 418.89,
   "end": 425.75,
   "text": "یعنی سرخ. از همشون عرفا گفتن از همشون سخت‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 425.75,
   "end": 427.89,
   "text": "موت أسود موت سیاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 427.89,
   "end": 431.11,
   "text": "اصلاً اسمش هم رو خودشه. مرگ سیاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 431.11,
   "end": 435.91,
   "text": "حالا این چهار تاش باید انجام بشه تا کسی بتونه به اون حقیقت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 435.91,
   "end": 439.39,
   "text": "اگر کسی به موت اختیاری رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 439.39,
   "end": 443.69,
   "text": "اون موقع اون موت اضطراری و اجباری براش شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 443.69,
   "end": 446.53,
   "text": "امیرالمؤمنین علیه‌السلام چرا فرمودن-- یکی از وجهش البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 446.53,
   "end": 451.65,
   "text": "چرا فرمودن که من شوقم به مرگ از شوق بچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 451.65,
   "end": 457.39,
   "text": "بچه‌ای که می‌خواد شیر بخوره و گشنشه به سینه مادر بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 457.39,
   "end": 459.81,
   "text": "چرا؟ این حقیقت رو چ-- همین جا چشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 459.81,
   "end": 462.05,
   "text": "موت رو همین جا چشیده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 462.05,
   "end": 465.35,
   "text": "انقدر شیرینه براش دوباره می‌خواد بچه، بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 465.35,
   "end": 468.29,
   "text": "توجه کردید؟ این موت‌ها حالا من توضیح بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 468.29,
   "end": 472.85,
   "text": "موت أبیض که حالا اصطلاحا میگن مرگ سفید همون جوعه، جوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 472.85,
   "end": 476.63,
   "text": "گرسنگی. آدم شکمش هیچ‌وقت پر نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 476.63,
   "end": 478.67,
   "text": "روزه بگیره، روزه داری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 478.67,
   "end": 481.85,
   "text": "افراط البته نه تفریط خوبه، نه افراط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 481.85,
   "end": 484.73,
   "text": "بعضیا به من شکایت می‌شه آقا پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 484.73,
   "end": 487.15,
   "text": "بر اساس حرفای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 487.15,
   "end": 492.09,
   "text": "ول کرده کار و زندگی و درسو مثلاً طلبه هم هست به عنوان مثال حالا یا هر جور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 492.09,
   "end": 496.45,
   "text": "یا کسب و کار. اصلاً همه رو ول کرده درس و بحث و کارو ول کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 496.45,
   "end": 500.19,
   "text": "همش داره روزه می‌گیره، نماز می‌خونه، عبادت شب‌ها تا صبح نمی‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 500.19,
   "end": 502.11,
   "text": "یه پوست و استخون ازش مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 502.11,
   "end": 504.05,
   "text": "میگه من می‌خوام به موت اختیاری برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 504.05,
   "end": 508.87,
   "text": "این چه کاریه آخه؟ کدوم یکی از بزرگان ما همچین کارایی کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 508.87,
   "end": 513.21,
   "text": "این غلط کاریا چیه؟ هیچ کجا افراط و تفریط خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 513.21,
   "end": 516.19,
   "text": "همون رو- ریاضت شرعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 516.19,
   "end": 518.97,
   "text": "یعنی روزه، روزه گرفتن. روزه نمی‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 518.97,
   "end": 522.67,
   "text": "شما افطار و سحر نداری؟ می‌خوری ولی پر نمی‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 522.67,
   "end": 525.03,
   "text": "حالا اینو باید توضیح داده بشه. فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 525.03,
   "end": 528.41,
   "text": "دیگه خودتون برید اهلش هستید الحمدالله بررسی می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 528.41,
   "end": 531.27,
   "text": "جوع. صمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 531.27,
   "end": 534.09,
   "text": "جوع. ها صمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 534.09,
   "end": 537.39,
   "text": "جوع. سحرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 537.39,
   "end": 541.13,
   "text": "این چیزایی که فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 541.13,
   "end": 544.67,
   "text": "حالا بیداری و اون ذکر به دوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 544.67,
   "end": 550.35,
   "text": "این‌ها باعث می‌شه که ناتمامان جهان را کند این پنج تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 550.35,
   "end": 552.41,
   "text": "صمت و با صاد یعنی سکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 552.41,
   "end": 557.15,
   "text": "صمت و جوع و سحر و خلوت و ذکر به دوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 557.15,
   "end": 560.29,
   "text": "ناتمامان جهان را کند این پنج تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 560.29,
   "end": 563.25,
   "text": "خیلی شعر عالیه. جوع، گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 563.25,
   "end": 568.53,
   "text": "این موت أبیض. موت أسود یا حالا سیاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 568.53,
   "end": 570.77,
   "text": "تحمل اذیت و آزار مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 570.77,
   "end": 575.19,
   "text": "چقدر ما حرف و حدیث می‌شنویم، چقدر فحش می‌شنویم، چقدر تهمت می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 575.19,
   "end": 579.59,
   "text": "هی بخوای بخوای بری از خودت دفاع کنی، هی اینو توجیه کنی، اونو توجیه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 579.59,
   "end": 581.21,
   "text": "دو تاشو کردی پنج تاشو چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 581.21,
   "end": 583.23,
   "text": "اون یکی رو چی؟ فردا چی؟ ول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 583.23,
   "end": 589.55,
   "text": "بسپر به خدا راضی باش. اتفاقاً از سخت‌ترین انواع موت هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 589.55,
   "end": 595.83,
   "text": "تحمل کنایه و نیش و زخم زبان دیگران که الانم به اوج رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 595.83,
   "end": 599.03,
   "text": "به دین‌دارها. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 599.03,
   "end": 602.53,
   "text": "به امام حسین‌ها، به ولایتی‌ها، به انقلابی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 602.53,
   "end": 608.33,
   "text": "تو محیط کارت، تو محیط درست، زندگیت حتی همسرها می-- گاهی اوقات دچار این مشکلاتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 608.33,
   "end": 614.57,
   "text": "میگه تحمل کن. مدیر بالا دستت نه که زور رو بپذیری و ظلم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 614.57,
   "end": 621.05,
   "text": "زیر بار ظلم بری. نه. یه وقتایی جسارتی به شخص خودت کرد اونجا میگه به خاطر خ-- شخص خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 621.05,
   "end": 629.11,
   "text": "خاطر خدا تحمل کن. بعد موت أخضر یا سبزه که اصطلاحاً همون بعضیا گفتن کهنه پوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 629.11,
   "end": 632.01,
   "text": "اما این به نظرم تعبیر سبکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 632.01,
   "end": 636.17,
   "text": "یعنی جامع نیست. تعبیر جامع می‌شه همون زهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 636.17,
   "end": 641.37,
   "text": "یعنی همون فقری که پیغمبر فرمود فقرنا فخرنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 641.37,
   "end": 643.91,
   "text": "یعنی همه‌چی مال خداست. به اینجا برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 643.91,
   "end": 646.43,
   "text": "مالم یکی نداری. اصلاً هیچی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 646.43,
   "end": 649.97,
   "text": "تو اصلاً هیچی در، در تملک خودت نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 649.97,
   "end": 653.91,
   "text": "همه‌چی رو مال خدا می‌بینی. هیچ تعلق خاطری لذا به هیچ چیزی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 653.91,
   "end": 660.89,
   "text": "این می‌شه معنای فقر. یا ایها الناس انتم الفقراء الى الله والله هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 660.89,
   "end": 665.11,
   "text": "الغني الحمید. قنا مال خداست، ذاتی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 665.11,
   "end": 667.53,
   "text": "فقر ذاتی ماست. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 667.53,
   "end": 670.51,
   "text": "حالا بعضیا گفتن راهش اینه که تو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 670.51,
   "end": 672.13,
   "text": "این تجملات بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 672.13,
   "end": 673.91,
   "text": "حداقل دچار تجملات نری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 673.91,
   "end": 677.01,
   "text": "مثلاً لباس‌های فاخر و آنچنانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 677.01,
   "end": 680.27,
   "text": "لوازم منزل آنچنانی، ماشین و خانه آنچنانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 680.27,
   "end": 685.03,
   "text": "اینا رو به سمتش نری. اگه می‌خوای واقعاً چون اونا جذابیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 685.03,
   "end": 687.59,
   "text": "البته تو معنای زهد میگن بی‌رغبتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 687.59,
   "end": 690.89,
   "text": "میگن در معنای کلی اون ج-- معنای جامع یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 690.89,
   "end": 693.81,
   "text": "بی‌رغبتی. نه یعنی نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 693.81,
   "end": 700.87,
   "text": "اما در راه‌های رسیدن به اون زهد و بی‌رغبتی میگن اینه که به این‌ها هم توجه نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 700.87,
   "end": 703.45,
   "text": "چون بالاخره جذابیت داره و می‌گیردت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 703.45,
   "end": 709.47,
   "text": "تعلق خاطر میاره. این که از to امام علیه الرحمه به پسرش احمد تو نامه‌ای که داشت عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 709.47,
   "end": 715.07,
   "text": "هیچ-- من عهدی از بزرگان رو ندیدم به بچه‌ش همچین تعبیری داشته باشه، توصیه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 715.07,
   "end": 719.95,
   "text": "که فرمود حتی از مال حرا-- حلال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 719.95,
   "end": 723.71,
   "text": "اعراض داشته باش. زیادیشو اعراض داشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 723.71,
   "end": 727.69,
   "text": "لذا هرچی هم از ارث پدرش به امام رسیده بود همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 727.69,
   "end": 732.71,
   "text": "وقف کرد به فقرا و یتیم داد به آقای جلالی خمینی خدا رحمتش کنه همسایه ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 732.71,
   "end": 734.79,
   "text": "اخیراً از دنیا رفت. حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 734.79,
   "end": 737.15,
   "text": "آقای جلالی خمینی شرق تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 737.15,
   "end": 741.15,
   "text": "همه رو بخشید به یتیم و-- از to امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 741.15,
   "end": 744.77,
   "text": "تو همون حالا زندگیشو نه که بگه بعد از مرگش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 744.77,
   "end": 747.75,
   "text": "چرا؟ به خاطر اینکه گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 747.75,
   "end": 751.91,
   "text": "عرض شود جذبه‌ها نشه از زهد خارج نشه و به موت اخضر برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 751.91,
   "end": 754.23,
   "text": "آخریش هم موت احمر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 754.23,
   "end": 758.27,
   "text": "همون مرگ سرخ. تعبیرش حالا شده به مرگ سرخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 758.27,
   "end": 763.31,
   "text": "این مرگ سرخ که ما از همین جا شروع کردیم امروز بحثمون رو همین جهاد اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 763.31,
   "end": 766.13,
   "text": "یعنی با مخالفت با نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 766.13,
   "end": 768.73,
   "text": "یعنی اونچه که نفس می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 768.73,
   "end": 772.21,
   "text": "بگه نه. مخالفت کنه، نفسشو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 772.21,
   "end": 777.01,
   "text": "یه کسی میگه رفتم حضور یکی از بزرگان که هنوزم زنده است میگه رفتم از علما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 777.01,
   "end": 778.99,
   "text": "رفتم محضر امام کارشون داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 778.99,
   "end": 781.95,
   "text": "وارد حجره شدم دیدم یه هندونه جلوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 781.95,
   "end": 784.99,
   "text": "هندونه سرخ تو چله تابستون گرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 784.99,
   "end": 789.37,
   "text": "گفتم به به الان امام یه بسم الله به ما میزنه ما میخوریم جیگرمون حال میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 789.37,
   "end": 794.13,
   "text": "هرچی نشستیم دیدیم امام عجیبه کریمه ایشون هیچ تعارفی به ما نزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 794.13,
   "end": 796.71,
   "text": "تعجب کردم چرا امام تعارف نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 796.71,
   "end": 799.37,
   "text": "به یک بهانه‌ای آقا از حجره رفت بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 799.37,
   "end": 802.03,
   "text": "ما هم پررویی کردیم گفتیم خب خودمون حالا می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 802.03,
   "end": 809.01,
   "text": "رفتیم چنگالو زدیم. یه حب گذاشتیم دهنمون بالا آوردم دیدم شوره شوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 809.01,
   "end": 814.43,
   "text": "چرا؟ چرا؟ امام با اون سن حدود نود سالگی چرا هندونه رو نمک میزنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 814.43,
   "end": 821.11,
   "text": "چرا؟ با اون سن داره مخالفت با نفس می‌کنه که برای مشتهیات نفسش اشتها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 821.11,
   "end": 826.99,
   "text": "خوش آمدن نفسش هندونه رو نخوره بلکه به خاطر سلامت بدنش بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 826.99,
   "end": 830.03,
   "text": "ببین این جهاده. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 830.03,
   "end": 834.81,
   "text": "جهاد اکبر رو انجام داد، مخالفت با نفسش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 834.81,
   "end": 838.57,
   "text": "اون موقع دیگه این قصه براش حل میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 838.57,
   "end": 841.11,
   "text": "از پیغمبر بخواد اجازه بگیره که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 841.11,
   "end": 843.39,
   "text": "انما یستؤذنک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 843.39,
   "end": 845.65,
   "text": "اجازه از تو بگیرن که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 845.65,
   "end": 849.23,
   "text": "بخوان جنگ نرن. چون جنگ دیگه پله پایین‌تر از اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 849.23,
   "end": 855.59,
   "text": "کسی که جهاد اکبر رو انجام داد قطعاً دیگه تو جهاد اصغر هم راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 855.59,
   "end": 859.79,
   "text": "راحت کیف می‌کنه. مثل این که کسی که این جهاد، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 859.79,
   "end": 863.73,
   "text": "موت اختیاری رو بهش رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 863.73,
   "end": 866.19,
   "text": "زیبایی و شیرینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 866.19,
   "end": 871.31,
   "text": "احلی من العسل موت رو، خروج از عادت و تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 871.31,
   "end": 873.73,
   "text": "کندن از تعلقات عالم رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 873.73,
   "end": 878.65,
   "text": "این‌ها رو چشید دیگه اصلاً اون مرگ اضطراری براش اینقدر شیرین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 878.65,
   "end": 881.77,
   "text": "اون دیگه از عسل که اصلاً خود چی بگیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 881.77,
   "end": 883.67,
   "text": "اصلاً شیرین اندر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 883.67,
   "end": 886.05,
   "text": "اصلاً له له میزنه برای اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 886.05,
   "end": 892.77,
   "text": "که اولیاء الله اینجوری میشن. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 892.77,
   "end": 901.95,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 901.95,
   "end": 904.99,
   "text": "صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 904.99,
   "end": 907.41,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 907.41,
   "end": 911.09,
   "text": "آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 911.09,
   "end": 914.03,
   "text": "صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 914.03,
   "end": 916.35,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 916.35,
   "end": 922.73,
   "text": "آله. اللهم صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 922.73,
   "end": 927.37,
   "text": "محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 927.37,
   "end": 932.95,
   "text": "اللهم صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 932.95,
   "end": 936.15,
   "text": "و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}