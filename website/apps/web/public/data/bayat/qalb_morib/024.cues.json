 "chapters": [
  {
   "index": 0,
   "title": "## حکم بهائیّت و وهّابیّت",
   "start": 0.26,
   "end": 76.7
  },
  {
   "index": 1,
   "title": "## ورود به سوفسطاییان؛ ادامهٔ قلب مریب",
   "start": 76.7,
   "end": 96.74
  },
  {
   "index": 2,
   "title": "## مغالطات حسّی و پاسخ علّامه",
   "start": 96.74,
   "end": 646.73
  },
  {
   "index": 3,
   "title": "## حکایت صالح بن عبدالقدّوس و کتاب شکوک",
   "start": 646.73,
   "end": 832.19
  },
  {
   "index": 4,
   "title": "## راه برون‌رفت؛ تفکّر عقلی نه تخیّلات فاسده",
   "start": 832.19,
   "end": 943.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 6.7,
   "text": "استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.7,
   "end": 10.4,
   "text": "آیاته، السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.4,
   "end": 15.42,
   "text": "دیروز یه حکمی رو عرض کردیم پیرامون بهائیت و وهابیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.42,
   "end": 22.92,
   "text": "اینو توجه داشته باشیم که کلاً بهائیت رو مطلقاً رهبر و همه مراجع نجس العين می‌دونن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.92,
   "end": 28.42,
   "text": "اصلاً مطلقاً اجازه هیچ گونه معاشرتی با این‌ها رو مراجع ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.42,
   "end": 31.76,
   "text": "غذا گرفتن حتی کار کردن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.76,
   "end": 36.18,
   "text": "جایی که اون‌ها مثلاً حکم‌فرما باشن، کارفرما باشن و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.18,
   "end": 38.66,
   "text": "منتها وهابیت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.66,
   "end": 44.02,
   "text": "بعضی از مراجع گفتن در صورتی که یعنی غالباً فرمودن که در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.02,
   "end": 50.9,
   "text": "دشمنی با اهل بیت بکنن چون اونام تو بین خودشون بعضی از وهابیت هستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.9,
   "end": 54.48,
   "text": "جاهلن، بی‌خبرن و دشمنی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.48,
   "end": 57.98,
   "text": "حالا اون اعتقاداتی که دارن متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.98,
   "end": 63.52,
   "text": "دیگه از ابن تیمیه خیلی اوج گرفت دیگه حدود فکر می‌کنم چهارصد سال پیش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.52,
   "end": 68.8,
   "text": "دیگه اوج گرفت و الا خب خیلیاشون بی‌خبرن، دشمنی آن‌چنانی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.8,
   "end": 73.64,
   "text": "پس این رو حواسمون باشه وهابیت رو اگر دشمنی داشته باشن بله اون‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.64,
   "end": 76.7,
   "text": "ج-- در حکم کافرن و نجس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.7,
   "end": 81.44,
   "text": "به فضل الهی امروز ورود به یک بحثی می‌کنیم که این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.44,
   "end": 84.56,
   "text": "که در پیران-- یعنی در ادامه همون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.56,
   "end": 87.04,
   "text": "قلب شکاک و مریب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.04,
   "end": 93.26,
   "text": "منتها به قدری این بحث مهمه از جهت فکری و توجه و پرداختن بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.26,
   "end": 95.5,
   "text": "که از تالار حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.5,
   "end": 100.94,
   "text": "در ابتدای دروس معرفت نفس همین کتابی که الان دست بنده هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.94,
   "end": 105.2,
   "text": "در ابتدای همون مثلاً حدود درس سوم و چهارم، پنجم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.2,
   "end": 108.4,
   "text": "بحثی پیرامون گروه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.4,
   "end": 112.36,
   "text": "سوفسطایی‌ها آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.36,
   "end": 114.8,
   "text": "به نظر بعضی از حکما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.8,
   "end": 120.78,
   "text": "معمولاً آدمایی که میرن تو وادی حق به سمت حق حرکت می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.78,
   "end": 125.8,
   "text": "دچار یه تفکرات این چنینی اون ابتدا می‌شن که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.8,
   "end": 131.36,
   "text": "یعنی شک‌هایی براشون پیش میاد که باید از اون مثل یک راه رو عبور کنن، درش نمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.36,
   "end": 139.42,
   "text": "لذا حضرت علامه هم اینو آورده. بعضیا میگن این نهله نیست یعنی یه فرقه و یه مکتب خاصی نیست سوفسطایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.42,
   "end": 141.82,
   "text": "که حالا صوفیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.82,
   "end": 145.64,
   "text": "می‌دونید یعنی دانشور. اینا غالبشون هم دانشمند بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.64,
   "end": 149.26,
   "text": "یعنی از جهت علمی خیلی آدمای قوی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.26,
   "end": 154.88,
   "text": "و حالا از-- حالا ال-الان توی فرانسه بهش میگن سپتیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.88,
   "end": 158.26,
   "text": "الان، الان هم هستن. یه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.26,
   "end": 161.9,
   "text": "بالاخره طرفداراشون ظاهراً زیاد شدن و اینا ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.9,
   "end": 165.92,
   "text": "غالباً من دیدم توجه کردم در تحقیقاتی که داشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.92,
   "end": 168.54,
   "text": "این‌ها را یک نهله نمی‌دونن، یک فکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.54,
   "end": 175.5,
   "text": "اینو توجه داشته باشید. یعنی هر کسی احتمال داره وقتی میره به سمت حقایق گرفتار این مسئله بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.5,
   "end": 180.0,
   "text": "یعنی یک آن دچار کن-- دچار این قصه بشه که نکنه واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.0,
   "end": 182.88,
   "text": "این چیزی که من دارم فکر می‌کنم اشتباهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.88,
   "end": 185.82,
   "text": "حالا دلایلی هم که اینا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.82,
   "end": 192.62,
   "text": "الان عرض می‌کنم مثلاً به عنوان نمونه عرض می‌کنم دلایلش رو که همون سفسطه و این‌ها هم از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.62,
   "end": 195.44,
   "text": "گرفته شده. سوفسطایی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.44,
   "end": 203.92,
   "text": "سفسطه که میگن حالا افلاطون و ارسطو که سید ابن طاووس این دو بزرگوار را از انبیا فر-فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.92,
   "end": 206.4,
   "text": "حدیث آوردن که این‌ها از انبیا بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.4,
   "end": 209.18,
   "text": "بر علیه این تفکر خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.18,
   "end": 211.76,
   "text": "تلاش کردن، خیلی زحمت کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.76,
   "end": 220.1,
   "text": "حالا چند تا نمونه‌هایی که من ااا عرض می‌کنم بین اینا کسایین که تقریباً معروفن توی این تفکر کار کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.1,
   "end": 222.04,
   "text": "جوون‌ها رو دور خودشون جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.04,
   "end": 225.28,
   "text": "مثلاً افرودیغوس دانشمند بدبینی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.28,
   "end": 228.12,
   "text": "می‌گفت همه دنیا درد و رنج و بلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.12,
   "end": 231.48,
   "text": "خب امیرالمؤمنین می‌فرماید \"الدهر یومن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.48,
   "end": 237.16,
   "text": "یومن لک و یومن علیک\" یه روز برای تو به نفع توست، خوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.16,
   "end": 242.42,
   "text": "یه روزم بر علیه توست. ایشون می‌گفت نه اصلاً همه چی بده و زشته و رنج و عذاب و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.42,
   "end": 245.48,
   "text": "مثلاً گورگیاس یکی دیگه از اوناست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.48,
   "end": 247.66,
   "text": "استدلالاتی شبیه زینوز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.66,
   "end": 253.6,
   "text": "زینون میاره و ایشون مثلاً مدعی بود که اصلاً وجود، موجود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.6,
   "end": 255.82,
   "text": "خیال है اصلاً ما فکر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.82,
   "end": 260.22,
   "text": "همه چی موجوده. اصلاً یه صحبت‌های این چنینی البته با دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.22,
   "end": 262.7,
   "text": "عجیب و غریب می‌آوردن که حالا امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.7,
   "end": 268.38,
   "text": "علامه حسن زاده جلوی اینا در مع-معاصر ما قد علم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.38,
   "end": 271.88,
   "text": "معتبرترین‌شون از این حکمای سوفسطایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.88,
   "end": 273.9,
   "text": "گور-- پروتوگوراسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.9,
   "end": 277.22,
   "text": "پروتوگوراس بیان خیلی خوبی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.22,
   "end": 279.62,
   "text": "خیلی اهل محاجه و بحث و جدل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.62,
   "end": 282.94,
   "text": "اینام غالباً چون تو یه و-- فضایی بودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.94,
   "end": 284.94,
   "text": "اگر می‌تونستن تو جدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.94,
   "end": 288.3,
   "text": "پیروز بشن به خاطر اغراض سیاسی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.3,
   "end": 291.24,
   "text": "این کارو می‌کردن. یعنی شده حتی به ناحق ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.24,
   "end": 295.3,
   "text": "اما جدل، جدل اون موقع خیلی-- یه فنی بود اصلاً جدل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.3,
   "end": 297.34,
   "text": "الانم هستا الانم یه سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.34,
   "end": 299.06,
   "text": "کسایی که میخوان برن تو بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.06,
   "end": 305.66,
   "text": "سیاسی یا مثلاً منصبی پیدا کنن، جایگاهی تو جدل حرکت می‌کنن و یه جوری که دیگران و مثلاً غالب بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.66,
   "end": 308.08,
   "text": "الانم این هست، یه فنیه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.08,
   "end": 310.16,
   "text": "ایشون خب جوون‌ها رو دور خودش جمع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.16,
   "end": 313.8,
   "text": "یه بیان گوی-- شیوایی داشت، خیلی تبحر داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.8,
   "end": 316.04,
   "text": "اما چون به مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.04,
   "end": 325.44,
   "text": "دینی خیلی اعتقاد راسخی نداشت، بعداً رفته رفته‌ش ایشونو تبعید کردن و حالا آثارشو سوزوندن و جوون‌ها از دور و برش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.44,
   "end": 328.88,
   "text": "متفرق شدن. و حالا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.88,
   "end": 329.88,
   "text": "مجموعاً حالا ما چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.88,
   "end": 336.86,
   "text": "نمونه‌شو براتون گفتم که همه اینا رو حضرت علامه حسن زاده میاره افکارشونو بررسی می‌کنه تو این کتاب شریفشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.86,
   "end": 340.42,
   "text": "این‌ها حرفشون چیه؟ اینا مثلاً میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.42,
   "end": 342.94,
   "text": "یه چند تا نمونه بگم. میگن آقا چطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.94,
   "end": 347.94,
   "text": "مگر عقل، عقل انسان از طریق مدرکات یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.94,
   "end": 350.78,
   "text": "حواس ظاهریش درک نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.78,
   "end": 355.12,
   "text": "برداشت‌های عقل ابتداً از طریق همین حواس ظاهریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.12,
   "end": 358.76,
   "text": "خب این حواس ظاهری وقتی به اشتباه میفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.76,
   "end": 363.62,
   "text": "مثلاً میگن شما از دور یه چیزو می‌بینی کوچیکه، میری جلو، نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.62,
   "end": 368.77,
   "text": "آتش گردون یکی داره می‌چرخونه، شما نگاه می‌کنی می‌بینی که یه حلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.77,
   "end": 373.49,
   "text": "سرخیه در صورتی که یک تیکه آتشو دارن میچرخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.49,
   "end": 376.81,
   "text": "حواس باصره تو داره اشتباه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.81,
   "end": 379.23,
   "text": "درسته؟ یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.23,
   "end": 381.93,
   "text": "سراب از دور آب می‌بینی میری می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.93,
   "end": 385.65,
   "text": "نیست. یا سوار کشتی داری حرکت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.65,
   "end": 389.53,
   "text": "فکر می‌کنی ساحل داره حرکت می‌کنه در حالی که تو داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.53,
   "end": 394.67,
   "text": "حرکت می‌کنی و این قبیل مثلاً مطالب رو بیان می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.67,
   "end": 401.39,
   "text": "که یا باران مثلاً بارون که داره میاد میگه نگاه می‌کنی مثل یه خط کشیده شده است در حالی که اینجوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.39,
   "end": 406.31,
   "text": "چون مدرکات حسی ما دارن اشتباه می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.31,
   "end": 410.43,
   "text": "پس همه چی غلطه. اصلاً همه چی-- ما در اشتباهیم ما اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.43,
   "end": 413.81,
   "text": "اینا همه باطل‌اند. اصلاً حقیقتی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.81,
   "end": 417.55,
   "text": "ما فکر می‌کنیم میگه و این دست صحبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.55,
   "end": 425.57,
   "text": "حالا بر علیه این فکر مثلاً حضرت علامه عظمى زنده مطالبی آوردن حتی اونا به خوابم میگن وقتی شما تو خواب میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.57,
   "end": 428.35,
   "text": "مطالبی رو میگی، می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.35,
   "end": 430.49,
   "text": "با اینکه یقین داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.49,
   "end": 435.05,
   "text": "که تو خواب، تو خواب یقین داری که اینایی که داری می‌بینی واقعیت داره و هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.05,
   "end": 437.87,
   "text": "ولی وقتی بیدار میشی می‌بینی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.87,
   "end": 443.11,
   "text": "ببینید این، این مغالطه کاری‌هایی که داره بیان می‌کنه باعث می‌شه ذهن جوون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.11,
   "end": 446.35,
   "text": "آشفته بشه و به سمت شکاکیت برن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.35,
   "end": 450.21,
   "text": "دچار ریب و تزلزل بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.21,
   "end": 456.79,
   "text": "اونی که میگه هیچ حقیقتی نیست حضرت علامه بهش میگه خب بفرمایید ببینم اینکه شما میگی حقیقتی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.79,
   "end": 462.63,
   "text": "همین حکمی که شما فرمودی که هیچ حقیقتی نیست حقیقت داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.63,
   "end": 468.89,
   "text": "شما میگی هیچ حقیقتی نیست. خب الان شما خودت یه حکمی صادر کردی که هیچ حقیقتی وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.89,
   "end": 472.27,
   "text": "این حکم شما وجود دارد یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.27,
   "end": 475.75,
   "text": "اگه بگه آره وجود داره که بر علیه خودش گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.75,
   "end": 479.09,
   "text": "اگه بگه وجود نداره پس اصلاً حرف خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.09,
   "end": 481.93,
   "text": "باطل اعلام کردی. یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.93,
   "end": 485.47,
   "text": "میگن هیچ حرف راستی وجود نداره همه چی دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.47,
   "end": 488.15,
   "text": "علامه می‌فرماید خب همین حرف شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.15,
   "end": 491.47,
   "text": "راسته یا دروغه؟ شما میگی هیچ حرف راستی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.47,
   "end": 493.69,
   "text": "همین حرف شما راسته یا دروغه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.69,
   "end": 497.67,
   "text": "اگه راسته پس یک حرف راستی وجود داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.67,
   "end": 501.81,
   "text": "حرف شما باطل شد. اما اگه دروغه حرف شما هم دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.81,
   "end": 504.01,
   "text": "پس ح-- مدعای شما اصلاً دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.01,
   "end": 505.99,
   "text": "ببین چجوری مچگیری می‌کنه علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.99,
   "end": 509.51,
   "text": "چقدر شیرین. یا برای ادراکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.51,
   "end": 511.93,
   "text": "میگن که برای ادراک هیچ راهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.93,
   "end": 520.65,
   "text": "به جز حواس نیست. البته علامه می‌فرماید این به یک معنا درسته اما همه حواس هم همین حواس پنج گانه ظاهریه نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.65,
   "end": 529.19,
   "text": "حواس دیگه‌ای هم داریم که این حکم شما، این حکمی که شما می‌کنی برای ادراک جز حواس هیچی دیگه وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.19,
   "end": 532.09,
   "text": "این خودش محسوسه یا غیر محسوسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.09,
   "end": 535.37,
   "text": "شما این حکمی که دادی حکم کردی که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.37,
   "end": 539.29,
   "text": "ادراک هیچ چیزی جز حواس ظاهری وجود نداره که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.29,
   "end": 542.43,
   "text": "عقل بخواد درک کنه. این محسوسه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.43,
   "end": 545.95,
   "text": "وقتی نگاه می‌کنی می‌بینی نه می‌بینیش، نه می‌چشیش، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.95,
   "end": 547.89,
   "text": "بو می‌کنی، نه لمسش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 547.89,
   "end": 551.89,
   "text": "پس این از هیچ-- از دایره همه حواس ظاهری خارج شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.89,
   "end": 556.43,
   "text": "این داره نشون میده که پس یه حواس دیگه‌ای هست به جز این حواس ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.43,
   "end": 564.93,
   "text": "پس حرف شما باطله. یا در خصوص خواب حضرت علامه تنوین مغتا-- مغناطیسی رو بیان می‌کنه در برابر حرف اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.93,
   "end": 568.83,
   "text": "که میگن هرچی که تو خواب می‌بینی اون لحظه فکر می‌کنی واقعیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.83,
   "end": 572.85,
   "text": "بعد که از خواب میای بیرون می‌فهمی دروغه و حقیقت نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.85,
   "end": 575.33,
   "text": "علامه می‌فرماید اگه اینطوره پس چطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.33,
   "end": 579.33,
   "text": "خیلی‌ها الان اصلاً تو-- اتفاقاً تو امر سیاست امروز هم این کارو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 579.33,
   "end": 583.37,
   "text": "میان تنوین مغتا-- مغناطیسی میدن یعنی مثلاً هیپنوتیزم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.37,
   "end": 586.79,
   "text": "به لوازم که خودش بحث علمی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 586.79,
   "end": 590.09,
   "text": "طرف رو به خواب می‌برن. خواب مغناطیسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.09,
   "end": 592.29,
   "text": "بعد از اون طریق ازش سؤال می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.29,
   "end": 594.65,
   "text": "تو خواب ازش سؤال می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.65,
   "end": 596.31,
   "text": "که آقا مثلاً فلان جا رفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.31,
   "end": 601.81,
   "text": "یکی از راه‌های جاسوسی هستن. تخلیه اطلاعاتی می‌کنن و اون میگه و درست هم میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.81,
   "end": 608.09,
   "text": "غالبش رو درست میگه. یا اصلاً علامه می‌فرماید چطور خیلی از خواب‌ها رو ما می‌بینیم همون اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.09,
   "end": 614.09,
   "text": "اگه قراره هرچی تو خواب می‌بینیم مطلقاً باطل باشه، بسیاری از خواب‌ها رو می‌بینیم و اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.09,
   "end": 617.57,
   "text": "و این‌ها نشون میده که نه، حرف شما غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.57,
   "end": 620.29,
   "text": "به هر حال دلایلی حضرت علامه میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.29,
   "end": 623.97,
   "text": "این‌ها رو خیلی خوب جوون‌ها تو امر فکری یعنی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.97,
   "end": 627.07,
   "text": "باور کنید بعضی از جوون‌هایی که خیلی دچار شبهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.07,
   "end": 630.01,
   "text": "فکری این چنینی بودن با همین چند تا درس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.01,
   "end": 635.15,
   "text": "علامه خدا لطف کرد تو جلساتی که باهاشون داشتیم اجابت پیدا کردن همین مباحث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.15,
   "end": 638.41,
   "text": "که الان تو دانشگاه‌های ما پره از این شبهات، از این افکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.41,
   "end": 644.47,
   "text": "غلط که از همین راه وارد میشن که میگن استغفرالله اصلاً هیچ حقیقتی نیست، خدایی نیست، پیغمبری نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.47,
   "end": 646.73,
   "text": "دین و آینی نیست و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.73,
   "end": 650.39,
   "text": "آخر درس چهارم جالبه تو همین بحث حالا اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.39,
   "end": 652.55,
   "text": "گوش بدید شیرینه. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.55,
   "end": 655.45,
   "text": "حکایتی رو نقل می‌کنه خود حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.45,
   "end": 659.13,
   "text": "که می‌فرماید که آورده‌اند که من از رو براتون دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.13,
   "end": 663.63,
   "text": "آورده‌اند که طفلی از صالح بن عبدالقدوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.63,
   "end": 667.45,
   "text": "که یکی از بزرگان سوفسطایی بود بمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.45,
   "end": 674.73,
   "text": "یعنی بچه‌ش مرد. این کسی که از بزرگان مثلاً سو-- سوفسطایی بود و شکاک بود بچه‌ش مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.73,
   "end": 678.61,
   "text": "ابو حذله الاف معتزلی به اتفاق ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.61,
   "end": 682.13,
   "text": "معروف به نظام که اون موقع بچه بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.13,
   "end": 684.29,
   "text": "میرن به تسلیت گفتن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.29,
   "end": 690.17,
   "text": "کی؟ به همین صالح بن عبدالقدوس که بزرگان مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 690.17,
   "end": 695.89,
   "text": "سوفسطایی‌ها بوده، پوچ‌گرا بوده، قائل به اینکه بوده که هیچی وجود نداره، همه چی خیاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.89,
   "end": 699.51,
   "text": "توهمه، چیه. بعد ابو حذله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 699.51,
   "end": 707.07,
   "text": "به سا-- به صالح به هم که پسرش مرده بوده بهش میگه که مردم که در نظر تو به مثابت نباتات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 707.07,
   "end": 709.37,
   "text": "یعنی تو این مردم رو مثل نبات فرض می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.37,
   "end": 713.41,
   "text": "اصلاً براش اهمیتی قائل نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 713.41,
   "end": 716.51,
   "text": "برای شما مردم بودن یا نبودنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 716.51,
   "end": 719.17,
   "text": "اندوه به خود راه دادن چه وجهی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 719.17,
   "end": 726.93,
   "text": "تو اینکه این مردم انقدر برات مثلاً اصلاً ارزشی ندارن، بودن یا نبودنشون براش چی ناراحتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 726.93,
   "end": 730.15,
   "text": "صالح گفت دلم از آن می‌سوزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 730.15,
   "end": 732.75,
   "text": "که این طفل مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 732.75,
   "end": 736.03,
   "text": "و کتاب شکوک را نخواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.03,
   "end": 738.33,
   "text": "این طفل کی بوده؟ بچه خودش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 738.33,
   "end": 742.95,
   "text": "حالا کتاب شکوک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 742.95,
   "end": 746.57,
   "text": "بهش میگه که کتاب شکوک چیه که تو میگی این بچه‌ات مرد نخوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 746.57,
   "end": 750.19,
   "text": "گفت کتابی‌ست که نوشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 750.19,
   "end": 754.13,
   "text": "هرکس بخواند شک می‌کند در آنچه بوده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 754.13,
   "end": 757.37,
   "text": "به حدی که توهم می‌کند که نبوده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 757.37,
   "end": 760.67,
   "text": "و چیزی که نبوده است گمان می‌کند که اند موجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 760.67,
   "end": 762.93,
   "text": "اصلاً قاطی میکنه. میگه هرچی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 762.93,
   "end": 765.57,
   "text": "نیست، هرچی نیست هست. اصلاً می‌ریزه به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 765.57,
   "end": 771.63,
   "text": "میگه این کتاب شکوک رو من نوشتم از این دارم می‌سوزم که بچه من مرد این کتاب رو نخوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.63,
   "end": 774.55,
   "text": "چه جواب دندون شکنی. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 774.55,
   "end": 776.95,
   "text": "ابراهیم میگه بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 776.95,
   "end": 782.43,
   "text": "که اینو از تعلم حسن زاده انتهای درس چهارم معرفت نفسش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 782.43,
   "end": 784.33,
   "text": "جوابو دقت کنید. والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 784.33,
   "end": 787.01,
   "text": "می‌فرمود که همچو فرض کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 787.01,
   "end": 790.33,
   "text": "ای کسی که میگی کاش پسرم بود و اینو می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 790.33,
   "end": 795.67,
   "text": "همچو فرض کن که طفلت نمرده است اگرچه مرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 795.67,
   "end": 800.69,
   "text": "و فرض کن کتاب را خوانده اگرچه نخوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 800.69,
   "end": 804.13,
   "text": "صالح ساکت شد و ن-- نتوانست جوابی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 804.13,
   "end": 808.75,
   "text": "چون اونجا میگه که تو اصلاً گمان می‌کنی اونچی که هست نیست، اونچی که نیست هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 808.75,
   "end": 811.73,
   "text": "اصلاً توهم می‌زنی اینا. میگه همچین کتابی نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 811.73,
   "end": 815.17,
   "text": "میگه خب تو ه-- حالا که واقعاً قائل به این اعتقادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 815.17,
   "end": 821.47,
   "text": "گمان کن بچه‌ات نمرده اگرچه مرده و گمان کن کتاب رو خونده اگرچه نخوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 821.47,
   "end": 825.25,
   "text": "اونم هیچ جوابی نداد. ببین به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 825.25,
   "end": 828.31,
   "text": "شیرینی مباحث عقلی اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 828.31,
   "end": 830.47,
   "text": "بعد طرف دیگه هیچ جوابی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 830.47,
   "end": 832.19,
   "text": "ساکت شد. خفه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 832.19,
   "end": 840.73,
   "text": "باید خیلی مراقب باشیم که مخصوصاً امروزه تو فضاهای مجازی، تو دانشگاه حتی اخیراً تو حوزه‌های ما متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 840.73,
   "end": 844.67,
   "text": "تو مسیر این پیچ و خم‌های فکری و عقیدتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 844.67,
   "end": 850.65,
   "text": "و عقلی، عقلی بسیار شبهات میان که اینا هم مقله‌اند، سفسطه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.65,
   "end": 853.73,
   "text": "که این‌ها برداشته شده از یک همچین تفکراتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 853.73,
   "end": 858.55,
   "text": "اگه جوون‌های ما این‌ها رو متوجه نباشند میرن به این سمت، دیگه هم برنمی‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 858.55,
   "end": 861.33,
   "text": "الا بیای برش می‌گردونن. قشنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 861.33,
   "end": 863.51,
   "text": "این نکته آخر رو خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 863.51,
   "end": 869.57,
   "text": "زیبایی کار علامه کارهای فکری ایشونه، کارهای عقلی ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 869.57,
   "end": 872.49,
   "text": "معمولاً هم اکثریت ما گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 872.49,
   "end": 877.77,
   "text": "خیالات مشوش به قول ایشون متخیلات فاسده‌ایم که قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 877.77,
   "end": 881.19,
   "text": "بهترین راهی که امروز شمه‌ش رو من عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 881.19,
   "end": 888.45,
   "text": "بهترین راهی که علامه داده برای بیرون رفت، برون رفت از این گرفتاری‌های فکری، خیالی، توهمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 888.45,
   "end": 894.17,
   "text": "و نجات خودت از شک و ریب عزیزم تفکر عقلی کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 894.17,
   "end": 896.69,
   "text": "تفکر عقلی. من متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 896.69,
   "end": 898.97,
   "text": "غصه می‌خورم تو همین شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 898.97,
   "end": 902.11,
   "text": "بیا هیئت‌های دیگه میری منبر جاهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 902.11,
   "end": 906.17,
   "text": "متعدد دانشگاه، حوزه بعضیا این نیش زبونو به ماها می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 906.17,
   "end": 910.31,
   "text": "جالبه همین هیئتی‌ها. آخ مبا-- حاج آقای مباحث عقلی اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 910.31,
   "end": 912.37,
   "text": "حاج آقای نمی‌دونم چی چی اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 912.37,
   "end": 917.03,
   "text": "همین بچه هیئتی‌ها. بابا یه روضه بخون گریه کنیم بریم ما که نفهمیدیم چی گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 917.03,
   "end": 919.75,
   "text": "اینا واقعاً گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 919.75,
   "end": 923.75,
   "text": "متخیلات فاسده بشن اهدی نمی‌تونه نجاتشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
