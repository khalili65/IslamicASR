 "chapters": [
  {
   "index": 0,
   "title": "## نظر در قرآن؛ عهد الهی برای رهایی از قلب مریب",
   "start": 0.26,
   "end": 163.14
  },
  {
   "index": 1,
   "title": "## عهد ولایت و وجوب نظر روزانه",
   "start": 163.14,
   "end": 194.88
  },
  {
   "index": 2,
   "title": "## تنزل قرآن و عبور از ظاهر به مثال",
   "start": 194.88,
   "end": 468.63
  },
  {
   "index": 3,
   "title": "## تفسیر انفسی؛ نزول مستمر و اقرأ و ارتق",
   "start": 468.63,
   "end": 488.95
  },
  {
   "index": 4,
   "title": "## قیامت قرآن و علی در وجود",
   "start": 488.95,
   "end": 748.12
  },
  {
   "index": 5,
   "title": "## مباهله؛ انفسنا و اثبات ولایت",
   "start": 748.12,
   "end": 1012.34
  },
  {
   "index": 6,
   "title": "## برد الیقین؛ نتیجهٔ اتحاد با باطن قرآن",
   "start": 1012.34,
   "end": 1096.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 6.6,
   "text": "بسم الله الرحمن الرحیم. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.6,
   "end": 9.32,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.32,
   "end": 14.42,
   "text": "در آخرین جلسه‌ای که ما پیرامون قلب مریب سخن گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.42,
   "end": 17.3,
   "text": "عرض کردیم که باید در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.3,
   "end": 22.02,
   "text": "نظر کرد. بعد گفتیم که حالا این نظر کردن در قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.02,
   "end": 24.9,
   "text": "توضیح میدیم. چون بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.9,
   "end": 32.0,
   "text": "حدیثی که در وسائل الشیعه جلد پونزده صفحه صد و هفتاد و یک هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.0,
   "end": 37.24,
   "text": "عرض کردیم که حضرت استاد علامه حسن زاده هم در رساله لقالاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.24,
   "end": 44.5,
   "text": "در قسمت از کار و برنامه‌هاشون این حدیث رو مورد توجه قرار دادن و استناد کردن به یکی از اون پونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.5,
   "end": 48.66,
   "text": "راهی که سالک به سمت خدا باید در سیر و سلوکش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.66,
   "end": 52.86,
   "text": "توجه بکنه یکیش همین بحث تلاوت قرآن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.86,
   "end": 54.84,
   "text": "که در اینجا در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.84,
   "end": 61.76,
   "text": "حدیثی که امیرالمؤمنین صلوات الله علیه به فرزندشون محمد حنفیه می‌فرماید که \"عَلَیکَ بِقِراءَةِ القُرآنِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.76,
   "end": 68.82,
   "text": "در بعضی از، بعضی از منابع اومده و علیک بتلاوت القرآن که تق-- فرق بین تلاوت و قرائت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.82,
   "end": 72.64,
   "text": "اجمالاً عرض کردیم و العمل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.64,
   "end": 81.22,
   "text": "یا العمل بما فیه و لزوم فرائضه و شرایعه و حلاله و حرامه و امره و نهیه و تهجد به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.22,
   "end": 85.38,
   "text": "اینجا یه توقفی کردیم تهجد با قرآن رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.38,
   "end": 88.92,
   "text": "و تلاوته فی لیلک و نهارکفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.92,
   "end": 93.06,
   "text": "عهد من الله تبارک و تعالی الی خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.06,
   "end": 98.48,
   "text": "عرض کردیم برای اینکه ما بخواهیم از قلبی که شکاکه، مردده، دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.48,
   "end": 104.58,
   "text": "در رفت و برگشت و نوسان نجات پیدا کنیم، عرض کردیم باید خودمون رو تحویل به قرآن بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.58,
   "end": 108.06,
   "text": "اینجا امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.06,
   "end": 111.02,
   "text": "قرآن رو عهد الهی معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.02,
   "end": 115.38,
   "text": "فإنه عهد من الله عهد، عهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.38,
   "end": 119.28,
   "text": "در آیه شصت سوره یاسین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.28,
   "end": 121.98,
   "text": "خوندید دیگه. ألم أعهد إليكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.98,
   "end": 124.58,
   "text": "عهد. آیا از شما عهد نگرفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.58,
   "end": 127.54,
   "text": "ألم أعهد إليكم. يا بني آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.54,
   "end": 129.76,
   "text": "ألا تعبدوا الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.76,
   "end": 134.92,
   "text": "إنه لكم عدو مبين وأن اعبدوني هذا صراط مستقيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.92,
   "end": 138.66,
   "text": "اساساً این صراط مستقیم این عهد الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.66,
   "end": 143.08,
   "text": "که مخالفش می‌شه تبعیت و عبادت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.08,
   "end": 148.18,
   "text": "حالا اینجا میگه همون عهدی که صراط مستقیمه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.18,
   "end": 151.3,
   "text": "و ببینید یک حقیقت واحدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.3,
   "end": 154.02,
   "text": "که عرض شد قرآن صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.02,
   "end": 159.82,
   "text": "انسان کامله. صورت کتبیه یا شرح کتبی امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.82,
   "end": 162.4,
   "text": "صلوات الله علیه که عهد خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.4,
   "end": 164.3,
   "text": "جالبه که در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.3,
   "end": 167.8,
   "text": "بیست و سه احزاب هم می‌خونیم \"و من المؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.8,
   "end": 172.52,
   "text": "رجال صدقوا ما عاهد الله عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.52,
   "end": 180.48,
   "text": "اینایی که میخوان به شهادت برسن چون فرمود \"فمنهم من قضي نحبه ومنهم من ينتظر\" این آیه در ارتباط با شاهداس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.48,
   "end": 183.66,
   "text": "چون اونایی که شهید شدن یا اونایی که منتظر شهادتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.66,
   "end": 188.68,
   "text": "اینا رجالی‌ان که صداقت داشتن در عهدشون، عهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.68,
   "end": 191.06,
   "text": "به یک معنا عهد، اون عهد ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.06,
   "end": 192.98,
   "text": "به یک معنا عهد عبودیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.98,
   "end": 196.12,
   "text": "به یک معنا عهد قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.12,
   "end": 198.64,
   "text": "که اینجا امیرالمؤمنین صلوات الله علیه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.64,
   "end": 201.74,
   "text": "تسریح می‌کنه. فهو واجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.74,
   "end": 203.7,
   "text": "واجبه على کل مسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.7,
   "end": 210.32,
   "text": "که چی بشه؟ این فریضه و واجبی که امیرالمؤمنین صلوات الله علیه داره می‌فرماید \"أن ينظر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.32,
   "end": 214.16,
   "text": "ينظر\". اینجا بحث نظر اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.16,
   "end": 216.96,
   "text": "نمیگه نگاه کن. ينظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.96,
   "end": 219.54,
   "text": "کل یا نمیگه فقط ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.54,
   "end": 222.5,
   "text": "یا بخوان. نه ينظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.5,
   "end": 224.72,
   "text": "کل یوم فی عهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.72,
   "end": 230.54,
   "text": "تو عهدش این نگاه، نظر بندازه به قرآن که حالا عرض می‌کنیم و لو خمسمائه آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.54,
   "end": 236.38,
   "text": "و لو به پنجاه آیه. حالا به ظرف وجودی فرزندش ابن حنفیه نگاه می‌کنه و می‌فرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.38,
   "end": 238.12,
   "text": "دیگه مثلاً حداقل پنجاه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.12,
   "end": 242.66,
   "text": "ولی خب ما سعه وجودیمون فرق می‌کنه شاید ما ده تا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.66,
   "end": 245.5,
   "text": "به هر حال مهم اون ينظر، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.5,
   "end": 247.4,
   "text": "نگاه، نظر انداختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.4,
   "end": 250.3,
   "text": "نظر فرقش با نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.3,
   "end": 253.8,
   "text": "اینه که نظر نگاه عمیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.8,
   "end": 256.84,
   "text": "نگاه همراه با توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.84,
   "end": 263.08,
   "text": "نگاهی‌ست که عبارتاً می‌تونیم از جهت فلسفی عرض کنیم یا عرفانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.08,
   "end": 265.38,
   "text": "همون راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.38,
   "end": 268.36,
   "text": "عبور از ظاهر به باطن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.36,
   "end": 272.38,
   "text": "معنای نظر یعنی عبور از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.38,
   "end": 275.94,
   "text": "چون نگاه عمیقه، نگاه باطنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.94,
   "end": 281.08,
   "text": "نه ظاهر. اگر ظاهر بود می‌گفت نگاه کن، ببین، بخوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.08,
   "end": 283.78,
   "text": "قرائت کن. اما وقتی میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.78,
   "end": 287.7,
   "text": "نظر بنداز یعنی برو به باطن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.7,
   "end": 290.22,
   "text": "قرآن هم عرض شد که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.22,
   "end": 300.34,
   "text": "تلقی حضرت رسول اعظم اسلام صلی الله علیه و آله و سلم از ذات حضرت حق از علم ذاتی‌شون که من لدن حکیم علیم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.34,
   "end": 304.22,
   "text": "از علم لدنی بود تنزل پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.22,
   "end": 308.74,
   "text": "فی کتاب مکنون، فی لوح محفوظ همینطوری مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.74,
   "end": 313.98,
   "text": "اومد الوهیت قرآن، عقل قرآن، مثال قرآن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.98,
   "end": 319.94,
   "text": "لفظ قرآن، ظاهر قرآن که الان ما و شما متأسفانه با همین ظاهر قرآن مرتبطیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.94,
   "end": 323.74,
   "text": "نگاه به ظاهر می‌کنیم. ظاهرشو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.74,
   "end": 330.62,
   "text": "در حالی که اینجا امیرالمؤمنین داره می‌فرماید که اگه می‌خوای به عهد خود عمل کنی واجبه که نظر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.62,
   "end": 332.36,
   "text": "نظر یعنی عبور از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.36,
   "end": 334.94,
   "text": "\"و إذ استسقى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.94,
   "end": 340.34,
   "text": "موسى لقومه أن اضرب بعصاک الحجر فانفجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.34,
   "end": 343.1,
   "text": "من حسنته عشرة عین\". اون آیه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.1,
   "end": 348.86,
   "text": "اون عالم میگه مشغوش بخوندن دوست داشت که مثال قرآن رو مثال، عالم مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.86,
   "end": 353.7,
   "text": "یعنی یه رتبه پنهان‌تر از ظاهر قرآن رو ببینه، بشنوه، بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.7,
   "end": 360.68,
   "text": "شنیده بود که یه باطنی داره و تأویل راه عبور از ظاهر به باطن در ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.68,
   "end": 363.89,
   "text": "تأویل بعد از تفسیر توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.89,
   "end": 367.57,
   "text": "خب می‌خواست بشنوه. خودش میگه وقتی تا شروع کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.57,
   "end": 372.81,
   "text": "به اون حالتی که حالا اون دستوری که هست من قبلاً عرض کردم چگونه که فارغ از ظاهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.81,
   "end": 378.77,
   "text": "فارغ از ظاهر بشی. حتی مرحوم کمپانی، استاد آقای بهجت علیه رحمة ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.77,
   "end": 382.25,
   "text": "به شاگردانشون ظاهراً دستور آقای قاضی هم بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.25,
   "end": 386.05,
   "text": "که به شاگردانشون توصیه می‌کردن که اون خواصشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.05,
   "end": 391.19,
   "text": "که شما قرآن رو می‌خوای به اون نحو عهد الهی بخونی و نظر کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.19,
   "end": 396.97,
   "text": "اون راهی که قبلاً عرض کردیم راه عبور، یکی از راه‌های عبور از ظاهر به باطن قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.97,
   "end": 401.57,
   "text": "فارغ از تجوید و حتی معانی و تلفظ ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.57,
   "end": 404.11,
   "text": "یه بشینی مثلاً اینجا ادغام رو رعایت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.11,
   "end": 406.77,
   "text": "یرمحروف یرمنون رو رعایت کنی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.77,
   "end": 409.85,
   "text": "ابتدا وقف و ابتدا نه، همینطوری شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.85,
   "end": 413.17,
   "text": "اصلاً توجه هم حتی به مفاهیم نکن که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.17,
   "end": 416.25,
   "text": "توضیح داده شد که چرا و یعنی چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.25,
   "end": 420.59,
   "text": "که بری به مثال میگه تا شروع کردم و \"و استسقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.59,
   "end": 423.07,
   "text": "موسی لقومه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.07,
   "end": 434.51,
   "text": "دیدم صدای، یه صدای حاطفی از ملکوت اومد به ولایت امیرالمؤمنین علی ابن ابی طالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.51,
   "end": 440.03,
   "text": "به کجا؟ موسی داره استسقا می‌کنه، طلب آب می‌کنه برای قومش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 440.03,
   "end": 445.15,
   "text": "به ولایت علی \"انضرب بعصاک الحجر\" بزن عصات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.15,
   "end": 447.85,
   "text": "ببیني میره یه دفعه می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.85,
   "end": 449.95,
   "text": "عجب! خب این کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.95,
   "end": 452.01,
   "text": "تو ظاهر قرآن که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.01,
   "end": 457.91,
   "text": "بعد میری تو تفسیر می‌بینی اتفاقاً تفسیر هم این رو تأیید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.91,
   "end": 463.49,
   "text": "تفسیر، اون لفظ معصوم که تأویل رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.49,
   "end": 467.51,
   "text": "تفاسیر ما بعضاً تأویلی هم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.51,
   "end": 469.99,
   "text": "خب در شرح، در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.99,
   "end": 473.75,
   "text": "عرفان تفسیر انفسي قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.75,
   "end": 477.77,
   "text": "تفسیر آفاقی نیست که این قرآن، این آیه کی نازل شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.77,
   "end": 480.15,
   "text": "چرا نازل شد؟ شأن نزولش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 480.15,
   "end": 484.57,
   "text": "چه سالی؟ چگونه؟ نه. این تفسیر انفسيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.57,
   "end": 486.55,
   "text": "جان تو با قرآن باید مرتبط بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.55,
   "end": 488.95,
   "text": "حالا چه سالی نازل شد تموم شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.95,
   "end": 491.27,
   "text": "الان به نحوی قرآن بخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.27,
   "end": 495.23,
   "text": "که انَّ در خلوت و سکوتت خودت رو تحویل به قرآن بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.23,
   "end": 498.77,
   "text": "که عرض شد که انَّ همین الان قرآن داره نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.77,
   "end": 503.09,
   "text": "\"إن أنزلناه في ليلة القدر\" بر ليلة قدر جان پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.09,
   "end": 505.71,
   "text": "و ایشون به تو القا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.71,
   "end": 509.05,
   "text": "اون القایی حالا یه وقت مثالیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 509.05,
   "end": 514.33,
   "text": "یک وقت عقليه. بودن کسایی که به این‌ها رسیدن و ما باید بهش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.33,
   "end": 518.11,
   "text": "و اونجا که قیامت میگه \"اقرأ ورقة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.11,
   "end": 521.73,
   "text": "حالا گفته می‌شود. \"يقال له\" فعل مجهوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.73,
   "end": 526.37,
   "text": "کی میگه \"يقال له\"؟ \"يقال له\" نمیگه \"يقول\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.37,
   "end": 531.29,
   "text": "\"يقال\" مجهوله. کی میگه بخوان و بالا برو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.29,
   "end": 533.73,
   "text": "خدا؟ می‌شه. پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.73,
   "end": 536.51,
   "text": "می‌شه. ملائکه؟ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.51,
   "end": 538.17,
   "text": "جان خودت. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.17,
   "end": 542.37,
   "text": "این که دیگه جان مطلبه. جان خودت میگه بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.37,
   "end": 548.23,
   "text": "توی این نشأت طبیعت چقدر جان تو عجین شد با باطن و جان قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.23,
   "end": 550.61,
   "text": "چقدر جان تو شد جان قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.61,
   "end": 555.93,
   "text": "چقدر جان قرآن، نفس قرآن، جان قرآن، باطن قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.93,
   "end": 557.93,
   "text": "با باطن تو عجین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.93,
   "end": 561.67,
   "text": "همون مقدار تو اجازه داری مثل صحبت که آقای بهجت گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.67,
   "end": 566.05,
   "text": "اینا رو میگم تداعی بشه براتون عه همه با هم جفت و جورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.05,
   "end": 568.43,
   "text": "یک حقیقته‌ن با الفاظ و مع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 568.43,
   "end": 572.11,
   "text": "حالا معانی مختلف. که آقای بهجت فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.11,
   "end": 574.57,
   "text": "الان چقدر وقت برای قرآن می‌ذاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 574.57,
   "end": 580.81,
   "text": "همونقدر اجازه داری اذن پیدا می‌کنی به، برای امام عصر شد وقت ظهور وقت بگذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.81,
   "end": 583.13,
   "text": "تمام. یعنی همون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.13,
   "end": 588.99,
   "text": "الان باطن و نفس و جان قرآن چقدر با جان تو با باطن تو عجینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.99,
   "end": 591.05,
   "text": "\"اقرأ ورقة\" بخوان و بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.05,
   "end": 595.35,
   "text": "تعداد درجات بهشت که در درون خود توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.35,
   "end": 598.07,
   "text": "می‌خوای انشائات نفس ناطقه بشه بهشتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.07,
   "end": 601.79,
   "text": "هرچی بسازی بر اساس آیات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.79,
   "end": 605.77,
   "text": "یعنی معارج تو به مدارج قرآنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.77,
   "end": 608.71,
   "text": "خب اون باید در جان تو تحقق شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.71,
   "end": 611.25,
   "text": "حتی از تحقیق هم فراتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.25,
   "end": 614.69,
   "text": "تحقیق، میری تحقیق و بررسی و تفحص و بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.69,
   "end": 618.11,
   "text": "اما تحقق یعنی دیگه اون تحقیقت جا افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.11,
   "end": 621.05,
   "text": "جا، پیاده شد تو وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.05,
   "end": 627.65,
   "text": "یعنی باطن تو با باطن قرآن-- همون مقدار اذن پیدا می‌کنی \"ورقة\" بری بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.65,
   "end": 631.05,
   "text": "همینه چیز عجیبی نیست. حالا بعضیا تو هم قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 631.05,
   "end": 633.71,
   "text": "اون موت اضطراری یا اجباری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.71,
   "end": 636.15,
   "text": "این قیامت رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.15,
   "end": 641.65,
   "text": "قائم شدن به وجود قرآن رو، وجودشون به وجود قرآن به جان و نفس قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.65,
   "end": 644.45,
   "text": "گره خورده. تو همین دنیا پرده‌ها میره کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.45,
   "end": 647.71,
   "text": "قیامت‌شونو به قیام قرآن می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 647.71,
   "end": 652.01,
   "text": "بعضیا هم نه. که حالا اینایی که زودتر می‌بینن می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 652.01,
   "end": 655.65,
   "text": "موت، موت اختیاری که قبلاً بحثش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 655.65,
   "end": 660.13,
   "text": "ولی اون که دیگه موت اجباری برای همه است نه، به محض مرگ یهو رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 660.13,
   "end": 668.89,
   "text": "یه دفعه می‌بینه عجب！چه قيامتی کرده قرآن و این چقدر از اون قیامت فارغ، فارغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 668.89,
   "end": 671.23,
   "text": "که پیغمبر این دو تا انگشت مبارکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.23,
   "end": 673.19,
   "text": "اشاره‌شونو به هم چسبوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.19,
   "end": 675.11,
   "text": "\"أنبئني عن القيامة كحاتن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.11,
   "end": 678.15,
   "text": "مثلاً این دو تا این. حالا به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 678.15,
   "end": 681.87,
   "text": "در حقیقت مخاطب خودش نگاه کرد پیغمبر ای باز اینو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 681.87,
   "end": 684.91,
   "text": "\"تلك الأمثال نذر الوالناس\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 684.91,
   "end": 687.31,
   "text": "مسئله برای اینکه مردم بفهمند و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.31,
   "end": 692.31,
   "text": "اگه می‌خواست مثلاً برای سلمان صرف بگه می‌فرمود اصلاً من قيامتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.31,
   "end": 695.89,
   "text": "قرآن قيامته. چقدر قرآن در تو قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 695.89,
   "end": 698.27,
   "text": "چقدر علی در تو قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.27,
   "end": 700.69,
   "text": "اصلاً باطن قرآن علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 700.69,
   "end": 702.53,
   "text": "جان پیغمبر علی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 702.53,
   "end": 707.11,
   "text": "نفس پیغمبر علی‌ست. چقدر علی در تو قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 707.11,
   "end": 709.49,
   "text": "همون مقدار تو قیامت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.49,
   "end": 712.41,
   "text": "الان چشمت باطنت باز بشه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 712.41,
   "end": 718.05,
   "text": "چون کورم نمی‌بینم می‌گن حالا بعداً قیامت میاد و الا نسیانه قیامت که الان اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 718.05,
   "end": 720.11,
   "text": "الان قیام کرده قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.11,
   "end": 723.87,
   "text": "خودت \"بل الإنسان على نفسه هى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 723.87,
   "end": 726.77,
   "text": "اون هاء ضمیر بر می‌گرده به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 726.77,
   "end": 730.58,
   "text": "بصیره. کاملاً دانایی نسبت به خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 730.58,
   "end": 733.46,
   "text": "چشمتو بستی. باز کن نگاه کن نظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 733.46,
   "end": 736.04,
   "text": "\"أَنْ يَنْظُرَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 736.04,
   "end": 739.78,
   "text": "أَنْ يَنْظُرَ كُلَّ يَوْمٍ فِي أَهْدِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 739.78,
   "end": 747.82,
   "text": "عهد اون قرآنه. پس جانشه، جان باطن تو باید با باطن قرآن عجین بشه که یه همچین روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 747.82,
   "end": 756.78,
   "text": "مثل روز مباهله اجازه بدید سنجاق کنیم بحث رو مباهله که غریب خیلی نمونه بشه بین ما حداقل تو جلسه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.78,
   "end": 762.68,
   "text": "که مر-- خدا حفظ کنه آقای جوادی آملی می‌فرمودن که غریب‌ترین اعیاد ما مباهله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 762.68,
   "end": 769.98,
   "text": "غریبه واقعا این. که اصلا می‌فرمود حتی نه تو حوزه‌ها حرفی ازش هست نه تو هیئت‌ها واقعا هم اینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 769.98,
   "end": 773.0,
   "text": "در حالی که من یه جلسه از حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 773.0,
   "end": 777.24,
   "text": "علامه حسن زاده خیلی مباحث ایشون رو پ-- تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 777.24,
   "end": 780.64,
   "text": "اِممم، یه جلسه علمی ایشون رو پیاده کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 780.64,
   "end": 785.88,
   "text": "بعد دیدم چقدر پیرامون اثبات موضوع ولایت و امامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 785.88,
   "end": 789.9,
   "text": "اشاره به آیه همین شصت و یک آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 789.9,
   "end": 796.4,
   "text": "آیه مباهله می‌کنه. چقدر کشت خودشو علامه تو اون جلسه که فقط با این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.4,
   "end": 799.12,
   "text": "که فریقین هم نقد کردن اثبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.12,
   "end": 801.3,
   "text": "حقانیت مولامون علی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 801.3,
   "end": 805.68,
   "text": "جالبه که حالا شما برید ببینید طبری عرض شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.68,
   "end": 808.34,
   "text": "ابن محمد سمرقندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 808.34,
   "end": 811.48,
   "text": "فخر رازی، فخر رازی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 811.48,
   "end": 815.2,
   "text": "ابن کثیر، ابن کثیر دمشقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 815.2,
   "end": 817.26,
   "text": "ابن امر بیضاوی زیادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.26,
   "end": 819.96,
   "text": "اینا همه اهل تسنن کبار علماشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 819.96,
   "end": 824.86,
   "text": "همشون تفسیر دارن. همه در تفسیرشون فرمودن اون \"أَنْفُسَنَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 824.86,
   "end": 830.16,
   "text": "جان ما که پیغمبر می‌فرمود علی علیه الصلاة-- علی-- حالا اونا صلوات نمی‌فرستاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 830.16,
   "end": 832.0,
   "text": "\"رَضِيَ اللهُ عَنْهُ\" اما تو بفرست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 832.0,
   "end": 834.98,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 834.98,
   "end": 841.22,
   "text": "محمد. بله این آیه \"فَمَنْ حَاجَّكَ فِيهِ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 841.22,
   "end": 844.2,
   "text": "گفتیم بریم به باطن دیگه. این یه معناشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 844.2,
   "end": 847.06,
   "text": "همینجوری بخونیم بریم؟ دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 847.06,
   "end": 850.32,
   "text": "\"فَقُلْ تَعَالَوْا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 850.32,
   "end": 854.82,
   "text": "بهشون بگو \"تَعَالَوْا\" بیا بالا من می‌خوام به شما ارتقاء وجودی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 854.82,
   "end": 857.94,
   "text": "پیغمبر به مسیحیان نجران میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 857.94,
   "end": 860.4,
   "text": "\"نَدْعُ أَبْنَاءَنَا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 860.4,
   "end": 862.92,
   "text": "ما می‌خونیم \"أَبْنَاءَنَا\" و \"أَبْنَاءَكُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 862.92,
   "end": 865.5,
   "text": "فرزندانمون، فرزندانمون. تمام اه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 865.5,
   "end": 873.22,
   "text": "تفاسیر اهل تسنن و شیعه، همه‌ی فرقه‌ها گفتن این \"أَبْنَاءَنَا\" پیغمبر حسن و حسین علیهم الصلاة و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 873.22,
   "end": 875.24,
   "text": "همه گفتن. شیعه و سنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 875.24,
   "end": 878.16,
   "text": "\"وَنِسَاءَنَا وَنِسَاءَكُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 878.16,
   "end": 880.12,
   "text": "جمعاً بسته \"نِسَاءَنَا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 880.12,
   "end": 883.7,
   "text": "ه-- زن‌های ما، زن‌های ما رو همه رو بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 883.7,
   "end": 885.86,
   "text": "سیده نساء العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 885.86,
   "end": 888.36,
   "text": "جالبه که اهل تسنن هم باز اینو آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 888.36,
   "end": 890.8,
   "text": "عجیبه. حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 890.8,
   "end": 892.98,
   "text": "خب دیگه مجمع علمیشونه عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 892.98,
   "end": 895.66,
   "text": "چرا قبول نمی‌کنن؟ سؤال خوشگل و شیرینی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 895.66,
   "end": 898.3,
   "text": "به جهت اینکه از عمارتی‌شون میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 898.3,
   "end": 902.66,
   "text": "به حقارت میفتن. از اون منصب و جایگاهشون میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 902.66,
   "end": 907.7,
   "text": "اگه بخوان اقرار کنن همین این بزرگان فعلی‌شون، این مفتی‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 907.7,
   "end": 911.92,
   "text": "اگه بخوان-- برای همین تو چاپ‌های جدیدشون همه اینا رو دارن حذف می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 911.92,
   "end": 913.76,
   "text": "تمام اینا رو. در فسوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 913.76,
   "end": 919.96,
   "text": "بحثی داشتیم یکی سؤال کرده الان تو کانال بچه‌ها بارگذاری کردن من جوابشو تو هفده، هجده دقیقه دادم علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 919.96,
   "end": 923.18,
   "text": "که مثلاً فسوس یا فتوحات ابن عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 923.18,
   "end": 925.74,
   "text": "که مثلاً چیز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 925.74,
   "end": 927.9,
   "text": "از جهت خدمتتون تحریف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 927.9,
   "end": 934.52,
   "text": "اونجا اصلاً ابن عربی یه رش-- رساله داره به نام شق الجید فقط در رابطه با حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 934.52,
   "end": 939.82,
   "text": "امام عصر. یک عظمتی از امام عصر بیان می‌کنه که کمتر بزرگی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 939.82,
   "end": 945.18,
   "text": "در خصوص امیرالمؤمنین صلوات الله علیه، ابن عربی که هی ما می‌گیم سنی بوده، سنی بوده، حنبلی بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 945.18,
   "end": 948.3,
   "text": "کلماتی رو میگه که من از کمتر بزرگی گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 948.3,
   "end": 953.88,
   "text": "سر و جان پیغمبر و سر همه انبیا و نزدیک‌ترین شخص به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 953.88,
   "end": 956.38,
   "text": "بعد به لفظ امام. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 956.38,
   "end": 963.32,
   "text": "امام عصر رو با الامام، الامام از اجدادش می‌رسونه تا علی ابن ابی طالب و حضرت فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 963.32,
   "end": 966.0,
   "text": "توی چاپ‌های بعدی همه اینا رو حذف کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 966.0,
   "end": 968.74,
   "text": "می‌ترسن از اون ریاست‌شون میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 968.74,
   "end": 971.6,
   "text": "حالا وقتتون رو نگیرم بحثو جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 971.6,
   "end": 975.88,
   "text": "\"وَنِسَاءَنَا وَنِسَاءَكُمْ وَأَنْفُسَنَا وَأَنْفُسَكُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 975.88,
   "end": 983.02,
   "text": "لذا آقای جوادی آملی می‌فرمود خدا در قرآن علی علیه الصلاة و السلام رو جان پیغمبر معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 983.02,
   "end": 990.26,
   "text": "خدا. خب بیاید این به این میگن به این معنا مشن تازه انزل مراتب نظره در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 990.26,
   "end": 992.46,
   "text": "شروع کنی بری به اون باطن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 992.46,
   "end": 996.34,
   "text": "تو ظاهرش نیست. ظاهر تو لفظو بخون برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 996.34,
   "end": 1002.14,
   "text": "هی هم به قشنگ‌ترین وجه ممکن تلفظ و تجوید و قراعات رو رعایت کن به چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1002.14,
   "end": 1004.44,
   "text": "قرائت. نه اینا، این اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1004.44,
   "end": 1007.46,
   "text": "قرائتی نیست که امیرالمؤمنین داره به پسرش میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1007.46,
   "end": 1010.1,
   "text": "قرائت نظر با دقت، امیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1010.1,
   "end": 1012.34,
   "text": "تو رو از ظاهر به باطن ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1012.34,
   "end": 1019.4,
   "text": "اگر کسی این نحو قرائت و تلاوت رو داشت رفته، رفته، رفته تو جانش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1019.4,
   "end": 1024.58,
   "text": "جان قرآن، باطن قرآن، باطن ولایت شکل می‌گیره، عجین می‌شه اتحاد وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1024.58,
   "end": 1028.04,
   "text": "اصلاً دیگه مطلقا شک، تردید، ریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1028.04,
   "end": 1031.18,
   "text": "برداشته می‌شه و یقین میاد پشت یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1031.18,
   "end": 1036.06,
   "text": "که علامه مقام، چی بگم حالا من زبانم بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1036.06,
   "end": 1039.18,
   "text": "یه مقامی رو در وادی یقین بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1039.18,
   "end": 1043.4,
   "text": "من ندیدم کسی بیان کنه به نام برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1043.4,
   "end": 1046.26,
   "text": "همه ما چی شنیدیم؟ علم اليقين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1046.26,
   "end": 1048.08,
   "text": "عين اليقين، حق اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1048.08,
   "end": 1050.04,
   "text": "اینا بعد برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1050.04,
   "end": 1055.88,
   "text": "یعنی خنک می‌شی. اصلاً تمام شک و ریب‌ها اینا همه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1055.88,
   "end": 1058.5,
   "text": "خنک، می، آرامی، آرامش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1058.5,
   "end": 1061.02,
   "text": "آرامش محض. این برد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1061.02,
   "end": 1064.4,
   "text": "جالبه که تو زیارت سید الشهدا هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1064.4,
   "end": 1068.0,
   "text": "اون برد اون نسیمی که تو نسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1068.0,
   "end": 1074.66,
   "text": "تو حرم سید الشهدا می‌وزه ازش به اون برد به اون خنکای الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1074.66,
   "end": 1079.12,
   "text": "نسیم رحمت الهی یاد شده که حالا چه اتصال و ارتباطی هست بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1079.12,
   "end": 1087.04,
   "text": "انشاالله که عاقبتمون ختم بخیر باشد و این عید بسیار با عظمت بر همه ما پر از خیر و برکت و مبارک باشد به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1087.04,
   "end": 1089.34,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1089.34,
   "end": 1096.48,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}