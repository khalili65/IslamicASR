 "chapters": [
  {
   "index": 0,
   "title": "بسم الله و بالله و علی ملّة رسول الله. المستغاث بک یا حجّة الله.",
   "start": 1.0,
   "end": 156.54
  },
  {
   "index": 1,
   "title": "## پله‌های تخصّصیِ معرفتِ نفس",
   "start": 156.54,
   "end": 325.7
  },
  {
   "index": 2,
   "title": "بر اساسِ قرآن، در آیهٔ صد و نودِ سورهٔ آل عمران — که بارها در جلسات قرائت شده — آمده است:",
   "start": 325.7,
   "end": 422.5
  },
  {
   "index": 3,
   "title": "## نامه‌ها، برنامه‌ها و کتاب‌های دعا",
   "start": 422.5,
   "end": 513.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 6.4,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.4,
   "end": 10.56,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.56,
   "end": 14.16,
   "text": "همچنین پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.16,
   "end": 21.9,
   "text": "برای عزیزانی که تازه کار هستند در سیر و سلوک چه کتاب‌هایی رو معرفی می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.9,
   "end": 24.82,
   "text": "یا کتاب‌های در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.82,
   "end": 29.8,
   "text": "خداشناسی و این‌ها. کتاب‌های روان البته گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.8,
   "end": 35.34,
   "text": "ببینید عزیزان. ماحصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.34,
   "end": 37.58,
   "text": "حدود چه عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.58,
   "end": 41.88,
   "text": "خدا به ما حدود پنجاه سال عمر داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.88,
   "end": 46.16,
   "text": "شاید عرض کنم بی اغراق حدود چهل سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.16,
   "end": 54.44,
   "text": "منبر گردی و عالم گردی و از این عالم به اون عالم از این مکتب به اون مکتب، از این حوزه به اون حوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.44,
   "end": 60.14,
   "text": "این‌ها رو خدمت شما عرض کنم و حاصل تجربه عملیاتیم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.14,
   "end": 64.9,
   "text": "که به نظر بنده حقیر هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.9,
   "end": 68.62,
   "text": "کتابی بهتر از خوانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.62,
   "end": 71.48,
   "text": "کتاب وجودی خودت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.48,
   "end": 73.36,
   "text": "یعنی همون سیر معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.36,
   "end": 77.4,
   "text": "بارها عرض کردم که الحمدلله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.4,
   "end": 79.38,
   "text": "حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.38,
   "end": 84.64,
   "text": "آثار حکمی و عرفانی ایشون غالباً سیرشون همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.64,
   "end": 87.88,
   "text": "موضوع رو پیش میگیرن. کتاب‌هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.88,
   "end": 90.7,
   "text": "اگر دقت کرده باشید از حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.7,
   "end": 95.28,
   "text": "مثل همین به صورت مقدماتی سه جلد کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.28,
   "end": 97.92,
   "text": "معرفت نفس از علامه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.92,
   "end": 100.94,
   "text": "به گونه‌ای هم هستش که هر کسی با هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.94,
   "end": 103.28,
   "text": "میزان سوادی بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.28,
   "end": 105.94,
   "text": "نه اینکه به حق مطلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.94,
   "end": 107.7,
   "text": "متوجه بشه و برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.7,
   "end": 114.66,
   "text": "اما بالاخره نسبت به خودش و دانسته‌هاش متوج-- از اون برداشت میکنه، خوشه‌چینی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.66,
   "end": 119.0,
   "text": "اگرچه نیاز به شرح و بسط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.0,
   "end": 122.36,
   "text": "اما به نظرم شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.36,
   "end": 126.88,
   "text": "ااا برید سراغ شناخت وجودی خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.88,
   "end": 131.68,
   "text": "کتاب وجودی خودتون. اون کتابی که قرآن می‌فرماید اقرأ كتابك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.68,
   "end": 135.02,
   "text": "كفى بنفسك اليوم عليك حسيبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.02,
   "end": 141.8,
   "text": "و اون سمت وقتی انسان از این دنیا رفت، اونجا دیگه بهش میگن که خطاب میشه که کتاب خودت رو خودت بخوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.8,
   "end": 144.26,
   "text": "خودت هم کفایت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.26,
   "end": 145.98,
   "text": "برای خوانش این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.98,
   "end": 150.14,
   "text": "چرا؟ چون بل 인간 على نفسه بصيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.14,
   "end": 154.3,
   "text": "هر کسی به نفس خودش آگاه‌تره، بصیرتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.3,
   "end": 158.56,
   "text": "وقتی که خودت رو شناختی چون انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.56,
   "end": 164.96,
   "text": "از حیث ذات و صفات و افعال به وزان حضرت حق آفریده شده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.96,
   "end": 172.2,
   "text": "لذا با شناخت و خوانش کتاب وجودی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.2,
   "end": 177.1,
   "text": "بهتر از هر وسیله‌ی دیگه‌ای می‌تونه خداش رو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.1,
   "end": 180.76,
   "text": "و البته چون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.76,
   "end": 183.96,
   "text": "قرآن شرح کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.96,
   "end": 187.0,
   "text": "انسان هست، انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.0,
   "end": 191.92,
   "text": "و عالم این نظام افقی هم شرح عینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.92,
   "end": 195.2,
   "text": "انسان کامل هست، با خوانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.2,
   "end": 199.22,
   "text": "کتاب تدوینی نظام هستی که قرآن هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.22,
   "end": 204.08,
   "text": "و کتاب تکوینی که نظام افقی است، این کلمات وجودی رو بخواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.08,
   "end": 207.26,
   "text": "در کنارش کمک می‌کنه اینها هم به شناخت خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.26,
   "end": 209.92,
   "text": "در هر حال بهترین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.92,
   "end": 212.12,
   "text": "برای این راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.12,
   "end": 215.04,
   "text": "عزیزان همین کتاب است. کتابی است که به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.04,
   "end": 220.34,
   "text": "سیر مع-- هر کتابی که پیرامون معرفت نفس از بزرگان نوشته شده رو بخوانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.34,
   "end": 224.02,
   "text": "که البته مهم‌ترینش به نظر بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.02,
   "end": 229.0,
   "text": "کتاب سیر معرفت نفس حضرت علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.0,
   "end": 236.74,
   "text": "که وقتی شما خودت رو خوب بشناسی قطعاً خدا رو هم خوب می‌شناسی، امام رو هم بهتر می‌شناسی و خوب می‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.74,
   "end": 238.86,
   "text": "نبوت و رسالت رو خوب می‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.86,
   "end": 241.16,
   "text": "حتی بهشت و جهنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.16,
   "end": 244.12,
   "text": "مرگ و قبر و قیامت رو خوب می‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.12,
   "end": 248.92,
   "text": "همه‌ی این‌ها در پس شناخت خود هست که من عرف نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.92,
   "end": 254.68,
   "text": "فقد عرف ربه. بعد وقتی انسان از اینجا شروع کرد رفته، رفته پله به پله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.68,
   "end": 258.2,
   "text": "این حالت تخصصی‌تر پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.2,
   "end": 262.66,
   "text": "بعدش کتاب گنجینه‌ی گوهر روان علامه رو می‌تونه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.66,
   "end": 267.34,
   "text": "البته اگه با شرح و بسط شاگردان علامه که خون رو نعل و نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.34,
   "end": 270.38,
   "text": "بعد اتحاد عاقل به معقول فوق‌العاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.38,
   "end": 276.9,
   "text": "دیگه حالت پیشرفته‌تر و والا اون تخصصی‌ش دیگه شرح العيون في شرح العيون شصت و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.9,
   "end": 280.2,
   "text": "مسئله از مسائل و اصول معرفت نفس درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.2,
   "end": 284.5,
   "text": "ممهد الهمم في شرح فصوص الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.5,
   "end": 290.12,
   "text": "که از علامه دارن و عرض شود خدمتتون کتاب اون رساله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.12,
   "end": 293.3,
   "text": "شریف و عرشی انسان در عرف عرفان که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.3,
   "end": 296.54,
   "text": "عالیست، عالی. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.54,
   "end": 301.52,
   "text": "که اگه اشتباه نکنم فکر می‌کنم حدود چهل و هفت یا چهل و شش اصل از اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.52,
   "end": 303.94,
   "text": "معرفت نفس درش پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.94,
   "end": 307.82,
   "text": "بعد یواش یواش این‌ها انسان را سوق میده به سمت برنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.82,
   "end": 310.36,
   "text": "به هر حال بر اساس قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.36,
   "end": 312.86,
   "text": "قرآن در آیه‌ی صد و نود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.86,
   "end": 316.44,
   "text": "سوره آل عمران که بارها قرائت شده محضرتون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.44,
   "end": 324.68,
   "text": "جلسات إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات لأولي الألباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.68,
   "end": 329.2,
   "text": "اینا همه این کلمات وجودی نظام افقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.2,
   "end": 332.36,
   "text": "برای اهل لب و فکر و مغز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.36,
   "end": 336.26,
   "text": "اونایی که اهل عقل و تعقل هستن، اینا آیه های الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.26,
   "end": 338.74,
   "text": "اینا کتاب قرآن هستی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.74,
   "end": 344.16,
   "text": "بعد این‌ها رو که معرفی می‌کنه آیه بعد، آیه‌ی صد و نود و یک می‌فرماید که الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.16,
   "end": 349.2,
   "text": "يذكرون الله قياما و قعودا و على جنوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.2,
   "end": 351.04,
   "text": "این‌ها اهل ذکرند دائماً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.04,
   "end": 354.16,
   "text": "یذكرون فعل مضارع دلالت بر استمرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.16,
   "end": 357.82,
   "text": "ایستاده، نشسته، خوابیده، مشغول ذکرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.82,
   "end": 360.66,
   "text": "بعد دوباره میاد می‌فرماید حالا میخوای بدونی اینا کی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.66,
   "end": 366.7,
   "text": "و يتفكرون، و يتفكرون في خلق السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.7,
   "end": 369.98,
   "text": "ربنا ما خلقت هذا باطلا سبحانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.98,
   "end": 376.34,
   "text": "وقنا عذاب النار. چه آیه شیرینیه این که هر روز آدم بهش دقت کنه باز چیز جدیدی گیرش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.34,
   "end": 382.08,
   "text": "به هر حال طبق این آیه وقتی دقت میکنیم میبینید ذکر اونم دائم و ذکر شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.08,
   "end": 385.42,
   "text": "بین فکر دو تا فکر اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.42,
   "end": 387.92,
   "text": "لب توجه به آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.92,
   "end": 390.46,
   "text": "خوانش کلمات وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.46,
   "end": 394.68,
   "text": "بعد یتفکرون دوباره فی خلق السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.68,
   "end": 397.9,
   "text": "با تفکر با اصل تفکر و تدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.9,
   "end": 403.7,
   "text": "انسان میتونه بره جلو یواش یواش به قول حضرت علامه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.7,
   "end": 408.14,
   "text": "تفکر و تدبر و تعقل خوانش این کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.14,
   "end": 413.14,
   "text": "کتاب‌ها که مهم‌ترینش کتاب وجودی نفس خودمون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.14,
   "end": 416.24,
   "text": "از اینجا دیگه خود به خود ذکر القا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.24,
   "end": 420.62,
   "text": "شما به عملیات میفتی، به عمل میفتی، به ذکر میفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.62,
   "end": 423.42,
   "text": "ذکر اصلاً القا میشه. بعد کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.42,
   "end": 428.98,
   "text": "نامه و برنامه‌های علامه برای عرفان عملی حکمت عل-- عملی خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.98,
   "end": 434.14,
   "text": "نور علی نور در ذکر و ذاکر و مذکور عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.14,
   "end": 436.26,
   "text": "و کتاب‌های دیگه حالا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.26,
   "end": 439.42,
   "text": "مثلاً خدا رحمت کنه سید عبد الله بهجت رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.42,
   "end": 442.8,
   "text": "بچه که بودیم محضر ایشون می‌رفتیم قم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.8,
   "end": 448.84,
   "text": "خب تازه افتاده بودیم تو وادی‌ها خیلی عطش داشتیم کتاب‌های ادعیه مختلف رو می‌گرفتیم می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.84,
   "end": 451.66,
   "text": "ایشون به من توصیه کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.66,
   "end": 454.42,
   "text": "مفاتیح الجنان شیخ عباس کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.42,
   "end": 458.04,
   "text": "همین کتاب رو بخونید عمل کنید به امام عصر هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.04,
   "end": 461.54,
   "text": "محبت شما تو دل آقا و بالعکس موج می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.54,
   "end": 465.26,
   "text": "همین کتاب برای ابتدا هم مفاتیح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.26,
   "end": 468.78,
   "text": "ازش قا-قافل نباشیم نسبت به صاعته وجودی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.78,
   "end": 473.1,
   "text": "بعد البته خب یه مقدار رشد کرد انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.1,
   "end": 476.8,
   "text": "میتونه از کتاب اقبال سید ابن طاووس استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.8,
   "end": 480.94,
   "text": "مفتاح الفلاح شیخ بهائی، عدت الداعی ابن فه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.94,
   "end": 483.78,
   "text": "ابن فهد حلی، عدت الداعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.78,
   "end": 492.3,
   "text": "بسیار کتاب عالیه. غوث القلوب ابو طالب مکی سفارش شده توسط بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.3,
   "end": 495.32,
   "text": "و هرچه باشد. المراقبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.32,
   "end": 499.66,
   "text": "آقای امیر جواد ملکی تبریزی هم خیلی کتاب عالی و خوبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.66,
   "end": 502.48,
   "text": "و این‌ها کمک می‌کنه به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.48,
   "end": 504.54,
   "text": "انشاالله که هممون موفق باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.54,
   "end": 507.38,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.38,
   "end": 510.34,
   "text": "و انشاالله که ما رو هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.34,
   "end": 513.98,
   "text": "از دعای خیرتون بی‌نصیب نگذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}