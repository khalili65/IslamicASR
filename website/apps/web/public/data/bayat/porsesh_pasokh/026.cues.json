   "start": 0.64,
   "end": 145.74
  },
  {
   "index": 1,
   "title": "## علم غیب و ترک مدینه",
   "start": 145.74,
   "end": 236.64
  },
  {
   "index": 2,
   "title": "## نام محسن پیش از ولادت",
   "start": 236.64,
   "end": 576.89
  },
  {
   "index": 3,
   "title": "## قدرت الهی صدیقه و دستور صبر",
   "start": 576.89,
   "end": 705.41
  },
  {
   "index": 4,
   "title": "## زمان واقعهٔ کوچه و خطبه در مسجد",
   "start": 705.41,
   "end": 971.11
  },
  {
   "index": 5,
   "title": "## شبههٔ ازدواج ام‌کلثوم و جمع‌بندی",
   "start": 971.11,
   "end": 1217.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 2.78,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.78,
   "end": 9.56,
   "text": "و به نستعین. والعاقبة لأهل التقى واليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.56,
   "end": 12.54,
   "text": "چند وقتی‌ست که کلیپی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.54,
   "end": 17.06,
   "text": "به صورت تصویری پخش میشه در فضای مجازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.06,
   "end": 21.62,
   "text": "که عنوانش هست دو کلام حرف حساب که بهتره بنویسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.62,
   "end": 28.76,
   "text": "حرف ناحساب و البته به طرز ناشیانه‌ای واقعه کوچه و قضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.76,
   "end": 32.94,
   "text": "شهادت حضرت زهرا صلوات الله علیها رو زیر سوال بردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.94,
   "end": 40.92,
   "text": "هر آدم حتی ضعیفی از حیث تحقیق و پژوهش جوابش رو میتونه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.92,
   "end": 48.4,
   "text": "اصلاً نیازی نیست که بخواد محققین، علما، فضلاى ما جوابیه ای داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.4,
   "end": 51.58,
   "text": "لذا حقیر هم چند تا کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.58,
   "end": 55.9,
   "text": "عرض می‌کنم که کلام ما البته حرف حساب است و محت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.9,
   "end": 58.06,
   "text": "مستحکم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.06,
   "end": 65.88,
   "text": "متقن. اولاً توی این کلیپ گفتن که افسانه العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.88,
   "end": 68.08,
   "text": "افسانه شهادت و چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.08,
   "end": 73.38,
   "text": "جالبه که واقعاً این‌ها رو که آدم می‌بینه و گوش میده متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.38,
   "end": 77.44,
   "text": "اون حقیقتی میشه که اهل بیت علیهم السلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.44,
   "end": 81.36,
   "text": "خداوند دشمنان ما را از احمق‌ها آفریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.36,
   "end": 86.2,
   "text": "از جهال. جهل اینا در گویش‌شون کاملاً مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.2,
   "end": 88.86,
   "text": "وقتی میگن افسانه شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.86,
   "end": 95.96,
   "text": "در حقیقت اون اندیشمندان و صاحبان فکر و حتی قلم خودشون رو هم زیر سوال می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.96,
   "end": 98.92,
   "text": "اینا رو من دعوت می‌کنم به کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.92,
   "end": 101.84,
   "text": "خورشید در بستر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.84,
   "end": 110.04,
   "text": "کتاب قطوری‌ست. نیمی از این کتاب به روایت علمای شیعه و نیمی به روایت کبار اهل تسننه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.04,
   "end": 115.2,
   "text": "که قصه شهادت حضرت زهرا صلوات الله علیها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.2,
   "end": 123.2,
   "text": "فریقین اثبات کردن که خانم به شهادت رسیده و نحوه شهادت رو هم کاملاً به زبان خودشون بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.2,
   "end": 127.54,
   "text": "پس در اولین مواجهه با این قبیل مبحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.54,
   "end": 129.82,
   "text": "حرف‌های بیهوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.82,
   "end": 135.7,
   "text": "عرض می‌کنیم که این‌ها اهل تحقیق نیستند، اهل مطالعه هم نیستند، چه برسه به تحقیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.7,
   "end": 140.66,
   "text": "سوالی که مطرح کردن گفتن چگونه میشه که مثلاً خانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.66,
   "end": 144.86,
   "text": "ان‌شاءالله امام عصر صلوات الله علیه بنده رو ببخشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.86,
   "end": 148.68,
   "text": "جسارت این‌ها رو این چنین جواب میدیم چاره‌ای نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.68,
   "end": 155.46,
   "text": "که چرا مثلاً خانم باردار بوده اومده پشت در در حالی که علی فاتح خیبر در منزل بوده و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.46,
   "end": 157.88,
   "text": "این هم جوابش در روایات ما اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.88,
   "end": 160.12,
   "text": "همین سؤال پرسیده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.12,
   "end": 168.96,
   "text": "و فرمودن که اصلاً یه فرمایشی هم پیغمبر عزیز عالم روزهای آخر عمرشون دارن به امیرالمؤمنین صلوات الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 168.96,
   "end": 172.84,
   "text": "با اون شکلی که فاطمه به تو امر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.84,
   "end": 176.44,
   "text": "عمل کن. به جهت عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.44,
   "end": 183.32,
   "text": "حضرت صدیقه صلوات الله علیها که حالا جوازاتش رو علما تشریح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.32,
   "end": 188.98,
   "text": "حضرت زهرا به جهت شدت قربتی که مولا پیدا کرده بودند در مدینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.98,
   "end": 196.02,
   "text": "خودشون فرمودن که علی جان این بار که اومدن در به منزل شما نرو اجازه بده من برم شاید حیا کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 196.02,
   "end": 199.94,
   "text": "از اینکه من دختر پیغمبر هستم، باردار هستم اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 199.94,
   "end": 202.08,
   "text": "حیا کنن. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.08,
   "end": 206.14,
   "text": "میشه گفت حضرت صدیقه صلوات-- صلوات الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.14,
   "end": 212.14,
   "text": "خواستن اثبات کنن به همه عالم که این‌ها کوچک‌ترین حیا و شرمی در وجودشون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 212.14,
   "end": 217.26,
   "text": "مثل کاری که ابا عبدالله صلوات الله علیه در کربلا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.26,
   "end": 222.08,
   "text": "شیرخوارشون رو بلند کردن که قساوت قلب اون ملعونه‌ای رو به عالم اثبات کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.08,
   "end": 227.7,
   "text": "البته یک وجهش اینه. دومین سوالی که گفتن مطلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 227.7,
   "end": 231.66,
   "text": "گفتن اینکه اگر این‌ها علم غیب می‌دونستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 231.66,
   "end": 235.96,
   "text": "امیرالمؤمنین، حضرت زهرا، امام حسن، امام حسین که در اون منزل بودند و علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 235.96,
   "end": 239.54,
   "text": "غیب می‌دونستن چرا زودتر از مدینه بیرون نرفتند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 239.54,
   "end": 242.64,
   "text": "خب این سؤال رو هم خیلی راحت میشه جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 242.64,
   "end": 245.0,
   "text": "به گواه تاریخ که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 245.0,
   "end": 246.8,
   "text": "هر کجا میخوان-- اولاً کجا برن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.8,
   "end": 249.84,
   "text": "اونجا کاشونه‌شون بوده، منزلشون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.84,
   "end": 255.26,
   "text": "برای چی به راحتی حق رو به اون‌ها بدن و میدان رو خالی کنند و بروند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.26,
   "end": 264.14,
   "text": "ضمن اینکه مثل ق-- باز قصه ابا عبدالله صلوات الله علیه که هر کجا می‌رفتند باز این‌ها دنبال سر این‌ها بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.14,
   "end": 267.26,
   "text": "به اصحاب آقام رحم نکردند چه برسه به خود حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 267.26,
   "end": 270.56,
   "text": "مگر اباذر رو تبعید نکردند و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 270.56,
   "end": 275.5,
   "text": "بیابان از گرسنگی و تشنگی به شهادت نرسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 275.5,
   "end": 277.32,
   "text": "اصلاً قصه فراتر از این حرفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 277.32,
   "end": 285.84,
   "text": "ضمن اینکه اگر بخواهیم این چنین نگاه کنیم خیلی سؤالات پیش میاد که همه این‌ها، این سؤالات در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 285.84,
   "end": 287.8,
   "text": "ضمن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 287.8,
   "end": 290.62,
   "text": "تعبیری که علمای ما کردن جوابش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 290.62,
   "end": 296.02,
   "text": "اونم اینکه اهل بیت علیهم السلام هر کجایی از علم غیبشون استفاده نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 296.02,
   "end": 301.32,
   "text": "به تعبیر آقای قرائتی خدا حفظشون کنه مثل یک پلیسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 301.32,
   "end": 307.66,
   "text": "مثلاً اسلحه به کمرش بسته اجازه نداره در هر جایی از این اسلحه استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 307.66,
   "end": 311.68,
   "text": "سؤال بعدی که مطرح کردن گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.68,
   "end": 318.04,
   "text": "اگر این‌ها می‌دونستن مثلاً مولامون علی علیه الصلاة والسلام می‌دونستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 318.04,
   "end": 322.18,
   "text": "قراره بزنن، بشکنن، بکشن این‌ها چرا زودتر بیعت نکردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 322.18,
   "end": 323.92,
   "text": "خب قصه اصلاً سر همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.92,
   "end": 327.88,
   "text": "جواب اینه که آی آدم‌های جاهل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 327.88,
   "end": 332.22,
   "text": "بی‌خبر اصلاً مولامون در منزل نشست که با اینا بیعت نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 332.22,
   "end": 335.6,
   "text": "نمی‌خواست بیعت کنه و حتی وقتی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 335.6,
   "end": 338.42,
   "text": "بردن به زور آقا رو تو مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 338.42,
   "end": 340.52,
   "text": "روایت داریم که مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 340.52,
   "end": 342.82,
   "text": "مشت حتی فریقین اینو نقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 342.82,
   "end": 345.46,
   "text": "مشت مبارکشون رو باز نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 345.46,
   "end": 348.8,
   "text": "و اون ملعون اومد دست زد به دست علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 348.8,
   "end": 351.02,
   "text": "و اعلام کرد که بیعت انجام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 351.02,
   "end": 353.5,
   "text": "و الا مولا مطلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 353.5,
   "end": 357.52,
   "text": "اصلاً به همین جهت مقاومت کرد که بیعت نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 357.52,
   "end": 360.32,
   "text": "و مطلب بعدی گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.32,
   "end": 366.79,
   "text": "خانه‌های اون موقع گلی been بوده، کوچک بوده، نمی‌دونم با برگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.79,
   "end": 373.95,
   "text": "نخل خرما و حصیر و این‌ها بوده چگونه آتش گرفته در حالی که این آتش کنترل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.95,
   "end": 378.09,
   "text": "خب این‌ها هم انقدر جاهلن که اولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.09,
   "end": 384.55,
   "text": "نکردن حداقل تاریخ مدینه رو در اون خص-- در اون زمان مطالعه بفرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.55,
   "end": 388.77,
   "text": "و ابداعاتی که خود امیرالمؤمنین صلی الله علیه در صنعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.77,
   "end": 396.21,
   "text": "معماری منازل داشتند نه فقط در حفر چاه و باغات و انشا و احياء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 396.21,
   "end": 401.75,
   "text": "زمین‌ها و کش– کشاورزها و این‌ها بلکه حتی در معماری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 401.75,
   "end": 409.07,
   "text": "اتفاقا در خانه مولامون علی علیه الصلاة والسلام به روایت تاریخ از جنس چوب بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 409.07,
   "end": 417.11,
   "text": "و در، در بهترین صنعت یعنی اهل بیت علیهم الصلاة والسلام صرفا به احکام شرعیه نپرداختند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 417.11,
   "end": 420.75,
   "text": "بلکه مردم را به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 420.75,
   "end": 423.39,
   "text": "توسعه و پیشرفت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 423.39,
   "end": 431.05,
   "text": "ارجاع دادند و تشویق کردند و در همین حین کمک هم کردند حتی در صنعت چاه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 431.05,
   "end": 435.35,
   "text": "و بایر کردن زمین‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 435.35,
   "end": 438.53,
   "text": "جهت کشاورزی استفاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 438.53,
   "end": 443.19,
   "text": "صناعات خیلی جالبی امیرالمؤمنین صلی الله علیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 443.19,
   "end": 445.73,
   "text": "درست کردن ابزار آلات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 445.73,
   "end": 449.49,
   "text": "اون لوازمی که به درد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 449.49,
   "end": 451.95,
   "text": "صنعت کشاورزی و اینا می‌خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.95,
   "end": 454.01,
   "text": "در تاریخ براشون ذکر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 454.01,
   "end": 458.09,
   "text": "کارهای قشنگ و ابداعات زیبایی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 458.09,
   "end": 462.69,
   "text": "و ضمن اینکه گفتن اتاق خیلی کوچک بوده و چه می‌دونم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 462.69,
   "end": 466.15,
   "text": "اتفاقا این هم با روایت تاریخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 466.15,
   "end": 471.45,
   "text": "درست نیست. اتفاقا خانه مولا اندرونی داشته و بیرونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 471.45,
   "end": 474.47,
   "text": "اینطور نبوده که فقط یک اتاق باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 474.47,
   "end": 478.43,
   "text": "اندرونی باشه به روایت این هم که اتفاقا به شاهد همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.43,
   "end": 480.67,
   "text": "ر– موضوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.67,
   "end": 484.55,
   "text": "دوستان حضرت هم داخل منزل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 484.55,
   "end": 490.51,
   "text": "هیچ وقت دوستان حضرت نمیان در اتاقی قرار بگیرن، در حجره‌ای قرار بگیرن که ناموس خدا هم اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.51,
   "end": 494.57,
   "text": "حالا عرض می‌کنیم تو سوالات بعدی هم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.57,
   "end": 497.63,
   "text": "مطلب بعدی گفتن چگونه که اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.63,
   "end": 504.75,
   "text": "اون عزیزی که شهید شده در رحم حضرت زهرا سلام الله علیها و سقط شده اسمش محسن بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 504.75,
   "end": 509.51,
   "text": "در حالی که هنوز به دنیا نیومده چگونه بچه‌ای که به دنیا نیومده اسمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.51,
   "end": 511.85,
   "text": "محسن از قبل نامگذاری شده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 511.85,
   "end": 514.39,
   "text": "این هم از جهل و بی‌خبری ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 514.39,
   "end": 518.69,
   "text": "همین الان از زمان‌های قدیم بوده تا حالا هم ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 518.69,
   "end": 521.43,
   "text": "خیلی‌ها هنوز بچه‌شون اصلا بچه‌دار هم نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 521.43,
   "end": 525.85,
   "text": "اصلا بچه در رحم مادر نیست براش اسم انتخاب کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 525.85,
   "end": 530.25,
   "text": "که آقا اگر خدا به من بچه بده مثلا اسمشو میذارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 530.25,
   "end": 533.37,
   "text": "فلان. اینا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 533.37,
   "end": 535.41,
   "text": "از جهل و بی‌خبری و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 535.41,
   "end": 539.39,
   "text": "می‌شه-- شاید اینجا دیگه باید گفت عناد نگهد-- نباید گفت جهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.39,
   "end": 545.25,
   "text": "عناد، دشمنی و بغضی که اینا نسبت به اهل بیت دارن مخصوصا از کلمات زشتی که استفاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 545.25,
   "end": 549.31,
   "text": "اینجور جاها میگن سناریو یعنی یه سناریویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 549.31,
   "end": 554.61,
   "text": "طراحی شده که باید تو اون سناریو شخصیت S داشته باشه و از این مزخرفات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 554.61,
   "end": 558.15,
   "text": "اراجیف. که بله این نام رو نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 558.15,
   "end": 560.37,
   "text": "محسن رو توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 560.37,
   "end": 565.61,
   "text": "اتفاقا اهل بیت علیهم الصلاة والسلام از قبل از شها–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 565.61,
   "end": 572.47,
   "text": "شهادت این آقا مثل نام امام حسن، امام حسین این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 572.47,
   "end": 576.49,
   "text": "ایجاد شده بود و تعیین شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 576.49,
   "end": 583.75,
   "text": "اما در خصوص اینکه چگونه می‌شه که مثلا حضرت زهرا صلی الله علیها با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 583.75,
   "end": 586.83,
   "text": "ضربات که بهشون وارد شده بوده مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 586.83,
   "end": 595.65,
   "text": "اون ملعون خبیث با چندین نفر مرد مثلا تو روایت هست که مولا رو می‌کشیدند چون حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 595.65,
   "end": 599.49,
   "text": "یه سمت ریسمان رو حالا به یه روایت کمر مولا رو گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 599.49,
   "end": 603.53,
   "text": "اینا زورشون نمی‌رسید. چگونه‌ست که مثلا زور چند تا مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 603.53,
   "end": 606.23,
   "text": "به یک خانم نرسیده؟ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 606.23,
   "end": 611.31,
   "text": "جالبه که خود این ملعونی هم که داره این روایتو میگه اقرار می‌کنه که بعد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 611.31,
   "end": 618.07,
   "text": "دومی ملعون با مثلا تازیانه به بازوان خانم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 618.07,
   "end": 621.79,
   "text": "اینجا باید گفتش که اولا این قدرت، قدرت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 621.79,
   "end": 627.59,
   "text": "همونطور که مولامون علی علیه الصلاة والسلام فرمودن من وقتی دروازه خیبرو از جا کندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 627.59,
   "end": 629.75,
   "text": "اصلا دروازه رو حس نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 629.75,
   "end": 635.29,
   "text": "به قدرت ربانی و الهی و روحانیم این کارو کردم نه جسمانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 635.29,
   "end": 638.31,
   "text": "ضمن اینکه حضرت صدیقه سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 638.31,
   "end": 645.97,
   "text": "به شه– به شهود روایت‌هایی که بسیار تو به تواتر اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 645.97,
   "end": 652.57,
   "text": "بسیار رشیده بودند، قدرتمند بودند، از نسل بنی هاشم بودند و بیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 652.57,
   "end": 655.87,
   "text": "چندین برابر یک دختر معمولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 655.87,
   "end": 660.37,
   "text": "رشد داشتند، قوت داشتند، بنیه داشتند و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 660.37,
   "end": 664.33,
   "text": "حالا این‌ها رو ارجاع میدیم به تاریخ برن مطالعه کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 664.33,
   "end": 669.47,
   "text": "و اینکه گفتن اون‌هایی که حالا مولا اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 669.47,
   "end": 674.15,
   "text": "مثلا به زور آقا رو بردن یا حضرت زهرا سلام الله علیها رو زدن و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 674.15,
   "end": 676.31,
   "text": "مولا دستور صبر داشت. خب بقیه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 676.31,
   "end": 679.85,
   "text": "اون یارانی که داخل منزل بودند چه می‌کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 679.85,
   "end": 684.67,
   "text": "اونجا هم روایت هست چون امیرالمؤمنین از پیغمبر دستور صبر داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 684.67,
   "end": 688.35,
   "text": "به اون کسانی که اونجا بودند از اون ابتدا فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 688.35,
   "end": 694.33,
   "text": "که اگر کسی قدرت و تحمل صبر کردن نداره پاشه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 694.33,
   "end": 695.87,
   "text": "بنده دستور صبر دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 695.87,
   "end": 701.01,
   "text": "کسی هم نباید اینجا دخالت کنه به جهت اینکه وحدت حفظ بشه، جامعه اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 701.01,
   "end": 705.09,
   "text": "متشتت نشه و زحمات پیغمبر به باد نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 705.09,
   "end": 708.29,
   "text": "و نکته بعدی که اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 708.29,
   "end": 713.37,
   "text": "این قلتهایی که وارد کردن که گفتن چگونه می‌شه که زنی که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 713.37,
   "end": 715.81,
   "text": "امام عصر صلی الله علیه ما را ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 715.81,
   "end": 718.89,
   "text": "مثلا میخ در به سینه اش فرو رفته یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 718.89,
   "end": 722.61,
   "text": "اون همه ضربات بهش وارد شده و این‌ها جالبه که خودشونم اقرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 722.61,
   "end": 726.91,
   "text": "بعد چگونه‌ست که سوار بر الاغ شده و رفته در منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 726.91,
   "end": 733.03,
   "text": "مثلاً انصار و مهاجرین و اینها یار طلبیده و رفته مسجد خطبه خونده و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 733.03,
   "end": 739.37,
   "text": "اتفاقاً ما در بحث اون جعلی بودن نهم ربیع قصه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 739.37,
   "end": 743.89,
   "text": "ااا عرض شود اون جشنی که می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 743.89,
   "end": 748.67,
   "text": "متعصبین ما متاسفانه می‌گیرن، اونجا اثباتمون اتفاقاً به همین نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 748.67,
   "end": 752.07,
   "text": "میگیم که این اتفاقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 752.07,
   "end": 755.77,
   "text": "بلافاصله بعد شهادت پیغمبر رخ نداده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 755.77,
   "end": 763.43,
   "text": "یعنی طول کشیده حداقل یک ماه و نیم الی دو ماه بعد از شهادت پیغمبر این اتفاق کوچه رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 763.43,
   "end": 767.49,
   "text": "اون اتفاقی که منجر به شهادت خانم و ضربات میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 767.49,
   "end": 774.61,
   "text": "و این رفتن در منزل صحابه و اینها انصار و مهاجرین و اینها همه قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 774.61,
   "end": 779.29,
   "text": "اون واقعه‌ی مذکوره در کوچه است؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 779.29,
   "end": 783.15,
   "text": "یعنی در زمان سلامت خانم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 783.15,
   "end": 786.25,
   "text": "اما گفتن که چا-- مثلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 786.25,
   "end": 790.79,
   "text": "اتفاق اون منزلی که از خانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 790.79,
   "end": 794.63,
   "text": "ااا توی روایات اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 794.63,
   "end": 798.95,
   "text": "اون توصیفاتی که برای در و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 798.95,
   "end": 801.53,
   "text": "وضعیت خانه‌ی منزل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 801.53,
   "end": 804.59,
   "text": "خانه‌ی منزل امیرالمؤمنین و اون حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 804.59,
   "end": 807.85,
   "text": "مخصوصاً در و دیوار و اینها شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 807.85,
   "end": 811.43,
   "text": "ما رو برمی‌گرده به چهار قرن بعد از اون‌ها؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 811.43,
   "end": 814.21,
   "text": "یعنی زمان مل-- بن العباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 814.21,
   "end": 817.27,
   "text": "که مثلاً دروازه‌ای داشتن، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 817.27,
   "end": 821.83,
   "text": "بزرگی داشتن، حیاط و مثلاً حیاط بسیار بزرگی داشتن اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 821.83,
   "end": 826.37,
   "text": "اینم باز برمی‌گرده به جهل و بی‌خبری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 826.37,
   "end": 832.33,
   "text": "اینکه اینها نکرده‌ن حداقل تاریخ رو بردارن بخونن که اتفاقاً اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 832.33,
   "end": 837.31,
   "text": "در وضعیت منزل مولامون علی علیه الصلاة والسلام بوده هیچ ربطی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 837.31,
   "end": 839.95,
   "text": "معماری زمان بن العباس نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 839.95,
   "end": 842.09,
   "text": "عینا مال همون زمان بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 842.09,
   "end": 846.93,
   "text": "و اینکه گفتن حالا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 846.93,
   "end": 849.79,
   "text": "تشبییهاتی کردن چه عرض کنم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 849.79,
   "end": 853.75,
   "text": "حرفای کریه و زشتی زدن که مثلاً اگه حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 853.75,
   "end": 858.97,
   "text": "پشت در قرار گرفته اگر در نود درجه باز شده خانم پرت میشه به دیوار نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 858.97,
   "end": 861.85,
   "text": "اگه صد و هشتاد درجه در باز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 861.85,
   "end": 868.39,
   "text": "باز خانم پرت میشه یا اصلاً میشه مگه صد و هشتاد درجه باز بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 868.39,
   "end": 871.51,
   "text": "یه مقدارم باز بشه مردم می‌تونن هجوم بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 871.51,
   "end": 876.17,
   "text": "هر جور حرفای به درد نخور بی‌پایه و اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 876.17,
   "end": 880.15,
   "text": "که اولاً اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 880.15,
   "end": 888.99,
   "text": "اون معماری و مهندسی منزل مولامون علی علیه الصلاة والسلام رو به روایت تاریخ بخونن جواب می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 888.99,
   "end": 891.29,
   "text": "ثانیا اینکه اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 891.29,
   "end": 894.05,
   "text": "در نامه‌ای که دومی ملعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 894.05,
   "end": 898.65,
   "text": "به معاویه لعنت الله عليه نوشت، همونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 898.65,
   "end": 904.75,
   "text": "اتفاقاً ذکر می‌کنه که من وقتی پشت در قرار گرفتم اتفاقاً جالبه که خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 904.75,
   "end": 906.81,
   "text": "اهل تسنن هم این نامه رو قید کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 906.81,
   "end": 915.81,
   "text": "من پشت در که قرار گرفتم صدای نفس کشیدن فاطمه رو که شنیدم با تمام قدرتم رو در پاهام جمع کردم و به در کوبیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 915.81,
   "end": 919.21,
   "text": "که صدای ناله او را از پشت در شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 919.21,
   "end": 921.43,
   "text": "اینا یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 921.43,
   "end": 926.15,
   "text": "وقایعی‌ست که حالا اینکه چرا گفتن بین در و دیوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 926.15,
   "end": 928.99,
   "text": "حتماً هم نمی‌تونه این باشه که یعنی خانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 928.99,
   "end": 933.33,
   "text": "اون لحظه‌ای که در باز شد به دیوار برخورد کرد که خب خانم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 933.33,
   "end": 941.51,
   "text": "به جهت اون حیا و حجبی که داشتن حجاب و عفت و متانتی که داشتن پشت در خودشون رو نگه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 941.51,
   "end": 945.79,
   "text": "حتی روایاتی داریم که ایشون در حالی که میخ در، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 945.79,
   "end": 951.57,
   "text": "حالا میخ هم بعضی گفتن پرچ بوده، پرچ مانندی بوده که این تیزیش بیرون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 951.57,
   "end": 953.15,
   "text": "در سینه خانم فرو میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 953.15,
   "end": 956.73,
   "text": "ایشون تو همون حالت برای اینکه کسی نگاهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 956.73,
   "end": 961.07,
   "text": "به سمت کبرا نیفته خودش رو پشت در نگه می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 961.07,
   "end": 964.51,
   "text": "یعنی بین دیوار و در. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 964.51,
   "end": 970.95,
   "text": "حالا حرفای اینا کاملاً بی‌پایه و اساسه در این خصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 970.95,
   "end": 974.35,
   "text": "و اما آخرین شبهه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 974.35,
   "end": 981.03,
   "text": "این از خدا بی‌خبران وارد کردن، این جهال وارد کردن و حتی میشه گفت این معاندین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 981.03,
   "end": 984.89,
   "text": "وارد کردن بحث موضوع نخ‌نمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 984.89,
   "end": 993.49,
   "text": "تاریخی ازدواج دختر امیرالمؤمنین حضرت طاهره معصومه سلام الله علیها با عمر علیه اللعنه است که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 993.49,
   "end": 1000.01,
   "text": "بیان می‌کنند که یعنی قائل به این هستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1000.01,
   "end": 1005.69,
   "text": "اگر برای اینکه عادی‌سازی کنن روابط بین مولا و خلی-- خلفا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1005.69,
   "end": 1009.61,
   "text": "میان کلاً یه همچین جعلی رو قرار میدن در تاریخ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1009.61,
   "end": 1015.07,
   "text": "آره اگر امیرالمؤمنین مشکلی با اون‌ها داشت چرا دخترش رو به دومی داد و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1015.07,
   "end": 1020.13,
   "text": "در حالی که بسیاری از اندیشمندان و بزرگان اهل شیعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1020.13,
   "end": 1025.25,
   "text": "اصلاً داشتن دختری به نام حضرت طاهره معصومه سلام الله علیها رو برای حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1025.25,
   "end": 1032.59,
   "text": "و امیرالمؤمنین انکار کردن. مثل رضیدین حلی، علامه مقرم، علامه باقر شریف قرشی اینا همه انکار کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1032.59,
   "end": 1036.01,
   "text": "و البته بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1036.01,
   "end": 1042.13,
   "text": "علمای شیعه هم به جهت با داشتن دلیل‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1042.13,
   "end": 1045.05,
   "text": "متقنی منکر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1045.05,
   "end": 1048.15,
   "text": "موضوع شدن. یعنی منکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1048.15,
   "end": 1053.71,
   "text": "به جهت وجود تعارضات در روایات از-- منکر این ازدواج شدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1053.71,
   "end": 1056.83,
   "text": "گفتن دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1056.83,
   "end": 1059.73,
   "text": "واضحی برای بطلان مدعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1059.73,
   "end": 1068.83,
   "text": "البته اهل تسنن که این رو ادعا می‌کنند وجود داره از جمله شیخ مفید که از اعاظم علماست در دو تا رساله مجزاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1068.83,
   "end": 1071.83,
   "text": "معروفه به المسائل، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1071.83,
   "end": 1073.83,
   "text": "پیرامون این موضوع بحث می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1073.83,
   "end": 1076.79,
   "text": "همچنین سید ناصر حسین الهندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1076.79,
   "end": 1080.19,
   "text": "الهندی معروف به الهندی در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1080.19,
   "end": 1083.31,
   "text": "افحام الاعداء و الخصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1083.31,
   "end": 1084.91,
   "text": "و همچنین آیت الله میلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1084.91,
   "end": 1086.85,
   "text": "اینا همه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1086.85,
   "end": 1090.01,
   "text": "تعارض‌های گسترده در این قصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1090.01,
   "end": 1094.92,
   "text": "این قبیل مستندات رو فاقد ارزش و سندیت می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1094.92,
   "end": 1098.48,
   "text": "و البته بعض به ندرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1098.48,
   "end": 1102.26,
   "text": "بعض از علما به ندرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1102.26,
   "end": 1105.26,
   "text": "عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1105.26,
   "end": 1109.5,
   "text": "که قبول می‌کنند این ازدواج صورت گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1109.5,
   "end": 1114.88,
   "text": "مثل مثلاً تا اونجا که در خاطرم هست سید مرتضی باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1114.88,
   "end": 1119.4,
   "text": "این‌ها میگن اگرم بپذیریم که یه همچین اتفاقی افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1119.4,
   "end": 1124.3,
   "text": "با زورگویی و تهدید دومی این صورت گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1124.3,
   "end": 1128.42,
   "text": "و با رضایت خاطر مولا نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1128.42,
   "end": 1135.34,
   "text": "اتفاقاً بعضی دیگر از علمای شیعه و حتی اهل تسنن با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1135.34,
   "end": 1142.34,
   "text": "پذیرش اینکه شخصی به نام ام کلثوم همسر دومی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1142.34,
   "end": 1145.7,
   "text": "عنوان می‌کنند که اصلاً ایشون دختر امیرالمؤمنین نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1145.7,
   "end": 1150.84,
   "text": "بله یه همچین کسی بوده اما دختر مولا نبوده، دختر ابوبکر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1150.84,
   "end": 1154.88,
   "text": "مثل یحیی بن شرف نووی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1154.88,
   "end": 1158.04,
   "text": "بله یحیی بن شرف نووی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1158.04,
   "end": 1162.0,
   "text": "مثلاً مهم‌ترین شارحین صحیح مسلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1162.0,
   "end": 1165.22,
   "text": "که در کتاب تهذیب الأسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1165.22,
   "end": 1170.36,
   "text": "این مطلب رو نقل کرده. همچین آیت الله آقای معارشی نجفی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1170.36,
   "end": 1177.78,
   "text": "ایشون هم که از علمای بزرگ و برجسته شیعه‌ست در شرح احقاق الحقش به این مطلب تصریح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1177.78,
   "end": 1181.54,
   "text": "در مجموع عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1181.54,
   "end": 1185.32,
   "text": "این‌هایی که این چنین جو پراکنی می‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1185.32,
   "end": 1187.52,
   "text": "میخوان اون عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1187.52,
   "end": 1190.44,
   "text": "این واقعه رو به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1190.44,
   "end": 1193.0,
   "text": "استهاله کردن دامن آلوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1193.0,
   "end": 1196.44,
   "text": "مشایخ‌شون کوچک کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1196.44,
   "end": 1201.24,
   "text": "بدانند که زورشون به حتی تاریخ هم نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1201.24,
   "end": 1204.46,
   "text": "چه برسه به دل‌های مردمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1204.46,
   "end": 1206.78,
   "text": "سالیان سال واج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1206.78,
   "end": 1210.44,
   "text": "و مملو از عشق و محبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1210.44,
   "end": 1213.24,
   "text": "خانم حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1213.24,
   "end": 1217.54,
   "text": "و بغض‌دار و کینه‌دار نحوه شهادت ایشون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}