 "chapters": [
  {
   "index": 0,
   "title": "## ربوبیت؛ پرورش از نقص به کمال",
   "start": 0.94,
   "end": 172.2
  },
  {
   "index": 1,
   "title": "## عهدِ عبودیت و کنهِ ربوبیت",
   "start": 172.2,
   "end": 193.32
  },
  {
   "index": 2,
   "title": "و نیز:",
   "start": 193.32,
   "end": 265.4
  },
  {
   "index": 3,
   "title": "## توجه؛ از تحقیق تا تحقق",
   "start": 265.4,
   "end": 454.91
  },
  {
   "index": 4,
   "title": "## من عرف نفسه فقد عرف ربه",
   "start": 454.91,
   "end": 823.72
  },
  {
   "index": 5,
   "title": "سطحِ دعوت باید به سوی ربِّ پیامبر بالا رود. همه به سمتِ ربشان در حرکت‌اند:",
   "start": 823.72,
   "end": 956.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.94,
   "end": 8.28,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.28,
   "end": 14.36,
   "text": "عزیزی در صحیفه سجادیه غور کردند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.36,
   "end": 19.1,
   "text": "سؤالاتی رو جنبه تحقیقی البته دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.1,
   "end": 22.98,
   "text": "و پرسیدن چند تا سؤال رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.98,
   "end": 31.54,
   "text": "یکی پیرامون معنای ربوبیت و جایگاه رب نسبت به مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.54,
   "end": 35.2,
   "text": "و نقش توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.2,
   "end": 38.86,
   "text": "عبد به ربوبیت در زندگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.86,
   "end": 40.56,
   "text": "اینها سؤال کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.56,
   "end": 44.7,
   "text": "اولاً بحث شود که رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.7,
   "end": 46.6,
   "text": "به معنای پرورش دهنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.6,
   "end": 48.16,
   "text": "غالباً این چنین فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.16,
   "end": 51.06,
   "text": "مثلاً کسی که در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.06,
   "end": 54.78,
   "text": "پرورش نفوس برمی‌آد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.78,
   "end": 57.38,
   "text": "بهش اصطلاحاً می‌گن مربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.38,
   "end": 61.14,
   "text": "که اون عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.14,
   "end": 67.26,
   "text": "تحت پرورش ایشون هستند مربای ایشون می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.26,
   "end": 74.08,
   "text": "که در حقیقت زیل این اسم شریف که یکی از اسامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.08,
   "end": 80.2,
   "text": "معروف حضرت حق است تمام کائنات در حال پرورش‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.2,
   "end": 85.44,
   "text": "پرورش پیدا می‌کنند. از نقص به کمال آن به آن حرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.44,
   "end": 87.36,
   "text": "هم ظاهرشون هم باطن‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.36,
   "end": 91.88,
   "text": "که حالا علم طبیعی میگه هر هفت سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.88,
   "end": 94.06,
   "text": "بدن انسان سلول‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.06,
   "end": 98.16,
   "text": "نو می‌شن. اما علم الهی میگه آن به آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.16,
   "end": 101.68,
   "text": "بدن، اجزای بدن در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.68,
   "end": 105.44,
   "text": "در حقیقت تبدل امثال‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.44,
   "end": 115.42,
   "text": "و تجدد صور پیدا می‌کنند و در حال تغییر و تبدل و عوض شدن هستند که این پرورش دهنده اون رب مطلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.42,
   "end": 117.32,
   "text": "که لا حول و لا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.32,
   "end": 122.98,
   "text": "إلا بالله العلی العظیم داره این کار رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.98,
   "end": 126.32,
   "text": "یکی از معنای در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.32,
   "end": 129.28,
   "text": "رب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.28,
   "end": 133.08,
   "text": "به ظاهر انسان برمی‌گرده هم به باطن انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.08,
   "end": 138.24,
   "text": "باطن هم دائماً داره از نقص به کمال میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.24,
   "end": 143.36,
   "text": "و اینکه اساساً حرکت جوهری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.36,
   "end": 145.48,
   "text": "انسان همه این کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.48,
   "end": 150.42,
   "text": "حرکت جوهری دارند در کنارشون یکی هم انسان معناش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.42,
   "end": 153.88,
   "text": "چون دائماً داره از نقص به کمال میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.88,
   "end": 157.2,
   "text": "و اشتداد وجودی اصطلاحاً پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.2,
   "end": 161.44,
   "text": "این شدت وجود به جهت وجود پشت وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.44,
   "end": 163.62,
   "text": "اشتداد وجودی میگن. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.62,
   "end": 165.76,
   "text": "چون تحت سیطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.76,
   "end": 168.94,
   "text": "رب است و پرورش دهنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.94,
   "end": 175.2,
   "text": "و رب از اسم رب حضرت حق در قرآن خیلی هم تکرار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.2,
   "end": 180.14,
   "text": "که اساساً مخلوقات منهای رب اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.14,
   "end": 185.62,
   "text": "وجودی ندارند. اصلاً نمیشه بهشون گفت دیگه مخلوقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.62,
   "end": 190.22,
   "text": "نمیشه گفت خلق چون خلق زائده‌ی رب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.22,
   "end": 194.96,
   "text": "در قرآن این حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.96,
   "end": 197.48,
   "text": "بنده به سمت حضرت حق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.48,
   "end": 203.28,
   "text": "زیاد معنا کرده حتی اون عهد الهی رو، عهد الهی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.28,
   "end": 206.42,
   "text": "حالا به یک معنا ولایت است به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.42,
   "end": 210.86,
   "text": "قرآن است به یک معنا عبودیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.86,
   "end": 213.56,
   "text": "به یک معنا همه یک حقیقتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.56,
   "end": 217.7,
   "text": "این‌ها رو همون عهد خودش گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.7,
   "end": 225.4,
   "text": "و فرموده که ألم أعهد إليكم يا بني آدم ألا تعبدوا الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.4,
   "end": 230.3,
   "text": "إنه لكم عدو مبين وأني اعبدوني، وأني اعبدوني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.3,
   "end": 233.02,
   "text": "ببینید منو عبادت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.02,
   "end": 236.12,
   "text": "عهدی که من اینجا عهد عبودیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.12,
   "end": 239.26,
   "text": "عهدی که خدا منظورش این‌جا عبودیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.26,
   "end": 245.12,
   "text": "که در جای دیگه قرآن فرمود و ما خلقت الجن والانس إلا ليعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.12,
   "end": 249.54,
   "text": "حالا ذیلش هم مفسرین فرمودن بر اساس روایات که أو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.54,
   "end": 252.66,
   "text": "أي ليعرفون. این عبودیت همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.66,
   "end": 256.58,
   "text": "معنای معرفت رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.58,
   "end": 264.16,
   "text": "اما بحث اینجاست که اون عهد رو داره به ربوبیت به در حقیقت عبودیت می‌زنه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.16,
   "end": 266.68,
   "text": "بندگی انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.68,
   "end": 270.64,
   "text": "بندگی عبد نسبت به ربش رو عهد گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.64,
   "end": 276.8,
   "text": "حالا این عبودیت رو امام صادق صلی الله علیه ترجمه کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.8,
   "end": 283.58,
   "text": "بازش کردند بسیار ظریف و دقیق و خطیر که فرمودن العبودیه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.58,
   "end": 287.34,
   "text": "اون عبودیت، اون بندگی که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.34,
   "end": 292.52,
   "text": "کائنات دارند که یسبح لله ما في السماوات و ما في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.52,
   "end": 294.66,
   "text": "العبودیه جوهرتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.66,
   "end": 299.38,
   "text": "این یه جوهره‌ای داره که كنها الربوبیه الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.38,
   "end": 305.54,
   "text": "در حقیقت ببینید كنها الربوبیه اسم ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.54,
   "end": 310.36,
   "text": "یعنی حتی اون باطن و كنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.36,
   "end": 313.66,
   "text": "و اون ذات عبودیت هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.66,
   "end": 316.72,
   "text": "در حقیقت خلقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.72,
   "end": 319.96,
   "text": "باز زیل اسم رب تعریف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.96,
   "end": 321.96,
   "text": "یعنی تا پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.96,
   "end": 327.9,
   "text": "او پرورشش نده، او نمی‌تونه عبادت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.9,
   "end": 330.2,
   "text": "لذا باز میگیم لا حول و لا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.2,
   "end": 336.68,
   "text": "إلا بالله. باز میگیم لا مؤثر في الوجود إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.68,
   "end": 340.22,
   "text": "این الله است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.22,
   "end": 345.1,
   "text": "در حقیقت در اسم رب این چنین تجلی می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.1,
   "end": 347.64,
   "text": "که همه خلائق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.64,
   "end": 353.0,
   "text": "پرورش بدهد. مگر اینکه مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.0,
   "end": 361.81,
   "text": "خودشون پشت پا بزنن به این پرورش و بخوان که دور بشوند از حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.81,
   "end": 367.19,
   "text": "در حقیقت توجه به ربوبیت به یک معنا میشه گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.19,
   "end": 376.03,
   "text": "چون انسان در حقیقت انسان تنها موجودی‌ست که به قول از تعلل حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 376.03,
   "end": 384.07,
   "text": "به وزان حضرت حق آفریده شده، آفریده شده هم از حیث صفات، هم ذات هم افعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 384.07,
   "end": 390.33,
   "text": "و چنین کسی است که می‌تواند مثل اعلای حق بشود یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 390.33,
   "end": 395.69,
   "text": "به عبارت مرحوم محی الدین مثل الله هم بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 395.69,
   "end": 397.77,
   "text": "خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 397.77,
   "end": 404.53,
   "text": "از توجه به ربوبیت حضرت حق است که می‌توانند به این مقام برسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 404.53,
   "end": 407.27,
   "text": "توجه، توجه خودش خیلی معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 407.27,
   "end": 412.05,
   "text": "توجه یعنی همون نظره یعنی نگاه عمیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 412.05,
   "end": 415.09,
   "text": "نه فقط نگاه سرسری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 415.09,
   "end": 420.05,
   "text": "نگاه عمیق. نگاهی که ادامه پیدا می‌کنه، محققانه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.05,
   "end": 425.97,
   "text": "بلکه انسان رو از تحقیق به جایی می‌رسونه که متحقq بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.97,
   "end": 430.29,
   "text": "یعنی صفت رب در او پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 430.29,
   "end": 433.55,
   "text": "یعنی خودش هم در طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 433.55,
   "end": 436.47,
   "text": "توحید حضرت حق دیگران رو پرورش بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 436.47,
   "end": 438.69,
   "text": "توجه به ربوبیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 438.69,
   "end": 442.73,
   "text": "اون توجه عرفانی اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.73,
   "end": 447.07,
   "text": "تقرب به همراه خودش میاره، قرب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.07,
   "end": 450.01,
   "text": "این قرب رو به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.01,
   "end": 454.31,
   "text": "فرمودن تلبس یعنی پوشیدن لباس اون اسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.31,
   "end": 458.51,
   "text": "یعنی شما اگر بخواید از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 458.51,
   "end": 462.19,
   "text": "به واسطه اسم رب حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 462.19,
   "end": 468.29,
   "text": "به او نزدیک بشی، لباس رب به تن بپوشی، خودش به یک معنا قرب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.29,
   "end": 472.07,
   "text": "در حقیقت تقرب به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.07,
   "end": 474.71,
   "text": "از توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 474.71,
   "end": 476.97,
   "text": "حضرت شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.97,
   "end": 482.61,
   "text": "که تا جایی توجه انشالله عمیق می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 482.61,
   "end": 485.05,
   "text": "لباس اون اسم رو طرف به تن می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 485.05,
   "end": 488.59,
   "text": "اصلاً به این لباس شناخته می‌شه مثل یکی که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 488.59,
   "end": 496.09,
   "text": "انقدر شاگرداش رو پرورش داده همه مثلاً بزرگ شدن، همه عظمت پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 496.09,
   "end": 500.05,
   "text": "مثل ملا حسین قلی احمدی که سیصد عارف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 500.05,
   "end": 502.69,
   "text": "کمال رو تربیت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.69,
   "end": 505.89,
   "text": "و تلبس در حقیقت تقرب میاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.89,
   "end": 511.95,
   "text": "نزدیکی به الله میاره به سبب قربش به اسم رب یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 511.95,
   "end": 515.17,
   "text": "این که لباس اسم رب رو بپوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 515.17,
   "end": 517.69,
   "text": "و این تقرب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 517.69,
   "end": 521.83,
   "text": "وقتی شدت می‌گیره به، به ولایت می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.83,
   "end": 524.43,
   "text": "ولی ای قرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.43,
   "end": 528.35,
   "text": "اساساً این ولایت همون قرب محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 528.35,
   "end": 532.35,
   "text": "البته باز به صیغه وجودی بستگی داره که هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 532.35,
   "end": 536.21,
   "text": "انسان به حضرت حق نزدیک شد تقرب پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 536.21,
   "end": 539.97,
   "text": "یعنی لباس اسماء الهی به تن کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 539.97,
   "end": 546.21,
   "text": "که و علم آدم الاسماء كلها به همان میزان ولایت می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 546.21,
   "end": 549.11,
   "text": "حالا این که کل اسماء رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.11,
   "end": 553.27,
   "text": "آدم تعلیم کردن، کی تعلیم کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.27,
   "end": 558.75,
   "text": "خدا. علم. یعنی به یک معنا میشه گفت کل ولایت رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 558.75,
   "end": 563.21,
   "text": "آدم بخشید. حالا اینجا مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 563.21,
   "end": 572.25,
   "text": "فرمودن که اون هم بر اساس روایات که این آدم رو آدم کلی و مطلقه باید گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 572.25,
   "end": 583.35,
   "text": "که منظور حضرت ختمی مرتبت هستند صلی الله علیه و آله وسلم که کل ولایت الهی رو، کل تقرب رو، کل اسماء رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 583.35,
   "end": 586.71,
   "text": "برداشتن. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 586.71,
   "end": 589.65,
   "text": "اونجا در حدیث شریف که از تعلل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 589.65,
   "end": 594.89,
   "text": "حسن زاده می‌فرمایند که اگر کل قرآن و روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 594.89,
   "end": 597.39,
   "text": "خلاصه‌اش کنی توی جمله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 597.39,
   "end": 604.69,
   "text": "همون حدیث شریف مولا علی‌ست که از معجزات قولیه مولاست که من عرف نفسه فقط عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.69,
   "end": 608.77,
   "text": "باز می‌فرماید ربه. هر کس جان خودش رو شناخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 608.77,
   "end": 611.97,
   "text": "پروردگارش رو شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 611.97,
   "end": 617.41,
   "text": "اینجا مرحوم حاجی سبزواری علیه رحمة و بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 617.41,
   "end": 621.73,
   "text": "حکمای متعله یعنی حکمایی که عارف هم بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 621.73,
   "end": 624.35,
   "text": "این رب رو به ولایت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 624.35,
   "end": 628.93,
   "text": "چون اگر امام تمام اسماء خدا درش پیاده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 628.93,
   "end": 632.31,
   "text": "پس یکی از اسماء امام باز ربه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 632.31,
   "end": 637.97,
   "text": "از اون صد وجهی که از تعلل بر این حدیث شریف آوردن یکیش اصلاً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 637.97,
   "end": 640.73,
   "text": "یعنی هرکس که جان خودش رو شناخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 640.73,
   "end": 643.67,
   "text": "نفسش رو شناخت فقط عرف ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 643.67,
   "end": 646.93,
   "text": "یعنی امامش رو فقط عرف امامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 646.93,
   "end": 654.77,
   "text": "امامش رو شناخت. در حقیقت امام پرورش دهنده است در طول حضرت حق در طول توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 654.77,
   "end": 657.41,
   "text": "چون ما منظورمون توحید صمدی‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 657.41,
   "end": 662.09,
   "text": "نه یک امام جدا به وجود استقلالی از خدا، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 662.09,
   "end": 667.95,
   "text": "اساساً در قرآن خیلی توسل و تمسک شده به اسم رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 667.95,
   "end": 672.27,
   "text": "تا جایی که اون اولین آیه هم که در سوره علق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 672.27,
   "end": 675.77,
   "text": "خدا به پیغمبرش در تنزل تدریجی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 675.77,
   "end": 678.61,
   "text": "نه انزال دفعی و به یک باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 678.61,
   "end": 682.85,
   "text": "در اون بیست و سه سال تنزیل قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 682.85,
   "end": 688.33,
   "text": "خدا امر می‌کنه به پیغمبرش که بخوان، خدا تو پروردگار تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 688.33,
   "end": 694.77,
   "text": "باز ببین اسم رب میاد که اقرأ باسم ربک الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 694.77,
   "end": 697.79,
   "text": "جالبه که چه ربی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 697.79,
   "end": 702.27,
   "text": "کدوم رب تو؟ الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 702.27,
   "end": 707.87,
   "text": "کآنه اساساً این ربوبیت خلق رو با خودش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 707.87,
   "end": 710.83,
   "text": "لذا توجه به ربوبیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 710.83,
   "end": 713.53,
   "text": "در زندگی مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 713.53,
   "end": 719.39,
   "text": "چنان تأثیری داره که اگر این توجه نباشه خلق پاش می‌لنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 719.39,
   "end": 722.35,
   "text": "چون پرورش الهی برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 722.35,
   "end": 725.62,
   "text": "در هر حیثیت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 725.62,
   "end": 727.72,
   "text": "شؤون مختلف زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 727.72,
   "end": 731.58,
   "text": "خلق نیاز هست که تحت پرورش رب باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 731.58,
   "end": 734.46,
   "text": "لذا میگه اونم رب خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 734.46,
   "end": 737.04,
   "text": "میگه \"اقرأ باسم ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 737.04,
   "end": 740.22,
   "text": "الذي خلق\" پروردگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 740.22,
   "end": 746.48,
   "text": "که یعنی هر کسی هر مقدار که تو به طرف رب بی، رب هم به طرف توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 746.48,
   "end": 749.02,
   "text": "یعنی از ضیغ به صع بیا بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 749.02,
   "end": 753.0,
   "text": "تعال. رشد بده به خودت رو که خدا فی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 753.0,
   "end": 755.64,
   "text": "فیاض علی الاطلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 755.64,
   "end": 758.14,
   "text": "مطلقا بخل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 758.14,
   "end": 760.02,
   "text": "وجود عین جوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 760.02,
   "end": 763.66,
   "text": "بخششش آن به آن در حال ریزشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 763.66,
   "end": 767.72,
   "text": "دیگه یکی پیاله اندازه پیاله است وجودش پیاله ای برمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 767.72,
   "end": 771.56,
   "text": "یکی دریاست دریا دریاست همینطور برمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 771.56,
   "end": 775.32,
   "text": "که حالا اونجا در قرآن باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 775.32,
   "end": 778.06,
   "text": "ااا خدا به پیغمبرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 778.06,
   "end": 782.68,
   "text": "امر میکنه که \"ادعو الى سبيل ربک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 782.68,
   "end": 787.38,
   "text": "باز میگه که تو سطح دعوتت رو ادعو دعوتت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 787.38,
   "end": 790.34,
   "text": "در مسیر من ببر بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 790.34,
   "end": 793.74,
   "text": "ربک به سمت پروردگار خودت اینا رو بکشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 793.74,
   "end": 800.0,
   "text": "با چی؟ بالحكمة والموعظة الحسنة وجادلهم بالتي هي أحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 800.0,
   "end": 802.98,
   "text": "باز میبینید که میگه ربک پروردگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 802.98,
   "end": 807.18,
   "text": "یعنی سطح دعوت رو چنان بالا برده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 807.18,
   "end": 811.96,
   "text": "که تمام مخلوقات رو در نهایت با خودت پیغمبر باید بکشونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 811.96,
   "end": 813.58,
   "text": "به سمت کی؟ ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 813.58,
   "end": 819.08,
   "text": "پروردگار خودت. اساسا همه به سمت ربشون در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 819.08,
   "end": 822.1,
   "text": "يا ايها الانسان انك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 822.1,
   "end": 827.78,
   "text": "كادحٌ. کادح یعنی رونده به همراه سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 827.78,
   "end": 830.88,
   "text": "قطعاً تو رونده به همراه سختی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 830.88,
   "end": 833.28,
   "text": "به چه سمتی؟ الى ربك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 833.28,
   "end": 837.92,
   "text": "سمت پروردگارت. چرا به سمت پروردگارت با سختی میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 837.92,
   "end": 841.58,
   "text": "اونم دوباره تاکید میکنه کادحٌ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 841.58,
   "end": 844.88,
   "text": "دوباره میگه با سختی فملاقي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 844.88,
   "end": 847.1,
   "text": "چون قراره ملاقات کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 847.1,
   "end": 849.5,
   "text": "ملاقات کنی کیو؟ ربت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 849.5,
   "end": 854.7,
   "text": "پروردگارت رو. که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 854.7,
   "end": 863.12,
   "text": "توجهش رو از پرورش دهنده خودش یعنی ربش برداره بی‌توجه باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 863.12,
   "end": 868.98,
   "text": "این اگرچه داره به ملاقات او میره اما آمادگی ملاقات نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 868.98,
   "end": 873.12,
   "text": "لذا نگرش میدارن توی پستویی، توی جایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 873.12,
   "end": 875.32,
   "text": "حالا اصطلاحا اول بهش میگن برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 875.32,
   "end": 877.04,
   "text": "بعد میگن قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 877.04,
   "end": 880.28,
   "text": "بعد میگن آخرت. تازه پنجاه موقف قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 880.28,
   "end": 883.38,
   "text": "همینطور نگرش میدارن تا آمادگی ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 883.38,
   "end": 885.88,
   "text": "اون نگه داشتن ها میشه ضیغ میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 885.88,
   "end": 889.72,
   "text": "عذاب میشه سختی. تو دنیا هم همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 889.72,
   "end": 895.08,
   "text": "توی دنیا هر مقدار که دور از رب بشه سختی میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 895.08,
   "end": 898.32,
   "text": "تا جایی که قرآن میفرماید من أعرض عن ذكري.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 898.32,
   "end": 901.72,
   "text": "این ذكري ذکر من یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 901.72,
   "end": 904.02,
   "text": "یعنی من پروردگار تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 904.02,
   "end": 912.52,
   "text": "ربك. فإن له معيشة ضنكا ونحشره يوم القيامة أعمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 912.52,
   "end": 916.88,
   "text": "هم زن که معیشت در دنیا پیدا میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 916.88,
   "end": 919.22,
   "text": "هم قیامت کور محشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 919.22,
   "end": 923.58,
   "text": "اگرچه به فملاقي قطعا همه میرسن ملاقات کنن اما کوره نمیبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 923.58,
   "end": 925.7,
   "text": "نمیفهمه کیو داره ملاقات میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 925.7,
   "end": 929.0,
   "text": "انقدر خطرناکه. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 929.0,
   "end": 931.5,
   "text": "عدم توجه به رب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 931.5,
   "end": 935.12,
   "text": "کوری قیامت، زank معیشت دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 935.12,
   "end": 938.92,
   "text": "اما توجه به رب تعالو داره تو خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 938.92,
   "end": 945.34,
   "text": "سطح دعوت رو برده بالا تا جایی که به بالاترین مراتب توحید برسونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 945.34,
   "end": 948.64,
   "text": "به بالاترین مراتب ولایت برسونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 948.64,
   "end": 951.94,
   "text": "خب این خیلی مهمه دیگه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 951.94,
   "end": 954.04,
   "text": "توجه داشته باشه به ربش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 954.04,
   "end": 956.08,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}