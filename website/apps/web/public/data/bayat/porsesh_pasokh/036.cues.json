 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله و بالله و علی ملّة رسول الله. المستغاث بک یا حجّة الله.",
   "start": 0.76,
   "end": 204.76
  },
  {
   "index": 1,
   "title": "## اگر مزاحمِ تفهّم باشد: تقویتِ حوزهٔ نظر",
   "start": 204.76,
   "end": 249.34
  },
  {
   "index": 2,
   "title": "## اگر صورِ زشت آورد: اشک، توسل، بستنِ حواس",
   "start": 249.34,
   "end": 399.84
  },
  {
   "index": 3,
   "title": "## سه شرطِ علّامه در طهارتِ نفس",
   "start": 399.84,
   "end": 515.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 3.74,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 7.58,
   "text": "المستغاث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.58,
   "end": 11.8,
   "text": "برا خصوص این سوالی که بعضی گفتن ما دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.8,
   "end": 16.26,
   "text": "خیالات آلوده و توهمات عجیب و غریب هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.26,
   "end": 22.52,
   "text": "و حالا اوم از هر چیز کوچکی متوهم می‌شیم، متخیل می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.52,
   "end": 26.82,
   "text": "و اذیت می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.82,
   "end": 29.9,
   "text": "و این بعضی از صحبت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.9,
   "end": 32.42,
   "text": "درون کانال رو که شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.42,
   "end": 36.24,
   "text": "متوهم شدیم. حالا تستی‌هاش به ما دست داده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.24,
   "end": 39.98,
   "text": "چه کنیم که مثلاً استاد گفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.98,
   "end": 44.88,
   "text": "اِاِاِ-- حتی علامه حسن زاده فرمودن که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.88,
   "end": 48.06,
   "text": "تا قوه خیال پاک نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.06,
   "end": 52.8,
   "text": "انسان نمی‌تونه به اون حقایق برسه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.8,
   "end": 58.5,
   "text": "عرض کنم که ببینید همونطور که در بعضی از پاسخ به بعضی از سوالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.5,
   "end": 61.64,
   "text": "اوم بنده حقیر عرض کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.64,
   "end": 65.48,
   "text": "تطهیر قوای وجود خصوصاً قوه خیال کار چندین ساله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.48,
   "end": 67.18,
   "text": "کار یک ساله و دو ساله و این‌ها نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.18,
   "end": 73.24,
   "text": "این کار یک اوه همت مردانه چندین ساله و یک عمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.24,
   "end": 76.08,
   "text": "بالاخره همه ما وقتی که بارون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.08,
   "end": 83.9,
   "text": "از سطح این هوا رد می‌شه می‌خواد بیاد مثلاً به همین تهران خودمون چقدر آلودگی با خودش می‌گیره میاد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.9,
   "end": 87.14,
   "text": "در غوص نزول نال الله که اومدیم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.14,
   "end": 91.18,
   "text": "پاک پاک اومدیم. اما از همون صلب و رحم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.18,
   "end": 95.88,
   "text": "دیگه بعد خوردن‌ها و چشیدن‌ها و دیدن‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.88,
   "end": 100.6,
   "text": "شنیدن‌ها و این‌ها نفس‌ها و این‌ها هرچی که از پدر، مادر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.6,
   "end": 103.98,
   "text": "نزدیکان، دور و بریا و اینا هی آلودگی‌ها رو آورد با خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.98,
   "end": 108.32,
   "text": "دیگه آلودگی پشت آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.32,
   "end": 112.42,
   "text": "در همه هم هست. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.42,
   "end": 115.02,
   "text": "وقتی که-- اولاً وقتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.02,
   "end": 119.18,
   "text": "خیالات و توهمات، این تخیلات و توهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.18,
   "end": 122.1,
   "text": "منجر به وسواس بشه، وسوسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.1,
   "end": 126.36,
   "text": "قطعاً از شیطانه و راهش هم قبلاً توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.36,
   "end": 130.44,
   "text": "با توجه به مضامین بلند آیات و روایات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.44,
   "end": 134.3,
   "text": "فرمایش بزرگان هیچ راهی جز بی‌توجهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.3,
   "end": 136.32,
   "text": "شیطان متکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.32,
   "end": 139.76,
   "text": "با متکبر هم باید متکبرانه رفتار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.76,
   "end": 144.68,
   "text": "وسواس، وسوسه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.68,
   "end": 147.96,
   "text": "همش از شیطانه و ما باید بی‌توجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.96,
   "end": 150.52,
   "text": "کاملاً بی‌توجهی کنیم به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.52,
   "end": 155.1,
   "text": "اصلاً انگار وجود ندارن. راهی غیر از این نیست تا گورشون رو گم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.1,
   "end": 158.66,
   "text": "اما وقتی این تخیلات و توهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.66,
   "end": 162.28,
   "text": "مزاحم تمرکز ما باشه، یعنی مزاحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.28,
   "end": 166.42,
   "text": "این باشه که ما نمی‌تونیم متمرکز بشیم توی یک موضوعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.42,
   "end": 169.7,
   "text": "اینجا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.7,
   "end": 175.92,
   "text": "دست به دامن ذکر لا اله الا الله بشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.92,
   "end": 183.64,
   "text": "تا اونجایی که می‌تونید. لبتون تر باشه البته با توجه، با توجه عرفانی لا اله الا الله بگید هر مقدار که می‌تونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.64,
   "end": 186.76,
   "text": "بعد از چند، چند وقت حالا نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.76,
   "end": 190.38,
   "text": "میزان آلودگی قوه خیال یا وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.38,
   "end": 193.34,
   "text": "این برطرف می‌شه. ما داشتیم بعضی از جوون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.34,
   "end": 199.6,
   "text": "به قدری تفکرات عجیبی داشتن که مثلاً خودشونو می‌زدن به خاطر این خیالات عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.6,
   "end": 204.76,
   "text": "ولی به جهت مثلاً یک سال مداومت بر این ذکر نجات پیدا کردن، خلاص شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.76,
   "end": 207.62,
   "text": "اگر تخیلات و توهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.62,
   "end": 209.78,
   "text": "منجر به عدم فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.78,
   "end": 214.02,
   "text": "یعنی در تفهم انسان مشکل ایجاد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.02,
   "end": 219.04,
   "text": "هیچ راهی جز تفکر عمیق در کلمات وجودی نظام هستی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.04,
   "end": 222.64,
   "text": "یعنی در حقیقت تو حوزه نظر باید تلاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.64,
   "end": 225.74,
   "text": "اگر مزاحم تفهمه برعکس باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.74,
   "end": 229.52,
   "text": "یعنی مزاحم شما حوزه نظرت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.52,
   "end": 234.46,
   "text": "در حقیقت حکمت نظریت و عرفان نظریت رو، یادگیریتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.46,
   "end": 236.12,
   "text": "زیاد کن. زیاد کتاب بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.12,
   "end": 240.04,
   "text": "زیاد پای مجالس علما برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.04,
   "end": 242.76,
   "text": "زیاد درس و بحث بگیر. زیاد این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.76,
   "end": 245.06,
   "text": "اهل تحقیق و تفحص و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.06,
   "end": 249.34,
   "text": "تدقق و تحقق این‌ها باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.34,
   "end": 252.48,
   "text": "اگر منجر به خیالات آلوده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.48,
   "end": 257.96,
   "text": "یعنی اصلاً اشکال و صور خیلی زشت تو فکر انسان بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.96,
   "end": 263.72,
   "text": "اینجا چند تا راه باید با هم انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.72,
   "end": 266.86,
   "text": "مهم‌ترینش اشک، اشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.86,
   "end": 268.84,
   "text": "اشک پاکی عجیبی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.84,
   "end": 274.26,
   "text": "منتها نه هر اشکی. اولاً اشک بر امام حسین صلی الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.26,
   "end": 278.1,
   "text": "به شدت تطهیر قوای وجود میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.1,
   "end": 280.54,
   "text": "و خوف خدا در دل شب این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.54,
   "end": 284.16,
   "text": "یعنی مناجات، اشک این‌ها خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.16,
   "end": 289.46,
   "text": "در پی‌ش توسل به اهل بیت خاصه به مقام عصمت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.46,
   "end": 296.9,
   "text": "عصمت الله الكبرى حضرت صدیقه طاهره توی این موضوع توسل به حضرت صدیقه طاهره سلام الله علیها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.9,
   "end": 298.78,
   "text": "گفتن صاحب این سؤال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.78,
   "end": 302.04,
   "text": "یه همچین دعبی داشته خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.04,
   "end": 305.18,
   "text": "هم از استغاثه به حضرت زهرا سلام الله علیها توسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.18,
   "end": 307.46,
   "text": "مداومت کنه تو این توسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.46,
   "end": 310.9,
   "text": "در کنار-- تاکید می‌کنم این به تنهایی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.9,
   "end": 314.7,
   "text": "در کنار بستن حاسه ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.7,
   "end": 319.54,
   "text": "یعنی حواس ظاهری، اون پنج تا حواس رو کاملاً مراقبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.54,
   "end": 321.44,
   "text": "محاسبه کنه شبا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.44,
   "end": 325.56,
   "text": "در روز مراقبه کنه. خودشو موعظه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.56,
   "end": 329.22,
   "text": "معاriebe کنه. البته اول مشارطه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.22,
   "end": 333.38,
   "text": "برای خودش شروطی رو تنظیم کنه، مراقبت کنه، شب محاسبه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.38,
   "end": 339.48,
   "text": "بعد معاriebe و موعظه کنه، عتاب کنه خودشو، سرزنش کنه، برای خودش تنبیه قرار بده که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.48,
   "end": 346.44,
   "text": "این راه پنج تا راه نفوذ به باطن مطلقا آلودگی وارد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.44,
   "end": 348.68,
   "text": "اول-- یعنی باید این راه رو بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.68,
   "end": 350.94,
   "text": "چشم رو بست. چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.94,
   "end": 354.22,
   "text": "خدا پلک بهش داده ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.22,
   "end": 356.76,
   "text": "دهان خدا فن داده ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.76,
   "end": 360.12,
   "text": "دهان رو ببند. به هر حال این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.12,
   "end": 362.08,
   "text": "منافذ ورودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.08,
   "end": 367.42,
   "text": "گوش باید عادت کنه به شنیدن صوت احسن که قبلاً بحثش گذشته چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.42,
   "end": 371.34,
   "text": "بهترین صوت احسن صوت وجودی خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.34,
   "end": 378.24,
   "text": "خودت در خلوتت با اون لحنی که به دل خودت می‌شینه شروع کنی قرآن خوندن، دعا خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.24,
   "end": 381.0,
   "text": "اصلاً همین با لو-- لسان خودت با خدا حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.0,
   "end": 385.06,
   "text": "اینا خیلی تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.06,
   "end": 387.82,
   "text": "به هر حال حواس ظاهری، شامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.82,
   "end": 392.94,
   "text": "ذائقه، بصره، سامعه، لامسه اینا حفظ بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.94,
   "end": 398.42,
   "text": "و در حفظ این‌ها هم کاملاً انسان مراقب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.42,
   "end": 402.64,
   "text": "و در کل، در کل حضرت علامه در کتاب طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.64,
   "end": 406.58,
   "text": "نفسشون که توصیه می‌شه در کنار کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.58,
   "end": 410.62,
   "text": "معرفت نفس ایشون، کتاب طهارت نفسشون هم حتما خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.62,
   "end": 416.68,
   "text": "بارها عرض کردیم فرمودن تطهیر قوه خیال به سه چیز بستگی داره مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.68,
   "end": 419.0,
   "text": "یکی اینکه عقاید پاکسازی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.0,
   "end": 422.66,
   "text": "یعنی حوزه نظر. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.66,
   "end": 427.3,
   "text": "حکمت نظری، عرفان نظری اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.3,
   "end": 431.28,
   "text": "عقاید درست بشه. عقایق رو، عقاید رو تصفیه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.28,
   "end": 435.78,
   "text": "اون می‌شه گفت علوم و معارفی که انسان پیش می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.78,
   "end": 441.0,
   "text": "درست باشه، متصل به منبع وحی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.0,
   "end": 449.58,
   "text": "و نکته بعدی اینکه مطلقا سوءظن برداشته بشه، کاملا خوشبینانه رفتار کنه، حسن ظن به خرج بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.58,
   "end": 453.96,
   "text": "به همه و به قول ابا عبدالله صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.96,
   "end": 457.06,
   "text": "اصلاً ادب اینه که از خونه که خارج می‌شی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.06,
   "end": 462.86,
   "text": "خودتو از همه بدتر بدونی، همه رو از خودت بهتر که کار سختی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.86,
   "end": 469.0,
   "text": "و نکته سوم اینکه آرزوها، آرزوها و آمال طولانی اینا باید برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.0,
   "end": 472.3,
   "text": "انسان کلاً قطع علاقه از دنیا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.3,
   "end": 475.7,
   "text": "حبش رو از دنیا بکنه، از مظاهر دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.7,
   "end": 478.6,
   "text": "و متوجه آخرت بشه. این آرزوها مانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.6,
   "end": 483.22,
   "text": "تطهیر قوای وجودی خصوصاً قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.22,
   "end": 487.0,
   "text": "این کار توأمان این چیزی که عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.0,
   "end": 493.6,
   "text": "خیلی هم زمان می‌بره همونطور که قبلاً عرض کردیم بعضیا بیست ساله، بعضیا سی ساله، بعضیا چهل ساله جواب گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.6,
   "end": 498.18,
   "text": "اما بالاخره رسیدن. مهمه که در مسیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.18,
   "end": 501.62,
   "text": "زمان می‌بره. به قول علامه عجله نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.62,
   "end": 505.82,
   "text": "در تعلیم عجله کنیم اما در نتیجه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.82,
   "end": 510.84,
   "text": "هرچی دیرتر بهمون بدن به قول علامه پخته‌تریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.84,
   "end": 513.78,
   "text": "انشاالله که خدای منان دست هممون رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.78,
   "end": 515.52,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}