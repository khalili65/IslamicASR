 },
 "chapters": [
  {
   "index": 0,
   "title": "## شبههٔ وحشی بودن دین",
   "start": 1.5,
   "end": 40.24
  },
  {
   "index": 1,
   "title": "## جسارت به ضریح و فقها",
   "start": 40.24,
   "end": 424.25
  },
  {
   "index": 2,
   "title": "## فرهنگ اهل‌بیت و زیارت",
   "start": 424.25,
   "end": 607.25
  },
  {
   "index": 3,
   "title": "## آستان قدس و خدمات عینی",
   "start": 607.25,
   "end": 627.99
  },
  {
   "index": 4,
   "title": "## فقه نذر و اتهام استعماری",
   "start": 627.99,
   "end": 975.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.5,
   "end": 5.76,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.76,
   "end": 8.68,
   "text": "المستغاث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.68,
   "end": 13.26,
   "text": "یه قطعه فیلمی پخش شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.26,
   "end": 18.08,
   "text": "حالا متاسفانه یه کسی در لباس روحانیت و ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.08,
   "end": 25.1,
   "text": "وجیه المنظر مطالب ناشایستی رو پیرامون دین ائمه اطهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.1,
   "end": 27.3,
   "text": "اینها بیان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.3,
   "end": 30.62,
   "text": "دوستان خواستن بنده حقیر یه جوابیه ای داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.62,
   "end": 34.42,
   "text": "اگرچه هر صاحب عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.42,
   "end": 36.82,
   "text": "فهم انسان فهیمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.82,
   "end": 42.7,
   "text": "متوجه زشتی این قبیل صحبت‌ها و بی پایه و اساس بودنش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.7,
   "end": 48.38,
   "text": "حالا چون دوستان تقاضا کرده بودند بنده حقیر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.38,
   "end": 53.34,
   "text": "انجام وظیفه می‌کنم. اولا ایشون بحث‌های تربیتی مطرح می‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.34,
   "end": 55.54,
   "text": "وصلش می‌کنند به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.54,
   "end": 60.26,
   "text": "دین گاهی اوقات می‌بینید دین انسان رو وحشی میکنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.26,
   "end": 62.38,
   "text": "این دینی که ما داریم وحشی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.38,
   "end": 66.14,
   "text": "اولا این بخش صحبت ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.14,
   "end": 74.66,
   "text": "کاملاً مغایر با آیات الهی همونطور که میدونید \"إن الدين عند الله الإسلام\" دین نزد حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.66,
   "end": 79.18,
   "text": "آل اسلام است و آنچه که از طرف حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.18,
   "end": 84.34,
   "text": "به رسولانش ابلاغ شده و اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.34,
   "end": 94.48,
   "text": "بیان کردن \"إنه ولا وحي يوحى\" هیچ چیزی نیست مگر اینکه وحی است و از سمت حضرت حق است و یک بسته ای است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.48,
   "end": 97.32,
   "text": "پیرامون سعادت دنیا و آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.32,
   "end": 103.88,
   "text": "و اگر بخواهیم بگیم منظور ایشون این دینی است که داره پیاده میشه به اسم دین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.88,
   "end": 109.96,
   "text": "خب ایشون باید تمیز قائل بشه باید بیان بکنه کسی که در لباس دینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.96,
   "end": 112.24,
   "text": "نباید بیاد این چنین دین رو تخریب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.24,
   "end": 114.64,
   "text": "خود شما در لباس دین قرار داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.64,
   "end": 117.64,
   "text": "بعد میگی دین انسان رو وحشی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.64,
   "end": 121.02,
   "text": "در صورتی که دین سراسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.02,
   "end": 124.52,
   "text": "همه اوامر و نواهییش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.52,
   "end": 129.66,
   "text": "بابت سعادت دنیوی و اخروی انسان‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.66,
   "end": 132.8,
   "text": "و این یه تخریب چهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.8,
   "end": 136.56,
   "text": "دین است. که البته دین را اگر شما بخواهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.56,
   "end": 142.1,
   "text": "معنای حکمت فلسفیش رو به طور دقیق بخواهید بررسی کنید، همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.1,
   "end": 149.54,
   "text": "پنهانی و ضمیر میشه گفت اون فطرتي است که در درون هر کسی است و خداجوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.54,
   "end": 153.74,
   "text": "که \"فطرت الله التي فطر الناس عليها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.74,
   "end": 158.22,
   "text": "و هر کسی در درون خودش ما فض ضمیرشون سره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.22,
   "end": 160.44,
   "text": "سر و سر وجودش و حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.44,
   "end": 166.74,
   "text": "وجودیش که ارتباط اون کانال وجودیش که ارتباط داره با دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.74,
   "end": 170.0,
   "text": "الوهیت نظام هستی اون دینشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.0,
   "end": 172.84,
   "text": "که اسم اعظم هر کسی است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.84,
   "end": 176.0,
   "text": "هر کسی رو به سمت حق میکشاند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.0,
   "end": 179.66,
   "text": "و \"و إن الیه راجعون\" رخ بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.66,
   "end": 185.56,
   "text": "اما بعد ایشون میاد جسارتی میکنه در خصوص ضریح اهل بیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.56,
   "end": 193.58,
   "text": "حالا این بارگاه‌هایی که این چنین با عظمت برافراشته شده و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.58,
   "end": 198.76,
   "text": "که خیلی با کلمات خیلی زشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.76,
   "end": 201.88,
   "text": "متاسفانه اولا میگن که ما یک فقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.88,
   "end": 207.18,
   "text": "فقیه مثلا یک عالم، یک فقیه ماهری که شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.18,
   "end": 211.76,
   "text": "شجاعت اینو داشته باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.76,
   "end": 219.54,
   "text": "بگه این کمک رسانی و پول ریختن تو ضریح‌ها و بارگاه اهل بیت و این نذر و نذورات حرامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.54,
   "end": 223.06,
   "text": "نداریم. یک فقیه ماهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 223.06,
   "end": 227.5,
   "text": "که شهامت داشته باشه. خب اینم یک جسارتی است به علما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 227.5,
   "end": 230.84,
   "text": "فقها و بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.84,
   "end": 234.1,
   "text": "که وقتی اینها جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.1,
   "end": 239.34,
   "text": "فراعنه زمان مستبدین زمان می‌ایستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.34,
   "end": 242.52,
   "text": "عین شهامته و عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.52,
   "end": 244.26,
   "text": "جسارت بالاشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.26,
   "end": 250.74,
   "text": "و این عین فهم دقیق و به روزشون از دینه که دین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.74,
   "end": 253.74,
   "text": "در هر عصری از معاصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.74,
   "end": 257.24,
   "text": "به بهترین وجه ممکن نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.24,
   "end": 260.38,
   "text": "از منه و امکنه پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.38,
   "end": 264.82,
   "text": "در حالی که ایشون میاد خط بطلان میکشه رو همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.82,
   "end": 267.4,
   "text": "فق‌هامون که نه ماهren،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.4,
   "end": 270.02,
   "text": "نه شهامت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.02,
   "end": 273.64,
   "text": "اینم یک جسارتیست به همه فق‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.64,
   "end": 277.58,
   "text": "و حالا چرا شهامت ندارن از نگاه ایشون فق‌های ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.58,
   "end": 283.4,
   "text": "به جهت اینکه نیومدن بگن کمک کردن و پول ریختن تو ضریح‌ها و اینا حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.4,
   "end": 286.78,
   "text": "بعد خیلی عجیب‌تر از اون اینکه تأویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.78,
   "end": 291.54,
   "text": "آیه \"يسدون عن سبيل الله\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.54,
   "end": 297.6,
   "text": "میاد \"سد عن سبيل الله\" رو بیان میکنه تأویلش رو میزنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.6,
   "end": 300.02,
   "text": "همین کمک کردن به حرم‌های اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.02,
   "end": 305.8,
   "text": "که حالا ما کأنّ حالا ایشون میگه که این همه ما فقیر داریم، بیچاره داریم، مشکل‌دار داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.8,
   "end": 307.74,
   "text": "بعد بیایم مثلا پول بریزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.74,
   "end": 311.22,
   "text": "بعد با یک عبارات زشت و سخیفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.22,
   "end": 313.68,
   "text": "که مثلا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.68,
   "end": 317.1,
   "text": "پولمون رو بمالونیم به پشت بوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.1,
   "end": 319.0,
   "text": "امام حسین علیه السلام یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.0,
   "end": 323.1,
   "text": "بریزیم تو این سوراخ سنبه‌های ضریح و این حرفای زشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.1,
   "end": 329.5,
   "text": "که حالا کأنَّ تمام مشکلات جهان اسلام حل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.5,
   "end": 331.72,
   "text": "هیچ معضل و مشکلی ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.72,
   "end": 337.56,
   "text": "تنها مشکل ما فقط و فقط همینه که مردم میرن پول میریزن تو این ضریح‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.56,
   "end": 341.96,
   "text": "انقدر انسان متاسفانه کوته فکر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.96,
   "end": 346.04,
   "text": "و آب بریزه به آسیاب دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.04,
   "end": 351.7,
   "text": "و اولا \"فمن يعظم شعائر الله فانها من تقى القلوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.7,
   "end": 357.4,
   "text": "صریح آیه قرآن می‌فرماید هر کسی که شعائر الهی رو تعظیم کنه این از تقوای علم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.4,
   "end": 361.63,
   "text": "و چه شعائری بالاتر از حرم‌های اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.63,
   "end": 366.47,
   "text": "قرآن حتی اون ابل و اون شترهایی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.47,
   "end": 375.53,
   "text": "بار و بنه حاجیان سوارش میشن، اینا بار و بنه‌شون رو سوارش می‌کنن تا ببرن به سمت حجر، اونو شعائر الهی می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.53,
   "end": 380.37,
   "text": "چه برسه به جایگاهی که نشان از اهل بیت دارد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.37,
   "end": 384.59,
   "text": "بدن پاک و مطهر و عرشی اهل بیت اونجا آرمیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.59,
   "end": 388.19,
   "text": "و پیغمبر عزیز عالم فرمود حق منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.19,
   "end": 391.65,
   "text": "پیغمبره از حقوق من بر امت اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.65,
   "end": 394.71,
   "text": "که اون‌ها دائماً به زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.71,
   "end": 399.81,
   "text": "ذریه من و اهل بیت من بعد از شهادتشون حتی بروند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.81,
   "end": 402.09,
   "text": "و این از حقوق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.09,
   "end": 405.23,
   "text": "حقوق پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.23,
   "end": 409.09,
   "text": "بر گردن امت زیارت فرزندانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.09,
   "end": 413.05,
   "text": "و ایشون میگه که کمک نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.05,
   "end": 417.97,
   "text": "حالا مثلاً چه اشکالی داره گنبد حضرت معصومه سلام الله علیها خشت و گلی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.97,
   "end": 421.09,
   "text": "حتما باید طلا ببری بمالونی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.09,
   "end": 424.05,
   "text": "مثلاً حرم ایشون. از این حرفای زشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.05,
   "end": 426.91,
   "text": "من سؤال می‌کنم که اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.91,
   "end": 433.05,
   "text": "چه کسی سردمدار نجات فقرا و محرومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.05,
   "end": 436.97,
   "text": "و چه کسی پیشتاز کمک به مستضعفینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.97,
   "end": 439.85,
   "text": "طی ادوار روزگار بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.85,
   "end": 444.67,
   "text": "جز این خانواده؟ آیا بهتر از این خانواده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.67,
   "end": 448.99,
   "text": "اینکه به فکر فقرا و مستمندان باشن سراغ دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.99,
   "end": 454.19,
   "text": "تا جایی که بگه بفرما انما نطعمکم لوجه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.19,
   "end": 458.01,
   "text": "لا نرید منکم جزاء اول و شکورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.01,
   "end": 463.81,
   "text": "ما این سه شبی که افطار نکردیم افطار خودمونو دادیم به شما فقط برای رضای خدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 463.81,
   "end": 467.13,
   "text": "احدی هم از شما توقعی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.13,
   "end": 471.05,
   "text": "این ببینید فرهنگ این خانواده چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.05,
   "end": 475.39,
   "text": "خب هر چقدر که شما به این خانواده نزدیک بشید به زیارتشون برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.39,
   "end": 479.07,
   "text": "زیارت هم که یعنی حضور ظاهر عند المظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 479.07,
   "end": 484.35,
   "text": "حاضر شدن ظاهر نزد زیارت شونده می‌شود زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.35,
   "end": 489.03,
   "text": "وقتی حاضر میشی المجالسه مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.03,
   "end": 492.37,
   "text": "همنشینی با او در تو تأثیر میگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.37,
   "end": 495.71,
   "text": "و او فرهنگش به تو القاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.71,
   "end": 501.39,
   "text": "پیدا میکنه و منتقل میشه و تو هم دوست داری مثل اون‌ها زندگی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.39,
   "end": 505.35,
   "text": "و بالاخره وقتی میری به زیارت اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.35,
   "end": 512.31,
   "text": "از معرفت اون‌ها در حرم‌ها با این همه مراسم‌ها و برنامه‌هایی که هست نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.31,
   "end": 521.67,
   "text": "و مناسبت‌ها، سخنرانی‌ها، جلسات معارفی، نشست و برخاست‌ها که در این حرم‌ها صورت می‌گیره انتقال معارف هم رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 521.67,
   "end": 528.83,
   "text": "می‌شنوی که مثلاً امام رضا صلوات الله علیه که به زیارتش میری به پسرش امام جواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 528.83,
   "end": 533.89,
   "text": "صلوات الله علیه فرمود که پسرم شنیدم از در پشتی می‌برنت بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 533.89,
   "end": 536.47,
   "text": "که فقرا و مستمندان اونا نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 536.47,
   "end": 539.33,
   "text": "در حالی که تو از دری بیا بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 539.33,
   "end": 546.31,
   "text": "حرف اونا رو گوش نده از دری بیا بیرون که فقرا و مردم اونا تجمع کردن و جیبت هم پر کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.31,
   "end": 551.09,
   "text": "که وقتی برخورد می‌کنی به مردم به اون‌ها هبه بدی کمک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 551.09,
   "end": 557.59,
   "text": "خب شما وقتی این معرفت را از امام اخذ می‌کنی تو هم در مسیر او حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 557.59,
   "end": 562.37,
   "text": "ضمن اینکه این دو هر دو باید با هم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 562.37,
   "end": 567.19,
   "text": "هم تعظیم شعائر یعنی رسیدگی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 567.19,
   "end": 570.37,
   "text": "حرم‌های اهل بیت علیهم الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 570.37,
   "end": 576.03,
   "text": "که بهترین جایگاه خدمت به انسانیت و انسان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 576.03,
   "end": 578.59,
   "text": "و بهترین جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 578.59,
   "end": 580.89,
   "text": "علم و معرفت و آگاهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 580.89,
   "end": 585.19,
   "text": "بهترین جایگاه سعادت دنیوی و اخروی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.19,
   "end": 587.75,
   "text": "هم رسیدگی به اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 587.75,
   "end": 590.57,
   "text": "لازمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 590.57,
   "end": 593.99,
   "text": "اصلاً واجبه، واجب شرعی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 593.99,
   "end": 598.05,
   "text": "که ایشون متأسفانه نمی‌دونم با چه استنباطی میگه حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 598.05,
   "end": 600.23,
   "text": "هم البته رسیدگی به فقرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 600.23,
   "end": 606.55,
   "text": "من از این‌هایی که اینجور مسائل سریع می‌لرزوندشون، می‌ترسوندشون این قبیل شبهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 606.55,
   "end": 611.93,
   "text": "سؤال می‌کنم آیا سراغ دارید آستانی، منزلی، معوایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 611.93,
   "end": 615.97,
   "text": "پر خیر و برکت‌تر از مثلاً آستان قدس رضوی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 615.97,
   "end": 619.73,
   "text": "می‌دونید چقدر آستان قدس به فقرا و محرومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 619.73,
   "end": 623.59,
   "text": "نه فقط شهر مشهد و استان خراسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.59,
   "end": 626.39,
   "text": "بلکه شهر‌های دیگه خیررسانی کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 626.39,
   "end": 632.75,
   "text": "چقدر خیریه‌ها، صندوق‌های قرض‌الحسنه، زمین‌های کشاورز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 632.75,
   "end": 635.19,
   "text": "و مراتعی که این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 635.19,
   "end": 637.47,
   "text": "بازسازی کنند به دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 637.47,
   "end": 640.13,
   "text": "جوون‌ها بدن به دست کشاورزها بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 640.13,
   "end": 643.89,
   "text": "چقدر مناطق روستایی رو رسیدگی کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 643.89,
   "end": 646.43,
   "text": "چقدر از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 646.43,
   "end": 649.33,
   "text": "عرض شود نذورات و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 649.33,
   "end": 652.47,
   "text": "موقوفات رووی در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 652.47,
   "end": 655.45,
   "text": "مسیر کمک برسونن به مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 655.45,
   "end": 659.41,
   "text": "از اونا استفاده کنن برای خدمت رسانی به فقرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 659.41,
   "end": 667.37,
   "text": "حالا شما برید مشهد حومه شهر مشهد ببینید آستان قدس چقدر خدمت رسانی کرده به فقرا در اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 667.37,
   "end": 672.47,
   "text": "چقدر برای ظاهرهایی که می‌خوان برای اولین بار بیان مشهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 672.47,
   "end": 675.17,
   "text": "جانمایی کرده مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.17,
   "end": 678.19,
   "text": "ظاهر سرا درست کرده بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 678.19,
   "end": 682.79,
   "text": "یک قرون دریافتی. و چقدر خود آستان قدس که الان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 682.79,
   "end": 686.67,
   "text": "مثلاً پایگاه معنوی و فرهنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 686.67,
   "end": 691.91,
   "text": "یا پایتخت معنوی و فرهنگی جهان اسلام چقدر خدمت رسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.91,
   "end": 694.41,
   "text": "به نه فقط کشور خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 694.41,
   "end": 698.73,
   "text": "و شهر‌های خودمون بلکه به جهان اسلام دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 698.73,
   "end": 701.05,
   "text": "حالا آستان قدس رضوی حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 701.05,
   "end": 704.87,
   "text": "خیلی از این نهادها و سازمان‌ها مثل سازمان صدا و سیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 704.87,
   "end": 707.79,
   "text": "که به قول رهبر عزیزمون خط مقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.79,
   "end": 710.67,
   "text": "جبهه فرهنگی نظامه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 710.67,
   "end": 716.05,
   "text": "وقتی کمبود بودجه پیدا می‌کنه و مشکلات پیدا می‌کنه آستان قدس بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 716.05,
   "end": 718.05,
   "text": "کمک می‌رسونه. حالا یا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.05,
   "end": 724.52,
   "text": "طریق استقراض و وام و قرض و اینها یا بلاعوض بالاخره کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.52,
   "end": 729.14,
   "text": "آیا این همه خدماتی که الان داره صورت می‌گیره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 729.14,
   "end": 736.9,
   "text": "ناحیه اصلاً همین یاران اهل بیت، زوار اهل بیت علیهم الصلاة والسلام را باید نابوده بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 736.9,
   "end": 743.28,
   "text": "بعد بالاخره چگونه می‌خواهی شما عشق و محبتت را نسبت به این خاندان نشان بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 743.28,
   "end": 749.02,
   "text": "بعد چقدر زشت که ایشون میگه پول‌هایی که می‌ریزید تو این سوراخ سنبه‌های مثلاً ضریح و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 749.02,
   "end": 751.56,
   "text": "اینا مصرف‌های فانتزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 751.56,
   "end": 755.4,
   "text": "ازش مصرف‌های فانتزی می‌شه یا استعماری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 755.4,
   "end": 759.22,
   "text": "خیلی جالبه. افکار پوچ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 759.22,
   "end": 763.36,
   "text": "نخ‌نما و پوسیده‌ی شما فان-- استعماریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 763.36,
   "end": 765.94,
   "text": "که آب به آسیاب دشمن می‌ریزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 765.94,
   "end": 772.86,
   "text": "و مردم رو از تعظیم جایگاه و مقام عظیم ابا عبدالله الحسین سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 772.86,
   "end": 776.4,
   "text": "وامی‌دارید و دور می‌دارید و برحذر می‌دارید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 776.4,
   "end": 779.4,
   "text": "این‌ها. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 779.4,
   "end": 782.36,
   "text": "شما افکارتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 782.36,
   "end": 784.76,
   "text": "استعماریه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 784.76,
   "end": 787.6,
   "text": "عرض شود اون‌هایی که نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 787.6,
   "end": 796.34,
   "text": "در حین زیارت به همان میزانی که خرج زیارت اهل بیت می‌کنند بلکه چندین برابرش تو این همایش‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 796.34,
   "end": 799.46,
   "text": "اااه عرض شود انسان دوستانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 799.46,
   "end": 805.38,
   "text": "و اااه بسته‌های غذایی که در سرتاسر کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 805.38,
   "end": 809.7,
   "text": "به وفور و دائم خصوصاً در ایام کرونا داره تقسیم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 809.7,
   "end": 813.18,
   "text": "این‌ها بالاخره وقتی قیاس می‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 813.18,
   "end": 816.28,
   "text": "می‌بینی افکار شما استعماریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 816.28,
   "end": 820.16,
   "text": "یا نحوه‌ی تعظیم مردم از این مقابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 820.16,
   "end": 825.92,
   "text": "یا نحوه‌ی استفاده از نزولات مردم در این بارگاه‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 825.92,
   "end": 834.62,
   "text": "کدومش استعماریه؟ شما داری بیشتر به افکار دشمنان اهل بیت کمک می‌کنی یا اون‌هایی که تعظیم می‌کنند این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 834.62,
   "end": 838.0,
   "text": "و ضمن اینکه اصلاً به چه-- به کسی چه ربطی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 838.0,
   "end": 842.18,
   "text": "اگر کسی نذر کرد نیازش این بود که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 842.18,
   "end": 845.34,
   "text": "از رو عشقش به امام حسین یه خشت طلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 845.34,
   "end": 847.46,
   "text": "تقدیم مثلاً حرم امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 847.46,
   "end": 850.82,
   "text": "اهدی نمی‌تونه از این پول جای دیگه‌ای استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 850.82,
   "end": 856.58,
   "text": "این حرامه. شما معلومه که اصلاً از فقه هیچ بویی نبردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 856.58,
   "end": 858.7,
   "text": "که میگی اصلاً کمک کردن به این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 858.7,
   "end": 862.9,
   "text": "این پولی که می‌خوای بدی به ضریح امام حسین و اینا برو بده به فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 862.9,
   "end": 865.88,
   "text": "خب پولی که کسی ز-- نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 865.88,
   "end": 869.94,
   "text": "حرم ابا عبدالله کرد، نذر حرم رضوی کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 869.94,
   "end": 872.84,
   "text": "الا و لابد باید همونجا هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 872.84,
   "end": 875.88,
   "text": "مطلقاً شما اینو نمی‌تونی ببری جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 875.88,
   "end": 880.14,
   "text": "مگر نذر عام باشه بسپارن مثلاً به متولیان امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 880.14,
   "end": 884.1,
   "text": "آستان که دستشون باز باشه هر کجا در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 884.1,
   "end": 886.02,
   "text": "حالا ولایت بتونن ازش استفاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 886.02,
   "end": 888.96,
   "text": "و الا اگر کسی هر چیزی رو مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 888.96,
   "end": 892.76,
   "text": "وقف خود امام حسین بکنه هیچ کجای دیگه نمی‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 892.76,
   "end": 896.36,
   "text": "ازش استفاده کرد از جهت فقهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 896.36,
   "end": 900.02,
   "text": "بعد ایشون با متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 900.02,
   "end": 904.14,
   "text": "زشت‌ترین الفاظ میگه پول جن و انس رو میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 904.14,
   "end": 905.98,
   "text": "می‌مالن به این ضریح‌ها و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 905.98,
   "end": 910.14,
   "text": "این چه ط-- شما مثلاً لباس دین بر تن داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 910.14,
   "end": 912.48,
   "text": "شما واقعاً باید خجالت بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 912.48,
   "end": 915.44,
   "text": "این لباس را از تنت در بیار روی این حرفا رو بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 915.44,
   "end": 918.82,
   "text": "لباس پیغمبر تنت و این حرفا رو می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 918.82,
   "end": 923.58,
   "text": "و اتفاقاً بیشترین مشکلی که مردم ما دارن متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 923.58,
   "end": 927.22,
   "text": "از همین آب به آسیاب دشمن ریختن توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 927.22,
   "end": 931.04,
   "text": "دوستانه یا جاهله یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 931.04,
   "end": 933.6,
   "text": "با چهره‌ی متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 933.6,
   "end": 935.86,
   "text": "نفاق، منافق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 935.86,
   "end": 938.22,
   "text": "کسایی که ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 938.22,
   "end": 942.0,
   "text": "لباس دین بر تن‌شونه اما باطناً دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 942.0,
   "end": 944.86,
   "text": "به نفع دشمنان دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 944.86,
   "end": 948.42,
   "text": "عمل می‌کنند. انشاالله که خدا هممون رو آگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 948.42,
   "end": 953.04,
   "text": "دردی بود عزیزان به ما گفتن اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 953.04,
   "end": 957.08,
   "text": "به نظرم می‌رسه که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 957.08,
   "end": 961.36,
   "text": "عزیزانی که کمترین بهره رو از معارف الهی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 961.36,
   "end": 965.44,
   "text": "سر سفره‌ی آل الله بردن می‌تونند جواب امثال ایشون رو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 965.44,
   "end": 971.1,
   "text": "اما بنده هم گفتم توفیقی داشته باشم و چیزکی عرض کرده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 971.1,
   "end": 975.34,
   "text": "ان شا الله که عاقبتمون ختم بخیر باشد. والحمد لله رب العالمين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}