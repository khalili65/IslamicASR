 "chapters": [
  {
   "index": 0,
   "title": "## آرزوی مرگ؛ نهی و معنای تهیّؤ",
   "start": 12.92,
   "end": 99.5
  },
  {
   "index": 1,
   "title": "### شوق دیدار و حفظ موقعیت خدمت",
   "start": 99.5,
   "end": 178.1
  },
  {
   "index": 2,
   "title": "### دنیا مزرعه است",
   "start": 178.1,
   "end": 209.12
  },
  {
   "index": 3,
   "title": "### استثنا در اولیای کامل",
   "start": 209.12,
   "end": 252.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 5.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.88,
   "end": 9.38,
   "text": "خدمت سؤال محترمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.38,
   "end": 14.4,
   "text": "سلام برسونید و بفرمایید که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.4,
   "end": 18.66,
   "text": "اینکه آیا ما اجازه داریم آرزوی مرگ کنیم یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.66,
   "end": 22.02,
   "text": "در اون سلسله بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.02,
   "end": 27.76,
   "text": "مربوط به شرح کتاب الموت مرحوم مجلسی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.76,
   "end": 29.98,
   "text": "یه چند جلسه‌ای پیرامون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.98,
   "end": 32.46,
   "text": "بر اساس آیات و روایات سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.46,
   "end": 36.04,
   "text": "خیلی اجمالاً بخوام عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.04,
   "end": 41.86,
   "text": "نهی شده از طرف اولیاء الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.86,
   "end": 46.14,
   "text": "خاص پیغمبر عزیز اسلام نهی شده که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.14,
   "end": 48.9,
   "text": "آرزوی مرگ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.9,
   "end": 54.04,
   "text": "اِاِاِ و بعض از بزرگان گفتن مگر در تهیّؤ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.04,
   "end": 57.84,
   "text": "تهیّؤ یعنی آمادگی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.84,
   "end": 60.5,
   "text": "دیدار خدا. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.5,
   "end": 62.94,
   "text": "آره مثل اینکه قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.94,
   "end": 69.6,
   "text": "\"فتمنّوا الموت ان كنتم صادقین\" تمنای موت کنید اگر صادقید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.6,
   "end": 72.32,
   "text": "این تمنا یعنی تمنای باطنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.32,
   "end": 75.66,
   "text": "یعنی انسان در درون خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.66,
   "end": 80.42,
   "text": "شوق و تهیّؤ آمادگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.42,
   "end": 82.2,
   "text": "دیدار حق رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.2,
   "end": 85.42,
   "text": "مثل اینکه شما می‌خوای بری کربلا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.42,
   "end": 90.16,
   "text": "انقدر شوق زیارت ارباب رو داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.16,
   "end": 95.84,
   "text": "در درون خودت آرام و قرار نداری برای زیارت حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.84,
   "end": 103.02,
   "text": "شوق دیدار داری و البته حالا که شوق دیدار داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.02,
   "end": 106.78,
   "text": "دوست هم نداری که موقعیت فعلی رو از دست بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.78,
   "end": 109.34,
   "text": "مثلاً الان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.34,
   "end": 113.28,
   "text": "محلی هستی که داری خدمت به خلق الله می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.28,
   "end": 120.48,
   "text": "اممم از راه دور زیارت می‌کنی، به پدر و مادرت رسیدگی می‌کنی، کارهای خیر انجام میدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.48,
   "end": 123.02,
   "text": "کمک به جمهوری اسلامی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.02,
   "end": 126.34,
   "text": "این‌ها اما این همه این‌ها هم خیر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.34,
   "end": 131.68,
   "text": "اما به یک معنا داری خودت رو آماده می‌کنی برای اون زیارت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.68,
   "end": 135.2,
   "text": "حضور ظاهر عند المظور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.2,
   "end": 142.88,
   "text": "این به مقام اندیت نمی‌رسه انسان مگر اینکه شبیه بشه، سنخیت پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.88,
   "end": 147.32,
   "text": "الشفع والوتر شفع جفت شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.32,
   "end": 152.3,
   "text": "شبیه شدن، هم سنخ و هم جنس شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.3,
   "end": 156.34,
   "text": "اینجا اگر کسی به طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.34,
   "end": 162.24,
   "text": "ابی عبدالله زندگی کرد به سبک زندگی اون‌ها که رهبر عزیز فرمود سبک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.24,
   "end": 167.02,
   "text": "زندگی اسلامی اینطور بود، اون موقع این می‌شه خودش یه نوع تهیّؤ و ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.02,
   "end": 169.38,
   "text": "اِاِاِ پر درآوردن برای زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.38,
   "end": 171.8,
   "text": "این تمنای باطنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.8,
   "end": 176.9,
   "text": "نه اینکه حالا الان این موقعیت‌ها رو از من بگیر صرفاً فقط من رو برسون به کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.9,
   "end": 180.22,
   "text": "این غلطه. مثل اینکه ما در این دنیا با این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.22,
   "end": 185.18,
   "text": "بسترهایی که برای ارتقای وجودیمون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.18,
   "end": 191.5,
   "text": "ما این‌ها رو ندیده بگیریم، پشت به پا به نعمت‌ها بزنیم که بزرگ‌ترین فرصت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.5,
   "end": 195.88,
   "text": "اینجا مزرعه‌ست و هرچی بکاری اونجا می‌تونی برداشت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.88,
   "end": 198.98,
   "text": "این فرصت رو بخوای بسوزی که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.98,
   "end": 201.3,
   "text": "صرفاً به دیدار بری، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.3,
   "end": 207.66,
   "text": "در حینی که داری از این فرصت بهره‌برداری می‌کنی شوق دیدار داری ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.66,
   "end": 210.12,
   "text": "شوق دیدن داری. البته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.12,
   "end": 213.66,
   "text": "گفتار بعض از کمالین از اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.66,
   "end": 216.9,
   "text": "هست که انسان به یک درجاتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.9,
   "end": 222.06,
   "text": "شوق و عرفان که می‌رسه ناخودآگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.06,
   "end": 224.54,
   "text": "طلب و تقاضای مرگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.54,
   "end": 229.64,
   "text": "اون قصه‌ش فرق می‌کنه. که مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.64,
   "end": 234.96,
   "text": "خانم فاطمه زهرا سلام الله علیها که اللهم عجل وفاتی سریعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.96,
   "end": 239.68,
   "text": "این‌ها دیگه یکپارچه نور محض بودند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.68,
   "end": 245.28,
   "text": "اِمم ناخودآگاه اصلاً طالب اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.28,
   "end": 248.24,
   "text": "اِاِاِ نور مطلق بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.24,
   "end": 250.28,
   "text": "این از این سؤال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.28,
   "end": 252.76,
   "text": "جواب این و پاسخ این سؤال اجمالاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}