 },
 "chapters": [
  {
   "index": 0,
   "title": "## منشأ ضعف؛ عدم استقلال وجودی",
   "start": 135.24,
   "end": 155.58
  },
  {
   "index": 1,
   "title": "## جزء و کل؛ پیچیدگی سه قرآن",
   "start": 155.58,
   "end": 185.18
  },
  {
   "index": 2,
   "title": "## نقش توجه به خالق در رفع مشکلات",
   "start": 185.18,
   "end": 697.9
  },
  {
   "index": 3,
   "title": "همین توجه به خالق است.",
   "start": 697.9,
   "end": 940.56
  },
  {
   "index": 4,
   "title": "حتی در آیهٔ شریفه که به هدایت ختم شده: أولئک هم المهتدون — اینان فقط اهل هدایت‌اند. از اول آیه:",
   "start": 940.56,
   "end": 997.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.6,
   "end": 5.6,
   "text": "بسم الله و بالله و علی ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.6,
   "end": 9.84,
   "text": "المستغاث بکه یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.84,
   "end": 17.54,
   "text": "باز عزیزی که پیرامون صحیفه سجادیه تحقیق داشتن سؤال دومشون این بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.54,
   "end": 24.44,
   "text": "ضعف آدمی در حل مشکلات بدون خالق یا مثلاً معنای اساساً خالقیت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.44,
   "end": 27.5,
   "text": "منشاء ضعف آدمی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.5,
   "end": 31.64,
   "text": "و این قبیل مطالب رو فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.64,
   "end": 33.46,
   "text": "نکته‌ای رو عرض کنیم خدمتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.46,
   "end": 36.14,
   "text": "ببینید عزیزان اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.14,
   "end": 40.06,
   "text": "خالق کسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.06,
   "end": 44.16,
   "text": "از ذات خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.16,
   "end": 49.96,
   "text": "ظهور می‌کنه. یعنی اون باطنش رو آشکار می‌کنه که به این معنا میگن کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.96,
   "end": 52.48,
   "text": "کلمه یعنی به معنای حقیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.48,
   "end": 56.8,
   "text": "مرحوم علامه رفیع قزوینی می‌فرماید که ظهور باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.8,
   "end": 63.5,
   "text": "لذا شما وقتی کلمه‌ای رو بر لسانت جاری می‌کنی تا مرد سخن نگفته باشد، ای بضاعت هنرش نه افته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.5,
   "end": 66.42,
   "text": "یک معناش اینه که میگن کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.42,
   "end": 69.92,
   "text": "که داری چیکار می‌کنی؟ باطن خودت رو آشکار می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.92,
   "end": 72.92,
   "text": "لذا خلائق می‌شن کلمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.92,
   "end": 76.52,
   "text": "چرا؟ چون ظهور باطن حضرت حقند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.52,
   "end": 81.54,
   "text": "وقتی حضرت حق، ذات حضرت حق تجلی کرد، جلوه کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.54,
   "end": 84.62,
   "text": "می‌شود چی؟ کلمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.62,
   "end": 87.36,
   "text": "یعنی ظهور، ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.36,
   "end": 94.06,
   "text": "باطن است. البته هر کسی نسبت به سعه وجودیش و جایگاه رتبه‌اش در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.06,
   "end": 98.42,
   "text": "به همان میزان از ظهور باطن حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.42,
   "end": 104.64,
   "text": "بهره می‌گیره. که ما قائل به توحید صمدیه حضرت حق هستیم که وجود یک وجود است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.64,
   "end": 107.66,
   "text": "که اگر دو وجود باشد نمی‌شه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.66,
   "end": 110.66,
   "text": "به قول قرآن فساد ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.66,
   "end": 114.0,
   "text": "وجود یک وجوده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.0,
   "end": 116.5,
   "text": "این کثرات همه بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.5,
   "end": 119.98,
   "text": "شؤون اون وجودند. ظهور اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.98,
   "end": 122.86,
   "text": "وجودند. هر کسی نسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.86,
   "end": 126.04,
   "text": "به رتبه وجودیش به همان میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.04,
   "end": 128.54,
   "text": "ظاهر شده از باطن قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.54,
   "end": 131.56,
   "text": "از باطن حضرت حق. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.56,
   "end": 135.24,
   "text": "منشاء ضعف حالا آدم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.24,
   "end": 139.1,
   "text": "پس معنای خالقیت شد ظهور باطن حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.1,
   "end": 142.9,
   "text": "که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.9,
   "end": 147.84,
   "text": "می‌شه گفت از اون اصل به فرع، از اون مصب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.84,
   "end": 152.66,
   "text": "به در حقیقت شرح رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.66,
   "end": 156.96,
   "text": "منشاء ضعف آدمی هم یکیش استقلال وجودیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.96,
   "end": 161.94,
   "text": "که نداره. چون استقلال وجودی نداره ضعف مطلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.94,
   "end": 165.1,
   "text": "یعنی ذاتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.1,
   "end": 167.24,
   "text": "نه حولی دارد نه قوه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.24,
   "end": 173.92,
   "text": "هرچه که هست لا حول و لا قوة الا بالله العلی العظیم، از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.92,
   "end": 175.52,
   "text": "هر آنچه که دارد از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.52,
   "end": 178.78,
   "text": "پس انسان ضعف مطلق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.78,
   "end": 181.26,
   "text": "او قوت مطلق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.26,
   "end": 184.86,
   "text": "انسان ضعف مطلقه. چون استقلال وجودی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.86,
   "end": 190.4,
   "text": "یعنی اگر یک آن، اون ظهور قطع بشود، انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.4,
   "end": 195.84,
   "text": "اصلاً نیست و نابود. اصلاً نه انسان، هیچ خلقی، اساساً هیچ خلقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.84,
   "end": 198.88,
   "text": "خلائق همه عرض شد که ظهور باطنند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.88,
   "end": 205.04,
   "text": "اگر باطن اراده کند که ظاهر نشود که البته چنین چیزی در فلسفه محال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.04,
   "end": 208.42,
   "text": "اما حالا فرض محال که محال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.42,
   "end": 211.1,
   "text": "اگر ظاهر اراده کند که با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.1,
   "end": 214.9,
   "text": "دیگه ظهور نکند، باطن اراده کند که ظاهر نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.9,
   "end": 216.52,
   "text": "خب دیگه چه، چه خلقی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.52,
   "end": 222.18,
   "text": "دیگه پس یعنی اساساً استقلال که چه عرض کنم اصلاً وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.18,
   "end": 224.56,
   "text": "به ظهور باطن حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.56,
   "end": 227.42,
   "text": "که خلق، خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.42,
   "end": 230.94,
   "text": "که اون باطن وقتی ظهور می‌کنه خالقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.94,
   "end": 234.2,
   "text": "در مقام خالقه که ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.2,
   "end": 236.76,
   "text": "حالا و نکته دیگر این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.76,
   "end": 240.04,
   "text": "چون، چون داریم در منشاء ضعف آدمی صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.04,
   "end": 243.86,
   "text": "چون در قوس نزول انا لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.86,
   "end": 247.06,
   "text": "چون در قوس نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.06,
   "end": 251.4,
   "text": "انسان در، در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.4,
   "end": 255.9,
   "text": "انزل مراتب تنزل قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.9,
   "end": 265.82,
   "text": "وقتی که از صادر اول یا اون نفس الرحمن یا صورت الرحمن بیست‌وهشت دسته خلائق به عدد منازل ماه، بیست‌وهشتگانه ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.82,
   "end": 271.06,
   "text": "تنزل پیدا کردن، انسان در انزل مراتب این بیست‌وهشت دسته خلائق قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.06,
   "end": 274.4,
   "text": "چون اومد رسید به رتبه جمادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.4,
   "end": 276.4,
   "text": "جماد دیگه اسمش رو خودشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.4,
   "end": 279.34,
   "text": "خاک، سنگ. دیگه انزل مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.34,
   "end": 283.68,
   "text": "ما هم چون از نطفه به وجود اومدیم، نطفه اول جماد بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.68,
   "end": 291.62,
   "text": "اون آب و نانی بود که پدر و مادر خوردن در صلب و رحم‌شون شکل گرفتیم ما شدیم جنین و به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.62,
   "end": 297.2,
   "text": "چون در انزل مراتب رخ میده باید در حقیقت بیاد در قالب ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.2,
   "end": 299.72,
   "text": "یخرجهم من الظلمات الی النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.72,
   "end": 306.2,
   "text": "الله ولی، ولیّ الذین آمنوا یخرجهم من الظلمات الی النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.2,
   "end": 309.2,
   "text": "دانه رو هم تو ظلمت زمین می‌کارن تا رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.2,
   "end": 313.52,
   "text": "همه چی بچه توش تاریکی رحم مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.52,
   "end": 318.64,
   "text": "رشد می‌کنه. ما اومدیم به عالم تاریک، ظلمت سرا دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.64,
   "end": 321.0,
   "text": "در انزل مراتب تا به بالا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.0,
   "end": 323.92,
   "text": "این خودش منشاء ضعفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.92,
   "end": 326.34,
   "text": "که باید از ضعف به قوت بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.34,
   "end": 329.46,
   "text": "بر اساس اون حرکت جوهری که بحث شد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.46,
   "end": 337.42,
   "text": "سؤال قبلی، این اشتداد وجودی، تبدل امثال و صور و این‌ها هی به ضعف بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.42,
   "end": 339.92,
   "text": "از ضعف به قوت بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.92,
   "end": 341.72,
   "text": "چون داری به سمت حضرت حق میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.72,
   "end": 345.38,
   "text": "فملاقی. می‌خوای خدا رو ملاقات کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.38,
   "end": 347.6,
   "text": "خدا هم که قویه علی الاطلاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.6,
   "end": 350.9,
   "text": "شما از ضعف به سمت قوت حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.9,
   "end": 353.84,
   "text": "منشاء ضعف آدمی یکیش هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.84,
   "end": 357.04,
   "text": "که در قوس نزول به اینجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.04,
   "end": 360.34,
   "text": "اومده در انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.34,
   "end": 365.94,
   "text": "در ثانی اینکه انسان در حل مشکلاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.94,
   "end": 373.82,
   "text": "ضعیفه و بدون خالق نمی‌تونه مشکلاتشو برطرف کنه به جهت اینکه انسان جزئی از کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.82,
   "end": 376.82,
   "text": "لذا به تنهایی قادر به حل مشکلاتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.82,
   "end": 379.9,
   "text": "باید کل بیاد کمک جزء کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.9,
   "end": 383.04,
   "text": "دیگری یعنی دلیل دیگری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.04,
   "end": 387.42,
   "text": "ضعف انسان رو نشون میده در حل مشکلاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.42,
   "end": 392.5,
   "text": "و باید خالق دخالت کنه، پیچیدگی وجود خود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.5,
   "end": 398.52,
   "text": "ما قبلاً عرض کردیم که اساساً تجلی از علم حضرت حق قرآن بوده که به سه شکل:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.52,
   "end": 403.6,
   "text": "یکی قرآن کتبی که همون قرآنی‌ست که ما لفظش رو در اختیار داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.6,
   "end": 413.1,
   "text": "که پیچیده شده و رفته این طومار تا علم حضرت حق که انک لَتُل-- انک لَتُلَقّی القرآن، القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.1,
   "end": 418.7,
   "text": "من لَدُن حکیم علیم. این علم لدنیه حضرت حق بوده تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.7,
   "end": 420.74,
   "text": "قرآن کتبی. یکی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.74,
   "end": 425.2,
   "text": "انفسی یا نفسی‌ست که همون جان انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.2,
   "end": 429.58,
   "text": "یکی هم قرآن آفاقی‌ست یعنی قرآن هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.58,
   "end": 433.46,
   "text": "هر سه قرآن‌اند. پیچیدگی این سه تا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.46,
   "end": 436.12,
   "text": "خطیره، خیلی دقیقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.12,
   "end": 439.98,
   "text": "خیلی عجیبه، خیلی غریبه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.98,
   "end": 443.64,
   "text": "پیچیدگی وجود انسان، این انسانی که می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.64,
   "end": 451.84,
   "text": "در حقیقت ااا مشکلاتشو برطرف کنه یا به هر جایی برسه خودش که وجودش به شدت پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.84,
   "end": 457.46,
   "text": "چقدر کتاب‌ها در معرفت نفس انسانی نوشته شده اما هم هیچ کدومش حق و حقش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.46,
   "end": 459.8,
   "text": "هیچ کدوم حتی علامه حائری yزده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.8,
   "end": 465.42,
   "text": "که بهترین مباحث و پیرامون این قصه دارن ادعا ندارن که تمام حق و حق قصه رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.42,
   "end": 470.04,
   "text": "نه. پیچیدگی وجود انسان بسیار عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 470.04,
   "end": 473.7,
   "text": "از طرفی یه بحثی ما داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.7,
   "end": 476.9,
   "text": "ااا در فلسفه و عرفان به نام تطابق آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.9,
   "end": 480.5,
   "text": "و عالم که یعنی آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.5,
   "end": 484.26,
   "text": "به سعادت به سرمنزل سعادت نمی‌رسه مگر با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.26,
   "end": 487.06,
   "text": "عالم خودش رو تطبیق بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.06,
   "end": 493.72,
   "text": "در خوابیدن، خوردن، سبک زندگی به قول رهبر عزیزمون و خیلی چیزای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.72,
   "end": 497.88,
   "text": "مثلاً اینکه هیچ حیوانی بین طلوعین خواب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.88,
   "end": 500.82,
   "text": "هیچ حیوانی رو شکمش یا به پشتش نمی‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.82,
   "end": 503.32,
   "text": "همه به سمت چپ و راست می‌خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.32,
   "end": 510.18,
   "text": "و، و، و. این تطابق عالم و آدم این یه بحث بسیار مهمی‌ست حتی در طب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 510.18,
   "end": 515.92,
   "text": "در طب اسلامی که معمولاً امروز یکی از مهم‌ترین مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.92,
   "end": 522.6,
   "text": "حتی پیچیده‌ی زندگی بشر، نوع بشر امروز عدم اطلاعش از این قصه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.6,
   "end": 526.58,
   "text": "حالا شما که بخوای تطبیق بدی بین خودت و عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.58,
   "end": 529.76,
   "text": "نیاز داره که خب نظام آفاقی رو هم دربیابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.76,
   "end": 532.0,
   "text": "خب اینم خودش پیچیدگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.0,
   "end": 536.14,
   "text": "نظام آفاقی هم به شدت پیچیده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.14,
   "end": 538.54,
   "text": "که خودشم لایتناهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.54,
   "end": 545.22,
   "text": "از اون طرف هم اون آئینی که به تو دستور می‌دهد که چگونه بین تو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.22,
   "end": 548.76,
   "text": "عالم تطابق ایجاد شود به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.76,
   "end": 555.18,
   "text": "دین، به نام آداب الهی، حالا قرآن بگیر اینو که همه‌ی علوم در قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.18,
   "end": 558.98,
   "text": "من اراد علم الاولین والآخرین فلینظر القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.98,
   "end": 561.66,
   "text": "خب علم اول و آخر در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.66,
   "end": 563.88,
   "text": "به قول امام سجاد صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.88,
   "end": 566.24,
   "text": "در کنز المال اومده این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.24,
   "end": 571.38,
   "text": "خب اینم پیچیده‌ست. این آداب هم به شدت خطیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 571.38,
   "end": 575.3,
   "text": "خیلی پرخطر، پر فراز و نشیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.3,
   "end": 582.54,
   "text": "پردقت. حالا شما دیگه ببین دیگه خود حدیث مفصل بخوان از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.54,
   "end": 585.82,
   "text": "که هر سه پیچیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.82,
   "end": 589.2,
   "text": "و چگونه می‌خوای این پیچیدگی‌ها رو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.2,
   "end": 594.22,
   "text": "بدون ت-- دخل و تصرف خالقیت نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.22,
   "end": 596.72,
   "text": "برطرف کنی، این مشکلات رو برطرف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.72,
   "end": 600.7,
   "text": "اصلاً محال همچین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.7,
   "end": 608.82,
   "text": "در حقیقت در نقش توجه به خالق در رفع مشکلات باید گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.82,
   "end": 614.9,
   "text": "اگر بخوای به آیین روایات و قرآن توجه کنی، اجمالاً عرض کنم به عنوان نمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.9,
   "end": 621.8,
   "text": "همین که خدای منان خالق ما فرموده \"من در نزد گمان بنده‌ام هستم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 621.8,
   "end": 627.32,
   "text": "خب این نقش توجه به خالق در رفع مشکلات و موانع زندگیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 627.32,
   "end": 630.86,
   "text": "اگر خدا نزد گمان بندشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 630.86,
   "end": 633.78,
   "text": "هرچی تو گمان داری به خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.78,
   "end": 635.8,
   "text": "خدا هم همونطور با تو رفتار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.8,
   "end": 640.1,
   "text": "یعنی اگر تو توجهت به خدا توجه عمیقی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.1,
   "end": 644.12,
   "text": "خدا هم عمیقاً بهتون توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.12,
   "end": 648.6,
   "text": "اگر خدا رو فراموش کنی، فأنساهم أنفسهم قرآن میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 648.6,
   "end": 650.3,
   "text": "خدا هم اینا رو فراموش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 650.3,
   "end": 654.54,
   "text": "اصلاً یک رابطه دو طرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 654.54,
   "end": 663.24,
   "text": "در حقیقت اگر کسی به ت-- به توجه عرفانی به خدا بنشینه، خدا هم به او متوجه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.24,
   "end": 666.7,
   "text": "این بخش توجه به خالقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.7,
   "end": 671.78,
   "text": "تو به خدا خوشبین باش، خدا هم به تو خ-خوش نگاه می‌کنه، خوش نظر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.78,
   "end": 676.28,
   "text": "حتی آرامش. ه-- کیه که بگه من دنبال آرامش نیستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 676.28,
   "end": 683.0,
   "text": "آرامش کجا پیدا میشه؟ ألا این ألا رو مفسرین از جمله طب طبایی فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.0,
   "end": 685.04,
   "text": "نگید یکی از راه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 685.04,
   "end": 687.78,
   "text": "نه، بلکه تنها راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 687.78,
   "end": 690.34,
   "text": "اطمینان و آرامش قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 690.34,
   "end": 692.6,
   "text": "ذکر خداست. ألا بذكر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 692.6,
   "end": 694.5,
   "text": "الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 694.5,
   "end": 697.9,
   "text": "الله. همین توجه به خالقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 697.9,
   "end": 702.4,
   "text": "یا سعادت. سعادت و خوشبختی در گرو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 702.4,
   "end": 706.78,
   "text": "به چی-- به چه کسی میگن سعادتمند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.78,
   "end": 710.4,
   "text": "خب قرآن می‌فرماید که قد أفلح من زكاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.4,
   "end": 713.24,
   "text": "یه جای دیگه می‌فرماید تزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 713.24,
   "end": 716.42,
   "text": "و یزکیهن. توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 716.42,
   "end": 719.34,
   "text": "آیه دو سوره جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 719.34,
   "end": 723.52,
   "text": "که خدای منان می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.52,
   "end": 725.9,
   "text": "هو الذی خودشو اینطوری معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 725.9,
   "end": 733.66,
   "text": "هو الذی بعث في الأميين رسولا منهم يتلو عليهم آياته ويزكيهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 733.66,
   "end": 736.16,
   "text": "خب این تزکیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 736.16,
   "end": 739.7,
   "text": "در حقیقت پاکی که سبب رستگاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 739.7,
   "end": 742.1,
   "text": "خب سعادت و رستگاری در گرو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 742.1,
   "end": 744.56,
   "text": "پاکیه. پاکی کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 744.56,
   "end": 747.86,
   "text": "بعث في الأميين رسولا منهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 747.86,
   "end": 750.96,
   "text": "یه پیغمبری رو خدا فرستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 750.96,
   "end": 757.34,
   "text": "یعنی اصل نمیشه تا با دخالت خدا نباشه که پیغمبر رو فرستاده کسی رستگار بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 757.34,
   "end": 762.12,
   "text": "مگر طبق آیین و دستورات پیغمبر عمل کنه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 762.12,
   "end": 767.94,
   "text": "تزکیه حاصل بشه. و دوباره والذين أوتوا العلم درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 767.94,
   "end": 771.4,
   "text": "اینهایی که همه دارم عرض می‌کنم آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 771.4,
   "end": 775.08,
   "text": "اگر می‌خواید درجه پیدا کنید یعنی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 775.08,
   "end": 779.78,
   "text": "مدارج قرآن به معراج بری و معارج بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 779.78,
   "end": 782.76,
   "text": "بری به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 782.76,
   "end": 786.26,
   "text": "درجات بالا برسی. والذين أوتوا العلم درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 786.26,
   "end": 790.62,
   "text": "علم. اونهایی که بهشون علم داده شده اینا صاحب درجه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 790.62,
   "end": 793.44,
   "text": "حالا این علم کجاست دوباره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 793.44,
   "end": 796.74,
   "text": "علم کجاست؟ و يعلمهم الكتاب و الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 796.74,
   "end": 799.22,
   "text": "دوباره ادامه همون و يزكيهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 799.22,
   "end": 801.84,
   "text": "و يزكيهم و يعلمهم الكتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 801.84,
   "end": 805.92,
   "text": "این يزكيهم این يعلمهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 805.92,
   "end": 808.34,
   "text": "از کجا اومده؟ از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 808.34,
   "end": 813.76,
   "text": "هو الذی بعث في الأميين رسولا، رسولا منهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 813.76,
   "end": 816.8,
   "text": "این پیغمبر اومده تعلیم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 816.8,
   "end": 822.22,
   "text": "باز تو دامن پیغمبره، تو دامن عترت پیغمبره، تو دامن قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 822.22,
   "end": 825.64,
   "text": "همه علم، همه پاکی و طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 825.64,
   "end": 827.58,
   "text": "که اومده يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 827.58,
   "end": 830.3,
   "text": "این آیات رو تلاوت کنه بر انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 830.3,
   "end": 833.9,
   "text": "پس باز میشه گفت بدون توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 833.9,
   "end": 836.3,
   "text": "به پیغمبر خدا یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 836.3,
   "end": 843.9,
   "text": "اون آیین الهی یعنی باز میشه گفت بدون توجه به خالقیت حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 843.9,
   "end": 846.62,
   "text": "به خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 846.62,
   "end": 853.52,
   "text": "که این چنین برای ما دستوراتش رو نازل کرده اصلاً نمیشه مشکلات برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 853.52,
   "end": 856.04,
   "text": "اگه کسی سعادت می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 856.04,
   "end": 858.78,
   "text": "تقوا، اه پاکیزگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 858.78,
   "end": 861.24,
   "text": "درجات می‌خواد تعلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 861.24,
   "end": 864.36,
   "text": "آرامش می‌خواد ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 864.36,
   "end": 867.82,
   "text": "نگاه خوش حضرت حقو می‌خواد گمان خوب به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 867.82,
   "end": 871.24,
   "text": "به خدا فرجام عاقبت خوب می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 871.24,
   "end": 873.76,
   "text": "والعاقبة للمتقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 873.76,
   "end": 876.4,
   "text": "چقدر در آیات قرآن تکرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 876.4,
   "end": 878.88,
   "text": "متقین، متقین، متقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 878.88,
   "end": 882.58,
   "text": "خروج از بن‌بست‌ها، گرفتاری‌ها رو می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 882.58,
   "end": 888.52,
   "text": "ها؟ میت و می یتقي الله يجعل له مخرجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 888.52,
   "end": 890.8,
   "text": "و يرزق من حيث لا يحتسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 890.8,
   "end": 892.88,
   "text": "برکت در رزقش می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 892.88,
   "end": 897.24,
   "text": "خروج از بن‌بست می‌خواد. تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 897.24,
   "end": 899.44,
   "text": "توجه کردید باز میشه-- تقوا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 899.44,
   "end": 901.64,
   "text": "رعایت حدود الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 901.64,
   "end": 905.48,
   "text": "یعنی فرجام عاقبت و العاقبة للمتقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 905.48,
   "end": 908.1,
   "text": "خروج از بن‌بست، تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 908.1,
   "end": 912.38,
   "text": "هرچی میگه می‌خوای قبولت کنه خدا در نهایت تو رو قبول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 912.38,
   "end": 914.58,
   "text": "انما يتقبل الله من المتقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 914.58,
   "end": 918.0,
   "text": "انما حصر فقط خدا از باتقوا‌ها می‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 918.0,
   "end": 921.9,
   "text": "والسلام. می‌دونید شما وقتی اینطوری نگاه می‌کنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 921.9,
   "end": 926.84,
   "text": "حتی تو اون آیه شریفه که آخرش به هدایت خرج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 926.84,
   "end": 931.08,
   "text": "أولئك هم المهتدون. میگه اینا فقط اهل هدایت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 931.08,
   "end": 939.34,
   "text": "از اول آیه که نگاه می‌کنی میگی ولنبلونكم شيء من الخوف والجوع ونقص من الأموال والأنفس والثمرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 939.34,
   "end": 947.96,
   "text": "اینایی که ما قطعاً گرفتار بلاشون می‌کنیم بلاهای از این چند جنس ترس و گرسنگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 947.96,
   "end": 951.02,
   "text": "از شاید نقص اموال و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 951.02,
   "end": 953.56,
   "text": "گرفتاری‌ها. وبشر الصابرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 953.56,
   "end": 956.92,
   "text": "باز بشارت بده اونایی که توجه به اسم صبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 956.92,
   "end": 959.98,
   "text": "صابر و صبار حضرت حق دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 959.98,
   "end": 962.64,
   "text": "توجه به خالقیت نظام هستی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 962.64,
   "end": 966.44,
   "text": "خدایی که اینا رو آفریده. حالا بعد اینا کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 966.44,
   "end": 970.38,
   "text": "الذين إذا أصابتهم مصيبة قالوا إنا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 970.38,
   "end": 974.04,
   "text": "وإنا إليه راجعون. یعنی وقتی مصیبت بهشون می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 974.04,
   "end": 977.22,
   "text": "این‌ها اهل توجه به خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 977.22,
   "end": 980.1,
   "text": "میگن ما از خدا اومدیم به خدا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 980.1,
   "end": 982.42,
   "text": "در قوس نزول إنا لله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 982.42,
   "end": 984.9,
   "text": "قوس صعود وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 984.9,
   "end": 987.58,
   "text": "بعد آخر آیه میگه این‌هان که اهل هدایتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 987.58,
   "end": 990.26,
   "text": "یعنی اگه که هدایت اگه کسی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 990.26,
   "end": 997.78,
   "text": "باز توجه به الله، الله، الله که خالق نظام هستی است. والحمد لله رب العالمين",
